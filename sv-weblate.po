#. from yeager:weblate-review
msgid "Selection Cursor Right"
msgstr "Markeringsmarkör höger"

#. from yeager:weblate-review
msgid "Moves the cursor one object right, altering the selection if any"
msgstr ""
"Flyttar markören ett objekt åt höger och ändrar markeringen om det finns "
"någon"

#. from yeager:weblate-review
msgid "Move Cursor Right"
msgstr "Flytta markören åt höger"

#. from yeager:weblate-review
msgid "Moves the cursor one object right, without altering the selection"
msgstr "Flyttar markören ett objekt åt höger, utan att ändra markeringen"

#. from yeager:weblate-review
msgid "To Mark"
msgstr "Till Mark"

#. from yeager:weblate-review
msgid "Moves the cursor to the Mark without altering the selection"
msgstr "Flyttar markören till markeringen utan att ändra valet"

#. from yeager:weblate-review
msgid "Swap Ends of Selection"
msgstr "Byt ändar på urvalet"

#. from yeager:weblate-review
msgid "Swaps the active end of the selection"
msgstr "Byter den aktiva änden av markeringen"

#. from yeager:weblate-review
msgid "To Selection Start"
msgstr "Till urvalet Start"

#. from yeager:weblate-review
msgid ""
"Moves the cursor to the first object in the selection without altering the "
"selection. returns #f if no selection"
msgstr ""
"Flyttar markören till det första objektet i urvalet utan att ändra urvalet. "
"returnerar #f om inget urval finns"

#. from yeager:weblate-review
msgid "Push Position"
msgstr "Tryck position"

#. from yeager:weblate-review
msgid "Pushes the current cursor position onto a stack"
msgstr "Flyttar den aktuella markörpositionen till en stack"

#. from yeager:weblate-review
msgid "Pop Position"
msgstr "Pop Position"

#. from yeager:weblate-review
msgid ""
"Pops a position from the stack of cursor positions, moving the cursor there"
msgstr ""
"Plockar fram en position från stapeln med markörpositioner och flyttar "
"markören dit"

#. from yeager:weblate-review
msgid "Pop and Push Position"
msgstr "Pop- och Push-position"

#. from yeager:weblate-review
msgid ""
"Pops a position from the stack of cursor positions, pushes the current "
"position, then moves the cursor to the popped position"
msgstr ""
"Plockar fram en position från stapeln med markörpositioner, flyttar fram den"
" aktuella positionen och flyttar sedan markören till den framtagna "
"positionen"

#. from yeager:weblate-review
msgid "Hide/Show Menus"
msgstr "Dölj/visa menyer"

#. from yeager:weblate-review
msgid ""
"Hides/Shows menus, panes etc. The ones shown are those checked in the view "
"menu."
msgstr ""
"Döljer/visar menyer, rutor etc. De som visas är de som är markerade i "
"visningsmenyn."

#. from yeager:weblate-review
msgid "Selection Staff Up"
msgstr "Urval notsystem Upp"

#. from yeager:weblate-review
msgid "Moves the cursor to the staff above, extending selection if any"
msgstr "Flyttar markören till staven ovanför och förlänger eventuellt val"

#. from yeager:weblate-review
msgid "Selection Staff Down"
msgstr "Urval notsystem Ned"

#. from yeager:weblate-review
msgid "Moves the cursor to the staff below, extending selection if any"
msgstr "Flyttar markören till staven nedanför och förlänger eventuellt val"

#. from yeager:weblate-review
msgid "Move to Staff Up"
msgstr "Flytta till Staff Up"

#. from yeager:weblate-review
msgid ""
"Moves the cursor to the staff above without altering selection. On the top "
"staff it adds space above the staffs."
msgstr ""
"Flyttar markören till notsystemet ovanför utan att ändra markeringen. På det"
" översta notsystemet lägger det till utrymme ovanför notsystemet."

#. from yeager:weblate-review
msgid "Move to Staff Down"
msgstr "Flytta till Staff Down"

#. from yeager:weblate-review
msgid "Moves the cursor to the staff below without altering selection"
msgstr "Flyttar markören till staven nedanför utan att ändra valet"

#. from yeager:weblate-review
msgid "Measure Left"
msgstr "Mät vänster"

#. from yeager:weblate-review
msgid ""
"Moves the cursor to the first object in the next measure, extending "
"selection if any"
msgstr ""
"Flyttar markören till det första objektet i nästa mått och utökar urvalet om"
" det finns något"

#. from yeager:weblate-review
msgid "Measure Right"
msgstr "Mät rätt"

#. from yeager:weblate-review
msgid ""
"Moves the cursor to the first object in the previous measure, extending "
"selection if any"
msgstr ""
"Flyttar markören till det första objektet i föregående mått och utökar "
