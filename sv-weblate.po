msgid "Needs review"
msgstr "Behöver granskas"

#. from yeager:weblate-review
msgid "This site runs Weblate for localizing a software project."
msgstr ""
"Den här webbplatsen använder Weblate för att lokalisera ett "
"programvaruprojekt."

#. from yeager:weblate-review
msgid "Actionable by me"
msgstr "Åtgärdbar av mig"

#. from yeager:weblate-review
msgid "Discovery configuration"
msgstr "Konfiguration för upptäckt"

#. from yeager:weblate-review
msgid ""
"Component discovery stopped because the repository contains too many paths."
msgstr ""
"Komponentupptäckten stoppades eftersom arkivet innehåller för många "
"sökvägar."

#. from yeager:weblate-review
msgid ""
"The language filter regular expression is too complex and took too long to "
"evaluate."
msgstr ""
"Språkfiltrets reguljära uttryck är för komplext och tog för lång tid att "
"utvärdera."

#. from yeager:weblate-review
msgid ""
"The regular expression used to match discovered files is too complex and "
"took too long to evaluate."
msgstr ""
"Det reguljära uttrycket som användes för att matcha de upptäckta filerna är "
"för komplicerat och det tog för lång tid att utvärdera det."

#. from yeager:weblate-review
msgid ""
"Component discovery stopped because matching translation files would require"
" too many comparisons."
msgstr ""
"Komponentupptäckten stoppades eftersom matchning av översättningsfiler "
"skulle kräva för många jämförelser."

#. from yeager:weblate-review
msgid ""
"The file mask used for discovery is too complex and took too long to "
"evaluate."
msgstr ""
"Filmasken som används för upptäckt är för komplex och tog för lång tid att "
"utvärdera."

#. from yeager:weblate-review
msgid ""
"Multiple base or new base files render to the same file mask %(mask)s "
"(%(existing)s and %(new)s)."
msgstr ""
"Flera basfiler eller nya basfiler återges till samma filmask %(mask)s "
"(%(existing)s och %(new)s)."

#. from yeager:weblate-review
msgid "Do not sort"
msgstr "Sortera inte"

#. from yeager:weblate-review
msgid "Case-sensitive sort"
msgstr "Skiftlägeskänslig sortering"

#. from yeager:weblate-review
msgid "Case-insensitive sort"
msgstr "Icke-skiftlägeskänslig sortering"

#. from yeager:weblate-review
msgid "Contributor comments"
msgstr "Kommentarer med uppgifter om bidragsgivare"

#. from yeager:weblate-review
msgid "Gettext"
msgstr "Gettext"

#. from yeager:weblate-review
msgid "SPDX"
msgstr "SPDX"

#. from yeager:weblate-review
msgid ""
"Add contributor names and years to header comments. SPDX also converts "
"existing recognized contributor comments to SPDX-FileCopyrightText entries."
msgstr ""
"Lägg till bidragsgivarnas namn och årtal i filhuvudets kommentarer. SPDX "
"konverterar också befintliga identifierade kommentarer med uppgifter om "
"bidragsgivare till SPDX-FileCopyrightText-poster."

#. from yeager:weblate-review
msgid "Controls previous msgid comments for fuzzy strings."
msgstr "Kontrollerar tidigare msgid-kommentarer efter fuzzy-strängar."

#. from yeager:weblate-review
msgid "Remove obsolete strings"
msgstr "Ta bort föråldrade strängar"

#. from yeager:weblate-review
msgid ""
"Remove obsolete entries from PO files when saving translation changes or "
"updating from a POT file."
msgstr ""
"Ta bort föråldrade poster från PO-filer när du sparar översättningsändringar"
" eller uppdaterar från en POT-fil."

#. from yeager:weblate-review
msgid "Update language team header"
msgstr "Uppdatera rubriken för språkgruppen"

#. from yeager:weblate-review
msgid "Lets Weblate update the \"Language-Team\" file header."
msgstr "Låt Weblate uppdatera filrubriken \"Language-Team\"."

#. from yeager:weblate-review
msgid "Update last translator header"
msgstr "Uppdatera rubriken för den senaste översättaren"

#. from yeager:weblate-review
msgid "Lets Weblate update the \"Last-Translator\" file header."
msgstr "Låt Weblate uppdatera filrubriken \"Last-Translator\"."

#. from yeager:weblate-review
msgid "Update X-Generator header"
msgstr "Uppdatera X-Generator-rubriken"

#. from yeager:weblate-review
msgid "Lets Weblate update the \"X-Generator\" file header."
msgstr "Låt Weblate uppdatera filrubriken \"X-Generator\"."

#. from yeager:weblate-review
msgid "Report msgid bugs to"
msgstr "Rapportera msgid-fel till"

#. from yeager:weblate-review
msgid ""
"Lets Weblate update the \"Report-Msgid-Bugs-To\" file header if Source "
"string bug reporting address is set."
msgstr ""
"Låt Weblate uppdatera filrubriken \"Report-Msgid-Bugs-To\" om källsträngens "
"felrapporteringsadress är inställd."

#. from yeager:weblate-review
msgid "Deduplicate identical strings"
msgstr "Ta bort dubbletter av identiska strängar"

#. from yeager:weblate-review
msgid ""
"Consolidates identical source strings into a single translation unit. "
"Prevents translation loss during file restructuring or table reordering by "
"removing position-dependent context."
msgstr ""
"Sammanför identiska källsträngar till en enda översättningsenhet. Förhindrar"
" att översättningar går förlorade vid omstrukturering av filer eller "
"omordning av tabeller genom att ta bort positionsberoende sammanhang."

#. from yeager:weblate-review
msgid "File encoding"
msgstr "Filkodning"

#. from yeager:weblate-review
msgid "Encoding used for Java Properties files"
msgstr "Kodning som används för Java-egenskapsfiler"

#. from yeager:weblate-review
msgid "Escape spreadsheet formulas"
msgstr "Skydda kalkylbladsformler"

#. from yeager:weblate-review
msgid ""
"Prefix values that look like spreadsheet formulas with an apostrophe when "
"saving CSV files."
msgstr ""
"Inled värden som ser ut som kalkylbladsformler med en apostrof när CSV-filer"
" sparas."

#. from yeager:weblate-review
msgid "Encoding used for GWT Properties files"
msgstr "Kodning som används för GWT-egenskapsfiler"

#. from yeager:weblate-review
msgid "Use DOS line endings (\\r\\n) instead of UNIX line endings (\\n) in strings."
msgstr ""
"Använd DOS-radändelser (\\r\\n) istället för UNIX-radändelser (\\n) i "
"strängar."

#. from yeager:weblate-review
msgid "Maximum line length"
msgstr "Maximal radlängd"

#. from yeager:weblate-review
msgid "The maximum number of characters for each line in the output file."
msgstr "Det maximala antalet tecken för varje rad i utdatafilen."

#. from yeager:weblate-review
msgid "Extract code blocks"
msgstr "Extrahera kodblock"

#. from yeager:weblate-review
msgid ""
"Whether to extract translatable content from code blocks in Markdown and MDX"
" files."
msgstr ""
"Huruvida översättningsbart innehåll skall extraheras från kodblock i "
"Markdown- och MDX-filer."

#. from yeager:weblate-review
msgid "Extract front matter"
msgstr "Extrahera inledningen"

#. from yeager:weblate-review
msgid ""
"Whether to extract and translate YAML front matter blocks in Markdown and "
"MDX files."
msgstr ""
"Huruvida YAML-inledningsblock skall extraheras och översättas i Markdown- "
"och MDX-filer."

#. from yeager:weblate-review
msgid "Translate front matter values"
msgstr "Översätt inledningsblockens värden"

#. from yeager:weblate-review
msgid ""
"Parse YAML front matter and translate only scalar string values. Keys, "
"structure, comments, and formatting are preserved when possible."
msgstr ""
"Tolka YAML-inledningen och översätt endast skalära strängvärden. Nycklar, "
"poster, kommentarer och formatering bevaras när det är möjligt."

#. from yeager:weblate-review
msgid "Disable placeholders"
msgstr "Deaktivera platshållare"

#. from yeager:weblate-review
msgid ""
"Disables detection and processing of placeholders in Markdown and MDX files."
msgstr ""
"Inaktiverar identifiering och bearbetning av platshållare i Markdown- och "
"MDX-filer."

#. from yeager:weblate-review
msgid "Strings with source comments"
msgstr "Strängar med källkommentarer"

#. from yeager:weblate-review
msgid "Repository branch is required for this integration."
msgstr "Förrådsgrenen krävs för denna integration."

#. from yeager:weblate-review
msgid ""
"The string you wanted to translate could not be identified. Please reopen it"
" and try again."
msgstr ""
"Strängen som du ville översätta kunde inte identifieras. Öppna den igen och "
"försök på nytt."

#. from yeager:weblate-review
msgid "Insufficient privileges for reviewing strings."
msgstr "Otillräckliga behörigheter för att granska strängar."

#. from yeager:weblate-review
msgid "Enter a source component ID."
msgstr "Ange ett ID för källkomponenten."

#. from yeager:weblate-review
msgid ""
"With {count} or more eligible source components, a project/component path is"
" also accepted. In that case, component and project operations also accept a"
" component slug from the target project."
msgstr ""
"Med {count} eller fler kvalificerade källkomponenter godtas även en "
"projekt-/komponentsökväg. I så fall godtar komponent- och projektåtgärder "
"även en komponentidentifierare från målprojektet."

#. from yeager:weblate-review
msgid ""
"Leave blank to use eligible components from each target component's project."
msgstr ""
"Lämna tomt för att använda kvalificerade komponenter från varje "
"målkomponents projekt."

#. from yeager:weblate-review
msgid "Leave blank to use eligible components in the current workspace."
msgstr ""
"Lämna tomt för att använda kvalificerade komponenter i den aktuella "
"arbetsytan."

#. from yeager:weblate-review
msgid "All eligible components in current workspace"
msgstr "Alla kvalificerade komponenter i den aktuella arbetsytan"

#. from yeager:weblate-review
msgid "All eligible components in current project"
msgstr "Alla kvalificerade komponenter i det aktuella projektet"

#. from yeager:weblate-review
msgid "Eligible components from each target component's project"
msgstr "Kvalificerade komponenter från varje målkomponents projekt"

#. from yeager:weblate-review
msgid ""
"You can also enter a component slug from the current project or a "
"project/component path."
msgstr ""
"Du kan även ange en komponentidentifierare från det aktuella projektet eller"
" en projekt-/komponentsökväg."

#. from yeager:weblate-review
msgid "You can also enter a project/component path."
msgstr "Du kan även ange en projekt-/komponentsökväg."

#. from yeager:weblate-review
msgid "Enter component ID or project/component slug."
msgstr "Ange komponent-ID eller projekt-/komponent-slug."

#. from yeager:weblate-review
msgid ""
"Revert the latest translation edits from this user in the current project."
msgstr ""
"Återställ de senaste översättningsändringarna från den här användaren i det "
"nuvarande projektet."

#. from yeager:weblate-review
msgid "Reject all pending suggestions from this user in the current project."
msgstr ""
"Avvisa alla väntande förslag från den här användaren i det nuvarande "
"projektet."

#. from yeager:weblate-review
msgid "Delete all comments from this user in the current project."
msgstr ""
"Ta bort alla kommentarer från denna användare i det nuvarande projektet."

#. from yeager:weblate-review
msgid "Counting mode"
msgstr "Räkneläge"

#. from yeager:weblate-review
msgid ""
"Choose whether repeated changes on the same string are counted once or as "
"separate changes."
msgstr ""
"Välj om upprepade ändringar på samma sträng ska räknas en gång eller som "
"separata ändringar."

#. from yeager:weblate-review
msgid "Unique strings"
msgstr "Unika strängar"

#. from yeager:weblate-review
msgid "All changes"
msgstr "Alla ändringar"

#. from yeager:weblate-review
msgid "Search filter"
msgstr "Sökfilter"

#. from yeager:weblate-review
msgid "Base rate"
msgstr "Grundpris"

#. from yeager:weblate-review
msgid "Price per source word."
msgstr "Pris per ord från källtexten."

#. from yeager:weblate-review
msgid "Translation memory threshold"
msgstr "Tröskelvärde för översättningsminne"

#. from yeager:weblate-review
msgid "New strings rate"
msgstr "Pris för nya strängar"

#. from yeager:weblate-review
msgid "Needs editing rate"
msgstr "Pris för redigeringsbehov"

#. from yeager:weblate-review
msgid "Exact match rate"
msgstr "Pris för exakt matchning"

#. from yeager:weblate-review
msgid "Fuzzy match rate"
msgstr "Pris för ungefärling matchning"

#. from yeager:weblate-review
msgid "Repetition rate"
msgstr "Repetitionspris"

#. from yeager:weblate-review
msgid "Minimum changes per day"
msgstr "Minsta ändringar per dag"

#. from yeager:weblate-review
msgid "Maximum changes per day"
msgstr "Maximalt antal ändringar per dag"

#. from yeager:weblate-review
msgid "Maximum source words per day"
msgstr "Maximalt antal källord per dag"

#. from yeager:weblate-review
msgid "Inherit from workspace"
msgstr "Ärv från arbetsområdet"

#. from yeager:weblate-review
msgid "Inherit from project"
msgstr "Ärv från projektet"

#. from yeager:weblate-review
msgid "Inherit from category"
msgstr "Ärv från kategorin"

#. from yeager:weblate-review
msgid ""
"Inherited value is shown. Disable inheritance to edit the stored override."
msgstr ""
"Ärvt värde visas. Inaktivera arv för att redigera den lagrade "
"åsidosättningen."

#. from yeager:weblate-review
msgid "The category does not belong to the selected project."
msgstr "Kategorin tillhör inte det valda projektet."

#. from yeager:weblate-review
msgid "You do not have permission to change project access settings."
msgstr "Du har inte behörighet att ändra projektets åtkomstinställningar."

#. from yeager:weblate-review
msgid ""
"You must specify a license for these components to make them publicly "
"accessible:"
msgstr ""
"Du måste ange en licens för dessa komponenter för att göra dem publikt "
"tillgängliga:"

#. from yeager:weblate-review
msgid ""
"Uses and contributes to the pool of shared translations between projects in "
"the workspace."
msgstr ""
"Använder och bidrar till samlingen med delade översättningar mellan projekt "
"i arbetsområdet."

#. from yeager:weblate-review
msgid ""
"Enter the UUID of a workspace where you have permission to edit settings and"
" add projects."
msgstr ""
"Ange UUID för en arbetsyta där du har behörighet att redigera inställningar "
"och lägga till projekt."

#. from yeager:weblate-review
msgid ""
"Enter the UUID of a workspace where you have permission to edit settings and"
" add projects, or leave empty to move the project out of a workspace."
msgstr ""
"Ange UUID för en arbetsyta där du har behörighet att redigera inställningar "
"och lägga till projekt, eller lämna tomt om du vill flytta projektet från en"
" arbetsyta."

#. from yeager:weblate-review
msgid "No matching workspace found."
msgstr "Inget matchande arbetsområde hittades."

#. from yeager:weblate-review
msgid ""
"The backup is from an incompatible version (%(version)s). Please upgrade "
"your Weblate instance."
msgstr ""
"Säkerhetskopian kommer från en inkompatibel version (%(version)s). "
"Uppgradera din Weblate-instans."

#. from yeager:weblate-review
msgid "Delete translation memory created from this component"
msgstr "Ta bort översättningsminnet som skapats från denna komponent"

#. from yeager:weblate-review
msgid ""
"Project, workspace, and shared translation memory entries will be deleted. "
"Personal and uploaded entries will be preserved."
msgstr ""
"Projekt, arbetsområde och poster i delat översättningsminne kommer att "
"raderas. Personliga och uppladdade poster kommer att bevaras."

#. from yeager:weblate-review
msgid "Delete translation memory created from components in this category"
msgstr ""
"Ta bort översättningsminnet som skapats från komponenter i denna kategori"

#. from yeager:weblate-review
msgid "Limit languages for %(team)s"
msgstr "Begränsa språken för %(team)s"

#. from yeager:weblate-review
msgid "Turn on customization above to change these settings."
msgstr "Aktivera anpassning ovan för att ändra dessa inställningar."

#. from yeager:weblate-review
msgid ""
"Create existing project languages; contact maintainers for new languages"
msgstr "Skapa befintliga projektspråk; kontakta underhållarna för nya språk"

#. from yeager:weblate-review
msgid ""
"Component %(component)s was skipped because its linked repository is "
"unavailable."
msgstr ""
"Komponent %(component)s hoppades över eftersom dess länkade arkiv inte är "
"tillgängligt."

#. from yeager:weblate-review
msgid ""
"Allows anonymous access to the engage pages and status widgets for Private "
"and Custom projects."
msgstr ""
"Tillåter anonym åtkomst till engageringssidorna och statuswidgetarna för "
"privata och anpassade projekt."

#. from yeager:weblate-review
msgid "Public sharing"
msgstr "Offentlig delning"

#. from yeager:weblate-review
msgid "Do not specify both component and category!"
msgstr "Ange inte både komponent och kategori!"

#. from yeager:weblate-review
msgid "Inherit translation license"
msgstr "Ärv översättningslicens"

#. from yeager:weblate-review
msgid ""
"Use the translation license configured in the parent category or project."
msgstr ""
"Använd den översättningslicens som är konfigurerad i den överordnade "
"kategorin eller i projektet."

#. from yeager:weblate-review
msgid ""
"Contributor license agreement which needs to be approved before a user can "
"translate components in this category."
msgstr ""
"Licensavtal för bidragsgivare som måste godkännas innan en användare kan "
"översätta komponenter i denna kategori."

#. from yeager:weblate-review
msgid "Inherit contributor license agreement"
msgstr "Ärv licensavtal för bidragsgivare"

#. from yeager:weblate-review
msgid ""
"Use the contributor license agreement configured in the parent category or "
"project."
msgstr ""
"Använd licensavtalet för bidragsgivare som är konfigurerat i den överordnade"
" kategorin eller projektet."

#. from yeager:weblate-review
msgid "Inherit adding new translations"
msgstr "Ärv tillägg av nya översättningar"

#. from yeager:weblate-review
msgid ""
"Use the adding new translations setting configured in the parent category or"
" project."
msgstr ""
"Använd inställningen för att lägga till nya översättningar som har "
"konfigurerats i den överordnade kategorin eller projektet."

#. from yeager:weblate-review
msgid "Inherit language code style"
msgstr "Ärv språkkodsstil"

#. from yeager:weblate-review
msgid ""
"Use the language code style configured in the parent category or project."
msgstr ""
"Använd språkkodsstilen som konfigurerats i den överordnade kategorin eller "
"projektet."

#. from yeager:weblate-review
msgid "Inherit secondary language"
msgstr "Ärv sekundärt språk"

#. from yeager:weblate-review
msgid ""
"Use the secondary language configured in the parent category or project."
msgstr ""
"Använd det sekundära språket som har konfigurerats i överordnad kategori "
"eller projekt."

#. from yeager:weblate-review
msgid "Inherit commit message when translating"
msgstr "Ärv commit-meddelandet vid översättning"

#. from yeager:weblate-review
msgid ""
"Use the commit message when translating configured in the parent category or"
" project."
msgstr ""
"Använd commit-meddelandet vid översättning av konfigurerade element i den "
"överordnade kategorin eller projektet."

#. from yeager:weblate-review
msgid "Inherit commit message when adding translation"
msgstr "Ärv commit-meddelandet när en översättning läggs till"

#. from yeager:weblate-review
msgid ""
"Use the commit message when adding translation configured in the parent "
"category or project."
msgstr ""
"Använd commit-meddelandet när du lägger till översättning som konfigurerats "
"i den överordnade kategorin eller projektet."

#. from yeager:weblate-review
msgid "Inherit commit message when removing translation"
msgstr "Ärv commit-meddelandet när en översättning tas bort"

#. from yeager:weblate-review
msgid ""
"Use the commit message when removing translation configured in the parent "
"category or project."
msgstr ""
"Använd commit-meddelandet när du tar bort översättning som konfigurerats i "
"den överordnade kategorin eller projektet."

#. from yeager:weblate-review
msgid "Inherit commit message when merging translation"
msgstr "Ärv commit-meddelande när översättningen slås samman"

#. from yeager:weblate-review
msgid ""
"Use the commit message when merging translation configured in the parent "
"category or project."
msgstr ""
"Använd commit-meddelandet när du sammanfogar översättningar som "
"konfigurerats i den överordnade kategorin eller projektet."

#. from yeager:weblate-review
msgid "Inherit commit message when add-on makes a change"
msgstr "Ärv commit-meddelande när ett tillägg gör en ändring"

#. from yeager:weblate-review
msgid ""
"Use the commit message when add-on makes a change configured in the parent "
"category or project."
msgstr ""
"Använd commit-meddelandet när tillägget gör en ändring som konfigurerats i "
"den överordnade kategorin eller projektet."

#. from yeager:weblate-review
msgid "Inherit merge request message"
msgstr "Ärv meddelandet från sammanslagningsbegäran"

#. from yeager:weblate-review
msgid ""
"Use the merge request message configured in the parent category or project."
