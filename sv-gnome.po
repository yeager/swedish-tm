#. from gnome:gitg
msgid "Enable Monitoring"
msgstr "Aktivera övervakning"

#. from gnome:gitg
msgid "Automatically update when external changes to .git are detected"
msgstr "Uppdatera automatiskt då externa ändringar till .git upptäcks"

#. from gnome:gitg
msgid "Enable Diff Highlighting"
msgstr "Aktivera färgmarkering av diffar"

#. from gnome:gitg
msgid "Setting that determines whether to enable syntax highlighting in diff views."
msgstr "Inställning som bestämmer huruvida syntaxfärgmarkering ska aktiveras i diffvyer."

#. from gnome:gitg
msgid "Color scheme to use for syntax highlighting"
msgstr "Färgschema att använda för syntaxmarkering"

#. from gnome:gitg
msgid "Used by GtkSourceView to determine colors for syntax highlighting"
msgstr "Används av GtkSourceView för att bestämma färger för färgmarkering av syntax"

#. from gnome:gitg
msgid "When to Collapse Inactive Lanes"
msgstr "När inaktiva banor ska fällas ihop"

#. from gnome:gitg
msgid "Setting that indicates when an inactive lane should be collapsed. Valid values are 0 — 4, where 0 indicates “early” and 4 indicates “late”."
msgstr "Inställning som indikerar när en inaktiv bana ska fällas ihop. Giltiga värden är 0 — 4, där 0 indikerar ”tidigt” och 4 indikerar ”sent”."

#. from gnome:gitg
msgid "Setting that indicates whether to collapse history lanes which do not show activity. Enabling this can provide a cleaner history view when there is a lot of parallel development. See collapse-inactive-lanes to control when lanes should be collapsed."
msgstr "Inställning som indikerar huruvida historikbanor som inte har någon aktivitet ska fällas ihop. Att aktivera detta kan ge en renare historikvy när det finns mycket parallell utveckling. Se collapse-inactive-lanes för att kontrollera när banor ska kollapsa."

#. from gnome:gitg
msgid "Show History in Topological Order"
msgstr "Visa historik i topologisk ordning"

#. from gnome:gitg
msgid "Setting that indicates whether to show the history in topological order."
msgstr "Inställning som indikerar huruvida historiken ska visas i topologisk ordning."

#. from gnome:gitg
msgid "Show Stashed Changes"
msgstr "Visa stashade ändringar"

#. from gnome:gitg
msgid "Setting that indicates whether to show items for the stash in the history."
msgstr "Inställning som indikerar huruvida objekt ska visas för stashen i historiken."

#. from gnome:gitg
msgid "Show Staged Changes"
msgstr "Visa köade ändringar"

#. from gnome:gitg
msgid "Setting that indicates whether to show a virtual item for the currently staged changes in the history."
msgstr "Inställning som indikerar huruvida ett virtuellt objekt ska visas för de för närvarande köade ändringarna i historiken."

#. from gnome:gitg
msgid "Show Unstaged Changes"
msgstr "Visa oköade ändringar"

#. from gnome:gitg
msgid "Setting that indicates whether to show a virtual item for the currently unstaged changes in the history."
msgstr "Inställning som indikerar huruvida ett virtuellt objekt ska visas för de för närvarande oköade ändringarna i historiken."

#. from gnome:gitg
msgid "Mainline Head"
msgstr "Huvudlinjeshuvud"

#. from gnome:gitg
msgid "Setting that indicates whether to always preserve a mainline in the history for the current HEAD."
msgstr "Inställning som indikerar huruvida huvudlinjen alltid ska bevaras historiken för nuvarande HEAD."

#. from gnome:gitg
msgid "Default selection of the history activity"
msgstr "Standardval för historikaktiviteten"

#. from gnome:gitg
msgid "Setting that determines the default selection on startup of the history activity."
msgstr "Inställning som bestämmer standardvalet vid start av historikaktiviteten."

#. from gnome:gitg
msgid "Reference Sort Order"
msgstr "Sorteringsordning för referenser"

#. from gnome:gitg
msgid "The order by which references in the history sidebar should be sorted."
msgstr "Ordningen enligt vilken referenser i historiksidopanelen ska sorteras."

#. from gnome:gitg
msgid "Show Upstream With Branch"
msgstr "Visa uppström med gren"

#. from gnome:gitg
msgid "Determines whether to also show the upstream (remote) tracking branch when selecting a local branch in the history view."
msgstr "Avgör huruvida uppströmsgren (fjärr) också visas då en lokal gren väljs i historikvyn."

#. from gnome:gitg
msgid "Filter unknown refs"
msgstr "Filtrera okända referenser"

#. from gnome:gitg
msgid "Hide any ref different from refs/heads and refs/remotes."
msgstr "Dölj alla referenser som skiljer sig från refs/heads och refs/remotes."

#. from gnome:gitg
msgid "Switch to the new branch on creation"
msgstr "Växla till den nya grenen då den skapas"

#. from gnome:gitg
msgid "Setting that controls whether the newly created branch is checked out automatically."
msgstr "Inställning som styr huruvida den nyligen skapade grenen checkas ut automatiskt."

#. from gnome:gitg
msgid "Show Right Margin in Commit Message View"
msgstr "Visa högermarginal i vyn för incheckningsmeddelande"

#. from gnome:gitg
msgid "Show a right margin indicator in the commit message view. This can be used to easily see where to break the commit message at a particular column."
msgstr "Visa högermaginalsindikator i vyn för incheckningsmeddelanden. Denna kan användas för att lätt se vid vilken kolumn du bör bryta rader i incheckningsmeddelandet."

#. from gnome:gitg
msgid "Column at Which Right Margin is Shown"
msgstr "Kolumn vid vilken högermarginalen visas"

#. from gnome:gitg
msgid "The column at which the right margin is shown if the show-right-margin preference is set to TRUE."
msgstr "Kolumnen vid vilken högermarginalen visas om inställningen show-right-margin är satt till TRUE."

#. from gnome:gitg
msgid "Show Subject Margin in Commit Message View"
msgstr "Visa ämnesmarginal i vyn för incheckningsmeddelande"

#. from gnome:gitg
msgid "Highlight the subject text of the commit message when it passes the margin specified by subject-margin-position."
msgstr "Markera ämnestexten i incheckningsmeddelandet när den passerar marginalen angiven av subject-margin-position."

#. from gnome:gitg
msgid "Column at Which Subject Margin is Shown"
msgstr "Kolumn vid vilken ämnesmarginalen visas"

#. from gnome:gitg
msgid "The column at which the subject margin is shown if the show-subject-margin preference is set to TRUE."
msgstr "Kolumnen vid vilken ämnesmarginalen visas om inställningen show-subject-margin är satt till TRUE."

#. from gnome:gitg
msgid "Enable Spell Checking"
msgstr "Aktivera rättstavning"

#. from gnome:gitg
msgid "Setting which determines whether or not spell checking is enabled when writing a commit message."
msgstr "Inställning som bestämmer huruvida rättstavning är aktiverat vid inmatning av incheckningsmeddelande."

#. from gnome:gitg
msgid "Spell Checking Language"
msgstr "Rättstavningsspråk"

#. from gnome:gitg
msgid "The language to use when spell checking is enabled for writing a commit message."
msgstr "Språket som används när rättstavning är aktiverat för inmatning av incheckningsmeddelande."

#. from gnome:gitg
msgid "Maximum number of previous commit messages"
msgstr "Maximalt antal tidigare incheckningsmeddelanden"

#. from gnome:gitg
msgid "Maximum number of previous commit messages to store for commit message history."
msgstr "Maximalt antal tidigare incheckningsmeddelanden att lagra för historiken över incheckningsmeddelanden."

#. from gnome:gitg
msgid "Maximum number of days to store previous commit messages"
msgstr "Maximalt antal dagar att lagra tidigare incheckningsmeddelanden"

#. from gnome:gitg
msgid "Maximum number of days to store previous commit messages for commit message history."
msgstr "Maximalt antal dagar att lagra tidigare incheckningsmeddelanden för historiken över incheckningsmeddelanden."

#. from gnome:gitg
msgid "Type of datetime format selected."
msgstr "Vald typ av datetime-format."

#. from gnome:gitg
msgid "Preferred datetime format of the user."
msgstr "Föredraget datetime-format för användaren."

#. from gnome:gitg
msgid "The datetime format to be used in commit-diff."
msgstr "Det datetime-format som ska användas i incheckningsdiff."

#. from gnome:gitg
msgid "Custom datetime format."
msgstr "Anpassat datetime-format."

#. from gnome:gitg
msgid "Use patience algorithm to show diffs"
msgstr "Använd patience-algoritmen för att visa diffar"

#. from gnome:gitg
msgid "Setting to use patience algorithm to show diffs of a commit."
msgstr "Inställning för att använda patience-algoritmen för att visa diffar för en incheckning."

#. from gnome:gitg
msgid "Ignore Whitespace Changes"
msgstr "Ignorera tomrumsändringar"

#. from gnome:gitg
msgid "Setting that indicates whether to ignore whitespace changes when showing the diff of a commit."
msgstr "Inställning som indikerar huruvida tomrumsändringar ska ignoreras när diffen för en incheckning visas."

#. from gnome:gitg
msgid "Show Changes Inline"
msgstr "Visa ändringar inbäddade"

#. from gnome:gitg
msgid "Setting that indicates whether changes within lines should be shown inline."
msgstr "Inställning som indikerar huruvida ändringar inom rader ska visas inbäddade."

