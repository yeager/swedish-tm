msgid ""
"TEXTJOIN:the concatenation of the strings @{s1}, @{s2},… delimited by @{del}"
msgstr ""
"TEXTJOIN:konkateneringen av strängarna @{s1}, @{s2},… avgränsad av @{avg}"

