msgid "Source already set"
msgstr "Källa är redan angiven"

#. from gnome:gnome-packagekit
msgid "Failed with unknown error code."
msgstr "Misslyckades med okänd felkod."

#. from gnome:gnome-packagekit
msgid "There is no network connection available.\nPlease check your connection settings and try again."
msgstr "Det finns ingen nätverksanslutning tillgänglig.\nKontrollera dina anslutningsinställningar och försök igen."

#. from gnome:gnome-packagekit
msgid "The package list needs to be rebuilt.\nThis should have been done by the backend automatically."
msgstr "Paketlistan behöver byggas om.\nDetta bör ha gjorts automatiskt av bakänden."

#. from gnome:gnome-packagekit
msgid "The service that is responsible for handling user requests is out of memory.\nPlease restart your computer."
msgstr "Tjänsten som är ansvarig för att hantera användarbegäran har slut på minne.\nStarta om din dator."

#. from gnome:gnome-packagekit
msgid "A thread could not be created to service the user request."
msgstr "En tråd kunde inte skapas för att hantera användarbegäran."

#. from gnome:gnome-packagekit
msgid "The action is not supported by this backend.\nPlease report a bug in your distribution bug tracker as this should not have happened."
msgstr "Åtgärden stödjs inte av denna bakände.\nRapportera detta via felhanteringssystemet för din distribution eftersom detta inte ska hända."

#. from gnome:gnome-packagekit
msgid "A problem that we were not expecting has occurred.\nPlease report this bug in your distribution bug tracker with the error description."
msgstr "Ett problem som vi inte förväntade oss har inträffat.\nRapportera detta inklusive felbeskrivningen via felhanteringssystemet för din distribution."

#. from gnome:gnome-packagekit
msgid "A security trust relationship could not be made with package source.\nPlease check your security settings."
msgstr "En relation av säkerhetsförtroende kunde inte skapas med paketkällan.\nKontrollera dina säkerhetsinställningar."

#. from gnome:gnome-packagekit
msgid "The package that is trying to be removed or updated is not already installed."
msgstr "Paketet som försöker att tas bort eller uppdateras är inte redan installerat."

#. from gnome:gnome-packagekit
msgid "The package that is being modified was not found on your system or in any package source."
msgstr "Paketet som blir ändrat hittades inte på ditt system eller i någon paketkälla."

#. from gnome:gnome-packagekit
msgid "The package that is trying to be installed is already installed."
msgstr "Paketet som försöker att installeras är redan installerat."

#. from gnome:gnome-packagekit
msgid "The package download failed.\nPlease check your network connectivity."
msgstr "Hämtningen av paketet misslyckades.\nKontrollera din nätverksanslutning."

#. from gnome:gnome-packagekit
msgid "The group type was not found.\nPlease check your group list and try again."
msgstr "Grupptypen hittades inte.\nKontrollera din grupplista och försök igen."

#. from gnome:gnome-packagekit
msgid "The group list could not be loaded.\nRefreshing your cache may help, although this is normally a software source error."
msgstr "Grupplistan kunde inte läsas in.\nUppdatera din cache kan hjälpa även om detta oftast är ett fel i en programkälla."

#. from gnome:gnome-packagekit
msgid "A package could not be found that allows the action to complete.\nMore information is available in the detailed report."
msgstr "Ett paket kunde inte hittas som gör att åtgärden kan färdigställas.\nMer information finns tillgänglig i den detaljerade rapporten."

#. from gnome:gnome-packagekit
msgid "The search filter was not correctly formed."
msgstr "Sökfiltret var inte korrekt formaterat."

#. from gnome:gnome-packagekit
msgid "The package identifier was not well formed when sent to the server.\nThis normally indicates an internal error and should be reported."
msgstr "Paketidentifieraren var inte korrekt formaterad när den skickades till servern.\nDetta indikerar oftast ett internt fel och bör rapporteras."

#. from gnome:gnome-packagekit
msgid "An unspecified transaction error has occurred.\nMore information is available in the detailed report."
msgstr "Ett ospecificerat transaktionsfel har inträffat.\nMer information finns tillgänglig i den detaljerade rapporten."

#. from gnome:gnome-packagekit
msgid "The remote package source name was not found.\nYou may need to enable an item in Package Sources."
msgstr "Fjärrnamnet på programkällan hittades inte.\nDu kan behöva att aktivera ett objekt i Paketkällor."

#. from gnome:gnome-packagekit
msgid "Removing a protected system package is not allowed."
msgstr "Borttagning av ett skyddat systempaket tillåts inte."

#. from gnome:gnome-packagekit
msgid "The action was canceled successfully and no packages were changed."
msgstr "Åtgärden avbröts och inga paket blev ändrade."

#. from gnome:gnome-packagekit
msgid "The action was canceled successfully and no packages were changed.\nThe backend did not exit cleanly."
msgstr "Åtgärden avbröts och inga paket blev ändrade.\nBakänden avslutades inte på ett korrekt sätt."

#. from gnome:gnome-packagekit
msgid "The native package configuration file could not be opened.\nPlease make sure configuration is valid."
msgstr "Den distributionsspecifika paketkonfigurationsfilen kunde inte öppnas.\nFörsäkra dig om att konfigurationen är giltig."

#. from gnome:gnome-packagekit
msgid "The action cannot be canceled at this time."
msgstr "Åtgärden kan inte avbrytas just nu."

#. from gnome:gnome-packagekit
msgid "Source packages are not normally installed this way.\nCheck the extension of the file you are trying to install."
msgstr "Källpaket installeras vanligtvis inte på detta sätt.\nKontrollera filändelsen på filen som du försöker att installera."

#. from gnome:gnome-packagekit
msgid "The license agreement was not agreed to.\nTo use this software you have to accept the license."
msgstr "Licensvillkoret har inte godkänts.\nDu måste godkänna licensen för att använda denna programvara."

#. from gnome:gnome-packagekit
msgid "Two packages provide the same file.\nThis is usually due to mixing packages from different sources."
msgstr "Två paket tillhandahåller samma fil.\nDetta sker oftast när man blandar paket från olika källor."

#. from gnome:gnome-packagekit
msgid "Multiple packages exist that are not compatible with each other.\nThis is usually due to mixing packages from different sources."
msgstr "Flera paket finns som inte är kompatibla med varandra.\nDetta sker oftast när man blandar paket från olika källor."

#. from gnome:gnome-packagekit
msgid "There was a (possibly temporary) problem connecting to a package source.\nPlease check the detailed error for further details."
msgstr "Det inträffade ett (möjligen temporärt) problem vid anslutning till en paketkälla.\nKontrollera det detaljerade felet för ytterligare information."

#. from gnome:gnome-packagekit
msgid "Failed to initialize packaging backend.\nThis may occur if other packaging tools are being used simultaneously."
msgstr "Misslyckades med att initiera paketeringsbakände.\nDetta kan inträffa om andra paketeringsverktyg används samtidigt."

#. from gnome:gnome-packagekit
msgid "Failed to close down the backend instance.\nThis error can normally be ignored."
msgstr "Misslyckades med att stänga av bakändesinstansen.\nDetta fel kan oftast ignoreras."

#. from gnome:gnome-packagekit
msgid "Cannot get the exclusive lock on the packaging backend.\nPlease close any other legacy packaging tools that may be open."
msgstr "Kan inte få ensamt lås på paketeringsbakäden.\nStäng alla andra pakteringsverktyg som kan vara öppnade."

#. from gnome:gnome-packagekit
msgid "None of the selected packages could be updated."
msgstr "Inget av de markerade paketen kunde uppdateras."

#. from gnome:gnome-packagekit
msgid "The repository configuration could not be modified."
msgstr "Förrådskonfigurationen kunde inte ändras."

#. from gnome:gnome-packagekit
msgid "Installing the local file failed.\nMore information is available in the detailed report."
msgstr "Installationen av den lokala filen misslyckades.\nMer information finns tillgänglig i den detaljerade rapporten."

#. from gnome:gnome-packagekit
msgid "The package security signature could not be verified."
msgstr "Paketets säkerhetssignatur kunde inte valideras."

#. from gnome:gnome-packagekit
msgid "The package security signature is missing and this package is untrusted.\nThis package was not signed when created."
msgstr "Paketets säkerhetssignatur saknades och detta paket är inte pålitligt.\nDetta paket blev inte signerat när det skapades."

#. from gnome:gnome-packagekit
msgid "Repository configuration was invalid and could not be read."
msgstr "Förrådskonfigurationen var ogiltig och kunde inte läsas."

#. from gnome:gnome-packagekit
msgid "The package you are attempting to install is not valid.\nThe package file could be corrupt, or not a proper package."
msgstr "Paketet som du försöker att installera är inte giltigt.\nPaketfilen kan vara skadad eller så är den inte ett korrekt paket."

#. from gnome:gnome-packagekit
msgid "Installation of this package prevented by your packaging system’s configuration."
msgstr "Installation av detta paket förhindrades av konfigurationen för ditt paketsystem."

#. from gnome:gnome-packagekit
msgid "The package that was downloaded is corrupt and needs to be downloaded again."
msgstr "Paketet som hämtades ner är skadat och behöver hämtas ner igen."

#. from gnome:gnome-packagekit
msgid "All of the packages selected for install are already installed on the system."
msgstr "Alla paket markerade för installation är redan installerade på systemet."

#. from gnome:gnome-packagekit
msgid "The specified file could not be found on the system.\nCheck the file still exists and has not been deleted."
msgstr "Den angivna filen kunde inte hittas på systemet.\nKontrollera att filen fortfarande finns och att den inte har tagits bort."

#. from gnome:gnome-packagekit
msgid "Required data could not be found on any of the configured package sources.\nThere were no more download mirrors that could be tried."
msgstr "Nödvändig data kunde inte hittas på någon av de konfigurerade paketkällorna.\nDet finns inga fler hämtningsservrar som kunde letas igenom."

#. from gnome:gnome-packagekit
msgid "Required upgrade data could not be found in any of the configured package sources.\nThe list of distribution upgrades will be unavailable."
msgstr "Nödvändig uppgraderingsdata kunde inte hittas på någon av de konfigurerade paketkällorna.\nListan över distributionsuppgraderingar kommer inte att vara tillgänglig."

#. from gnome:gnome-packagekit
msgid "The package that is trying to be installed is incompatible with this system."
msgstr "Paketet som försöker att installeras är inte kompatibelt med detta system."

#. from gnome:gnome-packagekit
msgid "There is insufficient space on the device.\nFree some space on the system disk to perform this operation."
msgstr "Det finns inte tillräckligt mycket utrymme på enheten.\nFrigör utrymme på systemdisken för att genomföra denna åtgärd."

#. from gnome:gnome-packagekit
msgid "Additional media is required to complete the transaction."
msgstr "Ytterligare media krävs för att färdigställa transaktionen."

#. from gnome:gnome-packagekit
msgid "You have failed to provide correct authentication.\nPlease check any passwords or account settings."
msgstr "Du har misslyckats med att ange korrekt autentisering.\nKontrollera dina lösenord eller kontoinställningar."

#. from gnome:gnome-packagekit
msgid "The specified update could not be found.\nIt could have already been installed or no longer available on the remote server."
msgstr "Den angivna uppdateringen kunde inte hittas.\nDen kan redan vara installerad eller finns kanske inte längre tillgänglig på fjärrservern."

#. from gnome:gnome-packagekit
msgid "The package could not be installed from untrusted source."
msgstr "Paketet kunde inte installeras från opålitlig källa."

#. from gnome:gnome-packagekit
msgid "The package could not be updated from untrusted source."
msgstr "Paketet kunde inte uppdateras från opålitlig källa."

#. from gnome:gnome-packagekit
msgid "The file list is not available for this package."
msgstr "Fillistan finns inte tillgänglig för detta paket."

#. from gnome:gnome-packagekit
msgid "The information about what requires this package could not be obtained."
msgstr "Informationen om vad detta paket kräver kunde inte hämtas in."

#. from gnome:gnome-packagekit
msgid "The specified package source could not be disabled."
msgstr "Angivna paketkällan kunde inte inaktiveras."

#. from gnome:gnome-packagekit
msgid "The download could not be done automatically and should be done manually.\nMore information is available in the detailed report."
msgstr "Hämtningen kunde inte göras automatiskt och bör göras manuellt.\nMer information finns tillgänglig i den detaljerade rapporten."

#. from gnome:gnome-packagekit
msgid "One of the selected packages failed to configure correctly.\nMore information is available in the detailed report."
msgstr "Konfigurationen av ett av de markerade paketen misslyckades.\nMer information finns tillgänglig i den detaljerade rapporten."

#. from gnome:gnome-packagekit
msgid "One of the selected packages failed to build correctly.\nMore information is available in the detailed report."
msgstr "Byggnationen av ett av de markerade paketen misslyckades.\nMer information finns tillgänglig i den detaljerade rapporten."

#. from gnome:gnome-packagekit
msgid "One of the selected packages failed to install correctly.\nMore information is available in the detailed report."
msgstr "Installationen av ett av de markerade paketen misslyckades.\nMer information finns tillgänglig i den detaljerade rapporten."

#. from gnome:gnome-packagekit
msgid "One of the selected packages failed to be removed correctly.\nMore information is available in the detailed report."
msgstr "Borttagningen av ett av de markerade paketen misslyckades.\nMer information finns tillgänglig i den detaljerade rapporten."

#. from gnome:gnome-packagekit
msgid "A program is running that has to be closed before the update can proceed.\nMore information is available in the detailed report."
msgstr "Ett program körs som måste stängas innan uppdateringen kan fortsätta.\nMer information finns tillgänglig i den detaljerade rapporten."

#. from gnome:gnome-packagekit
msgid "The package database was changed while the request was running."
msgstr "Paketdatabasen ändrades under tiden som begäran kördes."

#. from gnome:gnome-packagekit
msgid "The virtual provide type is not supported by this system."
msgstr "Den virtuella leverantörstypen stödjs inte av detta system."

