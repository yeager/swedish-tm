"md5=eb18edc22b6d6d0dc0f8c1378acf4bd7"
msgstr ""
"@@image: 'images/using/dock-anchor-dialog.png'; md5=THIS FILE DOESN'T EXIST"

#. from gnome:reviewed/gimp-help — GIMP User Manual/master
msgid ""
"@@image: 'images/stock-icons/gimp-menu-left.svg'; "
"md5=bcd8b1befe4e36f3afb9c7850e702752"
