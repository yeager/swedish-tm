msgstr "Använd minikartan för att se mer av filen"

#. from gnome:builder-main.sv
msgid "Build Parallelism"
msgstr "Byggparallellisering"

#. from gnome:builder-main.sv
msgid "Number of workers to use when performing builds. -1 for sensible default. 0 for number of CPU."
msgstr "Antal arbetare att använda vid byggen. -1 för ett rimligt standardvärde. 0 för antal processorer."

