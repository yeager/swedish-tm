#. from gnome:reviewed/gimp-help — GIMP User Manual/master
msgid "<placeholder-1/> filter example"
msgstr "Exempel på filtret <placeholder-1/>"

#. from gnome:reviewed/gimp-help — GIMP User Manual/master
