msgstr "gedit"

#. from gnome:gedit
msgid "Edit text files"
msgstr "Redigera textfiler"

#. from gnome:gedit
msgid "Text;Editor;Plaintext;Write;gedit;"
msgstr "Text;Redigerare;Vanlig text;Skriv;gedit;"

#. from gnome:gedit
msgid "New Document"
msgstr "Nytt dokument"

#. from gnome:gedit
msgid "Use Default Font"
msgstr "Använd standardtypsnitt"

#. from gnome:gedit
msgid "Whether to use the system’s default fixed width font for editing text instead of a font specific to gedit. If this option is turned off, then the font named in the “Editor Font” option will be used instead of the system font."
msgstr "Huruvida systemets standardtypsnitt med fast breddsteg ska användas för redigering av text i stället för ett typsnitt som är specifikt för gedit. Om detta alternativ är inaktiverat, kommer typsnittet som är angivet i alternativet ”Redigerartypsnitt” att användas i stället för systemtypsnittet."

#. from gnome:gedit
msgid "'Monospace 12'"
msgstr "'Monospace 12'"

#. from gnome:gedit
msgid "Editor Font"
msgstr "Redigerartypsnitt"

#. from gnome:gedit
msgid "A custom font that will be used for the editing area. This will only take effect if the “Use Default Font” option is turned off."
msgstr "Ett anpassat typsnitt som används för redigeringsytan. Detta kommer endast att ha effekt om alternativet ”Använd standardtypsnitt” är frånslaget."

#. from gnome:gedit
msgid "Style Scheme for Light Theme Variant"
msgstr "Stilschema för ljus temavariant"

#. from gnome:gedit
msgid "The ID of a libgedit-gtksourceview style scheme used to color the main text area when the application has a light theme applied."
msgstr "ID för ett libgedit-gtksourceview-stilschema som används för att färga det huvudsakliga textområdet när ett ljust tema är tillämpat för programmet."

#. from gnome:gedit
msgid "Style Scheme for Dark Theme Variant"
msgstr "Stilschema för mörk temavariant"

#. from gnome:gedit
msgid "The ID of a libgedit-gtksourceview style scheme used to color the main text area when the application has a dark theme applied."
msgstr "ID för ett libgedit-gtksourceview-stilschema som används för att färga det huvudsakliga textområdet när ett mörkt tema är tillämpat för programmet."

#. from gnome:gedit
msgid "Create Backup Copies"
msgstr "Skapa säkerhetskopior"

#. from gnome:gedit
msgid "Whether gedit should create backup copies for the files it saves."
msgstr "Huruvida gedit ska skapa säkerhetskopior för filerna som sparas."

#. from gnome:gedit
msgid "Autosave"
msgstr "Spara automatiskt"

#. from gnome:gedit
msgid "Whether gedit should automatically save modified files after a time interval. You can set the time interval with the “Autosave Interval” option."
msgstr "Huruvida gedit automatiskt ska spara ändrade filer efter ett tidsintervall. Du kan ange tidsintervallet med alternativet ”Intervall för automatiskt sparande”."

#. from gnome:gedit
msgid "Autosave Interval"
msgstr "Intervall för automatiskt sparande"

#. from gnome:gedit
msgid "Number of minutes after which gedit will automatically save modified files. This will only take effect if the “Autosave” option is turned on."
msgstr "Antal minuter efter vilket gedit automatiskt kommer att spara ändrade filer. Detta har endast effekt då alternativet ”Spara automatiskt” är påslaget."

#. from gnome:gedit
msgid "Maximum Number of Undo Actions"
msgstr "Maximalt antal ångringsåtgärder"

#. from gnome:gedit
msgid "Maximum number of actions that gedit will be able to undo or redo. Use “-1” for unlimited number of actions."
msgstr "Maximalt antal åtgärder som gedit kan ångra eller göra om. Använd ”-1” för obegränsat antal åtgärder."

#. from gnome:gedit
msgid "Line Wrapping Mode"
msgstr "Radbrytningsläge"

#. from gnome:gedit
msgid "Specifies how to wrap long lines in the editing area. Use “none” for no wrapping, “word” for wrapping at word boundaries, and “char” for wrapping at individual character boundaries. Note that the values are case-sensitive, so make sure they appear exactly as mentioned here."
msgstr "Anger hur långa rader ska radbrytas i redigeringsytan. Använd ”none” för ingen radbrytning, ”word” för radbrytning vid ordgränser och ”char” för radbrytning vid enskilda teckengränser. Observera att det görs skillnad på versaler och gemener i värdena, så försäkra dig om att de visas exakt som de visas här."

#. from gnome:gedit
msgid "Last split mode choice for line wrapping mode"
msgstr "Senast valda uppdelningsläge för radbrytningsläge"

#. from gnome:gedit
msgid "Specifies the last split mode used with line wrapping mode, so that when wrapping mode is off we still remember the split mode choice. Use “word” for wrapping at word boundaries, and “char” for wrapping at individual character boundaries."
msgstr "Anger det senast valda uppdelningsläget för radbrytningsläge, så att vi fortfarande kommer ihåg inställt uppdelningsläge även då radbrytningsläget är inaktiverat. Använd ”word” för radbrytning vid ordgränser, och ”char” för radbrytning vid enskilda teckengränser."

#. from gnome:gedit
msgid "Tab Size"
msgstr "Tabulatorbredd"

#. from gnome:gedit
msgid "Specifies the number of spaces that should be displayed instead of Tab characters."
msgstr "Anger antalet blanksteg som ska visas i stället för tabulatortecken."

#. from gnome:gedit
msgid "Insert spaces"
msgstr "Infoga blanksteg"

#. from gnome:gedit
msgid "Whether gedit should insert spaces instead of tabs."
msgstr "Huruvida gedit ska infoga blanksteg i stället för tabulatortecken."

#. from gnome:gedit
msgid "Automatic indent"
msgstr "Automatisk indentering"

#. from gnome:gedit
msgid "Whether gedit should enable automatic indentation."
msgstr "Huruvida gedit ska aktivera automatisk indentering."

#. from gnome:gedit
msgid "Display Line Numbers"
msgstr "Visa radnummer"

#. from gnome:gedit
msgid "Whether gedit should display line numbers in the editing area."
msgstr "Huruvida gedit ska visa radnummer i redigeringsytan."

#. from gnome:gedit
#. from gnome:reviewed/meld/main
#. from gnome:reviewed/schemes/main
msgid "Highlight Current Line"
msgstr "Markera aktuell rad"

#. from gnome:gedit
msgid "Whether gedit should highlight the current line."
msgstr "Huruvida gedit ska färgmarkera den aktuella raden."

#. from gnome:gedit
msgid "Highlight Matching Brackets"
msgstr "Färgmarkera matchande parenteser"

#. from gnome:gedit
msgid "Whether gedit should highlight matching brackets."
msgstr "Huruvida gedit ska färgmarkera matchande parenteser."

#. from gnome:gedit
msgid "Display Right Margin"
msgstr "Visa högermarginal"

#. from gnome:gedit
msgid "Whether gedit should display the right margin in the editing area."
msgstr "Huruvida gedit ska visa högermarginalen i redigeringsytan."

#. from gnome:gedit
#. from gnome:reviewed/gnome-text-editor/main
msgid "Right Margin Position"
msgstr "Position för högermarginal"

#. from gnome:gedit
msgid "Specifies the position of the right margin."
msgstr "Anger positionen för högermarginalen."

#. from gnome:gedit
msgid "Smart Home End"
msgstr "Smarta Home och End"

#. from gnome:gedit
msgid "Specifies how the cursor moves when the HOME and END keys are pressed. Use “disabled” to always move at the start/end of the line, “after” to move to the start/end of the line the first time the keys are pressed and to the start/end of the text ignoring whitespaces the second time the keys are pressed, “before” to move to the start/end of the text before moving to the start/end of the line and “always” to always move to the start/end of the text instead of the start/end of the line."
msgstr "Anger hur markören flyttas när tangenterna HOME och END används. Använd ”disabled” för att alltid flytta till början/slutet av raden, ”after” för att flytta till början/slutet av raden första gången tangenterna används och till början/slutet av texten samt ignorera tomrum andra gången som tangenterna används, ”before” för att flytta till början/slutet av texten innan flytt till början/slutet av raden och ”always” för att alltid flytta till början/slutet av texten i stället för början/slutet av raden."

#. from gnome:gedit
msgid "Restore Previous Cursor Position"
msgstr "Återställ tidigare markörposition"

#. from gnome:gedit
msgid "Whether gedit should restore the previous cursor position when a file is loaded."
msgstr "Huruvida gedit ska återställa den tidigare markörpositionen när en fil läses in."

#. from gnome:gedit
msgid "Enable Syntax Highlighting"
msgstr "Aktivera syntaxmarkering"

#. from gnome:gedit
msgid "Whether gedit should enable syntax highlighting."
msgstr "Huruvida gedit ska aktivera syntaxmarkering."

#. from gnome:gedit
msgid "Enable Search Highlighting"
msgstr "Aktivera färgmarkering vid sökning"

#. from gnome:gedit
msgid "Whether gedit should highlight all the occurrences of the searched text."
msgstr "Huruvida gedit ska färgmarkera alla förekomster av söktexten."

#. from gnome:gedit
msgid "Ensure Trailing Newline"
msgstr "Försäkra efterliggande nyrad"

#. from gnome:gedit
msgid "Whether gedit will ensure that documents always end with a trailing newline."
msgstr "Huruvida gedit ska försäkra att dokument alltid avslutas med en efterliggande nyrad."

#. from gnome:gedit
msgid "Maximum File Size"
msgstr "Maximal filstorlek"

#. from gnome:gedit
msgid "The limit on the number of bytes to read when loading a document."
msgstr "Gränsen på antal byte att läsa då ett dokument läses in."

#. from gnome:gedit
msgid "Notebook Show Tabs Mode"
msgstr "Visningsläge för anteckningsblocksflikar"

#. from gnome:gedit
msgid "Specifies when to show the notebook tabs. Use “never” to never show the tabs, “always” to always show the tabs, and “auto” to show the tabs only when there is more than one tab. Note that the values are case-sensitive, so make sure they appear exactly as mentioned here."
msgstr "Anger när anteckningsblocksflikar ska visas. Använd ”never” för att aldrig visa flikarna, ”always” för att alltid visa flikarna och ”auto” för att visa flikarna endast när det finns fler än en flik. Observera att det görs skillnad på versaler och gemener i värdena, så försäkra dig om att de visas exakt som de visas här."

#. from gnome:gedit
msgid "Status Bar is Visible"
msgstr "Statusrad är synlig"

#. from gnome:gedit
msgid "Whether the status bar at the bottom of editing windows should be visible."
msgstr "Huruvida statusraden i nederkanten på redigeringsfönster ska vara synlig."

#. from gnome:gedit
msgid "Side panel is Visible"
msgstr "Sidopanelen är synlig"

#. from gnome:gedit
msgid "Whether the side panel at the left of editing windows should be visible."
msgstr "Huruvida sidopanelen till vänster i redigeringsfönstret ska vara synlig."

#. from gnome:gedit
msgid "Which theme variant to use"
msgstr "Vilken temavariant som ska användas"

#. from gnome:gedit
msgid "Print Syntax Highlighting"
msgstr "Skriv ut syntaxmarkering"

#. from gnome:gedit
msgid "Whether gedit should print syntax highlighting when printing documents."
msgstr "Huruvida gedit ska skriva ut syntaxmarkering vid utskrift av dokument."

#. from gnome:gedit
msgid "Print Header"
msgstr "Skriv ut huvud"

#. from gnome:gedit
msgid "Whether gedit should include a document header when printing documents."
msgstr "Huruvida gedit ska inkludera ett dokumenthuvud vid utskrift av dokument."

#. from gnome:gedit
msgid "Printing Line Wrapping Mode"
msgstr "Radbrytningsläge för utskrift"

#. from gnome:gedit
msgid "Specifies how to wrap long lines for printing. Use “none” for no wrapping, “word” for wrapping at word boundaries, and “char” for wrapping at individual character boundaries. Note that the values are case-sensitive, so make sure they appear exactly as mentioned here."
msgstr "Anger hur långa rader ska radbrytas vid utskrift. Använd ”none” för ingen radbrytning, ”word” för radbrytning vid ordgränser och ”char” för radbrytning vid enskilda teckengränser. Observera att det görs skillnad på versaler och gemener i värdena, så försäkra dig om att de visas exakt som de visas här."

#. from gnome:gedit
msgid "Print Line Numbers"
msgstr "Skriv ut radnummer"

#. from gnome:gedit
msgid "If this value is 0, then no line numbers will be inserted when printing a document. Otherwise, gedit will print line numbers every such number of lines."
msgstr "Om detta värde är 0 kommer inga radnummer att infogas vid utskrift av ett dokument. Annars kommer gedit att skriva ut radnummer med detta radintervall."

#. from gnome:gedit
msgid "'Monospace 9'"
msgstr "'Monospace 9'"

#. from gnome:gedit
msgid "Body Font for Printing"
msgstr "Texttypsnitt för utskrift"

#. from gnome:gedit
msgid "Specifies the font to use for a document’s body when printing documents."
msgstr "Anger det typsnitt som ska användas för dokumentets text vid utskrift av dokument."

#. from gnome:gedit
msgid "'Sans 11'"
msgstr "'Sans 11'"

#. from gnome:gedit
msgid "Header Font for Printing"
msgstr "Sidhuvudstypsnitt för utskrift"

#. from gnome:gedit
msgid "Specifies the font to use for page headers when printing a document. This will only take effect if the “Print Header” option is turned on."
msgstr "Anger det typsnitt som ska användas för sidhuvud vid utskrift av ett dokument. Detta kommer endast att ha effekt om alternativet ”Skriv ut huvud” är påslaget."

#. from gnome:gedit
msgid "'Sans 8'"
msgstr "'Sans 8'"

#. from gnome:gedit
msgid "Line Number Font for Printing"
msgstr "Radnummerstypsnitt för utskrift"

#. from gnome:gedit
msgid "Specifies the font to use for line numbers when printing. This will only take effect if the “Print Line Numbers” option is non-zero."
msgstr "Anger det typsnitt som ska användas för radnummer vid utskrift. Detta kommer endast att ha effekt om alternativet ”Skriv ut radnummer” inte är noll."

#. from gnome:gedit
msgid "Margin Left"
msgstr "Vänstermarginal"

#. from gnome:gedit
msgid "The left margin, in millimeters."
msgstr "Vänstermarginalen i millimeter."

#. from gnome:gedit
msgid "Margin Top"
msgstr "Övre marginal"

#. from gnome:gedit
msgid "The top margin, in millimeters."
msgstr "Överkantsmarginalen i millimeter."

#. from gnome:gedit
msgid "Margin Right"
msgstr "Högermarginal"

#. from gnome:gedit
msgid "The right margin, in millimeters."
msgstr "Högermarginalen i millimeter."

#. from gnome:gedit
msgid "Margin Bottom"
msgstr "Nedre marginal"

#. from gnome:gedit
msgid "The bottom margin, in millimeters."
msgstr "Nederkantsmarginalen i millimeter."

#. from gnome:gedit
msgid "Candidate Encodings"
msgstr "Kandidatkodningar"

#. from gnome:gedit
msgid "List of candidate encodings shown in the Character Encoding menu in the open/save file chooser. “CURRENT” represents the current locale encoding. Only recognized encodings are used. The default value is the empty list, in which case gedit will choose good defaults depending on the country and language."
msgstr "Lista över kandidatkodningar som visas i menyn Teckenkodning i väljaren öppna/spara fil. ”CURRENT” representerar kodningen för aktuell lokal. Enbart kodningar som känns igen används. Standardvärdet är en tom lista, i vilket fall gedit kommer att välja bra standardvärden beroende på land och språk."

#. from gnome:gedit
#. from gnome:reviewed/metacity/master
msgid "Maximized"
msgstr "Maximerad"

#. from gnome:gedit
msgid "Whether the main window should start maximized."
msgstr "Huruvida huvudfönstret ska starta i maximerat läge."

#. from gnome:gedit
msgid "The width of the main window."
msgstr "Bredden på huvudfönstret."

#. from gnome:gedit
msgid "The height of the main window."
msgstr "Höjden på huvudfönstret."

#. from gnome:gedit
msgid "Active plugins"
msgstr "Aktiva insticksmoduler"

#. from gnome:gedit
msgid "List of active plugins."
msgstr "Lista över aktiva insticksmoduler."

#. from gnome:gedit
msgid "Text editor"
msgstr "Textredigerare"

#. from gnome:gedit
msgid "gedit is an easy-to-use and general-purpose text editor. Its development started in 1998, at the beginnings of the GNOME project, with a good integration with that desktop environment."
msgstr "gedit är en lättanvänd universaltextredigerare. Den skapades 1998, i begynnelsen av GNOME, och har god integration med den skrivbordsmiljön."

#. from gnome:gedit
msgid "You can use it to write simple notes and documents, or you can enable more advanced features that are useful for software development."
msgstr "Du kan använda den för att skriva enkla anteckningar och dokument, eller så kan du aktivera mer avancerade funktioner som är användbara för programvaruutveckling."

#. from gnome:gedit
msgid "Multiple tabs, syntax highlighting and an integrated file browser in the side panel"
msgstr "Flera flikar, syntaxmarkering och en integrerad filbläddrare i sidopanelen"

#. from gnome:gedit
msgid "Show the application’s version"
msgstr "Visa programmets version"

#. from gnome:gedit
msgid "Display list of possible values for the encoding option"
msgstr "Visa en lista över möjliga värden för kodningsalternativet"

#. from gnome:gedit
msgid "Set the character encoding to be used to open the files listed on the command line"
msgstr "Ställ in den teckenkodning som ska användas för att öppna filerna som anges på kommandoraden"

#. from gnome:gedit
msgid "ENCODING"
msgstr "KODNING"

#. from gnome:gedit
msgid "Create a new top-level window in an existing instance of gedit"
msgstr "Skapa ett nytt topplagerfönster i en befintlig instans av gedit"

#. from gnome:gedit
msgid "Create a new document in an existing instance of gedit"
msgstr "Skapa ett nytt dokument i en befintlig instans av gedit"

#. from gnome:gedit
msgid "Open files and block process until files are closed"
msgstr "Öppna filer och blockera processen tills filer har stängts"

#. from gnome:gedit
msgid "Run gedit in standalone mode"
msgstr "Kör gedit i fristående läge"

#. from gnome:gedit
msgid "[FILE…] [+LINE[:COLUMN]]"
msgstr "[FIL…] [+RAD[:KOLUMN]]"

#. from gnome:gedit
msgid "There was an error displaying the help."
msgstr "Ett fel inträffade vid visning av hjälpen."

#. from gnome:gedit
msgid "Untitled Document %d"
msgstr "Namnlöst dokument %d"

#. from gnome:gedit
msgid "%s: invalid encoding."
msgstr "%s: ogiltig kodning."

#. from gnome:gedit
msgid "Hide panel"
msgstr "Dölj panel"

#. from gnome:gedit
msgid "If you don’t save, changes from the last minute will be permanently lost."
msgstr "Om du inte sparar kommer ändringar gjorda under den senaste minuten att vara borta för alltid."

#. from gnome:gedit
msgid "If you don’t save, changes from the last hour will be permanently lost."
msgstr "Om du inte sparar kommer ändringar gjorda under den senaste timmen att vara borta för alltid."

#. from gnome:gedit
msgid "Save changes to document “%s” before closing?"
msgstr "Spara ändringarna i dokumentet ”%s” innan stängning?"

#. from gnome:gedit
msgid "S_elect the documents you want to save:"
msgstr "_Välj de dokument som du vill spara:"

#. from gnome:gedit
msgid "If you don’t save, all your changes will be permanently lost."
