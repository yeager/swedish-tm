msgstr ""
"@@image: 'images/toolbox/tool-options-paintbrush.png'; "
"md5=bb378ffe8d76def675478e7b72698ffa"

#. from gnome:reviewed/gimp-help — GIMP User Manual/master
msgid ""
"The paintbrush tool paints fuzzy brush strokes. All strokes are rendered "
"using the current brush."
msgstr ""
"Penselverktyget målar mjuka penseldrag. Alla drag återges med den aktuella "
"penseln."

#. from gnome:reviewed/gimp-help — GIMP User Manual/master
msgid ""
"From the main menu: <menuchoice><guimenu>Tools</guimenu><guisubmenu>Paint "
"Tools</guisubmenu><guimenuitem>Paintbrush</guimenuitem></menuchoice>."
msgstr ""
"Från huvudmenyn: "
"<menuchoice><guimenu>Verktyg</guimenu><guisubmenu>Målningsverktyg</guisubmenu><guimenuitem>Pensel</guimenuitem></menuchoice>."

#. from gnome:reviewed/gimp-help — GIMP User Manual/master
msgid "By pressing the <keycap>P</keycap> keyboard shortcut."
msgstr "Genom att trycka på tangentbordsgenvägen <keycap>P</keycap>."

#. from gnome:reviewed/gimp-help — GIMP User Manual/master
msgid ""
"This key changes the paintbrush to a <link linkend=\"gimp-tool-color-"
"picker\">Color Picker</link>."
msgstr ""
"Den här tangenten ändrar penseln till <link linkend=\"gimp-tool-color-"
"picker\">Färgväljare</link>."

#. from gnome:reviewed/gimp-help — GIMP User Manual/master
msgid ""
"This key places the paintbrush into straight line mode. Holding "
"<keycap>Shift</keycap> while clicking <mousebutton>Button 1</mousebutton> "
"will generate a straight line. Consecutive clicks will continue drawing "
"straight lines that originate from the end of the last line."
msgstr ""
"Den här tangenten försätter penseln i räta linjens läge. Om du håller ned "
"<keycap>Skift</keycap> medan du klickar med <mousebutton>knapp "
"1</mousebutton> skapas en rät linje. Efterföljande klick fortsätter rita "
"räta linjer som utgår från slutet av föregående linje."

#. from gnome:reviewed/gimp-help — GIMP User Manual/master
msgid ""
"@@image: 'images/stock-icons/gimp-tool-ink.svg'; "
"md5=2efa55def3bb116bd00a35a65a60f290"
msgstr ""
"@@image: 'images/stock-icons/gimp-tool-ink.svg'; "
