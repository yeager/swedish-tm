msgid "Will cause the window action menu to appear when the title is right-clicked.\nThis experimental feature is still under development!\nWarning! In current feature state you will be unable to access the applet action menu via title-right click when this option is enabled! You may still do so by right-clicking the icon if it is not hidden. You may always change this setting from gconf-editor."
msgstr "Kommer att göra att åtgärdsmenyn för fönster visas när titeln högerklickas.\nDenna experimentella egenskap är under utveckling!\nVarning! I nuvarande tillstånd kommer du inte att kunna komma åt miniprogrammets åtgärdsmeny via titelhögerklick när detta alternativ är aktiverat! Du kan fortfarande göra det genom att högerklicka ikonen om den inte är dold. Du kan alltid ändra denna inställning med gconf-editor."

#. from gnome:gnome-applets
msgid "Window title for your GNOME Panel."
msgstr "Fönstertitel för din GNOME-panel."

#. from gnome:gnome-commander
msgid "GNOME Commander"
msgstr "GNOME Commander"

#. from gnome:gnome-commander
msgid "A file manager using dual-panel layout"
msgstr "En filhanterare som använder en layout med två paneler"

#. from gnome:gnome-commander
msgid "file;manager;folder;explore;disk;filesystem;"
msgstr "fil;hanterare;mapp;utforska;disk;filsystem;"

#. from gnome:gnome-commander
msgid "List of advanced rename tool profiles"
msgstr "Lista över profiler i avancerat namnbytesverktyg"

#. from gnome:gnome-commander
msgid "The entries in this array represent the profiles in the advanced rename tool with specific settings for each profile."
msgstr "Posterna i denna vektor representerar profilerna i det avancerade namnbytesverktyget med specifika inställningar för varje profil."

#. from gnome:gnome-commander
msgid "Advanced rename tool window width"
msgstr "Fönsterbredd för avancerat namnbytesverktyg"

#. from gnome:gnome-commander
msgid "This option defines the width of the advanced rename tool window."
msgstr "Detta alternativ definierar bredden på fönstret för det avancerade namnbytesverktyget."

#. from gnome:gnome-commander
msgid "Advanced rename tool window height"
msgstr "Fönsterhöjd för avancerat namnbytesverktyg"

#. from gnome:gnome-commander
msgid "This option defines the height of the advanced rename tool window."
msgstr "Detta alternativ definierar höjden på fönstret för det avancerade namnbytesverktyget."

#. from gnome:gnome-commander
msgid "Advanced rename tool template history"
msgstr "Mallhistorik för avancerat namnbytesverktyg"

#. from gnome:gnome-commander
msgid "This string array represents the history of templates in the advanced rename tool."
msgstr "Denna strängvektor representerar historiken över mallar i det avancerade namnbytesverktyget."

#. from gnome:gnome-commander
msgid "History of visited directories"
msgstr "Historik över besökta kataloger"

#. from gnome:gnome-commander
msgid "This string array represents the history of visited directories."
msgstr "Denna strängvektor representerar historiken över besökta kataloger."

#. from gnome:gnome-commander
msgid "Panel font"
msgstr "Paneltypsnitt"

#. from gnome:gnome-commander
msgid "A custom font that will be used for the file panels if the “Use default font” option is turned off."
msgstr "Ett anpassat typsnitt som kommer att användas för filpanelerna om alternativet ”Använd standardtypsnitt” är inaktiverat."

#. from gnome:gnome-commander
msgid "Filesize display mode"
msgstr "Visningsläge för filstorlek"

#. from gnome:gnome-commander
msgid "Defines how the filesize will be displayed in the associated panel column."
msgstr "Definierar hur filstorleken visas i den associerade panelkolumnen."

#. from gnome:gnome-commander
msgid "Permission display mode"
msgstr "Visa filrättigheter som"

#. from gnome:gnome-commander
msgid "Defines how the file permission will be displayed in the associated panel column."
msgstr "Definierar hur filrättigheter visas i den associerade panelkolumnen."

#. from gnome:gnome-commander
msgid "Graphical layout mode"
msgstr "Grafiskt layoutläge"

#. from gnome:gnome-commander
msgid "Defines the icon style of files and folders in the file panels."
msgstr "Definierar ikonstilen för filer och mappar i filpanelerna."

#. from gnome:gnome-commander
msgid "List row height"
msgstr "Listradhöjd"

#. from gnome:gnome-commander
msgid "Defines the height of a row in the file panel."
msgstr "Definierar höjden för en rad i filpanelen."

#. from gnome:gnome-commander
msgid "'%F %R'"
msgstr "'%F %R'"

#. from gnome:gnome-commander
msgid "Date format"
msgstr "Datumformat"

#. from gnome:gnome-commander
msgid "Format of the date in the file panel."
msgstr "Datumformatet i filpanelen."

#. from gnome:gnome-commander
msgid "List font"
msgstr "Listtypsnitt"

#. from gnome:gnome-commander
msgid "The font in the file panels."
msgstr "Typsnittet i filpanelerna."

#. from gnome:gnome-commander
msgid "Extension display mode"
msgstr "Visningsläge för filändelse"

#. from gnome:gnome-commander
msgid "Defines where the file name extension is displayed."
msgstr "Definierar om filändelsen visas."

#. from gnome:gnome-commander
msgid "Left mouse button mode"
msgstr "Vänstermusknappsläge"

#. from gnome:gnome-commander
msgid "Number of left mouse button clicks for opening a file or folder."
msgstr "Antal musklick på vänstra knappen för att öppna en fil eller en mapp."

#. from gnome:gnome-commander
msgid "Left mouse button unselects"
msgstr "Vänster musknapp avmarkerar"

#. from gnome:gnome-commander
msgid "Defines if a click on an unselected item unselects already selected items."
msgstr "Definierar om ett klick på ett ej valt objekt avmarkerar redan markerade objekt."

#. from gnome:gnome-commander
msgid "Right mouse button mode"
msgstr "Högermusknappsläge"

#. from gnome:gnome-commander
msgid "Defines what happens when the right mouse button is clicked on an item."
msgstr "Definierar vad som händer när den högra musknappen klickas på ett objekt."

#. from gnome:gnome-commander
msgid "Use trash"
msgstr "Använd papperskorg"

#. from gnome:gnome-commander
msgid "Defines if items should be moved to trash by default instead of really deleting them."
msgstr "Definierar om objekt ska flyttas till papperskorgen som standard i stället för att ta bort dem på riktigt."

#. from gnome:gnome-commander
msgid "Icon size"
msgstr "Ikonstorlek"

#. from gnome:gnome-commander
msgid "Size of icons in the file panel."
msgstr "Ikonstorlekar i filpanelen."

#. from gnome:gnome-commander
msgid "Icon scale quality"
msgstr "Skalningskvaliteten för ikoner"

#. from gnome:gnome-commander
msgid "Describes the different interpolation modes that can be used with the scaling functions."
msgstr "Definierar de olika interpoleringslägen som kan användas med skalningsfunktionerna."

#. from gnome:gnome-commander
msgid "MIME icon directory"
msgstr "MIME-ikonkatalog"

#. from gnome:gnome-commander
msgid "Directory in which MIME icons are located."
msgstr "Katalogen för MIME-ikoner."

#. from gnome:gnome-commander
msgid "Command line history"
msgstr "Kommandoradshistorik"

#. from gnome:gnome-commander
msgid "This string array represents the history of commands executed in the command line."
msgstr "Denna strängvektor representerar historiken för kommandon exekverade på kommandoraden."

#. from gnome:gnome-commander
msgid "Command line history length"
msgstr "Längd på kommandoradshistoriken"

#. from gnome:gnome-commander
msgid "Split between panels and command line"
msgstr "Uppdelning mellan paneler och kommandorad"

#. from gnome:gnome-commander
msgid "Determines the height of file panels in pixels. Remaining vertical space is allocated for the command line."
msgstr "Avgör höjden på filpaneler i bildpunkter. Återstående vertikalt utrymme allokeras för kommandoraden."

#. from gnome:gnome-commander
msgid "Horizontal orientation"
msgstr "Horisontell orientering"

#. from gnome:gnome-commander
msgid "Defines if the orientation of the file panels should be horizontal or not."
msgstr "Definierar om orienteringen för filpanelerna ska vara horisontell eller ej."

#. from gnome:gnome-commander
msgid "GUI update rate"
msgstr "GUI-uppdateringshastighet"

#. from gnome:gnome-commander
msgid "Update rate of the graphical user interface in 1/1000ths of a second."
msgstr "Uppdateringshastigheten för det grafiska användargränssnittet i tusendels sekunder."

#. from gnome:gnome-commander
msgid "Show device buttons"
msgstr "Visa enhetsknappar"

#. from gnome:gnome-commander
msgid "Defines if device buttons are shown."
msgstr "Definierar om enhetsknapparna visas."

#. from gnome:gnome-commander
msgid "Show device list"
msgstr "Visa enhetslista"

#. from gnome:gnome-commander
msgid "Defines if the list of devices is shown."
msgstr "Definierar om enhetslistan visas."

#. from gnome:gnome-commander
msgid "Show command line"
msgstr "Visa kommandorad"

#. from gnome:gnome-commander
msgid "Defines if command line is shown."
msgstr "Definierar om kommandoraden visas."

#. from gnome:gnome-commander
msgid "Defines if the toolbar is shown."
msgstr "Definierar om verktygsfältet visas."

#. from gnome:gnome-commander
msgid "Show buttonbar"
msgstr "Visa knapprad"

#. from gnome:gnome-commander
msgid "Defines if the buttonbar is shown."
msgstr "Definierar om knappraden visas."

#. from gnome:gnome-commander
msgid "Symlink string"
msgstr "Sträng för symboliska länkar"

#. from gnome:gnome-commander
msgid "This string defines the default name of a newly created symlink. Leave the string empty to use the default value which is hard coded into the program code. A “%s” will be expanded to the item name for which a link should be created."
msgstr "Denna sträng definierar standardnamnet för en nyskapad symbolisk länk. Lämna strängen tom för att använda standardvärdet som är hårdkodat i programkoden. Ett ”%s” kommer att expanderas till objektnamnet för vilket en länk ska skapas."

#. from gnome:gnome-commander
msgid "Main window width"
msgstr "Huvudfönstrets bredd"

#. from gnome:gnome-commander
msgid "This option defines the width of the main window."
msgstr "Detta alternativ definierar bredden på huvudfönstret."

#. from gnome:gnome-commander
msgid "List of bookmarks"
msgstr "Lista över bokmärken"

#. from gnome:gnome-commander
msgid "Each entry in this list represents a bookmark."
msgstr "Varje post i denna lista representerar ett bokmärke."

#. from gnome:gnome-commander
msgid "Bookmarks window width"
msgstr "Bokmärkesfönstrets bredd"

#. from gnome:gnome-commander
msgid "This option defines the width of the bookmarks window."
msgstr "Detta alternativ definierar bredden på bokmärkesfönstret."

#. from gnome:gnome-commander
msgid "Bookmarks window height"
msgstr "Bokmärkesfönstrets höjd"

#. from gnome:gnome-commander
msgid "This option defines the height of the bookmarks window."
msgstr "Detta alternativ definierar höjden på bokmärkesfönstret."

#. from gnome:gnome-commander
msgid "List of connections"
msgstr "Lista över anslutningar"

#. from gnome:gnome-commander
msgid "Each entry in this list represents a connection."
msgstr "Varje post i denna lista representerar en anslutning."

#. from gnome:gnome-commander
msgid "Main window height"
msgstr "Huvudfönstrets höjd"

#. from gnome:gnome-commander
msgid "This option defines the height of the main window."
msgstr "Detta alternativ definierar höjden på huvudfönstret."

#. from gnome:gnome-commander
msgid "Options dialog width"
msgstr "Bredd på dialogen för alternativ"

#. from gnome:gnome-commander
msgid "This setting defines the width of the options dialog window."
msgstr "Denna inställning definierar bredden på dialogfönstret för alternativ."

#. from gnome:gnome-commander
msgid "Options dialog height"
msgstr "Höjd på dialogen för alternativ"

#. from gnome:gnome-commander
msgid "This setting defines the height of the options dialog window."
msgstr "Denna inställning definierar höjden på dialogfönstret för alternativ."

#. from gnome:gnome-commander
msgid "Width of icon column"
msgstr "Bredd på ikonkolumnen"

#. from gnome:gnome-commander
msgid "This option defines the width of the icon column."
msgstr "Detta alternativ definierar bredden på ikonkolumnen."

#. from gnome:gnome-commander
msgid "Width of name column"
msgstr "Bredd på namnkolumnen"

#. from gnome:gnome-commander
msgid "This option defines the width of the name column."
msgstr "Detta alternativ definierar bredden på namnkolumnen."

#. from gnome:gnome-commander
msgid "Width of extension column"
msgstr "Bredd på filändelsekolumnen"

#. from gnome:gnome-commander
msgid "This option defines the width of the extension column."
msgstr "Detta alternativ definierar bredden på filändelsekolumnen."

#. from gnome:gnome-commander
msgid "Width of directory column"
msgstr "Bredd på katalogkolumnen"

#. from gnome:gnome-commander
msgid "This option defines the width of the directory column."
msgstr "Detta alternativ definierar bredden på katalogkolumnen."

#. from gnome:gnome-commander
msgid "Width of size column"
msgstr "Bredd på storlekskolumnen"

#. from gnome:gnome-commander
msgid "This option defines the width of the size column."
msgstr "Detta alternativ definierar bredden på storlekskolumnen."

#. from gnome:gnome-commander
msgid "Width of date column"
msgstr "Datumkolumnens bredd"

#. from gnome:gnome-commander
msgid "This option defines the width of the date column."
msgstr "Detta alternativ definierar bredden på datumkolumnen."

#. from gnome:gnome-commander
msgid "Width of permissions column"
msgstr "Bredd på rättighetskolumnen"

#. from gnome:gnome-commander
msgid "This option defines the width of the permissions column."
msgstr "Detta alternativ definierar bredden på rättighetskolumnen."

#. from gnome:gnome-commander
msgid "Width of owner column"
msgstr "Bredd på ägarkolumnen"

#. from gnome:gnome-commander
msgid "This option defines the width of the owner column."
msgstr "Detta alternativ definierar bredden på ägarkolumnen."

#. from gnome:gnome-commander
msgid "Width of group column"
msgstr "Bredd på gruppkolumnen"

#. from gnome:gnome-commander
msgid "This option defines the width of the group column."
msgstr "Detta alternativ definierar bredden på gruppkolumnen."

#. from gnome:gnome-commander
msgid "List of keybindings"
msgstr "Lista över tangentbindningar"

#. from gnome:gnome-commander
msgid "Each entry in this list represents a keybinding."
msgstr "Varje post i denna lista representerar en tangentbindning."

#. from gnome:gnome-commander
msgid "Main window state"
msgstr "Huvudfönstrets tillstånd"

#. from gnome:gnome-commander
msgid "The number represents the main window state, e.g. “maximized”, “fullscreen”, etc. and is calculated internally."
msgstr "Siffran representerar tillståndet för huvudfönstret, exempelvis ”maximerat”, ”helskärm” och så vidare, och beräknas internt."

#. from gnome:gnome-commander
msgid "Middle mouse button mode"
msgstr "Mittenmusknappläge"

#. from gnome:gnome-commander
msgid "Defines what happens when the middle mouse button is clicked."
msgstr "Definierar vad som händer när mittenmusknappen klickas."

#. from gnome:gnome-commander
msgid "Save directories on exit"
msgstr "Spara kataloger vid avslut"

#. from gnome:gnome-commander
msgid "Defines if the current directories are opened again when GNOME Commander is restarted."
msgstr "Definierar om de nuvarande katalogerna öppnas igen när GNOME Commander startas om."

#. from gnome:gnome-commander
msgid "Save tabs on exit"
msgstr "Spara flikar vid avslut"

#. from gnome:gnome-commander
msgid "Defines if the current open tabs are opened again when GNOME Commander is restarted."
msgstr "Definierar om de nuvarande öppna flikarna öppnas igen när GNOME Commander startas om."

#. from gnome:gnome-commander
msgid "Save directory history on exit"
msgstr "Spara kataloghistorik vid avslut"

#. from gnome:gnome-commander
msgid "Defines if the history of visited directories is saved on exit."
msgstr "Definierar om historiken över besökta kataloger sparas vid avslut."

#. from gnome:gnome-commander
msgid "Save commandline history on exit"
msgstr "Spara kommandoradshistorik vid avslut"

#. from gnome:gnome-commander
msgid "Defines if the history of commands in the commandline is saved on exit."
msgstr "Definierar om historiken över kommandon i kommandoraden sparas vid avslut."

#. from gnome:gnome-commander
msgid "Save search history on exit"
msgstr "Spara sökhistorik vid avslut"

#. from gnome:gnome-commander
msgid "Defines if the history of search patterns is saved on exit."
msgstr "Definierar om historiken över sökmönster sparas vid avslut."

#. from gnome:gnome-commander
msgid "Always show tab bar"
msgstr "Visa alltid flikraden"

#. from gnome:gnome-commander
msgid "Defines if the tab bar is always shown."
msgstr "Definierar om flikraden alltid visas."

#. from gnome:gnome-commander
msgid "Tab lock indicator"
msgstr "Fliklåsindikator"

#. from gnome:gnome-commander
msgid "Defines the style of the tab lock indicator."
msgstr "Definierar stilen på fliklåsindikatorn."

#. from gnome:gnome-commander
msgid "Case sensitive sorting"
msgstr "Skiftlägeskänslig sortering"

#. from gnome:gnome-commander
msgid "This option defines if sorting should be case sensitive."
msgstr "Detta alternativ definierar om sortering ska vara skiftlägeskänslig."

#. from gnome:gnome-commander
msgid "Treat symbolic links as regular files"
msgstr "Behandla symboliska länkar som vanliga filer"

#. from gnome:gnome-commander
msgid "This option defines if symbolic links should be treated as regular files. In the file panel they are listed between other files and not at the top if their target is not existing."
msgstr "Detta alternativ definierar om symboliska länkar ska behandlas som vanliga filer. I filpanelen listas de mellan andra filer och inte högst upp om deras mål inte finns."

#. from gnome:gnome-commander
msgid "Select directories when all is marked"
msgstr "Välj kataloger när allt är markerat"

#. from gnome:gnome-commander
msgid "This option defines if directories will be marked when all items in a file panel should be marked."
msgstr "Detta alternativ definierar huruvida kataloger kommer att markeras när alla objekt i en filpanel markeras."

#. from gnome:gnome-commander
msgid "Allow multiple instances"
msgstr "Tillåt flera instanser"

#. from gnome:gnome-commander
msgid "This option defines if multiple instances are allowed."
msgstr "Detta alternativ definierar om flera instanser tillåts."

#. from gnome:gnome-commander
msgid "Quick search exact match begin"
msgstr "Snabbsök exakt träff i början"

#. from gnome:gnome-commander
msgid "This option defines if quick search should match explicitly at the beginning of an item name."
msgstr "Detta alternativ definierar huruvida en snabbsökning ska få träff explicit i början av ett objektsnamn."

#. from gnome:gnome-commander
msgid "Quick search exact match end"
msgstr "Snabbsök exakt träff i slutet"

#. from gnome:gnome-commander
msgid "This option defines if quick search should match explicitly at the end of an item name."
msgstr "Detta alternativ definierar om en snabbsökning får en träff explicit i slutet av ett objektsnamn."

#. from gnome:gnome-commander
msgid "Only device icons"
msgstr "Endast enhetsikoner"

#. from gnome:gnome-commander
msgid "This option defines if only device icons should be shown instead of icons and text label."
msgstr "Detta alternativ definierar om endast enhetsikoner ska visas i stället för ikoner och textetiketter."

#. from gnome:gnome-commander
msgid "Show the samba workgroups icon"
msgstr "Visa ikonen för samba-arbetsgrupper"

#. from gnome:gnome-commander
msgid "This option defines if the Samba workgroups icon should be shown in the devices list."
msgstr "Det här alternativet definierar om Samba-arbetsgruppsikonen ska visas i enhetslistan."

#. from gnome:gnome-commander
msgid "Main menu visibility"
msgstr "Synlighet på huvudmeny"

#. from gnome:gnome-commander
msgid "This option defines if the main menu is visible or not."
msgstr "Detta alternativ definierar om huvudmenyn är synlig eller ej."

#. from gnome:gnome-commander
msgid "Quick search shortcut"
msgstr "Kortkommando för snabbsökning"

#. from gnome:gnome-commander
msgid "This option defines the shortcut for quick search."
msgstr "Detta alternativ definierar kortkommandot för snabbsökningen."

#. from gnome:gnome-commander
msgid "Legacy list of file tabs"
msgstr "Gammal lista över filflikar"

#. from gnome:gnome-commander
msgid "This setting is only present for backwards compatibility and will be removed in future."
msgstr "Denna inställning finns endast för bakåtkompatibilitet och kommer tas bort i framtiden."

#. from gnome:gnome-commander
msgid "List of file tabs"
msgstr "Lista över filflikar"

#. from gnome:gnome-commander
msgid "The entries in this list are used for restoring the tabs and their history from the last session."
msgstr "Posterna i denna lista används för att återställa flikarna från föregående session och deras historik."

#. from gnome:gnome-commander
msgid "List of devices - deprecated"
msgstr "Lista över enheter - föråldrad"

#. from gnome:gnome-commander
msgid "The entries in this list represent the devices configured by the user."
msgstr "Posterna i denna lista representerar enheterna som konfigurerats av användaren."

#. from gnome:gnome-commander
msgid "List of devices"
msgstr "Lista över enheter"

#. from gnome:gnome-commander
msgid "List of favorite apps"
msgstr "Lista över favoritprogram"

#. from gnome:gnome-commander
msgid "The entries in this list represent the favorite apps configured by the user."
msgstr "Posterna i denna lista representerar favoritprogrammen som konfigurerats av användaren."

#. from gnome:gnome-commander
msgid "Search window width"
msgstr "Sökfönstrets bredd"

#. from gnome:gnome-commander
msgid "This option defines the width of the search window."
msgstr "Detta alternativ definierar bredden på sökfönstret."

#. from gnome:gnome-commander
msgid "Search window height"
msgstr "Sökfönstrets höjd"

#. from gnome:gnome-commander
msgid "This option defines the height of the search window."
msgstr "Detta alternativ definierar höjden på sökfönstret."

#. from gnome:gnome-commander
msgid "Search window is transient"
msgstr "Sökfönstret är tillfälligt"

#. from gnome:gnome-commander
msgid "Defines if the search window is transient or if it can be minimized and moved behind the main window."
msgstr "Definierar om sökfönstret är tillfälligt eller om det kan minimeras och flyttas bakom huvudfönstret."

#. from gnome:gnome-commander
msgid "Search text history"
msgstr "Söktexthistorik"

#. from gnome:gnome-commander
msgid "This string array represents the history of text searches in the search tool."
msgstr "Denna strängvektor representerar historiken för textsökningar i sökverktyget."

#. from gnome:gnome-commander
msgid "Search pattern history"
msgstr "Sökmönsterhistorik"

#. from gnome:gnome-commander
msgid "This string array represents the history of regular expression searches in the search tool."
msgstr "Denna strängvektor representerar historiken för sökningar med reguljära uttryck i sökverktyget."

#. from gnome:gnome-commander
msgid "Legacy search tool profiles"
msgstr "Gamla sökverktygsprofiler"

#. from gnome:gnome-commander
msgid "List of search tool profiles"
msgstr "Lista över sökverktygsprofiler"

#. from gnome:gnome-commander
msgid "The entries in this array represent the profiles in the search tool with specific settings for each profile."
msgstr "Posterna i denna vektor representerar profilerna i sökverktyget med specifika inställningar för varje profil."

#. from gnome:gnome-commander
msgid "Quick connect URI"
msgstr "Snabbanslutnings-URI"

#. from gnome:gnome-commander
msgid "Unified resource identifier for quick connections."
msgstr "Enad resursidentifierare för snabba anslutningar."

#. from gnome:gnome-commander
msgid "Password for anonymous FTP connections"
msgstr "Lösenord för anonyma FTP-anslutningar"

#. from gnome:gnome-commander
msgid "This string defines the password for anonymous FTP connections."
msgstr "Denna sträng definierar lösenordet för anonyma FTP-anslutningar."

#. from gnome:gnome-commander
msgid "Confirm delete"
msgstr "Bekräfta borttagning"

#. from gnome:gnome-commander
msgid "Defines if deletion of an item should be confirmed."
msgstr "Definierar om borttagning av ett objekt ska bekräftas."

#. from gnome:gnome-commander
msgid "Delete default"
msgstr "Standard för borttagning"

#. from gnome:gnome-commander
msgid "This setting defines the default active option in the delete confirmation dialog."
msgstr "Denna inställning definierar standardalternativet i dialogen borttagningsbekräftelse."

#. from gnome:gnome-commander
msgid "Confirm copy overwrite"
msgstr "Bekräfta skriv över vid kopiering"

#. from gnome:gnome-commander
msgid "This option defines the default behavior when items will be overwritten by a copy command."
msgstr "Detta alternativ definierar standardbeteendet för när objekt kommer att skrivas över av ett kopieringskommando."

#. from gnome:gnome-commander
msgid "Confirm move overwrite"
msgstr "Bekräfta skriv över vid flytt"

#. from gnome:gnome-commander
msgid "This option defines the default behavior when items will be overwritten by a move command."
msgstr "Detta alternativ definierar standardbeteendet för när objekt kommer att skrivas över av ett flyttkommando."

#. from gnome:gnome-commander
msgid "Confirm mouse drag and drop"
msgstr "Bekräfta musåtgärderna dra-och-släpp"

#. from gnome:gnome-commander
msgid "This option defines the behavior of mouse drag and drop operations."
msgstr "Detta alternativ definierar beteendet för musåtgärderna dra-och-släpp."

#. from gnome:gnome-commander
msgid "Hide unknown filetypes"
msgstr "Dölj okända filtyper"

#. from gnome:gnome-commander
msgid "Hide files which type does not match to one of the other types."
msgstr "Dölj filer vars typ inte matcher mot en av de andra typerna."

#. from gnome:gnome-commander
msgid "Hide regular files"
msgstr "Dölj vanliga filer"

#. from gnome:gnome-commander
msgid "Hide directories"
msgstr "Dölj kataloger"

#. from gnome:gnome-commander
msgid "Hide symbolic links"
msgstr "Dölj symboliska länkar"

#. from gnome:gnome-commander
msgid "Hide special files, such as a socket, fifo, block devices, or character devices."
