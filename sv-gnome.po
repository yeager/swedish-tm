msgstr "Arbetskopia med köade och oköade ändringar"

#. from gnome:reviewed/gitte/main
msgid "Commit Graph"
msgstr "Incheckningsgraf"

#. from gnome:reviewed/gitte/main
msgid "Commit log viewer"
msgstr "Visare för incheckningslogg"

#. from gnome:reviewed/gitte/main
msgid "Split view of staged and unstaged changes"
msgstr "Delad vy över köade och oköade ändringar"

#. from gnome:reviewed/gitte/main
msgid "Push dialog"
msgstr "Sänddialog"

#. from gnome:reviewed/gitte/main
msgid "Pull dialog"
msgstr "Hämtningsdialog"

#. from gnome:reviewed/gitte/main
msgid "Signing status"
msgstr "Signeringsstatus"

#. from gnome:reviewed/gitte/main
msgid "Welcome screen"
msgstr "Välkomstskärm"

#. from gnome:reviewed/gitte/main
msgid "Start screen with repository list"
msgstr "Startskärm med arkivlista"

#. from gnome:reviewed/gitte/main
msgid "Create tag dialog"
msgstr "Skapa tagg-dialog"

#. from gnome:reviewed/gitte/main
msgid "Stashes view"
msgstr "Stashvy"

#. from gnome:reviewed/gitte/main
