#. from gnome:libgweather-main.sv
msgid "Temperature unit"
msgstr "Temperaturenhet"

#. from gnome:libgweather-main.sv
msgid "The unit of temperature used for showing weather. Valid values are “kelvin”, “centigrade” and “fahrenheit”."
msgstr "Enheten för temperatur som används för att visa väder. Giltiga värden är ”kelvin”, ”centigrade” och ”fahrenheit”."

#. from gnome:libgweather-main.sv
msgid "Distance unit"
msgstr "Avståndsenhet"

#. from gnome:libgweather-main.sv
msgid "The unit of distance used for showing weather (for example for visibility or for distance of important events). Valid values are “meters”, “km” and “miles”."
msgstr "Enheten för avstånd som används för att visa väder (till exempel för sikt eller för avstånd för viktiga händelser). Giltiga värden är ”meters”, ”km” och ”miles”."

#. from gnome:libgweather-main.sv
msgid "Speed unit"
msgstr "Hastighetsenhet"

#. from gnome:libgweather-main.sv
msgid "The unit of speed used for showing weather (for example for wind speed). Valid values are “ms” (meters per second), “kph” (kilometers per hour), “mph” (miles per hour), “knots” and “bft” (Beaufort scale)."
msgstr "Enheten för hastighet som används för att visa väder (till exempel för vindhastighet). Giltiga värden är ”ms” (meter per sekund), ”kph” (kilometer per timme), ”mph” (engelska miles per timme), ”knots” (knop) och ”bft” (Beaufort-skala)."

#. from gnome:libgweather-main.sv
msgid "Pressure unit"
msgstr "Tryckenhet"

#. from gnome:libgweather-main.sv
msgid "The unit of pressure used for showing weather. Valid values are “kpa” (kilopascal), “hpa” (hectopascal), “mb” (millibar, mathematically equivalent to 1 hPa but shown differently), “mm-hg” (millimeters of mercury), “inch-hg” (inches of mercury), “atm” (atmospheres)."
msgstr "Enheten för lufttryck som används för att visa väder. Giltiga värden är ”kpa” (kilopascal), ”hpa” (hektopascal), ”mb” (millibar, matematiskt likvärdig med 1 hPa men visas annorlunda), ”mm-hg” (millimeter kvicksilver), ”inch-hg” (tum av kvicksilver), ”atm” (atmosfärer)."

#. from gnome:libgweather-main.sv
msgid "('', 'KNYC', nothing)"
msgstr "('', 'ESSA', nothing)"

#. from gnome:libgweather-main.sv
msgid "The default location for the weather applet. The first field is the name that will be shown. If empty, it will be taken from the locations database. The second field is the METAR code for the default weather station. It must not be empty and must correspond to a <code> tag in the Locations.xml file. The third field is a tuple of (latitude, longitude), to override the value taken from the database. This is only used for sunrise and moon phase calculations, not for weather forecast."
msgstr "Standardplatsen för väderminiprogrammet. Första fältet är namnet som ska visas. Om tom kommer den att tas från platsdatabasen. Det andra fältet är METAR-koden för standardväderstationen. Det får inte vara tomt och måste motsvara en <code>-tagg i filen Locations.xml. Det tredje fältet är en tupel av (latitud, longitud), för att åsidosätta värdet som tas från databasen. Detta används endast för soluppgång och beräkningar för månfaser, inte för väderprognoser."

