msgid "Show hide _buttons"
msgstr "Visa dölj_knappar"

#. from gnome:gnome-panel
msgid "Arro_ws on hide buttons"
msgstr "P_ilar på döljknappar"

#. from gnome:gnome-panel
msgid "Background image:"
msgstr "Bakgrundsbild:"

#. from gnome:gnome-panel
msgid "Rotate image on vertical panel"
msgstr "Rotera bilden på vertikal panel"

#. from gnome:gnome-panel
msgid "Text color:"
msgstr "Textfärg:"

#. from gnome:gnome-panel
msgid "Applets"
msgstr "Miniprogram"

#. from gnome:gnome-panel
msgid "_Remove From Panel"
msgstr "_Ta bort från panelen"

#. from gnome:gnome-panel
msgid "Open URL: %s"
msgstr "Öppna URL: %s"

#. from gnome:gnome-panel
msgid "Open '%s'"
msgstr "Öppna ”%s”"

#. from gnome:gnome-panel
#. from gnome:reviewed/gtk/main
msgid "Open your personal folder"
msgstr "Öppna din hemmapp"

#. from gnome:gnome-panel
msgid "Browse all local and remote disks and folders accessible from this computer"
msgstr "Bläddra bland alla lokala och fjärrdiskar samt mappar åtkomliga från denna dator"

#. from gnome:gnome-panel
msgid "Browse bookmarked and local network locations"
msgstr "Bläddra bland bokmärkta och lokala nätverksplatser"

#. from gnome:gnome-panel
msgid "Delete this panel?"
msgstr "Ta bort denna panel?"

#. from gnome:gnome-panel
msgid "When a panel is deleted, the panel and its\nsettings are lost."
msgstr "När en panel tas bort förloras panelen och dess\ninställningar."

#. from gnome:gnome-panel
msgid "Cannot delete this panel"
msgstr "Kan inte ta bort denna panel"

#. from gnome:gnome-panel
msgid "You must always have at least one panel."
msgstr "Du måste alltid ha åtminstone en panel."

#. from gnome:gnome-panel
msgid "_Add to Panel..."
msgstr "_Lägg till i panelen…"

#. from gnome:gnome-panel
msgid "_Delete This Panel"
msgstr "_Ta bort denna panel"

#. from gnome:gnome-panel
msgid "_New Panel"
msgstr "_Ny panel"

#. from gnome:gnome-panel
msgid "Cannot create initial panel layout"
msgstr "Kan inte skapa initial panellayout"

#. from gnome:gnome-panel
msgid "Top Expanded Edge Panel"
