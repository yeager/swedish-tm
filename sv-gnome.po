msgstr "Aktivera kommandot"

#. from gnome:reviewed/gimp-help — GIMP User Manual/master
msgid ""
"You can access this command from the main menu through "
"<menuchoice><guimenu>Image</guimenu><guimenuitem>Zealous "
"Crop</guimenuitem></menuchoice>."
msgstr ""
"Du kommer åt kommandot via huvudmenyn: "
"<menuchoice><guimenu>Bild</guimenu><guimenuitem>Intensiv "
"beskärning</guimenuitem></menuchoice>."

