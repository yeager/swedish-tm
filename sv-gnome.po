msgstr "Beräkna ensidig derivata med trepunktsformel"

#. from gnome:genius
msgid "Return a function which is the periodic extension of f defined on the interval [a,b]"
msgstr "Returnera en funktion som är den periodiska utvidgningen av f definierad på intervallet [a,b]"

#. from gnome:genius
msgid "Integration by right hand rule"
msgstr "Integration med höger rektangelregel"

#. from gnome:genius
