msgid "Ci_pher"
msgstr "Chi_ffer"

#. from gnome:NetworkManager-openvpn
msgid "D_ata ciphers"
msgstr "D_atachiffer"

#. from gnome:NetworkManager-openvpn
msgid "Da_ta ciphers fallback"
msgstr "Reserv för da_tachiffer"

#. from gnome:NetworkManager-openvpn
msgid "Configure a cipher that is used to fall back to if we could not determine which cipher the peer is willing to use.\nconfig: data-ciphers-fallback"
msgstr "Konfigurera ett chiffer som används som reserv om vi inte kunde avgöra vilket chiffer motparten är redo att använda.\nkonfig: data-ciphers-fallback"

#. from gnome:NetworkManager-openvpn
