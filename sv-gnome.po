msgid ""
"@@image: 'images/toolbox/tool-options-move.png'; md5=THIS FILE DOESN'T EXIST"
msgstr ""
"@@image: 'images/toolbox/tool-options-move.png'; md5=THIS FILE DOESN'T EXIST"

#. from gnome:reviewed/gimp-help — GIMP User Manual/master
msgid "If Move is on <guiicon>Layer</guiicon>:"
msgstr "Om Flytta är inställt på <guiicon>Lager</guiicon>:"

#. from gnome:reviewed/gimp-help — GIMP User Manual/master
msgid ""
"<guilabel>Pick a layer or guide</guilabel>: On an image with several layers,"
" the mouse pointer turns to a crosshair when it goes over an element "
"belonging to the current layer. Then you can click-and-drag it. If the mouse"
" pointer has a small hand shape (showing that you do "
"<emphasis>not</emphasis> pick an element of the active layer), you will move"
" a non-active layer instead (it becomes the active layer while moving)."
msgstr ""
"<guilabel>Välj ett lager eller en hjälplinje</guilabel>: I en bild med flera"
" lager blir muspekaren ett hårkors när den passerar ett element som hör till"
" det aktuella lagret. Du kan sedan klicka och dra det. Om muspekaren har "
"formen av en liten hand (vilket visar att du <emphasis>inte</emphasis> "
"väljer ett element i det aktiva lagret) flyttar du i stället ett icke-aktivt"
" lager (det blir aktivt medan det flyttas)."

#. from gnome:reviewed/gimp-help — GIMP User Manual/master
msgid ""
"<guilabel>Move the active layer</guilabel>: Only the current layer will be "
"moved. This may be useful if you want to move a layer with transparent "
"areas, where you can easily pick the wrong layer."
msgstr ""
"<guilabel>Flytta det aktiva lagret</guilabel>: Endast det aktuella lagret "
"flyttas. Detta kan vara användbart om du vill flytta ett lager med "
"genomskinliga områden, där du lätt kan välja fel lager."

#. from gnome:reviewed/gimp-help — GIMP User Manual/master
msgid "If Move is on <guiicon>Path</guiicon>:"
msgstr "Om Flytta är inställt på <guiicon>Bana</guiicon>:"

#. from gnome:reviewed/gimp-help — GIMP User Manual/master
msgid ""
"<guilabel>Pick a path</guilabel>: That's the default option. The mouse "
"pointer turns to a small hand when it goes over a <link linkend=\"gimp-path-"
"dialog-using\">visible path</link>. Then you can move this path by click-"
"and-dragging it (it will be the active path while moving)."
msgstr ""
"<guilabel>Välj en bana</guilabel>: Detta är standardalternativet. Muspekaren"
" blir en liten hand när den passerar en <link linkend=\"gimp-path-dialog-"
"using\">synlig bana</link>. Du kan sedan flytta banan genom att klicka och "
"dra den (den blir den aktiva banan medan den flyttas)."

#. from gnome:reviewed/gimp-help — GIMP User Manual/master
msgid ""
"<guilabel>Move the active path</guilabel>: Only the current path will be "
"moved. You can change the current path in the <link linkend=\"gimp-path-"
"dialog\">Path Dialog</link>."
msgstr ""
"<guilabel>Flytta den aktiva banan</guilabel>: Endast den aktuella banan "
"flyttas. Du kan ändra den aktuella banan i <link linkend=\"gimp-path-"
"dialog\">Bandialogen</link>."

#. from gnome:reviewed/gimp-help — GIMP User Manual/master
msgid ""
"@@image: 'images/toolbox/toolbox-measure.png'; md5=THIS FILE DOESN'T EXIST"
msgstr ""
"@@image: 'images/toolbox/toolbox-measure.png'; md5=THIS FILE DOESN'T EXIST"

#. from gnome:reviewed/gimp-help — GIMP User Manual/master
msgid ""
"@@image: 'images/toolbox/measure-tool-options.png'; md5=THIS FILE DOESN'T "
"EXIST"
msgstr ""
"@@image: 'images/toolbox/measure-tool-options.png'; md5=THIS FILE DOESN'T "
