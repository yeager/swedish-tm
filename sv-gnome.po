msgstr "© Fractal-gruppen"

#. from gnome:reviewed/fractal/main
msgid "Name by"
msgstr "Namn av"

#. from gnome:reviewed/fractal/main
msgid "Session not found"
msgstr "Sessionen hittades inte"

