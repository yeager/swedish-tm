msgstr "cellular;mobilnätverk;wwan;telefoni;sim;mobil;"

#. from gnome:gnome-control-center
msgid "Utility to configure the GNOME desktop"
msgstr "Verktyg för att konfigurera GNOME-skrivbordet"

#. from gnome:gnome-control-center
msgid "Settings is the primary interface for configuring your system."
msgstr "Inställningar är det primära gränssnittet för att konfigurera ditt system."

#. from gnome:gnome-control-center
msgid "Display version number"
msgstr "Visa versionsnummer"

#. from gnome:gnome-control-center
msgid "Enable verbose mode. Specify multiple times to increase verbosity"
msgstr "Aktivera utförligt läge. Ange flera gånger för att öka utförligheten"

#. from gnome:gnome-control-center
msgid "Search for the string"
msgstr "Sök efter strängen"

#. from gnome:gnome-control-center
msgid "List possible panel names and exit"
msgstr "Lista möjliga panelnamn och avsluta"

#. from gnome:gnome-control-center
msgid "Panel to display"
msgstr "Panel att visa"

#. from gnome:gnome-control-center
msgid "[PANEL] [ARGUMENT…]"
msgstr "[PANEL] [ARGUMENT…]"

#. from gnome:gnome-control-center
msgid "© 1998 %s"
msgstr "© 1998 %s"

#. from gnome:gnome-control-center
msgid "Settings categories"
msgstr "Inställningskategorier"

#. from gnome:gnome-control-center
msgid "Available panels:"
msgstr "Tillgängliga paneler:"

#. from gnome:gnome-control-center
msgid "Search settings"
msgstr "Sök inställningar"

#. from gnome:gnome-control-center
msgid "Warning: Development Version"
msgstr "Varning: Utvecklingsversion"

#. from gnome:gnome-control-center
msgid "This version of Settings should only be used for development purposes. You may experience incorrect system behavior, data loss, and other unexpected issues. "
msgstr "Denna version av Inställningar bör endast användas i utvecklingssyfte. Du kan råka ut för felaktigt beteende hos systemet, dataförlust och andra oväntade problem. "

#. from gnome:gnome-control-center
msgid "_About Settings"
msgstr "_Om Inställningar"

#. from gnome:gnome-control-center
msgid "Preferences;Settings;"
msgstr "Inställningar;"

#. from gnome:gnome-control-center
msgid "The identifier for the last Settings panel to be opened"
msgstr "Identifieraren för den sista inställningspanelen som öppnades"

#. from gnome:gnome-control-center
msgid "The identifier for the last Settings panel to be opened. Unrecognised values will be ignored and the first panel in the list selected."
msgstr "Identifieraren för den sista inställningspanelen som öppnades. Okända värden kommer att ignoreras och den första panelen i listan väljs."

#. from gnome:gnome-control-center
msgid "Show warning when running a development build of Settings"
msgstr "Visa en varning då en utvecklingsversion av Inställningar körs"

#. from gnome:gnome-control-center
msgid "Whether Settings should show a warning when running a development build."
msgstr "Huruvida Inställningar ska visa en varning då en utvecklingsversion körs."

#. from gnome:gnome-control-center
msgid "Initial state of the window"
msgstr "Initialt fönstertillstånd"

#. from gnome:gnome-control-center
msgid "A tuple containing the initial width, height and maximized state of the app window."
msgstr "En tupel som innehåller programfönstrets initiala bredd, höjd och maximeringstillstånd."

#. from gnome:gnome-control-center
msgid "Panels"
msgstr "Paneler"

#. from gnome:gnome-control-center
msgid "Go back to previous panel"
msgstr "Gå tillbaka till föregående panel"

#. from gnome:gnome-control-center
msgid "Cancel search"
msgstr "Avbryt sökning"

#. from gnome:gnome-settings-daemon
msgid "Applications"
msgstr "Program"

#. from gnome:gnome-settings-daemon
msgid "Applications that have defined global shortcuts"
msgstr "Program som har globala kortkommandom definierade"

#. from gnome:gnome-settings-daemon
msgid "Keyboard shortcut definitions"
msgstr "Definitioner på tangentbordsgenvägar"

#. from gnome:gnome-settings-daemon
msgid "Smartcard removal action"
msgstr "Borttagningsåtgärd för smartkort"

#. from gnome:gnome-settings-daemon
msgid "Set this to one of “none”, “lock-screen”, or “force-logout”. The action will get performed when the smartcard used for log in is removed."
msgstr "Ställ in denna till en av ”none”, ”lock-screen” eller ”force-logout”. Åtgärden kommer att genomföras när det smartkort som används för inloggning tas bort."

#. from gnome:gnome-settings-daemon
msgid "Whether the tablet’s orientation is locked, or rotated automatically."
msgstr "Huruvida ritplattans orientering är låst eller roteras automatiskt."

#. from gnome:gnome-settings-daemon
msgid "Mouse button orientation"
msgstr "Musknappsplacering"

#. from gnome:gnome-settings-daemon
msgid "Swap left and right mouse buttons for left-handed mice."
msgstr "Byt plats på vänster och höger musknapp för vänsterhänta möss."

#. from gnome:gnome-settings-daemon
msgid "Acceleration multiplier for mouse motion. A value of -1 is the system default."
msgstr "Accelerationsmultiplikator för musrörelse. Ett värde på -1 är systemets standard."

#. from gnome:gnome-settings-daemon
msgid "Distance in pixels the pointer must move before accelerated mouse motion is activated. A value of -1 is the system default."
msgstr "Avstånd i bildpunkter som markören måste röra sig innan accelererad musrörelse aktiveras. Ett värde på -1 är systemets standard."

#. from gnome:gnome-settings-daemon
msgid "Middle button emulation"
msgstr "Emulering av mittenknapp"

#. from gnome:gnome-settings-daemon
msgid "Enables middle mouse button emulation through simultaneous left and right button click."
msgstr "Aktiverar emulering av musens mittenknapp genom samtidigt klick på vänster- och högerknapp."

#. from gnome:gnome-settings-daemon
msgid "Double click time"
msgstr "Tid för dubbelklick"

#. from gnome:gnome-settings-daemon
msgid "Length of a double click in milliseconds."
msgstr "Längd för ett dubbelklick i millisekunder."

#. from gnome:gnome-settings-daemon
msgid "Drag threshold"
msgstr "Tröskelvärde för dragning"

#. from gnome:gnome-settings-daemon
msgid "Distance before a drag is started."
msgstr "Avstånd innan en dragning påbörjas."

#. from gnome:gnome-settings-daemon
msgid "Key Repeat Interval"
msgstr "Tangentupprepningsintervall"

#. from gnome:gnome-settings-daemon
msgid "Delay between repeats in milliseconds."
msgstr "Fördröjning mellan upprepningar i millisekunder."

#. from gnome:gnome-settings-daemon
msgid "Initial Key Repeat Delay"
msgstr "Fördröjning innan inledande tangentupprepning"

#. from gnome:gnome-settings-daemon
msgid "Initial key repeat delay in milliseconds."
msgstr "Fördröjning innan inledande tangentupprepning i millisekunder."

#. from gnome:gnome-settings-daemon
msgid "Remember NumLock state"
msgstr "Kom ihåg NumLock-tillstånd"

#. from gnome:gnome-settings-daemon
msgid "When set to true, GNOME will remember the state of the NumLock LED between sessions."
msgstr "När inställd till true (sant) kommer GNOME att komma ihåg tillståndet för NumLock-lampan mellan sessioner."

#. from gnome:gnome-settings-daemon
msgid "Disable touchpad while typing"
msgstr "Inaktivera styrplatta under skrivning"

#. from gnome:gnome-settings-daemon
msgid "Set this to TRUE if you have problems with accidentally hitting the touchpad while typing."
msgstr "Ställ in denna till TRUE (sant) om du har problem med oavsiktliga tryck på styrplattan när du skriver."

#. from gnome:gnome-settings-daemon
msgid "Enable horizontal scrolling"
msgstr "Aktivera horisontell rullning"

#. from gnome:gnome-settings-daemon
msgid "Set this to TRUE to allow horizontal scrolling by the same method selected with the scroll_method key."
msgstr "Ställ in denna till TRUE (sant) för att tillåta horisontell rullning med samma metod som valts med nyckeln scroll_method."

#. from gnome:gnome-settings-daemon
msgid "Select the touchpad scroll method"
msgstr "Välj rullningsmetod för styrplattan"

#. from gnome:gnome-settings-daemon
msgid "Select the touchpad scroll method. Supported values are: “disabled”, “edge-scrolling”, “two-finger-scrolling”."
msgstr "Välj rullningsmetod för styrplattan. Värden som stöds är: ”disabled”, ”edge-scrolling”, ”two-finger-scrolling”."

#. from gnome:gnome-settings-daemon
msgid "Enable mouse clicks with touchpad"
msgstr "Aktivera musklick med styrplatta"

#. from gnome:gnome-settings-daemon
msgid "Set this to TRUE to be able to send mouse clicks by tapping on the touchpad."
msgstr "Ställ in denna till TRUE (sant) för att kunna skicka musklick genom att trycka på styrplattan."

#. from gnome:gnome-settings-daemon
msgid "Enable touchpad"
msgstr "Aktivera styrplatta"

#. from gnome:gnome-settings-daemon
msgid "Set this to TRUE to enable all touchpads."
msgstr "Ställ in denna till TRUE (sant) för att aktivera alla styrplattor."

#. from gnome:gnome-settings-daemon
msgid "Touchpad button orientation"
msgstr "Knapplacering för styrplatta"

#. from gnome:gnome-settings-daemon
msgid "Swap left and right mouse buttons for left-handed mice with “left”, “right” for right-handed, “mouse” to follow the mouse setting."
msgstr "Byt plats på vänster och höger musknapp för vänsterhänta möss med ”left”, ”right” för högerhänta, ”mouse” för att följa musinställningen."

#. from gnome:gnome-settings-daemon
msgid "Natural scrolling"
msgstr "Naturlig rullning"

#. from gnome:gnome-settings-daemon
msgid "Set this to TRUE to enable natural (reverse) scrolling for touchpads."
msgstr "Ställ in denna till TRUE (sant) för att aktivera naturlig (omvänd) rullning för styrplattor."

#. from gnome:gnome-settings-daemon
msgid "Mouse wheel emulation button. 0 to disable the feature."
msgstr "Knapp för mushjulsemulering. 0 för att inaktivera funktionen."

#. from gnome:gnome-settings-daemon
msgid "Wacom stylus absolute mode"
msgstr "Absolut läge för Wacom-penna"

#. from gnome:gnome-settings-daemon
msgid "Enable this to set the tablet to absolute mode."
msgstr "Aktivera denna för att ställa in ritplattan till absolut läge."

#. from gnome:gnome-settings-daemon
msgid "Wacom tablet area"
msgstr "Område för Wacom-platta"

#. from gnome:gnome-settings-daemon
msgid "Set this to x1, y1 and x2, y2 of the area usable by the tools."
msgstr "Ställ in denna till x1, y1 och x2, y2 för området som ska användas av verktygen."

#. from gnome:gnome-settings-daemon
msgid "Wacom tablet aspect ratio"
msgstr "Bildförhållande för Wacom-platta"

#. from gnome:gnome-settings-daemon
msgid "Enable this to restrict the Wacom tablet area to match the aspect ratio of the output."
msgstr "Aktivera denna för att begränsa Wacom-plattans area till att matcha utmatningens bildförhållande."

#. from gnome:gnome-settings-daemon
msgid "Wacom tablet rotation"
msgstr "Rotation för Wacom-ritplatta"

#. from gnome:gnome-settings-daemon
msgid "Set this to “none”, “cw” for 90 degree clockwise, “half” for 180 degree, and “ccw” for 90 degree counterclockwise."
msgstr "Ställ in denna till ”none”, ”cw” för 90 grader medurs, ”half” för 180 grader, samt ”ccw” för 90 grader moturs."

#. from gnome:gnome-settings-daemon
msgid "Wacom touch feature"
msgstr "Styrplattefunktion för Wacom"

#. from gnome:gnome-settings-daemon
msgid "Enable this to move the cursor when the user touches the tablet."
msgstr "Aktivera denna för att flytta pekaren när användaren rör ritplattan."

#. from gnome:gnome-settings-daemon
msgid "Wacom stylus pressure curve"
msgstr "Tryckkurva för Wacom-penna"

#. from gnome:gnome-settings-daemon
msgid "Set this to x1, y1 and x2, y2 of the pressure curve applied to the stylus."
msgstr "Ställ in denna till x1, y1 och x2, y2 för tryckkurvan som tillämpas för pennan."

#. from gnome:gnome-settings-daemon
msgid "Wacom stylus button mapping"
msgstr "Knappmappning för Wacom-penna"

#. from gnome:gnome-settings-daemon
msgid "Set this to the logical button mapping."
msgstr "Ställ in denna till logisk knappmappning."

#. from gnome:gnome-settings-daemon
msgid "Wacom stylus pressure threshold"
msgstr "Tryckvärde för Wacom-penna"

#. from gnome:gnome-settings-daemon
msgid "Set this to the pressure value at which a stylus click event is generated."
msgstr "Ställ in denna till tryckvärdet vid vilket en pennklickshändelse genereras."

#. from gnome:gnome-settings-daemon
msgid "Wacom eraser pressure curve"
msgstr "Tryckkurva för Wacom-raderare"

#. from gnome:gnome-settings-daemon
msgid "Set this to x1, y1 and x2, y2 of the pressure curve applied to the eraser."
msgstr "Ställ in denna till x1, y1 och x2, y2 för tryckkurvan som tillämpas för raderaren."

#. from gnome:gnome-settings-daemon
msgid "Wacom eraser button mapping"
msgstr "Knappmappning för Wacom-raderare"

#. from gnome:gnome-settings-daemon
msgid "Wacom eraser pressure threshold"
msgstr "Tryckvärde för Wacom-raderare"

#. from gnome:gnome-settings-daemon
msgid "Set this to the pressure value at which an eraser click event is generated."
msgstr "Ställ in denna till tryckvärdet vid vilket en raderarklickshändelse genereras."

#. from gnome:gnome-settings-daemon
msgid "Wacom button action type"
msgstr "Åtgärdstyp för Wacom-knapp"

#. from gnome:gnome-settings-daemon
msgid "The type of action triggered by the button being pressed."
msgstr "Typen av åtgärd som utlöses av att knappen trycks ned."

#. from gnome:gnome-settings-daemon
msgid "Key combination for the custom action"
msgstr "Tangentkombination för anpassad åtgärd"

#. from gnome:gnome-settings-daemon
msgid "The keyboard shortcut generated when the button is pressed for custom actions."
msgstr "Tangentbordsgenvägen som genereras när knappen trycks ner för anpassade åtgärder."

#. from gnome:gnome-settings-daemon
msgid "Key combinations for a touchring or touchstrip custom action"
msgstr "Tangentkombinationer för en anpassad touchring- eller touchstrip-åtgärd"

#. from gnome:gnome-settings-daemon
msgid "The keyboard shortcuts generated when a touchring or touchstrip is used for custom actions (up followed by down)."
msgstr "Tangentbordsgenvägen som genereras när en touchring eller touchstrip används för anpassade åtgärder (upp följt av ner)."

#. from gnome:gnome-settings-daemon
msgid "Button label for OLED display."
msgstr "Knappetikett för OLED-skärm."

#. from gnome:gnome-settings-daemon
msgid "Label will be rendered to OLED display belonging to the button"
msgstr "Etikett kommer att renderas till OLED-skärm tillhörande denna knapp"

#. from gnome:gnome-settings-daemon
msgid "The duration a display profile is valid"
msgstr "Tidslängden som en skärmprofil är giltig"

#. from gnome:gnome-settings-daemon
msgid "This is the number of days after which the display color profile is considered invalid."
msgstr "Detta är antalet dagar efter vilken skärmens färgprofil anses vara ogiltig."

#. from gnome:gnome-settings-daemon
msgid "The duration a printer profile is valid"
msgstr "Tidslängden som en skrivarprofil är giltig"

#. from gnome:gnome-settings-daemon
msgid "This is the number of days after which the printer color profile is considered invalid."
msgstr "Detta är antalet dagar efter vilken skrivarens färgprofil anses vara ogiltig."

#. from gnome:gnome-settings-daemon
msgid "If the night light mode is enabled"
msgstr "Om nattljusläge är aktiverat"

#. from gnome:gnome-settings-daemon
msgid "Night light mode changes the color temperature of your display when the sun has gone down or at preset times."
msgstr "Nattljusläge ändrar färgtemperaturen för din skärm då solen har gått ner eller vid förinställda tider."

#. from gnome:gnome-settings-daemon
msgid "Temperature of the display when enabled"
msgstr "Temperatur för skärmen då aktiverat"

#. from gnome:gnome-settings-daemon
msgid "This temperature in Kelvin is used to modify the screen tones when night light mode is enabled. Higher values are bluer, lower redder."
msgstr "Denna temperatur i Kelvin används för att ändra skärmtonerna då nattljusläge är aktiverat. Högre värden är mer blå, lägre värden mer röda."

#. from gnome:gnome-settings-daemon
msgid "Use the sunrise and sunset"
msgstr "Använd soluppgång och solnedgång"

#. from gnome:gnome-settings-daemon
msgid "Calculate the sunrise and sunset times automatically, from the current location."
msgstr "Beräkna tider för soluppgång och solnedgång automatiskt från aktuell plats."

#. from gnome:gnome-settings-daemon
msgid "The start time"
msgstr "Starttiden"

#. from gnome:gnome-settings-daemon
msgid "When “night-light-schedule-automatic” is disabled, use this start time in hours from midnight."
msgstr "Då ”night-light-schedule-automatic” är inaktiverat, använd denna starttid i timmar från midnatt."

#. from gnome:gnome-settings-daemon
msgid "The end time"
msgstr "Sluttiden"

#. from gnome:gnome-settings-daemon
msgid "When “night-light-schedule-automatic” is disabled, use this end time in hours from midnight."
msgstr "Då ”night-light-schedule-automatic” är inaktiverat, använd denna sluttid i timmar från midnatt."

#. from gnome:gnome-settings-daemon
msgid "The last detected position"
msgstr "Den senast upptäckta platsen"

#. from gnome:gnome-settings-daemon
msgid "When location services are available this represents the last detected location. The default value is an invalid value to ensure it is always updated at startup."
msgstr "Då platstjänster är tillgängliga representerar detta den senaste upptäckta platsen. Standardvärdet är ett ogiltigt värde för att säkerställa att det alltid uppdateras vid uppstart."

#. from gnome:gnome-settings-daemon
msgid "List of plugins that are allowed to be loaded"
msgstr "Lista över tillåtna laddningsbara insticksmoduler"

#. from gnome:gnome-settings-daemon
msgid "A list of strings representing the plugins that are allowed to be loaded (default: “all”). This is only evaluated on startup."
msgstr "En lista av strängar vilka representerar vilka insticksmoduler som tillåts läsas in (standard: ”all”). Detta utvärderas bara vid uppstart."

#. from gnome:gnome-settings-daemon
msgid "Mount paths to ignore"
msgstr "Monteringssökvägar att ignorera"

#. from gnome:gnome-settings-daemon
msgid "Specify a list of mount paths to ignore when they run low on space."
msgstr "Ange en lista över monteringssökvägar att ignorera när de får lågt diskutrymme."

#. from gnome:gnome-settings-daemon
msgid "Free percentage notify threshold"
msgstr "Tröskelvärde för avisering om ledigt utrymme (procent)"

#. from gnome:gnome-settings-daemon
msgid "Percentage free space threshold for initial warning of low disk space. If the percentage free space drops below this, a warning will be shown."
msgstr "Tröskelvärde för ledigt utrymme (procent) för initial varning om lågt diskutrymme. Om procentandelen ledigt utrymme sjunker under detta värde så kommer en varning att visas."

#. from gnome:gnome-settings-daemon
msgid "Subsequent free space percentage notify threshold"
msgstr "Tröskelvärde för efterföljande varning om lågt diskutrymme (procent)"

#. from gnome:gnome-settings-daemon
msgid "Specify the percentage that the free disk space should reduce by before issuing a subsequent warning."
msgstr "Ange procentandelen som det lediga diskutrymme ska minskas med innan en efterföljande varning ska visas."

#. from gnome:gnome-settings-daemon
msgid "Free space notify threshold"
msgstr "Tröskelvärde för avisering om ledigt utrymme"

#. from gnome:gnome-settings-daemon
msgid "Specify an amount in GB. If the amount of free space is more than this, no warning will be shown."
msgstr "Ange en mängd i GB. Om mängden ledigt utrymme är mer än detta så kommer ingen varning att visas."

#. from gnome:gnome-settings-daemon
msgid "Minimum notify period for repeated warnings"
msgstr "Minsta aviseringsperioden för upprepade varningar"

#. from gnome:gnome-settings-daemon
msgid "Specify a time in minutes. Subsequent warnings for a volume will not appear more often than this period."
msgstr "Ange en tid i minuter. Efterföljande varningar för en volym kommer inte att visas oftare än denna tidsperiod."

#. from gnome:gnome-settings-daemon
msgid "Whether donation reminders are enabled"
msgstr "Huruvida donationspåminnelser är aktiverade"

#. from gnome:gnome-settings-daemon
msgid "Enables or disables the low-frequency donation reminder notification."
msgstr "Aktiverar eller inaktiverar den lågfrekvent visade donationspåminnelsen."

#. from gnome:gnome-settings-daemon
msgid "Last time the donation reminder was shown"
msgstr "Senast som donationspåminnelsen visades"

#. from gnome:gnome-settings-daemon
msgid "Timestamp for the last time a donation reminder was shown."
msgstr "Tidsstämpeln för den senaste tiden som en donationspåminnelse visades."

#. from gnome:gnome-settings-daemon
msgid "Binding to launch the calculator."
msgstr "Bindning för att starta miniräknaren."

#. from gnome:gnome-settings-daemon
msgid "Launch settings"
msgstr "Uppstartsinställningar"

#. from gnome:gnome-settings-daemon
msgid "Binding to launch GNOME Settings."
msgstr "Bindning för att öppna GNOME Inställningar."

#. from gnome:gnome-settings-daemon
msgid "Binding to launch the email client."
msgstr "Bindning för att starta e-postklienten."

#. from gnome:gnome-settings-daemon
msgid "Binding to eject an optical disc."
msgstr "Bindning för att mata ut en optisk skiva."

#. from gnome:gnome-settings-daemon
msgid "Binding to launch the help browser."
msgstr "Bindning för att starta hjälpvisaren."

#. from gnome:gnome-settings-daemon
msgid "Binding to open the Home folder."
msgstr "Bindning för att öppna hemmappen."

#. from gnome:gnome-settings-daemon
msgid "Binding to launch the media player."
msgstr "Bindning för att starta mediaspelaren."

#. from gnome:gnome-settings-daemon
msgid "Binding to skip to next track."
msgstr "Bindning för att hoppa till nästa spår."

#. from gnome:gnome-settings-daemon
msgid "Binding to pause playback."
msgstr "Bindning för att göra paus i uppspelningen."

#. from gnome:gnome-settings-daemon
msgid "Binding to start playback (or toggle play/pause)."
msgstr "Bindning för att starta uppspelningen (eller växla spela/pausa)."

#. from gnome:gnome-settings-daemon
msgid "Binding to log out."
msgstr "Bindning för att logga ut."

#. from gnome:gnome-settings-daemon
msgid "Binding to skip to previous track."
msgstr "Bindning för att hoppa till föregående spår."

#. from gnome:gnome-settings-daemon
msgid "Binding to lock the screen."
msgstr "Bindning för att låsa skärmen."

#. from gnome:gnome-settings-daemon
msgid "Binding to launch the search tool."
msgstr "Bindning för att starta sökverktyget."

#. from gnome:gnome-settings-daemon
msgid "Binding to stop playback."
msgstr "Bindning för att stoppa uppspelningen."

#. from gnome:gnome-settings-daemon
msgid "Binding to lower the volume."
msgstr "Bindning för att sänka volymen."

#. from gnome:gnome-settings-daemon
msgid "Binding to mute/unmute the volume."
msgstr "Bindning för att tysta/aktivera ljudet."

#. from gnome:gnome-settings-daemon
msgid "Binding to raise the volume."
msgstr "Bindning för att höja volymen."

#. from gnome:gnome-settings-daemon
msgid "Binding to mute/unmute the microphone."
msgstr "Bindning för att tysta/aktivera mikrofonen."

#. from gnome:gnome-settings-daemon
msgid "Binding to launch the web browser."
msgstr "Bindning för att starta webbläsaren."

#. from gnome:gnome-settings-daemon
msgid "Toggle magnifier"
msgstr "Växla förstorare"

#. from gnome:gnome-settings-daemon
msgid "Binding to show the screen magnifier"
msgstr "Bindning för att visa skärmförstoraren"

#. from gnome:gnome-settings-daemon
msgid "Toggle screen reader"
msgstr "Växla skärmläsare"

#. from gnome:gnome-settings-daemon
msgid "Binding to start the screen reader"
msgstr "Bindning för att starta skärmläsaren"

#. from gnome:gnome-settings-daemon
msgid "Toggle on-screen keyboard"
msgstr "Växla skärmtangentbord"

#. from gnome:gnome-settings-daemon
msgid "Binding to show the on-screen keyboard"
msgstr "Bindning för att visa skärmtangentbordet"

