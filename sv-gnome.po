msgstr "Alla alternativ för filtret <placeholder-1/>"

#. from gnome:reviewed/gimp-help — GIMP User Manual/master
msgid "Original and Current previews"
msgstr "Förhandsvisning av original och aktuellt resultat"

#. from gnome:reviewed/gimp-help — GIMP User Manual/master
msgid ""
"Two previews display respectively before treatment and after treatment "
"images."
msgstr ""
"De två förhandsvisningarna visar bilden före respektive efter behandlingen."

#. from gnome:reviewed/gimp-help — GIMP User Manual/master
msgid "Sets what you want to preview:"
msgstr "Anger vad du vill förhandsvisa:"

#. from gnome:reviewed/gimp-help — GIMP User Manual/master
msgid "Entire image"
msgstr "Hela bilden"

#. from gnome:reviewed/gimp-help — GIMP User Manual/master
msgid ""
"<guilabel>Selection only</guilabel> : if a selection exists (default is the "
"whole image)."
msgstr ""
"<guilabel>Endast markering</guilabel>: om det finns en markering (standard "
"är hela bilden)."

#. from gnome:reviewed/gimp-help — GIMP User Manual/master
msgid ""
"<guilabel>Selection in context</guilabel> : the selection within the image."
msgstr "<guilabel>Markering i sammanhang</guilabel>: markeringen i bilden."

#. from gnome:reviewed/gimp-help — GIMP User Manual/master
