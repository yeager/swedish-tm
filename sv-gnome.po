#. from gnome:gnote
msgid "Gnote"
msgstr "Gnote"

#. from gnome:gnote
msgid "A simple note-taking application"
msgstr "Ett enkelt anteckningsprogram"

#. from gnome:gnote
msgid "Gnote is a simple note-taking application for GNOME desktop environment. It allows you to capture your ideas, link them together using WikiWiki-style links, group together in notebooks and some extra features for everyday use."
msgstr "Gnote är ett enkelt anteckningsprogram för skrivbordsmiljön GNOME. Det låter dig fånga dina idéer, länka samman dem med länkar av WikiWiki-stil, gruppera dem i anteckningsblock samt har några extra funktioner för daglig användning."

#. from gnome:gnote
msgid "Notes can be printed or exported as HTML documents."
msgstr "Anteckningar kan skrivas ut eller exporteras som HTML-dokument."

#. from gnome:gnote
msgid "Gnote also supports synchronization, making it simple to use it on multiple devices."
msgstr "Gnote stöder också synkronisering vilket gör det enkelt att använda på flera enheter."

#. from gnome:gnote
msgid "Take notes, link ideas, and stay organized"
msgstr "Skriv ner anteckningar, länka till idéer och håll dig organiserad"

#. from gnome:gnote
msgid "Note-taker"
msgstr "Anteckningsverktyg"

#. from gnome:gnote
msgid "notes;idea;link;organize;"
msgstr "notes;anteckningar;idé;länk;organisera;"

#. from gnome:gnote
msgid "New Note"
msgstr "Ny anteckning"

#. from gnome:gnote
msgid "Enable spellchecking"
msgstr "Aktivera stavningskontroll"

#. from gnome:gnote
msgid "If true, misspellings will be underlined in red, and correct spelling suggestions shown in the right-click menu."
msgstr "Om sant, så kommer felstavningar att understrykas med rött och förslag på korrekta stavningar visas i högerklicksmenyn."

#. from gnome:gnote
msgid "Automatically create links when typing"
msgstr "Skapa automatiskt länkar då du skriver"

#. from gnome:gnote
msgid "Enable this option to automatically create a link, when text matches note title."
msgstr "Aktivera detta alternativ för att automatiskt skapa en länk då text matchar titeln på en anteckning."

#. from gnome:gnote
msgid "Create links for URLs in notes"
msgstr "Skapa länkar för URL:er i anteckningar"

#. from gnome:gnote
msgid "Enable this option to create links for URLs in notes."
msgstr "Aktivera detta alternativ för att skapa länkar för URL:er i anteckningar."

#. from gnome:gnote
msgid "Enable WikiWord highlighting"
msgstr "Aktivera WikiOrd-färgmarkering"

#. from gnome:gnote
msgid "Enable this option to highlight words ThatLookLikeThis. Clicking the word will create a note with that name."
msgstr "Aktivera detta alternativ för att färgmarkera ord som SerUtSomDetta. Att klicka på ett sådant ord kommer att skapa en anteckning med det namnet."

#. from gnome:gnote
msgid "Enable Auto bulleted lists"
msgstr "Aktivera automatiska punktlistor"

#. from gnome:gnote
msgid "Enable this option if you want bulleted lists to be automatic when you place - or * at the beginning of a line."
msgstr "Aktivera detta alternativ om du vill att punktlistor ska vara automatiska när du placerar ett - eller * i början av en rad."

#. from gnome:gnote
msgid "Enable Middle-Click Paste On Icon"
msgstr "Aktivera inklistring vid mittenklick på ikon"

#. from gnome:gnote
msgid "Enable this option if you want to be able to middle-click the Gnote icon to paste timestamped content into the Start Here note."
msgstr "Aktivera detta alternativ om du vill kunna klistra in tidsstämplat innehåll i Börja här-anteckningen genom att mittenklicka på Gnote-ikonen."

#. from gnome:gnote
msgid "Enable custom font"
msgstr "Aktivera anpassat typsnitt"

#. from gnome:gnote
msgid "If true, the font name set in custom-font-face will be used as the font when displaying notes. Otherwise the desktop default font will be used."
msgstr "Om sant, så kommer typsnittet satt i custom-font-face att användas för att visa anteckningar. Annars så kommer skrivbordets standardtypsnitt att användas."

#. from gnome:gnote
msgid "Custom Font Face"
msgstr "Anpassat typsnitt"

#. from gnome:gnote
msgid "If enable-custom-font is true, the font name set here will be used as the font when displaying notes."
msgstr "Om enable-custom-font är sant så kommer typsnittets namn som ställts in här att användas för att visa anteckningar."

#. from gnome:gnote
msgid "Background color for the highlighted text"
msgstr "Bakgrundsfärg för den färgmarkerade texten"

#. from gnome:gnote
msgid "When text is highlighted, use this color for background. A string gdk_rgba_parse() accepts."
msgstr "Använd denna bakgrundsfärg när text är färgmarkerad. En sträng som gdk_rgba_parse() accepterar."

#. from gnome:gnote
msgid "Color for the highlighted text"
msgstr "Färg för den färgmarkerade texten"

#. from gnome:gnote
msgid "When text is highlighted, use this color for text. A string gdk_rgba_parse() accepts."
msgstr "Använd denna textfärg när text är färgmarkerad. En sträng som gdk_rgba_parse() accepterar."

#. from gnome:gnote
msgid "Start Here Note"
msgstr "”Börja här”-anteckning"

#. from gnome:gnote
msgid "The note URI of the note that should be considered the \"Start Here\" note, which is always placed at the bottom of the Gnote note menu and also accessible by hotkey."
msgstr "Antecknings-URI:n för anteckningen som ska anses vara ”Börja här”-anteckningen, vilken alltid placeras i nederkant av Gnote-anteckningsmenyn och även är åtkomlig med en snabbtangent."

#. from gnome:gnote
msgid "Minimum number of notes to show in menu"
msgstr "Minimalt antal anteckningar att visa i menyn"

#. from gnome:gnote
msgid "Integer determining the minimum number of notes to show in the Gnote note menu."
msgstr "Heltal som bestämmer minimalt antal anteckningar att visa i Gnotes anteckningsmeny."

#. from gnome:gnote
msgid "List of pinned notes"
msgstr "Lista över nålade anteckningar"

#. from gnome:gnote
msgid "Whitespace-separated list of note URIs for notes that should always appear in the Gnote note menu."
msgstr "Blankstegsseparerad lista över URI:er för anteckningar som alltid ska visas i Gnotes anteckningsmeny."

#. from gnome:gnote
msgid "Is main window maximized"
msgstr "Är huvudfönster maximerat"

#. from gnome:gnote
msgid "If true, Gnote window will be maximized."
msgstr "Om sant, så kommer Gnote-fönstret vara maximerat."

#. from gnome:gnote
msgid "Saved height of Search window"
msgstr "Sparad höjd för sökfönstret"

#. from gnome:gnote
msgid "Determines pixel height of Search window; stored on Gnote exit."
msgstr "Bestämmer bildpunktshöjd för sökfönstret; lagras när Gnote avslutas."

#. from gnome:gnote
msgid "Saved width of Search window"
msgstr "Sparad bredd för sökfönstret"

#. from gnome:gnote
msgid "Determines pixel width of Search window; stored on Gnote exit."
msgstr "Bestämmer bildpunktsbredd för sökfönstret; lagras när Gnote avslutas."

#. from gnome:gnote
msgid "Saved splitter position of Search window splitter."
msgstr "Sparad delningsposition för sökfönstret."

#. from gnome:gnote
msgid "Determines Search window splitter position in pixels; stored on Gnote exit."
msgstr "Bestämmer delningsposition för sökfönstret (i bildpunkter); lagras när Gnote avslutas."

#. from gnome:gnote
msgid "Saved sorting of the Search window."
msgstr "Sparad sortering för sökfönstret."

#. from gnome:gnote
msgid "Determines Search window initial sorting."
msgstr "Bestämmer ursprunglig sortering för sökfönstret."

#. from gnome:gnote
msgid "FUSE Mounting Timeout (ms)"
msgstr "Tidsgräns för FUSE-montering (ms)"

#. from gnome:gnote
msgid "Time (in milliseconds) Gnote should wait for a response when using FUSE to mount a sync share."
msgstr "Tid (i millisekunder) som Gnote ska vänta på ett svar när FUSE används för att montera en synkroniseringsutdelning."

#. from gnome:gnote
msgid "SSHFS Remote Synchronization Folder"
msgstr "Mapp för SSHFS-fjärrsynkronisering"

#. from gnome:gnote
msgid "Path on SSH server to Gnote synchronization directory (optional)."
msgstr "Sökväg på SSH-servern för Gnotes synkroniseringskatalog (valfritt)."

#. from gnome:gnote
msgid "SSHFS Synchronization Server URL"
msgstr "Server-URL för SSHFS-synkronisering"

#. from gnome:gnote
msgid "URL of SSH server containing Gnote synchronization directory."
msgstr "URL för SSH-servern som innehåller Gnotes synkroniseringskatalog."

#. from gnome:gnote
msgid "SSHFS Remote Synchronization User Name"
msgstr "Användarnamn för SSHFS-fjärrsynkronisering"

#. from gnome:gnote
msgid "User name to use when connecting to the synchronization server via SSH."
msgstr "Användarnamnet att använda vid anslutning till synkroniseringsservern via SSH."

#. from gnome:gnote
msgid "SSHFS Synchronization Server Port"
msgstr "Serverport för SSHFS-synkronisering"

#. from gnome:gnote
msgid "The port to use when connecting to the synchronization server via SSH."
msgstr "Porten att använda vid anslutning till synkroniseringsservern via SSH."

#. from gnome:gnote
msgid "Link Updating Behavior on Note Rename"
msgstr "Beteende för länkuppdatering vid namnbyte"

#. from gnome:gnote
msgid "Integer value indicating if there is a preference to always perform a specific link updating behavior when a note is renamed, instead of prompting the user. The values map to an internal enumeration. 0 indicates that the user wishes to be prompted when renaming a note may impact links that exist in other notes. 1 indicates that links should automatically be removed. 2 indicates that link text should be updated to the new note name so that it will continue linking to the renamed note."
msgstr "Heltalsvärde som indikerar om det finns en inställning för att alltid genomföra ett specifikt beteende för länkuppdateringar när en anteckning byter namn, i stället för att fråga användaren. Värdena mappas till en intern numrering. 0 indikerar att användaren önskar att bli tillfrågad när en anteckning byter namn som kan påverka länkar som finns i andra anteckningar så att det nya anteckningsnamnet fortsätter att länka till anteckningen med nytt namn."

#. from gnome:gnote
msgid "Deprecated"
msgstr "Föråldrad"

#. from gnome:gnote
msgid "This key is deprecated and its value is ignored."
msgstr "Denna nyckel är föråldrad och dess värde ignoreras."

#. from gnome:gnote
msgid "Use status icon, when started as an application"
msgstr "Använd statusikon, när startad som ett program"

#. from gnome:gnote
msgid "Deprecated, has no effect."
msgstr "Föråldrad, har ingen effekt."

#. from gnome:gnote
msgid "This setting is deprecated and its value is ignored"
msgstr "Denna inställning är föråldrad och dess värde ignoreras"

#. from gnome:gnote
msgid "Use client side window decorations"
msgstr "Använd fönsterdekorationer från klientsidan"

#. from gnome:gnote
msgid "Should Gnote draw its window titlebar, or leave that to window manager. Possible values are 'enabled' to draw them, 'disabled' to leave them to window manager, or a comma separated list of desktop environments, where Gnote should draw decorations itself. Requires application restart."
msgstr "Ska Gnote rita sin namnlist för fönster, eller lämna det till fönsterhanteraren. Möjliga värden är \"enabled\" för att rita dem, \"disabled\" för att lämna dem till fönsterhanteraren, eller en kommaseparerad lista av skrivbordsmiljöer där Gnote ska rita dekorationer själv. Kräver omstart av programmet."

#. from gnome:gnote
msgid "Preferred color scheme to use"
msgstr "Föredraget färgschema att använda"

#. from gnome:gnote
msgid "The theme variant to use. Possible values are empty string to follow the system, 'dark' and 'light'."
msgstr "Temavarianten att använda. Möjliga värden är tom sträng för att följa systemet, ”dark” (mörk) och ”light” (ljus)."

#. from gnome:gnote
msgid "HTML Export Last Directory"
msgstr "HTML-exportera senaste katalogen"

#. from gnome:gnote
msgid "The last directory a note was exported to using the Export To HTML plugin."
msgstr "Senaste katalogen som en anteckning exporterades till med insticksmodulen ”Exportera till HTML”."

#. from gnome:gnote
msgid "HTML Export Linked Notes"
msgstr "HTML-exportera länkade anteckningar"

#. from gnome:gnote
msgid "The last setting for the 'Export linked notes' checkbox in the Export to HTML plugin."
msgstr "Senaste inställningen för kryssrutan ”Exportera länkade anteckningar” i insticksmodulen ”Exportera till HTML”."

#. from gnome:gnote
msgid "HTML Export All Linked Notes"
msgstr "HTML-exportera alla länkade anteckningar"

#. from gnome:gnote
msgid "The last setting for the 'Include all other linked notes' checkbox in the Export to HTML plugin. This setting is used in conjunction with the 'HTML Export Linked Notes' setting and is used to specify whether all notes (found recursively) should be included during an export to HTML."
msgstr "Den senaste inställningen för kryssrutan ”Inkludera alla andra länkade anteckningar” i insticksmodulen ”Exportera till HTML”. Den här inställningen används i kombination med inställningen för ”HTML-exportera länkade anteckningar” och används för att ange huruvida alla anteckningar (rekursivt hittade) ska inkluderas vid en HTML-exportering."

#. from gnome:gnote
msgid "Synchronization Client ID"
msgstr "ID för synkroniseringsklient"

#. from gnome:gnote
msgid "Unique identifier for this Gnote client, used when communicating with a synchronization server."
msgstr "Unik identifierare för den här Gnote-klienten, används vid kommunikation med en synkroniseringsserver."

#. from gnome:gnote
msgid "Synchronization Local Server Path"
msgstr "Lokal serversökväg för synkronisering"

#. from gnome:gnote
msgid "Path to the synchronization server when using the filesystem synchronization service addin."
msgstr "Sökväg till synkroniseringsservern när tilläggstjänsten för synkronisering av filsystem används."

#. from gnome:gnote
msgid "Selected Synchronization Service Addin"
msgstr "Valt tilläggstjänst för synkronisering"

#. from gnome:gnote
msgid "Unique identifier for the currently configured note synchronization service addin."
msgstr "Unik identifierare för den för närvarande konfigurerade tilläggstjänsten för synkronisering av anteckningar."

#. from gnome:gnote
msgid "Note Synchronization Conflict Saved Behavior"
msgstr "Sparat beteende för synkroniseringskonflikter för anteckningar"

#. from gnome:gnote
msgid "Integer value indicating if there is a preference to always perform a specific behavior when a conflict is detected, instead of prompting the user. The values map to an internal enumeration. 0 indicates that the user wishes to be prompted when a conflict occurs, so that they may handle each conflict situation on a case-by-case basis."
msgstr "Heltalsvärde som indikerar om det finns en inställning för att alltid genomföra ett specifikt beteende när en konflikt har upptäckts, i stället för att fråga användaren. Värdena mappas till en intern numrering. 0 indikerar att användaren önskar att bli tillfrågad när en konflikt uppstår, så att användaren kan hantera konflikten från fall till fall."

#. from gnome:gnote
msgid "Automatic Background Synchronization Timeout"
msgstr "Tidsgräns överskreds för automatisk bakgrundssynkronisering"

#. from gnome:gnote
msgid "Integer value indicating how frequently to perform a background sync of your notes (when sync is configured). Any value less than 1 indicates that autosync is disabled. The lowest acceptable positive value is 5. Value is in minutes."
msgstr "Heltalsvärde som indikerar hur frekvent en bakgrundssynkronisering kommer att genomföras av dina anteckningar (när synkronisering är konfigurerad). Alla värden mindre än 1 indikerar att automatisk synkronisering är inaktiverad. Det lägsta tillåtna positiva värdet är 5. Värdet anges i minuter."

#. from gnome:gnote
msgid "Online directory URI"
msgstr "URI för nätkatalog"

#. from gnome:gnote
msgid "URI to online directory where notes are synchronized to."
msgstr "URI till nätkatalog som anteckningar synkroniseras till."

#. from gnome:gnote
msgid "Accept SSL Certificates"
msgstr "Acceptera SSL-certifikat"

#. from gnome:gnote
msgid "Use wdfs option \"-ac\" to accept SSL certificates without prompting the user."
msgstr "Använd wdfs-flaggan ”-ac” för att acceptera SSL-certifikat utan att tillfråga användaren."

#. from gnome:gnote
msgid "Share URL"
msgstr "Utdelnings-URL"

#. from gnome:gnote
msgid "WebDAV share URL where notes are synchronized to."
msgstr "URL till WebDAV-utdelning som anteckningar synkroniseras till."

#. from gnome:gnote
msgid "Share username"
msgstr "Användarnamn för utdelning"

#. from gnome:gnote
msgid "Username to access WebDAV share."
msgstr "Användarnamn för att komma åt WebDAV-utdelning."

#. from gnome:gnote
msgid "Timestamp format"
msgstr "Format för tidsstämpel"

#. from gnome:gnote
msgid "The date format that is used for the timestamp. It follows the format of strftime(3)."
msgstr "Datumformatet som används för tidsstämpeln. Den följer formatet för strftime(3)."

#. from gnome:gnote
msgid "Time between checks"
msgstr "Tid mellan kontroller"

#. from gnome:gnote
msgid "Time interval between note directory checks (in seconds). Min value is 5."
msgstr "Tidsintervall mellan kontroller av anteckningskatalog (i sekunder). Minsta värde är 5."

#. from gnome:gnote
msgid "Open actions menu"
msgstr "Öppna åtgärdsmeny"

#. from gnome:gnote
msgid "Hide search bar"
msgstr "Dölj sökfältet"

#. from gnome:gnote
msgid "Open tab 1 (up to 9)"
msgstr "Öppna flik 1 (upp till 9)"

#. from gnome:gnote
msgid "Search bar"
msgstr "Sökfält"

#. from gnome:gnote
msgid "Display search bar"
msgstr "Visa sökfältet"

#. from gnome:gnote
msgid "Select next match"
msgstr "Välj nästa matchning"

#. from gnome:gnote
msgid "Select previous match"
msgstr "Välj föregående matchning"

#. from gnome:gnote
msgid "Notes list"
msgstr "Anteckningslista"

#. from gnome:gnote
msgid "Create new note"
msgstr "Skapa ny anteckning"

#. from gnome:gnote
msgid "Open selected note"
msgstr "Öppna vald anteckning"

#. from gnome:gnote
msgid "Open selected note in new window"
msgstr "Öppna vald anteckning i nytt fönster"

#. from gnome:gnote
msgid "Delete selected note"
msgstr "Ta bort vald anteckning"

#. from gnome:gnote
msgid "Note View"
msgstr "Anteckningsvy"

#. from gnome:gnote
msgid "Open note actions menu"
msgstr "Öppna åtgärdsmeny för anteckning"

#. from gnome:gnote
msgid "Close current tab"
msgstr "Stäng aktuell flik"

#. from gnome:gnote
msgid "Create link to note on selected text"
msgstr "Skapa länk till anteckning från markerad text"

#. from gnome:gnote
msgid "Toggle bold"
msgstr "Växla fetstil"

#. from gnome:gnote
msgid "Toggle italic"
msgstr "Växla kursiv stil"

#. from gnome:gnote
msgid "Toggle strikethrough"
msgstr "Växla genomstrykning"

#. from gnome:gnote
