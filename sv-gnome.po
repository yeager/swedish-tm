#. from gnome:evolution
msgid "_Disable"
msgstr "_Inaktivera"

#. from gnome:evolution
msgid "Cannot edit Search Folder “{0}” as it does not exist."
msgstr "Kan inte redigera sökmappen ”{0}” eftersom den inte finns."

