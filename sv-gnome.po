msgid "Integration by midpoint rule"
msgstr "Integration med mittpunktsregeln"

#. from gnome:genius
msgid "Attempt to calculate numerical derivative"
msgstr "Försök beräkna numerisk derivata"

#. from gnome:genius
msgid "Numerically compute the coefficients for a cosine Fourier series for a function on [0,L] up to the Nth coefficient."
msgstr "Beräkna numeriskt koefficienterna för en Fourier-cosinusserie för en funktion på [0,L] upp till den N:e koefficienten."

