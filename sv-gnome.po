msgstr "mönster:reguljärt uttryck"

#. from gnome:reviewed/gnumeric/master
msgid ""
"return_mode:0 for first match (default), 1 for all matches, 2 for capturing "
"groups"
msgstr ""
"returläge:0 för första träffen (standard), 1 för alla träffar, 2 för "
"fångstgrupper"

#. from gnome:reviewed/gnumeric/master
msgid ""
"case_insensitive:if TRUE, perform a case-insensitive match; defaults to "
"FALSE"
msgstr ""
"ignorera_skiftläge: om TRUE, utför en skiftlägesokänslig sökning, standard "
"FALSE"

#. from gnome:reviewed/gnumeric/master
msgid ""
"REGEXEXTRACT returns substrings from @{text} based on @{pattern}.\n"
"If @{return_mode} is 0, it returns the first match.\n"
"If @{return_mode} is 1, it returns all matches as a vertical array.\n"
"If @{return_mode} is 2, it returns capturing groups from the first match as a horizontal array."
msgstr ""
"REGEXEXTRACT returnerar delsträngar från @{text} baserat på @{mönster}.\n"
"Om @{returläge} är 0 returnerar det första träffen.\n"
"Om @{returläge} är 1 returnerar det alla träffar som en vertikal vektor.\n"
"Om @{returläge} är 2 returnerar det fångstgrupper från den första träffen som en horisontell vektor."

#. from gnome:reviewed/gnumeric/master
msgid "REGEXREPLACE:replace text matching a regular expression"
msgstr "REGEXREPLACE:ersätt text som matchar ett reguljärt uttryck"

#. from gnome:reviewed/gnumeric/master
