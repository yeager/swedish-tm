msgstr "NUMBERVALUE:numeriskt värde av @{text}"

#. from gnome:reviewed/gnumeric/master
msgid "separator:decimal separator"
msgstr "separator:decimalseparator"

#. from gnome:reviewed/gnumeric/master
msgid "group_separator:group separator"
msgstr "gruppseparator:gruppseparator"

#. from gnome:reviewed/gnumeric/master
msgid ""
"If @{text} does not look like a decimal number, NUMBERVALUE returns the "
"value VALUE would return (ignoring the given @{separator})."
msgstr ""
"Om @{text} inte ser ut som ett decimaltal, returnerar NUMBERVALUE värdet som"
" VALUE skulle returnera (ignorerar given @{separator})."

#. from gnome:reviewed/gnumeric/master
msgid "SUBSTITUTE:@{text} with all occurrences of @{old} replaced by @{new}"
msgstr "SUBSTITUTE:@{text} med alla förekomster av @{gammal} ersatt av @{ny}"

#. from gnome:reviewed/gnumeric/master
msgid "text:original text"
msgstr "text:originaltext"

#. from gnome:reviewed/gnumeric/master
msgid "old:string to be replaced"
msgstr "gammal:strängen att ersätta"

#. from gnome:reviewed/gnumeric/master
msgid ""
"num:if @{num} is specified and a number only the @{num}th occurrence of "
"@{old} is replaced"
msgstr ""
"ant:om @{ant} är specificerat och är en siffra ersätts endast @{ant}:e "
"förekomsten av @{gammal}"

#. from gnome:reviewed/gnumeric/master
msgid "TEXTBEFORE:text before @{delimiter}"
msgstr "TEXTBEFORE:text före @{avgränsare}"

#. from gnome:reviewed/gnumeric/master
msgid "delimiter:delimiter string or array of strings"
msgstr "avgränsare:avgränsarsträng eller vektor med strängar"

#. from gnome:reviewed/gnumeric/master
msgid "instance_num:the instance of the delimiter; defaults to 1"
msgstr "instanstal:instansen för avgränsaren, standard är 1"

#. from gnome:reviewed/gnumeric/master
msgid "match_mode:0 for case-sensitive (default), 1 for case-insensitive"
msgstr ""
"matchningsläge:0 för skiftlägeskänslig (standard), 1 för att ignorera "
"skiftläge"

#. from gnome:reviewed/gnumeric/master
msgid ""
"match_end:0 for no match at the end (default), 1 to match the end of the "
"text"
msgstr ""
"matchningsslut:0 för ingen matchning i slutet (standard), 1 för att matcha "
"slutet på texten"

#. from gnome:reviewed/gnumeric/master
msgid "TEXTBEFORE returns the text that occurs before the given @{delimiter}."
msgstr "TEXTBEFORE returnerar texten före angiven @{avgränsare}."

#. from gnome:reviewed/gnumeric/master
msgid "TEXTAFTER:text after @{delimiter}"
msgstr "TEXTAFTER:text efter @{avgränsare}"

#. from gnome:reviewed/gnumeric/master
msgid "TEXTAFTER returns the text that occurs after the given @{delimiter}."
msgstr "TEXTAFTER returnerar texten efter angiven @{avgränsare}."

#. from gnome:reviewed/gnumeric/master
msgid "TEXTSPLIT:split @{text} into an array using delimiters"
msgstr "TEXTSPLIT:dela @{text} till en vektor med hjälp av avgränsare"

#. from gnome:reviewed/gnumeric/master
msgid "col_delimiter:delimiter(s) for columns"
msgstr "kolavgränsare:avgränsare för kolumner"

#. from gnome:reviewed/gnumeric/master
msgid "row_delimiter:delimiter(s) for rows; optional"
msgstr "radavgränsare:avgränsare för rader, valfri"

#. from gnome:reviewed/gnumeric/master
msgid ""
"ignore_empty:TRUE to ignore empty cells in the result; defaults to FALSE"
msgstr ""
"ignorera_tom:TRUE för att ignorera tomma celler i resultatet. Standardvärdet"
" är FALSE"

#. from gnome:reviewed/gnumeric/master
msgid "pad_with:value to pad the result array with; defaults to #N/A"
msgstr ""
"fyll_med:värdet att fylla ut resultatvektorn med. Standardvärdet är #-"

#. from gnome:reviewed/gnumeric/master
msgid ""
"TEXTSPLIT splits @{text} into multiple cells using the provided column and "
"row delimiters."
msgstr ""
"TEXTSPLIT delar @{text} i flera celler med hjälp av tillhandahållna kolumn- "
"och radavgränsare."

#. from gnome:reviewed/gnumeric/master
msgid "DOLLAR:@{num} formatted as currency"
msgstr "DOLLAR:@{ant} formaterad som valuta"

#. from gnome:reviewed/gnumeric/master
msgid "decimals:decimals"
msgstr "decimaler:decimaler"

#. from gnome:reviewed/gnumeric/master
msgid ""
"SEARCH:the location of the @{search} string within @{text} after position "
"@{start}"
msgstr ""
"SEARCH:platsen för strängen @{sök} i @{text} efter positionen @{start}"

#. from gnome:reviewed/gnumeric/master
msgid "search:search string"
msgstr "sök:söksträng"

#. from gnome:reviewed/gnumeric/master
msgid "text:search field"
msgstr "text:sökfält"

#. from gnome:reviewed/gnumeric/master
msgid ""
"@{search} may contain wildcard characters (*) and question marks (?). A "
"question mark matches any single character, and a wildcard matches any "
"string including the empty string. To search for * or ?, precede the symbol "
"with ~."
msgstr ""
"@{sök} kan innehålla jokertecken (*) och frågetecken (?). Ett frågetecken "
"matchar varje enskilt tecken och ett jokertecken matchar varje sträng "
"inklusive den tomma strängen. För att söka efter * och ?, föregå symbolen "
"med ~."

#. from gnome:reviewed/gnumeric/master
msgid "This search is not case sensitive."
msgstr "Denna sökning är inte skiftlägeskänslig."

#. from gnome:reviewed/gnumeric/master
msgid "If @{search} is not found, SEARCH returns #VALUE!"
msgstr "Om @{sök} inte hittas returnerar SEARCH #VÄRDE!"

#. from gnome:reviewed/gnumeric/master
msgid ""
"If @{start} is less than one or it is greater than the length of @{text}, "
"SEARCH returns #VALUE!"
msgstr ""
"Om @{start} är mindre än ett eller är större än längden av @{text}, "
"returnerar SEARCH #VÄRDE!"

#. from gnome:reviewed/gnumeric/master
msgid ""
"SEARCHB:the location of the @{search} string within @{text} after byte "
"position @{start}"
msgstr ""
"SEARCHB:platsen för strängen @{sök} inom @{text} efter bytepositionen "
"@{start}"

#. from gnome:reviewed/gnumeric/master
msgid "If @{search} is not found, SEARCHB returns #VALUE!"
msgstr "Om @{sök} inte hittas returnerar SEARCHB #VÄRDE!"

#. from gnome:reviewed/gnumeric/master
msgid ""
"If @{start} is less than one or it is greater than the byte length of "
"@{text}, SEARCHB returns #VALUE!"
msgstr ""
"Om @{start} är mindre än ett eller är större än bytelängden av @{text}, "
"returnerar SEARCHB #VÄRDE!"

#. from gnome:reviewed/gnumeric/master
msgid ""
"ASC:text with full-width katakana and ASCII characters converted to half-"
"width"
msgstr ""
"ASC:text med fullbredds-katakana och ASCII-tecken konverterade till "
"halvbredd"

#. from gnome:reviewed/gnumeric/master
msgid ""
"ASC converts full-width katakana and ASCII characters to half-width "
"equivalent characters, copying all others."
msgstr ""
"ASC konverterar helbreddskatakana och ASCII-tecken till motsvarande "
"halvbreddstecken och kopierar alla andra."

#. from gnome:reviewed/gnumeric/master
msgid ""
"The distinction between half-width and full-width characters is described in"
" http://www.unicode.org/reports/tr11/."
msgstr ""
"Skillnaden mellan halvbredd och helbreddstecken beskrivs i "
"http://www.unicode.org/reports/tr11/."

#. from gnome:reviewed/gnumeric/master
msgid "For most strings, this function has the same effect as in Excel."
msgstr "För de flesta strängar har denna funktion samma effekt som i Excel."

#. from gnome:reviewed/gnumeric/master
msgid ""
"While in obsolete encodings ASC used to translate between 2-byte and 1-byte "
"characters, this is not the case in UTF-8."
msgstr ""
"Även om ASC i föråldrade kodningar används för att översätta mellan 2-byte "
"och 1-byte-tecken är det inte så för UTF-8."

#. from gnome:reviewed/gnumeric/master
msgid ""
"JIS:text with half-width katakana and ASCII characters converted to full-"
"width"
msgstr ""
"JIS:text med halvbredds-katakana och ASCII-tecken konverterade till "
"fullbredd"

#. from gnome:reviewed/gnumeric/master
msgid ""
"JIS converts half-width katakana and ASCII characters to full-width "
"equivalent characters, copying all others."
msgstr ""
"JIS konverterar halvbredds-katakana och ASCII-tecken till motsvarande "
"fullbreddstecken och kopierar alla andra."

#. from gnome:reviewed/gnumeric/master
msgid ""
"While in obsolete encodings JIS used to translate between 1-byte and 2-byte "
"characters, this is not the case in UTF-8."
msgstr ""
"Även om JIS i föråldrade kodningar används för att översätta mellan 1-byte "
"och 2-byte-tecken är det inte så för UTF-8."

#. from gnome:reviewed/gnumeric/master
msgid ""
"Possible interpolation methods are:\n"
"0: linear;\n"
"1: linear with averaging;\n"
"2: staircase;\n"
"3: staircase with averaging;\n"
"4: natural cubic spline;\n"
"5: natural cubic spline with averaging."
msgstr ""
"Möjliga interpolationsmetoder är:\n"
"0: linjär;\n"
"1: linjär med medelvärde;\n"
"2: trappsteg;\n"
"3: trappsteg med medelvärde;\n"
"4: naturlig kubisk spline;\n"
"5: naturlig kubisk spline med medelvärde."

#. from gnome:reviewed/gnumeric/master
msgid ""
"INTERPOLATION:interpolated values corresponding to the given abscissa "
"targets"
msgstr ""
"INTERPOLATION:interpolerade värden motsvarande målen för given abskissa"

#. from gnome:reviewed/gnumeric/master
msgid "abscissae:abscissae of the given data points"
msgstr "abskissor:abskissor för de givna datapunkterna"

#. from gnome:reviewed/gnumeric/master
msgid "ordinates:ordinates of the given data points"
msgstr "ordinator:ordinator för de givna datapunkterna"

#. from gnome:reviewed/gnumeric/master
msgid "targets:abscissae of the interpolated data"
msgstr "mål:abskissor för interpolerad data"

#. from gnome:reviewed/gnumeric/master
msgid "interpolation:method of interpolation, defaults to 0 ('linear')"
msgstr "interpolation:metod för interpolation, standardvärdet är 0 (”linjär”)"

#. from gnome:reviewed/gnumeric/master
msgid "The output consists always of one column of numbers."
msgstr "Utdata består alltid av en kolumn av tal."

#. from gnome:reviewed/gnumeric/master
msgid ""
"The @{abscissae} should be given in increasing order. If the @{abscissae} is"
" not in increasing order the INTERPOLATION function is significantly slower."
msgstr ""
"@{abskissor} borde vara given i ökande ordning. Om @{abskissor} inte är i "
"stigande ordning är funktionen INTERPOLATION signifikant långsammare."

#. from gnome:reviewed/gnumeric/master
msgid "If any two @{abscissae} values are equal an error is returned."
msgstr "Om två @{abskissor}-värden är lika returneras ett fel."

#. from gnome:reviewed/gnumeric/master
msgid ""
"If any of interpolation methods 1 ('linear with averaging'), 3 ('staircase "
"with averaging'), and 5 ('natural cubic spline with averaging') is used, the"
" number of returned values is one less than the number of targets and the "
"target values must be given in increasing order. The values returned are the"
" average heights of the interpolation function on the intervals determined "
"by consecutive target values."
msgstr ""
"Om några av interpolationsmetoderna 1 (”linjär med medelvärde”), 3 "
"(”trappsteg med medelvärde”), och 5 (”naturlig kubisk spline med "
"medelvärde”) används, är antalet returnerade värden ett mindre än antalet "
"mål, och målvärdena måste anges i stigande ordning. Värdena som returneras "
"är medelhöjderna för interpolationsfunktionen för intervallen bestämda av "
"målvärden."

#. from gnome:reviewed/gnumeric/master
msgid "Strings and empty cells in @{abscissae} and @{ordinates} are ignored."
msgstr "Strängar och tomma celler i @{abskissor} och @{ordinator} ignoreras."

#. from gnome:reviewed/gnumeric/master
msgid ""
"If several target data are provided they must be in the same column in "
"consecutive cells."
msgstr ""
"Om flera måldata tillhandahålls måste de vara i samma kolumn i närliggande "
"celler."

#. from gnome:reviewed/gnumeric/master
msgid "PERIODOGRAM:periodogram of the given data"
msgstr "PERIODOGRAM:periodogram för de givna datapunkterna"

#. from gnome:reviewed/gnumeric/master
msgid "ordinates:ordinates of the given data"
msgstr "ordinator:ordinator för de givna datapunkterna"

#. from gnome:reviewed/gnumeric/master
msgid "filter:windowing function to be used, defaults to no filter"
msgstr "filter:fönsterfunktion att användas, standard är inga filter"

#. from gnome:reviewed/gnumeric/master
msgid ""
"abscissae:abscissae of the given data, defaults to regularly spaced "
"abscissae"
msgstr ""
"abskissor:abskissor för givna data, standard är jämnt avstånd mellan "
"abskissor"

#. from gnome:reviewed/gnumeric/master
msgid "interpolation:method of interpolation, defaults to none"
msgstr "interpolation:metod för interpolation, standard är ingen"

#. from gnome:reviewed/gnumeric/master
msgid "number:number of interpolated data points"
msgstr "antal:antal interpolerade datapunkter"

#. from gnome:reviewed/gnumeric/master
msgid ""
"If an interpolation method is used, the number of returned values is one "
"less than the number of targets and the targets values must be given in "
"increasing order."
msgstr ""
"Om en interpolationsmetod används, är antalet returnerade värden en mindre "
"än antalet mål och målvärdena måste vara givna i ökande ordning."

#. from gnome:reviewed/gnumeric/master
msgid ""
"Possible window functions are:\n"
"0: no filter (rectangular window)\n"
"1: Bartlett (triangular window)\n"
"2: Hahn (cosine window)\n"
"3: Welch (parabolic window)"
msgstr ""
"Möjliga fönsterfunktioner:\n"
"0: inga filter (rektangulärt fönster)\n"
"1: Bartlett (triangulärt fönster)\n"
"2: Hahn (cosinus-fönster)\n"
"3: Welch (paraboliskt fönster)"

#. from gnome:reviewed/gnumeric/master
msgid "FOURIER:Fourier or inverse Fourier transform"
msgstr "FOURIER:Fouriertransformen eller inversen för fouriertransformen"

#. from gnome:reviewed/gnumeric/master
msgid "Sequence:the data sequence to be transformed"
msgstr "Sekvens:datasekvensen att transformera"

#. from gnome:reviewed/gnumeric/master
msgid ""
"Inverse:if true, the inverse Fourier transform is calculated, defaults to "
"false"
msgstr ""
"Invers:om sant, beräknas inversen för fouriertransformen, standardvärdet är "
"falskt"

#. from gnome:reviewed/gnumeric/master
msgid ""
"Separate:if true, the real and imaginary parts are given separately, "
"defaults to false"
msgstr ""
"Separat:om sant, lämnas de riktiga och imaginära delarna separat, standard "
"är falskt"

#. from gnome:reviewed/gnumeric/master
msgid ""
"This array function returns the Fourier or inverse Fourier transform of the "
"given data sequence."
msgstr ""
"Denna vektorfunktion returnerar fouriertransformen eller inversa "
"fouriertransformen för den givna datasekvensen."

#. from gnome:reviewed/gnumeric/master
msgid ""
"The output consists of one column of complex numbers if @{Separate} is false"
" and of two columns of real numbers if @{Separate} is true."
msgstr ""
"Utdata består av en kolumn av komplexa tal om @{Separat} är falskt och av "
"två kolumner av reella tal om @{Separat} är sant."

#. from gnome:reviewed/gnumeric/master
msgid ""
"If @{Separate} is true the first output column contains the real parts and "
"the second column the imaginary parts."
msgstr ""
"Om @{Separat} är sant kommer den första utdatakolumnen innehålla den reella "
"delen och den andra delen de imaginära delarna."

#. from gnome:reviewed/gnumeric/master
msgid ""
"If @{Sequence} is neither an n by 1 nor 1 by n array, this function returns "
"#VALUE!"
msgstr ""
"Om @{Sekvens} varken är en n×1- eller 1×n-vektor returnerar denna funktion "
"#VÄRDE!"

#. from gnome:reviewed/gnumeric/master
msgid "HPFILTER:Hodrick Prescott Filter"
msgstr "HPFILTER:Hodrick Prescott-filter"

#. from gnome:reviewed/gnumeric/master
msgid "λ:filter parameter λ, defaults to 1600"
msgstr "λ:filterparameter λ, standardvärdet är 1600"

#. from gnome:reviewed/gnumeric/master
msgid ""
"This array function returns the trend and cyclical components obtained by "
"applying the Hodrick Prescott Filter with parameter @{λ} to the given data "
"sequence."
msgstr ""
"Denna vektorfunktion returnerar trend och cykliska komponenter erhållna "
"genom att tillämpa filtret Hodrick Prescott Filter med parameter @{λ} på den"
" givna datasekvensen."

#. from gnome:reviewed/gnumeric/master
msgid ""
"The output consists of two columns of numbers, the first containing the "
"trend component, the second the cyclical component."
msgstr ""
"Utdata består av två kolumner av siffror, den första med trendkomponenten "
"och den andra den cykliska komponenten."

#. from gnome:reviewed/gnumeric/master
msgid ""
"If @{Sequence} contains less than 6 numerical values, this function returns "
"#VALUE!"
msgstr ""
"Om @{Sekvens} innehåller mindre än 6 numeriska värden returnerar denna "
"funktion #VÄRDE!"

#. from gnome:reviewed/gnumeric/master
msgid "EXECSQL:result of executing @{sql} in the libgda data source @{dsn}"
msgstr "EXECSQL:resultatet av att exekvera @{sql} i libgda-datakällan @{dsn}"

#. from gnome:reviewed/gnumeric/master
msgid "dsn:libgda data source"
msgstr "dsn:libgda-datakälla"

#. from gnome:reviewed/gnumeric/master
msgid "username:user name to access @{dsn}"
msgstr "användarnamn:användarnamn för att komma åt @{dsn}"

#. from gnome:reviewed/gnumeric/master
msgid "password:password to access @{dsn} as @{username}"
msgstr "lösenord:lösenord för att komma åt @{dsn} som @{användarnamn}"

#. from gnome:reviewed/gnumeric/master
msgid "sql:SQL command"
msgstr "sql:SQL-kommando"

#. from gnome:reviewed/gnumeric/master
msgid "Before using EXECSQL, you need to set up a libgda data source."
msgstr "Innan användning av EXECSQL behöver du ange en libgda-datakälla."

#. from gnome:reviewed/gnumeric/master
msgid "READDBTABLE:all rows of the table @{table} in @{dsn}"
msgstr "READDBTABLE:alla rader för tabellen @{tabell} i @{dsn}"

#. from gnome:reviewed/gnumeric/master
msgid "table:SQL table to retrieve"
msgstr "tabell:SQL-tabell att hämta"

#. from gnome:reviewed/gnumeric/master
msgid "ATL_LAST:sample real-time data source"
msgstr "ATL_LAST:sampling av realtidsdatakälla"

#. from gnome:reviewed/gnumeric/master
msgid "tag:tag to watch"
msgstr "tagg:tagg att bevaka"

#. from gnome:reviewed/gnumeric/master
msgid ""
"ATL_LAST is a sample implementation of a real time data source.  It takes a "
"string tag and monitors the named pipe ~/atl for changes to the value of "
"that tag."
msgstr ""
"ATL_LAST är en exempelimplementation av en realtidsdatakälla. Den tar en "
"strängtagg och bevakar det namngivna röret ~/atl för förändringar till "
"värdet av taggen."

#. from gnome:reviewed/gnumeric/master
msgid "This is not intended to be generally enabled and is OFF by default."
msgstr ""
"Det här är inte avsett att vara allmänt aktiverat och är OFF som standard."

#. from gnome:reviewed/gtk-vnc/master
msgid "Enables debug output"
msgstr "Aktiverar felsökningsutskrift"

#. from gnome:reviewed/gtk-vnc/master
msgid "GTK-VNC Options:"
msgstr "Alternativ för GTK-VNC:"

#. from gnome:reviewed/gtk-vnc/master
msgid "Show GTK-VNC Options"
msgstr "Visa alternativ för GTK-VNC"

#. from gnome:reviewed/libgedit-amtk — Gedit Technology - Actions, Menus and
#. Toolbars Kit/main
msgid "Open “%s”"
msgstr "Öppna ”%s”"

#. from gnome:reviewed/libgedit-amtk — Gedit Technology - Actions, Menus and
#. Toolbars Kit/main
msgid "Open a file recently used with %s"
msgstr "Öppna en fil som tidigare använts med %s"

#. from gnome:reviewed/tracker-miner-chatlog/master
msgid "Chat logs"
msgstr "Chattloggar"

#. from gnome:reviewed/tracker-miner-chatlog/master
msgid "Chat logs miner"
msgstr "Chattloggsindexerare"

#. from gnome:reviewed/template-glib/main
msgid "%s() may only be called once"
msgstr "%s() kan bara anropas en gång"

#. from gnome:reviewed/template-glib/main
msgid "Parser does not contain an input stream"
msgstr "Tolken innehåller ingen inmatningsström"

#. from gnome:reviewed/template-glib/main
msgid "Must parse template before expanding"
msgstr "Mallen måste tolkas före expansion"

#. from gnome:reviewed/template-glib/main
msgid "Failed to locate template “%s”"
msgstr "Kunde inte hitta mallen ”%s”"

#. from gnome:reviewed/WirePlumber/master
msgid ""
"How long to wait, in milliseconds, before restoring the previous profile "
"when recording stops"
msgstr ""
"Hur länge man ska vänta, i millisekunder, innan den föregående profilen "
"återställs när inspelningen avslutas"

#. from gnome:reviewed/WirePlumber/master
msgid "Auto-switch restore timeout"
msgstr "Tidsgräns för återställning vid automatisk växling"

#. from gnome:reviewed/WirePlumber/master
msgid ""
"How long to wait, in milliseconds, before switching to headset mode when "
"recording starts"
msgstr ""
"Hur länge man ska vänta, i millisekunder, innan växling till headsetläge "
"sker när inspelningen påbörjas"

#. from gnome:reviewed/WirePlumber/master
msgid "Auto-switch timeout"
msgstr "Tidsgräns för automatisk växling"

#. from gnome:reviewed/WirePlumber/master
msgid ""
"Prefer better quality or better latency when auto-selecting profiles (only "
"'quality' or 'latency' values are accepted)"
msgstr ""
"Föredra bättre kvalitet eller lägre latens vid automatiskt profilval (endast"
" värdena ”quality” och ”latency” godtas)"

#. from gnome:reviewed/WirePlumber/master
msgid "Bluetooth profile preference"
msgstr "Bluetooth-profilinställning"

#. from gnome:reviewed/WirePlumber/master
msgid "The default volume for capture streams"
msgstr "Standardvolymen för inspelningsströmmar"

#. from gnome:reviewed/WirePlumber/master
msgid "The default volume for playback streams"
msgstr "Standardvolymen för uppspelningsströmmar"

#. from gnome:reviewed/WirePlumber/master
msgid "Enable control ports on audio streams"
msgstr "Aktivera styrportar på ljudströmmar"

#. from gnome:reviewed/WirePlumber/master
msgid "Enable monitor ports on audio streams"
msgstr "Aktivera övervakningsportar på ljudströmmar"

#. from gnome:reviewed/WirePlumber/master
msgid "Configure all audio device sink streams in MONO"
msgstr "Konfigurera alla ljudenheters utgångsströmmar som MONO"

#. from gnome:reviewed/realmd/master
msgid "Renew credentials for this machine in a realm"
msgstr "Förnya autentiseringsuppgifter för denna maskin i en sfär"

#. from gnome:reviewed/realmd/master
msgid "Failed to discover realm"
msgstr "Kunde inte upptäcka sfär"

#. from gnome:reviewed/realmd/master
msgid "No realm found"
msgstr "Ingen sfär hittades"

#. from gnome:reviewed/realmd/master
msgid "Cannot determine if fully-qualified name are used or not"
msgstr "Kan inte avgöra om fullständiga namn används eller inte"

#. from gnome:reviewed/realmd/master
msgid ""
"Please note that by default, you have to use fully-qualified names\n"
"during AD user lookup & login instead of just short names\n"
"e.g. 'username@domain' instead of just 'username'. Although\n"
"fully-qualified names are recommended, this behaviour can be changed\n"
"in sssd.conf file with the 'use_fully_qualified_names = False' option.\n"
msgstr ""
"Observera att du som standard måste använda fullständiga namn\n"
"vid sökning efter och inloggning av AD-användare, i stället för endast korta namn\n"
"till exempel 'användarnamn@domän' i stället för endast 'användarnamn'. Även om\n"
"fullständiga namn rekommenderas kan beteendet ändras\n"
"i filen sssd.conf med alternativet 'use_fully_qualified_names = False'.\n"

#. from gnome:reviewed/realmd/master
msgid ""
"Please note that by default, you can use short names during AD user\n"
"lookup & login instead of fully-qualified names\n"
"e.g. 'username' instead of 'username@domain'. If you prefer\n"
"fully-qualified names, this behaviour can be changed\n"
"in sssd.conf file with the 'use_fully_qualified_names = True' option.\n"
msgstr ""
"Observera att du som standard kan använda korta namn vid sökning efter och\n"
"inloggning av AD-användare, i stället för fullständiga namn\n"
