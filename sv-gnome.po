msgid "Time interval, in seconds, to automatically backup files. A minimum of 30 seconds is recommended."
msgstr "Tidsintervall i sekunder för att automatiskt säkerhetskopiera filer. Minst 30 sekunder rekommenderas."

#. from gnome:gnome-subtitles
msgid "Time step increment"
msgstr "Tidsstegökning"

