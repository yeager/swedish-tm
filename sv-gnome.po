msgstr "Klipp ut objekt"

#. from gnome:gnumeric
msgid "Unable to paste"
msgstr "Det går inte att klistra in"

#. from gnome:gnumeric
msgid "Contents can only be pasted by value or by link."
msgstr "Innehåll kan endast klistras in via värde eller genom länk."

#. from gnome:gnumeric
msgid "destination does not have an even multiple of source columns (%d vs %d)\n\nTry selecting a single cell or an area of the same shape and size."
msgstr "målet har inte en jämn multipel av källkolumner (%d gentemot %d)\n\nFörsök markera en enstaka cell eller en yta med samma form och storlek."

#. from gnome:gnumeric
msgid "destination does not have an even multiple of source rows (%d vs %d)\n\nTry selecting a single cell or an area of the same shape and size."
msgstr "målet har inte en jämn multipel av källrader (%d gentemot %d)\n\nFörsök markera en enstaka cell eller en yta med samma form och storlek."

#. from gnome:gnumeric
msgid "result passes the sheet boundary"
msgstr "resultatet går utanför bladets kant"

#. from gnome:gnumeric
msgid "destination has a different shape (%dRx%dC) than the original (%dRx%dC)\n\nTry selecting a single cell or an area of the same shape and size."
msgstr "målet har en annan form (%dR×%dK) än originalet (%dR×%dK)\n\nFörsök välja en enstaka cell eller en yta med samma form och storlek."

#. from gnome:gnumeric
msgid "Unable to paste into selection"
msgstr "Det går inte att klistra in i markeringen"

#. from gnome:gnumeric
msgid "Inserting these cells would push data off the sheet. Please enlarge the sheet first."
msgstr "Att infoga dessa celler skulle knuffa ut data utanför kalkylbladet. Förstora kalkylbladet först."

