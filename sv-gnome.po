msgid "Luminosity"
msgstr "Luminans"

#. from gnome:reviewed/gimp-help — GIMP User Manual/master
msgid "Luminosity = 0.21 * R + 0.71 * G + 0.07 * B"
msgstr "Luminans = 0.21 * R + 0.71 * G + 0.07 * B"

#. from gnome:reviewed/gimp-help — GIMP User Manual/master
msgid "Average Brightness = (R + G + B) / 3"
msgstr "Genomsnittlig ljusstyrka = (R + G + B) / 3"

#. from gnome:reviewed/gimp-help — GIMP User Manual/master
