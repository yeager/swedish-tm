#. from gnome:reviewed/gimp/master
#. from gnome:reviewed/gnome-commander/main
#. from gnome:reviewed/gnumeric/master
#. from gnome:reviewed/gitg/master
msgid "Wrap"
msgstr "Radbryt"

#. from gnome:gitg
msgid "Wrap lines."
msgstr "Radbryt rader."

#. from gnome:gitg
msgid "Number of Before/After Context Lines"
msgstr "Antal kontextrader före/efter"

#. from gnome:gitg
msgid "Setting that determines how many lines of context (before and after) should be shown when showing the diff of a commit."
msgstr "Inställningen som bestämmer hur många rader kontext (före och efter) som ska visas när diffen för en incheckning visas."

#. from gnome:gitg
msgid "Rendered Width of a Tab Character"
msgstr "Visad bredd för ett tabbtecken"

#. from gnome:gitg
msgid "Setting that determines how much space a tab character should occupy when showing the diff of a commit."
msgstr "Inställning som bestämmer hur många blanksteg ett tabbtecken ska uppta när diffen för en incheckning visas."

#. from gnome:gitg
msgid "Setting that determines how many lines of context (before and after) should be shown when showing the diff to be staged/unstaged in the commit area."
msgstr "Inställning som bestämmer hur många rader kontext (före och efter) som ska visas när diffen som ska köas upp/tas bort ur kön visas i incheckningsområdet."

