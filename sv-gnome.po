msgstr "Nyansalternativet för filtret <placeholder-1/>"

#. from gnome:reviewed/gimp-help — GIMP User Manual/master
msgid ""
"<guilabel>Saturation</guilabel>: Three previews for more or less saturation."
msgstr ""
"<guilabel>Mättnad</guilabel>: Tre förhandsvisningar med mer eller mindre "
