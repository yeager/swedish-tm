#. from gnome:gnumeric
msgid "List of recently used functions."
msgstr "Lista över senast använda funktioner."

#. from gnome:gnumeric
msgid "The function selector keeps a list of recently used functions. This is that list."
msgstr "Funktionsväljaren har en lista över senast använda funktioner. Detta är listan."

#. from gnome:gnumeric
msgid "Maximum Length of Recently Used Functions List"
msgstr "Maximal längd på lista över senast använda funktioner"

#. from gnome:gnumeric
msgid "The function selector keeps a list of recently used functions. This is the maximum length of that list."
msgstr "Funktionsväljaren har en lista över senast använda funktioner. Detta är den maximala längden på den listan."

#. from gnome:gnumeric
msgid "Autocorrect initial caps"
msgstr "Autorätta stor bokstav i början"

#. from gnome:gnumeric
msgid "This variable determines whether to autocorrect initial caps"
msgstr "Den här variabeln avgör huruvida automatisk korrigering av inledande versaler ska ske"

#. from gnome:gnumeric
msgid "List of initial caps exceptions"
msgstr "Lista över undantag för stor bokstav"

#. from gnome:gnumeric
msgid "The autocorrect engine does not correct the initial caps for words in this list."
msgstr "Autorättaren rättar inte stor bokstav först för ord i den här listan."

#. from gnome:gnumeric
msgid "Autocorrect first letter"
msgstr "Autorätta första bokstaven"

#. from gnome:gnumeric
msgid "This variable determines whether to autocorrect first letters"
msgstr "Den här variabeln avgör huruvida autokorrigering av första bokstäver ska ske"

#. from gnome:gnumeric
msgid "List of First Letter Exception"
msgstr "Lista över undantag för första tecken"

#. from gnome:gnumeric
msgid "The autocorrect engine does not capitalize the first letter of words following strings in this list."
msgstr "Autorättaren gör inte det första tecknet till versal för ord som följer strängar i denna lista."

#. from gnome:gnumeric
msgid "Autocorrect names of days"
msgstr "Autorätta namn på dagar"

#. from gnome:gnumeric
msgid "This variable determines whether to autocorrect names of days"
msgstr "Den här variabeln avgör huruvida autokorrigering av dagars namn ska ske"

#. from gnome:gnumeric
msgid "Autocorrect replace"
msgstr "Autorätta ersätt"

#. from gnome:gnumeric
msgid "Activate New Plugins"
msgstr "Aktivera nya insticksmoduler"

#. from gnome:gnumeric
msgid "This variable determines whether to activate every new encountered plugin."
msgstr "Den här variabeln avgör om varje ny insticksmodul skall aktiveras."

#. from gnome:gnumeric
msgid "List of Active Plugins."
msgstr "Lista över aktiva insticksmoduler."

#. from gnome:gnumeric
msgid "This list contains all plugins that are supposed to be automatically activated."
msgstr "Den här listan innehåller alla insticksmoduler som skall aktiveras automatiskt."

#. from gnome:gnumeric
msgid "List of Known Plugins."
msgstr "Lista över kända insticksmoduler."

#. from gnome:gnumeric
msgid "This list contains all known plugins."
msgstr "Den här listan innehåller alla kända insticksmoduler."

#. from gnome:gnumeric
msgid "List of Plugin File States."
msgstr "Lista över filtillstånd för insticksmoduler."

#. from gnome:gnumeric
msgid "This list contains all plugin file states."
msgstr "Den här listan innehåller filtillstånden för alla insticksmoduler."

#. from gnome:gnumeric
msgid "List of Extra Plugin Directories."
msgstr "Lista över extra insticksmodulkataloger."

#. from gnome:gnumeric
msgid "This list contains all extra directories containing plugins."
msgstr "Den här listan innehåller alla extra kataloger med insticksmoduler."

#. from gnome:gnumeric
msgid "List of Extra Autoformat Directories."
msgstr "Lista över extra autoformat-kataloger."

#. from gnome:gnumeric
msgid "This list contains all extra directories containing autoformat templates."
msgstr "Den här listan innehåller alla extra kataloger med autoformatmallar."

#. from gnome:gnumeric
msgid "System Directory for Autoformats"
msgstr "Systemkatalog för autoformat"

#. from gnome:gnumeric
msgid "This directory contains the pre-installed autoformat templates."
msgstr "Den här katalogen innehåller de fördefinierade autoformatmallarna."

#. from gnome:gnumeric
msgid "User Directory for Autoformats"
msgstr "Användarkatalog för autoformat"

#. from gnome:gnumeric
msgid "The main directory for user specific autoformat templates."
msgstr "Huvudkatalogen för användarspecifika autoformatmallar."

#. from gnome:gnumeric
msgid "Apply print-setup to all sheets"
msgstr "Tillämpa skrivarinställningar på alla blad"

#. from gnome:gnumeric
msgid "This value determines whether by default the print set-up dialog applies to all sheets simultaneously."
msgstr "Det här värdet avgör om skrivarinställningsdialogen skall gälla för alla blad samtidigt."

#. from gnome:gnumeric
msgid "GTKPrintSetting"
msgstr "GTKPrintSetting"

#. from gnome:gnumeric
msgid "The configuration of GTKPrintSetting. Do not edit this variable."
msgstr "Konfigurationen för GTKPrintSetting. Ändra inte denna variabel."

#. from gnome:gnumeric
msgid "Page Header"
msgstr "Sidhuvud"

#. from gnome:gnumeric
msgid "The default page header for new documents that can be modified using the page setup dialog."
msgstr "Sidhuvud för nya dokument som kan modifieras i dialogen för sidegenskaper."

#. from gnome:gnumeric
msgid "Page Footer"
msgstr "Sidfot"

#. from gnome:gnumeric
msgid "The default page footer for new documents that can be modified using the page setup dialog."
msgstr "Sidfot för nya dokument som kan modifieras i dialogen för sidegenskaper."

#. from gnome:gnumeric
msgid "Default Header/Footer Font Size"
msgstr "Standardtypsnittsstorlek för sidhuvud/sidfot"

#. from gnome:gnumeric
msgid "The default font size for headers and footers."
msgstr "Standardtypsnittsstorleken för nya sidhuvud och sidfot."

#. from gnome:gnumeric
msgid "Default header/footer font name"
msgstr "Standardtypsnitt för sidhuvud/sidfot"

#. from gnome:gnumeric
msgid "The default font name for headers and footers."
msgstr "Standardtypsnittsnamnet för sidhuvud och sidfot."

#. from gnome:gnumeric
msgid "The default header/footer font is bold."
msgstr "Standardtypsnittet för sidhuvud/sidfot är i fetstil."

#. from gnome:gnumeric
msgid "This value determines whether the default font for headers and footers is bold."
msgstr "Det här värdet avgör om standardtypsnittet för sidhuvud och sidfot är i fetstil."

#. from gnome:gnumeric
msgid "The default header/footer font is italic."
msgstr "Standardtypsnittet för sidhuvud/sidfot är kursivt."

#. from gnome:gnumeric
msgid "This value determines whether the default font for headers and footers is italic."
msgstr "Det här värdet avgör om standardtypsnittet för sidhuvud och sidfot är kursivt."

#. from gnome:gnumeric
msgid "Default Horizontal Centering"
msgstr "Vågrät centrering som standard"

#. from gnome:gnumeric
msgid "This value determines whether the default setting in the Print Setup dialog is to center pages horizontally."
msgstr "Det här värdet avgör huruvida standardinställningen i Skrivarinställningar är att sidor skall centreras vågrätt."

#. from gnome:gnumeric
msgid "Default Vertical Centering"
msgstr "Lodrät centrering som standard"

#. from gnome:gnumeric
msgid "This value determines whether the default setting in the Print Setup dialog is to center pages vertically."
msgstr "Det här värdet avgör huruvida standardinställningen i Skrivarinställningar är att sidor skall centreras lodrätt."

#. from gnome:gnumeric
msgid "Default Grid Line Printing"
msgstr "Skriv som standard ut rutnät"

#. from gnome:gnumeric
msgid "This value determines the default setting in the Print Setup dialog whether print grid lines. Please use the Print Setup dialog to edit this value."
msgstr "Det här värdet avgör huruvida standardinställningen i Skrivarinställningar ska skriva ut rutnätslinjer. Använd dialogen Skrivarinställningar för att redigera detta värde."

#. from gnome:gnumeric
msgid "Default Print Cells with Only Styles"
msgstr "Skriv ut celler med bara stilar som standard"

#. from gnome:gnumeric
msgid "This value determines the default setting in the Print Setup dialog whether to print empty but formatted cells. Please use the Print Setup dialog to edit this value."
msgstr "Det här värdet sätter standardinställningen i Skrivarinställningar för om tomma men formaterade celler skall skrivas ut. Använd Skrivarinställningar för att redigera detta värde."

#. from gnome:gnumeric
msgid "Default Black and White Printing"
msgstr "Svart-vit utskrift som standard"

#. from gnome:gnumeric
msgid "This value determines the default setting in the Print Setup dialog whether to print in only black and white. Please use the Print Setup dialog to edit this value."
msgstr "Det här värdet sätter standardinställningen i Skrivarinställningar för om utskrift endast skall vara i svart-vitt. Använd Skrivarinställningar för att redigera detta värde."

#. from gnome:gnumeric
msgid "Default Title Printing"
msgstr "Skriv ut titel som standard"

#. from gnome:gnumeric
msgid "This value determines the default setting in the Print Setup dialog whether to print row and column headers. Please use the Print Setup dialog to edit this value."
msgstr "Det här värdet sätter standardinställningen i Skrivarinställningar för om rad- och kolumnrubriker skall skrivas ut. Använd Skrivarinställningar för att redigera detta värde."

#. from gnome:gnumeric
msgid "Default Print Direction"
msgstr "Standardriktning för utskrift"

#. from gnome:gnumeric
msgid "This value determines the default setting in the Print Setup dialog whether to print first right then down. Please use the Print Setup dialog to edit this value."
msgstr "Det här värdet sätter standardinställningen i Skrivarinställningar för om sidorna ska skrivas ut åt höger och sedan ner eller inte. Använd Skrivarinställningar för att redigera detta värde."

#. from gnome:gnumeric
msgid "Default Scale Type"
msgstr "Skalningstyp som standard"

#. from gnome:gnumeric
msgid "This value determines the default setting in the Print Setup dialog whether to scale pages by a given percentage. Please use the Print Setup dialog to edit this value."
msgstr "Det här värdet sätter standardinställningen i Skrivarinställningar för om sidorna skall skalas med en given procentsats. Använd Skrivarinställningar för att redigera detta värde."

#. from gnome:gnumeric
msgid "Default Scale Percentage"
msgstr "Standardskalning i procent"

#. from gnome:gnumeric
msgid "This value gives the percentage by which to scale each printed page. Please use the Print Setup dialog to edit this value."
msgstr "Det här värdet anger procentsatsen med vilken varje utskriven sida skalas. Använd Skrivarinställningar för att redigera detta värde."

#. from gnome:gnumeric
msgid "Default Scaling Width"
msgstr "Vågrät skalning i procent som standard"

#. from gnome:gnumeric
msgid "This value determines the maximum number of pages that make up the width of a printout of the current sheet. The sheet will be reduced to fit within this width. This value can be changed in the Page Setup dialog."
msgstr "Det här värdet anger högst antal sidor som utgör bredden på en utskrift för aktuellt blad. Bladet kommer att förminskas till att passa inom denna bredd. Värdet kan ändras i dialogen Sidinställning."

#. from gnome:gnumeric
msgid "Default Scaling Height"
msgstr "Lodrät skalning i procent som standard"

#. from gnome:gnumeric
msgid "This value determines the maximum number of pages that make up the height of a printout of the current sheet. The sheet will be reduced to fit within this height. This value can be changed in the Page Setup dialog."
msgstr "Det här värdet anger högst antal sidor som utgör höjden på en utskrift för aktuellt blad. Bladet kommer att förminskas till att passa inom denna höjd. Värdet kan ändras i dialogen Sidinställning."

#. from gnome:gnumeric
msgid "Default Repeated Top Region"
msgstr "Repetera övre regionen som standard"

#. from gnome:gnumeric
msgid "This string gives the default region to be repeated at the top of each printed sheet. Please use the Print Setup dialog to edit this value."
msgstr "Den här strängen anger området som ska repeteras överst på varje utskrivet blad. Använd Skrivarinställningar för att redigera detta värde."

#. from gnome:gnumeric
msgid "Default Repeated Left Region"
msgstr "Repetera vänstra regionen som standard"

#. from gnome:gnumeric
msgid "This string gives the default region to be repeated at the left of each printed sheet. Please use the Print Setup dialog to edit this value."
msgstr "Den här strängen anger området som ska repeteras till vänster av varje utskrivet blad. Använd Skrivarinställningar för att redigera detta värde."

#. from gnome:gnumeric
msgid "Preferred Display Unit"
msgstr "Önskad visningsenhet"

#. from gnome:gnumeric
msgid "This string gives the default unit to be used in the page setup dialog."
msgstr "Strängen anger standardenhet att användas i sidinställningsdialogen."

#. from gnome:gnumeric
msgid "Default Top Margin"
msgstr "Standard övermarginal"

#. from gnome:gnumeric
msgid "This value gives the default number of points from the top of a page to the start of the body. Please use the Print Setup dialog to edit this value."
msgstr "Det här värdet anger antal punkter från sidans överkant till början på huvudinnehållet. Använd Skrivarinställningar för att redigera detta värde."

#. from gnome:gnumeric
msgid "Default Bottom Margin"
msgstr "Standard nedermarginal"

#. from gnome:gnumeric
msgid "This value gives the default number of points from the bottom of a page to the end of the body. Please use the Print Setup dialog to edit this value."
msgstr "Det här värdet anger antal punkter från sidans nederkant till slutet på huvudinnehållet. Använd Skrivarinställningar för att redigera detta värde."

#. from gnome:gnumeric
msgid "Default Bottom Outside Margin"
msgstr "Standard underutsidemarginal"

#. from gnome:gnumeric
msgid "This value gives the default number of points from the bottom of a page to the end of the footer. Please use the Print Setup dialog to edit this value."
msgstr "Det här värdet anger standardantal punkter från sidans nederkant till slutet på foten. Använd Skrivarinställningar för att redigera detta värde."

#. from gnome:gnumeric
msgid "Default Top Outside Margin"
msgstr "Standard överutsidemarginal"

#. from gnome:gnumeric
msgid "This value gives the default number of points from the top of a page to the top of the header. Please use the Print Setup dialog to edit this value."
msgstr "Det här värdet anger antal standardpunkter från sidans överkant till början på huvudet. Använd Skrivarinställningar för att redigera detta värde."

#. from gnome:gnumeric
msgid "Default Left Margin"
msgstr "Standard vänstermarginal"

#. from gnome:gnumeric
msgid "This value gives the default number of points from the left of a page to the left of the body. Please use the Print Setup dialog to edit this value."
msgstr "Det här värdet anger antal punkter från sidans vänstra del till vänster om huvuddelen. Använd Skrivarinställningar för att redigera detta värde."

#. from gnome:gnumeric
msgid "Default Right Margin"
msgstr "Standard högermarginal"

#. from gnome:gnumeric
msgid "This value gives the default number of points from the right of a page to the right of the body. Please use the Print Setup dialog to edit this value."
msgstr "Det här värdet anger antal punkter från sidans högra del till höger om huvuddelen. Använd Skrivarinställningar för att redigera detta värde."

#. from gnome:gnumeric
msgid "This is the default paper specification. Please use the Print Setup dialog to edit this value."
msgstr "Det här är standardpappersspecifikationen. Använd dialogen Skrivarinställningar för att redigera detta värde."

#. from gnome:gnumeric
msgid "Paper orientation"
msgstr "Pappersorientering"

#. from gnome:gnumeric
msgid "This is the default paper orientation. Please use the Print Setup dialog to edit this value."
msgstr "Det här är standard för pappersorienteringen. Använd dialogen Skrivarinställningar för att ändra detta värde."

#. from gnome:gnumeric
msgid "Header/Footer Format (Left Portion)"
msgstr "Format för sidhuvud/sidfot (vänster del)"

#. from gnome:gnumeric
msgid "Please use the Print Setup dialog to edit this value."
msgstr "Använd Skrivarinställningar för att redigera detta värde."

#. from gnome:gnumeric
msgid "Header/Footer Format (Middle Portion)"
msgstr "Format för sidhuvud/sidfot (mittendel)"

#. from gnome:gnumeric
msgid "Header/Footer Format (Right Portion)"
msgstr "Format för sidhuvud/sidfot (höger del)"

#. from gnome:gnumeric
msgid "Allow Unfocused Range Selections"
msgstr "Tillåt ofokuserade områdesval"

#. from gnome:gnumeric
msgid "Some dialogs contain only a single entry field that allows range selections in the workbook. Setting this variable to TRUE directs selections to this entry even if the entry does not have keyboard focus."
msgstr "En del dialoger innehåller bara ett indatafält som tillåter områdesurval i arbetsboken. Med variabeln satt till TRUE skickas urval till det här fältet även om fältet inte har fokus."

#. from gnome:gnumeric
msgid "Text Export String Indicator"
msgstr "Strängindikator för textexport"

#. from gnome:gnumeric
msgid "Please use the Text Export dialog to edit this value."
msgstr "Använd dialogen textexport för att ändra detta värde."

#. from gnome:gnumeric
msgid "Text Export Field Separator"
msgstr "Fältseparator för textexport"

#. from gnome:gnumeric
msgid "Text Export Record Terminator"
msgstr "Postavslutare för textexport"

#. from gnome:gnumeric
msgid "Text Export Locale"
msgstr "Lokal för textexport"

#. from gnome:gnumeric
msgid "Text Export Encoding"
msgstr "Kodning för textexport"

#. from gnome:gnumeric
msgid "Text Export String Quoting Rule"
msgstr "Strängcitationsregel för textexport"

#. from gnome:gnumeric
msgid "Text Export Formatting Rule"
msgstr "Formateringsregel för textexport"

#. from gnome:gnumeric
msgid "Text Export Unknown Character Transliteration"
msgstr "Translitterera okända tecken vid textexport"

#. from gnome:gnumeric
msgid "Search &amp; Replace Ignores Case"
msgstr "Sök och ersätt ignorerar skiftläge"

#. from gnome:gnumeric
msgid "Search &amp; Replace ignores case as default"
msgstr "Sök och ersätt ignorerar skiftläge som standard"

#. from gnome:gnumeric
msgid "Search &amp; Replace Preserves Case"
msgstr "Sök och ersätt bevarar skiftläge"

#. from gnome:gnumeric
msgid "Search &amp; Replace preserves case as default"
msgstr "Sök och ersätt bevarar skiftläge som standard"

#. from gnome:gnumeric
msgid "Search &amp; Replace Poses Query"
msgstr "Sök och ersätt frågar"

#. from gnome:gnumeric
msgid "Search &amp; Replace poses query before each change as default"
msgstr "Sök och ersätt ställer som standard en fråga före varje ändring"

#. from gnome:gnumeric
msgid "Search &amp; Replace Whole Words Only"
msgstr "Sök och ersätt ersätter endast hela ord"

#. from gnome:gnumeric
msgid "Search &amp; Replace replaces whole words only as default"
msgstr "Sök och ersätt ersätter som standard endast hela ord"

#. from gnome:gnumeric
msgid "Search &amp; Replace Scope"
msgstr "Sök och ersätt omfång"

#. from gnome:gnumeric
msgid "This is the default scope of Search &amp; Replace. 0: entire workbook; 1: current sheet; 2: range"
msgstr "Detta är standardomfånget för Sök och ersätt. 0: hela arbetsboken; 1: aktuellt kalkylblad; 2: omfång"

#. from gnome:gnumeric
msgid "Search &amp; Replace Changes Strings"
msgstr "Sök och ersätt ändrar strängar"

#. from gnome:gnumeric
msgid "Search &amp; Replace changes cells containing strings as default"
msgstr "Sök och ersätt ändrar som standard celler som innehåller strängar"

#. from gnome:gnumeric
msgid "Search &amp; Replace Changes Expressions"
msgstr "Sök och ersätt ändrar uttryck"

#. from gnome:gnumeric
msgid "Search &amp; Replace changes cells containing expressions as default"
msgstr "Sök och ersätt ändrar som standard celler innehållandes uttryck"

#. from gnome:gnumeric
msgid "Search &amp; Replace Changes Other Values"
msgstr "Sök och ersätt ändrar andra värden"

#. from gnome:gnumeric
msgid "Search &amp; Replace changes cells containing other values as default"
msgstr "Sök och ersätt ändrar som standard celler innehållandes andra värden"

#. from gnome:gnumeric
msgid "Search &amp; Replace Changes Comments"
msgstr "Sök och ersätt ändrar kommentarer"

#. from gnome:gnumeric
msgid "Search &amp; Replace changes comments as default"
msgstr "Sök och ersätt ändrar kommentarer som standard"

#. from gnome:gnumeric
msgid "Search searches in results"
msgstr "Sök söker i resultat"

#. from gnome:gnumeric
msgid "Search searches in results as default"
msgstr "Sök söker som standard i resultat"

#. from gnome:gnumeric
msgid "Search &amp; Replace Keeps Strings as Strings"
msgstr "Sök och ersätt behåller strängar som strängar"

#. from gnome:gnumeric
msgid "Search &amp; Replace keeps strings as strings even if they look like numbers as default"
msgstr "Sök och ersätt behåller strängar som strängar även om det ser ut som tal"

#. from gnome:gnumeric
msgid "Search &amp; Replace Search Type"
msgstr "Söktyp för Sök och ersätt"

#. from gnome:gnumeric
msgid "This value determines the input type for Search &amp; Replace. 0: text; 1: regular expression; 2: number"
msgstr "Detta värde bestämmer inmatningstypen för Sök och ersätt. 0: text; 1: reguljära uttryck; 2: tal"

#. from gnome:gnumeric
msgid "Search &amp; Replace Column Major"
msgstr "Sök och ersätt i kolumnordning"

#. from gnome:gnumeric
msgid "Search &amp; Replace proceeds in column major order as default"
msgstr "Sök och ersätt går som standard i kolumnordning i det aktuella bladet"

#. from gnome:gnumeric
msgid "Search &amp; Replace Error Behavior"
msgstr "Sök och ersätt felbeteende"

#. from gnome:gnumeric
msgid "This is the default error behavior of Search &amp; Replace indicated by an integer from 0 to 4."
msgstr "Detta är standardfelbeteendet för Sök och ersätt indikerat av ett heltal från 0 till 4."

#. from gnome:gnumeric
msgid "Toolbar Style"
msgstr "Stil på verktygsfält"

#. from gnome:gnumeric
msgid "Toolbar Style. Valid values are both, both_horiz, icon, and text."
msgstr "Stil på verktygsfält. Godkända värden är both, both_horiz, icon och text."

#. from gnome:gnumeric
msgid "Show Sheet Name in Undo List"
msgstr "Visa bladnamn i ångralistan"

#. from gnome:gnumeric
msgid "This value determines whether to show the sheet names in the undo and redo lists."
msgstr "Det här värdet avgör om bladnamnen skall visas i ångra/gör om-listorna."

#. from gnome:gnumeric
msgid "Maximal Undo Size"
msgstr "Maximal ångrastorlek"

#. from gnome:gnumeric
msgid "This value determines the length of the undo chain. Each editing action has a size associate with it, to compare it with the memory requirements of a simple one-cell edit (size of 1). The undo list will be truncated when its total size exceeds this configurable value."
msgstr "Det här värdet anger storleken på ångrahögen. Varje redigeringsåtgärd har en storlek associerad, för att jämföras med minneskraven för en enkel redigering av en cell (storlek 1). Ångralistan trunkeras om dess totala storlek blir större än detta konfigurerbara värde."

#. from gnome:gnumeric
msgid "Number of Undo Items"
msgstr "Antal ångraobjekt"

#. from gnome:gnumeric
msgid "This value determines the maximum number of items in the undo/redo list."
msgstr "Det här värdet avgör det största antalet objekt i ångra/gör om-listan."

#. from gnome:gnumeric
msgid "Length of the Undo Descriptors"
msgstr "Längden på ångrabeskrivningarna"

#. from gnome:gnumeric
msgid "This value is indicative of the maximum length of the command descriptors in the undo and redo chains."
msgstr "Det här värdet indikerar den maximala längden av kommandobeskrivningarna i ångra/gör om-högarna."

#. from gnome:gnumeric
msgid "Default Font Size"
msgstr "Standardtypsnittstorlek"

#. from gnome:gnumeric
msgid "The default font size for new workbooks."
msgstr "Standardtypsnittsstorleken för nya arbetsböcker."

#. from gnome:gnumeric
msgid "Default font name"
msgstr "Standardtypsnitt"

#. from gnome:gnumeric
msgid "The default font name for new workbooks."
msgstr "Standardtypsnittsnamnet för nya arbetsböcker."

#. from gnome:gnumeric
msgid "The default font is bold."
msgstr "Standardtypsnittet är i fetstil."

#. from gnome:gnumeric
msgid "This value determines whether the default font for a new workbook is bold."
msgstr "Det här värdet avgör om standardtypsnittet för en ny arbetsbok är i fetstil."

#. from gnome:gnumeric
msgid "The default font is italic."
msgstr "Standardtypsnittet är kursivt."

#. from gnome:gnumeric
msgid "This value determines whether the default font for a new workbook is italic."
msgstr "Det här värdet avgör om standardtypsnittet för en ny arbetsbok är kursivt."

#. from gnome:gnumeric
msgid "Default Number of Sheets"
msgstr "Antal blad som standard"

#. from gnome:gnumeric
msgid "The number of sheets initially created in a new workbook."
msgstr "Antal blad som skapas för en ny arbetsbok."

#. from gnome:gnumeric
msgid "Default Number of rows in a sheet"
msgstr "Antal rader i ett blad som standard"

#. from gnome:gnumeric
msgid "The number of rows in each sheet. This setting will be used only in a new Gnumeric session."
msgstr "Antalet rader i varje blad. Denna inställning kommer att bara att användas i en ny Gnumeric-session."

#. from gnome:gnumeric
msgid "Default Number of columns in a sheet"
msgstr "Antal kolumner i ett blad som standard"

#. from gnome:gnumeric
msgid "The number of columns in each sheet. This setting will be used only in a new Gnumeric session."
msgstr "Antalet kolumner i varje blad. Denna inställning kommer att bara att användas i en ny Gnumeric-session."

#. from gnome:gnumeric
msgid "Autosave frequency"
msgstr "Frekvens för automatisk sparning"

#. from gnome:gnumeric
msgid "The number of seconds between autosaves."
msgstr "Antal sekunder mellan automatisk sparning."

#. from gnome:gnumeric
msgid "Horizontal DPI"
msgstr "Horisontell DPI"

#. from gnome:gnumeric
msgid "Screen resolution in the horizontal direction."
msgstr "Skärmens upplösning i horisontellt led."

#. from gnome:gnumeric
msgid "Vertical DPI"
msgstr "Vertikal DPI"

#. from gnome:gnumeric
msgid "Screen resolution in the vertical direction."
msgstr "Skärmens upplösning i vertikalt led."

#. from gnome:gnumeric
msgid "Standard toolbar visible"
msgstr "Standardverktygsfält synligt"

#. from gnome:gnumeric
msgid "This variable determines whether the standard toolbar should be visible initially."
msgstr "Den här variabeln avgör huruvida standardverktygsfältet ska vara initialt synligt."

#. from gnome:gnumeric
msgid "Standard toolbar position"
msgstr "Position för standardverktygsfält"

#. from gnome:gnumeric
msgid "This variable determines where the standard toolbar should be shown. 0 is left, 1 is right, 2 is top."
msgstr "Den här variabeln avgör var standardverktygsfältet ska visas. 0 är vänster, 1 är höger, 2 är toppen."

#. from gnome:gnumeric
msgid "Format toolbar visible"
msgstr "Formatverktygsfält synligt"

#. from gnome:gnumeric
msgid "This variable determines whether the format toolbar should be visible initially."
msgstr "Den här variabeln avgör huruvida formatverktygsfältet ska visas initialt."

#. from gnome:gnumeric
msgid "Format toolbar position"
msgstr "Position för formatverktygsfält"

#. from gnome:gnumeric
msgid "This variable determines where the format toolbar should be shown. 0 is left, 1 is right, 2 is top."
msgstr "Den här variabeln avgör var formatverktygsfältet ska visas. 0 är vänster, 1 är höger, 2 är toppen."

#. from gnome:gnumeric
msgid "Object toolbar visible"
msgstr "Objektverktygsfält synligt"

#. from gnome:gnumeric
msgid "This variable determines whether the object toolbar should be visible initially."
msgstr "Den här variabeln avgör huruvida objektverktygsfältet ska visas initialt."

#. from gnome:gnumeric
msgid "Object toolbar position"
msgstr "Position för objektverktygsfält"

#. from gnome:gnumeric
msgid "This variable determines where the object toolbar should be shown. 0 is left, 1 is right, 2 is top."
msgstr "Den här variabeln avgör var objektverktygsfältet ska visas. 0 är vänster, 1 är höger, 2 är toppen."

#. from gnome:gnumeric
msgid "Function Markers"
msgstr "Funktionsmarkörer"

#. from gnome:gnumeric
msgid "This variable determines whether cells containing spreadsheet function are marked."
msgstr "Den här variabeln avgör huruvida celler innehållandes kalkylbladsfunktioner är markerade."

#. from gnome:gnumeric
msgid "Extension Markers"
msgstr "Utökningsmarkörer"

#. from gnome:gnumeric
msgid "This variable determines whether cells with truncated content are marked."
msgstr "Den här variabeln avgör huruvida celler med trunkerat innehåll är markerade."

#. from gnome:gnumeric
msgid "Autocomplete"
msgstr "Autokomplettera"

#. from gnome:gnumeric
msgid "This variable determines whether autocompletion is set on."
msgstr "Den här variabeln avgör om autokomplettering är aktivt."

#. from gnome:gnumeric
msgid "Minimum Number of Characters for Autocompletion"
msgstr "Minsta antal tecken för autokomplettering"

#. from gnome:gnumeric
msgid "This variable determines the minimum number of characters required for autocompletion."
msgstr "Det här värdet avgör det minsta antalet tecken som krävs för autokomplettering."

#. from gnome:gnumeric
msgid "Show Function Name Tooltips"
msgstr "Visa inforutor för funktionsnamn"

#. from gnome:gnumeric
msgid "This variable determines whether to show function name tooltips."
msgstr "Den här variabeln avgör huruvida inforutor ska visas för funktionsnamn."

#. from gnome:gnumeric
msgid "Show Function Argument Tooltips"
msgstr "Visa inforuta för funktionsargument"

#. from gnome:gnumeric
msgid "This variable determines whether to show function argument tooltips."
msgstr "Den här variabeln avgör huruvida inforutor för funktionsargument ska visas."

#. from gnome:gnumeric
msgid "Enter Direction"
msgstr "Ange riktning"

#. from gnome:gnumeric
msgid "Which direction pressing Enter will move the edit position."
msgstr "Den riktning i vilken redigeringspositionen kommer att flyttas vid tryck på Retur."

#. from gnome:gnumeric
msgid "Auto Expression Recalculation Lag"
msgstr "Fördröjning för automatisk omberäkning av uttryck"

#. from gnome:gnumeric
msgid "If `lag' is 0, Gnumeric recalculates all auto expressions immediately after every change. Non-zero values of `lag' allow Gnumeric to accumulate more changes before each recalculation. If `lag' is positive, then whenever a change appears, Gnumeric waits `lag' milliseconds and then recalculates; if more changes appear during that period, they are also processed at that time. If `lag' is negative, then recalculation happens only after a quiet period of |lag| milliseconds."
msgstr "Om \"lag\" är 0 räknar Gnumeric om alla automatiska uttryck direkt efter varje förändring. Är \"lag\" inte noll väntar Gnumeric på fler ändringar innan uttrycken räknas om. Om \"lag\" är positivt så väntar Gnumeric i \"lag\" millisekunder och räknar sedan om; om fler ändringar har skett under den tidsperioden så bearbetas de också nu. Om \"lag\" är negativt så sker omräkning endast då inga ändringar har hänt i \"lag\" millisekunder."

#. from gnome:gnumeric
msgid "Transition Keys"
msgstr "Övergångsnycklar"

#. from gnome:gnumeric
msgid "This variable determines whether transition keys are set on. Transition keys are a throw back to 1-2-3 style event handling. They turn Ctrl-arrow into page movement rather than jumping to the start/end of series."
msgstr "Variabeln avgör huruvida övergångstangenter är på. Övergångstangenter påminner om händelsehantering för 1-2-3-stil. De förvandlar Ctrl-pil till en sidrörelse istället för att hoppa till start/slut i en serie."

#. from gnome:gnumeric
msgid "Default Horizontal Window Size"
msgstr "Horisontell fönsterstorlek som standard"

#. from gnome:gnumeric
msgid "This number (between 0.25 and 1.00) gives the horizontal fraction of the screen size covered by the default window."
msgstr "Det här värdet (mellan 0,25 och 1,00) anger den horisontella delen av skärmen som täcks av standardfönstret."

#. from gnome:gnumeric
msgid "Default Vertical Window Size"
msgstr "Vertikal fönsterstorlek som standard"

#. from gnome:gnumeric
msgid "This number (between 0.25 and 1.00) gives the vertical fraction of the screen size covered by the default window."
msgstr "Det här värdet (mellan 0,25 och 1,00) anger den vertikala delen av skärmen som täcks av standardfönstret."

#. from gnome:gnumeric
msgid "Default Zoom Factor"
msgstr "Zoomvärde som standard"

#. from gnome:gnumeric
msgid "The initial zoom factor for new workbooks."
msgstr "Standardinzoomningsvärdet för nya arbetsböcker."

#. from gnome:gnumeric
msgid "Default Compression Level For Gnumeric Files"
msgstr "Standardkompressionsnivå för Gnumeric-filer"

#. from gnome:gnumeric
msgid "This integer (between 0 and 9) specifies the amount of compression performed by Gnumeric when saving files in the default file format. 0 is minimal compression while 9 is maximal compression."
msgstr "Det här heltalet (mellan 0 och 9) anger mängden komprimering Gnumeric använder när den sparar i standardfilformatet. 0 är minimal komprimering och 9 är maximal komprimering."

#. from gnome:gnumeric
msgid "Warn When Exporting Into Single Sheet Format"
msgstr "Varna när export sker till ett enkelbladsformat"

#. from gnome:gnumeric
msgid "Some file formats can contain only a single sheet. This variable determines whether the user will be warned if only a single sheet of a multi-sheet workbook is being saved."
msgstr "Vissa filformat kan endast innehålla ett blad. Den här variabeln avgör om användaren blir varnad om endast ett blad i en arbetsbok med flera blad kommer att sparas."

#. from gnome:gnumeric
msgid "Default To Overwriting Files"
msgstr "Skriv över filer som standardinställning"

#. from gnome:gnumeric
msgid "Before an existing file is being overwritten, Gnumeric will present a warning dialog. Setting this option will make the overwrite button in that dialog the default button."
msgstr "Innan en befintlig fil skrivs över visar Gnumeric en varningsdialogruta. Det här alternativet sätter överskrivningsknappen som standardvalet."

#. from gnome:gnumeric
msgid "List of file savers with disabled extension check."
msgstr "Lista över filsparare med inaktiverad utökningskontroll."

#. from gnome:gnumeric
msgid "This list contains the ids of the file savers for which the extension check is disabled."
msgstr "Denna lista innehåller id:n för filsparare för vilka utökningskontrollen är inaktiverad."

#. from gnome:gnumeric
msgid "Sort is Case-Sensitive"
msgstr "Sortering gör skillnad på gemener/VERSALER"

#. from gnome:gnumeric
msgid "Setting this option will cause the sort buttons on the toolbar to perform a case-sensitive sort and determine the initial state of the case-sensitive checkbox in the sort dialog."
msgstr "Sätts detta val kommer sorteringsknapparna på verktygsfältet att sortera med hänsyn till gemener/VERSALER och avgör också standardinställningen för kryssrutan för gemener/VERSALER i sorteringsdialogen."

#. from gnome:gnumeric
msgid "Sorting Preserves Formats"
msgstr "Sortering bevarar format"

#. from gnome:gnumeric
msgid "Setting this option will cause the sort buttons on the toolbar to preserve the cell formats while sorting and determines the initial state of the preserve-formats checkbox in the sort dialog."
msgstr "Sätts detta val kommer sorteringsknapparna på verktygsfältet att behålla cellformaten under sorteringen och avgör också standardinställningen för kryssrutan för behåll-cellformat i sorteringsdialogen."

#. from gnome:gnumeric
msgid "Sort Ascending"
msgstr "Sortera stigande"

#. from gnome:gnumeric
msgid "This option determines the initial state of the sort-order button in the sort dialog."
msgstr "Det här valet avgör standardläget för sorteringsordningsknappen i sorteringsdialogen."

#. from gnome:gnumeric
msgid "Number of Automatic Clauses"
msgstr "Antal automatiska satser"

#. from gnome:gnumeric
msgid "When selecting a sort region in the sort dialog, sort clauses are automatically added. This number determines the maximum number of clauses to be added automatically."
msgstr "När ett sorteringsområde väljs i sorteringsdialogen läggs sorteringssatser till automatiskt. Detta värde bestämmer det maximala antalet satser att läggas till automatiskt."

#. from gnome:gnumeric
msgid "Prefer CLIPBOARD over PRIMARY selection"
msgstr "Föredrar CLIPBOARD före PRIMARY-val"

#. from gnome:gnumeric
msgid "When TRUE, Gnumeric will prefer the modern CLIPBOARD selection over the legacy PRIMARY selections. Set to FALSE if you have to deal with older applications, like Xterm or Emacs, which set only the PRIMARY selection."
msgstr "När TRUE, föredrar Gnumeric den moderna CLIPBOARD-urklippet framför de gamla PRIMARY-valen. Sätt till FALSE om du måste arbeta med äldre program, som Xterm eller Emacs, som endast sätter PRIMARY-valet."

#. from gnome:gnumeric
msgid "Use UTF-8 in LaTeX Export"
msgstr "Använd UTF-8 i LaTeX-export"

#. from gnome:gnumeric
msgid "This setting determines whether created LaTeX files use UTF-8 (unicode) or ISO-8859-1 (Latin1). To use the UTF-8 files, you must have the ucs LaTeX package installed."
msgstr "Den här inställningen avgör om LaTeX-filer använder UTF-8 (unicode) eller ISO-8859-1 (Latin1). För att använda UTF-8-filer måste du ha ucs LaTeX-paketet installerat."

#. from gnome:gnumeric
msgid "Full path of lp_solve program to use"
msgstr "Sökvägen till det lp_solve-program som ska användas"

#. from gnome:gnumeric
msgid "This is the full path to the lp_solve binary that the lpsolve plugin should use."
msgstr "Detta är hela sökvägen till binären för lp_solve som insticksmodulen för lpsolve ska använda."

#. from gnome:gnumeric
