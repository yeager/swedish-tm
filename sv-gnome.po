msgstr "Aktivera omedelbara uri-ändringar (endast med playbin3)"

#. from gnome:reviewed/gstreamer/main
msgid "Shuffle playlist"
msgstr "Blanda spellista"

#. from gnome:reviewed/gstreamer/main
msgid "Disable interactive control via the keyboard"
msgstr "Inaktivera interaktiv styrning via tangentbordet"

#. from gnome:reviewed/gstreamer/main
msgid "Start position in seconds."
msgstr "Startposition i sekunder."

#. from gnome:reviewed/gstreamer/main
msgid "Enable accurate seeking"
msgstr "Aktivera noggrann sökning"

#. from gnome:reviewed/gstreamer/main
msgid "Playlist file containing input media files"
msgstr "Fil med spellista innehållandes inkommande mediafiler"

#. from gnome:reviewed/gstreamer/main
msgid "Use the experimental instant-rate-change flag when changing rate"
msgstr ""
"Använd den experimentella flaggan för omedelbar hastighetsändring vid "
"ändring av hastighet"

#. from gnome:reviewed/gstreamer/main
msgid "Do not print any output (apart from errors)"
msgstr "Mata inte ut någonting (bortsett från fel)"

#. from gnome:reviewed/gstreamer/main
msgid "Use playbin3 pipeline (default)"
msgstr "Använd playbin3-rörledning (standard)"

#. from gnome:reviewed/gstreamer/main
msgid "Use playbin2 pipeline"
msgstr "Använd playbin2-rörledning"

#. from gnome:reviewed/gstreamer/main
msgid ""
"Keep showing the last frame on EOS until quit or playlist change command "
"(gapless is ignored)"
msgstr ""
"Fortsätt visa den sista ramen vid EOS tills avslutning eller "
"ändringskommando för spellista (mellanrumslös hoppas över)"

#. from gnome:reviewed/gstreamer/main
msgid "Do not print current position of pipeline"
msgstr "Skriv inte ut aktuell position för rörledningen"

#. from gnome:reviewed/gstreamer/main
msgid "Disable missing plugin installation"
msgstr "Inaktivera saknad insticksmodulsinstallation"

#. from gnome:reviewed/gstreamer/main
msgid "Usage: %s FILE1|URI1 [FILE2|URI2] [FILE3|URI3] ..."
msgstr "Användning: %s FIL1|URI1 [FIL2|URI2] [FIL3|URI3] ..."

#. from gnome:reviewed/gstreamer/main
msgid "You must provide at least one filename or URI to play."
msgstr "Du måste ange åtminstone ett filnamn eller en URI att spela."

#. from gnome:reviewed/gstreamer/main
msgid "Press 'k' to see a list of keyboard shortcuts.\n"
msgstr "Tryck på 'k' för att se en lista över tangentbordsgenvägar.\n"

#. from gnome:reviewed/gnome-initial-setup/main
msgid "_Grant administrative privileges to first user"
msgstr "_Ge administratörsbehörighet till den första användaren"

#. from gnome:reviewed/gnome-initial-setup/main
msgid "Failed to create parent user: "
msgstr "Misslyckades med att skapa föräldraanvändare: "

#. from gnome:reviewed/gnome-initial-setup/main
msgctxt "Wireless access point"
msgid "Other…"
msgstr "Andra…"

#. from gnome:reviewed/gnome-initial-setup/main
msgctxt "Password hint"
msgid "The new password needs to be different from the old one."
msgstr "Det nya lösenordet måste skilja sig från det gamla."

#. from gnome:reviewed/gnome-initial-setup/main
msgctxt "Password hint"
msgid ""
"This password is very similar to your last one. Try changing some letters "
"and numbers."
msgstr ""
"Detta lösenord liknar ditt föregående väldigt mycket. Försök att ändra några"
" bokstäver och siffror."

#. from gnome:reviewed/gnome-initial-setup/main
msgctxt "Password hint"
msgid ""
"This password is very similar to your last one. Try changing the password a "
"bit more."
msgstr ""
"Detta lösenord liknar ditt föregående väldigt mycket. Försök att ändra "
"lösenordet lite till."

#. from gnome:reviewed/gnome-initial-setup/main
msgctxt "Password hint"
msgid ""
"This is a weak password. A password without your user name would be "
"stronger."
msgstr ""
"Detta är ett svagt lösenord. Ett lösenord utan ditt användarnamn skulle vara"
" säkrare."

#. from gnome:reviewed/gnome-initial-setup/main
msgctxt "Password hint"
msgid "This is a weak password. Try to avoid using your name in the password."
msgstr ""
"Detta är ett svagt lösenord. Försök att undvika att använda ditt namn i "
"lösenordet."

#. from gnome:reviewed/gnome-initial-setup/main
msgctxt "Password hint"
msgid ""
"This is a weak password. Try to avoid some of the words included in the "
"password."
msgstr ""
"Detta är ett svagt lösenord. Försök att undvika några av orden som ingår i "
"lösenordet."

#. from gnome:reviewed/gnome-initial-setup/main
msgctxt "Password hint"
msgid "This is a weak password. Try to avoid common words."
msgstr "Detta är ett svagt lösenord. Försök att undvika vanliga ord."

#. from gnome:reviewed/gnome-initial-setup/main
msgctxt "Password hint"
msgid "This is a weak password. Try to avoid reordering existing words."
msgstr ""
"Detta är ett svagt lösenord. Försök att undvika att kasta om existerande "
"ord."

#. from gnome:reviewed/gnome-initial-setup/main
msgctxt "Password hint"
msgid "This is a weak password. Try to use more numbers."
msgstr "Detta är ett svagt lösenord. Försök att använda fler siffror."

#. from gnome:reviewed/gnome-initial-setup/main
msgctxt "Password hint"
msgid "This is a weak password. Try to use more uppercase letters."
msgstr "Detta är ett svagt lösenord. Försök att använda fler stora bokstäver."

#. from gnome:reviewed/gnome-initial-setup/main
msgctxt "Password hint"
msgid "This is a weak password. Try to use more lowercase letters."
msgstr "Detta är ett svagt lösenord. Försök att använda fler små bokstäver."

#. from gnome:reviewed/gnome-initial-setup/main
msgctxt "Password hint"
msgid ""
"This is a weak password. Try to use more special characters, like "
"punctuation."
msgstr ""
"Detta är ett svagt lösenord. Försök att använda fler specialtecken, till "
"exempel skiljetecken."

#. from gnome:reviewed/gnome-initial-setup/main
msgctxt "Password hint"
msgid ""
"This is a weak password. Try to use a mixture of letters, numbers and "
"punctuation."
msgstr ""
"Detta är ett svagt lösenord. Försök att använda en blandning av bokstäver, "
"siffror och skiljetecken."

#. from gnome:reviewed/gnome-initial-setup/main
msgctxt "Password hint"
msgid "This is a weak password. Try to avoid repeating the same character."
msgstr ""
"Detta är ett svagt lösenord. Försök att undvika att upprepa samma tecken."

#. from gnome:reviewed/gnome-initial-setup/main
msgctxt "Password hint"
msgid ""
"This is a weak password. Try to avoid repeating the same type of character: "
"you need to mix up letters, numbers and punctuation."
msgstr ""
"Detta är ett svagt lösenord. Försök att undvika att upprepa samma typ av "
"tecken: du behöver blanda bokstäver, nummer och skiljetecken."

#. from gnome:reviewed/gnome-initial-setup/main
msgctxt "Password hint"
msgid "This is a weak password. Try to avoid sequences like 1234 or abcd."
msgstr ""
"Detta är ett svagt lösenord. Försök att undvika sekvenser som 1234 eller "
"abcd."

#. from gnome:reviewed/gnome-initial-setup/main
msgctxt "Password hint"
msgid ""
"This is a weak password. Try to add more letters, numbers and punctuation."
msgstr ""
"Detta är ett svagt lösenord. Försök att lägga till fler bokstäver, siffror "
"och skiljetecken."

#. from gnome:reviewed/gnome-initial-setup/main
msgctxt "Password hint"
msgid "Mix uppercase and lowercase and try to use a number or two."
msgstr ""
"Blanda stora och små bokstäver samt försök använda en siffra eller två."

#. from gnome:reviewed/gnome-initial-setup/main
msgctxt "Password hint"
msgid ""
"Adding more letters, numbers and punctuation will make the password "
"stronger."
msgstr ""
"Att lägga till fler bokstäver, siffror och skiljetecken kommer göra "
"lösenordet starkare."

#. from gnome:reviewed/gnome-initial-setup/main
msgid ""
"Error Type: %s\n"
"Message: %s"
msgstr ""
"Feltyp: %s\n"
"Meddelande: %s"

#. from gnome:reviewed/gnome-initial-setup/main
msgctxt "timezone loc"
msgid "%s, %s"
msgstr "%s, %s"

#. from gnome:reviewed/gnome-initial-setup/main
msgctxt "timezone map"
msgid "%s (%s)"
msgstr "%s (%s)"

#. from gnome:reviewed/meld/main
msgid "Meld requires %s."
msgstr "Meld kräver %s."

#. from gnome:reviewed/meld/main
msgid "Meld"
msgstr "Meld"

#. from gnome:reviewed/meld/main
msgid "Diff Viewer"
msgstr "Diffvisare"

#. from gnome:reviewed/meld/main
msgid "Compare and merge your files"
msgstr "Jämför och sammanfoga dina filer"

#. from gnome:reviewed/meld/main
msgid "diff;merge;"
msgstr "diff;merge;sammanfogning;"

#. from gnome:reviewed/meld/main
msgid "Meld comparison description"
msgstr "Meld jämförelsebeskrivning"

#. from gnome:reviewed/meld/main
msgid "Default window maximized state"
msgstr "Maximeringstillstånd för standardfönster"

#. from gnome:reviewed/meld/main
msgid ""
"Whether to force the light or dark variant of the GTK theme. If set to "
"'default', the application will follow the system default variant."
msgstr ""
"Huruvida den ljusa eller mörka varianten av GTK-temat ska tvingas. Om satt "
"till ”default” (standard), kommer programmet följa systemets "
"standardvariant."

#. from gnome:reviewed/meld/main
msgid "Additional automatically detected text encodings"
msgstr "Ytterligare automatiskt upptäckta textkodningar"

#. from gnome:reviewed/meld/main
msgid ""
"Meld will use these text encodings to try to decode loaded text files before"
" trying any other encodings. In addition to the encodings in this list, "
"UTF-8 and the current locale-default encoding will always be used; other "
"encodings may also be tried, depending on the user’s locale."
msgstr ""
"Meld kommer använda dessa textkodningar för att försöka avkoda inlästa "
"textfiler innan andra kodningar provas. Utöver kodningarna i denna lista "
"kommer UTF-8 och standardkodningen för aktuell lokal alltid att användas. "
"Andra kodningar kan också provas beroende på användarens lokal."

#. from gnome:reviewed/meld/main
msgid "Width of an indentation step"
msgstr "Bredden på ett indenteringssteg"

#. from gnome:reviewed/meld/main
msgid "The number of spaces to use for a single indent step"
msgstr "Antalet blanksteg att använda för ett ensamt indenteringssteg"

#. from gnome:reviewed/meld/main
msgid "Whether to indent using spaces or tabs"
msgstr "Huruvida indentering sker med blanksteg eller tabb"

#. from gnome:reviewed/meld/main
msgid "If true, any new indentation will use spaces instead of tabs."
msgstr ""
"Om true kommer nya indenteringar att använda blanksteg i stället för tabbar."

#. from gnome:reviewed/meld/main
msgid "If true, line numbers will be shown in the gutter of file comparisons."
msgstr "Om true visas radnummer i marginalen på filjämförelserna."

#. from gnome:reviewed/meld/main
msgid "Highlight syntax"
msgstr "Markera syntax"

#. from gnome:reviewed/meld/main
msgid "Whether to highlight syntax in comparisons."
msgstr "Om syntax ska färgmarkeras i jämförelser."

#. from gnome:reviewed/meld/main
msgid "Draw whitespace"
msgstr "Rita ut tomrum"

#. from gnome:reviewed/meld/main
msgid ""
"If true, whitespace characters will be drawn in comparisons even if they are"
" not in a changed area."
msgstr ""
"Om true (sant), kommer tomrumstecken att ritas ut i jämförelser även om de "
"inte är i ett ändrat område."

#. from gnome:reviewed/meld/main
msgid ""
"Lines in file comparisons will be wrapped according to this setting, either "
"not at all ('none'), at any character ('char') or only at the end of words "
"('word')."
msgstr ""
"Rader i filjämförelser kommer att radbrytas enligt denna inställning, "
"antingen inte alls (\"none\"), vid vilket tecken som helst (\"char\") eller "
"bara vid slutet av ord (\"word\")."

#. from gnome:reviewed/meld/main
msgid ""
"If true, the line containing the cursor will be highlighted in file "
"comparisons."
msgstr "Om true kommer raden med markören att bli markerad i filjämförelser."

#. from gnome:reviewed/meld/main
msgid "Use the system default monospace font"
msgstr "Använd systemets standard typsnitt med fast breddsteg"

#. from gnome:reviewed/meld/main
msgid ""
"If false, custom-font will be used instead of the system monospace font."
msgstr ""
"Om false kommer det anpassade typsnittet att användas i stället för "
"systemets monospace-typsnitt."

#. from gnome:reviewed/meld/main
msgid "Custom font"
msgstr "Anpassat typsnitt"

#. from gnome:reviewed/meld/main
msgid ""
"The custom font to use, stored as a string and parsed as a Pango font "
"description."
msgstr ""
"Det anpassade typsnittet att använda, lagrat som en sträng och tolkat som en"
" som en Pango typsnittsbeskrivning."

#. from gnome:reviewed/meld/main
msgid "Show overview source map"
msgstr "Visa översiktskällkodskarta"

#. from gnome:reviewed/meld/main
msgid ""
"If true, file comparisons will have paired source maps for compared files."
msgstr ""
"Om true (sant), kommer filjämförelser ha ihopparade källkodskartor för "
"jämförda filer."

#. from gnome:reviewed/meld/main
msgid "Style of overview map"
msgstr "Stil för översiktskarta"

#. from gnome:reviewed/meld/main
msgid "Style options for how the overview map is displayed."
msgstr "Stilalternativ för hur översiktskartan visas."

#. from gnome:reviewed/meld/main
msgid "Ignore blank lines when comparing files"
msgstr "Ignorera tomma rader vid filjämförelser"

#. from gnome:reviewed/meld/main
msgid ""
"If true, blank lines will be trimmed when highlighting changes between "
"files."
msgstr ""
"Om true kommer tomma rader att tas bort när ändringar markeras mellan filer."

#. from gnome:reviewed/meld/main
msgid "Use the system default editor"
msgstr "Använd systemets standardredigerare"

#. from gnome:reviewed/meld/main
msgid ""
"If false, custom-editor-command will be used instead of the system editor "
"when opening files externally."
msgstr ""
"Om false kommer den anpassade redigeraren att användas i stället för "
"systemredigeraren när filer öppnas externt."

#. from gnome:reviewed/meld/main
msgid "The custom editor launch command"
msgstr "Kommandot för att starta anpassad redigerare"

#. from gnome:reviewed/meld/main
msgid ""
"The command used to launch a custom editor. Some limited templating is "
"supported here; at the moment '{file}' and '{line}' are recognised tokens."
msgstr ""
"Kommandot för att starta en anpassad redigerare. Begränsat mallstöd här; för"
" tillfället är ”{file}” och ”{line}” igenkända informationsbärare."

#. from gnome:reviewed/meld/main
msgid "Columns to display"
msgstr "Kolumner att visa"

#. from gnome:reviewed/meld/main
msgid ""
"List of column names in folder comparison and whether they should be "
"displayed."
msgstr "Lista av kolumnnamn vid mappjämförelse och huruvida de ska visas."

#. from gnome:reviewed/meld/main
msgid "Ignore symbolic links"
msgstr "Ignorera symboliska länkar"

#. from gnome:reviewed/meld/main
msgid ""
"If true, folder comparisons do not follow symbolic links when traversing the"
" folder tree."
msgstr ""
"Om true följer inte mappjämförelser symboliska länkar när mappträdet "
"genomsöks."

#. from gnome:reviewed/meld/main
msgid "Use shallow comparison"
msgstr "Använd ytlig jämförelse"

#. from gnome:reviewed/meld/main
msgid ""
"If true, folder comparisons compare files based solely on size and mtime, "
"considering files to be identical if their size and mtime match, and "
"different otherwise."
msgstr ""
"Om true sker mappjämförelser endast baserat på storlek och mtime och bedömer"
" filerna identiska om deras storlek och mtime matchar, annars inte."

#. from gnome:reviewed/meld/main
msgid "File timestamp resolution"
msgstr "Tidsstämpelupplösning på filen"

#. from gnome:reviewed/meld/main
msgid ""
"When comparing based on mtime, this is the minimum difference in nanoseconds"
" between two files before they’re considered to have different mtimes. This "
"is useful when comparing files between filesystems with different timestamp "
"resolution."
msgstr ""
"När jämförelser baserade på mtime sker så är detta minsta skillnaden i "
"nanosekunder mellan två filer innan de anses ha olika mtime. Det är "
"användbart när filer jämförs på olika filsystem med olika "
"tidsstämpelupplösningar."

#. from gnome:reviewed/meld/main
msgid "Apply text filters during folder comparisons"
msgstr "Verkställ textfilter vid mappjämförelser"

#. from gnome:reviewed/meld/main
msgid ""
"If true, folder comparisons that compare file contents also apply active "
"text filters and the blank line trimming option, and ignore newline "
"differences."
msgstr ""
"Om true kommer mappjämförelser som jämför filinnehåll också att verkställa "
"aktiva textfilter och alternativet att trimma tomma rader samt ignorera "
"nyradsskillnader."

#. from gnome:reviewed/meld/main
msgid "File status filters"
msgstr "Filstatusfilter"

#. from gnome:reviewed/meld/main
msgid "List of statuses used to filter visible files in folder comparison."
msgstr ""
"Lista över statusar använda till att filtrera synliga filer vid "
"mappjämförelse."

#. from gnome:reviewed/meld/main
msgid "Show the version control console output"
msgstr "Visa versionshanterarens konsolutmatning"

#. from gnome:reviewed/meld/main
msgid ""
"If true, a console output section will be shown in version control views, "
"showing the commands run for version control operations."
msgstr ""
"Om true kommer en konsolutmatning att visas i versionshanteringsvyer, "
"visandes de kommandon som körs vid versionshanteringsåtgärder."

#. from gnome:reviewed/meld/main
msgid "Version control pane position"
msgstr "Position för versionshanteringspanelen"

#. from gnome:reviewed/meld/main
msgid ""
"This is the height of the main version control tree when the console pane is"
" shown."
msgstr ""
"Detta är höjden på huvudträdet för versionshanteringen när konsolpanelen "
"visas."

#. from gnome:reviewed/meld/main
msgid "Present version comparisons as left-local/right-remote"
msgstr "Visa versionsjämförelser som vänster-lokal/höger-fjärr"

#. from gnome:reviewed/meld/main
msgid ""
"If true, version control comparisons will use a left-is-local, right-is-"
"remote scheme to determine what order to present files in panes. Otherwise, "
"a left-is-theirs, right-is-mine scheme is used."
msgstr ""
"Om true kommer jämförelser med versionshantering att använda ett vänster-är-"
"lokal-, höger-är-fjärr-schema för att bestämma i vilken ordning filerna ska "
"presenteras i paneler. Annars används ett vänster-är-deras-, höger-är-mitt-"
"schema."

#. from gnome:reviewed/meld/main
msgid "Order for files in three-way version control merge comparisons"
msgstr "Sortering för filer i trevägsjämförelser med versionshantering"

#. from gnome:reviewed/meld/main
msgid ""
"Choices for file order are remote/merged/local and local/merged/remote. This"
" preference only affects three-way comparisons launched from the version "
"control view, so is used solely for merges/conflict resolution within Meld."
msgstr ""
"Val för filsortering är fjärr/sammanfogad/lokal och lokal/sammanfogad/fjärr."
" Denna inställning påverkar bara trevägsjämförelser startade från "
"versionshanteringsvyn, och används endast för sammanfogning/konfliktlösning "
"i Meld."

#. from gnome:reviewed/meld/main
msgid "Show margin in commit message editor"
msgstr "Visa marginal i redigeraren för incheckningsmeddelanden"

#. from gnome:reviewed/meld/main
msgid ""
"If true, a guide will be displayed to show what column the margin is at in "
"the version control commit message editor."
msgstr ""
"Om true så visas en guide för marginalens kolumn i "
"versionshanteringsredigeraren för incheckningsmeddelanden."

#. from gnome:reviewed/meld/main
msgid "Margin column in commit message editor"
msgstr "Marginalkolumn i redigeraren för incheckningsmeddelanden"

#. from gnome:reviewed/meld/main
msgid ""
"The column at which to show the margin in the version control commit message"
" editor."
msgstr ""
"Kolumnen i vilken marginalen ska visas i versionshanteringsredigeraren för "
"incheckningsmeddelanden."

#. from gnome:reviewed/meld/main
msgid "Automatically hard-wrap commit messages"
msgstr "Automatisk radbrytning av incheckningsmeddelanden"

#. from gnome:reviewed/meld/main
msgid ""
"If true, the version control commit message editor will hard-wrap (i.e., "
"insert line breaks) at the commit margin before commit."
msgstr ""
"Om true kommer versionshanteringsredigeraren för incheckningsmeddelanden att"
" radbrytas (d.v.s. infoga radbrytning) vid incheckningsmarginalen före "
"incheckning."

#. from gnome:reviewed/meld/main
msgid "Version control status filters"
msgstr "Statusfilter för versionshantering"

#. from gnome:reviewed/meld/main
msgid ""
"List of statuses used to filter visible files in version control comparison."
msgstr ""
"Statuslista använd för att filtrera synliga filer vid "
"versionshanteringsjämförelse."

#. from gnome:reviewed/meld/main
msgid ""
"[\n"
"              (\"Backups\", true, \"#*# .#* ~* *~ *.{orig,bak,swp}\"),\n"
"              (\"OS-Specific Metadata\", true, \".DS_Store ._* .Spotlight-V100 .Trashes Thumbs.db Desktop.ini\"),\n"
"              (\"Version Control\", true, \"_MTN .bzr .svn .svn .hg .fslckout _FOSSIL_ .fos CVS _darcs .git .svn .osc\"),\n"
"              (\"Binaries\", true, \"*.{pyc,a,obj,o,so,la,lib,dll,exe}\"),\n"
