msgid "Active spellcheck language for text"
msgstr "Aktivt stavningskontrollspråk för text"

#. from gnome:gnome-subtitles
msgid "The language used to check the spelling of subtitle text."
msgstr "Språket att använda för att kontrollera stavning av undertexter."

#. from gnome:gnome-subtitles
msgid "Active spellcheck language for translation"
msgstr "Aktivt stavningskontrollspråk för översättning"

#. from gnome:gnome-subtitles
msgid "The language used to check the spelling of subtitle translation."
msgstr "Språket att använda för att kontrollera stavning av översättning av undertexter."

#. from gnome:gnome-subtitles
msgid "Autocheck spelling"
msgstr "Kontrollera stavning automatiskt"

#. from gnome:gnome-subtitles
msgid "Whether to automatically check the spelling of subtitle text."
msgstr "Huruvida stavning automatiskt ska kontrolleras för undertexter."

#. from gnome:gnome-subtitles
msgid "Auto backup"
msgstr "Automatisk säkerhetskopiering"

#. from gnome:gnome-subtitles
msgid "Whether to automatically backup files. A copy of the file will be periodically saved with a ~ suffix."
msgstr "Huruvida filer ska säkerhetskopieras automatiskt. En kopia av filen kommer med jämna mellanrum sparas med ändelsen ~."

#. from gnome:gnome-subtitles
msgid "Backup time"
msgstr "Tid för säkerhetskopior"

#. from gnome:gnome-subtitles
msgid "Time interval, in seconds, to automatically backup files. A minimum of 30 seconds is recommended."
msgstr "Tidsintervall i sekunder för att automatiskt säkerhetskopiera filer. Minst 30 sekunder rekommenderas."

#. from gnome:gnome-subtitles
msgid "Time step increment"
msgstr "Tidsstegökning"

#. from gnome:gnome-subtitles
msgid "Time, in milliseconds, to add or subtract when adjusting times in spinbutton controls (e.g., start, end and duration)."
msgstr "Tid i millisekunder att lägga till eller subtrahera när tidsvärden justeras i stegningsrutor (t.ex. start, slut och längd)."

#. from gnome:gnome-subtitles
msgid "Frames step increment"
