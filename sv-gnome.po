#. from gnome:reviewed/gimp-help — GIMP User Manual/master
msgid ""
"Parameter /INSTALL requires parameters /DIR and /ALLUSERS or /CURRENTUSER."
msgstr ""
"Parametern /INSTALL kräver parametrarna /DIR och /ALLUSERS eller "
"/CURRENTUSER."

#. from gnome:reviewed/gimp-help — GIMP User Manual/master
msgid ""
"No suitable GIMP installations were found. %1 can only be installed when "
"GIMP %2 is already present."
msgstr ""
"Inga lämpliga GIMP-installationer hittades. %1 kan endast installeras om "
"GIMP %2 redan är installerat."

#. from gnome:reviewed/gimp-help — GIMP User Manual/master
