#. from gnome:reviewed/gnumeric/master/help
msgid ""
"<function>EFFECT</function>(<parameter>rate</parameter>,<parameter>nper</parameter>)"
msgstr ""
"<function>EFFECT</function>(<parameter>ränta</parameter>;<parameter>antal_perioder</parameter>)"

#. from gnome:reviewed/gnumeric/master/help
msgid "<parameter>nper</parameter>: number of periods used for compounding"
msgstr ""
"<parameter>antal_perioder</parameter>: antal perioder använda för "
"sammanräkning"

#. from gnome:reviewed/gnumeric/master/help
msgid ""
"<function>EFFECT</function> calculates the effective interest rate using the"
" formula "
"(1+<parameter>rate</parameter>/<parameter>nper</parameter>)^<parameter>nper</parameter>-1."
msgstr ""
"<function>EFFECT</function> beräknar den effektiva räntesatsen med formeln "
"(1+<parameter>ränta</parameter>/<parameter>antal_perioder</parameter>)^<parameter>antal_perioder</parameter>-1."

#. from gnome:reviewed/gnumeric/master/help
msgid ""
"<function>FV</function>(<parameter>rate</parameter>,<parameter>nper</parameter>,<parameter>pmt</parameter>,<parameter>pv</parameter>,<parameter>type</parameter>)"
msgstr ""
"<function>FV</function>(<parameter>ränta</parameter>;<parameter>antal_perioder</parameter>;<parameter>bet</parameter>;<parameter>nv</parameter>;<parameter>typ</parameter>)"

#. from gnome:reviewed/gnumeric/master/help
msgid ""
"<function>FV</function> calculates the future value of "
"<parameter>pv</parameter> moved <parameter>nper</parameter> periods into the"
" future, assuming a periodic payment of <parameter>pmt</parameter> and an "
"interest rate of <parameter>rate</parameter> per period."
msgstr ""
"<function>FV</function> beräknar det framtida värdet av "
"<parameter>pv</parameter> flyttad <parameter>antal_perioder</parameter> "
"perioder till framtiden, antagande en periodisk betalning av "
"<parameter>bet</parameter> och en räntesats <parameter>ränta</parameter> per"
" period."

