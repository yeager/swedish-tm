msgstr ""
"Indikerar referensen som används för att ange bäringen till "
"destinationspunkten. ”T” betecknar sann riktning och ”M” magnetisk riktning."

#. from gnome:reviewed/gnome-commander/main
msgid "GPS Destination Bearing"
msgstr "GPS-destinationsbäring"

#. from gnome:reviewed/gnome-commander/main
msgid ""
"Indicates the bearing to the destination point. The range of values is from "
"0.00 to 359.99."
msgstr ""
"Indikerar bäringen till destinationspunkten. Värdeintervallet är från 0.00 "
"till 359.99."

#. from gnome:reviewed/gnome-commander/main
msgid "GPS Destination Distance Reference"
msgstr "GPS-destinationsavståndsreferens"

#. from gnome:reviewed/gnome-commander/main
msgid ""
"Indicates the unit used to express the distance to the destination point. "
"\"K\", \"M\" and \"N\" represent kilometers, miles and nautical miles."
msgstr ""
"Indikerar enheten som används för att uttrycka avståndet till "
"destinationspunkten. ”K”, ”M” och ”N” representerar kilometer, engelska mil "
"och nautiska mil."

