msgstr "Är en matris uppåt triangulär"

#. from gnome:genius
msgid "Is a matrix lower triangular"
msgstr "Är en matris nedåt triangulär"

#. from gnome:genius
msgid "Is a matrix diagonal"
msgstr "Är en matris diagonal"

