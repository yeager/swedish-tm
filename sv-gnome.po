#. from gnome:reviewed/gimp-help — GIMP User Manual/master
msgid "Example for the Waves filter"
msgstr "Exempel på filtret Vågor"

#. from gnome:reviewed/gimp-help — GIMP User Manual/master
msgid "Filter <quote>Waves</quote> applied"
msgstr "Filtret <quote>Vågor</quote> tillämpat"

#. from gnome:reviewed/gimp-help — GIMP User Manual/master
msgid ""
"With this filter you get the same effect as a stone thrown in a quiet pond, "
"giving concentric waves."
msgstr ""
"Med detta filter får du samma effekt som av en sten som kastas i en stilla "
"damm och ger koncentriska vågor."

#. from gnome:reviewed/gimp-help — GIMP User Manual/master
msgid ""
"You can find this filter through "
"<menuchoice><guimenu>Filters</guimenu><guisubmenu>Distorts</guisubmenu><guimenuitem>Waves</guimenuitem></menuchoice>."
msgstr ""
"Du hittar filtret via "
"<menuchoice><guimenu>Filter</guimenu><guisubmenu>Förvrängningar</guisubmenu><guimenuitem>Vågor</guimenuitem></menuchoice>."

#. from gnome:reviewed/gimp-help — GIMP User Manual/master
msgid ""
"All your setting changes will appear in the Preview without affecting the "
"image until you click on <guilabel>OK</guilabel>. Don't keep <emphasis>Do "
"Preview</emphasis> checked if your computer is too much slow."
msgstr ""
"Alla ändringar av dina inställningar visas i förhandsvisningen utan att "
"påverka bilden förrän du klickar på <guilabel>OK</guilabel>. Låt inte "
"<emphasis>Förhandsvisa</emphasis> vara markerat om datorn är för långsam."

#. from gnome:reviewed/gimp-help — GIMP User Manual/master
msgid ""
"<guilabel>Smear</guilabel>: Because of the waves, areas are rendered empty "
"on sides. The adjacent pixels will spread to fill them."
msgstr ""
"<guilabel>Smeta ut</guilabel>: På grund av vågorna ritas tomma områden vid "
"sidorna. Angränsande bildpunkter sprids för att fylla dem."

#. from gnome:reviewed/gimp-help — GIMP User Manual/master
msgid ""
"<guilabel>Blacken</guilabel>: The empty areas will be filled by black color."
msgstr "<guilabel>Svärta</guilabel>: De tomma områdena fylls med svart färg."

#. from gnome:reviewed/gimp-help — GIMP User Manual/master
msgid "Reflective"
msgstr "Reflekterande"

#. from gnome:reviewed/gimp-help — GIMP User Manual/master
msgid ""
"<guilabel>Reflective</guilabel>: Waves bounce on sides and interfere with "
"the arriving ones."
msgstr ""
"<guilabel>Reflekterande</guilabel>: Vågor studsar mot sidorna och stör de "
"inkommande vågorna."

#. from gnome:reviewed/gimp-help — GIMP User Manual/master
msgid "<guilabel>Amplitude</guilabel>: Varies the height of waves."
msgstr "<guilabel>Amplitud</guilabel>: Varierar vågornas höjd."

#. from gnome:reviewed/gimp-help — GIMP User Manual/master
msgid "<guilabel>Phase</guilabel>: This command shifts the top of waves."
msgstr "<guilabel>Fas</guilabel>: Detta kommando förskjuter vågornas toppar."

#. from gnome:reviewed/gimp-help — GIMP User Manual/master
msgid "Wavelength"
msgstr "Våglängd"

#. from gnome:reviewed/gimp-help — GIMP User Manual/master
msgid ""
"<guilabel>Wavelength</guilabel>: Varies the distance between the top of "
"waves."
msgstr ""
"<guilabel>Våglängd</guilabel>: Varierar avståndet mellan vågornas toppar."

#. from gnome:reviewed/gimp-help — GIMP User Manual/master
msgid ""
