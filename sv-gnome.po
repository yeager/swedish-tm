msgstr "Dessa alternativ är självförklarande"

#. from gnome:reviewed/gimp-help — GIMP User Manual/master
msgid ""
"The <guilabel>Period</guilabel> is related to wavelength (0-200 pixels)"
msgstr ""
"<guilabel>Period</guilabel> är relaterad till våglängden (0–200 bildpunkter)"

#. from gnome:reviewed/gimp-help — GIMP User Manual/master
msgid ""
"The <guilabel>Amplitude</guilabel> is related to wave height (0-200 pixels)."
msgstr ""
"<guilabel>Amplitud</guilabel> är relaterad till våghöjden (0–200 "
"bildpunkter)."

