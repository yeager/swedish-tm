#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:189
msgid ""
"To select an entire row of cells, press the combination of "
"<keycombo><keycap>Shift</keycap><keycap>space</keycap></keycombo> keys. This"
" is equivalent to pressing the row label button on the left side of the "
"sheet."
msgstr ""
"Om du vill markera en hel rad trycker du på "
"<keycombo><keycap>Shift</keycap><keycap>blanksteg</keycap></keycombo>. Det "
"motsvarar att klicka på radrubriken till vänster i kalkylbladet."

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:199
msgid ""
"<imageobject> <imagedata fileref=\"figures/selection-8.png\" "
"format=\"PNG\"/> </imageobject> <textobject> <phrase>An image of a selected "
"row.</phrase> </textobject>"
msgstr ""
"<imageobject> <imagedata fileref=\"figures/selection-8.png\" "
"format=\"PNG\"/> </imageobject> <textobject> <phrase>En bild av en markerad "
"rad.</phrase> </textobject>"

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:211
msgid ""
"To select an entire column of cells, press the combination of "
"<keycombo><keycap>Ctrl</keycap><keycap>Space</keycap></keycombo> keys. This "
"is equivalent to pressing the column label button on the top of the sheet."
msgstr ""
"Om du vill markera en hel kolumn trycker du på "
"<keycombo><keycap>Ctrl</keycap><keycap>Blanksteg</keycap></keycombo>. Det "
"motsvarar att klicka på kolumnrubriken längst upp i kalkylbladet."

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:219
msgid "An entire column being selected."
msgstr "En hel kolumn markeras."

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:221
msgid ""
"<imageobject> <imagedata fileref=\"figures/selection-9.png\" "
"format=\"PNG\"/> </imageobject> <textobject> <phrase>An image of a selected "
"column.</phrase> </textobject>"
msgstr ""
"<imageobject> <imagedata fileref=\"figures/selection-9.png\" "
"format=\"PNG\"/> </imageobject> <textobject> <phrase>En bild av en markerad "
"kolumn.</phrase> </textobject>"

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:232
msgid ""
"To select the entire sheet, press the combination of "
"<keycombo><keycap>Ctrl</keycap><keycap>A</keycap></keycombo> keys. This is "
"equivalent to pressing the button in the top left corner of the sheet."
msgstr ""
"Om du vill markera hela kalkylbladet trycker du på "
"<keycombo><keycap>Ctrl</keycap><keycap>A</keycap></keycombo>. Det motsvarar "
"att klicka på knappen längst upp till vänster i kalkylbladet."

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:240
msgid "The entire worksheet being selected."
msgstr "Hela kalkylbladet markeras."

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:242
msgid ""
"<imageobject> <imagedata fileref=\"figures/selection-10.png\" "
"format=\"PNG\"/> </imageobject> <textobject> <phrase>An image of an entire "
"worksheet selected.</phrase> </textobject>"
msgstr ""
"<imageobject> <imagedata fileref=\"figures/selection-10.png\" "
"format=\"PNG\"/> </imageobject> <textobject> <phrase>En bild av ett helt "
"markerat kalkylblad.</phrase> </textobject>"

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:253
msgid ""
"The following list summaries keyboard shortcuts which can be used to select "
"large cell blocks."
msgstr ""
"Följande lista sammanfattar kortkommandon som du kan använda för att markera"
" större cellområden."

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:260
msgid ""
"<keycombo><keycap>Shift</keycap><keycap>Arrow</keycap></keycombo> : Define "
"selection with cursor keys."
msgstr ""
"<keycombo><keycap>Shift</keycap><keycap>piltangent</keycap></keycombo> : "
"Skapa en markering med piltangenterna."

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:267
msgid ""
"<keycombo><keycap>Ctrl</keycap><keycap>Arrow</keycap></keycombo> : Jump to "
"the end of the current region."
msgstr ""
"<keycombo><keycap>Ctrl</keycap><keycap>piltangent</keycap></keycombo> : "
"Hoppa till slutet av det aktuella området."

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:274
msgid ""
"<keycombo><keycap>Alt</keycap><keycap>Space</keycap></keycombo> : Select "
"current row."
msgstr ""
"<keycombo><keycap>Alt</keycap><keycap>Blanksteg</keycap></keycombo> : "
"Markera den aktuella raden."

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:281
msgid ""
"<keycombo><keycap>Ctrl</keycap><keycap>Space</keycap></keycombo> : Select "
"current column."
msgstr ""
"<keycombo><keycap>Ctrl</keycap><keycap>Blanksteg</keycap></keycombo> : "
"Markera den aktuella kolumnen."

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:288
msgid ""
"<keycombo><keycap>Ctrl</keycap><keycap>A</keycap></keycombo> : Select the "
"entire sheet."
msgstr ""
"<keycombo><keycap>Ctrl</keycap><keycap>A</keycap></keycombo> : Markera hela "
"kalkylbladet."

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:295
msgid ""
"<keycombo><keycap>Ctrl</keycap><keycap>/</keycap></keycombo> : Select the "
"array formula around the current edit position."
msgstr ""
"<keycombo><keycap>Ctrl</keycap><keycap>/</keycap></keycombo> : Markera "
"matrisformeln runt den aktuella redigeringspositionen."
