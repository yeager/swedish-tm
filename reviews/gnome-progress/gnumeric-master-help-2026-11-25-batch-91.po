#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:3055
msgid ""
"<imageobject> <imagedata fileref=\"figures/analysistools-ttest-equal-"
"ex2.png\" format=\"PNG\"/> </imageobject> <textobject> <phrase>An image of "
"the output from a t-test with unknown but equal variances.</phrase> "
"</textobject>"
msgstr ""
"<imageobject> <imagedata fileref=\"figures/analysistools-ttest-equal-"
"ex2.png\" format=\"PNG\"/> </imageobject> <textobject> <phrase>En bild av "
"resultatet från ett t-test med okända men antagna lika varianser.</phrase> "
"</textobject>"

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:3070
msgid ""
"<parameter>t</parameter>-Test: Two-Sample Assuming Unequal Variances Tool"
msgstr ""
"<parameter>t</parameter>-test: verktyg för två urval med olika varianser"

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:3072
msgid ""
"<parameter>t</parameter>-Test (Unknown and Unequal Variances) Tool Dialog "
"Options"
msgstr ""
"<parameter>t</parameter>-test: dialogrutealternativ för okända och olika "
"varianser"

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:3075
msgid ""
"<imageobject> <imagedata fileref=\"figures/analysistools-ttest-unequal.png\""
" format=\"PNG\"/> </imageobject> <textobject> <phrase>An image of the "
"options in a t-test of two samples with unknown and possibly unequal "
"variances.</phrase> </textobject>"
msgstr ""
"<imageobject> <imagedata fileref=\"figures/analysistools-ttest-unequal.png\""
" format=\"PNG\"/> </imageobject> <textobject> <phrase>En bild av "
"alternativen för ett t-test av två urval med okända och eventuellt olika "
"varianser.</phrase> </textobject>"

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:3088
msgid ""
"For unpaired variables with unknown and assumed unequal population "
"variances, when you click on <quote><guibutton>OK</guibutton></quote>, "
"<application>Gnumeric</application> will test whether the mean of the "
"difference between the paired variables is equal to the given hypothesized "
"mean difference."
msgstr ""
"När du klickar på <quote><guibutton>OK</guibutton></quote> testar "
"<application>Gnumeric</application> om skillnaden mellan de oparade "
"variablernas medelvärden är lika med den angivna hypotetiska "
"medelvärdesskillnaden. Testet utgår från att populationsvarianserna är "
"okända och olika."

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:3094
msgid ""
"Using the <parameter>t</parameter>-Test (Unknown and Unequal Variances) Tool"
msgstr ""
"Använda verktyget för <parameter>t</parameter>-test med okända och olika "
"varianser"

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:3095
msgid ""
"See <xref linkend=\"ttest-unequal-tool-ex1\"/> for an example of a completed"
" dialog and <xref linkend=\"ttest-unequal-tool-ex2\"/> for the corresponding"
" output."
msgstr ""
"Se <xref linkend=\"ttest-unequal-tool-ex1\"/> för ett exempel på en ifylld "
"dialogruta och <xref linkend=\"ttest-unequal-tool-ex2\"/> för motsvarande "
"resultat."

