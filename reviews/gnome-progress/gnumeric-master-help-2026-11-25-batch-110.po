"<imageobject> <imagedata fileref=\"figures/widget-spinbutton.png\" "
"format=\"PNG\"/> </imageobject> <textobject> <phrase> An image of a "
"spinbutton widget. </phrase> </textobject>"
msgstr ""
"<imageobject> <imagedata fileref=\"figures/widget-spinbutton.png\" "
