#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:413
msgid ""
"<guiicon><inlinemediaobject> <imageobject> <imagedata "
"fileref=\"figures/button-sort-za.png\"/> </imageobject> <textobject> "
"<phrase>An image of the standard toolbar's \"Sort Z to A\" button.</phrase> "
"</textobject> </inlinemediaobject> Sort Descending </guiicon>"
msgstr ""
"<guiicon><inlinemediaobject> <imageobject> <imagedata "
"fileref=\"figures/button-sort-za.png\"/> </imageobject> <textobject> "
"<phrase>En bild av knappen ”Sortera Z till A” i "
"standardverktygsfältet.</phrase> </textobject> </inlinemediaobject> Sortera "
"fallande </guiicon>"

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:427
msgid ""
"Sorts the selected region in descending order based on the first column "
"selected."
msgstr ""
"Sorterar det markerade området i fallande ordning utifrån den första "
"markerade kolumnen."

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:434
msgid ""
"<guiicon><inlinemediaobject> <imageobject> <imagedata "
"fileref=\"figures/button-graph.png\"/> </imageobject> <textobject> "
"<phrase>An image of the standard toolbar's \"Graph\" button.</phrase> "
"</textobject> </inlinemediaobject> Graph </guiicon>"
msgstr ""
"<guiicon><inlinemediaobject> <imageobject> <imagedata "
"fileref=\"figures/button-graph.png\"/> </imageobject> <textobject> "
"<phrase>En bild av knappen ”Graf” i standardverktygsfältet.</phrase> "
"</textobject> </inlinemediaobject> Graf </guiicon>"

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:506
msgid ""
"<guiicon><inlinemediaobject> <imageobject> <imagedata "
"fileref=\"figures/button-zoom.png\"/> </imageobject> <textobject> <phrase>An"
" image of the standard toolbar's \"Zoom\" box.</phrase> </textobject> "
"</inlinemediaobject> Zoom </guiicon>"
msgstr ""
"<guiicon><inlinemediaobject> <imageobject> <imagedata "
"fileref=\"figures/button-zoom.png\"/> </imageobject> <textobject> <phrase>En"
" bild av zoomrutan i standardverktygsfältet.</phrase> </textobject> "
"</inlinemediaobject> Zooma </guiicon>"

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:520
msgid ""
"The zoom button allows the users to trade-off the extent of the worksheet "
"which is visible against the size of the visible text and cells."
msgstr ""
"Med zoomknappen kan du väga hur stor del av kalkylbladet som visas mot "
"storleken på text och celler."

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:554
msgid ""
"<guiicon><inlinemediaobject> <imageobject> <imagedata "
"fileref=\"figures/button-font-type.png\"/> </imageobject> <textobject> "
"<phrase>An image of the format toolbar's \"Font\" selection box.</phrase> "
"</textobject> </inlinemediaobject> Font Chooser. </guiicon>"
msgstr ""
"<guiicon><inlinemediaobject> <imageobject> <imagedata "
"fileref=\"figures/button-font-type.png\"/> </imageobject> <textobject> "
"<phrase>En bild av teckensnittsvalet i formatverktygsfältet.</phrase> "
"</textobject> </inlinemediaobject> Välj teckensnitt. </guiicon>"

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:568
msgid ""
"The user can change the font of a selection either by typing the name of a "
"new font in the text area of this box or by clicking on the little arrow to "
"the right of the text area. This will cause a menu to appear from which a "
"font can be chosen."
msgstr ""
"Du kan byta teckensnitt för markeringen genom att skriva namnet på ett nytt "
"teckensnitt i rutan eller klicka på den lilla pilen till höger om rutan och "
"välja ett teckensnitt i menyn."

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:578
msgid ""
"<guiicon><inlinemediaobject> <imageobject> <imagedata "
"fileref=\"figures/button-font-size.png\"/> </imageobject> <textobject> "
"<phrase>An image of the format toolbar's \"Font Size\" selection "
"box.</phrase> </textobject> </inlinemediaobject> Font size </guiicon>"
msgstr ""
"<guiicon><inlinemediaobject> <imageobject> <imagedata "
"fileref=\"figures/button-font-size.png\"/> </imageobject> <textobject> "
"<phrase>En bild av teckenstorleksrutan i formatverktygsfältet.</phrase> "
"</textobject> </inlinemediaobject> Teckenstorlek </guiicon>"

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:592
msgid ""
"The user can change the font size of a selection by typing the number of a "
"different font size or by clicking on the little arrow to the right of the "
"entry box and selecting the preferred size."
msgstr ""
"Du kan ändra teckenstorleken för markeringen genom att skriva in en annan "
"storlek eller klicka på den lilla pilen till höger om rutan och välja önskad"
" storlek."

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:600
msgid ""
"<guiicon><inlinemediaobject> <imageobject> <imagedata "
"fileref=\"figures/button-bold.png\"/> </imageobject> <textobject> <phrase>An"
" image of the format toolbar's \"Bold\" button.</phrase> </textobject> "
"</inlinemediaobject> Bold </guiicon>"
msgstr ""
"<guiicon><inlinemediaobject> <imageobject> <imagedata "
"fileref=\"figures/button-bold.png\"/> </imageobject> <textobject> <phrase>En"
" bild av knappen ”Fetstil” i formatverktygsfältet.</phrase> </textobject> "
"</inlinemediaobject> Fetstil </guiicon>"

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:614
msgid ""
"Change the style of the current cell or the currently selected text to be "
"bold, or unbold it if it is already bold."
msgstr ""
"Gör texten i den aktuella cellen eller den markerade texten fet, eller ta "
"bort fetstilen om den redan är fet."

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:620
msgid ""
"<guiicon><inlinemediaobject> <imageobject> <imagedata "
"fileref=\"figures/button-italic.png\"/> </imageobject> <textobject> "
"<phrase>An image of the format toolbar's \"Italic\" button.</phrase> "
"</textobject> </inlinemediaobject> Italic </guiicon>"
msgstr ""
"<guiicon><inlinemediaobject> <imageobject> <imagedata "
"fileref=\"figures/button-italic.png\"/> </imageobject> <textobject> "
"<phrase>En bild av knappen ”Kursiv” i formatverktygsfältet.</phrase> "
"</textobject> </inlinemediaobject> Kursiv </guiicon>"

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:634
msgid ""
"Change the style of the current cell or the currently selected text to be "
"italicized."
msgstr ""
"Ändra texten i den aktuella cellen eller den markerade texten till kursiv "
"stil."

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:639
msgid ""
"<guiicon><inlinemediaobject> <imageobject> <imagedata "
"fileref=\"figures/button-underline.png\"/> </imageobject> <textobject> "
"<phrase>An image of the format toolbar's \"Underline\" button.</phrase> "
"</textobject> </inlinemediaobject> Underline </guiicon>"
msgstr ""
"<guiicon><inlinemediaobject> <imageobject> <imagedata "
"fileref=\"figures/button-underline.png\"/> </imageobject> <textobject> "
"<phrase>En bild av knappen ”Understrykning” i formatverktygsfältet.</phrase>"
" </textobject> </inlinemediaobject> Understrykning </guiicon>"

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:653
msgid ""
"Change the style of the current cell or the currently selected text to be "
"underlined."
msgstr "Stryk under texten i den aktuella cellen eller den markerade texten."
