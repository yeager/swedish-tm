"format=\"PNG\"/> </imageobject> <textobject> <phrase> An image of a list "
"widget. </phrase> </textobject>"
msgstr ""
"<imageobject> <imagedata fileref=\"figures/widget-list.png\" "
"format=\"PNG\"/> </imageobject> <textobject> <phrase>En bild av en "
"listkomponent.</phrase> </textobject>"

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:743
msgid "Combination Boxes."
msgstr "Kombinationsrutor."

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:745
msgid ""
"Combination box widgets are currently unusable because they cannot be "
"configured."
