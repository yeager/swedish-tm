#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:708
msgid "Lists."
msgstr "Listor."

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:710
msgid ""
"List widget elements are currently unusable because they cannot be "
"configured."
msgstr ""
"Listkomponenterna kan för närvarande inte användas eftersom de inte går att "
"konfigurera."

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:716
msgid "A list widget."
msgstr "En listkomponent."

