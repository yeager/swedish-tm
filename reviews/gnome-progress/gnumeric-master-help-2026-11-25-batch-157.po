"</inlinemediaobject>"

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:1644
msgid "The icon for a bubble plot."
msgstr "Ikonen för ett bubbeldiagram."

#. from gnome:reviewed/gnumeric/master/help
