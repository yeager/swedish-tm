#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:1108
msgid ""
"Insert a rectangular box containing optionally some text into the worksheet."
msgstr ""
"Infogar en rektangulär ruta, som valfritt kan innehålla text, i "
"kalkylbladet."

