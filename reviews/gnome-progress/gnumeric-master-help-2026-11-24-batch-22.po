#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:952
msgid ""
"<guiicon><inlinemediaobject> <imageobject> <imagedata "
"fileref=\"figures/button-fill.png\"/> </imageobject> <textobject> <phrase>An"
" image of the format toolbar's \"Set background colour\" button and drop "
"down palette.</phrase> </textobject> </inlinemediaobject> Set the Background"
" Colour. </guiicon>"
msgstr ""
"<guiicon><inlinemediaobject> <imageobject> <imagedata "
"fileref=\"figures/button-fill.png\"/> </imageobject> <textobject> <phrase>En"
" bild av knappen ”Ange bakgrundsfärg” och dess rullgardinspalett i "
"formatverktygsfältet.</phrase> </textobject> </inlinemediaobject> Ange "
"bakgrundsfärg. </guiicon>"

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:966
msgid ""
"This button and drop down menu can be used to set the back ground colour."
msgstr "Med knappen och rullgardinsmenyn kan du ange bakgrundsfärg."

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:974
msgid ""
"<guiicon><inlinemediaobject> <imageobject> <imagedata "
"fileref=\"figures/button-text-colour.png\"/> </imageobject> <textobject> "
"<phrase>An image of the format toolbar's \"Set text colour\" button and drop"
" down palette.</phrase> </textobject> </inlinemediaobject> Set the Text "
"Colour </guiicon>"
msgstr ""
"<guiicon><inlinemediaobject> <imageobject> <imagedata "
"fileref=\"figures/button-text-colour.png\"/> </imageobject> <textobject> "
"<phrase>En bild av knappen ”Ange textfärg” och dess rullgardinspalett i "
"formatverktygsfältet.</phrase> </textobject> </inlinemediaobject> Ange "
"textfärg </guiicon>"

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:1013
msgid ""
"The <interface>Long Format Toolbar</interface> contains all buttons that the"
" <interface>Format Toolbar</interface> (described in <xref linkend=\"fmt-"
"toolbar\"/>) contains, except in a different order."
msgstr ""
"<interface>Det långa formatverktygsfältet</interface> innehåller samma "
"knappar som <interface>formatverktygsfältet</interface> (som beskrivs i "
"<xref linkend=\"fmt-toolbar\"/>), men i en annan ordning."

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:1018
msgid ""
"In addition, the <interface>Long Format Toolbar</interface> also contains "
"the following buttons:"
msgstr ""
"Dessutom innehåller <interface>det långa formatverktygsfältet</interface> "
"följande knappar:"

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:1025
msgid ""
"<guiicon><inlinemediaobject> <imageobject> <imagedata "
"fileref=\"figures/button-subscript.png\"/> </imageobject> <textobject> "
"<phrase>An image of the long format toolbar's \"Subscript\" button.</phrase>"
" </textobject> </inlinemediaobject> Subscript </guiicon>"
msgstr ""
"<guiicon><inlinemediaobject> <imageobject> <imagedata "
"fileref=\"figures/button-subscript.png\"/> </imageobject> <textobject> "
"<phrase>En bild av knappen ”Nedsänkt text” i det långa "
"formatverktygsfältet.</phrase> </textobject> </inlinemediaobject> Nedsänkt "
"text </guiicon>"

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:1039
msgid ""
"Change the style of the current cell or the currently selected text to be "
"subscripted."
msgstr ""
"Formatera texten i den aktuella cellen eller den markerade texten som "
"nedsänkt."

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:1047
msgid ""
"<guiicon><inlinemediaobject> <imageobject> <imagedata "
"fileref=\"figures/button-superscript.png\"/> </imageobject> <textobject> "
"<phrase>An image of the long format toolbar's \"Superscript\" "
"button.</phrase> </textobject> </inlinemediaobject> Superscript </guiicon>"
msgstr ""
"<guiicon><inlinemediaobject> <imageobject> <imagedata "
"fileref=\"figures/button-superscript.png\"/> </imageobject> <textobject> "
"<phrase>En bild av knappen ”Upphöjd text” i det långa "
"formatverktygsfältet.</phrase> </textobject> </inlinemediaobject> Upphöjd "
"text </guiicon>"

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:1061
msgid ""
"Change the style of the current cell or the currently selected text to be "
"superscripted."
msgstr ""
"Formatera texten i den aktuella cellen eller den markerade texten som "
"upphöjd."

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:1094
msgid ""
"<guiicon><inlinemediaobject> <imageobject> <imagedata "
"fileref=\"figures/button-rectangle.png\"/> </imageobject> <textobject> "
"<phrase>An image of the object toolbar's \"Create a rectangle object\" "
