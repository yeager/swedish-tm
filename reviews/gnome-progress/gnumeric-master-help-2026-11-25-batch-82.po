#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:2365
msgid "The icon for a pie plot of the style with joint slices."
msgstr "Ikon för cirkeldiagram med sammanhängande sektorer."

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:2371
msgid ""
"<inlinemediaobject> <imageobject> <imagedata "
"fileref=\"figures/chart_pie_2_1.png\"/> </imageobject> <textobject> <phrase>"
" The icon for a pie plot of the style with separated slices. </phrase> "
"</textobject> </inlinemediaobject>"
msgstr ""
"<inlinemediaobject> <imageobject> <imagedata "
"fileref=\"figures/chart_pie_2_1.png\"/> </imageobject> <textobject> <phrase>"
