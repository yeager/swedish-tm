#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:351
msgid "This screenshot depicts the two panels of the graph guru."
msgstr "Den här skärmbilden visar diagramguidens två paneler."

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:368
msgid "The components of the two panels"
msgstr "Delarna i de två panelerna"

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:371
msgid "<guimenu>A</guimenu> - The Plot Type Selection Area"
msgstr "<guimenu>A</guimenu> – området för val av rittyp"

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:376
msgid ""
"This area lists the different types of plots which can be contained within "
"the graph. The desired plot type can be selected simply by placing the mouse"
" cursor over the desired type and clicking with the primary mouse button. "
"The blue highlight indicates the currently selected type."
msgstr ""
"Här visas de olika rittyper som kan ingå i grafen. Välj en rittyp genom att "
"föra muspekaren till den och klicka med den primära musknappen. Blå "
"markering visar vilken typ som är vald."

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:388
msgid "<guimenu>B</guimenu> - The Preview Area."
msgstr "<guimenu>B</guimenu> – förhandsvisningsområdet."

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:392
msgid ""
"This area shows a preview of the currently selected plot type/sub type "
"combination using the default settings for this type of plot."
msgstr ""
"Här visas en förhandsgranskning av den valda kombinationen av rittyp och "
"undertyp med standardinställningarna för rittypen."

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:401
msgid "<guimenu>C</guimenu> - The Plot Subtype Area."
msgstr "<guimenu>C</guimenu> – området för rittypens undertyper."

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:419
msgid ""
"Hovering the mouse pointer over one of these icons causes a description of "
"the plot type to be shown next to the icon."
msgstr ""
"Om du håller muspekaren över någon av ikonerna visas en beskrivning av "
"rittypen bredvid ikonen."

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:427
msgid "<guimenu>D</guimenu> - The First Panel Navigation Buttons"
msgstr "<guimenu>D</guimenu> – navigeringsknapparna i den första panelen"

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:431
msgid ""
"These buttons enable the user to navigate through the <interface>Graph "
"Guru</interface>."
msgstr "Med knapparna kan du navigera i <interface>Diagramguiden</interface>."

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:439 C/gnumeric.xml:589
msgid "The <guibutton>Help</guibutton> Button"
msgstr "Knappen <guibutton>Hjälp</guibutton>"

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:443 C/gnumeric.xml:593
msgid ""
"The <guibutton>Help</guibutton> button should cause this section of the "
"manual to open."
msgstr ""
"Knappen <guibutton>Hjälp</guibutton> öppnar det här avsnittet i handboken."

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:455
msgid ""
"The <guibutton>Cancel</guibutton> button will dismiss the <interface>Graph "
"Guru</interface> and return the user to the "
"<application>Gnumeric</application> worksheet."
msgstr ""
"Knappen <guibutton>Avbryt</guibutton> stänger "
"<interface>Diagramguiden</interface> och återgår till kalkylbladet i "
"<application>Gnumeric</application>."

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:465
msgid "The <guibutton>Forward</guibutton> Button"
msgstr "Knappen <guibutton>Framåt</guibutton>"

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:469
msgid ""
"The <guibutton>Forward</guibutton> button will dismiss the first panel of "
"the <interface>Graph Guru</interface> and open up the second panel."
msgstr ""
"Knappen <guibutton>Framåt</guibutton> stänger den första panelen i "
"<interface>Diagramguiden</interface> och öppnar den andra."

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:478
msgid "The <guibutton>Insert</guibutton> Button"
msgstr "Knappen <guibutton>Infoga</guibutton>"

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:482
msgid ""
"The <guibutton>Insert</guibutton> button will dismiss the <interface>Graph "
"Guru</interface> and allow users to insert the graph, as it is currently "
"defined, into the worksheet. The resulting graph may not include any plots "
"or data but it can be modified subsequently using the context menu's "
"<guimenuitem>Properties</guimenuitem> menu entry."
msgstr ""
"Knappen <guibutton>Infoga</guibutton> stänger "
"<interface>Diagramguiden</interface> och infogar den aktuella grafen i "
"kalkylbladet. Grafen kanske inte innehåller några rittyper eller data, men "
"du kan ändra den senare via snabbmenyns alternativ "
"<guimenuitem>Egenskaper</guimenuitem>."
