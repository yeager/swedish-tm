#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:563
msgid "In the following cells, enter the equations below in the 'Profit' tab:"
msgstr "Ange följande formler i cellerna på fliken ”Profit”:"

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:595
msgid "Running the simulation"
msgstr "Köra simuleringen"

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:600
msgid "Variables tab in simulation dialog box"
msgstr "Fliken Variabler i simuleringsdialogrutan"

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:607
msgid ""
"Screenshot of the simulation dialog with input and output variables filled "
"in for the newsvendor example."
msgstr ""
"Skärmbild av simuleringsdialogrutan med variabler för in- och utdata ifyllda"
" för exemplet med tidningsförsäljning."

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:622
msgid "Options tab in Simulation dialog box for newsvendor simulation example"
msgstr ""
"Fliken Alternativ i simuleringsdialogrutan för exemplet med "
"tidningsförsäljning"

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:629
msgid ""
"Options tab in simulations dialog showing Rounds and number of iterations."
msgstr ""
"Fliken Alternativ i simuleringsdialogrutan med antal omgångar och "
"iterationer."

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:640
msgid "Maximum time for simulation exceeded message box"
msgstr "Meddelanderuta om att simuleringens maximala körtid har överskridits"

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:647
msgid "Dialog to warn that the maximum time for the simulation was exceeded."
msgstr ""
"Dialogruta som varnar om att simuleringens maximala körtid har överskridits."

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:658
msgid ""
"Due to the random nature of the simulation, the output may vary between "
"simulation runs)."
msgstr ""
"Eftersom simuleringen bygger på slumpvärden kan resultatet variera mellan "
"körningarna."

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:662
msgid "Summary tab for simulation tool"
msgstr "Fliken Sammanfattning i simuleringsverktyget"

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:669
msgid ""
"Simulation summary tab inside of simulation dialog box including summary of "
"simulation options and summary of results."
msgstr ""
"Fliken Sammanfattning i simuleringsdialogrutan, med en sammanfattning av "
"simuleringsalternativen och resultaten."

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:678
msgid ""
"Simulations: Number of rounds as determined in the Simulation Options box."
msgstr ""
"Simuleringar: antal omgångar enligt dialogrutan Simuleringsalternativ."

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:680
msgid "Iterations: Number of iterations in a single simulation round."
msgstr "Iterationer: antal iterationer i en simuleringsomgång."

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:683
msgid ""
"# input variables: Number of random numbers sampled for each iteration."
msgstr ""
"# variabler för indata: antal slumptal som tas fram för varje iteration."

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:686
msgid "# output variables: Number of outputs recorded for simulation"
msgstr ""
"# variabler för utdata: antal resultat som registreras för simuleringen"

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:687
msgid "Runtime: Runtime of simulations in seconds."
msgstr "Körtid: simuleringarnas körtid i sekunder."

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:688
msgid "Run on: Date and time simulation was run."
msgstr "Kördes: datum och tid då simuleringen kördes."

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:696
msgid "Output options tab for simulation"
msgstr "Fliken Utdataalternativ för simuleringen"

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:703
msgid ""
"Output tab inside of simulation dialog box showing options for output "
"placement and output formatting."
msgstr ""
"Fliken Utdata i simuleringsdialogrutan, med alternativ för placering och "
"formatering av utdata."

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:715
msgid "For output formatting, their are four options."
msgstr "Det finns fyra alternativ för formatering av utdata."
