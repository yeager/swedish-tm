"other explanations."
msgstr ""
"Problem med handboken, funktionsbeskrivningarna eller annan dokumentation."

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:350
msgid ""
"<emphasis>The Default.</emphasis> Use this when none of the other categories"
" apply."
msgstr ""
"<emphasis>Standardvalet.</emphasis> Använd detta om inget annat alternativ "
"passar."

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:354
msgid "GUI"
msgstr "Grafiskt gränssnitt"

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:355
