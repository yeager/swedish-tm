"<imageobject> <imagedata fileref=\"figures/dialog-properties-arrow.png\" "
"format=\"PNG\"/> </imageobject> <textobject> <phrase> An image of the dialog"
" used to configure arrow drawing elements. </phrase> </textobject>"
msgstr ""
