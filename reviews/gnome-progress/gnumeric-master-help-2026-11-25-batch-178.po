#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:2
msgid "File Formats"
msgstr "Filformat"

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:4
msgid ""
"<application>Gnumeric</application> supports numerous file formats in "
"addition to its own XML based format. The table below lists the formats "
"currently supported. In the table below, the name of the format is a link "
"which can be used to jump to the section which discusses the format."
msgstr ""
"Utöver det egna XML-baserade formatet stöder "
"<application>Gnumeric</application> många filformat. Tabellen nedan visar de"
" format som stöds för närvarande. Klicka på ett formatnamn för att gå till "
"avsnittet där formatet beskrivs."

