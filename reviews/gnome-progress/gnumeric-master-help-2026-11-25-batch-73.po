#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:1966
msgid "Spencer's 15 Point Moving Average"
msgstr "Spencers 15-punkts glidande medelvärde"

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:1967
msgid ""
"Spencer's 15 point moving average is a central moving average calculated "
"according to formula <xref linkend=\"moving-formula-spencer\"/>. "
"<parameter>a<subscript>t</subscript></parameter> is the moving average at "
"time <parameter>t</parameter> and "
"<parameter>y<subscript>t</subscript></parameter> is the observation at time "
"<parameter>t</parameter>."
msgstr ""
"Spencers 15-punkters glidande medelvärde är ett centralt glidande medelvärde"
" som beräknas enligt formeln <xref linkend=\"moving-formula-spencer\"/>. "
"<parameter>a<subscript>t</subscript></parameter> är det glidande medelvärdet"
" vid tidpunkt <parameter>t</parameter> och "
"<parameter>y<subscript>t</subscript></parameter> är observationen vid "
"tidpunkt <parameter>t</parameter>."

