#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:571 C/gnumeric.xml:573
msgid "Frequency Tool Results"
msgstr "Resultat från frekvensverktyget"

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:575
