#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:2
msgid "Keybinding Reference"
msgstr "Referens för kortkommandon"

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:9
msgid ""
"Keybindings are combinations of keystrokes which tell an application to run "
"a task. These can greatly speed-up the user's interactions with an "
"application. Some of the most common ones are <keycombo> "
"<keycap>Ctrl</keycap> <keycap>s</keycap> </keycombo> to save a file or "
"<keycombo> <keycap>Ctrl</keycap> <keycap>q</keycap> </keycombo> to quit the "
"application. <application>Gnumeric</application> also comes with keybindings"
" to make your spreadsheet experience faster."
msgstr ""
"Kortkommandon är tangentkombinationer som får ett program att utföra en "
"åtgärd. De kan göra det mycket snabbare att arbeta i programmet. Några "
"vanliga kortkommandon är <keycombo> <keycap>Ctrl</keycap> <keycap>s</keycap>"
" </keycombo> för att spara en fil och <keycombo> <keycap>Ctrl</keycap> "
"<keycap>q</keycap> </keycombo> för att avsluta programmet. "
"<application>Gnumeric</application> har också kortkommandon som gör det "
"snabbare att arbeta med kalkylblad."

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:26
msgid ""
"Normally, keybindings are next to a command in a menu. For example, if "
"<menuchoice> <guimenuitem>Save</guimenuitem> </menuchoice> has <keycombo> "
"<keycap>Ctrl</keycap> <keycap>s</keycap> </keycombo> next to it, that means "
"that <keycombo> <keycap>Ctrl</keycap> <keycap>s</keycap> </keycombo> can be "
"typed at the same time to save your file. However, some keystrokes aren't "
"listed in the menus. They are as follows:"
msgstr ""
"Vanligtvis visas kortkommandon bredvid ett menykommando. Om <menuchoice> "
"<guimenuitem>Spara</guimenuitem> </menuchoice> till exempel har <keycombo> "
"<keycap>Ctrl</keycap> <keycap>s</keycap> </keycombo> bredvid sig betyder det"
" att du kan trycka ned <keycombo> <keycap>Ctrl</keycap> <keycap>s</keycap> "
"</keycombo> samtidigt för att spara filen. Vissa kortkommandon visas dock "
"inte i menyerna. De är följande:"

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:48
msgid ""
"<keycap>F2</keycap> sets the current cell for editing. The cursor is "
"inserted at the end of the current text."
msgstr ""
"<keycap>F2</keycap> aktiverar redigering av den aktuella cellen och placerar"
" markören sist i cellens text."

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:54
msgid ""
"<keycap>Ctrl-O</keycap> opens the <interface>Load file</interface> dialog "
"window."
msgstr ""
"<keycap>Ctrl-O</keycap> öppnar dialogrutan <interface>Läs in "
"fil</interface>."

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:60
msgid ""
"<keycap>Ctrl-F3</keycap> opens the <interface>Define Name</interface> dialog"
" window."
msgstr ""
"<keycap>Ctrl-F3</keycap> öppnar dialogrutan <interface>Definiera "
"namn</interface>."

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:66
msgid "<keycap>F4</keycap> repeat the last action."
msgstr "<keycap>F4</keycap> upprepar den senaste åtgärden."

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:71
msgid ""
"<keycap>Ctrl-G</keycap> opens the <interface>Go to</interface> dialog window"
" which allows you to jump to a specified cell."
msgstr ""
"<keycap>Ctrl-G</keycap> öppnar dialogrutan <interface>Gå till</interface>, "
"där du kan hoppa till en viss cell."

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:77
msgid ""
"<keycap>Ctrl-H</keycap> opens the <interface>Search and Replace</interface> "
"dialog where you can search through your spreadsheets for text strings and "
"replace them with something else."
msgstr ""
"<keycap>Ctrl-H</keycap> öppnar dialogrutan <interface>Sök och "
"ersätt</interface>. Där kan du söka efter text i kalkylbladen och ersätta "
"den."

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:85
msgid ""
"<keycap>Ctrl-F</keycap> opens the <interface>Search Center</interface>. The "
"<interface>Search Center</interface> allows you to search through your "
"spreadsheets for text strings."
msgstr ""
"<keycap>Ctrl-F</keycap> öppnar <interface>Sökcentralen</interface>. Med "
"<interface>Sökcentralen</interface> kan du söka efter text i kalkylbladen."

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:94
msgid "<keycap>Ctrl-~</keycap> Formats the current selection as a 'General'."
msgstr ""
"<keycap>Ctrl-~</keycap> formaterar markeringen med formatet ”Allmänt”."

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:99
msgid ""
"<keycap>Ctrl-$</keycap> Formats the current selection as the default "
"currency"
msgstr ""
"<keycap>Ctrl-$</keycap> formaterar markeringen med standardformatet för "
"valuta"

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:104
msgid ""
"<keycap>Ctrl-#</keycap> Formats the current selection with default date "
"style"
msgstr ""
"<keycap>Ctrl-#</keycap> formaterar markeringen med standardformatet för "
"datum"

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:109
msgid "<keycap>Ctrl-^</keycap> Formats the current selection as superscript"
msgstr "<keycap>Ctrl-^</keycap> formaterar markeringen som upphöjd text"

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:114
msgid ""
"<keycap>Ctrl-@</keycap> Formats the current selection with the default time "
"format"
msgstr ""
"<keycap>Ctrl-@</keycap> formaterar markeringen med standardformatet för tid"

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:119
msgid ""
"<keycap>Ctrl-!</keycap> Formats the current selection as an integer (a "
"number with no decimal places)."
msgstr ""
"<keycap>Ctrl-!</keycap> formaterar markeringen som ett heltal, alltså ett "
"tal utan decimaler."

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:124
msgid ""
"<keycap>Ctrl-&amp;</keycap> Adds a thin border around the current selection"
msgstr ""
"<keycap>Ctrl-&amp;</keycap> lägger till en tunn kantlinje runt markeringen"

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:129
msgid "<keycap>Ctrl-_</keycap> Formats the current selection as subscript"
msgstr "<keycap>Ctrl-_</keycap> formaterar markeringen som nedsänkt text"

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:135
msgid ""
"<keycap>Ctrl-B</keycap> or <keycap>Ctrl-2</keycap> Toggles the boldness of "
"the font in the current selection."
msgstr ""
"<keycap>Ctrl-B</keycap> eller <keycap>Ctrl-2</keycap> växlar mellan fet och "
"normal stil för den markerade texten."

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:141
msgid ""
"<keycap>Ctrl-I</keycap> or <keycap>Ctrl-3</keycap> Toggles the italics of "
"the font in the current selection."
msgstr ""
"<keycap>Ctrl-I</keycap> eller <keycap>Ctrl-3</keycap> växlar mellan kursiv "
"och normal stil för den markerade texten."

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:147
msgid ""
"<keycap>Ctrl-U</keycap> or <keycap>Ctrl-4</keycap> Toggles single "
"underlining of the current selection."
msgstr ""
"<keycap>Ctrl-U</keycap> eller <keycap>Ctrl-4</keycap> växlar mellan enkel "
"understrykning och ingen understrykning för den markerade texten."

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:153
msgid ""
"<keycap>Ctrl-5</keycap> Toggles strikethrough of the current selection."
msgstr ""
"<keycap>Ctrl-5</keycap> växlar genomstrykning för den markerade texten."

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:159
msgid ""
"<keycap>Shift-Ctrl-G</keycap> Changes the keyboard focus to the current cell"
" indicator described in <xref linkend=\"data-entry-currentcell\"/>."
msgstr ""
"<keycap>Shift-Ctrl-G</keycap> flyttar tangentbordsfokus till indikatorn för "
"den aktuella cellen som beskrivs i <xref linkend=\"data-entry-"
"currentcell\"/>."

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:165
msgid ""
"<keycap>Ctrl-a</keycap> Select all cells on the currently focused sheet."
msgstr ""
"<keycap>Ctrl-a</keycap> markerar alla celler i det kalkylblad som har fokus."
