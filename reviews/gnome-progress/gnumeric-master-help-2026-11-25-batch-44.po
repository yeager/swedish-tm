#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:93
msgid "Cutting a Selection to the Clipboard"
msgstr "Klippa ut en markering till urklippet"

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:102
msgid ""
"Use keyboard shortcut "
"<keycombo><keycap>Ctrl</keycap><keycap>X</keycap></keycombo>."
msgstr ""
"Använd kortkommandot "
"<keycombo><keycap>Ctrl</keycap><keycap>X</keycap></keycombo>."

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:108
msgid ""
"Choose <guimenuitem>Cut</guimenuitem> from the <guimenu>Edit</guimenu> menu."
msgstr ""
"Välj <guimenuitem>Klipp ut</guimenuitem> i menyn "
"<guimenu>Redigera</guimenu>."

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:114
msgid ""
"Click on <guiicon><inlinemediaobject> <imageobject> <imagedata "
"fileref=\"figures/button-cut.png\"/> </imageobject> <textobject> <phrase>An "
"image of the cut toolbar button.</phrase> </textobject> </inlinemediaobject>"
" Cut </guiicon> button in the toolbar."
msgstr ""
"Klicka på knappen <guiicon><inlinemediaobject> <imageobject> <imagedata "
"fileref=\"figures/button-cut.png\"/> </imageobject> <textobject> <phrase>En "
"bild av knappen Klipp ut i verktygsraden.</phrase> </textobject> "
"</inlinemediaobject> Klipp ut </guiicon> i verktygsraden."

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:128
msgid ""
"Right-click on the selection and choose <guimenuitem>Cut</guimenuitem> from "
"the context menu."
msgstr ""
"Högerklicka på markeringen och välj <guimenuitem>Klipp ut</guimenuitem> i "
"snabbmenyn."

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:95
msgid ""
"To cut a cell or a selection to the clipboard, you should select a cell or "
"range of cells as described in <xref linkend=\"sect-data-selections\"/> and "
"then use one of the following methods: <_:itemizedlist-1/> The selection "
"will be copied to the clipboard buffer. To remind you of this, the border of"
" the selection will be shown as \"marching ants\". The selection will be "
"moved to a new location as soon as you choose "
"<guimenuitem>Paste</guimenuitem> command as described below."
msgstr ""
"Om du vill klippa ut en cell eller en markering till urklippet markerar du "
"först en cell eller ett cellområde enligt <xref linkend=\"sect-data-"
"selections\"/> och använder sedan någon av metoderna: <_:itemizedlist-1/> "
"Markeringen kopieras till urklippet. Den rörliga streckade kanten, de så "
"kallade ”vandrande myrorna”, visar att den ligger kvar. Så snart du väljer "
"<guimenuitem>Klistra in</guimenuitem> flyttas markeringen till den nya "
"platsen."

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:142
msgid ""
"Please note that the selection will remain in its current location until you"
" paste it. If you want to delete a selection without pasting it to a new "
"location, use <guimenuitem>Delete</guimenuitem> command instead."
msgstr ""
"Markeringen ligger kvar på sin plats tills du klistrar in den. Om du vill ta"
" bort den utan att klistra in den någon annanstans väljer du i stället "
"<guimenuitem>Ta bort</guimenuitem>."

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:153
msgid "Copying a Selection to the Clipboard"
msgstr "Kopiera en markering till urklippet"

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:162
msgid ""
"Use keyboard shortcut "
"<keycombo><keycap>Ctrl</keycap><keycap>C</keycap></keycombo>."
msgstr ""
"Använd kortkommandot "
"<keycombo><keycap>Ctrl</keycap><keycap>C</keycap></keycombo>."

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:168
msgid ""
"Choose <guimenuitem>Copy</guimenuitem> from the <guimenu>Edit</guimenu> "
"menu."
msgstr ""
"Välj <guimenuitem>Kopiera</guimenuitem> i menyn <guimenu>Redigera</guimenu>."

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:174
msgid ""
"Click on <guiicon><inlinemediaobject> <imageobject> <imagedata "
"fileref=\"figures/button-copy.png\"/> </imageobject> <textobject> <phrase>An"
" image of the copy toolbar button.</phrase> </textobject> "
"</inlinemediaobject> Copy </guiicon> button in the toolbar."
msgstr ""
"Klicka på knappen <guiicon><inlinemediaobject> <imageobject> <imagedata "
"fileref=\"figures/button-copy.png\"/> </imageobject> <textobject> <phrase>En"
" bild av knappen Kopiera i verktygsraden.</phrase> </textobject> "
"</inlinemediaobject> Kopiera </guiicon> i verktygsraden."

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:189
msgid ""
"Right-click on the selection and choose <guimenuitem>Copy</guimenuitem> from"
" the context menu."
msgstr ""
"Högerklicka på markeringen och välj <guimenuitem>Kopiera</guimenuitem> i "
"snabbmenyn."

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:155
msgid ""
"To copy a cell or a selection to the clipboard, you should select a cell or "
"range of cells as described in <xref linkend=\"sect-data-selections\"/> and "
"then use one of the following methods: <_:itemizedlist-1/> The selection "
"will be copied to the clipboard buffer. To remind you of this, the selection"
" will outlined by \"marching ants\" border. The selection will be copied to "
"a new location as soon as you choose <guimenuitem>Paste</guimenuitem> "
"command as described below."
msgstr ""
"Om du vill kopiera en cell eller en markering till urklippet markerar du "
"först en cell eller ett cellområde enligt <xref linkend=\"sect-data-"
"selections\"/> och använder sedan någon av metoderna: <_:itemizedlist-1/> "
"Markeringen kopieras till urklippet och omges av den rörliga streckade "
"kanten, de så kallade ”vandrande myrorna”. Därefter kan du klistra in en "
"kopia på en ny plats genom att välja <guimenuitem>Klistra in</guimenuitem>, "
"enligt beskrivningen nedan."

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:204
msgid "Pasting the Clipboard"
msgstr "Klistra in från urklippet"

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:211
msgid ""
"Use keyboard shortcut "
"<keycombo><keycap>Ctrl</keycap><keycap>V</keycap></keycombo>."
msgstr ""
"Använd kortkommandot "
"<keycombo><keycap>Ctrl</keycap><keycap>V</keycap></keycombo>."
