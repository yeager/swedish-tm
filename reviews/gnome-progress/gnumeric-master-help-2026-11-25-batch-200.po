"<function>CEILING</function>(<parameter>x</parameter>,<parameter>significance</parameter>,1)."
msgstr ""
"<function>CEILING</function>(<parameter>x</parameter>) exporteras till ODF "
"som "
"<function>CEILING</function>(<parameter>x</parameter>,SIGN(<parameter>x</parameter>),1)."
" "
"<function>CEILING</function>(<parameter>x</parameter>,<parameter>significance</parameter>)"
" är OpenFormula-funktionen "
"<function>CEILING</function>(<parameter>x</parameter>,<parameter>significance</parameter>,1)."

