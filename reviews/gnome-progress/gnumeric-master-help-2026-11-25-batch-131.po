#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:2
msgid "Opening Files"
msgstr "Öppna filer"

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:4
msgid ""
"Opening an existing file into a <application>Gnumeric</application> workbook"
" requires working through the <interface>File Open</interface> dialog. The "
"user must select the file that they wish <application>Gnumeric</application>"
" to open, possibly specifying a file format and character encoding."
msgstr ""
"Om du vill öppna en befintlig fil i <application>Gnumeric</application> "
"använder du dialogrutan <interface>Öppna fil</interface>. Välj filen som "
"<application>Gnumeric</application> ska öppna och ange vid behov filformat "
"och teckenkodning."

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:12
msgid "The steps required to open a file."
msgstr "Stegen för att öppna en fil."

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:19 C/gnumeric.xml:601
msgid "Launch the <interface>File Open</interface> dialog."
msgstr "Öppna dialogrutan <interface>Öppna fil</interface>."

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:22
msgid ""
"In the <guimenu>File</guimenu> menu, select the "
"<guimenuitem>Open</guimenuitem> menu item."
msgstr ""
"I menyn <guimenu>Arkiv</guimenu> väljer du menyalternativet "
"<guimenuitem>Öppna</guimenuitem>."

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:28
msgid "Open the folder containing the desired file."
msgstr "Öppna mappen som innehåller filen."

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:31
msgid "Navigate the folder hierarchy by double-clicking on the folders."
msgstr "Navigera i mappstrukturen genom att dubbelklicka på mapparna."

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:36
msgid "Select the desired file within the folder."
msgstr "Markera filen i mappen."

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:39
msgid "Click on the file name in the folder content area."
msgstr "Klicka på filnamnet i mappens innehållsområde."

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:44
msgid "(Optional) Specify a file format type."
msgstr "(Valfritt) Ange filformat."

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:49
msgid "(Optional) Specify the character encoding."
msgstr "(Valfritt) Ange teckenkodningen."

#. from gnome:reviewed/gnumeric/master/help
#: C/gnumeric.xml:54
msgid "Click on the <guibutton>Open</guibutton> button."
msgstr "Klicka på knappen <guibutton>Öppna</guibutton>."
