msgstr "Maximalt X-index för klippningsramen"

#. from yeager:blender-review
msgid "Maximum Y index of the clipping bounding box"
msgstr "Maximal Y-index för klippningens begränsningsram"

#. from yeager:blender-review
msgid "Maximum Z index of the clipping bounding box"
msgstr "Maximal Z-index för beskärningsramen"

#. from yeager:blender-review
msgid "Connectivity"
msgstr "Anslutningsmöjligheter"

#. from yeager:blender-review
msgid "Number of times to dilate or erode the active voxels"
msgstr "Antal gånger att expandera eller erodera de aktiva voxlarna"

#. from yeager:blender-review
msgid "Divergence"
msgstr "Divergens"

#. from yeager:blender-review
msgid "Background Value"
msgstr "Bakgrundsvärde"

#. from yeager:blender-review
msgid "Transform from grid index space to object space"
msgstr "Omvandla från rutnätsindexutrymme till objektutrymme"

#. from yeager:blender-review
msgid "Default value outside of grid voxels"
msgstr "Standardvärde utanför rutnätets voxlar"

