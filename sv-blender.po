msgid ""
"Time delay in 1/10 seconds before automatically opening sub level menus"
msgstr ""
"Tidsfördröjning på 1/10 sekunder innan undermenyerna öppnas automatiskt"

#. from yeager:blender
msgid "Top Level Menu Open Delay"
msgstr "Öppningsfördröjning för toppmenyn"

