#. from yeager:blender
msgid "General Conventions"
msgstr "Allmänna konventioner"

#. from yeager:blender
msgid "Use a three-space indentation."
msgstr "Använd ett indrag med tre mellanrum."

#. from yeager:blender
msgid "Limit line length to 120 characters."
msgstr "Begränsa radlängden till 120 tecken."

