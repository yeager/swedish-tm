msgid "Add a constraint to make the planes track the camera"
msgstr "Lägg till en begränsning så att planen följer kameran"

#. from yeager:blender
msgid "Number of pixels per inch or Blender Unit"
msgstr "Antal pixlar per tum eller Blender-enhet"

#. from yeager:blender
msgid "Filepath used for importing the file"
msgstr "Filväg som används för att importera filen"

#. from yeager:blender
msgid "Method to scale the plane with the camera frame"
msgstr "Metod för att skala planet med kameraramen"

#. from yeager:blender
msgid "Fill camera frame, spilling outside the frame"
msgstr "Fyll kameraramen, sprid dig utanför bildrutan"

#. from yeager:blender
msgid "Fit entire image within the camera frame"
msgstr "Anpassa hela bilden till kamerans bildruta"

#. from yeager:blender
