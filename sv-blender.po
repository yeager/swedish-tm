msgstr "Hela dess kedja markerad med Linked."

#. from yeager:blender
msgid "Select Similar"
msgstr "Välj liknande"

#. from yeager:blender
msgid ":menuselection:`Select --> Select Similar`"
msgstr ":menuselection:`Välj --> Välj liknande`"

#. from yeager:blender
msgid ":kbd:`Shift-G`"
msgstr ":kbd:`Shift-G`"

#. from yeager:blender
msgid "Children"
msgstr "Barn"

#. from yeager:blender
msgid "Extends the selection to all hierarchical descendant bones."
msgstr "Utökar urvalet till alla hierarkiskt nedåtgående ben."

#. from yeager:blender
msgid "Immediate Children"
msgstr "Direkta barn"

#. from yeager:blender
msgid "Extends the selection to all direct child bones."
msgstr "Utökar urvalet till alla direkta barnben."

#. from yeager:blender
msgid "Siblings"
msgstr "Syskon"

#. from yeager:blender
msgid "Selects bones that have the same parent as the active bone."
msgstr "Väljer ben som har samma förälder som det aktiva benet."

#. from yeager:blender
msgid ""
"Selects bones with a similar :ref:`bone length <bpy.types.EditBone.length>` "
