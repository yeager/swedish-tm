msgstr ""
"Tvinga omladdning av bilden om den redan är öppen någon annanstans i Blender"

#. from yeager:blender
msgid "Height of the created plane"
msgstr "Höjd på det skapade planet"

#. from yeager:blender
msgid ""
"Import sequentially numbered images as an animated image sequence instead of"
" separate planes"
msgstr ""
"Importera sekventiellt numrerade bilder som en animerad bildsekvens istället"
" för separata plan."

#. from yeager:blender
msgid ""
"Offset planes from each other. If disabled, multiple planes will be created "
"at the same location"
msgstr ""
"Förskjut plan från varandra. Om denna funktion är inaktiverad skapas flera "
"plan på samma plats."

#. from yeager:blender
msgid "Set distance between each plane"
msgstr "Ställ in avståndet mellan varje plan"

#. from yeager:blender
msgid "How planes are oriented relative to each others' local axis"
msgstr "Hur flygplan är orienterade i förhållande till varandras lokala axlar"

#. from yeager:blender
msgid "Side by Side to the Left"
msgstr "Sida vid sida till vänster"

#. from yeager:blender
msgid "Side by Side, Downward"
msgstr "Sida vid sida, nedåt"

#. from yeager:blender
msgid "Stacked Above"
msgstr "Staplade ovanpå varandra"

#. from yeager:blender
msgid "Side by Side to the Right"
msgstr "Sida vid sida till höger"

#. from yeager:blender
msgid "Side by Side, Upward"
msgstr "Sida vid sida, uppåt"

#. from yeager:blender
msgid "Stacked Below"
msgstr "Staplade nedanför"

#. from yeager:blender
msgid "Method for computing the plane size"
msgstr "Metod för beräkning av planets storlek"

#. from yeager:blender
msgid "Scale to fit or fill the camera frame"
msgstr "Skala för att passa eller fylla kameraramen"

#. from yeager:blender
msgid "Scale based on pixels per inch"
msgstr "Skala baserad på pixlar per tum"

#. from yeager:blender
msgid "Scale based on pixels per Blender Unit"
msgstr "Skala baserad på pixlar per Blender-enhet"

#. from yeager:blender
msgid "Set image's user's length to the one of this video"
msgstr "Ställ in bildens användarlängd till den i den här videon"

#. from yeager:blender
msgid "Create a tiled image"
msgstr "Skapa en kaklad bild"

#. from yeager:blender
msgid "Create an image with left and right views"
msgstr "Skapa en bild med vänster- och högervy"

#. from yeager:blender
msgid "Allow the path to contain substitution tokens"
msgstr "Tillåt att sökvägen innehåller substitutionsmarkörer"

#. from yeager:blender
msgid ""
"Automatically detect animated sequences in selected images (based on file "
"names)"
msgstr ""
"Automatiskt upptäcka animerade sekvenser i valda bilder (baserat på filnamn)"

#. from yeager:blender
msgid "Detect selected UDIM files and load all matching tiles"
msgstr "Detektera valda UDIM-filer och ladda alla matchande rutor"

#. from yeager:blender
msgid "Use sequence detection"
msgstr "Använd sekvensdetektering"

#. from yeager:blender
msgid "Use UDIM detection"
msgstr "Använd UDIM-detektering"

#. from yeager:blender
msgid "Read all the current scene's view layers from cache, as needed"
msgstr "Läs alla aktuella scenens visningslager från cacheminnet, efter behov"

#. from yeager:blender
msgid "Remove Render Slot"
msgstr "Ta bort Render Slot"

#. from yeager:blender
msgid "Remove the current render slot"
msgstr "Ta bort den aktuella renderingsplatsen"

#. from yeager:blender
msgid "Set the boundaries of the render region and enable render region"
msgstr ""
"Ställ in gränserna för renderingsområdet och aktivera renderingsområdet"

#. from yeager:blender
msgid "Scale all the image's UDIM tiles"
msgstr "Skala alla bildens UDIM-rutor"

#. from yeager:blender
msgid "Rotate Image Orthogonal"
msgstr "Rotera bilden ortogonalt"

#. from yeager:blender
msgid "Amount of rotation in degrees (90, 180, 270)"
msgstr "Rotationsvinkel i grader (90, 180, 270)"

#. from yeager:blender
msgid "Rotate 90 degrees clockwise"
msgstr "Vrid 90 grader medurs"

#. from yeager:blender
msgid "Rotate 180 degrees clockwise"
msgstr "Vrid 180 grader medurs"

#. from yeager:blender
msgid "Rotate 270 degrees clockwise"
msgstr "Rotera 270 grader medurs"

#. from yeager:blender
msgid "Use mouse to sample a color in current image"
msgstr "Använd musen för att välja en färg i den aktuella bilden."

#. from yeager:blender
msgid "Sample a line and show it in Scope panels"
msgstr "Prova en linje och visa den i Scope-panelerna"

#. from yeager:blender
msgid "Create a new image file without modifying the current image in Blender"
msgstr "Skapa en ny bildfil utan att ändra den aktuella bilden i Blender"

#. from yeager:blender
msgid "Add Tile"
msgstr "Lägg till kakel"

#. from yeager:blender
msgid "Adds a tile to the image"
msgstr "Lägger till en ruta till bilden"

#. from yeager:blender
msgid "How many tiles to add"
msgstr "Hur många plattor som ska läggas till"

