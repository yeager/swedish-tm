msgid "Brush data-block for storing brush settings for painting and sculpting"
msgstr ""
"Penseldatablock för lagring av penselinställningar för målning och "
"skulptering"

#. from yeager:blender
msgid ""
"Ratio between the brush radius and the radius that is going to be used to "
"sample the area center"
msgstr ""
"Förhållandet mellan borstradien och den radie som kommer att användas för "
"att ta prov från områdets centrum."

#. from yeager:blender
msgid "Amount of smoothing to automatically apply to each stroke"
msgstr "Mängd utjämning som automatiskt ska tillämpas på varje streck"

#. from yeager:blender
msgid ""
"Distance where boundary edge automasking is going to protect vertices from "
"the fully masked edge"
msgstr ""
"Avstånd där automatisk maskering av gränskanter skyddar hörnpunkter från "
"helt maskerade kanter."

#. from yeager:blender
msgid "Blur Steps"
msgstr "Sudda ut steg"

#. from yeager:blender
msgid "The number of times the cavity mask is blurred"
msgstr "Antalet gånger kavitetsmasken är suddig"

#. from yeager:blender
msgid "Cavity Curve"
msgstr "Hålrumskurva"

#. from yeager:blender
msgid "Cavity Factor"
msgstr "Kavitetskoefficient"

#. from yeager:blender
msgid "The contrast of the cavity mask"
msgstr "Kontrasten hos kavitetsmasken"

#. from yeager:blender
msgid "Area Normal Falloff"
msgstr "Område Normal avtagning"

