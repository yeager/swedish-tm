#. from yeager:blender
msgid "Gridlines"
msgstr "Rutnät"

#. from yeager:blender
msgid "Show gridlines"
msgstr "Visa rutnät"

#. from yeager:blender
msgid "Visualize vector fields"
msgstr "Visualisera vektorfält"

