msgid "The display and view transform supports high dynamic range colors"
msgstr ""
"Display- och visningstransformationen stöder färger med högt dynamiskt "
"omfång."

#. from yeager:blender-review
msgid "Support Emulation"
msgstr "Stöd för emulering"

#. from yeager:blender-review
msgid ""
"The display and view transform supports automatic emulation for another "
"display device, using the display color spaces mechanism in OpenColorIO v2 "
"configurations"
msgstr ""
"Display- och visningstransformationen stöder automatisk emulering för en "
"annan bildskärm, med hjälp av mekanismen för bildskärmens färgrymder i "
"OpenColorIO v2-konfigurationer."

#. from yeager:blender-review
