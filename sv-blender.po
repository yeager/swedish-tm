#. from yeager:blender
msgid "Filter COLLADA files"
msgstr "Filtrera COLLADA-filer"

#. from yeager:blender
msgid "Filter font files"
msgstr "Filtrera teckensnittsfiler"

#. from yeager:blender
msgid "Filter image files"
msgstr "Filtrera bildfiler"

#. from yeager:blender
msgid "Filter movie files"
msgstr "Filtrera filmfiler"

#. from yeager:blender
msgid "Filter OBJ files"
msgstr "Filtrera OBJ-filer"

#. from yeager:blender
msgid "Filter sound files"
msgstr "Filtrera ljudfiler"

#. from yeager:blender
msgid "Filter text files"
msgstr "Filtrera textfiler"

#. from yeager:blender
msgid "Filter USD files"
msgstr "Filtrera USD-filer"

#. from yeager:blender
msgid "Filter OpenVDB volume files"
msgstr "Filtrera OpenVDB-volymfiler"

#. from yeager:blender
msgid "Hide Operator Properties"
msgstr "Dölj operatörsegenskaper"

#. from yeager:blender
msgid "Collapse the region displaying the operator settings"
msgstr "Dölj regionen som visar operatörsinställningarna"

#. from yeager:blender
msgid "File sorting mode"
msgstr "Filsorteringsläge"

#. from yeager:blender
msgid "Delete Asset Catalog"
msgstr "Ta bort tillgångskatalog"

#. from yeager:blender
msgid ""
"Remove an asset catalog from the asset library (contained assets will not be"
" affected and show up as unassigned)"
msgstr ""
"Ta bort en tillgångskatalog från tillgångsbiblioteket (innehållna tillgångar"
" påverkas inte och visas som otilldelade)"

#. from yeager:blender
msgid "ID of the catalog to delete"
msgstr "ID för katalogen som ska raderas"

#. from yeager:blender
msgid "New Asset Catalog"
msgstr "Ny tillgångskatalog"

#. from yeager:blender
msgid "Create a new catalog to put assets in"
msgstr "Skapa en ny katalog för att lägga in tillgångar i"

#. from yeager:blender
msgid "Parent Path"
msgstr "Föräldrabana"

#. from yeager:blender
msgid "Optional path defining the location to put the new catalog under"
msgstr "Valfri sökväg som anger var den nya katalogen ska placeras"

#. from yeager:blender
msgid "Redo Catalog Edits"
msgstr "Gör om katalogredigeringar"

#. from yeager:blender
msgid "Redo the last undone edit to the asset catalogs"
msgstr "Gör om den senaste ångrade redigeringen av tillgångskatalogerna."

#. from yeager:blender
msgid "Undo Catalog Edits"
msgstr "Ångra katalogredigeringar"

#. from yeager:blender
msgid "Undo the last edit to the asset catalogs"
msgstr "Ångra den senaste ändringen i tillgångskatalogerna"

#. from yeager:blender
msgid "Store undo snapshot for asset catalog edits"
msgstr "Spara ångra snapshot för redigering av tillgångskatalog"

#. from yeager:blender
msgid "Store the current state of the asset catalogs in the undo buffer"
msgstr ""
"Lagra det aktuella tillståndet för tillgångskatalogerna i ångra-bufferten"

#. from yeager:blender
msgid ""
"Make any edits to any catalogs permanent by writing the current set up to "
"the asset library"
msgstr ""
"Gör alla ändringar i kataloger permanenta genom att skriva den aktuella "
"inställningen till tillgångsbiblioteket."

#. from yeager:blender
msgid ""
"Delete all asset metadata and turn the selected asset data-blocks back into "
"normal data-blocks"
msgstr ""
"Ta bort alla metadata för tillgångar och omvandla de valda "
"tillgångsdatablocken tillbaka till normala datablock."

#. from yeager:blender
msgid "Set Fake User"
msgstr "Ställ in falsk användare"

#. from yeager:blender
msgid ""
"Ensure the data-block is saved, even when it is no longer marked as asset"
msgstr ""
"Se till att datablocket sparas, även om det inte längre är markerat som "
"tillgång."

#. from yeager:blender
msgid "Clear Single Asset"
msgstr "Tydlig enskild tillgång"

#. from yeager:blender
msgid ""
"Delete all asset metadata and turn the asset data-block back into a normal "
"data-block"
msgstr ""
"Ta bort alla metadata för tillgången och återställ tillgångens datablock "
"till ett normalt datablock."

#. from yeager:blender
msgid "Reread assets and asset catalogs from the asset library on disk"
msgstr ""
"Läs om tillgångar och tillgångskataloger från tillgångsbiblioteket på disken"

#. from yeager:blender
msgid "Mark as Single Asset"
msgstr "Markera som enskild tillgång"

#. from yeager:blender
msgid ""
"Enable easier reuse of a data-block through the Asset Browser, with the help"
" of customizable metadata (like previews, descriptions and tags)"
msgstr ""
"Möjliggör enklare återanvändning av ett datablock genom Asset Browser, med "
