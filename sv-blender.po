#. from yeager:blender
msgid "Offset per Curve"
msgstr "Förskjutning per kurva"

#. from yeager:blender
msgid "Random offset of noise texture for each Curve."
msgstr "Slumpmässig förskjutning av brustexturen för varje kurva."

#. from yeager:blender
msgid "Seed value for randomization."
msgstr "Seed-värde för randomisering."

#. from yeager:blender
msgid "Preserve the length of the Curves on a segment basis."
msgstr "Bevara längden på kurvorna på en segmentbasis."

#. from yeager:blender
msgid "**Offset Vector**"
msgstr "**Offset vektor**"

#. from yeager:blender
msgid "Hair Deformation Nodes"
msgstr "Hårets deformationsnoder"

