msgstr ""
"Begränsa pixelintensiteten för att minska bruset i glansiga reflektioner "
"från reflektionskubkartor (0 för att inaktivera)"

#. from yeager:blender
msgid "Irradiance Pool Size"
msgstr "Irradians Poolstorlek"

#. from yeager:blender
msgid ""
"Size of the irradiance pool, a bigger pool size allows for more irradiance "
"grid in the scene but might not fit into GPU memory and decrease performance"
msgstr ""
"Storleken på irradianspoolen. En större pool möjliggör fler irradiansrutnät "
"i scenen, men kanske inte får plats i GPU-minnet och minskar prestandan."

#. from yeager:blender
msgid "Irradiance Visibility Size"
msgstr "Irradians Synlighet Storlek"

#. from yeager:blender
msgid "Size of the shadow map applied to each irradiance sample"
msgstr "Storleken på skuggkartan som tillämpas på varje irradiansprov"

#. from yeager:blender
msgid "8 px"
msgstr "8 px"

#. from yeager:blender
msgid "16 px"
msgstr "16 px"

#. from yeager:blender
msgid "32 px"
msgstr "32 px"

#. from yeager:blender
msgid "64 px"
msgstr "64 px"

#. from yeager:blender
msgid "Distance of object that contribute to the ambient occlusion effect"
msgstr "Avstånd till objekt som bidrar till omgivande ocklusionsverkan"

#. from yeager:blender
msgid "Precision of the horizon search"
msgstr "Precision i horisontsökningen"

#. from yeager:blender
msgid "Minimum light intensity for a light to contribute to the lighting"
msgstr "Minsta ljusintensitet för att en lampa ska bidra till belysningen"

#. from yeager:blender
msgid "Lower values will reduce background bleeding onto foreground elements"
msgstr "Lägre värden minskar bakgrundsblödningen på förgrundselementen."

#. from yeager:blender
msgid "Maximum blur distance a pixel can spread over"
msgstr "Maximal oskärpaavstånd som en pixel kan sprida sig över"

#. from yeager:blender
msgid "Motion steps"
msgstr "Rörelsesteg"

#. from yeager:blender
msgid "Overscan Size"
msgstr "Överskanningsstorlek"

#. from yeager:blender
msgid ""
"Percentage of render size to add as overscan to the internal render buffers"
msgstr ""
"Procentandel av renderingsstorlek som ska läggas till som överskanning till "
"de interna renderingsbuffertarna"

#. from yeager:blender
msgid "Select the tracing method used to find scene-ray intersections"
msgstr ""
"Välj den spårningsmetod som används för att hitta skärningspunkter mellan "
"scenstrålar."

#. from yeager:blender
msgid "Use light probes to find scene intersection"
msgstr "Använd ljussonder för att hitta skärningspunkten mellan scener"

#. from yeager:blender
msgid ""
"Raytrace against the depth buffer. Fallback to light probes for invalid "
"rays."
msgstr ""
"Raytrace mot djupbuffert. Fallback till ljusprober för ogiltiga strålar."

#. from yeager:blender
msgid "Reflection Trace Options"
msgstr "Alternativ för reflektionsspårning"

#. from yeager:blender
msgid "EEVEE settings for tracing reflections"
msgstr "EEVEE-inställningar för spårning av reflektioner"

#. from yeager:blender
msgid "Shadow Pool Size"
msgstr "Skuggpoolens storlek"

#. from yeager:blender
msgid ""
"Size of the shadow pool, a bigger pool size allows for more shadows in the "
"scene but might not fit into GPU memory"
msgstr ""
"Storleken på skuggpoolen. En större pool gör det möjligt att ha fler skuggor"
" i scenen, men kanske inte får plats i GPU-minnet."

#. from yeager:blender
msgid "Shadow Ray Count"
msgstr "Skuggråstråleantal"

#. from yeager:blender
msgid "Amount of shadow ray to trace for each light"
msgstr "Mängd skuggråder som ska spåras för varje ljus"

#. from yeager:blender
msgid "Resolution percentage of shadow maps"
msgstr "Upplösningsprocent för skuggkartor"

#. from yeager:blender
msgid "Shadow Step Count"
msgstr "Skuggstegräkning"

#. from yeager:blender
msgid "Amount of shadow map sample per shadow ray"
msgstr "Mängd skuggkarta-prov per skuggestråle"

#. from yeager:blender
msgid "Render Samples"
msgstr "Rendera exempel"

#. from yeager:blender
msgid "Number of samples per pixel for rendering"
msgstr "Antal sampel per pixel för rendering"

#. from yeager:blender
msgid "Number of samples, unlimited if 0"
msgstr "Antal sampel, obegränsat om 0"

#. from yeager:blender
msgid ""
"Jitter camera position to create accurate blurring using render samples "
"(only for final render)"
msgstr ""
"Skaka kamerapositionen för att skapa exakt oskärpa med hjälp av "
"renderingsprover (endast för slutlig rendering)"

#. from yeager:blender
msgid "Use faster global illumination technique for high roughness surfaces"
msgstr "Använd snabbare global belysningsteknik för ytor med hög grovhet"

#. from yeager:blender
msgid "Enable ambient occlusion to simulate medium scale indirect shadowing"
msgstr ""
"Aktivera ambient occlusion för att simulera indirekt skuggning i medelstor "
"skala"

#. from yeager:blender
msgid ""
"Internally render past the image border to avoid screen-space effects "
