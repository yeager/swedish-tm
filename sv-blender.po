msgid "Selects the layers to convert."
msgstr "Väljer de lager som ska konverteras."

#. from yeager:blender
msgid "Create a separate curve instance for every layer."
msgstr "Skapa en separat kurvinstans för varje lager."

#. from yeager:blender
msgid ""
"This is equivalent to a :doc:`Realize Instances "
"</modeling/geometry_nodes/instances/realize_instances>` operation after "
"creating the curve geometry instances. This can simplify some logic later "
"on, but typically keeping this operation off will be much better for "
"performance."
msgstr ""
"Detta motsvarar en :doc:`Realize Instances "
"</modeling/geometry_nodes/instances/realize_instances>`-operation efter att "
"kurvgeometriinstanserna har skapats. Detta kan förenkla viss logik senare, "
"men vanligtvis är det mycket bättre för prestandan att inte använda denna "
"operation."

#. from yeager:blender
msgid "Standard curves geometry."
msgstr "Geometri för standardkurvor."

#. from yeager:blender
msgid "Grease Pencil Operation Nodes"
msgstr "Grease Pencil Operation Noder"

#. from yeager:blender
