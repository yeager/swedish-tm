msgid "``.bmp``"
msgstr "``.bmp``"

#. from yeager:blender
msgid "Iris"
msgstr "Iris"

#. from yeager:blender
msgid "8, 16bit"
msgstr "8, 16 bitar"

#. from yeager:blender
msgid "``.sgi`` ``.rgb`` ``.bw``"
msgstr "``.sgi`` ``.rgb`` ``.bw``"

