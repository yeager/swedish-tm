msgid "JPEG 2000"
msgstr "JPEG 2000"

#. from yeager:blender
msgid "8, 12, 16bit"
msgstr "8, 12, 16bit"

#. from yeager:blender
msgid "``.jp2`` ``.jp2`` ``.j2c``"
msgstr "``.jp2`` ``.jp2`` ``.j2c``"

