msgid "Propagate every info, error, and warning message upstream"
msgstr ""
"Sprid all information, alla felmeddelanden och varningsmeddelanden uppströms"

#. from yeager:blender-review
msgid "Propagate only error and warning messages upstream"
msgstr "Sprid endast fel- och varningsmeddelanden uppströms"

#. from yeager:blender-review
msgid "Propagate only error messages upstream"
msgstr "Sprid endast felmeddelanden uppströms"

#. from yeager:blender-review
msgid "Do not propagate any messages upstream"
msgstr "Sprid inte några meddelanden uppströms."

#. from yeager:blender-review
msgid "Returns an image with the given size and constant color"
msgstr "Returnerar en bild med given storlek och konstant färg"

#. from yeager:blender-review
msgid "Convert to Display"
msgstr "Konvertera till visning"

#. from yeager:blender-review
msgid ""
"Convert from scene linear to display color space, with a view transform and "
"look for tone mapping"
msgstr ""
"Konvertera från scenlinjärt till visningsfärgrymd, med en vyomvandling och "
"sök efter tonmappning."

#. from yeager:blender-review
msgid "Color management display device settings"
msgstr "Inställningar för färghanteringsdisplay"

#. from yeager:blender-review
msgid "Color management view transform settings"
msgstr "Inställningar för färghanteringsvy"

#. from yeager:blender-review
msgid "Convolve"
msgstr "Konvolvera"

#. from yeager:blender-review
msgid "Convolves an image with a kernel"
msgstr "Konvolverar en bild med en kärna"

#. from yeager:blender-review
msgid "Returns the coordinates of the pixels of an image"
msgstr "Returnerar koordinaterna för bildens pixlar"

#. from yeager:blender-review
msgid "Input mask from a mask data-block, created in the image editor"
msgstr "Inmatningsmask från ett maskdatablock, skapat i bildredigeraren"

#. from yeager:blender-review
msgid "Mask To SDF"
msgstr "Mask till SDF"

#. from yeager:blender-review
msgid "Computes a signed distance field from the given mask"
msgstr "Beräknar ett signerat avståndsfält från den angivna masken"

#. from yeager:blender-review
msgid ""
"Input image or movie from a movie clip data-block, typically used for motion"
" tracking"
msgstr ""
"Inmatning av bild eller film från ett filmklippsdatablock, som vanligtvis "
"används för rörelsespårning."

#. from yeager:blender-review
msgid "Input normalized normal values to other nodes in the tree"
msgstr "Ange normaliserade normalvärden till andra noder i trädet"

#. from yeager:blender-review
msgid "The directory where the image will be written"
msgstr "Katalogen där bilden kommer att skrivas"

#. from yeager:blender-review
msgid ""
"The base name of the file. Other information might be included in the final "
"file name depending on the node options"
msgstr ""
"Filens basnamn. Annan information kan inkluderas i det slutliga filnamnet "
"beroende på nodalternativen."

#. from yeager:blender-review
msgid "Relative To Pixel"
msgstr "Relativt till pixel"

#. from yeager:blender-review
msgid ""
"Converts values that are relative to the image size to be in terms of pixels"
msgstr "Konverterar värden som är relativa till bildstorleken till pixlar."

#. from yeager:blender-review
msgid "The type of data"
msgstr "Typ av data"

#. from yeager:blender-review
msgid "Float value"
msgstr "Flytande värde"

#. from yeager:blender-review
msgid "Reference Dimension"
msgstr "Referensdimension"

#. from yeager:blender-review
msgid ""
"Defines the dimension of the image that the relative value is in reference "
"to"
msgstr "Definierar dimensionen på bilden som det relativa värdet avser."

#. from yeager:blender-review
msgid "Per Dimension"
msgstr "Per dimension"

#. from yeager:blender-review
msgid ""
"The value is relative to each of the dimensions of the image independently"
msgstr "Värdet är relativt för var och en av bildens dimensioner separat."

#. from yeager:blender-review
msgid "The value is relative to the X dimension of the image"
msgstr "Värdet är relativt till bildens X-dimension."

#. from yeager:blender-review
msgid "The value is relative to the Y dimension of the image"
msgstr "Värdet är relativt till bildens Y-dimension."

#. from yeager:blender-review
msgid "The value is relative to the greater dimension of the image"
msgstr "Värdet är relativt till bildens större dimension."

#. from yeager:blender-review
msgid "Smaller"
msgstr "Mindre"

#. from yeager:blender-review
msgid "The value is relative to the smaller dimension of the image"
msgstr "Värdet är relativt till bildens minsta dimension."

#. from yeager:blender-review
msgid "The value is relative to the diagonal of the image"
msgstr "Värdet är relativt till bildens diagonal."

#. from yeager:blender-review
msgid "Sequencer Strip Info"
msgstr "Sekvenserare Strip Info"

#. from yeager:blender-review
msgid "Returns information about the active strip of the modifier"
msgstr "Returnerar information om modifierarens aktiva remsa."

#. from yeager:blender-review
msgid "String To Image"
msgstr "Sträng till bild"

#. from yeager:blender-review
msgid "Depth Combine"
msgstr "Djupkombination"

#. from yeager:blender-review
msgid "Orient an Euler rotation along the given direction"
msgstr "Orienter en Euler-rotation längs den angivna riktningen"

#. from yeager:blender-review
msgid "Orient a rotation along the given direction"
msgstr "Orienter en rotation längs den angivna riktningen"

#. from yeager:blender-review
msgid "Build a rotation from an axis and a rotation around that axis"
msgstr "Bygg en rotation från en axel och en rotation runt den axeln"

#. from yeager:blender-review
msgid "Bit Math"
msgstr "Bitmatematik"

#. from yeager:blender-review
msgid "Perform bitwise operations on 32-bit integers"
msgstr "Utför bitvisa operationer på 32-bitars heltal"

#. from yeager:blender-review
msgid "Returns a value where the bits of A and B are both set"
msgstr "Returnerar ett värde där bitarna i A och B båda är inställda."

#. from yeager:blender-review
msgid "Returns a value where the bits of either A or B are set"
msgstr "Returnerar ett värde där bitarna i antingen A eller B är inställda."

#. from yeager:blender-review
msgid "Exclusive Or"
msgstr "Exklusiv eller"

#. from yeager:blender-review
msgid "Returns a value where only one bit from A and B is set"
msgstr "Returnerar ett värde där endast en bit från A och B är inställd."

#. from yeager:blender-review
msgid ""
"Returns the opposite bit value of A, in decimal it is equivalent of A = -A -"
" 1"
msgstr ""
"Returnerar motsatt bitvärde för A, i decimalform motsvarar det A = -A - 1."

#. from yeager:blender-review
msgid ""
"Shifts the bit values of A by the specified Shift amount. Positive values "
"shift left, negative values shift right."
msgstr ""
"Skiftar bitvärdena för A med det angivna skiftvärdet. Positiva värden "
"skiftas åt vänster, negativa värden skiftas åt höger."

#. from yeager:blender-review
msgid ""
"Rotates the bit values of A by the specified Shift amount. Positive values "
"rotate left, negative values rotate right."
msgstr ""
"Rotera bitvärdena för A med det angivna skiftvärdet. Positiva värden roterar"
" åt vänster, negativa värden roterar åt höger."

#. from yeager:blender-review
msgid "Perform a logical operation on the given boolean inputs"
msgstr "Utför en logisk operation på de givna booleska ingångarna"

#. from yeager:blender-review
msgid ""
"Combine four channels into a single color, based on a particular color model"
msgstr ""
"Kombinera fyra kanaler till en enda färg, baserat på en viss färgmodell."

#. from yeager:blender-review
msgid ""
"Combine a translation vector, a rotation, and a scale vector into a "
"transformation matrix"
msgstr ""
"Kombinera en translationsvektor, en rotation och en skalningsvektor till en "
"transformationsmatris."

#. from yeager:blender-review
msgid "Perform a comparison operation on the two given inputs"
msgstr "Utför en jämförelse mellan de två givna ingångarna."

#. from yeager:blender-review
msgid "Build a rotation from separate angles around each axis"
msgstr "Bygg en rotation från separata vinklar runt varje axel"

#. from yeager:blender-review
msgid ""
"Find the number of times a given string occurs in another string and the "
"position of the first match"
msgstr ""
"Hitta antalet gånger en given sträng förekommer i en annan sträng och "
"positionen för den första matchningen"

#. from yeager:blender-review
msgid ""
"Convert the given floating-point number to an integer, with a choice of "
"methods"
msgstr ""
"Konvertera det angivna flyttalstalet till ett heltal, med val av metoder"

#. from yeager:blender-review
msgid "Format String"
msgstr "Formatsträng"

#. from yeager:blender-review
msgid ""
"Insert values into a string using a Python and path template compatible "
"formatting syntax"
msgstr ""
"Infoga värden i en sträng med hjälp av Python och en formateringssyntax som "
"är kompatibel med sökvägsmallar."

#. from yeager:blender-review
msgid "Generate a randomized integer using the given input value as a seed"
msgstr ""
"Generera ett slumpmässigt heltal med det angivna ingångsvärdet som "
"utgångspunkt."

#. from yeager:blender-review
msgid ""
"Provide a True/False value that can be connected to other nodes in the tree"
msgstr "Ange ett sant/falskt värde som kan kopplas till andra noder i trädet."

#. from yeager:blender-review
msgid "Output a color value chosen with the color picker widget"
msgstr "Skriv ut ett färgvärde som valts med färgväljaren"

#. from yeager:blender-review
msgid ""
"Provide an integer value that can be connected to other nodes in the tree"
msgstr "Ange ett heltal som kan kopplas till andra noder i trädet."

#. from yeager:blender-review
msgid "Dimensions of the vector socket"
msgstr "Dimensioner på vektorsockeln"

#. from yeager:blender-review
msgid ""
"Provide a rotation value that can be connected to other nodes in the tree"
msgstr "Ange ett rotationsvärde som kan kopplas till andra noder i trädet."

#. from yeager:blender-review
msgid ""
"Output string characters that cannot be typed directly with the keyboard"
msgstr "Skriv ut tecken som inte kan skrivas direkt med tangentbordet"

#. from yeager:blender-review
msgid ""
"Provide a string value that can be connected to other nodes in the tree"
msgstr "Ange ett strängvärde som kan kopplas till andra noder i trädet."

#. from yeager:blender-review
msgid ""
"Provide a vector value that can be connected to other nodes in the tree"
msgstr "Ange ett vektorvärde som kan kopplas till andra noder i trädet."

#. from yeager:blender-review
msgid "Perform various math operations on the given integer inputs"
msgstr ""
"Utför olika matematiska operationer på de givna heltaliga ingångsvärdena."

#. from yeager:blender-review
msgid "Compute the inverse of the given matrix, if one exists"
msgstr "Beräkna inversen av den givna matrisen, om en sådan finns."

#. from yeager:blender-review
msgid "Compute the inverse of the given rotation"
msgstr "Beräkna inversen av den givna rotationen"

#. from yeager:blender-review
msgid "Check if a given string exists within another string"
msgstr "Kontrollera om en given sträng finns i en annan sträng"

#. from yeager:blender-review
msgid "Compute the determinant of the given matrix"
msgstr "Beräkna determinanten för den givna matrisen"

#. from yeager:blender-review
msgid "Perform a matrix multiplication on two input matrices"
msgstr "Utför en matrismultiplikation på två ingångsmatriser"

#. from yeager:blender-review
msgid "Matrix SVD"
msgstr "Matris SVD"

#. from yeager:blender-review
msgid "Compute the singular value decomposition of the 3x3 part of a matrix"
msgstr "Beräkna singulärvärdesdekompositionen för den 3x3-delen av en matris"

#. from yeager:blender-review
msgid "Build a rotation from quaternion components"
msgstr "Bygg en rotation från kvaternionkomponenter"

#. from yeager:blender-review
msgid "Output a randomized value"
msgstr "Skriv ut ett slumpmässigt värde"

#. from yeager:blender-review
msgid "Replace a given string segment with another"
msgstr "Ersätt ett visst strängsegment med ett annat"

#. from yeager:blender-review
msgid "Apply a secondary Euler rotation to a given Euler rotation"
msgstr "Tillämpa en sekundär Euler-rotation på en given Euler-rotation"

#. from yeager:blender-review
msgid "Apply a secondary rotation to a given rotation value"
msgstr "Tillämpa en sekundär rotation på ett givet rotationsvärde"

#. from yeager:blender-review
msgid "Apply a rotation to a given vector"
msgstr "Tillämpa en rotation på en given vektor"

#. from yeager:blender-review
msgid "Convert a rotation to axis angle components"
msgstr "Konvertera en rotation till axelvinkelkomponenter"

#. from yeager:blender-review
msgid "Convert a standard rotation value to an Euler rotation"
msgstr "Konvertera ett standardrotationsvärde till en Euler-rotation"

#. from yeager:blender-review
msgid "Retrieve the quaternion components representing a rotation"
msgstr "Hämta kvaternionkomponenterna som representerar en rotation"

#. from yeager:blender-review
msgid ""
"Split a color into separate channels, based on a particular color model"
msgstr "Dela upp en färg i separata kanaler, baserat på en viss färgmodell"

#. from yeager:blender-review
msgid ""
"Split a transformation matrix into a translation vector, a rotation, and a "
"scale vector"
msgstr ""
"Dela upp en transformationsmatris i en translationsvektor, en rotation och "
"en skalvektor"

#. from yeager:blender-review
msgid "Extract a string segment from a larger string"
msgstr "Extrahera ett strängsegment från en större sträng"

#. from yeager:blender-review
msgid "Output the number of characters in the given string"
msgstr "Skriv ut antalet tecken i den angivna strängen"

#. from yeager:blender-review
msgid "String to Value"
msgstr "Sträng till värde"

#. from yeager:blender-review
msgid "Derive a numeric value from a given string representation"
msgstr "Härled ett numeriskt värde från en given strängrepresentation"

#. from yeager:blender-review
msgid ""
"Apply a transformation matrix (excluding translation) to the given vector"
msgstr ""
"Tillämpa en transformationsmatris (exklusive translation) på den givna "
"vektorn"

#. from yeager:blender-review
msgid "Apply a transformation matrix to the given vector"
msgstr "Tillämpa en transformationsmatris på den givna vektorn"

#. from yeager:blender-review
msgid ""
"Flip a matrix over its diagonal, turning columns into rows and vice-versa"
msgstr ""
"Vänd en matris över dess diagonal, så att kolumner blir rader och vice "
"versa."

#. from yeager:blender-review
msgid "Generate a string representation of the given input value"
msgstr "Generera en strängrepresentation av det angivna ingångsvärdet"

#. from yeager:blender-review
msgid "Bone Info"
msgstr "Beninfo"

#. from yeager:blender-review
msgid "Retrieve information of armature bones"
msgstr "Hämta information om armaturben"

#. from yeager:blender-review
msgid "Output the bone pose relative to the armature object transform"
msgstr ""
"Skriv ut benets position i förhållande till armeringsobjektets "
"transformation"

#. from yeager:blender-review
msgid "Bring the bone pose into the modified object"
msgstr "För in benpositionen i det modifierade objektet"

#. from yeager:blender-review
msgid "Create a list of values"
msgstr "Skapa en lista med värden"

#. from yeager:blender-review
msgid "Cube Grid Topology"
msgstr "Kubisk rutnätstopologi"

#. from yeager:blender-review
msgid ""
"Create a boolean grid topology with the given dimensions, for use with the "
"Field to Grid node"
msgstr ""
"Skapa en boolesk rutnätstopologi med angivna dimensioner, för användning med"
" noden Field to Grid."

#. from yeager:blender-review
msgid ""
"The handle can be moved anywhere, and does not influence the point's other "
"handle"
msgstr ""
"Handtaget kan flyttas var som helst och påverkar inte punktens andra "
"handtag."

#. from yeager:blender-review
msgid "Field to Grid"
msgstr "Från fält till elnät"

#. from yeager:blender-review
msgid ""
"Create new grids by evaluating new values on an existing volume grid "
"topology"
msgstr ""
"Skapa nya rutnät genom att utvärdera nya värden på en befintlig "
"volymrutnätsstruktur."

#. from yeager:blender-review
msgid "Data type for topology grid"
msgstr "Datatyp för topologiraster"

#. from yeager:blender-review
msgid "Field to List"
msgstr "Fält till lista"

#. from yeager:blender-review
msgid "Get Geometry Bundle"
msgstr "Skaffa geometripaketet"

#. from yeager:blender-review
msgid "Get the bundle of a geometry"
msgstr "Skaffa geometripaketet"

#. from yeager:blender-review
msgid "Advect Grid"
msgstr "Advect rutnät"

#. from yeager:blender-review
msgid ""
"Move grid values through a velocity field using numerical integration. "
"Supports multiple integration schemes for different accuracy and performance"
" trade-offs"
msgstr ""
"Flytta rutnätsvärden genom ett hastighetsfält med hjälp av numerisk "
"integration. Stöder flera integrationsscheman för olika avvägningar mellan "
"noggrannhet och prestanda."

#. from yeager:blender-review
msgid "Clip Grid"
msgstr "Klipprutnät"

#. from yeager:blender-review
msgid ""
"Deactivate grid voxels outside minimum and maximum coordinates, setting them"
" to the background value."
msgstr ""
"Inaktivera rutnätsvoxlar utanför minimi- och maximikoordinaterna och ställ "
"in dem till bakgrundsvärdet."

#. from yeager:blender-review
msgid "Grid Curl"
msgstr "Grid Curl"

#. from yeager:blender-review
msgid ""
"Calculate the magnitude and direction of circulation of a directional vector"
" grid"
msgstr ""
"Beräkna storleken och riktningen på cirkulationen för ett "
"riktningsvektorgaller"

#. from yeager:blender-review
msgid "Grid Dilate & Erode"
msgstr "Rutnätet utvidgas och urholkas"

#. from yeager:blender-review
msgid ""
"Dilate or erode the active regions of a grid. This changes which voxels are "
"active but does not change their values."
msgstr ""
"Utvidga eller erodera de aktiva områdena i ett rutnät. Detta ändrar vilka "
"voxlar som är aktiva, men ändrar inte deras värden."

#. from yeager:blender-review
msgid "Grid Divergence"
msgstr "Nätavvikelse"

#. from yeager:blender-review
msgid ""
"Calculate the flow into and out of each point of a directional vector grid"
msgstr "Beräkna flödet in och ut från varje punkt i ett riktningsvektorgaller"

#. from yeager:blender-review
msgid "Grid Gradient"
msgstr "Rutnätets lutning"

#. from yeager:blender-review
msgid ""
"Calculate the direction and magnitude of the change in values of a scalar "
"grid"
msgstr ""
"Beräkna riktningen och storleken på förändringen i värdena för ett skalärt "
"rutnät"

#. from yeager:blender-review
msgid "Grid Info"
msgstr "Nätinformation"

#. from yeager:blender-review
msgid "Retrieve information about a volume grid"
msgstr "Hämta information om ett volymrutnät"

#. from yeager:blender-review
msgid "Grid Laplacian"
msgstr "Grid Laplacian"

#. from yeager:blender-review
msgid "Compute the divergence of the gradient of the input grid"
msgstr "Beräkna divergensen av gradienten för ingångsrutnätet"

#. from yeager:blender-review
msgid "Grid Mean"
msgstr "Nätets medelvärde"

#. from yeager:blender-review
msgid ""
"Apply mean (box) filter smoothing to a voxel. The mean value from "
"surrounding voxels in a box-shape defined by the radius replaces the voxel "
"value."
msgstr ""
"Tillämpa medelvärdesfilter (box) på en voxel. Medelvärdet från omgivande "
"voxlar i en boxform definierad av radien ersätter voxelvärdet."

#. from yeager:blender-review
msgid "Grid Median"
msgstr "Nätets medianvärde"

#. from yeager:blender-review
msgid ""
"Apply median (box) filter smoothing to a voxel. The median value from "
"surrounding voxels in a box-shape defined by the radius replaces the voxel "
"value."
msgstr ""
"Tillämpa medianfilterutjämning (box) på en voxel. Medianvärdet från "
"omgivande voxlar i en boxform definierad av radien ersätter voxelvärdet."

#. from yeager:blender-review
msgid "Prune Grid"
msgstr "Beskärningsrutnät"

#. from yeager:blender-review
msgid ""
"Make the storage of a volume grid more efficient by collapsing data into "
"tiles or inner nodes"
msgstr ""
"Gör lagringen av ett volymnät mer effektiv genom att komprimera data till "
"rutor eller inre noder."

#. from yeager:blender-review
msgid "Grid to Points"
msgstr "Rutnät till punkter"

#. from yeager:blender-review
msgid "Generate a point cloud from a volume grid's active voxels"
msgstr "Generera en punktmoln från ett volymrutnätets aktiva voxlar"

#. from yeager:blender-review
msgid "Voxelize Grid"
msgstr "Voxelize-rutnät"

#. from yeager:blender-review
msgid ""
"Remove sparseness from a volume grid by making the active tiles into voxels"
msgstr ""
"Ta bort gleshet från ett volymrutnät genom att göra de aktiva rutorna till "
"voxlar."

#. from yeager:blender-review
msgid "Import volume data from a .vdb file"
msgstr "Importera volymdata från en .vdb-fil"

#. from yeager:blender-review
msgid "Voxel Index"
msgstr "Voxelindex"

#. from yeager:blender-review
msgid ""
"Retrieve the integer coordinates of the voxel that the field is evaluated on"
msgstr "Hämta heltalskoordinaterna för den voxel som fältet utvärderas på."

#. from yeager:blender-review
msgid "Get List Item"
msgstr "Hämta listobjekt"

#. from yeager:blender-review
msgid "Retrieve a value from a list"
msgstr "Hämta ett värde från en lista"

#. from yeager:blender-review
msgid "Value may be implicitly converted if the type does not match"
msgstr "Värdet kan konverteras implicit om typen inte stämmer överens."

#. from yeager:blender-review
msgid "Structure Type"
msgstr "Strukturtyp"

#. from yeager:blender-review
msgid ""
"What kind of higher order types are expected to flow through this socket"
msgstr "Vilka typer av högre ordning förväntas flöda genom detta uttag"

#. from yeager:blender-review
msgid "List Length"
msgstr "Listlängd"

#. from yeager:blender-review
msgid "Count how many items are in a given list"
msgstr "Räkna hur många objekt som finns i en given lista"

#. from yeager:blender-review
msgid "Realize to Point Domain"
msgstr "Förverkliga till punktdomän"

#. from yeager:blender-review
msgid ""
"Propagate instance attributes to the point domain rather than the curve "
"domain. This property exists for compatibility with 5.0 and earlier."
msgstr ""
"Sprid instansattribut till punktdomänen istället för kurvdomänen. Denna "
"egenskap finns för kompatibilitet med 5.0 och tidigare versioner."

#. from yeager:blender-review
msgid ""
"Do not collapse curves to single points if they are shorter than the given "
"length. The collapsing behavior exists for compatibility reasons."
msgstr ""
"Kollapsa inte kurvor till enstaka punkter om de är kortare än den angivna "
"längden. Kollapsningsfunktionen finns av kompatibilitetsskäl."

#. from yeager:blender-review
msgid "SDF Grid Fillet"
msgstr "SDF-rutnätfilé"

#. from yeager:blender-review
msgid ""
"Round off concave internal corners in a signed distance field. Only affects "
"areas with negative principal curvature, creating smoother transitions "
"between surfaces"
msgstr ""
"Avrunda konkava inre hörn i ett signerat avståndsfält. Påverkar endast "
"områden med negativ huvudkrökning, vilket skapar mjukare övergångar mellan "
"ytor."

#. from yeager:blender-review
msgid "SDF Grid Laplacian"
msgstr "SDF-rutnät Laplacian"

#. from yeager:blender-review
msgid ""
"Apply Laplacian flow smoothing to a signed distance field. Computationally "
"efficient alternative to mean curvature flow, ideal when combined with SDF "
"normalization"
msgstr ""
"Tillämpa Laplacian-flödesutjämning på ett signerat avståndsfält. "
"Beräkningsmässigt effektivt alternativ till medelkurvaturflöde, idealiskt i "
"kombination med SDF-normalisering."

#. from yeager:blender-review
msgid "SDF Grid Mean"
msgstr "SDF-nätets medelvärde"

#. from yeager:blender-review
msgid ""
"Apply mean (box) filter smoothing to a signed distance field. Fast separable"
" averaging filter for general smoothing of the distance field"
msgstr ""
"Tillämpa medelvärdesfilter (boxfilter) för utjämning av ett signerat "
"avståndsfält. Snabbt separerbart medelvärdesfilter för allmän utjämning av "
"avståndsfältet."

#. from yeager:blender-review
msgid "SDF Grid Mean Curvature"
msgstr "SDF-rutnätets medelkurvatur"

#. from yeager:blender-review
msgid ""
"Apply mean curvature flow smoothing to a signed distance field. Evolves the "
"surface based on its mean curvature, naturally smoothing high-curvature "
"regions more than flat areas"
msgstr ""
"Tillämpa utjämning av medelkurvaturflöde på ett signerat avståndsfält. "
"Utvecklar ytan baserat på dess medelkurvatur, vilket naturligt utjämnar "
"områden med hög kurvatur mer än plana områden."

#. from yeager:blender-review
msgid "SDF Grid Median"
msgstr "SDF-rutnätets median"

#. from yeager:blender-review
msgid ""
"Apply median filter to a signed distance field. Reduces noise while "
"preserving sharp features and edges in the distance field"
msgstr ""
"Tillämpa medianfilter på ett signerat avståndsfält. Minskar bruset samtidigt"
" som skarpa detaljer och kanter i avståndsfältet bevaras."

#. from yeager:blender-review
msgid "SDF Grid Offset"
msgstr "SDF-rutnätsförskjutning"

#. from yeager:blender-review
msgid ""
"Offset a signed distance field surface by a world-space distance. Dilates "
"(positive) or erodes (negative) while maintaining the signed distance "
"property"
msgstr ""
"Kompensera en signerad avståndsfältyta med ett avstånd i världsrummet. "
"Dilaterar (positivt) eller eroderar (negativt) samtidigt som den signerade "
"avståndsegenskapen bibehålls."

#. from yeager:blender-review
msgid "Retrieve values from the specified volume grid"
msgstr "Hämta värden från det angivna volymrutnätet"

#. from yeager:blender-review
msgid "Set Geometry Bundle"
msgstr "Ställ in geometripaket"

#. from yeager:blender-review
msgid "Set the bundle of a geometry"
msgstr "Ställ in geometrins bunt"

#. from yeager:blender-review
msgid "Set Grease Pencil Softness"
msgstr "Ställ in mjukheten för fettpennan"

#. from yeager:blender-review
msgid "Set softness attribute on Grease Pencil geometry"
msgstr "Ställ in mjukhetsattribut på Grease Pencil-geometri"

#. from yeager:blender-review
msgid "Set Grid Background"
msgstr "Ställ in rutnätets bakgrund"

#. from yeager:blender-review
msgid "Set the background value used for inactive voxels and tiles"
msgstr "Ställ in bakgrundsvärdet som används för inaktiva voxlar och brickor"

#. from yeager:blender-review
msgid "Set Grid Transform"
msgstr "Ställ in rutnätstransformering"

#. from yeager:blender-review
msgid "Set the transform for the grid from index space into object space."
msgstr ""
"Ställ in transformeringen för rutnätet från indexutrymmet till "
"objektutrymmet."

#. from yeager:blender-review
msgid "UV Tangent"
msgstr "UV-tangent"

#. from yeager:blender-review
msgid "Generate tangent directions based on a UV map"
msgstr "Generera tangentriktningar baserat på en UV-karta"

#. from yeager:blender-review
msgid "Domain to evaluate fields on"
msgstr "Domän för utvärdering av fält på"

#. from yeager:blender-review
msgid "Viewer Items"
msgstr "Visningsobjekt"

#. from yeager:blender-review
msgid "Define Signature"
msgstr "Definiera signatur"

#. from yeager:blender-review
msgid ""
"This zone defines a closure signature that should be used by other nodes"
msgstr ""
"Denna zon definierar en stängningssignatur som ska användas av andra noder."

#. from yeager:blender-review
msgid ""
"This node defines a bundle signature that should be used by other nodes"
msgstr ""
"Denna nod definierar en bunt-signatur som ska användas av andra noder."

#. from yeager:blender-review
msgid "Enable Output"
msgstr "Aktivera utdata"

#. from yeager:blender-review
msgid "Either pass through the input value or output the fallback value"
msgstr "Antingen vidarebefordra ingångsvärdet eller mata ut reservvärdet"

#. from yeager:blender-review
msgid "Execute a given closure"
msgstr "Utför en given stängning"

#. from yeager:blender-review
msgid ""
"This node defines a closure signature that should be used by other nodes"
msgstr ""
"Denna nod definierar en stängningssignatur som ska användas av andra noder."

#. from yeager:blender-review
msgid "Get Bundle Item"
msgstr "Skaffa paketartikel"

#. from yeager:blender-review
msgid "Retrieve a bundle item by path."
msgstr "Hämta ett paketobjekt efter sökväg."

#. from yeager:blender-review
