msgstr "Använd rotationsordningen som definieras i BVH-filen."

#. from yeager:blender
msgid "Euler (XYZ)"
msgstr "Euler (XYZ)"

#. from yeager:blender
msgid "Convert rotations to euler XYZ"
msgstr "Konvertera rotationer till Euler XYZ"

#. from yeager:blender
msgid "Euler (XZY)"
msgstr "Euler (XZY)"

#. from yeager:blender
msgid "Convert rotations to euler XZY"
msgstr "Konvertera rotationer till Euler XZY"

#. from yeager:blender
msgid "Euler (YXZ)"
msgstr "Euler (YXZ)"

