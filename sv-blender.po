msgid "Attempt to import 'allPurpose' materials."
msgstr "Försök att importera material av typen \"allPurpose\"."

#. from yeager:blender
msgid ""
"Attempt to import 'preview' materials. Load 'allPurpose' materials as a "
"fallback"
msgstr ""
"Försök att importera \"preview\"-material. Ladda \"allPurpose\"-material som"
" reserv."

