msgid "Targa"
msgstr "Targa"

#. from yeager:blender
msgid "``.tga``"
msgstr "``.tga``"

#. from yeager:blender
msgid "`Cineon & DPX`_"
msgstr "`Cineon & DPX`_"

#. from yeager:blender
msgid "8, 10, 12, 16bit"
msgstr "8, 10, 12, 16 bitar"

#. from yeager:blender
msgid "``.cin`` ``.dpx``"
msgstr "``.cin`` ``.dpx``"

#. from yeager:blender
msgid "`OpenEXR`_"
msgstr "`OpenEXR`_"

#. from yeager:blender
msgid "float 16, 32bit"
msgstr "float 16, 32bit"

