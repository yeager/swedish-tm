msgstr ""
"En enhet i scenen med plats, skala och rotation. Används av scener och "
"samlingar."

#. from yeager:blender
msgid ":doc:`Paint Curve </sculpt_paint/brush/stroke>`"
msgstr ":doc:`Målningskurva </sculpt_paint/brush/stroke>`"

#. from yeager:blender
msgid "Stores a paint or sculpt stroke. Access from the paint tools."
msgstr "Lagrar ett färg- eller skulpteringsdrag. Åtkomst från målarverktygen."

#. from yeager:blender
msgid ":doc:`Palette </sculpt_paint/index>`"
msgstr ":doc:`Palett </sculpt_paint/index>`"

#. from yeager:blender
msgid "Store color presets. Access from the paint tools."
msgstr "Lagra förinställda färger. Åtkomst från färgverktygen."

#. from yeager:blender
msgid ":doc:`Particle </physics/particles/introduction>`"
msgstr ":doc:`Partikel </physics/particles/introduction>`"

#. from yeager:blender
msgid "Particle settings. Used by particle systems."
msgstr "Partikelinställningar. Används av partikelsystem."

#. from yeager:blender
msgid "Help achieve complex real-time lighting in EEVEE."
msgstr "Hjälp att åstadkomma komplex realtidsbelysning i EEVEE."

#. from yeager:blender
msgid ":doc:`Scene </scene_layout/scene/introduction>`"
msgstr ":doc:`Scen </scene_layout/scene/introduction>`"

#. from yeager:blender
msgid ""
"Primary store of all data displayed and animated. Used as top-level storage "
