msgid ""
"Upper mesh concavity bound (high values tend to smoothen and fill out "
"concave regions)"
msgstr ""
"Övre meshkonkavitetsgräns (höga värden tenderar att jämna ut och fylla ut "
"konkava områden)"

#. from yeager:blender
msgid "Mesh generator"
msgstr "Nätgenerator"

