msgstr "Lager för justeringskontrollerna ska vara på"

#. from yeager:blender
msgid "Assign Tweak Collections"
msgstr "Tilldela tweak-samlingar"

#. from yeager:blender
msgid "Use Head"
msgstr "Använd huvud"

#. from yeager:blender
msgid "Create head and neck bones"
msgstr "Skapa huvud- och halsben"

#. from yeager:blender
msgid "Create tail bones"
msgstr "Skapa svansben"

#. from yeager:blender
msgid "Custom Widget orient"
msgstr "Anpassad widgetorientering"

#. from yeager:blender
msgid "Targets custom WGTs to defined axis (global space)"
msgstr "Riktar anpassade WGT:er mot definierad axel (globalt utrymme)"

