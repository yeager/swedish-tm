msgstr "Använd blandningsläget Pin Light när du målar"

#. from yeager:blender
msgid "Use Difference blending mode while painting"
msgstr "Använd blandningsläget Skillnad när du målar"

#. from yeager:blender
msgid "Exclusion"
msgstr "Uteslutning"

#. from yeager:blender
msgid "Use Exclusion blending mode while painting"
msgstr "Använd blandningsläget Exclusion när du målar"

#. from yeager:blender
msgid "Use Subtract blending mode while painting"
msgstr "Använd blandningsläget Subtrahera när du målar"

#. from yeager:blender
msgid "Use Hue blending mode while painting"
msgstr "Använd blandningsläget Hue när du målar"

#. from yeager:blender
