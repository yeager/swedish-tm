msgid "Local +X Tangent"
msgstr "Lokal +X Tangent"

#. from yeager:blender
msgid "Local +Z Tangent"
msgstr "Lokal +Z Tangent"

#. from yeager:blender
msgid "Global +X Axis"
msgstr "Global +X-axel"

#. from yeager:blender
msgid "Global +Y Axis"
msgstr "Global +Y-axel"

#. from yeager:blender
msgid "Global +Z Axis"
msgstr "Global +Z-axel"

#. from yeager:blender
msgid "Local -X Tangent"
msgstr "Lokal -X Tangent"

#. from yeager:blender
msgid "Local -Z Tangent"
msgstr "Lokal -Z Tangent"

#. from yeager:blender
msgid "Global -X Axis"
msgstr "Global -X-axel"

#. from yeager:blender
msgid "Global -Y Axis"
msgstr "Global -Y-axel"

#. from yeager:blender
msgid "Global -Z Axis"
msgstr "Global -Z-axel"

#. from yeager:blender
msgid ""
"Create a new bone going from the last selected joint to the mouse position"
msgstr ""
"Skapa ett nytt ben som går från den senast valda leden till musens position."

#. from yeager:blender
msgid "Add Bone Collection"
msgstr "Lägg till Bone Collection"

#. from yeager:blender
msgid "Add a new bone collection"
msgstr "Lägg till en ny bensamling"

#. from yeager:blender
msgid "Add Selected Bones to Collection"
msgstr "Lägg till Selected Bones i samlingen"

#. from yeager:blender
msgid "Add selected bones to the chosen bone collection"
msgstr "Lägg till valda ben till den valda bensamlingen"

#. from yeager:blender
msgid ""
"Name of the bone collection to assign this bone to; empty to assign to the "
