msgid "Effective but slow compression"
msgstr "Effektiv men långsam komprimering"

#. from yeager:blender
msgid "Multithreaded compression, similar in size and quality as 'Zip'"
msgstr "Flertrådad komprimering, liknande i storlek och kvalitet som \"Zip"

#. from yeager:blender
msgid "Data Depth"
msgstr "Datadjup"

