msgstr "Färg på stråle när den missar"

#. from yeager:blender-review
msgid "Time step range controlling the teleportation arc parabola"
msgstr "Tidsstegsintervall som styr teleporteringsbågens parabel"

#. from yeager:blender-review
msgid "Ray Line Width"
msgstr "Strålbredd"

#. from yeager:blender-review
msgid "Visual width of the teleportation ray line"
msgstr "Teleporteringsstrålens synliga bredd"

#. from yeager:blender-review
msgid "Delete all workspaces except this one"
msgstr "Ta bort alla arbetsytor utom den här"

#. from yeager:blender-review
msgid "Show BVH Nodes"
msgstr "Visa BVH-noder"

#. from yeager:blender-review
msgid "Show the underlying BVH nodes as differently colored faces"
msgstr "Visa de underliggande BVH-noderna som olika färgade ytor"

