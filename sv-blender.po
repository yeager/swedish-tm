msgstr "**alltid** placera `-f` eller `-a` som sista argument."

#. from yeager:blender
msgid "Single Image"
msgstr "Enkel bild"

#. from yeager:blender
msgid "``-b``"
msgstr "``-b``"

#. from yeager:blender
msgid "Render in the background (without UI)."
msgstr "Rendera i bakgrunden (utan användargränssnitt)."

#. from yeager:blender
msgid "``file.blend``"
msgstr "``file.blend``"

#. from yeager:blender
msgid "Path to the blend-file to render."
msgstr "Sökväg till blend-filen som ska renderas."

#. from yeager:blender
msgid "``-f 10``"
msgstr "``-f 10``"

#. from yeager:blender
msgid "Render only the 10th frame."
msgstr "Rendera endast den 10:e ramen."

#. from yeager:blender
msgid "``-o /project/renders/frame_#####``"
msgstr "``-o /project/renders/frame_#####``"

#. from yeager:blender
msgid ""
"Path of where to save the rendered image, using five padded zeros for the "
"frame number."
msgstr ""
"Sökväg för var den renderade bilden ska sparas, med fem nollor som "
"ramnummer."

