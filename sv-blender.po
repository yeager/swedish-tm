msgid ""
"Lower mesh concavity bound (high values tend to smoothen and fill out "
"concave regions)"
msgstr ""
"Lägre gräns för konkavitet i nätet (höga värden tenderar att jämna ut och "
"fylla ut konkava områden)"

#. from yeager:blender
msgid "Upper Concavity"
msgstr "Övre konkavitet"

