msgstr "Använd blandningsläget Mättnad när du målar"

#. from yeager:blender
msgid "Use Color blending mode while painting"
msgstr "Använd färgblandningsläge när du målar"

#. from yeager:blender
msgid "Use Value blending mode while painting"
msgstr "Använd blandningsläget Värde när du målar"

#. from yeager:blender
