msgstr "Offsetobjekt"

#. from yeager:blender
msgid "Value for changes in location"
msgstr "Värde för förändringar i plats"

#. from yeager:blender
msgid "Random Rotation"
msgstr "Slumpmässig rotation"

#. from yeager:blender
msgid "Value for changes in rotation"
msgstr "Värde för förändringar i rotation"

#. from yeager:blender
msgid "Value for changes in scale"
msgstr "Värde för förändringar i skala"

#. from yeager:blender
msgid ""
"Index of the material used for generated strokes (0 keep original material)"
msgstr ""
"Index för material som används för genererade streck (0 behåll "
"originalmaterial)"

#. from yeager:blender
msgid "Random seed"
msgstr "Slumpmässigt frö"

#. from yeager:blender
msgid "Enable offset"
msgstr "Aktivera förskjutning"

#. from yeager:blender
msgid "Use Layer Pass"
msgstr "Använd lagerpass"

#. from yeager:blender
msgid "Use layer pass filter"
msgstr "Använd lagerpassfilter"

#. from yeager:blender
msgid "Use Material Pass"
msgstr "Använd materialpass"

#. from yeager:blender
msgid "Use material pass filter"
msgstr "Använd materialpassfilter"

#. from yeager:blender
msgid "Use the same random seed for each scale axis for a uniform scale"
msgstr ""
"Använd samma slumpmässiga utgångsvärde för varje skalaxel för en enhetlig "
"skala."

#. from yeager:blender
msgid "Animate strokes appearing and disappearing"
msgstr "Animera streck som dyker upp och försvinner"

#. from yeager:blender
msgid "How should strokes start to appear/disappear"
msgstr "Hur streck ska börja visas/försvinna"

#. from yeager:blender
msgid "All strokes start at same time (i.e. short strokes finish earlier)"
msgstr "Alla tag börjar samtidigt (dvs. korta tag avslutas tidigare)."

#. from yeager:blender
msgid "All strokes end at same time (i.e. short strokes start later)"
msgstr "Alla slag slutar samtidigt (dvs. korta slag börjar senare)"

#. from yeager:blender
msgid "Fade Factor"
msgstr "Fade-faktor"

#. from yeager:blender
msgid "Defines how much of the stroke is fading in/out"
msgstr "Definierar hur mycket av slaget som tonas in/ut."

#. from yeager:blender
msgid "How much strength fading applies on top of stroke opacity"
msgstr "Hur mycket styrka avtar utöver streckets opacitet"

#. from yeager:blender
msgid "Thickness Strength"
msgstr "Tjocklek Styrka"

#. from yeager:blender
msgid "How much strength fading applies on top of stroke thickness"
msgstr "Hur mycket styrka försvinner utöver streckets tjocklek"

#. from yeager:blender
msgid "End Frame (when Restrict Frame Range is enabled)"
msgstr "Slutbildruta (när Begränsa bildruteintervall är aktiverat)"

#. from yeager:blender
msgid "Start Frame (when Restrict Frame Range is enabled)"
msgstr "Startbildruta (när Begränsa bildruteområde är aktiverat)"

#. from yeager:blender
msgid ""
"Maximum number of frames that the build effect can run for (unless another "
"GP keyframe occurs before this time has elapsed)"
msgstr ""
"Maximalt antal bildrutor som byggnadseffekten kan köras under (om inte en "
"annan GP-nyckelbildruta inträffar innan denna tid har förflutit)"

#. from yeager:blender
msgid "How strokes are being built"
msgstr "Hur slag byggs upp"

#. from yeager:blender
msgid ""
"Strokes appear/disappear one after the other, but only a single one changes "
"at a time"
msgstr "Strokes visas/försvinner en efter en, men endast en ändras åt gången."

#. from yeager:blender
msgid "Multiple strokes appear/disappear at once"
msgstr "Flera streck visas/försvinner samtidigt"

#. from yeager:blender
msgid "Builds only new strokes (assuming 'additive' drawing)"
msgstr "Skapar endast nya streck (förutsatt att det är en \"additiv\" ritning)"

#. from yeager:blender
msgid "Object used as build starting position"
msgstr "Objekt som används som startposition för byggandet"

#. from yeager:blender
msgid "Defines how much of the stroke is visible"
msgstr "Definierar hur mycket av slaget som är synligt"

#. from yeager:blender
msgid "Multiply recorded drawing speed by a factor"
msgstr "Multiplicera den registrerade ritningshastigheten med en faktor"

#. from yeager:blender
msgid "The maximum gap between strokes in seconds"
msgstr "Maximal gap mellan slag i sekunder"

#. from yeager:blender
msgid ""
"Number of frames after each GP keyframe before the modifier has any effect"
msgstr ""
"Antal bildrutor efter varje GP-nyckelbildruta innan modifieraren har någon "
"effekt"

#. from yeager:blender
msgid "Output Vertex group"
msgstr "Utgång Vertexgrupp"

#. from yeager:blender
msgid ""
"Use drawing speed, a number of frames, or a manual factor to build strokes"
msgstr ""
"Använd ritningshastighet, antal bildrutor eller en manuell faktor för att "
"skapa streck."

#. from yeager:blender
msgid "Use recorded speed multiplied by a factor"
msgstr "Använd registrerad hastighet multiplicerad med en faktor"

#. from yeager:blender
msgid "Set a fixed number of frames for all build animations"
msgstr "Ställ in ett fast antal bildrutor för alla bygganimationer"

#. from yeager:blender
msgid "Set a manual percentage to build"
msgstr "Ställ in en manuell procentandel för att bygga"

#. from yeager:blender
msgid "How are strokes animated (i.e. are they appearing or disappearing)"
msgstr "Hur streck animeras (dvs. visas eller försvinner de)"

#. from yeager:blender
msgid ""
"Show points in the order they occur in each stroke (e.g. for animating lines"
" being drawn)"
msgstr ""
"Visa punkter i den ordning de förekommer i varje streck (t.ex. för att "
"animera linjer som ritas)."

#. from yeager:blender
msgid ""
"Hide points from the end of each stroke to the start (e.g. for animating "
"lines being erased)"
msgstr ""
"Dölj punkter från slutet av varje streck till början (t.ex. för att animera "
"linjer som raderas)"

#. from yeager:blender
msgid ""
"Hide points in the order they occur in each stroke (e.g. for animating ink "
"fading or vanishing after getting drawn)"
msgstr ""
"Dölj punkter i den ordning de förekommer i varje streck (t.ex. för att "
"animera bläck som bleknar eller försvinner efter att det ritats)."

#. from yeager:blender
msgid "Use Fading"
msgstr "Använd Fading"

#. from yeager:blender
msgid "Fade out strokes instead of directly cutting off"
msgstr "Tona ut streck istället för att klippa av dem direkt"

#. from yeager:blender
msgid "Restrict Visible Points"
msgstr "Begränsa synliga punkter"

#. from yeager:blender
msgid "Use a percentage factor to determine the visible points"
msgstr "Använd en procentfaktor för att bestämma de synliga punkterna"

#. from yeager:blender
msgid "Only modify strokes during the specified frame range"
msgstr "Ändra endast streck under det angivna bildintervallet"

#. from yeager:blender
msgid "Grease Pencil Color Modifier"
msgstr "Fettpenna färgmodifierare"

#. from yeager:blender
msgid "Attributes to modify"
msgstr "Attribut att ändra"

#. from yeager:blender
msgid "Modify fill and stroke colors"
msgstr "Ändra fyllnings- och konturfärger"

#. from yeager:blender
msgid "Modify stroke color only"
msgstr "Ändra endast streckfärg"

#. from yeager:blender
msgid "Modify fill color only"
msgstr "Ändra endast fyllningsfärg"

#. from yeager:blender
msgid "Custom curve to apply effect"
msgstr "Anpassad kurva för att tillämpa effekt"

#. from yeager:blender
msgid "Color hue offset"
msgstr "Färgtonförskjutning"

#. from yeager:blender
msgid "Color saturation factor"
msgstr "Färgmättnadsfaktor"

#. from yeager:blender
msgid "Use a custom curve to define a factor along the strokes"
msgstr "Använd en anpassad kurva för att definiera en faktor längs strecken"

#. from yeager:blender
msgid "Color value factor"
msgstr "Färgvärdefaktor"

#. from yeager:blender
msgid "Grease Pencil Dash Modifier"
msgstr "Fettpenna-streckmodifierare"

#. from yeager:blender
msgid "Create dot-dash effect for strokes"
msgstr "Skapa punkt-streck-effekt för streck"

#. from yeager:blender
msgid ""
"Offset into each stroke before the beginning of the dashed segment "
"generation"
msgstr ""
"Förskjutning i varje slag före början av genereringen av streckade segment"

#. from yeager:blender
msgid "Active Dash Segment Index"
msgstr "Aktivt instrumentpanelsegmentindex"

#. from yeager:blender
msgid "Active index in the segment list"
msgstr "Aktivt index i segmentlistan"

#. from yeager:blender
msgid "Grease Pencil Envelope Modifier"
msgstr "Fettpenna-kuvertmodifierare"

#. from yeager:blender
msgid "Envelope stroke effect modifier"
msgstr "Modifierare för kuvertstreckseffekt"

#. from yeager:blender
msgid "The material to use for the new strokes"
msgstr "Materialet som ska användas för de nya strecken"

#. from yeager:blender
msgid "Algorithm to use for generating the envelope"
msgstr "Algoritm som ska användas för att generera kuvertet"

#. from yeager:blender
msgid "Deform the stroke to best match the envelope shape"
msgstr "Deformera strecket så att det bäst matchar kuvertets form"

#. from yeager:blender
msgid "Add segments to create the envelope. Keep the original stroke."
msgstr ""
"Lägg till segment för att skapa kuvertet. Behåll den ursprungliga konturen."

#. from yeager:blender
msgid "Fills"
msgstr "Fyllningar"

#. from yeager:blender
msgid ""
"Add fill segments to create the envelope. Don't keep the original stroke."
msgstr ""
"Lägg till fyllsegment för att skapa kuvertet. Behåll inte den ursprungliga "
"konturen."

#. from yeager:blender
msgid "The number of generated segments to skip to reduce complexity"
msgstr ""
"Antalet genererade segment som ska hoppas över för att minska komplexiteten"

#. from yeager:blender
msgid "The number of points to skip to create straight segments"
msgstr "Antalet punkter som ska hoppas över för att skapa raka segment"

#. from yeager:blender
msgid "Multiplier for the strength of the new strokes"
msgstr "Multiplikator för styrkan hos de nya slagen"

#. from yeager:blender
msgid "Multiplier for the thickness of the new strokes"
msgstr "Multiplikator för tjockleken på de nya strecken"

#. from yeager:blender
msgid "Hook modifier to modify the location of stroke points"
msgstr "Krokmodifierare för att ändra placeringen av streckpunkter"

#. from yeager:blender
msgid "Hook Center"
msgstr "Krokcenter"

#. from yeager:blender
msgid "If not zero, the distance from the hook where influence ends"
msgstr "Om inte noll, avståndet från kroken där påverkan upphör."

#. from yeager:blender
msgid "No Falloff"
msgstr "Inget bortfall"

#. from yeager:blender
msgid "Reverse the transformation between this object and its target"
msgstr "Återställ omvandlingen mellan detta objekt och dess mål"

#. from yeager:blender
msgid "Parent Object for hook, also recalculates and clears offset"
msgstr "Överordnat objekt för hook, beräknar också om och rensar offset"

#. from yeager:blender
msgid "Relative force of the hook"
msgstr "Krokens relativa kraft"

#. from yeager:blender
msgid ""
"Name of Parent Bone for hook (if applicable), also recalculates and clears "
"offset"
msgstr ""
"Namn på överordnat ben för krok (om tillämpligt), beräknar också om och "
"rensar förskjutningen"

#. from yeager:blender
msgid "Compensate for non-uniform object scale"
msgstr "Kompensera för ojämn objektskala"

#. from yeager:blender
msgid "Grease Pencil Lattice Modifier"
msgstr "Fettpenna-gittermodifierare"

#. from yeager:blender
msgid "Lattice object to deform with"
msgstr "Gitterobjekt att deformera med"

#. from yeager:blender
msgid "Strength of modifier effect"
msgstr "Modifierarens styrka"

#. from yeager:blender
msgid "Stretch or shrink strokes"
msgstr "Sträck eller krymp streck"

#. from yeager:blender
msgid "End Factor"
msgstr "Slutfaktor"

#. from yeager:blender
msgid "Added length to the end of each stroke relative to its length"
msgstr "Längd tillagd i slutet av varje slag i förhållande till dess längd"

#. from yeager:blender
msgid "Absolute added length to the end of each stroke"
msgstr "Absolut tillagd längd i slutet av varje slag"

#. from yeager:blender
msgid "Invert Curvature"
msgstr "Invertera krökning"

#. from yeager:blender
msgid "Invert the curvature of the stroke's extension"
msgstr "Vänd på kurvan för strykningens förlängning"

#. from yeager:blender
msgid ""
"Ignore points on the stroke that deviate from their neighbors by more than "
"this angle when determining the extrapolation shape"
msgstr ""
"Ignorera punkter på strecket som avviker från sina grannar med mer än denna "
"vinkel när extrapoleringsformen bestäms."

#. from yeager:blender
msgid "Mode to define length"
msgstr "Läge för att definiera längd"

#. from yeager:blender
msgid "Length in ratio to the stroke's length"
msgstr "Längd i förhållande till slaglängden"

#. from yeager:blender
msgid "Length in geometry space"
msgstr "Längd i geometriskt utrymme"

#. from yeager:blender
msgid ""
"Defines what portion of the stroke is used for the calculation of the "
"extension"
msgstr ""
"Definierar vilken del av slaget som används för beräkningen av "
"förlängningen."

#. from yeager:blender
msgid "Multiplied by Start/End for the total added point count"
msgstr "Multiplicerat med Start/Slut för det totala antalet tillagda poäng"

#. from yeager:blender
msgid "Random End Factor"
msgstr "Slumpmässig slutfaktor"

#. from yeager:blender
msgid "Size of random length added to the end of each stroke"
msgstr "Storlek på slumpmässig längd som läggs till i slutet av varje streck"

#. from yeager:blender
msgid "Smoothly offset each stroke's random value"
msgstr "Jämna ut varje slags slumpmässiga värde"

#. from yeager:blender
msgid "Random Start Factor"
msgstr "Slumpmässig startfaktor"

#. from yeager:blender
msgid "Size of random length added to the start of each stroke"
msgstr "Storlek på slumpmässig längd som läggs till i början av varje streck"

#. from yeager:blender
msgid "Start Factor"
msgstr "Startfaktor"

#. from yeager:blender
msgid "Added length to the start of each stroke relative to its length"
msgstr ""
"Längden på början av varje slag har förlängts i förhållande till dess längd."

#. from yeager:blender
msgid "Absolute added length to the start of each stroke"
msgstr "Absolut tillagd längd till början av varje slag"

#. from yeager:blender
msgid "Number of frames between randomization steps"
msgstr "Antal bildrutor mellan randomiseringsstegen"

#. from yeager:blender
msgid "Use Curvature"
msgstr "Använd Curvature"

#. from yeager:blender
msgid "Follow the curvature of the stroke"
msgstr "Följ streckets kurvatur"

#. from yeager:blender
msgid "Use random values over time"
msgstr "Använd slumpmässiga värden över tid"

#. from yeager:blender
msgid "Generate Line Art strokes from selected source"
msgstr "Skapa linjekonststreck från vald källa"

#. from yeager:blender
msgid ""
"Segments with an image distance smaller than this will be chained together"
msgstr ""
"Segment med ett avstånd mellan bilderna som är mindre än detta kommer att "
"kopplas ihop."

#. from yeager:blender
msgid ""
"Angles smaller than this will be treated as creases. Crease angle priority: "
"object Line Art crease override > mesh auto smooth angle > Line Art default "
"crease."
msgstr ""
"Vinklar som är mindre än detta kommer att behandlas som veck. Prioritet för "
"veckvinkel: objekt Linjekonst vecköverskrivning > mesh automatisk "
"utjämningsvinkel > Linjekonst standardveck."

#. from yeager:blender
msgid "Invert source vertex group values"
msgstr "Invertera källans vertexgruppsvärden"

#. from yeager:blender
msgid "This modifier has baked data"
msgstr "Denna modifierare har bakade data"

#. from yeager:blender
msgid "Level End"
msgstr "Nivå Slut"

#. from yeager:blender
msgid "Maximum number of occlusions for the generated strokes"
msgstr "Maximalt antal ocklusioner för de genererade slagen"

#. from yeager:blender
msgid "Level Start"
msgstr "Nivå Start"

#. from yeager:blender
msgid "Minimum number of occlusions for the generated strokes"
msgstr "Minsta antal ocklusioner för de genererade slagen"

#. from yeager:blender
msgid "Use this light object to generate light contour"
msgstr "Använd detta ljusobjekt för att generera ljus kontur"

#. from yeager:blender
msgid "The strength value for the generate strokes"
msgstr "Styrkevärdet för genererade slag"

#. from yeager:blender
msgid ""
"A margin to prevent strokes from ending abruptly at the edge of the image"
msgstr ""
"En marginal för att förhindra att streck slutar abrupt vid bildens kant."

#. from yeager:blender
msgid "Shadow Camera Far"
msgstr "Skuggkamera långt bort"

#. from yeager:blender
msgid "Shadow Camera Near"
msgstr "Skuggkamera nära"

#. from yeager:blender
msgid "Near clipping distance of shadow camera"
msgstr "Nära klippavstånd för skuggkamera"

#. from yeager:blender
msgid ""
"Represents the \"Orthographic Scale\" of an orthographic camera. If the "
"camera is positioned at the light's location with this scale, it will "
"represent the coverage of the shadow \"camera\"."
msgstr ""
"Representerar den \"ortografiska skalan\" för en ortografisk kamera. Om "
"kameran placeras på ljusets plats med denna skala kommer den att "
"representera täckningen för skuggkameran."

#. from yeager:blender
msgid "Shadow Region Filtering"
msgstr "Filtrering av skuggområden"

#. from yeager:blender
msgid "Not filtering any lines based on illumination region"
msgstr "Ingen filtrering av linjer baserat på belysningsområde"

#. from yeager:blender
msgid "Only selecting lines from illuminated regions"
msgstr "Välj endast linjer från upplysta områden"

#. from yeager:blender
msgid "Only selecting lines from shaded regions"
msgstr "Välj endast rader från skuggade områden"

#. from yeager:blender
msgid ""
"Selecting lines from lit regions, and make the combination of contour, light"
" contour and shadow lines into enclosed shapes"
msgstr ""
"Välj linjer från upplysta områden och kombinera kontur-, ljus- och "
"skugglinjer till slutna former."

#. from yeager:blender
msgid "Silhouette Filtering"
msgstr "Silhuettfiltrering"

#. from yeager:blender
msgid "Strength of smoothing applied on jagged chains"
msgstr "Styrka hos utjämning som tillämpas på ojämna kedjor"

#. from yeager:blender
msgid "Use specified camera object for generating Line Art strokes"
msgstr "Använd angivet kameraobjekt för att generera linjekonststreck"

#. from yeager:blender
msgid "Generate strokes from the objects in this collection"
msgstr "Skapa streck från objekten i denna samling"

#. from yeager:blender
msgid "Generate strokes from this object"
msgstr "Skapa streck från detta objekt"

#. from yeager:blender
msgid "Line Art stroke source type"
msgstr "Linjekonstpenselkälltyp"

#. from yeager:blender
msgid "Source Vertex Group"
msgstr "Källa: Vertex Group"

#. from yeager:blender
msgid ""
"Match the beginning of vertex group names from mesh objects, match all when "
"left empty"
msgstr ""
"Matcha början av vertexgruppnamn från meshobjekt, matcha alla när fältet "
"lämnas tomt"

#. from yeager:blender
msgid "Angle in screen space below which a stroke is split in two"
msgstr "Vinkel i skärmytan under vilken ett streck delas i två delar"

#. from yeager:blender
msgid "Stroke Depth Offset"
msgstr "Djupförskjutning för streck"

#. from yeager:blender
msgid ""
"Move strokes slightly towards the camera to avoid clipping while preserve "
"depth for the viewport"
msgstr ""
"Flytta strecken något mot kameran för att undvika klippning samtidigt som "
"djupet för visningsfönstret bevaras."

#. from yeager:blender
msgid "Grease Pencil layer to which assign the generated strokes"
msgstr "Fettpenna-lager som tilldelas de genererade strecken"

#. from yeager:blender
msgid "Grease Pencil material assigned to the generated strokes"
msgstr "Fettpenna-material tilldelat de genererade strecken"

#. from yeager:blender
msgid "The thickness for the generated strokes"
msgstr "Tjockleken för de genererade strecken"

#. from yeager:blender
msgid "Back Face Culling"
msgstr "Baksideklippning"

#. from yeager:blender
msgid ""
"Remove all back faces to speed up calculation, this will create edges in "
"different occlusion levels than when disabled"
msgstr ""
"Ta bort alla baksidor för att påskynda beräkningen. Detta skapar kanter i "
"olika ocklusionsnivåer än när funktionen är inaktiverad."

#. from yeager:blender
msgid ""
"Use cached scene data from the first Line Art modifier in the stack. Certain"
" settings will be unavailable."
msgstr ""
"Använd cachade scendata från den första Line Art-modifieraren i stapeln. "
"Vissa inställningar kommer inte att vara tillgängliga."

#. from yeager:blender
msgid "Allow lines generated by the near/far clipping plane to be shown"
msgstr "Tillåt att linjer som genereras av det nära/fjärran klippplanet visas"

#. from yeager:blender
msgid "Generate strokes from contours lines"
msgstr "Generera streck från konturlinjer"

#. from yeager:blender
msgid "Use Crease"
msgstr "Använd veck"

#. from yeager:blender
msgid "Generate strokes from creased edges"
msgstr "Skapa streck från vikta kanter"

#. from yeager:blender
msgid "Crease On Sharp Edges"
msgstr "Veck på skarpa kanter"

#. from yeager:blender
msgid "Allow crease to show on sharp edges"
msgstr "Låt veck synas på skarpa kanter"

#. from yeager:blender
msgid "Crease On Smooth Surfaces"
msgstr "Veck på släta ytor"

#. from yeager:blender
msgid "Allow crease edges to show inside smooth surfaces"
msgstr "Låt veckade kanter synas på släta ytor"

#. from yeager:blender
msgid "Use custom camera instead of the active camera"
msgstr "Använd anpassad kamera istället för den aktiva kameran"

#. from yeager:blender
msgid "Keep the zig-zag \"noise\" in initial chaining"
msgstr "Behåll zigzag-bruset i den initiala kedjan"

#. from yeager:blender
msgid "Use Edge Mark"
msgstr "Använd kantmarkering"

#. from yeager:blender
msgid "Generate strokes from Freestyle marked edges"
msgstr "Generera streck från Freestyle-markerade kanter"

#. from yeager:blender
msgid "Handle Overlapping Edges"
msgstr "Hantera överlappande kanter"

#. from yeager:blender
msgid ""
"Allow edges in the same location (i.e. from edge split) to show properly. "
"May run slower."
msgstr ""
"Tillåt att kanter på samma plats (dvs. från kantdelning) visas korrekt. Kan "
"fungera långsammare."

#. from yeager:blender
msgid "Filter Face Marks"
msgstr "Filter för ansiktsmärken"

#. from yeager:blender
msgid "Filter feature lines using Freestyle face marks"
msgstr "Filtrera funktionslinjer med hjälp av Freestyle-ansiktsmarkeringar"

#. from yeager:blender
msgid "Filter feature lines based on face mark boundaries"
msgstr "Filtrera funktionslinjer baserat på ansiktsmärkesgränser"

#. from yeager:blender
msgid "Invert face mark filtering"
msgstr "Invertera filtrering av ansiktsmärken"

#. from yeager:blender
msgid "Preserve contour lines while filtering"
msgstr "Bevara konturlinjerna vid filtrering"

#. from yeager:blender
msgid "Treat all lines as the same line type so they can be chained together"
msgstr "Behandla alla linjer som samma linjetyp så att de kan kopplas ihop."

#. from yeager:blender
msgid "Intersection With Contour"
msgstr "Korsning med kontur"

#. from yeager:blender
msgid ""
"Treat intersection and contour lines as if they were the same type so they "
"can be chained together"
msgstr ""
"Behandla skärningspunkter och konturlinjer som om de vore av samma typ så "
"att de kan kopplas ihop."

#. from yeager:blender
msgid "Use Geometry Space"
msgstr "Använd geometriutrymme"

#. from yeager:blender
msgid "Use geometry distance for chaining instead of image space"
msgstr "Använd geometrisk avstånd för kedjning istället för bildutrymme"

#. from yeager:blender
msgid ""
"Trim all edges right at the boundary of image (including overscan region)"
msgstr ""
"Trimma alla kanter precis vid bildens gräns (inklusive överskanningsområdet)"

#. from yeager:blender
