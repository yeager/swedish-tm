"Time delay in 1/10 seconds before automatically opening top level menus"
msgstr "Tidsfördröjning på 1/10 sekund innan toppmenyerna öppnas automatiskt"

#. from yeager:blender
msgid ""
"Time needed to fully animate the pie to unfolded state (in 1/100ths of sec)"
msgstr ""
"Tid som behövs för att animera cirkeln till utfällt tillstånd (i 1/100-delar"
