msgstr "Deformerar befintliga hårkurvor till flätor med hjälp av styrkurvor"

#. from yeager:blender
msgid "Guide index map that was used for the operation"
msgstr "Guideindexkarta som användes för operationen"

#. from yeager:blender
msgid "Parameter from 0 to 1 along the flare"
msgstr "Parameter från 0 till 1 längs facklan"

