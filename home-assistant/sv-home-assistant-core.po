msgctxt "[\"Home Assistant Core\",\"core\",\"component::airthings_ble::issues::connectivity_smartlink::title\",\"962761753\"]"
msgid "{device_name} ({serial_number}) uses SmartLink connectivity"
msgstr "{device_name} ({serial_number}) använder SmartLink-anslutning"

