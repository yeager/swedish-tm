msgctxt "[\"Home Assistant Companion for Android\",\"android\",\"webview_error_SSL_DATE_INVALID\",\"50009162\"]"
msgid "The date of the Home Assistant certificate is invalid, please review the Home Assistant certificate or the connection settings and try again."
msgstr "Datumet för Home Assistant-certifikatet är ogiltigt. Granska Home Assistant-certifikatet eller anslutningsinställningarna och försök igen."

#. Lokalise key 50009163; source translation 354867122; Swedish translation 354867143; snapshot 2026-10-24; live-lokalise-export
msgctxt "[\"Home Assistant Companion for Android\",\"android\",\"webview_error_SSL_EXPIRED\",\"50009163\"]"
msgid "The Home Assistant certificate has expired, please review the Home Assistant certificate or the connection settings and try again."
msgstr "Home Assistant-certifikatet har löpt ut. Granska Home Assistant-certifikatet eller anslutningsinställningarna och försök igen."

#. Lokalise key 50009164; source translation 354867149; Swedish translation 354867170; snapshot 2026-10-24; live-lokalise-export
msgctxt "[\"Home Assistant Companion for Android\",\"android\",\"webview_error_SSL_IDMISMATCH\",\"50009164\"]"
