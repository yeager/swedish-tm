msgstr "Certifikatet för Home Assistant-värdnamnet matchar inte. Granska Home Assistant-certifikatet eller anslutningsinställningarna och försök igen."

#. Lokalise key 50009165; source translation 354867176; Swedish translation 354867197; snapshot 2026-10-24; live-lokalise-export
msgctxt "[\"Home Assistant Companion for Android\",\"android\",\"webview_error_SSL_INVALID\",\"50009165\"]"
msgid "A generic SSL error occurred when loading Home Assistant, please review the Home Assistant certificate or the connection settings and try again."
msgstr "Ett allmänt SSL-fel inträffade när Home Assistant laddades. Granska Home Assistant-certifikatet eller anslutningsinställningarna och försök igen."

#. Lokalise key 50009166; source translation 354867203; Swedish translation 354867224; snapshot 2026-10-24; live-lokalise-export
msgctxt "[\"Home Assistant Companion for Android\",\"android\",\"webview_error_SSL_NOTYETVALID\",\"50009166\"]"
msgid "The Home Assistant certificate is not yet valid, please review the Home Assistant certificate or the connection settings and try again."
msgstr "Home Assistant-certifikatet är inte giltigt ännu. Granska Home Assistant-certifikatet eller anslutningsinställningarna och försök igen."

#. Lokalise key 50009167; source translation 354867230; Swedish translation 354867251; snapshot 2026-10-24; live-lokalise-export
msgctxt "[\"Home Assistant Companion for Android\",\"android\",\"webview_error_SSL_UNTRUSTED\",\"50009167\"]"
