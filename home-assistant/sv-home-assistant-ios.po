msgctxt "[\"Home Assistant Companion for iOS\",\"ios\",\"server_identity.about.same_id.body\",\"961381489\"]"
msgid "A server set up from a backup of another one carries the same ID. The app cannot tell them apart by ID alone, so it asks which situation applies."
