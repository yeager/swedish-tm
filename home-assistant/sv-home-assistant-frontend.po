msgid "Up-to-date sensors and location, even when you're away from home."
msgstr "Aktuella sensordata och positionsinformation, även när du inte är hemma."

#. Lokalise key 887616667; source translation 9052189009; Swedish translation 9052186576; snapshot 2026-10-24; live-lokalise-export
msgctxt "[\"Home Assistant Frontend\",\"frontend\",\"ui::panel::config::cloud::account::companion::bullet_presence\",\"887616667\"]"
