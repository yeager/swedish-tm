msgid "$15: Zandahan!"
msgstr "15 dollar: Zandahan!"

#. from yeager:scummvm
msgid "$3: A pocałuj się gdzieś."
msgstr "$3: Och kyss någonstans."

#. from yeager:scummvm
msgid "#E4#B0"
msgstr "#E4#B0"

#. from yeager:scummvm
msgid "#E8#B0"
