msgstr "150"

#. from yeager:scummvm
msgid "BRANTALK.WSA"
msgstr "BRANTALK.WSA"

#. from yeager:scummvm
msgid "151"
msgstr "151"

#. from yeager:scummvm
msgid "So, YOU'RE the hero thrown against me?"
msgstr "Så det är du som är hjälten som kastas mot mig?"

#. from yeager:scummvm
msgid "152"
msgstr "152"

#. from yeager:scummvm
msgid "Were there none to test me better?"
msgstr "Fanns det ingen som kunde testa mig bättre?"

#. from yeager:scummvm
msgid "153"
msgstr "153"

#. from yeager:scummvm
msgid "Do you believe in all Brynn's lies?"
msgstr "Tror du på alla Brynns lögner?"

#. from yeager:scummvm
msgid "154"
msgstr "154"

#. from yeager:scummvm
msgid "Perhaps your MOTHER should assist you."
msgstr "Kanske din mor borde hjälpa dig."

#. from yeager:scummvm
msgid "My mother is dead, sir."
msgstr "Min mor är död, sir."

#. from yeager:scummvm
msgid "155"
msgstr "155"

#. from yeager:scummvm
msgid "156"
msgstr "156"

#. from yeager:scummvm
msgid "But YOURS lives, for surely, SHE has dressed you!"
msgstr "Men DIN lever, för visst har HON klätt dig!"

#. from yeager:scummvm
msgid "Be careful, boy.  Do not insult a man with knives."
msgstr "Var försiktig, pojke.  Förolämpa inte en man med knivar."

#. from yeager:scummvm
msgid "157"
msgstr "157"

#. from yeager:scummvm
msgid "Please move aside. I seek the cave."
msgstr "Flytta er åt sidan. Jag söker grottan."

#. from yeager:scummvm
msgid "158"
msgstr "158"

#. from yeager:scummvm
msgid "159"
msgstr "159"

#. from yeager:scummvm
msgid "Beware, young fool..."
msgstr "Akta dig, unga dåre..."

#. from yeager:scummvm
msgid "...my grip may slip!"
msgstr "...kan jag tappa greppet!"

#. from yeager:scummvm
msgid "160"
msgstr "160"

#. from yeager:scummvm
msgid "DODGE.WSA"
msgstr "DODGE.WSA"

#. from yeager:scummvm
msgid "161"
msgstr "161"

#. from yeager:scummvm
msgid "No bother sir. You missed the mark."
msgstr "Ingen fara, sir. Du missade målet."

#. from yeager:scummvm
msgid "162"
msgstr "162"

#. from yeager:scummvm
msgid "I do not miss..."
msgstr "Jag saknar inte..."

#. from yeager:scummvm
msgid "163"
msgstr "163"

#. from yeager:scummvm
msgid "...except at will."
msgstr "Spelarhälsan kommer aldrig att minska (förutom under spelets slutscener)."

#. from yeager:scummvm
msgid "164"
msgstr "164"

#. from yeager:scummvm
msgid "I must return your gift, kind sir."
msgstr "Jag måste återlämna er gåva, snälla sir."

#. from yeager:scummvm
msgid "165"
msgstr "165"

#. from yeager:scummvm
msgid "I leave you now, and dodge your sorrow..."
msgstr "Jag lämnar dig nu, och undviker din sorg..."

#. from yeager:scummvm
msgid "166"
msgstr "166"

#. from yeager:scummvm
msgid "167"
msgstr "167"

#. from yeager:scummvm
msgid "...but I may NOT be nice tomorrow."
msgstr "...men jag kanske INTE är snäll i morgon."

#. from yeager:scummvm
msgid "FROZEN.WSA"
msgstr "FROZEN.WSA"

#. from yeager:scummvm
msgid "168"
msgstr "168"

#. from yeager:scummvm
msgid "Now THAT'S scary!"
msgstr "Nu är det läskigt!"

#. from yeager:scummvm
msgid "169"
msgstr "169"

#. from yeager:scummvm
msgid "Which circus is HE from?"
msgstr "Vilken cirkus är han från?"

#. from yeager:scummvm
msgid "170"
msgstr "170"

#. from yeager:scummvm
msgid "171"
msgstr "171"

#. from yeager:scummvm
msgid "This is solid ice!"
msgstr "Det här är solid is!"

#. from yeager:scummvm
msgid "Serpent's Grotto"
msgstr "Ormens grotta"

#. from yeager:scummvm
msgid "172"
msgstr "172"

#. from yeager:scummvm
msgid "Don't you want this?"
msgstr "Vill du inte ha den här?"

#. from yeager:scummvm
msgid "173"
msgstr "173"

#. from yeager:scummvm
msgid "174"
msgstr "174"

#. from yeager:scummvm
msgid "It's the closest thing to birdseed I've got."
msgstr "Det är det närmaste fågelfrö jag har."

#. from yeager:scummvm
msgid "Why would a sick bird want that?"
msgstr "Varför skulle en sjuk fågel vilja ha det?"

#. from yeager:scummvm
msgid "175"
msgstr "175"

#. from yeager:scummvm
msgid "That bird is definitely hurt..."
msgstr "Den där fågeln är definitivt skadad..."

#. from yeager:scummvm
msgid "176"
msgstr "176"

#. from yeager:scummvm
msgid "177"
msgstr "177"

#. from yeager:scummvm
msgid "How can his wing bend like that?"
msgstr "Hur kan hans vinge böjas så där?"

#. from yeager:scummvm
msgid "178"
msgstr "178"

#. from yeager:scummvm
msgid "Yeech!"
msgstr "Yeech!"

#. from yeager:scummvm
msgid "What a messy housekeeper."
msgstr "Vilken stökig hushållerska."

#. from yeager:scummvm
msgid "179"
msgstr "179"

#. from yeager:scummvm
msgid "Songbird's nest"
msgstr "Sångfågelns bo"

#. from yeager:scummvm
msgid "180"
msgstr "180"

#. from yeager:scummvm
msgid "181"
msgstr "181"

#. from yeager:scummvm
msgid "If I heal his wing..."
msgstr "Om jag läker hans vinge..."

#. from yeager:scummvm
msgid "...he'll have to give me a feather, won't he?"
msgstr "...får han väl ge mig en fjäder, eller hur?"

#. from yeager:scummvm
msgid "182"
msgstr "182"

#. from yeager:scummvm
msgid "183"
msgstr "183"

#. from yeager:scummvm
msgid "SNGSPELL.WSA"
msgstr "SNGSPELL.WSA"

#. from yeager:scummvm
msgid "184"
msgstr "184"

#. from yeager:scummvm
msgid "SONG1.WSA"
msgstr "SONG1.WSA"

#. from yeager:scummvm
msgid "185"
msgstr "185"

#. from yeager:scummvm
msgid "Hope this qualifies as a quill."
msgstr "Hoppas det här kvalificerar sig som en fjäderpenna."

#. from yeager:scummvm
msgid "186"
msgstr "186"

#. from yeager:scummvm
msgid "One nut?"
msgstr "En mutter?"

#. from yeager:scummvm
msgid "Forest"
msgstr "Skog"

#. from yeager:scummvm
msgid "187"
msgstr "187"

#. from yeager:scummvm
msgid "WAKEN.WSA"
msgstr "WAKEN.WSA"

#. from yeager:scummvm
msgid "188"
msgstr "188"

#. from yeager:scummvm
msgid "Where am I?"
msgstr "Var är jag?"

#. from yeager:scummvm
msgid "189"
msgstr "189"

#. from yeager:scummvm
msgid "Oh my head!"
msgstr "Åh, mitt huvud!"

#. from yeager:scummvm
msgid "190"
msgstr "190"

#. from yeager:scummvm
msgid "What am I doing here?"
msgstr "Vad gör jag här?"

#. from yeager:scummvm
msgid "191"
msgstr "191"

#. from yeager:scummvm
msgid "192"
msgstr "192"

#. from yeager:scummvm
msgid "Did you transport me magically?"
msgstr "Transporterade du mig magiskt?"

#. from yeager:scummvm
msgid "You got hit on the head, and I dragged you in here."
msgstr "Du blev slagen i huvudet och jag släpade in dig hit."

#. from yeager:scummvm
msgid "193"
msgstr "193"

#. from yeager:scummvm
msgid "194"
msgstr "194"

#. from yeager:scummvm
msgid "ZANBASIC.WSA"
msgstr "ZANBASIC.WSA"

#. from yeager:scummvm
msgid "195"
msgstr "195"

#. from yeager:scummvm
msgid "BRANZAN.WSA"
msgstr "BRANZAN.WSA"

#. from yeager:scummvm
msgid "196"
msgstr "196"

#. from yeager:scummvm
msgid "LAUNDRY.WSA"
msgstr "LAUNDRY.WSA"

#. from yeager:scummvm
msgid "197"
msgstr "197"

#. from yeager:scummvm
msgid "POUR.WSA"
msgstr "POUR.WSA"

#. from yeager:scummvm
msgid "Who are you?"
msgstr "Vem är du?"

#. from yeager:scummvm
msgid "198"
msgstr "198"

#. from yeager:scummvm
msgid "I am Zanthia."
msgstr "Jag är Zanthia."

#. from yeager:scummvm
msgid "199"
msgstr "199"

#. from yeager:scummvm
msgid "200"
msgstr "200"

#. from yeager:scummvm
msgid "You must be Brandon."
msgstr "Du måste vara Brandon."

#. from yeager:scummvm
msgid "201"
msgstr "201"

#. from yeager:scummvm
msgid "You were a child the last time I saw you."
msgstr "Du var ett barn förra gången jag såg dig."

#. from yeager:scummvm
msgid "202"
msgstr "202"

#. from yeager:scummvm
msgid "So, what's in the cauldron?"
msgstr "Så, vad finns i kitteln?"

#. from yeager:scummvm
msgid "203"
msgstr "203"

#. from yeager:scummvm
msgid "A potion for time travel?"
msgstr "En dryck för tidsresor?"

#. from yeager:scummvm
msgid "No, this is my laundry."
msgstr "Nej, det här är min tvätt."

#. from yeager:scummvm
msgid "204"
msgstr "204"

#. from yeager:scummvm
msgid "Oh!"
msgstr "Åh!"

#. from yeager:scummvm
msgid "205"
msgstr "205"

#. from yeager:scummvm
msgid "206"
msgstr "206"

#. from yeager:scummvm
msgid "Did Darm and Brynn at least get all the gems activated on your amulet?"
msgstr "Fick Darm och Brynn åtminstone alla ädelstenar aktiverade på din amulett?"

#. from yeager:scummvm
msgid "I have two."
msgstr "Jag har två."

#. from yeager:scummvm
msgid "207"
msgstr "207"

#. from yeager:scummvm
msgid "208"
msgstr "208"

#. from yeager:scummvm
msgid "Two!?"
msgstr "Två!?"

#. from yeager:scummvm
msgid "Probably Healing and Will-O-Wisp!"
msgstr "Förmodligen Healing och Will-O-Wisp!"

#. from yeager:scummvm
msgid "209"
msgstr "209"

#. from yeager:scummvm
msgid "They said they didn't have much magic left."
msgstr "De sa att de inte hade mycket magi kvar."

#. from yeager:scummvm
msgid "210"
msgstr "210"

#. from yeager:scummvm
msgid "211"
msgstr "211"

#. from yeager:scummvm
msgid "Nobody has much magic left!"
msgstr "Ingen har mycket magi kvar!"

#. from yeager:scummvm
msgid "Can you help me?"
msgstr "Kan du hjälpa mig?"

#. from yeager:scummvm
msgid "212"
msgstr "212"

#. from yeager:scummvm
msgid "Why don't you just go up to the castle and give it a try with what you've got?"
msgstr "Varför går du inte bara upp till slottet och försöker med det du har?"

#. from yeager:scummvm
msgid "213"
msgstr "213"

#. from yeager:scummvm
msgid "Fine with me."
msgstr "Det är okej med mig."

#. from yeager:scummvm
msgid "214"
msgstr "214"

#. from yeager:scummvm
msgid "215"
msgstr "215"

#. from yeager:scummvm
msgid "I'll go, but how will I get there?"
msgstr "Jag ska gå, men hur ska jag ta mig dit?"

#. from yeager:scummvm
msgid "Didn't Darm do anything?"
msgstr "Gjorde inte Darm något?"

#. from yeager:scummvm
msgid "216"
msgstr "216"

#. from yeager:scummvm
msgid "He recommended I come see you."
msgstr "Han rekommenderade att jag skulle komma till dig."

#. from yeager:scummvm
msgid "217"
msgstr "217"

#. from yeager:scummvm
msgid "218"
msgstr "218"

#. from yeager:scummvm
msgid "Okay, I'll give you what I can, but I don't care if you are the Prince..."
msgstr "Okej, jag ska ge dig vad jag kan, men jag bryr mig inte om du är prinsen..."

#. from yeager:scummvm
msgid "219"
msgstr "219"

#. from yeager:scummvm
msgid "...I'm not giving up my wardrobe spell or my enchanted aquarium!"
msgstr "...jag ger inte upp min garderobsförtrollning eller mitt förtrollade akvarium!"

#. from yeager:scummvm
msgid "The Prince?"
msgstr "Prinsen?"

#. from yeager:scummvm
msgid "220"
msgstr "220"

#. from yeager:scummvm
msgid "221"
msgstr "221"

#. from yeager:scummvm
msgid "Who's a Prince?"
msgstr "Vem är en prins?"

#. from yeager:scummvm
msgid "THEY DIDN'T TELL YOU!!??"
msgstr "DE BERÄTTADE INTE FÖR DIG!!??"

#. from yeager:scummvm
msgid "222"
msgstr "222"

#. from yeager:scummvm
msgid "I can't believe they would do this!"
msgstr "Jag kan inte tro att de skulle göra så här!"

#. from yeager:scummvm
msgid "223"
msgstr "223"

#. from yeager:scummvm
msgid "224"
msgstr "224"

#. from yeager:scummvm
msgid "Listen Brandon, we're in trouble."
msgstr "Lyssna Brandon, vi är i trubbel."

#. from yeager:scummvm
msgid "Go to the Enchanted Fountain..."
msgstr "Gå till den förtrollade fontänen..."

#. from yeager:scummvm
msgid "225"
msgstr "225"

#. from yeager:scummvm
msgid "226"
msgstr "226"

#. from yeager:scummvm
msgid "...and fill a flask for me."
msgstr "...och fyll en flaska åt mig."

#. from yeager:scummvm
msgid "227"
msgstr "227"

#. from yeager:scummvm
msgid "I'll get things set up for your potions."
msgstr "Jag ordnar med dina drycker."

#. from yeager:scummvm
msgid "228"
msgstr "228"

#. from yeager:scummvm
msgid "The fountain is ruined, and there is no water."
msgstr "Fontänen är förstörd och det finns inget vatten."

#. from yeager:scummvm
msgid "Malcolm was there."
msgstr "Malcolm var där."

#. from yeager:scummvm
msgid "229"
msgstr "229"

#. from yeager:scummvm
msgid "Let me explain, Brandon."
msgstr "Låt mig förklara, Brandon."

#. from yeager:scummvm
msgid "230"
msgstr "230"

#. from yeager:scummvm
msgid "231"
msgstr "231"

#. from yeager:scummvm
msgid "Without magic water, none of my potions are possible."
msgstr "Utan magiskt vatten är ingen av mina drycker möjliga."

#. from yeager:scummvm
msgid "232"
msgstr "232"

#. from yeager:scummvm
msgid "This cauldron can mix up potions that when combined will give the ability to fly to the castle."
msgstr "Denna kittel kan blanda till drycker som när de kombineras ger förmågan att flyga till slottet."

#. from yeager:scummvm
msgid "233"
msgstr "233"

#. from yeager:scummvm
msgid "But you need the water, right?"
msgstr "Men du behöver vattnet, eller hur?"

#. from yeager:scummvm
msgid "234"
msgstr "234"

#. from yeager:scummvm
msgid "I'll find some."
msgstr "Jag ska hitta några."

#. from yeager:scummvm
msgid "Maybe some splashed out..."
msgstr "Kanske några stänkte ut..."

#. from yeager:scummvm
msgid "235"
msgstr "235"

#. from yeager:scummvm
msgid "...or I can wring some out of the moss."
msgstr "...eller så kan jag vrida lite ur mossan."

#. from yeager:scummvm
msgid "236"
msgstr "236"

#. from yeager:scummvm
msgid "237"
msgstr "237"

#. from yeager:scummvm
msgid "Now what's this about a Prince?"
msgstr "Vad är det här om en prins?"

#. from yeager:scummvm
msgid "238"
msgstr "238"

#. from yeager:scummvm
msgid "Bring the magic water from the fountain first..."
msgstr "Hämta det magiska vattnet från fontänen först..."

#. from yeager:scummvm
msgid "239"
msgstr "239"

#. from yeager:scummvm
msgid "...and then we'll talk."
msgstr "...och sen kan vi prata."

#. from yeager:scummvm
msgid "Thanks, Brandon..."
msgstr "Tack, Brandon..."

#. from yeager:scummvm
msgid "240"
msgstr "240"

#. from yeager:scummvm
msgid "241"
msgstr "241"

#. from yeager:scummvm
msgid "You are a Prince."
msgstr "Du är en prins."

#. from yeager:scummvm
msgid "THE Prince actually."
msgstr "THE Prince faktiskt."

#. from yeager:scummvm
msgid "242"
msgstr "242"

#. from yeager:scummvm
msgid "Your parents were King William and Queen Katherine..."
msgstr "Dina föräldrar var kung William och drottning Katherine..."

#. from yeager:scummvm
msgid "243"
msgstr "243"

#. from yeager:scummvm
msgid "244"
msgstr "244"

#. from yeager:scummvm
msgid "Did you know Malcolm murdered them and seized the Kyragem?"
msgstr "Visste du att Malcolm mördade dem och beslagtog Kyragem?"

#. from yeager:scummvm
msgid "We had him locked in the castle.  But now he's loose."
msgstr "Vi hade honom inlåst i slottet.  Men nu är han lös."

#. from yeager:scummvm
msgid "245"
msgstr "245"

#. from yeager:scummvm
msgid "Malcolm!"
msgstr "Malcolm!"

#. from yeager:scummvm
msgid "246"
msgstr "246"

#. from yeager:scummvm
msgid "That old jester?"
msgstr "Den gamle gycklaren?"

#. from yeager:scummvm
msgid "247"
msgstr "247"

#. from yeager:scummvm
msgid "248"
msgstr "248"

#. from yeager:scummvm
msgid "If I free the gem, can I get revenge?"
msgstr "Om jag befriar ädelstenen, kan jag då hämnas?"

#. from yeager:scummvm
msgid "249"
msgstr "249"

#. from yeager:scummvm
msgid "Will it give me powers?"
msgstr "Kommer det att ge mig krafter?"

#. from yeager:scummvm
msgid "250"
msgstr "250"

#. from yeager:scummvm
msgid "It will be difficult."
msgstr "Det blir svårt."

#. from yeager:scummvm
msgid "251"
msgstr "251"

#. from yeager:scummvm
msgid "I'm sure the vestments have been lost."
msgstr "Jag är säker på att kläderna har försvunnit."

#. from yeager:scummvm
msgid "Malcolm probably wears the crown."
msgstr "Malcolm bär förmodligen kronan."

#. from yeager:scummvm
msgid "252"
msgstr "252"

#. from yeager:scummvm
msgid "253"
msgstr "253"

#. from yeager:scummvm
msgid "You'll need luck, if nothing else."
msgstr "Du kommer att behöva tur, om inte annat."

#. from yeager:scummvm
msgid "254"
msgstr "254"

#. from yeager:scummvm
msgid "Are you Mystics powerless?"
msgstr "Är ni mystiker maktlösa?"

#. from yeager:scummvm
msgid "255"
msgstr "255"

#. from yeager:scummvm
msgid "Can't you free the Kyragem?"
msgstr "Kan du inte befria Kyragem?"

#. from yeager:scummvm
msgid "256"
msgstr "256"

#. from yeager:scummvm
msgid "Only you can do it now."
msgstr "Det är bara du som kan göra det nu."

#. from yeager:scummvm
msgid "The pact requires royal blood."
msgstr "Pakten kräver kungligt blod."

#. from yeager:scummvm
msgid "257"
msgstr "257"

#. from yeager:scummvm
msgid "258"
msgstr "258"

#. from yeager:scummvm
msgid "What should I do?"
msgstr "Vad ska jag göra?"

#. from yeager:scummvm
msgid "Let's mix a potion."
msgstr "Låt oss blanda en dryck."

#. from yeager:scummvm
msgid "259"
msgstr "259"

#. from yeager:scummvm
msgid "260"
msgstr "260"

#. from yeager:scummvm
msgid "Go get some blueberries."
msgstr "Gå och plocka blåbär."

#. from yeager:scummvm
msgid "261"
msgstr "261"

#. from yeager:scummvm
msgid "CARPET.WSA"
msgstr "CARPET.WSA"

#. from yeager:scummvm
msgid "262"
msgstr "262"

#. from yeager:scummvm
msgid "It looks thick, like blue syrup."
msgstr "Det ser tjockt ut, som blå sirap."

#. from yeager:scummvm
msgid "263"
msgstr "263"

#. from yeager:scummvm
msgid "This one looks dangerous."
msgstr "Den här ser farlig ut."

#. from yeager:scummvm
msgid "264"
msgstr "264"

#. from yeager:scummvm
msgid "A beautiful color, but what is it?"
msgstr "En vacker färg, men vad är det?"

#. from yeager:scummvm
msgid "265"
msgstr "265"

#. from yeager:scummvm
msgid "Why would I want her laundry water?"
msgstr "Varför skulle jag vilja ha hennes tvättvatten?"

#. from yeager:scummvm
msgid "The concoction seems to be only half-complete."
msgstr "Sammansättningen verkar bara vara halvfärdig."

#. from yeager:scummvm
msgid "266"
msgstr "266"

#. from yeager:scummvm
msgid "267"
msgstr "267"

#. from yeager:scummvm
msgid "It smells like a strange combination of herbs and spices."
msgstr "Det luktar som en konstig kombination av örter och kryddor."

#. from yeager:scummvm
msgid "This flask is already filled."
msgstr "Denna kolv är redan fylld."

#. from yeager:scummvm
msgid "268"
msgstr "268"

#. from yeager:scummvm
msgid "269"
msgstr "269"

#. from yeager:scummvm
msgid "I only use the freshest ingredients!"
msgstr "Jag använder bara de färskaste ingredienserna!"

#. from yeager:scummvm
msgid "270"
msgstr "270"

#. from yeager:scummvm
msgid "Go get some fresh blueberries!"
msgstr "Gå och hämta färska blåbär!"

#. from yeager:scummvm
msgid "271"
msgstr "271"

#. from yeager:scummvm
msgid "This doesn't look like a blueberry!"
msgstr "Det här ser inte ut som ett blåbär!"

#. from yeager:scummvm
msgid "272"
msgstr "272"

#. from yeager:scummvm
msgid "Hey!"
msgstr "Hallå där!"

#. from yeager:scummvm
msgid "Rats. I wish I could find one of her cookbooks."
msgstr "Råttor. Jag önskar att jag kunde hitta en av hennes kokböcker."

#. from yeager:scummvm
msgid "273"
msgstr "273"

#. from yeager:scummvm
msgid "274"
msgstr "274"

#. from yeager:scummvm
msgid "Fetch the magic water."
msgstr "Hämta det magiska vattnet."

#. from yeager:scummvm
msgid "Then we'll worry about ingredients."
msgstr "Sedan får vi bekymra oss om ingredienserna."

#. from yeager:scummvm
msgid "275"
msgstr "275"

#. from yeager:scummvm
msgid "These blueberries are not freshly picked."
msgstr "Dessa blåbär är inte nyplockade."

#. from yeager:scummvm
msgid "276"
msgstr "276"

#. from yeager:scummvm
msgid "I need fresh blueberries!"
msgstr "Jag behöver färska blåbär!"

#. from yeager:scummvm
msgid "277"
msgstr "277"

#. from yeager:scummvm
msgid "This doesn't look like a blueberry"
msgstr "Det här ser inte ut som ett blåbär"

#. from yeager:scummvm
msgid "278"
msgstr "278"

#. from yeager:scummvm
msgid "Are you a donkey?"
msgstr "Är du en åsna?"

#. from yeager:scummvm
msgid "279"
msgstr "279"

