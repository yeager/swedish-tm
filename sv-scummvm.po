#. from yeager:scummvm
msgid "417"
msgstr "417"

#. from yeager:scummvm
msgid "I'd love to sit down..."
msgstr "Jag skulle gärna vilja sitta ner..."

#. from yeager:scummvm
msgid "418"
msgstr "418"

