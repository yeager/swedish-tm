msgstr "Den är skadad och kan inte sjunga."

#. from yeager:scummvm
msgid "I'm sorry to hear that."
msgstr "Det var tråkigt att höra."

#. from yeager:scummvm
msgid "404"
msgstr "404"

#. from yeager:scummvm
msgid "405"
msgstr "405"

#. from yeager:scummvm
msgid "But I still need a quill."
msgstr "Men jag behöver fortfarande en fjäderpennan."

#. from yeager:scummvm
msgid "406"
msgstr "406"

