msgid "If you would harvest, you must sow!"
msgstr "Om du vill skörda måste du så!"

#. from yeager:scummvm
msgid "Are these my new shoes?"
msgstr "Är det här mina nya skor?"

#. from yeager:scummvm
msgid "407"
msgstr "407"

#. from yeager:scummvm
msgid "408"
msgstr "408"

#. from yeager:scummvm
