#. from yeager:scummvm
msgid "415"
msgstr "415"

#. from yeager:scummvm
msgid "416"
msgstr "416"

#. from yeager:scummvm
msgid "Is that bird ALWAYS here?"
msgstr "Är den där fågeln ALLTID här?"

#. from yeager:scummvm
msgid "The oldest tree in Kyrandia"
