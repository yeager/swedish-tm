msgstr "*Skörda!"

#. from yeager:scummvm
msgid "410"
msgstr "410"

#. from yeager:scummvm
msgid "Can't you see I'm trying to rest?"
msgstr "Ser du inte att jag försöker vila?"

#. from yeager:scummvm
msgid "I tried to carve my name on this..."
msgstr "Jag försökte rista in mitt namn på den här..."

#. from yeager:scummvm
msgid "411"
msgstr "411"

#. from yeager:scummvm
msgid "412"
msgstr "412"

