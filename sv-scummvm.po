#. from yeager:scummvm
msgid "386"
msgstr "386"

#. from yeager:scummvm
msgid "*WHEEZE*"
msgstr "*WHEEZE*"

#. from yeager:scummvm
msgid "387"
msgstr "387"

#. from yeager:scummvm
