msgid "393"
msgstr "393"

#. from yeager:scummvm
msgid "394"
msgstr "394"

#. from yeager:scummvm
msgid "I need a quill, sir."
msgstr "Jag behöver en fjäderpenna, sir."

#. from yeager:scummvm
msgid "395"
msgstr "395"

#. from yeager:scummvm
msgid "Can you direct me?"
msgstr "Kan du vägleda mig?"

#. from yeager:scummvm
msgid "What for?"
msgstr "Vad är nytt?"

#. from yeager:scummvm
msgid "396"
msgstr "396"

#. from yeager:scummvm
msgid "397"
msgstr "397"

#. from yeager:scummvm
msgid "*ACKACKACK*"
msgstr "*ACKACKACK*"

#. from yeager:scummvm
msgid "Darm requests it."
msgstr "Darm begär det."

#. from yeager:scummvm
msgid "398"
msgstr "398"

#. from yeager:scummvm
msgid "399"
msgstr "399"

#. from yeager:scummvm
msgid "I am collecting magic to fight Malcolm."
msgstr "Jag samlar magi för att bekämpa Malcolm."

#. from yeager:scummvm
msgid "I know of Malcolm."
msgstr "Jag känner till Malcolm."

#. from yeager:scummvm
msgid "400"
msgstr "400"

