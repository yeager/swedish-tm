msgstr "Jag är upptagen."

#. from yeager:scummvm
msgid "388"
msgstr "388"

#. from yeager:scummvm
msgid "Go away."
msgstr "Gå iväg."

#. from yeager:scummvm
msgid "389"
msgstr "389"

#. from yeager:scummvm
msgid "390"
msgstr "390"

#. from yeager:scummvm
msgid "Go pester the Mystic."
msgstr "Gå och reta upp mystikern."

#. from yeager:scummvm
msgid "Enlighten Darm with your presence, not me."
msgstr "Upplys Darm med din närvaro, inte med min."

#. from yeager:scummvm
msgid "391"
msgstr "391"

#. from yeager:scummvm
msgid "392"
msgstr "392"

