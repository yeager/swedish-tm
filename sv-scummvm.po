msgstr "meddelande - \"Du ombeds vänligen att inte kasta tunga eller vassa föremål i riktning mot fången, inte heller spotta eller kittla honom.\"+\"Att utnyttja en fånges hjälplöshet, till exempel genom att råna honom eller tortera honom överdrivet, kan eventuellt bestraffas med böter. En gång.\""

#. from yeager:scummvm
msgid "alejka - Widzę dom z godłem barda nad drzwiami."
msgstr "gränd - Jag ser ett hus med bardens emblem ovanför dörren."

#. from yeager:scummvm
msgid "drzwi do magazynu - Zamknięte. Zresztą i tak dobrze pilnuje|ich ten gruby kupiec."
msgstr "dörren till lagerlokalen - stängd. Väl bevakad av den fete köpmannen i alla fall."

#. from yeager:scummvm
msgid "tobołek - Pokaźny ładunek, ale kupcy tak się|zafascynowali grą, że zapomnieli go|nawet rozładować."
msgstr "bundle - En ansenlig last, men köpmännen blev så upptagna av spelet att de glömde att ens lasta av den."

#. from yeager:scummvm
msgid "kram - Wygląda to jak zbiór pamiątek|z dalekich podróży."
msgstr "stall - Det ser ut som en samling souvenirer från avlägsna resor."

#. from yeager:scummvm
msgid "niski kupiec - No, to Pinokio nam wydoroślał."
msgstr "lowly merchant - Ja, då har Pinocchio vuxit upp för oss."

#. from yeager:scummvm
msgid "wysoki kupiec - Szlachetna twarz, ale w oczach widać|obłęd i żądzę gry."
msgstr "lång köpman - Ädelt ansikte, men man kan se galenskapen och lusten för spelet i ögonen."

#. from yeager:scummvm
msgid "gruby kupiec - Wagą, postawą i spojrzeniem wygląda|na kupieckiego przywódcę."
msgstr "fet köpman - Med sin vikt, hållning och blick ser han ut som en köpmansledare."

#. from yeager:scummvm
msgid "kupiec - Ależ dziwny typ urody! Pewnie dotarł do|nas z dalekiego południa."
msgstr "köpman - Vilken märklig typ av skönhet! Han måste ha kommit till oss från långt söderut."

#. from yeager:scummvm
msgid "kości do gry - Zwykłe kości do gry."
msgstr "tärningar - Vanliga tärningar."

#. from yeager:scummvm
msgid "woalka - To chyba woalka trucicielki...+Widocznie to znana tutaj kobieta.+Wiadomo, że najłatwiej liść schować|w lesie..."
msgstr "voile - Jag tror att det är giftmördarens voile...+Tydligen är det en välkänd kvinna här.+Det är känt att det enklaste bladet att gömma sig i skogen...."

#. from yeager:scummvm
msgid "tabliczka - \"Zamknięte. Badania naukowe.\""
msgstr "plakat - \"Stängt. Forskning.\""

#. from yeager:scummvm
msgid "wyjście - Wyjście z miasteczka."
msgstr "exit - Att lämna staden."

#. from yeager:scummvm
msgid "wyjście - Wyjście na świeże powietrze."
msgstr "exit - Att komma ut i friska luften."

#. from yeager:scummvm
msgid "ogłoszenie - \"Nie obsługujemy na kredyt. Nie przyjmujemy|w zastaw żon, psów ani dzieci. Złote|i srebrne przedmioty mile widziane.\""
msgstr "annons - \"Vi tjänar inte på kredit. Vi tar inte emot fruar, hundar eller barn som pant. Guld- och silverföremål är välkomna.\""

#. from yeager:scummvm
msgid "zakonnik - Albo miał nieszczęśliwy wypadek u golibrody,|albo zbyt mocno nachylił się nad ogniskiem."
msgstr "friar - Antingen råkade han ut för en olycklig olycka hos rakapparaten eller så lutade han sig för hårt över elden."

#. from yeager:scummvm
msgid "krasnolud - Całkiem spory, jak na krasnoluda.*+Ba, całkiem spory jak na człowieka."
msgstr "dvärg - Ganska stor för en dvärg *+Ba, ganska stor för en människa."

#. from yeager:scummvm
msgid "Arivald - No, nareszcie będziemy mogli dłużej|porozmawiać!"
msgstr "Arivald - Äntligen kan vi prata längre!"

#. from yeager:scummvm
msgid "Arivald - Mój ukochany przyjaciel, moja ostoja|w trudnych czasach i nieskażone|źródło czystej mądrości."
msgstr "Arivald - Min älskade vän, min tillflykt i svåra tider och en oförfalskad källa till ren visdom."

#. from yeager:scummvm
msgid "ognisko - Cieplutki, przyjemny ogień."
msgstr "lägereld - En varm, trevlig eld."

#. from yeager:scummvm
msgid "skrzynka - Skoro stoi na widoku publicznym, to|chyba jest pusta. A pieniądze pewnie|w skarpecie."
msgstr "lådan - Eftersom den är synlig för allmänheten är den förmodligen tom. Och pengarna ligger antagligen i en strumpa."

#. from yeager:scummvm
msgid "karczmarz - Prawidłowo rozwinięty mięsień piwny..."
msgstr "värdinnan - En välutvecklad ölmuskel...."

#. from yeager:scummvm
msgid "beka piwa - Uchh... Imponująca..."
msgstr "ölkagge - Uchh... Imponerande..."

#. from yeager:scummvm
msgid "drzwi - Zapachy stamtąd docierające zniechęciłyby|nawet najbardziej zdesperowanego złodzieja."
msgstr "dörr - Lukten som kommer därifrån skulle avskräcka även den mest desperata tjuven."

#. from yeager:scummvm
msgid "bard - Zakola jak królewski dziedziniec, nos jak|pazur smoka, obślinione usta i czarny wąsik.+Teoretycznie wszystko jest przeciwko niemu,|ale coś mi mówi, że widoczna w jego oczach|pasja zaimponowała niejednej kobiecie..."
msgstr "bard - Kurvor som en kunglig gård, näsa som en drakklo, plutande läppar och en svart mustasch.+Teoretiskt sett är allt emot honom, men något säger mig att passionen som syns i hans ögon har imponerat på många kvinnor...."

#. from yeager:scummvm
msgid "plakat - \"Kto odnajdzie moją jedyną i ukochaną córkę|Shandrię otrzyma tyle złota, ile potrafi|unieść. Nie będę zmuszał do małżeństwa\".+\"...Zaginęła roku Kozła, zimą, i do dziś los|jest jej nieznany. Pogrążony w smutku, król|Badurrae, Rawet\".+Jest jeszcze portret, ale już mało wyraźny.|Ten plakat wisi tu chyba ładnych parę lat..."
msgstr "affisch - \"Den som hittar min enda och älskade dotter Shandria kommer att få så mycket guld som hon kan bära. Jag kommer inte att tvinga henne till äktenskap\".+\"...Hon försvann under getens år, på vintern, och än i dag är hennes öde okänt. Den sorgsne kungen av Badurrae, Rawet\".+Det finns fortfarande ett porträtt, men det är inte särskilt tydligt längre.+Den här affischen hänger här i förmodligen ett par fina år...."

#. from yeager:scummvm
msgid "butelki - Butelki trochę brudne, ale zawartość|chyba... hm...  czysta."
msgstr "flaskor - Flaskor lite smutsiga, men innehållet tror jag.... ...um...  ren."

#. from yeager:scummvm
msgid "rulonik - To może być coś fascynującego albo|...kompromitującego..."
msgstr "roll - Detta kan vara något fascinerande eller ... komprometterande...."

#. from yeager:scummvm
msgid "linka - Pasek dla ubogich."
msgstr "länk - Fattigmansbälte."

#. from yeager:scummvm
msgid "kufel - Iście krasnoludzki rozmach."
msgstr "pint - Ett verkligt dvärgiskt momentum."

#. from yeager:scummvm
msgid "nieznajoma - Bardzo tajemnicza osóbka..."
msgstr "främling - En mycket mystisk person...."

#. from yeager:scummvm
msgid "drzwi - Z powrotem do rynku."
msgstr "dörr - Tillbaka till marknaden."

#. from yeager:scummvm
msgid "alchemik - Palce pożółkłe od kwasów, oczy oślepłe|od czytania ksiąg - oto prawdziwy|fachowiec!"
msgstr "alkemist - Fingrar gulnade av syror, ögon blinda av att läsa böcker - det är ett riktigt proffs!"

#. from yeager:scummvm
msgid "księga - Zapewne zbiór alchemicznych przepisów."
msgstr "bok - Förmodligen en samling alkemiska recept."

#. from yeager:scummvm
msgid "dziwne stworzenie - Wygląda jak mały człowieczek, ale|jest w nim coś magicznego..."
msgstr "en konstig varelse - Den ser ut som en liten man, men det är något magiskt med den...."

#. from yeager:scummvm
msgid "homunkulus - Biedaczysko... Jak wielu z nas, widzi|tylko część problemu, i dlatego nie|potrafi znaleźć rozwiązania."
msgstr "homunkulus - Fattig ... Som många av oss ser han bara en del av problemet och kan därför inte hitta en lösning."

#. from yeager:scummvm
msgid "jaszczur - Przyszły obiad czy obiekt eksperymentów?|A może ukochana maskotka?"
msgstr "ödla - framtida middag eller experimentobjekt? Eller kanske en älskad maskot?"

#. from yeager:scummvm
msgid "półka - Mnóstwo różnych preparatów i ksiąg."
msgstr "hylla - Massor av olika preparat och böcker."

#. from yeager:scummvm
msgid "krzesło - Im dłużej się w nie wpatruję tym bardziej|uświadczam się w przekonaniu, iż jest to|krzesło."
msgstr "stol - Ju längre jag stirrar på den desto mer övertygad blir jag om att det är en stol."

#. from yeager:scummvm
msgid "księga - \"Transmutacja - nowa moda czy realna szansa?\""
msgstr "bok - \"Transmutation - ny modefluga eller verklig möjlighet?\""

#. from yeager:scummvm
msgid "pergaminy - Rozmaite notatki alchemika, mnóstwo|akademickiego żargonu."
msgstr "pergament - Olika alkemistanteckningar, mycket akademisk jargong."

#. from yeager:scummvm
msgid "rozmaite tajemnicze urządzenia - Albo to jest jakiś naukowy eksperyment,|albo mamy do czynienia z klasyczną|nalewką z ziemniaków."
msgstr "en mängd mystiska anordningar - Antingen är detta något slags vetenskapligt experiment, eller så har vi att göra med en klassisk potatissoppa."

#. from yeager:scummvm
msgid "zegar - Być może jest to magiczny chronometr|odmierzający czas do końca świata.+A może po prostu ktoś oddał zegar do|reperacji."
msgstr "klocka - Kanske är det en magisk kronometer som mäter tiden fram till världens undergång, eller så har någon bara gett bort klockan för att den ska restaureras."

#. from yeager:scummvm
msgid "wyjście - Powrót z alejki na obrzeża rynku."
msgstr "exit - Återvänd från gränden till kanten av marknaden."

#. from yeager:scummvm
msgid "wyjście - Z powrotem między kupieckie stragany."
msgstr "utgång - Tillbaka bland handelsbodarna."

#. from yeager:scummvm
msgid "drzwi - Drzwi do mieszkania barda."
msgstr "dörr - Dörren till bardens lägenhet."

#. from yeager:scummvm
msgid "znak - Albo bard jest bardzo poważany w tym mieście,|albo uważa, że trochę autoreklamy nigdy nie|zaszkodzi."
msgstr "sign - Antingen är barden mycket respekterad i den här staden, eller så tycker han att lite självreklam aldrig skadar."

#. from yeager:scummvm
msgid "balkon - Bardzo romantyczne miejsce...+Księżycowa noc, smutna melodia fletu|unosząca się pod niebiosa...*+Tylko ta wyprana bielizna trochę|psuje wrażenie."
msgstr "balkong - En mycket romantisk plats...+Månskensnatten, flöjtens sorgsna melodi som svävar upp mot himlen...*+Endast de urtvättade underkläderna förstör intrycket lite."

#. from yeager:scummvm
msgid "stary wóz - Kompletna ruina."
msgstr "gammal vagn - En fullständig ruin."

#. from yeager:scummvm
msgid "kot - Typowy piecuch."
msgstr "katt - Typisk kaminrör."

#. from yeager:scummvm
msgid "słowik - Ludzie prości nazwą to stworzenie słowikiem,|ludzie znający związki przyczynowo-skutkowe|powiedzą, iż to koci obiad."
msgstr "nightingale - Enkla människor kallar denna varelse för en näktergal, människor som är bekanta med orsak och verkan säger att det är en katts middag."

#. from yeager:scummvm
msgid "rupiecie - Różne starocie, nowością wyróżnia się|tylko lutnia."
msgstr "rupees - Diverse antikviteter, det enda nya som sticker ut är lutan."

#. from yeager:scummvm
msgid "szlafmyca - Że też musiała utkwić akurat w takim|miejscu!"
msgstr "att den var tvungen att sitta fast på ett sådant ställe!"

#. from yeager:scummvm
msgid "szlafmyca - Że też dorośli ludzie noszą takie|rzeczy na głowie!..."
msgstr "badrock - Att vuxna människor har sådana saker på huvudet!...."

#. from yeager:scummvm
msgid "kobieta - Zastanawiam się ile musieliby mi zapłacić,|żebym zechciał...+Nie, nie, nie... to zbyt obrzydliwe."
msgstr "kvinna - Jag undrar hur mycket de skulle behöva betala mig för att vilja ...+Nej, nej, nej.... det är för äckligt."

#. from yeager:scummvm
msgid "zamek - Klasyka. Tak mały, że znalezienie go|graniczyło z cudem."
msgstr "slottet - En klassiker. Så litet att det gränsade till ett mirakel att hitta det."

#. from yeager:scummvm
msgid "słowik - Biedny ptak..."
msgstr "näktergal - Stackars fågel..."

#. from yeager:scummvm
msgid "klatka - Co za okrucieństwo i brak gustu!"
msgstr "cage - Vilken grymhet och brist på smak!"

#. from yeager:scummvm
msgid "flakonik - Flakonik z dziwnym płynem."
msgstr "flacon - Flacon med en konstig vätska."

#. from yeager:scummvm
msgid "wyjście - Schodki w dół."
msgstr "utgång - Steg ner."

#. from yeager:scummvm
msgid "wyjście na balkon - Wolę nie kręcić się w pobliżu|gaci barda."
msgstr "går ut på balkongen - jag föredrar att inte umgås med barden."

#. from yeager:scummvm
msgid "stół - Rękopisy, pióro, tusz i butelka wina.+Wszystko, czego artysta potrzebuje do|tworzenia.*+Może jednak za mało wina."
msgstr "bord - Manuskript, penna, bläck och en flaska vin.+Allt en konstnär behöver för att skapa.*+Möjligen inte tillräckligt med vin dock."

#. from yeager:scummvm
msgid "miotła - Na pewno środek lokomocji żony barda."
msgstr "kvast - Säkert bardens hustrus sätt att förflytta sig."

#. from yeager:scummvm
msgid "lustro - Całe brudne i porysowane. Nic dziwnego, że|żona barda wygląda jak wygląda..."
msgstr "spegel - Alldeles smutsig och repig. Inte undra på att bardens fru ser ut som hon gör...."

#. from yeager:scummvm
msgid "wyjście - Wyjście na drogę."
msgstr "exit - Utgång till vägen."

#. from yeager:scummvm
msgid "przejście - Widać kręte, wąskie schody w dół."
msgstr "passage - En slingrande, smal trappa nedåt kan ses."

#. from yeager:scummvm
msgid "wyjście - Powrót na górę."
msgstr "exit - Tillbaka till toppen."

#. from yeager:scummvm
msgid "sztandar - Jeden w wielu przedmiotów w tym miejscu,|który wygląda jak nowy, ale czuć od|niego dziwną starość..."
msgstr "banner - En av de många föremålen på denna plats,som ser ny ut, men känns konstigt gammal...."

#. from yeager:scummvm
msgid "okno - O, widać stąd miasteczko..."
msgstr "fönster - Åh, du kan se staden härifrån...."

#. from yeager:scummvm
msgid "dziwne znaki - Nie mam pojęcia, co ten napis oznacza."
msgstr "märkliga tecken - jag har ingen aning om vad denna skrift betyder."

#. from yeager:scummvm
msgid "runy - Hmmm... Ciekawe, czy to jakiś rodzaj zaklęcia."
msgstr "runor - Hmmm... Jag undrar om det är någon form av besvärjelse."

#. from yeager:scummvm
msgid "runy - Wiem, co to znaczy, ale nie chcę mówić na głos,|bo się znowu pojawi duch bóstwa i mogą być|kłopoty."
msgstr "runor - Jag vet vad det betyder, men jag vill inte säga det högt, för då kommer gudomens ande att dyka upp igen och det kan bli problem."

#. from yeager:scummvm
msgid "ołtarz - Przypomina tron jakiegoś wyjątkowo|wojowniczo usposobionego króla."
msgstr "altare - Påminner om tronen hos någon exceptionellt krigisk kung."

#. from yeager:scummvm
msgid "wyjście - Ścieżka do miasteczka."
msgstr "exit - Väg till kommunen."

#. from yeager:scummvm
msgid "przetarta lina - Budynek i okolica są wyraźnie niedoinwestowane."
msgstr "rubbat rep - Byggnaden och dess omgivningar är klart underinvesterade."

#. from yeager:scummvm
msgid "ptaszysko - Nie wiem, co to za ptak, ale ma|cztery jaja."
msgstr "fågel - jag vet inte vad det är för fågel, men den har fyra ägg."

#. from yeager:scummvm
msgid "strażnik - Albo hodował wąsy przez dwadzieścia|lat, albo podkleił pod nosem zdechłą|wiewiórkę.+Tak czy inaczej, robi wrażenie."
msgstr "guard - Antingen har han odlat mustasch i tjugo år, eller så har han stoppat en död ekorre under näsan.+ Hur som helst är han imponerande."

#. from yeager:scummvm
msgid "godło zamku - G... Zapewne od \"Garrahan\".*+Nie ma to jak umiejętność wyciągania|prawidłowych wniosków."
msgstr "slottets emblem - G... Troligen från \"Garrahan\" *+ Det finns inget som är bättre än att kunna dra korrekta slutsatser."

#. from yeager:scummvm
msgid "brama zamkowa - Prowadzi wprost na zamkowy dziedziniec."
msgstr "slottsport - Leder direkt in på slottets borggård."

#. from yeager:scummvm
msgid "wyjście - Widać schody w dół na dziedziniec zamkowy."
msgstr "exit - Du kan se trappan ner till slottets innergård."

#. from yeager:scummvm
msgid "sztandar - Ponoć są już kraje, gdzie|taki orzeł ma koronę."
msgstr "banderoll - Det sägs att det redan finns länder där örnen har en krona."

#. from yeager:scummvm
msgid "zbroja - W środku ciemno i duszno, ale za to|ni miecz, ni kop w klejnoty nie|straszny."
msgstr "rustning - mörk och instängd inuti, men varken svärd eller spark i juvelerna."

#. from yeager:scummvm
msgid "drzwi - Wyglądają zwyczajnie. Pewnie są od jakiejś|zwyczajnej komnaty."
msgstr "dörr - De ser vanliga ut. De kommer förmodligen från någon vanlig kammare."

#. from yeager:scummvm
msgid "drzwi - Drzwi do jaskini smoka."
msgstr "dörr - Dörren till drakens grotta."

#. from yeager:scummvm
msgid "zbroja - Taka zbroja to jest bardzo fajna rzecz.+Jak się człowiek wywróci, od razu służy|za trumnę."
msgstr "rustning - Den här typen av rustning är en mycket cool sak.+När en person faller omkull serverar de omedelbart en kista."

#. from yeager:scummvm
msgid "zamek - Kolejny zamek do zdobycia."
msgstr "slott - Ännu ett slott att erövra."

#. from yeager:scummvm
msgid "drzwi do skarbca - Impregnowane drewno wzmocnione żelaznymi|ćwiekami.+Nie do wyważenia. Nawet dla niedźwiedzia."
msgstr "valvdörr - Impregnerat trä förstärkt med järnpinnar + Okrossbar. Till och med för en björn."

#. from yeager:scummvm
msgid "wejście do skarbca - Droga do szczęścia stoi otworem."
msgstr "ingången till valvet - vägen till lycka står öppen."

#. from yeager:scummvm
msgid "wyjście - Przejście z dziedzińca na podzamcze."
msgstr "utgång - Passage från borggården till borggården."

#. from yeager:scummvm
msgid "drzwi - Nie mam pojęcia, co się za nimi kryje."
msgstr "dörr - jag har ingen aning om vad som döljer sig bakom dem."

#. from yeager:scummvm
msgid "drzwi - Sądząc po znaku, prowadzą do skarbca."
msgstr "dörr - Av skylten att döma leder den till valvet."

#. from yeager:scummvm
msgid "tarcza - Drewniana... Hm... Pewnie niewiele|z niej było pożytku."
msgstr "sköld - Trä... Hm... Det fanns nog inte mycket användning för den."

#. from yeager:scummvm
msgid "drzwi - Droga do króla."
msgstr "dörr - Vägen till kungen."

#. from yeager:scummvm
msgid "drzwi - Jedyne, które nie mają klamki.+Nic dziwnego, skoro kryją drogę|do skarbca."
msgstr "dörren - Den enda som inte har något handtag + Inte så konstigt, eftersom den döljer vägen till valvet."

#. from yeager:scummvm
msgid "łańcuch - Arivald oddał mi niedźwiedzią przysługę|skuwając mnie tak mocnym łańcuchem."
msgstr "kedja - Arivald gjorde mig en björntjänst genom att ge mig en så stark kedja."

#. from yeager:scummvm
msgid "zerwany łańcuch - Trochę nadszarpnięty, ale coś tam|jeszcze z niego zostało."
msgstr "broken chain - Lite ansträngande, men det finns fortfarande något kvar av den."

#. from yeager:scummvm
msgid "skrzynia z ciuchami - Z daleka niespecjalnie dokładnie widać,|a póki dziewczę zajęte jest sobą,|lepiej zostanę na miejscu."
msgstr "en låda med kläder - Man ser inte mycket på avstånd, och så länge flickan är upptagen med sig själv är det bäst att jag stannar här."

#. from yeager:scummvm
msgid "okno - Nie chcę podchodzić, lepiej, żeby|dziewczę pozostało skupione na sobie."
msgstr "fönster - Jag vill inte närma mig, det är bättre för flickan att hålla fokus."

#. from yeager:scummvm
msgid "złota klatka - Lepiej nie będę oglądał tej klatki|z bliska, bo jeszcze dziewczę zechce|mi się dokładniej przyjrzeć...+Zresztą, klatka i tak jest pusta."
msgstr "en gyllene bur - det är bäst att jag inte tittar närmare på den här buren, för då vill flickan titta närmare...+Buren är ändå tom."

#. from yeager:scummvm
msgid "lustro - Że też jeszcze nie pękło..."
msgstr "spegel - Att den inte har gått sönder ännu heller...."

#. from yeager:scummvm
msgid "portret - Młody, przystojny, podobny do szympansa."
msgstr "porträtt - Ung, stilig, liknar en schimpans."

#. from yeager:scummvm
msgid "brzydka dziewczyna - Ponoć był taki podróżnik, który brał na|długie wyprawy najbrzydszą dziewczynę|w okolicy.+Kiedy po miesiącach pobytu na pustkowiu|dziewczyna zaczynała mu się podobać|wiedział, że czas wracać do ludzi.+Ale gdyby miał tę dziewczynę u boku...+...nigdy byśmy go już nie zobaczyli..."
msgstr "den fula flickan - Det sägs att det fanns en resenär som tog med sig den fulaste flickan i området på långa expeditioner.+När han efter månader i vildmarken började tycka om flickan visste han att det var dags att återvända till folket.+Men om han hade haft flickan vid sin sida...skulle vi aldrig ha sett honom igen...."

#. from yeager:scummvm
msgid "Sheila - Ponoć był taki podróżnik, który brał na|długie wyprawy najbrzydszą dziewczynę|w okolicy.+Kiedy po miesiącach pobytu na pustkowiu|dziewczyna zaczynała mu się podobać|wiedział, że czas wracać do ludzi.+Ale gdyby miał Sheilę u boku...+...nigdy byśmy go już nie zobaczyli..."
msgstr "Sheila - Det sägs att det fanns en resenär som tog med sig den fulaste flickan i området på långa expeditioner.+När han efter månader i vildmarken började tycka om flickan visste han att det var dags att återvända till folket.+Men om han hade haft Sheila vid sin sida...skulle vi aldrig ha sett honom igen...."

#. from yeager:scummvm
msgid "wstążki - Lubię ozdoby, ale wstążki w łóżku to już|chyba lekka przesada."
msgstr "band - Jag gillar dekorationer, men band i sängen är lite överdrivet, tycker jag."

#. from yeager:scummvm
msgid "łoże - Jest tak obrzydliwie słodkodziewczęcoróżowe,|że chyba wolałbym spać na podłodze."
msgstr "sängen - Den är så sjukt rosa att jag hellre skulle sova på golvet."

#. from yeager:scummvm
msgid "skóra - U-hu. Chyba z niedźwiedzia..."
msgstr "hud - U-hu. Jag tror att det är från en björn..."

#. from yeager:scummvm
msgid "sekretera - Pfuj, same babskie rzeczy."
msgstr "secreter - Pfuj, alla kvinnogrejer."

#. from yeager:scummvm
msgid "wyjście - Droga do normalnego świata."
msgstr "exit - Vägen till en normal värld."

#. from yeager:scummvm
msgid "wyjście - Wyjście stąd jest, ale po co?"
msgstr "utgång - Det finns en utgång härifrån, men varför?"

#. from yeager:scummvm
msgid "tabliczka - Podręczna pomoc królewskiego rachmistrza."
msgstr "plakett - Ett praktiskt hjälpmedel för den kungliga räkningen."

#. from yeager:scummvm
msgid "skrzynia pełna skarbów - O mamo mamo mamo...+...Mamo...mamo...mamo...+...Mamo...mamo...mamo...*+Ad infinitum."
msgstr "en skattkista full av skatter - O mamo mamo mamo mamo...+...Mamo...Mamo...Mamo...Mamo...+...Mamo...Mamo...*+Ad infinitum."

#. from yeager:scummvm
msgid "lustro - Niestety, sama rama."
msgstr "spegel - Tyvärr är det själva ramen."

#. from yeager:scummvm
msgid "kobierzec - Szyty grubymi, złotymi nićmi."
msgstr "feminin - Sydd med tjocka guldtrådar."

#. from yeager:scummvm
msgid "miecze w beczce - Stłoczone jak śledzie, ale piękne,|zdobione rubinami na głowni miecze."
msgstr "svärd i tunna - Trångt som sillar, men vackert, och dekorerat med rubiner på svärdskallen."

#. from yeager:scummvm
msgid "tarcza - Model dziecięcy."
msgstr "urtavla - Barnmodell."

#. from yeager:scummvm
msgid "skrzynka - Gdybym ją oworzył, miałbym... miałbym...+...zmarnowany rok na liczenie dukatów."
msgstr "box - Om jag hade skapat den, skulle jag ha.... jag skulle ha...+...slösat bort ett år på att räkna dukater."

#. from yeager:scummvm
msgid "skrzynia pełna złota - O mamo...+Kupiłbym sobie za to...+O, mamo, czego ja bym sobie|za to NIE kupił?"
msgstr "en kista full av guld - Åh, mamma...+Jag skulle köpa mig något med den här...+Åh, mamma, vad skulle jag INTE köpa mig med den här?"

#. from yeager:scummvm
msgid "zbroja - Nie wiem, co to jest, ale zbroja|wykonana jest z ciemnoniebieskiej,|podobnej do kryształu materii."
msgstr "rustning - Jag vet inte vad det är, men rustningen är gjord av mörkblå, kristallliknande materia."

#. from yeager:scummvm
msgid "skrzynia - Śliczna, zgrabna skrzynka z eleganckim|wiekiem."
msgstr "box - En vacker, välformad låda med ett elegant lock."

#. from yeager:scummvm
msgid "księgi - Skoro znajdują się w takim miejscu, to pewnie|są wiele warte...+Może opowiadają o sztuce czarodziejskiej?+Albo są rodowymi pamiętnikami pełnymi|namiętności i zbrodni?*+No cóż, mogą też być zwykłe księgi|rachunkowe.+Albo spis mieszkańców królestwa.+Eee tam, na pewno nic ciekawego."
msgstr "böcker - Eftersom de finns på en plats som denna måste de vara värda en hel del...+De kanske handlar om trollkonst? +Eller är det familjedagböcker fulla av passioner och brott? +Nja, det kan också vara vanliga räkenskapsböcker. +Eller en förteckning över rikets invånare. +Eee där, säkert inget intressant."

#. from yeager:scummvm
msgid "zasłona - Chroni skarbiec przed wzrokiem ciekawskich|ptaków?..."
msgstr "slöja - Skyddar valvet från nyfikna fåglars blickar?...."

#. from yeager:scummvm
msgid "pusta skrzynka - W środku nie ma nic więcej."
msgstr "tom låda - Det finns inget annat inuti."

#. from yeager:scummvm
msgid "wyjście - Z powrotem na ścieżkę."
msgstr "exit - Tillbaka på rätt spår."

#. from yeager:scummvm
msgid "zamek - Dziwny ten zamek. Porozrzucany po|całej okolicy."
msgstr "slott - Konstigt slott. Spridda överallt."

#. from yeager:scummvm
msgid "brama zamkowa - Wejście w czeluście zamczyska..."
msgstr "slottsporten - Att ta sig in i slottets djup...."

#. from yeager:scummvm
msgid "posąg - Gdybym powiedział, że jest trochę|przerażający byłoby to za dużo.*+Za dużo o słowo \"trochę\"."
msgstr "staty - Om jag sa att det var lite skrämmande skulle det vara för mycket.*+ För mycket om ordet \"lite\"."

#. from yeager:scummvm
msgid "posąg - Może i wygląda jak wykuty z kamienia,|ale mój tyłek ma inne zdanie."
msgstr "staty - Det kan se ut som om den är huggen i sten, men min bakdel har en annan åsikt."

#. from yeager:scummvm
msgid "łuska - Nie mam pojęcia, czyja to łuska."
msgstr "skal - jag har ingen aning om vems skal det är."

#. from yeager:scummvm
msgid "brama zamkowa - Jedyna droga ucieczki..."
msgstr "slottsport - Det enda sättet att ta sig ut...."

#. from yeager:scummvm
msgid "drzwi - Wejście do wylęgarni potworów."
msgstr "dörr - Ingång till monsterkläckningsanläggningen."

#. from yeager:scummvm
msgid "przejście - Wąski most prowadzący do drugiej części zamczyska."
msgstr "passage - Smal bro som leder till den andra delen av slottet."

#. from yeager:scummvm
msgid "kościotrup - Jakiś śmiałek nie zdążył uciec..."
msgstr "bonehead - Någon våghals lyckades inte ta sig ut...."

#. from yeager:scummvm
msgid "wejście - Rzeźba przy wejściu mówi mi wszystko."
msgstr "entré - Skulpturen vid entrén berättar allt för mig."

#. from yeager:scummvm
msgid "brama zamkowa - Nadal sporo tu cienia."
msgstr "castle gate - Fortfarande gott om skugga här."

#. from yeager:scummvm
msgid "kościotrup - W słońcu wygląda równie przerażająco, co w mroku."
msgstr "skelett - Det ser lika skrämmande ut i solljuset som i mörkret."

#. from yeager:scummvm
msgid "wejście - Wejście do komnaty nekromanty."
msgstr "ingång - Ingång till nekromantikerns kammare."

#. from yeager:scummvm
msgid "klucz - Wszyscy w okolicy mają jakąś obsesję na punkcie|olbrzymich kluczy.+Jakaś rekompensata czy co?"
msgstr "nyckel - Alla i grannskapet har någon form av besatthet av|stora nycklar.+Någon form av kompensation eller vad?"

#. from yeager:scummvm
msgid "szafa - Mnóstwo pomocy naukowych nekromanty.+Zupełnie jak u alchemika, tylko trochę|bardziej podniszczone."
msgstr "garderob - Massor av studiehjälpmedel för nekromantiker + Som en alkemists, bara lite mer sjabbig."

#. from yeager:scummvm
msgid "kielich - Nie dość, że wino czerwone jak krew, to|jeszcze kielich zgnieciony potężną siłą.+Co tu się działo?!"
msgstr "kalken - Inte riktigt vinrött som blod, men en kalk som krossats av en mäktig kraft.+Vad hände här!"

#. from yeager:scummvm
msgid "pergamin - To chyba jakieś motto...+\"Jeśli zbyt długo patrzysz w otchłań,|otchłań zaczyna patrzeć w ciebie\"."
msgstr "pergament - Jag antar att det är någon form av motto...+\"Om du tittar ner i avgrunden för länge börjar avgrunden titta in i dig\"."

#. from yeager:scummvm
msgid "kartka - To pewnie jakaś ważna czarnoksięska uwaga,|albo zapis bluźnierczego czaru...+Nie, zaraz...+To jakaś lista...+\"Kupić mleko... Posprzątać po Zraleimchu....|Pomodlić się do potężnego Kecaja Arakeipa|jeszcze przed śniadaniem....\"+\"Załatwić dostawę bułeczek...\"+Och..."
msgstr "kort - Det är förmodligen någon viktig trolldomskommentar,+eller en uppteckning av en hädisk besvärjelse...+Nej, vänta...+Det är någon lista...+\"Köp mjölk.... Städa upp efter Zraleimch....|Ber till den mäktige Kecai Arakeip|före frukost.... \"+\"Få en leverans av bullar...\"+Oh...."

#. from yeager:scummvm
msgid "kartka - Kahem, nic ważnego."
msgstr "kort - Kahem, inget viktigt."

#. from yeager:scummvm
msgid "papiery - Pamiętnik nekromanty...*+Wynika z niego, że to właśnie on pomagał Księciu|Wampirów zabezpieczyć jakąś część zamku przed|wzrokiem śmiertelników...+Czyżby chodziło o wieczną noc na dziedzińcu?|Nie... O tym jest w innym miejscu pamiętnika:+\"...będzie tu panować noc tak ciemna, jak ciemne|są myśli tego, co potęgę swą znalazł w czeluściach|najgłębszych otchłani\".+Hmm, co za styl!+\"Nigdy parzące promienie słońca nie oświetlą tego|zamku, tak jak nigdy dusza mroczna nie zazna|świetlistej tortury, wolna od jasności, która by...\"+Ufff!+\"Pan Słońce (niech będzie przeklęte jego imię, niech|jego ciało spotka wieczna tortura wśród lodowych|pustkowi wiecznej nocy!) nie zagości nad zamkiem Fjord...\"+\"...który pozostanie wolny od plugawego dotyku światła|na wieki wieków i po wsze czasy. A oprócz tego...\"*+Hmmm... Niestety, brakuje ostatniej, najnowszej|strony."
msgstr "tidningar - En nekromantikers dagbok...*+Det verkar som om han var den som hjälpte vampyrprinsen att säkra någon del av slottet från de dödligas blickar...+Är det här om den eviga natten på borggården? Nej.... Det nämns på ett annat ställe i dagboken:+\"...det skall bli en natt lika mörk som tankarna hos den som fann sin kraft i de djupaste avgrunderna.\"+Hmm, vilken stil! +\"Aldrig skall solens brännande strålar lysa upp detta slott, lika lite som den mörka själen skall få uppleva den lysande tortyren, fri från den ljusstyrka som skulle....\"+Ufff!+\"Solens herre (må hans namn vara förbannat, må hans kropp möta evig tortyr mitt i den eviga nattens iskalla ödslighet!) skall inte regera över slottet Fjord...\"+\"...som skall förbli fritt från ljusets fula beröring för evigt och alltid. Och dessutom...\"*+Hmmm.... Tyvärr saknas den sista, senaste sidan."

#. from yeager:scummvm
msgid "papiery - Pamiętnik nekromanty...+Nic nowego się już z niego nie dowiem."
msgstr "tidningar - En nekromantikers dagbok...+Inget nytt att lära sig av den längre."

#. from yeager:scummvm
msgid "peleryna - Czerwona pelerynka...+Płachta na rogate demony?"
msgstr "mantel - Röd mantel...+Hornad demonmantel?"

#. from yeager:scummvm
msgid "stołek - Najwyraźniej przewrócony w trakcie jakiejś|brutalnej walki."
msgstr "pall - Tydligen omkullvält i samband med någon form av våldsam kamp."

#. from yeager:scummvm
msgid "świecznik - Cały czarny. Ani chybi atrybut nekromanty."
msgstr "ljusstake - Helt svart. Inte heller en nekromantikers attribut."

#. from yeager:scummvm
msgid "ślady pazurów - Za żadne skarby świata nie chciałbym stanąć oko|w oko z istotą posiadającą takie szpony."
msgstr "klomärken - jag skulle inte vilja stå öga mot öga med en varelse med sådana klor av någon anledning i världen."

#. from yeager:scummvm
msgid "pentagram - Przerażający znak. Wygląda na|niedokończony albo zatarty."
msgstr "pentagram - Ett skrämmande tecken. Ser oavslutat eller utplånat ut."

#. from yeager:scummvm
msgid "drzwi - To chyba ślady włamania. Chyba że komuś|się bardzo spieszyło..."
msgstr "dörr - Jag tror att det här är spår av ett inbrott. Såvida inte någon hade väldigt bråttom...."

#. from yeager:scummvm
msgid "ślady krwi - Mam dziwną pewność, że nie są to ślady|po rozlanym, czerwonym winie."
msgstr "spår av blod - jag är märkligt säker på att det inte är spår av utspillt rödvin."

#. from yeager:scummvm
msgid "kreda - Ta sama, którą wyrysowano pentagram."
msgstr "krita - Samma som användes för att rita pentagrammet."

#. from yeager:scummvm
msgid "wyjście - Drzwi stoją szeroko otworem.+Bardzo szeroko."
msgstr "utgång - Dörren står vidöppen.+Mycket vidöppen."

#. from yeager:scummvm
msgid "kominek - W środku są tylko zwęglone resztki."
msgstr "eldstad - Det finns bara förkolnade rester inuti."

#. from yeager:scummvm
msgid "pogrzebacz - Tu chyba nie potrzeba pogrzebacza, ale|pogrzebu..."
msgstr "poker - Här tror jag inte att du behöver en poker, men du behöver en poker...."

#. from yeager:scummvm
msgid "skrzynia - Stara lina, wyszczerbiony miecz, skrzynka|z dziurą...+Trofea?..."
msgstr "kista - gammalt rep, flisat svärd, låda med hål ... + Troféer? ...."

#. from yeager:scummvm
msgid "księga - \"Księga Szarej Magii\""
msgstr "bok - \"Boken om grå magi\""

#. from yeager:scummvm
msgid "talizman - To chyba talizman nekromanty. Mam wrażenie, że|nie przyniósł mu szczęścia..."
msgstr "talisman - Jag tror att det är nekromantikerns talisman. Jag har en känsla av att den inte gav honom tur...."

#. from yeager:scummvm
msgid "wyjście - Powrót do głównej części zamku."
msgstr "exit - Återgå till huvuddelen av slottet."

#. from yeager:scummvm
msgid "Książę Wampirów - W jego pobliżu boję się nawet mrugnąć, żeby|mnie nie usłyszał."
msgstr "Vampyrprinsen - När jag är nära honom vågar jag inte ens blinka, för då hör han mig."

#. from yeager:scummvm
msgid "trumna - Atłasowe wnętrze, okuta srebrem,|gustowna trupia czaszka...+Trumna de luxe.+Lepiej się nie zbliżać."
msgstr "kista - satininredning, silverlindad, rustik likskalle...+Kista de luxe.+Vill helst inte komma för nära."

#. from yeager:scummvm
msgid "trumna - Zaraz, coś tu w środku leży...|Jakaś kartka..."
msgstr "kista - Vänta lite, det finns något som ligger inuti... Någon form av kort...."

#. from yeager:scummvm
msgid "trumna - Teraz przynajmniej spełnia właściwą rolę."
msgstr "kista - Nu fyller den i alla fall sin funktion."

#. from yeager:scummvm
msgid "kamienna płyta - Wielka, kamienna płyta z jakimiś|dziwnymi wypustkami."
msgstr "stenplatta - En stor stenplatta med några märkliga utskjutande delar."

#. from yeager:scummvm
msgid "przepaść - Wydaje mi się, że nie dałbym rady spaść|żywy. W locie umarłbym z głodu."
msgstr "abyss - Jag tror inte att jag skulle ha kunnat falla ner levande. Jag skulle svälta ihjäl under flygningen."

#. from yeager:scummvm
msgid "Pan Słońce - Wygląda na znudzonego nawet jak śpi."
msgstr "Mr Sun - Han ser uttråkad ut även när han sover."

#. from yeager:scummvm
msgid "nałożnica - Eeech, ładna."
msgstr "barnmorskan - Eeech, sötnos."

#. from yeager:scummvm
msgid "nałożnica - Ech, jak już się to wszystko uspokoi..."
msgstr "barnmorskan - Eh, när allt har lugnat ner sig...."

#. from yeager:scummvm
msgid "wodospad - Panu Słońce pewnie się dobrze zasypia|przy jego delikatnym szumie."
msgstr "vattenfall - Mr Sun måste somna gott till dess mjuka surrande."

#. from yeager:scummvm
msgid "rzeczka - Ciekawe, dokąd uchodzi woda|z takiej wysokości..."
msgstr "flod - jag undrar vart vattnet rinner av från en sådan höjd...."

#. from yeager:scummvm
msgid "kosz z owocami - Kosz pełen słodkich, soczystych owoców."
msgstr "fruktkorg - En korg full av söt, saftig frukt."

#. from yeager:scummvm
msgid "instrukcja obsługi - Jakieś hieroglify."
msgstr "bruksanvisning - Några hieroglyfer."

#. from yeager:scummvm
msgid "wyjście - Powrót na ziemię."
msgstr "exit - Återvänd till jorden."

#. from yeager:scummvm
msgid "ścieżka - Piękna okolica..."
msgstr "väg - Vackra omgivningar ..."

#. from yeager:scummvm
msgid "bajoro - Dziwna, zielonkawa maź."
msgstr "byre - En märklig, grönaktig sörja."

#. from yeager:scummvm
msgid "uschłe drzewo - Zdaje się, że substancja w bajorze nie służy|tutejszej roślinności."
msgstr "vissnat träd - Det verkar som om ämnet i byre inte tjänar vegetationen här."

#. from yeager:scummvm
msgid "ptak - Jedyny świadek rozkładu dawnego|centrum intelektualnego.+A może ...strażnik?"
msgstr "fågel - Det enda vittnet till förfallet av det tidigare intellektuella centrumet.+ Och kanske ... väktare?"

#. from yeager:scummvm
msgid "księga - Wygląda na zupełnie nieruszoną zębem czasu|ni dziobem tego ptaszyska."
msgstr "bok - Det ser helt orört ut av tidens tand med näbben på denna fågel."

#. from yeager:scummvm
msgid "ścieżka - W oddali widać kilka uschniętych drzew."
msgstr "väg - Flera vissna träd kan ses på avstånd."

#. from yeager:scummvm
msgid "pożółkły pergamin - Czas i deszcz zrobiły swoje.+Widzę tylko pojedyncze znaki i nie mogę|zrozumieć treści."
msgstr "gulnat pergament - Tid och regn har gjort sitt +Jag kan bara se enstaka tecken och kan inte förstå innehållet."

#. from yeager:scummvm
msgid "strona z książki - Widzę tytuł jakiegoś rozdziału...+\"Ciepła posadka, czyli palenie czarownic\".*+Hm, ciekawe czy mieli tu też słynne dzieło:|\"Jak rzucić palenie czarownic w tydzień\"."
msgstr "en sida ur en bok - jag ser titeln på ett kapitel...+\"Varm post, eller häxbränning\".*+Hm, jag undrar om de också hade det berömda verket här:|\"Hur man slutar med häxbränning på en vecka\"."

#. from yeager:scummvm
msgid "resztki bramy - Mam nieodparte wrażenie, że przestała spełniać|swoją pierwotną rolę.+W przypadku tego gruzowiska pojęcie wyjścia|jest naprawdę szerokie."
msgstr "resterna av en grind - jag har det omisskännliga intrycket att den inte längre fyller sin ursprungliga funktion.+ När det gäller detta bråte är begreppet utgång verkligen brett."

#. from yeager:scummvm
msgid "stos kamieni - Kupa drobnych kamyczków. Dowód zwycięstwa|materii nad duchem."
msgstr "stenhög - En hög med små stenar. Bevis på materiens seger över anden."

#. from yeager:scummvm
msgid "księga - \"O skutecznym zdejmowaniu klątw\".+Och...+Lepiej wcale niż późno."
msgstr "bok - \"Om effektiv borttagning av förbannelser\".+Åh...+Företräcker inte alls än sent."

#. from yeager:scummvm
msgid "księga - \"Czwarty wymiar\".+Hmmm... Pewnie polityczna."
msgstr "bok - \"Den fjärde dimensionen\".+Hmmm.... Förmodligen politiskt."

#. from yeager:scummvm
msgid "księga - Wygląda zachęcająco."
msgstr "bok - Ser uppmuntrande ut."

#. from yeager:scummvm
msgid "Arivald - Mój chyba nieoceniony wybawca. On pewnie|nie ma co do tego wątpliwości."
msgstr "Arivald - min förmodligen ovärderliga räddare. Han har förmodligen ingen tvekan om det."

#. from yeager:scummvm
msgid "wejście - Ciemno jak w hebanowej rzyci."
msgstr "entré - Mörk som ebenholts."

#. from yeager:scummvm
msgid "łagodny stok - Widać drogę do miasteczka."
msgstr "svag sluttning - Man kan se vägen till staden."

#. from yeager:scummvm
msgid "kastet - Git."
msgstr "caster - Git."

#. from yeager:scummvm
msgid "dźwignia - Założę się, że to jakaś forma pułapki."
msgstr "hävstångseffekt - jag slår vad om att detta är någon form av fälla."

#. from yeager:scummvm
msgid "dźwignia - Odblokowana.+Niezła ze mnie złota rączka.+I to dosłownie."
msgstr "spak - olåst.+Jag är inte mycket till hantverkare.+Och det menar jag bokstavligen."

#. from yeager:scummvm
msgid "wyjście - Umpff...+Dlaczego nic w życiu, oprócz zdobywania|kobiet, nie przychodzi bez trudu?..."
msgstr "exit - Umpff...+Varför är ingenting i livet, förutom att få kvinnor, lätt? ...."

#. from yeager:scummvm
msgid "wyjście - Wolny! Nareszcie!"
msgstr "exit - Gratis! Äntligen!"

#. from yeager:scummvm
msgid "olbrzymi szkielet - O rany! Kiedy ten wojownik żył, to pewnie|przyjacielskim klapsem potrafił zabić trolla.+Ten miecz waży chyba więcej niż cały ja."
msgstr "ett jättelikt skelett - oj då! När den här krigaren levde kunde han förmodligen döda ett troll med en vänlig örfil.+ Det här svärdet väger förmodligen mer än hela jag."

#. from yeager:scummvm
msgid "tarcza - Dziwny herb: trójgłowy smok...+Chyba że to hydra mająca symbolizować|trwałość rodu."
msgstr "sköld - Märklig vapensköld: en trehövdad drake...+ Förmodligen en hydra som symboliserar familjens uthållighet."

#. from yeager:scummvm
msgid "wyjście - Cudowne, świeże powietrze bez siarki i dymu."
msgstr "utgång - Underbar, frisk luft utan svavel eller rök."

#. from yeager:scummvm
msgid "zbroja - Opakowanie po jedzeniu powinno się wyrzucać|do śmieci, a nie na ziemię!"
msgstr "armour - Livsmedelsförpackningar ska slängas i soporna, inte på marken!"

#. from yeager:scummvm
msgid "czaszka - Dla kogoś taki czerep to było kiedyś|być albo nie być..."
msgstr "skalle - För någon brukade en skalle som denna vara ett måste...."

#. from yeager:scummvm
msgid "żelazne obręcze - Niejedną parę przegubów już gościły."
msgstr "järnbågar - De har redan varit värd för mer än ett par leder."

#. from yeager:scummvm
msgid "smok - Stwierdzam bez przekąsu, że widziałem|dziewice brzydsze od niego."
msgstr "draken - jag påstår utan att överdriva att jag har sett tjejer som är fulare än honom."

#. from yeager:scummvm
msgid "dziewczyna - Łoł!...+Co my tu mamy...+Mocne, żelazne kajdany...+Piękna dziewczyna, całkowicie bezwolna.+Może by tak..."
msgstr "flicka - Whoa!...+Vad har vi här...+Mäktiga, järnbojor...+Vacker flicka, helt ofri.+Varför inte...."

#. from yeager:scummvm
msgid "dziewczyna - Smaczny kąsek!"
msgstr "flicka - En välsmakande bit!"

#. from yeager:scummvm
msgid "pajęczyna - Obrzydliwa, zaczarowana pajęczyna."
msgstr "spindelväv - Ett äckligt, förtrollat spindelväv."

#. from yeager:scummvm
msgid "skała - Wystający kawałek skały."
msgstr "rock - En utskjutande bit av sten."

#. from yeager:scummvm
msgid "droga - Szeroka i dobrze ubita, choć nierówna."
msgstr "väg - Bred och välkompakterad, men ojämn."

#. from yeager:scummvm
msgid "pomost - Stąd pewnie wypływały barki z mąką."
msgstr "piren - Det är härifrån mjölpråmarna måste ha seglat ut."

#. from yeager:scummvm
msgid "podnośnik - Niestety, już nieczynny, a lina ucięta.+Mam nadzieję, że nie ma to nic wspólnego|ze zbankrutowanym młynarzem."
msgstr "hiss - Tyvärr inte längre i bruk och repet har klippts av.+Jag hoppas att detta inte har något att göra med den konkursade mjölnaren."

#. from yeager:scummvm
msgid "beczka - Pusta jak kufel Arivalda po półtorej|sekundy."
msgstr "keg - Tomt som en pint Arivald efter en och en halv sekund."

#. from yeager:scummvm
msgid "wejście - Czy to jakaś moda, czy w tej okolicy| wszyscy po prostu mocno pukają?"
msgstr "entry - Är det här någon slags modefluga, eller slår alla bara hårt på det här området?"

#. from yeager:scummvm
msgid "młyńskie koło - Jeżeli będę się w nie wystarczająco mocno|i długo wpatrywał, na pewno ruszy."
msgstr "kvarnhjulet - Om jag stirrar på det tillräckligt hårt och länge kommer det definitivt att röra på sig."

#. from yeager:scummvm
msgid "wyjście - Polna dróżka."
msgstr "avfart - Field Road."

#. from yeager:scummvm
msgid "droga - Szeroko i dobrze ubita, choć nierówna."
msgstr "väg - Bred och välkompakterad, men ojämn."

#. from yeager:scummvm
msgid "wejście - Pomyśleć, że z drugiej strony to już|jest coś dokładnie odwrotnego."
msgstr "entry - Att tänka sig att det å andra sidan är precis tvärtom."

#. from yeager:scummvm
msgid "worki - Dziwne, młyn opuszczony, ale worki pełne|są mąki."
msgstr "säckar - Märkligt, kvarnen övergiven men säckar fulla med mjöl."

#. from yeager:scummvm
msgid "szczelina - Interesujący otwór, ale trzeba uważać,|żeby nie wpaść."
msgstr "gap - En intressant öppning, men man måste vara försiktig så att man inte ramlar i."

#. from yeager:scummvm
msgid "mąka - Pełno w niej robactwa.+Kto chce placuszka?"
msgstr "mjöl - Det är fullt av ohyra.+Vem vill ha en pannkaka?"

#. from yeager:scummvm
msgid "żarna - Nieco nadgryzione zębem czasu."
msgstr "quern - Något biten av tidens tand."

#. from yeager:scummvm
msgid "super tajny piksel - Brawo! Znalazłeś super tajny piksel!+Co prawda nic to zmienia w dalszym biegu|wydarzeń, ale wyrażamy nasz podziw dla|Twojej kontroli nad myszką.+Bo chyba nie zaciąłeś się w grze i nie|szukasz desperacko piksel po pikselu|jakiegoś obiektu, który może ominąłeś?..."
msgstr "super hemlig pixel - Bravo! Du har hittat den superhemliga pixeln! +Detta ändrar ingenting i det fortsatta händelseförloppet, men vi uttrycker vår beundran för din kontroll över musen.+För att du inte sitter fast i spelet och inte desperat letar pixel för pixel efter något objekt som du kanske har missat?…"

#. from yeager:scummvm
msgid "dziewczyna - Lubię patrzeć, jak tak kręci|i potrząsa."
msgstr "flicka - Jag gillar att se honom snurra och skaka så där."

#. from yeager:scummvm
msgid "linka - Aż sama zaprasza..."
msgstr "länk - Tills den bjuder in sig själv...."

#. from yeager:scummvm
msgid "szczur - Szczur. Ratus maior czy może ratus minor?+Obojętne. I tak jest tylko małym owrzodzonym|paskudztwem roznoszącym zarazki dżumy."
msgstr "råtta - råtta. Ratus maior eller ratus minor? Det är ändå bara en liten sårig sak som sprider pestbakterier."

#. from yeager:scummvm
msgid "wyjście - Z kolan na nogi."
msgstr "exit - Från knän till fötter."

#. from yeager:scummvm
msgid "butelki - Puste jak głowa Sheili."
msgstr "flaskor - lika tomma som Sheilas huvud."

#. from yeager:scummvm
msgid "pajęczyna - Pajączek, pajączek bez nóżek i bez rączek."
msgstr "spindel - En spindel, en spindel utan ben och utan händer."

#. from yeager:scummvm
msgid "elegancka dama - Nigdy nie widziałem wcześniej tak wystrojonej|kobiety.+Pewnie to jakaś ważna osobistość, ciesząca się|wielkim szacunkiem."
msgstr "elegant dam - Jag har aldrig sett en kvinna så uppklädd förut + Förmodligen är hon någon viktig person som åtnjuter stor respekt."

#. from yeager:scummvm
msgid "kupiec - Wygląda na bardzo miłego człowieka."
msgstr "köpman - Han verkar vara en mycket trevlig man."

#. from yeager:scummvm
msgid "drzwi - Te drzwi prowadzą do jakiegoś rodzaju świątyni.+Mam nadzieję, że nie składa się tu ofiar|z ludzi."
msgstr "dörr - Den här dörren leder till något slags tempel.+Jag hoppas att inga människooffer görs här."

#. from yeager:scummvm
msgid "stalowa maszkara - Wygląda tak, jakby była sterowana przez kogoś|od wewnątrz.+Ciekawe przez kogo? Może krasnoludy, bo człowiek|na pewno się w środku nie zmieści."
msgstr "en stålmaskerad - Det ser ut som om den styrs av någon inifrån.+Jag undrar av vem? Kanske dvärgar, för en människa skulle verkligen inte passa in."

#. from yeager:scummvm
msgid "drzwi - To drzwi do jakiegoś publicznie dostępnego|budynku."
msgstr "dörr - Detta är dörren till en byggnad som är tillgänglig för allmänheten."

#. from yeager:scummvm
msgid "skrzynka - Znak złotej trąbki niedwuznacznie wskazuje, że|nie mam pojęcia, do czego ta skrzynka może|służyć."
msgstr "låda - Den gyllene trumpetens tecken visar entydigt att jag inte har någon aning om vad den här lådan kan användas till."

#. from yeager:scummvm
msgid "drzwi - Tutaj pewnie tubylcy składają ofiary|ze zwierząt."
msgstr "dörr - Det är förmodligen här som infödingarna offrar sina djur."

#. from yeager:scummvm
msgid "drzwi - Widać znak węża owiniętego dookoła słupa.+To pewnie miejsce pracy jakiegoś tutejszego|czarnoksiężnika."
msgstr "dörr - Du kan se tecknet på en orm som är lindad runt en stolpe.+ Det är förmodligen arbetsplatsen för någon lokal trollkarl."

#. from yeager:scummvm
msgid "stragan - Niektóre warzywa i owoce znam, ale niektórych|nigdy wcześniej nie widziałem."
msgstr "stall - En del grönsaker och frukt känner jag till, men en del har jag aldrig sett förut."

#. from yeager:scummvm
msgid "dziwna machina - Kołyska na kółkach - to po prostu genialne!"
msgstr "konstig maskin - Vagga på hjul - den är helt enkelt genial!"

#. from yeager:scummvm
msgid "przechodzień - Co za dziwna moda..."
msgstr "förbipasserande - Vilket underligt mode...."

#. from yeager:scummvm
msgid "kapłan - Dziwne: ubrany na czarno, ale nie sprawia|wrażenia adepta czarnej magii."
msgstr "priest - Märklig: klädd i svart, men ger inte intryck av att vara en adept inom svart magi."

#. from yeager:scummvm
msgid "obraz - Artysta uwiecznił jakiegoś potężnego maga, który|ruchem dłoni ujarzmił morze."
msgstr "målning - Konstnären förevigade en mäktig trollkarl som tämjde havet med en handviftning."

#. from yeager:scummvm
msgid "drzwi - Prowadzą na zaplecze świątyni."
msgstr "dörr - leder till baksidan av templet."

#. from yeager:scummvm
msgid "ambona - Chwała na wysokości."
msgstr "predikstol - Ära i höjden."

#. from yeager:scummvm
msgid "ławy - Puste.+Niestety."
msgstr "bänkar - Tomma.+Olyckligtvis."

#. from yeager:scummvm
msgid "kropielnica - Wyschnięta, kamień jest tylko lekko wilgotny."
msgstr "stoup - Uttorkad, stenen är endast lätt fuktig."

#. from yeager:scummvm
msgid "wyjście - Powrót do ulicznego zgiełku."
msgstr "utgång - Tillbaka till gatans liv och rörelse."

#. from yeager:scummvm
msgid "człowiek o twarzy sadystycznego mordercy - Chyba wykonuje zawód zgodny z zainteresowaniami."
msgstr "en man med en sadistisk mördares ansikte - jag antar att han har ett yrke som ligger i linje med hans intressen."

#. from yeager:scummvm
msgid "drzwi - Jedyna droga ucieczki."
msgstr "dörr - Den enda vägen ut."

#. from yeager:scummvm
msgid "certyfikat - Nie znam tutejszego języka, ale założyłbym się,|że ten dokument ma coś wspólnego z oceną|umiejętności machania toporkiem."
msgstr "intyg - Jag kan inte språket här, men jag skulle gissa att det här dokumentet har något att göra med bedömning av färdigheter i att svinga yxa."

#. from yeager:scummvm
msgid "wędliny - Mniam, mniam."
msgstr "kallskuret kött - Mums, mums."

#. from yeager:scummvm
msgid "mózg - No, to teraz już jasne, dlaczego ten|za ladą ma taki głupi wyraz twarzy."
msgstr "brain - Ja, nu förstår man varför han bakom disken har ett så dumt ansiktsuttryck."

#. from yeager:scummvm
msgid "pojemnik - Zwierzęta mają bardzo bogate życie|wewnętrzne..."
msgstr "container - Djur har ett mycket rikt liv|internt..."

#. from yeager:scummvm
msgid "siekiera - Gdyby nie drzwi... byłbym niższy|o głowę."
msgstr "yxa - Om det inte vore för dörren.... skulle jag raka mitt huvud."

#. from yeager:scummvm
msgid "strażnik - Idiotów z bejzbolami chyba nigdy nie zabraknie..."
msgstr "guardian - Idioter med jätteföretag kommer förmodligen aldrig att bli en bristvara...."

#. from yeager:scummvm
msgid "wejście - Ciepło, ciepło..."
msgstr "post - Värme, värme ..."

#. from yeager:scummvm
msgid "wyjście - Któżby chciał opuszczać piekielne otchłanie?"
msgstr "exit - Vem skulle vilja lämna helvetets avgrunder?"

#. from yeager:scummvm
msgid "tabliczka - \"Wstęp tylko dla diabłów i zmarłych. Obsługujemy|tylko jedną parę naraz. Przed wejściem należy|przygotować listę grzechów.\""
msgstr "skylt - \"Inträde endast för djävlar och döda. Vi serverar endast ett par åt gången. En lista över synder måste förberedas innan du går in.\""

#. from yeager:scummvm
msgid "drzwi - Solidne drewno z metalowymi okuciami.+Mucha nie siada."
msgstr "dörrar - Massivt trä med metallbeslag.+Flyg sitter inte."

#. from yeager:scummvm
msgid "krata więzienna - Lepsza taka wentylacja niż żadna."
msgstr "fängelsegaller - Bättre denna typ av ventilation än ingen alls."

#. from yeager:scummvm
msgid "zamek - Widzę, że nowoczesna technika sięgnęła nawet|Piekła."
msgstr "slott - Jag ser att modern teknik till och med har nått helvetet."

#. from yeager:scummvm
msgid "drzwi - Nie do pokonania, chyba że ma się do dyspozycji|wściekłego słonia.*+Albo klucz."
msgstr "dörr - oslagbar om du inte har en arg elefant till ditt förfogande*+eller en nyckel."

#. from yeager:scummvm
msgid "czarka - Pewnie to właśnie naczynie trafia do więźniów."
msgstr "niggle - Det är förmodligen det fartyg som går till fångarna."

#. from yeager:scummvm
msgid "przejście - Droga w czeluście piekieł."
msgstr "passage - Vägen in i helvetets djup."

#. from yeager:scummvm
msgid "przejście - Prowadzi do znanych mi już obszarów piekielnych."
msgstr "passage - Leder till områden i helvetet som jag redan känner till."

#. from yeager:scummvm
msgid "przejście - W inne rejony Piekła."
msgstr "övergång - till andra områden i Hell."

#. from yeager:scummvm
msgid "wnęka - Wnęka dość mroczna, ale widzę dwa pilnujące|czegoś diabły."
msgstr "alkove - En alkove som är ganska mörk, men jag kan se två djävlar som vaktar något."

#. from yeager:scummvm
msgid "drzwi - Stare, ale jare."
msgstr "dörren - en gammal goding."

#. from yeager:scummvm
msgid "wejście - Pukajcie, a będzie wam otworzone."
msgstr "entré - Knacka på så öppnas den för dig."

#. from yeager:scummvm
msgid "zawór - Kurek z dziwnego metalu..."
msgstr "ventil - Konstig metallkran...."

#. from yeager:scummvm
msgid "zbiornik - Tutaj lawa znajduje swoje ujście.+Ciekawe, co się z nią dalej dzieje."
msgstr "reservoar - Det är här lavan får sitt utlopp, och jag undrar vad som händer med den härnäst."

#. from yeager:scummvm
msgid "kawałek różka - Rozdzielnicowy."
msgstr "en rosa bit - ställverk."

#. from yeager:scummvm
msgid "diabeł - Rozdzielnicowy."
msgstr "devil - Växel."

#. from yeager:scummvm
msgid "biała świeca - Mała, krótka świeca; stoi najbliżej drzwi do|sali z napisem \"Grzechy lekkie\"."
msgstr "vitt ljus - Litet, kort ljus; står närmast dörren till rummet med inskriptionen \"Lätta synder\"."

#. from yeager:scummvm
msgid "czerwona świeca - Średniej wielkości świeca, stoi blisko drzwi|z napisem \"Grzechy ciężkie\"."
msgstr "rött ljus - Medelstort ljus, står nära dörren med inskriptionen \"Grave Sins\"."

#. from yeager:scummvm
msgid "czarna świeca - Olbrzymia, gruba świeca. Jest najbliżej drzwi|z napisem \"V.I.P.\"."
msgstr "svart ljus - Ett stort, tjockt ljus. Det står närmast dörren med texten \"V.I.P.\"."

#. from yeager:scummvm
msgid "drzwi - \"Wirtualna sala grzechów lekkich.\""
msgstr "dörr - \"Virtuell sal för lätta synder.\""

#. from yeager:scummvm
msgid "drzwi - \"Wirtualna sala tylko dla V.I.P.-ów.\"+Jest jeszcze dopisek: \"Wersja beta.\""
msgstr "dörr - \"Virtuellt rum endast för V.I.P.s.\"+Det finns också en anteckning: \"Betaversion.\""

#. from yeager:scummvm
msgid "drzwi - \"Wirtualna sala grzechów ciężkich.\""
msgstr "dörr - \"Virtuell hall för allvarliga synder.\""

#. from yeager:scummvm
msgid "wyjście - Zejście w głąb korytarzy Piekła."
msgstr "exit - Nedstigning i djupet av helvetets korridorer."

#. from yeager:scummvm
msgid "diabeł - Jedzonko nie posłużyło."
msgstr "djävul - Maten serverades inte."

#. from yeager:scummvm
msgid "różki - Śliczne!"
msgstr "rosa - underbart!"

#. from yeager:scummvm
msgid "kociołek - Pusty, bez żadnej strawy.+Najprawdopodobniej nigdy jej tutaj nie było."
msgstr "cauldron - Tom, utan någon mat.+ Förmodligen har den aldrig varit här."

#. from yeager:scummvm
msgid "żar - Ognisko gorące, ale płomień wygaszony."
msgstr "embers - Elden är het men lågan har slocknat."

#. from yeager:scummvm
msgid "skóra - To chyba z tego biedaka, który stracił|głowę dla ściany."
msgstr "skin - Detta är förmodligen från den stackars man som tappade huvudet för väggen."

#. from yeager:scummvm
msgid "czaszka - Rozumiem potrzebę ozdobnika, ale dziwny mają|gust w tym Piekle...+I tak dobrze, że nie przybili tu gwoździami|czegoś żywego."
msgstr "dödskalle - Jag förstår behovet av utsmyckning, men det finns en märklig avsky i detta helvete...+Det är så bra att de inte spikade fast något levande här."

#. from yeager:scummvm
msgid "fotel - Mebel dwuosobowy, ale karę odbywa się|w samotności.+Nuda, samotność, pustka... I to tylko kara za|grzechy lekkie..."
msgstr "fåtölj - En möbel för två, men straffet sker i ensamhet.+Tristess, ensamhet, tomhet.... Och detta är bara ett straff för lätta synder...."

#. from yeager:scummvm
msgid "węgielek - Superrozgrzany."
msgstr "kol - Överhettad."

#. from yeager:scummvm
msgid "węgielek - Rozgrzany."
msgstr "kol - Uppvärmd."

#. from yeager:scummvm
msgid "fake - Nic. Tego tutaj nie ma. Zapomnij."
msgstr "fake - Ingenting. Det här är inte här. Glöm det."

#. from yeager:scummvm
msgid "udziec - Tłuściutki kawał mięcha."
msgstr "ben - En fet köttbit."

#. from yeager:scummvm
msgid "łóżko - Wygląda na mięciutkie i przytulne.|W rzeczywistości jest zimne i twarde."
msgstr "säng - Den ser mjuk och mysig ut, men i verkligheten är den kall och hård."

#. from yeager:scummvm
msgid "potrawy - Widok cudowny, rozczulający i ślinopędny, ale|nawet smoczy żołądek nie potrafi trawić|kamieni..."
msgstr "rätter - En syn att skåda, förtjusande och saliverande, men inte ens en drakes mage kan smälta stenar...."

#. from yeager:scummvm
msgid "wino i słodycze - Torcik palce lizać, a wino aż błyszczy.|Doprawdy, perfidny miraż..."
msgstr "vin och sötsaker - Tårtan slickar i fingrarna och vinet skiner. Ett perfidiskt mirakel...."

#. from yeager:scummvm
msgid "owoce - Wyglądają bardzo smacznie, ale są|z polakierowanego drewna.+Chociaż banan mógłby się komuś przydać."
msgstr "frukt - De ser väldigt goda ut, men de är av lackat trä.+Även om en banan kan vara användbar för någon."

#. from yeager:scummvm
msgid "kukła - Model najwyraźniej symbolizujący niegrzeczne|dzieci i krasnoludy."
msgstr "marionett - En modell som tydligen symboliserar stygga barn och dvärgar."

#. from yeager:scummvm
msgid "wygasłe palenisko - Nic poza zwęglonym pyłem."
msgstr "släckt eldstad - Inget annat än förkolnat damm."

#. from yeager:scummvm
msgid "palenisko - Buzuje aż miło."
msgstr "härd - det surrar hela vägen."

#. from yeager:scummvm
msgid "zastygła smoła - \"Model wycofany z produkcji. Napęd węglowy.\""
msgstr "solidifierad tjära - \"Modell som tagits ur produktion. Kolfiberdriven.\""

#. from yeager:scummvm
msgid "smoła - Diabelskie jakuzi..."
msgstr "tjära - Djävulens yakuzi..."

#. from yeager:scummvm
msgid "wiadro - Wrrr... Jak wyobrażę to sobie w działaniu..."
msgstr "hink - Wrrr... Som jag föreställer mig det i action...."

#. from yeager:scummvm
msgid "probówki - Mają bardzo fantazyjne kształty, ale|nie wiem, do czego mogłyby służyć.+I nawet nie chcę wiedzieć."
msgstr "provrör - De har väldigt snygga former, men jag vet inte vad de kan användas till + jag vill inte ens veta."

#. from yeager:scummvm
msgid "klepsydra - Odmierzała czas oprawcom."
msgstr "hourglass - Tidtagning av torterarna."

#. from yeager:scummvm
msgid "wyjście - Wyjście na korytarz."
msgstr "exit - Utgång till korridor."

#. from yeager:scummvm
msgid "pomoce naukowe - Podręczny zestaw każdego szanującego się|poszukiwacza wrażeń."
msgstr "studiehjälpmedel - Den praktiska utrustningen för alla spänningssökare med självrespekt."

#. from yeager:scummvm
msgid "madejowe łoże - Nie ma to jak wyciągnąć się na łóżku, co?"
msgstr "faddish bed - Inget går upp mot att sträcka ut sig på en säng, eller hur?"

#. from yeager:scummvm
msgid "żelazna dziewica - Teraz już wiem, dlaczego smoków coraz mniej."
msgstr "iron Maiden - Nu vet jag varför drakarna blir färre och färre."

#. from yeager:scummvm
msgid "zużyte narzędzia - Widać na nich lata intensywnej pracy.+Dla dobra ludzkości, rzecz jasna."
msgstr "slitna verktyg - man kan se åratal av intensivt arbete på dem.+För mänsklighetens bästa, förstås."

#. from yeager:scummvm
msgid "hak - Na każdego jest jakiś hak."
msgstr "krok - Det finns en krok för alla."

#. from yeager:scummvm
msgid "wrzątek - Trochę to dziwnie brzmi, ale wrzątek ostudził|pewnie niejednego grzesznika."
msgstr "kokande vatten - Det låter lite konstigt, men kokande vatten har kylt ner många syndare."

#. from yeager:scummvm
msgid "kamień - Jest przeogromny. Żaden człowiek nie jest|w stanie go poruszyć."
msgstr "sten - Den är enorm. Ingen människa kan flytta den."

#. from yeager:scummvm
msgid "łańcuch - Grube, solidne ogniwa."
msgstr "kedja - Tjocka, robusta länkar."

#. from yeager:scummvm
msgid "prycza - Malutka. Widać nie przewidują gości."
msgstr "bunk - pytteliten. De förväntar sig uppenbarligen inga besökare."

#. from yeager:scummvm
msgid "latarnia - No tak, nic dziwnego, w końcu do Piekła|światło słoneczne nie dochodzi."
msgstr "lantern - Ja, det är inte så konstigt, för solljuset når ju inte till helvetet."

#. from yeager:scummvm
msgid "magiczne drzwi - Dlaczego nie ma tu Arivalda? Rozbiłby|je w puch jednym zaklęciem!"
msgstr "magisk dörr - Varför är inte Arivald här? Han skulle ha slagit sönder den med en enda trollformel!"

#. from yeager:scummvm
msgid "wyjście - Powrót na główny korytarz."
msgstr "exit - Återgå till huvudkorridoren."

#. from yeager:scummvm
msgid "diabeł - Lewy."
msgstr "devil - vänster."

#. from yeager:scummvm
msgid "diabeł - Prawy."
msgstr "devil - rätt."

#. from yeager:scummvm
msgid "maszyna muzyczna - To chyba jakaś tajna broń Piekła w walce|z Niebem.+Może ma zakłócić brzmienie anielskich|chórów?"
msgstr "musikmaskinen - Det är förmodligen något slags hemligt vapen från helvetet i kampen mot himlen.+Möjligen är det för att störa ljudet av änglakörer?"

#. from yeager:scummvm
msgid "wejście - Jestem u celu. Raz kozie śmierć, jak|mawiał rzeźnik."
msgstr "inresa - jag är framme vid min destination. En gång en getdöd, som slaktaren brukade säga."

#. from yeager:scummvm
msgid "Lucyfer - Lucyfer. Wygląda może nie tak|przerażająco, ale...+Ci, którzy go zlekceważyli zostali|tu pewnie na zawsze.+Na godziny długie jak miesiące, miesiące|długie jak lata...+... i tak dalej."
msgstr "Lucifer - Lucifer. Han ser kanske inte så skrämmande ut, men...+De som struntar i honom lämnas nog för alltid.+I timmar så långa som månader, månader så långa som år.... och så vidare."

