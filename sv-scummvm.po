#. from yeager:scummvm
msgid "#X1"
msgstr "#X1"

#. from yeager:scummvm
msgid "HERO: Gdzieś to już dzisiaj słyszałem..."
msgstr "HERO: Jag har hört det här någonstans tidigare idag...."

#. from yeager:scummvm
msgid "P#OTHER: Kim jesteś, śmiertelniku?"
msgstr "Vem är du, dödliga?"

#. from yeager:scummvm
msgid "$0: Jestem twoim wyznawcą, panie."
msgstr "$0: Jag är din följare, sir."

#. from yeager:scummvm
msgid "$1: To naprawdę b-a-r-d-z-o długa historia."
msgstr "$1: Det är en riktigt b-a-r-d-z-o lång historia."

#. from yeager:scummvm
msgid "$2: Całe szczęście, że jeszcze ...istniejesz."
msgstr "$2: Det är tur att du fortfarande ... existerar."

#. from yeager:scummvm
msgid "$3: Porozmawiajmy o interesach."
msgstr "$3: Låt oss prata affärer."

#. from yeager:scummvm
msgid "OTHER: Wiem, przecież nie wzywałbyś mego imienia|nadaremno."
msgstr "OTHER: Jag vet, du skulle inte kalla på mitt namn förgäves."

#. from yeager:scummvm
msgid "OTHER: Dlaczego od tak dawna nie widziałem moich|kapłanów?"
msgstr "OTHER: Varför har jag inte träffat mina präster på så länge?"

#. from yeager:scummvm
msgid "OTHER: Dlaczego nie czuję słodkiego zapachu krwi|ofiarnych zwierząt?"
msgstr "OTHER: Varför kan jag inte känna den söta lukten av blod?"

#. from yeager:scummvm
msgid "OTHER: Dlaczego nie słyszę pieśni sławiących|moje imię?"
msgstr "OTHER: Varför hör jag inte sånger som hyllar mitt namn?"

#. from yeager:scummvm
msgid "P#OTHER: Dlaczego tu tak pusto?"
msgstr "P#OTHER: Varför är det så tomt här?"

#. from yeager:scummvm
msgid "HERO: Ludzie odwracają się od starych bogów,|eeee... panie...."
msgstr "HERO: Människor vänder ryggen åt de gamla gudarna,|eeee... damer...."

#. from yeager:scummvm
msgid "HERO: Wszyscy gonią za zyskiem, uciechami|codziennego dnia. Religia przestaje|ich interesować."
msgstr "HERON: Alla jagar vinst, dagens nöjen. Religionen intresserar dem inte längre."

#. from yeager:scummvm
msgid "HERO: Ludzie zrobili się wygodni..."
msgstr "HERO: Människor har blivit bekväma ..."

#. from yeager:scummvm
msgid "HERO: Po co iść do odległej świątyni, kiedy|w tym samym czasie można zabawić się|kielichami w gronie przyjaciół?#B0"
msgstr "HERO: Varför gå till ett avlägset tempel när du kan ha kul med dina vänner på samma gång? #B0"

#. from yeager:scummvm
msgid "OTHER: Nie szkodzi, teraz, kiedy okazało się, że|moi wyznawcy jeszcze żyją, mam dużo czasu."
msgstr "OTHER: Det är okej, nu när det har visat sig att mina följare fortfarande lever har jag gott om tid."

#. from yeager:scummvm
msgid "HERO: Nie wątpię, eeee... panie.... Ale ja|nie jestem wieczny, a ta historia..."
msgstr "HERO: Utan tvekan, eeee.... mr .... Men jag är inte evig, och den här historien...."

#. from yeager:scummvm
msgid "HERO: Cóż, trwa właściwie całe moje życie."
msgstr "HERO: Tja, det har varat i stort sett hela mitt liv."

#. from yeager:scummvm
msgid "HERO: Następnym razem, obiecuję.#B0"
msgstr "HERO: Nästa gång, jag lovar.#B0"

#. from yeager:scummvm
msgid "P#OTHER: Więc wiesz, jaki los mnie czekał..."
msgstr "P#OTHER: Så du vet vilket öde som väntade mig...."

#. from yeager:scummvm
msgid "P#HERO: Wiem. Dowiedziałem się od pewnego|wędrownego mnicha."
msgstr "P#HERO: Jag vet, jag fick reda på det från en viss vandrande munk."

#. from yeager:scummvm
msgid "P#OTHER: Mogę robić, co tylko chcę."
msgstr "P#OTHER: Jag kan göra vad jag vill."

#. from yeager:scummvm
msgid "OTHER: Jestem potężniejszy od królów, magów i kapłanów.|Jednym ruchem dłoni ujarzmiałem smoki, a gniewnym|zmarszczeniem brwi rozpędzałem armie."
msgstr "OTHER: Jag är mäktigare än kungar, magiker och präster, jag har kuvat drakar med en handrörelse och släppt lös arméer med en arg rynka i pannan."

#. from yeager:scummvm
msgid "OTHER: Potrafię zmienić gwiazdę w łabędzia,|a złoto w ogień."
msgstr "OTHER: Jag kan förvandla en stjärna till en svan och guld till eld."

#. from yeager:scummvm
msgid "OTHER: Ale moje istnienie zależy od was."
msgstr "OTHER: Men min existens beror på dig."

#. from yeager:scummvm
msgid "OTHER: Od najbardziej kruchej i niepewnej rzeczy na|świecie - ludzkiego życia."
msgstr "OTHER: Från det mest bräckliga och osäkra i världen - människolivet."

#. from yeager:scummvm
msgid "P#OTHER: Tak to już bywa: coś za coś.#B0"
msgstr "P#OTHER: Det är så det går: något för något.#B0"

#. from yeager:scummvm
msgid "OTHER: Jak to o interesach?!"
msgstr "OTHER: Vad menar du med affärer!"

#. from yeager:scummvm
msgid "HERO: Po kolei."
msgstr "En efter en."

#. from yeager:scummvm
msgid "HERO: Szczerze mówiąc nie jestem twoim|wyznawcą."
msgstr "HERO: För att vara ärlig, jag är inte din följare."

#. from yeager:scummvm
msgid "HERO: Ale jako bóstwo powinieneś mieć|ogromną moc."
msgstr "HERO: Men som gudom borde du ha en enorm makt."

#. from yeager:scummvm
msgid "HERO: Ufam, iż wiesz, jak zniszczyć klątwę."
msgstr "HERO: Jag litar på att du vet hur man förstör förbannelsen."

#. from yeager:scummvm
msgid "HERO: Mam tutaj cztery przedmioty, które przeklął|pewien gorącogłowy grabarz."
msgstr "HERO: Jag har fyra föremål här som förbannades av en hetlevrad begravningsentreprenör."

#. from yeager:scummvm
msgid "HERO: Jednym z przedmiotów jest eliksir|nieśmiertelności."
msgstr "HERO: Ett av föremålen är odödlighetens elixir."

#. from yeager:scummvm
msgid "HERO: Proponuję umowę: dam ci eliksir, a ty w zamian|za to zniweczysz działanie uroku."
msgstr "HERO: Jag föreslår ett avtal: Jag ger dig drycken, och du upphäver effekten av charmen i gengäld."

#. from yeager:scummvm
msgid "HERO: Dzięki temu będziesz wieczny, i przestaniesz|być zależny od wiernych."
msgstr "HERO: Detta kommer att göra dig evig, och du kommer inte längre att vara beroende av de trogna."

#. from yeager:scummvm
msgid "HERO: Których zresztą, a przykro mi to mówić, nie ma."
msgstr "HERO: Vilket förresten, och jag är ledsen att säga, det inte finns."

#. from yeager:scummvm
msgid "P#HERO: To jak? Mam nadzieję, że się dogadamy?"
msgstr "Vad sägs om det? Jag hoppas att vi kan komma överens?"

#. from yeager:scummvm
msgid "P#P#OTHER: Ty... Ty... Ty..."
msgstr "Du... Du... ...du..."

#. from yeager:scummvm
msgid "OTHER: Ty żałosny, słaby człowieczku!"
msgstr "OTHER: Din patetiska, svaga man!"

#. from yeager:scummvm
msgid "OTHER: Ośmielasz się ze mną ...TARGOWAĆ?!"
msgstr "OTHER: Du vågar ...förhandla med mig!"

#. from yeager:scummvm
msgid "OTHER: A może twój nędzny rozum podpowiedział ci,|iż boga można SZANTAŻOWAĆ?"
msgstr "OTHER: Eller har ditt eländiga förnuft sagt dig att Gud kan FÖRSTÖRAS?"

#. from yeager:scummvm
msgid "OTHER: Zaraz przekonasz się, na czym polega|gniew boski!"
msgstr "OTHER: Du kommer snart att få reda på vad du förlitar dig på!"

#. from yeager:scummvm
msgid "OTHER: PRZYGOTUJ SIĘ!!!"
msgstr "OTHER: GÖR ER REDO!!!"

#. from yeager:scummvm
msgid "P#P#P#P#P#OTHER: Kurka, coś słaby dzisiaj jestem."
msgstr "Shucks, något svagt idag."

#. from yeager:scummvm
msgid "OTHER: W porządku, umowa stoi.#X1"
msgstr "OTHER: Okej, det är en affär.#X1"

#. from yeager:scummvm
msgid "HERO: Arivaldzie, ponoć w pobliżu jest jakiś|demoniczny zamek."
msgstr "HERO: Arivald, det sägs att det finns ett demoniskt slott i närheten."

#. from yeager:scummvm
msgid "HERO: Może tam znajdę jakiegoś osobnika z piekła|rodem, który pomoże mi dorwać tego przeklętego|demona, co wpędził mnie w takie kłopoty."
msgstr "HERO: Där kanske jag kan hitta någon från helvetet som kan hjälpa mig att fånga den förbannade demon som gav mig så mycket problem."

#. from yeager:scummvm
msgid "OTHER: No, cóż. Może to jest jakiś pomysł."
msgstr "OTHER: Nåväl, nåväl. Det kanske är en idé."

#. from yeager:scummvm
msgid "P#OTHER: Czy wiesz coś więcej o tym zamku?"
msgstr "F#OTHER: Vet du något mer om detta slott?"

#. from yeager:scummvm
msgid "HERO: Jeszcze raz powiem o tym zamku..."
msgstr "HERO: Jag ska säga en gång till om det slottet...."

#. from yeager:scummvm
msgid "HERO: Ponoć żyją w nim wampiry."
msgstr "HERO: Det ryktas att vampyrer lever i den."

#. from yeager:scummvm
msgid "HERO: W zamku żaden człowiek nie|mieszka od lat."
msgstr "HERO: Ingen människa har bott i slottet på flera år."

#. from yeager:scummvm
msgid "HERO: Budynek jest dwuczęściowy."
msgstr "HERO: Byggnaden är uppdelad i två delar."

#. from yeager:scummvm
msgid "HERO: W okolicy panuje mrok, tak jakby|słońce nie chciało tam świecić."
msgstr "HERO: Området är mörkt, som om solen inte vill skina där."

#. from yeager:scummvm
msgid "OTHER: Hm, gdzieś, kiedyś... Nie, nie pamiętam."
msgstr "Hm, nånstans, nån gång.... Nej, det minns jag inte."

#. from yeager:scummvm
msgid "OTHER: Mój drogi, może napiłbyś się piwa|zamiast zawracać mi w kółko głowę?"
msgstr "OTHER: Min kära, varför tar du inte en öl istället för att besvära mig om och om igen?"

#. from yeager:scummvm
msgid "OTHER: Mmmm...."
msgstr "OTHER: Mmmm...."

#. from yeager:scummvm
msgid "OTHER: Blisko, blisko..."
msgstr "OTHER: Nära, nära ..."

#. from yeager:scummvm
msgid "P#OTHER: Mam to na końcu języka, ale..."
msgstr "P#OTHER: Det är på min tungspets, men...."

#. from yeager:scummvm
msgid "OTHER: Nie, chłopcze, w końcu nie byłem tu już|tysiąc lat. Mam prawo zapomnieć jeden|czy drugi drobny szczegół."
msgstr "OTHER: Nej, pojk, jag har ju inte varit här i tusen år. Jag har rätt att glömma den ena eller andra lilla detaljen."

#. from yeager:scummvm
msgid "OTHER: Hm..."
msgstr "OTHER: Hm..."

#. from yeager:scummvm
msgid "P#OTHER: Hm."
msgstr "P#OTHER: Hm."

#. from yeager:scummvm
msgid "P#OTHER: Hm!"
msgstr "P#OTHER: Hm!"

#. from yeager:scummvm
msgid "OTHER: Słynny zamek Fjord!"
msgstr "OTHER: Det berömda Fjordslottet!"

#. from yeager:scummvm
msgid "OTHER: Ależ to Fjord!"
msgstr "OTHER: Men det är ju Fjord!"

#. from yeager:scummvm
msgid "OTHER: Musisz pójść na południowy wschód.|To niedaleko stąd."
msgstr "Du måste åka sydost. Det är inte långt härifrån."

#. from yeager:scummvm
msgid "OTHER: Nigdy mi się nie podobało to stare zamczysko.|Nic dziwnego, że wampiry uwiły sobie w nim|urocze gniazdko."
msgstr "OTHER: Jag har aldrig gillat det här gamla slottet. Inte undra på att vampyrer har gjort ett kåt bo i det."

#. from yeager:scummvm
msgid "OTHER: Czy opowiadałem ci jak kiedyś poskromiłem...|A zresztą masz pewnie większe zmartwienia?"
msgstr "OTHER: Har jag berättat hur jag en gång tämjde...och förresten, du har nog större saker att oroa dig för?"

#. from yeager:scummvm
msgid "HERO: Znalazłem pewną książkę..."
msgstr "HERO: Jag hittade en viss bok ..."

#. from yeager:scummvm
msgid "HERO: Wydaje mi się, iż jest magiczna, więc od razu|pomyślałem o tobie, drogi przyjacielu."
msgstr "HERO: Jag tycker att det är magiskt, så jag tänkte genast på dig, kära vän."

#. from yeager:scummvm
msgid "OTHER: Cóż...hm...tak...zajmujące. Powiem|więcej: interesujące."
msgstr "OTHER: Tja... ja... ockuperande. Jag ska säga mer: intressant."

#. from yeager:scummvm
msgid "OTHER: Gdzie znalazłeś tego białego kruka?"
msgstr "OTHER: Var hittade du den här vita korpen?"

#. from yeager:scummvm
msgid "OTHER: Czyżby zostało coś ze starej wiedzy|przesławnej Silmaniony?"
msgstr "OTHER: Finns det något kvar av Silmanionas gamla kunskaper?"

#. from yeager:scummvm
msgid "HERO: Eeee... Nie wiem, ja tam znalazłem|to przy drodze, może któryś z kupców|kiedyś ją zgubił..."
msgstr "HERO: Eeee... Jag vet inte, jag hittade den där vid sidan av vägen, kanske en av köpmännen en gång tappade den...."

#. from yeager:scummvm
msgid "OTHER: Kupców! Ha! Ci dusigrosze znają się|na magii tyle, co kura na pieprzu!"
msgstr "OTHER: Handlare! Ha! Dessa själar vet lika mycket om magi som en höna vet om peppar!"

#. from yeager:scummvm
msgid "OTHER: Nawet jeśli była ich, to tym lepiej,|że ją stracili!"
msgstr "OTHER: Även om det var deras, desto bättre att förlora det!"

#. from yeager:scummvm
msgid "HERO: Rysunki w tej księdze wyglądają interesująco."
msgstr "HERO: Teckningarna i den här boken ser intressanta ut."

#. from yeager:scummvm
msgid "OTHER: Nie musisz dodawać ni słowa, książę!"
msgstr "OTHER: Du behöver inte lägga till något ord, Prince!"

#. from yeager:scummvm
msgid "OTHER: Zaraz biorę się za wnikliwe studia!"
msgstr "OTHER: Jag är på väg att påbörja en fördjupad studie!"

#. from yeager:scummvm
msgid "OTHER: Co do zapłaty..."
msgstr "OTHER: Beträffande betalning ..."

#. from yeager:scummvm
msgid "P#P#OTHER: <westchnienie>"
msgstr "P#P#OTHER: <westchnienie>"

#. from yeager:scummvm
msgid "OTHER: Eliksirów miłosnych już nie mam, ale ten|zabawny czar na pewno rozrusza twoich|przyjaciół na jakiejś biesiadzie."
msgstr "OTHER: Jag har inte kärleksdrycker längre, men den här roliga trollformeln kommer säkert att få dina vänner att skratta på någon fest."

#. from yeager:scummvm
msgid "HERO: Arivaldzie..."
msgstr "HERO: Arivald..."

#. from yeager:scummvm
msgid "P#OTHER: Tak?"
msgstr "P#OTHER: Ja?"

#. from yeager:scummvm
msgid "HERO: Jak to powiedzieć..."
msgstr "HERO: Hur säger man..."

#. from yeager:scummvm
msgid "HERO: Wejścia do Fjord broni taki kamienny demon,|który właściwie nie jest kamienny i..."
msgstr "HERO: Ingången till fjorden försvaras av en slags stendemon, som egentligen inte är sten och..."

#. from yeager:scummvm
msgid "OTHER: Czyżby była ci potrzebna maść na oparzenia?"
msgstr "OTHER: Behöver du brännskadesalva?"

#. from yeager:scummvm
msgid "$0: I to na bardzo wrażliwe miejsce."
msgstr "$0: Och det är på en mycket känslig plats."

#. from yeager:scummvm
msgid "$1: Widzę, że znasz problem."
msgstr "$1: Jag ser att du känner till problemet."

#. from yeager:scummvm
msgid "$2: Jak pokonać tego diabelskiego strażnika?"
msgstr "$2: Hur besegrar du denna djävulska väktare?"

#. from yeager:scummvm
msgid "OTHER: Pewnie \"tam, gdzie plecy tracą swą|szlachetną nazwę\"."
msgstr "OTHER: Förmodligen \"där ryggen förlorar sitt ädla namn\"."

#. from yeager:scummvm
msgid "OTHER: Nie martw się, do wesela się zagoi."
msgstr "OTHER: Oroa dig inte, det kommer att läka av bröllopet."

#. from yeager:scummvm
msgid "HERO: Co jednak nie zmienia faktu, że|nie mogę wejść do środka zamku."
msgstr "HERO: Vilket dock inte ändrar det faktum att jag inte kan gå in i slottet."

#. from yeager:scummvm
msgid "OTHER: Stare sztuczki zawsze działają. Lustro,|mój chłopcze, może ci pomóc. Idealnie|gładkie lustro."
msgstr "Gamla knep fungerar alltid. En spegel, min pojke, kan hjälpa dig. En perfekt slät spegel."

#. from yeager:scummvm
msgid "OTHER: Może barman ma coś takiego na składzie.|No chociaż na twoim miejscu, oczywiście|bym na to nie liczył.#X1"
msgstr "OTHER: Kanske har bartendern något liknande i lager.Tja, även om jag var du, naturligtvis|Jag skulle inte räkna med det.#X1"

#. from yeager:scummvm
msgid "OTHER: Sam kiedyś wymyśliłem ten system|zabezpieczeń."
msgstr "OTHER: Jag uppfann en gång detta system själv."

#. from yeager:scummvm
msgid "OTHER: Widzę, że mój detektor ruchu przetrwał|całe tysiąclecie."
msgstr "OTHER: Jag ser att min rörelsedetektor har överlevt ett helt årtusende."

#. from yeager:scummvm
msgid "HERO: Cieszę się razem z tobą, ale jak mam|pokonać tego laserowego strażnika?"
msgstr "HERO: Jag är glad för din skull, men hur ska jag kunna besegra det här laserskyddet?"

#. from yeager:scummvm
msgid "OTHER: Stary trick z lustrem byłby pomocny,|ale przeciw takiemu demonowi pomogłoby|tylko idealnie gładkie lustro."
msgstr "OTHER: Det gamla spegeltricket skulle hjälpa, men mot en sådan demon skulle bara en perfekt slät spegel hjälpa."

#. from yeager:scummvm
msgid "OTHER: Zapytaj barmana.#X1"
msgstr "OTHER: Fråga bartendern.#X1"

#. from yeager:scummvm
msgid "OTHER: Kiedy jesteś w jego pobliżu, pamiętaj,|mój przyjacielu: festina lente."
msgstr "OTHER: När du är nära honom, kom ihåg, min vän: festina lente."

#. from yeager:scummvm
msgid "OTHER: Gładziutkie lusterko. Oto rozwiązanie|twojego problemu."
msgstr "OTHER: Slät spegel. Här är lösningen på ditt problem."

#. from yeager:scummvm
msgid "HERO: Arivald coś wspomniał, że możesz mieć|jakieś idealnie gładkie lustro?..."
msgstr "HERO: Arivald nämnde något om att du skulle kunna ha en perfekt slät spegel. ...."

#. from yeager:scummvm
msgid "OTHER: Mistrz Arivald? Dostojny czarodziej?"
msgstr "Mäster Arivald? Den värdige trollkarlen?"

#. from yeager:scummvm
msgid "OTHER: Mistrz Arivald? Mój nowy, wspaniały klient?"
msgstr "Mäster Arivald? Min underbara nya klient?"

#. from yeager:scummvm
msgid "OTHER: Niestety, bardzo bym chciał ci pomóc,|książę, ale nie mogę."
msgstr "OTHER: Tyvärr skulle jag väldigt gärna vilja hjälpa er, prins, men det kan jag inte."

#. from yeager:scummvm
msgid "OTHER: Siedem lat temu stały się dwie|rzeczy."
msgstr "OTHER: För sju år sedan hände två saker."

#. from yeager:scummvm
msgid "OTHER: Ożeniłem się, i rozbiłem jedyne|lustro."
msgstr "OTHER: Jag gifte mig och krossade min enda spegel."

#. from yeager:scummvm
msgid "OTHER: Już nigdy nie kupię nowego."
msgstr "OTHER: Jag kommer aldrig att köpa en ny igen."

#. from yeager:scummvm
msgid "HERO: Może znalazłbyś jakiś dobrze wypolerowany|kawałek metalu?"
msgstr "HERO: Du kanske kan hitta en välpolerad metallbit?"

#. from yeager:scummvm
msgid "HERO: Cokolwiek gładkiego!"
msgstr "HERO: Allt som är smidigt!"

#. from yeager:scummvm
msgid "OTHER: Niestety..."
msgstr "OTHER: Tyvärr ..."

#. from yeager:scummvm
msgid "P#OTHER: Chociaż przecież..."
msgstr "P#OTHER: Även om trots allt ..."

#. from yeager:scummvm
msgid "OTHER: No jasne!"
msgstr "OTHER: Naturligtvis!"

#. from yeager:scummvm
msgid "OTHER: Poproś swojego ojca, książę!"
msgstr "Fråga din far, prins!"

#. from yeager:scummvm
msgid "OTHER: On ma w skarbcu to słynne magiczne|lustro, które właściwie nie wiadomo|do czego służy."
msgstr "OTHER: Han har en berömd magisk spegel i sitt valv, som man inte riktigt vet vad den är till för."

#. from yeager:scummvm
msgid "OTHER: Ponoć jest bezcenne, ale w końcu jesteś|księciem i możesz brać ze skarbca, co|chcesz."
msgstr "OTHER: Den är förmodligen ovärderlig, men i slutändan är du en bok och du kan ta vad du vill från valvet."

#. from yeager:scummvm
msgid "P#HERO: No to mam kłopoty."
msgstr "Då är jag illa ute."

#. from yeager:scummvm
msgid "HERO: Mam tu coś, co cię zaciekawi."
msgstr "HERO: Jag har något här som kommer att intressera dig."

#. from yeager:scummvm
msgid "OTHER: Naprawdę?"
msgstr "OTHER: Verkligen?"

#. from yeager:scummvm
msgid "HERO: Dostałem to od innego czarodzieja."
msgstr "HERO: Jag fick det från en annan trollkarl."

#. from yeager:scummvm
msgid "OTHER: Och, to znany czar. Tylko hmmm, niech|spojrzę. Dziwne efekty uboczne."
msgstr "OTHER: Åh, det är en välkänd charm. Bara hmmm, låt mig se. Konstiga biverkningar."

#. from yeager:scummvm
msgid "HERO: Wiedziałem, że gdzieś tkwi jakiś|haczyk."
msgstr "HERO: Jag visste att det fanns en hake någonstans."

#. from yeager:scummvm
msgid "OTHER: To czar zamiany w zwierzę. Pospolita|magia."
msgstr "OTHER: Det är en trollformel för att förvandlas till ett djur. Vanlig magi."

#. from yeager:scummvm
msgid "OTHER: Problem tkwi w tym, że osoba, na którą rzucamy|to zaklęcie zamienia się w zwierzę symbolizujące|odwrotność jej charakteru."
msgstr "OTHER: Problemet är att den person som vi kastar denna besvärjelse på förvandlas till ett djur som symboliserar motsatsen till deras karaktär."

#. from yeager:scummvm
msgid "OTHER: Czy mówię jasno, chłopcze?"
msgstr "OTHER: Är jag tydlig, pojke?"

#. from yeager:scummvm
msgid "OTHER: Znaczy to, iż jeżeli ktoś jest odważnym i silnym|człowiekiem, zamienić się może, powiedzmy, w mysz."
msgstr "OTHER: Det betyder att om man är modig och stark kan man förvandlas till exempelvis en mus."

#. from yeager:scummvm
msgid "P#HERO: Aha."
msgstr "P#HERO: Aha."

#. from yeager:scummvm
msgid "OTHER: Chciałbyś, żebym coś zrobił z tym czarem?"
msgstr "OTHER: Vill du att jag ska göra något åt besvärjelsen?"

#. from yeager:scummvm
msgid "P#HERO: Na razie nie wiem, ale jak coś wymyślę,|dam znać."
msgstr "P#HERO: Jag vet inte just nu, men om jag kommer på något så ska jag berätta det."

#. from yeager:scummvm
msgid "HERO: Arivaldzie, muszę się dostać do Garrahan,|ale jeżeli straże mnie zobaczą zostanę|uwięziony..."
msgstr "HERO: Arivald, jag måste ta mig till Garrahan, men om vakterna ser mig blir jag fängslad...."

#. from yeager:scummvm
msgid "HERO: Użyj tego czaru zamiany i wprowadź mnie|do zamku."
msgstr "HERO: Använd den här bytesformeln och för mig in i slottet."

#. from yeager:scummvm
msgid "HERO: Nie wiem, w co się zamienię, ale po|prostu wejdź ze mną do zamku."
msgstr "HERO: Jag vet inte vad jag kommer att förvandlas till, men följ bara med mig in i slottet."

#. from yeager:scummvm
msgid "HERO: Oto wszystkie moje rzeczy, zostaw mi|tylko wytrychy."
msgstr "HERO: Här är alla mina grejer, lämna bara trumfkorten till mig."

#. from yeager:scummvm
msgid "HERO: Arivaldzie, czy wiesz co to za czar?"
msgstr "HERO: Arivald, vet du vad besvärjelsen är?"

#. from yeager:scummvm
msgid "HERO: Dostałem go w prezencie."
msgstr "HERO: Jag fick den som en gåva."

#. from yeager:scummvm
msgid "OTHER: Pospolity czar, ale efekty uboczne|...zastanawiające."
msgstr "OTHER: Vanlig charm, men biverkningar ... förbryllande."

#. from yeager:scummvm
msgid "OTHER: To czar zamiany w zwierzę."
msgstr "OTHER: Det är en besvärjelse för att förvandlas till ett djur."

#. from yeager:scummvm
msgid "HERO: Muszę się dostać do Garrahan, ale jeżeli|straże mnie zobaczą zostanę uwięziony."
msgstr "HERO: Jag måste ta mig till Garrahan, men om de ser mig blir jag fängslad."

#. from yeager:scummvm
msgid "HERO: Oto wszystkie moje rzeczy, zostaw|mi tylko wytrychy."
msgstr "HERO: Här är alla mina saker, lämna mig bara med knepen."

#. from yeager:scummvm
msgid "OTHER: Na Boga, książę! Co ty tu robisz? Twój ojciec|szaleje ze złości. Co się dzieje, mój panie?"
msgstr "För Guds skull, Duke! Vad gör du här? Din far är rasande av ilska. Vad är det som händer, min herre?"

#. from yeager:scummvm
msgid "$0: Mam ważne sprawy do załatwienia."
msgstr "$0: Jag har viktiga saker att ta itu med."

#. from yeager:scummvm
msgid "$1: Niektóre rzeczy są inne, niż się wydają..."
msgstr "$1: Vissa saker är inte vad de ser ut att vara...."

#. from yeager:scummvm
msgid "$2: Nie jestem twoim panem!"
msgstr "$2: Jag är inte din herre!"

#. from yeager:scummvm
msgid "$4: Uratowałem ci kiedyś życie?"
msgstr "$4: Har jag någonsin räddat ditt liv?"

#. from yeager:scummvm
msgid "OTHER: Ja o tym wiem. Ale teraz..."
msgstr "OTHER: Jag vet det. Men nu..."

#. from yeager:scummvm
msgid "OTHER: Lepiej uciekaj, książę, na dziedzińcu|czekają na ciebie strażnicy.#B0"
msgstr "OTHER: Bäst att springa, prins, det finns vakter som väntar på dig på gården.#B0"

#. from yeager:scummvm
msgid "OTHER: Wierzę w to, co ty powiesz, książę."
msgstr "OTHER: Jag tror på det du säger, Prince."

#. from yeager:scummvm
msgid "OTHER: Nie wiem, jakie miałeś powody, by...|nie zabić Czarnego Rycerza."
msgstr "Jag vet inte vilka skäl du hade för att inte döda den svarte riddaren."

#. from yeager:scummvm
msgid "OTHER: Ale jestem ci wciąż wierny, mój panie.#B0"
msgstr "ANDRA: Men jag är fortfarande trogen dig, min herre.#B0"

#. from yeager:scummvm
msgid "OTHER: Zawsze będziesz moim księciem. Cokolwiek|nie rozkazałby twój ojciec. Uratowałeś mi|życie, panie. Tego się nie zapomina.#E4#B0"
msgstr "Du kommer alltid att vara min prins. Oavsett vad din far befaller. Ni räddade mitt liv, min lord. Det är något du inte glömmer.#E4#B0"

#. from yeager:scummvm
msgid "OTHER: Co się z tobą stało, książę? Nie pamiętasz|jak zasłoniłeś mnie własnym ciałem, kiedy...|Ale ...dość!"
msgstr "Vad har hänt med dig, prins? Minns du inte hur du täckte mig med din egen kropp när ... Men ... nu räcker det!"

#. from yeager:scummvm
msgid "OTHER: Teraz czas, abym ja ocalił ci życie. Król,|twój ojciec, na razie skazał cię tylko na|banicję i utratę czci."
msgstr "OTHER: Nu är det dags för mig att rädda ditt liv. Kungen, din far, har bara dömt dig till förvisning och förlust av heder för tillfället."

#. from yeager:scummvm
msgid "OTHER: Ale jego złość jest taka wielka, że może|skazać cię na utratę gardła. Zhańbiłeś go."
msgstr "OTHER: Men hans vrede är så stor att den kan få dig att förlora din hals. Du har vanärat honom."

#. from yeager:scummvm
msgid "OTHER: Musisz uciekać, panie!"
msgstr "OTHER: Ni måste springa iväg, mina damer!"

#. from yeager:scummvm
msgid "HERO: Mam nadzieję, że spotkamy się jeszcze. Kiedyś|zrozumieją, że książę nie był tchórzem."
msgstr "Jag hoppas att vi möts igen. En dag kommer de att förstå att prinsen inte var en fegis."

#. from yeager:scummvm
msgid "OTHER: Wiem, panie, że tylko ważne powody mogły cię|popchnąć do ucieczki. Ufam ci i wierzę, że|wrócisz na zamek."
msgstr "OTHER: Jag vet, sire, att endast tvingande skäl kan ha fått er att fly. Jag litar på dig och tror att du kommer att återvända till slottet."

#. from yeager:scummvm
msgid "OTHER: Ale ...dość! Musisz uciekać, panie!#X0"
msgstr "Men...nu räcker det! Ni måste springa iväg, mina damer! #X0"

#. from yeager:scummvm
msgid "OTHER: Ależ jesteś silny! Oczyściłeś taki wielki|słój jednym oddechem!"
msgstr "OTHER: Vad stark du är! Du har rensat en så stor burk med ett enda andetag!"

#. from yeager:scummvm
msgid "OTHER: Ja męczyłem się przez kilka miesięcy!"
msgstr "OTHER: Jag våndades i flera månader!"

#. from yeager:scummvm
msgid "OTHER: Może i jestem tylko z mandragory, ale wiem|co to wdzięczność."
msgstr "OTHER: Jag kanske bara är från Mandragora, men jag vet vad tacksamhet är."

#. from yeager:scummvm
msgid "OTHER: Pomogę ci, kiedy tylko będziesz mnie|potrzebował. Powiedzmy ...trzy razy."
msgstr "OTHER: Jag ska hjälpa dig när du behöver mig. Låt oss säga ... tre gånger."

#. from yeager:scummvm
msgid "OTHER: Daj znać, kiedy będę potrzebny."
msgstr "OTHER: Låt mig veta när jag behövs."

#. from yeager:scummvm
msgid "HERO: To chyba dobra wiadomość."
msgstr "HERO: Jag tycker att det här är goda nyheter."

#. from yeager:scummvm
msgid "OTHER: To pułapka?"
msgstr "OTHER: Är det en fälla?"

#. from yeager:scummvm
msgid "OTHER: Cudeńko błyszczy jak słońce, ale coś złego|z niego emanuje."
msgstr "OTHER: Undret lyser som solen, men något ont strålar ut från det."

#. from yeager:scummvm
msgid "OTHER: Nie wezmę tego za żadne skarby."
msgstr "OTHER: Jag tar det inte för någonting."

#. from yeager:scummvm
msgid "OTHER: Taki sam miał kiedyś nasz Król Pod Górą.|Mogłem patrzeć na niego całymi godzinami,|kiedy pilnowałem skarbca."
msgstr "OTHER: Det här är samma som vår kung under berget brukade ha. Jag kunde titta på den i timmar när jag vaktade skattkammaren."

#. from yeager:scummvm
msgid "OTHER: A co to za bezwartościowy, brzydki, cuchnący|i odrażający śmieć?"
msgstr "OTHER: Och vad är detta värdelösa, fula, stinkande och äckliga skräp?"

#. from yeager:scummvm
msgid "OTHER: I to ma być podarunek godny księcia? Czego|ty jesteś księciem? Śmietnika?"
msgstr "OTHER: Och det här ska vara en gåva värdig en prins? Vad är du en prins av? Soptunnan?"

#. from yeager:scummvm
msgid "OTHER: Kto nie ryzykuje, ten ginie."
msgstr "OTHER: Den som inte tar några risker dör."

#. from yeager:scummvm
msgid "OTHER: Do dzieła!"
msgstr "OTHER: Fortsätt med det!"

#. from yeager:scummvm
msgid "OTHER: Niedźwiedź..."
msgstr "OTHER: Bear ..."

#. from yeager:scummvm
msgid "OTHER: Zabawne. Sądziłem, że zmienisz się w lwa."
msgstr "Lustigt. Jag trodde att du skulle förvandlas till ett lejon."

#. from yeager:scummvm
msgid "OTHER: Prowadzę bardzo ucieszne stworzenie|dla króla."
msgstr "OTHER: Jag kör en mycket lycklig skapelse för kungen."

#. from yeager:scummvm
msgid "OTHER: Ten miś nie tylko tańczy, ale|także mruczy najlepsze dowcipy|na świecie."
msgstr "OTHER: Denna björn dansar inte bara utan spinner också världens bästa skämt."

#. from yeager:scummvm
msgid "OTHER2: Hm..."
msgstr "OTHER2: Hm..."

#. from yeager:scummvm
msgid "OTHER2: Od kiedy pewien wędrowny magik chciał zabawić|nas czymś co nazywał \"Para skunksów tańczy|kankana\"..."
msgstr "OTHER2: Ända sedan en kringvandrande trollkarl ville underhålla oss med något han kallade \"Ett par skunkar dansar cancan\" ...."

#. from yeager:scummvm
msgid "OTHER2: ...nie wpuszczamy zwierząt na dziedziniec."
msgstr "OTHER2: ...vi tillåter inte djur på innergården."

#. from yeager:scummvm
msgid "OTHER: Słyszałem, że król kocha dobrą zabawę, a|ten miś ma tylko jedną wadę. Patrząc jak|tańczy można pęknąć ze śmiechu."
msgstr "OTHER: Jag har hört att kungen älskar att ha roligt, och den här nallebjörnen har bara en brist. Att se honom dansa kan få dig att brista ut i skratt."

#. from yeager:scummvm
msgid "OTHER: A teraz, po tej historii z księciem..."
msgstr "OTHER: Och nu, efter historien med prinsen...."

#. from yeager:scummvm
msgid "OTHER2: I ja o tym myślę."
msgstr "OTHER2: Och jag tänker på det."

#. from yeager:scummvm
msgid "OTHER2: Dlatego chyba zrobię wyjątek."
msgstr "OTHER2: Det är därför jag tror att jag kommer att göra ett undantag."

#. from yeager:scummvm
msgid "OTHER2: Tylko nie bądźcie zbyt nachalni."
msgstr "OTHER2: Var bara inte för påträngande."

#. from yeager:scummvm
msgid "OTHER: Przyprowadziłem dar dla króla."
msgstr "OTHER: Jag har tagit med en gåva till kungen."

#. from yeager:scummvm
msgid "OTHER2: Kiepski pomysł. Niedźwiedź mu syna|nie zastąpi."
msgstr "OTHER2: Dålig idé. Björnen kommer inte att ersätta sin son."

#. from yeager:scummvm
msgid "OTHER: Ale na chwilę odepchnie troski."
msgstr "OTHER: Men det kommer att skjuta bort bekymmerna ett tag."

#. from yeager:scummvm
msgid "OTHER: Mój podopieczny rozweselił kiedyś nawet|meble u maga Fraeda."
msgstr "OTHER: Min skyddsling har en gång till och med muntrat upp möblemanget på Fraed-magasinet."

#. from yeager:scummvm
msgid "OTHER: Tańczące krzesła, to niezapomniany widok,|mój dobry człowieku."
msgstr "OTHER: Dansande stolar, det är en oförglömlig syn, min gode man."

#. from yeager:scummvm
msgid "OTHER: Potem się okazało, że to byli zaczarowani|dłużnicy Fraeda. Nie na darmo nazywaliśmy|go Pomysłowym."
msgstr "OTHER: Det visade sig senare att de var Fraeds förtrollade gäldenärer. Det var inte för inte som vi kallade honom Ingenious."

#. from yeager:scummvm
msgid "OTHER: Ale to już inna historia."
msgstr "OTHER: Men det är en annan historia."

#. from yeager:scummvm
msgid "OTHER2: W porządku."
msgstr "OTHER2: Okej."

#. from yeager:scummvm
msgid "OTHER2: Możesz zostać."
msgstr "OTHER2: Du kan stanna."

#. from yeager:scummvm
msgid "OTHER: Ale nie jestem tu tylko dla zabawy..."
msgstr "OTHER: Men jag är inte bara här för skojs skull...."

#. from yeager:scummvm
msgid "OTHER: Jakoś trzeba zarabiać na życie."
msgstr "OTHER: Man måste ju försörja sig på något sätt."

#. from yeager:scummvm
msgid "OTHER2: Widzisz ten skarbiec?"
msgstr "OTHER2: Ser du det här valvet?"

#. from yeager:scummvm
msgid "OTHER: Nasz król jest może nieszczęśliwy, ale|na pewno jest bardzo bogaty."
msgstr "OTHER: Vår kung kanske är olycklig, men han är verkligen mycket rik."

#. from yeager:scummvm
msgid "OTHER: Na razie jednak zapraszam na ucztę."
msgstr "OTHER: För tillfället bjuder jag dock in er till en festmåltid."

#. from yeager:scummvm
msgid "OTHER: Właśnie trwa biesiada na cześć Czarnego|Rycerza."
msgstr "OTHER: En fest till den svarte riddarens ära pågår."

#. from yeager:scummvm
msgid "OTHER: Wygrał co prawda walkowerem, ale|jednak."
msgstr "OTHER: Han vann visserligen genom en walkover."

#. from yeager:scummvm
msgid "OTHER: Idź tam razem z paziem, przedstawi cię|i za kilka godzin zabawisz króla."
msgstr "OTHER: Åk dit tillsammans med maken, han kommer att presentera dig och om några timmar kommer du att underhålla kungen."

#. from yeager:scummvm
msgid "OTHER2: Znakomicie."
msgstr "OTHER2: Utmärkt."

#. from yeager:scummvm
msgid "OTHER: Tylko swojego pupilka..."
msgstr "OTHER: Bara ditt husdjur..."

#. from yeager:scummvm
msgid "OTHER2: ...zostawiam tutaj."
msgstr "...jag lämnar den här."

#. from yeager:scummvm
msgid "OTHER2: Oczywiście."
msgstr "OTHER2: Naturligtvis."

#. from yeager:scummvm
msgid "OTHER: Mała drzemka przed pokazem|nie zaszkodzi..."
msgstr "OTHER: En liten tupplur före föreställningen hade inte skadat...."

#. from yeager:scummvm
msgid "OTHER: To ty, drogi kuzynku?"
msgstr "OTHER: Är det du, kära kusin?"

#. from yeager:scummvm
msgid "OTHER: Tata mówił, że przyjedziesz."
msgstr "OTHER: Pappa sa att du skulle komma."

#. from yeager:scummvm
msgid "OTHER: Wciąż taki nieśmiały?"
msgstr "OTHER: Fortfarande så blyg?"

#. from yeager:scummvm
msgid "OTHER: Podejdź bliżej, bo mam słaby|wzrok."
msgstr "OTHER: Kom närmare eftersom min syn är dålig."

#. from yeager:scummvm
msgid "OTHER: Przywitaj kuzyneczkę Sheilę."
msgstr "OTHER: Säg hej till kusin Sheila."

#. from yeager:scummvm
msgid "OTHER: Czy mi się wydaje, czy w końcu|zaczęły ci rosnąć włosy na|brodzie?"
msgstr "OTHER: Är det bara inbillning eller har du äntligen börjat få hår på skägget?"

#. from yeager:scummvm
msgid "$0: Dobrze, że lustra nie pękają od brzydoty."
msgstr "$0: Det är tur att speglar inte spricker av fulhet."

#. from yeager:scummvm
msgid "$1: Czy na mycie nosa zużywasz całe mydło?"
msgstr "$1: Använder du all tvål för att tvätta näsan?"

#. from yeager:scummvm
msgid "$2: Magiczne operacje plastyczne są ponoć tanie."
msgstr "$2: Magisk plastikkirurgi sägs vara billig."

#. from yeager:scummvm
msgid "$3: Koniec zabawy, ściągaj maskę."
msgstr "$3: Inget mer kul, ta av dig masken."

#. from yeager:scummvm
msgid "OTHER: I głos ci się obniżył."
msgstr "OTHER: Och din röst har sänkts."

#. from yeager:scummvm
msgid "OTHER: Och to cudownie!"
msgstr "OTHER: Åh, det är underbart!"

#. from yeager:scummvm
msgid "OTHER: Robi się z ciebie prawdziwy|mężczyzna!#B0"
msgstr "OTHER: Du börjar bli en riktig man!#B0"

#. from yeager:scummvm
msgid "OTHER: Myślałam, że wzrok mam popsuty,|ale słyszę, że i z uszami nie|najlepiej."
msgstr "OTHER: Jag trodde att min syn var dålig, men jag har hört att mina öron inte heller är så bra."

#. from yeager:scummvm
msgid "OTHER: Chyba mówisz z pełną buzią. To|bardzo nieładnie, kuzynku.#B0"
msgstr "OTHER: Jag tror att du pratar med full mun. Det är inte så snällt, kusin"

#. from yeager:scummvm
msgid "OTHER: Podobają mi się te okrzyki zachwytu."
msgstr "OTHER: Jag gillar dessa rop av förtjusning."

#. from yeager:scummvm
msgid "OTHER: Przyznasz, że z wiekiem staję się|coraz ładniejsza?...#B0"
msgstr "OTHER: Erkänner du att jag blir vackrare med åldern?...#B0"

#. from yeager:scummvm
msgid "OTHER: Pocałowałabym cię na przywitanie, kuzynie,|ale musisz się ładnie wystroić. Lubię|zadbanych mężczyzn."
msgstr "OTHER: Jag skulle kyssa dig hej, kusin, men du måste klä upp dig snyggt. Jag gillar välvårdade män."

#. from yeager:scummvm
msgid "OTHER: Nie lubię pedantów, ale za niechlujami|też nie przepadam."
msgstr "OTHER: Jag tycker inte om pedanter, men jag tycker inte om slashasar heller."

#. from yeager:scummvm
msgid "HERO: Grrhhl..."
msgstr "HERO: Grrhhl..."

#. from yeager:scummvm
msgid "HERO: Urgggh..."
msgstr "HERO: Urgggh..."

#. from yeager:scummvm
msgid "HERO: Harrrghl..."
msgstr "HERO: Harrrghl..."

#. from yeager:scummvm
msgid "OTHER: Mmm..."
msgstr "OTHER: Mmm..."

#. from yeager:scummvm
msgid "OTHER: Lubię owłosionych mężczyzn, kuzynie, bo nie|ma to jak zatopić zgrabne paluszki w gęstym|futrze."
msgstr "OTHER: Jag gillar håriga män, kusin, eftersom det inte finns något som att sjunka dina glatta fingrar i en tjock päls."

#. from yeager:scummvm
msgid "OTHER: Witaj!"
msgstr "OTHER: Välkommen!"

#. from yeager:scummvm
msgid "HERO: Grrrrlll!..."
msgstr "HERO: Grrrrlll!...."

#. from yeager:scummvm
msgid "OTHER: Jakim cudem?..."
msgstr "OTHER: Hur kan..."

#. from yeager:scummvm
msgid "OTHER: Zresztą nieważne, twoje wrzaski|na pewno przywołają strażników."
msgstr "OTHER: Hur som helst, glöm det, dina skrik kommer säkert att kalla på vakterna."

#. from yeager:scummvm
msgid "OTHER: L'ours!"
msgstr "OTHER: L'ours!"

#. from yeager:scummvm
msgid "OTHER: Obudził mnie jakiś ryk..."
msgstr "OTHER: Jag vaknade av ett vrål...."

#. from yeager:scummvm
msgid "OTHER2: Cóż, mój przyjaciel widocznie musi|załatwić swoje przyziemne potrzeby."
msgstr "OTHER2: Min vän behöver tydligen lösa sina vardagliga behov."

#. from yeager:scummvm
msgid "OTHER: Przyziemne?"
msgstr "OTHER: Jordat?"

#. from yeager:scummvm
msgid "OTHER2: Jeśli go zaraz wyprowadzę, to będą|przyziemne, a jeśli jeszcze chwilę|tu postoi, to będą przykamienne."
msgstr "OTHER2: Om jag tar ut honom direkt kommer de att vara överjordiska, och om han stannar ett tag längre kommer de att vara överjordiska."

#. from yeager:scummvm
msgid "OTHER2: A ostrzegam, że niedźwiedź dzisiaj|BARDZO dużo zjadł..."
msgstr "OTHER2: Och varning för att björnen idag|har ätit MYCKET mycket...."

#. from yeager:scummvm
msgid "OTHER: No to sio stąd, ale szybko!"
msgstr "OTHER: Tja, ut härifrån, men snabbt!"

#. from yeager:scummvm
msgid "OTHER: Na pewno oddałem ci wszystkie|rzeczy?"
msgstr "OTHER: Är du säker på att jag gav dig alla grejer?"

#. from yeager:scummvm
msgid "HERO: Tak, sprawdziłem dokładnie."
msgstr "HERO: Ja, jag kollade noga."

#. from yeager:scummvm
msgid "OTHER: Dobrze. Ale zaraz: jakim cudem w zamku|stałeś się znowu człowiekiem?"
msgstr "Okej. Men genast: hur i hela friden blev du människa igen?"

#. from yeager:scummvm
msgid "HERO: To bolesna historia."
msgstr "HERO: Det är en smärtsam historia."

#. from yeager:scummvm
msgid "HERO: Cieszę się, że przynajmniej ty|nie musiałeś mnie całowa..."
msgstr "HERO: Jag är glad att du åtminstone inte behövde kyssa mig...."

#. from yeager:scummvm
msgid "HERO: Łup, chyba się wygadałem."
msgstr "Booty, jag tror jag har övertalat mig själv att inte göra det."

#. from yeager:scummvm
msgid "OTHER: Ktoś cię całował? Wspaniale, chłopcze!"
msgstr "Någon kysste dig? Bra, grabben!"

#. from yeager:scummvm
msgid "OTHER: Ach tak, następny skutek uboczny."
msgstr "OTHER: Ah ja, ännu en biverkning."

#. from yeager:scummvm
msgid "OTHER: Wystarczy pocałunek. Zapomniałem.|Muszę lecieć. Pa. Do zobaczenia.|Na razie. Trzymaj się."
msgstr "Bara en kyss. Jag glömde. Jag måste gå. Hej då. Hej då. Vi ses senare.Hej då. Ta hand om dig."

#. from yeager:scummvm
msgid "OTHER: Zastanów się jeszcze."
msgstr "OTHER: Tänk om."

#. from yeager:scummvm
msgid "OTHER: Ten demon nie wygląda zbyt przyjaźnie."
msgstr "OTHER: Den här demonen ser inte särskilt vänlig ut."

#. from yeager:scummvm
msgid "OTHER: Szczerze mówiąc, trochę się boję."
msgstr "OTHER: Ärligt talat är jag lite rädd."

#. from yeager:scummvm
msgid "HERO: Hm."
msgstr "HERO: Hm."

#. from yeager:scummvm
msgid "HERO: Znalazłem w zamku Fjord pewną księgę."
msgstr "HERO: Jag hittade en viss bok i Fjord Castle."

#. from yeager:scummvm
msgid "HERO: Pomyślałem, że może cię zainteresować."
msgstr "HERO: Jag tänkte att du kanske var intresserad."

#. from yeager:scummvm
msgid "OTHER: To tom poświęcony szarej magii, czyli|czarom pozornie neutralnym wobec|dobra czy zła."
msgstr "OTHER: Detta är en volym som ägnas åt grå magi, det vill säga magi som till synes är neutral i förhållande till gott eller ont."

#. from yeager:scummvm
msgid "OTHER: Bardzo ciekawe, większość zaklęć|jest mi nie znana."
msgstr "OTHER: Mycket intressant, de flesta trollformlerna är okända för mig."

#. from yeager:scummvm
msgid "HERO: Coś ciekawego?"
msgstr "HERO: Något intressant?"

#. from yeager:scummvm
msgid "OTHER: Bardzo interesujące."
msgstr "OTHER: Mycket intressant."

#. from yeager:scummvm
msgid "OTHER: Większość czarów wymaga długich studiów."
msgstr "OTHER: De flesta besvärjelser kräver långvariga studier."

#. from yeager:scummvm
msgid "OTHER: Na przykład zamiana brylantów w węgiel.|Odwrotnie, banał, a tu proszę..."
msgstr "OTHER: Till exempel att förvandla diamanter till kol. Motsatsen, en kliché, och här har du det...."

#. from yeager:scummvm
msgid "OTHER: Pozwolisz, że wrócę do lektury."
msgstr "OTHER: Låt mig gå tillbaka till läsningen."

#. from yeager:scummvm
msgid "HERO: Nie chcę mu przeszkadzać, zanim nie|będę dokładnie wiedział, w czym ta|księga może mi pomóc."
msgstr "HERO: Jag vill inte störa honom innan jag vet exakt vad den här boken kan hjälpa mig med."

#. from yeager:scummvm
msgid "HERO: Czy poznałeś kiedyś Pana Słońce?"
msgstr "HERO: Har du någonsin träffat Mr Sun?"

#. from yeager:scummvm
msgid "OTHER: Och, kiedyś mieliśmy okazję się spotkać."
msgstr "OTHER: Åh, vi brukade ha möjlighet att träffas."

#. from yeager:scummvm
msgid "OTHER: Co chciałbyś wiedzieć?"
msgstr "OTHER: Vad skulle du vilja veta?"

#. from yeager:scummvm
msgid "$0: Jak się do niego dostać?"
msgstr "$0: Hur kommer man till det?"

#. from yeager:scummvm
msgid "$1: Znasz go osobiście?"
msgstr "$1: Känner du honom personligen?"

#. from yeager:scummvm
msgid "$2: Kim on jest?"
msgstr "$2: Vem är han?"

#. from yeager:scummvm
msgid "$3: Naukowe."
msgstr "3 dollar: Vetenskaplig."

#. from yeager:scummvm
msgid "$4: Po ludzku."
msgstr "$4: I mänskliga termer."

#. from yeager:scummvm
msgid "OTHER: To bardzo proste.#X1"
msgstr "OTHER: Det är mycket enkelt.#X1"

#. from yeager:scummvm
msgid "OTHER: Prosiłem go kiedyś, by poświecił mocniej|nad krasnoludzkimi kopalniami Ghorlargu.|Bardzo niemiłe miejsce."
msgstr "OTHER: Jag bad honom en gång att lysa hårdare över dvärggruvorna i Ghorlarg, en mycket obehaglig plats."

#. from yeager:scummvm
msgid "OTHER: Była tam fabryka krasnoludzkiego spirytusu,|i kiedy kadź pękła, wszyscy zostali zalani."
msgstr "OTHER: Det fanns en dvärgspritfabrik, och när karet gick sönder blev alla översvämmade."

#. from yeager:scummvm
msgid "OTHER: Zalani dosłownie i w przenośni."
msgstr "OTHER: Översvämmad bokstavligen och bildligt talat."

#. from yeager:scummvm
msgid "OTHER: I nikt nie mógł znaleźć drogi do|wyjścia, a w środku było mało|powietrza."
msgstr "OTHER: Och ingen kunde hitta vägen ut, och det fanns lite luft inuti."

#. from yeager:scummvm
msgid "OTHER: Nie można było wejść z pochodniami,|bo groziło to wybuchem."
msgstr "OTHER: Det var inte möjligt att gå in med facklor, eftersom det fanns risk för explosion."

#. from yeager:scummvm
msgid "OTHER: Reszty już się domyślasz.#B0"
msgstr "OTHER: Du har redan gissat resten.#B0"

#. from yeager:scummvm
msgid "OTHER: Jakie chcesz wyjaśnienie, naukowe|czy zrozumiałe?#B1"
msgstr "OTHER: Vilken förklaring vill du ha, vetenskapligt förståelig? #B1"

#. from yeager:scummvm
msgid "OTHER: Steruje centralną gwiazdą naszego|systemu planetarnego, zwaną|popularnie Słońcem.#B0"
msgstr "OTHER: Kontrollerar centralstjärnan i vårt planetsystem, allmänt känd som solen.#B0"

#. from yeager:scummvm
msgid "OTHER: Steruje tym małym, żółtym kółeczkiem,|od patrzenia w które bolą oczka.#B0"
msgstr "OTHER: Kontrollerar den lilla gula cirkeln som gör ont i ögonen när man tittar på den #B0"

#. from yeager:scummvm
msgid "HERO: Wyrwałeś kartkę z książki?!"
msgstr "HERO: Du rev ut en sida ur en bok!"

#. from yeager:scummvm
msgid "OTHER: Księga to narzędzie, a nie cel|sam w sobie."
msgstr "OTHER: Boken är ett verktyg, inte ett självändamål."

#. from yeager:scummvm
msgid "OTHER: To prosty czar. Nie wiedziałem wcześniej,|że można skrócić drogę do Pana Słońce."
msgstr "Det är en enkel trollformel. Jag visste inte förut att man kan ta en genväg till Solens herre."

#. from yeager:scummvm
msgid "HERO: Skrócić?"
msgstr "HERO: Shorten?"

#. from yeager:scummvm
msgid "OTHER: Zwykle można tam się dostać tylko|drogą magiczną."
msgstr "OTHER: Vanligtvis kan man bara ta sig dit med magi."

#. from yeager:scummvm
msgid "OTHER: Ten czar tworzy coś w rodzaju|miejsca przenosin."
msgstr "OTHER: Denna besvärjelse skapar något av en rörelse."

#. from yeager:scummvm
msgid "HERO: Dzięki."
msgstr "HERO: Tack."

#. from yeager:scummvm
msgid "HERO: Widzę, że schowałeś księgę.|Koniec studiów?"
msgstr "HERO: Jag ser att du har lagt undan boken. Är du klar med dina studier?"

#. from yeager:scummvm
msgid "OTHER: Nauka jest wieczna, a piwo wietrzeje."
msgstr "OTHER: Vetenskapen är evig och öl är förgänglig."

#. from yeager:scummvm
msgid "OTHER: \"Nikt cię tu nie chciał ani zapraszał|Rozgniewasz mnie nie na żarty|Wysil więc rozum i daj mi dowód|Żeś czasu mego jest warty.\""
msgstr "OTHER: \"Ingen ville ha dig här eller bjöd in dig hit och du gör mig otroligt arg, så bestäm dig och bevisa för mig att du är värd min tid.\""

#. from yeager:scummvm
msgid "OTHER: \"Wskaż moich braci\"."
msgstr "OTHER: \"Peka ut mina bröder\"."

#. from yeager:scummvm
msgid "OTHER: \"Wskaż wrogów Ziemi\"."
msgstr "OTHER: \"Hitta jordens fiender\"."

#. from yeager:scummvm
msgid "OTHER: \"Wskaż moich przyjaciół\"."
msgstr "OTHER: \"Peka ut mina vänner\"."

#. from yeager:scummvm
msgid "HERO: Wskaż moich braci?..."
msgstr "HERO: Peka ut mina bröder? ...."

#. from yeager:scummvm
msgid "HERO: Wskaż wrogów Ziemi?..."
msgstr "HERO: peka ut jordens fiender?..."

#. from yeager:scummvm
msgid "HERO: Wskaż moich przyjaciół?..."
msgstr "HERO: Peka ut mina vänner? ...."

#. from yeager:scummvm
msgid "HERO: Przepraszam, Panie Słońce, czy mógłbyś podarować|trochę swego cennego czasu?"
msgstr "HERO: Ursäkta mig, Mr Sun, kan du donera lite av din dyrbara tid?"

#. from yeager:scummvm
msgid "OTHER: Mmmm... Znowu..."
msgstr "OTHER: Mmmm... Igen..."

#. from yeager:scummvm
msgid "OTHER: To już drugi w ciągu ostatniego tysiąclecia."
msgstr "OTHER: Detta är den andra under det senaste årtusendet."

#. from yeager:scummvm
msgid "OTHER: O co chodzi?"
msgstr "OTHER: Vad handlar den om?"

#. from yeager:scummvm
msgid "$0: Jest taki zamek spowity wiecznymi ciemnościami..."
msgstr "$0: Det finns ett slott som är höljt i evigt mörker...."

#. from yeager:scummvm
msgid "$4: Ale tam musi stać się dzień!"
msgstr "$4: Men det är där en dag måste hända!"

#. from yeager:scummvm
msgid "$1: Drugi? A kto był przede mną?"
msgstr "$1: Andra? Och vem var före mig?"

#. from yeager:scummvm
msgid "$2: Bardzo miło."
msgstr "$2: Mycket trevligt."

#. from yeager:scummvm
msgid "$3: Przepraszam za kłopot, na razie to wszystko."
msgstr "$3: Ledsen för besväret, det är allt för nu."

#. from yeager:scummvm
msgid "OTHER: O nie, tylko nie Fjord..."
msgstr "OTHER: Åh nej, bara inte Fjord...."

#. from yeager:scummvm
msgid "HERO: Skąd pan wie?!"
msgstr "HERO: Hur vet du det!"

#. from yeager:scummvm
msgid "OTHER: Bo to jedyne miejsce na świecie, gdzie|nie dochodzi Słońce podczas swojej|normalnej wędrówki."
msgstr "OTHER: För att det är den enda plats i världen dit solen inte når under sin normala vandring."

#. from yeager:scummvm
msgid "HERO: I zawsze tak było?"
msgstr "HERO: Och har det alltid varit så här?"

#. from yeager:scummvm
msgid "OTHER: Oczywiście, że nie zawsze! Co za pytanie!"
msgstr "OTHER: Naturligtvis inte alltid! Vilken fråga!"

#. from yeager:scummvm
msgid "OTHER: Od kilkuset lat, a może dłużej hmm... żyje tam|sprytny nekromanta, którego czary spowodowały|ten godny pożałowania incydent."
msgstr "OTHER: I flera hundra år, eller kanske längre hmm... har det bott en listig nekromantiker där vars trolldom orsakade denna beklagliga händelse."

#. from yeager:scummvm
msgid "HERO: Co do nekromanty, to czas teraźniejszy|jest już chyba nieaktualny."
msgstr "HERO: När det gäller nekromantikern är presens förmodligen redan föråldrat."

#. from yeager:scummvm
msgid "HERO: Co do Fjord, nie ma szans, żeby tam|wpuścić trochę światła?"
msgstr "HERO: När det gäller Fjord, finns det ingen chans att släppa in lite ljus där?"

#. from yeager:scummvm
msgid "OTHER: Jest, ale do tego musiałby być spełniony|pewien niesamowicie trudny warunek."
msgstr "OTHER: Det är det, men för det krävs att ett otroligt svårt villkor uppfylls."

#. from yeager:scummvm
msgid "HERO: Jaki? Zgadzam się z góry na wszystko!"
msgstr "HERO: Vad? Jag samtycker i förväg till allt!"

#. from yeager:scummvm
msgid "OTHER: Musiałoby mi się chcieć."
msgstr "OTHER: Jag skulle behöva vilja det."

#. from yeager:scummvm
msgid "P#HERO: A konkretnie?"
msgstr "P#HERO: Och specifikt?"

#. from yeager:scummvm
msgid "OTHER: Szczerze mówiąc, nawet mi się nie chce|mówić o tym, dlaczego mi się nic nie chce."
msgstr "OTHER: Ärligt talat vill jag inte ens prata om varför jag inte vill göra någonting."

#. from yeager:scummvm
msgid "OTHER: Więc pozwól mi drzemać dalej.#E4#B0"
msgstr "OTHER: Så låt mig snooza på.#E4#B0"

#. from yeager:scummvm
msgid "OTHER: Był taki jeden wielki czarodziej, który chciał|znaleźć legendarne źródło spirytusu|w opuszczonej kopalni krasnoludzkiej."
msgstr "OTHER: Det var en stor trollkarl som ville hitta en legendarisk andekälla i en övergiven dvärggruva."

#. from yeager:scummvm
msgid "OTHER: Zrobili z kumplami wyprawę, ale jak jeden|wszedł do środka z pochodnią, to od oparów był|wybuch i zostały z niego sznurówki."
msgstr "OTHER: De gjorde en expedition med sina kompisar, men när en av dem gick in med en ficklampa exploderade ångorna och strängar blev kvar."

#. from yeager:scummvm
msgid "OTHER: Więc wymarudził u mnie oświetlenie jaskiń,|a że miał argumenty, to się zgodziłem."
msgstr "OTHER: Så han gjorde en ursäkt med mig för att tända grottorna,och eftersom han hade argument, gick jag med på det."

#. from yeager:scummvm
msgid "HERO: Jakie argumenty?"
msgstr "HERO: Vilka argument?"

#. from yeager:scummvm
msgid "OTHER: Podzielił się ze mną tym szlachetnym|trunkiem, i jeszcze dołożył magiczny|most."
msgstr "OTHER: Han delade den här ädla stammen med mig, och lade ändå till en magisk mest."

#. from yeager:scummvm
msgid "OTHER: Tak, tak, Awiwat to specjalista od|zabezpieczeń."
msgstr "OTHER: Ja, ja, Avivat är en säkerhetsspecialist."

#. from yeager:scummvm
msgid "HERO: Awiwat? Może Arivald?"
msgstr "Avivat? Arivald, kanske?"

#. from yeager:scummvm
msgid "OTHER: Może i Aribalt, nie pamiętam.#B0"
msgstr "OTHER: Kanske Aribalt, jag minns inte.#B0"

#. from yeager:scummvm
msgid "OTHER: Wszystko może się znudzić, mój|chłopcze."
msgstr "OTHER: Allt kan bli tråkigt, min pojke."

#. from yeager:scummvm
msgid "OTHER: Nawet szemrzący strumyk, zielone|drzewa i soczyste owoce."
msgstr "OTHER: Till och med en porlande bäck, gröna träd och saftig frukt."

#. from yeager:scummvm
msgid "HERO: Ale te dwie piękne istoty|z wachlarzami..."
msgstr "HERO: Men dessa två vackra varelser|med fans...."

#. from yeager:scummvm
msgid "OTHER: Nawet i one. Nawet i one..."
msgstr "OTHER: Även dem. Till och med de..."

#. from yeager:scummvm
msgid "P#HERO: Mam to jeszcze przed sobą.#B0"
msgstr "P#HERO: Jag har det fortfarande framför mig.#B0"

#. from yeager:scummvm
msgid "OTHER: Tu na górę dochodzi niewiele dźwięków.|Jestem spragniony muzyki."
msgstr "OTHER: Det finns få ljud här uppe.jag törstar efter musik."

#. from yeager:scummvm
msgid "OTHER: Tak, muuuzyka."
msgstr "OTHER: Ja, musa."

#. from yeager:scummvm
msgid "OTHER: Ale ludzka mowa to nie jest to, co|tygrysy lubią najbardziej."
msgstr "OTHER: Men mänskligt tal är inte det som tigrar gillar bäst."

#. from yeager:scummvm
msgid "OTHER: Więc nie musisz szybko wracać.#E3"
msgstr "OTHER: Så att du inte behöver gå tillbaka snart.#E3"

#. from yeager:scummvm
msgid "OTHER: Ja nic nie muszę."
msgstr "OTHER: Jag behöver inte göra någonting."

#. from yeager:scummvm
msgid "OTHER: A jak jeszcze raz wrzaśniesz, to|spopielę cię i rzucę jako nawóz|dla trolli.#B0"
msgstr "OTHER: Och om du skriker igen kommer jag att bränna dig och kasta dig som gödningsmedel för trollen.#B0"

#. from yeager:scummvm
msgid "HERO: Hi babe..."
msgstr "HERO: Hej älskling..."

#. from yeager:scummvm
msgid "HERO: Gdybym powiedział ci o czym myślę pewnie|byś się obraziła."
msgstr "HERO: Om jag berättade för dig vad jag tänkte på skulle du förmodligen bli förolämpad."

#. from yeager:scummvm
msgid "OTHER: Czego?"
msgstr "Vad?"

#. from yeager:scummvm
msgid "OTHER: Akwizytorom łamię karki,|a żebrakami karmię psy."
msgstr "OTHER: Jag bryter nacken av dörrknackare och matar tiggare med hundar."

#. from yeager:scummvm
msgid "OTHER: Jakieś pytania?"
msgstr "OTHER: Några frågor?"

#. from yeager:scummvm
msgid "OTHER: Co jest, zapomniałeś języka|w gębie?"
msgstr "OTHER: Vad är det, har du glömt din tunga?"

#. from yeager:scummvm
msgid "OTHER: Znowu!?"
msgstr "OTHER: Igen!?"

#. from yeager:scummvm
msgid "P#HERO: Khm."
msgstr "P#HERO: Khm."

#. from yeager:scummvm
msgid "$0: Jestem księciem."
msgstr "$0: Jag är en prins."

#. from yeager:scummvm
msgid "$1: Zapukałem tak tylko, z ciekawości."
msgstr "$1: Jag knackade bara så där, av ren nyfikenhet."

#. from yeager:scummvm
msgid "$2: Mogę wejść?"
msgstr "$2: Kan jag komma in?"

#. from yeager:scummvm
msgid "$3: Do widzenia."
msgstr "3 dollar: Adjö."

#. from yeager:scummvm
msgid "OTHER: Tylko dlatego jeszcze żyjesz."
msgstr "OTHER: Det är enda anledningen till att du fortfarande är vid liv."

#. from yeager:scummvm
msgid "OTHER: A teraz poszedł stąd!"
msgstr "OTHER: Och nu är han borta!"

#. from yeager:scummvm
msgid "OTHER: Ciekawość to pierwszy stopień|do Piekła."
msgstr "OTHER: Nyfikenhet är den första graden av helvetet."

#. from yeager:scummvm
msgid "HERO: Kiedy ja właśnie chcę do Piekła!"
msgstr "HERO: När jag bara vill åka till helvetet!"

#. from yeager:scummvm
msgid "P#OTHER: Chyba już wolę akwizytorów, niż|idiotów."
msgstr "P#OTHER: Jag tror att jag redan föredrar dörrknackare framför idioter."

#. from yeager:scummvm
msgid "OTHER: Tylko spróbuj, to wyjdziesz stąd|nogami do przodu."
msgstr "OTHER: Försök bara, så kommer du ut härifrån."

#. from yeager:scummvm
msgid "#E3"
msgstr "#E3"

#. from yeager:scummvm
msgid "OTHER: \"Dłoń ma, co jeszcze dotyku twego nie znała| Nieśmiała, lecz ogniem dzikim płonąca| Sunie po aksamicie cudnego ciała| Ja modlę się, by pieściła cię bez końca!\""
msgstr "\"Handen som ännu inte har känt din beröring, blyg men vilt brinnande, glider över sammeten på din vackra kropp, jag ber att den smeker dig i all oändlighet!\""

#. from yeager:scummvm
msgid "OTHER: Zatłukę tego małego gnojka!"
msgstr "OTHER: Jag ska slå ner den lilla jäveln!"

#. from yeager:scummvm
msgid "OTHER: Koniec z wysłuchiwaniem rzępolenia!"
msgstr "OTHER: Sluta lyssna på gnällspikarna!"

#. from yeager:scummvm
msgid "OTHER: Koniec z lutnią-samograjką!"
msgstr "OTHER: Inget mer lutspelande!"

#. from yeager:scummvm
msgid "OTHER: Koniec z praniem skarpetek!"
msgstr "OTHER: Inget mer tvättande av strumpor!"

#. from yeager:scummvm
msgid "OTHER: Koniec z gotowaniem rosołu na kaca!"
msgstr "OTHER: Ingen mer baksmälla med buljong!"

#. from yeager:scummvm
msgid "OTHER: Żeby tu więcej jego brudna stopa|nie postała!"
msgstr "OTHER: Så inget mer av hans smutsiga fot här!"

#. from yeager:scummvm
msgid "HERO: Na razie nie muszę mu o niczym mówić."
msgstr "HERO: Jag behöver inte berätta något för honom just nu."

#. from yeager:scummvm
msgid "HERO: Trzeba jakoś wykorzystać tę sytuację|dla siebie."
msgstr "HERO: Du måste använda situationen på något sätt för dig själv."

#. from yeager:scummvm
msgid "HERO: Mój drogi, mam dla ciebie dwie wiadomości.|Jedną dobrą, a drugą złą."
msgstr "HERO: Min kära, jag har två meddelanden till dig. Ett bra och ett dåligt."

#. from yeager:scummvm
msgid "HERO: Dobra jest taka, że twoja urocza żona|jest teraz w domu."
msgstr "HERO: Det som är bra är att din underbara fru nu är hemma."

#. from yeager:scummvm
msgid "HERO: Zła, iż wszystkie twoje rzeczy są na|zewnątrz twojego domu."
msgstr "HERO: Arg för att alla dina saker finns på insidan av ditt hus."

#. from yeager:scummvm
msgid "OTHER: To twój kolejny dowcip, panie?"
msgstr "OTHER: Är det här ännu ett skämt av er, mina damer?"

#. from yeager:scummvm
msgid "OTHER: Zemsta za ten żartobliwy poemat|o tobie i Kornelii?"
msgstr "OTHER: Hämnd för den humoristiska dikten om dig och Cornelia?"

#. from yeager:scummvm
msgid "HERO: Nie, nie, to poważna sprawa."
msgstr "HERO: Nej, nej, det här är en allvarlig sak."

#. from yeager:scummvm
msgid "HERO: Ponoć wpadł jej w ręce jakiś twój|miłosny poemat."
msgstr "HERO: Tydligen har några av dina kärleksdikter hamnat i hennes händer."

#. from yeager:scummvm
msgid "HERO: Coś o dzikim ogniu i pieszczeniu ciała."
msgstr "HERO: Något om skogsbrand och smekning av kroppen."

#. from yeager:scummvm
msgid "OTHER: Och nie!"
msgstr "OTHER: Åh nej!"

#. from yeager:scummvm
msgid "OTHER: Jestem poetą."
msgstr "OTHER: Jag är poet."

#. from yeager:scummvm
msgid "OTHER: Poeta nie musi zwracać się do konkretnej osoby,|lecz może przemawiać do wyimaginowanej kochanki,|która jest jedynie wytworem jego wyobraźni."
msgstr "OTHER: Poeten behöver inte vända sig till en specifik person, utan kan tala till en imaginär älskare, som bara är ett fantasifoster."

#. from yeager:scummvm
msgid "OTHER: Więc jednak to nie żart, ale smutna|rzeczywistość."
msgstr "OTHER: Så det är inte ett skämt trots allt, utan en sorglig verklighet."

#. from yeager:scummvm
msgid "OTHER: Mam niejasne wrażenie, że chyba|książę maczał w tym palce."
msgstr "OTHER: Jag har en vag känsla av att jag tror att prinsen hade sina fingrar med i spelet."

#. from yeager:scummvm
msgid "OTHER: Wiedziałam, że przypełzniesz, ty|mały piszczący robaczku!"
msgstr "OTHER: Jag visste att du skulle komma krypande, din lilla pipande mask!"

#. from yeager:scummvm
msgid "OTHER: Zabieraj swoje łachy i won!"
msgstr "OTHER: Ta dina trasor och gå!"

#. from yeager:scummvm
msgid "OTHER: Ależ kochanie, nastąpiła horrendalna|pomył..."
msgstr "OTHER: Men, kära läsare, det har skett ett fruktansvärt misstag...."

#. from yeager:scummvm
msgid "OTHER2: Zawsze wiedziałam, że zadajesz się|z ladacznicami!"
msgstr "OTHER2: Jag har alltid vetat att du umgås med snyggingar!"

#. from yeager:scummvm
msgid "OTHER: Ależ kruszynko..."
msgstr "OTHER: Men smuligt..."

#. from yeager:scummvm
msgid "OTHER2: Morda!..."
msgstr "OTHER2: Morda!..."

#. from yeager:scummvm
msgid "OTHER2: Ja mówię."
msgstr "OTHER2: Jag säger."

#. from yeager:scummvm
msgid "OTHER2: Jak śmiesz mi się sprzeciwiać!"
msgstr "OTHER2: Hur vågar du säga emot mig!"

#. from yeager:scummvm
msgid "OTHER: To był poemat o tobie, cukiereczku!"
msgstr "OTHER: Det var en dikt om dig, sötnos!"

#. from yeager:scummvm
msgid "OTHER: Tylko o tobie..."
msgstr "OTHER: Bara om dig..."

#. from yeager:scummvm
msgid "OTHER: Wymówka już gotowa, cwaniaku!"
msgstr "OTHER: Ursäkten är redan på plats, smartskalle!"

#. from yeager:scummvm
msgid "OTHER: Chono tutaj, nie będę cię prała|na ulicy!"
msgstr "OTHER: Chono här, jag tänker inte tvätta dig på gatan!"

#. from yeager:scummvm
msgid "OTHER: Po kilku głośnych wyzwiskach i jeszcze|głośniejszych klapsach słychać długi monolog|barda i odgłosy cmokania w policzek."
msgstr "OTHER: Efter flera högljudda utmaningar och ännu mer högljudda örfilar hörs en lång monolog och ljudet av en kyss på kinden."

#. from yeager:scummvm
msgid "OTHER: Wynagrodzę ci to, misiaczku."
msgstr "OTHER: Jag ska gottgöra dig, björn."

#. from yeager:scummvm
msgid "OTHER: Idziemy na spacerek."
msgstr "OTHER: Vi ska ta en promenad."

#. from yeager:scummvm
msgid "HERO: Kici, kici, skocz na tę szlafmycę..."
msgstr "HERO: Kisse, kisse, hoppa på den där morgonrocken...."

#. from yeager:scummvm
msgid "HERO: Szlafmyca, kici, kici, szlafmyca..."
msgstr "Stroboskop, kisse, kisse, stroboskop..."

#. from yeager:scummvm
msgid "HERO: Skocz na szlafmycę, sierściuchu!"
msgstr "Hoppa på morgonrocken, pälsboll!"

#. from yeager:scummvm
msgid "HERO: Szlafmyca, ty tłuściochu!"
msgstr "HERO: En badrock, ditt feta kräk!"

#. from yeager:scummvm
msgid "$0: Kici kici..."
msgstr "0 dollar: Kisse kisse..."

#. from yeager:scummvm
msgid "$1: Widzisz tu ptaszka, przyjacielu?"
msgstr "$1: Ser du en fågel här, min vän?"

#. from yeager:scummvm
msgid "$2: Fiu-fiu-fiu!"
msgstr "$2: Fiu-fiu-fiu!"

#. from yeager:scummvm
msgid "$3: Głupie kocisko."
msgstr "3 dollar: Dumma filt."

#. from yeager:scummvm
msgid "$5: Fiu-fiu-fiuuu!"
msgstr "5 dollar: Fiu-fiu-fiuuu!"

#. from yeager:scummvm
msgid "$6: Fiuuu-fiu-fiu!"
msgstr "$6: Fiuuu-fiu-fiu!"

#. from yeager:scummvm
msgid "$7: Fiu-fiuuu-fiu!"
msgstr "$7: Fiu-fiuuu-fiu!"

#. from yeager:scummvm
msgid "$8: FIU-FIU!"
msgstr "8 DOLLAR: FIU-FIU!"

#. from yeager:scummvm
msgid "#B1"
msgstr "#B1"

#. from yeager:scummvm
msgid "OTHER: To było przepiękne."
msgstr "OTHER: Det var vackert."

#. from yeager:scummvm
msgid "OTHER: Przepiękne..."
msgstr "OTHER: Vackert ..."

#. from yeager:scummvm
msgid "OTHER: Dawno nie słyszałem muzyki, i zapomniałem,|jak może być cudowna..."
msgstr "OTHER: Det var länge sedan jag hörde musik, och jag hade glömt hur underbart det kan vara...."

#. from yeager:scummvm
msgid "P#OTHER: Co to było, czego chciałeś, młodzieńcze?"
msgstr "Vad var det du ville, unge man?"

#. from yeager:scummvm
msgid "HERO: Chodzi o zamek Fjord, który..."
msgstr "HERON: Det handlar om Fjord Castle, som..."

#. from yeager:scummvm
msgid "OTHER: Ach tak, zalane mrokiem siedlisko zła."
msgstr "OTHER: Åh ja, ondskans mörka översvämmade hemvist."

#. from yeager:scummvm
msgid "OTHER: Zrobię, co trzeba, nie martw się."
msgstr "OTHER: Jag ska göra vad som behöver göras, oroa dig inte."

#. from yeager:scummvm
msgid "OTHER: Ale teraz naprawdę zostaw mnie już|samego, chcę sycić się wspomnieniami|dźwięków."
msgstr "OTHER: Men låt mig nu verkligen vara ifred, jag vill njuta av minnena."

#. from yeager:scummvm
msgid "OTHER: Powodzenia, chłopcze. A jak byś zobaczył|czarodzieja Arybałta, to pozdrów go ode|mnie."
msgstr "Lycka till, pojke. Och om du ser trollkarlen Arbalt, säg hej till honom från mig."

#. from yeager:scummvm
msgid "OTHER: Niech tu wpadnie kiedyś. Porozmawiamy o|dawnych, dobrych czasach."
msgstr "Låt honom komma förbi här någon gång. Vi kan prata om den gamla goda tiden."

#. from yeager:scummvm
msgid "OTHER: Halo?"
msgstr "Hallå?"

#. from yeager:scummvm
msgid "OTHER: Jest tam kto?"
msgstr "Är det någon där?"

#. from yeager:scummvm
msgid "OTHER: Wyraźnie kogoś słyszę!..."
msgstr "OTHER: Jag kan tydligt höra någon!...."

#. from yeager:scummvm
msgid "OTHER: Halo?..."
msgstr "Hallå? ..."

#. from yeager:scummvm
msgid "HERO: Hej, jestem tu, ale kto mówi?!"
msgstr "HERO: Hej, jag är här, men vem är det som pratar!"

#. from yeager:scummvm
msgid "OTHER: Nareszcie jakiś człowiek!"
msgstr "OTHER: Äntligen en man!"

#. from yeager:scummvm
msgid "OTHER: W końcu!"
msgstr "OTHER: Äntligen!"

#. from yeager:scummvm
msgid "OTHER: Wydostań mnie stąd!"
msgstr "Få ut mig härifrån!"

#. from yeager:scummvm
msgid "$0: Chętnie, ale jak?"
msgstr "$0: Det skulle jag gärna göra, men hur?"

#. from yeager:scummvm
msgid "$1: Dobrze, ale kim jesteś?"
msgstr "$1: OK, men vem är du?"

#. from yeager:scummvm
msgid "$2: Jak się tu znalazłaś?"
msgstr "$2: Hur kom du hit?"

#. from yeager:scummvm
msgid "$3: Wrócę później."
msgstr "$ 3: Jag kommer tillbaka senare."

#. from yeager:scummvm
msgid "OTHER: Jestem więziona za magiczną ścianą stworzoną|siłą woli Księcia Wampirów."
msgstr "OTHER: Jag är fängslad bakom en magisk mur som skapats av vampyrprinsens viljestyrka."

#. from yeager:scummvm
msgid "OTHER: Musisz go odnaleźć i zabić."
msgstr "Du måste hitta honom och döda honom."

#. from yeager:scummvm
msgid "OTHER: Gdy on zginie, zginie i ściana."
msgstr "OTHER: När han dör, dör också väggen."

#. from yeager:scummvm
msgid "OTHER: Banalne."
msgstr "OTHER: Banal."

#. from yeager:scummvm
msgid "HERO: BANALNE?"
msgstr "HERO: BANAL?"

#. from yeager:scummvm
msgid "HERO: Zabić Księcia Wampirów?!"
msgstr "HERO: Att döda vampyrernas prins!"

#. from yeager:scummvm
msgid "OTHER: Zabić."
msgstr "OTHER: Att döda."

#. from yeager:scummvm
msgid "OTHER: Zaszlachtować."
msgstr "OTHER: Att sprängas i luften."

#. from yeager:scummvm
msgid "OTHER: Zamordować."
msgstr "OTHER: Att mörda."

#. from yeager:scummvm
msgid "OTHER: Ukatru..."
msgstr "OTHER: Ukatru..."

#. from yeager:scummvm
msgid "HERO: To rozumiem, ale samego Księcia!..."
msgstr "HERO: Det kan jag förstå, men prinsen själv!...."

#. from yeager:scummvm
msgid "OTHER: Najpierw musisz go znaleźć."
msgstr "OTHER: Först måste du hitta den."

#. from yeager:scummvm
msgid "HERO: Chyba leży tutaj i śpi."
msgstr "HERO: Jag tror att han ligger här och sover."

#. from yeager:scummvm
msgid "HERO: Pan Słońce zaświecił nad Fjord,|więc pewnie postanowił przeczekać|dzień."
msgstr "HERO: Herr Sol har gått ner över Fjord, så han bestämde sig nog för att vänta ut dagen."

#. from yeager:scummvm
msgid "OTHER: No to najtrudniejsze za tobą."
msgstr "OTHER: Tja, den svåraste delen ligger bakom dig."

#. from yeager:scummvm
msgid "OTHER: Teraz tylko wbij mu kołek w pierś|i po krzyku.#B0"
msgstr "OTHER: Nu är det bara att sticka en påle i bröstet på honom och skrika.#B0"

#. from yeager:scummvm
msgid "OTHER: Och to nieważne!..."
msgstr "OTHER: Åh det spelar ingen roll!...."

#. from yeager:scummvm
msgid "OTHER: Pospiesz się tylko z ratowaniem, bo|nudzę się tu już od ponad roku."
msgstr "OTHER: Bara skynda dig till undsättning, för jag har haft tråkigt här i över ett år nu."

#. from yeager:scummvm
msgid "HERO: Roku?!"
msgstr "Roku?!"

#. from yeager:scummvm
msgid "HERO: To szmat czasu!"
msgstr "HERO: Det är en trasig tid!"

#. from yeager:scummvm
msgid "OTHER: Nie żartuj?"
msgstr "OTHER: Skojar du?"

#. from yeager:scummvm
msgid "P#OTHER: Jesteś tu jeszcze czy już poszedłeś|mnie ratować?#B0"
msgstr "P#OTHER: Är du fortfarande här eller har du redan gått för att rädda mig? #B0"

#. from yeager:scummvm
msgid "OTHER: Słuchaj, później będziemy mieli|mnóstwo czasu na pogawędki."
msgstr "OTHER: Lyssna, vi kommer att ha gott om tid att prata senare."

#. from yeager:scummvm
msgid "OTHER: Ale teraz proszę, pospiesz się,|bo już tutaj nie wytrzymam!"
msgstr "OTHER: Men skynda dig nu, för jag står inte ut här längre!"

#. from yeager:scummvm
msgid "HERO: Dobrze, już dobrze.#B0"
msgstr "HERO: Okej, det är okej.#B0"

#. from yeager:scummvm
msgid "OTHER: Bajki nigdy nie mówiły, że bohaterowie|ratujący damy, tak się guzdrzą."
msgstr "OTHER: Sagor har aldrig sagt att hjältar|räddarinnor blir så oförskämda."

#. from yeager:scummvm
msgid "OTHER: Ależ to wszystko trwa."
msgstr "OTHER: Men allt tar tid."

#. from yeager:scummvm
msgid "OTHER: Tysiąc sto jeden, tysiąc sto dwa, tysiąc sto trzy..."
msgstr "OTHER: Ettusentohundraett, ettusentohundratvå, ettusentohundratre...."

#. from yeager:scummvm
msgid "OTHER: Jesteś tam jeszcze, czy już uciekłeś?"
msgstr "OTHER: Är du kvar där, eller har du redan flytt?"

#. from yeager:scummvm
msgid "OTHER: Chyba się nie boisz?"
msgstr "OTHER: Du är inte rädd, eller hur?"

#. from yeager:scummvm
msgid "OTHER: Zaraz zwariuję z nudów."
msgstr "OTHER: Jag håller på att bli galen av tristess."

#. from yeager:scummvm
msgid "HERO: Arivaldzie, czy znasz jakiś skuteczny|środek przeciwko wampirom?"
msgstr "HERO: Arivald, känner du till några effektiva medel mot vampyrer?"

#. from yeager:scummvm
msgid "OTHER: Szybkie nogi?"
msgstr "OTHER: Snabba ben?"

#. from yeager:scummvm
msgid "HERO: Hm, uściślijmy. Chodzi o pokonanie wampira,|a nie uciekanie przed wampirem."
msgstr "Hm, låt oss förtydliga. Det handlar om att besegra en vampyr, inte att springa från en vampyr."

#. from yeager:scummvm
msgid "OTHER: Oczywiście osikowy kołek."
msgstr "OTHER: En asppinne, naturligtvis."

#. from yeager:scummvm
msgid "OTHER: Wbity w wampirzą pierś działa|ze stuprocentową skutecznością."
msgstr "OTHER: Det hamrade vampyrbröstet fungerar med 100 procents effektivitet."

#. from yeager:scummvm
msgid "P#HERO: A gdyby ktoś musiał pokonać|samego Księcia Wampirów?"
msgstr "P#HERO: Tänk om någon måste besegra vampyrprinsen själv?"

#. from yeager:scummvm
msgid "OTHER: Ho ho ho ho ho!"
msgstr "OTHER: Ho ho ho ho!"

#. from yeager:scummvm
msgid "OTHER: Tego jeszcze nikt nie próbował,|ale zakładam, że osikowy kołek|musiałby zostać wzmocniony."
msgstr "OTHER: Detta har ännu inte prövats av någon, men jag antar att asppinnen skulle behöva förstärkas."

#. from yeager:scummvm
msgid "HERO: W jaki sposób?"
msgstr "HERO: På vilket sätt?"

#. from yeager:scummvm
msgid "OTHER: Pobłogosławiony?"
msgstr "OTHER: Välsignad?"

#. from yeager:scummvm
msgid "OTHER: Trochę czosnku też by nie zaszkodziło.|W moich czasach był to podstawowy|straszak na wampiry."
msgstr "OTHER: Lite vitlök skulle inte skada heller. På min tid var det en grundläggande rädsla för vampyrer."

#. from yeager:scummvm
msgid "OTHER: Odstraszał też, co prawda, piękne|kobiety, ale to tylko skutek uboczny."
msgstr "OTHER: Det skrämde visserligen också bort vackra kvinnor, men det är bara en bieffekt."

#. from yeager:scummvm
msgid "HERO: Ale ten ...czosnek..."
msgstr "HERO: Men det här ...garlic...."

#. from yeager:scummvm
msgid "OTHER: Wiem, wiem, teraz się nie uprawia. Dziwne."
msgstr "OTHER: Jag vet, jag vet, den växer inte nu. Det är konstigt."

#. from yeager:scummvm
msgid "OTHER: Chciałem zamówić wieprzowinę duszoną|z czosnkiem, ale barman tylko|bezradnie rozłożył ręce."
msgstr "OTHER: Jag ville beställa bräserat fläsk med vitlök, men bartendern bara bredde ut sina händer hjälplöst."

#. from yeager:scummvm
msgid "OTHER: Myślałem jednak o pewnym rozwiązaniu..."
msgstr "OTHER: Men jag tänkte på en lösning...."

#. from yeager:scummvm
msgid "HERO: Założę się, że zaraz znowu zostanę|zaczarowany..."
msgstr "HERO: Jag slår vad om att jag är på väg att bli förtrollad igen...."

#. from yeager:scummvm
msgid "OTHER: Nie mylisz się, chłopcze!"
msgstr "OTHER: Du har inte fel, pojke!"

#. from yeager:scummvm
msgid "OTHER: Przywołam cię za kilkanaście minut, a ty|tymczasem przyjrzyj się innemu światu!"
msgstr "OTHER: Jag ringer upp dig om några minuter, men under tiden kan du ta en titt på den andra världen!"

#. from yeager:scummvm
msgid "HERO: Dlaczego trwało to tak długo?!..."
msgstr "HERO: Varför tog det så lång tid?!…"

#. from yeager:scummvm
msgid "HERO: Mało nie przypłaciłem życiem twojej|opieszałości!"
msgstr "HERO: Jag fick nästan betala med mitt liv för din långsamhet!"

#. from yeager:scummvm
msgid "OTHER: Przy kuflu czas szybko mija..."
msgstr "OTHER: Med en pint går tiden fort ..."

#. from yeager:scummvm
msgid "OTHER: Lepiej powiedz, jak było?"
msgstr "OTHER: Det är bäst att du berättar för oss hur det var?"

#. from yeager:scummvm
msgid "HERO: Jak tylko to sobie poukładam w głowie."
msgstr "HERO: Så fort jag har fått ordning på det i huvudet."

#. from yeager:scummvm
msgid "HERO: Widziałem tak dziwne rzeczy, że|wszystko wydaje mi się bardziej|snem niż jawą."
msgstr "HERO: Jag har sett så märkliga saker att det hela känns mer som en dröm än som vaket tillstånd."

#. from yeager:scummvm
msgid "OTHER: No to może kufelek?"
msgstr "OTHER: Vad sägs om en pint?"

#. from yeager:scummvm
msgid "HERO: Nie mogę, muszę ratować nieznajomą."
msgstr "HERO: Jag kan inte, jag måste rädda en främling."

#. from yeager:scummvm
msgid "P#HERO: Ha! Ratuję kogoś!"
msgstr "Ha! Jag räddar någon!"

#. from yeager:scummvm
msgid "HERO: Właśnie to sobie uświadomiłem!"
msgstr "HERO: Jag har just insett det!"

#. from yeager:scummvm
msgid "HERO: Zostanę bohaterem!"
msgstr "HERO: Jag ska bli en hjälte!"

#. from yeager:scummvm
msgid "HERO: Będą o mnie śpiewać pieśni i układać poematy."
msgstr "HERO: De kommer att sjunga sånger om mig och skriva dikter om mig."

#. from yeager:scummvm
msgid "HERO: A tłum będzie sypał płatki róż pod moje stopy!"
msgstr "HERO: Och publiken kommer att hälla rosenblad under mina fötter!"

#. from yeager:scummvm
msgid "HERO: Yes!"
msgstr "HERO: Ja!"

#. from yeager:scummvm
msgid "OTHER: O-ho!"
msgstr "OTHER: O-ho!"

#. from yeager:scummvm
msgid "OTHER: Znowu mamy problem."
msgstr "OTHER: Vi har ett problem igen."

#. from yeager:scummvm
msgid "OTHER: Chętnie posłucham, tylko mów|szybko i krótko."
msgstr "OTHER: Jag lyssnar gärna, håll det bara kort och snabbt."

#. from yeager:scummvm
msgid "HERO: Smok."
msgstr "HERO: Draken."

#. from yeager:scummvm
msgid "HERO: Pokonać."
msgstr "HERO: Besegra."

#. from yeager:scummvm
msgid "HERO: Pomoc."
msgstr "Hjälp."

#. from yeager:scummvm
msgid "HERO: Teraz."
msgstr "Nu."

#. from yeager:scummvm
msgid "P#HERO: Koniec."
msgstr "P#HERO: Slutet."

#. from yeager:scummvm
msgid "P#OTHER: No dobra."
msgstr "P#OTHER: Okej."

#. from yeager:scummvm
msgid "OTHER: Koniec lenistwa."
msgstr "OTHER: Ingen mer lättja."

#. from yeager:scummvm
msgid "OTHER: Czas ruszać w drogę!"
msgstr "OTHER: Dags att ge sig ut på vägarna!"

#. from yeager:scummvm
msgid "HERO: Naprawdę?"
msgstr "HERO: Verkligen?"

#. from yeager:scummvm
msgid "HERO: Zabijesz za mnie smoka?"
msgstr "HERO: Kan du döda en drake åt mig?"

#. from yeager:scummvm
msgid "HERO: To cudo..."
msgstr "HERO: Det är ett underverk..."

#. from yeager:scummvm
msgid "OTHER: Spokojnie, spokojnie."
msgstr "OTHER: Ta det lugnt, ta det lugnt."

#. from yeager:scummvm
msgid "OTHER: Zaraz znajdziemy się w najcudowniejszym|miejscu na świecie."
msgstr "OTHER: Vi är på väg att befinna oss på världens mest underbara plats."

#. from yeager:scummvm
msgid "OTHER: W przewspaniałej, przeogromnej Silmanionie!"
msgstr "OTHER: I den magnifika, förvuxna Silmanion!"

#. from yeager:scummvm
msgid "HERO: Co właściwie jest w Silmanionie?"
msgstr "HERO: Vad står det egentligen i Silmanion?"

#. from yeager:scummvm
msgid "OTHER: Kolebka wiedzy. Miejsce studiów największych|magów. Największa biblioteka świata."
msgstr "OTHER: Kunskapens vagga. Studieplatsen för de största magierna. Det största biblioteket i världen."

#. from yeager:scummvm
msgid "OTHER: No cóż."
msgstr "OTHER: Tja."

#. from yeager:scummvm
msgid "OTHER: Latka lecą."
msgstr "OTHER: Åren flyger förbi."

#. from yeager:scummvm
msgid "OTHER: Na szczycie jednej ze ścian jest chyba księga,|której potrzebujemy."
msgstr "OTHER: Längst upp på en av väggarna finns förmodligen den bok vi behöver."

#. from yeager:scummvm
msgid "OTHER: Musi zawierać potężne czary, skoro nie skruszył|jej ząb czasu."
msgstr "OTHER: Den måste innehålla mäktig trolldom om den inte har smulats sönder av tidens tand."

#. from yeager:scummvm
msgid "OTHER: Znalazłem coś całkiem użytecznego."
msgstr "OTHER: Jag hittade något ganska användbart."

#. from yeager:scummvm
msgid "OTHER: Czar nazywa się \"Moc Trolla\", to ci powinno|pomóc."
msgstr "OTHER: Besvärjelsen heter \"Troll Power\", det här borde hjälpa dig."

#. from yeager:scummvm
msgid "OTHER: Jak tylko wypowiesz \"Yukkakoppamakki\",|staniesz się na sekundę silny jak troll!"
msgstr "OTHER: Så snart du säger \"Yukkakoppamakki\" blir du lika stark som ett troll för en sekund!"

#. from yeager:scummvm
msgid "OTHER: O właśnie."
msgstr "OTHER: Okej."

#. from yeager:scummvm
msgid "OTHER: Chyba domyślasz się, co wtedy trzeba|zrobić..."
msgstr "OTHER: Jag antar att du kan gissa vad du behöver göra då...."

#. from yeager:scummvm
msgid "HERO: Yukkakopp?..."
msgstr "Yukkakopp?..."

#. from yeager:scummvm
msgid "OTHER: Sza! Nie marnuj czaru na byle okazję!"
msgstr "OTHER: Shh! Slösa inte bort en besvärjelse vid något tillfälle!"

#. from yeager:scummvm
msgid "HERO: Jest tak zafascynowany lekturą,|że żal przerywać."
msgstr "HERO: Han är så fascinerad av läsningen att det är synd att avbryta."

#. from yeager:scummvm
msgid "HERO: Było nie było, nie miał książki|w ręku od tysiąca lat."
msgstr "HERO: Han har inte haft en bok i sin hand på tusen år."

#. from yeager:scummvm
msgid "HERO: Widziałeś to śmierdzące bajoro niedaleko?"
msgstr "HERO: Såg du den stinkande röran i närheten?"

#. from yeager:scummvm
msgid "OTHER: Zapaszek dolatuje aż tutaj."
msgstr "OTHER: Lukten kommer hela vägen hit."

#. from yeager:scummvm
msgid "OTHER: Być może ktoś tu przeprowadzał eksperymenty|z magicznymi środkami chemiczno-bojowymi."
msgstr "OTHER: Kanske någon här har experimenterat med magiska kemikalier."

#. from yeager:scummvm
msgid "OTHER: Nieudane eksperymenty, dodajmy."
msgstr "OTHER: Misslyckade experiment, kan vi tillägga."

#. from yeager:scummvm
msgid "OTHER: Chyba że ktoś umyślnie chciał zniszczyć|Silmanionę..."
msgstr "OTHER: Om inte någon medvetet ville förstöra|Silmaniona...."

#. from yeager:scummvm
msgid "OTHER: Po opowiedzeniu całej historii..."
msgstr "OTHER: Efter att ha berättat hela historien ..."

#. from yeager:scummvm
msgid "OTHER: No, no..."
msgstr "OTHER: Nej, nej..."

#. from yeager:scummvm
msgid "OTHER: Zdaje się, że pomóc ci może tylko|jeden czło... Hm, demon."
msgstr "OTHER: Det verkar som om bara en person kan hjälpa dig.... Hm, demon."

#. from yeager:scummvm
msgid "OTHER: A nawet demon nad demonami."
msgstr "OTHER: Och till och med en demon över demoner."

#. from yeager:scummvm
msgid "OTHER: W skrócie: szef Piekła."
msgstr "OTHER: Kort sagt: helvetets boss."

#. from yeager:scummvm
msgid "OTHER: Lucyfer."
msgstr "OTHER: Lucifer."

#. from yeager:scummvm
msgid "P#OTHER: No, no..."
msgstr "P#OTHER: Nåväl, nåväl..."

#. from yeager:scummvm
msgid "OTHER: Dostać się do Piekła to nie taka|prosta sprawa."
msgstr "OTHER: Att ta sig till helvetet är inte så enkelt."

#. from yeager:scummvm
msgid "OTHER: Ja tam, na przykład, nigdy nie|byłem."
msgstr "OTHER: Jag har i alla fall aldrig varit där."

#. from yeager:scummvm
msgid "OTHER: A byłem w naprawdę wielu|miejscach."
msgstr "OTHER: Och jag har varit på många ställen."

#. from yeager:scummvm
msgid "HERO: Do Piekła?!"
msgstr "Till helvetet?!"

#. from yeager:scummvm
msgid "HERO: Chyba gorzej już nie mogło być..."
msgstr "HERO: Jag tror inte att det kan bli värre...."

#. from yeager:scummvm
msgid "OTHER: Wierz mi: mogło."
msgstr "OTHER: Tro mig, det kan det."

#. from yeager:scummvm
msgid "HERO: Sam sobie nie poradzę!"
msgstr "HERO: Jag kan inte göra det ensam!"

#. from yeager:scummvm
msgid "HERO: Pomo..."
msgstr "HERO: Hjälper..."

#. from yeager:scummvm
msgid "OTHER: Powtarzasz się. Bądź mężczyzną|i weź się w garść."
msgstr "Du upprepar dig själv. Var en man och ta dig samman."

#. from yeager:scummvm
msgid "OTHER: Jak nie będziesz skomlał tylko działał,|to na pewno sobie poradzisz."
msgstr "OTHER: Om du inte gnäller utan agerar, är jag säker på att du kan klara dig."

#. from yeager:scummvm
msgid "OTHER: Słuchaj, siedzi przed tobą ktoś,|kto przez tysiąc lat był martwy!"
msgstr "OTHER: Lyssna, det sitter någon framför dig som har varit död i tusen år!"

#. from yeager:scummvm
msgid "OTHER: Więc cuda się zdarzają, to może|i tobie się uda ukończyć grę|bez zerkania do rozwiązania."
msgstr "OTHER: Så mirakel sker, då kanske du också lyckas slutföra spelet utan att kika på lösningen."

#. from yeager:scummvm
msgid "OTHER: Mój drogi, porozmawiamy później."
msgstr "OTHER: Min kära, vi kommer att prata senare."

#. from yeager:scummvm
msgid "OTHER: Kiedy mam wybierać pomiędzy delektowaniem|się zimnym piwem, a uroczą konwersacją|z tobą, to zapewne wiesz, co wybieram?"
msgstr "OTHER: När jag måste välja mellan att njuta av en kall öl och ett trevligt samtal med dig, vet du säkert vad jag väljer?"

#. from yeager:scummvm
msgid "OTHER: Zgoda?"
msgstr "OTHER: Överenskommet?"

#. from yeager:scummvm
msgid "P#HERO: <westchnienie>"
msgstr "P#HERO: <westchnienie>"

#. from yeager:scummvm
msgid "HERO: Zgoda."
msgstr "HERO: Håller med."

#. from yeager:scummvm
msgid "HERO: Ale jak będę miał coś naprawdę ważnego..."
msgstr "HERO: Men när jag har något riktigt viktigt...."

#. from yeager:scummvm
msgid "OTHER: To wal jak w dym."
msgstr "OTHER: Det är pang på."

#. from yeager:scummvm
msgid "HERO: Mam nadzieję, że teraz porozmawiamy|sobie dłużej."
msgstr "HERO: Jag hoppas att vi kan prata längre nu."

#. from yeager:scummvm
msgid "HERO: To tak się traktuje wybawcę i bohatera!?"
msgstr "HERO: Är det så här man behandlar en räddare och en hjälte!?"

#. from yeager:scummvm
msgid "HERO: Nie ma sprawiedliwości, miłości i pokoju|na tym okrutnym, okrutnym świecie."
msgstr "HERO: Det finns ingen rättvisa, ingen kärlek och ingen fred i denna grymma, grymma värld."

#. from yeager:scummvm
msgid "HERO: Przypatrz się dobrze..."
msgstr "HERO: Ta en ordentlig titt..."

#. from yeager:scummvm
msgid "HERO: Jako wizjoner powinieneś wiedzieć, gdzie obecnie|znajduje się istota o takiej właśnie łusce."
msgstr "HERO: Som visionär borde du veta var en varelse med den här typen av skal befinner sig för närvarande."

#. from yeager:scummvm
msgid "OTHER: O nie..."
msgstr "OTHER: Åh nej..."

#. from yeager:scummvm
msgid "OTHER: To nie tak..."
msgstr "OTHER: Det är inte så..."

#. from yeager:scummvm
msgid "OTHER: Potrafię odnajdywać rzeczy, ale muszę|wiedzieć, jak wyglądają."
msgstr "OTHER: Jag kan hitta saker, men jag måste veta hur de ser ut."

#. from yeager:scummvm
msgid "OTHER: Owszem, do uzyskania wizji potrzebna jest|jakaś rzecz..."
msgstr "OTHER: Ja, du behöver något för att få en vision...."

#. from yeager:scummvm
msgid "OTHER: ...rzecz..."
msgstr "...sak..."

#. from yeager:scummvm
msgid "OTHER: ...eee..."
msgstr "...eh..."

#. from yeager:scummvm
msgid "HERO: Obiektu?"
msgstr "HERO: Ett objekt?"

#. from yeager:scummvm
msgid "OTHER: ...obiektu, ale tylko jako pomoc."
msgstr "OTHER: ...objekt, men endast som ett hjälpmedel."

#. from yeager:scummvm
msgid "OTHER: Najpierw opowiedz mi, jak wygląda, to czego|mam szukać, a potem spróbujemy to znaleźć."
msgstr "OTHER: Berätta först hur det ser ut, vad jag ska leta efter, så försöker vi hitta det."

#. from yeager:scummvm
msgid "OTHER: Muszę wiedzieć, czy to jaszczur, czy wąż,|czy jakaś magiczna cholera."
msgstr "OTHER: Jag måste få veta om det är en ödla eller en orm eller någon slags magisk kolera."

#. from yeager:scummvm
msgid "HERO: Myślałem, ze pustelnicy znają się na|przyrodzie?"
msgstr "HERO: Jag trodde att eremiter kände till naturen?"

#. from yeager:scummvm
msgid "OTHER: Oczywiście. Ale na grzybkach, roślinkach,|korzonkach, wywarach..."
msgstr "OTHER: Naturligtvis. Men på svampar, växter, rötter, dekokter...."

#. from yeager:scummvm
msgid "HERO: Wrócę, jak tylko dowiem się czegoś więcej."
msgstr "HERO: Jag kommer tillbaka så snart jag vet mer."

#. from yeager:scummvm
msgid "HERO: Sklep otwarty, czyżby studia nad księgą|zostały zakończone?"
msgstr "HERO: Butiken är öppen, har bokstudierna slutförts?"

#. from yeager:scummvm
msgid "OTHER: Ech, książę, nadal masz powietrze w głowie."
msgstr "OTHER: Eh, Prince, du har fortfarande luft i huvudet."

#. from yeager:scummvm
msgid "OTHER: W takim krótkim czasie można lekturę jeno|pobieżnie przekartkować."
msgstr "OTHER: På så kort tid är det möjligt att läsa igenom boken endast kortfattat."

#. from yeager:scummvm
msgid "HERO: Znalazłeś coś ciekawego?"
msgstr "HERO: Har du hittat något intressant?"

#. from yeager:scummvm
msgid "OTHER: Okazało się, że to nie jest księga magiczna,|ale zapiski pewnego podróżnika sprzed|wieków."
msgstr "OTHER: Det visade sig att detta inte var en magisk bok utan anteckningar från en resenär för flera hundra år sedan."

#. from yeager:scummvm
msgid "OTHER: Szczegółowy opis dziwnych roślin, zaginionych|zwierząt, tajemniczych miejsc."
msgstr "OTHER: Detaljerad beskrivning av konstiga växter, försvunna djur, mystiska platser."

#. from yeager:scummvm
msgid "OTHER: Fascynująca lektura."
msgstr "OTHER: Fascinerande läsning."

#. from yeager:scummvm
msgid "OTHER: Prawie że encyklopedia."
msgstr "OTHER: Nästan en encyklopedi."

#. from yeager:scummvm
msgid "HERO: Hmmm..."
msgstr "HERO: Hmmm..."

#. from yeager:scummvm
msgid "P#HERO: Mógłbyś powiedzieć mi o niej coś więcej?"
msgstr "P#HERO: Kan du berätta mer om henne?"

#. from yeager:scummvm
msgid "HERO: Na początek choćby opis zwierząt?"
msgstr "HERO: Till att börja med, även en beskrivning av djuren?"

#. from yeager:scummvm
msgid "OTHER: A po cóż to?!"
msgstr "OTHER: Och vad är det till för!"

#. from yeager:scummvm
msgid "OTHER: Czyżbyś chciał rozpocząć..."
msgstr "OTHER: Skulle du vilja börja ..."

#. from yeager:scummvm
msgid "OTHER: ...EDUKACJĘ?!?..."
msgstr "OTHER: ...UTBILDNING?!??..."

#. from yeager:scummvm
msgid "HERO: Oczywiście!"
msgstr "HERO: Naturligtvis!"

#. from yeager:scummvm
msgid "HERO: Właśnie to chcę zrobić."
msgstr "HERO: Det är vad jag vill göra."

#. from yeager:scummvm
msgid "HERO: Spoważnieć."
msgstr "HERO: Var allvarlig."

#. from yeager:scummvm
msgid "HERO: Uczyć się."
msgstr "HERO: Att lära sig."

#. from yeager:scummvm
msgid "HERO: Nie uganiać już więcej za dziewczętami, tylko|poświęcić sprawom poważnym i wzniosłym."
msgstr "HERO: Jaga inte tjejer längre, utan ägna dig åt allvarliga och högtstående frågor."

#. from yeager:scummvm
msgid "HERO: Na przykład nauce."
msgstr "HERO: Till exempel vetenskap."

#. from yeager:scummvm
msgid "OTHER: Jestem zdumiony i wzruszony. Skoro tak się|sprawy mają nie mogę ci odmówić."
msgstr "OTHER: Jag är förvånad och rörd. Eftersom det är så här det är, kan jag inte neka dig."

#. from yeager:scummvm
msgid "OTHER: Poczekaj tu chwilkę."
msgstr "OTHER: Vänta här ett ögonblick."

#. from yeager:scummvm
msgid "HERO: Pamiętasz łuskę, którą ci pokazałem?"
msgstr "HERO: Kommer du ihåg skalet jag visade dig?"

#. from yeager:scummvm
msgid "HERO: Wiem już, że to smocza łuska."
msgstr "HERO: Jag vet redan att det är en drakfjäll."

#. from yeager:scummvm
msgid "HERO: Mam do ciebie prośbę, jako do wizjonera."
msgstr "HERO: Jag har en begäran till dig som visionär."

#. from yeager:scummvm
msgid "HERO: Potrzebuję zlokalizować pewien, hm,|obiekt..."
msgstr "HERO: Jag behöver lokalisera ett visst, um, objekt...."

#. from yeager:scummvm
msgid "OTHER: Zaginione żony, dzieci, koty i psy to|moja specjalność."
msgstr "OTHER: Försvunna fruar, barn, katter och hundar är min specialitet."

#. from yeager:scummvm
msgid "OTHER: Tych pierwszych czasem lepiej nie odnajdywać."
msgstr "OTHER: De förstnämnda är ibland bättre att inte hitta."

#. from yeager:scummvm
msgid "OTHER: Przez skromność nie wspomnę o..."
msgstr "OTHER: För blygsamhetens skull kommer jag inte att nämna ..."

#. from yeager:scummvm
msgid "HERO: Chodzi o pewnego gada."
msgstr "HERO: Det handlar om en viss reptil."

#. from yeager:scummvm
msgid "HERO: Oto jego łuska."
msgstr "HERO: Här är hans skal."

#. from yeager:scummvm
msgid "HERO: Wiadomo ponad wszelką wątpliwość, że|to łuska smocza."
msgstr "HERO: Det är ställt utom allt tvivel att detta är drakfjäll."

#. from yeager:scummvm
msgid "OTHER: Smocza!"
msgstr "Draken!"

#. from yeager:scummvm
msgid "OTHER: Żarty!"
msgstr "OTHER: Skämt!"

#. from yeager:scummvm
msgid "OTHER: Smoków nie ma!"
msgstr "OTHER: Det finns inga drakar!"

#. from yeager:scummvm
msgid "OTHER: Chociaż w sumie o jednym ostatnio|śniłem."
msgstr "OTHER: Även om jag har pratat om en sak i sin helhet nyligen."

#. from yeager:scummvm
msgid "OTHER: Nad ranem zamienił się co prawda|w księżniczkę Sheilę, ale to już inna|historia."
msgstr "OTHER: På morgonen förvandlades han till prinsessan Sheila, men det är en annan historia."

#. from yeager:scummvm
msgid "HERO: Więc skup się i powiedz mi, gdzie jest|ten potwór."
msgstr "Fokusera och berätta var monstret är."

#. from yeager:scummvm
msgid "HERO: To sprawa życia i śmierci."
msgstr "HERO: Det är en fråga om liv och död."

#. from yeager:scummvm
msgid "HERO: Czy mógłbym spytać o coś największego|siłacza w okolicy?"
msgstr "HERO: Kan jag fråga något om den största makten i området?"

#. from yeager:scummvm
msgid "HERO: W jaki sposób można pokonać smoka?"
msgstr "HERO: Hur besegrar man en drake?"

#. from yeager:scummvm
msgid "OTHER: Zapewne chcesz wiedzieć, w jaki sposób|TY mógłbyś pokonać smoka."
msgstr "OTHER: Du vill säkert veta hur du kan besegra en drake."

#. from yeager:scummvm
msgid "OTHER: Sposób jest więcej niż prosty."
msgstr "OTHER: Vägen är mer än enkel."

#. from yeager:scummvm
msgid "OTHER: Wziąć ze sobą dziesięciu krasnoludów|silnych jak ja, pokazać im legowisko|potwora i schować się, póki walka trwa."
msgstr "OTHER: Ta med dig tio dvärgar som är lika starka som jag, visa dem monstrets lya och göm dig medan striden pågår."

#. from yeager:scummvm
msgid "HERO: Bardzo śmieszne."
msgstr "HERO: Mycket roligt."

#. from yeager:scummvm
msgid "HERO: Nie wiedziałem, że krasnoludy mają tak|wysublimowane poczucie humoru."
msgstr "HERO: Jag visste inte att dvärgar hade ett sådant sublimt sinne för humor."

#. from yeager:scummvm
msgid "OTHER: To nie żart."
msgstr "OTHER: Detta är inte ett skämt."

#. from yeager:scummvm
msgid "OTHER: Człowiek kontra smok. Śmiechu warte."
msgstr "OTHER: Människan mot draken. Skrattar."

#. from yeager:scummvm
msgid "OTHER: No chyba, żebyś był paladynem z Zakonu|Smokobójców. Wtedy was stu dałoby sobie|radę. Ale nie jesteś paladynem, prawda?"
msgstr "OTHER: Tja, om du inte är en paladin från Dragonkillers Order. Då skulle hundra av er kunna klara er. Men du är inte en paladin, eller hur?"

#. from yeager:scummvm
msgid "OTHER: I nie masz dziewięćdziesięciu dziewięciu|kumpli?"
msgstr "OTHER: Och du har inte nittionio?"

#. from yeager:scummvm
msgid "OTHER: Potrzebowałbyś cudu, żeby pokonać|choćby krowę, a co dopiero smoka."
msgstr "OTHER: Det skulle krävas ett mirakel för att besegra en ko, än mindre en drake."

#. from yeager:scummvm
msgid "OTHER: Ale nawet gdybyś był sto razy silniejszy,|to i tak twoja skóra przy smoczej to jak|papier przy kamieniu."
msgstr "OTHER: Men även om du var hundra gånger starkare, är din hud bredvid en drakes fortfarande som papper bredvid sten."

#. from yeager:scummvm
msgid "OTHER: Nawet i miecz tu nie pomoże."
msgstr "OTHER: Inte ens ett svärd hjälper här."

#. from yeager:scummvm
msgid "HERO: Czyli najlepiej dać sobie spokój, tak?"
msgstr "HERO: Så det är bäst att släppa det, eller hur?"

#. from yeager:scummvm
msgid "OTHER: I tak doszliśmy do rozsądnych wniosków."
msgstr "OTHER: Och så kom vi till en rimlig slutsats."

#. from yeager:scummvm
msgid "OTHER: Zawsze wierzyłem, że i w takiej dziurze|znajdą się ludzie światli."
msgstr "OTHER: Jag har alltid trott att det även i ett sådant hål kommer att finnas upplysta människor."

#. from yeager:scummvm
msgid "OTHER: Tacy, co to wiedzą, że powinno się|zabierać biednym, a dawać bogatym."
msgstr "OTHER: De som vet att man ska ta från de fattiga och ge till de rika."

#. from yeager:scummvm
msgid "OTHER: Cieszę się, że znasz znak, książę."
msgstr "OTHER: Jag är glad att du kan tecknet, Prince."

#. from yeager:scummvm
msgid "OTHER: Przedni wybór, chyba nie ma nic bardziej|symbolicznego niż okradzenie żebraka."
msgstr "OTHER: Första valet, det finns nog inget mer symboliskt än att råna en tiggare."

#. from yeager:scummvm
msgid "OTHER: Ale to jeszcze nie wystarczy, by wstąpić|do Gildii..."
msgstr "OTHER: Men det är fortfarande inte tillräckligt för att gå med i Guild...."

#. from yeager:scummvm
msgid "$0: Potrzebny drugi kapeć?..."
msgstr "$0: Behöver du en andra cape? ...."

#. from yeager:scummvm
msgid "$1: Gildii?"
msgstr "$1: Guild?"

#. from yeager:scummvm
msgid "$2: Kradniecie biednym i rozdajecie bogatym?!"
msgstr "$2: Stjäl från de fattiga och ge till de rika!"

#. from yeager:scummvm
msgid "$3: Chyba należy dawać biednym, a zabierać bogatym?"
msgstr "$3: Jag antar att man ska ge till de fattiga och ta från de rika?"

#. from yeager:scummvm
msgid "$4: Coś naprawdę cennego? Czyli co?"
msgstr "4 dollar: Något riktigt värdefullt? Vad betyder det?"

#. from yeager:scummvm
msgid "$5: Nie mam nic naprawdę wartościowego."
msgstr "$5: Jag har inget av verkligt värde."

#. from yeager:scummvm
msgid "$6: Kapeć nie wystarcza?"
msgstr "$6: En cape är inte tillräckligt?"

#. from yeager:scummvm
msgid "$7: Macie zniżki dla arystokratów?"
msgstr "$7: Har ni rabatter för aristokrater?"

#. from yeager:scummvm
msgid "OTHER: Żarcik, żarcik, żarcik..."
msgstr "OTHER: Skämtar, skämtar, skämtar...."

#. from yeager:scummvm
msgid "OTHER: Jesteś niewyczerpany, książę."
msgstr "OTHER: Du är outtömlig, prins."

#. from yeager:scummvm
msgid "OTHER: Nasze tajne Stowarzyszenie, nasza|prześwietna Gildia, to bardzo|poważna sprawa."
msgstr "OTHER: Vårt hemliga sällskap, vårt hemliga skrå, är en mycket allvarlig fråga."

#. from yeager:scummvm
msgid "OTHER: Znakiem dowiodłeś, książę, że nasze|idee nie są ci obce."
msgstr "OTHER: Genom ett tecken har du bevisat, prins, att våra idéer inte är främmande för dig."

#. from yeager:scummvm
msgid "OTHER: Teraz jeszcze musisz tylko wnieść,|jak my to nazywamy, posag, aby|zostać jednym z nas.#B1"
msgstr "OTHER: Nu behöver du bara ta med dig, som vi kallar det, en hemgift för att bli en av oss.#B1"

#. from yeager:scummvm
msgid "OTHER: Stowarzyszenia, Gildii, nazwa nie|jest tu ważna."
msgstr "OTHER: Föreningar, gillen, namnet är inte viktigt här."

#. from yeager:scummvm
msgid "OTHER: Niejawnej organizacji czuwającej nad|właściwym przepływem wartości|pieniężnych."
msgstr "OTHER: Hemlig organisation för att säkerställa ett korrekt flöde av monetära värden."

#. from yeager:scummvm
msgid "OTHER: Czyli, krótko mówiąc, obławiamy się|u tych samych, u których obławia się|każde państwo świata."
msgstr "OTHER: Så, kort sagt, vi fiskar med samma människor som fiskar med alla länder i världen."

#. from yeager:scummvm
msgid "OTHER: U biedaków."
msgstr "OTHER: I de fattiga."

#. from yeager:scummvm
msgid "OTHER: Kiedy tylko wniesiesz do Gildii coś|wyjątkowo cennego, staniesz się|jednym z nas."
msgstr "OTHER: När du tillför något extremt värdefullt till sektionen blir du en av oss."

#. from yeager:scummvm
msgid "OTHER: A wtedy świat stanie przed tobą|otworem.#B1"
msgstr "OTHER: Och sedan kommer världen att stå framför dig. #B1"

#. from yeager:scummvm
msgid "OTHER: Oczywiście. A można inaczej?"
msgstr "OTHER: Naturligtvis. Och kan det göras på ett annat sätt?"

#. from yeager:scummvm
msgid "OTHER: Bogatych jest niewielu i pilnują swojego|majątku bardzo czujnie."
msgstr "OTHER: De rika är få och de vaktar sina rikedomar mycket vaksamt."

#. from yeager:scummvm
msgid "OTHER: Biedaków jest o wiele więcej i nikt się|nie przejmuje, kiedy są okradani."
msgstr "OTHER: Det finns många fler fattiga människor och ingen bryr sig om när de blir rånade."

#. from yeager:scummvm
msgid "OTHER: Czasem mamy tylko pewne konflikty|z ministrami finansów. W końcu|działamy w jednej branży."
msgstr "OTHER: Ibland har vi bara vissa konflikter med finansministrarna. Vi är ju trots allt i samma bransch."

#. from yeager:scummvm
msgid "OTHER: Obrabiając biedaków hurtem, zyskujemy|na ilości."
msgstr "OTHER: Genom att råna de fattiga i bulk vinner vi i kvantitet."

#. from yeager:scummvm
msgid "OTHER: Podstawy ekonomii każdego państwa,|książę."
msgstr "OTHER: De grundläggande faktorerna i ett lands ekonomi, sade han."

#. from yeager:scummvm
msgid "OTHER: Kiedy tylko wniesiesz do Gildii coś|wyjątkowo cennego, wtedy staniesz|się jednym z nas."
msgstr "OTHER: Så snart du tillför något extremt värdefullt till sektionen blir du en av oss."

#. from yeager:scummvm
msgid "OTHER: He he he..."
msgstr "OTHER: Han han han han..."

#. from yeager:scummvm
msgid "OTHER: Oj, bo się popłaczę, książę..."
msgstr "OTHER: Åh, annars gråter jag, prins...."

#. from yeager:scummvm
msgid "OTHER: Ty to jak coś powiesz..."
msgstr "OTHER: Du är när du säger något...."

#. from yeager:scummvm
msgid "OTHER: Jaki to sens robić z bogacza biedaka?"
msgstr "OTHER: Vad är det för mening med att göra en rik man till en fattig man?"

#. from yeager:scummvm
msgid "OTHER: Żeby inny biedak mógł stać się|bogaczem?"
msgstr "OTHER: Så att en annan fattig man kan bli en rik man?"

#. from yeager:scummvm
msgid "OTHER: Przecież to nielogiczne...."
msgstr "OTHER: Det är ju trots allt ologiskt...."

#. from yeager:scummvm
msgid "OTHER: Jeśli masz jakiekolwiek wątpliwości, miesiąc|członkostwa w naszym Stowarzyszeniu powinien|cię przekonać."
msgstr "OTHER: Om du har några tvivel, bör en månads medlemskap i vår förening övertyga dig."

#. from yeager:scummvm
msgid "OTHER: A wtedy świat stanie przed tobą otworem.#B1"
msgstr "OTHER: Och då kommer världen att vara öppen för dig.#B1"

#. from yeager:scummvm
msgid "OTHER: Coś wyjątkowego."
msgstr "OTHER: Något speciellt."

#. from yeager:scummvm
msgid "OTHER: Kiedyś otrzymaliśmy magiczną kłódkę, która nie|dość, że zabezpiecza sejf, to jeszcze sama|jest z białego złota wysadzanego brylantami."
msgstr "OTHER: Vi fick en gång ett magiskt hänglås som inte bara låser kassaskåpet utan också är tillverkat av vitguld med diamanter."

#. from yeager:scummvm
msgid "OTHER: Że nie wspomnę o krysztale lokalizującym poborców|podatkowych i rzucającym na nich automatycznie|czar o wdzięcznej nazwie Hemoroidus Maximus."
msgstr "OTHER: För att inte tala om kristallen som lokaliserar skatteindrivare och automatiskt förtrollar dem med det graciösa namnet Hemoroidus Maximus."

#. from yeager:scummvm
msgid "OTHER: Hmm..."
msgstr "OTHER: Hmm..."

#. from yeager:scummvm
msgid "P#OTHER: Nie ukrywam, że jest taki przedmiot, którego|wszyscy pożądają."
msgstr "P#OTHER: Jag gör ingen hemlighet av att det finns ett föremål som alla vill ha."

#. from yeager:scummvm
msgid "OTHER: Być może o nim słyszałeś."
msgstr "OTHER: Du kanske har hört talas om honom."

#. from yeager:scummvm
msgid "OTHER: To tytanowy kastet wysadzany diamentami."
msgstr "OTHER: Det här är ett hjul i titan som är infattat med diamanter."

#. from yeager:scummvm
msgid "OTHER: Problem w tym, iż należał on do słynnego|wojownika, który dawno temu poległ|w bitwie pod miastem."
msgstr "OTHER: Problemet är att den tillhörde en berömd krigare som föll i en strid nära staden för länge sedan."

#. from yeager:scummvm
msgid "OTHER: Wojownika pochowano w kurhanie wraz|z całym dobytkiem."
msgstr "OTHER: Krigaren begravdes i en korg med alla sina tillhörigheter."

#. from yeager:scummvm
msgid "OTHER: Nikt jednak jeszcze nie zdołał wejść do|kurhanu... A w każdym razie nie wiemy o|nikim, kto zdołał stamtąd WYJŚĆ."
msgstr "OTHER: Ingen har dock ännu lyckats ta sig in i Kurhan.... Och i vilket fall som helst känner vi inte till någon som har lyckats UT därifrån."

#. from yeager:scummvm
msgid "OTHER: Pewnie dlatego, że kurhan strzeżony jest|dzień i noc przez upiory zabitych rycerzy."
msgstr "OTHER: Förmodligen för att gravkammaren vaktas dag och natt av vålnader från dödade riddare."

#. from yeager:scummvm
msgid "HERO: Mmmmm..."
msgstr "HERO: Mmmmm..."

#. from yeager:scummvm
msgid "HERO: Coś mi się obiło o uszy."
msgstr "HERO: Jag har hört något."

#. from yeager:scummvm
msgid "HERO: Zobaczę, co się da zrobić."
msgstr "HERO: Jag ska se vad jag kan göra."

#. from yeager:scummvm
msgid "OTHER: Wierzyć mi się nie chce."
msgstr "OTHER: Jag kan inte tro det."

#. from yeager:scummvm
msgid "OTHER: W końcu jesteś synem władcy tej|krainy."
msgstr "OTHER: Du är trots allt son till härskaren i detta land."

#. from yeager:scummvm
msgid "OTHER: Choć może... Hm..."
msgstr "Fast kanske... Hm..."

#. from yeager:scummvm
msgid "P#OTHER: Kiedyś otrzymaliśmy magiczną kłódkę, która nie|dość, że zabezpiecza sejf, to jeszcze sama|jest z białego złota wysadzanego brylantami."
msgstr "P#ANDRA: Vi fick en gång ett magiskt hänglås som inte bara låser kassaskåpet, utan som själv är tillverkat av vitguld med diamanter."

#. from yeager:scummvm
msgid "OTHER: Ależ książę, przecież to|bardzo poważna sprawa."
msgstr "OTHER: Men Prince, trots allt är detta en mycket allvarlig fråga."

#. from yeager:scummvm
msgid "OTHER: Ależ książę..."
msgstr "OTHER: Men Prince ..."

#. from yeager:scummvm
msgid "OTHER: ...przecież to|bardzo poważna sprawa."
msgstr "OTHER: ... trots allt är detta en mycket allvarlig fråga."

#. from yeager:scummvm
msgid "$0: Obiecuję, że..."
msgstr "$0: Jag lovar att ..."

#. from yeager:scummvm
msgid "$1: Przysięgam na swój honor, że..."
msgstr "$1: Jag svär på min heder att...."

#. from yeager:scummvm
msgid "$2: Klnę się, że..."
msgstr "$2: Jag förbannar det ..."

#. from yeager:scummvm
msgid "$3: Słowo księcia, że..."
msgstr "$3: Duke's ord att..."

#. from yeager:scummvm
msgid "$4: ...przyjmę od ciebie świętą misję..."
msgstr "4 dollar: ... Jag kommer att acceptera ett heligt uppdrag från dig...."

#. from yeager:scummvm
msgid "$5: ...byłem zawsze bardzo grzeczny..."
msgstr "$5: ...jag har alltid varit mycket artig...."

#. from yeager:scummvm
msgid "$6: ...jesteś moim ideałem wojownika..."
msgstr "$6: ...du är min idealbild av en krigare...."

#. from yeager:scummvm
msgid "$7: ...mam dobre zamiary..."
msgstr "$7: ...jag har goda avsikter...."

#. from yeager:scummvm
msgid "$8: ...i użyję twojej broni..."
msgstr "$8: ...och jag kommer att använda din pistol...."

#. from yeager:scummvm
msgid "$9: ...i po prostu potrzebuję czegoś..."
msgstr "$ 9: ... och jag behöver bara något...."

#. from yeager:scummvm
msgid "$10: ...i oddam twoją broń jeszcze dziś i użyję jej..."
msgstr "10 dollar: ... och jag kommer att lämna över din pistol senare idag och använda den...."

#. from yeager:scummvm
msgid "$11: ...i twoja drogocenna broń zostanie użyta..."
msgstr "$11: ...och ditt dyrbara vapen kommer att användas...."

#. from yeager:scummvm
msgid "$12: ...do wkupienia się w łaski pewnych intrygantów."
msgstr "12 dollar: ...för att vinna vissa ränksmidares gunst."

#. from yeager:scummvm
msgid "$13: ...tylko do zniszczenia zła."
msgstr "13 dollar: ...bara för att förgöra ondskan."

#. from yeager:scummvm
msgid "$14: ...do uwolnienia swojej duszy."
msgstr "14 dollar: ...för att befria din själ."

#. from yeager:scummvm
msgid "$15: ...tylko i wyłącznie do pokojowych celów."
msgstr "15 dollar: ...endast för fredliga ändamål."

