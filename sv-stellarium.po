#. from yeager:stellarium
msgid "Pan"
msgstr "Panorera"

#. from yeager:stellarium
msgid "Greek; goat-god, son of Amalthea and Hermes in some legends, also Zeus' foster brother."
msgstr "Grek; getgud, son till Amalthea och Hermes enligt vissa legender, även Zeus fosterbror."

#. from yeager:stellarium
msgid "Gaea"
msgstr "Gaea"

#. from yeager:stellarium
msgid "Greek mother earth goddess who brought Zeus to Crete."
msgstr "Grekisk moderjordgudinna som förde Zeus till Kreta."

#. from yeager:stellarium
msgid "Ida Facula"
msgstr "Ida Facula"

#. from yeager:stellarium
msgid "Greek; mountain where Zeus played as a child."
msgstr "Grekiska; berg där Zeus lekte som barn."

#. from yeager:stellarium
msgid "Lyctos Facula"
msgstr "Lyctos Facula"

#. from yeager:stellarium
msgid "Greek; area in Crete where Zeus was raised."
msgstr "Grekisk; område på Kreta där Zeus växte upp."

#. from yeager:stellarium
msgid "Agape"
msgstr "Agape"

#. from yeager:stellarium
msgid "Spirit in Spenser's “Fairy Queene.”"
msgstr "Anden i Spensers \"Fairy Queene\""

#. from yeager:stellarium
msgid "Berylune"
msgstr "Berylune"

#. from yeager:stellarium
msgid "Good spirit in Maeterlinck's “The Bluebird.”"
msgstr "God anda i Maeterlincks \"Bluebird\""

#. from yeager:stellarium
msgid "Abans"
msgstr "Abans"

#. from yeager:stellarium
msgid "Spirit of the iron mines."
msgstr "Järnmalmsgruvornas anda."

#. from yeager:stellarium
msgid "Ataksak"
msgstr "Ataksak"

#. from yeager:stellarium
msgid "Eskimo benevolent spirit."
msgstr "Eskimåernas välvilliga ande."

#. from yeager:stellarium
msgid "Deive"
msgstr "Deive"

#. from yeager:stellarium
msgid "Spirit of beautiful maiden."
msgstr "Den vackra jungfruns ande."

#. from yeager:stellarium
msgid "Djadek"
msgstr "Djadek"

#. from yeager:stellarium
msgid "Czech ancestral benevolent spirit and household guardian."
msgstr "Tjeckisk välvillig ande från förfäderna och väktare av hushållet."

#. from yeager:stellarium
msgid "Domovoy"
msgstr "Domovoy"

#. from yeager:stellarium
msgid "Slavic spirit protector of home."
msgstr "Slavisk ande som skyddar hemmet."

#. from yeager:stellarium
msgid "Finvara"
msgstr "Finvara"

#. from yeager:stellarium
msgid "Irish king of spirits; provided horses and wine to men."
msgstr "Irländsk kung av spritdrycker; försåg män med hästar och vin."

#. from yeager:stellarium
msgid "Huon"
msgstr "Huon"

#. from yeager:stellarium
msgid "Replaced Oberon as King of Spirits when Oberon died."
msgstr "Ersatte Oberon som andarnas kung när Oberon dog."

#. from yeager:stellarium
msgid "Gwyn"
msgstr "Gwyn"

#. from yeager:stellarium
msgid "Irish god of battle; leads mens' souls to Annwn."
msgstr "Irländsk stridsgud som leder människornas själar till Annwn."

#. from yeager:stellarium
msgid "Laica"
msgstr "Laica"

#. from yeager:stellarium
msgid "Inca good spirit."
msgstr "Inkas goda anda."

#. from yeager:stellarium
msgid "Mab"
msgstr "Mab"

#. from yeager:stellarium
msgid "Queen of Spirits, dethroned Titania."
msgstr "Andarnas drottning, detroniserade Titania."

#. from yeager:stellarium
msgid "Melusine"
msgstr "Melusine"

#. from yeager:stellarium
msgid "Spirit heroine of medieval French story."
msgstr "Andlig hjältinna i medeltida fransk berättelse."

#. from yeager:stellarium
msgid "Oonagh"
msgstr "Oonagh"

#. from yeager:stellarium
msgid "Irish Queen of Fairies."
msgstr "Den irländska drottningen av älvor."

#. from yeager:stellarium
msgid "Rima"
msgstr "Rima"

#. from yeager:stellarium
msgid "Spirit in Hudson's “Green Mansions.”"
msgstr "Spirit i Hudsons \"gröna herrgårdar\""

#. from yeager:stellarium
msgid "Yangoor"
msgstr "Yangoor"

#. from yeager:stellarium
msgid "Spirit that brings day."
msgstr "Ande som ger dag."

#. from yeager:stellarium
msgid "Befana"
msgstr "Befana"

#. from yeager:stellarium
msgid "Good spirit who fills Italian children's stockings with toys on twelfth night."
msgstr "God ande som fyller italienska barns strumpor med leksaker på tolvslaget."

#. from yeager:stellarium
msgid "Brownie Chasma"
msgstr "Brownie Chasma"

#. from yeager:stellarium
msgid "German good spirits who live in woods."
msgstr "Tyska goda andar som bor i skogarna."

#. from yeager:stellarium
msgid "Kachina Chasmata"
msgstr "Kachina Chasmata"

#. from yeager:stellarium
msgid "Pueblo (USA) good spirits who bring rain or other blessings."
msgstr "Pueblo (USA) goda andar som ger regn eller andra välsignelser."

#. from yeager:stellarium
msgid "Kra Chasma"
msgstr "Kra Chasma"

#. from yeager:stellarium
msgid "Vital spirits (Gold Coast)."
msgstr "Vital Spirits (Gold Coast)."

#. from yeager:stellarium
msgid "Kewpie Chasma"
msgstr "Kewpie Chasma"

#. from yeager:stellarium
msgid "British race of quaint spirit babies."
msgstr "Brittisk ras av pittoreska andebebisar."

#. from yeager:stellarium
msgid "Korrigan Chasma"
msgstr "Korrigan Chasma"

#. from yeager:stellarium
msgid "French wind spirits who cure diseases."
msgstr "Franska vindandar som botar sjukdomar."

#. from yeager:stellarium
msgid "Sylph Chasma"
msgstr "Sylfiden Chasma"

#. from yeager:stellarium
msgid "British air spirits who influence the temperaments man."
msgstr "Brittiska luftandar som påverkar människans temperament."

#. from yeager:stellarium
msgid "Pixie Chasma"
msgstr "Pixie Chasma"

#. from yeager:stellarium
msgid "British spirits that live in rocks."
msgstr "Brittiska andar som bor i stenar."

#. from yeager:stellarium
msgid "Sprite Vallis"
msgstr "Sprite Vallis"

#. from yeager:stellarium
msgid "Earth spirits."
msgstr "Jordandar."

#. from yeager:stellarium
msgid "Leprechaun Vallis"
msgstr "Leprechaun Vallis"

#. from yeager:stellarium
msgid "Spirits or dwarfs."
msgstr "Andar eller dvärgar."

#. from yeager:stellarium
msgid "Sky"
msgstr "Himmel"

#. from yeager:stellarium
msgid "Word for 'sky' in the English language."
msgstr "Ord för \"sky\" i det engelska språket."

#. from yeager:stellarium
msgid "Ka'an Arcus"
msgstr "Ka'an Arcus"

#. from yeager:stellarium
msgid "Word for 'sky' in Yucatec Maya."
msgstr "Ord för \"himmel\" på yucatec maya."

#. from yeager:stellarium
msgid "Akasa Linea"
msgstr "Akasa Linea"

#. from yeager:stellarium
msgid "Word for 'sky' in Bengali (Bangla) and related languages."
msgstr "Ord för \"himmel\" på bengali (Bangla) och besläktade språk."

#. from yeager:stellarium
msgid "Wenu Lobus"
msgstr "Wenu Lobus"

#. from yeager:stellarium
msgid "Word for “sky” in the Mapuche language."
msgstr "Ord för \"himmel\" på mapuchespråket."

#. from yeager:stellarium
msgid "Weeyo Lobus"
msgstr "Weeyo Lobus"

#. from yeager:stellarium
msgid "Word for 'sky' in the Pulaar language of western Africa."
msgstr "Ord för \"himmel\" på Pulaar-språket i västra Afrika."

#. from yeager:stellarium
msgid "Minokawa"
msgstr "Minokawa"

#. from yeager:stellarium
msgid "Massive bird that resides beyond the eastern horizon since before time began and causes lunar eclipses in myths of Bagobo (Lumad group at Mindanao Island, S. Philippines)."
msgstr "Massiv fågel som har uppehållit sig bortom den östra horisonten sedan urminnes tider och som orsakar månförmörkelser i myter om Bagobo (Lumad-grupp på ön Mindanao, södra Filippinerna)."

#. from yeager:stellarium
msgid "Huhuk"
msgstr "Huhuk"

#. from yeager:stellarium
msgid "Pawnee (Central USA) Thunderbird, a huge long-necked bird with a forked, jagged tail. The beating of his wings causes thunder."
msgstr "Pawnee (Centrala USA) Thunderbird, en enorm fågel med lång hals och en kluven, taggig stjärt. Hans vingslag orsakar åska."

#. from yeager:stellarium
msgid "Ohnivak"
msgstr "Ohnivak"

#. from yeager:stellarium
msgid "In Czech and Slovak folklore, glowing or burning bird (firebird) with colorful red, gold and orange feathers."
msgstr "I tjeckisk och slovakisk folklore glödande eller brinnande fågel (eldfågel) med färgglada fjädrar i rött, guld och orange."

#. from yeager:stellarium
msgid "Bralgah"
msgstr "Bralgah"

#. from yeager:stellarium
msgid "In myths of Aboriginal Australian people of the Murray River basin, a crane, who tossed an egg from the nest of emu Dinewan into the sky where it became the sun."
msgstr "I myter om aboriginska australiensiska folk i Murray River-bäckenet var det en trana som kastade ett ägg från emun Dinewans bo upp i himlen där det blev till solen."

#. from yeager:stellarium
msgid "Dinewan"
msgstr "Dinewan"

#. from yeager:stellarium
msgid "Emu whose egg created the sun in the myths of Aboriginal Australian people of the Murray River basin."
msgstr "Emu vars ägg skapade solen i myterna hos australiensiska aboriginer i Murrayflodens avrinningsområde."

#. from yeager:stellarium
msgid "Alicanto"
msgstr "Alicanto"

#. from yeager:stellarium
msgid "Chilean mythological nocturnal bird whose wings shine at night with metallic colors so bright that cast no shadow. It lives in small caves and eats metal ores, weight of which gives no possibility to fly."
msgstr "Chilensk mytologisk nattfågel vars vingar lyser på natten med metalliska färger så starka att de inte kastar någon skugga. Den lever i små grottor och äter metallmalm, vars vikt gör att den inte kan flyga."

#. from yeager:stellarium
msgid "Hokioi"
msgstr "Hokioi"

#. from yeager:stellarium
msgid "Maori (New Zealand) mythical bird with enormously long divided tail, which lives in heavens and never visits earth."
msgstr "Maori (Nya Zeeland) mytisk fågel med enormt lång delad stjärt, som lever i himlen och aldrig besöker jorden."

#. from yeager:stellarium
msgid "Lilitu"
msgstr "Lilitu"

#. from yeager:stellarium
msgid "Mesopotamian/Sumerian nocturnal wind demon depicted as woman with wings and birds' feet with talons."
msgstr "Mesopotamisk/sumerisk nattlig vinddemon som avbildas som kvinna med vingar och fågelfötter med klor."

#. from yeager:stellarium
msgid "Wuchowsen"
msgstr "Wuchowsen"

#. from yeager:stellarium
msgid "Abenaki (Algonquians of NE USA) giant bird, named Windblower, who sits upon a rock at the edge of the sky far in the north and produces winds by his wings."
msgstr "Abenaki (Algonquianer i nordöstra USA) jättefågel, kallad Windblower, som sitter på en klippa vid himlens kant långt i norr och skapar vindar med sina vingar."

#. from yeager:stellarium
msgid "Wututu"
msgstr "Wututu"

#. from yeager:stellarium
msgid "Fon (Benin/Dahomey) mythical bird which reconciled the two gods in their dispute and thus ended a great drought."
msgstr "Fon (Benin/Dahomey) mytisk fågel som försonade de två gudarna i deras tvist och därmed gjorde slut på en stor torka."

#. from yeager:stellarium
msgid "Sampati"
msgstr "Sampati"

#. from yeager:stellarium
msgid "In Hindu mythology, a giant bird, vulture, whose wings had been burnt by the blaze of the Sun when he had flown too close to it in racing with his brother."
msgstr "I hinduisk mytologi en gigantisk fågel, gam, vars vingar hade bränts av solens glöd när han hade flugit för nära den i kapplöpning med sin bror."

#. from yeager:stellarium
msgid "Pegasus"
msgstr "Pegasus"

#. from yeager:stellarium
msgid "Winged horse in Greek mythology."
msgstr "Bevingad häst i den grekiska mytologin."

#. from yeager:stellarium
msgid "Tlanuwa Regio"
msgstr "Tlanuwa region"

#. from yeager:stellarium
msgid "Cherokee (Southeast USA), giant birds who scattered the Earth with pieces of serpent which turned into standing pillars of rocks."
msgstr "Cherokee (sydöstra USA), jättefåglar som spred ut bitar av orm över jorden som förvandlades till stående pelare av stenar."

#. from yeager:stellarium
msgid "Gargoyle Saxum"
msgstr "Gargoyle Saxum"

#. from yeager:stellarium
msgid "French, dragon-like monster with wings, bird-like neck, and the ability to breathe fire."
msgstr "Franskt, drakliknande monster med vingar, fågelliknande hals och förmåga att andas eld."

#. from yeager:stellarium
msgid "Roc Saxum"
msgstr "Roc Saxum"

#. from yeager:stellarium
msgid "Enormous bird of prey in Arabic mythology of the Middle East."
msgstr "Enorm rovfågel i arabisk mytologi i Mellanöstern."

#. from yeager:stellarium
msgid "Huginn Saxum"
msgstr "Huginn Saxum"

#. from yeager:stellarium
msgid "Norse, one of the two ravens (together with Muninn) accompanying the supreme god Odin."
msgstr "Nordisk, en av de två korparna (tillsammans med Muninn) som följer med den högsta guden Oden."

#. from yeager:stellarium
msgid "Amihan Saxum"
msgstr "Amihan Saxum"

#. from yeager:stellarium
msgid "Tagalog (Philippines) deity that is depicted as a bird, the first creature to inhabit the universe."
msgstr "Tagalog (Filippinerna) gudom som avbildas som en fågel, den första varelsen som levde i universum."

#. from yeager:stellarium
msgid "Simurgh Saxum"
msgstr "Simurgh Saxum"

#. from yeager:stellarium
msgid "Iranian benevolent bird who possesses all knowledge."
msgstr "Iransk välvillig fågel som besitter all kunskap."

#. from yeager:stellarium
msgid "Boobrie Saxum"
msgstr "Boobrie Saxum"

#. from yeager:stellarium
msgid "Mythological shapeshifting entity inhabiting the lochs (lakes) of the west coast of Scotland. It commonly adopts the appearance of a gigantic water bird."
msgstr "Mytologiskt skepnadsskiftande väsen som lever i sjöarna (lochs) på Skottlands västkust. Den antar vanligen utseendet av en gigantisk vattenfågel."

#. from yeager:stellarium
msgid "Gamayun Saxum"
msgstr "Gamayun Saxum"

#. from yeager:stellarium
msgid "Slavic prophetic bird, symbol of wisdom and knowledge; she is depicted as a large bird with a woman's head."
msgstr "Slavisk profetisk fågel, symbol för visdom och kunskap; hon avbildas som en stor fågel med kvinnohuvud."

#. from yeager:stellarium
msgid "Benben Saxum"
msgstr "Benben Saxum"

#. from yeager:stellarium
msgid "Ancient Egyptian primordial mound that arose from the primordial waters Nu. The god Atum settled upon it to create the world after his flight over the waters in the form of the Bennu bird, who is a piece of his soul."
msgstr "Fornegyptisk urbergshög som uppstod ur urvattnet Nu. Guden Atum slog sig ner på den för att skapa världen efter sin flykt över vattnet i form av fågeln Bennu, som är en del av hans själ."

#. from yeager:stellarium
msgid "Muninn Saxum"
msgstr "Muninn Saxum"

#. from yeager:stellarium
msgid "Norse, one of the two ravens (together with Huginn) accompanying the supreme god Odin."
msgstr "Nordisk, en av de två korparna (tillsammans med Huginn) som följer den högste guden Oden."

#. from yeager:stellarium
msgid "Pouakai Saxum"
msgstr "Pouakai Saxum"

#. from yeager:stellarium
msgid "Māori (Polynesia) monstrous bird who kills and eat humans."
msgstr "Māori (Polynesien) monstruös fågel som dödar och äter människor."

#. from yeager:stellarium
msgid "Ocypete Saxum"
msgstr "Ocypete Saxum"

#. from yeager:stellarium
msgid "Greek, one of the three named harpies, half-maiden and half-bird personification of storm winds, that would snatch and carry things away from Earth."
msgstr "Grekiska, en av de tre namngivna harpyorna, till hälften jungfru och till hälften fågel, personifiering av stormvindar, som skulle rycka och bära bort saker från jorden."

#. from yeager:stellarium
msgid "Strix Saxum"
msgstr "Strix Saxum"

#. from yeager:stellarium
msgid "Roman vampiric bird of ill omen."
msgstr "Romersk vampyrisk fågel med dåligt omen."

#. from yeager:stellarium
msgid "Aetos Saxum"
msgstr "Aetos Saxum"

#. from yeager:stellarium
msgid "Greek, childhood playmate of the supreme god Zeus who was turned into an eagle by Hera."
msgstr "Grek, barndomskamrat till den högste guden Zeus som förvandlades till en örn av Hera."

#. from yeager:stellarium
msgid "Kongamato Saxum"
msgstr "Kongamato Saxum"

#. from yeager:stellarium
msgid "Giant flying creature looking like bird or bat in myths of Kaonde, a Bantu-speaking people of NW Zambia and the adjacent areas of the Democratic Republic of Congo (Zaire)."
msgstr "Jättelik flygande varelse som ser ut som en fågel eller fladdermus i myter om Kaonde, ett bantutalande folk i nordvästra Zambia och angränsande områden i Demokratiska republiken Kongo (Zaire)."

#. from yeager:stellarium
msgid "Thorondor Saxum"
msgstr "Thorondor Saxum"

#. from yeager:stellarium
msgid "King of the Eagles in the Middle-earth, the fictional setting in fantasy novels by English author J.R.R. Tolkien, the greatest of all eagles, with a wingspan of 55 m (approximately as this boulder)."
msgstr "Örnarnas kung i Midgård, den fiktiva miljön i fantasyromaner av den engelske författaren J.R.R. Tolkien, den största av alla örnar, med ett vingspann på 55 m (ungefär som detta stenblock)."

#. from yeager:stellarium
msgid "Dodo Saxum"
msgstr "Dodo Saxum"

#. from yeager:stellarium
msgid "Non-flying bird, rounded and gray, a fictional character in the book Alice's Adventure in Wonderland (1865) by English writer Lewis Carroll."
msgstr "Icke flygande fågel, rund och grå, en fiktiv karaktär i boken Alice's Adventure in Wonderland (1865) av den engelske författaren Lewis Carroll."

#. from yeager:stellarium
msgid "Odette Saxum"
msgstr "Odette Saxum"

#. from yeager:stellarium
msgid "Princess turned into White Swan in the ballet Swan Lake (1877) by Russian composer Pyotr Tchaikovsky. This character, which name derives from French, is opposite to Odile, the Black Swan maiden."
msgstr "Prinsessan förvandlas till den vita svanen i baletten Svansjön (1877) av den ryske kompositören Pjotr Tjajkovskij. Denna karaktär, vars namn härstammar från franskan, är motsatsen till Odile, den svarta svanens jungfru."

#. from yeager:stellarium
msgid "Ciinkwia Saxum"
msgstr "Ciinkwia Saxum"

#. from yeager:stellarium
msgid "Thunder-beings of Algonquian mythology (in particular Oklahoma Miami Nation) that live in the sky and cause thunder and lightning. They look like giant eagles, or as birds with a human head."
msgstr "Åskväsen i algonkinernas mytologi (särskilt Oklahoma Miami Nation) som lever i himlen och orsakar åska och blixtar. De ser ut som gigantiska örnar eller som fåglar med människohuvud."

#. from yeager:stellarium
msgid "Gullinkambi Saxum"
msgstr "Gullinkambi Saxum"

#. from yeager:stellarium
msgid "Norse, gold-combed rooster who lives in the heavenly majestic hall Valhalla and wakes gods and heroes."
msgstr "Nordisk, guldkammad tupp som bor i den himmelska majestätiska salen Valhall och väcker gudar och hjältar."

#. from yeager:stellarium
msgid "Aellopus Saxum"
msgstr "Aellopus Saxum"

#. from yeager:stellarium
msgid "Aello; Greek, one of the harpies (together with Celaeno and Ocypete), half-maiden and half-bird personification of storm winds, that would snatch and carry things away from Earth."
msgstr "Aello; grekisk, en av harpyorna (tillsammans med Celaeno och Ocypete), till hälften jungfru och till hälften fågel, personifikation av stormvindar, som skulle rycka och bära bort saker från jorden."

#. from yeager:stellarium
msgid "Odile Saxum"
msgstr "Odile Saxum"

#. from yeager:stellarium
msgid "Black Swan maiden in the ballet Swan Lake (1877) by Russian composer Pyotr Tchaikovsky. This character, which name derives from Old German, is opposite to Odette, the Swan Princess."
msgstr "Jungfrun Svarta svanen i baletten Svansjön (1877) av den ryske kompositören Pjotr Tjajkovskij. Denna karaktär, vars namn härstammar från gammal tyska, är motsatsen till Odette, svanprinsessan."

#. from yeager:stellarium
msgid "Camulatz Saxum"
msgstr "Camulatz Saxum"

#. from yeager:stellarium
msgid "One of four birds which destructed the first race of people carved out of wood in Kʼicheʼ Maya (Guatemala) creation myth."
msgstr "En av fyra fåglar som förstörde den första människorasen som var skulpterad i trä i Kʼicheʼ Mayas (Guatemala) skapelsemyt."

#. from yeager:stellarium
msgid "Celaeno Saxum"
msgstr "Celaeno Saxum"

#. from yeager:stellarium
msgid "Greek, one of the harpies (together with Aellopus and Ocypete), half-maiden and half-bird personification of darkness and storm winds, that would snatch and carry things away from Earth."
msgstr "Grekisk, en av harpyorna (tillsammans med Aellopus och Ocypete), till hälften jungfru och till hälften fågel, personifiering av mörker och stormvindar, som skulle rycka åt sig och bära bort saker från jorden."

#. from yeager:stellarium
msgid "Brami"
msgstr "Brami"

#. from yeager:stellarium
msgid "Norse; Ottar's ancestor."
msgstr "Nordisk; Ottars förfader."

#. from yeager:stellarium
msgid "Bran"
msgstr "Bran"

#. from yeager:stellarium
msgid "Celtic; omnipotent god who watched over people."
msgstr "Keltisk; allsmäktig gud som vakade över människor."

#. from yeager:stellarium
msgid "Buga"
msgstr "Buga"

#. from yeager:stellarium
msgid "Tungu heaven god."
msgstr "Tungu himmel gud."

#. from yeager:stellarium
msgid "Buri"
msgstr "Buri"

#. from yeager:stellarium
msgid "Norse dwarf."
msgstr "Nordisk dvärg."

#. from yeager:stellarium
msgid "Burr"
msgstr "Burr"

#. from yeager:stellarium
msgid "Norse giant; his sons raised up heaven's vault and shaped the Earth."
msgstr "Nordisk jätte; hans söner höjde himlavalvet och formade jorden."

#. from yeager:stellarium
msgid "Dryops"
msgstr "Dryops"

#. from yeager:stellarium
msgid "Greek; son of Dia by Apollo."
msgstr "Grek; son till Dia av Apollo."

#. from yeager:stellarium
msgid "Durinn"
msgstr "Durinn"

#. from yeager:stellarium
msgid "Dag"
msgstr "Dag"

#. from yeager:stellarium
msgid "Danr"
msgstr "Danr"

#. from yeager:stellarium
msgid "Norse; king against whom Konr marched."
msgstr "Nordiska; kung som Konr marscherade mot."

#. from yeager:stellarium
msgid "Dia"
msgstr "Dia"

#. from yeager:stellarium
msgid "Greek; Callisto's sister."
msgstr "Grek; Callistos syster."

#. from yeager:stellarium
msgid "Doh"
msgstr "Doh"

#. from yeager:stellarium
msgid "Ketian shaman who created the earth."
msgstr "Ketian shaman som skapade jorden."

#. from yeager:stellarium
msgid "Bragi"
msgstr "Bragi"

#. from yeager:stellarium
msgid "Skaldic; god of poetry."
msgstr "Skaldisk; poesins gud."

#. from yeager:stellarium
msgid "Bavörr"
msgstr "Bavörr"

#. from yeager:stellarium
msgid "Biflindi"
msgstr "Biflindi"

#. from yeager:stellarium
msgid "Another name for Odinn."
msgstr "Ett annat namn för Odinn."

#. from yeager:stellarium
msgid "Beli"
msgstr "Beli"

#. from yeager:stellarium
msgid "Celtic; father of Caswallawn."
msgstr "Celtic; far till Caswallawn."

#. from yeager:stellarium
msgid "Adal"
msgstr "Adal"

#. from yeager:stellarium
msgid "Norse; son of Karl and Erna."
msgstr "Norska; son till Karl och Erna."

#. from yeager:stellarium
msgid "Ajleke"
msgstr "Ajleke"

#. from yeager:stellarium
msgid "Saami god of holidays."
msgstr "Samisk gud för helgdagar."

#. from yeager:stellarium
msgid "Akycha"
msgstr "Akycha"

#. from yeager:stellarium
msgid "Alaskan name of the sun."
msgstr "Alaskas namn på solen."

#. from yeager:stellarium
msgid "Alfr"
msgstr "Alfr"

#. from yeager:stellarium
msgid "Arcas"
msgstr "Arcas"

#. from yeager:stellarium
msgid "Callisto's child by Zeus."
msgstr "Callistos barn med Zeus."

#. from yeager:stellarium
msgid "Askr"
msgstr "Askr"

#. from yeager:stellarium
msgid "Norse; first man, created from a log drifted ashore on a beach."
msgstr "Nordisk; första människan, skapad av en stock som drivit i land på en strand."

#. from yeager:stellarium
msgid "Audr"
msgstr "Audr"

#. from yeager:stellarium
msgid "Ottar's ancestor."
msgstr "Ottars förfader."

#. from yeager:stellarium
