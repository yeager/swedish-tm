l</notr></td>\n		<td><notr>Δελφίς</notr></td>\n		<td>Dolphin</td>\n		<td><img width=\"255\" src=\"illustrations/del_sw_bg.png\"/></td>\n	</tr>\n	<tr valign=\"top\">\n		<td><notr>Equ</notr></td>\n		<td><notr>Προτομή</notr></td>\n		<td>Byst [av en häst]</td>\n		<td>saknas (stjärnor tillhör Dolphin)</td>\n	</tr>\n	<tr valign=\"top\">\n		<td><notr>Peg</notr></td>\n		<td><notr>ʿˊΙππος</notr></td>\n		<td>Häst [ej namngiven]</td>\n		<td><img width=\"255\" src=\"illustrations/peg_sw_bg.png\"/></td>\n	</tr>\n	<tr valign=\"top\">\n		<td><notr>Och</notr></td>\n		<td><notr>...och..</notr></td>\n		<td>Prinsessan Andromeda</td>\n		<td><img width=\"355\" src=\"illustrations/and_sw_bg.png\"/></td>\n	</tr>\n	<tr valign=\"top\">\n		<td><notr>Tri</notr></td>\n		<td><notr>Τρίγωνος</notr></td>\n		<td>Triangel</td>\n		<td>saknad</td>\n	</tr>\n	<tr valign=\"top\">\n		<td><notr>Ari</notr></td>\n		<td><notr>Κριός</notr></td>\n		<td>Ram</td>\n		<td><img width=\"255\" src=\"illustrations/ari_sw_bg.png\"/></td>\n	</tr>\n	<tr valign=\"top\">\n		<td><notr>Tau</notr></td>\n		<td><notr>Ταυ̃ρος</notr></td>\n		<td>Tjur</td>\n		<td><img width=\"255\" src=\"illustrations/tau_sw_bg.png\"/></td>\n	</tr>\n	<tr valign=\"top\">\n		<td><notr>Gem</notr></td>\n		<td><notr>Δίδυμοι</notr></td>\n		<td>Tvillingar</td>\n		<td><img width=\"255\" src=\"illustrations/gem_sw_bg.png\"/></td>\n	</tr>\n	<tr valign=\"top\">\n		<td><notr>Cnc</notr></td>\n		<td><notr>Καρκίνος</notr></td>\n		<td>Kräftan</td>\n		<td><img width=\"255\" src=\"illustrations/cnc_sw_bg.png\"/></td>\n	</tr>\n	<tr valign=\"top\">\n		<td><notr>Lejonet</notr></td>\n		<td><notr>Λέων</notr></td>\n		<td>Lejonet</td>\n		<td><img width=\"255\" src=\"illustrations/leo_sw_bg.png\"/></td>\n	</tr>\n	<tr valign=\"top\">\n		<td><notr>Vir</notr></td>\n		<td><notr>Παρθένος</notr></td>\n		<td>Ung dam</td>\n		<td><img width=\"255\" src=\"illustrations/vir_sw_bg.png\"/></td>\n	</tr>\n	<tr valign=\"top\">\n		<td><notr>Lib</notr></td>\n		<td><notr>Χηλαί</notr></td>\n		<td>Klorna [på skorpionen som bär en balans]</td>\n		<td><img width=\"255\" src=\"illustrations/lib.png\"/></td>\n	</tr>\n	<tr valign=\"top\">\n		<td><notr>Sco</notr></td>\n		<td><notr>Σκορπίος</notr></td>\n		<td>Skorpion</td>\n		<td><img width=\"255\" src=\"illustrations/sco_sw_bg.png\"/></td>\n	</tr>\n	<tr valign=\"top\">\n		<td><notr>Sgr</notr></td>\n		<td><notr>Τοξότης</notr></td>\n		<td>Bågskytt (två ben: detta är satyren Kroton, inte kentauren Cheiron)</td>\n		<td><img width=\"255\" src=\"illustrations/sgr_sw_bg.png\"/></td>\n	</tr>\n	<tr valign=\"top\">\n		<td><notr>Hätta</notr></td>\n		<td><notr>Αίγόκερος</notr></td>\n		<td>den med horn som en get</td>\n		<td><img width=\"255\" src=\"illustrations/cap.png\"/></td>\n	</tr>\n	<tr valign=\"top\">\n		<td><notr>Aqr</notr></td>\n		<td><notr>ʿΥδροχόος</notr></td>\n		<td>Vatten-pourer</td>\n		<td><img width=\"255\" src=\"illustrations/aqr_sw_bg.png\"/></td>\n	</tr>\n	<tr valign=\"top\">\n		<td><notr>Psc</notr></td>\n		<td><notr>två fiskar</notr></td>\n		<td>Två fiskar</td>\n		<td><img width=\"255\" src=\"illustrations/psc_sw_bg.png\"/></td>\n	</tr>\n	<tr valign=\"top\">\n		<td><notr>Cet</notr></td>\n		<td><notr>Κη̃τος</notr></td>\n		<td>Havsmonster</td>\n		<td><img width=\"255\" src=\"illustrations/cet_sw_bg.png\"/></td>\n	</tr>\n	<tr valign=\"top\">\n		<td><notr>Ori</notr></td>\n		<td><notr>ʾΩρίων</notr></td>\n		<td>Orion</td>\n		<td><img width=\"255\" src=\"illustrations/ori_sw_bg.png\"/></td>\n	</tr>\n	<tr valign=\"top\">\n		<td><notr>Eri</notr></td>\n		<td><notr>Ποταμός</notr></td>\n		<td>Floden [namnlös]</td>\n		<td><img width=\"255\" src=\"illustrations/eri.png\"/></td>\n	</tr>\n	<tr>\n		<td><notr>Lep</notr></td>\n		<td><notr>Λαγω̃ς</notr></td>\n		<td>Hare</td>\n		<td><img width=\"255\" src=\"illustrations/lep_sw_bg.png\"/></td>\n	</tr>\n	<tr valign=\"top\">\n		<td><notr>CMa</notr></td>\n		<td><notr>Κύων</notr></td>\n		<td>Hund</td>\n		<td><img width=\"255\" src=\"illustrations/cma_sw_bg.png\"/></td>\n	</tr>\n	<tr valign=\"top\">\n		<td><notr>CMi</notr></td>\n		<td><notr>Προκύων</notr></td>\n		<td>Asterismen före Hunden</td>\n		<td>saknas [täckt av Atlas hand]</td>\n	</tr>\n	<tr valign=\"top\">\n		<td><notr>Arg</notr></td>\n		<td><notr>ʾΑργω</notr></td>\n		<td>Skeppet &quot;Argo&quot;</td>\n		<td><img width=\"255\" src=\"illustrations/arg_sw_bg.png\"/></td>\n	</tr>\n	<tr valign=\"top\">\n		<td><notr>Hya + Crt + Crv</notr></td>\n		<td><notr>ʿˊΥδρος + Κρατήρ + Κóραξ</notr></td>\n		<td>Vattenorm + Krater + Korp</td>\n		<td><img width=\"255\" src=\"illustrations/hya_sw_bg.png\"/></td>\n	</tr>\n	<tr valign=\"top\">\n		<td><notr>Cen</notr></td>\n		<td><notr>Κένταυρος</notr></td>\n		<td>Kentauros</td>\n		<td><img width=\"255\" src=\"illustrations/cen_sw_bg.png\"/></td>\n	</tr>\n	<tr valign=\"top\">\n		<td><notr>Lup</notr></td>\n		<td><notr>Θηρίον</notr></td>\n		<td>Monster</td>\n		<td><img width=\"255\" src=\"illustrations/lup_bg.png\"/></td>\n	</tr>\n	<tr valign=\"top\">\n		<td><notr>Ara</notr></td>\n		<td><notr>Θυμιατήριον</notr></td>\n		<td>Altare</td>\n		<td><img width=\"255\" src=\"illustrations/ara_sw_bg.png\"/></td>\n	</tr>\n	<tr valign=\"top\">\n		<td><notr>CrA</notr></td>\n		<td><notr>Στέφανος Νότιος</notr></td>\n		<td>Södra kransen</td>\n		<td><img width=\"255\" src=\"illustrations/cra_bg.png\"/></td>\n	</tr>\n	<tr valign=\"top\">\n		<td><notr>PsA</notr></td>\n		<td><notr>Södra kransen</notr></td>\n		<td>Södra fisken</td>\n		<td>saknas [täckt av Atlas axel]</td>\n	</tr>\n</table></p>\n\n### Rättvis användning\n\nVi tillhandahåller denna himmelskultur kostnadsfritt, men författarna förtjänar att citeras enligt de vanliga reglerna. Vi tackar dig för din hjälp!"

