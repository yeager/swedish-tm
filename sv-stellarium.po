msgid "Akkuttujuuk, two stars signaling the return of sunlight to the arctic."
msgstr "Akkuttujuuk, två stjärnor som signalerar solens återkomst till Arktis."

#. from transifex:stellarium-stellarium-po-stellarium-skycultures-descriptions-stellarium-skycultures-descriptions-pot--master
msgid "Qimmiitt, five dogs harassing Nanook, or Nanurjuk, the polar bear."
msgstr "Qimmiitt, fem hundar som trakasserar Nanook, eller Nanurjuk, isbjörnen."

#. from transifex:stellarium-stellarium-po-stellarium-skycultures-descriptions-stellarium-skycultures-descriptions-pot--master
