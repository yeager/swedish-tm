msgstr "Afar Lobus"

#. from transifex:stellarium-stellarium-po-stellarium-planetary-features-stellarium-planetary-features-pot--master
msgid "Afar Triangle (Ethiopia), site of many important fossil finds."
msgstr "Afar-triangeln (Etiopien), platsen för många viktiga fossilfynd."

#. from transifex:stellarium-stellarium-po-stellarium-planetary-features-stellarium-planetary-features-pot--master
