msgstr "Vektorlager med icke-matchande funktioner från inmatningslagret"

#. from transifex:qgis-qgis-documentation-6fcaa455c6d127110dd81a327c555432
msgid "**Algorithm ID**: ``native:extractbyattribute``"
msgstr "**Algoritm-id**: ``native:extractbyattribute``"

#. from transifex:qgis-qgis-documentation-6fcaa455c6d127110dd81a327c555432
msgid "The criteria for adding features to the resulting layer is based on a QGIS expression. For more information about expressions see the :ref:`vector_expressions`."
msgstr "Kriterierna för att lägga till funktioner i det resulterande lagret baseras på ett QGIS-uttryck. För mer information om uttryck, se :ref:`vector_expressions`."

#. from transifex:qgis-qgis-documentation-6fcaa455c6d127110dd81a327c555432
msgid ":ref:`qgisselectbyexpression`"
msgstr ":ref:`qgisselectbyexpression`"

#. from transifex:qgis-qgis-documentation-6fcaa455c6d127110dd81a327c555432
