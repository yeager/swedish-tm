msgstr "genom att klicka på knappen |expression|;"

#. from transifex:qgis-qgis-documentation-1e2e731905156cb333bb4a8bc9a82c15
msgid ":ref:`selecting features <sec_selection>` with the |expressionSelect| :sup:`Select By Expression...` tool;"
msgstr ":ref:`välja funktioner <sec_selection>` med verktyget |expressionSelect| :sup:`Välj efter uttryck...`;"

#. from transifex:qgis-qgis-documentation-1e2e731905156cb333bb4a8bc9a82c15
msgid ":ref:`editing attributes <calculate_fields_values>` with e.g. the |calculateField| :sup:`Field calculator` tool;"
msgstr ":ref:`redigering av attribut <calculate_fields_values>` med t.ex. verktyget |calculateField| :sup:`Field calculator`;"

#. from transifex:qgis-qgis-documentation-1e2e731905156cb333bb4a8bc9a82c15
