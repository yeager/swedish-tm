msgstr "**Overstyra projektionen för utdatafilen**"

#. from transifex:qgis-qgis-documentation-8628e5bebc8e7e1d32054bebe27a9ff5
msgid "``OVERCRS``"
msgstr "``OVERCRS``"

#. from transifex:qgis-qgis-documentation-8628e5bebc8e7e1d32054bebe27a9ff5
msgid "If checked, the output file is assigned the input layer CRS."
msgstr "Om markerat tilldelas utdatafilen CRS för inmatningslagret."

#. from transifex:qgis-qgis-documentation-8628e5bebc8e7e1d32054bebe27a9ff5
msgid "**Assign a specified NoData value to output bands**"
msgstr "**Tilldela ett specificerat NoData-värde till utgångsbanden**"

#. from transifex:qgis-qgis-documentation-8628e5bebc8e7e1d32054bebe27a9ff5
msgid "``NODATA``"
msgstr "``NODATA``"

#. from transifex:qgis-qgis-documentation-8628e5bebc8e7e1d32054bebe27a9ff5
msgid "Defines a value that should be inserted for the NoData values in the output raster"
msgstr "Definierar ett värde som ska infogas för NoData-värdena i utdatarastern"

#. from transifex:qgis-qgis-documentation-8628e5bebc8e7e1d32054bebe27a9ff5
