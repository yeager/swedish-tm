msgstr "``CSV``"

#. from transifex:qgis-qgis-documentation-33ddae0642f4fa21dfcacde56a5d3079
msgid "Sets whether the output file should be of type comma-separated values (csv)."
msgstr "Anger om utdatafilen ska vara av typen csv (comma-separated values)."

#. from transifex:qgis-qgis-documentation-33ddae0642f4fa21dfcacde56a5d3079
msgid "**XYZ ASCII file**"
msgstr "**XYZ ASCII-fil**"

#. from transifex:qgis-qgis-documentation-33ddae0642f4fa21dfcacde56a5d3079
msgid "[table]"
msgstr "[tabell]"

#. from transifex:qgis-qgis-documentation-33ddae0642f4fa21dfcacde56a5d3079
msgid "Table file containing the values exported from the raster band."
msgstr "Tabellfil som innehåller de värden som exporterats från rasterbandet."

#. from transifex:qgis-qgis-documentation-33ddae0642f4fa21dfcacde56a5d3079
msgid "**Algorithm ID**: ``gdal:gdal2xyz``"
msgstr "**Algoritm-ID**: ``gdal:gdal2xyz``"

#. from transifex:qgis-qgis-documentation-33ddae0642f4fa21dfcacde56a5d3079
msgid "Converts an 8 bit paletted image to a 24 bit RGB. It will convert a pseudocolor band from the input file to an RGB file of the desired format."
msgstr "Konverterar en 8 bitars paletterad bild till 24 bitars RGB. Den konverterar ett pseudofärgband från indatafilen till en RGB-fil i önskat format."

#. from transifex:qgis-qgis-documentation-33ddae0642f4fa21dfcacde56a5d3079
msgid "This algorithm is derived from the `GDAL pct2rgb utility <https://gdal.org/en/latest/programs/pct2rgb.html>`_."
msgstr "Denna algoritm är hämtad från `GDAL pct2rgb utility <https://gdal.org/en/latest/programs/pct2rgb.html>`_."

#. from transifex:qgis-qgis-documentation-33ddae0642f4fa21dfcacde56a5d3079
msgid "**Default menu**: :menuselection:`Raster --> Conversion`"
msgstr "**Standardmeny**: :menuselection:`Raster --> Konvertering`"

#. from transifex:qgis-qgis-documentation-33ddae0642f4fa21dfcacde56a5d3079
msgid "Input 8 bit raster image"
msgstr "Inmatning 8 bitars rasterbild"

#. from transifex:qgis-qgis-documentation-33ddae0642f4fa21dfcacde56a5d3079
msgid "**Generate a RGBA file**"
msgstr "**Genererar en RGBA-fil**"

#. from transifex:qgis-qgis-documentation-33ddae0642f4fa21dfcacde56a5d3079
