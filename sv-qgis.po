msgid "**Algorithm ID**: ``gdal:rgbtopct``"
msgstr "**Algoritm-ID**: ``gdal:rgbtopct``"

#. from transifex:qgis-qgis-documentation-33ddae0642f4fa21dfcacde56a5d3079
msgid "Converts raster data between different formats."
msgstr "Konverterar rasterdata mellan olika format."

#. from transifex:qgis-qgis-documentation-33ddae0642f4fa21dfcacde56a5d3079
msgid "**Override the projection of the output file**"
msgstr "**Åsidosätt projiceringen av utdatafilen**"

#. from transifex:qgis-qgis-documentation-33ddae0642f4fa21dfcacde56a5d3079
msgid "Specify a projection for the output file"
msgstr "Ange en projektion för utdatafilen"

#. from transifex:qgis-qgis-documentation-33ddae0642f4fa21dfcacde56a5d3079
msgid "Defines the value to use for NoData in the output raster"
msgstr "Definierar det värde som ska användas för NoData i utdatarastern"

#. from transifex:qgis-qgis-documentation-33ddae0642f4fa21dfcacde56a5d3079
msgid "**Copy all subdatasets of this file to individual output files**"
msgstr "**Kopiera alla underdataset i den här filen till enskilda utdatafiler**"

#. from transifex:qgis-qgis-documentation-33ddae0642f4fa21dfcacde56a5d3079
msgid "``COPY_SUBDATASETS``"
msgstr "``COPY_SUBDATASETS``"

#. from transifex:qgis-qgis-documentation-33ddae0642f4fa21dfcacde56a5d3079
msgid "Create individual files for subdatasets"
msgstr "Skapa enskilda filer för underdatauppsättningar"

#. from transifex:qgis-qgis-documentation-33ddae0642f4fa21dfcacde56a5d3079
msgid "Specification of the output (translated) raster layer. :ref:`One of <output_parameter_widget>`:"
msgstr "Specifikation av det utgående (översatta) rasterlagret. :ref:`En av <output_parameter_widget>`:"

