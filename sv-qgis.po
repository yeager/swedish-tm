msgid "**Create an output alpha band**"
msgstr "**Skapa ett alfaband för utdata**"

#. from transifex:qgis-qgis-documentation-8628e5bebc8e7e1d32054bebe27a9ff5
msgid "``ALPHA_BAND``"
msgstr "``ALPHA_BAND``"

