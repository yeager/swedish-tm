msgid "**Source CRS**"
msgstr "**Källa CRS**"

#. from transifex:qgis-qgis-documentation-8628e5bebc8e7e1d32054bebe27a9ff5
msgid "``SOURCE_CRS``"
msgstr "``SOURCE_CRS``"

#. from transifex:qgis-qgis-documentation-8628e5bebc8e7e1d32054bebe27a9ff5
msgid "Set the coordinate reference to use for the input raster"
msgstr "Ange den koordinatreferens som ska användas för inmatningsrastret"

#. from transifex:qgis-qgis-documentation-8628e5bebc8e7e1d32054bebe27a9ff5
msgid "``TARGET_CRS``"
msgstr "``TARGET_CRS``"

#. from transifex:qgis-qgis-documentation-8628e5bebc8e7e1d32054bebe27a9ff5
msgid "Set the coordinate reference to use for the mask layer"
msgstr "Ange den koordinatreferens som ska användas för masklagret"

#. from transifex:qgis-qgis-documentation-8628e5bebc8e7e1d32054bebe27a9ff5
msgid "**Target extent**"
msgstr "** Målets omfattning**"

#. from transifex:qgis-qgis-documentation-8628e5bebc8e7e1d32054bebe27a9ff5
msgid "``TARGET_EXTENT``"
msgstr "``TARGET_EXTENT``"

#. from transifex:qgis-qgis-documentation-8628e5bebc8e7e1d32054bebe27a9ff5
