#. from transifex:qgis-qgis-website-qgis-hugo-docs-md
msgid "{{< block title=\"Get the software, documentation, and further resources\" text-color=\"black\" background-color=\"white\">}}{{< /block >}}"
msgstr "{{< block title=\"Hämta programvaran, dokumentationen och ytterligare resurser\" text-color=\"black\" background-color=\"white\">}}{{< /block >}}"

#. from transifex:qgis-qgis-website-qgis-hugo-docs-md
msgid "{{< block title=\"Downloads\" subtitle=\"We provide downloads for all popular desktop and mobile operating systems. In just a few clicks you can start using our best-in-class software on your own devices!\" text-color=\"white\" background-color=\"#589632\" image=\"downloads.png\">}}{{< /block >}}"
msgstr "{{< block title=\"Nerladdningar\" subtitle=\"Vi erbjuder nedladdningar <tx-placeholder class=\"glossary-highlight\" title=\"\" data-copy-glossary=\"\">för alla populära operativsystem för stationära och mobila enheter. Med bara några få klick kan du börja använda vår förstklassiga programvara på dina egna enheter!\" text-color=\"white\" background-color=\"#589632\" image=\"downloads.png\">}}{{< /block >}}"

#. from transifex:qgis-qgis-website-qgis-hugo-docs-md
msgid "{{< block title=\"Documentation\" subtitle=\"We understand that downloading software is just the beginning of your journey. To transition from a novice to an expert in the shortest time possible, you'll need comprehensive documentation and training materials. Use our technical documentation and training resources to get started.\" text-color=\"black\" background-color=\"white\" image=\"documentation.png\" link-text=\"Learn More\" link=\"https://\">}}{{< /block >}}"
msgstr "{{< block title=\"Dokumentation\" subtitle=\"Vi förstår att nedladdningen av programvaran bara är början på din resa. För att gå från nybörjare till expert på kortast möjliga tid behöver du omfattande dokumentation och utbildningsmaterial. Använd vår tekniska dokumentation och våra utbildningsresurser för att komma igång.\" text-color=\"black\" background-color=\"white\" image=\"documentation.png\" link-text=\"Läs mer\" link=\"https://\">}}{{< /block >}}"

#. from transifex:qgis-qgis-website-qgis-hugo-docs-md
msgid "{{< block title=\"Plugins, styles, and more\" subtitle=\"Maximise the capabilities of QGIS with the numerous resources developed by our community. A rich ecosystem of plugins allows community members to enhance QGIS functionality. Other resources offer ready-to-use cartography styles, access to online data, and much more!\" text-color=\"white\" background-color=\"#589632\" image=\"pluginsstylesandmore.png\" link-text=\"Explore\" link=\"https://\">}}{{< /block >}}"
msgstr "{{< block title=\"<tx-placeholder class=\"glossary-highlight\" title=\"\" data-copy-glossary=\"\">Plugins, stilar och mer\" subtitle=\"Maximera <tx-placeholder class=\"glossary-highlight\" title=\"\" data-copy-glossary=\"\">QGIS:s kapacitet med de många resurser som utvecklats av vår gemenskap. Ett rikt ekosystem av plugins gör det möjligt för gemenskapens medlemmar att förbättra QGIS:s funktionalitet. Andra resurser erbjuder färdiga kartografistilar, tillgång till onlinedata och mycket mer!\" text-color=\"white\" background-color=\"#589632\" image=\"pluginsstylesandmore.png\" link-text=\"Utforska\" link=\"https://\">}}{{< /block >}}"

#. from transifex:qgis-qgis-website-qgis-hugo-docs-md
msgid "{{< block title=\"Stay up to date\" subtitle=\"No matter which social media platform you prefer, you can likely find us there. We'd love to keep you updated with the amazing innovations and advances happening within the QGIS project.\" text-color=\"black\" background-color=\"white\" image=\"stayuptodate.png\" link-text=\"Follow Us\" link=\"https://\">}}{{< /block >}}"
msgstr "{{< block title=\"Håll dig uppdaterad\" subtitle=\"Oavsett vilken social medieplattform du föredrar kan du troligen hitta oss där. Vi vill gärna hålla dig uppdaterad om de fantastiska innovationerna och framstegen inom QGIS-projektet.\" text-color=\"black\" background-color=\"white\" image=\"stayuptodate.png\" link-text=\"Follow Us\" link=\"https://\">}}{{< /block >}}"

#. from transifex:qgis-qgis-website-qgis-hugo-docs-md
msgid "{{< block title=\"Engage with users\" subtitle=\"No matter which medium you prefer, we have community members ready to engage. There are special interest teams for collaboration, a variety of news sources to keep you updated, chat rooms for instant communication, and service providers who are eager to collaborate with you on your QGIS journey.\" text-color=\"white\" background-color=\"#589632\" image=\"engagewithusers.png\" link-text=\"Connect\" link=\"https://\">}}{{< /block >}}"
msgstr "{{< block title=\"Interagera med användarna\" subtitle=\"Oavsett vilket medium du föredrar har vi communitymedlemmar som är redo att engagera sig. Det finns specialintressegrupper för samarbete, en mängd olika nyhetskällor som håller dig uppdaterad, chattrum för direktkommunikation och tjänsteleverantörer som gärna samarbetar med dig på din QGIS-resa.\" text-color=\"white\" background-color=\"#589632\" image=\"engagewithusers.png\" link-text=\"Anslut\" link=\"https://\">}}{{< /block >}}"

#. from transifex:qgis-qgis-website-qgis-hugo-docs-md
msgid "{{< block title=\"Get certified\" subtitle=\"Obtain your professional certification as a QGIS practitioner. We have a global network of certified educators who can cater to your training needs.\" text-color=\"black\" background-color=\"white\" image=\"getcertified.png\" link-text=\"Learn More\" link=\"https://\">}}{{< /block >}}"
msgstr "{{< block title=\"Bli certifierad\" subtitle=\"Skaffa din professionella certifiering som QGIS-användare. Vi har ett globalt nätverk av certifierade utbildare som kan tillgodose dina utbildningsbehov..\" text-color=\"black\" background-color=\"white\" image=\"getcertified.png\" link-text=\"Läs mer\" link=\"https://\">}}{{< /block >}}"

#. from transifex:qgis-qgis-website-qgis-hugo-docs-md
msgid "{{< block title=\"QGIS Association\" subtitle=\"The QGIS Project was initiated in 2002. We take pride in our open governance and community-friendly project management model. This approach empowers all community members, giving them a voice and a sense of agency in the decisions and directions of the project.\" text-color=\"white\" background-color=\"#589632\" image=\"qgisassociation.png\" link-text=\"Learn More\" link=\"https://\">}}{{< /block >}}"
msgstr "{{< block title=\"<tx-placeholder class=\"glossary-highlight\" title=\"QGIS (click to copy)\" data-copy-glossary=\"QGIS\">QGIS-föreningen\" subtitle=\" <tx-placeholder class=\"glossary-highlight\" title=\"QGIS (click to copy)\" data-copy-glossary=\"QGIS\">QGIS-projektet startades 2002. Vi är stolta över vår öppna styrning och vår gemenskapsvänliga projektledningsmodell. Denna strategi ger alla medlemmar i gemenskapen inflytande och en känsla av delaktighet i projektets beslut och inriktning.\" text-color=\"white\" background-color=\"#589632\" image=\"qgisassociation.png\" link-text=\"Läs mer\" link=\"https://\">}}{{< /block >}}"

