msgstr "raster,skapa,slumpmässigt,geometrisk"

#. from yeager:qgis
msgid "Create random raster layer (negative binomial distribution)"
msgstr "Skapa slumpraster (negativ binominal fördelning)"

#. from yeager:qgis
msgid "raster,create,random,negative,binomial,negative-binomial"
msgstr "raster,skapa,slumpmässigt,negativ,binominal,negative-binominal"

#. from yeager:qgis
msgid "Create random raster layer (normal distribution)"
msgstr "Skapa slumpraster (normalfördelning)"

