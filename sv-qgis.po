msgid "With the **DISPLAY** environment variable in the HTTP server configuration."
msgstr "Med miljövariabeln **DISPLAY** i HTTP-serverns konfiguration."

#. from transifex:qgis-qgis-documentation-5d281e2637e5bf9bb2ac4e9ea19331a9
msgid "Installation on Windows"
msgstr "Installation i Windows"

#. from transifex:qgis-qgis-documentation-5d281e2637e5bf9bb2ac4e9ea19331a9
msgid "QGIS Server can also be installed on Windows systems using the OSGeo4W network installer (https://qgis.org/resources/installation-guide/#windows)."
msgstr "QGIS Server kan också installeras på Windows-system med hjälp av nätverksinstallatören OSGeo4W (https://qgis.org/resources/installation-guide/#windows)."

