msgid "**TODO:**"
msgstr "**TODO:**"

#. from transifex:qgis-qgis-documentation-248f54fdcb824842576b63c4df845c40
msgid "creating/modifying symbols"
msgstr "skapa/ändra symboler"

#. from transifex:qgis-qgis-documentation-248f54fdcb824842576b63c4df845c40
msgid "working with style (:class:`QgsStyle <qgis.core.QgsStyle>`)"
msgstr "arbeta med stil (:class:`QgsStyle <qgis.core.QgsStyle>`)"

#. from transifex:qgis-qgis-documentation-248f54fdcb824842576b63c4df845c40
msgid "working with color ramps (:class:`QgsColorRamp <qgis.core.QgsColorRamp>`)"
msgstr "arbeta med färgramper (:class:`QgsColorRamp <qgis.core.QgsColorRamp>`)"

#. from transifex:qgis-qgis-documentation-248f54fdcb824842576b63c4df845c40
