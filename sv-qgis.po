msgstr "**Uttryck**"

#. from transifex:qgis-qgis-documentation-6fcaa455c6d127110dd81a327c555432
msgid "``EXPRESSION``"
msgstr "``EXPRESSION``"

#. from transifex:qgis-qgis-documentation-6fcaa455c6d127110dd81a327c555432
msgid "Expression to filter the vector layer"
msgstr "Uttryck för att filtrera vektorlagret"

#. from transifex:qgis-qgis-documentation-6fcaa455c6d127110dd81a327c555432
msgid "**Matching features**"
msgstr "**Matchande funktioner**"

#. from transifex:qgis-qgis-documentation-6fcaa455c6d127110dd81a327c555432
msgid "**Non-matching**"
msgstr "**Inte matchande**"

#. from transifex:qgis-qgis-documentation-6fcaa455c6d127110dd81a327c555432
msgid "**Algorithm ID**: ``native:extractbyexpression``"
msgstr "**Algoritm-id**: ``native:extractbyexpression``"

#. from transifex:qgis-qgis-documentation-6fcaa455c6d127110dd81a327c555432
msgid "Creates a new vector layer that only contains matching features from an input layer."
msgstr "Skapar ett nytt vektorlager som endast innehåller matchande funktioner från ett inmatningslager."

#. from transifex:qgis-qgis-documentation-6fcaa455c6d127110dd81a327c555432
msgid "The criteria for adding features to the resulting layer is based on the spatial relationship between each feature and the features in an additional layer."
msgstr "Kriterierna för att lägga till funktioner i det resulterande lagret baseras på det spatiala förhållandet mellan varje funktion och funktionerna i ett ytterligare lager."

#. from transifex:qgis-qgis-documentation-6fcaa455c6d127110dd81a327c555432
msgid ":ref:`qgisselectbylocation`, :ref:`qgisextractwithindistance`"
msgstr ":ref:`qgisselectbylocation`, :ref:`qgisextractwithindistance`"

#. from transifex:qgis-qgis-documentation-6fcaa455c6d127110dd81a327c555432
msgid "Exploring spatial relations"
msgstr "Utforska spatiala relationer"

#. from transifex:qgis-qgis-documentation-6fcaa455c6d127110dd81a327c555432
msgid "**Extract features from**"
msgstr "**Extrahera funktioner från**"

#. from transifex:qgis-qgis-documentation-6fcaa455c6d127110dd81a327c555432
msgid "**Where the features (geometric predicate)**"
msgstr "**Var funktionerna (geometriskt predikat)**"

#. from transifex:qgis-qgis-documentation-6fcaa455c6d127110dd81a327c555432
msgid "``PREDICATE``"
msgstr "``PREDICATE``"

#. from transifex:qgis-qgis-documentation-6fcaa455c6d127110dd81a327c555432
msgid "Default: [0]"
msgstr "Standard: [0]"

#. from transifex:qgis-qgis-documentation-6fcaa455c6d127110dd81a327c555432
msgid "Type of spatial relation the input feature should have with an intersect feature so that it could be selected. One or more of:"
msgstr "Typ av spatial relation som indatafunktionen bör ha med en intersect-funktion för att den ska kunna väljas. En eller flera av:"

#. from transifex:qgis-qgis-documentation-6fcaa455c6d127110dd81a327c555432
msgid "0 --- intersect"
msgstr "0 --- korsa"

#. from transifex:qgis-qgis-documentation-6fcaa455c6d127110dd81a327c555432
msgid "1 --- contain"
msgstr "1 --- innehåller"

#. from transifex:qgis-qgis-documentation-6fcaa455c6d127110dd81a327c555432
msgid "2 --- disjoint"
msgstr "2 --- åtskilda"

#. from transifex:qgis-qgis-documentation-6fcaa455c6d127110dd81a327c555432
msgid "3 --- equal"
msgstr "3 --- lika"

#. from transifex:qgis-qgis-documentation-6fcaa455c6d127110dd81a327c555432
msgid "4 --- touch"
msgstr "4 --- beröring"

#. from transifex:qgis-qgis-documentation-6fcaa455c6d127110dd81a327c555432
msgid "5 --- overlap"
msgstr "5 --- överlappning"

#. from transifex:qgis-qgis-documentation-6fcaa455c6d127110dd81a327c555432
msgid "6 --- are within"
msgstr "6 --- är inom"

#. from transifex:qgis-qgis-documentation-6fcaa455c6d127110dd81a327c555432
msgid "7 --- cross"
msgstr "7 --- kors"

#. from transifex:qgis-qgis-documentation-6fcaa455c6d127110dd81a327c555432
msgid "If more than one condition is chosen, at least one of them (OR operation) has to be met for a feature to be extracted."
msgstr "Om mer än ett villkor väljs måste minst ett av dem (OR-operationen) uppfyllas för att en funktion ska kunna extraheras."

#. from transifex:qgis-qgis-documentation-6fcaa455c6d127110dd81a327c555432
msgid "**By comparing to the features from**"
msgstr "**Genom att jämföra med funktionerna från**"

#. from transifex:qgis-qgis-documentation-6fcaa455c6d127110dd81a327c555432
msgid "Intersection vector layer"
msgstr "Vektorlager för korsning"

#. from transifex:qgis-qgis-documentation-6fcaa455c6d127110dd81a327c555432
msgid "**Extracted (location)**"
msgstr "**Utdragna (plats)**"

#. from transifex:qgis-qgis-documentation-6fcaa455c6d127110dd81a327c555432
msgid "Specify the output vector layer for the features that have the chosen spatial relationship(s) with one or more features in the comparison layer. :ref:`One of <output_parameter_widget>`:"
msgstr "Ange utmatningsvektorlagret för de funktioner som har de valda spatiala relationerna med en eller flera funktioner i jämförelselagret. :ref:`En av <output_parameter_widget>`:"

#. from transifex:qgis-qgis-documentation-6fcaa455c6d127110dd81a327c555432
msgid "Vector layer with features from the input layer that have the chosen spatial relationship(s) with one or more features in the comparison layer."
msgstr "Vektorlager med funktioner från inmatningslagret som har det eller de valda spatiala förhållandena med en eller flera funktioner i jämförelselagret."

#. from transifex:qgis-qgis-documentation-6fcaa455c6d127110dd81a327c555432
msgid "**Algorithm ID**: ``native:extractbylocation``"
msgstr "**Algoritm-id**: ``native:extractbylocation``"

#. from transifex:qgis-qgis-documentation-6fcaa455c6d127110dd81a327c555432
msgid "Creates a new vector layer that only contains matching features from an input layer. Features are copied wherever they are within the specified maximum distance from the features in an additional reference layer."
msgstr "Skapar ett nytt vektorlager som endast innehåller matchande funktioner från ett inmatningslager. Funktionerna kopieras om de ligger inom det angivna maximala avståndet från funktionerna i ett extra referenslager."

#. from transifex:qgis-qgis-documentation-6fcaa455c6d127110dd81a327c555432
msgid ":ref:`qgisselectwithindistance`, :ref:`qgisextractbylocation`"
msgstr ":ref:`qgisselectwithindistance`, :ref:`qgisextractbylocation`"

#. from transifex:qgis-qgis-documentation-6fcaa455c6d127110dd81a327c555432
msgid "Input vector layer to copy features from"
msgstr "Ingångsvektorlager för att kopiera funktioner från"

#. from transifex:qgis-qgis-documentation-6fcaa455c6d127110dd81a327c555432
msgid "``REFERENCE``"
msgstr "``REFERENCE``"

#. from transifex:qgis-qgis-documentation-6fcaa455c6d127110dd81a327c555432
msgid "Vector layer whose features closeness is used"
msgstr "Vektorlager vars egenskaper närhet används"

#. from transifex:qgis-qgis-documentation-6fcaa455c6d127110dd81a327c555432
msgid "**Where the features are within**"
msgstr "**Var funktionerna finns inom**"

#. from transifex:qgis-qgis-documentation-6fcaa455c6d127110dd81a327c555432
msgid "``DISTANCE``"
msgstr "``DISTANCE``"

#. from transifex:qgis-qgis-documentation-6fcaa455c6d127110dd81a327c555432
msgid "The maximum distance around reference features to select input features within"
msgstr "Det maximala avståndet runt referensobjekten för att välja inmatningsobjekt inom"

#. from transifex:qgis-qgis-documentation-6fcaa455c6d127110dd81a327c555432
msgid "**Modify current selection by**"
msgstr "**Ändra aktuellt urval genom**"

#. from transifex:qgis-qgis-documentation-6fcaa455c6d127110dd81a327c555432
msgid "``METHOD``"
msgstr "``METHOD``"

#. from transifex:qgis-qgis-documentation-6fcaa455c6d127110dd81a327c555432
msgid "How the selection of the algorithm should be managed. One of:"
msgstr "Hur valet av algoritm ska hanteras. En av:"

#. from transifex:qgis-qgis-documentation-6fcaa455c6d127110dd81a327c555432
msgid "0 --- creating new selection"
msgstr "0 --- skapa nytt urval"

#. from transifex:qgis-qgis-documentation-6fcaa455c6d127110dd81a327c555432
