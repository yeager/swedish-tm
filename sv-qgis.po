msgstr "Stigningslager"

#. from yeager:qgis
msgid "Total climb"
msgstr "Total stigning"

#. from yeager:qgis
msgid "Total descent"
msgstr "Total nedstigning"

#. from yeager:qgis
msgid "The layer does not have Z values. If you have a DEM, use the Drape algorithm to extract Z values."
msgstr "Lagret har inte Z-värden. Om du har en DEM, använd algoritmen drapera för att extrahera Z-värden."

