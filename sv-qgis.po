msgstr "Marginaler runt etikettens text, i den enhet du väljer"

#. from transifex:qgis-qgis-documentation-209ed3ee0edd73ebd004db4bdc659472
msgid ":guilabel:`Line style`"
msgstr ":guilabel:`Linjestil`"

#. from transifex:qgis-qgis-documentation-209ed3ee0edd73ebd004db4bdc659472
