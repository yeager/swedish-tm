msgstr "0 --- Avstånd till närmaste punkt på objektet"

#. from transifex:qgis-qgis-documentation-7522e7bc2f074529459a4a9310dbcd94
msgid "1 --- Distance to feature centroid"
msgstr "1 --- Avstånd till objektets tyngdpunkt"

#. from transifex:qgis-qgis-documentation-7522e7bc2f074529459a4a9310dbcd94
msgid "**Maximum number of neighbors**"
msgstr "**Maximalt antal grannar**"

#. from transifex:qgis-qgis-documentation-7522e7bc2f074529459a4a9310dbcd94
msgid "``NEIGHBORS``"
msgstr "``NEIGHBORS``"

#. from transifex:qgis-qgis-documentation-7522e7bc2f074529459a4a9310dbcd94
msgid "Maximum number of neighbors to look for"
msgstr "Maximalt antal grannar att leta efter"

#. from transifex:qgis-qgis-documentation-7522e7bc2f074529459a4a9310dbcd94
msgid "**Maximum distance**"
msgstr "**Maximalt avstånd**"

#. from transifex:qgis-qgis-documentation-7522e7bc2f074529459a4a9310dbcd94
msgid "Only destination features which are closer than this distance will be considered."
msgstr "Endast destinationsfunktioner som ligger närmare än detta avstånd kommer att beaktas."

#. from transifex:qgis-qgis-documentation-7522e7bc2f074529459a4a9310dbcd94
msgid "**Shortest lines**"
msgstr "**Kortaste linjerna**"

#. from transifex:qgis-qgis-documentation-7522e7bc2f074529459a4a9310dbcd94
msgid "Line vector layer joining source features to their nearest neighbor(s) in the destination layer. Contains all attributes for both source and destination features, and the computed distance."
msgstr "Linjevektorlager som sammanfogar källfunktioner med deras närmaste granne(r) i destinationslagret. Innehåller alla attribut för både käll- och destinationsobjekten samt det beräknade avståndet."

