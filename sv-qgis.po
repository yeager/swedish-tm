msgstr "**Algoritm-ID**: ``gdal:translate``"

#. from transifex:qgis-qgis-documentation-37c03d49ba3123d703c3e0001536afd8
msgid "Lesson: GRASS Tools"
msgstr "Lektion: GRASS-verktyg"

#. from transifex:qgis-qgis-documentation-37c03d49ba3123d703c3e0001536afd8
msgid "In this lesson we will present a selection of tools to give you an idea of the capabilities of GRASS."
msgstr "I den här lektionen kommer vi att presentera ett urval av verktyg för att ge dig en uppfattning om GRASS möjligheter."

#. from transifex:qgis-qgis-documentation-37c03d49ba3123d703c3e0001536afd8
msgid ":abbr:`★☆☆ (Basic level)` Follow Along: Create an aspect map"
msgstr ":abbr:`★☆☆ (Grundläggande nivå)` Följ med: Skapa en aspektkarta"

#. from transifex:qgis-qgis-documentation-37c03d49ba3123d703c3e0001536afd8
msgid "Open the :guilabel:`GRASS Tools` tab"
msgstr "Öppna fliken :guilabel:`GRASS Tools`"

#. from transifex:qgis-qgis-documentation-37c03d49ba3123d703c3e0001536afd8
