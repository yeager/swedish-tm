msgstr "**Andra alternativ för skapande**"

#. from transifex:qgis-qgis-documentation-8628e5bebc8e7e1d32054bebe27a9ff5
msgid "**Output data type**"
msgstr "**Typ av utdata**"

#. from transifex:qgis-qgis-documentation-8628e5bebc8e7e1d32054bebe27a9ff5
msgid "``DATA_TYPE``"
msgstr "``DATA_TYPE``"

#. from transifex:qgis-qgis-documentation-8628e5bebc8e7e1d32054bebe27a9ff5
msgid "Defines the format of the output raster file."
msgstr "Definierar formatet för den utgående rasterfilen."

#. from transifex:qgis-qgis-documentation-8628e5bebc8e7e1d32054bebe27a9ff5
msgid "**Additional command-line parameters**"
msgstr "**Ytterligare kommandoradsparametrar**"

#. from transifex:qgis-qgis-documentation-8628e5bebc8e7e1d32054bebe27a9ff5
msgid "``EXTRA``"
msgstr "``EXTRA``"

