msgstr "Beräkna från layoutkarta...: använder omfattningen av ett :ref:`layoutkartobjekt <layout_map_item>` i det aktiva projektet"

#. from transifex:qgis-qgis-documentation-3773c72a3ef5f2eca69201ec2ee534b0
msgid "Calculate from bookmark…: uses extent of a saved :ref:`bookmark <sec_bookmarks>`"
msgstr "Beräkna från bokmärke...: använder omfattningen av ett sparat :ref:`bokmärke <sec_bookmarks>`"

#. from transifex:qgis-qgis-documentation-3773c72a3ef5f2eca69201ec2ee534b0
msgid "Use map canvas extent"
msgstr "Använd kartans omfattning"

#. from transifex:qgis-qgis-documentation-3773c72a3ef5f2eca69201ec2ee534b0
