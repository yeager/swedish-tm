#. from transifex:qgis-qgis-documentation-6fcaa455c6d127110dd81a327c555432
msgid "7 --- contains"
msgstr "7 --- innehåller"

#. from transifex:qgis-qgis-documentation-6fcaa455c6d127110dd81a327c555432
