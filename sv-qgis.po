msgid "Without user input (native)"
msgstr "Utan användarinmatning (inbyggd)"

#. from transifex:qgis-qgis-documentation-3783fc1800ebed769973bed5bcd82500
msgid "0 --- Byte        (Eight bit unsigned integer (quint8))"
msgstr "0 --- Byte (Åtta bitars osignerat heltal (quint8))"

#. from transifex:qgis-qgis-documentation-3783fc1800ebed769973bed5bcd82500
msgid "1 --- Int16       (Sixteen bit signed integer (qint16))"
msgstr "1 --- Int16 (Sexton bitars signerat heltal (qint16))"

#. from transifex:qgis-qgis-documentation-3783fc1800ebed769973bed5bcd82500
msgid "2 --- UInt16      (Sixteen bit unsigned integer (quint16))"
msgstr "2 --- UInt16 (Sexton bitars osignerat heltal (quint16))"

#. from transifex:qgis-qgis-documentation-3783fc1800ebed769973bed5bcd82500
msgid "3 --- Int32       (Thirty two bit signed integer (qint32))"
msgstr "3 --- Int32 (Trettio tvåbitars signerade heltal (qint32))"

#. from transifex:qgis-qgis-documentation-3783fc1800ebed769973bed5bcd82500
