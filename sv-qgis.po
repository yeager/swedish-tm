#. from yeager:qgis
msgid "Great Meteor Sea Mountain"
msgstr "Stora Meteorsjöberget"

#. from yeager:qgis
msgid "Map of the Great Meteor, a Sea Mountain with ~4000m high, nearby the Azores Island.\nThe Layout template is from the Layout Loader Plugin\n\nThe major exercise of this map was the ability to put bathymetic contours labels following a line from an helper layer called labels, instead of randomly place along the contours.\n\nThis was the expression used on the labels placement geometry generator.\n\n    coalesce(\n	aggregate(\n		'labels', -- layer\n		'collect', -- aggregate type\n		intersection(\n			buffer($geometry,3000),\n			geometry(@parent)\n		), -- Expression\n		intersects(\n			$geometry,\n			geometry(@parent)\n		) -- Filter\n	),\n	$geometry\n    )\n\n\nData: GEBCO (https://www.gebco.net/data_and_products/gridded_bathymetry_data/)"
msgstr "Karta över Great Meteor, ett havsberg med en höjd på ~4000m, i närheten av ön Azorerna.\nLayoutmallen är från Layout Loader Plugin\n\nDen stora övningen på denna karta var möjligheten att sätta bathymetiska konturetiketter efter en linje från ett hjälpskikt som heter etiketter, istället för att slumpmässigt placera längs konturerna.\n\nDetta var det uttryck som användes på geometrigeneratorn för etikettplacering.\n\n    sammanfoga(\n	aggregat(\n		'etiketter', -- lager\n		'collect', -- aggregattyp\n		intersektion(\n			buffert($geometri,3000),\n			geometri(@parent)\n		), -- Uttryck\n		korsar(\n			$geometri,\n			geometri(@förälder)\n		) -- Filter\n	),\n	$geometri\n    )\n\n\nUppgifter: GEBCO (https://www.gebco.net/data_and_products/gridded_bathymetry_data/)"

