msgid "``CROP_TO_CUTLINE``"
msgstr "``CROP_TO_CUTLINE``"

#. from transifex:qgis-qgis-documentation-8628e5bebc8e7e1d32054bebe27a9ff5
msgid "Default: True"
msgstr "Standard: Sann"

#. from transifex:qgis-qgis-documentation-8628e5bebc8e7e1d32054bebe27a9ff5
msgid "Applies the vector layer extent to the output raster if checked."
msgstr "Tillämpar vektorlagrets utsträckning på utdatarastern om detta är markerat."

#. from transifex:qgis-qgis-documentation-8628e5bebc8e7e1d32054bebe27a9ff5
msgid "**Keep resolution of input raster**"
msgstr "**Behåll upplösningen på inmatningsrastret**"

#. from transifex:qgis-qgis-documentation-8628e5bebc8e7e1d32054bebe27a9ff5
msgid "``KEEP_RESOLUTION``"
msgstr "``KEEP_RESOLUTION``"

#. from transifex:qgis-qgis-documentation-8628e5bebc8e7e1d32054bebe27a9ff5
msgid "The resolution of the output raster will not be changed"
msgstr "Upplösningen på utmatningsrastret kommer inte att ändras"

#. from transifex:qgis-qgis-documentation-8628e5bebc8e7e1d32054bebe27a9ff5
msgid "**Set output file resolution**"
msgstr "**Ställ in upplösning för utdatafil**"

#. from transifex:qgis-qgis-documentation-8628e5bebc8e7e1d32054bebe27a9ff5
msgid "``SET_RESOLUTION``"
msgstr "``SET_RESOLUTION``"

#. from transifex:qgis-qgis-documentation-8628e5bebc8e7e1d32054bebe27a9ff5
msgid "Shall the output resolution (cell size) be specified"
msgstr "Ska utmatningsupplösningen (cellstorlek) specificeras"

#. from transifex:qgis-qgis-documentation-8628e5bebc8e7e1d32054bebe27a9ff5
msgid "**X Resolution to output bands**"
msgstr "**X Upplösning till utmatningsband**"

#. from transifex:qgis-qgis-documentation-8628e5bebc8e7e1d32054bebe27a9ff5
msgid "``X_RESOLUTION``"
msgstr "``X_RESOLUTION``"

#. from transifex:qgis-qgis-documentation-8628e5bebc8e7e1d32054bebe27a9ff5
msgid "The width of the cells in the output raster"
msgstr "Bredden på cellerna i utdatarastret"

#. from transifex:qgis-qgis-documentation-8628e5bebc8e7e1d32054bebe27a9ff5
msgid "**Y Resolution to output band**"
msgstr "**Y Upplösning till utgångsband**"

#. from transifex:qgis-qgis-documentation-8628e5bebc8e7e1d32054bebe27a9ff5
msgid "``Y_RESOLUTION``"
msgstr "``Y_RESOLUTION``"

#. from transifex:qgis-qgis-documentation-8628e5bebc8e7e1d32054bebe27a9ff5
msgid "The height of the cells in the output raster"
msgstr "Höjden på cellerna i utdatarastret"

#. from transifex:qgis-qgis-documentation-8628e5bebc8e7e1d32054bebe27a9ff5
msgid "**Use multithreaded warping implementation**"
msgstr "**Använda flertrådig warping-implementering**"

#. from transifex:qgis-qgis-documentation-8628e5bebc8e7e1d32054bebe27a9ff5
msgid "``MULTITHREADING``"
msgstr "``MULTITHREADING``"

#. from transifex:qgis-qgis-documentation-8628e5bebc8e7e1d32054bebe27a9ff5
msgid "Two threads will be used to process chunks of image and perform input/output operation simultaneously. Note that computation is not multithreaded itself."
msgstr "Två trådar kommer att användas för att bearbeta delar av bilden och utföra in- och utmatningsoperationer samtidigt. Observera att själva beräkningen inte är flertrådad."

#. from transifex:qgis-qgis-documentation-8628e5bebc8e7e1d32054bebe27a9ff5
msgid "**Clipped (mask)**"
msgstr "**Klippt (mask)**"

#. from transifex:qgis-qgis-documentation-8628e5bebc8e7e1d32054bebe27a9ff5
msgid "Output raster layer clipped by the vector layer"
msgstr "Utgående rasterlager som klippts av vektorlagret"

#. from transifex:qgis-qgis-documentation-8628e5bebc8e7e1d32054bebe27a9ff5
msgid "**Algorithm ID**: ``gdal:cliprasterbymasklayer``"
msgstr "**Algoritm-ID**: ``gdal:cliprasterbymasklayer``"

#. from transifex:qgis-qgis-documentation-8628e5bebc8e7e1d32054bebe27a9ff5
msgid "Extracts contour lines from any GDAL-supported elevation raster."
msgstr "Extraherar höjdkurvor från alla GDAL-stödda höjdraster."

#. from transifex:qgis-qgis-documentation-8628e5bebc8e7e1d32054bebe27a9ff5
msgid "This algorithm is derived from the `GDAL contour utility <https://gdal.org/en/latest/programs/gdal_contour.html>`_."
msgstr "Denna algoritm är hämtad från `GDAL contour utility <https://gdal.org/en/latest/programs/gdal_contour.html>`_."

#. from transifex:qgis-qgis-documentation-8628e5bebc8e7e1d32054bebe27a9ff5
msgid "Raster band to create the contours from"
msgstr "Rasterband för att skapa konturerna från"

#. from transifex:qgis-qgis-documentation-8628e5bebc8e7e1d32054bebe27a9ff5
msgid "**Interval between contour lines**"
msgstr "**Intervall mellan höjdkurvor**"

#. from transifex:qgis-qgis-documentation-8628e5bebc8e7e1d32054bebe27a9ff5
msgid "``INTERVAL``"
msgstr "``INTERVAL``"

#. from transifex:qgis-qgis-documentation-8628e5bebc8e7e1d32054bebe27a9ff5
msgid "Defines the interval between the contour lines in the given units of the elevation raster (minimum value 0)"
msgstr "Definierar intervallet mellan höjdkurvorna i de angivna enheterna i höjdrastret (minsta värde 0)"

#. from transifex:qgis-qgis-documentation-8628e5bebc8e7e1d32054bebe27a9ff5
msgid "**Attribute name (if not set, no elevation attribute is attached)**"
msgstr "**Attributets namn (om det inte anges är inget höjdattribut kopplat)**"

#. from transifex:qgis-qgis-documentation-8628e5bebc8e7e1d32054bebe27a9ff5
msgid "``FIELD_NAME``"
msgstr "``FIELD_NAME``"

#. from transifex:qgis-qgis-documentation-8628e5bebc8e7e1d32054bebe27a9ff5
msgid "Default: 'ELEV'"
msgstr "Standard: \"ELEV"

#. from transifex:qgis-qgis-documentation-8628e5bebc8e7e1d32054bebe27a9ff5
msgid "Provides a name for the attribute in which to put the elevation."
msgstr "Ger ett namn på det attribut där förhöjningen ska placeras."

#. from transifex:qgis-qgis-documentation-8628e5bebc8e7e1d32054bebe27a9ff5
msgid "**Offset from zero relative to which to interpret intervals**"
msgstr "**Offset från noll i förhållande till vilket intervallen ska tolkas**"

#. from transifex:qgis-qgis-documentation-8628e5bebc8e7e1d32054bebe27a9ff5
