msgstr "``NATURAL_SORT``"

#. from transifex:qgis-qgis-documentation-5040259c1647426ef0fe5278f81b076b
msgid "If checked, naturally sorts the features based on the provided expression (i.e., 'a9' < 'a10')."
msgstr "Om markerad sorteras funktionerna naturligt utifrån det angivna uttrycket (t.ex. 'a9' < 'a10')."

#. from transifex:qgis-qgis-documentation-5040259c1647426ef0fe5278f81b076b
