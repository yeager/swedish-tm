msgstr "Ange fältnamnet för attributen för de anslutna regionerna."

#. from transifex:qgis-qgis-documentation-33ddae0642f4fa21dfcacde56a5d3079
msgid "**Use 8-connectedness**"
msgstr "**Använd 8-anslutning**"

