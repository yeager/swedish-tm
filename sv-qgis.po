msgstr "**X-ursprung för en bricka för parallella körningar**"

#. from transifex:qgis-qgis-documentation-82b7db94955f392ff46f5e943f24c541
msgid "``ORIGIN_X``"
msgstr "``ORIGIN_X``"

#. from transifex:qgis-qgis-documentation-82b7db94955f392ff46f5e943f24c541
msgid "**Y origin of a tile for parallel runs**"
msgstr "**Y-ursprung för en kakelplatta för parallella körningar**"

#. from transifex:qgis-qgis-documentation-82b7db94955f392ff46f5e943f24c541
msgid "``ORIGIN_Y``"
msgstr "``ORIGIN_Y``"

#. from transifex:qgis-qgis-documentation-82b7db94955f392ff46f5e943f24c541
msgid "Output raster layer features of the point cloud layer are exported to. Currently supported format is :file:`.TIF`."
msgstr "Utgående rasterlager som funktioner i punktmolnslagret exporteras till. Format som stöds för närvarande är :file:`.TIF`."

#. from transifex:qgis-qgis-documentation-82b7db94955f392ff46f5e943f24c541
msgid "**Algorithm ID**: ``pdal:exportraster``"
msgstr "**Algoritm-ID**: ``pdal:exportraster``"

#. from transifex:qgis-qgis-documentation-82b7db94955f392ff46f5e943f24c541
msgid "Export raster (using triangulation)"
msgstr "Exportera raster (med hjälp av triangulering)"

#. from transifex:qgis-qgis-documentation-82b7db94955f392ff46f5e943f24c541
msgid "Exports point cloud data to a 2D raster grid using a triangulation of points and then interpolating cell values from triangles."
msgstr "Exporterar punktmolnsdata till ett 2D-rasterraster med hjälp av en triangulering av punkter och sedan interpolering av cellvärden från trianglar."

#. from transifex:qgis-qgis-documentation-82b7db94955f392ff46f5e943f24c541
msgid "Using this algorithm can be slower if you are dealing with a large dataset. If your point cloud is dense, you can export your ground points as a raster using the :ref:`pdalexportraster` algorithm."
msgstr "Den här algoritmen kan vara långsammare om du har att göra med en stor datamängd. Om ditt punktmoln är tätt kan du exportera dina markpunkter som ett raster med hjälp av algoritmen :ref:`pdalexportraster`."

#. from transifex:qgis-qgis-documentation-82b7db94955f392ff46f5e943f24c541
msgid "Terrain raster output generated by point cloud triangulation"
msgstr "Terrängraster som genereras genom triangulering av punktmoln"

#. from transifex:qgis-qgis-documentation-82b7db94955f392ff46f5e943f24c541
msgid "**Exported (using triangulation)**"
msgstr "**Exporterad (med hjälp av triangulering)**"

#. from transifex:qgis-qgis-documentation-82b7db94955f392ff46f5e943f24c541
msgid "**Algorithm ID**: ``pdal:exportrastertin``"
msgstr "**Algoritm-id**: ``pdal:exportrastertin``"

#. from transifex:qgis-qgis-documentation-82b7db94955f392ff46f5e943f24c541
msgid "Exports point cloud data to a vector layer with 3D points (a GeoPackage), optionally with extra attributes."
msgstr "Exporterar punktmolnsdata till ett vektorlager med 3D-punkter (ett GeoPackage), eventuellt med extra attribut."

#. from transifex:qgis-qgis-documentation-82b7db94955f392ff46f5e943f24c541
msgid "Exporting point cloud (ground points) to a vector layer styled based on the elevation"
msgstr "Exportera punktmoln (markpunkter) till ett vektorlager som stylas baserat på höjden"

#. from transifex:qgis-qgis-documentation-82b7db94955f392ff46f5e943f24c541
msgid "[field] [list]"
msgstr "[fält] [lista]"

#. from transifex:qgis-qgis-documentation-82b7db94955f392ff46f5e943f24c541
msgid "One or more fields of the point cloud layer to export with the points."
msgstr "Ett eller flera fält i punktmolnslagret som ska exporteras med punkterna."

#. from transifex:qgis-qgis-documentation-82b7db94955f392ff46f5e943f24c541
msgid "[vector]"
msgstr "[vektor]"

#. from transifex:qgis-qgis-documentation-82b7db94955f392ff46f5e943f24c541
msgid "Specify the vector file to export the data to. :ref:`One of <output_parameter_widget>`:"
msgstr "Ange den vektorfil som data ska exporteras till. :ref:`En av <output_parameter_widget>`:"

#. from transifex:qgis-qgis-documentation-82b7db94955f392ff46f5e943f24c541
msgid "Output vector layer features of the point cloud layer are exported to. Currently supported format is :file:`.GPKG`."
msgstr "Utgångsvektorlager som funktioner i punktmolnslagret exporteras till. Format som stöds för närvarande är :file:`.GPKG`."

#. from transifex:qgis-qgis-documentation-82b7db94955f392ff46f5e943f24c541
msgid "**Algorithm ID**: ``pdal:exportvector``"
msgstr "**Algoritm-id**: ``pdal:exportvector``"

#. from transifex:qgis-qgis-documentation-8628e5bebc8e7e1d32054bebe27a9ff5
msgid "Clips any GDAL-supported raster file to a given extent."
msgstr "Klipper ut en GDAL-stödd rasterfil till en viss utsträckning."

#. from transifex:qgis-qgis-documentation-8628e5bebc8e7e1d32054bebe27a9ff5
msgid "This algorithm is derived from the `GDAL translate utility <https://gdal.org/en/latest/programs/gdal_translate.html>`_."
msgstr "Denna algoritm är hämtad från `GDAL translate utility <https://gdal.org/en/latest/programs/gdal_translate.html>`_."

#. from transifex:qgis-qgis-documentation-8628e5bebc8e7e1d32054bebe27a9ff5
msgid "**Default menu**: :menuselection:`Raster --> Extraction`"
msgstr "**Standardmeny**: :menuselection:`Raster --> Extraktion`"

