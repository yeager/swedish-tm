msgstr "Spara ditt projekt"

#. from transifex:qgis-qgis-documentation-60232da5d2a3cfb62a93f01c696ab675
msgid "Fixing geometry"
msgstr "Fastställande av geometri"

#. from transifex:qgis-qgis-documentation-60232da5d2a3cfb62a93f01c696ab675
