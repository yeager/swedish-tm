msgstr "``RGBA``"

#. from transifex:qgis-qgis-documentation-33ddae0642f4fa21dfcacde56a5d3079
msgid "Sets whether the output file should be of type RGBA."
msgstr "Anger om utdatafilen ska vara av typen RGBA."

#. from transifex:qgis-qgis-documentation-33ddae0642f4fa21dfcacde56a5d3079
msgid "**PCT to RGB**"
msgstr "**PCT till RGB**"

#. from transifex:qgis-qgis-documentation-33ddae0642f4fa21dfcacde56a5d3079
