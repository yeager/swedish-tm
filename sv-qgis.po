msgstr "**HTML-rapport**"

#. from transifex:qgis-qgis-documentation-7522e7bc2f074529459a4a9310dbcd94
msgid "Default:``[Save to temporary file]``"
msgstr "Standard:``[Spara till temporär fil]``"

#. from transifex:qgis-qgis-documentation-7522e7bc2f074529459a4a9310dbcd94
msgid "HTML report of unique values in the :menuselection:`Processing --> Results viewer`. :ref:`One of <output_parameter_widget>`:"
msgstr "HTML-rapport av unika värden i :menuselection:`Bearbetning --> Resultatvisning`. :ref:`En av <output_parameter_widget>`:"

#. from transifex:qgis-qgis-documentation-7522e7bc2f074529459a4a9310dbcd94
msgid "Summary table layer with unique values"
msgstr "Sammanfattande tabellager med unika värden"

#. from transifex:qgis-qgis-documentation-7522e7bc2f074529459a4a9310dbcd94
msgid "HTML report of unique values. Can be opened from the :menuselection:`Processing --> Results viewer`"
msgstr "HTML-rapport över unika värden. Kan öppnas från :menuselection:`Bearbetning --> Resultatvisare`"

#. from transifex:qgis-qgis-documentation-7522e7bc2f074529459a4a9310dbcd94
msgid "**Total unique values**"
msgstr "**Totala unika värden**"

#. from transifex:qgis-qgis-documentation-7522e7bc2f074529459a4a9310dbcd94
msgid "``TOTAL_VALUES``"
msgstr "``TOTAL_VALUES``"

#. from transifex:qgis-qgis-documentation-7522e7bc2f074529459a4a9310dbcd94
msgid "The number of unique values in the input field"
msgstr "Antalet unika värden i inmatningsfältet"

#. from transifex:qgis-qgis-documentation-7522e7bc2f074529459a4a9310dbcd94
msgid "**Unique values concatenated**"
msgstr "**Unika värden sammanlänkade**"

#. from transifex:qgis-qgis-documentation-7522e7bc2f074529459a4a9310dbcd94
