msgstr "**Värde**"

#. from transifex:qgis-qgis-documentation-6fcaa455c6d127110dd81a327c555432
msgid "Value to be evaluated"
msgstr "Värde som ska utvärderas"

#. from transifex:qgis-qgis-documentation-6fcaa455c6d127110dd81a327c555432
msgid "**Extracted (attribute)**"
msgstr "**Extraherad (attribut)**"

#. from transifex:qgis-qgis-documentation-6fcaa455c6d127110dd81a327c555432
msgid "Default: ``[Create Temporary Layer]``"
msgstr "Standard: ``[Create Temporary Layer]``"

#. from transifex:qgis-qgis-documentation-6fcaa455c6d127110dd81a327c555432
msgid "Specify the output vector layer for matching features. :ref:`One of <output_parameter_widget>`:"
msgstr "Ange utdatavektorlagret för matchande funktioner. :ref:`Ett av <output_parameter_widget>`:"

#. from transifex:qgis-qgis-documentation-6fcaa455c6d127110dd81a327c555432
msgid "**Extracted (non-matching)**"
msgstr "**Extraherad (ej matchande)**"

#. from transifex:qgis-qgis-documentation-6fcaa455c6d127110dd81a327c555432
msgid "``FAIL_OUTPUT``"
msgstr "``FAIL_OUTPUT``"

#. from transifex:qgis-qgis-documentation-6fcaa455c6d127110dd81a327c555432
msgid "Specify the output vector layer for non-matching features. :ref:`One of <output_parameter_widget>`:"
msgstr "Ange utdatavektorlagret för icke-matchande funktioner. :ref:`Ett av <output_parameter_widget>`:"

#. from transifex:qgis-qgis-documentation-6fcaa455c6d127110dd81a327c555432
msgid "Vector layer with matching features from the input layer"
msgstr "Vektorlager med matchande funktioner från inmatningslagret"

#. from transifex:qgis-qgis-documentation-6fcaa455c6d127110dd81a327c555432
