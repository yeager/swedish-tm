msgstr "``NCOLORS``"

#. from transifex:qgis-qgis-documentation-33ddae0642f4fa21dfcacde56a5d3079
msgid "The number of colors the resulting image will contain. A value from 2-256 is possible."
msgstr "Antalet färger som den resulterande bilden kommer att innehålla. Ett värde från 2-256 är möjligt."

#. from transifex:qgis-qgis-documentation-33ddae0642f4fa21dfcacde56a5d3079
msgid "**RGB to PCT**"
msgstr "**RGB till PCT**"

#. from transifex:qgis-qgis-documentation-33ddae0642f4fa21dfcacde56a5d3079
