#. from transifex:qgis-qgis-documentation-60232da5d2a3cfb62a93f01c696ab675
msgid "Name the output file :file:`rural_aspect_slope_rainfall.shp`"
msgstr "Namnge utdatafilen :file:`rural_aspect_slope_rainfall.shp`"

#. from transifex:qgis-qgis-documentation-60232da5d2a3cfb62a93f01c696ab675
