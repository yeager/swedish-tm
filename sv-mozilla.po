msgid "Unable to obtain identification status for this site."
msgstr "Kunde inte erhålla identifieringsstatus för webbplatsen."

#. from mozilla:security
msgid "No Information Available"
msgstr "Ingen information tillgänglig"

#. from mozilla:security
msgid "The certificate is not trusted because it hasn’t been verified as issued by a trusted authority using a secure signature."
msgstr "Certifikatet är inte betrott eftersom det inte har verifierats av en betrodd certifikatutfärdare med hjälp av en säker signatur."

#. from mozilla:security
msgid "Unknown Identity"
msgstr "Okänd identitet"

#. from mozilla:security
msgid "This site provides valid, verified identification.  There is no need to add an exception."
msgstr "Platsen har presenterat en giltig och verifierad identifikation.  Du behöver inte lägga till något undantag."

