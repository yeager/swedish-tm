#. from mozilla:browser
msgid "Define domains allowed to access Google Workspace."
msgstr "Definiera domäner som får åtkomst till Google Workspace."

#. from mozilla:browser
msgid "Enable or disable automatic application update."
msgstr "Aktivera eller inaktivera automatisk applikationsuppdatering."

#. from mozilla:browser
msgid "Prevent { -brand-short-name } from being updated beyond the specified version."
msgstr "Förhindra att { -brand-short-name } uppdateras utöver den angivna versionen."

#. from mozilla:browser
msgid "Set custom app update URL."
msgstr "Ange anpassad URL för programuppdateringar."

#. from mozilla:browser
msgid "Configure integrated authentication for websites that support it."
msgstr "Ställ in integrerad autentisering för webbplatser som stödjer det."

#. from mozilla:browser
msgid "Define a list of external protocols that can be used from listed origins without prompting the user."
msgstr "Definiera en lista över externa protokoll som kan användas från listade ursprung utan att uppmana användaren."

#. from mozilla:browser
msgid "Enable autofill for addresses."
msgstr "Aktivera autofyll för adresser."

#. from mozilla:browser
msgid "Enable autofill for payment methods."
msgstr "Aktivera autofyll för betalningsmetoder."

#. from mozilla:browser
msgid "Enable or disable the background updater."
msgstr "Aktivera eller inaktivera uppdateringar i bakgrunden."

#. from mozilla:browser
msgid "Disable backup or restore of profile data."
msgstr "Inaktivera säkerhetskopiering eller återställning av profildata."

#. from mozilla:browser
msgid "Block access to the Add-ons Manager (about:addons)."
msgstr "Blockera tillgång till tilläggshanteraren (about:addons)"

#. from mozilla:browser
msgid "Block access to the about:config page."
msgstr "Blockera tillgång till sidan about:config."

#. from mozilla:browser
msgid "Block access to the about:profiles page."
msgstr "Blockera tillgång till sidan about:profiles."

#. from mozilla:browser
msgid "Block access to the about:support page."
msgstr "Blockera tillgång till sidan about:support."

#. from mozilla:browser
msgid "Create bookmarks in the Bookmarks toolbar, Bookmarks menu, or a specified folder inside them."
msgstr "Skapa bokmärken i bokmärkesfältet, bokmärkesmenyn eller en angiven mapp inuti dem."

#. from mozilla:browser
msgid "Enable or disable captive portal support."
msgstr "Aktivera eller inaktivera captive portal support."

#. from mozilla:browser
msgid "Add certificates or use built-in certificates."
msgstr "Lägg till certifikat eller använd inbyggda certifikat."

#. from mozilla:browser
msgid "Set policies related to containers."
msgstr "Ange policyer relaterade till behållare."

#. from mozilla:browser
msgid "Enable or disable connection to data-loss-prevention agent."
msgstr "Aktivera eller inaktivera anslutningen till agenten för förebyggande av dataförlust."

#. from mozilla:browser
msgid "Allow or deny websites to set cookies."
msgstr "Tillåt eller neka webbplatser att lagra kakor"

#. from mozilla:browser
msgid "Configure DNS over HTTPS."
msgstr "Konfigurera DNS över HTTPS."

#. from mozilla:browser
msgid "Set the default download directory."
msgstr "Ange standard för nedladdningskatalog."

#. from mozilla:browser
msgid "Prevent the browser from updating."
msgstr "Förhindra att webbläsaren uppdateras."

#. from mozilla:browser
msgid "Disable PDF.js, the built-in PDF viewer in { -brand-short-name }."
msgstr "Inaktivera PDF.js, den inbyggda PDF-visaren i { -brand-short-name }."

#. from mozilla:browser
msgid "Prevent the default browser agent from taking any actions. Only applicable to Windows; other platforms don’t have the agent."
msgstr "Förhindra att standardwebbläsaren agerar. Gäller endast Windows; andra plattformar har inte agenten."

#. from mozilla:browser
msgid "Block access to the developer tools."
msgstr "Blockera tillgång till utvecklarverktygen."

#. from mozilla:browser
msgid "Disable use of the TLS feature Encrypted Client Hello (ECH)."
msgstr "Inaktivera användning av TLS-funktionen ECH (Encrypted Client Hello)."

#. from mozilla:browser
msgid "Disable commands to send feedback from the Help menu (Submit Feedback and Report Deceptive Site)."
msgstr "Inaktivera menyalternativen att skicka feedback från hjälpmenyn (Skicka in feedback och rapportera vilseledande webbplats)."

#. from mozilla:browser
msgid "Disable { -fxaccount-brand-name } based services, including Sync."
msgstr "Inaktivera { -fxaccount-brand-name }-baserade tjänster, inklusive Sync."

#. from mozilla:browser
msgid "Disable account-based services, including sync."
msgstr "Inaktivera kontobaserade tjänster, inklusive synkronisering."

#. from mozilla:browser
msgid "Disable the Firefox Screenshots feature."
msgstr "Inaktivera funktionen Firefox Screenshots"

#. from mozilla:browser
msgid "Prevent { -brand-short-name } from running studies."
msgstr "Förhindra { -brand-short-name } att genomföra studier."

#. from mozilla:browser
msgid "Prevent access to the Forget button."
msgstr "Förhindra tillgång till knappen Glöm."

#. from mozilla:browser
msgid "Don’t remember search and form history."
msgstr "Spara inte sök- och formulärhistorik."

#. from mozilla:browser
msgid "Do not allow passwords to be revealed in saved logins."
msgstr "Låt inte lösenord avslöjas i sparade inloggningar."

#. from mozilla:browser
msgid "Disable the feature to save webpages to { -pocket-brand-name }."
msgstr "Inaktivera funktionen att spara webbsidor till { -pocket-brand-name }."

#. from mozilla:browser
msgid "If true, a Primary Password can’t be created."
msgstr "Om det är sant kan ett huvudlösenord inte skapas."

#. from mozilla:browser
msgid "Disable Private Browsing."
msgstr "Inaktivera privat surfning."

#. from mozilla:browser
msgid "Disable the menu command to Import data from another browser."
msgstr "Inaktivera menyalternativet att importera data från en annan webbläsare."

#. from mozilla:browser
msgid "Disable the Refresh { -brand-short-name } button in the about:support page."
msgstr "Inaktivera knappen Återställ { -brand-short-name } på sidan about:support."

#. from mozilla:browser
msgid "Prevent { -brand-short-name } from applying performance, stability, and feature changes between updates."
msgstr "Förhindra { -brand-short-name } från att tillämpa prestanda, stabilitet och funktionsändringar mellan uppdateringar."

#. from mozilla:browser
msgid "Disable the feature to restart in Safe Mode. Note: the Shift key to enter Safe Mode can only be disabled on Windows using Group Policy."
msgstr "Inaktivera funktionen att starta om i felsäkert läge. OBS: Att använda knappen Shift för att starta i felsäkert läge kan bara inaktiveras via grupprinciper på Windows."

#. from mozilla:browser
msgid "Prevent the user from bypassing certain security warnings."
msgstr "Förhindra användaren från att gå vidare vid vissa säkerhetsvarningar."

#. from mozilla:browser
msgid "Disable the menu command Set as Desktop Background for images."
msgstr "Inaktivera menyalternativet Använd som skrivbordsbakgrund för bilder."

#. from mozilla:browser
msgid "Prevent the browser from installing and updating system add-ons."
msgstr "Förhindra webbläsaren att installera och uppdatera systemtillägg."

#. from mozilla:browser
msgid "Turn off Telemetry."
msgstr "Stäng av telemetri."

#. from mozilla:browser
msgid "Prevent the user from blocking third-party modules that get injected into the { -brand-short-name } process."
msgstr "Förhindra användaren från att blockera tredjepartsmoduler som injiceras i { -brand-short-name }-processen."

#. from mozilla:browser
msgid "Disable ciphers."
msgstr "Inaktivera chiffer."

#. from mozilla:browser
msgid "Display the Bookmarks Toolbar by default."
msgstr "Visa bokmärkesfältet som standard."

#. from mozilla:browser
msgid "Display the Menu Bar by default."
msgstr "Visa menyraden som standard."

#. from mozilla:browser
msgid "Disable check for default browser on startup."
msgstr "Inaktivera kontrollen av förvald webbläsare vid start."

#. from mozilla:browser
msgid "Set and lock the download directory."
msgstr "Ange och lås nedladdningskatalogen."

#. from mozilla:browser
msgid "Enable or disable Content Blocking and optionally lock it."
msgstr "Aktivera eller inaktivera Innehållsblockering med möjlighet att låsa valet."

#. from mozilla:browser
msgid "Enable or disable Encrypted Media Extensions and optionally lock it."
msgstr "Aktivera eller inaktivera Encrypted Media Extensions och lås eventuellt inställningen."

#. from mozilla:browser
msgid "Disable warnings based on file extension for specific file types on domains."
msgstr "Inaktivera varningar baserade på filtillägg för specifika filtyper på domäner."

#. from mozilla:browser
msgid "Manage all aspects of extension installation."
msgstr "Hantera alla aspekter av tilläggsinstallation."

#. from mozilla:browser
msgid "Enable or disable automatic extension updates."
msgstr "Aktivera eller inaktivera automatiska tilläggsuppdateringar."

#. from mozilla:browser
msgid "Install, uninstall or lock extensions. The Install option takes URLs or paths as parameters. The Uninstall and Locked options take extension IDs."
msgstr "Installera, avinstallera eller låsa tillägg. Installeringsalternativet tar webbadresser eller sökvägar som parametrar. Alternativen för borttagning och låsning använder tilläggs-ID."

#. from mozilla:browser
msgid "Configure { -firefox-home-brand-name }."
msgstr "Konfigurera { -firefox-home-brand-name }."

#. from mozilla:browser
msgid "Configure { -firefox-suggest-brand-name }."
msgstr "Konfigurera { -firefox-suggest-brand-name }."

#. from mozilla:browser
msgid "Configure generative AI features."
msgstr "Konfigurera generativa AI-funktioner."

#. from mozilla:browser
msgid "Force direct intranet site navigation instead of searching when typing single word entries in the address bar."
msgstr "Tvinga direkt navigering på intranätet istället för att söka när du skriver in enstaka ord i adressfältet."

#. from mozilla:browser
msgid "Configure default application handlers."
msgstr "Konfigurera standardprogramhanterare."

#. from mozilla:browser
msgid "If false, turn off hardware acceleration."
msgstr "Om inaktiv, stäng av hårdvaruacceleration."

#. from mozilla:browser
msgid "Set and optionally lock the homepage."
msgstr "Ställ in och eventuellt lås startsidan."

#. from mozilla:browser
msgid "Origins that will not be upgraded to HTTPS."
msgstr "Ursprung som inte kommer att uppgraderas till HTTPS."

#. from mozilla:browser
msgid "Allow HTTPS-Only Mode to be enabled."
msgstr "Tillåt endast HTTPS-läge."

#. from mozilla:browser
msgid "Allow certain websites to install add-ons."
msgstr "Tillåt vissa webbplatser att installera tillägg."

#. from mozilla:browser
msgid "Disable the feature enforcing a separate profile for each installation."
msgstr "Inaktivera funktionen som framtvingar en separat profil för varje installation"

#. from mozilla:browser
msgid "Enable default legacy SameSite cookie behavior setting."
msgstr "Aktivera standardinställningen för föråldrat SameSite-kakbeteende."

#. from mozilla:browser
msgid "Revert to legacy SameSite behavior for cookies on specified sites."
msgstr "Återgå till föråldrat SameSite-kakbeteende på specifika webbplatser."

#. from mozilla:browser
msgid "Allow specific websites to link to local files."
msgstr "Tillåt specifika webbplatser att länka till lokala filer."

#. from mozilla:browser
msgid "Enable or disable local network access checks."
msgstr "Aktivera eller inaktivera kontroller av lokala nätverksåtkomst."

#. from mozilla:browser
msgid "Configures a list of bookmarks managed by an administrator that cannot be changed by the user."
msgstr "Konfigurerar en lista över bokmärken som hanteras av en administratör som inte kan ändras av användaren."

#. from mozilla:browser
msgid "Allow manual updates only and do not notify the user about updates."
msgstr "Tillåt endast manuella uppdateringar och meddela inte användaren om uppdateringar."

#. from mozilla:browser
msgid "Allow single sign-on for Microsoft Entra accounts."
msgstr "Tillåt enkel inloggning för Microsoft Entra-konton."

#. from mozilla:browser
msgid "Enable or disable network prediction (DNS prefetching)."
msgstr "Aktivera eller inaktivera nätverksprediktning (DNS-prefetch)."

#. from mozilla:browser
msgid "Enable or disable the New Tab page."
msgstr "Aktivera eller inaktivera sidan Ny flik."

#. from mozilla:browser
msgid "Disable creation of the default bookmarks bundled with { -brand-short-name }, and the Smart Bookmarks (Most Visited, Recent Tags). Note: this policy is only effective if used before the first run of the profile."
msgstr "Inaktivera skapandet av standardbokmärken som levereras med { -brand-short-name } och smarta bokmärken (Mest besökta, Senast använda etiketter). OBS: denna policy fungerar bara om den är inställd innan profilen används för första gången."

#. from mozilla:browser
msgid "Enforce the setting to allow { -brand-short-name } to offer to remember saved logins and passwords. Both true and false values are accepted."
msgstr "Påtvinga inställningen att tillåta { -brand-short-name } att kunna komma ihåg sparade inloggningar och lösenord. Både värdena sant och falskt accepteras."

#. from mozilla:browser
msgid "Set the default value for allowing { -brand-short-name } to offer to remember saved logins and passwords. Both true and false values are accepted."
msgstr "Ange standardvärdet för att { -brand-short-name } ska erbjuda att komma ihåg sparade inloggningar och lösenord. Både sanna och falska värden accepteras."

#. from mozilla:browser
msgid "Override the first run page. Set this policy to blank if you want to disable the first run page."
msgstr "Åsidosätt sidan som visas första gången. Sätt denna policy till blankt om du vill inaktivera sidan som visas första gången."

#. from mozilla:browser
msgid "Override the post-update “What’s New” page. Set this policy to blank if you want to disable the post-update page."
msgstr "Åsidosätt sidan \"Vad är nytt\" efter uppdateringar. Sätt denna policy till blankt om du vill inaktivera sidan efter uppdateringar."

#. from mozilla:browser
msgid "Disable or configure PDF.js, the built-in PDF viewer in { -brand-short-name }."
msgstr "Inaktivera eller konfigurera PDF.js, den inbyggda PDF-visaren i { -brand-short-name }"

#. from mozilla:browser
msgid "Enable saving passwords to the password manager."
msgstr "Aktivera att spara lösenord i lösenordshanteraren."

#. from mozilla:browser
msgid "Prevent { -brand-short-name } from saving passwords for specific sites."
msgstr "Förhindra { -brand-short-name } från att spara lösenord för specifika webbplatser."

#. from mozilla:browser
msgid "Configure permissions for camera, microphone, location, notifications, and autoplay."
msgstr "Konfigurera behörigheter för kamera, mikrofon, plats, aviseringar och autoplay."

#. from mozilla:browser
msgid "Enable or disable Picture-in-Picture."
msgstr "Aktivera eller inaktivera bild-i-bild."

#. from mozilla:browser
msgid "Allow certain websites to display popups by default."
msgstr "Tillåt vissa webbplatser att visa popup-fönster som standard."

#. from mozilla:browser
msgid "Allow certain websites to display popups and be redirected by third-party frames."
msgstr "Tillåt vissa webbplatser visa popup-fönster och omdirigeras av ramar från tredje part."

#. from mozilla:browser
msgid "Enable post-quantum key agreement for TLS."
msgstr "Aktivera post-quantum nyckelöverenskommelse för TLS."

#. from mozilla:browser
msgid "Set and lock the value for a subset of preferences."
msgstr "Ställ in och lås värdet för en delmängd av inställningar."

#. from mozilla:browser
msgid "Require or prevent using a Primary Password."
msgstr "Kräv eller förhindra användandet av ett huvudlösenord."

#. from mozilla:browser
msgid "Enable or disable printing."
msgstr "Aktivera eller inaktivera utskrift."

#. from mozilla:browser
msgid "Set availability of private browsing mode."
msgstr "Ange tillgänglighet för privat surfläge."

#. from mozilla:browser
msgid "Ask where to save files when downloading."
msgstr "Fråga var du ska spara filer när du laddar ner."

#. from mozilla:browser
msgid "Configure proxy settings."
msgstr "Ange inställningar för proxy."

#. from mozilla:browser
msgid "Set the list of requested locales for the application in order of preference."
msgstr "Ange listan över begärda språk för programmet efter ordning i inställningar."

#. from mozilla:browser
msgid "Set the maximum SSL version."
