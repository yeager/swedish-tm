msgid "Warning! You are about to send a message of size %S. Are you sure you want to do this?"
msgstr "Varning! Du håller på att skicka ett meddelande med storlek %S som kan överskrida den tillåtna gränsen på e-postservern. Är du säker på att du vill göra det?"

#. from thunderbird:mail
msgid ".doc,.pdf,.xls,.ppt,.rtf,.pps,attachment,attach,attached,attaching,enclosed,CV,cover letter"
msgstr ".doc,.pdf,.xls,.ppt,.rtf,.pps,bilaga,bilagor,bifogar,bifogat,bifogad,bifogade,dokument,CV"

