#. from thunderbird:chat
msgid "{ $commandName } &lt;alias&gt;: Create an alias for the room. Expected room alias of the form ‘#localname:domain’. Requires permission to add aliases."
msgstr "{ $commandName } &lt;alias&gt;: Skapa ett alias för rummet. Förväntat rumsalias i formetet '#localname:domain'. Kräver behörighet för att lägga till alias."

#. from thunderbird:chat
msgid "{ $commandName } &lt;userId&gt; [&lt;reason&gt;]: Ban the user with the userId from the room with optional reason message. Requires permission to ban users."
msgstr "{ $commandName } &lt;userId&gt; [&lt;reason&gt;]: Stäng av användaren med userId från rummet med ett valfritt anledningsmeddelande. Kräver behörighet för att stänga av användare."

#. from thunderbird:chat
msgid "{ $commandName } &lt;userId&gt;: Reset the user to power level 0 (User). Requires permission to change member’s power levels. Does not work on admins other than yourself."
msgstr "{ $commandName } &lt;userId&gt;: Återställ användaren till nivå 0 (Användare). Kräver behörighet för att ändra medlemmarnas nivåer. Fungerar inte på andra administratörer än dig själv."

#. from thunderbird:chat
msgid "{ $commandName }: Display the details of the room."
msgstr "{ $commandName }: Visa detaljerna för rummet."

#. from thunderbird:chat
msgid "{ $commandName } &lt;guest access&gt; &lt;history visibility&gt;: Set the access and history visibility of the current room for the guest users. Enter two integer values, the first for the guest access (not allowed: 0 and allowed: 1) and the second for the history visibility (not visible: 0 and visible: 1). Requires permission to change history visibility."
msgstr "{ $commandName } &lt;guest access&gt; &lt;history visibility&gt;: Ställ in åtkomst och historik synlighet för det aktuella rummet för gästanvändarna. Ange två heltalvärden, det första för gäståtkomst (ej tillåtet: 0 och tillåtet: 1) och det andra för historikens synlighet (ej synlig: 0 och synlig: 1). Kräver behörighet för att ändra historikens synlighet."

#. from thunderbird:chat
msgid "{ $commandName } &lt;userId&gt;: Invite the user to the room."
msgstr "{ $commandName } &lt;userId&gt;: Bjud in användaren till rummet."

#. from thunderbird:chat
msgid "{ $commandName } &lt;roomId&gt;: Join the given room."
msgstr "{ $commandName } &lt;roomId&gt;: Gå med i det givna rummet."

#. from thunderbird:chat
msgid "{ $commandName } &lt;userId&gt; [&lt;reason&gt;]: Kick the user with the userId from the room with optional reason message. Requires permission to kick users."
msgstr "{ $commandName } &lt;userId&gt; [&lt;reason&gt;]: Sparka ut användaren med userId från rummet med ett valfritt anledningsmeddelande. Kräver behörighet för att sparka ut användare."

#. from thunderbird:chat
msgid "{ $commandName }: Leave the current room."
msgstr "{ $commandName }: Lämna det nuvarande rummet."

#. from thunderbird:chat
msgid "{ $commandName } &lt;action&gt;: Perform an action."
msgstr "{ $commandName } &lt;action&gt;: Utför en åtgärd."

#. from thunderbird:chat
msgid "{ $commandName } &lt;userId&gt; &lt;message&gt;: Send a direct message to the given user."
msgstr "{ $commandName } &lt;userId&gt; &lt;message&gt;: Skicka ett direktmeddelande till den givna användaren."

#. from thunderbird:chat
msgid "{ $commandName } &lt;display_name&gt;: Change your display name."
msgstr "{ $commandName } &lt;display_name&gt;: Ändra ditt visningsnamn."

#. from thunderbird:chat
msgid "{ $commandName } &lt;userId&gt; [&lt;power level&gt;]: Define the power level of the user. Enter an integer value, User: 0, Moderator: 50 and Admin: 100. Default will be 50 if no argument is provided. Requires permission to change member’s power levels. Does not work on admins other than yourself."
msgstr "{ $commandName } &lt;userId&gt; [&lt;power level&gt;]: Definiera användarens nivå. Ange ett heltal, Användare: 0, Moderator: 50 och Admin: 100. Standard är 50 om inget argument tillhandahålls. Kräver behörighet för att ändra medlemmarnas nivåer. Fungerar inte på andra administratörer än dig själv."

#. from thunderbird:chat
msgid "{ $commandName } &lt;alias&gt;: Remove the alias for the room. Expected room alias of the form ‘#localname:domain’. Requires permission to remove aliases."
msgstr "{ $commandName } &lt;alias&gt;: Ta bort alias för rummet. Förväntat rumsalias i formatet '#localname:domain'. Kräver behörighet för att ta bort alias."

#. from thunderbird:chat
msgid "{ $commandName } &lt;name&gt;: Set the name for the room. Requires permission to change the room name."
msgstr "{ $commandName } &lt;name&gt;: Ställ in namnet på rummet. Kräver behörighet för att ändra rumsnamnet."

#. from thunderbird:chat
msgid "{ $commandName } &lt;topic&gt;: Set the topic for the room. Requires permissions to change the room topic."
msgstr "{ $commandName } &lt;topic&gt;: Ställ in ämnet för rummet. Kräver behörighet för att ändra rumsämnet."

#. from thunderbird:chat
msgid "{ $commandName } &lt;userId&gt;: Unban a user who is banned from the room. Requires permission to ban users."
msgstr "{ $commandName } &lt;userId&gt;: Avblockera en användare som är utestängd från rummet. Kräver behörighet för att stänga av användare."

#. from thunderbird:chat
msgid "{ $commandName } &lt;newVersion&gt;: Upgrade room to given version. Requires permission to upgrade the room."
msgstr "{ $commandName } &lt;newVersion&gt;: Uppgradera rummet till den aktuella versionen. Kräver behörighet för att uppgradera rummet."

#. from thunderbird:chat
msgid "{ $commandName } [&lt;visibility&gt;]: Set the visibility of the current room in the current Home Server’s room directory. Enter an integer value, Private: 0 and Public: 1. Default will be Private (0) if no argument is provided. Requires permission to change room visibility."
msgstr "{ $commandName } [&lt;visibility&gt;]: Ställ in synligheten för det aktuella rummet i den aktuella hemservers rumskatalog. Ange ett heltal, Privat: 0 och Allmän: 1. Standardinställningen är Privat (0) om inget argument tillhandahålls. Kräver behörighet för att ändra rummets synlighet."

