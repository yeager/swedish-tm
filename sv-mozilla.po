msgid "Warning! You have decided not to use a password. { pippki-pw-empty-warning }"
msgstr "Varning! Du har beslutat att inte använda ett lösenord. { pippki-pw-empty-warning }"

#. from mozilla:security
msgid "Your Primary Password has been reset."
msgstr "Ditt huvudlösenord har återställts."

#. from mozilla:security
msgid "Reset Primary Password"
msgstr "Återställ huvudlösenord"

#. from mozilla:security
msgid "Please authenticate to the token “{ $tokenName }”. How to do so depends on the token (for example, using a fingerprint reader or entering a code with a keypad)."
msgstr "Vänligen autentisera till token \"{ $tokenName }\". Hur man gör det beror på token (till exempel genom att använda en fingeravtrycksläsare eller ange en kod med en knappsats)."

#. from mozilla:security
msgid ".label = Reset"
msgstr ".label = Ta bort"

#. from mozilla:security
msgid "If you reset your Primary Password, all your stored web and e-mail passwords, personal certificates, and private keys will be forgotten. Are you sure you want to reset your Primary Password?"
msgstr "Om du återställer ditt huvudlösenord kommer alla dina lagrade webb- och e-postlösenord, personliga certifikat och privata nycklar att glömmas. Är du säker på att du vill återställa ditt huvudlösenord?"

#. from mozilla:security
msgid ".title = Reset Primary Password .style = min-width: 40em"
msgstr ".title = Återställ huvudlösenord .style = min-width: 40em"

#. from mozilla:security
msgid ".value = Certificate backup password:"
msgstr ".value = Lösenord för certifikatets säkerhetskopia:"

