msgid "No PKCS#11 token could be found to do a required operation."
msgstr "Ingen PKCS#11-token fanns för att utföra ett nödvändigt moment."

#. from mozilla:security
msgid "SSL attempted to send a record that exceeded the maximum permissible length."
msgstr "SSL försökte skicka en post som överskred den maximalt tillåtna längden."

#. from mozilla:security
msgid "The peer tried to resume with an unexpected extended_master_secret extension."
msgstr "Den andra parten försökte återuppta med en oväntad extended_master_secret utökning."

#. from mozilla:security
msgid "Peer does not recognize and trust the CA that issued your certificate."
msgstr "Den andra parten känner inte igen och betror den CA som utfärdade ditt certifikat."

#. from mozilla:security
msgid "An unknown SSL cipher suite has been requested."
msgstr "En okänd SSL-chiffersvit har efterfrågats."

#. from mozilla:security
msgid "SSL peer has no certificate for the requested DNS name."
msgstr "Den andra SSL-parten har inget certifikat för det efterfrågade DNS-namnet."

#. from mozilla:security
msgid "Peer attempted old style (potentially vulnerable) handshake."
msgstr "Den andra parten försökte med en gammal (möjligen sårbar) handskakning."

#. from mozilla:security
msgid "Unsupported certificate type."
msgstr "Certifikattypen stöds inte."

#. from mozilla:security
msgid "SSL peer does not support certificates of the type it received."
msgstr "Den andra SSL-parten stöder inte certifikat av typen den mottog."

#. from mozilla:security
msgid "SSL peer does not support requested TLS hello extension."
msgstr "Den andra SSL-parten stöder inte det efterfrågade tillägget TLS hello."

#. from mozilla:security
msgid "Unsupported hash algorithm used by TLS peer."
msgstr "Hash-algoritmen stöds inte av TLS-parten."

#. from mozilla:security
msgid "The peer used an unsupported combination of signature and hash algorithm."
msgstr "Den andra parten använder en kombination av signatur och hash-algoritm som inte stöds."

#. from mozilla:security
msgid "Peer using unsupported version of security protocol."
msgstr "Den andra parten använder en version av säkerhetsprokollet som inte stöds."

#. from mozilla:security
msgid "Peer user canceled handshake."
msgstr "Den andra parten återkallade handskakningen."

#. from mozilla:security
msgid "Unable to communicate securely. Peer requires high-grade encryption which is not supported."
msgstr "Kan inte kommunicera säkert. Den andra parten kräver en höggradig kryptering som inte stöds."

#. from mozilla:security
msgid "The server certificate included a public key that was too weak."
msgstr "Servercertifikatet innehöll en publik nyckel som var för svag."

#. from mozilla:security
msgid "SSL received a weak ephemeral Diffie-Hellman key in Server Key Exchange handshake message."
msgstr "SSL mottog en svag kortlivad Diffie-Hellman-nyckel i handskakningsmeddelandet Server Key Exchange."

#. from mozilla:security
msgid "Client authentication failed: private key in key database does not match public key in certificate database."
msgstr "Klientautentiseringen misslyckades: den privata nyckeln i nyckeldatabasen matchar inte den öppna nyckeln i certifikatdatabasen."

