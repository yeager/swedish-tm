msgctxt "[\"Mint-Welcome\",\"mintwelcome_sv.po\",\"\",\"235\",\"3464cf77ad914ea8dda0bf1e\"]"
msgid "You can also connect to Matrix and chat with users who are currently online. Ask a question, maybe someone there knows the solution?"
msgstr "Du kan också ansluta till Matrix och chatta med användare som är uppkopplade just nu. Ställ en fråga, kanske någon där har lösningen?"

# Review: 366e5f27d1b839e3facea1ca
# Evidence: https://github.com/yeager/translations/blob/867f2aacbc1144c749cc7b2d9654b861937140e6/Mint-Welcome/mintwelcome_sv.po
