msgctxt "[\"Mint-Welcome\",\"mintwelcome_sv.po\",\"\",\"213\",\"5ad2c10afc683f618c403ac8\"]"
msgid "Control and monitor network traffic by enabling the firewall."
msgstr "Kontrollera och övervaka nätverkstrafik genom att aktivera brandväggen."

# Review: 651f028e55552f18a017d925
# Evidence: https://github.com/yeager/translations/blob/867f2aacbc1144c749cc7b2d9654b861937140e6/Mint-Welcome/mintwelcome_sv.po
# Evidence-SHA256: 53585fb4385e5fe61f1d5369be82f26300ae19e4e462a3d9ffdda1e2ae9519e7
