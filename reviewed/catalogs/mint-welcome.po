msgctxt "[\"Mint-Welcome\",\"mintwelcome_sv.po\",\"\",\"104\",\"59914558a1ab0a9355b843a6\"]"
msgid "Click the button below to read about known bugs, limitations and workarounds for this version of Linux Mint."
msgstr "Klicka på knappen nedan för att läsa om kända fel, begränsningar och problemlösningar för denna version av Linux Mint."

# Review: 5ad2c10afc683f618c403ac8
# Evidence: https://github.com/yeager/translations/blob/867f2aacbc1144c749cc7b2d9654b861937140e6/Mint-Welcome/mintwelcome_sv.po
