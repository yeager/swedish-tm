msgid "Are all walls, beams and columns based on a single line or profile (standard case)?"
msgstr "Är alla väggar, balkar och pelare baserade på en enda linje eller profil (standardfall)?"

# Review: fdf1cd4c2b9622c01f9223d8
# Evidence: https://crowdin.com/translate/freecad-addons/32152/en-sv-SE
# Evidence-SHA256: 1526ae6e4e631612819ad6e0679885d397fcfc03386cd8349e9a6bf349784abe
