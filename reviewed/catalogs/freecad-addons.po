msgctxt "[\"FreeCAD Addons\",\"/Archive/BIM.ts\",\"Form\\n../dialogPreflight.ui:365\",\"32152:6580394\",\"1660b8e4053020d8935b90b7\"]"
msgid "Are all object exportable as extrusions?"
msgstr "Kan alla objekt exporteras som extruderingar?"

# Review: 4a9b56dcaab5d4534aafcb42
# Evidence: https://crowdin.com/translate/freecad-addons/32152/en-sv-SE
# Evidence-SHA256: 1526ae6e4e631612819ad6e0679885d397fcfc03386cd8349e9a6bf349784abe
# Source-evidence: {"crowdin_file": "32152", "crowdin_unit": "6580396", "language": "sv-SE"}
