msgctxt "[\"FreeCAD Addons\",\"/MOOC.ts\",\"MOOC\",\"32160:6588766\",\"572ff8f07061241d943aff9e\"]"
msgid ""
"<h3>Installer l'atelier A2plus</h3>\n"
"            <p>Ouvrir l'addon manager depuis le menu <b>Outils</b> puis\n"
"            <b>Addon manager</b></p>\n"
"            <p>Dans la fenêtre qui s'ouvre et après que la liste des atelier se soit\n"
"            actualisé on sélectionne <b>A2plus</b> puis on clique sur le bouton\n"
"            <b>Install/Update</b>.</p>\n"
"            <p><img src= %s/></p>\n"
"            <p>Une fois l'installation terminé, lorsque la fenêtre indique\n"
"            <b>\"Succesfully installed\"</b> il faut fermer la fenêtre en cliquant sur\n"
"            le bouton <b>Close</b> et, comme indiquer dans la fenêtre de dialogue,\n"
"            <b>Redémarrer FreeCAD</b>.</p>\n"
"            <p>On se retrouve après le redémarrage de FreeCAD.</p>"
msgstr ""
"<h3>Installer l'atelier A2plus</h3>\n"
"            ouvrir l'addon manager depuis le menu <b>Outils</b> puis\n"
"            <b>Addon manager</b></p>\n"
"            <p>I det fönster som öppnas och efter att listan över ateljéer har\n"
"            actualisé on sélectionne <b>A2plus</b> puis on clique sur le bouton\n"
"            <b>Installera/Uppdatera</b>.</p>\n"
"            <p><img src=%s/></p>\n"
"            <p>En gång installationen slutförd, när fönstret indikerar\n"
"            <b>\"Succesfully installed\"</b> il faut fermer la fenêtre en cliquant sur\n"
"            le bouton <b>Close</b> et, comme indiquer dans la fenêtre de dialogue,\n"
"            <b>Redémarrer FreeCAD</b>.</p>\n"
"            <p>On se retrouve après le redémarrage de FreeCAD.</p>"

