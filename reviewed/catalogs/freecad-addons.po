msgid "<html><head/><body><p>Revit discards all objects that contain lines smaller than 1/32 inch (0.8mm). This test will find any object containing lines smaller than that value.</p></body></html>"
msgstr "<html><head/><body><p>Revit kasserar alla objekt som innehåller linjer som är mindre än 0,8 mm (1/32 tum). Detta test kommer att hitta alla objekt som innehåller linjer som är mindre än detta värde.</p></body></html>"

# Review: 013b28113ff34e8b7556947f
# Evidence: https://crowdin.com/translate/freecad-addons/32152/en-sv-SE
# Evidence-SHA256: 1526ae6e4e631612819ad6e0679885d397fcfc03386cd8349e9a6bf349784abe
