msgid "<html><head/><body><p><span style=\" font-weight:600;\">Black List:</span><br/>put here your model names that you don't want to load (e.g. smallest ones)<br/>separated by a semicolon.<br/>DNP or DNF attribute.<br/>volume and height are also configurable.<br/>(volume=1 means all models with a volume &lt; 1mm3 will not be included)<br/>(height=1 means all models with a height &lt; 1mm will not be included)<br/><br/><span style=\" font-weight:600;\">Examples:</span><br/>DNP;R_0402_1005Metric;C_0402_1005Metric;<br/>height=1.0<br/>volume=1.0<br/><span style=\" font-weight:600;\">An empty list means all the models will be parsed.</span></p></body></html>"
msgstr "<html><head/><body><p><span style=\" font-weight:600;\">Svartlista:</span><br/>ange modellnamnen som du inte vill läsa in (t.ex. de minsta)<br/>separerade med semikolon.<br/>DNP- eller DNF-attribut.<br/>Volym och höjd kan också konfigureras.<br/>(volym=1 innebär att alla modeller med en volym &lt; 1mm3 inte tas med)<br/>(höjd=1 innebär att alla modeller med en höjd &lt; 1mm inte tas med)<br/><br/><span style=\" font-weight:600;\">Exempel:</span><br/>DNP;R_0402_1005Metric;C_0402_1005Metric;<br/>height=1.0<br/>volume=1.0<br/><span style=\" font-weight:600;\">En tom lista innebär att alla modeller bearbetas.</span></p></body></html>"

