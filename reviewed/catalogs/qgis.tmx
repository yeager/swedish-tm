<tu tuid="0e2180c9b1ab4a9f8c000036-0"><prop type="id">0e2180c9b1ab4a9f8c000036</prop><prop type="project">QGIS</prop><prop type="component">qgis-application</prop><prop type="context">QgsDb2Provider</prop><prop type="unit">o:qgis:p:QGIS:r:qgis-application:s:5f625a20a35426d568f809601f349908</prop><prop type="publication_status">local-reviewed-pending-upload</prop><prop type="source_plural"></prop><prop type="evidence">https://app.transifex.com/qgis/qgis/translate/#sv/qgis-application/</prop><prop type="evidence_sha256">d6386636fa33d40ee03aa4049a6bc9b44fb65e9ef7e52a315c8b6f2d07b4ddfc</prop><prop type="source_evidence">{}</prop><prop type="note_json">"Bevarar HTML-taggarna runt Qt-platshållaren %1 och platshållaren %2."</prop><prop type="plural_index">0</prop><tuv xml:lang="en"><seg>There was an error opening the database &lt;b&gt;%1&lt;/b&gt;: %2</seg></tuv><tuv xml:lang="sv"><seg>Det uppstod ett fel när databasen &lt;b&gt;%1&lt;/b&gt; öppnades: %2</seg></tuv></tu>
<tu tuid="0e2180c9b1ab4a9f8c000037-0"><prop type="id">0e2180c9b1ab4a9f8c000037</prop><prop type="project">QGIS</prop><prop type="component">qgis-application</prop><prop type="context">QgsIso8601</prop><prop type="unit">o:qgis:p:QGIS:r:qgis-application:s:69dc5ce59df3d7bd85336bb75f1e509e</prop><prop type="publication_status">local-reviewed-pending-upload</prop><prop type="source_plural"></prop><prop type="evidence">https://app.transifex.com/qgis/qgis/translate/#sv/qgis-application/</prop><prop type="evidence_sha256">d6386636fa33d40ee03aa4049a6bc9b44fb65e9ef7e52a315c8b6f2d07b4ddfc</prop><prop type="source_evidence">{}</prop><prop type="note_json">"Bevarar ISO-format, kodtaggar och teckensekvensen [+|-]."</prop><prop type="plural_index">0</prop><tuv xml:lang="en"><seg>Extended format: Either &lt;code&gt;yyyy-MM-dd&lt;/code&gt; for dates or &lt;code&gt;yyyy-MM-ddTHH:mm:ss&lt;/code&gt; (e.g. 2017-07-24T15:46:29), or with a timezone suffix (Z for UTC or an offset as [+|-]HH:mm), where applicable for combined date and time.</seg></tuv><tuv xml:lang="sv"><seg>Utökat format: antingen &lt;code&gt;yyyy-MM-dd&lt;/code&gt; för datum eller &lt;code&gt;yyyy-MM-ddTHH:mm:ss&lt;/code&gt; (t.ex. 2017-07-24T15:46:29), eller med ett tidszonsuffix (Z för UTC, annars en förskjutning som [+|-]HH:mm), där det är lämpligt för kombinerade datum och tider.</seg></tuv></tu>
<tu tuid="0e2180c9b1ab4a9f8c000038-0"><prop type="id">0e2180c9b1ab4a9f8c000038</prop><prop type="project">QGIS</prop><prop type="component">qgis-application</prop><prop type="context">QgsDataProvider</prop><prop type="unit">o:qgis:p:QGIS:r:qgis-application:s:75d5e9b1b751a1d8149d6c36516c66e6</prop><prop type="publication_status">local-reviewed-pending-upload</prop><prop type="source_plural"></prop><prop type="evidence">https://app.transifex.com/qgis/qgis/translate/#sv/qgis-application/</prop><prop type="evidence_sha256">d6386636fa33d40ee03aa4049a6bc9b44fb65e9ef7e52a315c8b6f2d07b4ddfc</prop><prop type="source_evidence">{}</prop><prop type="note_json">"Bevarar hela HTML-strukturen och produktnamnet PostgreSQL."</prop><prop type="plural_index">0</prop><tuv xml:lang="en"><seg>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Some data providers can emit a notification to QGIS, for example PostgreSQL. If this data provider can do so, then the layer will be updated when a notification is received.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</seg></tuv><tuv xml:lang="sv"><seg>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Vissa dataleverantörer kan skicka ett meddelande till QGIS, till exempel PostgreSQL. Om den här dataleverantören kan göra det uppdateras lagret när ett meddelande kommer.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</seg></tuv></tu>
<tu tuid="0e2180c9b1ab4a9f8c000039-0"><prop type="id">0e2180c9b1ab4a9f8c000039</prop><prop type="project">QGIS</prop><prop type="component">qgis-application</prop><prop type="context">QgsAbout</prop><prop type="unit">o:qgis:p:QGIS:r:qgis-application:s:1e9f801f77c3762d47f48458a30c42fa</prop><prop type="publication_status">local-reviewed-pending-upload</prop><prop type="source_plural"></prop><prop type="evidence">https://app.transifex.com/qgis/qgis/translate/#sv/qgis-application/</prop><prop type="evidence_sha256">d6386636fa33d40ee03aa4049a6bc9b44fb65e9ef7e52a315c8b6f2d07b4ddfc</prop><prop type="source_evidence">{}</prop><prop type="note_json">"Bevarar HTML-markup, radslut och produkt- samt organisationsnamn."</prop><prop type="plural_index">0</prop><tuv xml:lang="en"><seg>&lt;p&gt;QGIS is a user friendly Open Source Geographic Information System (GIS) licensed under the GNU General Public License. QGIS is an official project of the Open Source Geospatial Foundation (OSGeo). It runs on Linux, Unix, Mac OS X, Windows and Android and supports numerous vector, raster and database formats and functionalities.&lt;/p&gt;
  </seg></tuv><tuv xml:lang="sv"><seg>&lt;p&gt;QGIS är ett användarvänligt geografiskt informationssystem (GIS) med öppen källkod, licensierat under GNU General Public License. QGIS är ett officiellt projekt hos Open Source Geospatial Foundation (OSGeo). Det körs på Linux, Unix, Mac OS X, Windows och Android och stöder många vektor-, raster- och databasformat samt funktioner.&lt;/p&gt;
  </seg></tuv></tu>
