msgctxt "[\"Translation Project\",\"util-linux-man\",\"\",\"6146\",\"bb777f46e705e491d1977e87\"]"
msgid ""
"$ id -u\n"
"1000\n"
"$ cat /etc/subuid\n"
"1000:100000:65536\n"
"$ unshare --user --map-auto --map-root-user\n"
"# id -u\n"
"0\n"
"# cat /proc/self/uid_map\n"
"         0       1000          1\n"
"         1     100000      65535\n"
"# touch file; chown 1:1 file\n"
"# ls -ln --time-style=+ file\n"
"-rw-r--r-- 1 1 1 0  file\n"
"# exit\n"
"$ ls -ln --time-style=+ file\n"
"-rw-r--r-- 1 100000 100000 0  file\n"
msgstr ""
"$ id -u\n"
"1000\n"
"$ cat /etc/subuid\n"
"1000:100000:65536\n"
"$ unshare --user --map-auto --map-root-user\n"
"# id -u\n"
"0\n"
"# cat /proc/self/uid_map\n"
"         0       1000          1\n"
"         1     100000      65535\n"
"# touch file; chown 1:1 file\n"
"# ls -ln --time-style=+ file\n"
"-rw-r--r-- 1 1 1 0  file\n"
"# exit\n"
"$ ls -ln --time-style=+ file\n"
"-rw-r--r-- 1 100000 100000 0  file\n"

