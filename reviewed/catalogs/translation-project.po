"  -mshort                 använd 16-bitars int-ABI (standard)\n"
"  -mlong                  använd 32-bitars int-ABI\n"
"  -mshort-double          använd 32-bitars double-ABI\n"
"  -mlong-double           använd 64-bitars double-ABI (standard)\n"
"  --force-long-branches   omvandla alltid relativa grenar till absoluta\n"
"  -S,--short-branches     omvandla inte relativa grenar till absoluta\n"
"                          när avståndet är utanför intervallet\n"
"  --strict-direct-mode    omvandla inte direktläge till utökat läge\n"
"                          när instruktionen saknar stöd för direktläge\n"
"  --print-insn-syntax     skriv ut instruktionssyntaxen vid fel\n"
"  --print-opcodes         skriv ut listan över instruktioner med syntax\n"
"  --xgate-ramoffset       förskjut RAM-adresser med 0xc000\n"
"  --generate-example      generera ett exempel för varje instruktion\n"
"                          (används för testning)\n"

