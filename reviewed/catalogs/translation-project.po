"\n"
"  KONVERTERING Skalformatexempel           Utskrift\n"
"  %s           '[%14s]' 'fyll vänster'     [ fyll vänster]\n"
"  %s           '[%-14s]' 'fyll höger'      [fyll höger   ]\n"
"  %c %s        '%c %.3s' un unibyte        u uni\n"
"\n"
"  %d %i        \"%'d ;%04i\" 1234 '-1'       1 234 ;-001\n"
