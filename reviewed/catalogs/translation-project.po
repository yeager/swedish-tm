# Review: 1c647f4f6677e0030a2333a3
# Evidence: https://translationproject.org/domain/tin.html
# Evidence-SHA256: 111972aaa5309f79650bc2829a8de0d1471e575d9f6e907fddb21022603067a0
# Source-evidence: {}
# Publication: reviewed-local
#. Review-note (JSON): "Parameternamnet STRING översätts konsekvent till STRÄNG i den svenska konfigurationsdokumentationen."
msgctxt "[\"Translation Project\",\"tin\",\"\",\"1838\",\"1c647f4f6677e0030a2333a3\"]"
msgid ""
"# Format:\n"
"#   comment=STRING    Optional. Multiple lines allowed. Comments must be placed\n"
"#                     at the beginning of a rule, or they will be moved to the\n"
"#                     next rule. '#' is not a valid keyword for a comment!\n"
"#   group=STRING      Mandatory. Newsgroups list (e.g. comp.*,!*sources*).\n"
"#   case=NUM          Mandatory. Compare=0 / ignore=1 case when filtering.\n"
"#   score=NUM|STRING  Mandatory. Score to give. Either:\n"
"#     score=NUM         A number (e.g. 70). Or:\n"
"#     score=STRING      One of the two keywords: 'hot' or 'kill'.\n"
"#   subj=STRING       Optional. Subject: line (e.g. How to be a wizard).\n"
"#   from=STRING       Optional. From: line (e.g. *Craig Shergold*).\n"
"#   msgid=STRING      Optional. Message-ID: line (e.g. <123@example.net>) with\n"
"#                     full references.\n"
"#   msgid_last=STRING Optional. Like above, but with last reference only.\n"
"#   msgid_only=STRING Optional. Like above, but without references.\n"
"#   refs_only=STRING  Optional. References: line (e.g. <123@example.net>)\n"
"#                     without Message-ID:\n"
"#   lines=[<>]?NUM    Optional. Lines: line. '<' or '>' are optional.\n"
"#   gnksa=[<>]?NUM    Optional. GNKSA parse_from() return code. '<' or '>' opt.\n"
"#   xref=PATTERN      Optional. Kill pattern (e.g. alt.flame*)\n"
"#   path=PATTERN      Optional. Kill pattern (e.g. news.example.org)\n"
"#                     Be aware that filtering on Path: may significantly slow\n"
"#                     down the process.\n"
"#   time=NUM          Optional. time_t value when rule expires\n"
"#\n"
msgstr ""
"# Format:\n"
"# comment=STRÄNG    Valfritt. Flera rader tillåtna. Kommentarer måste placeras\n"
"#                     i början av en regel, annars flyttas de till\n"
"#                     nästa regel. ’#’ är inte ett giltigt nyckelord för en kommentar!\n"
"# group=STRÄNG      Obligatoriskt. Lista över nyhetsgrupper (t.ex. comp.*,!*sources*).\n"
"# case=NUM          Obligatoriskt. Jämför=0 / ignorera=1 skiftläge vid filtrering.\n"
"# score=NUM|STRING  Obligatoriskt. Poäng att ge. Antingen:\n"
"# score=NUM         Ett tal (t.ex. 70). Eller:\n"
"# score=STRÄNG      Ett av de två nyckelorden: ’hot’ eller ’kill’.\n"
"# subj=STRÄNG       Valfritt. Subject:-rad (t.ex. Hur man blir en trollkarl).\n"
"# from=STRÄNG       Valfritt. From:-rad (t.ex. *Craig Shergold*).\n"
"# msgid=STRÄNG      Valfritt. Message-ID:-rad (t.ex. <123@example.net>) med\n"
"#                     fullständiga referenser.\n"
"# msgid_last=STRÄNG Valfritt. Som ovan, men endast med sista referensen.\n"
"# msgid_only=STRÄNG Valfritt. Som ovan, men utan referenser.\n"
"# refs_only=STRÄNG  Valfritt. References:-rad (t.ex. <123@example.net>)\n"
"#                     utan Message-ID:\n"
"# lines=[<>]?NUM    Valfritt. Lines:-rad. ’<’ eller ’>’ är valfritt.\n"
"# gnksa=[<>]?NUM    Valfritt. GNKSA parse_from() returnerar kod. ’<’ eller ’>’ valfritt.\n"
"# xref=MÖNSTER      Valfritt. Bortfiltreringsmönster (t.ex. alt.flame*)\n"
"# path=MÖNSTER      Valfritt. Bortfiltreringsmönster (t.ex. news.example.org)\n"
"#                     Tänk på att filtrering på Path: kan avsevärt sakta\n"
"#                     ner processen.\n"
"# time=NUM          Valfritt. time_t-värde när regeln löper ut\n"
"#\n"

