# Review: 76680f3c2ce32b931cbe9491
# Evidence: https://translationproject.org/domain/ld.html
# Evidence-SHA256: 111972aaa5309f79650bc2829a8de0d1471e575d9f6e907fddb21022603067a0
# Source-evidence: {}
# Publication: reviewed-local
#. Review-note (JSON): "Manuell språk-, terminologi- och sakgranskning av ld-flaggor och diagnostik."
msgctxt "[\"Translation Project\",\"ld\",\"\",\"6652\",\"76680f3c2ce32b931cbe9491\"]"
msgid ""
"  --stub-group-size=N         Maximum size of a group of input sections that\n"
"                                can be handled by one stub section.  A negative\n"
"                                value locates all stubs before their branches\n"
"                                (with a group size of -N), while a positive\n"
"                                value allows two groups of input sections, one\n"
"                                before, and one after each stub section.\n"
"                                Values of +/-1 indicate the linker should\n"
"                                choose suitable defaults.\n"
msgstr ""
"  --stub-group-size=N         Maximal storlek på en grupp av indataavsnitt\n"
"                                som kan hanteras av ett stubbavsnitt. Ett negativt värde\n"
"                                placerar alla stubbar före sina grenar (med en\n"
"                                gruppstorlek på -N), medan ett positivt värde tillåter två\n"
"                                grupper av indataavsnitt, en före och en efter varje stubb-\n"
"                                avsnitt. Värden på +/-1 innebär att länkaren ska välja\n"
"                                lämpliga standardvärden.\n"

