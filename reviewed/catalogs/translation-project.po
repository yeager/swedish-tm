msgid ""
"\n"
"Output control:\n"
"  -m, --max-count=NUM       stop after NUM selected lines\n"
"  -b, --byte-offset         print the byte offset with output lines\n"
"  -n, --line-number         print line number with output lines\n"
"      --line-buffered       flush output on every line\n"
"  -H, --with-filename       print file name with output lines\n"
"  -h, --no-filename         suppress the file name prefix on output\n"
"      --label=LABEL         use LABEL as the standard input file name prefix\n"
msgstr ""
"\n"
"Kontroll av utdata:\n"
"  -m, --max-count=ANTAL     avsluta efter ANTAL träffar\n"
"  -b, --byte-offset         skriv ut byteförskjutningen med utdatarader\n"
"  -n, --line-number         skriv ut radnummer med utdatarader\n"
"      --line-buffered       spola utdata för varje rad\n"
"  -H, --with-filename       skriv ut filnamn med utdatarader\n"
"  -h, --no-filename         skriv inte ut filnamnsprefixet i utdata\n"
"      --label=ETIKETT       använd ETIKETT som filnamnsprefix för standard in\n"

