msgstr "Sieve-skript installerat med lyckat resultat på servern '%1'.\nFrånvarosvar är nu aktiverat."

#. from kde:libksieve-libksieve6
msgid "Sieve script installed successfully on the server '%1'.\nOut of Office reply has been deactivated."
msgstr "Sieve-skript installerat med lyckat resultat på servern '%1'.\nFrånvarosvar är nu inaktiverat."

#. from kde:libksieve-libksieve6
msgid "Impossible to install script on server '%1'"
msgstr "Omöjligt att installera skript på servern '%1'"

