msgstr "Säg orden för att få reda på när tre försök återstår (om tillgängligt)"

#. from kde:gcompris-gcompris_qt
msgid "The classic hangman game"
msgstr "Det klassiska spelet Hänga gubben"

#. from kde:gcompris-gcompris_qt
msgid "Guess the letters of the given word."
msgstr "Gissa bokstäverna i det givna ordet."

#. from kde:gcompris-gcompris_qt
