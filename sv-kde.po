msgid "Could not change permissions for %1."
msgstr "Kunde inte ändra filskydd för %1."

#. from kde:kio-kio6
msgid "Could not change ownership for %1."
msgstr "Kunde inte ändra ägare av %1."

#. from kde:kio-kio6
msgid "Could not delete file %1."
msgstr "Kunde inte ta bort filen %1."

#. from kde:kio-kio6
msgid "The process for the %1 protocol died unexpectedly."
msgstr "Processen för protokollet %1 dog oväntat."

#. from kde:kio-kio6
msgid "Error. Out of memory.\n%1"
msgstr "Fel. Slut på minnet.\n%1"

#. from kde:kio-kio6
msgid "Unknown proxy host\n%1"
msgstr "Okänd Internetadress för proxyservern\n%1"

#. from kde:kio-kio6
msgid "Authorization failed, %1 authentication not supported"
msgstr "Behörighetskontrollen misslyckades, %1 behörighetskontroll stöds inte"

#. from kde:kio-kio6
msgid "User canceled action\n%1"
msgstr "Användaren avbröt åtgärd\n%1"

#. from kde:kio-kio6
msgid "Internal error in server\n%1"
msgstr "Internt fel i server\n%1"

#. from kde:kio-kio6
msgid "Timeout on server\n%1"
msgstr "Timeout på server\n%1"

#. from kde:kio-kio6
msgid "Unknown error\n%1"
msgstr "Okänt fel\n%1"

#. from kde:kio-kio6
msgid "Unknown interrupt\n%1"
msgstr "Okänt avbrott\n%1"

#. from kde:kio-kio6
msgid "Could not delete original file %1.\nPlease check permissions."
msgstr "Kunde inte bort originalfilen %1.\nKontrollera filskyddet."

#. from kde:kio-kio6
msgid "Could not delete partial file %1.\nPlease check permissions."
msgstr "Kunde inte ta bort den delvisa filen %1.\nKontrollera filskyddet."

#. from kde:kio-kio6
msgid "Could not rename original file %1.\nPlease check permissions."
msgstr "Kunde inte byta namn på originalfilen %1.\nKontrollera filskyddet."

#. from kde:kio-kio6
msgid "Could not rename partial file %1.\nPlease check permissions."
msgstr "Kunde inte byta namn på den delvisa filen %1.\nKontrollera filskyddet."

#. from kde:kio-kio6
msgid "Could not create symlink %1.\nPlease check permissions."
msgstr "Kunde inte skapa symbolisk länk %1.\nKontrollera filskyddet."

#. from kde:kio-kio6
msgid "Cannot create symlinks at %1.\nThe destination filesystem doesn't support symlinks."
msgstr "Kan inte skapa symboliska länkar i %1.\nMålfilsystemet stöder inte symboliska länkar."

#. from kde:kio-kio6
msgid "There is not enough space on the disk to write %1."
msgstr "Det finns inte tillräckligt utrymme på disken för att skriva %1."

#. from kde:kio-kio6
msgid "The source and destination are the same file.\n%1"
msgstr "Källan och målet är samma fil.\n%1"

#. from kde:kio-kio6
msgid "%1 is required by the server, but is not available."
msgstr "%1 krävs av servern, men är inte tillgänglig."

#. from kde:kio-kio6
msgid "Access to restricted port in POST denied."
msgstr "Tillgång till skyddad port för POST nekad."

#. from kde:kio-kio6
msgid "The required content size information was not provided for a POST operation."
msgstr "Den nödvändiga informationen om innehållets storlek tillhandahölls inte för en POST-åtgärd."

#. from kde:kio-kio6
msgid "A file or folder cannot be dropped onto itself"
msgstr "En fil eller katalog kan inte släppas på sig själv"

#. from kde:kio-kio6
msgid "A folder cannot be moved into itself"
msgstr "En katalog kan inte flyttas in i sig själv"

#. from kde:kio-kio6
msgid "Communication with the local password server failed"
msgstr "Kommunikation med den lokala lösenordsservern misslyckades"

#. from kde:kio-kio6
msgid "Unable to create KIO worker. %1"
msgstr "Kunde inte skapa I/O-arbetare. %1"

#. from kde:kio-kio6
msgid "Cannot transfer <filename>%1</filename> because it is too large. The destination filesystem only supports files up to 4GiB"
msgstr "Kan inte överföra <filename>%1</filename> eftersom den är för stor. Målfilsystemet stöder bara filer upp till 4 GiB."

#. from kde:kio-kio6
msgid "Privilege escalation is not necessary because \n'%1' is owned by the current user.\nPlease retry after changing permissions."
msgstr "Privilegieupptrappning behövs inte eftersom \n'%1' ägs av aktuell användare.\nFörsök igen efter att ha ändrat rättigheter."

#. from kde:kio-kio6
msgid "File is too large to be trashed."
msgstr "Filen är för stor för att slängas i papperskorgen."

#. from kde:kio-kio6
msgid "Unknown error code %1\n%2\nPlease send a full bug report at https://bugs.kde.org."
msgstr "Okänd felkod %1\n%2\nSkicka in en fullständig felrapport på https://bugs.kde.org."

#. from kde:kio-kio6
msgid "<qt><p><b>%1</b></p><p>%2</p></qt>"
msgstr "<qt><p><b>%1</b></p><p>%2</p></qt>"

#. from kde:kio-kio6
msgid "<b>Technical reason</b>: "
msgstr "<b>Teknisk orsak</b>: "

#. from kde:kio-kio6
msgid "<b>Details of the request</b>:"
msgstr "<b>Information om begäran</b>:"

#. from kde:kio-kio6
msgid "<li>URL: %1</li>"
msgstr "<li>Webbadress: %1</li>"

#. from kde:kio-kio6
msgid "<li>Protocol: %1</li>"
msgstr "<li>Protokoll: %1</li>"

#. from kde:kio-kio6
msgid "<li>Date and time: %1</li>"
msgstr "<li>Datum och tid: %1</li>"

#. from kde:kio-kio6
msgid "<li>Additional information: %1</li>"
msgstr "<li>Ytterligare information: %1</li>"

#. from kde:kio-kio6
msgid "<b>Possible causes</b>:"
msgstr "<b>Möjliga orsaker</b>:"

#. from kde:kio-kio6
msgid "<b>Possible solutions</b>:"
msgstr "<b>Möjliga lösningar</b>:"

#. from kde:kio-kio6
msgid "(unknown)"
msgstr "(okänt)"

#. from kde:kio-kio6
msgid "Contact your appropriate computer support system, whether the system administrator, or technical support group for further assistance."
msgstr "Kontakta en lämplig tillgänglig datorunderstödsfunktion, som t ex systemadministratören eller den tekniska stödgruppen för ytterligare hjälp."

#. from kde:kio-kio6
msgid "Contact the administrator of the server for further assistance."
msgstr "Kontakta serveradministratören för ytterligare hjälp."

#. from kde:kio-kio6
msgid "Check your access permissions on this resource."
msgstr "Kontrollera din åtkomstbehörighet för den här resursen."

#. from kde:kio-kio6
msgid "Your access permissions may be inadequate to perform the requested operation on this resource."
msgstr "Din åtkomstbehörighet för den här resursen kanske inte är tillräcklig för att utföra den begärda åtgärden för resursen."

#. from kde:kio-kio6
msgid "The file may be in use (and thus locked) by another user or application."
msgstr "Filen kan vara i användning (och därför låst) av en annan användare eller ett annat program."

#. from kde:kio-kio6
msgid "Check to make sure that no other application or user is using the file or has locked the file."
msgstr "Kontrollera att ingen annan användare eller annat program använder filen eller har låst filen."

#. from kde:kio-kio6
msgid "Although unlikely, a hardware error may have occurred."
msgstr "Även om det inte är troligt, kan ett hårdvarufel ha inträffat."

#. from kde:kio-kio6
msgid "You may have encountered a bug in the program."
msgstr "Du kan ha påträffat ett fel i programmet."

#. from kde:kio-kio6
msgid "This is most likely to be caused by a bug in the program. Please consider submitting a full bug report as detailed below."
msgstr "Det orsakas troligen av ett fel i programmet. Överväg att skicka in en fullständig felrapport enligt beskrivningen nedan."

#. from kde:kio-kio6
msgid "Update your software to the latest version. Your distribution should provide tools to update your software."
msgstr "Uppdatera din programvara till den senaste versionen. Din leverantör bör tillhandahålla verktyg för att uppdatera programvaran."

#. from kde:kio-kio6
msgid "When all else fails, please consider helping the KDE team or the third party maintainer of this software by submitting a high quality bug report. If the software is provided by a third party, please contact them directly. Otherwise, first look to see if the same bug has been submitted by someone else by searching at the <a href=\"https://bugs.kde.org/\">KDE bug reporting website</a>. If not, take note of the details given above, and include them in your bug report, along with as many other details as you think might help."
msgstr "Om ingenting annat återstår, hjälp gärna KDE-gruppen eller tredjepartsutvecklaren av den här programvaran genom att skicka in en felrapport av hög kvalitet. Om programvaran tillhandahålls av tredjepart, kontakta dem direkt. Annars, titta först om samma fel redan har rapporterats av någon annan genom att leta på <a href=\"https://bugs.kde.org/\">KDE:s webbplats för felrapportering</a>. Om inte, notera informationen som anges ovan och ta med den i felrapporten, tillsammans med så mycket övrig information som du tror kan vara till hjälp."

#. from kde:kio-kio6
msgid "There may have been a problem with your network connection."
msgstr "Det kan ha varit ett problem med din nätverksanslutning."

#. from kde:kio-kio6
msgid "There may have been a problem with your network configuration. If you have been accessing the Internet with no problems recently, this is unlikely."
msgstr "Det kan ha varit ett problem med din nätverksinställning. Om du har kommit åt Internet nyligen utan problem, är detta inte troligt."

#. from kde:kio-kio6
msgid "There may have been a problem at some point along the network path between the server and this computer."
msgstr "Det kan ha varit ett problem på nätverket längs vägen mellan servern och den här datorn."

#. from kde:kio-kio6
msgid "Try again, either now or at a later time."
msgstr "Försök igen, antingen nu eller senare."

#. from kde:kio-kio6
msgid "A protocol error or incompatibility may have occurred."
msgstr "Ett protokollfel eller inkompatibilitet kan ha inträffat."

#. from kde:kio-kio6
msgid "Ensure that the resource exists, and try again."
msgstr "Försäkra dig om att resursen finns, och försök igen."

#. from kde:kio-kio6
msgid "The specified resource may not exist."
msgstr "Den angivna resursen kanske inte finns."

#. from kde:kio-kio6
msgid "Double-check that you have entered the correct location and try again."
msgstr "Kontrollera en gång till att du har angett den korrekta platsen och försök igen."

#. from kde:kio-kio6
msgid "Check your network connection status."
msgstr "Kontrollera status för nätverksanslutningen."

#. from kde:kio-kio6
msgid "Cannot Open Resource For Reading"
msgstr "Kan inte öppna resurs för läsning"

#. from kde:kio-kio6
msgid "This means that the contents of the requested file or folder <strong>%1</strong> could not be retrieved, as read access could not be obtained."
msgstr "Det betyder att innehållet i filen eller katalogen <strong>%1</strong> som begärts inte kunde levereras, eftersom läsåtkomst inte kunde erhållas."

#. from kde:kio-kio6
msgid "You may not have permissions to read the file or open the folder."
msgstr "Du kanske inte har behörighet att läsa filen eller öppna katalogen."

#. from kde:kio-kio6
msgid "Cannot Open Resource For Writing"
msgstr "Kan inte öppna resurs för skrivning"

#. from kde:kio-kio6
msgid "This means that the file, <strong>%1</strong>, could not be written to as requested, because access with permission to write could not be obtained."
msgstr "Det betyder att innehållet i filen, <strong>%1</strong>, inte kunde skrivas som begärts, eftersom åtkomst med skrivbehörighet inte kunde erhållas."

#. from kde:kio-kio6
msgid "Cannot Launch Process required by the %1 Protocol"
msgstr "Kan inte starta process som krävs av protokollet %1"

#. from kde:kio-kio6
msgid "Unable to Launch Process"
msgstr "Kunde inte starta processen"

#. from kde:kio-kio6
msgid "The program on your computer which provides access to the <strong>%1</strong> protocol could not be found or started. This is usually due to technical reasons."
msgstr "Programmet på din dator som ger tillgång till protokollet <strong>%1</strong> kunde inte hittas eller startas. Det beror oftast på tekniska orsaker."

#. from kde:kio-kio6
msgid "The program which provides compatibility with this protocol may not have been updated with your last update of KDE. This can cause the program to be incompatible with the current version and thus not start."
msgstr "Programmet som tillhandahåller möjlighet att använda det här protokollet kanske inte har uppdaterats med den senaste uppdateringen av KDE. Det kan orsaka att programmet inte fungerar tillsammans med den aktuella versionen, och därför inte startar."

#. from kde:kio-kio6
msgid "The program on your computer which provides access to the <strong>%1</strong> protocol has reported an internal error."
msgstr "Programmet på din dator som ger tillgång till protokollet <strong>%1</strong> rapporterade ett internt fel."

#. from kde:kio-kio6
msgid "Improperly Formatted URL"
msgstr "Felaktigt formaterad webbadress"

#. from kde:kio-kio6
msgid "The <strong>U</strong>niform <strong>R</strong>esource <strong>L</strong>ocator (URL) that you entered was not properly formatted. The format of a URL is generally as follows:<blockquote><strong>protocol://user:password@www.example.org:port/folder/filename.extension?query=value</strong></blockquote>"
msgstr "Webbadressen (URL) som du angav var inte korrekt formaterad. Formatet för en webbadress är i allmänhet följande:<blockquote><strong>protokoll://användare@lösenord:www.exempel.org:port/katalog/filnamn.filändelse?fråga=värde</strong></blockquote>"

#. from kde:kio-kio6
msgid "Unsupported Protocol %1"
msgstr "Protokollet %1 stöds inte"

#. from kde:kio-kio6
msgid "The protocol <strong>%1</strong> is not supported by the KDE programs currently installed on this computer."
msgstr "Protokollet <strong>%1</strong> stöds inte av KDE-programmen som för närvarande är installerade på den här datorn."

#. from kde:kio-kio6
msgid "The requested protocol may not be supported."
msgstr "Det begärda protokollet kanske inte stöds."

#. from kde:kio-kio6
msgid "The versions of the %1 protocol supported by this computer and the server may be incompatible."
msgstr "Versionerna av protokollet %1 som stöds av den här datorn och servern kan vara inkompatibla."

#. from kde:kio-kio6
msgid "You may perform a search on the Internet for a software plugin (called a \"KIO worker\") which supports this protocol. Places to search include <a href=\"https://store.kde.org/\">https://store.kde.org</a>."
msgstr "Du kan söka på Internet efter ett insticksprogram (kallat \"I/O-arbetare\") som stödjer protokollet. Platser att leta på omfattar <a href=\"https://store.kde.org/\">https://store.kde.org</a>."

#. from kde:kio-kio6
msgid "URL Does Not Refer to a Resource."
msgstr "Webbadressen anger inte en resurs."

#. from kde:kio-kio6
msgid "Protocol is a Filter Protocol"
msgstr "Protokollet är ett filterprotokoll"

#. from kde:kio-kio6
msgid "The <strong>U</strong>niform <strong>R</strong>esource <strong>L</strong>ocator (URL) that you entered did not refer to a specific resource."
msgstr "Webbadressen (URL) som du skrev in anger inte en särskild resurs."

#. from kde:kio-kio6
msgid "KDE is able to communicate through a protocol within a protocol; the protocol specified is only for use in such situations, however this is not one of these situations. This is a rare event, and is likely to indicate a programming error."
msgstr "KDE kan kommunicera med ett protokoll inne i ett annat protokoll, och det angivna protokollet används bara i sådana situationer. Det är dock inte en av dessa situationer. Det är en sällsynt händelse, och anger troligen ett programmeringsfel."

#. from kde:kio-kio6
msgid "Unsupported Action: %1"
msgstr "Åtgärden %1 stöds inte"

#. from kde:kio-kio6
msgid "The requested action is not supported by the KDE program which is implementing the <strong>%1</strong> protocol."
msgstr "Den begärda åtgärden stöds inte av KDE-programmet som implementerar protokollet <strong>%1</strong>."

#. from kde:kio-kio6
msgid "This error is very much dependent on the KDE program. The additional information should give you more information than is available to the KDE input/output architecture."
msgstr "Det här felet beror nästan helt på KDE-programmet. Den ytterligare informationen bör ge dig mer information än som är tillgänglig för KDE:s in- och utmatningsarkitektur."

#. from kde:kio-kio6
msgid "Attempt to find another way to accomplish the same outcome."
msgstr "Försöker att hitta ett annat sätt att åstadkomma samma slutresultat."

#. from kde:kio-kio6
msgid "File Expected"
msgstr "Fil förväntades"

#. from kde:kio-kio6
msgid "The request expected a file, however the folder <strong>%1</strong> was found instead."
msgstr "Begäran förväntade en fil, men katalogen <strong>%1</strong> hittades istället."

#. from kde:kio-kio6
msgid "This may be an error on the server side."
msgstr "Det kan vara ett fel på serversidan."

#. from kde:kio-kio6
msgid "Folder Expected"
msgstr "Katalog förväntades"

#. from kde:kio-kio6
msgid "The request expected a folder, however the file <strong>%1</strong> was found instead."
msgstr "Begäran förväntade en katalog, men filen <strong>%1</strong> hittades istället."

#. from kde:kio-kio6
msgid "File or Folder Does Not Exist"
msgstr "Filen eller katalogen finns inte."

#. from kde:kio-kio6
msgid "The specified file or folder <strong>%1</strong> does not exist."
msgstr "Den specificerade filen eller katalogen <strong>%1</strong> finns inte."

#. from kde:kio-kio6
msgid "The requested file could not be created because a file with the same name already exists."
msgstr "Den begärda filen kunde inte skapas, eftersom en fil med samma namn redan finns."

#. from kde:kio-kio6
msgid "Try moving the current file out of the way first, and then try again."
msgstr "Försök att flytta undan den aktuella filen och försök sedan igen."

#. from kde:kio-kio6
msgid "Delete the current file and try again."
msgstr "Ta bort den aktuella filen och försök igen."

#. from kde:kio-kio6
msgid "Choose an alternate filename for the new file."
msgstr "Välj ett annat filnamn för den nya filen."

#. from kde:kio-kio6
msgid "The requested folder could not be created because a folder with the same name already exists."
msgstr "Den begärda katalogen kunde inte skapas, eftersom en katalog med samma namn redan finns."

#. from kde:kio-kio6
msgid "Try moving the current folder out of the way first, and then try again."
msgstr "Försök att flytta undan den aktuella katalogen och försök sedan igen."

#. from kde:kio-kio6
msgid "Delete the current folder and try again."
msgstr "Ta bort den aktuella katalogen och försök igen."

#. from kde:kio-kio6
msgid "Choose an alternate name for the new folder."
msgstr "Välj ett annat filnamn för den nya katalogen."

#. from kde:kio-kio6
msgid "Unknown Host"
msgstr "Okänd värddator"

#. from kde:kio-kio6
msgid "An unknown host error indicates that the server with the requested name, <strong>%1</strong>, could not be located on the Internet."
msgstr "Felet okänd värddator anger att servern med det begärda namnet <strong>%1</strong>, inte kunde hittas på Internet."

#. from kde:kio-kio6
msgid "The name that you typed, %1, may not exist: it may be incorrectly typed."
msgstr "Namnet som du skrev in, %1, kanske inte finns: det kan vara felaktigt inskrivet."

#. from kde:kio-kio6
msgid "Access Denied"
msgstr "Åtkomst nekades"

#. from kde:kio-kio6
msgid "Access was denied to the specified resource, <strong>%1</strong>."
msgstr "Åtkomst nekades till den angivna resursen, <strong>%1</strong>."

#. from kde:kio-kio6
msgid "You may have supplied incorrect authentication details or none at all."
msgstr "Du kanske har angivit felaktig behörighetsinformation eller ingen alls."

#. from kde:kio-kio6
msgid "Your account may not have permission to access the specified resource."
msgstr "Ditt konto kanske inte har behörighet att komma åt den angivna resursen."

#. from kde:kio-kio6
msgid "Retry the request and ensure your authentication details are entered correctly."
msgstr "Gör om förfrågningen och försäkra dig om att behörighetsinformationen som är inskriven är korrekt."

#. from kde:kio-kio6
msgid "Write Access Denied"
msgstr "Skrivåtkomst nekades"

#. from kde:kio-kio6
msgid "This means that an attempt to write to the file <strong>%1</strong> was rejected."
msgstr "Det betyder att ett försök att skriva till filen <strong>%1</strong> avslogs."

#. from kde:kio-kio6
msgid "Unable to Enter Folder"
msgstr "Kan inte gå in i katalog"

#. from kde:kio-kio6
msgid "This means that an attempt to enter (in other words, to open) the requested folder <strong>%1</strong> was rejected."
msgstr "Det betyder att ett försök att gå in i (med andra ord, öppna) den begärda katalogen <strong>%1</strong> avslogs."

#. from kde:kio-kio6
msgid "Folder Listing Unavailable"
msgstr "Kataloglistning inte tillgänglig"

#. from kde:kio-kio6
msgid "Protocol %1 is not a Filesystem"
msgstr "Protokollet %1 är inte ett filsystem"

#. from kde:kio-kio6
msgid "This means that a request was made which requires determining the contents of the folder, and the KDE program supporting this protocol is unable to do so."
msgstr "Det betyder att en begäran gjordes som kräver att innehållet i katalogen kan avgöras, och att KDE-programmet som stödjer det här protokollet inte kan göra detta."

#. from kde:kio-kio6
msgid "Cyclic Link Detected"
msgstr "Cyklisk länk upptäckt"

#. from kde:kio-kio6
msgid "UNIX environments are commonly able to link a file or folder to a separate name and/or location. KDE detected a link or series of links that results in an infinite loop - i.e. the file was (perhaps in a roundabout way) linked to itself."
msgstr "Unix-miljöer kan vanligtvis länka en fil eller katalog till ett annat namn och/eller plats. KDE upptäckte en länk eller serie med länkar som gav upphov till en oändlig snurra, dvs. filen var (kanske på ett indirekt sätt) länkad till sig själv."

#. from kde:kio-kio6
msgid "Delete one part of the loop in order that it does not cause an infinite loop, and try again."
msgstr "Ta bort någon del av snurran, så att en oändlig snurra inte existerar längre, och försök igen."

#. from kde:kio-kio6
msgid "Request Aborted By User"
msgstr "Begäran avbruten av användaren"

#. from kde:kio-kio6
msgid "The request was not completed because it was aborted."
msgstr "Begäran gjordes inte klar eftersom den avbröts."

#. from kde:kio-kio6
msgid "Retry the request."
msgstr "Försök göra om begäran."

#. from kde:kio-kio6
msgid "Cyclic Link Detected During Copy"
msgstr "Cyklisk länk upptäckt under kopiering"

#. from kde:kio-kio6
msgid "UNIX environments are commonly able to link a file or folder to a separate name and/or location. During the requested copy operation, KDE detected a link or series of links that results in an infinite loop - i.e. the file was (perhaps in a roundabout way) linked to itself."
msgstr "Unix-miljöer kan vanligtvis länka en fil eller katalog till ett annat namn och/eller plats. Under den begärda kopieringen, upptäckte KDE en länk eller serie med länkar som gav upphov till en oändlig snurra, dvs. filen var (kanske på ett indirekt sätt) länkad till sig själv."

#. from kde:kio-kio6
msgid "Could Not Create Network Connection"
msgstr "Kunde inte skapa nätverksanslutning"

#. from kde:kio-kio6
msgid "Could Not Create Socket"
msgstr "Kunde inte skapa uttag (socket)"

#. from kde:kio-kio6
msgid "This is a fairly technical error in which a required device for network communications (a socket) could not be created."
msgstr "Det är ett ganska tekniskt fel, där en enhet som krävs för nätverkskommunikation (ett uttag) inte kunde skapas."

#. from kde:kio-kio6
msgid "The network connection may be incorrectly configured, or the network interface may not be enabled."
msgstr "Nätverksanslutningen kan vara felaktigt inställd, eller så är inte nätverksenheten aktiverad."

#. from kde:kio-kio6
msgid "Connection to Server Refused"
msgstr "Anslutning till server vägrades"

#. from kde:kio-kio6
msgid "The server <strong>%1</strong> refused to allow this computer to make a connection."
msgstr "Servern <strong>%1</strong> vägrade den här datorn att göra en anslutning."

#. from kde:kio-kio6
msgid "The server, while currently connected to the Internet, may not be configured to allow requests."
msgstr "Servern, även om den för närvarande är ansluten till Internet, kanske inte är inställd att tillåta någon begäran."

#. from kde:kio-kio6
msgid "The server, while currently connected to the Internet, may not be running the requested service (%1)."
msgstr "Servern, även om den för närvarande är ansluten till Internet, kanske inte kör den begärda tjänsten (%1)."

#. from kde:kio-kio6
msgid "A network firewall (a device which restricts Internet requests), either protecting your network or the network of the server, may have intervened, preventing this request."
msgstr "En brandvägg (en enhet som begränsar åtkomst till Internet), som antingen skyddar ditt nätverk eller serverns nätverk, kan ha ingripit och förhindrat denna begäran."

#. from kde:kio-kio6
msgid "Connection to Server Closed Unexpectedly"
msgstr "Anslutning till server stängdes oväntat"

#. from kde:kio-kio6
msgid "Although a connection was established to <strong>%1</strong>, the connection was closed at an unexpected point in the communication."
msgstr "Även om en anslutning upprättades till <strong>%1</strong>, stängdes anslutningen på ett oväntat ställe under kommunikationen."

#. from kde:kio-kio6
msgid "A protocol error may have occurred, causing the server to close the connection as a response to the error."
msgstr "Ett protokollfel kan ha inträffat och orsakat att servern stängde anslutningen som ett svar på felet."

#. from kde:kio-kio6
msgid "URL Resource Invalid"
msgstr "Ogiltig webbadressresurs"

#. from kde:kio-kio6
msgid "Protocol %1 is not a Filter Protocol"
msgstr "Protokollet %1 är inte ett filterprotokoll"

#. from kde:kio-kio6
msgid "The <strong>U</strong>niform <strong>R</strong>esource <strong>L</strong>ocator (URL) that you entered did not refer to a valid mechanism of accessing the specific resource, <strong>%1%2</strong>."
msgstr "Webbadressen (URL) som du skrev in anger inte ett giltigt sätt att komma åt den särskilda resursen, <strong>%1%2</strong>."

#. from kde:kio-kio6
msgid "KDE is able to communicate through a protocol within a protocol. This request specified a protocol be used as such, however this protocol is not capable of such an action. This is a rare event, and is likely to indicate a programming error."
msgstr "KDE kan kommunicera med ett protokoll inne i ett annat protokoll. Den här begäran anger ett protokollet som ska användas på detta sätt, men  protokollet klarar inte en sådan användning. Det är en sällsynt händelse, och anger troligen ett programmeringsfel."

#. from kde:kio-kio6
msgid "Unable to Initialize Input/Output Device"
msgstr "Kan inte initiera in/ut-enhet"

#. from kde:kio-kio6
msgid "Could Not Mount Device"
msgstr "Kunde inte montera enhet"

#. from kde:kio-kio6
msgid "The requested device could not be initialized (\"mounted\"). The reported error was: <strong>%1</strong>"
msgstr "Den begärda enheten kunde inte initieras (\"monteras\"). Det rapporterade felet var: <strong>%1</strong>"

#. from kde:kio-kio6
msgid "The device may not be ready, for example there may be no media in a removable media device (i.e. no CD-ROM in a CD drive), or in the case of a peripheral/portable device, the device may not be correctly connected."
msgstr "Enheten kanske inte är klar, det finns till exempel kanske inga medier i enheter med flyttbara medier (dvs. ingen skiva i en cd-enhet), eller så är enheten kanske inte riktigt ansluten om den är en periferienhet eller en bärbar enhet."

#. from kde:kio-kio6
msgid "You may not have permissions to initialize (\"mount\") the device. On UNIX systems, often system administrator privileges are required to initialize a device."
msgstr "Du kanske inte har behörighet att initiera (\"montera\") enheten. På Unix-system krävs ofta administratörsbehörighet för att få initiera en enhet."

#. from kde:kio-kio6
msgid "Check that the device is ready; removable drives must contain media, and portable devices must be connected and powered on.; and try again."
msgstr "Kontrollera att enheten är klar. Flyttbara enheter måste innehålla medier, och bärbara enheter måste vara anslutna och påslagna. Försök därefter igen."

#. from kde:kio-kio6
msgid "Unable to Uninitialize Input/Output Device"
msgstr "Kan inte avinitiera in/ut-enhet"

#. from kde:kio-kio6
msgid "Could Not Unmount Device"
msgstr "Kunde inte avmontera enhet"

#. from kde:kio-kio6
msgid "The requested device could not be uninitialized (\"unmounted\"). The reported error was: <strong>%1</strong>"
msgstr "Den begärda enheten kunde inte avinitieras (\"avmonteras\"). Det rapporterade felet var: <strong>%1</strong>"

#. from kde:kio-kio6
msgid "The device may be busy, that is, still in use by another application or user. Even such things as having an open browser window on a location on this device may cause the device to remain in use."
msgstr "Enheten kan vara upptagen, dvs fortfarande i användning av ett annat program eller användare. Till och med något sådant som att ha ett öppet filhanteringsfönster som visar någon plats på enheten kan göra att den förblir upptagen."

#. from kde:kio-kio6
msgid "You may not have permissions to uninitialize (\"unmount\") the device. On UNIX systems, system administrator privileges are often required to uninitialize a device."
msgstr "Du kanske inte har behörighet att avinitiera (\"avmontera\") enheten. På Unix-system krävs ofta administratörsbehörighet för att få avinitiera en enhet."

#. from kde:kio-kio6
msgid "Check that no applications are accessing the device, and try again."
msgstr "Kontrollera att inga program använder enheten, och försök igen."

#. from kde:kio-kio6
msgid "Cannot Read From Resource"
msgstr "Kan inte läsa från resurs"

#. from kde:kio-kio6
msgid "This means that although the resource, <strong>%1</strong>, was able to be opened, an error occurred while reading the contents of the resource."
msgstr "Det betyder att även om resursen <strong>%1</strong> kunde öppnas, uppstod ett fel när resursens innehåll skulle läsas."

#. from kde:kio-kio6
msgid "You may not have permissions to read from the resource."
msgstr "Du kanske inte har behörighet att läsa från resursen."

#. from kde:kio-kio6
msgid "Cannot Write to Resource"
msgstr "Kan inte skriva till resurs"

#. from kde:kio-kio6
msgid "This means that although the resource, <strong>%1</strong>, was able to be opened, an error occurred while writing to the resource."
msgstr "Det betyder att även om resursen <strong>%1</strong> kunde öppnas, uppstod ett fel när skrivning till resursen skulle ske."

#. from kde:kio-kio6
msgid "You may not have permissions to write to the resource."
msgstr "Du kanske inte har behörighet att skriva till resursen."

#. from kde:kio-kio6
msgid "Could Not Listen for Network Connections"
msgstr "Kunde inte lyssna efter nätverksanslutningar"

#. from kde:kio-kio6
msgid "Could Not Bind"
msgstr "Kunde inte binda"

#. from kde:kio-kio6
msgid "This is a fairly technical error in which a required device for network communications (a socket) could not be established to listen for incoming network connections."
msgstr "Det är ett ganska tekniskt fel, där en enhet som krävs för nätverkskommunikation (ett uttag) inte kunde upprättas för att lyssna efter inkommande nätverksanslutningar."

#. from kde:kio-kio6
msgid "Could Not Listen"
msgstr "Kunde inte lyssna"

#. from kde:kio-kio6
msgid "Could Not Accept Network Connection"
msgstr "Kunde inte acceptera nätverksanslutning"

#. from kde:kio-kio6
msgid "This is a fairly technical error in which an error occurred while attempting to accept an incoming network connection."
msgstr "Det är ett ganska tekniskt fel, där ett fel uppstod vid ett försök att acceptera en inkommande nätverksanslutning."

#. from kde:kio-kio6
msgid "You may not have permissions to accept the connection."
msgstr "Du kanske inte har behörighet att acceptera anslutningen."

#. from kde:kio-kio6
msgid "Could Not Login: %1"
msgstr "Kunde inte logga in: %1"

#. from kde:kio-kio6
msgid "An attempt to login to perform the requested operation was unsuccessful."
msgstr "Ett försök att logga in eller utföra den begärda åtgärden misslyckades."

#. from kde:kio-kio6
msgid "Could Not Determine Resource Status"
msgstr "Kunde inte avgöra resursstatus"

#. from kde:kio-kio6
msgid "Could Not Stat Resource"
msgstr "Kunde inte hämta resursens status"

#. from kde:kio-kio6
msgid "An attempt to determine information about the status of the resource <strong>%1</strong>, such as the resource name, type, size, etc., was unsuccessful."
msgstr "Ett försök att avgöra information om status för resursen, <strong>%1</strong>, som dess namn, typ, storlek etc. misslyckades."

#. from kde:kio-kio6
msgid "The specified resource may not have existed or may not be accessible."
msgstr "Den angivna resursen kanske inte fanns eller kunde inte kommas åt."

#. from kde:kio-kio6
msgid "Could Not Cancel Listing"
msgstr "Kunde inte avbryta listning"

#. from kde:kio-kio6
msgid "FIXME: Document this"
msgstr "ATT GÖRA: Dokumentera det här"

#. from kde:kio-kio6
msgid "Could Not Create Folder"
msgstr "Kunde inte skapa katalog"

#. from kde:kio-kio6
msgid "An attempt to create the requested folder failed."
msgstr "Ett försök att skapa den begärda katalogen misslyckades."

#. from kde:kio-kio6
msgid "The location where the folder was to be created may not exist."
msgstr "Platsen där katalogen skulle skapas kanske inte finns."

#. from kde:kio-kio6
msgid "Could Not Remove Folder"
msgstr "Kunde inte ta bort katalog"

#. from kde:kio-kio6
msgid "An attempt to remove the specified folder, <strong>%1</strong>, failed."
msgstr "Ett försök att ta bort den angivna katalogen <strong>%1</strong>, misslyckades."

#. from kde:kio-kio6
msgid "The specified folder may not exist."
msgstr "Den angivna katalogen kanske inte finns."

#. from kde:kio-kio6
msgid "The specified folder may not be empty."
msgstr "Den angivna katalogen kanske inte är tom."

#. from kde:kio-kio6
msgid "Ensure that the folder exists and is empty, and try again."
msgstr "Försäkra dig om att katalogen finns och är tom, och försök igen."

#. from kde:kio-kio6
msgid "Could Not Resume File Transfer"
msgstr "Kunde inte återuppta filöverföring"

#. from kde:kio-kio6
msgid "The specified request asked that the transfer of file <strong>%1</strong> be resumed at a certain point of the transfer. This was not possible."
msgstr "Den angivna begäran angav att överföringen av filen <strong>%1</strong> skulle återupptas vid en viss punkt i överföringen. Detta var inte möjligt."

#. from kde:kio-kio6
msgid "The protocol, or the server, may not support file resuming."
msgstr "Protokollet, eller servern, kanske inte stödjer att filöverföring återupptas."

#. from kde:kio-kio6
msgid "Retry the request without attempting to resume transfer."
msgstr "Försök begära igen utan att ange att överföringen ska återupptas."

#. from kde:kio-kio6
msgid "Could Not Rename Resource"
msgstr "Kunde inte byta namn på resurs"

#. from kde:kio-kio6
msgid "An attempt to rename the specified resource <strong>%1</strong> failed."
msgstr "Ett försök att byta namn på den angivna resursen <strong>%1</strong> misslyckades."

#. from kde:kio-kio6
msgid "Could Not Alter Permissions of Resource"
msgstr "Kunde inte ändra skydd för resurs"

#. from kde:kio-kio6
msgid "An attempt to alter the permissions on the specified resource <strong>%1</strong> failed."
msgstr "Ett försök att ändra skydd för den angivna resursen <strong>%1</strong> misslyckades."

#. from kde:kio-kio6
msgid "Could Not Change Ownership of Resource"
msgstr "Kunde inte ändra ägare av resurs"

#. from kde:kio-kio6
msgid "An attempt to change the ownership of the specified resource <strong>%1</strong> failed."
msgstr "Ett försök att ändra ägare av den angivna resursen <strong>%1</strong> misslyckades."

#. from kde:kio-kio6
msgid "Could Not Delete Resource"
msgstr "Kunde inte ta bort resurs"

#. from kde:kio-kio6
msgid "An attempt to delete the specified resource <strong>%1</strong> failed."
msgstr "Ett försök att ta bort den angivna resursen <strong>%1</strong> misslyckades."

#. from kde:kio-kio6
msgid "Unexpected Program Termination"
msgstr "Oväntad avslutning av program"

#. from kde:kio-kio6
msgid "The program on your computer which provides access to the <strong>%1</strong> protocol has unexpectedly terminated."
msgstr "Programmet på din dator som ger tillgång till protokollet <strong>%1</strong> avslutades oväntat."

#. from kde:kio-kio6
msgid "Out of Memory"
msgstr "Slut på minnet"

#. from kde:kio-kio6
msgid "The program on your computer which provides access to the <strong>%1</strong> protocol could not obtain the memory required to continue."
msgstr "Programmet på din dator som ger tillgång till protokollet <strong>%1</strong> kunde inte erhålla minne som krävs för att fortsätta."

#. from kde:kio-kio6
msgid "Unknown Proxy Host"
msgstr "Okänd proxyvärddator"

#. from kde:kio-kio6
msgid "While retrieving information about the specified proxy host, <strong>%1</strong>, an Unknown Host error was encountered. An unknown host error indicates that the requested name could not be located on the Internet."
msgstr "När information hämtades om den angivna proxyvärddatorn <strong>%1</strong>, inträffade felet okänd proxyvärddator. Okänd proxyvärddator anger att det angivna namnet inte kunde hittas på Internet."

#. from kde:kio-kio6
msgid "There may have been a problem with your network configuration, specifically your proxy's hostname. If you have been accessing the Internet with no problems recently, this is unlikely."
msgstr "Det kan ha varit ett problem med din nätverksinställning, närmare bestämt proxyvärddatorns namn. Om du har kommit åt Internet nyligen utan problem, är detta inte troligt."

#. from kde:kio-kio6
msgid "Double-check your proxy settings and try again."
msgstr "Kontrollera proxyinställningarna en gång till och försök igen."

#. from kde:kio-kio6
msgid "Authentication Failed: Method %1 Not Supported"
msgstr "Behörighetskontrollen misslyckades: metoden %1 stöds inte"

#. from kde:kio-kio6
msgid "Although you may have supplied the correct authentication details, the authentication failed because the method that the server is using is not supported by the KDE program implementing the protocol %1."
msgstr "Även om du kan ha angivit korrekt behörighetsinformation kan behörighetskontrollen misslyckas, eftersom metoden som servern använder inte stöds av KDE-programmet som implementerar protokollet %1."

#. from kde:kio-kio6
msgid "Please file a bug at <a href=\"https://bugs.kde.org/\">https://bugs.kde.org/</a> to inform the KDE team of the unsupported authentication method."
msgstr "Skicka gärna en felrapport till <a href=\"https://bugs.kde.org/\">https://bugs.kde.org/</a>, för att informera KDE-gruppen om metoden för behörighetskontroll som inte stöds."

#. from kde:kio-kio6
msgid "Request Aborted"
msgstr "Begäran avbröts"

#. from kde:kio-kio6
msgid "Internal Error in Server"
msgstr "Internt fel i server"

#. from kde:kio-kio6
msgid "The program on the server which provides access to the <strong>%1</strong> protocol has reported an internal error: %2."
msgstr "Programmet på servern som ger tillgång till protokollet <strong>%1</strong> rapporterade ett internt fel: %2."

#. from kde:kio-kio6
msgid "This is most likely to be caused by a bug in the server program. Please consider submitting a full bug report as detailed below."
msgstr "Det orsakas troligen av ett fel i serverprogrammet. Överväg att skicka in en fullständig felrapport enligt beskrivningen nedan."

#. from kde:kio-kio6
msgid "Contact the administrator of the server to advise them of the problem."
msgstr "Kontakta administratören av servern för att göra dem uppmärksamma på problemet."

#. from kde:kio-kio6
msgid "If you know who the authors of the server software are, submit the bug report directly to them."
msgstr "Om du känner till upphovsmännen för serverns programvara, skicka då felrapporten direkt till dem."

#. from kde:kio-kio6
msgid "Timeout Error"
msgstr "Överskriden tidsgräns"

#. from kde:kio-kio6
msgid "Although contact was made with the server, a response was not received within the amount of time allocated for the request."
msgstr "Även om servern kunde kontaktas, togs inte ett svar emot inom det tidsintervall tilldelat till begäran."

#. from kde:kio-kio6
msgid "The server was too busy responding to other requests to respond."
msgstr "Servern var för upptagen för att svara på andra begäran för att svara."

#. from kde:kio-kio6
msgid "Unknown Error"
msgstr "Okänt fel"

#. from kde:kio-kio6
msgid "The program on your computer which provides access to the <strong>%1</strong> protocol has reported an unknown error: %2."
msgstr "Programmet på din dator som ger tillgång till protokollet <strong>%1</strong> rapporterade ett okänt fel: %2."

#. from kde:kio-kio6
msgid "Unknown Interruption"
msgstr "Okänt avbrott"

#. from kde:kio-kio6
msgid "The program on your computer which provides access to the <strong>%1</strong> protocol has reported an interruption of an unknown type: %2."
msgstr "Programmet på din dator som ger tillgång till protokollet <strong>%1</strong> rapporterade ett avbrott av okänd typ: %2."

#. from kde:kio-kio6
msgid "Could Not Delete Original File"
msgstr "Kunde inte ta bort ursprunglig fil"

#. from kde:kio-kio6
msgid "The requested operation required the deleting of the original file, most likely at the end of a file move operation. The original file <strong>%1</strong> could not be deleted."
msgstr "Den begärda åtgärden krävde att den ursprungliga filen skulle tas bort, troligen vid slutet av en filflyttningsåtgärd. Den ursprungliga filen <strong>%1</strong>, kunde inte tas bort."

#. from kde:kio-kio6
msgid "Could Not Delete Temporary File"
msgstr "Kunde inte ta bort tillfällig fil"

#. from kde:kio-kio6
msgid "The requested operation required the creation of a temporary file in which to save the new file while being downloaded. This temporary file <strong>%1</strong> could not be deleted."
msgstr "Den begärda åtgärden krävde att en tillfällig fil skapades där den nya filen sparades medan den laddades ner. Den här tillfälliga filen <strong>%1</strong>, kunde inte tas bort."

#. from kde:kio-kio6
msgid "Could Not Rename Original File"
msgstr "Kunde inte byta namn på ursprunglig fil"

#. from kde:kio-kio6
msgid "The requested operation required the renaming of the original file <strong>%1</strong>, however it could not be renamed."
msgstr "Den begärda åtgärden krävde att den ursprungliga filen, <strong>%1</strong>, skulle döpas om, men detta kunde inte utföras."

#. from kde:kio-kio6
msgid "Could Not Rename Temporary File"
msgstr "Kunde inte byta namn på tillfällig fil"

#. from kde:kio-kio6
msgid "The requested operation required the creation of a temporary file <strong>%1</strong>, however it could not be created."
msgstr "Den begärda åtgärden krävde att en tillfällig fil, <strong>%1</strong>, skapades, men den kunde inte skapas."

#. from kde:kio-kio6
msgid "Could Not Create Link"
msgstr "Kunde inte skapa länk"

#. from kde:kio-kio6
msgid "Could Not Create Symbolic Link"
msgstr "Kunde inte skapa symbolisk länk"

#. from kde:kio-kio6
msgid "The requested symbolic link %1 could not be created."
msgstr "Den begärda symboliska länken %1 kunde inte skapas."

#. from kde:kio-kio6
msgid "No Content"
msgstr "Inget innehåll"

#. from kde:kio-kio6
msgid "Disk Full"
msgstr "Disken är full"

#. from kde:kio-kio6
msgid "The requested file <strong>%1</strong> could not be written to as there is inadequate disk space."
msgstr "Den begärda filen <strong>%1</strong> kunde inte skrivas på grund av otillräckligt diskutrymme."

#. from kde:kio-kio6
msgid "Free up enough disk space by 1) deleting unwanted and temporary files; 2) archiving files to removable media storage such as CD-Recordable discs; or 3) obtain more storage capacity."
msgstr "Frigör tillräckligt med diskutrymme genom att 1) ta bort onödiga och tillfälliga filer, 2) arkivera filer på flyttbara medier som inspelningsbara cd-skivor, eller 3) skaffa ytterligare lagringskapacitet."

#. from kde:kio-kio6
msgid "Source and Destination Files Identical"
msgstr "Den ursprungliga och nya filen är identiska"

#. from kde:kio-kio6
msgid "The operation could not be completed because the source and destination files are the same file."
msgstr "Åtgärden kunde inte utföras eftersom den ursprungliga och den nya filen är samma fil."

#. from kde:kio-kio6
msgid "Choose a different filename for the destination file."
msgstr "Välj ett annat filnamn för den nya filen."

#. from kde:kio-kio6
msgid "File or Folder dropped onto itself"
msgstr "Fil eller katalog släppt på sig själv"

#. from kde:kio-kio6
msgid "The operation could not be completed because the source and destination file or folder are the same."
msgstr "Åtgärden kunde inte utföras eftersom den ursprungliga och den nya filen eller katalogen är samma."

#. from kde:kio-kio6
msgid "Drop the item into a different file or folder."
msgstr "Släpp objektet på en annan fil eller katalog."

#. from kde:kio-kio6
msgid "Folder moved into itself"
msgstr "Katalog flyttat in i sig själv"

#. from kde:kio-kio6
msgid "The operation could not be completed because the source can not be moved into itself."
msgstr "Åtgärden kunde inte utföras eftersom källan inte kan flyttas in i sig själv."

#. from kde:kio-kio6
msgid "Move the item into a different folder."
msgstr "Flytta objektet in i en annan katalog."

#. from kde:kio-kio6
msgid "Could not communicate with password server"
msgstr "Kunde inte kommunicera med lösenordsserver"

#. from kde:kio-kio6
msgid "The operation could not be completed because the service for requesting passwords (kpasswdserver) couldn't be contacted"
msgstr "Åtgärden kunde inte slutföras eftersom tjänsten för att begära lösenord (kasspwdserver) inte kunde kontaktas"

#. from kde:kio-kio6
msgid "Try restarting your session, or look in the logs for errors from kiod."
msgstr "Försök att starta om sessionen, eller titta i loggarna efter fel från kiod."

#. from kde:kio-kio6
msgid "Cannot Initiate the %1 Protocol"
msgstr "Kan inte starta protokollet %1"

#. from kde:kio-kio6
msgid "Unable to Create KIO Worker"
msgstr "Kunde inte skapa I/O-arbetare"

#. from kde:kio-kio6
msgid "The KIO worker which provides access to the <strong>%1</strong> protocol could not be started. This is usually due to technical reasons."
msgstr "I/O-arbetaren som ger tillgång till protokollet <strong>%1</strong> kunde inte startas. Det beror oftast på tekniska orsaker."

#. from kde:kio-kio6
msgid "klauncher could not find or start the plugin which provides the protocol. This means you may have an outdated version of the plugin."
msgstr "Startprogrammet kunde inte hitta eller starta insticksprogrammet som tillhandahåller protokollet. Det betyder att du kan ha en föråldrad version av insticksprogrammet."

#. from kde:kio-kio6
msgid "Cannot transfer <filename>%1</filename>"
msgstr "Kan inte överföra <filename>%1</filename>"

#. from kde:kio-kio6
msgid "The file <filename>%1</filename> cannot be transferred, because the destination filesystem does not support files that large"
msgstr "Filen <filename>%1</filename> kan inte överföras eftersom målfilsystemet inte stöder filer som är så stora"

#. from kde:kio-kio6
msgid "Reformat the destination drive to use a filesystem that supports files that large."
msgstr "Formatera om målenheten så att den använder ett filsystem som stöder filer sm är så stora."

#. from kde:kio-kio6
msgid "Undocumented Error"
msgstr "Odokumenterat fel"

#. from kde:kio-kio6
msgid "(Symbolic Link to %1)"
msgstr "(Symbolisk länk till %1)"

#. from kde:kio-kio6
msgid "(%1, Link to %2)"
msgstr "(%1, Länk till %2)"

#. from kde:kio-kio6
msgid " (Points to %1)"
msgstr " (Pekar på %1)"

#. from kde:kio-kio6
msgid "Malformed URL\n%1"
msgstr "Felaktig webbadress\n%1"

#. from kde:kio-kio6
msgid "Unable to determine the type of file for %1"
msgstr "Kan inte avgöra filtyp för %1"

#. from kde:kio-kio6
msgid "Could not extract executable name from '%1', please type a valid program name."
msgstr "Kunde inte extrahera körbart namn från '%1'. Skriv in ett giltigt programnamn."

#. from kde:kio-kio6
msgid "<filename>%1</filename> does not appear to be an executable program."
msgstr "<filename>%1</filename> verkar inte vara ett körbart program."

#. from kde:kio-kio6
msgid "<filename>%1</filename> was not found; please enter a valid path to an executable program."
msgstr "<filename>%1</filename> hittas inte. Ange en giltig sökväg till ett körbart program."

#. from kde:kio-kio6
msgid "Opening connections is not supported with the protocol %1."
msgstr "Att öppna anslutningar stöds inte med protokollet %1."

#. from kde:kio-kio6
msgid "Closing connections is not supported with the protocol %1."
msgstr "Att stänga anslutningar stöds inte med protokollet %1."

#. from kde:kio-kio6
msgid "Accessing files is not supported with the protocol %1."
msgstr "Att komma åt filer stöds inte med protokollet %1."

#. from kde:kio-kio6
msgid "Writing to %1 is not supported."
msgstr "Skrivning till %1 stöds inte."

#. from kde:kio-kio6
