msgstr "Välj så många delar du kan utan att använda mer än halva pajen."

#. from kde:gcompris-gcompris_qt
msgid "Find the fractions"
msgstr "Bestäm bråken"

#. from kde:gcompris-gcompris_qt
msgid "Find the correct numerator and denominator of the represented fraction."
msgstr "Bestäm den riktiga täljaren och nämnaren för det angivna bråket."

#. from kde:gcompris-gcompris_qt
msgid "Learn to write a fraction corresponding to a given fractional representation."
msgstr "Lär dig att skriva ett bråk som motsvarar en given bråkrepresentation."

#. from kde:gcompris-gcompris_qt
msgid "Write the fraction corresponding to the fractional representation: Count the total number of parts of the represented shape, and set it as the denominator. Then count the number of selected parts, and set it as the numerator."
msgstr "Skriv bråket som motsvarar bråkrepresentationen: Räkna det totala antalet delar i den representerade formen och använd det som nämnare. Räkna sedan antalet valda delar och använd det som täljare."

#. from kde:gcompris-gcompris_qt
msgid "Find numerator (with a pie)."
msgstr "Bestäm täljaren (med en paj)."

#. from kde:gcompris-gcompris_qt
msgid "Find numerator (with a square)."
msgstr "Bestäm täljaren (med en kvadrat)."

#. from kde:gcompris-gcompris_qt
msgid "Find denominator (with a pie)."
msgstr "Bestäm nämnaren (med en paj)."

#. from kde:gcompris-gcompris_qt
msgid "Find denominator (with a square)."
msgstr "Bestäm nämnaren (med en kvadrat)."

#. from kde:gcompris-gcompris_qt
msgid "Find numerator and denominator (with a pie)."
msgstr "Bestäm täljaren och nämnaren (med en paj)."

#. from kde:gcompris-gcompris_qt
msgid "Find numerator and denominator (with a square)."
msgstr "Bestäm täljaren och nämnaren (med en kvadrat)."

#. from kde:gcompris-gcompris_qt
msgid "Frieze"
