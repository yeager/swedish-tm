msgstr "Dölj hjul och drev"

#. from kde:gcompris-gcompris_qt
msgid "Gear"
msgstr "Drev"

#. from kde:gcompris-gcompris_qt
msgid "%1 spikes"
msgstr "%1 kuggar"

#. from kde:gcompris-gcompris_qt
msgid "Slow"
msgstr "Långsam"

#. from kde:gcompris-gcompris_qt
msgid "Fast"
msgstr "Snabb"

