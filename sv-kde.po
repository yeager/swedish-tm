msgid "KMail"
msgstr "Kmail"

#. from kde:kalarm-kalarm
msgid "Choose how to send email when an email alarm is triggered."
msgstr "Välj hur e-post ska skickas när ett e-postalarm utlöses."

#. from kde:kalarm-kalarm
msgid "<para>%1<list><item><interface>%2</interface>: The email is sent automatically via <application>KMail</application>.</item><item><interface>%3</interface>: The email is sent automatically. This option will only work if your system is configured to use <application>sendmail</application> or a sendmail compatible mail transport agent.</item></list></para>"
msgstr "<para>%1<list><item><interface>%2</interface>: E-post skickas automatiskt via <application>Kmail</application>.</item><item><interface>%3</interface>: E-post skickas automatiskt. Alternativet fungerar bara om systemet är inställt för att använda <application>sendmail</application> eller ett program för att skicka e-post som fungerar som sendmail.</item></list></para>"

#. from kde:kalarm-kalarm
msgid "<para>%1<list><item><interface>%2</interface>: The email is sent automatically. This option will only work if your system is configured to use <application>sendmail</application> or a sendmail compatible mail transport agent.</item></list></para>"
msgstr "<para>%1<list><item><interface>%2</interface>: E-post skickas automatiskt. Alternativet fungerar bara om systemet är inställt för att använda <application>sendmail</application> eller ett program för att skicka e-post som fungerar som sendmail.</item></list></para>"

#. from kde:kalarm-kalarm
msgid "Copy sent emails into <application>KMail</application>'s <resource>%1</resource> folder"
msgstr "Kopiera skickad e-post till <application>Kmails</application> korg <resource>%1</resource>"

#. from kde:kalarm-kalarm
msgid "After sending an email, store a copy in <application>KMail</application>'s <resource>%1</resource> folder"
msgstr "Efter att ha skickade e-post, lagra en kopia i <application>Kmails</application> korg <resource>%1</resource>"

