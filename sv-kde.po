msgstr "Kopiera till"

#. from kde:libksieve-libksieve6
msgid "I am out of office till %1.\n\nIn urgent cases, please contact Mrs. \"vacation replacement\"\n\nemail: \"email address of vacation replacement\"\nphone: +49 711 1111 11\nfax.:  +49 711 1111 12\n\nYours sincerely,\n-- \"enter your name and email address here\"\n"
msgstr "Jag är borta till %1.\n\nVid brådskande ärenden, kontakta \"semestervikarie\"\n\ne-post: \"e-postadress till semestervikarie\"\ntelefon: +46 8 111 11 11\ntelefax: +46 8 111 11 12\n\nVänliga hälsningar,\n-- \"ange ditt namn och din e-postadress här\"\n"

