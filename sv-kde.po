msgstr "             # Om tillämpligt, matar ut enheten som motsvarar 'udi'.\n"

#. from kde:solid-solid6_qt
msgid "             # Listen to all add/remove events on supported hardware.\n"
msgstr "             # Lyssna på alla tilläggs- och borttagningshändelser på hårdvara som stöder det.\n"

#. from kde:solid-solid6_qt
msgid "             # Monitor devices for changes.\n"
msgstr "             # Övervaka enheter för ändringar.\n"

#. from kde:solid-solid6_qt
