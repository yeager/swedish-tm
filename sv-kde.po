#. from kde:gcompris-gcompris_qt
msgid "You found the number!"
msgstr "Du hittade talet!"

#. from kde:gcompris-gcompris_qt
msgid "Guess a number between 1 and %1."
msgstr "Gissa ett tal mellan 1 och %1."

