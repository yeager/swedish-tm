msgstr "Markera dagar under veckan som är arbetsdagar"

#. from kde:kalarm-kalarm
msgid "Daily start time:"
msgstr "Daglig starttid:"

#. from kde:kalarm-kalarm
msgid "<para>Enter the start time of the working day.</para><para>%1</para>"
msgstr "<para>Ange tiden då arbetsdagen börjar.</para><para>%1</para>"

#. from kde:kalarm-kalarm
msgid "Daily end time:"
msgstr "Daglig sluttid:"

#. from kde:kalarm-kalarm
msgid "<para>Enter the end time of the working day.</para><para>%1</para>"
msgstr "<para>Ange tiden då arbetsdagen slutar.</para><para>%1</para>"

