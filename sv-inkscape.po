msgstr "Stationär skärplotter (AutoCAD DXF R 12) (\\*.dxf)"

#. from yeager:inkscape
msgid "plotter file format"
msgstr "plotterfilformat"

#. from yeager:inkscape
msgid "Desktop Cutting Plotter (AutoCAD DXF R 14) (\\*.dxf)"
msgstr "Stationär skärplotter (AutoCAD DXF R 14) (\\*.dxf)"

#. from yeager:inkscape
msgid "Enhanced Metafile (\\*.emf)"
msgstr "Enhanced Metafile (\\*.emf)"

#. from yeager:inkscape
msgid "improved version of .wmf with support for Bézier curves"
msgstr "förbättrad version av .wmf med stöd för Bézier-kurvor"

#. from yeager:inkscape
msgid "Encapsulated PostScript (\\*.eps)"
msgstr "Encapsulated PostScript (\\*.eps)"

#. from yeager:inkscape
msgid "embeddable printer graphics file"
msgstr "inbäddningsbar grafikfil för skrivare"

