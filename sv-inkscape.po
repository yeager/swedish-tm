msgstr "spraya fler objekt på samma plats"

#. from yeager:inkscape
msgid "copy mode"
msgstr "kopieringsläge"

#. from yeager:inkscape
msgid "clone mode"
msgstr "kloningsläge"

#. from yeager:inkscape
