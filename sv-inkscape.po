msgstr "Skala bort proprietära namnrymder"

#. from yeager:inkscape
msgid "Remove any known proprietary SVG data"
msgstr "Ta bort alla kända proprietära SVG-data"

#. from yeager:inkscape
msgid "Reverse Auto Start Markers"
msgstr "Omvända autostartmarkörer"

#. from yeager:inkscape
msgid "Remove auto start positions from markers"
msgstr "Ta bort automatiska startpositioner från markörer"

#. from yeager:inkscape
msgid "Try to Remove All Transforms"
msgstr "Försök att ta bort alla transformationer"

#. from yeager:inkscape
msgid "Attempt to remove all transforms from all shapes"
msgstr "Försök att ta bort alla transformationer från alla former"

#. from yeager:inkscape
msgid "Remove Marker Context Paint"
msgstr "Ta bort markörens kontextfärg"

#. from yeager:inkscape
msgid "Remove context paints from markers"
msgstr "Ta bort kontextfärger från markörer"

#. from yeager:inkscape
msgid "Insert Text Fallback"
msgstr "Infoga textreserver"

#. from yeager:inkscape
msgid "Replace SVG2 text with SVG1.1 text"
msgstr "Ersätt SVG2-text med SVG1.1-text"

#. from yeager:inkscape
msgid "Insert Mesh Polyfill"
msgstr "Infoga nätpolyfill"

#. from yeager:inkscape
msgid "Insert JavaScript for rendering meshes"
msgstr "Infoga JavaScript för rendering av nät"

#. from yeager:inkscape
msgid "Insert Hatch Polyfill"
msgstr "Infoga skraffel-polyfill"

#. from yeager:inkscape
msgid "Insert JavaScript for rendering hatches"
msgstr "Infoga JavaScript för rendering av skraffel"

#. from yeager:inkscape
msgid "Unlink All Clones"
msgstr "Avlänka alla kloner"

#. from yeager:inkscape
msgid "Recursively unlink all clones and symbols"
msgstr "Avlänka kloner och symboler rekursivt"

#. from yeager:inkscape
msgid "All Objects to Paths"
msgstr "Alla objekt till slingor"

#. from yeager:inkscape
msgid "Turn all shapes recursively into path elements"
msgstr "Gör om alla former rekursivt till slingelement"

#. from yeager:inkscape
msgid "All Strokes to Paths"
msgstr "Alla streck till slingor"

#. from yeager:inkscape
msgid "Turn all strokes recursively into fill-only paths"
msgstr "Gör om alla streck rekursivt till slingor som bara kan fyllas i"

#. from yeager:inkscape
msgid "Normalize Path Data"
msgstr "Normalisera slingdata"

#. from yeager:inkscape
msgid "Make all paths absolute and predictable"
msgstr "Gör alla slingor absoluta och förutsägbara"

#. from yeager:inkscape
msgid "Annotate all Bounding Boxes"
msgstr "Kommentera alla avgränsningsrutor"

#. from yeager:inkscape
msgid "Write bounding box data of every shape and group into its attributes for inkscape:visualbox or inkscape:geometricbox. The value will not update automatically."
msgstr "Skriv data för avgränsningsruta för varje form och grupp i dess attribut för inkscape:visualbox eller inkscape:geometricbox. Värdet kommer inte att uppdateras automatiskt."

#. from yeager:inkscape
msgid "Annotate all Shape Paths"
msgstr "Kommentera alla formslingor"

#. from yeager:inkscape
msgid "Write path data for every non-path shape into its inkscape:d attribute. The value will not update automatically."
msgstr "Skriva slingdata för varje icke-slingform till dess inkscape:d-attribute. Värdet kommer inte att uppdateras automatiskt."

#. from yeager:inkscape
msgid "Clean up Document"
msgstr "Städa upp dokument"

#. from yeager:inkscape
msgid "Remove unused definitions (gradients, etc.)"
msgstr "Ta bort oanvända definitioner (gradienter, etc.)"

#. from yeager:inkscape
msgid "Put on Path"
msgstr "Placera på slinga"

#. from yeager:inkscape
msgid "Put text on path"
msgstr "Placera text på slinga"

#. from yeager:inkscape
msgid "Remove from Path"
msgstr "Ta bort från slinga"

#. from yeager:inkscape
msgid "Remove text from path"
msgstr "Ta bort text från slinga"

#. from yeager:inkscape
msgid "Flow into Frame"
msgstr "Flöda in i ram"

#. from yeager:inkscape
msgid "Put text into a frame (path or shape), creating a flowed text linked to the frame object"
msgstr "Placera text i en ram (slinga eller form) för att skapa textflöde länkat till ramobjektet"

#. from yeager:inkscape
msgid "Set Subtraction Frames"
msgstr "Ställ in subtraheringsformer"

#. from yeager:inkscape
msgid "Flow text around a frame (path or shape), only available for SVG 2.0 Flow text."
msgstr "Flöda text runt en ram (slinga eller form), endast tillgänglig för SVG 2.0 Flödestext."

#. from yeager:inkscape
msgid "Unflow"
msgstr "Avflöda"

#. from yeager:inkscape
msgid "Remove text from frame (creates a single-line text object)"
msgstr "Ta bort text från ram (skapar ett enradigt textobjekt)"

#. from yeager:inkscape
msgid "Convert to Text"
msgstr "Konvertera till text"

#. from yeager:inkscape
msgid "Convert flowed text to regular text object (preserves appearance)"
msgstr "Konvertera textflöde to vanligt textobjekt (bevarar utseende)"

#. from yeager:inkscape
msgid "Convert to Glyphs"
msgstr "Konvertera till glyfer"

#. from yeager:inkscape
msgid "Convert text into individual glyphs"
msgstr "Konvertera text till enskilda glyfer"

#. from yeager:inkscape
msgid "Remove Manual Kerns"
msgstr "Ta bort manuell kerning"

#. from yeager:inkscape
msgid "Remove all manual kerns and glyph rotations from a text object"
msgstr "Ta bort all manuell kerning och roterade glyfer från ett textobjekt"

#. from yeager:inkscape
msgid "<b>Click</b> to Select and Transform objects, <b>Drag</b> to select many objects."
msgstr "<b>Klicka</b> för att markera och transformera objekt, <b>dra</b> för att markera flera objekt."

#. from yeager:inkscape
msgid "Modify selected path points (nodes) directly."
msgstr "Ändra valda slingpunkter (noder) direkt."

#. from yeager:inkscape
msgid "Construct shapes with the interactive Boolean tool."
msgstr "Konstruera former med det interaktiva booleska verktyget."

#. from yeager:inkscape
msgid "<b>Drag</b> to create a rectangle. <b>Drag controls</b> to round corners and resize. <b>Click</b> to select."
msgstr "<b>Dra</b> för att skapa en rektangel. <b>Dra kontroller</b> för att runda hörnen och ändra storlek. <b>Klicka</b> för att välja."

#. from yeager:inkscape
msgid "<b>Drag</b> to create an ellipse. <b>Drag controls</b> to make an arc or segment. <b>Click</b> to select."
msgstr "<b>Dra</b> för att skapa en ellips. <b>Dra kontroller</b> för att göra en båge eller segment. <b>Klicka</b> för att välja."

#. from yeager:inkscape
msgid "<b>Drag</b> to create a star. <b>Drag controls</b> to edit the star shape. <b>Click</b> to select."
msgstr "<b>Dra</b> för att skapa en stjärna. <b>Dra kontroller</b> för att redigera stjärnformen. <b>Klicka</b> för att välja."

#. from yeager:inkscape
msgid "<b>Drag</b> to create a 3D box. <b>Drag controls</b> to resize in perspective. <b>Click</b> to select (with <b>Ctrl+Alt</b> for single faces)."
msgstr "<b>Dra</b> för att skapa en 3D-ruta. <b>Dra kontroller</b> för att ändra storlek i perspektiv. <b>Klicka</b> för att välja (med <b>Ctrl+Alt</b> för enskilda sidor)."

#. from yeager:inkscape
msgid "<b>Drag</b> to create a spiral. <b>Drag controls</b> to edit the spiral shape. <b>Click</b> to select."
msgstr "<b>Dra</b> för att skapa en spiral. <b>Dra kontroller</b> för att redigera spiralformen. <b>Klicka</b> för att välja."

#. from yeager:inkscape
msgid "<b>Click</b> a shape to start editing its markers. <b>Drag controls</b> to change orientation, scale, and position."
msgstr "<b>Klicka</b> på en form för att börja redigera dess markörer. <b>Dra kontroller</b> för att ändra orientering, skala och position."

#. from yeager:inkscape
msgid "<b>Drag</b> to create a freehand line. <b>Shift</b> appends to selected path, <b>Alt</b> activates sketch mode."
msgstr "<b>Dra</b> för att skapa en frihandslinje. <b>Skift</b> lägger till i den valda slingan, <b>Alt</b> aktiverar skissläge."

#. from yeager:inkscape
msgid "<b>Click</b> or <b>click and drag</b> to start a path; with <b>Shift</b> to append to selected path. <b>Ctrl+click</b> to create single dots (straight line modes only)."
msgstr "<b>Klicka</b> eller <b>klicka och dra</b> för att starta en slinga; med <b>Skift</b> för att lägga till i vald slinga. <b>Ctrl+klick</b> för att skapa enstaka punkter (endast i lägen för raka linjer)."

#. from yeager:inkscape
msgid "<b>Drag</b> to draw a calligraphic stroke; with <b>Ctrl</b> to track a guide path. <b>Arrow keys</b> adjust width (left/right) and angle (up/down)."
msgstr "<b>Dra</b> för att rita ett kalligrafiskt streck; med <b>Ctrl</b> för att kalkera en hjälpslinga. <b>Piltangenter</b> justerar bredd (vänster/höger) och vinkel (upp/ned)."

#. from yeager:inkscape
msgid "<b>Click</b> to select or create text, <b>drag</b> to create flowed text; then type."
msgstr "<b>Klicka</b> för att välja eller skapa text, <b>dra</b> för att skapa flödande text; skriv sedan."

#. from yeager:inkscape
msgid "<b>Drag</b> or <b>double click</b> to create a gradient on selected objects, <b>drag handles</b> to adjust gradients."
msgstr "<b>Dra</b> eller <b>dubbelklicka</b> för att skapa en gradient på markerade objekt, <b>dra handtag</b> för att justera gradienter."

#. from yeager:inkscape
msgid "<b>Drag</b> or <b>double click</b> to create a mesh on selected objects, <b>drag handles</b> to adjust meshes."
msgstr "<b>Dra</b> eller <b>dubbelklicka</b> för att skapa ett nät på valda objekt, <b>dra handtag</b> för att justera nät."

#. from yeager:inkscape
msgid "<b>Click</b> or <b>drag around an area</b> to zoom in, <b>Shift+click</b> to zoom out."
msgstr "<b> Klicka </b> eller <b> dra runt ett område </b> för att zooma in, <b> shift + klicka </b> att zooma ut."

#. from yeager:inkscape
msgid "<b>Drag</b> to measure the dimensions of objects."
msgstr "<b>Dra</b> för att mäta måtten på objekt."

#. from yeager:inkscape
msgid "<b>Click</b> to set fill, <b>Shift+click</b> to set stroke; <b>drag</b> to average color in area; with <b>Alt</b> to pick inverse color; <b>Ctrl+C</b> to copy the color under mouse to clipboard"
msgstr "<b>Klicka</b> för att ställa in fyllning, <b>Skift+klicka</b> för att ställa in streck; <b>dra</b> för medelfärg inom område; med <b>Alt</b> för att välja inverterad färg; <b>Ctrl+C</b> för att kopiera färgen under muspekaren till urklipp"

#. from yeager:inkscape
msgid "To tweak a path by pushing, select it and drag over it."
msgstr "För att finjustera en slinga, markera den och drag sedan över den."

#. from yeager:inkscape
msgid "<b>Drag</b>, <b>click</b> or <b>click and scroll</b> to spray the selected objects."
msgstr "<b>Dra</b>, <b>klicka</b> eller <b>klicka och rulla</b> för att spraya de valda objekten."

#. from yeager:inkscape
msgid "<b>Click and drag</b> between shapes to create a connector."
msgstr "<b>Klicka och dra</b> mellan former för att skapa en anslutning."

#. from yeager:inkscape
msgid "<b>Click</b> to paint a bounded area, <b>Shift+click</b> to union the new fill with the current selection, <b>Ctrl+click</b> to change the clicked object's fill and stroke to the current setting."
msgstr "<b>Klicka</b> för att färga ett avgränsat område, <b>Skift+klick</b> för att sammanfoga den nya fyllningen med den nuvarande markeringen, <b>Ctrl+klick</b> för att ändra på det valda objektets fyllnings- och streckinställningar till den aktuella inställningen."

#. from yeager:inkscape
msgid "<b>Drag</b> to erase."
msgstr "<b>Dra</b> för att sudda."

