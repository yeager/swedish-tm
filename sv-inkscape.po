msgstr "justera spraybredd med 1"

#. from yeager:inkscape
msgid "adjust spray population by 1"
msgstr "justera spraypopulationen med 1"

#. from yeager:inkscape
msgid "set spray width to its minimum or maximum"
msgstr "ställ in spraybredd till minimum eller maximum"

