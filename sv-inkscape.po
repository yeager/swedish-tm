msgstr "Dra fäller in slingor, dra med Skift fäller ut."

#. from yeager:inkscape
msgid "attract/repel path mode"
msgstr "attrahera/repellera slingläge"

#. from yeager:inkscape
msgid "Drag attracts paths to cursor, drag with Shift repels."
msgstr "Dra för att dra slingor till markören, dra med Skift repellerar."

#. from yeager:inkscape
msgid "roughen mode"
msgstr "grovt läge"

#. from yeager:inkscape
msgid "color paint mode"
msgstr "målningsfärgläge"

#. from yeager:inkscape
msgid "color jitter mode"
msgstr "färgjitterläge"

#. from yeager:inkscape
