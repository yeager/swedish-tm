msgstr "_Lista:"

#. from libreoffice:sw-messages
msgid "C_aption:"
msgstr "Bildtext:"

#. from libreoffice:sw-messages
msgid "_Index:"
msgstr "_Förteckning:"

#. from libreoffice:sw-messages
msgid "Specifies the font to be used for the Default Paragraph Style."
msgstr "Anger vilket teckensnitt som ska användas i styckeformatmallen Standard."

#. from libreoffice:sw-messages
msgid "Specifies the font to be used for headings."
msgstr "Anger vilket teckensnitt som ska användas av rubriker."

#. from libreoffice:sw-messages
msgid "Specifies the fonts for lists and numbering and all derived styles."
msgstr "Anger vilket teckensnitt som ska användas av listor och numreringar samt formatmallar som är baserade på dessa."

#. from libreoffice:sw-messages
msgid "Specifies the font used for the captions of images and tables."
msgstr "Anger vilket teckensnitt som bildtexter/figurtexter ska använda sig av."

#. from libreoffice:sw-messages
msgid "Specifies the font used for indexes, alphabetical indexes, and tables of contents."
msgstr "Anger vilket teckensnitt som ska användas i förteckningar, sakregister och innehållsförteckningar."

#. from libreoffice:sw-messages
msgid "Specifies the size of the font."
msgstr "Anger teckenstorleken."

#. from libreoffice:sw-messages
msgid "Basic Fonts (%1)"
msgstr "Grundläggande teckensnitt (%1)"

#. from libreoffice:sw-messages
msgid "Specifies the settings for the basic fonts in your documents."
msgstr "Inställningar för grundläggande teckensnitt i dina dokument."

#. from libreoffice:sw-messages
msgid "Pa_ragraph end"
msgstr "Stycketecken"

#. from libreoffice:sw-messages
msgid "Specifies whether paragraph delimiters are displayed. The paragraph delimiters also contain paragraph format information."
msgstr "Anger om styckeavgränsare visas eller inte. Styckeavgränsare innehåller även formateringsinformation."

#. from libreoffice:sw-messages
msgid "Soft h_yphens"
msgstr "Mjuka bindestreck"

#. from libreoffice:sw-messages
msgid "Specifies whether soft hyphens (called also as optional or discretionary hyphens) are displayed. These are hidden user-defined delimiters that you enter within a word by pressing Ctrl+Hyphen(-). Words with soft hyphens are only separated at the end of a line at the point where a soft hyphen has been inserted, irrespective of whether the automatic hyphenation is activated or deactivated."
msgstr "Anger om mjuka bindestreck (kallas även som valfria eller diskretionära bindestreck) ska visas. Dessa är dolda användardefinierade avgränsare som du anger i ett ord genom att trycka på Ctrl+bindestreck(-). Ord med mjuka bindestreck separeras endast i slutet av en rad vid den punkt där ett mjukt bindestreck har infogats, oavsett om den automatiska avstavningen är aktiverad eller inaktiverad."

#. from libreoffice:sw-messages
msgid "Spac_es"
msgstr "Blanksteg"

#. from libreoffice:sw-messages
msgid "Specifies whether to represent every space in the text with a dot."
msgstr "Anger ifall varje blanksteg i texten ska representeras av en punkt."

#. from libreoffice:sw-messages
msgid "Non-breaking s_paces and hyphen"
msgstr "Fasta blank_steg och bindestreck"

#. from libreoffice:sw-messages
msgid "Specifies that non-breaking spaces are shown as gray boxes. Non-breaking spaces are not broken at the end of a line and are entered with the Ctrl+Shift+Spacebar shortcut keys."
msgstr "Anger att fasta blanksteg visas som grå rutor. Fasta blanksteg bryts inte i slutet av en rad och skrivs in med genvägen Ctrl+Skift+Mellanslag."

#. from libreoffice:sw-messages
msgid "_Tabs"
msgstr "_Flikar"

#. from libreoffice:sw-messages
msgid "Specifies that tab stops are displayed as small arrows."
msgstr "Anger att tabbar ska representeras av små pilar."

#. from libreoffice:sw-messages
msgid "Brea_ks"
msgstr "Brytningar"

#. from libreoffice:sw-messages
msgid "Displays all line breaks inserted with the Shift+Enter shortcut. These breaks create a new line, but do not start a new paragraph."
msgstr "Visar alla radbrytningar som infogats med kortkommandot Skift+Retur. De här brytningarna skapar en ny rad, men de börjar inte ett nytt stycke."

#. from libreoffice:sw-messages
msgid "_Hidden characters"
msgstr "_Dolda tecken"

#. from libreoffice:sw-messages
msgid "Displays text that uses the character format \"hidden\", when View - Formatting Marks is enabled."
msgstr "Visar text som använder teckenformatet \"dold\", när Visa - Formateringstecken är aktiverat."

#. from libreoffice:sw-messages
msgid "Specifies whether bookmark positions are displayed on the screen."
msgstr "Anger om bokmärkespositioner ska visas på skärmen."

#. from libreoffice:sw-messages
msgid "⌶ indicates a point bookmark,\n[ and ] indicate the start and end of a bookmark on a text range"
msgstr "⌶ anger ett punktbokmärke,\n[ och ] anger början och slutet av ett bokmärke i ett textintervall"

#. from libreoffice:sw-messages
msgid "Display Formatting"
msgstr "Visningsformatering"

#. from libreoffice:sw-messages
msgid "_Math baseline alignment"
msgstr "_Math baslinjejustering"

#. from libreoffice:sw-messages
msgid "Layout Assistance"
msgstr "Layouthjälp"

#. from libreoffice:sw-messages
msgid "Enable cursor"
msgstr "Aktivera markör"

#. from libreoffice:sw-messages
msgid "Specifies that you can set the cursor in a protected area, but cannot make any changes."
msgstr "Anger att du kan placera markören i ett skyddat område, men har inte möjlighet att ändra något."

#. from libreoffice:sw-messages
msgid "Protected Areas"
msgstr "Skyddade områden"

#. from libreoffice:sw-messages
msgid "_Direct cursor"
msgstr "Direktmarkör"

#. from libreoffice:sw-messages
msgid "Activates the direct cursor."
msgstr "Aktiverar direktmarkören."

#. from libreoffice:sw-messages
msgid "Tabs and spaces"
msgstr "Tabbar och mellanrum"

#. from libreoffice:sw-messages
msgid "Direct Cursor"
msgstr "Direktmarkör"

#. from libreoffice:sw-messages
msgid "_Anchor:"
msgstr "_Ankare:"

#. from libreoffice:sw-messages
msgid "Enclose with characters"
msgstr "Omslut med tecken"

#. from libreoffice:sw-messages
msgid "When enabled you can enclose selected text with parentheses, square brackets, curly braces or double/single quotation marks when pressing the respective button."
msgstr "När det är aktiverat kan du omge markerad text med parenteser, hakparenteser, parenteser eller dubbla/enkla citattecken när du trycker på respektive knapp."

#. from libreoffice:sw-messages
msgid "Specifies that you can enclose selected text with parentheses, square brackets, curly braces or double/single quotation marks when pressing the respective button."
msgstr "Anger att du kan omge markerad text med parenteser, hakparenteser, parenteser eller dubbla/enkla citattecken när du trycker på respektive knapp."

#. from libreoffice:sw-messages
msgid "Auto complete"
msgstr "Autokomplettera"

#. from libreoffice:sw-messages
msgid "Allow text to be dragged and dropped"
msgstr "Tillåt att text dras och släpps"

#. from libreoffice:sw-messages
msgid "Specifies whether dragging and dropping selected text should be possible."
msgstr "Anger om det ska vara möjligt att dra och släppa markerad text."

#. from libreoffice:sw-messages
msgid "Drag 'n Drop"
msgstr "Dra och släpp"

#. from libreoffice:sw-messages
msgid "Te_xt"
msgstr "Te_xt"

#. from libreoffice:sw-messages
msgid "Displays the text object boundaries."
msgstr "Visar textobjektets gränser."

#. from libreoffice:sw-messages
msgid "Tab_les"
msgstr "Tab_eller"

#. from libreoffice:sw-messages
msgid "Displays the boundaries of table cells."
msgstr "Visar gränserna för tabellceller."

#. from libreoffice:sw-messages
msgid "_Sections and Frames"
msgstr "_Sektioner och ramar"

#. from libreoffice:sw-messages
msgid "Displays the boundaries of sections and frames."
msgstr "Visar gränserna för sektioner och ramar."

#. from libreoffice:sw-messages
msgid "_Crop marks"
msgstr "_Beskärningsmärken"

#. from libreoffice:sw-messages
msgid "Shows marks on the corners of the margins box."
msgstr "Visar märken i hörnen av marginalrutan."

#. from libreoffice:sw-messages
msgid "Border _Outline"
msgstr "_Gränskontur"

#. from libreoffice:sw-messages
msgid "Shows a faint line indicating the page margins."
msgstr "Visar en svag linje som anger sidmarginalerna."

#. from libreoffice:sw-messages
msgid "Object Boundaries"
msgstr "Objektgränser"

#. from libreoffice:sw-messages
msgid "In Writer text and HTML documents, defines the display for certain characters and for the direct cursor."
msgstr "I Writer-text och HTML-dokument, definierar visningen för vissa tecken och för direktmarkören."

#. from libreoffice:sw-messages
msgid "_Fields"
msgstr "_Fält"

#. from libreoffice:sw-messages
msgid "The contents of all fields are updated automatically whenever the screen contents are displayed as new. Even with this box unchecked, some fields are updated each time a special condition takes place."
msgstr "Fältens innehåll uppdateras automatiskt varje gång skärminnehållet visas på nytt. Vissa fält uppdateras varje gång ett visst villkor uppfylls oavsett om kryssrutan är markerad eller inte."

#. from libreoffice:sw-messages
msgid "_Charts"
msgstr "Diagram"

#. from libreoffice:sw-messages
msgid "Specifies whether to automatically update charts. Whenever a Writer table cell value changes and the cursor leaves that cell, the chart that displays the cell value is updated automatically."
msgstr "Anger om diagram ska uppdateras automatiskt. När cellvärdet i en Writer-tabell ändras och markören flyttas från cellen, uppdateras cellvärdet i diagrammet automatiskt."

#. from libreoffice:sw-messages
msgid "Automatically Update"
msgstr "Automatisk uppdatering"

#. from libreoffice:sw-messages
msgid "_Always"
msgstr "Alltid"

#. from libreoffice:sw-messages
msgid "Always updates links while loading a document, and only if the document is in a trusted file location or the global security level is Low (Not recommended)."
msgstr "Uppdaterar alltid länkar när ett dokument laddas, och endast om dokumentet finns på en betrodd filplats eller om den globala säkerhetsnivån är låg (rekommenderas inte)."

#. from libreoffice:sw-messages
msgid "Updates links only on request while loading a document."
msgstr "Uppdaterar endast länkar vid förfrågan när dokumentet läses in."

#. from libreoffice:sw-messages
msgid "Links are never updated while loading a document."
msgstr "Länkar uppdateras aldrig vid inläsning av dokument."

#. from libreoffice:sw-messages
msgid "Update Links when Loading"
msgstr "Uppdatera länkar vid inläsning"

#. from libreoffice:sw-messages
msgid "_Measurement unit:"
msgstr "Måttenhet:"

#. from libreoffice:sw-messages
msgid "Specifies the unit of measurement for text documents."
msgstr "Anger en måttenhet för textdokument."

#. from libreoffice:sw-messages
msgid "Specifies the spacing between the individual tab stops."
msgstr "Anger avståndet mellan individuella tabulatorlägen."

#. from libreoffice:sw-messages
msgid "_Enable char unit"
msgstr "Aktivera teckenenhet"

#. from libreoffice:sw-messages
msgid "When this setting is enabled, the measurement units of indents and spacing on Format - Paragraph - Indents & Spacing tab will be character (ch) and line."
msgstr "När denna inställning är aktiv så kommer måttenheterna för indrag och avstånd på fliken Format - Stycke - Indrag och avstånd att vara angivna som tecken (ch) och rader."

#. from libreoffice:sw-messages
msgid "_Use square page mode for text grid"
msgstr "Använd kvadratiskt sidläge för textrutnät"

#. from libreoffice:sw-messages
msgid "When this setting is enabled, the text grid will look like square page."
msgstr "När denna inställning är aktiverad så kommer textrutnät att likna en kvadratisk sida."

#. from libreoffice:sw-messages
msgid "_Additional separators:"
msgstr "Övriga skiljetecken:"

#. from libreoffice:sw-messages
msgid "Show standardized page count"
msgstr "Visa standardiserat sidantal"

#. from libreoffice:sw-messages
msgid "Characters per standardized page:"
msgstr "Tecken per standardiserad sida:"

#. from libreoffice:sw-messages
msgid "Specifies general settings for text documents."
msgstr "Anger allmänna inställningar för textdokument."

