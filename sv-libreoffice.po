msgstr "Välj ett skalningsläge från listrutan. Lämpliga kontroller kommer att visas under listrutan."

#. from libreoffice:sc-messages
msgid "Specifies the elements to be included in the printout of all sheets with the current Page Style. Additionally, you can set the print order, the first page number, and the page scale."
msgstr "Anger vilka element som ska tas med i utskriften av alla tabeller med aktuell sidformatmall. Du kan dessutom ange utskriftsordning, första sidnummer och sidskala."

#. from libreoffice:sc-messages
msgid "Sheet View"
msgstr "Bladvy"

#. from libreoffice:sc-messages
msgid "Show Changes"
msgstr "Visa ändringar"

#. from libreoffice:sc-messages
