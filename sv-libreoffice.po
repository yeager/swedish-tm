msgstr "Menyn <emph>Visa - Förstora</emph>"

#. from libreoffice:smath-00
msgid "Choose <emph>View - Zoom Out</emph>"
msgstr "Menyn <emph>Visa - Förminska</emph>"

#. from libreoffice:smath-00
