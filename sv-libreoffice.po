msgid "Hyphenate words in _CAPS"
msgstr "Avstava ord med STORA bokstäver"

#. from libreoffice:cui-messages
msgid "Hyphenate last word"
msgstr "Avstava sista ordet"

#. from libreoffice:cui-messages
msgid "Hyphenation"
msgstr "Avstavning"

#. from libreoffice:cui-messages
msgid "Last full line of paragraph"
msgstr "Sista hela raden i stycket"

#. from libreoffice:cui-messages
msgid "Deselect this check box, if you don't want to hyphenate across the last full line of paragraph, column, page and spread."
msgstr "Avmarkera den här kryssrutan om du inte vill avstava över den sista hela raden i stycke, kolumn, sida och uppslag."

#. from libreoffice:cui-messages
msgid "Deselect this check box, if you don't want to hyphenate across column, page and spread."
msgstr "Avmarkera den här kryssrutan om du inte vill avstava över kolumn, sida och uppslag."

#. from libreoffice:cui-messages
msgid "Deselect this check box, if you don't want to hyphenate across page and spread."
msgstr "Avmarkera den här kryssrutan om du inte vill avstava över sidan och uppslaget."

#. from libreoffice:cui-messages
msgid "Spread"
msgstr "Uppslag"

#. from libreoffice:cui-messages
msgid "Deselect this check box, if you don't want to hyphenate across spread."
msgstr "Avmarkera den här kryssrutan om du inte vill avstava över uppslaget."

