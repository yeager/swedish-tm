msgstr "Area cosinus hyperbolicus"

#. from libreoffice:smath-01
msgid "<ahelp hid=\"HID_SMA_ARCOSHX\">Inserts an area hyperbolic cosine function with one placeholder.</ahelp> You can also type <emph>arcosh(<?>)</emph> in the <emph>Commands</emph> window."
msgstr "<ahelp hid=\"HID_SMA_ARCOSHX\">Infogar funktionen area cosinus hyperbolicus med en platshållare.</ahelp> Du kan också skriva <emph>arcosh(<?>)</emph> i fönstret <emph>Kommandon</emph>."

#. from libreoffice:smath-01
msgid "Area Hyperbolic Tangent"
msgstr "Area tangens hyperbolicus"

