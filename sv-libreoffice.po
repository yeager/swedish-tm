msgid "Value 0 corresponds to 1899-12-30"
msgstr "Värde 0 motsvarar 1899-12-30"

#. from libreoffice:sc-messages
msgid "Sets 1899-12-30 as day zero."
msgstr "Anger 1899-12-30 som dag noll."

#. from libreoffice:sc-messages
msgid "1900-01-01 (Star_Calc 1.0)"
msgstr "1900-01-01 (Star_Calc 1.0)"

#. from libreoffice:sc-messages
msgid "Value 0 corresponds to 1900-01-01"
msgstr "Värde 0 motsvarar 1900-01-01"

#. from libreoffice:sc-messages
msgid "Sets 1900-01-01 as day zero. Use this setting for StarCalc 1.0 spreadsheets containing date entries."
msgstr "Anger 1900-01-01 som dag noll. Använd den här inställningen för StarCalc 1.0-kalkylblad som innehåller datumanteckningar."

#. from libreoffice:sc-messages
msgid "_1904-01-01"
msgstr "_1904-01-01"

#. from libreoffice:sc-messages
msgid "0 corresponds to 1904-01-01"
msgstr "0 motsvarar 1904-01-01"

#. from libreoffice:sc-messages
msgid "Sets 1904-01-01 as day zero. Use this setting for spreadsheets that are imported in a foreign format."
msgstr "Anger 1904-01-01 som dag noll. Använd den här inställningen för kalkylblad som importeras i ett främmande format."

#. from libreoffice:sc-messages
msgid "Enable w_ildcards in formulas"
msgstr "Aktivera jokertecken _i formler"

#. from libreoffice:sc-messages
msgid "Enable wildcards for interoperability with Microsoft Excel"
msgstr "Aktivera jokertecken för interoperabilitet med Microsoft Excel"

#. from libreoffice:sc-messages
msgid "Specifies that wildcards are enabled when searching and also for character string comparisons."
msgstr "Anger att jokertecken är aktiverade vid sökningar samt vid teckensträngsjämförelser."

#. from libreoffice:sc-messages
msgid "Enable r_egular expressions in formulas"
msgstr "Aktivera r_eguljära uttryck i formler"

#. from libreoffice:sc-messages
msgid "Specifies that regular expressions instead of simple wildcards are enabled when searching and also for character string comparisons."
msgstr "Anger att reguljära utryck, i stället för enkla jokertecken, är aktiverade vid sökningar samt vid teckensträngsjämförelser."

#. from libreoffice:sc-messages
msgid "No wildcards or regular expressions in formulas"
msgstr "Inga jokertecken eller reguljära uttryck i formler"

#. from libreoffice:sc-messages
msgid "Specifies that only literal strings are used when searching and also for character string comparisons."
msgstr "Anger att textsträngar tolkas bokstavligt vid sökningar samt vid teckensträngsjämförelser."

#. from libreoffice:sc-messages
msgid "Formulas Wildcards"
msgstr "Jokertecken för formler"

