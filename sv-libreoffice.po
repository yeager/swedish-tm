msgstr "Geometrisk"

#. from libreoffice:sc-messages
msgid "Negative Binomial"
msgstr "Negativ binomial"

#. from libreoffice:sc-messages
msgid "Poisson"
msgstr "Poisson"

#. from libreoffice:sc-messages
