msgstr "Infoga cell"

#. from libreoffice:sw-messages
msgid "Keyboard Handling"
msgstr "Användning av tangentbordet"

#. from libreoffice:sw-messages
msgid "Defines the attributes of tables in text documents."
msgstr "Inställningar för tabeller i textdokument."

