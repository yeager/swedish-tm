msgstr "Standardformat för exponent"

#. from libreoffice:scalc-04
msgid "Standard date format"
msgstr "Standardformat för datum"

#. from libreoffice:scalc-04
msgid "Standard currency format"
msgstr "Standardformat för valuta"

