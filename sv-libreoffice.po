#. from libreoffice:scalc-01
msgid "<ahelp hid=\"modules/scalc/ui/headerfootercontent/textviewWND_RIGHT\">Enter the text to be displayed at the right side of the header or footer.</ahelp>"
msgstr "<ahelp hid=\"modules/scalc/ui/headerfootercontent/textviewWND_RIGHT\">Skriv texten som ska visas till höger i sidhuvudet eller sidfoten.</ahelp>"

#. from libreoffice:scalc-01
msgid "Header/Footer"
