#. from libreoffice:sw-messages
msgid "Enter the width of the envelope."
msgstr "Ange kuvertets bredd."

#. from libreoffice:sw-messages
msgid "Enter the height of the envelope."
msgstr "Ange kuvertets höjd."

#. from libreoffice:sw-messages
msgid "Select the envelope size that you want, or select \"User Defined\", and then enter the width and the height of the custom size."
msgstr "Välj den kuvertstorlek du vill ha, eller välj \"Användardefinierad\" och ange sedan bredden och höjden på den anpassade storleken."

#. from libreoffice:sw-messages
msgid "Specifies the layout and the dimension of the envelope."
msgstr "Anger utseende och storlek på kuvertet."

#. from libreoffice:sw-messages
msgid "_Print from top"
msgstr "Skriv ut från överkant"

#. from libreoffice:sw-messages
msgid "Feeds the envelope with the print side face up in the printer tray."
msgstr "Matar kuvertet med den tryckta sidan uppåt i pappersmagasinet."

#. from libreoffice:sw-messages
msgid "Print from _bottom"
msgstr "Skriv ut från underkant"

#. from libreoffice:sw-messages
msgid "Feeds the envelope with the print side face down in the printer tray."
msgstr "Matar kuvertet med den tryckta sidan nedåt i pappersmagasinet."

#. from libreoffice:sw-messages
msgid "_Shift right"
msgstr "Flytta åt höger"

#. from libreoffice:sw-messages
msgid "Shift _down"
msgstr "Flytta nedåt"

#. from libreoffice:sw-messages
msgid "Enter the amount to shift the print area to the right."
msgstr "Ange hur mycket utskriftsområdet ska flyttas åt höger."

#. from libreoffice:sw-messages
msgid "Enter the amount to shift the print area down."
msgstr "Ange hur mycket utskriftsområdet ska flyttas ned."

#. from libreoffice:sw-messages
msgid "Horizontal Left"
msgstr "Horisontellt vänster"

#. from libreoffice:sw-messages
msgid "Horizontal Center"
msgstr "Horisontellt mitten"

#. from libreoffice:sw-messages
msgid "Horizontal Right"
msgstr "Horisontellt höger"

#. from libreoffice:sw-messages
msgid "Vertical Left"
msgstr "Vertikalt vänster"

#. from libreoffice:sw-messages
msgid "Vertical Center"
msgstr "Vertikalt mitten"

#. from libreoffice:sw-messages
msgid "Vertical Right"
msgstr "Vertikalt höger"

#. from libreoffice:sw-messages
msgid "Envelope Orientation"
msgstr "Kuvertmatning"

#. from libreoffice:sw-messages
msgid "Opens the Printer Setup dialog where you can define additional printer settings, such as paper format and orientation."
msgstr "Öppnar dialogrutan Skrivarinställningar där du kan definiera ytterligare skrivarinställningar, såsom pappersformat och orientering."

#. from libreoffice:sw-messages
msgid "Current Printer"
msgstr "Aktuell skrivare"

#. from libreoffice:sw-messages
msgid "Set the print options for the envelope."
msgstr "Ange utskriftsalternativen för kuvertet."

#. from libreoffice:sw-messages
msgid "Databases in Use"
msgstr "Använda databaser"

#. from libreoffice:sw-messages
msgid "_Available Databases"
msgstr "Tillgängliga databaser"

#. from libreoffice:sw-messages
msgid "Lists the databases that are currently in use."
msgstr "Visar en lista över de databaser som används."

#. from libreoffice:sw-messages
msgid "Lists the databases that are registered in Writer."
msgstr "Listar de databaser som är registrerade i Writer."

#. from libreoffice:sw-messages
msgid "Opens the Open dialog to select a database file (*.odb). The selected file is added to the Available Databases list."
msgstr "Öppnar dialogrutan Öppna för att välja en databasfil (*.odb). Den valda filen läggs till i listan tillgängliga databaser."

#. from libreoffice:sw-messages
msgid "Use this dialog to replace the databases you access in your document via database fields, with other databases. You can only make one change at a time. Multiple selection is possible in the list on the left.\nUse the browse button to select a database file."
msgstr "Använd den här dialogrutan när du vill ersätta databaserna du öppnar i dokumenten via databasfält med andra databaser. Du kan bara göra en ändring i taget. Du kan göra flera markeringar i listan till vänster.\nVälj en databasfil med hjälp av bläddringsknappen."

#. from libreoffice:sw-messages
msgid "Exchange Databases"
msgstr "Byt databas"

#. from libreoffice:sw-messages
msgid "Database applied to document:"
msgstr "Databaser som används för dokumentet:"

#. from libreoffice:sw-messages
msgid "Change the data sources for the current document."
msgstr "Ändrar datakällorna för det aktuella dokumentet."

#. from libreoffice:sw-messages
msgid "Inserts the selected field at the current cursor position in the document. To close the dialog, click the Close button."
msgstr "Infogar det markerade fältet vid markörens aktuella position i dokumentet. När du vill stänga dialogrutan klickar du på knappen Stäng."

#. from libreoffice:sw-messages
msgid "Inserts a field at the current cursor position."
msgstr "Infogar ett fält på den plats där markören står."

#. from libreoffice:sw-messages
msgid "Find Entry"
msgstr "Hitta post"

#. from libreoffice:sw-messages
msgid "Displays the next record that contains the search text."
msgstr "Visar nästa post som innehåller söktexten."

#. from libreoffice:sw-messages
msgid "F_ind"
msgstr "Sök"

#. from libreoffice:sw-messages
msgid "Enter the search term."
msgstr "Ange sökvillkoret."

#. from libreoffice:sw-messages
msgid "Find _only in"
msgstr "Sök enbart i"

#. from libreoffice:sw-messages
msgid "Restricts the search to one data field."
msgstr "Begränsar sökningen till ett datafält."

#. from libreoffice:sw-messages
msgid "Select the data field where you want to search for the text."
msgstr "Välj det datafält där du vill söka efter texten."

#. from libreoffice:sw-messages
msgid "Searches for a record or recipient in the mail merge address list."
msgstr "Söker efter en post eller mottagare i adresslistan för sammankoppling av e-post."

#. from libreoffice:sw-messages
msgid "_Condition"
msgstr "_Villkor"

#. from libreoffice:sw-messages
msgid "For fields linked to a condition, enter the criteria here."
msgstr "Här anger du villkoren för fält med villkor."

#. from libreoffice:sw-messages
msgid "Enter the number of the record that you want to insert when the condition that you specify is met."
msgstr "Ange numret på den datapost som du vill infoga när det angivna villkoret uppfylls."

#. from libreoffice:sw-messages
msgid "Record number"
msgstr "Datapost_nummer"

#. from libreoffice:sw-messages
msgid "Select the database table or the database query that you want the field to refer to."
msgstr "Välj den databastabell eller databassökning som du vill att fältet ska referera till."

#. from libreoffice:sw-messages
msgid "Database S_election"
msgstr "_Databasval"

#. from libreoffice:sw-messages
msgid "Add database file"
msgstr "Lägg till databasfil"

#. from libreoffice:sw-messages
msgid "Opens the Open dialog where you can select a database file (*.odb). The selected file is added to the Databases Selection list."
msgstr "Öppnar dialogrutan Öppna där du kan välja en databasfil (*.odb). Den valda filen läggs till i listan databaser."

#. from libreoffice:sw-messages
msgid "From database"
msgstr "Från databas"

#. from libreoffice:sw-messages
msgid "Uses the format defined in the selected database."
msgstr "Använder det format som är definierat i den markerade databasen."

#. from libreoffice:sw-messages
msgid "Applies the format that you select in the List of user-defined formats."
msgstr "Använder det format som du väljer i listan med användardefinierade format."

#. from libreoffice:sw-messages
msgid "Lists the available user-defined formats."
msgstr "Listar tillgängliga användardefinierade format."

#. from libreoffice:sw-messages
msgid "Fi_xed content"
msgstr "_Fast innehåll"

#. from libreoffice:sw-messages
msgid "Inserts the field as static content, that is, the field cannot be updated."
msgstr "Infogar fältet som statiskt innehåll, d.v.s. fältet går inte att uppdatera."

#. from libreoffice:sw-messages
msgid "Select the first prior heading for display whose outline level is less than or equal to the specified value."
msgstr "Välj den första föregående rubriken för visning vars dispositionsnivå är mindre än eller lika med det angivna värdet."

#. from libreoffice:sw-messages
msgid "Use this option to specify which heading before the field to display. The selected heading is the first one whose outline level is less than or equal to the specified value. For example, specifying “2” will display the first heading before the field with outline level 1 or outline level 2. Heading numbers can be enabled by using “Tools - Heading Numbering“."
msgstr "Använd detta alternativ för att ange vilken rubrik före fältet som ska visas. Den valda rubriken är den första vars dispositionsnivå är mindre än eller lika med det angivna värdet. Om du till exempel anger “2” kommer den första rubriken att visas före fältet med dispositionsnivå 1 eller dispositionsnivå 2. Rubriknummer kan aktiveras genom att använda ”Verktyg – Rubriknumrering“."

#. from libreoffice:sw-messages
msgid "Enter the offset that you want to apply to a date or time field."
msgstr "Ange den korrigering du vill använda på ett datum- eller tidsfält."

#. from libreoffice:sw-messages
msgid "Offs_et in days"
msgstr "Förskjutning i dagar"

#. from libreoffice:sw-messages
msgid "Offs_et in minutes"
msgstr "Förskjutning i minuter"

#. from libreoffice:sw-messages
msgid "Enter the offset value that you want to apply to a page number field, for example \"+1\"."
msgstr "Ange det korrigeringsvärde som du vill använda på ett sidnummerfält, till exempel \"+1\"."

#. from libreoffice:sw-messages
msgid "Click the format that you want to apply to the selected field, or click \"Additional formats\" to define a custom format."
msgstr "Klicka på det format som du vill använda för det markerade fältet, eller klicka på \"Ytterligare format\" för att definiera ett eget format."

#. from libreoffice:sw-messages
msgid "Opens the Macro Selector dialog, where you can choose the macro that will run when you click the selected field in the document."
msgstr "Öppnar dialogrutan Makroväljare där du kan välja vilket makro som ska köras när du klickar på det markerade fältet i dokumentet."

#. from libreoffice:sw-messages
msgid "Sets additional function parameters for fields. The type of parameter depends on the field type that you select."
msgstr "Ange ytterligare funktionsparametrar för fält. Typen av parameter beror på vilken fälttyp du väljer."

#. from libreoffice:sw-messages
msgid "Then"
msgstr "Om sant"

#. from libreoffice:sw-messages
msgid "Else"
msgstr "Annars"

#. from libreoffice:sw-messages
msgid "Enter the text to display when the condition is met in the Then box, and the text to display when the condition is not met in the Else box."
msgstr "Ange texten som ska visas när villkoret är uppfyllt i rutan \"Om sant\" och texten som ska visas när villkoret inte är uppfyllt i rutan \"Annars\"."

#. from libreoffice:sw-messages
msgid "It_em"
msgstr "Post"

#. from libreoffice:sw-messages
msgid "Enter a new item."
msgstr "Ange ett nytt objekt."

#. from libreoffice:sw-messages
msgid "Adds the Item to the list."
msgstr "Lägger till objektet till listan."

#. from libreoffice:sw-messages
msgid "Items on _list"
msgstr "Poster i _lista"

#. from libreoffice:sw-messages
msgid "Lists the items. The topmost item is shown in the document."
msgstr "Listar posterna. Det översta objektet visas i dokumentet."

#. from libreoffice:sw-messages
msgid "Removes the selected item from the list."
msgstr "Tar bort det markerade objektet från listan."

#. from libreoffice:sw-messages
msgid "Move _Up"
msgstr "Flytta _uppåt"

#. from libreoffice:sw-messages
msgid "Moves the selected item up in the list."
msgstr "Flyttar det markerade objektet uppåt i listan."

#. from libreoffice:sw-messages
msgid "Move Do_wn"
msgstr "Flytta _nedåt"

#. from libreoffice:sw-messages
msgid "Moves the selected item down in the list."
msgstr "Flyttar det markerade objektet nedåt i listan."

#. from libreoffice:sw-messages
msgid "Enter a unique name for the Input list."
msgstr "Ange ett unikt namn för inmatningslistan."

#. from libreoffice:sw-messages
msgid "Lists the available field types. To add a field to your document, click a field type, click a field in the Selection list, and then click Insert."
msgstr "Visar tillgängliga fälttyper. Vill du lägga till ett fält i dokumentet klickar du på fälttyp, klickar på ett fält i listan Urval och klickar sedan på Infoga."

#. from libreoffice:sw-messages
msgid "Select format for selected reference field."
msgstr "Välj format för valt referensfält."

#. from libreoffice:sw-messages
msgid "Select the format that you want to use for the selected reference field."
msgstr "Välj det format som du vill använda för det valda referensfältet."

#. from libreoffice:sw-messages
msgid "_Refer using:"
msgstr "_Referera med:"

#. from libreoffice:sw-messages
msgid "Search this page from bottom to top"
msgstr "Sök på den här sidan från botten till toppen"

#. from libreoffice:sw-messages
msgid "Hide non-numerical characters"
msgstr "Dölj icke-numeriska tecken"

#. from libreoffice:sw-messages
msgid "Filter Selection"
msgstr "Filtrera urval"

#. from libreoffice:sw-messages
msgid "Lists the available fields for the field type selected in the “Type” list. To insert a field, click the field, select a format in the “Refer using” list, and then click “Insert”."
msgstr "Listar de tillgängliga fälten för den fälttyp som valts i listan \"Typ\". För att infoga ett fält, klicka på fältet, välj ett format i listan \"Referera med\" och klicka sedan på \"Infoga\"."

#. from libreoffice:sw-messages
msgid "S_election"
msgstr "Urval"

#. from libreoffice:sw-messages
msgid "Enter the contents that you want to add to a user-defined fields."
msgstr "Ange innehållet du vill lägga till i användardefinierade fält."

#. from libreoffice:sw-messages
msgid "Type the name of the user-defined field that you want to create."
msgstr "Skriv namnet på det användardefinierade fält som du ska skapa."

#. from libreoffice:sw-messages
msgid "This is where you insert the references or referenced fields into the current document. References are referenced fields within the same document or within sub-documents of a master document."
msgstr "Här infogar du referenserna eller referensfälten i det aktuella dokumentet. Referenserna är referensfält inom samma dokument eller i underdokument till ett samlingsdokument."

#. from libreoffice:sw-messages
msgid "Type the name of the user-defined field  to create."
msgstr "Skriv namnet på det användardefinierade fältet som ska skapas."

#. from libreoffice:sw-messages
msgid "Enter the contents to add to a user-defined field."
msgstr "Ange innehållet som ska läggas till i ett användardefinierat fält."

#. from libreoffice:sw-messages
msgid "Adds the user-defined field to the Select list."
msgstr "Lägger till det användardefinierade fältet i urvalslistan."

#. from libreoffice:sw-messages
msgid "Removes the user-defined field from the select list. You can only remove fields that are not used in the current document."
msgstr "Tar bort det användardefinierade fältet från urvalslistan. Du kan bara ta bort fält som inte används i det aktuella dokumentet."

#. from libreoffice:sw-messages
msgid "Lists the available field types. To add a field to your document, click a field type, click a field in the Select list, and then click Insert."
msgstr "Visar de tillgängliga fälttyperna. Om du vill lägga till ett fält i ett dokument klickar du på en fälttyp och sedan ett fält i Urvalslistan  och sedan klickar du på Infoga."

#. from libreoffice:sw-messages
msgid "Lists the available fields for the field type selected in the Type list. To insert a field, click the field, and then click Insert."
msgstr "Visar en lista över tillgängliga fält för den fälttyp som markerats i listan Typ. Om du vill infoga ett fält klickar du på fältet och sedan på Infoga."

#. from libreoffice:sw-messages
msgid "Click the format to apply to the selected field, or click \"Additional formats\" to define a custom format."
msgstr "Klicka på formatet som ska tillämpas på det valda fältet, eller klicka på \"Ytterligare format\" för att definiera ett anpassat format."

#. from libreoffice:sw-messages
msgid "In the Format list, define if the value is inserted as text or as number."
msgstr "I listan Format, definiera om värdet ska infogas som text eller som nummer."

#. from libreoffice:sw-messages
msgid "Invisi_ble"
msgstr "Osynligt"

#. from libreoffice:sw-messages
msgid "Hides the field contents in the document."
msgstr "Döljer fältinnehållet i dokumentet."

#. from libreoffice:sw-messages
msgid "Se_parator:"
msgstr "_Skiljetecken:"

#. from libreoffice:sw-messages
msgid "Choose heading number to prepend to displayed field, where the number comes from the first prior heading whose outline level is equal to or less than the selected outline level. If [None] is selected, no heading number is displayed."
msgstr "Välj rubriknummer som ska läggas före det visade fältet, där numret kommer från den första föregående rubriken vars dispositionsnivå är lika med eller mindre än den valda dispositionsnivån. Om [Ingen] väljs visas inget rubriknummer."

#. from libreoffice:sw-messages
msgid "Choose heading number to prepend to displayed field, where the number comes from the first prior heading whose outline level is equal to or less than the selected outline level. For example, select “2” to use the heading number of the first prior heading that has outline level 2 or less. If “None” is selected, no heading number is displayed. To use this option, heading numbers must be enabled. Use “Tools - Heading Numbering”."
msgstr "Välj rubriknummer som ska läggas före det visade fältet, där numret kommer från den första föregående rubriken vars dispositionsnivå är lika med eller mindre än den valda dispositionsnivån. Välj till exempel \"2\" för att använda rubriknumret för den första föregående rubriken som har dispositionsnivå 2 eller lägre. Om \"Ingen\" väljs, visas inget rubriknummer. För att använda detta alternativ måste rubriknummer vara aktiverat. Använd \"Verktyg - Rubriknumrering\"."

#. from libreoffice:sw-messages
msgid "Enter the character to use as a separator between the heading number and the field number."
msgstr "Ange tecknet som ska användas som skiljetecken mellan rubriknumret och fältnumret."

#. from libreoffice:sw-messages
msgid "With Heading Number"
msgstr "Med rubriknummer"

#. from libreoffice:sw-messages
msgid "_Format"
msgstr "_Format"

#. from libreoffice:sw-messages
msgid "Synchronize Labels"
msgstr "Synkronisera etiketter"

#. from libreoffice:sw-messages
msgid "Settings of Footnotes and Endnotes"
msgstr "Inställningar för fotnoter och slutnoter"

#. from libreoffice:sw-messages
msgid "_Not larger than page area"
msgstr "Höjd maximalt som _sida"

#. from libreoffice:sw-messages
msgid "Automatically adjusts the height of the footnote area depending on the number of footnotes."
msgstr "Justerar automatiskt höjden på fotnotsområdet beroende på antalet fotnoter."

#. from libreoffice:sw-messages
msgid "Maximum footnote _height"
msgstr "Fotnotens ma_ximala höjd"

#. from libreoffice:sw-messages
msgid "Sets a maximum height for the footnote area. Enable this option, then enter the height."
msgstr "Ange en maximal höjd för fotnotsområdet. Aktivera det här alternativet och ange sedan höjden."

#. from libreoffice:sw-messages
msgid "Space to text"
msgstr "Avstånd till text"

#. from libreoffice:sw-messages
msgid "Enter the amount of space to leave between the bottom page margin and the first line of text in the footnote area."
msgstr "Ange hur mycket utrymme som ska lämnas mellan den nedre sidmarginalen och den första textraden i fotnotsområdet."

#. from libreoffice:sw-messages
msgid "Enter the maximum height for the footnote area."
msgstr "Ange den maximala höjden för fotnotsområdet."

#. from libreoffice:sw-messages
msgid "Footnote Area"
msgstr "Fotnotsområde"

#. from libreoffice:sw-messages
msgid "_Position"
msgstr "_Position"

#. from libreoffice:sw-messages
msgid "_Style"
msgstr "Stil"

#. from libreoffice:sw-messages
msgid "_Thickness"
msgstr "_Tjocklek"

#. from libreoffice:sw-messages
msgid "_Spacing to footnote contents"
msgstr "Avstån_d till fotnotens innehåll"

#. from libreoffice:sw-messages
msgid "Select the horizontal alignment for the line that separates the main text from the footnote area."
msgstr "Välj den horisontella justeringen för linjen som skiljer huvudtexten från fotnotsområdet."

#. from libreoffice:sw-messages
msgid "Select the formatting style for the separator line. If you do not want a separator line, choose \"None\"."
msgstr "Välj formateringsstil för skiljelinjen. Om du inte vill ha en skiljelinje, välj \"Ingen\"."

#. from libreoffice:sw-messages
msgid "Select the color of the separator line."
msgstr "Välj färgen på skiljelinjen."

#. from libreoffice:sw-messages
msgid "Enter the length of the separator line as a percentage of the page width area."
msgstr "Ange längden på skiljelinjen som en procentandel av sidbreddsytan."

#. from libreoffice:sw-messages
msgid "Enter the amount of space to leave between the separator line and the first line of the footnote area."
msgstr "Ange hur mycket utrymme som ska lämnas mellan skiljelinjen och den första raden i fotnotsområdet."

#. from libreoffice:sw-messages
msgid "Select the thickness of the separator line."
msgstr "Välj tjockleken på skiljelinjen."

#. from libreoffice:sw-messages
msgid "Separator Line"
msgstr "Skiljelinje"

#. from libreoffice:sw-messages
msgid "Specifies the layout options for footnotes, including the line that separates the footnote from the main body of document."
msgstr "Anger layoutalternativen för fotnoter, inklusive raden som skiljer fotnoten från huvuddelen av dokumentet."

#. from libreoffice:sw-messages
msgid "Enter the number for the first footnote in the document. This option is only available if you selected \"Per Document\" in the Counting box."
msgstr "Ange ordningstalet för den första fotnoten i dokumentet. Det här alternativet är bara tillgängligt om du väljer \"Per dokument\" i rutan Räknar."

#. from libreoffice:sw-messages
msgid "Enter the text that you want to display in front of the footnote number in the note text."
msgstr "Ange den text som ska skrivas framför fotnotens siffra i fotnotstexten."

#. from libreoffice:sw-messages
msgid "Enter the text that you want to display after the footnote number in the note text."
msgstr "Ange den text som ska skrivas efter fotnotens siffra i fotnotstexten."

#. from libreoffice:sw-messages
msgid "Counting:"
msgstr "Räkning:"

#. from libreoffice:sw-messages
msgid "Per page"
msgstr "Per sida"

#. from libreoffice:sw-messages
msgid "Per chapter"
msgstr "Per kapitel"

#. from libreoffice:sw-messages
msgid "Per document"
msgstr "Per dokument"

#. from libreoffice:sw-messages
msgid "Select the numbering option for the footnotes."
msgstr "Ange numreringsstil för fotnoter."

#. from libreoffice:sw-messages
msgid "End of page"
msgstr "Slutet av sidan"

#. from libreoffice:sw-messages
msgid "Displays footnotes at the bottom of the page."
msgstr "Visar fotnoter längst ned på sidan."

#. from libreoffice:sw-messages
msgid "End of document"
msgstr "Dokumentslut"

#. from libreoffice:sw-messages
msgid "Displays footnotes at the end of the document as endnotes."
msgstr "Visar fotnoter i slutet av dokumentet som slutnoter."

#. from libreoffice:sw-messages
msgid "Autonumbering"
msgstr "Automatisk numrering"

#. from libreoffice:sw-messages
msgid "Paragraph:"
msgstr "Stycke:"

#. from libreoffice:sw-messages
msgid "Select the paragraph style for the footnote text. Only special styles can be selected."
msgstr "Välj styckeformatmall för fotnotstexten. Endast specialformatmallar kan väljas."

#. from libreoffice:sw-messages
msgid "Select the page style that you want to use for footnotes."
msgstr "Välj den sidformatmall som ska användas av fotnoterna."

#. from libreoffice:sw-messages
msgid "Text style"
msgstr "Textformat"

#. from libreoffice:sw-messages
msgid "Anchor in text:"
msgstr "Ankare i text:"

#. from libreoffice:sw-messages
msgid "Anchor in footnote:"
msgstr "Ankare i fotnot:"

#. from libreoffice:sw-messages
msgid "Numbering char style"
msgstr "Numreringsdiagramstil"

#. from libreoffice:sw-messages
msgid "End of footnote:"
msgstr "Slutet på fotnoten:"

#. from libreoffice:sw-messages
msgid "Enter the text that you want to display when the footnotes are continued on the next page, for example, \"Continued on Page \". Writer automatically inserts the number of the following page."
msgstr "Skriv in texten som du vill visa när fotnoterna fortsätter på nästa sida, till exempel \"Fortsättning på sida \". Writer infogar automatiskt numret på följande sida."

#. from libreoffice:sw-messages
msgid "Start of next page:"
msgstr "Början på nästa sida:"

#. from libreoffice:sw-messages
msgid "Enter the text that you want to display on the page where the footnotes are continued, for example, \"Continued from Page \". Writer automatically inserts the number of the previous page."
msgstr "Skriv in texten som du vill visa på sidan där fotnoterna fortsätter, till exempel \"Fortsättning från sida \". Writer infogar automatiskt numret på föregående sida."

#. from libreoffice:sw-messages
msgid "Continuation Notice"
msgstr "Hänvisningstext för flersidiga fotnoter"

#. from libreoffice:sw-messages
msgid "Specifies the formatting for footnotes."
msgstr "Anger formateringen för fotnoter."

#. from libreoffice:sw-messages
msgid "Restarts the footnote numbering at the number that you specify."
msgstr "Börjar om fotnotsnumreringen på det nummer du anger."

#. from libreoffice:sw-messages
msgid "Enter the number that you want to assign the footnote."
msgstr "Ange det nummer du vill tilldela fotnoten."

#. from libreoffice:sw-messages
msgid "Custom _format"
msgstr "Anpassat format"

#. from libreoffice:sw-messages
msgid "Enter the text that you want to display after the footnote number."
msgstr "Skriv in den text som ska visas efter fotnotsnumret."

#. from libreoffice:sw-messages
msgid "Select the numbering scheme for the footnotes."
msgstr "Välj numreringsschema för fotnoterna."

#. from libreoffice:sw-messages
msgid "Enter the text that you want to display in front of the footnote number."
msgstr "Ange den text som ska visas framför fotnotsnumret."

#. from libreoffice:sw-messages
msgid "Collec_t at end of text"
msgstr "Samla vid textslut"

#. from libreoffice:sw-messages
msgid "Adds footnotes at the end of the section. If the section spans more than one page, the footnotes are added to the bottom of the page on which the footnote anchors appear."
msgstr "Lägger till fotnoter i slutet av området. Om området sträcker sig över mer än en sida, läggs fotnoterna till nederst på den sida där fotnotsankare visas."

#. from libreoffice:sw-messages
msgid "Footnotes"
msgstr "Fotnoter"

#. from libreoffice:sw-messages
msgid "C_ollect at end of section"
msgstr "Samla vid områdets slut"

#. from libreoffice:sw-messages
msgid "Adds endnotes at the end of the section."
msgstr "Lägger till slutnoter i slutet av området."

#. from libreoffice:sw-messages
msgid "_Restart numbering"
msgstr "Starta numrering på nytt"

#. from libreoffice:sw-messages
msgid "Restarts the endnote numbering at the number that you specify."
msgstr "Börjar om slutnotsnumreringen på det nummer du anger."

#. from libreoffice:sw-messages
msgid "Enter the number that you want to assign the endnote."
msgstr "Ange det nummer du vill tilldela slutnoten."

#. from libreoffice:sw-messages
msgid "_Start at:"
msgstr "Börja med"

#. from libreoffice:sw-messages
msgid "_Custom format"
msgstr "Anpassat format"

#. from libreoffice:sw-messages
msgid "Specifies a custom numbering format for endnotes."
msgstr "Anger ett eget numreringsformat för fotnoter."

#. from libreoffice:sw-messages
msgid "Enter the text that you want to display after the endnote number."
msgstr "Skriv in den text som ska visas efter slutnotsnumret."

#. from libreoffice:sw-messages
msgid "Aft_er:"
msgstr "Efter:"

#. from libreoffice:sw-messages
msgid "Select the numbering scheme for the endnotes."
msgstr "Välj numreringsschema för slutnoterna."

#. from libreoffice:sw-messages
msgid "Enter the text that you want to display in front of the endnote number"
msgstr "Ange den text som ska visas framför slutnotsnumret."

#. from libreoffice:sw-messages
msgid "Be_fore:"
msgstr "Före:"

#. from libreoffice:sw-messages
msgid "Endnotes"
msgstr "Slutnoter"

#. from libreoffice:sw-messages
msgid "Specifies where footnotes and endnotes are displayed as well as their numbering formats."
msgstr "Anger var fotnoter och slutnoter ska visas och deras numreringsformat."

#. from libreoffice:sw-messages
msgid "W_idth"
msgstr "_Bredd"

#. from libreoffice:sw-messages
msgid "Enter an internal name for the table. You can use this name to quickly locate the table in the Navigator."
msgstr "Ange ett internt namn på tabellen. Du kan använda namnet för att snabbt hitta tabellen med Navigator."

#. from libreoffice:sw-messages
msgid "Displays the width of the table as a percentage of the page width."
msgstr "Visar tabellens bredd som en procentandel av sidbredden."

#. from libreoffice:sw-messages
msgid "Enter the width of the table."
msgstr "Ange tabellens bredd."

#. from libreoffice:sw-messages
msgid "Lef_t"
msgstr "Till väns_ter"

#. from libreoffice:sw-messages
msgid "Ri_ght"
msgstr "Till hö_ger"

#. from libreoffice:sw-messages
msgid "_Above"
msgstr "_Uppe"

#. from libreoffice:sw-messages
msgid "_Below"
msgstr "N_ere"

#. from libreoffice:sw-messages
msgid "Enter the amount of space that you want to leave between the left page margin and the edge of the table."
msgstr "Ange hur stort utrymme som ska lämnas mellan vänster sidmarginal och tabellens kant."

#. from libreoffice:sw-messages
msgid "Enter the amount of space that you want to leave between the right page margin and the edge of the table."
msgstr "Ange hur stort utrymme som ska lämnas mellan höger sidmarginal och tabellens kant."

#. from libreoffice:sw-messages
msgid "Enter the amount of space that you want to leave between the top edge of the table and the text above the table."
msgstr "Ange hur mycket utrymme som ska lämnas mellan tabellens överkant och texten ovanför tabellen."

#. from libreoffice:sw-messages
msgid "Enter the amount of space that you want to leave between the bottom edge of the table and the text below the table."
msgstr "Ange hur mycket utrymme som ska lämnas mellan tabellens nederkant och texten under tabellen."

#. from libreoffice:sw-messages
msgid "Extends the table horizontally to the left and to the right page margins."
msgstr "Utvidgar tabellen vågrätt till vänster och höger sidmarginaler."

#. from libreoffice:sw-messages
msgid "Aligns the left edge of the table to the left page margin."
msgstr "Justerar tabellens vänstra kant mot vänster sidmarginal."

#. from libreoffice:sw-messages
msgid "_From left"
msgstr "Från vänster"

#. from libreoffice:sw-messages
msgid "Aligns the left edge of the table to the indent that you enter in the Left box in the Spacing area."
msgstr "Justerar tabellens vänsterkant till det indrag du anger i rutan Till vänster under Avstånd."

#. from libreoffice:sw-messages
msgid "R_ight"
msgstr "Höge_r"

#. from libreoffice:sw-messages
msgid "Aligns the right edge of the table to the right page margin."
msgstr "Justerar tabellens högra kant mot höger sidmarginal."

#. from libreoffice:sw-messages
msgid "Centers the table horizontally on the page."
msgstr "Centrerar tabellen horisontellt på sidan."

#. from libreoffice:sw-messages
msgid "Horizontally aligns the table based on the values that you enter in the Left and Right boxes in the Spacing area."
msgstr "Justerar tabellen horisontellt baserat på de värden du anger i rutorna Till vänster och Till höger under Avstånd."

#. from libreoffice:sw-messages
msgid "Text _direction"
msgstr "Text_riktning"

#. from libreoffice:sw-messages
msgid "Properties "
msgstr "Egenskaper "

#. from libreoffice:sw-messages
msgid "Specify the size, position, spacing, and alignment options for the selected table."
msgstr "Anger alternativ för storlek, placering, avstånd och justering av den markerade tabellen."

#. from libreoffice:sw-messages
msgid "Enter a name for the selected item."
msgstr "Ange ett namn på det markerade objektet."

#. from libreoffice:sw-messages
msgid "Enter a short description of the essential details of the selected object for a person who cannot see the object. This text is available for use by assistive technologies. For images, this text is exported with an appropriate tag to HTML and PDF format."
msgstr "Ange en kort beskrivning av de väsentliga detaljerna för det valda objektet för en person som inte kan se objektet. Denna text är tillgänglig för användning av hjälpmedel. För bilder exporteras denna text med en lämplig tagg till HTML- och PDF-format."

#. from libreoffice:sw-messages
msgid "Give a short description for users who do not see this object."
msgstr "Ge en kort beskrivning för användare som inte ser detta objekt."

#. from libreoffice:sw-messages
msgid "Text _Alternative:"
msgstr "_Textalternativ:"

#. from libreoffice:sw-messages
msgid "Give a longer explanation of the content if it is too complex to be described briefly in “Text Alternative.”"
msgstr "Ge en längre förklaring av innehållet om det är för komplicerat för att kortfattat beskrivas i \"Textalternativ.\""

#. from libreoffice:sw-messages
msgid "Enter a longer description of the object, especially if the object is too complex or contains too much detail to be described adequately with the short “Text Alternative.” This text is available for use by assistive technologies. For images, this text is exported with an appropriate tag to HTML and PDF format."
msgstr "Ange en längre beskrivning av objektet, särskilt om objektet är för komplext eller innehåller för mycket detaljer för att beskrivas på ett tillfredsställande sätt med det korta \"Textalternativ.\" Denna text är tillgänglig för användning av hjälpmedel. För bilder exporteras denna text med en lämplig tagg till HTML- och PDF-format."

#. from libreoffice:sw-messages
msgid "_Vertical alignment:"
msgstr "_Vertikal justering:"

#. from libreoffice:sw-messages
msgid "Specifies the vertical alignment of the frame's content. Mainly it means text content, but it also affects tables and other objects anchored to the text area (anchored as character, to character or to paragraph), for example frames, graphics or drawings."
msgstr "Anger den vertikala justeringen av innehållet i en ram. Detta innebär i huvudsak text men påverkar även tabeller och andra objekt som förankrats i textytan (förankring som tecken, till tecken eller till stycke) som exempelvis ramar, bilder och teckningar."

#. from libreoffice:sw-messages
msgid "Content Alignment"
msgstr "Justera innehåll"

#. from libreoffice:sw-messages
msgid "_Editable in read-only document"
msgstr "Redigerbar i skrivskyddade dokument"

#. from libreoffice:sw-messages
msgid "Allows you to edit the contents of a frame in a document that is read-only (write-protected)."
msgstr "Gör att du kan redigera innehållet i en ram i ett dokument med skrivskydd."

#. from libreoffice:sw-messages
msgid "Prin_t"
msgstr "Skriv ut"

#. from libreoffice:sw-messages
msgid "Includes the selected item when you print the document."
msgstr "Tar med det markerade objektet när du skriver ut dokumentet."

#. from libreoffice:sw-messages
msgid "Specifies the preferred text flow direction in a frame. To use the default text flow settings for the page, select Use superordinate object settings from the list."
msgstr "Anger den önskade textflödesriktningen i en ram. Du kan använda standardinställningarna för textflöde på sidan genom att välja Använd det överordnade objektets inställningar i listan."

#. from libreoffice:sw-messages
msgid "Link this frame prior to current frame."
msgstr "Länka den här ramen före den aktuella ramen."

#. from libreoffice:sw-messages
msgid "_Previous link:"
msgstr "_Föregående länk:"

#. from libreoffice:sw-messages
msgid "Displays the frame that comes before the current frame in a linked sequence. To add or change the previous link, select a frame from the list. If you are linking frames, the current frame and the target frame must be empty."
msgstr "Visar ramen som kommer före den aktuella ramen i en länkad sekvens. För att lägga till eller ändra föregående länk, välj en ram från listan. Om du länkar ramar måste den aktuella ramen och målramen vara tomma."

#. from libreoffice:sw-messages
msgid "Link this frame after the current frame."
msgstr "Länka den här ramen efter den aktuella ramen."

#. from libreoffice:sw-messages
msgid "_Next link:"
msgstr "_Nästa länk:"

#. from libreoffice:sw-messages
msgid "<None>"
msgstr "<Ingen>"

#. from libreoffice:sw-messages
msgid "Displays the frame that comes after the current frame in a linked sequence. To add or change the next link, select a frame from the list. If you are linking frames, the target frame must be empty."
msgstr "Visar ramen som kommer efter den aktuella ramen i en länkad sekvens. För att lägga till eller ändra nästa länk, välj en ram från listan. Om du länkar ramar måste målramen vara tom."

#. from libreoffice:sw-messages
msgid "Specify the sequence for linked frames."
msgstr "Ange sekvensen för länkade ramar."

#. from libreoffice:sw-messages
msgid "Sequence"
msgstr "Sekvens"

#. from libreoffice:sw-messages
msgid "Specifies properties for the selected object, graphic or frame."
msgstr "Anger egenskaper för det valda objektet, grafiken eller ramen."

#. from libreoffice:sw-messages
msgid "_Width"
msgstr "_Bredd"

#. from libreoffice:sw-messages
msgid "_Width (at least)"
msgstr "_Bredd (minst)"

#. from libreoffice:sw-messages
msgid "Relat_ive to"
msgstr "Relativ"

#. from libreoffice:sw-messages
msgid "Calculates the width of the selected object as a percentage of the width of the page text area."
msgstr "Beräknar det markerade objektets bredd som en procentandel av bredden på sidans textområde."

#. from libreoffice:sw-messages
msgid "Decides what 100% width means: either text area (excluding margins) or the entire page (including margins)."
msgstr "Bestämmer vad 100% bredd innebär: antingen textytan (exklusive marginaler) eller hela sidan (inklusive marginaler)."

#. from libreoffice:sw-messages
msgid "H_eight"
msgstr "Höj_d"

#. from libreoffice:sw-messages
msgid "H_eight (at least)"
msgstr "Höj_d (minst)"

#. from libreoffice:sw-messages
msgid "Re_lative to"
msgstr "Relativ"

#. from libreoffice:sw-messages
msgid "Calculates the height of the selected object as a percentage of the height of the page text area."
msgstr "Beräknar det markerade objektets höjd som en procentandel av höjden på sidans textområde."

#. from libreoffice:sw-messages
msgid "Decides what 100% height means: either text area (excluding margins) or the entire page (including margins)."
msgstr "Bestämmer vad 100% höjd innebär: antingen textytan (exklusive marginaler) eller hela sidan (inklusive marginaler)."

#. from libreoffice:sw-messages
msgid "AutoSize"
msgstr "Automatisk"

#. from libreoffice:sw-messages
msgid "Automatically adjusts the width or height of a frame to match the contents of the frame. If you want, you can specify a minimum width or minimum height for the frame."
msgstr "Justerar höjden eller bredden på ramen automatiskt så den anpassas efter raminnehållet. Du kan om du vill ange en minsta bredd eller höjd för ramen."

#. from libreoffice:sw-messages
msgid "Resets the size settings of the selected object to the original values."
msgstr "Återställer storleksinställningarna för det markerade objektet till ursprungsvärdena."

#. from libreoffice:sw-messages
msgid "_Contents"
msgstr "_Innehåll"

#. from libreoffice:sw-messages
msgid "Prevents changes to the contents of the selected item."
msgstr "Förhindrar ändringar av innehållet i det valda objektet."

#. from libreoffice:sw-messages
msgid "P_osition"
msgstr "P_osition"

#. from libreoffice:sw-messages
msgid "Locks the position of the selected item in the current document."
msgstr "Låser positionen för det valda objektet i det aktuella dokumentet."

#. from libreoffice:sw-messages
msgid "Locks the size of the selected item."
msgstr "Låser storleken på det valda objektet."

#. from libreoffice:sw-messages
msgid "b_y"
msgstr "med"

#. from libreoffice:sw-messages
msgid "_to"
msgstr "till"

#. from libreoffice:sw-messages
msgid "t_o"
msgstr "till"

#. from libreoffice:sw-messages
msgid "Keep inside text boundaries"
msgstr "Håll inom textgränserna"

#. from libreoffice:sw-messages
msgid "Allow frame to split across pages"
msgstr "Tillåt ram att delas över sidor"

#. from libreoffice:sw-messages
msgid "Enter the complete path to the file that you want to open."
msgstr "Ange sökvägen till den fil du vill öppna."

#. from libreoffice:sw-messages
msgid "_Frame:"
msgstr "_Ram:"

#. from libreoffice:sw-messages
msgid "Locate the file that you want the hyperlink to open, and then click Open."
msgstr "Leta rätt på den fil som du vill att hyperlänken ska öppna och klicka sedan på Öppna."

#. from libreoffice:sw-messages
msgid "Specify the name of the frame where you want to open the targeted file."
msgstr "Ange namnet på den HTML-ram där målfilen ska öppnas."

#. from libreoffice:sw-messages
msgid "Link to"
msgstr "Länk till"

#. from libreoffice:sw-messages
msgid "_Server-side image map"
msgstr "Bildkarta på _serversidan"

#. from libreoffice:sw-messages
msgid "Uses a server-side image map."
msgstr "Använder en image map på serversidan."

#. from libreoffice:sw-messages
msgid "_Client-side image map"
msgstr "Bildkarta på _klientsidan"

#. from libreoffice:sw-messages
msgid "Uses the image map that you created for the selected object."
msgstr "Använder den image map som du skapat för det markerade objektet."

#. from libreoffice:sw-messages
msgid "Image Map"
msgstr "Bildkarta"

#. from libreoffice:sw-messages
msgid "Specify the properties of the hyperlink for the selected graphic, frame or OLE object."
msgstr "Ange egenskaperna för hyperlänken för det valda grafik-, ram- eller OLE-objektet."

#. from libreoffice:sw-messages
msgid "Border and Background..."
msgstr "Inramning och bakgrund…"

#. from libreoffice:sw-messages
msgid "Insert Page Count"
msgstr "Infoga sidräkning"

#. from libreoffice:sw-messages
msgid "Insert Page Count In Page Numbering Range"
msgstr "Infoga sidantal i sidnumreringsintervallet"

#. from libreoffice:sw-messages
msgid "Insert number of pages in the range of pages until the page numbering is modified."
msgstr "Infoga antal sidor i sidintervallet tills sidnumreringen ändras."

#. from libreoffice:sw-messages
msgid "_Before section"
msgstr "Före område"

#. from libreoffice:sw-messages
msgid "_After section"
msgstr "Efter område"

#. from libreoffice:sw-messages
msgid "Specifies the indents before the section, at the left margin."
msgstr "Anger indraget före området, vid vänstermarginalen."

#. from libreoffice:sw-messages
msgid "Specifies the indents after the section, at the right margin."
msgstr "Anger indraget efter området, vid högermarginalen."

#. from libreoffice:sw-messages
msgid "Close dialog without saving non-applied changes."
msgstr "Stäng dialogrutan utan att spara icke tillämpade ändringar."

#. from libreoffice:sw-messages
msgid "Deletes the selected entry from the index. The entry text in the document is not deleted."
msgstr "Tar bort den markerade posten från förteckningen. Den text i dokumentet som hör till posten påverkas inte."

#. from libreoffice:sw-messages
msgid "Index:"
msgstr "Förteckning:"

#. from libreoffice:sw-messages
msgid "Select the index that you want to add the entry to."
msgstr "Välj förteckningen som du vill lägga till posten till."

#. from libreoffice:sw-messages
msgid "New User-defined Index"
msgstr "Ny användardefinierad förteckning"

#. from libreoffice:sw-messages
msgid "Entry:"
msgstr "Post:"

#. from libreoffice:sw-messages
msgid "Displays the text that is selected in the document. If you want, you can enter a different word for the index entry. The selected text in the document is not changed."
msgstr "Visar texten som är markerad i dokumentet. Om du vill kan du ange ett annat ord för indexposten. Den markerade texten i dokumentet ändras inte."

#. from libreoffice:sw-messages
msgid "Update entry from selection"
msgstr "Uppdatera post från markering"

#. from libreoffice:sw-messages
msgid "Enter the phonetic reading for the corresponding entry. For example, if a Japanese Kanji word has more than one pronunciation, enter the correct pronunciation as a Katakana word. The Kanji word is then sorted according to the phonetic reading entry."
msgstr "Ange den fonetiska läsningen för motsvarande post. Till exempel, om ett japanskt Kanji-ord har mer än ett uttal anger du rätt uttal som ett Katakana-ord. Kanji-ordet sorteras sedan enligt den fonetiska läsposten."

#. from libreoffice:sw-messages
msgid "Phonetic reading:"
msgstr "Fonetisk läsning:"

#. from libreoffice:sw-messages
msgid "Enter the phonetic reading for the corresponding entry."
msgstr "Ange den fonetiska läsningen för motsvarande post."

#. from libreoffice:sw-messages
msgid "1st key:"
msgstr "1:a nyckeln:"

#. from libreoffice:sw-messages
msgid "Makes the current selection a subentry of the word that you enter here. For example, if you select “cold”, and enter “weather” as the 1st key, the index entry will be “weather, cold”."
msgstr "Gör det aktuella valet till en underpost till ordet som du anger här. Till exempel, om du väljer \"kallt\" och anger \"väder\" som den första knappen, kommer indexposten att vara \"väder, kallt\"."

#. from libreoffice:sw-messages
msgid "2nd key:"
msgstr "2:a nyckel:"

#. from libreoffice:sw-messages
msgid "Makes the current selection a sub-subentry of the 1st key. For example, if you select “cold”, and enter “weather” as the 1st key and “winter” as the 2nd key, the index entry will be “weather, winter, cold”."
msgstr "Gör det aktuella valet till en underpost till den första nyckeln. Om du till exempel väljer \"kallt\" och anger \"väder\" som 1:a nyckel och \"vinter\" som 2:a nyckel, kommer indexposten att vara \"väder, vinter, kallt\"."

#. from libreoffice:sw-messages
msgid "Index level:"
msgstr "Indexnivå:"

#. from libreoffice:sw-messages
msgid "Enter the index level for the entry, which determines the appearance of the entry in the generated index."
msgstr "Ange indexnivån för posten, som bestämmer utseendet på posten i det genererade förteckningen."

#. from libreoffice:sw-messages
msgid "Enter the index level for the entry. The index level determines the appearance of the entry, according to the settings for that level in the “Entries” tab and the “Styles” tab in the “Table of Contents, Index, or Bibliography” dialog. With default settings, a higher index level results in a greater indent for the entry in the generated index."
msgstr "Ange indexnivån för posten. Indexnivån bestämmer postens utseende, enligt inställningarna för den nivån på fliken \"Inlägg\" och fliken \"Mallar\" i dialogrutan \"Innehållsförteckning, index eller källförteckning\". Med standardinställningar resulterar en högre indexnivå i en större indrag för posten i det genererade förteckningen."

#. from libreoffice:sw-messages
msgid "Main entry"
msgstr "Huvudpost"

#. from libreoffice:sw-messages
msgid "Makes the selected text the main entry in an alphabetical index."
msgstr "Gör den markerade texten till huvudposten i ett alfabetiskt index."

#. from libreoffice:sw-messages
msgid "Apply to all other occurrences"
msgstr "Tillämpa på alla andra förekomster"

#. from libreoffice:sw-messages
msgid "Add an index entry to any other occurrences of the text selected into “Entry”."
msgstr "Lägg till en indexpost till alla andra förekomster av texten som valts i \"Post\"."

#. from libreoffice:sw-messages
msgid "Add an index entry to any other occurrences of the text selected into “Entry”. For a modified entry, the match is conducted on the original selection, but the modified entry is inserted, and will appear in the index."
msgstr "Lägg till en indexpost till alla andra förekomster av texten som valts i \"Post\". För en modifierad post utförs matchningen på det ursprungliga urvalet, men den ändrade posten infogas och kommer att visas i indexet."

#. from libreoffice:sw-messages
msgid "Next entry (same name)"
msgstr "Nästa post (samma namn)"

#. from libreoffice:sw-messages
msgid "Jumps to the next index entry of the same type and with the same name in the document."
msgstr "Hoppar till nästa indexpost av samma typ och med samma namn i dokumentet."

#. from libreoffice:sw-messages
msgid "Previous entry (same name)"
msgstr "Föregående post (samma namn)"

#. from libreoffice:sw-messages
msgid "Jumps to the previous index entry of the same type and with the same name in the document."
msgstr "Hoppar till föregående indexpost av samma typ och med samma namn i dokumentet."

#. from libreoffice:sw-messages
msgid "Previous entry"
msgstr "Föregående post"

#. from libreoffice:sw-messages
msgid "Jumps to the previous index entry of the same type in the document."
msgstr "Går till den föregående förteckningsposten av samma typ i dokumentet."

#. from libreoffice:sw-messages
msgid "Next entry"
msgstr "Nästa post"

#. from libreoffice:sw-messages
msgid "Jumps to the next index entry of the same type in the document."
msgstr "Går till den nästa förteckningsposten av samma typ i dokumentet."

#. from libreoffice:sw-messages
msgid "Marks the selected text as index or table of contents entry. Edits the selected index entry."
msgstr "Markerar den markerade texten som index eller innehållsförteckning. Redigerar den valda indexposten."

#. from libreoffice:sw-messages
msgid "Search key not found."
msgstr "Sökord hittades inte."

#. from libreoffice:sw-messages
msgid "Read-Only Content"
msgstr "Skrivskyddat innehåll"

#. from libreoffice:sw-messages
msgid "Write-protected content cannot be changed."
msgstr "Skrivskyddat innehåll kan inte ändras."

#. from libreoffice:sw-messages
msgid "No modifications will be accepted."
msgstr "Inga ändringar accepteras."

#. from libreoffice:sw-messages
msgid "Review Fields"
msgstr "Granska fält"

#. from libreoffice:sw-messages
msgid "_Previous"
msgstr "_Föregående"

#. from libreoffice:sw-messages
msgid "Jumps to the next input field in the document."
msgstr "Hoppar till nästa inmatningsfält i dokumentet."

#. from libreoffice:sw-messages
msgid "Reference:"
msgstr "Referens:"

#. from libreoffice:sw-messages
msgid "This box displays the name that you entered in the Reference box on the Functions or Variables tab of the Fields dialog. The box underneath displays the contents of the field."
msgstr "Den här rutan visar namnet som du angav i rutan Referens på fliken Funktioner eller Variabler i dialogrutan Fält. Rutan nedanför visar innehållet i fältet."

#. from libreoffice:sw-messages
msgid "Inserts a text field that you can open and edit by clicking it in the document."
msgstr "Infogar ett fältkommando som du kan öppna och redigera genom att klicka på det i dokumentet."

#. from libreoffice:sw-messages
msgid "Calculates the sum of the selected cells."
msgstr "Beräknar summan av de markerade cellerna."

#. from libreoffice:sw-messages
msgid "Rounds a number to the specified decimal places."
msgstr "Avrundar ett tal till angivna decimaler."

#. from libreoffice:sw-messages
msgid "Calculates the square root."
msgstr "Beräknar kvadratroten."

#. from libreoffice:sw-messages
msgid "Calculates the power of a number."
msgstr "Beräknar potensen av ett tal."

#. from libreoffice:sw-messages
msgid "List Separator"
msgstr "Skiljetecken för lista"

#. from libreoffice:sw-messages
msgid "Separates the elements in a list."
msgstr "Separerar elementen i en lista."

#. from libreoffice:sw-messages
msgid "Checks if selected values are equal."
msgstr "Kontrollerar om valda värden är lika."

#. from libreoffice:sw-messages
msgid "Not Equal"
msgstr "Inte lika med"

#. from libreoffice:sw-messages
msgid "Tests for inequality between selected values."
msgstr "Tester för ojämlikhet mellan valda värden."

#. from libreoffice:sw-messages
msgid "Less Than or Equal"
msgstr "Mindre än eller lika med"

#. from libreoffice:sw-messages
msgid "Tests for values less than or equal to a specified value."
msgstr "Testar för värden mindre än eller lika med ett angivet värde."

#. from libreoffice:sw-messages
msgid "Greater Than or Equal"
msgstr "Större än eller lika med"

#. from libreoffice:sw-messages
msgid "Tests for values greater than or equal to a specified value"
msgstr "Testar för värden större än eller lika med ett angivet värde"

#. from libreoffice:sw-messages
msgid "Less"
msgstr "Mindre än"

#. from libreoffice:sw-messages
msgid "Tests for values less than a specified value"
msgstr "Testar för värden mindre än ett angivet värde"

#. from libreoffice:sw-messages
msgid "Greater"
msgstr "Större än"

#. from libreoffice:sw-messages
msgid "Tests for values greater than a specified value"
msgstr "Testar för värden som är större än ett angivet värde"

#. from libreoffice:sw-messages
msgid "Boolean Or"
msgstr "Logiskt eller"

#. from libreoffice:sw-messages
msgid "Tests for values matching the Boolean OR"
msgstr "Testar för värden som matchar det booleska ELLER"

#. from libreoffice:sw-messages
msgid "Boolean Xor"
msgstr "Logiskt exklusivt eller"

#. from libreoffice:sw-messages
msgid "Tests for values matching the Boolean exclusive OR"
msgstr "Testar för värden som matchar det booleska exklusiva ELLER"

#. from libreoffice:sw-messages
msgid "Boolean And"
msgstr "Logiskt och"

#. from libreoffice:sw-messages
msgid "Tests for values matching the Boolean AND"
msgstr "Testar för värden som matchar det booleska OCH"

#. from libreoffice:sw-messages
msgid "Boolean Not"
msgstr "Logiskt inte"

#. from libreoffice:sw-messages
msgid "Tests for values matching the Boolean NOT"
msgstr "Testar för värden som matchar booleska NOT"

#. from libreoffice:sw-messages
msgid "You can insert various operators in your formula."
msgstr "Du kan infoga olika operatorer i din formel."

#. from libreoffice:sw-messages
msgid "Statistical Functions"
msgstr "Statistiska funktioner"

#. from libreoffice:sw-messages
msgid "Calculates the arithmetic mean of the values in an area or a list."
msgstr "Beräknar det aritmetiska medelvärdet av värdena i ett område eller en lista."

#. from libreoffice:sw-messages
msgid "Calculates the minimum value in an area or a list."
msgstr "Beräknar minimivärdet i ett område eller en lista."

#. from libreoffice:sw-messages
msgid "Calculates the maximum value in an area or a list."
msgstr "Beräknar det maximala värdet i ett område eller en lista."

#. from libreoffice:sw-messages
msgid "You can choose from the following statistical functions:"
msgstr "Du kan välja mellan följande statistiska funktioner:"

#. from libreoffice:sw-messages
msgid "Calculates the sine in radians"
msgstr "Beräknar sinus i radianer"

#. from libreoffice:sw-messages
msgid "Calculates the cosine in radians."
msgstr "Beräknar cosinus i radianer."

#. from libreoffice:sw-messages
msgid "Calculates the tangent in radians."
msgstr "Beräknar tangenten i radianer."

#. from libreoffice:sw-messages
msgid "Calculates the arc sine in radians."
msgstr "Beräknar arcussinus i radianer"

#. from libreoffice:sw-messages
msgid "Calculates the arc cosine in radians."
msgstr "Beräknar arcuscosinus i radianer."

#. from libreoffice:sw-messages
msgid "Calculates the arc tangent in radians."
msgstr "Beräknar arcustangenten i radianer."

#. from libreoffice:sw-messages
msgid "Abs"
msgstr "Abs"

#. from libreoffice:sw-messages
msgid "Int"
msgstr "Int"

#. from libreoffice:sw-messages
msgid "You can choose from the following trigonometric functions:"
msgstr "Du kan välja mellan följande trigonometriska funktioner:"

#. from libreoffice:sw-messages
msgid "Insert AutoText"
msgstr "Infoga autotext"

#. from libreoffice:sw-messages
msgid "Autotexts for Shortcut "
msgstr "Autotexter till förkortningen "

#. from libreoffice:sw-messages
msgid "Type the name of the bookmark that you want to create. Then press Insert."
msgstr "Skriv namnet på bokmärket som du vill skapa. Tryck sedan på Infoga."

#. from libreoffice:sw-messages
msgid "_Bookmarks:"
msgstr "_Bokmärken:"

#. from libreoffice:sw-messages
msgid "To delete a bookmark, select the bookmark and click the Delete button. No confirmation dialog will follow."
msgstr "För att ta bort ett bokmärke, välj bokmärket och klicka på knappen Ta bort. Ingen bekräftelsedialog kommer att följa."

#. from libreoffice:sw-messages
msgid "Edit Text"
msgstr "Redigera text"

#. from libreoffice:sw-messages
msgid "Inserts a bookmark at the cursor position. You can then use the Navigator to quickly jump to the marked location at a later time."
msgstr "Infogar ett bokmärke vid markörens position. Du kan sedan använda navigatorn för att snabbt hoppa till den markerade platsen vid ett senare tillfälle."

#. from libreoffice:sw-messages
msgid "Insert Break"
msgstr "Infoga brytning"

#. from libreoffice:sw-messages
msgid "Line break"
msgstr "Radbrytning"

#. from libreoffice:sw-messages
msgid "Ends the current line, and moves the text found to the right of the cursor to the next line, without creating a new paragraph."
msgstr "Avslutar aktuell rad, och flyttar texten till höger om markören till nästa rad, utan att skapa ett nytt stycke."

#. from libreoffice:sw-messages
msgid "Restart Location:"
msgstr "Ny startposition:"

#. from libreoffice:sw-messages
msgid "Next Line"
msgstr "Nästa rad"

#. from libreoffice:sw-messages
msgid "Next Full Line"
msgstr "Nästa hela rad"

#. from libreoffice:sw-messages
msgid "Column break"
msgstr "Kolumnbrytning"

#. from libreoffice:sw-messages
msgid "Inserts a manual column break (in a multiple column layout), and moves the text found to the right of the cursor to the beginning of the next column. A manual column break is indicated by a nonprinting border at the top of the new column."
msgstr "Infogar en manuell kolumnbrytning (i en flerkolumnlayout) och flyttar texten till höger om markören till början av nästa kolumn. En manuell kolumnbrytning indikeras av en kantlinje överst i den nya spalten. Kantlinjen syns inte när du skriver ut dokumentet."

#. from libreoffice:sw-messages
msgid "Inserts a manual page break, and moves the text found to the right of the cursor to the beginning of the next page. The inserted page break is indicated by a nonprinting border at the top of the new page."
msgstr "Infogar en manuell sidbrytning och flyttar texten till höger om markören till början av nästa sida. En manuell sidbrytning indikeras av en kantlinje högst upp på den nya sidan. Kantlinjen syns inte när du skriver ut dokumentet."

#. from libreoffice:sw-messages
msgid "Page Style:"
msgstr "Sidoformatmall:"

#. from libreoffice:sw-messages
msgid "Select the page style for the page that follows the manual page break."
msgstr "Ange sidformatmallen för sidan som följer den manuella sidbrytningen."

#. from libreoffice:sw-messages
msgid "Change page number"
msgstr "Ändra sidnummer"

#. from libreoffice:sw-messages
msgid "Enter the new page number for the page that follows the manual page break."
msgstr "Ange det nya sidnumret för sidan som följer den manuella sidbrytningen."

#. from libreoffice:sw-messages
msgid "Inserts a manual line break, column break or a page break at the current cursor position."
msgstr "Infogar en manuell radbrytning, kolumnbrytning eller sidbrytning vid den position där markören står."

#. from libreoffice:sw-messages
msgid "Auto..."
msgstr "Auto..."

#. from libreoffice:sw-messages
msgid "Numbering:"
msgstr "Numrering:"

#. from libreoffice:sw-messages
msgid "Select the type of numbering that you want to use in the caption."
msgstr "Välj vilken typ av numrering som du vill använda i bildtexten."

#. from libreoffice:sw-messages
msgid "Enter optional text characters to appear after the caption category and number and before the caption text."
msgstr "Ange valfria texttecken som ska visas efter bildtextkategorin och numret och före bildtexten."

#. from libreoffice:sw-messages
msgid ": "
msgstr ": "

#. from libreoffice:sw-messages
msgid "Enter optional text characters to appear after the caption category and number and before the caption text. The optional text characters are not inserted if no caption text is given."
msgstr "Ange valfria texttecken som ska visas efter bildtextkategorin och numret och före bildtexten. De valfria texttecknen infogas inte om ingen bildtext anges."

#. from libreoffice:sw-messages
msgid "When “Caption order” (in Options) is “Numbering first”, enter optional text to appear after caption number."
msgstr "När \"Ordningsföljd\" (i alternativ) är \"Numrering först\", ange valfri text som ska visas efter bildtextnumret."

#. from libreoffice:sw-messages
msgid "Enter optional text to appear after the caption number. Only available when “Numbering first” is selected for “Caption order” in Options."
msgstr "Ange valfri text som ska visas efter bildtextnumret. Endast tillgängligt när \"Numrering först\" är valt för \"Ordningsföljd\" i alternativ."

#. from libreoffice:sw-messages
msgid "Adds the caption above or below the selected item. This option is only available for some objects."
msgstr "Lägger till bildtexten över eller under det markerade objektet. Det här alternativet är bara tillgängligt för vissa objekt."

#. from libreoffice:sw-messages
msgid "Select the caption category, or type a name to create a new category. The category text appears before the caption number in the caption label. Each predefined caption category is formatted with a paragraph style of the same name."
msgstr "Välj typ av bildtext, eller skriv ett namn för att skapa en ny kategori. Kategoritexten visas före bildtextens nummer i bildtexten. Varje fördefinierad bildtextkategori är formaterad med styckeformatmallen med samma namn."

#. from libreoffice:sw-messages
msgid "Adds a numbered caption to a selected image, table, chart, frame, or shape."
msgstr "Lägger till en numrerad bildtext till en vald bild, tabell, diagram, ram eller form."

#. from libreoffice:sw-messages
msgid "Insert Database Columns"
msgstr "Infoga databaskolumner"

#. from libreoffice:sw-messages
msgid "Insert data as:"
msgstr "Infoga data som:"

#. from libreoffice:sw-messages
msgid "Inserts data selected from the data source browser into the document as a table."
msgstr "Infogar data från datakällvyn som en tabell i dokumentet."

#. from libreoffice:sw-messages
msgid "Inserts data selected from the data source browser into the document as fields."
msgstr "Infogar data från datakällvyn som fält i dokumentet."

#. from libreoffice:sw-messages
msgid "Inserts data selected from the data source browser into the document as text."
msgstr "Infogar data från datakällvyn som text i dokumentet."

#. from libreoffice:sw-messages
msgid "Database _columns"
msgstr "Databaskolumner"

#. from libreoffice:sw-messages
msgid "Tab_le column(s)"
msgstr "Tabellkolumn(er)"

#. from libreoffice:sw-messages
msgid "Moves all listed database fields into the Table column(s) list box."
msgstr "Flyttar alla databasfält till listrutan Tabellkolumn(er)."

#. from libreoffice:sw-messages
msgid "Moves the selected database field into the Table column(s) list box."
msgstr "Flyttar det markerade databasfältet till listrutan Tabellkolumn(er)."

#. from libreoffice:sw-messages
msgid "Moves the fields that you selected in the Database columns list box into the selection field."
msgstr "Flyttar de markerade fälten i listrutan Databaskolumner till urvalsfältet."

#. from libreoffice:sw-messages
msgid "Removes the selected database field from the Table column(s) list box"
msgstr "Tar bort det markerade databasfältet från listrutan Tabellkolumn(er)."

#. from libreoffice:sw-messages
msgid "Removes all database fields from the Table column(s) list box."
msgstr "Tar bort alla databasfält från listrutan Tabellkolumn(er)."

#. from libreoffice:sw-messages
msgid "Lists all database columns to be inserted into the document."
msgstr "Visar alla databaskolumner som ska infogas i dokumentet."

#. from libreoffice:sw-messages
msgid "Lists the database columns that you selected to be inserted into the document. You can also enter text here. This text will be also inserted into the document."
msgstr "Visar vilka databaskolumner som kommer att infogas i dokumentet. Du kan också skriva in text här. Texten kommer också att infogas i dokumentet."

#. from libreoffice:sw-messages
msgid "Specifies the database columns to be inserted into the text table."
msgstr "Anger vilka databaskolumner som ska infogas i texttabellen."

#. from libreoffice:sw-messages
msgid "Select the database columns that you want to insert in the document."
msgstr "Välj de databaskolumner som du vill infoga i dokumentet."

#. from libreoffice:sw-messages
msgid "Insert table heading"
msgstr "Infoga tabellrubrik"

#. from libreoffice:sw-messages
msgid "Specifies whether to insert a heading line for the columns in the text table."
msgstr "Anger om en rubrikrad för kolumnerna ska infogas i texttabellen."

#. from libreoffice:sw-messages
msgid "Apply column _name"
msgstr "Använd kolumnnamn"

#. from libreoffice:sw-messages
msgid "Uses the field names of the database table as headings for each of the text table columns."
msgstr "Använder fältnamnen i databastabellen som rubriker för varje texttabellkolumn."

#. from libreoffice:sw-messages
msgid "Create row only"
msgstr "Skapa bara rad"

#. from libreoffice:sw-messages
msgid "Inserts an empty heading line into the text table."
msgstr "Infogar en tom rad överst i texttabellen."

#. from libreoffice:sw-messages
msgid "Opens the Table Format dialog, which enables you to define the table properties such as borders, background, and column width."
msgstr "Öppnar dialogrutan Tabellformat som du använder för att definiera tabellens egenskaper, t.ex. ramar, bakgrund och kolumnbredd."

#. from libreoffice:sw-messages
msgid "Aut_oFormat..."
msgstr "Autoformat..."

#. from libreoffice:sw-messages
msgid "Opens the AutoFormat dialog, in which you can select format styles that are immediately applied when inserting the table."
msgstr "Öppnar dialogrutan Autoformat som du använder för att välja den formatmall som ska användas när tabellen infogas."

#. from libreoffice:sw-messages
msgid "Paragraph _style:"
msgstr "Styckeformatmall:"

#. from libreoffice:sw-messages
msgid "This is where you can select other Paragraph Styles to apply to the paragraph you want to insert into the document."
msgstr "Här kan du välja andra styckeformatmallar som ska användas i det stycke som kommer att infogas i dokumentet."

#. from libreoffice:sw-messages
msgid "From _database"
msgstr "Från databas"

#. from libreoffice:sw-messages
msgid "Accepts the database formats."
msgstr "Godkänner databasformaten."

#. from libreoffice:sw-messages
msgid "Specifies a format from the list, if the format information of certain data fields is not accepted."
msgstr "Anger ett format från listan, om vissa datafälts formatinformation inte accepteras."

#. from libreoffice:sw-messages
msgid "Insert Footnote/Endnote"
msgstr "Infoga fot-/slutnot"

#. from libreoffice:sw-messages
msgid "Previous footnote/endnote"
msgstr "Föregående fot-/slutnot"

#. from libreoffice:sw-messages
msgid "Moves to the previous footnote or endnote anchor in the document."
msgstr "Går till föregående fotnot eller slutnot i dokumentet."

#. from libreoffice:sw-messages
msgid "Next footnote/endnote"
msgstr "Nästa fot-/slutnot"

#. from libreoffice:sw-messages
msgid "Moves to the next footnote or endnote anchor in the document."
msgstr "Går till nästa fotnot eller slutnot i dokumentet."

#. from libreoffice:sw-messages
msgid "Automatically assigns consecutive numbers to the footnotes or endnotes that you insert."
msgstr "Numrerar automatiskt de fotnoter eller slutnoter som du infogar."

#. from libreoffice:sw-messages
msgid "Choose this option to define a character or symbol for the current footnote."
msgstr "Välj det här alternativet för att definiera ett tecken eller symbol för den aktuella fotnoten."

#. from libreoffice:sw-messages
msgid "Choose…"
msgstr "Välj…"

#. from libreoffice:sw-messages
msgid "Inserts a special character as a footnote or endnote anchor."
msgstr "Infogar ett specialtecken som förankringspunkt för en fotnot eller slutnot."

#. from libreoffice:sw-messages
msgid "Inserts a footnote anchor at the current cursor position in the document, and adds a footnote to the bottom of the page."
msgstr "Infogar en förankringspunkt för en fotnot på den plats där markören står i dokumentet och lägger till en fotnot längst ned på sidan."

#. from libreoffice:sw-messages
msgid "Inserts an endnote anchor at the current cursor position in the document, and adds an endnote at the end of the document."
msgstr "Infogar en förankringspunkt för en slutnot på den plats där markören står i dokumentet och lägger till en slutnot i slutet av dokumentet."

#. from libreoffice:sw-messages
msgid "Inserts a footnote or an endnote in the document. The anchor for the note is inserted at the current cursor position."
msgstr "Infogar en fotnot eller en slutnot i dokumentet. Ankaret för noten infogas vid den aktuella markörpositionen."

#. from libreoffice:sw-messages
msgid "Insert Script"
msgstr "Infoga skript"

#. from libreoffice:sw-messages
msgid "Jump to Previous Script."
msgstr "Hoppa till föregående skript."

#. from libreoffice:sw-messages
msgid "Jump to Next Script."
msgstr "Hoppa till nästa skript."

#. from libreoffice:sw-messages
msgid "Script type:"
msgstr "Skripttyp:"

#. from libreoffice:sw-messages
msgid "Enter the type of script that you want to insert."
msgstr "Ange vilken typ av skript du vill infoga."

#. from libreoffice:sw-messages
msgid "Adds a link to a script file. Click the URL radio button, and then enter the link in the box. You can also click the Browse button, locate the file, and then click Insert."
msgstr "Lägger till en länk till en skriptfil. Klicka på alternativfältet URL och ange sedan länken i rutan. Du kan också klicka på bläddringsknappen (...), leta rätt på filen och sedan klicka på Infoga."

#. from libreoffice:sw-messages
msgid "Browse…"
msgstr "Bläddra…"

#. from libreoffice:sw-messages
msgid "Locate the script file that you want to link to, and then click Insert."
msgstr "Leta rätt på den skriptfil du vill länka till och klicka sedan på Infoga."

#. from libreoffice:sw-messages
msgid "Enter the script code that you want to insert."
msgstr "Ange den skriptkod du vill infoga."

#. from libreoffice:sw-messages
msgid "Inserts a script at the current cursor position in an HTML or text document."
msgstr "Infogar ett skript där markören finns i ett HTML- eller textdokument."

#. from libreoffice:sw-messages
msgid "Insert Section"
msgstr "Infoga område"

#. from libreoffice:sw-messages
msgid "Enter a name for the table."
msgstr "Ange ett namn till tabellen."

#. from libreoffice:sw-messages
msgid "Enter the number of columns that you want in the table."
msgstr "Ange det antal kolumner som ska finnas i tabellen."

#. from libreoffice:sw-messages
msgid "_Rows:"
msgstr "_Rader:"

#. from libreoffice:sw-messages
msgid "Enter the number of rows that you want in the table."
msgstr "Ange det antal rader som ska finnas i tabellen."

#. from libreoffice:sw-messages
msgid "Warning : Large tables may adversely affect performance and compatibility"
msgstr "Varning: Stora tabeller kan påverka prestanda och kompatibilitet negativt"

#. from libreoffice:sw-messages
msgid "Hea_ding"
msgstr "_Rubrik"

#. from libreoffice:sw-messages
msgid "Includes a heading row in the table."
msgstr "Inkludera en rubrikrad i tabellen."

#. from libreoffice:sw-messages
msgid "Repeat heading rows on new _pages"
msgstr "Upprepa rubrikrader på nya _sidor"

#. from libreoffice:sw-messages
msgid "Repeats the heading of the table at the top of subsequent page if the table spans more than one page."
msgstr "Upprepar tabellrubriken överst på följande sida om tabellen sträcker sig över fler än en sida."

#. from libreoffice:sw-messages
msgid "Don’t _split table over pages"
msgstr "Dela inte tabeller över sidor"

#. from libreoffice:sw-messages
msgid "Prevents the table from spanning more than one page."
msgstr "Förhindrar tabellen från att dela sig vid en sidbrytning."

#. from libreoffice:sw-messages
msgid "Select the number of rows that you want to use for the heading."
msgstr "Ange hur många rader som ska användas som rubrikrader."

#. from libreoffice:sw-messages
msgid "Heading ro_ws:"
msgstr "Rubrikrader:"

#. from libreoffice:sw-messages
msgid "Select a predefined style for the new table."
msgstr "Välj en fördefinierad formatmall för den nya tabellen."

#. from libreoffice:sw-messages
msgid "Inserts a table into the document. You can also click the arrow, drag to select the number of rows and columns to include in the table, and then click in the last cell."
msgstr "Infogar en tabell i dokumentet. Du kan också klicka på pilen, dra för att välja antalet rader och kolumner som ska inkluderas i tabellen och sedan klicka i den sista cellen."

#. from libreoffice:sw-messages
msgid "_New Document"
msgstr "Nytt dokument"

#. from libreoffice:sw-messages
msgid "Creates a new document for editing."
msgstr "Skapar ett nytt dokument som kan redigeras."

#. from libreoffice:sw-messages
msgid "Allows you to create labels. Labels are created in a text document."
msgstr "Låter dig skapa etiketter. Etiketter skapas i ett textdokument."

#. from libreoffice:sw-messages
msgid "Hori_zontal pitch:"
msgstr "Horisontellt avstånd:"

#. from libreoffice:sw-messages
msgid "Displays the distance between the left edges of adjacent labels or business cards. If you are defining a custom format, enter a value here."
msgstr "Visar avståndet mellan vänsterkanterna av intilliggande etiketter eller visitkort. Om du definierar ett eget format anger du ett värde här."

#. from libreoffice:sw-messages
msgid "_Vertical pitch:"
msgstr "Vertikalt avstånd:"

#. from libreoffice:sw-messages
msgid "Displays the distance between the upper edge of a label or a business card and the upper edge of the label or the business card directly below. If you are defining a custom format, enter a value here."
msgstr "Visar avståndet mellan den övre kanten av en etikett eller ett visitkort och den övre kanten av etiketten eller visitkortet nedanför. Om du definierar ett eget format anger du ett värde här."

#. from libreoffice:sw-messages
msgid "Displays the width for the label or the business card. If you are defining a custom format, enter a value here."
msgstr "Visar bredden på etiketten eller visitkortet. Om du definierar ett eget format anger du ett värde här."

#. from libreoffice:sw-messages
msgid "Displays the height for the label or business card. If you are defining a custom format, enter a value here."
msgstr "Visar höjden på etiketten eller visitkortet. Om du definierar ett eget format anger du ett värde här."

#. from libreoffice:sw-messages
msgid "Displays the distance from the left edge of the page to the left edge of the first label or business card. If you are defining a custom format, enter a value here."
msgstr "Visar avståndet mellan överkanterna av intilliggande etiketter eller visitkort. Om du definierar ett eget format anger du ett värde här."

#. from libreoffice:sw-messages
msgid "_Top margin:"
msgstr "Övre marginal:"

#. from libreoffice:sw-messages
msgid "Displays distance from the top edge of the page to the top of the first label or business card. If you are defining a custom format, enter a value here."
msgstr "Visar avståndet från den översta kanten av sidan till den översta kanten av den första etiketten eller visitkortet. Om du definierar ett eget format anger du ett värde här."

#. from libreoffice:sw-messages
msgid "_Columns:"
msgstr "_Kolumner:"

#. from libreoffice:sw-messages
msgid "Enter the number of labels or business cards that you want to span the width of the page."
msgstr "Ange hur många etiketter eller visitkort som ska placeras bredvid varandra i bredd på sidan."

#. from libreoffice:sw-messages
msgid "R_ows:"
msgstr "Rader:"

#. from libreoffice:sw-messages
msgid "Enter the number of labels or business cards that you want to span the height of the page."
msgstr "Ange hur många etiketter eller visitkort som ska placeras ovanpå varandra i sidans höjd."

#. from libreoffice:sw-messages
msgid "P_age width:"
msgstr "Sidbredd:"

#. from libreoffice:sw-messages
msgid "Pa_ge height:"
msgstr "Sidhöjd:"

#. from libreoffice:sw-messages
msgid "Saves the current label or business card format."
msgstr "Sparar det aktuella etikett- eller visitkortsformatet."

#. from libreoffice:sw-messages
msgid "Set paper formatting options."
msgstr "Ange alternativ för pappersformat."

#. from libreoffice:sw-messages
msgid "_Entire page"
msgstr "Hela sidan"

#. from libreoffice:sw-messages
msgid "Creates a full page of labels or business cards."
msgstr "Skapar en hel sida med etiketter eller visitkort."

#. from libreoffice:sw-messages
msgid "_Single label"
msgstr "Enstaka etikett"

#. from libreoffice:sw-messages
msgid "Prints a single label or business card on a page."
msgstr "Skriver ut en enda etikett eller visitkort på en sida."

#. from libreoffice:sw-messages
msgid "Colu_mn"
msgstr "Kolumn"

#. from libreoffice:sw-messages
msgid "Select the column in which you want to place your single label or business card."
msgstr "Välj den kolumn där du vill placera din enda etikett eller visitkort."

#. from libreoffice:sw-messages
msgid "Ro_w"
msgstr "Rad"

#. from libreoffice:sw-messages
msgid "Select the row in which you want to place your single label or business card."
msgstr "Välj den rad där du vill placera din enda etikett eller visitkort."

#. from libreoffice:sw-messages
msgid "Synchroni_ze contents"
msgstr "Synkronisera innehåll"

#. from libreoffice:sw-messages
msgid "Allows you to edit a single label or business card and updates the contents of the remaining labels or business cards on the page when you click the Synchronize Labels button."
