msgstr "Inloggningsinformation för Internet (lösenordet visas aldrig)"

#. from libreoffice:cui-messages
msgid "Website"
msgstr "Webbplats"

#. from libreoffice:cui-messages
msgid "User name"
msgstr "Användarnamn"

#. from libreoffice:cui-messages
msgid "Remove _All"
msgstr "Ta bort alla"

#. from libreoffice:cui-messages
msgid "_Change Password..."
msgstr "_Ändra lösenord..."

#. from libreoffice:cui-messages
msgid "Keep ratio"
msgstr "Anpassa proportionellt"

#. from libreoffice:cui-messages
msgid "Keep Ratio"
msgstr "Anpassa proportionellt"

