#. from libreoffice:scalc-01
msgid "<bookmark_value>ISOWEEKNUM function</bookmark_value>"
msgstr "<bookmark_value>VECKONR</bookmark_value>"

#. from libreoffice:scalc-01
msgid "<variable id=\"isoweeknum\"><link href=\"text/scalc/01/func_isoweeknum.xhp\">ISOWEEKNUM</link></variable>"
msgstr "<variable id=\"weeknum\"><link href=\"text/scalc/01/func_weeknum.xhp\">VECKONR</link></variable>"

#. from libreoffice:scalc-01
msgid "<ahelp hid=\"HID_FUNC_ISOWEEKNUM\">ISOWEEKNUM calculates the week number of the year for the internal date value.</ahelp>"
msgstr "<ahelp hid=\"HID_FUNC_KALENDERWOCHE\">VECKONR beräknar veckonumret i året för det interna datumvärdet.</ahelp>"

#. from libreoffice:scalc-01
msgid "The International Standard ISO 8601 has decreed that Monday shall be the first day of the week. A week that lies partly in one year and partly in another is assigned a number in the year in which most of its days lie. That means that week number 1 of any year is the week that contains the January 4th."
msgstr "Enligt den internationella ISO-standarden ISO 8601 ska måndag räknas som veckans första dag. En vecka som sträcker sig över ett årsskifte  tilldelas ett nummer i det år då merparten av veckans dagar infaller. Det innebär att vecka 1 ett givet år alltid är den vecka då den 4 januari infaller."

#. from libreoffice:scalc-01
msgid "<bookmark_value>MINUTE function</bookmark_value>"
msgstr "<bookmark_value>MINUT, funktion </bookmark_value>"

#. from libreoffice:scalc-01
msgid "<variable id=\"minute\"><link href=\"text/scalc/01/func_minute.xhp\">MINUTE</link></variable>"
msgstr "<variable id=\"minute\"><link href=\"text/scalc/01/func_minute.xhp\">MINUT</link></variable>"

#. from libreoffice:scalc-01
msgid "<ahelp hid=\"HID_FUNC_MINUTE\">Calculates the minute for an internal time value.</ahelp> The minute is returned as a number between 0 and 59."
msgstr "<ahelp hid=\"HID_FUNC_MINUTE\">Beräknar minuten för ett internt tidsvärde.</ahelp> Minuten returneras som ett tal mellan 0 och 59."

#. from libreoffice:scalc-01
msgid "MINUTE(Number)"
msgstr "MINUT(tal)"

#. from libreoffice:scalc-01
msgid "<emph>Number</emph>, as a time value, is a decimal number where the number of the minute is to be returned."
msgstr "<emph>tal</emph> är som tidvärde ett decimaltal för vilket antal minuter ska beräknas."

#. from libreoffice:scalc-01
msgid "<item type=\"input\">=MINUTE(8.999)</item> returns 58"
msgstr "<item type=\"input\">=MINUT(8,999)</item> returnerar 58"

#. from libreoffice:scalc-01
msgid "<item type=\"input\">=MINUTE(8.9999)</item> returns 59"
msgstr "<item type=\"input\">=MINUT(8,9999)</item> returnerar 59"

#. from libreoffice:scalc-01
msgid "<item type=\"input\">=MINUTE(NOW())</item> returns the current minute value."
msgstr "<item type=\"input\">=MINUT(NU())</item> returnerar det aktuella minutvärdet."

#. from libreoffice:scalc-01
msgid "<bookmark_value>MONTH function</bookmark_value>"
msgstr "<bookmark_value>MÅNAD, funktion </bookmark_value>"

#. from libreoffice:scalc-01
msgid "<variable id=\"month\"><link href=\"text/scalc/01/func_month.xhp\">MONTH</link></variable>"
msgstr "<variable id=\"month\"><link href=\"text/scalc/01/func_month.xhp\">MÅNAD</link></variable>"

#. from libreoffice:scalc-01
msgid "<ahelp hid=\"HID_FUNC_MONAT\">Returns the month for the given date value.</ahelp> The month is returned as an integer between 1 and 12."
msgstr "<ahelp hid=\"HID_FUNC_MONAT\">Returnerar månaden för ett givet datumvärde.</ahelp> Månaden returneras som ett heltal mellan 1 och 12."

#. from libreoffice:scalc-01
msgid "MONTH(Number)"
msgstr "MÅNAD(tal)"

#. from libreoffice:scalc-01
msgid "<bookmark_value>NOW function</bookmark_value>"
msgstr "<bookmark_value>NU, funktion </bookmark_value>"

#. from libreoffice:scalc-01
msgid "<variable id=\"now\"><link href=\"text/scalc/01/func_now.xhp\">NOW</link></variable>"
msgstr "<variable id=\"now\"><link href=\"text/scalc/01/func_now.xhp\">NU</link></variable>"

#. from libreoffice:scalc-01
msgid "<ahelp hid=\"HID_FUNC_JETZT\">Returns the computer system date and time.</ahelp> The value is updated when you recalculate the document or each time a cell value is modified."
msgstr "<ahelp hid=\"HID_FUNC_JETZT\">Returnerar datorns systemdatum och -tid.</ahelp> Värdet uppdateras när du räknar om dokumentet eller varje gång ett cellvärde ändras."

#. from libreoffice:scalc-01
msgid "NOW()"
msgstr "NU()"

#. from libreoffice:scalc-01
msgid "NOW is a function without arguments."
msgstr "NOW är en funktion utan argument."

#. from libreoffice:scalc-01
msgid "<item type=\"input\">=NOW()-A1</item> returns the difference between the date in A1 and now. Format the result as a number."
msgstr "<item type=\"input\">=NU()-A1</item> returnerar skillnaden mellan datumet i A1 och dagens datum. Formatera resultatet som ett tal."

#. from libreoffice:scalc-01
msgid "<bookmark_value>NUMBERVALUE function</bookmark_value>"
msgstr "<bookmark_value>TIDVÄRDE, funktion </bookmark_value>"

#. from libreoffice:scalc-01
msgid "<bookmark_value>SECOND function</bookmark_value>"
msgstr "<bookmark_value>SEKUND, funktion </bookmark_value>"

#. from libreoffice:scalc-01
msgid "<variable id=\"second\"><link href=\"text/scalc/01/func_second.xhp\">SECOND</link></variable>"
msgstr "<variable id=\"second\"><link href=\"text/scalc/01/func_second.xhp\">SEKUND</link></variable>"

#. from libreoffice:scalc-01
msgid "<ahelp hid=\"HID_FUNC_SEKUNDE\">Returns the second for the given time value.</ahelp> The second is given as an integer between 0 and 59."
msgstr "<ahelp hid=\"HID_FUNC_SEKUNDE\">Returnerar sekunden för ett givet tidsvärde.</ahelp> Sekunden returneras som ett heltal mellan 0 och 59."

#. from libreoffice:scalc-01
msgid "SECOND(Number)"
msgstr "SEKUND(tal)"

#. from libreoffice:scalc-01
msgid "<emph>Number</emph>, as a time value, is a decimal, for which the second is to be returned."
msgstr "<emph>tal</emph> är som tidvärde ett decimaltal för vilket sekunden ska beräknas."

#. from libreoffice:scalc-01
msgid "<item type=\"input\">=SECOND(NOW())</item> returns the current second"
msgstr "<item type=\"input\">=SEKUND(NU())</item> returnerar innevarande sekund"

#. from libreoffice:scalc-01
msgid "<item type=\"input\">=SECOND(C4)</item> returns 17 if contents of C4 = <item type=\"input\">12:20:17</item>."
msgstr "<item type=\"input\">=SEKUND(C4)</item> returnerar 17 om innehållet i C4 = <item type=\"input\">12:20:17</item>."

#. from libreoffice:scalc-01
msgid "<bookmark_value>skewness;population</bookmark_value>  <bookmark_value>SKEWP function</bookmark_value>"
msgstr "<bookmark_value>NORMFÖRD, funktion</bookmark_value><bookmark_value>Täthetsfunktion</bookmark_value>"

#. from libreoffice:scalc-01
msgid "<variable id=\"skewp_head\"><link href=\"text/scalc/01/func_skewp.xhp\">SKEWP</link></variable>"
msgstr "<variable id=\"year\"><link href=\"text/scalc/01/func_year.xhp\">ÅR</link></variable>"

#. from libreoffice:scalc-01
msgid "<bookmark_value>SUMIFS function</bookmark_value>  <bookmark_value>sum;satisfying conditions</bookmark_value>"
msgstr "<bookmark_value>FAKULTET, funktion</bookmark_value><bookmark_value>antalet kombinationer</bookmark_value>"

#. from libreoffice:scalc-01
msgid "<item type=\"input\">=SUMIFS(B2:B6;B2:B6;\">=20\")</item>"
msgstr "<item type=\"input\">=MEDEL (A1:A50)</item>"

#. from libreoffice:scalc-01
msgid "<item type=\"input\">=SUMIFS(C2:C6;B2:B6;\">=20\";C2:C6;\">70\")</item>"
msgstr "<item type=\"input\">=MEDEL (A1:A50)</item>"

#. from libreoffice:scalc-01
msgid "<bookmark_value>TIME function</bookmark_value>"
msgstr "<bookmark_value>KLOCKSLAG, funktion </bookmark_value>"

#. from libreoffice:scalc-01
msgid "<variable id=\"time\"><link href=\"text/scalc/01/func_time.xhp\">TIME</link></variable>"
msgstr "<variable id=\"time\"><link href=\"text/scalc/01/func_time.xhp\">KLOCKSLAG</link></variable>"

#. from libreoffice:scalc-01
msgid "<ahelp hid=\"HID_FUNC_ZEIT\">TIME returns the current time value from values for hours, minutes and seconds.</ahelp> This function can be used to convert a time based on these three elements to a decimal time value."
msgstr "<ahelp hid=\"HID_FUNC_ZEIT\">KLOCKSLAG returnerar det aktuella tidsvärdet från värden för timmar, minuter och sekunder.</ahelp> Den här funktionen kan användas för att konvertera en tid baserat på dessa tre element till ett decimalt tidsvärde."

#. from libreoffice:scalc-01
msgid "TIME(Hour; Minute; Second)"
msgstr "KLOCKSLAG (Timme; Minut; Sekund)"

#. from libreoffice:scalc-01
msgid "Use an integer to set the <emph>Hour</emph>."
msgstr "Använd ett heltal när du ställer in <emph>Timme</emph>."

#. from libreoffice:scalc-01
msgid "Use an integer to set the <emph>Minute</emph>."
msgstr "Använd ett heltal när du ställer in <emph>Minut</emph>."

#. from libreoffice:scalc-01
msgid "Use an integer to set the <emph>Second</emph>."
msgstr "Använd ett heltal när du ställer in <emph>Sekund</emph>."

#. from libreoffice:scalc-01
msgid "<item type=\"input\">=TIME(0;0;0)</item> returns 00:00:00"
msgstr "<item type=\"input\">=KLOCKSLAG(0;0;0)</item> returnerar 00:00:00"

#. from libreoffice:scalc-01
msgid "<item type=\"input\">=TIME(4;20;4)</item> returns 04:20:04"
msgstr "<item type=\"input\">=KLOCKSLAG(4;20;4)</item> returnerar 04:20:04"

#. from libreoffice:scalc-01
msgid "<bookmark_value>TIMEVALUE function</bookmark_value>"
msgstr "<bookmark_value>TIDVÄRDE, funktion </bookmark_value>"

#. from libreoffice:scalc-01
msgid "<variable id=\"timevalue\"><link href=\"text/scalc/01/func_timevalue.xhp\">TIMEVALUE</link></variable>"
msgstr "<variable id=\"timevalue\"><link href=\"text/scalc/01/func_timevalue.xhp\">TIDVÄRDE</link></variable>"

#. from libreoffice:scalc-01
msgid "<ahelp hid=\"HID_FUNC_ZEITWERT\">TIMEVALUE returns the internal time number from a text enclosed by quotes and which may show a possible time entry format.</ahelp>"
msgstr "<ahelp hid=\"HID_FUNC_ZEITWERT\">TIDVÄRDE returnerar det interna tidstalet från en text som omsluts med citattecken och som kan visa ett möjligt tidsformat.</ahelp>"

#. from libreoffice:scalc-01
msgid "The internal number indicated as a decimal is the result of the date system used under $[officename] to calculate date entries."
msgstr "Det interna talet, som anges som ett decimaltal, är ett resultat av det datumsystem som används i $[officename] för beräkning av datumuppgifter."

#. from libreoffice:scalc-01
msgid "If the text string also includes a year, month, or day, TIMEVALUE only returns the fractional part of the conversion."
msgstr "Om textsträngen också innehåller ett år, en månad eller en dag så returnerar TIDVÄRDE endast bråkdelen av konverteringen."

#. from libreoffice:scalc-01
msgid "TIMEVALUE(\"Text\")"
msgstr "TIDVÄRDE(\"text\")"

#. from libreoffice:scalc-01
msgid "<emph>Text</emph> is a valid time expression and must be entered in quotation marks."
msgstr "<emph>Text</emph> är ett giltigt tidsuttryck som ska anges inom citattecken."

#. from libreoffice:scalc-01
msgid "<item type=\"input\">=TIMEVALUE(\"4PM\")</item> returns 0.67. When formatting in time format HH:MM:SS, you then get 16:00:00."
msgstr "<item type=\"input\">=TIDVÄRDE(\"4PM\")</item> returnerar 0,67. Om du använder tidsformatet TT:MM:SS får du då resultatet 16:00:00."

#. from libreoffice:scalc-01
msgid "<item type=\"input\">=TIMEVALUE(\"24:00\")</item> returns 0. If you use the HH:MM:SS time format, the value is 00:00:00."
msgstr "<item type=\"input\">=TIDVÄRDE(\"24:00\")</item> returnerar 1. Om du använder tidsformatet TT:MM:SS är värdet 00:00:00."

#. from libreoffice:scalc-01
msgid "<bookmark_value>TODAY function</bookmark_value>"
msgstr "<bookmark_value>IDAG, funktion </bookmark_value>"

#. from libreoffice:scalc-01
msgid "<variable id=\"today\"><link href=\"text/scalc/01/func_today.xhp\">TODAY</link></variable>"
msgstr "<variable id=\"today\"><link href=\"text/scalc/01/func_today.xhp\">IDAG</link></variable>"

#. from libreoffice:scalc-01
msgid "<ahelp hid=\"HID_FUNC_HEUTE\">Returns the current computer system date.</ahelp> The value is updated when you reopen the document or modify the values of the document."
msgstr "<ahelp hid=\"HID_FUNC_HEUTE\">Returnerar datorns aktuella systemdatum.</ahelp> Värdet uppdateras när du öppnar dokumentet igen eller ändrar värdena i dokumentet."

#. from libreoffice:scalc-01
msgid "TODAY()"
msgstr "IDAG()"

#. from libreoffice:scalc-01
msgid "TODAY is a function without arguments."
msgstr "TODAY är en funktion utan argument."

#. from libreoffice:scalc-01
msgid "<item type=\"input\">TODAY()</item> returns the current computer system date."
msgstr "<item type=\"input\">IDAG()</item> returnerar dagens datum."

#. from libreoffice:scalc-01
msgid "<bookmark_value>WEBSERVICE function</bookmark_value>"
msgstr "<bookmark_value>UDDASPRIS, funktion </bookmark_value>"

#. from libreoffice:scalc-01
msgid "<bookmark_value>WEEKDAY function</bookmark_value>"
msgstr "<bookmark_value>VECKODAG, funktion</bookmark_value>"

#. from libreoffice:scalc-01
msgid "<emph>Number</emph>, as a date value, is a decimal for which the weekday is to be returned."
msgstr "<emph>tal</emph> är som datumvärde ett decimaltal för vilket veckodagen ska beräknas."

#. from libreoffice:scalc-01
msgid "<bookmark_value>WEEKNUM function</bookmark_value>"
msgstr "<bookmark_value>VECKONR</bookmark_value>"

#. from libreoffice:scalc-01
msgid "<variable id=\"weeknum\"><link href=\"text/scalc/01/func_weeknum.xhp\">WEEKNUM</link></variable>"
msgstr "<variable id=\"weeknum\"><link href=\"text/scalc/01/func_weeknum.xhp\">VECKONR</link></variable>"

#. from libreoffice:scalc-01
msgid "WEEKNUM(Number [; Mode])"
msgstr "VECKONR(Tal; Läge)"

#. from libreoffice:scalc-01
msgid "<bookmark_value>WEEKNUM_OOO function</bookmark_value>"
msgstr "<bookmark_value>VECKONR_ADD</bookmark_value>"

#. from libreoffice:scalc-01
msgid "<variable id=\"weeknum_ooo\"><link href=\"text/scalc/01/func_weeknum_ooo.xhp\">WEEKNUM_OOO</link></variable>"
msgstr "<variable id=\"weeknumadd\"><link href=\"text/scalc/01/func_weeknumadd.xhp\">VECKONR_ADD</link></variable>"

#. from libreoffice:scalc-01
msgid "<ahelp hid=\"HID_FUNC_WEEKNUM_OOO\">WEEKNUM_OOO calculates the week number of the year for the internal date value.</ahelp>"
msgstr "<ahelp hid=\"HID_FUNC_KALENDERWOCHE\">VECKONR beräknar veckonumret i året för det interna datumvärdet.</ahelp>"

#. from libreoffice:scalc-01
msgid "WEEKNUM_OOO(Number; Mode)"
msgstr "VECKONR(Tal; Läge)"

#. from libreoffice:scalc-01
msgid "<emph>Number</emph> is the internal date number."
msgstr "<emph>tal</emph> är det interna datumtalet."

#. from libreoffice:scalc-01
msgid "<emph>Mode</emph> sets the start of the week and the calculation type."
msgstr "<emph>läge</emph> beräknar när veckan börjar och typ av beräkning."

#. from libreoffice:scalc-01
msgid "1 = Sunday"
msgstr "1 = Söndag"

#. from libreoffice:scalc-01
msgid "<bookmark_value>WEEKNUM_EXCEL2003 function</bookmark_value>"
msgstr "<bookmark_value>VECKONR_ADD</bookmark_value>"

#. from libreoffice:scalc-01
msgid "<variable id=\"weeknumadd\"><link href=\"text/scalc/01/func_weeknumadd.xhp\">WEEKNUM_EXCEL2003</link></variable>"
msgstr "<variable id=\"weeknumadd\"><link href=\"text/scalc/01/func_weeknumadd.xhp\">VECKONR_ADD</link></variable>"

#. from libreoffice:scalc-01
msgid "<ahelp hid=\"HID_AAI_FUNC_WEEKNUM\">The result indicates the number of the calendar week for a date.</ahelp>"
msgstr "<ahelp hid=\"HID_AAI_FUNC_WEEKNUM\">Resultatet indikerar kalenderveckans nummer för ett datum.</ahelp>"

#. from libreoffice:scalc-01
msgid "<emph>Date</emph> is the date within the calendar week."
msgstr "<emph>Datum</emph> är datumet i kalenderveckan."

#. from libreoffice:scalc-01
msgid "<emph>ReturnType</emph> is 1 for week beginning on a Sunday, 2 for week beginning on a Monday."
msgstr "<emph>Returtyp</emph> är 1 för veckor som börjar med söndag, 2 för veckor som börjar med måndag."

#. from libreoffice:scalc-01
msgid "In which week number does 2001-12-24 fall?"
msgstr "I vilken kalendervecka ligger 2001-12-24?"

#. from libreoffice:scalc-01
msgid "<bookmark_value>WORKDAY function</bookmark_value>"
msgstr "<bookmark_value>ARBETSDAGAR, funktion </bookmark_value>"

#. from libreoffice:scalc-01
msgid "<variable id=\"workday\"><link href=\"text/scalc/01/func_workday.xhp\">WORKDAY</link></variable>"
msgstr "<variable id=\"workday\"><link href=\"text/scalc/01/func_workday.xhp\">ARBETSDAGAR</link></variable>"

#. from libreoffice:scalc-01
msgid "<ahelp hid=\"HID_AAI_FUNC_WORKDAY\"> The result is a date number that can be formatted as a date. You then see the date of a day that is a certain number of <emph>workdays</emph> away from the <emph>start date</emph>.</ahelp>"
msgstr "<ahelp hid=\"HID_AAI_FUNC_WORKDAY\"> Resultatet är ett datumnummer som kan formateras som ett datum. Sedan ser du det datum som infaller ett visst antal <emph>arbetsdagar</emph>från <emph>startdatumet</emph>.</ahelp>"

#. from libreoffice:scalc-01
msgid "<emph>StartDate</emph> is the date from when the calculation is carried out. If the start date is a workday, the day is included in the calculation."
msgstr "<emph>Startdatum</emph> är det första datumet i perioden som beräkningen utförs för. Om startdatumet är en arbetsdag tas dagen med i beräkningen."

#. from libreoffice:scalc-01
msgid "<emph>Days</emph> is the number of workdays. Positive value for a result after the start date, negative value for a result before the start date."
msgstr "<emph>Dagar</emph> är antalet arbetsdagar. Positivt värde för ett resultat efter startdatumet, och negativt värde för ett resultat före startdatumet."

#. from libreoffice:scalc-01
msgid "<emph>Holidays</emph> is a list of optional holidays. These are non-working days. Enter a cell range in which the holidays are listed individually."
msgstr "<emph>Helgdagar</emph> är en valfri lista över helgdagar. De här dagarna är inte arbetsdagar. Ange ett cellintervall där semesterdagarna visas individuellt."

#. from libreoffice:scalc-01
msgid "What date came 17 workdays after 1 December 2001? Enter the start date \"2001-12-01\" in C3 and the number of workdays in D3. Cells F3 to J3 contain the following Christmas and New Year holidays: \"2001-12-24\", \"2001-12-25\", \"2001-12-26\", \"2001-12-31\", \"2002-01-01\"."
msgstr "Vilket datum infaller 17 arbetsdagar efter 1 december 2001? Ange startdatumet \"2001-12-01\" i C3 och antalet arbetsdagar i D3. Cellerna F3 till J3 innehåller följande jul- och nyårshelgdagar: \"2001-12-24\", \"2001-12-25\", \"2001-12-26\", \"2001-12-31\", \"2002-01-01\"."

#. from libreoffice:scalc-01
msgid "<bookmark_value>YEAR function</bookmark_value>"
msgstr "<bookmark_value>ÅR, funktion </bookmark_value>"

#. from libreoffice:scalc-01
msgid "<variable id=\"year\"><link href=\"text/scalc/01/func_year.xhp\">YEAR</link></variable>"
msgstr "<variable id=\"year\"><link href=\"text/scalc/01/func_year.xhp\">ÅR</link></variable>"

#. from libreoffice:scalc-01
msgid "YEAR(Number)"
msgstr "ÅR(tal)"

#. from libreoffice:scalc-01
msgid "<emph>Number</emph> shows the internal date value for which the year is to be returned."
msgstr "<emph>tal</emph> anger det interna datumvärde för vilket årtalet ska beräknas."

#. from libreoffice:scalc-01
msgid "<item type=\"input\">=YEAR(1)</item> returns 1899"
msgstr "<item type=\"input\">=ÅR(1)</item> returnerar 1899"

#. from libreoffice:scalc-01
msgid "<item type=\"input\">=YEAR(2)</item> returns 1900"
msgstr "<item type=\"input\">=ÅR(2)</item> returnerar 1900"

#. from libreoffice:scalc-01
msgid "<item type=\"input\">=YEAR(33333.33)</item> returns 1991"
msgstr "<item type=\"input\">=ÅR(33333,33)</item> returnerar 1991"

#. from libreoffice:scalc-01
msgid "<bookmark_value>YEARFRAC function</bookmark_value>"
msgstr "<bookmark_value>ÅRDEL, funktion </bookmark_value>"

#. from libreoffice:scalc-01
msgid "<variable id=\"yearfrac\"><link href=\"text/scalc/01/func_yearfrac.xhp\">YEARFRAC</link></variable>"
msgstr "<variable id=\"yearfrac\"><link href=\"text/scalc/01/func_yearfrac.xhp\">ÅRDEL</link></variable>"

#. from libreoffice:scalc-01
msgid "<ahelp hid=\"HID_AAI_FUNC_YEARFRAC\">The result is the number of the years (including fractional part) between <emph>StartDate</emph> and <emph>EndDate</emph>.</ahelp>"
msgstr "<ahelp hid=\"HID_AAI_FUNC_YEARFRAC\">Resultatet är antalet år (inklusive bråkdel) mellan <emph>Startdatum</emph> och <emph>Slutdatum</emph>.</ahelp>"

#. from libreoffice:scalc-01
msgid "<emph>StartDate</emph> and <emph>EndDate</emph> are two date values."
msgstr "<emph>Startdatum</emph> och <emph>Slutdatum</emph> är två datumvärden."

#. from libreoffice:scalc-01
msgid "<emph>Basis</emph> (optional) is chosen from a list of options and indicates how the year is to be calculated."
msgstr "<emph>Bas</emph> väljs i en lista med alternativ och indikerar hur året ska beräknas."

#. from libreoffice:scalc-01
msgid "US method (NASD), 12 months of 30 days each"
msgstr "US-metod (NASD), 12 månader om 30 dagar"

#. from libreoffice:scalc-01
msgid "Exact number of days in months, exact number of days in year"
msgstr "exakt antal dagar per månad, exakt antal dagar per år"

#. from libreoffice:scalc-01
msgid "Exact number of days in month, year has 360 days"
msgstr "exakt antal dagar per månad, år har 360 dagar"

#. from libreoffice:scalc-01
msgid "Exact number of days in month, year has 365 days"
msgstr "exakt antal dagar per månad, år har 365 dagar"

#. from libreoffice:scalc-01
msgid "European method, 12 months of 30 days each"
msgstr "Europa-metod, 12 månader om 30 dagar"

#. from libreoffice:scalc-01
msgid "What fraction of the year 2008 lies between 2008-01-01 and 2008-07-01?"
msgstr "Vilken del av år 2008 ligger mellan 2008-01-01 och 2008-07-01?"

#. from libreoffice:scalc-01
msgid "<variable id=\"solver\"><link href=\"text/scalc/01/solver.xhp\">Solver</link></variable>"
msgstr "<variable id=\"solver\"><link href=\"text/scalc/01/solver.xhp\">Problemlösaren</link></variable>"

#. from libreoffice:scalc-01
msgid "To solve equations with the solver"
msgstr "Lösa ekvationer med problemlösaren"

#. from libreoffice:scalc-01
msgid "The goal of the solver process is to find those variable values of an equation that result in an optimized value in the <emph>target cell</emph>, also named the \"objective\". You can choose whether the value in the target cell should be a maximum, a minimum, or approaching a given value."
msgstr "Målet med problemlösningsprocessen är att finna de variabla värdena för en ekvation som resulterar i ett optimalt värde i <emph>målcellen</emph>, som även kallas målfunktion. Du kan välja om värdet i målcellen ska vara ett maximalt, minimalt eller närma sig ett givet värde."

#. from libreoffice:scalc-01
msgid "The initial variable values are inserted in a rectangular cell range that you enter in the <emph>By changing cells</emph> box."
msgstr "De initiala variabelvärdena infogas i ett rektangulärt cellområde som du anger i rutan <emph>Genom att ändra cell</emph>."

#. from libreoffice:scalc-01
msgid "You can define a series of limiting conditions that set constraints for some cells. For example, you can set the constraint that one of the variables or cells must not be bigger than another variable, or not bigger than a given value. You can also define the constraint that one or more variables must be integers (values without decimals), or binary values (where only 0 and 1 are allowed)."
msgstr "Du kan definiera en serie villkor som anger begränsningar för en del celler. Du kan t.ex. ange begränsningen att en av variablerna eller cellerna inte får vara större än andra variabler, eller inte större än ett givet värde. Du kan också definiera en begränsning att en eller flera variabler måsta vara heltal (värden utan decimaler) eller binära värden (där endast 0 eller 1 tillåts)."

#. from libreoffice:scalc-01
msgid "Click OK to accept the changes and to go back to the <link href=\"text/scalc/01/solver.xhp\">Solver</link> dialog."
msgstr "Klicka på OK för att godkänna ändringarna och gå tillbaka till dialogrutan <link href=\"text/scalc/01/solver.xhp\">Problemlösaren</link>."

#. from libreoffice:scalc-01
msgid "Use the data statistics in Calc to perform complex data analysis"
msgstr "Använd datastistik i Calc för att utföra komplex datanalys"

#. from libreoffice:scalc-01
msgid "To work on a complex statistical or engineering analysis, you can save steps and time by using Calc Data Statistics. You provide the data and parameters for each analysis, and the set of tools uses the appropriate statistical or engineering functions to calculate and display the results in an output table."
msgstr "Om du arbetar med komplex statistik- eller utvecklingsanalys kan du spara in moment och tid genom att använda Datastatistiken i Calc. Du stoppar in data och parametrar för varje analys och de olika verktygen använder lämpliga statistik- och utvecklingsfunktioner för att beräkna och visa resultaten i en utmatningstabell."

#. from libreoffice:scalc-01
msgid "<bookmark_value>text to columns</bookmark_value>"
msgstr "<bookmark_value>text till kolumner</bookmark_value>"

#. from libreoffice:scalc-01
msgid "<link href=\"text/scalc/01/text2columns.xhp\">Text to Columns</link>"
msgstr "<link href=\"text/scalc/01/text2columns.xhp\">Text till kolumner</link>"

#. from libreoffice:scalc-01
msgid "To expand cell contents to multiple cells"
msgstr "Så här expanderar du cellinnehållet till flera celler"

#. from libreoffice:scalc-01
msgid "You can expand cells that contain comma separated values (CSV) into multiple cells in the same row."
msgstr "Du kan expandera celler som innehåller kommaavgränsade värden (CSV) till flera celler i samma rad."

#. from libreoffice:scalc-01
msgid "For example, cell A1 contains the comma separated values <item type=\"literal\">1,2,3,4</item>, and cell A2 contains the text <item type=\"literal\">A,B,C,D</item>."
msgstr "Till exempel innehåller cellen A1 de kommaavgränsade värdena <item type=\"literal\">1,2,3,4</item> och cellen A2 innehåller texten <item type=\"literal\">A,B,C,D</item>."

#. from libreoffice:scalc-01
msgid "Select the cell or cells that you want to expand."
msgstr "Markera den eller de celler du vill expandera."

#. from libreoffice:scalc-01
msgid "Choose <emph>Data - Text to Columns</emph>."
msgstr "Välj <emph>Data - Text till kolumner</emph>."

#. from libreoffice:scalc-01
msgid "You see the Text to Columns dialog."
msgstr "Dialogrutan Text till kolumner visas."

#. from libreoffice:scalc-01
msgid "Select the separator options. The preview shows how the current cell contents will be transformed into multiple cells."
msgstr "Välj delningsalternativ. Förhandsgranskningen visar hur det aktuella cellinnehållet omvandlas till flera celler."

#. from libreoffice:scalc-01
msgid "You can select a fixed width and then click the ruler on the preview to set cell breakup positions."
msgstr "Du kan välja en fast bredd och sedan klicka på linjalen i förhandsgranskningen för att ange cellavgränsningspositioner."

#. from libreoffice:scalc-01
msgid "You can select or enter separator characters to define the positions of breaking points. The separator characters are removed from the resulting cell contents."
msgstr "Du kan välja eller ange avgränsningstecken för att definiera positionerna för brytpunkterna. Avgränsningstecknen tas bort från det resulterande cellinnehållet."

#. from libreoffice:scalc-01
msgid "In the example, you select the comma as a delimiter character. Cells A1 and A2 will be expanded to four columns each. A1 contains 1, B1 contains 2, and so on."
msgstr "I exemplet väljer du komma som avgränsningstecken. Cellerna A1 och A2 expanderas till fyra kolumner var. A1 innehåller 1, B1 innehåller 2, o.s.v."

#. from libreoffice:scalc-02
msgid "<ahelp hid=\"HID_INSWIN_POS\">Displays the reference for the current cell, the range of the selected cells, or the name of the area. You can also select a range of cells, and then type a name for that range into the <emph>Name Box</emph>.</ahelp>"
msgstr "<ahelp hid=\"HID_INSWIN_POS\">Visar referensen för den aktiva cellen, det markerade cellområdet eller namnet på området. Du kan också markera ett cellområde och sedan skriva ett namn på området i rutan <emph>Namn</emph>.</ahelp>"

#. from libreoffice:scalc-02
msgid "<bookmark_value>formula bar; functions</bookmark_value><bookmark_value>functions; formula bar icon</bookmark_value>"
msgstr "<bookmark_value>Formelrad; funktioner</bookmark_value><bookmark_value>Funktioner; ikon för formelrad</bookmark_value>"

#. from libreoffice:scalc-02
msgid "<link href=\"text/scalc/02/06040000.xhp\">Function</link>"
msgstr "<link href=\"text/scalc/02/06040000.xhp\">Funktion</link>"

#. from libreoffice:scalc-02
msgid "<ahelp hid=\"HID_INSWIN_FUNC\">Adds a formula to the current cell. Click this icon, and then enter the formula in the <emph>Input line</emph>.</ahelp>"
msgstr "<ahelp hid=\"HID_INSWIN_FUNC\">Lägger till en formel i den aktuella cellen. Klicka på den här ikonen och skriv in formeln på <emph>Inmatningsraden</emph>.</ahelp>"

#. from libreoffice:scalc-02
msgid "This icon is only available when the <emph>Input line</emph> box is not active."
msgstr "Den här ikonen är bara tillgänglig när <emph>Inmatningsraden</emph> inte är aktiv."

#. from libreoffice:scalc-02
msgid "<link href=\"text/scalc/02/06050000.xhp\">Input line</link>"
msgstr "<link href=\"text/scalc/02/06050000.xhp\">Inmatningsrad</link>"

#. from libreoffice:scalc-02
msgid "<ahelp hid=\"HID_INSWIN_INPUT\">Enter the formula that you want to add to the current cell. You can also click the <link href=\"text/scalc/01/04060000.xhp\">Function Wizard</link> icon to insert a predefined function into the formula.</ahelp>"
msgstr "<ahelp hid=\"HID_INSWIN_INPUT\">Skriv den formel som du ska lägga till i den aktiva cellen. Du kan också klicka på ikonen <link href=\"text/scalc/01/04060000.xhp\">Funktionsguiden</link> om du vill infoga en fördefinierad funktion i formeln.</ahelp>"

#. from libreoffice:scalc-02
msgid "<bookmark_value>formula bar; canceling inputs</bookmark_value><bookmark_value>functions; canceling input icon</bookmark_value>"
msgstr "<bookmark_value>Formelrad; ignorera inmatning</bookmark_value><bookmark_value>Funktioner; ikon för ignorera</bookmark_value>"

#. from libreoffice:scalc-02
msgid "<link href=\"text/scalc/02/06060000.xhp\">Cancel</link>"
msgstr "<link href=\"text/scalc/02/06060000.xhp\">Ignorera</link>"

#. from libreoffice:scalc-02
msgid "<ahelp hid=\"HID_INSWIN_CANCEL\">Clears the contents of the <emph>Input line</emph>, or cancels the changes that you made to an existing formula.</ahelp>"
msgstr "<ahelp hid=\"HID_INSWIN_CANCEL\">Rensar innehållet på <emph>Inmatningsraden</emph>, eller ångrar ändringar du har gjort i en befintlig formel.</ahelp>"

#. from libreoffice:scalc-02
msgid "<image id=\"img_id3156422\" src=\"svx/res/nu02.png\" width=\"0.2228inch\" height=\"0.2228inch\"><alt id=\"alt_id3156422\">Icon</alt></image>"
msgstr "<image id=\"img_id3156422\" src=\"svx/res/nu02.png\" width=\"5.66mm\" height=\"5.66mm\"><alt id=\"alt_id3156422\">Symbol</alt></image>"

#. from libreoffice:scalc-02
msgid "<bookmark_value>formula bar; accepting inputs</bookmark_value><bookmark_value>functions; accepting input icon</bookmark_value>"
msgstr "<bookmark_value>Formelrad; acceptera inmatning</bookmark_value><bookmark_value>Funktioner; ikon för acceptera</bookmark_value>"

#. from libreoffice:scalc-02
msgid "<link href=\"text/scalc/02/06070000.xhp\">Accept</link>"
msgstr "<link href=\"text/scalc/02/06070000.xhp\">Överta</link>"

#. from libreoffice:scalc-02
msgid "<ahelp hid=\"HID_INSWIN_OK\">Accepts the contents of the <emph>Input line</emph>, and then inserts the contents into the current cell.</ahelp>"
msgstr "<ahelp hid=\"HID_INSWIN_OK\">Godkänner innehållet på <emph>Inmatningsraden</emph> och infogar innehållet i den aktuella cellen.</ahelp>"

#. from libreoffice:scalc-02
msgid "<image id=\"img_id3156422\" src=\"svx/res/nu01.png\" width=\"5.64mm\" height=\"5.64mm\"><alt id=\"alt_id3156422\">Icon</alt></image>"
msgstr "<image id=\"img_id3156422\" src=\"svx/res/nu01.png\" width=\"5.64mm\" height=\"5.64mm\"><alt id=\"alt_id3156422\">Symbol</alt></image>"

#. from libreoffice:scalc-02
msgid "Theme Selection"
msgstr "Välja tema"

#. from libreoffice:scalc-02
msgid "<ahelp hid=\"HID_DLGSTYLES_LISTBOX\">Click the formatting theme that you want to apply, and then click <emph>OK</emph>.</ahelp>"
msgstr "<ahelp hid=\"HID_DLGSTYLES_LISTBOX\">Klicka på det formateringstema som du vill använda och klicka sedan på <emph>OK</emph>.</ahelp>"

#. from libreoffice:scalc-02
msgid "Position in document"
msgstr "Placering i dokument"

#. from libreoffice:scalc-02
msgid "<link href=\"text/scalc/02/08010000.xhp\">Position in document</link>"
msgstr "<link href=\"text/scalc/02/08010000.xhp\">Position i dokument</link>"

#. from libreoffice:scalc-02
msgid "<ahelp hid=\".uno:StatusDocPos\">Displays the number of the current sheet and the total number of sheets in the spreadsheet.</ahelp>"
msgstr "<ahelp hid=\".uno:StatusDocPos\">Visar numret för den aktuella tabellen och det totala antalet tabeller i kalkylbladet.</ahelp>"

#. from libreoffice:scalc-02
msgid "Standard Formula, Date/Time, Error Warning"
msgstr "Standardformel, Datum/tid, Felvarning"

#. from libreoffice:scalc-02
msgid "<bookmark_value>formulas;status bar</bookmark_value>"
msgstr "<bookmark_value>Formler;statusrad</bookmark_value>"

#. from libreoffice:scalc-02
msgid "<link href=\"text/scalc/02/08080000.xhp\">Standard Formula, Date/Time, Error Warning</link>"
msgstr "<link href=\"text/scalc/02/08080000.xhp\">Standardformel, datum/klockslag, felmeddelande</link>"

#. from libreoffice:scalc-02
msgid "<ahelp hid=\".uno:StateTableCell\">Displays information about the current document. By default, the SUM of the contents of the selected cells is displayed.</ahelp>"
msgstr "<ahelp hid=\".uno:StateTableCell\">Visar information om det aktuella dokumentet. Standardinställningen är att summan av innehållet i de markerade cellerna visas.</ahelp>"

#. from libreoffice:scalc-02
msgid "To change the default formula that is displayed, right-click the field, and then choose the formula that you want. The available formulas are: Average, count of values (COUNTA), count of numbers (COUNT), Maximum, Minimum, Sum, or None."
msgstr "Du kan ställa in vilken standardformel som visas genom att högerklicka i fältet och sedan välja en annan formel. Du kan välja mellan följande formler: Medelvärde, AntalV (antal värden), Antal (antal tal), Maximum, Minimum, Summa eller Ingen."

#. from libreoffice:scalc-02
msgid "<link href=\"text/scalc/05/02140000.xhp\">Error codes</link>"
msgstr "<link href=\"text/scalc/05/02140000.xhp\">Felkoder</link>"

#. from libreoffice:scalc-02
msgid "<bookmark_value>page views; increasing scales</bookmark_value><bookmark_value>increasing scales in page view</bookmark_value><bookmark_value>zooming;enlarging page views</bookmark_value>"
msgstr "<bookmark_value>Förhandsgranskning; ökande skalor</bookmark_value><bookmark_value>Ökande skalor i förhandsgranskning</bookmark_value><bookmark_value>Zooma;förstora sidvisning</bookmark_value>"

#. from libreoffice:scalc-02
msgid "<ahelp hid=\".uno:ZoomIn\">Enlarges the screen display of the current document. The current zoom factor is displayed on the <emph>Status Bar</emph>.</ahelp>"
msgstr "<ahelp hid=\".uno:ZoomIn\">Gör visningen av det aktuella dokumentet större. Den aktuella zoomfaktorn visas på <emph>statusraden</emph>.</ahelp>"

#. from libreoffice:scalc-02
msgid "The maximum zoom factor is 400%."
msgstr "Den största zoomnivån är 400 %."

#. from libreoffice:scalc-02
msgid "<bookmark_value>page views;reducing scales</bookmark_value><bookmark_value>zooming;reducing page views</bookmark_value>"
msgstr "<bookmark_value>Förhandsgranskning;minska skalor</bookmark_value><bookmark_value>Zooma;minska förhandsgranskning</bookmark_value>"

#. from libreoffice:scalc-02
msgid "<ahelp hid=\".uno:ZoomOut\">Reduces the screen display of the current document. The current zoom factor is displayed on the <emph>Status Bar</emph>.</ahelp>"
msgstr "<ahelp hid=\".uno:ZoomOut\">Gör visningen av det aktuella dokumentet större eller mindre. Den aktuella zoomfaktorn visas på <emph>statusraden</emph>.</ahelp>"

#. from libreoffice:scalc-02
msgid "The minimum zoom factor is 20%."
msgstr "Den minsta zoomnivån är 20 %."

#. from libreoffice:scalc-02
msgid "Zooming Out"
msgstr "Zoomar ut"

#. from libreoffice:scalc-02
msgid "<bookmark_value>inserting; objects, toolbar icon</bookmark_value>"
msgstr "<bookmark_value>Infoga; objekt, verktygsradsikon</bookmark_value>"

#. from libreoffice:scalc-02
msgid "<link href=\"text/scalc/02/18010000.xhp\">Insert</link>"
msgstr "<link href=\"text/scalc/02/18010000.xhp\">Infoga</link>"

#. from libreoffice:scalc-02
msgid "<bookmark_value>inserting; cells, toolbar icon</bookmark_value>"
msgstr "<bookmark_value>Infoga; celler, verktygsradsikon</bookmark_value>"

#. from libreoffice:scalc-02
msgid "<link href=\"text/scalc/02/18020000.xhp\">Insert Cells</link>"
msgstr "<link href=\"text/scalc/02/18020000.xhp\">Infoga celler</link>"

#. from libreoffice:scalc-02
msgid "<ahelp hid=\".uno:InsCellsCtrl\">Click the arrow next to the icon to open the <emph>Insert Cells </emph>toolbar, where you can insert cells, rows, and columns into the current sheet.</ahelp>"
msgstr "<ahelp hid=\".uno:InsCellsCtrl\">Klicka på pilen bredvid ikonen om du vill öppna verktygsraden <emph>Infoga celler</emph> där du kan infoga celler och kolumner i den aktuella tabellen.</ahelp>"

#. from libreoffice:scalc-02
msgid "Tools bar icon:"
msgstr "Verktygsradsikon:"

#. from libreoffice:scalc-02
msgid "You can select the following icons:"
msgstr "Du kan välja följande funktioner:"

#. from libreoffice:scalc-02
msgid "<link href=\"text/scalc/01/04020000.xhp\">Insert Cells Down</link>"
msgstr "<link href=\"text/scalc/01/04020000.xhp\">Infoga celler, nedåt</link>"

#. from libreoffice:scalc-02
msgid "<link href=\"text/scalc/01/04020000.xhp\">Insert Cells Right</link>"
msgstr "<link href=\"text/scalc/01/04020000.xhp\">Infoga celler till höger</link>"

#. from libreoffice:scalc-02
msgid "<link href=\"text/scalc/01/04020000.xhp\">Rows</link>"
msgstr "<link href=\"text/scalc/01/04020000.xhp\">Rader</link>"

#. from libreoffice:scalc-02
msgid "<link href=\"text/scalc/01/04020000.xhp\">Columns</link>"
msgstr "<link href=\"text/scalc/01/04020000.xhp\">Kolumner</link>"

#. from libreoffice:scalc-04
msgid "Shortcut Keys for Spreadsheets"
msgstr "Kortkommandon för tabeller"

#. from libreoffice:scalc-04
msgid "<variable id=\"calc_keys\"><link href=\"text/scalc/04/01020000.xhp\">Shortcut Keys for Spreadsheets</link></variable>"
msgstr "<variable id=\"calc_keys\"><link href=\"text/scalc/04/01020000.xhp\">Kortkommandon för kalkylblad</link></variable>"

#. from libreoffice:scalc-04
msgid "Moves the cursor to the first cell in the sheet (A1)."
msgstr "Flyttar markören till den första cellen i tabellen (A1)."

#. from libreoffice:scalc-04
msgid "<switchinline select=\"sys\"><caseinline select=\"MAC\">Command</caseinline><defaultinline>Ctrl</defaultinline></switchinline>+Home"
msgstr "<switchinline select=\"sys\"><caseinline select=\"MAC\">Kommando</caseinline><defaultinline>Ctrl</defaultinline></switchinline>+Home"

#. from libreoffice:scalc-04
msgid "Moves the cursor to the last cell on the sheet that contains data."
msgstr "Flyttar markören till den sista cellen i tabellen som innehåller data."

#. from libreoffice:scalc-04
msgid "<switchinline select=\"sys\"><caseinline select=\"MAC\">Command</caseinline><defaultinline>Ctrl</defaultinline></switchinline>+End"
msgstr "<switchinline select=\"sys\"><caseinline select=\"MAC\">Kommando</caseinline><defaultinline>Ctrl</defaultinline></switchinline>+End"

#. from libreoffice:scalc-04
msgid "Moves the cursor to the first cell of the current row."
msgstr "Flyttar markören till första cellen på den markerade raden."

#. from libreoffice:scalc-04
msgid "Home"
msgstr "Home"

#. from libreoffice:scalc-04
msgid "<switchinline select=\"sys\"><caseinline select=\"MAC\">Command</caseinline><defaultinline>Ctrl</defaultinline></switchinline>+Left Arrow"
msgstr "<switchinline select=\"sys\"><caseinline select=\"MAC\">Kommando</caseinline><defaultinline>Ctrl</defaultinline></switchinline>+Vänsterpil"

#. from libreoffice:scalc-04
msgid "<switchinline select=\"sys\"><caseinline select=\"MAC\">Command</caseinline><defaultinline>Ctrl</defaultinline></switchinline>+Right Arrow"
msgstr "<switchinline select=\"sys\"><caseinline select=\"MAC\">Kommando</caseinline><defaultinline>Ctrl</defaultinline></switchinline>+Högerpil"

#. from libreoffice:scalc-04
msgid "<switchinline select=\"sys\"><caseinline select=\"MAC\">Command</caseinline><defaultinline>Ctrl</defaultinline></switchinline>+Up Arrow"
msgstr "<switchinline select=\"sys\"><caseinline select=\"MAC\">Kommando</caseinline><defaultinline>Ctrl</defaultinline></switchinline>+Uppil"

#. from libreoffice:scalc-04
msgid "<switchinline select=\"sys\"><caseinline select=\"MAC\">Command</caseinline><defaultinline>Ctrl</defaultinline></switchinline>+Down Arrow"
msgstr "<switchinline select=\"sys\"><caseinline select=\"MAC\">Kommando</caseinline><defaultinline>Ctrl</defaultinline></switchinline>+Nedpil"

#. from libreoffice:scalc-04
msgid "Moves one sheet to the left."
msgstr "Hopp till föregående tabellark."

#. from libreoffice:scalc-04
msgid "In the print preview: Moves to the previous print page."
msgstr "I förhandsgranskningen: Går till föregående utskriftssida."

#. from libreoffice:scalc-04
msgid "<switchinline select=\"sys\"><caseinline select=\"MAC\">Command</caseinline><defaultinline>Ctrl</defaultinline></switchinline>+Page Up"
msgstr "<switchinline select=\"sys\"><caseinline select=\"MAC\">Kommando </caseinline><defaultinline>Ctrl</defaultinline></switchinline> + PageUp"

#. from libreoffice:scalc-04
msgid "Moves one sheet to the right."
msgstr "Hopp till nästa tabellark."

#. from libreoffice:scalc-04
msgid "In the print preview: Moves to the next print page."
msgstr "I förhandsgranskningen: Går till nästa utskriftssida."

#. from libreoffice:scalc-04
