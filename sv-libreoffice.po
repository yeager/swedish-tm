msgstr "Behåller den aktuella formateringen i cellen."

#. from libreoffice:sc-messages
msgid "Enable natural sort"
msgstr "Aktivera naturlig sortering"

#. from libreoffice:sc-messages
msgid "Numbers embedded in text are sorted according to their value."
msgstr "Siffror inbäddade i text sorteras efter deras värde."

#. from libreoffice:sc-messages
msgid "For numbers embedded in text, sorting uses their values instead of their sequence of digit characters. Example: A1, A2, A10 instead of A1, A10, A2"
msgstr "För siffror inbäddade i text använder sorteringen deras värden istället för deras sekvens av siffror. Exempel: A1, A2, A10 istället för A1, A10, A2"

#. from libreoffice:sc-messages
msgid "Recognize decimal separator"
msgstr "Känna igen decimalseparatorn"

#. from libreoffice:sc-messages
msgid "Example: A1.14 (with dot as separator) contains character 'A' and number 1.14"
msgstr "Exempel: A1.14 (med punkt som avgränsare) innehåller tecknet 'A' och siffran 1.14"

#. from libreoffice:sc-messages
msgid "Example: A1.14, A1.2, A2.5, A10 (with dot as separator). The locale determines which character is used as the decimal separator."
msgstr "Exempel: A1.14, A1.2, A2.5, A10 (med punkt som avgränsare). Språkinställningen avgör vilket tecken som används som decimalavgränsare."

#. from libreoffice:sc-messages
msgid "Decimal separator as regular character"
msgstr "Decimalavgränsare som vanligt tecken"

#. from libreoffice:sc-messages
msgid "Example: In A1.14, the dot is a character, not a decimal separator."
msgstr "Exempel: I A1.14 är punkten ett tecken, inte en decimalavgränsare."

#. from libreoffice:sc-messages
msgid "Example: A1.14 contains character 'A', number 1, character '.' and number 14."
msgstr "Exempel: A1.14 innehåller tecknet 'A', siffran 1, tecknet '.' och siffran 14."

