msgid "Enter the maximum number of pages to be printed horizontally across."
msgstr "Ange det högsta antalet sidor som ska skrivas ut horisontellt tvärs över."

#. from libreoffice:sc-messages
msgid "Enter the maximum number of pages to be printed vertically stacked."
msgstr "Skriv det högsta antalet sidor som ska skrivas ut vertikalt staplat."

#. from libreoffice:sc-messages
