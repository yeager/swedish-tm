msgid "Uniform"
msgstr "Likafördelad"

#. from libreoffice:sc-messages
msgid "Uniform Integer"
msgstr "Likafördelat heltal"

#. from libreoffice:sc-messages
msgid "Cauchy"
msgstr "Cauchy-fördelat"

#. from libreoffice:sc-messages
