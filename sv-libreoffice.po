msgstr "<image src=\"cmd/lc_deleteannotation.svg\" id=\"img_id161685994175304\" width=\"1cm\" height=\"1cm\"><alt id=\"alt_id751685994175306\">Ikon för Ta bort kommentar</alt></image>"

