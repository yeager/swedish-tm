msgstr "<item type=\"input\">Startkostnad</item>"

#. from libreoffice:scalc-01
msgid "<item type=\"input\">Salvage Value</item>"
msgstr "<item type=\"input\">Restvärde</item>"

#. from libreoffice:scalc-01
msgid "<item type=\"input\">Useful Life</item>"
msgstr "<item type=\"input\">Livslängd</item>"

#. from libreoffice:scalc-01
msgid "<item type=\"input\">Time Period</item>"
msgstr "<item type=\"input\">Tidsperiod</item>"

#. from libreoffice:scalc-01
msgid "<item type=\"input\">Deprec. SYD</item>"
msgstr "<item type=\"input\">Avskrivn. ÅRSAVSKR</item>"

#. from libreoffice:scalc-01
msgid "<item type=\"input\">50,000 currency units</item>"
msgstr "<item type=\"input\">50 000 valutaenheter</item>"

#. from libreoffice:scalc-01
