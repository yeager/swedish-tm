msgid "The date or numeric array; a consistent step between values is needed."
msgstr "Datumet eller numerisk matris; det krävs konsekventa steg mellan värden."

#. from libreoffice:sc-messages
msgid "Statistic type"
msgstr "Statistisktyp"

#. from libreoffice:sc-messages
msgid "Value (1-9) or array of values, indicating which statistic will be returned for the calculated forecast"
msgstr "Värde (1-9) eller matris av värden, som indikerar vilken statistik som kommer att returneras för den beräkna prognosen"

#. from libreoffice:sc-messages
msgid "Period length"
msgstr "Periodlängd"

#. from libreoffice:sc-messages
msgid "Number of samples in period (default 1); length of the seasonal pattern."
msgstr "Antal stickprov under period (standard 1); längden på säsongsmönstret."

#. from libreoffice:sc-messages
msgid "Data completion"
msgstr "Datakomplettering"

#. from libreoffice:sc-messages
msgid "Data completion (default 1); 0 treats missing points as zero, 1 interpolates."
msgstr "Datakomplettering (standard 1); behandlar saknade punkter som noll, 1 interpolerar."

#. from libreoffice:sc-messages
msgid "Aggregation"
msgstr "Sammanställning"

#. from libreoffice:sc-messages
msgid "Aggregation (default 1 = AVERAGE); method to be used to aggregate identical (time) values."
msgstr "Sammanställning (standardvärde 1 = GENOMSNITT), metod som används för att slå samman identiska (tids-) värden."

#. from libreoffice:sc-messages
msgid "Returns a value along a linear regression"
msgstr "Beräknar ett värde längs en regressionslinje."

#. from libreoffice:sc-messages
msgid "The X value for which the Y value on the regression linear is to be calculated."
msgstr "X-värdet för vilket y-värdet på regressionslinjen beräknas."

#. from libreoffice:sc-messages
msgid "Data Y"
msgstr "Data Y"

#. from libreoffice:sc-messages
msgid "The Y data array."
msgstr "Matrisen med y-data."

#. from libreoffice:sc-messages
msgid "Data X"
msgstr "Data X"

#. from libreoffice:sc-messages
msgid "The X data array."
msgstr "Matrisen med x-data."

#. from libreoffice:sc-messages
msgid "Returns the reference to a cell as text."
msgstr "Bestämmer referensen till en cell som text."

#. from libreoffice:sc-messages
msgid "The row number of the cell."
msgstr "Radnumret för cellen."

#. from libreoffice:sc-messages
msgid "The column number of the cell."
msgstr "Cellens kolumnnummer."

#. from libreoffice:sc-messages
msgid "Specifies whether absolute or relative referencing is to be used."
msgstr "Anger om absolut eller relativ referens används."

#. from libreoffice:sc-messages
msgid "The spreadsheet name of the cell reference."
msgstr "Tabellnamnet för cellreferensen."

#. from libreoffice:sc-messages
msgid "Returns the number of individual ranges that belong to a (multiple) range."
msgstr "Bestämmer antalet enskilda områden som tillhör ett (multi-)område."

#. from libreoffice:sc-messages
msgid "Selects a value from a list of up to 30 value arguments."
msgstr "Väljer ett värde från upp till 30 argument."

#. from libreoffice:sc-messages
msgid "The index of the value (1..30) selected."
msgstr "Index för värdet (1..30) som väljs ut."

#. from libreoffice:sc-messages
msgid "Value "
msgstr "Värde "

#. from libreoffice:sc-messages
msgid "Value 1, value 2,... The list of arguments from which a value is chosen."
msgstr "värde 1; värde 2;... Argumentlistan från vilken ett värde väljs ut."

#. from libreoffice:sc-messages
msgid "Returns the internal column number of a reference."
msgstr "Bestämmer det interna kolumnnumret för en referens."

#. from libreoffice:sc-messages
msgid "Defines the internal row number of a reference."
msgstr "Bestämmer det interna radnumret för en referens."

#. from libreoffice:sc-messages
msgid "Returns the internal sheet number of a reference or a string."
msgstr "Bestämmer det interna bladnumret för en referens eller en teckensträng."

#. from libreoffice:sc-messages
msgid "The reference to a cell or a range or the character string of a sheet name."
msgstr "Referensen till en cell eller ett område eller till ett bladnamns teckensträng."

#. from libreoffice:sc-messages
msgid "Returns the number of columns in an array or reference."
msgstr "Bestämmer antalet kolumner för en referens eller en matris."

#. from libreoffice:sc-messages
msgid "The array (reference) for which the number of columns is to be determined."
msgstr "Matrisen (referensen) vars kolumnantal bestäms."

#. from libreoffice:sc-messages
msgid "Returns the number of rows in a reference or array."
msgstr "Bestämmer antalet rader i en referens eller matris."

#. from libreoffice:sc-messages
msgid "The array (reference) for which the number of rows is to be determined."
msgstr "Matrisen (referensen) vars radantal bestäms."

#. from libreoffice:sc-messages
msgid "Returns the number of sheets of a given reference. If no parameter has been entered, the total number of sheets in the document is returned."
msgstr "Bestämmer antalet blad för en referens. Om ingen parameter är angiven, returneras antalet blad i dokumentet."

#. from libreoffice:sc-messages
msgid "The reference to a cell or a range."
msgstr "Referensen till en cell eller ett område."

#. from libreoffice:sc-messages
msgid "Horizontal search and reference to the cells located below."
msgstr "Vågrät sökning och hänvisning till underliggande celler."

#. from libreoffice:sc-messages
msgid "The value to be found in the first row."
msgstr "Värdet som söks i första raden."

#. from libreoffice:sc-messages
msgid "The array or the range for the reference."
msgstr "Matrisen eller området för hänvisningen."

#. from libreoffice:sc-messages
msgid "The row index in the array."
msgstr "Radnumret i matrisen."

#. from libreoffice:sc-messages
msgid "If the value is TRUE or not given, the search row of the array represents a series of ranges, and must be sorted in ascending order."
msgstr "Om värdet är SANT eller inte anges representerar sökraden i matrisen en serie områden och måste sorteras i stigande ordning."

#. from libreoffice:sc-messages
msgid "Vertical search and reference to indicated cells."
msgstr "Lodrätt sökning och hänvisning till intilliggande celler."

#. from libreoffice:sc-messages
msgid "The array or range for referencing."
msgstr "Matrisen eller området för hänvisningen."

#. from libreoffice:sc-messages
msgid "Column index number in the array."
msgstr "Kolumnindex i matrisen."

#. from libreoffice:sc-messages
msgid "Sorted range lookup"
msgstr "Sorterad områdessökning"

#. from libreoffice:sc-messages
msgid "If the value is TRUE or not given, the search column of the array represents a series of ranges, and must be sorted in ascending order."
msgstr "Om värdet är SANT eller inte anges representerar sökkolumnen i matrisen en serie områden och måste sorteras i stigande ordning."

#. from libreoffice:sc-messages
msgid "Extended vertical search and reference to indicated cells."
msgstr "Utökad vertikal sökning och referens till angivna celler."

#. from libreoffice:sc-messages
msgid "The value to be found in the first column."
msgstr "Värdet som finns i den första kolumnen."

#. from libreoffice:sc-messages
msgid "Result Array"
msgstr "Resultatmatris"

#. from libreoffice:sc-messages
msgid "The array or range to return."
msgstr "Matrisen eller intervallet som ska returneras."

#. from libreoffice:sc-messages
msgid "Result if not found"
msgstr "Resultat om det inte hittas"

#. from libreoffice:sc-messages
msgid "If given, return given text, otherwise return #N/A."
msgstr "Om angivet, returnera given text, annars returnera #N/A."

#. from libreoffice:sc-messages
msgid "Returns a reference to a cell from a defined range."
msgstr "Bestämmer en referens till en cell från ett angivet område."

#. from libreoffice:sc-messages
msgid "The reference to a (multiple) range."
msgstr "Referensen till ett (multi-)område."

#. from libreoffice:sc-messages
msgid "The row in the range."
msgstr "Raden i området."

#. from libreoffice:sc-messages
msgid "The column in the range."
msgstr "Kolumnen i området."

#. from libreoffice:sc-messages
msgid "The index of the subrange if referring to a multiple range."
msgstr "Index för delområdet om det rör sig om ett multiområde."

#. from libreoffice:sc-messages
msgid "Returns the contents of a cell that is referenced in text form."
msgstr "Bestämmer innehållet i en cell som är angiven som referens i textform."

#. from libreoffice:sc-messages
msgid "The cell whose contents are to be evaluated is to be referenced in text form (e.g. \"A1\")."
msgstr "Cellen vars innehåll skall utvärderas som referens i textform ( t. ex. \"A1\")."

#. from libreoffice:sc-messages
msgid "A1"
msgstr "A1"

#. from libreoffice:sc-messages
msgid "The reference style: 0 or FALSE means R1C1 style, any other value or omitted means A1 style."
msgstr "Referensformatmallen: 0 eller FALSKT innebär R1C1-formatmall. Alla andra värden, eller inget värde alls, innebär A1-formatmall."

#. from libreoffice:sc-messages
msgid "Determines a value in a vector by comparison to values in another vector."
msgstr "Bestämmer ett värde i en vektor genom värdejämförelse i en annan vektor."

#. from libreoffice:sc-messages
msgid "Search vector"
msgstr "sökvektor"

#. from libreoffice:sc-messages
msgid "The vector (row or column) in which to search."
msgstr "Vektorn (raden eller kolumnen) som det söks i."

#. from libreoffice:sc-messages
msgid "Result vector"
msgstr "Resultatvektor"

#. from libreoffice:sc-messages
msgid "The vector (row or range) from which the value is to be determined."
msgstr "Vektorn (raden eller kolumnen) från vilket värdet bestäms."

#. from libreoffice:sc-messages
msgid "Defines a position in an array after comparing values."
msgstr "Bestämmer en position i en matris enligt en värdejämförelse."

#. from libreoffice:sc-messages
msgid "Lookup array"
msgstr "Sökmatris"

#. from libreoffice:sc-messages
msgid "The array (range) in which the search is made."
msgstr "Matrisen (området) som det skall sökas i."

#. from libreoffice:sc-messages
msgid "Type can take the value 1 (first column array ascending), 0 (exact match or wildcard or regular expression match) or -1 (first column array descending) and determines the criteria to be used for comparison purposes."
msgstr "Typ kan ta värdet 1 (första kolumnmatrisen stigande), 0 (exakt matchning eller jokertecken eller reguljärt uttrycksmatchning) eller -1 (första kolumnmatrisen fallande) och bestämmer kriterierna som ska användas för jämförelseändamål."

#. from libreoffice:sc-messages
msgid "Defines a relative position in an array or range of cells after comparing values."
msgstr "Definierar en relativ position i en matris eller ett cellområde efter jämförelse av värden."

#. from libreoffice:sc-messages
msgid "Search criterion"
msgstr "Sökkriterium"

#. from libreoffice:sc-messages
msgid "The value to be used for comparison."
msgstr "Värdet som ska användas för jämförelse."

#. from libreoffice:sc-messages
msgid "Search Array"
msgstr "Sök i matris"

#. from libreoffice:sc-messages
msgid "The array or range to search."
msgstr "Matrisen eller intervallet som ska sökas."

#. from libreoffice:sc-messages
msgid "0 - Exact match. Will return #N/A if no match. (default).\n-1 - Exact match or the next smaller item.\n1 - Exact match or the next larger item.\n2 - Wildcard match.\n3 - Regular expression match."
msgstr "0 - Exakt matchning. Kommer att returnera #N/A om ingen matchning. (standard).\n-1 - Exakt matchning eller nästa mindre objekt.\n1 - Exakt matchning eller nästa större objekt.\n2 - Matchning med jokertecken\n3 - Matchning av reguljära uttryck."

#. from libreoffice:sc-messages
msgid "Search Mode"
msgstr "Sökläge"

#. from libreoffice:sc-messages
msgid "1 - Search from the first value (default).\n-1 - Search from the last value (reverse).\n2 - Binary search values sorted in ascending order.\n-2 - Binary search values sorted in descending order."
msgstr "1 - Sök från det första värdet (standard).\n-1 - Sök från det senaste värdet (omvänt).\n2 - Binära sökvärden sorterade i stigande ordning.\n-2 - Binära sökvärden sorterade i fallande ordning."

#. from libreoffice:sc-messages
msgid "Returns a reference which has been moved in relation to the starting point."
msgstr "Bestämmer en referens som är förflyttad i förhållande till utgångspunkten."

#. from libreoffice:sc-messages
msgid "The reference (cell) from which to base the movement."
msgstr "Referensen (cellen) från vilken förflyttningen bestäms."

#. from libreoffice:sc-messages
msgid "The number of rows to be moved either up or down."
msgstr "Antalet rader som förflyttas uppåt eller neråt."

#. from libreoffice:sc-messages
msgid "The number of columns that are to be moved to the left or to the right."
msgstr "Antalet kolumner som förflyttas till vänster eller till höger."

#. from libreoffice:sc-messages
msgid "The number of rows of the moved reference."
msgstr "Antalet rader i den förflyttade referensen."

#. from libreoffice:sc-messages
msgid "The number of columns in the moved reference."
msgstr "Antalet kolumner i den flyttade referensen."

#. from libreoffice:sc-messages
msgid "Returns a number corresponding to an error type"
msgstr "Returnerar felnumret på uppkomna fel."

#. from libreoffice:sc-messages
msgid "Reference"
msgstr "Referens"

#. from libreoffice:sc-messages
msgid "The reference (cell) in which the error occurred."
msgstr "Referensen (cellen) där felet har uppkommit."

#. from libreoffice:sc-messages
msgid "Returns a number corresponding to one of the error values or #N/A if no error exists"
msgstr "Returnerar ett tal som motsvarar ett av felvärdena eller #SAKNAS om det inte finns något fel"

#. from libreoffice:sc-messages
msgid "The error value whose identifying number you want to find. Can be the actual error value or a reference to a cell that you want to test."
msgstr "Felvärdet vars identifieringsnummer du vill hitta. Kan vara ett faktiskt felvärde eller en referens till en cell som du vill testa."

#. from libreoffice:sc-messages
msgid "Applies a Style to the formula cell."
msgstr "Tilldelar formelcellen en formatmall."

#. from libreoffice:sc-messages
msgid "The name of the Style to be applied."
msgstr "Namnet på formatmallen som tilldelas."

#. from libreoffice:sc-messages
msgid "The time (in seconds) that the Style is to remain valid."
msgstr "Tiden (i sekunder) då formatmallen är giltig."

#. from libreoffice:sc-messages
msgid "The style to be applied after time expires."
msgstr "Formatmallen som tilldelas när tiden har gått ut."

#. from libreoffice:sc-messages
msgid "Result of a DDE link."
msgstr "Resultatet av en DDE-länkning."

#. from libreoffice:sc-messages
msgid "Server"
msgstr "Server"

#. from libreoffice:sc-messages
msgid "The name of the server application."
msgstr "Namnet på servertillämpningen."

#. from libreoffice:sc-messages
msgid "Topic/file"
msgstr "Ämne/fil"

#. from libreoffice:sc-messages
msgid "The topic or name of the file."
msgstr "Ämnet eller filnamnet."

#. from libreoffice:sc-messages
msgid "Item/range"
msgstr "Post/intervall"

#. from libreoffice:sc-messages
msgid "The item or range from which data is to be taken."
msgstr "Posten eller intervallet från vilket data skall hämtas."

#. from libreoffice:sc-messages
msgid "Defines how data is to be converted to numbers."
msgstr "Definierar hur data omvandlas till tal."

#. from libreoffice:sc-messages
msgid "Construct a Hyperlink."
msgstr "Konstruera en hyperlänk."

#. from libreoffice:sc-messages
msgid "The clickable URL."
msgstr "Den klickbara URL:en"

#. from libreoffice:sc-messages
msgid "Cell text"
msgstr "Celltext"

#. from libreoffice:sc-messages
msgid "The cell text to be displayed."
msgstr "Celltexten som skall visas."

#. from libreoffice:sc-messages
msgid "Extracts value(s) from a pivot table."
msgstr "Hämtar värde(n) från en pivottabell."

#. from libreoffice:sc-messages
msgid "The name of the pivot table field to extract."
msgstr "Namnet på det pivottabellsfält som skall hämtas ut."

#. from libreoffice:sc-messages
msgid "Pivot table"
msgstr "Pivottabell"

#. from libreoffice:sc-messages
msgid "A reference to a cell or range in the pivot table."
msgstr "En referens till en cell eller ett område i pivottabellen."

#. from libreoffice:sc-messages
msgid "Field name / item"
msgstr "Fältnamn/post"

#. from libreoffice:sc-messages
msgid "Field name/value pair to filter the target data."
msgstr "Fältnamn-värde-par för att filtrera måldata."

#. from libreoffice:sc-messages
msgid "Converts a number to text (Baht)."
msgstr "Konverterar ett tal till text (Baht)."

#. from libreoffice:sc-messages
msgid "The number to convert."
msgstr "Det tal som ska konverteras."

#. from libreoffice:sc-messages
msgid "Converts half-width ASCII and katakana characters to full-width."
msgstr "Konverterar halvbreda ASCII- och katakanatecken till full bredd."

#. from libreoffice:sc-messages
msgid "Converts full-width ASCII and katakana characters to half-width."
msgstr "Konverterar fullbred ASCII- och katakanatecken till halva bredden."

#. from libreoffice:sc-messages
msgid "The text to convert."
msgstr "Texten att konvertera."

#. from libreoffice:sc-messages
msgid "Returns a numeric code for the first character in a text string."
msgstr "Returnerar koden för det första tecknet i en text."

#. from libreoffice:sc-messages
msgid "Converts a number to text in currency format."
msgstr "Omvandlar ett tal till en text i valutaformat."

#. from libreoffice:sc-messages
msgid "Value is a number, a reference to a cell containing a number or a formula that results in a number."
msgstr "Värde är ett tal, en referens till en cell som innehåller ett tal eller en formel som resulterar i ett tal."

#. from libreoffice:sc-messages
msgid "Decimal places. Denotes the number of digits to the right of the decimal point."
msgstr "Decimaler. Är antalet siffror till höger om decimalkommat."

#. from libreoffice:sc-messages
msgid "Converts a code number into a character or letter."
msgstr "Omvandlar ett kodtal till ett tecken eller bokstav."

#. from libreoffice:sc-messages
msgid "Removes all nonprintable characters from text."
msgstr "Raderar tecken som inte kan skrivas ut från en text."

#. from libreoffice:sc-messages
msgid "The text from which nonprintable characters are to be removed."
msgstr "Texten från vilken tecknen, som inte kan skrivas ut, tas bort."

#. from libreoffice:sc-messages
msgid "Combines several text items into one."
msgstr "Sammanfogar texter till en enda."

#. from libreoffice:sc-messages
msgid "Text for the concatenation."
msgstr "Text som ska sammanfogas."

#. from libreoffice:sc-messages
msgid "Combines several text items into one, accepts cell ranges as arguments."
msgstr "Kombinerar flera textposter till en, accepterar cellintervall som argument."

#. from libreoffice:sc-messages
msgid "Combines several text items into one, accepts cell ranges as arguments. Uses delimiter between items."
msgstr "Kombinerar flera textposter till en, accepterar cellintervall som argument. Använder avgränsning mellan poster."

#. from libreoffice:sc-messages
msgid "Text string to be used as delimiter."
msgstr "Textsträng som ska användas som skiljetecken"

#. from libreoffice:sc-messages
msgid "If TRUE, empty cells will be ignored."
msgstr "Om SANT, så kommer tomma celler att ignoreras"

#. from libreoffice:sc-messages
msgid "Text and/or cell ranges for the concatenation."
msgstr "Text och/eller cellområden som ska sammanfogas."

#. from libreoffice:sc-messages
msgid "Checks 1 or more conditions and returns a value corresponding to the first true condition."
msgstr "Kontrollerar 1 eller flera villkor och returnerar ett värde som motsvarar det första sanna villkoret."

#. from libreoffice:sc-messages
msgid "Test"
msgstr "test"

#. from libreoffice:sc-messages
msgid "Any value or expression which can be either TRUE or FALSE."
msgstr "Ett valfritt värde eller uttryck som kan beräknas till SANT eller FALSKT."

#. from libreoffice:sc-messages
msgid "The result of the function if test is TRUE."
msgstr "Resultatet av funktionen om testet är SANT."

#. from libreoffice:sc-messages
msgid "Compares expression against list of value/result pairs, and returns result for first value that matches the expression.  If expression does not match any value, a default result is returned, if it is placed as final item in parameter list without a value."
msgstr "Jämför uttryck med en lista över värde/resultatpar och returnerar resultatet för det första värdet som matchar uttrycket. Om uttrycket inte matchar något värde returneras ett standardresultat om det placeras som slutobjekt i parameterlistan utan ett värde."

#. from libreoffice:sc-messages
msgid "Value to be compared against value1…valueN (N ≤ 127)"
msgstr "Värde som ska jämföras med värde1...värdeN (N ≤ 127)"

#. from libreoffice:sc-messages
msgid "Value to compare against expression. If no result is given, then value is returned as default result."
msgstr "Värde att jämföra mot uttryck. Om inget resultat ges returneras värdet som standardresultat."

#. from libreoffice:sc-messages
msgid "Value to return when corresponding value argument matches expression."
msgstr "Värde att returnera då motsvarande värdeargument matchar uttryck."

#. from libreoffice:sc-messages
msgid "Returns the minimum value in a range that meet multiple criteria in multiple ranges."
msgstr "Returnerar det lägsta värdet i ett område som uppfyller flera kriterier i flera områden."

#. from libreoffice:sc-messages
msgid "Min range"
msgstr "Min område"

#. from libreoffice:sc-messages
msgid "The range from which the minimum will be determined."
msgstr "Det område från vilket minimum kommer att bestämmas."

#. from libreoffice:sc-messages
msgid "Returns the maximum value in a range that meet multiple criteria in multiple ranges."
msgstr "Returnerar maxvärdet i ett intervall som uppfyller fler kriterier i flera områden."

#. from libreoffice:sc-messages
msgid "Max range"
msgstr "Maxområde"

#. from libreoffice:sc-messages
msgid "The range from which the maximum will be determined."
msgstr "Det område från vilket maximum kommer att bestämmas."

#. from libreoffice:sc-messages
msgid "Range "
msgstr "Område "

#. from libreoffice:sc-messages
msgid "Range 1, range 2,... are the ranges to be evaluated by the criteria given."
msgstr "Område 1, område 2,... är de områden som ska utvärderas mot givna kriterier."

#. from libreoffice:sc-messages
msgid "Criteria "
msgstr "Kriterier "

#. from libreoffice:sc-messages
msgid "Criteria 1, criteria 2,... are the criteria to be applied to the ranges given."
msgstr "Villkor 1, villkor 2,... är de villkor som skall användas på angivna områden."

#. from libreoffice:sc-messages
msgid "Specifies whether two texts are identical."
msgstr "Anger om två texter är lika."

#. from libreoffice:sc-messages
msgid "Text 1"
msgstr "Text 1"

#. from libreoffice:sc-messages
msgid "The first text to be used for comparing texts."
msgstr "Den första texten för textjämförelsen."

#. from libreoffice:sc-messages
msgid "Text 2"
msgstr "Text 2"

#. from libreoffice:sc-messages
msgid "The second text for comparing texts."
msgstr "Den andra texten för textjämförelsen."

#. from libreoffice:sc-messages
msgid "Looks for a string of text within another (case sensitive)"
msgstr "Söker efter en textsträng i en text (versalkänslig)."

#. from libreoffice:sc-messages
msgid "Looks for one text value within another (not case-sensitive)."
msgstr "Söker en textsträng i en text (inte versalkänsligt)."

#. from libreoffice:sc-messages
msgid "The position in the text where the search is started."
msgstr "Positionen i texten där sökningen skall börja."

#. from libreoffice:sc-messages
msgid "Removes extra spaces from text."
msgstr "Raderar alla överflödiga mellanslag mellan ord."

#. from libreoffice:sc-messages
msgid "The text in which extra spaces between words are to be deleted."
msgstr "Texten där överflödiga mellanslag mellan ord tas bort."

#. from libreoffice:sc-messages
msgid "Capitalizes the first letter in all words."
msgstr "Omvandlar begynnelsebokstäverna i alla ord till stora bokstäver."

#. from libreoffice:sc-messages
msgid "The text in which the beginning of words are to be replaced by capital letters."
msgstr "Texten där begynnelsebokstäver ersätts av stora bokstäver."

#. from libreoffice:sc-messages
msgid "Converts text to uppercase."
msgstr "Omvandlar alla bokstäver i en text till stora bokstäver."

#. from libreoffice:sc-messages
msgid "The text in which lower case letters are to be converted to capitals."
msgstr "Texten där små bokstäver skall omvandlas till stora bokstäver."

#. from libreoffice:sc-messages
msgid "Converts text to lowercase."
msgstr "Omvandlar alla bokstäver i en text till små bokstäver."

#. from libreoffice:sc-messages
msgid "The text in which capitals are converted to lower case letters."
msgstr "Texten där stora bokstäver ersätts med små."

#. from libreoffice:sc-messages
msgid "Converts text to a number."
msgstr "Omvandlar en text till ett tal."

#. from libreoffice:sc-messages
msgid "Converts a number to text according to a given format."
msgstr "Omvandlar ett tal till en text enligt en formatangivelse."

#. from libreoffice:sc-messages
msgid "The numeric value to be converted."
msgstr "är talvärdet som skall omvandlas."

#. from libreoffice:sc-messages
msgid "The text that describes the format."
msgstr "Texten som beskriver formatet."

#. from libreoffice:sc-messages
msgid "Returns a value if it is text, otherwise an empty string."
msgstr "Returnerar ett värde om det är text, och annars en tom sträng."

#. from libreoffice:sc-messages
msgid "The value to be checked and returned if it is text."
msgstr "Det värde som ska kontrolleras och returneras om det är text."

#. from libreoffice:sc-messages
msgid "Replaces characters within a text string with a different text string."
msgstr "Ersätter en del av en text med en annan text."

#. from libreoffice:sc-messages
msgid "Formats a number with a fixed number of places after the decimal point and thousands separator."
msgstr "Formaterar ett tal med ett fast antal decimaler och tusentalsavgränsare."

#. from libreoffice:sc-messages
msgid "The number to be formatted."
msgstr "Talet som formateras."

#. from libreoffice:sc-messages
msgid "Decimals"
msgstr "Decimaler"

#. from libreoffice:sc-messages
msgid "Decimal places. The number of fixed decimal places that are to be displayed. Default 2."
msgstr "Decimaler. Antalet fasta decimaler som ska visas. Standard 2."

#. from libreoffice:sc-messages
msgid "No thousands separators"
msgstr "Inga tusentalsavgränsare"

#. from libreoffice:sc-messages
msgid "Thousands separator. If 0 or omitted the locale group separator is used else the separator is suppressed."
msgstr "Tusentalsavgränsare. Om värdet är utelämnat eller lika med 0 så används det skiljetecken som är angivet för tusental i de regionala inställningarna, annars utelämnas skiljetecknet."

#. from libreoffice:sc-messages
msgid "Calculates length of a text string."
msgstr "Beräknar längden på en text."

#. from libreoffice:sc-messages
msgid "Returns the first character or characters of a text."
msgstr "Returnerar det första tecknet eller tecknen i en text."

#. from libreoffice:sc-messages
msgid "Returns the last character or characters of a text."
msgstr "Returnerar det sista tecknet eller tecknen i en text."

#. from libreoffice:sc-messages
msgid "Returns a partial text string of a text."
msgstr "Bestämmer ett delord i en text"

#. from libreoffice:sc-messages
msgid "Repeats text a given number of times."
msgstr "Upprepar en text ett bestämt antal gånger."

#. from libreoffice:sc-messages
msgid "The text to be repeated."
msgstr "Texten som upprepas."

#. from libreoffice:sc-messages
msgid "The number of times the text is to be repeated."
msgstr "Antalet gånger texten upprepas."

#. from libreoffice:sc-messages
msgid "Substitutes new text for old text in a string."
msgstr "Ersätter textsträngar flera gånger i en text."

#. from libreoffice:sc-messages
msgid "The text in which partial words are to be replaced."
msgstr "Texten där textsträngar byts ut."

#. from libreoffice:sc-messages
msgid "Search text"
msgstr "Söktext"

#. from libreoffice:sc-messages
msgid "The partial string to be (repeatedly) replaced."
msgstr "Textsträngen som skall bytas ut (flera gånger)."

#. from libreoffice:sc-messages
msgid "The text which is to replace the text string."
msgstr "Texten som skall ersätta textsträngen."

#. from libreoffice:sc-messages
msgid "Occurrence"
msgstr "Förekomst"

#. from libreoffice:sc-messages
msgid "Which occurrence of the old text is to be replaced."
msgstr "Vilken förekomst av den gamla texten som ska ersättas."

#. from libreoffice:sc-messages
msgid "Matches and extracts or optionally replaces text using regular expressions."
msgstr "Matchar och extraherar eller ersätter text med hjälp av reguljära uttryck."

#. from libreoffice:sc-messages
msgid "The text to be operated on."
msgstr "Texten som skall användas."

#. from libreoffice:sc-messages
msgid "Expression"
msgstr "Uttryck"

#. from libreoffice:sc-messages
msgid "The regular expression pattern to be matched."
msgstr "Det reguljära uttrycksmönster som skall matchas."

#. from libreoffice:sc-messages
msgid "Replacement"
msgstr "Ersättning"

#. from libreoffice:sc-messages
msgid "The replacement text and references to capture groups."
msgstr "Ersättningstexten och referenser till fångstgrupper."

#. from libreoffice:sc-messages
msgid "Flags or Occurrence"
msgstr "Flaggor eller förekomst"

#. from libreoffice:sc-messages
msgid "Text specifying option flags, \"g\" for global replacement. Or number of occurrence to match or replace."
msgstr "Text som anger alternativ för flaggor, \"g\" för global ersättning. Eller antal förekomster som matchar eller ersätter."

#. from libreoffice:sc-messages
msgid "Converts a positive integer to text from a number system to the base defined."
msgstr "Omvandlar ett positivt heltal till en text från ett talsystem till den angivna basen."

#. from libreoffice:sc-messages
msgid "The number to be converted."
msgstr "Talet som skall omvandlas."

#. from libreoffice:sc-messages
msgid "Minimum length"
msgstr "minimilängd"

#. from libreoffice:sc-messages
msgid "If the text is shorter than the specified length, zeros are added to the left of the string."
msgstr "Om texten är kortare fylls den ut till vänster med nollor."

#. from libreoffice:sc-messages
msgid "Converts a text of a specified number system to a positive integer in the base given."
msgstr "Omvandlar en text från ett talsystem för den angivna basen till ett positivt heltal."

#. from libreoffice:sc-messages
msgid "The text to be converted."
msgstr "Texten som skall omvandlas."

#. from libreoffice:sc-messages
msgid "Radix"
msgstr "Roten ur"

#. from libreoffice:sc-messages
msgid "The base number for conversion must be in the range 2 - 36."
msgstr "Talbasen till vilken konvertering sker, måste ligga i området 2 - 36."

#. from libreoffice:sc-messages
msgid "Converts a value according to a conversion table in the configuration (main.xcd)."
msgstr "Konverterar ett värde enligt en konverteringstabell i konfigurationen (main.xcd)."

#. from libreoffice:sc-messages
msgid "Unit from which something is converted, case-sensitive."
msgstr "Enhet från vilken något konverteras, skiftlägeskänsligt."

#. from libreoffice:sc-messages
msgid "Unit into which something is converted, case-sensitive."
msgstr "Enhet till vilken något konverteras, skiftlägeskänsligt."

#. from libreoffice:sc-messages
msgid "Converts a number to a Roman numeral."
msgstr "Omvandlar ett tal till romerska siffror."

#. from libreoffice:sc-messages
msgid "The number to be converted to a Roman numeral must be in the 0 - 3999 range."
msgstr "Talet som ska omvandlas till romerska siffror måste ligga i området 0 - 3999."

#. from libreoffice:sc-messages
msgid "The more this value increases, the more the Roman numeral is simplified. The value must be in the 0 - 4 range."
msgstr "Ju högre värdet är desto mer förenklas de romerska siffrorna. Värdet måste ligga i området 0 -4."

#. from libreoffice:sc-messages
msgid "Calculates the value of a Roman numeral."
msgstr "Beräknar värdet av romerska siffror."

#. from libreoffice:sc-messages
msgid "The text that represents a Roman numeral."
msgstr "Texten som representerar en romersk siffra."

#. from libreoffice:sc-messages
msgid "Returns information about the environment."
msgstr "Returnerar information om miljön."

#. from libreoffice:sc-messages
msgid "Can be \"osversion\", \"system\", \"release\", \"numfile\", and \"recalc\"."
msgstr "Kan vara \"osversion\", \"system\", \"release\", \"numfile\" och \"recalc\"."

#. from libreoffice:sc-messages
msgid "Returns the numeric code for the first Unicode character in a text string."
msgstr "Returnerar den numeriska koden för det första Unicode-tecknet i en textsträng."

#. from libreoffice:sc-messages
msgid "This is the text for which the code of the first character is to be found."
msgstr "Är texten för vilken det första tecknets kod skall hittas."

#. from libreoffice:sc-messages
msgid "Converts a code number into a Unicode character or letter."
msgstr "Omvandlar ett kodtal till ett Unicode-tecken eller en Unicode-bokstav."

#. from libreoffice:sc-messages
msgid "The code value for the character."
msgstr "Kodvärdet för tecknet."

#. from libreoffice:sc-messages
msgid "Converts a value from one to another Euro currency."
msgstr "Konverterar ett belopp från en europeisk valuta till en annan."

#. from libreoffice:sc-messages
msgid "The value to be converted."
msgstr "Värdet som skall räknas om."

#. from libreoffice:sc-messages
msgid "From currency"
msgstr "Från valuta"

#. from libreoffice:sc-messages
msgid "ISO 4217 code of the currency from which is converted."
msgstr "ISO 4217-kod för valutan som konverteras."

#. from libreoffice:sc-messages
msgid "To currency"
msgstr "Till valuta"

#. from libreoffice:sc-messages
msgid "ISO 4217 code of the currency into which is converted."
msgstr "ISO 4217-kod för valutan som konverteras till."

#. from libreoffice:sc-messages
msgid "Full precision"
msgstr "Full precision"

#. from libreoffice:sc-messages
msgid "If omitted or 0 or FALSE, the result is rounded to the decimals of To_currency. Else the result is not rounded."
msgstr "Om utelämnat eller 0 eller FALSKT, avrundas resultatet till decimalerna för Till_valuta. Annars avrundas inte resultatet."

#. from libreoffice:sc-messages
msgid "Triangulation precision"
msgstr "Triangulations_precision"

#. from libreoffice:sc-messages
msgid "If given and >=3, the intermediate result of a triangular conversion is rounded to that precision. If omitted, the result is not rounded."
msgstr "Om ett värde har angetts och >=3, avrundas det mellanliggande resultatet i en triangulär konvertering med den exaktheten.  Om inget värde angetts avrundas inte resultatet."

#. from libreoffice:sc-messages
msgid "Converts text to a number, in a locale-independent way."
msgstr "Omvandlar ett text till tal oberoende av regionala inställningar."

#. from libreoffice:sc-messages
msgid "The text to be converted to a number."
msgstr "Texten som skall omvandlas till ett tal."

#. from libreoffice:sc-messages
msgid "Decimal separator"
msgstr "Decimalavskiljare"

#. from libreoffice:sc-messages
msgid "Defines the character used as the decimal separator."
msgstr "Anger vilket tecken som ska användas som decimalavskiljare."

#. from libreoffice:sc-messages
msgid "Group separator"
msgstr "Gruppavskiljare"

#. from libreoffice:sc-messages
msgid "Defines the character(s) used as the group separator."
msgstr "Anger vilka/vilket tecken som ska användas som gruppavskiljare."

#. from libreoffice:sc-messages
msgid "Bitwise \"AND\" of two integers."
msgstr "Bitvis \"OCH\" av två heltal."

#. from libreoffice:sc-messages
msgid "Bitwise \"OR\" of two integers."
msgstr "Bitvis \"ELLER\" av två heltal."

#. from libreoffice:sc-messages
msgid "Bitwise \"exclusive OR\" of two integers."
msgstr "Bitvis \"exklusiv ELLER\" av två heltal."

#. from libreoffice:sc-messages
msgid "Number1"
msgstr "Tal1"

#. from libreoffice:sc-messages
msgid "Positive integer less than 2^48."
msgstr "Positivt heltal mindre än 2^48."

#. from libreoffice:sc-messages
msgid "Number2"
msgstr "Tal2"

#. from libreoffice:sc-messages
msgid "Bitwise right shift of an integer value."
msgstr "Bitvis heltalsförskjutning åt höger."

#. from libreoffice:sc-messages
msgid "Bitwise left shift of an integer value."
msgstr "Bitvis heltalsförskjutning åt vänster."

#. from libreoffice:sc-messages
msgid "The value to be shifted. Positive integer less than 2^48."
msgstr "Värdet som ska förskjutas. Positivt heltal mindre än 2^48."

#. from libreoffice:sc-messages
msgid "The integer number of bits the value is to be shifted."
msgstr "Det antal bitar (i heltal) som värdet ska förskjutas."

#. from libreoffice:sc-messages
msgid "Calculates length of a text string, with DBCS"
msgstr "Beräknar en textsträngs längd, med DBCS"

#. from libreoffice:sc-messages
msgid "The text in which the length is to be determined."
msgstr "Texten vars längd bestäms."

#. from libreoffice:sc-messages
msgid "Returns the last character or characters of a text,with DBCS"
msgstr "Returnerar det sista tecknet eller tecknen i en text med DBCS"

#. from libreoffice:sc-messages
msgid "The text in which the end partial words are to be determined."
msgstr "Texten vars slutdelord skall bestämmas."

#. from libreoffice:sc-messages
msgid "The number of characters for the end text."
msgstr "Antalet tecken för slutdelordet."

#. from libreoffice:sc-messages
msgid "Returns the first character or characters of a text,with DBCS"
msgstr "Returnerar det första tecknet eller tecknen i en text med DBCS"

#. from libreoffice:sc-messages
msgid "The text where the initial partial words are to be determined."
msgstr "Texten vars begynnelsedelord bestäms."

#. from libreoffice:sc-messages
msgid "The number of characters for the start text."
msgstr "Antalet tecken för begynnelsedelordet."

#. from libreoffice:sc-messages
msgid "Returns a partial text string of a text, with DBCS"
msgstr "Returnerar en del av en text, med DBCS"

#. from libreoffice:sc-messages
msgid "The text in which partial words are to be determined."
msgstr "Texten vars delord bestäms."

#. from libreoffice:sc-messages
msgid "The position from which the part word is to be determined."
msgstr "Positionen från vilket delordet bestäms."

#. from libreoffice:sc-messages
msgid "The number of characters for the text."
msgstr "Antalet tecken för delordet."

#. from libreoffice:sc-messages
msgid "Apply an XPath expression to an XML document"
msgstr "Använd ett XPath-uttryck på ett XML-dokument"

#. from libreoffice:sc-messages
msgid "XML Document"
msgstr "XML-dokument"

#. from libreoffice:sc-messages
msgid "String containing a valid XML stream"
msgstr "Textsträng som innehåller en giltig XML-ström"

#. from libreoffice:sc-messages
msgid "XPath expression"
msgstr "XPath-uttryck"

#. from libreoffice:sc-messages
msgid "String containing a valid XPath expression"
msgstr "Textsträng som innehåller ett giltigt XPath-uttryck"

#. from libreoffice:sc-messages
msgid "Returns an implementation defined value representing a RGBA color"
msgstr "Returnerar ett implementationsdefinierat värde som representerar en RGBA-färg"

#. from libreoffice:sc-messages
msgid "Value of red"
msgstr "Andel rött"

#. from libreoffice:sc-messages
msgid "Value of green"
msgstr "Andel grönt"

#. from libreoffice:sc-messages
msgid "Value of blue"
msgstr "Andel blått"

#. from libreoffice:sc-messages
msgid "Value of alpha"
msgstr "Alfavärdet"

#. from libreoffice:sc-messages
msgid "Get some web-content from a URI."
msgstr "Få lite webbinnehåll från en URI."

#. from libreoffice:sc-messages
msgid "URI"
msgstr "URI"

#. from libreoffice:sc-messages
msgid "URI of the webservice"
msgstr "Webbtjänstens URI"

#. from libreoffice:sc-messages
msgid "Return a URL-encoded string."
msgstr "Returnera en URL-kodad sträng."

#. from libreoffice:sc-messages
msgid "A string to be URL-encoded"
msgstr "En textsträng som ska URL-kodas"

#. from libreoffice:sc-messages
msgid "Returns the error function."
msgstr "Returnerar felfunktionen."

#. from libreoffice:sc-messages
msgid "Returns the complementary error function."
msgstr "Returnerar den komplementära felfunktionen."

#. from libreoffice:sc-messages
msgid "Lower limit"
msgstr "Undre gräns"

#. from libreoffice:sc-messages
msgid "The lower limit for integration"
msgstr "Undre gräns för integration."

#. from libreoffice:sc-messages
msgid "Returns the subtraction of numbers. Like a-b-c but without eliminating small roundoff errors."
msgstr "Returnerar subtraktion av tal. Som a-b-c men utan att eliminera små avrundningsfel."

#. from libreoffice:sc-messages
msgid "Minuend"
msgstr "Minuend"

#. from libreoffice:sc-messages
msgid "Number from which following arguments are subtracted."
msgstr "Tal från vilket följande argument är subtraherade."

#. from libreoffice:sc-messages
msgid "Subtrahend "
msgstr "Subtrahend "

#. from libreoffice:sc-messages
msgid "Subtrahend 1, subtrahend 2, ... are numerical arguments subtracted from the minuend."
msgstr "Subtrahend 1, subtrahend 2, ... är numeriska argument subtraherade från minuenden."

#. from libreoffice:sc-messages
msgid "Rounds a number to predefined significant digits."
msgstr "Rundar av ett tal till fördefinierade signifikanta siffror."

#. from libreoffice:sc-messages
msgid "The number to be rounded."
msgstr "Talet som skall avrundas."

#. from libreoffice:sc-messages
msgid "Digits"
msgstr "Siffror"

#. from libreoffice:sc-messages
msgid "The number of significant digits to which value is to be rounded."
msgstr "Antalet signifikanta siffror till vilket värdet skall avrundas."

#. from libreoffice:sc-messages
msgid "Replaces characters within a text string with a different text string, with DBCS."
msgstr "Ersätter tecken i en textsträng med en annan textsträng, med DBCS."

#. from libreoffice:sc-messages
msgid "The text in which some characters are to be replaced."
msgstr "Texten där en del ersätts."

#. from libreoffice:sc-messages
msgid "The character position from which text is to be replaced."
msgstr "Teckenpositionen där ersättningen skall börja."

#. from libreoffice:sc-messages
msgid "The number of characters to be replaced."
msgstr "Antalet tecken som ersätts."

#. from libreoffice:sc-messages
msgid "New text"
msgstr "Ny text"

#. from libreoffice:sc-messages
msgid "The text to be inserted."
msgstr "Texten som ska infogas."

#. from libreoffice:sc-messages
msgid "Looks for a string of text within another (case sensitive), using byte positions."
msgstr "Söker efter en textsträng i en annan (skiftlägeskänslig) med hjälp av bitgruppositioner."

#. from libreoffice:sc-messages
msgid "Looks for a string of text within another (not case sensitive), using byte positions."
msgstr "Söker efter en textsträng i en annan (inte skiftlägeskänslig) med hjälp av bitgruppositioner."

#. from libreoffice:sc-messages
msgid "Find text"
msgstr "Sök text"

#. from libreoffice:sc-messages
msgid "The text to be found."
msgstr "Texten som söks."

#. from libreoffice:sc-messages
msgid "The text in which a search is to be made."
msgstr "Texten som det söks i."

#. from libreoffice:sc-messages
msgid "The position in the text from which the search starts."
msgstr "Positionen i texten varifrån sökningen sker."

#. from libreoffice:sc-messages
msgid "Computes the Discrete Fourier Transform (DFT) of an array"
msgstr "Beräknar Discrete Fourier Transform (DFT) på fält"

#. from libreoffice:sc-messages
msgid "The array whose DFT needs to be computed. The dimensions of this array can be Nx1 or Nx2 or 1xN or 2xN."
msgstr "Fältet vars DFT behöver beräknas. Dimensionerna på fältet kan vara Nx1 eller Nx2 eller 1xN eller 2xN."

#. from libreoffice:sc-messages
msgid "GroupedByColumns"
msgstr "Kolumn"

#. from libreoffice:sc-messages
msgid "Flag to indicate whether the array is grouped by columns or not (default TRUE)."
msgstr "Flagga för att indikera huruvida fältet är grupperat genom kolumner eller inte (standard SANT)"

#. from libreoffice:sc-messages
msgid "Flag to indicate whether an inverse DFT is to be computed (default FALSE)."
msgstr "Flagga för att indikera huruvida ett inverterat DFT ska beräknas (standard (FALSKT)"

#. from libreoffice:sc-messages
msgid "Polar"
msgstr "Polär"

#. from libreoffice:sc-messages
msgid "Flag to indicate whether to return the results in polar form (default FALSE)."
msgstr "Flagga för att indikera huruvida resultaten ska returneras i polär form (standard FALSKT)."

#. from libreoffice:sc-messages
msgid "MinimumMagnitude"
msgstr "Minsta storlek"

#. from libreoffice:sc-messages
msgid "In case of Polar=TRUE, the frequency components below this magnitude are clipped out (default 0.0)."
msgstr "Ifall polär=SANT, är frekvenskomponenterna under denna magnitud bortklippta (standard 0.0)."

#. from libreoffice:sc-messages
msgid "Returns a random number between 0 and 1, non-volatile."
msgstr "Returnerar ett slumpmässigt tal mellan 0 och 1, icke flyktig."

#. from libreoffice:sc-messages
msgid "Returns a random integer between the specified Bottom and Top values (both inclusive), non-volatile."
msgstr "Returnerar ett slumpmässigt heltal mellan de angivna botten- och toppvärdena (båda inklusive), icke-flyktigt."

#. from libreoffice:sc-messages
msgid "The smallest integer that can be returned."
msgstr "Det minsta heltal som kan returneras."

#. from libreoffice:sc-messages
msgid "The largest integer that can be returned."
msgstr "Det största heltal som kan returneras."

#. from libreoffice:sc-messages
msgid "Filters an array based on a Boolean (True/False) array."
msgstr "Filtrerar en matris baserat på en boolesk (Sann/Falsk) matris."

#. from libreoffice:sc-messages
msgid "The array, or range to filter."
msgstr "Matrisen eller intervallet som ska filtreras."

#. from libreoffice:sc-messages
msgid "A Boolean array whose height or width is the same as the array."
msgstr "En boolesk matris vars höjd eller bredd är densamma som matrisen."

#. from libreoffice:sc-messages
msgid "Result if empty"
msgstr "Resultat om tomt"

#. from libreoffice:sc-messages
msgid "The value to return if all values in the included array are empty (filter returns nothing)."
msgstr "Värdet som ska returneras om alla värden i den inkluderade matrisen är tomma (filtret returnerar ingenting)."

#. from libreoffice:sc-messages
msgid "Sorts the contents of a range or array."
msgstr "Sorterar innehållet i ett intervall eller matris."

#. from libreoffice:sc-messages
msgid "The range, or array to sort."
msgstr "Området eller matrisen som ska sorteras."

#. from libreoffice:sc-messages
msgid "Sort index"
msgstr "Sorteringsindex"

#. from libreoffice:sc-messages
msgid "A number indicating the row or column to sort by."
msgstr "En siffra som anger raden eller kolumnen att sortera efter."

#. from libreoffice:sc-messages
msgid "A number indicating the desired sort order; 1 for ascending order (default), -1 for descending order."
msgstr "En siffra som anger önskad sorteringsordning; 1 för stigande ordning (standard), -1 för fallande ordning."

#. from libreoffice:sc-messages
msgid "A logical value indicating the desired sort direction; FALSE to sort by row (default), TRUE to sort by column."
msgstr "Ett logiskt värde som indikerar den önskade sorteringsriktningen; FALSK för att sortera efter rad (standard), SANN för att sortera efter kolumn."

#. from libreoffice:sc-messages
msgid "Sorts the contents of a range or array based on the values in a corresponding range or array."
msgstr "Sorterar innehållet i ett intervall eller matris baserat på värdena i ett motsvarande intervall eller matris."

#. from libreoffice:sc-messages
msgid "Sort range"
msgstr "Sorteringsintervall"

#. from libreoffice:sc-messages
msgid "The array or range to sort."
msgstr "Matrisen eller intervallet som ska sorteras."

#. from libreoffice:sc-messages
msgid "Sort by range "
msgstr "Sortera efter intervall "

#. from libreoffice:sc-messages
msgid "Range 1, range 2,... are the arrays or ranges to sort on."
msgstr "Område 1, område 2,... är de matriser eller områden att sortera på."

#. from libreoffice:sc-messages
msgid "Sort order "
msgstr "Sorteringsordning "

#. from libreoffice:sc-messages
msgid "Order 1, order 2,... are the orders to use for sorting. 1 for ascending, -1 for descending. Default is ascending."
msgstr "Följd 1, följd 2,... är den ordning som ska användas för sortering. 1 för stigande, -1 för fallande. Standard är stigande."

#. from libreoffice:sc-messages
msgid "Generates a list of sequential numbers in an array, such as 1, 2, 3, 4."
msgstr "Genererar en lista med sekventiella nummer i en matris, till exempel 1, 2, 3, 4."

#. from libreoffice:sc-messages
msgid "The first number in the sequence."
msgstr "Den första numret i sekvensen."

#. from libreoffice:sc-messages
msgid "Step"
msgstr "Steg"

#. from libreoffice:sc-messages
msgid "The amount to increment each subsequent value in the array."
msgstr "Mängden som ska öka varje efterföljande värde i matrisen."

#. from libreoffice:sc-messages
msgid "Generates an array of random numbers between two limit values."
msgstr "Genererar en matris med slumpmässiga tal mellan två gränsvärden."

#. from libreoffice:sc-messages
msgid "The number of rows to return."
msgstr "Antalet rader som ska returneras."

#. from libreoffice:sc-messages
msgid "The number of columns to return."
msgstr "Antalet kolumner som ska returneras."

#. from libreoffice:sc-messages
msgid "The lower limit of the generated numbers."
msgstr "Den nedre gränsen för de genererade siffrorna."

#. from libreoffice:sc-messages
msgid "The upper limit of the generated numbers."
msgstr "Den övre gränsen för de genererade siffrorna."

#. from libreoffice:sc-messages
msgid "Return integer (TRUE) or decimal (FALSE) values."
msgstr "Returnera heltalsvärden (TRUE) eller decimalvärden (FALSE)."

#. from libreoffice:sc-messages
msgid "Returns the specified columns from an array."
msgstr "Returnerar de angivna kolumnerna från en matris."

#. from libreoffice:sc-messages
msgid "The array containing the columns to be returned in the new array."
msgstr "Matrisen som innehåller kolumnerna som ska returneras i den nya matrisen."

#. from libreoffice:sc-messages
msgid "Column "
msgstr "Kolumn "

#. from libreoffice:sc-messages
msgid "Column 1, Column 2,... The list of column numbers to be returned."
msgstr "Kolumn 1, Kolumn 2,... Listan över kolumnnummer som ska returneras."

#. from libreoffice:sc-messages
msgid "Returns the specified rows from an array."
msgstr "Returnerar de angivna raderna från en matris."

#. from libreoffice:sc-messages
msgid "The array containing the rows to be returned in the new array."
msgstr "Matrisen som innehåller raderna som ska returneras i den nya matrisen."

#. from libreoffice:sc-messages
msgid "Row "
msgstr "Rad "

#. from libreoffice:sc-messages
msgid "Row 1, Row 2,... The list of row numbers to be returned."
msgstr "Rad 1, Rad 2,... Listan över radnummer som ska returneras."

#. from libreoffice:sc-messages
msgid "Excludes a specified number of contiguous rows or columns from the start or end of an array."
msgstr "Exkluderar ett specificerat antal sammanhängande rader eller kolumner från början eller slutet av en matris."

#. from libreoffice:sc-messages
msgid "The array from which to drop rows or columns."
msgstr "Matrisen från vilken rader eller kolumner ska exkluderas."

#. from libreoffice:sc-messages
msgid "The number of rows to drop. A negative value drops from the end of the array."
msgstr "Antalet rader som ska exkluderas. Ett negativt värde tar bort från slutet av matrisen."

#. from libreoffice:sc-messages
msgid "The number of columns to drop. A negative value drops from the end of the array."
msgstr "Antalet kolumner som ska exkluderas. Ett negativt värde tar bort från slutet av matrisen."

#. from libreoffice:sc-messages
msgid "Expands or pads an array to specified row and column dimensions."
msgstr "Expanderar eller fyller ut en matris till specificerade rad- och kolumndimensioner."

#. from libreoffice:sc-messages
msgid "The array to expand."
msgstr "Matrisen att expandera."

#. from libreoffice:sc-messages
msgid "The number of rows in the expanded array. If missing, rows will not be expanded."
msgstr "Antalet rader i den expanderade matrisen. Om det saknas kommer raderna inte att utökas."

#. from libreoffice:sc-messages
msgid "The number of columns in the expanded array. If missing, columns will not be expanded."
msgstr "Antalet kolumner i den expanderade matrisen. Om det saknas kommer kolumner inte att utökas."

#. from libreoffice:sc-messages
msgid "Appends arrays horizontally to create a larger array."
msgstr "Lägger till matriser horisontellt för att skapa en större matris."

#. from libreoffice:sc-messages
msgid "Array 1, Array 2,... The following arrays to append. If an array has fewer rows, #N/A error will be returned in the additional rows."
msgstr "Matris 1, Matris 2,... Följande matriser ska läggas till. Om en matris har färre rader kommer #N/A-felet att returneras i de ytterligare raderna."

#. from libreoffice:sc-messages
msgid "Appends arrays vertically to create a larger array."
msgstr "Lägger till matriser vertikalt för att skapa en större matris."

#. from libreoffice:sc-messages
msgid "The first array to append."
msgstr "Den första matrisen som ska läggas till."

#. from libreoffice:sc-messages
msgid "Array 1, Array 2,... The following arrays to append. If an array has fewer columns, #N/A error will be returned in the additional columns."
msgstr "Matris 1, Matris 2,... Följande matriser ska läggas till. Om en matris har färre kolumner kommer #N/A-felet att returneras i de ytterligare kolumnerna."

#. from libreoffice:sc-messages
msgid "Returns a specified number of contiguous rows or columns from the start or end of an array."
msgstr "Returnerar ett angivet antal sammanhängande rader eller kolumner från början eller slutet av en matris."

#. from libreoffice:sc-messages
msgid "The array from which to take rows or columns."
msgstr "Matrisen från vilken rader eller kolumner ska tas från."

#. from libreoffice:sc-messages
msgid "The number of rows to take. A negative value takes from the end of the array."
msgstr "Antal rader som ska tas. Ett negativt värde tar från slutet av matrisen."

#. from libreoffice:sc-messages
msgid "The number of columns to take. A negative value takes from the end of the array."
msgstr "Antalet kolumner som ska tas. Ett negativt värde tar från slutet av matrisen."

#. from libreoffice:sc-messages
msgid "Returns the text that occurs after a given substring or delimiter."
msgstr "Returnerar texten som förekommer efter en given delsträng eller avgränsare."

#. from libreoffice:sc-messages
msgid "The instance of the delimiter after which to extract text. The default is 1. A negative number starts searching from the end."
msgstr "Instansen av avgränsaren efter vilken text ska extraheras. Standardvärdet är 1. Ett negativt tal börjar söka från slutet."

#. from libreoffice:sc-messages
msgid "Returns the text that occurs before a given substring or delimiter."
msgstr "Returnerar texten som förekommer före en given delsträng eller avgränsare."

#. from libreoffice:sc-messages
msgid "The original text."
msgstr "Originaltexten."

#. from libreoffice:sc-messages
msgid "Delimiter"
msgstr "Avgränsare"

#. from libreoffice:sc-messages
msgid "The delimiter. Multiple delimiters can be supplied."
msgstr "Avgränsare. Flera avgränsare kan anges."

#. from libreoffice:sc-messages
msgid "Instance Number"
msgstr "Instansnummer"

#. from libreoffice:sc-messages
msgid "The instance of the delimiter before which to extract text. The default is 1. A negative number starts searching from the end."
msgstr "Instansen av avgränsaren före vilken text ska extraheras. Standardvärdet är 1. Ett negativt tal börjar söka från slutet."

#. from libreoffice:sc-messages
msgid "Match Mode"
msgstr "Matchningsläge"

#. from libreoffice:sc-messages
msgid "Match End"
msgstr "Slut på match"

#. from libreoffice:sc-messages
msgid "Set to 1 to treat the end of text as a delimiter. The default is 0."
msgstr "Ställ in på 1 för att behandla slutet av texten som en avgränsare. Standardvärdet är 0."

#. from libreoffice:sc-messages
msgid "If Not Found"
msgstr "Om den inte hittas"

#. from libreoffice:sc-messages
msgid "The value returned if no match is found. The default is #N/A."
msgstr "Värdet som returneras om ingen matchning hittas. Standardvärdet är #N/A."

#. from libreoffice:sc-messages
msgid "Splits text by a given delimiter to an array of multiple cells."
msgstr "Delar text med ett givet avgränsningstecken till en matris med flera celler."

#. from libreoffice:sc-messages
msgid "The text to split."
msgstr "Texten som ska delas."

#. from libreoffice:sc-messages
msgid "Column Delimiter"
msgstr "Kolumnavgränsare"

#. from libreoffice:sc-messages
msgid "The text to delimit the columns. Multiple delimiters can be supplied."
msgstr "Texten som avgränsar kolumnerna. Flera avgränsare kan anges."

#. from libreoffice:sc-messages
msgid "Row Delimiter"
msgstr "Radavgränsare"

#. from libreoffice:sc-messages
msgid "The text to delimit the rows. Multiple delimiters can be supplied."
msgstr "Texten som avgränsar raderna. Flera avgränsare kan anges."

#. from libreoffice:sc-messages
msgid "Ignore Empty"
msgstr "Ignorera tomma"

#. from libreoffice:sc-messages
msgid "Set to TRUE to ignore consecutive delimiters otherwise it creates an empty cell. The default is FALSE."
msgstr "Sätt till SANT för att ignorera efterföljande avgränsare, annars skapas en tom cell. Standardvärdet är FALSKT."

#. from libreoffice:sc-messages
msgid "Match mode"
msgstr "Matchningsläge"

#. from libreoffice:sc-messages
msgid "Set to 1 to perform a case-insensitive match. The default is 0."
msgstr "Ställ in på 1 för att utföra en skiftlägeskänslig matchning. Standardinställningen är 0."

#. from libreoffice:sc-messages
msgid "Transforms an array into a single column."
msgstr "Omvandlar en matris till en enda kolumn."

#. from libreoffice:sc-messages
msgid "The range or array to return as a single column."
msgstr "Området eller matrisen som ska returneras som en enda kolumn."

#. from libreoffice:sc-messages
msgid "transforms an array into a single row."
msgstr "Omvandlar en matris till en enda rad."

#. from libreoffice:sc-messages
msgid "The range or array to return as a single row."
msgstr "Området eller matrisen som ska returneras som en enda rad."

#. from libreoffice:sc-messages
msgid "Whether to ignore certain types of values. 0 or omitted - keep all values (default). 1 - ignore blank cells. 2 - ignore cells with error. 3 - ignore blanks cells and cells with error."
msgstr "Om man ska ignorera vissa typer av värden. 0 eller utelämnad - behåll alla värden (standard). 1 - ignorera tomma celler. 2 - ignorera celler med fel. 3 - ignorera tomma celler och celler med fel."

#. from libreoffice:sc-messages
msgid "Scan by column"
msgstr "Skanna efter kolumn"

#. from libreoffice:sc-messages
msgid "Scan the array by column. FALSE or omitted (default) - the array is scanned by row. TRUE - the array is scanned by column."
msgstr "Skanna matrisen efter kolumn. FALSE eller utelämnad (standard) - matrisen skannas efter rad. TRUE - matrisen skannas efter kolumn."

#. from libreoffice:sc-messages
msgid "Returns a list of unique values from a range or array."
msgstr "Returnerar en lista med unika värden från ett intervall eller en matris."

#. from libreoffice:sc-messages
msgid "The range or array from which to return unique values."
msgstr "Området eller matrisen från vilken unika värden ska returneras."

#. from libreoffice:sc-messages
msgid "By col"
msgstr "Efter kolumn"

#. from libreoffice:sc-messages
msgid "Logical value indicating how to compare data: TRUE - compares data across columns. FALSE or omitted (default) - compares data across rows."
msgstr "Logiskt värde som indikerar hur data jämförs: SANN - jämför data mellan kolumner. FALSK eller utelämnad (standard) - jämför data mellan rader."

#. from libreoffice:sc-messages
msgid "Uniqueness"
msgstr "Unikhet"

#. from libreoffice:sc-messages
msgid "Logical value that defines what values are considered unique: TRUE - returns values that occur only once. FALSE or omitted (default) - returns all distinct (different) values in the range or array."
msgstr "Logiskt värde som definierar vilka värden som anses vara unika: SANN - returnerar värden som bara förekommer en gång. FALSK eller utelämnad (standard) - returnerar alla distinkta (olika) värden i intervallet eller matrisen."

#. from libreoffice:sc-messages
msgid "The LET function assigns names to calculation results. This allows storing intermediate calculations, values, or defining names inside a formula. These names only apply within the scope of the LET function."
msgstr "LET-funktionen tilldelar beräkningsresultat namn. Detta gör det möjligt att lagra mellanliggande beräkningar, värden eller definiera namn i en formel. Dessa namn gäller endast inom ramen för LET-funktionen."

#. from libreoffice:sc-messages
msgid "Name 1"
msgstr "Namn 1"

#. from libreoffice:sc-messages
msgid "The first name to assign. Must start with a letter. Cannot be the output of a formula or conflict with range syntax."
msgstr "Det första namnet att tilldela. Måste börja med en bokstav. Kan inte vara resultatet av en formel eller konflikt med intervallsyntaxen."

#. from libreoffice:sc-messages
msgid "Name value "
msgstr "Namnvärde "

#. from libreoffice:sc-messages
msgid "Name value 1, Name value 2,... The value or calculation to assign to Name."
msgstr "Namnvärde 1, Namnvärde 2,... Värdet eller beräkningen att tilldela Namn."

#. from libreoffice:sc-messages
msgid "Calculation or Name "
msgstr "Beräkning eller namn "

#. from libreoffice:sc-messages
msgid "A calculation that uses all names within the LET function. This must be the last argument in the LET function. Or a second Name to assign to a second Name value. If a second Name is specified, Name value 2 and Calculation or Name 3 become required."
msgstr "En beräkning som använder alla namn inom LET-funktionen. Detta måste vara det sista argumentet i LET-funktionen. Eller ett andra namn att tilldela ett andra namnvärde. Om ett andra namn anges krävs namnvärde 2 och beräkning eller namn 3."

#. from libreoffice:sc-messages
msgid "Wraps the provided row or column of values by columns after a specified number of elements to form a new array."
msgstr "Bryter den angivna raden eller kolumnen med värden efter kolumner efter ett angivet antal element för att bilda en ny matris."

#. from libreoffice:sc-messages
msgid "The maximum number of values for each column."
msgstr "Det maximala antalet värden för varje kolumn."

#. from libreoffice:sc-messages
msgid "Wraps the provided row or column of values by rows after a specified number of elements to form a new array."
msgstr "Bryter den angivna raden eller kolumnen med värden efter rader efter ett angivet antal element för att bilda en ny matris."

#. from libreoffice:sc-messages
msgid "the range to wrap."
msgstr "området som ska brytas."

#. from libreoffice:sc-messages
msgid "Wrap count"
msgstr "Antal brytningar"

#. from libreoffice:sc-messages
msgid "The maximum number of values for each row."
msgstr "Det maximala antalet värden för varje rad."

