msgid "Uses the selected cells as the data source for the pivot table."
msgstr "Använder de markerade cellerna som datakälla för pivottabellen."

#. from libreoffice:sc-messages
msgid "_Data source registered in Calc"
msgstr "_Datakälla registrerad i Calc"

