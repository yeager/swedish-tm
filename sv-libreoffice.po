#. from libreoffice:sbasic-shared
msgid "<bookmark_value>LBound function</bookmark_value>"
msgstr "<bookmark_value>Lbound, funktion </bookmark_value>"

#. from libreoffice:sbasic-shared
msgid "Returns the lower boundary of an array."
msgstr "Returnerar den nedre gränsen för en matris."

#. from libreoffice:sbasic-shared
msgid "LBound (ArrayName [, Dimension])"
msgstr "LBound (ArrayName [, Dimension])"

#. from libreoffice:sbasic-shared
msgid "<emph>ArrayName:</emph> Name of the array for which you want to return the upper (<emph>Ubound</emph>) or the lower (<emph>LBound</emph>) boundary of the array dimension."
msgstr "<emph>ArrayName:</emph> Namnet på den matris för vars dimensioner du vill returnera den övre (<emph>Ubound</emph>) eller nedre (<emph>LBound</emph>) gränsen."

#. from libreoffice:sbasic-shared
msgid "<emph>[Dimension]:</emph> Integer that specifies which dimension to return the upper (<emph>Ubound</emph>) or the lower (<emph>LBound</emph>) boundary for. If a value is not specified, the first dimension is assumed."
msgstr "<emph>[Dimension]:</emph> Heltal som anger för vilken dimension den övre (<emph>Ubound</emph>) eller nedre (<emph>LBound</emph>) gränsen ska returneras. Om inget värde anges väljs automatiskt den första dimensionen."

#. from libreoffice:sbasic-shared
msgid "<bookmark_value>UBound function</bookmark_value>"
msgstr "<bookmark_value>Ubound, funktion</bookmark_value>"

#. from libreoffice:sbasic-shared
msgid "Returns the upper boundary of an array."
msgstr "Returnerar en matris övre gräns."

#. from libreoffice:sbasic-shared
msgid "UBound (ArrayName [, Dimension])"
msgstr "UBound (MatrisNamn [, Dimension])"

#. from libreoffice:sbasic-shared
msgid "<emph>ArrayName:</emph> Name of the array for which you want to determine the upper (<emph>Ubound</emph>) or the lower (<emph>LBound</emph>) boundary."
msgstr "<emph>ArrayName:</emph> Den matris vars övre begränsning (<emph>UBound</emph>) eller undre begränsning (<emph>LBound</emph>) ska returneras."

#. from libreoffice:sbasic-shared
msgid "<emph>[Dimension]:</emph> Integer that specifies which dimension to return the upper(<emph>Ubound</emph>) or lower (<emph>LBound</emph>) boundary for. If no value is specified, the boundary of the first dimension is returned."
msgstr "<emph>[Dimension]:</emph> Heltal som anger i vilken dimension den övre (<emph>UBound</emph>) resp. nedre (<emph>LBound</emph>) begränsningen ska kontrolleras. Om värdet utelämnas returneras begränsningen för den första dimensionen."

