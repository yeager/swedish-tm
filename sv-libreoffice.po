msgid "Ignores empty fields in the data source."
msgstr "Ignorera tomma fält i datakällan."

#. from libreoffice:sc-messages
msgid "Identify categories"
msgstr "Identifiera kategorier"

#. from libreoffice:sc-messages
msgid "Automatically assigns rows without labels to the category of the row above."
msgstr "Tilldelar automatiskt rader utan etiketter till kategorin för raden ovanför."

#. from libreoffice:sc-messages
msgid "Show totals row"
msgstr "Visa totalraden"

#. from libreoffice:sc-messages
msgid "Calculates and displays the grand total of the row calculation."
msgstr "Beräknar och visar totalsumman för radberäkningen."

#. from libreoffice:sc-messages
msgid "Show totals column"
msgstr "Visa totalkolumnen"

#. from libreoffice:sc-messages
msgid "Calculates and displays the grand total of the column calculation."
msgstr "Beräknar och visar totalsumman för kolumnberäkningen."

#. from libreoffice:sc-messages
msgid "Add filter"
msgstr "Lägg till filter"

#. from libreoffice:sc-messages
msgid "Adds a Filter button to pivot tables that are based on spreadsheet data."
msgstr "Lägger till en filterknapp i pivottabeller som baseras på kalkylbladsdata."

#. from libreoffice:sc-messages
msgid "Enable drill to details"
msgstr "Aktivera nedbrytning till detaljer"

#. from libreoffice:sc-messages
msgid "Select this check box and double-click an item label in the table to show or hide details for the item. Clear this check box and double-click a cell in the table to edit the contents of the cell."
msgstr "Markera den här kryssrutan och dubbelklicka på en objektetikett i tabellen om du vill visa eller dölja information om objektet. Avmarkera kryssrutan och dubbelklicka i cellen i tabellen om du vill redigera cellens innehåll."

#. from libreoffice:sc-messages
msgid "Show expand/collapse buttons"
msgstr "Visa expandera/komprimera knappar"

#. from libreoffice:sc-messages
