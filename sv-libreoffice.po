msgstr "Välj <emph>Verktyg - guiden Kopplad utskrift</emph>"

#. from libreoffice:swriter-01
msgid "During printing, the database information replaces the corresponding database fields (placeholders). For more information about inserting database fields refer to the <link href=\"text/swriter/01/04090006.xhp\"><emph>Database</emph></link> tab page under <emph>Insert - Field - More Fields</emph>."
msgstr "Databasinformationen infogas först vid utskriften vid databasfältkommandonas (platshållarnas) positioner. Information om att infoga databasfältkommandon finns under <emph>Infoga - Fältkommando - Andra</emph> under fliken <link href=\"text/swriter/01/04090006.xhp\">Databas</link>."

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".\" visibility=\"hidden\">Select a database and table.</ahelp>"
msgstr "<ahelp hid=\".\" visibility=\"hidden\">Välj databas och tabell.</ahelp>"

#. from libreoffice:swriter-01
msgid "Determines the number of records for printing the form letter. One letter will be printed for each record."
msgstr "Bestämmer antalet utskriftsposter för standardbrevet. Ett brev skrivs ut för varje post."

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/mailmerge/all\">Processes all the records from the database.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/mailmerge/all\">Bearbetar alla poster från databasen.</ahelp>"

#. from libreoffice:swriter-01
msgid "Selected records"
msgstr "Markerade dataposter"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/mailmerge/selected\">Processes only the marked records from the database. This option is only available when you have previously marked the necessary records in the database.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/mailmerge/selected\">Bearbetar endast de markerade posterna från databasen. Det här alternativet är bara tillgängligt om du har markerat de nödvändiga posterna i databasen.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".\">Specify the number of the first record to be printed.</ahelp>"
msgstr "<ahelp hid=\".\">Ange numret på den första post som ska skrivas ut.</ahelp>"

#. from libreoffice:swriter-01
msgid "To:"
msgstr "Till:"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/mailmerge/to\">Specify the number of the last record to be printed.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/mailmerge/to\">Ange numret på den sista post som ska skrivas ut.</ahelp>"

#. from libreoffice:swriter-01
msgid "Determines whether to send your form letters to a printer or save them to a file."
msgstr "Anger om standardbrev ska skickas till en skrivare eller sparas som en fil."

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/mailmerge/printer\">Prints the form letters.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/mailmerge/printer\">Skriver ut standardbreven.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/mailmerge/file\">Saves the form letters in files.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/mailmerge/file\">Sparar standardbreven i filer.</ahelp>"

#. from libreoffice:swriter-01
msgid "Save as single document"
msgstr "Spara som ett enda dokument"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".\">Create one big document containing all data records.</ahelp>"
msgstr "<ahelp hid=\".\">Skapa ett stort dokument som innehåller alla dataposter</ahelp>"

#. from libreoffice:swriter-01
msgid "Save as individual documents"
msgstr "Spara som enskilda dokument"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".\">Create one document for every one data record.</ahelp>"
msgstr "<ahelp hid=\".\">Skapa ett dokument för varje datapost.</ahelp>"

#. from libreoffice:swriter-01
msgid "Generate file name from database"
msgstr "Skapa filnamn från databas"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".\">Generate each file name from data contained in a database.</ahelp>"
msgstr "<ahelp hid=\".\">Skapa varje filnamn från data som finns i en databas.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/mailmerge/field\">Uses the content of the selected database field as the file name for the form letter.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/mailmerge/field\">Använder innehållet i det markerade databasfältet som filnamn för standardbrevet.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/mailmerge/path\">Specifies the path to store the form letters.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/mailmerge/path\">Anger var standardbreven ska sparas.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/mailmerge/pathpb\">Opens the<emph> Select Path </emph>dialog.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/mailmerge/pathpb\">Öppnar dialogrutan <emph>Välj ut sökväg</emph>.</ahelp>"

#. from libreoffice:swriter-01
msgid "File format"
msgstr "Filformat"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".\">Select the file format to store the resulting document.</ahelp>"
msgstr "<ahelp hid=\".\">Välj filformat för att lagra det resulterande dokumentet.</ahelp>"

#. from libreoffice:swriter-01
msgid "Outline to Presentation"
msgstr "Disposition till presentation"

#. from libreoffice:swriter-01
msgid "<link href=\"text/swriter/01/01160100.xhp\">Outline to Presentation</link>"
msgstr "<link href=\"text/swriter/01/01160100.xhp\">Disposition till presentation</link>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".uno:SendOutlineToStarImpress\">Sends the outline of the active document to a new presentation document.</ahelp>"
msgstr "<ahelp hid=\".uno:SendOutlineToStarImpress\">Skickar dispositionen för det aktiva dokumentet till ett nytt presentationsdokument.</ahelp>"

#. from libreoffice:swriter-01
msgid "Outline to Clipboard"
msgstr "Disposition till urklipp"

#. from libreoffice:swriter-01
msgid "<link href=\"text/swriter/01/01160200.xhp\">Outline to Clipboard</link>"
msgstr "<link href=\"text/swriter/01/01160200.xhp\">Disposition till urklipp</link>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".uno:SendOutlineToClipboard\">Sends the outline of a document to the clipboard in Rich Text Format (RTF).</ahelp>"
msgstr "<ahelp hid=\".uno:SendOutlineToClipboard\">Skickar dokumentdispositionen till urklipp i RTF-format.</ahelp>"

#. from libreoffice:swriter-01
msgid "<link href=\"text/swriter/01/01160300.xhp\">Create AutoAbstract</link>"
msgstr "<link href=\"text/swriter/01/01160300.xhp\">Skapa AutoUtdrag</link>"

#. from libreoffice:swriter-01
msgid "<variable id=\"autoabstracttext\"><ahelp hid=\".uno:CreateAbstract\">Copies the headings and a number of subsequent paragraphs in the active document to a new AutoAbstract text document. An AutoAbstract is useful for obtaining an overview of long documents.</ahelp> You can specify the number of outline levels as well as the number of paragraphs displayed therein. All levels and paragraphs under the respective settings are hidden.</variable>"
msgstr "<variable id=\"autoabstracttext\"><ahelp hid=\".uno:CreateAbstract\">Kopierar rubrikerna och ett antal efterföljande stycken i det aktiva dokumentet till ett nytt AutoAbstract-textdokument. Ett AutoAbstract är användbart för att få en översikt över långa dokument.</ahelp> Du kan ange antalet rubriknivåer samt antalet stycken som visas i det. Alla nivåer och stycken under respektive inställningar är dolda.</variable>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/abstractdialog/outlines\">Enter the extent of the outline levels to be copied to the new document.</ahelp> For example, if you choose 4 levels, all paragraphs formatted with Heading 1 to Heading 4 are included, along with the number of subsequent paragraphs specified in <emph>Subpoints per Level</emph>."
msgstr "<ahelp hid=\"modules/swriter/ui/abstractdialog/outlines\">Ange hur många dispositionsnivåer som ska kopieras till det nya dokumentet.</ahelp> Om du till exempel väljer fyra nivåer inkluderas alla stycken med formateringen Rubrik 1 till Rubrik 4 samt det antal understycken som angetts i <emph>Understycken per nivå</emph>."

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/abstractdialog/paras\">Specify the maximum number of consecutive paragraphs to be included in the AutoAbstract document after each heading.</ahelp> All of the paragraphs up to the maximum defined are included until the next paragraph with a Heading Style is reached."
msgstr "<ahelp hid=\"modules/swriter/ui/abstractdialog/paras\">Ange det högsta antalet stycken i följd som ska inkluderas i AutoUtdrag dokumentet efter varje rubrik.</ahelp> Alla stycken upp till det högsta antal som angetts inkluderas till nästa stycke med en styckeformatmall för rubriker nåtts."

#. from libreoffice:swriter-01
msgid "AutoAbstract to Presentation"
msgstr "AutoUtdrag till presentation"

#. from libreoffice:swriter-01
msgid "<link href=\"text/swriter/01/01160400.xhp\">AutoAbstract to Presentation</link>"
msgstr "<link href=\"text/swriter/01/01160400.xhp\">AutoUtdrag till presentation</link>"

#. from libreoffice:swriter-01
msgid "Included Outline Levels"
msgstr "Inkluderade kapitelnivåer"

#. from libreoffice:swriter-01
msgid "Enter the number of outline levels to include in the new presentation. For example, if you choose one level, only the paragraphs that follow the \"Heading 1\" paragraph style are included."
msgstr "Ange antalet kapitelnivåer som ska ingå i den nya presentationen. Om du t.ex. väljer en nivå så ingår bara de stycken som är formaterade med styckeformatmallen Rubrik 1."

#. from libreoffice:swriter-01
msgid "Enter the number of paragraphs that you want to include below each outline level (heading)."
msgstr "Ange hur många stycken som du vill ha under varje kapitelnivå (rubrik)."

#. from libreoffice:swriter-01
msgid "Consecutive numbers are added to the file name if more than one HTML document is created. The titles of the HTML pages are created from the topmost chapter heading."
msgstr "Om mer än ett HTML dokument skapas så läggs numrering i ordningsföljd till i filnamnet. HTML-sidornas titlar skapas från den översta kapitelrubriken."

#. from libreoffice:swriter-01
msgid "File type"
msgstr "Filtyp"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".\" visibility=\"hidden\">Switches between master view and normal view if a master document is open.</ahelp> Switches between <link href=\"text/shared/01/02110000.xhp\">master view</link> and normal view if a <link href=\"text/shared/01/01010001.xhp\">master document</link> is open."
msgstr "<ahelp hid=\".\" visibility=\"hidden\">Växlar mellan samlingsläget och den normala vyn om ett samlingsdokument är öppet.</ahelp> Växlar mellan <link href=\"text/shared/01/02110000.xhp\">samlingsläget</link> och den normala vyn om ett <link href=\"text/shared/01/01010001.xhp\">samlingsdokument</link> är öppet."

#. from libreoffice:swriter-01
msgid "Anchor <-> Text"
msgstr "Ankare <-> Text"

#. from libreoffice:swriter-01
msgid "List box on/off"
msgstr "Urvalsbox på/av"

#. from libreoffice:swriter-01
msgid "To quickly reorder headings and their associated text in your document, select the \"Headings\" category in the list, and then click the<emph> Content View</emph> icon. Now you can use drag-and-drop to reorder contents."
msgstr "Om du snabbt vill ändra ordningen mellan rubriker och den text som hör till dem i dokumentet, kan du välja kategorin \"Rubriker\" i listan och klicka på ikonen <emph>Växla innehållsvisning</emph>. Nu kan du ändra ordningen på innehållet."

#. from libreoffice:swriter-01
msgid "Drag mode"
msgstr "Draläge"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"HID_NAVI_DRAG_HYP\">Creates a hyperlink when you drag and drop an item into the current document. Click the hyperlink in the document to jump to the item that the hyperlink points to.</ahelp>"
msgstr "<ahelp hid=\"HID_NAVI_DRAG_HYP\">Skapar en hyperlänk när du drar och släpper ett objekt i det aktuella dokumentet. Om du klickar på hyperlänken i dokumentet går du till det objekt som hyperlänken pekar på.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"HID_NAVI_DRAG_LINK\">Inserts the selected item as a link where you drag and drop in the current document. Text is inserted as protected sections. The contents of the link are automatically updated when the source is changed. To manually update the links in a document, choose <emph>Tools - Update - Links</emph>. You cannot create links for graphics, OLE objects, references and indexes.</ahelp>"
msgstr "<ahelp hid=\"HID_NAVI_DRAG_LINK\">Infogar det markerade objektet som en länk där du drar och släpper objektet i dokumentet. Text infogas som skyddade områden. Innehållet i länken uppdateras automatiskt om källan ändras. Du kan uppdatera länkarna i ett dokument automatiskt genom att välja <emph>Verktyg - Uppdatera - Länkar</emph>. Det går inte att skapa länkar för grafik, OLE-objekt, referenser och förteckningar.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"HID_NAVI_DRAG_COPY\">Inserts a copy of the selected item where you drag and drop in the current document. You cannot drag and drop copies of graphics, OLE objects, references and indexes.</ahelp>"
msgstr "<ahelp hid=\"HID_NAVI_DRAG_COPY\">Infogar en kopia av det markerade objektet där du drar och släpper objektet i dokumentet. Det går inte att dra och släppa kopior av bilder, OLE-objekt, referenser och förteckningar.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"HID_NAVIGATOR_LISTBOX\">Lists the names of all open text documents. To view the contents of a document in the Navigator window, select the name of the document in the list. The current document displayed in the Navigator is indicated by the word \"active\" after its name in the list.</ahelp>"
msgstr "<ahelp hid=\"HID_NAVIGATOR_LISTBOX\">Visar namnen på alla öppna textdokument. Om du vill visa innehållet i ett dokument i Navigator-fönstret, markerar du namnet på dokument i listan. Det aktuella dokumentet visas i listan med ordet \"aktiv\" efter namnet.</ahelp>"

#. from libreoffice:swriter-01
msgid "<bookmark_value>searching; repeating a search</bookmark_value>"
msgstr "<bookmark_value>Söka; upprepa en sökning</bookmark_value>"

#. from libreoffice:swriter-01
msgid "<link href=\"text/swriter/01/02120000.xhp\">AutoText</link>"
msgstr "<link href=\"text/swriter/01/02120000.xhp\">AutoText</link>"

#. from libreoffice:swriter-01
msgid "<variable id=\"autotexttext\"><ahelp hid=\".uno:EditGlossary\">Creates, edits, or inserts AutoText. You can store formatted text, text with graphics, tables, and fields as AutoText. To quickly insert AutoText, type the shortcut for the AutoText in your document, and then press F3.</ahelp></variable>"
msgstr "<variable id=\"autotexttext\"><ahelp hid=\".uno:EditGlossary\">Skapar, ändrar eller infogar autotext. Du kan lagra formaterad text, text med grafik, tabeller och fält som autotext. Om du snabbt vill använda en autotext-post, skriver du förkortningen för posten i dokumentet och trycker på F3.</ahelp></variable>"

#. from libreoffice:swriter-01
msgid "You can also click the arrow next to the <emph>AutoText</emph> icon on the <emph>Insert</emph> bar, and then choose the AutoText that you want to insert."
msgstr "Du kan också klicka på pilen bredvid ikonen <emph>Autotext</emph> på verktygsraden <emph>Infoga</emph> och sedan välja den autotext som du vill infoga."

#. from libreoffice:swriter-01
msgid "The <emph>AutoText </emph>dialog lists the AutoText categories and entries."
msgstr "I dialogrutan <emph>AutoText</emph> finns olika områden och poster för AutoText."

#. from libreoffice:swriter-01
msgid "Display remainder of name as a suggestion while typing"
msgstr "Visa resten av namnet som tips vid inmatningen"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/autotext/name\">Lists the name of the currently selected AutoText entry. If you have selected text in the document, type the name of the new AutoText entry, click the <emph>AutoText </emph>button, and then choose <emph>New</emph>.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/autotext/name\">Listar namnen på den autotext-post som är markerad. Om du har markerat text i dokumentet skriver du namnet på den nya autotext-posten, klickar på knappen <emph>Autotext</emph> och väljer <emph>Ny</emph>.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/autotext/shortname\">Displays the shortcut for the selected AutoText entry. If you are creating a new AutoText entry, type the shortcut that you want to use for the entry.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/autotext/shortname\">Visar förkortningen för den markerade autotext-posten. Om du skapar en ny autotext-post, skriver du den förkortning som du vill använda för posten.</ahelp>"

#. from libreoffice:swriter-01
msgid "Lists the AutoText categories. To view the AutoText entries in a category, double-click the category, or click the plus sign (+) in front of the category. To insert an AutoText entry into the current document, select the entry in the list, and then click <emph>Insert</emph>."
msgstr "Visar AutoText-områden. Om du vill se vilka poster som finns i ett område dubbelklickar du på området. Du kan också klicka på plustecknet (+) som finns för varje område. Om du vill infoga en AutoText-post i det aktuella dokumentet markerar du posten i listan och klickar på <emph>Infoga</emph>."

#. from libreoffice:swriter-01
msgid "You can drag and drop AutoText entries from one category to another."
msgstr "Du kan dra och släppa AutoText-poster från ett område till ett annat."

#. from libreoffice:swriter-01
msgid "Inserts the selected AutoText into the current document."
msgstr "Infoga den markerade AutoText-posten i det aktuella dokumentet."

#. from libreoffice:swriter-01
msgid "If you insert an unformatted AutoText entry into a paragraph, the entry is formatted with the current paragraph style."
msgstr "Om du infogar en oformaterad AutoText-post i ett stycke kommer posten att formateras med det styckeformat som du använder."

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/autotext/autotext\">Click to display additional AutoText commands, for example, to create a new AutoText entry from a text selection in the current document.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/autotext/autotext\">Klicka här för att visa fler autotext-kommandon, till exempel för att skapa en ny post av den markerade texten i det aktuella dokumentet.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/autotext/new\">Creates a new AutoText entry from the selection that you made in the current document. The entry is added to the currently selected AutoText category. You must first enter a name before you see this command.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/autotext/new\">Skapar en ny autotext-post enbart från den text som är markerad i det aktiva dokumentet. Posten läggs till i det autotext-område som är markerat.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/autotext/newtext\">Creates a new AutoText entry only from the text in the selection that you made in the current document. Graphics, tables and other objects are not included. You must first enter a name before you see this command.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/autotext/newtext\">Skapar en ny autotext-post från markeringen i det aktiva dokumentet. Grafik, tabeller och andra objekt tas inte med. Du måste först ange ett namn innan du ser detta kommando.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/autotext/copy\">Copies the selected AutoText to the clipboard.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/autotext/copy\">Kopierar den markerade autotext-posten till urklippet.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/autotext/replace\">Replaces the contents of the selected AutoText entry with the selection that was made in the current document.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/autotext/replace\">Ersätter innehållet i den markerade autotext-posten med markeringen i det aktuella dokumentet.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".\" visibility=\"hidden\">Opens the Rename AutoText dialog, where you can change the name of the selected AutoText entry.</ahelp> Opens the <link href=\"text/swriter/01/02120100.xhp\">Rename AutoText</link> dialog, where you can change the name of the selected AutoText entry."
msgstr "<ahelp hid=\".\" visibility=\"hidden\">Öppnar dialogrutan Byt namn på autotext där du kan ändra namnet på den markerade autotext-posten.</ahelp>Öppnar dialogrutan <link href=\"text/swriter/01/02120100.xhp\">Byt namn på autotext</link> där du kan ändra namnet på den markerade autotext-posten."

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/autotext/edit\">Opens the selected AutoText entry for editing in a separate document. Make the changes that you want, choose <emph>File - Save AutoText</emph>, and then choose <emph>File - Close</emph>.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/autotext/edit\">Öppnar den markerade autotext-posten för redigering i ett separat dokument. Gör de ändringar som behövs, välj <emph>Arkiv - Spara textblock</emph> och välj sedan <emph>Arkiv - Stäng</emph>.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".\" visibility=\"hidden\">Opens the Assign Macro dialog, where you attach a macro to the selected AutoText entry.</ahelp> Opens the <link href=\"text/swriter/01/05060700.xhp\">Assign Macro</link> dialog, where you attach a macro to the selected AutoText entry."
msgstr "<ahelp hid=\".\" visibility=\"hidden\">Öppnar dialogrutan Tilldela makro där du kan koppla ett makro till den markerade autotext-posten.</ahelp>Öppnar dialogrutan <link href=\"text/swriter/01/05060700.xhp\">Tilldela makro</link> där du kan koppla ett makro till den markerade autotext-posten."

#. from libreoffice:swriter-01
msgid "You can also use the macros that are linked to some of the provided AutoText entries in AutoText entries that you create. The AutoText entries must be created with the \"text only\" option. For example, insert the string <field:company> in an AutoText entry, and $[officename] replaces the string with the contents of the corresponding database field."
msgstr "Du kan också använda makron som är länkade till vissa av autoext-posterna i posterna som du skapar. Autotext-posterna måste skapas med alternativet \"bara text\". Om du till exempel infogar strängen <field:company> i en autotext-post, kommer $[officename] att ersätta strängen med innehållet i motsvarande databassträng."

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/autotext/categories\">Adds, renames, or deletes AutoText categories.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/autotext/categories\">Lägger till, byter namn på eller tar bort autotext-områden.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/editcategories/EditCategoriesDialog\">Adds, renames, or deletes AutoText categories.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/editcategories/EditCategoriesDialog\">Lägger till, byter namn på eller tar bort autotext-områden.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/editcategories/name\">Displays the name of the selected AutoText category. To change the name of the category, type a new name, and then click <emph>Rename</emph>. To create a new category, type a name, and then click <emph>New</emph>.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/editcategories/name\">Visar namnet på det markerade autotext-området. Om du vill ändra områdets namn skriver du ett nytt namn och klickar på <emph>Byt namn</emph>. Du kan skapa ett helt nytt område genom att skriva ett namn och klicka på <emph>Nytt</emph>.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/editcategories/pathlb\">Displays the current path to the directory where the selected AutoText category files are stored. If you are creating an AutoText category, select where you want to store the category files.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/editcategories/pathlb\">Visar sökvägen till den katalog där posterna i det markerade autotext-området lagras. Om du skapar ett nytt autotext-område väljer du var områdesfilerna lagras.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/editcategories/new\">Creates a new AutoText category using the name that you entered in the<emph> Name</emph> box.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/editcategories/new\">Skapar en ny autotext-post med det namn som du anger i rutan <emph>Namn</emph>.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/editcategories/rename\">Changes the name of the selected AutoText category to the name that you enter in the <emph>Name </emph>box.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/editcategories/rename\">Ändrar namnet på det markerade autotext-området till det namn som du skriver in i rutan <emph>Namn</emph>.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/editcategories/group\">Lists the existing AutoText categories and the corresponding paths.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/editcategories/group\">Visar alla definierade autotext-områden och motsvarande sökvägar.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".\" visibility=\"hidden\">Opens the Edit Paths dialog, where you can select the directory to store AutoText.</ahelp> Opens the <link href=\"text/shared/optionen/01010301.xhp\">Edit Paths</link> dialog, where you can select the directory to store AutoText."
msgstr "<ahelp hid=\".\" visibility=\"hidden\">Öppnar dialogrutan Redigera sökvägar där du kan välja i vilken katalog du vill lagra AutoText.</ahelp>Öppnar dialogrutan <link href=\"text/shared/optionen/01010301.xhp\">Redigera sökvägar</link> där du kan välja i vilken katalog du vill lagra AutoText."

#. from libreoffice:swriter-01
msgid "To add a new path to an AutoText directory, click the <emph>Path</emph> button in the <emph>AutoText </emph>dialog."
msgstr "Om du vill lägga till en ny sökväg i en Autotextkatalog klickar du på <emph>Sökväg</emph>i <emph>Autotextdialogrutan</emph>."

#. from libreoffice:swriter-01
msgid "Save links relative to"
msgstr "Spara länkar relativt"

#. from libreoffice:swriter-01
msgid "Use this area to set the way $[officename] inserts links to the AutoText directory."
msgstr "Använd det här området för att ange hur $[officename] infogar länkar till AutoText-katalogen."

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/autotext/relfile\">Links to AutoText directories on your computer are relative.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/autotext/relfile\">Länkar till autotext-kataloger på datorn är relativa.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/autotext/relnet\">Links to files on the Internet are relative.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/autotext/relnet\">Länkar till filer på Internet är relativa.</ahelp>"

#. from libreoffice:swriter-01
msgid "Allows you to change the name of an AutoText entry."
msgstr "Här kan du ändra namn på en AutoText-post."

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/renameautotextdialog/oldname\" visibility=\"visible\">Displays the current name of the selected AutoText item.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/renameautotextdialog/oldname\" visibility=\"visible\">Visar aktuellt namn på det markerade AutoText-objektet.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/renameautotextdialog/newname\" visibility=\"visible\">Type the new name for the selected AutoText component.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/renameautotextdialog/newname\" visibility=\"visible\">Skriv ett nytt namn på den markerade AutoText-komponenten.</ahelp>"

#. from libreoffice:swriter-01
msgid "Shortcut"
msgstr "Förkortning"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/renameautotextdialog/newsc\" visibility=\"visible\">Assigns a shortcut to the selected AutoText entry.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/renameautotextdialog/newsc\" visibility=\"visible\">Tilldelar en förkortning till den markerade AutoText-posten.</ahelp>"

#. from libreoffice:swriter-01
msgid "Edit Bibliography Entry"
msgstr "Redigera post i litteraturförteckning"

#. from libreoffice:swriter-01
msgid "Displays the abbreviation for the bibliography entry."
msgstr "Visar förkortningen för litteraturförteckningsposten."

#. from libreoffice:swriter-01
msgid "Displays the author and title information contained in the bibliography entry."
msgstr "Visar författar- och titelinformationen som finns i litteraturförteckningsposten."

#. from libreoffice:swriter-01
msgid "Applies the changes that you made, and then closes the <emph>Edit Bibliography Entry </emph>dialog."
msgstr "Ändringarna som du har gjort tillämpas och dialogrutan <emph>Redigera post i litteraturförteckning</emph> stängs."

#. from libreoffice:swriter-01
msgid "Opens the <link href=\"text/swriter/01/04120229.xhp\">Define Bibliography Entry</link> dialog, where you can create a new entry."
msgstr "Öppnar dialogrutan <link href=\"text/swriter/01/04120229.xhp\">Definiera litteraturpost</link> där du kan skapa en ny post."

#. from libreoffice:swriter-01
msgid "Opens the <link href=\"text/swriter/01/04120229.xhp\">Define Bibliography Entry</link> dialog, where you can edit the current entry."
msgstr "Öppnar dialogrutan <link href=\"text/swriter/01/04120229.xhp\">Definiera litteraturpost</link> där du kan redigera den aktuella posten."

#. from libreoffice:swriter-01
msgid "<link href=\"text/swriter/guide/indices_literature.xhp\">Tips for working with bibliography entries</link>."
msgstr "<link href=\"text/swriter/guide/indices_literature.xhp\">Information om att arbeta med litteraturförteckningsposter</link>."

#. from libreoffice:swriter-01
msgid "<variable id=\"fields_text\"><variable id=\"feldbefehltext\"><ahelp hid=\".uno:FieldDialog\">Opens a dialog where you can edit the properties of a field. Click in front of a field, and then choose this command.</ahelp> In the dialog, you can use the arrow buttons to move to the previous or the next field. </variable></variable>"
msgstr "<variable id=\"feldbefehltext\"><ahelp hid=\".uno:FieldDialog\">Öppnar en dialogruta som du kan använda för att redigera egenskaperna för ett fält. Klicka framför fältet och välj kommandot.</ahelp> I dialogrutan kan du använda pilknapparna för att gå till nästa eller föregående fält. </variable>"

#. from libreoffice:swriter-01
msgid "You can also double-click a field in your document to open the field for editing."
msgstr "Du kan också dubbelklicka på ett fält i dokumentet för att öppna fältet för redigering."

#. from libreoffice:swriter-01
msgid "If you select a <link href=\"text/shared/00/00000005.xhp#dde\">DDE</link> link in your document, and then choose <item type=\"menuitem\">Edit - Fields</item>, the <link href=\"text/shared/01/02180000.xhp\"><emph>Edit Links</emph></link> dialog opens."
msgstr "Om du har markerat en <link href=\"text/shared/00/00000005.xhp#dde\">DDE-länk</link> i dokumentet och väljer <emph>Redigera - Fältkommando</emph> öppnas dialogrutan <link href=\"text/shared/01/02180000.xhp\"><emph>Redigera länkar</emph></link>."

#. from libreoffice:swriter-01
msgid "If you click in front of a \"sender\" type field, and then choose <item type=\"menuitem\">Edit - Fields</item>, the <link href=\"text/shared/optionen/01010100.xhp\"><emph>User data</emph></link> dialog opens."
msgstr "Om du klickar framför ett fältkommando av typen \"avsändare\" och väljer <emph>Redigera - Fältkommando</emph> visas dialogrutan <link href=\"text/shared/optionen/01010100.xhp\"><emph>Användardata</emph></link>."

#. from libreoffice:swriter-01
msgid "Lists the type of field that you are editing."
msgstr "Visar vilken typ av fält du redigerar."

#. from libreoffice:swriter-01
msgid "The following dialog elements are only visible when the corresponding field type is selected."
msgstr "Följande kontroller i dialogrutan visas bara när du har markerat motsvarande typ av fält."

#. from libreoffice:swriter-01
msgid "Lists the field options, for example, \"fixed\". If you want, you can click another option for the selected field type."
msgstr "Visar alternativen för fältet, till exempel \"fixera\". Om du vill kan du klicka på ett annat alternativ för den markerade fälttypen."

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/flddocumentpage/numformat\">Select the format for the contents of the field. For date, time, and user-defined fields, you can also click \"Additional formats\" in the list, and then choose a different format.</ahelp> The formats that are available depend on the type of field that you are editing."
msgstr "<ahelp hid=\"modules/swriter/ui/flddocumentpage/numformat\">Välj format för innehållet i fältet. För datum, tid, och användardefinierade fält kan du även klicka på \"Ytterligare format\" i listan och välja ett annat format.</ahelp> Vilka format du kan använda beror på vilken typ av fält du arbetar med."

#. from libreoffice:swriter-01
msgid "Displays the offset for the selected field type, for example, for \"Next Page,\" \"Page Numbers\" or \"Previous Page\". You can enter a new offset value which will be added to the displayed page number."
msgstr "Visar korrigeringen för den aktuella fälttypen, till exempel \"Nästa sida\", \"Sidantal\" eller \"Föregående sida\". Du kan skriva in ett nytt korrigeringsvärde som läggs till på det sidnummer som visas."

#. from libreoffice:swriter-01
msgid "Displays the name of a field variable. If you want, you can enter a new name."
msgstr "Visar namnet på en fältvariabel. Du kan skriva in ett nytt namn om det behövs."

#. from libreoffice:swriter-01
msgid "Displays the current value of the field variable. If you want, you can enter a new value."
msgstr "Visar fältvariabelns aktuella värde. Du kan skriva in ett nytt värde om det behövs."

#. from libreoffice:swriter-01
msgid "Displays the condition that must be met for the field to be activated. If you want, you can enter a new <link href=\"text/swriter/01/04090200.xhp\">condition</link>."
msgstr "Visar de villkor som måste vara uppfyllda för att fältet ska aktiveras. Du kan skriva in ett nytt <link href=\"text/swriter/01/04090200.xhp\">villkor</link> om det behövs."

#. from libreoffice:swriter-01
msgid "Change the field contents that are displayed depending on whether the field condition is met or not."
msgstr "Ändrar fältinnehållet som visas beroende på om fältvillkoret är uppfyllt eller inte."

#. from libreoffice:swriter-01
msgid "Insert or modify the reference text for the selected field."
msgstr "Infoga eller ändra referenstexten för det markerade fältet."

#. from libreoffice:swriter-01
msgid "Displays the name of the macro assigned to the selected field."
msgstr "Visar namn på det makro som är kopplat till det markerade fältet."

#. from libreoffice:swriter-01
msgid "Displays the placeholder text of the selected field."
msgstr "Visar platshållartexten för det markerade fältet."

#. from libreoffice:swriter-01
msgid "Displays the text that is linked to a condition."
msgstr "Visar den text som är kopplad till en beräkning."

#. from libreoffice:swriter-01
msgid "Displays the formula of a formula field."
msgstr "Visar formeln för ett formelfält."

#. from libreoffice:swriter-01
msgid "Database selection"
msgstr "Databasurval"

#. from libreoffice:swriter-01
msgid "Select a registered database that you want to insert the selected field from. You can also change the table or query that the selected field refers to."
msgstr "Välj en registrerad databas som du vill infoga fältet från. Du kan också ändra vilken tabell eller fråga som det markerade fältet refererar till."

#. from libreoffice:swriter-01
msgid "Displays the database record number that is inserted when the condition specified for the \"Any record\" field type is met."
msgstr "Visar databaspostens postnummer som infogas när villkoret för fälttypen \"Alla poster\" är uppfyllt."

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"HID_DLG_FLDEDT_PREV\">Jumps to the previous field of the same type in the document.</ahelp> This button is only active when a document contains more than one field of the same type."
msgstr "<ahelp hid=\"HID_DLG_FLDEDT_PREV\">Går till föregående fält av samma typ i dokumentet.</ahelp> Den här knappen är bara aktiv om ett dokument innehåller mer än ett fält av samma typ."

#. from libreoffice:swriter-01
msgid "Previous Field"
msgstr "Föregående fältkommando"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"HID_DLG_FLDEDT_NEXT\">Jumps to the next field of the same type in the document.</ahelp> This button is only active when a document contains more than one field of the same type."
msgstr "<ahelp hid=\"HID_DLG_FLDEDT_NEXT\">Går till nästa fält av samma typ i dokumentet.</ahelp> Den här knappen är bara aktiv om ett dokument innehåller mer än ett fält av samma typ."

#. from libreoffice:swriter-01
msgid "Next Field"
msgstr "Nästa fältkommando"

#. from libreoffice:swriter-01
msgid "<link href=\"text/swriter/01/02150000.xhp\">Edit Footnote or Endnote</link>"
msgstr "<link href=\"text/swriter/01/02150000.xhp\">Fotnot/slutnot</link>"

#. from libreoffice:swriter-01
msgid "<variable id=\"footnote_endnote_text\"><variable id=\"fusstext\"><ahelp hid=\".uno:EditFootnote\">Edits the selected footnote or endnote anchor. Click in front of the footnote or endnote, and then choose this command.</ahelp> </variable></variable>"
msgstr "<variable id=\"fusstext\"><ahelp hid=\".uno:EditFootnote\">Redigerar förankringsplatsen för den markerade slutnoten eller fotnoten. Klicka framför eller bakom noten, och välj det här kommandot.</ahelp></variable>"

#. from libreoffice:swriter-01
msgid "To edit the text of a footnote or endnote, click in the footnote area at the bottom of the page, or at the end of the document."
msgstr "Om du vill ändra texten i en fotnot eller slutnot klickar du i fotnotsområdet längst ned på sidan, eller i slutet av dokumentet."

#. from libreoffice:swriter-01
msgid "Select the numbering type for the footnote or endnote."
msgstr "Anger numreringsformatet för fotnoten eller slutnoten."

#. from libreoffice:swriter-01
msgid "Select the type of note to insert, that is, footnote or endnote. A footnote is placed at the bottom of the current page, whereas an endnote is placed at the end of the document."
msgstr "Markera den typ av not som du ska infoga (slutnot eller fotnot). Den text som hör till en fotnot infogas längst ned på sidan, och texten för en slutnot infogas i slutet av dokumentet."

#. from libreoffice:swriter-01
msgid "Converts an endnote to a footnote."
msgstr "Konverterar en slutnot till en fotnot."

#. from libreoffice:swriter-01
msgid "Converts a footnote to an endnote."
msgstr "Konverterar en fotnot till en slutnot."

#. from libreoffice:swriter-01
msgid "Arrow left"
msgstr "Vänsterpil"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/insertfootnote/prev\">Moves to the previous footnote or endnote anchor in the document.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/insertfootnote/prev\">Går till föregående fotnot eller slutnot i dokumentet.</ahelp>"

#. from libreoffice:swriter-01
msgid "Arrow right"
msgstr "Högerpil"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/insertfootnote/next\">Moves to the next footnote or endnote anchor in the document.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/insertfootnote/next\">Går till nästa fotnot eller slutnot i dokumentet.</ahelp>"

#. from libreoffice:swriter-01
msgid "<link href=\"text/swriter/01/04030000.xhp\">Insert Footnote/Endnote</link> dialog."
msgstr "<link href=\"text/swriter/01/04030000.xhp\"> Dialogrutan Infoga - Fotnot/slutnot</link>."

#. from libreoffice:swriter-01
msgid "The <emph>Edit Sections</emph> dialog is similar to the <link href=\"text/swriter/01/04020100.xhp\"><emph>Insert - Section</emph></link> dialog, and offers the following additional options:"
msgstr "Dialogrutan <emph>Redigera områden</emph> liknar dialogrutan <link href=\"text/swriter/01/04020100.xhp\"><emph>Infoga område</emph></link> men har dessutom följande alternativ:"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/editsectiondialog/tree\">Type the name of the section that you want to edit, or click a name in the <emph>Section </emph>list.</ahelp> If the cursor is currently in a section, the section name is displayed on the right side of the status bar at the bottom of the document window."
msgstr "<ahelp hid=\"modules/swriter/ui/editsectiondialog/tree\">Ange namnet på det område som du ska redigera eller klicka på ett namn i listan <emph>Område </emph>.</ahelp> Om markören står i ett område visas områdets namn till höger på statuslisten längst ned i dokumentfönstret."

#. from libreoffice:swriter-01
msgid "The current write protection status of a section is indicated by the lock symbol in front of the section name in the list. An open lock is unprotected and a closed lock is protected. Similarly, visible sections are indicated by a glasses symbol."
msgstr "Om området är skrivskyddat visas det med en symbol i form av ett låst hänglås framför områdesnamnet i listan. Ett öppet lås betyder att området inte är skyddat. På samma sätt visas synliga områden med ett par glasögon."

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/editsectiondialog/tree\">Opens the <link href=\"text/swriter/01/05040501.xhp\"><emph>Options</emph></link> dialog, where you can edit the column layout, background, footnote and endnote behavior of the selected section.</ahelp> If the section is password protected, you must enter the password first."
msgstr "<ahelp hid=\"modules/swriter/ui/editsectiondialog/tree\">Öppnar dialogrutan <link href=\"text/swriter/01/05040501.xhp\"><emph>Alternativ</emph></link> där du kan redigera kolumnens utseende, bakgrund, samt fot- och slutnoter i det markerade området.</ahelp> Om området är lösenordsskyddat måste du ange lösenordet först."

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/editsectiondialog/remove\">Removes the selected section from the document, and inserts the contents of the section into the document.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/editsectiondialog/remove\">Tar bort det markerade avsnittet från dokumentet och infogar innehållet i avsnittet i dokumentet.</ahelp>"

#. from libreoffice:swriter-01
msgid "<link href=\"text/swriter/01/03050000.xhp\">Rulers</link>"
msgstr "<link href=\"text/swriter/01/03050000.xhp\">Linjal</link>"

#. from libreoffice:swriter-01
msgid "Text Boundaries"
msgstr "Textbegränsningar"

#. from libreoffice:swriter-01
msgid "<link href=\"text/swriter/01/03070000.xhp\">Text Boundaries</link>"
msgstr "<link href=\"text/swriter/01/03070000.xhp\">Textbegränsningar</link>"

#. from libreoffice:swriter-01
msgid "Field Shadings"
msgstr "Markeringar"

#. from libreoffice:swriter-01
msgid "<link href=\"text/swriter/01/03080000.xhp\">Field Shadings</link>"
msgstr "<link href=\"text/swriter/01/03080000.xhp\">Markeringar</link>"

#. from libreoffice:swriter-01
msgid "Field Names"
msgstr "Fältnamn"

#. from libreoffice:swriter-01
msgid "To change the default field display to field names instead of the field contents, choose <switchinline select=\"sys\"><caseinline select=\"MAC\"><item type=\"menuitem\">%PRODUCTNAME - Preferences</item></caseinline><defaultinline><item type=\"menuitem\">Tools - Options</item></defaultinline></switchinline><emph> - %PRODUCTNAME Writer - View</emph>, and then select the <emph>Field codes</emph> checkbox in the <emph>Display</emph> area."
msgstr "Om du vill ändra standardinställningen för fält till att visa fältnamn i stället för fältinnehåll väljer du <emph><switchinline select=\"sys\"><caseinline select=\"MAC\">%PRODUCTNAME – Inställningar</caseinline><defaultinline>Verktyg – Alternativ</defaultinline></switchinline> – %PRODUCTNAME Writer – Vy</emph>. Markera sedan kryssrutan <emph>Fältnamn</emph> under <emph>Visa</emph>."

#. from libreoffice:swriter-01
msgid "When you print a document with <item type=\"menuitem\">View - Field Names</item> enabled, you are prompted to include the field names in the print out."
msgstr "När du skriver ut ett dokument och <emph>Visa - Fältnamn</emph> är aktivt blir du tillfrågad om fältnamnen ska tas med i utskriften."

#. from libreoffice:swriter-01
msgid "<link href=\"text/swriter/01/04090000.xhp\">Insert - Field</link>."
msgstr "<link href=\"text/swriter/01/04090000.xhp\">Infoga - Fältkommando</link>."

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".\">Shows hidden formatting symbols in your text, such as paragraph marks, line breaks, tab stops, and spaces.</ahelp>"
msgstr "<ahelp hid=\".uno:ControlCodes\">Visar kontrolltecken i texten, till exempel stycketecken, radbrytningar, tabbtecken och mellanslag.</ahelp>"

#. from libreoffice:swriter-01
msgid "When you delete a paragraph mark, the paragraph that is merged takes on the formatting of the paragraph that the cursor is in."
msgstr "När du tar bort ett stycketecken får det nya sammanfogade stycket samma styckeformatering som det stycke där markören står."

#. from libreoffice:swriter-01
msgid "Web Layout"
msgstr "Webblayout"

#. from libreoffice:swriter-01
msgid "<link href=\"text/swriter/01/03120000.xhp\">Web Layout</link>"
msgstr "<link href=\"text/swriter/01/03120000.xhp\">Webblayout</link>"

#. from libreoffice:swriter-01
msgid "<link href=\"text/swriter/01/03130000.xhp\">Normal Layout</link>"
msgstr "<link href=\"text/swriter/01/03130000.xhp\">Utskriftslayout</link>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".\">Shows or hides hidden paragraphs.</ahelp> This option only affects the screen display of hidden paragraphs, and not the printing of hidden paragraphs."
msgstr "<ahelp hid=\".uno:ShowHiddenParagraphs\">Visar eller döljer dolda stycken.</ahelp> Det här alternativet påverkar bara hur bildskärmen visar dolda stycken och inte hur dolda stycken skrivs ut."

#. from libreoffice:swriter-01
msgid "Use the <link href=\"text/swriter/01/04090000.xhp\">field command</link> \"Hidden Paragraph\" to assign a <link href=\"text/swriter/01/04090200.xhp\">condition</link> that must be met to hide a paragraph. If the condition is not met, the paragraph is displayed."
msgstr "Använd <link href=\"text/swriter/01/04090000.xhp\">fältkommandot</link> \"Dolt stycke\" för att tilldela ett <link href=\"text/swriter/01/04090200.xhp\">villkor</link> som måste uppfyllas för att ett stycke ska döljas. Om villkoret inte uppfylls visas stycket."

#. from libreoffice:swriter-01
msgid "When you hide a paragraph, footnotes and frames that are anchored to characters in the paragraph are also hidden."
msgstr "När du döljer ett stycke, döljs också fotnoterna och ramarna som är förankrade till tecknen i stycket."

#. from libreoffice:swriter-01
msgid "Insert Manual Break"
msgstr "Infoga manuell brytning"

#. from libreoffice:swriter-01
msgid "<variable id=\"manual_break_text\"><ahelp hid=\".uno:InsertBreak\">Inserts a manual line break, column break or a page break at the current cursor position.</ahelp> </variable>"
msgstr "<variable id=\"umbruch\"><ahelp hid=\".uno:InsertBreak\">Infogar en manuell radbrytning, kolumnbrytning eller sidbrytning vid den position där markören står.</ahelp></variable>"

#. from libreoffice:swriter-01
msgid "Select the type of break that you want to insert."
msgstr "Välj den typ av brytning som du ska infoga."

#. from libreoffice:swriter-01
msgid "Line Break"
msgstr "Radbrytning"

#. from libreoffice:swriter-01
msgid "<variable id=\"bereicheinfuegen\"><link href=\"text/swriter/01/04020000.xhp\">Insert Section</link></variable>"
msgstr "<variable id=\"bereicheinfuegen\"><link href=\"text/swriter/01/04020000.xhp\">Infoga område</link></variable>"

#. from libreoffice:swriter-01
msgid "You can insert an entire document in a section, or a named section from another. You can also insert a section as a <link href=\"text/shared/00/00000005.xhp#dde\">DDE</link> link."
msgstr "Du kan infoga ett helt dokument i ett område, eller ett namngivet område från ett annat. Du kan också infoga ett område som en <link href=\"text/shared/00/00000005.xhp#dde\">DDE-länk</link>."

#. from libreoffice:swriter-01
msgid "To edit a section, choose <link href=\"text/swriter/01/02170000.xhp\"><emph>Format - Sections</emph></link>."
msgstr "Om du vill redigera ett område väljer du <link href=\"text/swriter/01/02170000.xhp\"><emph>Format - Områden</emph></link>."

#. from libreoffice:swriter-01
msgid "The <emph>Insert Section </emph>dialog contains the following tabs:"
msgstr "I dialogrutan <emph>Infoga område</emph> finns följande flikar:"

#. from libreoffice:swriter-01
msgid "Inserts the section that you defined at the current cursor position in the document."
msgstr "Infogar området på den plats där markören står i dokumentet."

#. from libreoffice:swriter-01
msgid "<bookmark_value>sections;inserting sections by DDE</bookmark_value><bookmark_value>DDE; command for inserting sections</bookmark_value>"
msgstr "<bookmark_value>Områden; infoga områden med DDE</bookmark_value><bookmark_value>DDE-kommando; infoga områden</bookmark_value>"

#. from libreoffice:swriter-01
msgid "The general syntax for a DDE command is: \"<Server> <Topic> <Item>\", where server is the DDE name for the application that contains the data. Topic refers to the location of the Item (usually the file name), and Item represents the actual object."
msgstr "Allmän syntax för ett DDE-kommando är: \"<Server> <Topic> <Item>\", där Server är DDE-namnet på det program som innehåller data. Topic är platsen för Item (vanligen filnamnet), och Item är det faktiska objektet."

#. from libreoffice:swriter-01
msgid "When you open a document that contains linked sections, you are prompted to update the links."
msgstr "När du öppnar ett dokument som innehåller länkade områden uppmanas du att uppdatera länkarna."

#. from libreoffice:swriter-01
msgid "With password"
msgstr "Med lösenord"

#. from libreoffice:swriter-01
msgid "You cannot hide a section if it is the only content on a page, or in a header, footer, footnote, frame, or table cell."
msgstr "Du kan inte dölja ett område som är det enda innehållet på en sida eller i ett sidhuvud, en sidfot, en fotnot, en ram eller en tabellcell."

#. from libreoffice:swriter-01
msgid "With condition"
msgstr "Med villkor"

#. from libreoffice:swriter-01
msgid "You see this area of the dialog when the current document is an XForms document."
msgstr "Du ser det här området av dialogrutan när det aktuella dokumentet är ett XForms dokument."

#. from libreoffice:swriter-01
msgid "Select to allow editing of the section's contents even if the document is opened in read-only mode."
msgstr "Markera detta alternativ om du vill att områdets innehåll ska kunna redigeras även när dokumentet öppnas som skrivskyddat."

#. from libreoffice:swriter-01
msgid "<link href=\"text/swriter/01/04090200.xhp\">Syntax for conditions</link>"
msgstr "<link href=\"text/swriter/01/04090200.xhp\">Syntax för villkor</link>"

#. from libreoffice:swriter-01
msgid "<link href=\"text/swriter/01/04020200.xhp\">Indents</link>"
msgstr "<link href=\"text/swriter/01/04020200.xhp\">Indrag</link>"

#. from libreoffice:swriter-01
msgid "Indents the section with a left and right margin."
msgstr "Drar in området med en vänster- eller en högermarginal."

#. from libreoffice:swriter-01
msgid "Before section"
msgstr "Före avsnitt"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/indentpage/before\">Specifies the indents before the section, at the left margin.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/indentpage/before\">Anger indraget före området, vid vänstermarginalen.</ahelp>"

#. from libreoffice:swriter-01
msgid "After section"
msgstr "Efter avsnitt"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/indentpage/after\">Specifies the indents after the section, at the right margin.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/indentpage/after\">Anger indraget efter området, vid högermarginalen.</ahelp>"

#. from libreoffice:swriter-01
msgid "<link href=\"text/swriter/01/04090000.xhp\">Field commands</link>"
msgstr "<link href=\"text/swriter/01/04090000.xhp\">Fältkommandon</link>"

#. from libreoffice:swriter-01
msgid "Footnote/Endnote"
msgstr "Fotnot/slutnot"

#. from libreoffice:swriter-01
msgid "<link href=\"text/swriter/01/04030000.xhp\">Footnote/Endnote</link>"
msgstr "<link href=\"text/swriter/01/04030000.xhp\">Fotnot/slutnot</link>"

#. from libreoffice:swriter-01
msgid "Select the type of numbering that you want to use for footnotes and endnotes."
msgstr "Välj det numreringsformat som du vill använda för fotnoter eller slutnoter."

#. from libreoffice:swriter-01
msgid "Select whether to insert a footnote or an endnote. Endnote numbering is separate from the footnote numbering."
msgstr "Välj om du ska infoga en fotnot eller en slutnot. Numreringen av slutnoter är fristående från numreringen av fotnoter."

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/insertfootnote/footnote\">Inserts a footnote anchor at the current cursor position in the document, and adds a footnote to the bottom of the page.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/insertfootnote/footnote\">Infogar en förankringspunkt för en fotnot på den plats där markören står i dokumentet och lägger till en fotnot längst ned på sidan.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/insertfootnote/endnote\">Inserts an endnote anchor at the current cursor position in the document, and adds an endnote at the end of the document.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/insertfootnote/endnote\">Infogar en förankringspunkt för en slutnot på den plats där markören står i dokumentet och lägger till en slutnot i slutet av dokumentet.</ahelp>"

#. from libreoffice:swriter-01
msgid "<bookmark_value>bookmarks;inserting</bookmark_value>"
msgstr "<bookmark_value>bokmärken;infoga</bookmark_value>"

#. from libreoffice:swriter-01
msgid "You cannot use the following characters in a bookmark name: / \\ @ : * ? \" ; , . #"
msgstr "Du kan inte använda följande tecken i ett bokmärkesnamn: / \\ @ : * ? \" ; , . #"

#. from libreoffice:swriter-01
msgid "<link href=\"text/swriter/01/04060000.xhp\">Caption</link>"
msgstr "<link href=\"text/swriter/01/04060000.xhp\">Bildtext</link>"

#. from libreoffice:swriter-01
msgid "Set the caption options for the current selection."
msgstr "Ange bildtextalternativ för den aktuella markeringen."

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/insertcaption/position\">Adds the caption above or below the selected item. This option is only available for some objects.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/insertcaption/position\">Lägger till bildtexten över eller under det markerade objektet. Det här alternativet är bara tillgängligt för vissa objekt.</ahelp>"

#. from libreoffice:swriter-01
msgid "<link href=\"text/swriter/01/04060100.xhp\">Options</link>"
msgstr "<link href=\"text/swriter/01/04060100.xhp\">Alternativ</link>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/captionoptions/border_and_shadow\">Applies the border and shadow of the object to the caption frame.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/captionoptions/border_and_shadow\">Använder objektets ram och skuggning till bildtextramen.</ahelp>"

#. from libreoffice:swriter-01
msgid "<bookmark_value>inserting;envelopes</bookmark_value>      <bookmark_value>letters;inserting envelopes</bookmark_value>      <bookmark_value>envelopes</bookmark_value>"
msgstr "<bookmark_value>Infoga; kuvert</bookmark_value>      <bookmark_value>brev;infoga kuvert</bookmark_value>      <bookmark_value>kuvert</bookmark_value>"

#. from libreoffice:swriter-01
msgid "<link href=\"text/swriter/01/04070000.xhp\">Envelope</link>"
msgstr "<link href=\"text/swriter/01/04070000.xhp\">Kuvert</link>"

#. from libreoffice:swriter-01
msgid "<variable id=\"briefum\"><ahelp hid=\".uno:InsertEnvelope\">Creates an envelope.</ahelp> On three tab pages, you can specify the addressee and sender, the position and format for both addresses, the size of the envelope, and the envelope orientation.</variable>"
msgstr "<variable id=\"briefum\"><ahelp hid=\".uno:InsertEnvelope\">Skapar ett kuvert.</ahelp> På tre flikar anger du information om adressat och avsändare, position och format för båda adresserna, storleken på kuvertet och kuvertets orientering.</variable>"

#. from libreoffice:swriter-01
msgid "New doc."
msgstr "Nytt dok."

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"HID_ENVELOP_PRINT\">Creates a new document and inserts the envelope.</ahelp>"
msgstr "<ahelp hid=\"HID_ENVELOP_PRINT\">Skapar ett nytt dokument och infogar kuvertet.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"HID_ENVELOP_INSERT\">Inserts the envelope before the current page in the document.</ahelp>"
msgstr "<ahelp hid=\"HID_ENVELOP_INSERT\">Infogar kuvertet före den aktuella sidan i dokumentet.</ahelp> Kuvertet formateras med sidformatmallen <emph>Kuvert</emph>."

#. from libreoffice:swriter-01
msgid "To delete an envelope from a document"
msgstr "Så här raderar du ett kuvert från ett dokument"

#. from libreoffice:swriter-01
msgid "Click into the envelope page to make it the current page."
msgstr "Klicka på sidan \"Kuvert\" om du vill ha den som aktuell sida."

#. from libreoffice:swriter-01
msgid "Right-click the field on the status line that shows \"Envelope\"."
msgstr "Högerklicka i fältet på statuslinjen som visar \"Kuvert\"."

#. from libreoffice:swriter-01
msgid "A submenu opens showing some page styles."
msgstr "En undermeny öppnas som visar sidstilar."

#. from libreoffice:swriter-01
msgid "Choose the \"Default\" page style from the submenu."
msgstr "Välj sidformatmallen Standard från undermenyn."

#. from libreoffice:swriter-01
msgid "This removes the special \"Envelope\" page formatting."
msgstr "Då tas specialformateringen bort för sidan \"Kuvert\"."

#. from libreoffice:swriter-01
msgid "Delete the frames for sender and recipient. Click the border of each frame and press the Del key."
msgstr "Ta bort ramar för avsändare och mottagare. Klicka på kanten för varje ram och tryck på tangenten Del."

#. from libreoffice:swriter-01
msgid "<link href=\"text/swriter/01/04070100.xhp\">Envelope</link>"
msgstr "<link href=\"text/swriter/01/04070100.xhp\">Kuvert</link>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/envaddresspage/EnvAddressPage\" visibility=\"visible\">Enter the delivery and return addresses for the envelope. You can also insert address fields from a database, for example from the Addresses database.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/envaddresspage/EnvAddressPage\" visibility=\"visible\">Ange mottagar- och avsändaradresserna för kuvertet. Du kan också infoga adressfält från en databas, till exempel från databasen Adresser.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/envaddresspage/database\" visibility=\"visible\">Select the database containing the address data that you want to insert.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/envaddresspage/database\" visibility=\"visible\">Markera den databas som innehåller de adressdata du vill infoga.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/envaddresspage/table\" visibility=\"visible\">Select the database table containing the address data that you want to insert.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/envaddresspage/table\" visibility=\"visible\">Markera den databastabell som innehåller de adressdata du vill infoga.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/envaddresspage/insert\" visibility=\"visible\">Select the database field containing the address data that you want to insert, and then click the left arrow button. The data is added to the address box containing the cursor.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/envaddresspage/insert\" visibility=\"visible\">Markera det databasfält som innehåller adressinformationen som du vill infoga och klicka på vänsterpilen. Adressen läggs till i den adressruta där markören står.</ahelp>"

#. from libreoffice:swriter-01
msgid "<link href=\"text/swriter/01/04070200.xhp\">Format</link>"
msgstr "<link href=\"text/swriter/01/04070200.xhp\">Format</link>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/envformatpage/EnvFormatPage\">Specifies the layout and the dimension of the envelope.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/envformatpage/EnvFormatPage\">Anger utseende och storlek på kuvertet.</ahelp>"

#. from libreoffice:swriter-01
msgid "Sets the position and the text formatting options of the addressee field."
msgstr "Anger positionen och textformateringen för fältet mottagare."

#. from libreoffice:swriter-01
msgid "Sets the position of the recipient's address on the envelope."
msgstr "Anger positionen för mottagarens adress på kuvertet."

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/envformatpage/leftaddr\">Enter the amount of space that you want to leave between the left edge of the envelope and the addressee field.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/envformatpage/leftaddr\">Ange hur mycket utrymme som ska lämnas mellan kuvertets vänsterkant och mottagarfältet.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/envformatpage/topaddr\">Enter the amount of space that you want to leave between the top edge of the envelope and the addressee field.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/envformatpage/topaddr\">Ange hur mycket utrymme som ska lämnas mellan kuvertets överkant och mottagarfältet.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/envformatpage/addredit\">Click and choose the text formatting style for the addressee field that you want to edit.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/envformatpage/addredit\">Klicka och välj en textformatmall för det mottagarfält som du vill redigera.</ahelp>"

#. from libreoffice:swriter-01
msgid "Opens a dialog where you can edit the character formatting that is used in the addressee field."
msgstr "Öppnar en dialogruta där du kan ändra teckenformateringen som används i mottagarfältet."

#. from libreoffice:swriter-01
msgid "Opens a dialog where you can edit the paragraph formatting that is used in the addressee field."
msgstr "Öppnar en dialogruta där du kan ändra styckformateringen som används i mottagarfältet."

#. from libreoffice:swriter-01
msgid "Sets the position and the text formatting options of the sender field."
msgstr "Anger positionen och textformateringen för fältet avsändare."

#. from libreoffice:swriter-01
msgid "Sets the position of the sender's address on the envelope."
msgstr "Anger positionen för avsändarens adress på kuvertet."

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/envformatpage/leftsender\">Enter the amount of space that you want to leave between the left edge of the envelope and the sender field.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/envformatpage/leftsender\">Ange hur mycket utrymme som ska lämnas mellan kuvertets vänsterkant och avsändarfältet.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/envformatpage/topsender\">Enter the amount of space that you want to leave between the top edge of the envelope and the sender field.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/envformatpage/topsender\">Ange hur mycket utrymme som ska lämnas mellan kuvertets överkant och avsändarfältet.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/envformatpage/senderedit\">Click and choose the text formatting style for the sender field that you want to edit.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/envformatpage/senderedit\">Klicka och välj en textformatmall för det avsändarfält som du vill redigera.</ahelp>"

#. from libreoffice:swriter-01
msgid "Opens a dialog where you can edit the character formatting that is used in the sender field."
msgstr "Öppnar en dialogruta där du kan ändra teckenformateringen som används i avsändarfältet."

#. from libreoffice:swriter-01
msgid "Opens a dialog where you can edit the paragraph formatting that is used in the sender field."
msgstr "Öppnar en dialogruta där du kan ändra styckformateringen som används i avsändarfältet."

#. from libreoffice:swriter-01
msgid "Select the envelope size format that you want to use, or create a custom size."
msgstr "Välj ett fördefinierat kuvertformat som du vill använda eller skapa ett eget format."

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/envformatpage/format\">Select the envelope size that want, or select \"User Defined\", and then enter the width and the height of the custom size.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/envformatpage/format\">Välj en kuvertstorlek eller välj \"Användare\", och ange höjd och bredd för kuvertstorleken.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/envformatpage/width\">Enter the width of the envelope.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/envformatpage/width\">Ange kuvertets bredd.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/envformatpage/height\">Enter the height of the envelope.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/envformatpage/height\">Ange kuvertets höjd.</ahelp>"

#. from libreoffice:swriter-01
msgid "<link href=\"text/swriter/01/04070300.xhp\">Printer</link>"
msgstr "<link href=\"text/swriter/01/04070300.xhp\">Skrivare</link>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/envprinterpage/EnvPrinterPage\">Set the print options for the envelope.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/envprinterpage/EnvPrinterPage\">Ange utskriftsalternativen för kuvertet.</ahelp>"

#. from libreoffice:swriter-01
msgid "Consult the documentation that came with your printer for setting up the printer for envelopes. Depending on the printer model, envelopes may have to be placed left, right, in the middle, and either face up or face down."
msgstr "Se efter i skrivarens dokumentation hur du måste lägga in kuverten för att de ska matas igenom skrivaren på rätt sätt. Beroende på skrivarmodell kan det hända att kuverten måste läggas an mot vänster sida, mot höger sida eller placeras i mitten; och i vissa skrivare måste de placeras med utskriftssidan nedåt, i andra med utskriftssidan uppåt."

#. from libreoffice:swriter-01
msgid "Horizontal left"
msgstr "Liggande till vänster"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/envprinterpage/horileft\">Feeds the envelope horizontally from the left edge of the printer tray.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/envprinterpage/horileft\">Matar kuvertet horisontellt från vänster sida av pappersmagasinet.</ahelp>"

#. from libreoffice:swriter-01
msgid "Horizontal center"
msgstr "Liggande i mitten"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/envprinterpage/horicenter\">Feeds the envelope horizontally from the center of the printer tray.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/envprinterpage/horicenter\">Matar kuvertet horisontellt från mitten av pappersmagasinet.</ahelp>"

#. from libreoffice:swriter-01
msgid "Horizontal right"
msgstr "Liggande till höger"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/envprinterpage/horiright\">Feeds the envelope horizontally from the right edge of the printer tray.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/envprinterpage/horiright\">Matar kuvertet horisontellt från höger sida av pappersmagasinet.</ahelp>"

#. from libreoffice:swriter-01
msgid "Vertical left"
msgstr "Vertikal vänster"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/envprinterpage/vertleft\">Feeds the envelope vertically from the left edge of the printer tray.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/envprinterpage/vertleft\">Matar kuvertet vertikalt från vänster sida av pappersmagasinet.</ahelp>"

#. from libreoffice:swriter-01
msgid "Vertical center"
msgstr "Stående i mitten"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/envprinterpage/vertcenter\">Feeds the envelope vertically from the center of the printer tray.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/envprinterpage/vertcenter\">Matar kuvertet vertikalt från mitten av pappersmagasinet.</ahelp>"

#. from libreoffice:swriter-01
msgid "Vertical right"
msgstr "Stående till höger"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/envprinterpage/vertright\">Feeds the envelope vertically from the right edge of the printer tray.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/envprinterpage/vertright\">Matar kuvertet vertikalt från höger sida av pappersmagasinet.</ahelp>"

#. from libreoffice:swriter-01
msgid "Print from top"
msgstr "Skriv ut uppifrån"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/envprinterpage/top\">Feeds the envelope with the print side face up in the printer tray.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/envprinterpage/top\">Matar kuvertet med den tryckta sidan uppåt i pappersmagasinet.</ahelp>"

#. from libreoffice:swriter-01
msgid "Print from bottom"
msgstr "Skriv ut nedifrån"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/envprinterpage/bottom\">Feeds the envelope with the print side face down in the printer tray.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/envprinterpage/bottom\">Matar kuvertet med den tryckta sidan nedåt i pappersmagasinet.</ahelp>"

#. from libreoffice:swriter-01
msgid "Shift right"
msgstr "Åt höger"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/envprinterpage/right\">Enter the amount to shift the print area to the right.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/envprinterpage/right\">Ange hur mycket utskriftsområdet ska flyttas åt höger.</ahelp>"

#. from libreoffice:swriter-01
msgid "Shift down"
msgstr "Nedåt"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/envprinterpage/down\">Enter the amount to shift the print area down.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/envprinterpage/down\">Ange hur mycket utskriftsområdet ska flyttas ned.</ahelp>"

#. from libreoffice:swriter-01
msgid "Current printer"
msgstr "Aktuell skrivare"

#. from libreoffice:swriter-01
msgid "Displays the name of the current printer."
msgstr "Här visas namnet på den aktuella skrivaren. Du växlar aktuell skrivare i operativsystemet."

#. from libreoffice:swriter-01
msgid "Setup"
msgstr "Ställ in..."

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/envprinterpage/setup\">Opens the Print Setup dialog where you can define additional printer settings, such as paper format and orientation.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/envprinterpage/setup\">Öppnar dialogrutan Utskriftsalternativ där du kan ställa in andra skrivarinställningar som pappersformat och orientering.</ahelp>"

#. from libreoffice:swriter-01
msgid "<link href=\"text/swriter/01/04090000.xhp\">Fields</link>"
msgstr "<link href=\"text/swriter/01/04090000.xhp\">Fältkommando</link>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"HID_FIELD_INSERT\">Inserts the selected field at the current cursor position in the document. To close the dialog, click the <emph>Close </emph>button.</ahelp>"
msgstr "<ahelp hid=\"HID_FIELD_INSERT\">Infogar det markerade fältet vid markörens aktuella position i dokumentet. När du vill stänga dialogrutan klickar du på knappen <emph>Stäng</emph>.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".\" visibility=\"hidden\">Closes the dialog.</ahelp>"
msgstr "<ahelp hid=\".\" visibility=\"hidden\">Stänger dialogrutan.</ahelp>"

#. from libreoffice:swriter-01
msgid "<link href=\"text/swriter/01/04090001.xhp\">Document</link>"
msgstr "<link href=\"text/swriter/01/04090001.xhp\">Dokument</link>"

#. from libreoffice:swriter-01
msgid "Inserts the filename and/or the directory path of the current document, as well as the filename without extension."
msgstr "Infogar filnamn och/eller sökväg för det aktuella dokumentet och filnamnet utan filnamnstillägg."

#. from libreoffice:swriter-01
msgid "Inserts the page number of the current, previous, or next page."
msgstr "Infogar sidnumret för den aktuella, föregående eller följande sidan."

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".\" visibility=\"hidden\">Inserts the field as static content, that is, the field cannot be updated.</ahelp>"
msgstr "<ahelp hid=\".\" visibility=\"hidden\">Infogar fältet som statiskt innehåll, d.v.s. fältet går inte att uppdatera.</ahelp>"

#. from libreoffice:swriter-01
msgid "Offset"
msgstr "Korrigering"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/flddocumentpage/value\">Enter the offset value that you want to apply to a page number field, for example \"+1\".</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/flddocumentpage/value\">Ange det korrigeringsvärde som du vill använda på ett sidnummerfält, till exempel \"+1\".</ahelp>"

#. from libreoffice:swriter-01
msgid "If you want to change the actual page number and not the displayed number, do not use the <emph>Offset</emph> value. To change page numbers, read the <link href=\"text/swriter/guide/pagenumbers.xhp\"><emph>Page Numbers</emph></link> guide."
msgstr "Om du vill ändra faktiskt sidnummer och inte det som visas, ska du inte använda<emph>Korrigerings-</emph>värdet. Vill du ändra sidnummer, läs guiden<link href=\"text/swriter/guide/pagenumbers.xhp\"><emph>Sidnummer</emph></link>."

#. from libreoffice:swriter-01
msgid "Offset in days/minutes"
msgstr "Korrigering i dagar/- minuter"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/flddocumentpage/offset\">Enter the offset that you want to apply to a date or time field.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/flddocumentpage/offset\">Ange den korrigering du vill använda på ett datum- eller tidsfält.</ahelp>"

#. from libreoffice:swriter-01
msgid "Cross-references"
msgstr "Korsreferens"

#. from libreoffice:swriter-01
msgid "<variable id=\"reftext\"><ahelp hid=\".\">This is where you insert the references or referenced fields into the current document. References are referenced fields within the same document or within sub-documents of a master document.</ahelp></variable>"
msgstr "<variable id=\"reftext\"><ahelp hid=\".\">Här infogar du referenserna eller referensfälten i det aktuella dokumentet. Referenserna är referensfält inom samma dokument eller i underdokument till ett samlingsdokument.</ahelp></variable>"

#. from libreoffice:swriter-01
msgid "The advantage of entering a cross-reference as a field is that you do not have to adjust the references manually every time you change the document. Just update the fields with F9 and the references in the document are updated too."
msgstr "Fördelen med att infoga en korshänvisning som fältkommando är att du inte måste anpassa hänvisningarna manuellt så snart du ändrar något i dokumentet. Du behöver bara uppdatera fältkommandona med F9, så stämmer korshänvisningarna igen."

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".\">Lists the available field types. To add a field to your document, click a field type, click a field in the Selection list, and then click Insert.</ahelp> The following fields are available:"
msgstr "<ahelp hid=\".\">Visar tillgängliga fälttyper. Vill du lägga till ett fält i dokumentet klickar du på fälttyp, klickar på ett fält i listan Urval och klickar sedan på Infoga.</ahelp> Följande fält är tillgängliga:"

#. from libreoffice:swriter-01
msgid "Set target for a referenced field. Under <emph>Name</emph>, enter a name for the reference. When inserting the reference, the name will then appear as an identification in the list box <emph>Selection</emph>."
msgstr "Sätter målet för en korshänvisning. Under <emph>Namn</emph> anger Du en beteckning för referensen. Denna visas sedan i listrutan <emph>Urval</emph> när referensen infogas."

#. from libreoffice:swriter-01
msgid "In an HTML document, reference fields entered this way will be ignored. For the target in HTML documents, you have to <link href=\"text/swriter/01/04040000.xhp\">insert a bookmark</link>."
msgstr "I HTML dokument tas dock ingen hänsyn till de referensfält som infogats på detta vis. Som mål för en korshänvisning i ett HTML dokument måste Du <link href=\"text/swriter/01/04040000.xhp\">infoga ett bokmärke</link>."

#. from libreoffice:swriter-01
msgid "Inserting a reference to another position in the document. The corresponding text position has to be defined with \"Set Reference\" first. Otherwise, inserting a reference by choosing a field name under <emph>Selection</emph> is not possible."
msgstr "Infogar en korshänvisning till ett annat ställe i dokumentet. Du måste ha definierat det motsvarande stället i texten tidigare med \"Sätt referens\". Det är bara då som Du kan infoga en hänvisning genom att välja ett fältnamn under <emph>Urval</emph>."

#. from libreoffice:swriter-01
msgid "In master documents, you can also reference from one sub-document to another. Note that the reference name will not appear in the selection field and has to be entered \"by hand\"."
msgstr "I samlingsdokument kan du även hänvisa från ett deldokument till ett annat. Observera att referensens namn inte visas i urvalsfältet och att du måste skriva in det \"för hand\"."

#. from libreoffice:swriter-01
msgid "In an HTML document, reference fields entered this way will be ignored. For referenced fields in HTML documents, you have to <link href=\"text/shared/01/05020400.xhp\">insert a hyperlink</link>."
msgstr "I HTML dokument tas dock ingen hänsyn till de referensfält som infogats på detta vis. För korshänvisningar i HTML dokument måste Du <link href=\"text/shared/01/05020400.xhp\">infoga en hyperlänk</link>."

#. from libreoffice:swriter-01
msgid "The Selection box shows a list of all headings in the order of their appearance in the document."
msgstr "I urvalsrutan visas en lista över alla rubriker i samma turordning som i dokumentet."

#. from libreoffice:swriter-01
msgid "After inserting a bookmark in the document with <emph>Insert - Bookmark</emph>, the bookmarks entry on the <emph>References</emph> tab becomes usable. Bookmarks are used to mark certain text passages in a document. In a text document, you can use the bookmarks, for example, to jump from one passage in the document to another."
msgstr "Om du har infogat ett bokmärke i dokumentet via <emph>Infoga - Bokmärke</emph>, så visas även posten \"Bokmärken\" under fliken <emph>Referenser</emph>. Bokmärken använder du för att markera vissa textavsnitt inom ett dokument. I ett textdokument kan du med hjälp av infogade bokmärken t.ex. snabbt hoppa från ett ställe i dokumentet till ett annat."

#. from libreoffice:swriter-01
msgid "In an HTML document, these bookmarks become anchors <A name>, which determine the target of hyperlinks for example."
msgstr "I ett HTML dokument blir de här bokmärkena ankare <A name>, som bestämmer t.ex. hyperlänkarnas mål."

#. from libreoffice:swriter-01
msgid "If your documents contains a footnote, you can select the Footnotes entry. A reference to a footnote returns the footnote number."
msgstr "Om dina dokument innehåller en fotnot kan du välja Fotnotsposten. En referens till en fotnot returnerar fotnotsnumret."

#. from libreoffice:swriter-01
msgid "(Inserted objects with captions)"
msgstr "(Infogade objekt med bildtexter)"

#. from libreoffice:swriter-01
msgid "You can set references to objects that have captions applied. For example, insert a picture, right-click the picture, choose Caption. Now the object shows up as a numbered \"Illustration\" in the list."
msgstr "Du kan ange hänvisningar till objekt som har bildtexter. Exempelvis kan du infoga en bild, högerklicka på den och välja Bildtext. Nu visas objektet som en numrerad \"Illustration\" i listan."

#. from libreoffice:swriter-01
msgid "References are fields. To remove a reference, delete the field. If you set a longer text as a reference and you do not want to reenter it after deleting the reference, select the text and copy it to the clipboard. You can then reinsert it as \"unformatted text\" at the same position using the command <emph>Edit - Paste special</emph>. The text remains intact while the reference is deleted."
msgstr "Referenser är fältkommandon. Om du vill ta bort en referens raderar du fältkommandot. Om du har satt en längre text som referens, och inte vill skriva in den på nytt när du har raderat referensen kan du markera texten och kopiera den till urklippet. Sedan kan du infoga den igen som \"oformaterad text\" på samma ställe igen med kommandot <emph>Redigera - Klistra in innehåll</emph>. Då bibehålls själva texten medan referensen raderas."

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/fldrefpage/format\">Select the format that you want to use for the selected reference field.</ahelp> The following formats are available:"
msgstr "<ahelp hid=\"modules/swriter/ui/fldrefpage/format\">Välj det format som du vill använda för det valda referensfältet.</ahelp> Följande format är tillgängliga:"

#. from libreoffice:swriter-01
msgid "Inserts the number of the page containing the reference target."
msgstr "Infogar numret på den sida som innehåller hänvisningens mål."

#. from libreoffice:swriter-01
msgid "Inserts \"above\" or \"below\", depending on the location of the reference target relative to the position of the reference field."
msgstr "Infogar \"ovan\" eller \"nedan\" beroende på platsen för hänvisningens mål relativt korshänvisningen."

#. from libreoffice:swriter-01
msgid "Inserts the number of the page containing the reference target using the format specified in the page style."
msgstr "Infogar numret på den sida som innehåller hänvisningens mål i det format som anges i sidformatmallen."

#. from libreoffice:swriter-01
msgid "Inserts the number of the heading or numbered paragraph, including superior levels depending on the context. See note below this table for more information."
msgstr "Infogar rubrikens eller det numrerade styckets nummer, inklusive överordnade nivåer beroende på sammanhanget. Se noteringen nedanför den här tabellen för mer information."

#. from libreoffice:swriter-01
msgid "Inserts only the number of the heading or numbered paragraph."
msgstr "Infogar endast rubrikens eller det numrerade styckets nummer."

#. from libreoffice:swriter-01
msgid "Inserts the number of the heading or numbered paragraph, including all superior levels."
msgstr "Infogar rubrikens eller det numrerade styckets nummer, inklusive alla överordnade nivåer."

#. from libreoffice:swriter-01
msgid "In a master document, targets that are in different sub-documents are not displayed in the<emph> Selection</emph> list. If you want to insert a reference to the target, you must type the path and the name in the <emph>Name </emph>box."
msgstr "När Du använder hänvisningar till ett samlingsdokuments olika deldokument, så måste Du skriva in namnet på en referens manuellt om den inte finns i samma deldokument."

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".\" visibility=\"hidden\">Enter the contents that you want to add to a user-defined fields.</ahelp>"
msgstr "<ahelp hid=\".\" visibility=\"hidden\">Ange innehållet du vill lägga till i användardefinierade fält.</ahelp>"

#. from libreoffice:swriter-01
msgid "If you select text in the document, and then insert a reference, the selected text becomes the contents of the field that you insert."
msgstr "När Du sätter en referens till en markering i texten, så används den aktuella markeringen som fältinnehåll."

#. from libreoffice:swriter-01
msgid "<link href=\"text/swriter/01/04090003.xhp\">Functions</link>"
msgstr "<link href=\"text/swriter/01/04090003.xhp\">Funktioner</link>"

#. from libreoffice:swriter-01
msgid "Inserts text if a certain <link href=\"text/swriter/01/04090200.xhp\">condition</link> is met. For example, enter \"sun eq 1\" in the <emph>Condition</emph> box, and then the text that you want to insert when the variable \"sun\" equals \"1\" in the <emph>Then </emph>box. If you want, you can also enter the text that you want to display when this condition is not met in the <emph>Else</emph> box. To define the variable \"sun\", click the <link href=\"text/swriter/01/04090005.xhp\"><emph>Variables</emph></link> tab, select \"Set variable\", type \"sun\" in the<emph> Name</emph> box, and its value in the<emph> Value</emph> box."
msgstr "Infogar text om ett visst <link href=\"text/swriter/01/04090200.xhp\">villkor</link> uppfylls. Ange till exempel \"sun eq 1\" i rutan <emph>Villkor</emph> och sedan den text som du vill infoga när variabeln \"sun\" är lika med \"1\" i rutan <emph>Så</emph>. Du kan om du vill också ange texten som du vill ska visas om inte villkoret uppfylls i rutan <emph>Annars</emph>. Du definierar variabeln \"sun\" genom att klicka på fliken <link href=\"text/swriter/01/04090005.xhp\"><emph>Variabler</emph></link>, välja \"Sätt variabel\", skriva \"sun\" i rutan <emph>Namn</emph> och dess värde i rutan <emph>Värde</emph>."

#. from libreoffice:swriter-01
msgid "Inserts a text field that you can open by <link href=\"text/swriter/01/04090100.xhp\">clicking</link> it in the document. You can then change the text that is displayed."
msgstr "Infogar formulärfält för inmatning av text. Dessa kan Du förse med separata hänvisningar. När Du klickar på kommandoknappen <emph>Infoga</emph>, öppnas dialogrutan  <link href=\"text/swriter/01/04090100.xhp\"><emph>Inmatningsfält</emph></link>, där Du kan skriva in och redigera den önskade texten."

#. from libreoffice:swriter-01
msgid "Inserts a text field that runs a macro when you click the field in the document. To assign a macro to the field, click the <emph>Macro</emph> button."
msgstr "Infogar ett textfält som automatiskt utför ett tilldelat makro när du dubbelklickar. Du väljer det önskade makrot med kommandoknappen <emph>Makro...</emph>. När du har valt makro skriver du in den tillhörande förklaringen i textfältet <emph>Hänvisning</emph>."

#. from libreoffice:swriter-01
msgid "Inserts a placeholder field in the document, for example, for graphics. When you click a placeholder field in the document, you are prompted to insert the item that is missing."
msgstr "Infogar en platshållare i dokumentet. Platshållarens typ bestämmer Du under <emph>Format</emph>. Beteckningen skriver Du i textfältet <emph>Platshållare</emph> och eventuella förklaringar under <emph>Hänvisning</emph>. När Du klickar på platshållaren i dokumentet, kan Du infoga det objekt i vars ställe platshållaren står."

#. from libreoffice:swriter-01
msgid "Combines up to 6 characters, so that they behave as a single character. This feature is only available when Asian fonts are supported."
msgstr "Här kan du kombinera 1 till 6 tecken som behandlas som ett standardtecken när kombinationen har gjorts."

#. from libreoffice:swriter-01
msgid "For function fields, the format field is only used for fields of the type placeholder. Here, the format determines the object for which the placeholder stands."
msgstr "För funktionsfält används formatfältet bara för fältkommandon av typen platshållare. Här bestämmer du genom formatet för vilket objekt en platshållare gäller."

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/flddbpage/condition\">For fields linked to a <link href=\"text/swriter/01/04090200.xhp\">condition</link>, enter the criteria here.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/flddbpage/condition\">Här anger du villkoren för fält med <link href=\"text/swriter/01/04090200.xhp\">villkor</link>.</ahelp>"

#. from libreoffice:swriter-01
msgid "You can also insert database fields in the <emph>Then </emph>and <emph>Else </emph>boxes using the format \"databasename.tablename.fieldname\"."
msgstr "I resultatfälten <emph>Så</emph> och <emph>Annars</emph> kan du dels skriva in vanlig text, dels ange databasfält i form av \"databasnamn.tabellnamn.fältnamn\" (utan citattecken) så att fältinnehåll infogas om villkoret uppfylls. $[officename] försöker vid sådana uttryck först identifiera texten som en databaskolumn. Om en sådan finns, så matas kolumnens innehåll ut, i annat fall bara texten."

#. from libreoffice:swriter-01
msgid "If the table or the field name does not exist in a database, nothing is inserted."
msgstr "Om det angivna tabell- eller fältnamnet inte finns i någon databas, så infogas ingenting om citattecknen inte sätts ut."

#. from libreoffice:swriter-01
msgid "If you include the quotes in \"databasename.tablename.fieldname\", the expression is inserted as text."
msgstr "Om du tar med citattecknen i \"databasnamn.tabellnamn.fältnamn\" infogas uttrycket som text."

#. from libreoffice:swriter-01
msgid "Type the text that you want to display in the field. If you are inserting a placeholder field, type the text that you want to display as a help tip when you rest the mouse pointer over the field."
msgstr "Ange den text som du vill ska visas i fältet. Om du infogar ett platshållarfält, skriv den text som du vill ska visas som hjälptext när du placerar musmarkören över fältet."

#. from libreoffice:swriter-01
msgid "Select the macro that you want to run when the field is clicked."
msgstr "Här väljer du det makro som ska utföras när någon klickar på fältet."

#. from libreoffice:swriter-01
msgid "Displays the name of the selected macro."
msgstr "För fält som används för att köra ett makro visas här namnet på det makro som är markerat i urvalsfältet."

#. from libreoffice:swriter-01
msgid "Type the text that you want to appear in the placeholder field."
msgstr "Om du väljer fälttypen <emph>Platshållare</emph> kan du definiera en platshållare här."

#. from libreoffice:swriter-01
msgid "Type the text that you want to hide if a condition is met."
msgstr "För fälttypen <emph>Dold text</emph> kan du ange text som ska visas om ett visst villkor uppfylls."

#. from libreoffice:swriter-01
msgid "Enter the characters that you want to combine. You can combine a maximum of 6 characters. This option is only available for the <emph>Combine characters</emph> field type."
msgstr "Skriv in de tecken som du vill kombinera. Du kan som mest kombinera 6 tecken. Detta val är endast tillgängligt för fälttypen <emph>Kombinera tecken</emph>."

#. from libreoffice:swriter-01
msgid "Enter a value for the selected field."
msgstr "Om du har valt fälttypen Kombinera tecken  kan du ange ett värde här."

#. from libreoffice:swriter-01
msgid "The following controls are displayed for <emph>Input list</emph> fields:"
msgstr "Följande kontroller visas för <emph>inmatningslistefält</emph>:"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/fldfuncpage/item\">Enter a new item.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/fldfuncpage/item\">Ange ett nytt objekt.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/fldfuncpage/add\">Adds the <emph>Item</emph> to the list.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/fldfuncpage/add\">Lägger till <emph>objektet</emph> till listan.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/fldfuncpage/listitems\">Lists the items. The topmost item is shown in the document.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/fldfuncpage/listitems\">Listar posterna. Det översta objektet visas i dokumentet.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/fldfuncpage/remove\">Removes the selected item from the list.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/fldfuncpage/remove\">Tar bort det markerade objektet från listan.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/fldfuncpage/up\">Moves the selected item up in the list.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/fldfuncpage/up\">Flyttar det markerade objektet uppåt i listan.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/fldfuncpage/down\">Moves the selected item down in the list.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/fldfuncpage/down\">Flyttar det markerade objektet nedåt i listan.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/fldfuncpage/listname\">Enter a unique name for the <emph>Input list</emph>.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/fldfuncpage/listname\">Ange ett unikt namn för <emph>inmatningslistan</emph>.</ahelp>"

#. from libreoffice:swriter-01
msgid "Choose Item"
msgstr "Välj objekt"

#. from libreoffice:swriter-01
msgid "This dialog is shown when you click an <emph>Input list</emph> field in the document."
msgstr "Den här dialogrutan visas när du klickar på ett <emph>inmatningslistefält</emph> i dokumentet."

#. from libreoffice:swriter-01
msgid "<link href=\"text/swriter/01/04090004.xhp\">DocInformation</link>"
msgstr "<link href=\"text/swriter/01/04090004.xhp\">Dokumentinfo</link>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".\" visibility=\"hidden\">Lists the available field types. To add a field to your document, click a field type, click a field in the Select list, and then click Insert.</ahelp>"
msgstr "<ahelp hid=\".\" visibility=\"hidden\">Visar de tillgängliga fälttyperna. Om du vill lägga till ett fält i ett dokument klickar du på en fälttyp och sedan ett fält i Urvalslistan och sedan klickar du på Infoga.</ahelp>"

#. from libreoffice:swriter-01
msgid "Inserts the name of the author, and the date, or the time when the document was created."
msgstr "Infogar författarens namn, och datum eller klockslag när dokumentet skapades."

#. from libreoffice:swriter-01
msgid "Inserts the name of the author, and the date or time that the document was last printed."
msgstr "Infogar författarens namn, och datum eller klockslag när dokumentet skrevs ut senast."

#. from libreoffice:swriter-01
msgid "Inserts the name of the author, and the date, or the time of the last save."
msgstr "Infogar författarens namn och datum eller klockslag när filen sparades senast."

#. from libreoffice:swriter-01
msgid "Inserts the version number of the current document."
msgstr "Infogar det aktuella dokumentets versionsnummer."

#. from libreoffice:swriter-01
msgid "Inserts the amount of time spent on editing a document."
msgstr "Infogar hur mycket tid som har använts för att redigera ett dokument."

#. from libreoffice:swriter-01
msgid "For the \"Created\", \"Modified\", and \"Last printed\" field types, you can include the author, date, and time of the corresponding operation."
msgstr "För fälttyperna \"Skapat\", \"Ändrat\" och \"Senaste utskrift\" kan du inkludera författare, datum och klockslag för motsvarande ."

#. from libreoffice:swriter-01
msgid "Fixed content"
msgstr "Fixera innehåll"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/flddocinfopage/fixed\">Inserts the field as static content, that is, the field cannot be updated.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/flddocinfopage/fixed\">Infogar fältet som statiskt innehåll, d.v.s. fältet går inte att uppdatera.</ahelp>"

#. from libreoffice:swriter-01
msgid "Fields with fixed content are only evaluated when you create a new document from a template that contains such a field. For example, a date field with fixed content inserts the date that a new document was created from the template."
msgstr "Fält med fast innehåll kan bara utvärderas om du skapar ett nytt dokument från en mall som innehåller ett fast fält. Ett datumfält med fast innehåll infogar t.ex. det datum då ett nytt dokument skapades från mallen."

#. from libreoffice:swriter-01
msgid "<bookmark_value>user-defined fields, restriction</bookmark_value>"
msgstr "<bookmark_value>Användardefinierade fält, begränsning</bookmark_value>"

#. from libreoffice:swriter-01
msgid "<link href=\"text/swriter/01/04090005.xhp\">Variables</link>"
msgstr "<link href=\"text/swriter/01/04090005.xhp\">Variabler</link>"

#. from libreoffice:swriter-01
msgid "Set Variable"
msgstr "Sätt variabel"

#. from libreoffice:swriter-01
msgid "Show Variable"
msgstr "Visa variabel"

#. from libreoffice:swriter-01
msgid "Inserts a <link href=\"text/shared/00/00000005.xhp#dde\">DDE</link> link into the document, that you can update as often as you want through the assigned name."
msgstr "Infogar en <link href=\"text/shared/00/00000005.xhp#dde\">DDE</link>-länk i dokumentet som du kan uppdatera så ofta du vill via det tilldelade namnet."

#. from libreoffice:swriter-01
msgid "Inserts a fixed number, or the result of a formula."
msgstr "Infogar ett fast tal eller resultatet av en formel."

#. from libreoffice:swriter-01
msgid "Inserts a new value for a variable or a User Field."
msgstr "Infogar ett nytt värde för en variabel eller ett användarfält."

#. from libreoffice:swriter-01
msgid "The value of a variable in an Input field is only valid from where the field is inserted and onwards. To change the value of the variable later in the document, insert another Input field of the same name, but with a different value. However, the value of a User Field is changed globally."
msgstr "Värdet på en variabel i ett inmatningsfält är bara giltigt från det ställe där fältet är infogat och framåt. Du kan ändra värdet på variabeln senare i dokumentet genom att infoga ett annat inmatningsfält med samma namn, men med ett annat värde. Värdet i ett användarfält ändras dock globalt."

#. from libreoffice:swriter-01
msgid "Inserts a reference point in the document, after which the page count restarts. Select \"on\" to enable the reference point, and \"off\" to disable it. You can also enter an offset to start the page count at a different number."
msgstr "Infogar en referenspunkt i dokumentet, efter vilken sidnumreringen ska börja om. Välj \"på\" om du vill aktivera referenspunkten, och \"av\" om du vill deaktivera den. Du kan också ange en korrigering som startar sidnumreringen på ett annat nummer."

#. from libreoffice:swriter-01
msgid "Displays the number of pages from the \"Set page variable\" reference point to this field."
msgstr "Visar antalet sidor från referenspunkten \"Sätt sidvariabel\" till det här fältet."

#. from libreoffice:swriter-01
msgid "Inserts a custom global variable. You can use the User Field to define a variable for a condition statement. When you change a User Field, all instances of the variable in the document are updated."
msgstr "Infogar en användardefinierad global variabel. Du kan använda användarfältet för att definiera en variabel för ett villkorsuttryck. När du ändrar ett användarfält uppdateras alla förekomster av variabeln i dokumentet."

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".\" visibility=\"hidden\">Click the format that you want to apply to the selected field, or click \"Additional formats\" to define a custom format.</ahelp>"
msgstr "<ahelp hid=\".\" visibility=\"hidden\">Klicka på det format som du vill använda för det markerade fältet, eller klicka på \"Ytterligare format\" för att definiera ett eget format.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".\" visibility=\"hidden\">Type the name of the user-defined field that you want to create.</ahelp>"
msgstr "<ahelp hid=\".\" visibility=\"hidden\">Skriv namnet på det användardefinierade fält som du ska skapa.</ahelp>"

#. from libreoffice:swriter-01
msgid "User-defined fields are only available in the current document."
msgstr "Användardefinierade fält är bara tillgängliga i det aktuella dokumentet."

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".\" visibility=\"hidden\">Enter the contents that you want to add to a user-defined field.</ahelp>"
msgstr "<ahelp hid=\".\" visibility=\"hidden\">Ange innehållet du vill lägga till i ett användardefinierat fält.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/fldvarpage/format\">In the <emph>Format</emph> list, define if the value is inserted as text or a number.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/fldvarpage/format\">I listan <emph>Format</emph> kan du ange om värdet ska infogas som text eller som ett tal.</ahelp>"

#. from libreoffice:swriter-01
msgid "In an HTML document, two additional fields are available for the \"Set variable\" field type: HTML_ON and HTML_OFF. The text that you type in the <emph>Value </emph>box is converted to an opening HTML <link href=\"text/shared/00/00000002.xhp#tags\">tag</link> (<Value>) or to a closing HTML (</Value>) tag when the file is saved as an HTML document, depending on the option that you select."
msgstr "I ett HTML dokument är ytterligare två fält tillgängliga för fälttypen \"Sätt variabel\": HTML_ON och HTML_OFF. Den text du skriver i rutan <emph>Värde</emph> konverteras till en inledande <link href=\"text/shared/00/00000002.xhp#tags\">HTML-tagg</link> (<Värde>) eller en avslutande HTML-tagg (</Värde>) när filen sparas som ett HTML dokument, beroende på vilket alternativ du väljer."

#. from libreoffice:swriter-01
msgid "Invisible"
msgstr "Osynligt"

#. from libreoffice:swriter-01
msgid "<link href=\"text/swriter/01/04090006.xhp\">Database</link>"
msgstr "<link href=\"text/swriter/01/04090006.xhp\">Databas</link>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".\" visibility=\"hidden\">Lists the available field types. To add a field to your document, click a field type, click a field in the <emph>Select </emph>list, and then click <emph>Insert</emph>.</ahelp>"
msgstr "<ahelp hid=\".\" visibility=\"hidden\">Visar de tillgängliga fälttyperna. Om du vill lägga till ett fält i ett dokument klickar du på en fälttyp och sedan ett fält i <emph>Urvalslistan </emph> och sedan klickar du på <emph>Infoga</emph>.</ahelp>"

#. from libreoffice:swriter-01
msgid "Any Record"
msgstr "Slumpvis datapost"

#. from libreoffice:swriter-01
msgid "Inserts the contents of the database field that you specify in the <emph>Record Number</emph> box as a mail merge field if the <link href=\"text/swriter/01/04090200.xhp\"><emph>Condition</emph></link> that you enter is met. Only records selected by a multiple selection in the data source view are considered."
msgstr "Infogar innehållet i det databasfält du anger i rutan <emph>Datapostnummer</emph> som ett fält för kopplad utskrift, om det <link href=\"text/swriter/01/04090200.xhp\"><emph>villkor</emph></link> du anger uppfylls. Endast poster som är valda med en multimarkering i datakällvyn beaktas."

#. from libreoffice:swriter-01
msgid "You can use this field to insert several records into a document. Simply insert the <emph>Any Record</emph> field in front of the form letter fields that use a certain record."
msgstr "Du kan använda det här fältet för att infoga flera dataposter i ett dokument. Infoga fältet <emph>Slumpvis datapost</emph> framför de fält för kopplad utskrift som innehåller en viss datapost."

#. from libreoffice:swriter-01
msgid "Inserts the name of the database table selected in the <emph>Database selection </emph>box. The \"Database Name\" field is a global field, that is, if you insert a different database name in your document, the contents of all previously inserted \"Database Name\" fields are updated."
msgstr "Infogar namnet på den databastabell som är markerad i rutan <emph>Databasurval</emph>. \"Databasnamn\" är ett globalt fält, d.v.s. om du infogar ett annat databasnamn i dokumentet, så uppdateras innehållet i alla tidigare infogade fält av typen \"Databasnamn\"."

#. from libreoffice:swriter-01
msgid "Mail merge field"
msgstr "Standardbrevfält"

#. from libreoffice:swriter-01
msgid "Inserts the name of a database field as a placeholder, so that you can create a mail merge document. The field content is automatically inserted when you print the form letter."
msgstr "Infogar namnet på ett databasfält som en platshållare, så att du kan skapa ett dokument för kopplad utskrift. Fältinnehållet skrivs in automatiskt vid utskrift av standardbrev (kopplad utskrift)."

#. from libreoffice:swriter-01
msgid "Inserts the contents of the next mail merge field in your document, if the condition that you define is met. The records that you want to include must be selected in the data source view."
msgstr "Infogar innehållet i nästa fält för kopplad utskrift i dokumentet, om det villkor du har definierat uppfylls. De dataposter som ska tas med måste vara markerade i datakällvyn."

#. from libreoffice:swriter-01
msgid "You can use the \"Next record\" field to insert the contents of consecutive records between the mail merge fields in a document."
msgstr "Du kan använda fältet \"Nästa datapost\" för att infoga innehållet i på varandra följande dataposter mellan fälten för kopplad utskrift i ett dokument."

#. from libreoffice:swriter-01
msgid "Inserts the number of the selected database record."
msgstr "Infogar den markerade databaspostens nummer."

#. from libreoffice:swriter-01
msgid "Database Selection"
msgstr "Databasurval"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/flddbpage/select\">Select the database table or the database query that you want the field to refer to.</ahelp> You can include fields from more than one database or query in a document."
msgstr "<ahelp hid=\"modules/swriter/ui/flddbpage/select\">Välj den databastabell eller databassökning som du vill att fältet ska referera till.</ahelp> Du kan ta med fält från mer än en databas eller sökning i ett dokument."

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".\" visibility=\"hidden\">For fields linked to a condition, enter the criteria here.</ahelp>"
msgstr "<ahelp hid=\".\" visibility=\"hidden\">Här anger du villkoren för fält med villkor.</ahelp>"

#. from libreoffice:swriter-01
msgid "If you want, you can assign a condition that must be met before the contents of the \"Any Record\" and \"Next Record\" fields are inserted. The default condition is \"True\", that is, the condition is always true if you do not change the condition text."
msgstr "Om du vill kan du definiera ett villkor som ska uppfyllas innan innehållet i fälten \"Valfri datapost\" och \"Nästa datapost\" infogas. Standardvillkoret är \"Sant\". Det innebär att villkoret alltid är sant om du inte ändrar villkorstexten."

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/flddbpage/recnumber\">Enter the number of the record that you want to insert when the condition that you specify is met.</ahelp> The record number corresponds to the current selection in the data source view. For example, if you select the last 5 records in a database containing 10 records, the number of the first record will be 1, and not 6."
msgstr "<ahelp hid=\"modules/swriter/ui/flddbpage/recnumber\">Ange numret på den datapost som du vill infoga när det angivna villkoret uppfylls.</ahelp> Datapostens nummer motsvarar den aktuella markeringen i datakällvyn. Om du t.ex. markerar de 5 sista dataposterna i en databas som innehåller 10 dataposter, så blir den första datapostens nummer 1, och inte 6."

#. from libreoffice:swriter-01
msgid "If you refer to fields in a different database (or in a different table or query within the same database), $[officename] determines the record number relative to the current selection."
msgstr "Om du refererar till fält i en annan databas (eller i en annan tabell eller sökning i samma databas), så bestämmer $[officename] postens nummer relativt den aktuella markeringen."

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/flddbpage/fromdatabasecb\">Uses the format defined in the selected database.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/flddbpage/fromdatabasecb\">Använder det format som är definierat i den markerade databasen.</ahelp>"

#. from libreoffice:swriter-01
msgid "User defined"
msgstr "Användardefinierat"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/flddbpage/userdefinedcb\">Applies the format that you select in the <emph>List of user-defined formats</emph>.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/flddbpage/userdefinedcb\">Använder det format som du väljer i <emph>listan med användardefinierade format</emph>.</ahelp>"

#. from libreoffice:swriter-01
msgid "List of user-defined formats"
msgstr "Lista över användardefinierade format"

#. from libreoffice:swriter-01
msgid "Printing a form letter"
msgstr "Skriva ut ett standardbrev"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".\">When you print a document that contains database fields, a dialog asks you if you want to print a form letter. If you answer Yes, the <link href=\"text/swriter/01/01150000.xhp\">Mail Merge</link> dialog opens where you can select the database records to print.</ahelp>"
msgstr "<ahelp hid=\".\">När du skriver ut ett dokument som innehåller databasfält visas en dialogruta med en fråga om du vill skriva ut ett standardbrev. Om du svarar Ja öppnas dialogrutan <link href=\"text/swriter/01/01150000.xhp\">Kopplad utskrift</link> där du kan markera vilka databasposter som ska skrivas ut.</ahelp>"

#. from libreoffice:swriter-01
msgid "Special Tags"
msgstr "Specialtaggar"

#. from libreoffice:swriter-01
msgid "<bookmark_value>tags; in $[officename] Writer</bookmark_value><bookmark_value>$[officename] Writer; special HTML tags</bookmark_value><bookmark_value>HTML;special tags for fields</bookmark_value><bookmark_value>fields;HTML import and export</bookmark_value><bookmark_value>time fields;HTML</bookmark_value><bookmark_value>date fields;HTML</bookmark_value><bookmark_value>DocInformation fields</bookmark_value>"
msgstr "<bookmark_value>Taggar; i $[officename] Writer</bookmark_value><bookmark_value>$[officename] Writer; särskilda HTML-taggar</bookmark_value><bookmark_value>HTML;specialtaggar för fält</bookmark_value><bookmark_value>Fält;importera och exportera HTML</bookmark_value><bookmark_value>Tidsfält;HTML</bookmark_value><bookmark_value>Datumfält;HTML</bookmark_value><bookmark_value>Dokumentinfofält</bookmark_value>"

#. from libreoffice:swriter-01
msgid "<link href=\"text/swriter/01/04090007.xhp\">Special Tags</link>"
msgstr "<link href=\"text/swriter/01/04090007.xhp\">Speciella taggar</link>"

#. from libreoffice:swriter-01
msgid "When you save a document that contains fields as an HTML document, $[officename] automatically converts date, time, and DocInformation fields to special HTML tags. The field contents are inserted between the opening and closing HTML tags of the converted fields. These special HTML tags do not correspond to standard HTML tags."
msgstr "När du sparar ett dokument som innehåller fält som ett HTML dokument, så konverterar $[officename] automatiskt datum, klockslag och dokumentinfofält till särskilda HTML-taggar. Fältens innehåll infogas mellan de inledande och avslutande HTML-taggarna i de konverterade fälten. De här särskilda HTML-taggarna är inte som vanliga HTML-taggar."

#. from libreoffice:swriter-01
msgid "$[officename] Writer fields are identified by the <SDFIELD> tag in an HTML document. The field type, the format, and the name of the special field are included in the opening HTML tag. The format of a field tag that is recognized by an HTML filter depends on the field type."
msgstr "$[officename] Writer-fält identifieras i ett HTML dokument av taggen <SDFIELD>. Fältkommandots typ, format och namn ingår i den inledande HTML-taggen. Vilket format av fältkommandotagg som känns igen av ett HTML-filter beror på fältkommandots typ."

#. from libreoffice:swriter-01
msgid "Date and Time Fields"
msgstr "Datum- och tidsfält"

#. from libreoffice:swriter-01
msgid "For \"Date\" and \"Time\" fields, the TYPE parameter equals DATETIME. The format of the date or the time is specified by the SDNUM parameter, for example, DD:MM:YY for dates, or HH:MM:SS for time."
msgstr "För fälten \"Datum\" och \"Klockslag\" är parametern TYPE lika med DATETIME. Datumets eller klockslagets format anges av parametern SDNUM, t.ex. DD:MM:ÅÅ för datum, eller TT:MM:SS för klockslag."

#. from libreoffice:swriter-01
msgid "For fixed date and time fields, the date or the time is specified by the SDVAL parameter."
msgstr "För fasta datum- och tidsfält anges datum och klockslag av parametern SDVAL."

#. from libreoffice:swriter-01
msgid "Examples of date and time special HTML tags that are recognized by $[officename] as fields are shown in the following table:"
msgstr "Följande tabell innehåller exempel på speciella HTML-taggar för datum och tid som känns igen av $[officename] som fältkommandon:"

#. from libreoffice:swriter-01
msgid "Date is fixed"
msgstr "Datum fast"

#. from libreoffice:swriter-01
msgid "<SDFIELD TYPE=DATETIME SDVAL=\"35843,4239988426\" SDNUM=\"1031;1031;DD/MM/YY\">17/02/98</SDFIELD>"
msgstr "<SDFIELD TYPE=DATETIME SDVAL=\"35843,4239988426\" SDNUM=\"1031;1031;DD.MM.ÅÅ\">17.02.98</SDFIELD>"

#. from libreoffice:swriter-01
msgid "Date is variable"
msgstr "Datum variabel"

#. from libreoffice:swriter-01
msgid "<SDFIELD TYPE=DATETIME SDNUM=\"1031;1031;DD/MM/YY\">17/02/98</SDFIELD>"
msgstr "<SDFIELD TYPE=DATETIME SDVAL=\"35843,4239988426\" SDNUM=\"1031;1031;DD.MM.ÅÅ\">17.02.98</SDFIELD>"

#. from libreoffice:swriter-01
msgid "Time is fixed"
msgstr "Klockslag fast"

#. from libreoffice:swriter-01
msgid "<SDFIELD TYPE=DATETIME SDVAL=\"35843,4240335648\" SDNUM=\"1031;1031;HH:MM:SS\">10:10:36</SDFIELD>"
msgstr "<SDFIELD TYPE=DATETIME SDVAL=\"35843,4240335648\" SDNUM=\"1031;1031;HH:MM:SS\">10:10:36</SDFIELD>"

#. from libreoffice:swriter-01
msgid "Time is variable"
msgstr "Klockslag variabelt"

#. from libreoffice:swriter-01
msgid "<SDFIELD TYPE=DATETIME SDNUM=\"1031;1031;HH:MM:SS\">10:10:36</SDFIELD>"
msgstr "<SDFIELD TYPE=DATETIME SDVAL=\"35843,4240335648\" SDNUM=\"1031;1031;HH:MM:SS\">10:10:36</SDFIELD>"

#. from libreoffice:swriter-01
msgid "DocInformation Fields"
msgstr "Dokumentinfofält"

#. from libreoffice:swriter-01
msgid "For DocInformation fields, the TYPE parameter equals DOCINFO. The SUBTYPE parameter displays the specific field type, for example, for the \"Created\" DocInformation field, SUBTYPE=CREATE. For date and time DocInformation fields, the FORMAT parameter equals DATE or TIME, and the SDNUM parameter indicates the number format that is used. The SDFIXED parameter indicates if the content of the DocInformation field is fixed or not."
msgstr "För dokumentinfofält är parametern TYPE lika med DOCINFO. Parametern SUBTYPE visar den specifika fälttypen. För t.ex. dokumentinfofältet \"Skapad\" blir SUBTYPE=CREATE. För dokumentinfofält med datum och tid är parametern FORMAT lika med DATE eller TIME, och parametern SDNUM anger vilket talformat som används. Parametern SDFIXED anger om innehållet i dokumentinfofältet är fast eller inte."

#. from libreoffice:swriter-01
msgid "The contents of a fixed date or time field are equal to the SDVAL parameter, otherwise the contents are equal to the text found between the SDFIELD HTML tags."
msgstr "Innehållet i ett fast datum- eller tidsfält är lika med parametern SDVAL. Annars är innehållet lika med den text som finns mellan SDFIELD-taggarna."

#. from libreoffice:swriter-01
msgid "Examples of DocInformation special HTML tags that are recognized by $[officename] as fields are shown in the following table:"
msgstr "Följande tabell innehåller exempel på speciella HTML-taggar för dokumentinformation som känns igen av $[officename] som fältkommandon:"

#. from libreoffice:swriter-01
msgid "$[officename] Tag"
msgstr "<emph>$[officename]-tagg</emph>"

#. from libreoffice:swriter-01
msgid "Description (fixed content)"
msgstr "Beskrivning (innehåll fast)"

#. from libreoffice:swriter-01
msgid "<SDFIELD TYPE=DOCINFO SUBTYPE=COMMENT SDFIXED>Description</SDFIELD>"
msgstr "<SDFIELD TYPE=DOCINFO SUBTYPE=COMMENT SDFIXED>beskrivning</SDFIELD>"

#. from libreoffice:swriter-01
msgid "Creation date"
msgstr "Skapande datum"

#. from libreoffice:swriter-01
msgid "<SDFIELD TYPE=DOCINFO SUBTYPE=CREATE FORMAT=DATE SDNUM=\"1031;1031;QQ YY\">1. Quarter 98</SDFIELD>"
msgstr "<SDFIELD TYPE=DOCINFO SUBTYPE=CREATE FORMAT=DATE SDNUM=\"1031;1031;KK ÅÅ\">1 kvartalet 98</SDFIELD>"

#. from libreoffice:swriter-01
msgid "Creation time (fixed content)"
msgstr "Skapande klockslag (innehåll fast)"

#. from libreoffice:swriter-01
msgid "<SDFIELD TYPE=DOCINFO SUBTYPE=CREATE FORMAT=TIME SDVAL=\"0\" SDNUM=\"1031;1031;HH:MM:SS AM/PM\" SDFIXED>03:58:35 PM</SDFIELD>"
msgstr "<SDFIELD TYPE=DOCINFO SUBTYPE=CREATE FORMAT=TIME SDVAL=\"0\" SDNUM=\"1031;1031;HH:MM:SS AM/PM\" SDFIXED>03:58:35 PM</SDFIELD>"

#. from libreoffice:swriter-01
msgid "Modification date"
msgstr "Ändring datum"

#. from libreoffice:swriter-01
msgid "<SDFIELD TYPE=DOCINFO SUBTYPE=CHANGE FORMAT=DATE SDNUM=\"1031;1031;NN DD MMM, YY\">Mo 23 Feb, 98</SDFIELD>"
msgstr "<SDFIELD TYPE=DOCINFO SUBTYPE=CHANGE FORMAT=DATE SDNUM=\"1031;1031;NN DD.MMM ÅÅ\">Må 23 feb 98</SDFIELD>"

#. from libreoffice:swriter-01
msgid "Input Field"
msgstr "Inmatningsfält"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/inputfielddialog/InputFieldDialog\">Inserts a text field that you can open and edit by clicking it in the document.</ahelp> You can use input fields for text, or to assign a new value to a variable."
msgstr "<ahelp hid=\"modules/swriter/ui/inputfielddialog/InputFieldDialog\">Infogar ett fältkommando som du kan öppna och redigera genom att klicka på det i dokumentet.</ahelp> Du kan använda inmatningsfält för text eller tilldela en variabel ett nytt värde."

#. from libreoffice:swriter-01
msgid "To change the content of an Input Field in a document, click the field, and then edit the text in the lower box of the dialog."
msgstr "Du kan ändra innehållet i ett inmatningsfält i ett dokument genom att klicka i fältet och redigera texten i den nedre rutan i dialogrutan."

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/inputfielddialog/next\">Jumps to the next input field in the document.</ahelp> This button is only available when you position the cursor directly before an input field, and then press Shift+Ctrl+F9."
msgstr "<ahelp hid=\"modules/swriter/ui/inputfielddialog/next\">Hoppar till nästa inmatningsfält i dokumentet.</ahelp> Den här knappen är bara tillgänglig när du placerar markören direkt framför ett inmatningsfält och sedan trycker på Skift+Ctrl+F9."

#. from libreoffice:swriter-01
msgid "Defining Conditions"
msgstr "Definiera villkor"

#. from libreoffice:swriter-01
msgid "<bookmark_value>logical expressions</bookmark_value>      <bookmark_value>formulating conditions</bookmark_value>      <bookmark_value>conditions; in fields and sections</bookmark_value>      <bookmark_value>fields;defining conditions</bookmark_value>      <bookmark_value>sections;defining conditions</bookmark_value>      <bookmark_value>variables; in conditions</bookmark_value>      <bookmark_value>user data;in conditions</bookmark_value>      <bookmark_value>databases;in conditions</bookmark_value>      <bookmark_value>hiding; database fields</bookmark_value>"
msgstr "<bookmark_value>logiska uttryck</bookmark_value>      <bookmark_value>formulera villkor</bookmark_value>      <bookmark_value>villkor; i fält och avsnitt</bookmark_value>      <bookmark_value>fält;definiera villkor</bookmark_value>      <bookmark_value>avsnitt;definiera villkor</bookmark_value>      <bookmark_value>variabler; i villkor</bookmark_value>      <bookmark_value>användardata;i villkor</bookmark_value>      <bookmark_value>databaser;i villkor</bookmark_value>      <bookmark_value>dölja; databasfält</bookmark_value>"

#. from libreoffice:swriter-01
msgid "<variable id=\"defining_conditions\"><link href=\"text/swriter/01/04090200.xhp\">Defining Conditions</link></variable>"
msgstr "<variable id=\"defining_conditions\"><link href=\"text/swriter/01/04090200.xhp\">Definiera villkor</link></variable>"

#. from libreoffice:swriter-01
msgid "Conditions are logical expressions that you can use to control the display of <link href=\"text/swriter/01/04090000.xhp\">fields</link> and <link href=\"text/swriter/01/04020000.xhp\">sections</link> in your document. Although the following examples apply to fields, they also apply to sections."
msgstr "Villkor är logiska uttryck som du kan använda för att kontrollera visning av <link href=\"text/swriter/01/04090000.xhp\">fält</link> och <link href=\"text/swriter/01/04020000.xhp\">områden</link> i dokumentet. Följande exempel gäller inte bara fält, utan också områden."

#. from libreoffice:swriter-01
msgid "You can define conditions for the following field types:"
msgstr "Du kan definiera villkor för följande fälttyper:"

#. from libreoffice:swriter-01
msgid "Conditional text: displays text A if the condition is true, or text B if the condition is false."
msgstr "Villkorlig text: visar text A om villkoret är sant, eller text B om villkoret är falskt."

#. from libreoffice:swriter-01
msgid "Hidden text: hides the contents of the field if the condition is true."
msgstr "Dold text: döljer fältets innehåll om villkoret är sant."

#. from libreoffice:swriter-01
msgid "Hidden paragraph: hides the paragraph if the condition is true."
msgstr "Dolt stycke: döljer stycket om villkoret är sant."

#. from libreoffice:swriter-01
msgid "Any record and next record: controls the access to database records."
msgstr "Slumpvis datapost och Nästa datapost: kontrollerar åtkomst till databasposter."

#. from libreoffice:swriter-01
msgid "The simplest way to define a condition is to type the logical expression directly in a <emph>Condition </emph>box using the following values:"
msgstr "Det enklaste sättet att definiera ett villkor är att skriva det logiska uttrycket direkt i rutan <emph>Villkor</emph> med följande värden:"

#. from libreoffice:swriter-01
msgid "The condition is always met. You can also enter any value not equal to 0 as the conditional text."
msgstr "Villkoret är alltid uppfyllt. Du kan även ange ett valfritt värde inte lika med 0 som villkorstext."

#. from libreoffice:swriter-01
msgid "The condition is not met. You can also enter the value 0."
msgstr "Villkoret är inte uppfyllt. Du kan även ange värdet 0."

#. from libreoffice:swriter-01
msgid "If you leave the <emph>Condition </emph>box empty, the condition is interpreted as not being met."
msgstr "Om du lämnar rutan <emph>Villkor</emph> tom tolkas det som att villkoret inte är uppfyllt."

#. from libreoffice:swriter-01
msgid "When you define a condition, use the same <link href=\"text/swriter/02/14020000.xhp\">elements</link> for defining a formula, namely comparative operators, mathematical and statistical functions, number formats, variables and constants."
msgstr "När du definierar ett villkor använder du samma <link href=\"text/swriter/02/14020000.xhp\">element</link> som när du definierar en formel, nämligen relationsoperatorer, matematiska funktioner, statistiska funktioner, talformat, variabler och konstanter."

#. from libreoffice:swriter-01
msgid "You can use the following types of variables when you define a condition:"
msgstr "Du kan använda följande typer av variabler när du definierar ett villkor:"

#. from libreoffice:swriter-01
msgid "Predefined <link href=\"text/swriter/02/14020000.xhp\">$[officename] variables</link> that use statistics on document properties"
msgstr "Fördefinierade <link href=\"text/swriter/02/14020000.xhp\">$[officename]-variabler</link> som använder statistik på dokumentegenskaper"

#. from libreoffice:swriter-01
msgid "Custom variables, that are a created with the \"Set variable\" field"
msgstr "Anpassade variabler som skapas med fältet \"Sätt variabel\""

#. from libreoffice:swriter-01
msgid "Variables based on user data"
msgstr "Variabler baserade på användardata"

#. from libreoffice:swriter-01
msgid "Variables based on the contents of database fields"
msgstr "Variabler baserade på innehållet i databasfält"

#. from libreoffice:swriter-01
msgid "You cannot use internal variables, such as page and chapter numbers, in condition expression."
msgstr "Du kan inte använda interna variabler i villkorsuttryck, till exempel sid- och kapitelnummer."

#. from libreoffice:swriter-01
msgid "Conditions and Variables"
msgstr "Villkor och variabler"

#. from libreoffice:swriter-01
msgid "The following examples use a variable called \"x\":"
msgstr "I följande exempel används en variabel som kallas \"x\":"

#. from libreoffice:swriter-01
msgid "x == 1 or x EQ 1"
msgstr "x == 1 eller x EQ 1"

#. from libreoffice:swriter-01
msgid "The condition is true if \"x\" is equal to 1."
msgstr "Villkoret är sant om \"x\" är lika med 1."

#. from libreoffice:swriter-01
msgid "x != 1 or x NEQ 1"
msgstr "x != 1 eller x NEQ 1"

#. from libreoffice:swriter-01
msgid "The condition is true if \"x\" does not equal 1."
msgstr "Villkoret är sant om \"x\" inte är lika med 1."

#. from libreoffice:swriter-01
msgid "sinx == 0"
msgstr "sinx == 0"

#. from libreoffice:swriter-01
msgid "The condition is true if \"x\" is a multiple of pi."
msgstr "Villkoret är sant om \"x\" är en multipel av pi."

#. from libreoffice:swriter-01
msgid "To use comparative operators with strings, the operands must be bounded by double quotation marks:"
msgstr "Om du vill använda relationsoperatorer i strängar måste operatorerna omges av dubbla citattecken."

#. from libreoffice:swriter-01
msgid "x == \"ABC\" or x EQ \"ABC\""
msgstr "x == \"ABC\" eller x EQ \"ABC\""

#. from libreoffice:swriter-01
msgid "Checks if variable \"x\" contains (true) the \"ABC\" string, or not (false)."
msgstr "Kontrollerar om variabeln \"x\" innehåller strängen \"ABC\" (sant), eller inte (falskt)."

#. from libreoffice:swriter-01
msgid "x == \"\" or x EQ \"\""
msgstr "x == \"\" eller x EQ \"\""

#. from libreoffice:swriter-01
msgid "!x or NOT x"
msgstr "!x eller NOT x"

#. from libreoffice:swriter-01
msgid "Checks if the variable \"x\" contains an empty string."
msgstr "Kontrollerar om variabeln \"x\" innehåller en tom sträng."

#. from libreoffice:swriter-01
msgid "The \"equal\" comparative operator must be represented by two equal signs (==) in a condition. For example, if you define a variable \"x\" with the value of 1, you can enter the condition as x==1."
msgstr "Relationsoperatorn \"är lika med\" måste representeras av två likhetstecken (==) i ett villkor. Om du till exempel definierar variabeln \"x\" med värdet 1, kan du ange villkoret som x==1."

#. from libreoffice:swriter-01
msgid "The following table lists user data variables and their meanings:"
msgstr "Följande tabell innehåller variabler för användardata och deras innebörd:"

#. from libreoffice:swriter-01
msgid "Business telephone number"
msgstr "Telefon - arbetet"

#. from libreoffice:swriter-01
msgid "State (not in all $[officename] versions)"
msgstr "Stat (inte i alla $[officename]-versioner)"

#. from libreoffice:swriter-01
msgid "For example, to hide a paragraph, text, or a section from a user with a specific initial, such as \"LM\", enter the condition: user_initials==\"LM\"."
msgstr "Om du t.ex. vill dölja ett stycke, text eller område från en användare med vissa initialer, t.ex. \"LM\", så anger du följande villkor: user_initials==\"LM\"."

#. from libreoffice:swriter-01
msgid "Conditions and Database Fields"
msgstr "Villkor och databasfält"

#. from libreoffice:swriter-01
msgid "You can define conditions for accessing databases, or database fields. For example, you can check the contents of a database field from a condition, or use database fields in logical expressions. The following table lists a few more examples of using databases in conditions:"
msgstr "Du kan definiera villkor för att komma åt databaser och databasfält. Du kan t.ex. kontrollera innehållet i ett databasfält utifrån ett villkor eller använda databasfält i logiska uttryck. Följande tabell innehåller några ytterligare exempel på hur du kan använda databaser i villkor:"

#. from libreoffice:swriter-01
msgid "Database.Table.Company"
msgstr "databas.tabell.företag"

#. from libreoffice:swriter-01
msgid "Database.Table.Company NEQ \"\""
msgstr "Databas.Tabell.Företag NEQ \"\""

#. from libreoffice:swriter-01
msgid "Database.Table.Company != \"\""
msgstr "Databas.Tabell.Företag != \"\""

#. from libreoffice:swriter-01
msgid "The condition is true if the COMPANY field is not empty. (In the first example, no operator is required.)"
msgstr "Villkoret är sant om fältet FÖRETAG inte är tomt. (I det första exemplet krävs ingen operator.)"

#. from libreoffice:swriter-01
msgid "!Database.Table.Company"
msgstr "!Databas.Tabell.Företag"

#. from libreoffice:swriter-01
msgid "NOT Database.Table.Company"
msgstr "NOT databas.tabell.företag"

#. from libreoffice:swriter-01
msgid "Database.Table.Company EQ \"\""
msgstr "Databas.Tabell.Företag EQ \"\""

#. from libreoffice:swriter-01
msgid "Database.Table.Company ==\"\""
msgstr "Databas.Tabell.Företag ==\"\""

#. from libreoffice:swriter-01
msgid "Returns TRUE if the COMPANY field is empty."
msgstr "Returnerar SANT om fältet FÖRETAG är tomt."

#. from libreoffice:swriter-01
msgid "Database.Table.Company !=\"Sun\""
msgstr "Databas.Tabell.Företag !=\"Sun\""

#. from libreoffice:swriter-01
msgid "Database.Table.Company NEQ \"Sun\""
msgstr "Databas.Tabell.Företag NEQ \"Sun\""

#. from libreoffice:swriter-01
msgid "Returns TRUE if the current entry in the COMPANY field is not \"Sun\". (Exclamation sign represents a logical NOT.)"
msgstr "Returnerar SANT om den aktuella poster i fältet FÖRETAG inte är Sun. (Utropstecken representerar ett logiskt ICKE.)"

#. from libreoffice:swriter-01
msgid "Database.Table.Firstname AND Database.Table.Name"
msgstr "databas.tabell.förnamn AND databas.tabell.namn"

#. from libreoffice:swriter-01
msgid "Returns TRUE if the record contains the first and the last name."
msgstr "Returnerar SANT om posten innehåller det första och sista namnet."

#. from libreoffice:swriter-01
msgid "Note the difference between the boolean NOT \"!\" and the comparative operator not equal \"!=\" (NEQ)."
msgstr "Observera skillnaden mellan det logiska Inte \"!\" (NOT) och relationsoperatorn Inte lika med \"!=\" (NEQ)."

#. from libreoffice:swriter-01
msgid "When you refer to a database field in a condition, use the form Databasename.Tablename.Fieldname. If one of the names contains a character that is an operator, such as a minus sign (-), enclose the name in square brackets, for example, Databasename.[Table-name].Fieldname. Never use spaces inside field names."
msgstr "När du refererar till ett databasfält i ett villkor använder du formen databasnamn.tabellnamn.fältnamn. Om ett av namnen innehåller ett tecken som är en operator, till exempel ett minustecken (-), ska du omgärda namnet med hakparenteser, exempelvis databasnamn.[tabellnamn].fältnamn. Använd aldrig mellanslag inuti fältnamn."

#. from libreoffice:swriter-01
msgid "Example: Hiding an Empty Database Field"
msgstr "Exempel: Dölja ett tomt databasfält"

#. from libreoffice:swriter-01
msgid "You may want to create a condition that hides an empty field, for example, if the COMPANY field is empty for some of the data records."
msgstr "Du kan vilja skapa ett villkor som döljer tomma fält, t.ex. om vissa av FÖRETAG-fältets dataposter är tomma."

#. from libreoffice:swriter-01
msgid "Select the <emph>Hidden Paragraph</emph> list entry, and type the following condition: Addressbook.Addresses.Company EQ \"\""
msgstr "Välj <emph>Dolt stycke</emph> från listan och ange följande villkor: Adressbok.Adresser.Företag EQ \"\""

#. from libreoffice:swriter-01
msgid "or type the following"
msgstr "eller skriv följande"

#. from libreoffice:swriter-01
msgid "NOT Addressbook.Addresses.Company"
msgstr "NOT Adressbok.Adresser.Företag"

#. from libreoffice:swriter-01
msgid "If the COMPANY database field is empty, the condition is true and the paragraph is hidden."
msgstr "Om databasfältet FÖRETAG är tomt så är villkoret sant och stycket döljs."

#. from libreoffice:swriter-01
msgid "Examples of Conditions in Fields"
msgstr "Exempel på villkor i fältkommandon"

#. from libreoffice:swriter-01
msgid "The following examples use the Conditional text field, although they can be applied to any fields that can be linked to a condition. The syntax used for conditions is also used for the Hidden text, Hidden paragraph, Any record or Next record fields."
msgstr "I följande exempel används fältet Villkorlig text, även om exemplen gäller alla fält som går att länka till ett villkor. Den syntax som används i villkor används också i fälten Dold text, Dolt stycke, Slumpvis datapost och Nästa datapost."

#. from libreoffice:swriter-01
msgid "To display conditional text based on the number of pages:"
msgstr "Så här visar du villkorlig text baserat på antalet sidor:"

#. from libreoffice:swriter-01
msgid "Choose <emph>Insert - Field - More Fields</emph>, and then click the <emph>Functions</emph> tab."
msgstr "Välj <emph>Infoga - Fältkommando - Andra</emph> och klicka sedan på fliken <emph>Funktioner</emph>."

#. from libreoffice:swriter-01
msgid "In the <emph>Type</emph> list, click \"Conditional text\"."
msgstr "Klicka på \"Villkorlig text\" i listan <emph>Fälttyp</emph>."

#. from libreoffice:swriter-01
msgid "In the <emph>Condition </emph>box, type \"page == 1\"."
msgstr "I rutan <emph>Villkor</emph> skriver du \"page == 1\"."

#. from libreoffice:swriter-01
msgid "In the <emph>Then</emph> box, type \"There is only one page\"."
msgstr "I rutan <emph>Så</emph> skriver du \"Det finns bara en sida\"."

#. from libreoffice:swriter-01
msgid "In the <emph>Or </emph>box, type \"There are several pages\"."
msgstr "I rutan <emph>Annars</emph> skriver du \"Det finns flera sidor\"."

#. from libreoffice:swriter-01
msgid "Click <emph>Insert</emph>, and then click <emph>Close</emph>."
msgstr "Klicka på <emph>Infoga</emph> och sedan på <emph>Stäng</emph>."

#. from libreoffice:swriter-01
msgid "To display conditional text based on a user-defined Variable"
msgstr "Så här visar du villkorlig text baserad på en användardefinierad variabel"

#. from libreoffice:swriter-01
msgid "Choose <emph>Insert - Field - More Fields</emph>, and then click the <emph>Variables</emph> tab."
msgstr "Välj <emph>Infoga - Fältkommando - Andra</emph> och klicka sedan på fliken <emph>Variabler</emph>."

#. from libreoffice:swriter-01
msgid "In the <emph>Type </emph>list, click \"Set Variable\"."
msgstr "Klicka på \"Sätt variabel\" i listan <emph>Fälttyp</emph>."

#. from libreoffice:swriter-01
msgid "In the<emph> Name</emph> box, type \"Profit\"."
msgstr "Skriv \"Vinst\" i rutan <emph>Namn</emph>."

#. from libreoffice:swriter-01
msgid "In the<emph> Value</emph> box, type \"5000\"."
msgstr "Skriv \"5000\" i rutan <emph>Värde</emph>."

#. from libreoffice:swriter-01
msgid "Click the <emph>Functions</emph> tab, and click \"Conditional text\" in the <emph>Type</emph> list."
msgstr "Klicka på fliken <emph>Funktioner</emph> och sedan på \"Villkorlig text\" i listan <emph>Fälttyp</emph>."

#. from libreoffice:swriter-01
msgid "In the <emph>Condition</emph> box, type \"Profit < 5000\"."
msgstr "Skriv \"Vinst < 5000\" i rutan <emph>Villkor</emph>."

#. from libreoffice:swriter-01
msgid "In the <emph>Then</emph> box, type \"Target is not met\"."
msgstr "Skriv \"Målet är inte uppnått\" i rutan <emph>Så</emph>."

#. from libreoffice:swriter-01
msgid "In the <emph>Or </emph>box, type \"Target is met\"."
msgstr "Skriv \"Målet är uppnått\" i rutan <emph>Annars</emph>."

#. from libreoffice:swriter-01
msgid "To edit the contents of the \"Profit\" variable, double-click the variable field."
msgstr "Om du vill redigera innehållet i variabeln \"Vinst\" dubbelklickar du på variabelfältet."

#. from libreoffice:swriter-01
msgid "To display conditional text based on the contents of a database field:"
msgstr "Så här visar du villkorlig text baserad på innehållet i ett databasfält:"

#. from libreoffice:swriter-01
msgid "The first part of this example inserts a space between the \"First Name\" and \"Last Name\" fields in a document, and the second part inserts text based on the contents of a field. This example requires that an address data source is registered with $[officename]."
msgstr "I den första delen av exemplet infogas ett mellanslag mellan fälten \"Förnamn\" och \"Efternamn\" i ett dokument, och i den andra delen infogas text baserad på innehållet i ett fält. I exemplet förutsätts att en adressdatakälla är registrerad i $[officename]."

#. from libreoffice:swriter-01
msgid "Choose <emph>Insert - Field - More Fields</emph>, and then click the <emph>Database</emph> tab."
msgstr "Välj <emph>Infoga - Fältkommando - Andra</emph> och klicka sedan på fliken <emph>Databas</emph>."

#. from libreoffice:swriter-01
msgid "In the <emph>Type </emph>list, click \"Mail merge fields\"."
msgstr "Klicka på \"Standardbrevfät\" (kopplad utskrift) i listan <emph>Fälttyp</emph>."

#. from libreoffice:swriter-01
msgid "In the<emph> Database selection</emph> box, double-click an address book, click \"First Name\", and then click<emph> Insert</emph>. Repeat for \"Last Name\"."
msgstr "Gå till rutan <emph>Databasurval</emph>, dubbelklicka på en adressbok, klicka på \"Förnamn\" och sedan på <emph>Infoga</emph>. Upprepa åtgärden för \"Efternamn\"."

#. from libreoffice:swriter-01
msgid "In the document, place the cursor between the two fields, press Space, and then return to the <emph>Fields </emph>dialog:"
msgstr "Placera markören mellan de två fälten i dokumentet, tryck på mellanslag och återgå sedan till dialogrutan <emph>Fält</emph>:"

#. from libreoffice:swriter-01
msgid "Click the <emph>Functions</emph> tab, and then click \"Conditional text\" in the <emph>Type</emph> list."
msgstr "Klicka på fliken <emph>Funktioner</emph> och sedan på \"Villkorlig text\" i listan <emph>Fälttyp</emph>."

#. from libreoffice:swriter-01
msgid "In the <emph>Condition </emph>box, type: \"Addressbook.addresses.firstname\"."
msgstr "I rutan <emph>Villkor</emph> skriver du: \"adressbok.adresser.förnamn\"."

#. from libreoffice:swriter-01
msgid "In the <emph>Then </emph>box, type a space and leave the <emph>Or </emph>box blank."
msgstr "I rutan <emph>Så</emph> skriver du ett blanksteg och lämnar rutan <emph>Annars</emph> tom."

#. from libreoffice:swriter-01
msgid "You can now use a condition to insert text based on the contents of the First Name field."
msgstr "Du kan nu använda ett villkor för att infoga text baserad på innehållet i fältet Förnamn."

#. from libreoffice:swriter-01
msgid "In the <emph>Fields </emph>dialog, click the <emph>Functions </emph>tab."
msgstr "Klicka på fliken <emph>Funktioner</emph> i dialogrutan <emph>Fält</emph>."

#. from libreoffice:swriter-01
msgid "In the <emph>Type </emph>box, click \"Conditional text\"."
msgstr "Klicka på \"Villkorlig text\" i rutan <emph>Typ</emph>."

#. from libreoffice:swriter-01
msgid "In the <emph>Condition </emph>box, type: Addressbook.addresses.firstname == \"Michael\""
msgstr "I rutan <emph>Villkor</emph> skriver du: adressbok.adresser.förnamn == \"Mikael\""

#. from libreoffice:swriter-01
msgid "In the <emph>Then </emph>box, type \"Dear\"."
msgstr "I rutan <emph>Så</emph> skriver du \"Bäste\"."

#. from libreoffice:swriter-01
msgid "In the <emph>Else</emph> box, type \"Hello\"."
msgstr "Skriv \"Hej\" i rutan <emph>Annars</emph>."

#. from libreoffice:swriter-01
msgid "Click <emph>Insert</emph>."
msgstr "Klicka på <emph>Infoga</emph>."

#. from libreoffice:swriter-01
msgid "<link href=\"text/swriter/01/04120100.xhp\">Index Entry</link>"
msgstr "<link href=\"text/swriter/01/04120100.xhp\">Post...</link>"

#. from libreoffice:swriter-01
msgid "<link href=\"text/swriter/01/04120300.xhp\">Bibliography Entry</link>"
msgstr "<link href=\"text/swriter/01/04120300.xhp\">Litteraturförteckningspost...</link>"

#. from libreoffice:swriter-01
msgid "New user-defined index"
msgstr "Ny användardefinierad förteckning"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/indexentry/new\">Opens the <emph>Create New User-defined Index</emph> dialog where you can create a custom index.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/indexentry/new\">Öppnar dialogrutan <emph>Skapa ny användardefinierad förteckning</emph> som du använder för att skapa en anpassad förteckning.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/newuserindexdialog/NewUserIndexDialog\">Enter a name for the new user-defined index. The new index is added to the list of available indexes and tables.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/newuserindexdialog/NewUserIndexDialog\">Ange namnet på den nya användardefinierade förteckningen.  Den nya förteckningen läggs till i listan över tillgängliga förteckningar och tabeller.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/indexentry/entryed\">Displays the text that is selected in the document. If you want, you can enter a different word for the index entry. The selected text in the document is not changed.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/indexentry/entryed\">Visar texten som är markerad i dokumentet. Om du vill kan du använda ett annat ord för förteckningsposten. Den markerade texten i dokumentet påverkas inte.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/indexentry/key1cb\">Makes the current selection a subentry of the word that you enter here. For example, if you select \"cold\", and enter \"weather\" as the 1st key, the index entry is \"weather, cold\".</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/indexentry/key1cb\">Gör den aktuella markeringen till en underpost till det ord du skriver här. Om du till exempel har markerat \"kallt\" och skriver in \"väder\" som sorteringskod 1, kommer förteckningsposten att bli \"väder, kallt\".</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/indexentry/key2cb\">Makes the current selection a sub-subentry of the 1st key. For example, if you select \"cold\", and enter \"weather\" as the 1st key and \"winter\" as the 2nd key, the index entry is \"weather, winter, cold\".</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/indexentry/key2cb\">Gör den aktuella markeringen till en underordnad underpost till den första nyckeln. Om du till exempel har markerat \"kallt\" och skriver in \"väder\" som sorteringskod 1 och \"vinter\" som sorteringskod 2, kommer förteckningsposten att bli \"väder, vinter, kallt\".</ahelp>"

#. from libreoffice:swriter-01
msgid "Phonetic reading"
msgstr "Fonetiskt uttal"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/indexentry/phonetic0ed\">Enter the phonetic reading for the corresponding entry. For example, if a Japanese Kanji word has more than one pronunciation, enter the correct pronunciation as a Katakana word. The Kanji word is then sorted according to the phonetic reading entry.</ahelp> This option is only available if Asian language support is enabled."
msgstr "<ahelp hid=\"modules/swriter/ui/indexentry/phonetic0ed\">Skriv in det fonetiska uttalet för motsvarande post. Om det till exempel finns fler än ett uttal för ett japanskt kanji-ord, skriver du det korrekta uttalet som ett katakana-ord. Kanji-ordet kommer sedan att sorteras efter det fonetiska uttalet.</ahelp> Alternativet är bara tillgängligt om du har aktiverat stöd för asiatiska språk."

#. from libreoffice:swriter-01
msgid "Main Entry"
msgstr "Huvudpost"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/indexentry/mainentrycb\">Makes the selected text the main entry in an alphabetical index.</ahelp> $[officename] displays the page number of the main entry in a different format than the other entries in the index."
msgstr "<ahelp hid=\"modules/swriter/ui/indexentry/mainentrycb\">Gör den markerade texten till en huvudpost i en alfabetisk förteckning.</ahelp> $[officename] visar sidnumret för huvudposten i ett annat format än andra poster i förteckningen."

#. from libreoffice:swriter-01
msgid "This option is available only for table of contents and user-defined index entries."
msgstr "Det här alternativet är endast tillgängligt för innehållsförteckningar och användardefinierade förteckningsposter."

#. from libreoffice:swriter-01
msgid "To include all occurrences of a text passage in an index, select the text, choose<emph> Edit - Find & Replace</emph>, and click <emph>Find All</emph>. Then choose <emph>Insert - Table of Contents and Index - Index Entry</emph> and click <emph>Insert</emph>."
msgstr "Om du vill ha med alla förekomster av ett textstycke i en förteckning, markerar du texten och väljer <emph>Redigera - Sök och ersätt</emph> och klickar på <emph>Sök alla</emph>. Välj sedan <emph>Infoga - Förteckningar - Post</emph> och klicka på <emph>Infoga</emph>."

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/indexentry/insert\">Marks an index entry in your text.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/indexentry/insert\">Markerar en förteckningspost i din text.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/indexentry/close\">Closes the dialog.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/indexentry/close\">Stänger dialogen.</ahelp>"

#. from libreoffice:swriter-01
msgid "<link href=\"text/swriter/guide/indices_toc.xhp\">Using Tables of Content and Indexes</link>"
msgstr "<link href=\"text/swriter/guide/indices_toc.xhp\">Använda förteckningar</link>"

#. from libreoffice:swriter-01
msgid "You can also preview the index or table in this dialog."
msgstr "Dialogrutan innehåller också en förhandsvisning av förteckningen."

#. from libreoffice:swriter-01
msgid "Depending on the type of index or table that you select, the following tabs are present."
msgstr "Beroende på vilken typ av förteckning du väljer är följande flikar tillgängliga."

#. from libreoffice:swriter-01
msgid "Use this tab to specify the column layout for the index or table of contents. By default, the index title is one-column wide and extends out from left page margin."
msgstr "Under den här fliken anger du förteckningens kolumnlayout. Förteckningens rubrik är som standard en kolumn bred och utgår från sidans vänstermarginal."

#. from libreoffice:swriter-01
msgid "<link href=\"text/swriter/guide/main.xhp\">Using Tables of Content and Indexes</link>"
msgstr "<link href=\"text/swriter/guide/main.xhp\">Använda förteckningar</link>"

#. from libreoffice:swriter-01
msgid "<link href=\"text/swriter/01/04120201.xhp\">Styles</link>"
msgstr "<link href=\"text/swriter/01/04120201.xhp\">Mallar</link>"

#. from libreoffice:swriter-01
msgid "Levels"
msgstr "Nivåer"

#. from libreoffice:swriter-01
msgid "Depending on the type of index that you select, this tab contains the following options."
msgstr "Den här fliken innehåller följande alternativ, beroende på vilken typ av förteckning du väljer."

#. from libreoffice:swriter-01
msgid "<link href=\"text/swriter/01/04120211.xhp\">Table of Contents</link>"
msgstr "<link href=\"text/swriter/01/04120211.xhp\">Innehållsförteckning</link>"

#. from libreoffice:swriter-01
msgid "<link href=\"text/swriter/01/04120212.xhp\">Alphabetical Index</link>"
msgstr "<link href=\"text/swriter/01/04120212.xhp\">Sakregister</link>"

#. from libreoffice:swriter-01
msgid "<link href=\"text/swriter/01/04120214.xhp\">Index of Tables</link>"
msgstr "<link href=\"text/swriter/01/04120214.xhp\">Tabellförteckning</link>"

#. from libreoffice:swriter-01
msgid "<link href=\"text/swriter/01/04120215.xhp\">User-Defined</link>"
msgstr "<link href=\"text/swriter/01/04120215.xhp\">Användardefinierad</link>"

#. from libreoffice:swriter-01
msgid "<link href=\"text/swriter/01/04120216.xhp\">Table of Objects</link>"
msgstr "<link href=\"text/swriter/01/04120216.xhp\">Objektförteckning</link>"

#. from libreoffice:swriter-01
msgid "<link href=\"text/swriter/01/04120217.xhp\">Bibliography</link>"
msgstr "<link href=\"text/swriter/01/04120217.xhp\">Litteraturförteckning</link>"

#. from libreoffice:swriter-01
msgid "<link href=\"text/swriter/01/04120100.xhp\">Insert - Table of Contents and Index - Index Entry</link>"
msgstr "<link href=\"text/swriter/01/04120100.xhp\">Infoga - Förteckningar - Post</link>"

#. from libreoffice:swriter-01
msgid "Specify the type and title of the index."
msgstr "Ange förteckningens typ och rubrik."

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/tocindexpage/title\">Enter a title for the selected index.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/tocindexpage/title\" visibility=\"visible\">Ange en rubrik på den markerade förteckningen.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/tocindexpage/readonly\">Prevents the contents of the index from being changed.</ahelp> Manual changes that you make to an index are lost when the index is refreshed. If you want the cursor to scroll through a protected area, choose <switchinline select=\"sys\"><caseinline select=\"MAC\"><emph>%PRODUCTNAME - Preferences</emph></caseinline><defaultinline><emph>Tools - Options</emph></defaultinline></switchinline><emph> - %PRODUCTNAME Writer - Formatting Aids</emph>, and then select the <emph>Enable cursor</emph> check box in the <emph>Protected Areas</emph> section."
msgstr "<ahelp hid=\"modules/swriter/ui/tocindexpage/readonly\">Förhindrar att innehållet i förteckningen ändras.</ahelp> Manuella ändringar som du gör i en förteckning går förlorade när förteckningen uppdateras. Om du vill bläddra med markören genom ett skyddat område väljer du <emph><switchinline select=\"sys\"><caseinline select=\"MAC\">%PRODUCTNAME – Inställningar</caseinline><defaultinline>Verktyg – Alternativ</defaultinline></switchinline> – %PRODUCTNAME Writer – Formateringshjälp</emph> och markerar sedan kryssrutan <emph>Markör i skyddade områden – Aktiverad</emph>."

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/tocindexpage/scope\">Select whether to create the index for the document or for the current chapter.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/tocindexpage/scope\" visibility=\"visible\">Välj om du vill skapa en förteckning för dokumentet eller för det aktuella kapitlet.</ahelp>"

#. from libreoffice:swriter-01
msgid "Use this area to specify which information to include in an index."
msgstr "I det här området anger du vilken information som ska ingå i en förteckning."

#. from libreoffice:swriter-01
msgid "Additional Styles"
msgstr "Ytterligare mallar"

#. from libreoffice:swriter-01
msgid "Assign styles"
msgstr "Tilldela mall"

#. from libreoffice:swriter-01
msgid "<link href=\"text/swriter/01/04120212.xhp\">Index</link>"
msgstr "<link href=\"text/swriter/01/04120212.xhp\">Förteckning</link>"

#. from libreoffice:swriter-01
msgid "<variable id=\"verzeichnis\">The following options are available when you select <emph>Alphabetical Index </emph>as the <link href=\"text/swriter/01/04120210.xhp\">index</link> type. </variable>"
msgstr "<variable id=\"verzeichnis\">Följande alternativ är tillgängliga när du väljer <emph>Sakregister</emph> som <link href=\"text/swriter/01/04120210.xhp\">typ av förteckning</link>. </variable>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/tocindexpage/combinesame\">Replaces identical index entries with a single entry that lists the page numbers where the entry occurs in the document. For example, the entries \"View 10, View 43\" are combined as \"View 10, 43\".</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/tocindexpage/combinesame\">Ersätter identiska förteckningsposter med en enda som visar de sidnummer där posten förekommer i dokumentet. T.ex. posterna \"Visning 10, visning 43\" slås samman till \"Visning 10, 43\".</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/tocindexpage/usedash\">Replaces identical index entries that occur on consecutive pages with a single entry and the page range where the entry occurs. For example, the entries \"View 10, View 11, View 12\" are combined as \"View 10-12\".</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/tocindexpage/usedash\">Ersätter förteckningsposter som förekommer på sammanhängande sidor med en enda post och det sidområde där posten förekommer. Posterna \"Visning 10, visning 11, visning 12\" slås t.ex. samman till \"Visning 10-12\".</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/tocindexpage/casesens\">Distinguishes between uppercase and lowercase letters in identical index entries. For Asian languages special handling applies.</ahelp> If you want the first occurrence of the entry in the document to determine the case of the entry, select <emph>Combine identical entries</emph>."
msgstr "<ahelp hid=\"modules/swriter/ui/tocindexpage/casesens\">Skiljer mellan stora och små bokstäver i identiska förteckningsposter. Asiatiska språk kräver särskild hantering.</ahelp> Om du vill att första förekomsten av en post i dokumentet ska bestämma postens skiftläge ska du markera <emph>Kombinera likadana poster</emph>."

#. from libreoffice:swriter-01
msgid "To use multi-level collation to Asian languages, select <emph>Case sensitive</emph>. In the multi-level collation, the cases and diacritics of the entries are ignored and only the primitive forms of the entries are compared. If the forms are identical, the diacritics of the forms are compared. If the forms are still identical, the cases of the forms as well as the widths of the characters, and the differences in the Japanese Kana are compared."
msgstr "Om du vill använda flernivåskollation för asiatiska språk väljer du <emph>Versalkänslig</emph>. Vid flernivåskollation ignoreras posternas kasus och diakritiska tecken, och endast posternas grundform jämförs. Om formerna är identiska jämförs formernas diakritiska tecken. Om formerna fortfarande är identiska jämförs även formernas kasus och teckenbredd samt skillnaderna i japansk kana."

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/tocindexpage/initcaps\">Automatically capitalizes the first letter of an index entry.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/tocindexpage/initcaps\">Ger automatiskt förteckningsposterna stor begynnelsebokstav.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/tocindexpage/keyasentry\">Inserts index keys as separate index entries.</ahelp> A key is inserted as a top level index entry and the entries that are assigned to the key as indented subentries."
msgstr "<ahelp hid=\"modules/swriter/ui/tocindexpage/keyasentry\">Infogar nyckelbegrepp som separata förteckningsposter.</ahelp> Ett nyckelord infogas som överbegrepp och de poster som är tilldelade nyckelordet visas under nyckelordet med indrag."

#. from libreoffice:swriter-01
msgid "To define an index key, choose <link href=\"text/swriter/01/04120100.xhp\"><emph>Insert Index Entry</emph></link> dialog."
msgstr "Du definierar ett nyckelord genom att välja dialogrutan <link href=\"text/swriter/01/04120100.xhp\"><emph>Infoga förteckningspost</emph></link>."

#. from libreoffice:swriter-01
msgid "Concordance file"
msgstr "Konkordansfil"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/tocindexpage/fromfile\">Automatically marks index entries using a concordance file - a list of words to include in an index.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/tocindexpage/fromfile\">Markerar automatiskt förteckningsposter med hjälp av en konkordansfil - en lista över vilka ord som ska ingå i en förteckning.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/tocindexpage/file\">Select, create, or edit a concordance file.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/tocindexpage/file\">Markera, skapa eller redigera en konkordansfil.</ahelp>"

#. from libreoffice:swriter-01
msgid "Sets the options for sorting the index entries."
msgstr "Anger alternativ för sortering av förteckningsposter."

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/tocindexpage/lang\">Select the language rules to use for sorting the index entries.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/tocindexpage/lang\">Välj de språkregler som ska användas vid sortering av förteckningsposter.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/tocindexpage/keytype\">Select numeric when you want to sort numbers by value, such as in 1, 2, 12. Select alphanumeric, when you want to sort the numbers by character code, such as in 1, 12, 2.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/tocindexpage/keytype\">Välj numeriskt om du vill sortera numren efter värde, som t.ex. 1, 2, 12. Välj alfanumeriskt om du vill sortera numren efter teckenkod, som t.ex. 1, 12, 2.</ahelp>"

#. from libreoffice:swriter-01
msgid "Specify the information to be combined to form an index."
msgstr "Ange den information som ska kombineras för att skapa en förteckning."

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/tocindexpage/captions\">Creates index entries from object captions.</ahelp> To add a caption to an object, select the object, and then choose <emph>Insert - Caption</emph>."
msgstr "<ahelp hid=\"modules/swriter/ui/tocindexpage/captions\">Skapar förteckningsposter av bildtexter.</ahelp> Du kan lägga till en bildtext i ett objekt genom att markera objektet och välja <emph>Infoga - Bildtext</emph>."

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/tocindexpage/category\">Select the caption category that you want to use for the index entries.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/tocindexpage/category\">Välj vilken bildtextkategori som du vill använda i förteckningsposter.</ahelp>"

#. from libreoffice:swriter-01
msgid "Selections in the Display list box"
msgstr "<emph>Val i listrutan Visning</emph>"

#. from libreoffice:swriter-01
msgid "Entry in the Index"
msgstr "<emph>Post i förteckningen</emph>"

#. from libreoffice:swriter-01
msgid "The Sun"
msgstr "Solen"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/tocindexpage/objnames\">Creates index entries from object names.</ahelp> You can view object names in the Navigator, for example, and change them in the context menu."
msgstr "<ahelp hid=\"modules/swriter/ui/tocindexpage/objnames\">Skapar förteckningsposter av objektnamn.</ahelp> Du kan visa objektnamn i t.ex. Navigator, och ändra dem på snabbmenyn."

#. from libreoffice:swriter-01
msgid "<link href=\"text/swriter/01/04120214.xhp\">Index</link>"
msgstr "<link href=\"text/swriter/01/04120214.xhp\">Förteckning</link>"

#. from libreoffice:swriter-01
msgid "<variable id=\"verzeichnis\">The following options are available when you select <emph>Index of Tables </emph>as the <link href=\"text/swriter/01/04120210.xhp\">index</link> type.</variable>"
msgstr "<variable id=\"verzeichnis\">Följande alternativ är tillgängliga när du väljer <emph>Tabellförteckning</emph> som typ av <link href=\"text/swriter/01/04120210.xhp\">förteckning</link>.</variable>"

#. from libreoffice:swriter-01
msgid "<variable id=\"verzeichnis\">The following options are available when you select <emph>User-Defined </emph>as the <link href=\"text/swriter/01/04120210.xhp\">index</link> type.</variable>"
msgstr "<variable id=\"verzeichnis\">Följande alternativ är tillgängliga när du väljer <emph>Användardefinierad</emph> som typ av <link href=\"text/swriter/01/04120210.xhp\">förteckning</link>.</variable>"

#. from libreoffice:swriter-01
msgid "Create from"
msgstr "Skapa från"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/tocindexpage/fromtables\">Includes tables in the index.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/tocindexpage/fromtables\">Tar med tabeller i förteckningen.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/tocindexpage/fromgraphics\">Includes graphics in the index.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/tocindexpage/fromgraphics\">Tar med grafiska objekt i förteckningen.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/tocindexpage/fromoles\">Includes OLE objects in the index.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/tocindexpage/fromoles\">Tar med OLE-objekt i förteckningen.</ahelp>"

#. from libreoffice:swriter-01
msgid "<link href=\"text/swriter/01/04120100.xhp\">Defining an index entry</link>"
msgstr "<link href=\"text/swriter/01/04120100.xhp\">Definiera en förteckningspost</link>"

#. from libreoffice:swriter-01
msgid "<link href=\"text/swriter/01/04120216.xhp\">Index</link>"
msgstr "<link href=\"text/swriter/01/04120216.xhp\">Förteckning</link>"

#. from libreoffice:swriter-01
msgid "<variable id=\"verzeichnis\">The following options are available when you select <emph>Table of Objects </emph>as the <link href=\"text/swriter/01/04120210.xhp\">index</link> type.</variable>"
msgstr "<variable id=\"verzeichnis\">Följande alternativ är tillgängliga när du väljer <emph>Objektförteckning</emph> som typ av <link href=\"text/swriter/01/04120210.xhp\">förteckning</link>.</variable>"

#. from libreoffice:swriter-01
msgid "Create from the following objects"
msgstr "Skapa från följande objekt"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/tocindexpage/objects\">Select the object types that you want to include in a table of objects.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/tocindexpage/objects\">Välj de objekttyper som du vill ta med i en objekttabell.</ahelp>"

#. from libreoffice:swriter-01
msgid "<link href=\"text/swriter/01/04120217.xhp\">Index</link>"
msgstr "<link href=\"text/swriter/01/04120217.xhp\">Förteckning</link>"

#. from libreoffice:swriter-01
msgid "<variable id=\"verzeichnis\">The following options are available when you select <emph>Bibliography </emph>as the <link href=\"text/swriter/01/04120210.xhp\">index</link> type.</variable>"
msgstr "<variable id=\"verzeichnis\">Följande alternativ är tillgängliga när du väljer <emph>Litteraturförteckning</emph> som typ av <link href=\"text/swriter/01/04120210.xhp\">förteckning</link>.</variable>"

#. from libreoffice:swriter-01
msgid "Formatting of the entries"
msgstr "Formatering av poster"

#. from libreoffice:swriter-01
msgid "Number entries"
msgstr "Numrera poster"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/tocindexpage/numberentries\">Automatically numbers the bibliography entries.</ahelp> To set the sorting options for the numbering, click the <link href=\"text/swriter/01/04120227.xhp\">Entries</link> tab."
msgstr "<ahelp hid=\"modules/swriter/ui/tocindexpage/numberentries\">Numrerar automatiskt posterna i litteraturförteckningen.</ahelp> Du kan ange sorteringsalternativ för numrering genom att klicka på fliken <link href=\"text/swriter/01/04120227.xhp\">Poster</link>."

#. from libreoffice:swriter-01
msgid "<link href=\"text/swriter/01/04120219.xhp\">Assign Styles</link>"
msgstr "<link href=\"text/swriter/01/04120219.xhp\">Tilldela mall</link>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/assignstylesdialog/AssignStylesDialog\" visibility=\"visible\">Creates index entries from specific paragraph styles.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/assignstylesdialog/AssignStylesDialog\" visibility=\"visible\">Skapar förteckningsposter baserade på specifika styckeformatmallar.</ahelp>"

#. from libreoffice:swriter-01
msgid "The list contains the paragraph styles that you can assign to index levels."
msgstr "Listan innehåller de styckeformatmallar som du kan tilldela förteckningsnivåer."

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/assignstylesdialog/left\" visibility=\"visible\">Moves the selected paragraph style up one level in the index hierarchy.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/assignstylesdialog/left\" visibility=\"visible\">Flyttar upp den markerade styckeformatmallen en nivå i förteckningshierarkin.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/assignstylesdialog/right\" visibility=\"visible\">Moves the selected paragraph style down one level in the index hierarchy.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/assignstylesdialog/right\" visibility=\"visible\">Flyttar ned den markerade styckeformatmallen en nivå i förteckningshierarkin.</ahelp>"

#. from libreoffice:swriter-01
msgid "Entries (indexes/tables)"
msgstr "Poster (förteckningar)"

#. from libreoffice:swriter-01
msgid "<link href=\"text/swriter/01/04120220.xhp\">Entries (indexes/tables)</link>"
msgstr "<link href=\"text/swriter/01/04120220.xhp\">Poster (förteckningar)</link>"

#. from libreoffice:swriter-01
msgid "<link href=\"text/swriter/01/04120221.xhp\">Table of Contents</link>"
msgstr "<link href=\"text/swriter/01/04120221.xhp\">Innehållsförteckning</link>"

#. from libreoffice:swriter-01
msgid "<link href=\"text/swriter/01/04120222.xhp\">Alphabetical Index</link>"
msgstr "<link href=\"text/swriter/01/04120222.xhp\">Sakregister</link>"

#. from libreoffice:swriter-01
msgid "<link href=\"text/swriter/01/04120223.xhp\">Illustration Index</link>"
msgstr "<link href=\"text/swriter/01/04120223.xhp\">Illustrationsförteckning</link>"

#. from libreoffice:swriter-01
msgid "<link href=\"text/swriter/01/04120224.xhp\">Index of Tables</link>"
msgstr "<link href=\"text/swriter/01/04120224.xhp\">Tabellförteckning</link>"

#. from libreoffice:swriter-01
msgid "<link href=\"text/swriter/01/04120225.xhp\">User-Defined</link>"
msgstr "<link href=\"text/swriter/01/04120225.xhp\">Användardefinierad</link>"

#. from libreoffice:swriter-01
msgid "<link href=\"text/swriter/01/04120226.xhp\">Table of Objects</link>"
msgstr "<link href=\"text/swriter/01/04120226.xhp\">Objektförteckning</link>"

#. from libreoffice:swriter-01
msgid "<link href=\"text/swriter/01/04120227.xhp\">Bibliography</link>"
msgstr "<link href=\"text/swriter/01/04120227.xhp\">Litteraturförteckning</link>"

#. from libreoffice:swriter-01
msgid "Entries (table of contents)"
msgstr "Poster (innehållsförteckning)"

#. from libreoffice:swriter-01
msgid "<link href=\"text/swriter/01/04120221.xhp\">Entries (table of contents)</link>"
msgstr "<link href=\"text/swriter/01/04120221.xhp\">Poster (innehållsförteckning)</link>"

#. from libreoffice:swriter-01
msgid "<variable id=\"eintraege\">Specify the format of the entries in the table of contents.</variable>"
msgstr "<variable id=\"eintraege\">Ange posternas format i en innehållsförteckning.</variable>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".\">Select the level that you want to define.</ahelp>"
msgstr "<ahelp hid=\".\">Markera den nivå som du vill definiera.</ahelp>"

#. from libreoffice:swriter-01
msgid "Structure and formatting"
msgstr "Struktur och formatering"

#. from libreoffice:swriter-01
msgid "The <emph>Structure </emph>line defines how the entries in the index are composed. To change the appearance of an entry you can enter codes or text in the empty boxes on this line. You can also click in an empty box or on a code, and then click a code button."
msgstr "På <emph>strukturraden</emph> anges hur posterna i indexet är sammansatta. Du kan ändra utseende på en post genom att ange kod eller text i de tomma rutorna på den här raden. Du kan också klicka i en tom ruta eller på en kod, och sedan klicka på en kodknapp."

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".\" visibility=\"hidden\">Displays the remainder of the <emph>Structure </emph>line.</ahelp>"
msgstr "<ahelp hid=\".\" visibility=\"hidden\">Visar resten av <emph>strukturraden</emph>.</ahelp>"

#. from libreoffice:swriter-01
msgid "To replace a code from the <emph>Structure </emph>line, click the code, and then click a code button."
msgstr "Du kan ersätta en kod från <emph>strukturraden</emph> genom att klicka på koden och sedan klicka på en kodknapp."

#. from libreoffice:swriter-01
msgid "To add a code to the <emph>Structure </emph>line, click in an empty box, and then click a code button."
msgstr "Du kan lägga till en kod i raden <emph>Struktur</emph> genom att klicka i en tom ruta, och sedan klicka på en kodknapp."

#. from libreoffice:swriter-01
msgid "Entry text (E)"
msgstr "Posttext"

#. from libreoffice:swriter-01
msgid "Tab stop (T)"
msgstr "Tabulator"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/tocentriespage/tabstop\">Inserts a tab stop. To add leader dots to the tab stop, select a character in the <emph>Fill character box</emph>. To change the position of the tab stop, enter a value in the <emph>Tab stop position </emph>box, or select the <emph>Align right </emph>check box.</ahelp>"
msgstr "<ahelp visibility=\"visible\" hid=\"modules/swriter/ui/tocentriespage/tabstop\">Infogar en tabulator. Du kan lägga till inledande punkter i tabulatorn genom att markera ett tecken i rutan <emph>Utfyllnadstecken</emph>. Du kan ändra tabulatorns position genom att ange ett värde i rutan <emph>Tabulatorposition</emph>, eller markera kryssrutan <emph>Högerjustera</emph>.</ahelp>"

#. from libreoffice:swriter-01
msgid "Page number (#)"
msgstr "Sidnummer (#)"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/tocentriespage/pageno\">Inserts the page number of the entry.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/tocentriespage/pageno\" visibility=\"visible\">Infogar postens sidnummer.</ahelp>"

#. from libreoffice:swriter-01
msgid "Hyperlink (LS and LE)"
msgstr "Hyperlänk"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/tocentriespage/edit\">Opens a dialog where you can edit the selected character style.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/tocentriespage/edit\" visibility=\"visible\">Öppnar en dialogruta där du kan redigera den markerade teckenformatmallen.</ahelp>"

#. from libreoffice:swriter-01
msgid "Fill character"
msgstr "Utfyllnadstecken"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/tocentriespage/fillchar\">Select the tab leader that you want use.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/tocentriespage/fillchar\" visibility=\"visible\">Välj det utfyllnadstecken som ska placeras framför tabulatorn.</ahelp>"

#. from libreoffice:swriter-01
msgid "Tab stop position"
msgstr "Tabulatorposition"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/tocentriespage/tabstoppos\">Enter the distance to leave between the left page margin and the tab stop.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/tocentriespage/tabstoppos\" visibility=\"visible\">Ange önskat avstånd mellan vänster sidmarginal och tabulatorn.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/tocentriespage/alignright\">Aligns the tab stop to the right page margin.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/tocentriespage/alignright\" visibility=\"visible\">Justerar tabulatorn efter höger sidmarginal.</ahelp>"

#. from libreoffice:swriter-01
msgid "Tab position relative to Paragraph Style indent"
msgstr "Tabbarnas position relativ till indraget från styckeformatmallen"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/tocentriespage/reltostyle\">Positions the tab stop relative to the \"indent from left\" value defined in the paragraph style selected on the <emph>Styles</emph> tab. Otherwise the tab stop is positioned relative to the left text margin.</ahelp>"
msgstr "<ahelp visibility=\"visible\" hid=\"modules/swriter/ui/tocentriespage/reltostyle\">Placerar tabulatorn relativt det värde för \"indrag från vänster\" som anges i styckeformatmallen som markerades under fliken <emph>Mallar</emph>. Annars placeras tabulatorn relativt vänster textmarginal.</ahelp>"

#. from libreoffice:swriter-01
msgid "Entries (alphabetical index)"
msgstr "Poster (sakregister)"

#. from libreoffice:swriter-01
msgid "<link href=\"text/swriter/01/04120222.xhp\">Entries (alphabetical index)</link>"
msgstr "<link href=\"text/swriter/01/04120222.xhp\">Poster (sakregister)</link>"

#. from libreoffice:swriter-01
msgid "<variable id=\"eintraege\">Specify the format of the alphabetical index entries. </variable>"
msgstr "<variable id=\"eintraege\">Ange format för förteckningsposter i ett sakregister.</variable>"

#. from libreoffice:swriter-01
msgid "Level \"S\" refers to the single letter headings that divide the index entries alphabetically. To enable these headings, select the <emph>Alphabetical delimiter</emph> check box in the <emph>Format</emph> area."
msgstr "Den första nivån \"T\" avser skiljetecken som består av en bokstav och delar upp förteckningsposterna alfabetiskt. Du kan aktivera de här skiljetecknen genom att markera kryssrutan <emph>Alfabetiskt skiljetecken</emph> i området <emph>Format</emph>."

#. from libreoffice:swriter-01
msgid "Character Style for main entries"
msgstr "Teckenformatmall för huvudposter"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/tocentriespage/mainstyle\">Specify the formatting style for the main entries in the alphabetical index. To convert an index entry into a main entry, click in front of the index field in the document and then choose <emph>Edit - </emph><link href=\"text/swriter/01/04120100.xhp\"><emph>Index Entry</emph></link>.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/tocentriespage/mainstyle\">Ange teckenformatmallen för huvudposterna i sakregistret. Du kan konvertera en förteckningspost till en huvudpost genom att klicka framför förteckningsposten i dokumentet och sedan välja <emph>Redigera - </emph><link href=\"text/swriter/01/04120100.xhp\"><emph>Förteckningspost</emph></link>.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/tocentriespage/alphadelim\">Uses the initial letters of the alphabetically arranged index entries as section headings.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/tocentriespage/alphadelim\">Använder begynnelsebokstäverna i alfabetiskt ordnade förteckningsposter som områdesrubriker.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/tocentriespage/commasep\">Arranges the index entries on the same line, separated by commas.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/tocentriespage/commasep\">Ordnar förteckningsposterna på samma rad, separerade av kommatecken.</ahelp>"

#. from libreoffice:swriter-01
msgid "Entries (index of tables)"
msgstr "Poster (tabellförteckning)"

#. from libreoffice:swriter-01
msgid "<link href=\"text/swriter/01/04120224.xhp\">Entries (index of tables)</link>"
msgstr "<link href=\"text/swriter/01/04120224.xhp\">Poster (tabellförteckning)</link>"

#. from libreoffice:swriter-01
msgid "<variable id=\"eintraege\">Specify the format for the entries in an Index of Tables. </variable>"
msgstr "<variable id=\"eintraege\">Ange posternas format i en tabellförteckning.</variable>"

#. from libreoffice:swriter-01
msgid "An Index of Tables only has one index level."
msgstr "En tabellförteckning har bara en förteckningsnivå."

#. from libreoffice:swriter-01
msgid "Entries (user-defined index)"
msgstr "Poster (användardefinierad förteckning)"

#. from libreoffice:swriter-01
msgid "<link href=\"text/swriter/01/04120225.xhp\">Entries (user-defined index)</link>"
msgstr "<link href=\"text/swriter/01/04120225.xhp\">Poster (användardefinierad förteckning)</link>"

#. from libreoffice:swriter-01
msgid "<variable id=\"eintraege\">Specify the format for the entries in a user-defined index. </variable>"
msgstr "<variable id=\"eintraege\">Ange posternas format i en användardefinierad förteckning.</variable>"

#. from libreoffice:swriter-01
msgid "User-defined indexes do not support sub-keys."
msgstr "Användardefinierade index stöder inte undernycklar."

#. from libreoffice:swriter-01
msgid "Entries (table of objects)"
msgstr "Poster (objektförteckning)"

#. from libreoffice:swriter-01
msgid "<link href=\"text/swriter/01/04120226.xhp\">Entries (table of objects)</link>"
msgstr "<link href=\"text/swriter/01/04120226.xhp\">Poster (objektförteckning)</link>"

#. from libreoffice:swriter-01
msgid "<variable id=\"eintraege\">Specify the format for the entries in a Table of Objects. </variable>"
msgstr "<variable id=\"eintraege\">Ange posternas format i en objektförteckning.</variable>"

#. from libreoffice:swriter-01
msgid "A Table of Objects only has one index level."
msgstr "En objektförteckning har bara en förteckningsnivå."

#. from libreoffice:swriter-01
msgid "Entries (bibliography)"
msgstr "Poster (litteraturförteckning)"

#. from libreoffice:swriter-01
msgid "<link href=\"text/swriter/01/04120227.xhp\">Entries (bibliography)</link>"
msgstr "<link href=\"text/swriter/01/04120227.xhp\">Poster (litteraturförteckning)</link>"

#. from libreoffice:swriter-01
msgid "<variable id=\"eintraege\">Specify the format for bibliography entries.</variable>"
msgstr "<variable id=\"eintraege\">Ange format för posterna i en litteraturförteckning.</variable>"

#. from libreoffice:swriter-01
msgid "The types that are displayed depend on the different literature sources."
msgstr "Vilka typer som visas beror på litteraturreferensernas olika källor."

#. from libreoffice:swriter-01
msgid "Lists the available bibliography entries. <ahelp hid=\".\">To add an entry to the Structure line, click the entry, click in an empty box on the Structure line, and then click <emph>Insert</emph>.</ahelp> Use the <link href=\"text/swriter/01/04120229.xhp\">Define Bibliography Entry</link> dialog to add new entries."
msgstr "Visar tillgängliga poster i litteraturförteckningen. <ahelp hid=\".\">Du kan lägga till en post på strukturraden genom att klicka på posten, klicka i en tom ruta på strukturraden, och sedan klicka på <emph>Infoga</emph>.</ahelp> Använd dialogrutan <link href=\"text/swriter/01/04120229.xhp\">Definiera litteraturpost</link> när du vill lägga till nya poster."

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/tocentriespage/insert\">Adds the reference code for the selected bibliography entry to the Structure line. Select an entry in the list, click in an empty box, and then click this button.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/tocentriespage/insert\">Lägger till referenskoden för den markerade litteraturposten på strukturraden. Markera en post i listan, klicka i en tom ruta, och klicka sedan på den här knappen.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/tocentriespage/remove\">Removes the selected reference code from the Structure line.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/tocentriespage/remove\">Tar bort den markerade referenskoden från strukturraden.</ahelp>"

#. from libreoffice:swriter-01
msgid "Specify the sorting options for the bibliography entries."
msgstr "Ange sorteringsalternativ för litteraturposter."

#. from libreoffice:swriter-01
msgid "Document position"
msgstr "Dokumentposition"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/tocentriespage/sortpos\">Sorts the bibliography entries according to the position of their references in the document.</ahelp> Select this option if you want to use automatically numbered references."
msgstr "<ahelp hid=\"modules/swriter/ui/tocentriespage/sortpos\">Sorterar litteraturposter efter platsen för deras referenser i dokumentet.</ahelp> Välj det här alternativet om du vill använda automatiskt numrerade referenser."

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/tocentriespage/sortcontents\">Sorts the bibliography entries by the Sort keys that you specify, for example, by author or by year of publication.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/tocentriespage/sortcontents\">Sorterar litteraturposterna efter de sorteringsnycklar som du anger, till exempel efter författare eller publiceringsår.</ahelp>"

#. from libreoffice:swriter-01
msgid "Sort keys"
msgstr "Sorteringsnyckel"

#. from libreoffice:swriter-01
msgid "1, 2 or 3"
msgstr "1, 2 eller 3"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/tocentriespage/key3lb\">Select the entry by which to sort the bibliography entries. This option is only available if you select the <emph>Content</emph> radio button in the <emph>Sort by</emph> area.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/tocentriespage/key3lb\">Markera den post som litteraturposterna ska sorteras efter. Det här alternativet är bara tillgängligt om du markerar alternativfältet <emph>Innehåll</emph> under <emph>Sortera efter</emph>.</ahelp>"

#. from libreoffice:swriter-01
msgid "AZ"
msgstr "AZ"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/tocentriespage/up3cb\">Sorts the bibliography entries in ascending alphanumerical order.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/tocentriespage/up3cb\">Sorterar litteraturposterna i stigande alfanumerisk ordning.</ahelp>"

#. from libreoffice:swriter-01
msgid "ZA"
msgstr "ZA"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/tocentriespage/down3cb\">Sorts the bibliography entries in a descending alphanumerical order.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/tocentriespage/down3cb\">Sorterar litteraturposterna i fallande alfanumerisk ordning.</ahelp>"

#. from libreoffice:swriter-01
msgid "<link href=\"text/swriter/01/04120229.xhp\">Define Bibliography Entry</link>"
msgstr "<link href=\"text/swriter/01/04120229.xhp\">Definiera litteraturpost</link>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/createauthorentry/CreateAuthorEntryDialog\">Change the content of a bibliography entry.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/createauthorentry/CreateAuthorEntryDialog\">Ändra innehållet i en litteraturpost.</ahelp>"

#. from libreoffice:swriter-01
msgid "Entry data"
msgstr "Postdata"

#. from libreoffice:swriter-01
msgid "Enter a short name and select the appropriate source type. You can now enter data into the other fields belonging for the entry."
msgstr "Ange ett kort namn och välj lämplig typ av källa. Du kan nu ange data i de andra fälten som hör till den här posten."

#. from libreoffice:swriter-01
msgid "<link href=\"text/swriter/01/04120227.xhp\">Formatting bibliography entries</link>"
msgstr "<link href=\"text/swriter/01/04120227.xhp\">Formatera litteraturposter</link>"

#. from libreoffice:swriter-01
msgid "<bookmark_value>editing; concordance files</bookmark_value>  <bookmark_value>concordance files; definition</bookmark_value>"
msgstr "<bookmark_value>Redigera; konkordansfiler</bookmark_value><bookmark_value>Konkordansfiler; definition</bookmark_value>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/createautomarkdialog/CreateAutomarkDialog\">Create or edit a list of words to include in an Alphabetical Index.</ahelp> A concordance file lists words that should be referenced in an alphabetical index, together with the page number(s) where they appear in the document."
msgstr "<ahelp hid=\"modules/swriter/ui/createautomarkdialog/CreateAutomarkDialog\">Skapa eller redigera en lista med ord som ska tas med i ett sakregister.</ahelp> En konkordansfil innehåller ord som ska finnas med i ett sakregister, bredvid motsvarande sidhänvisningar."

#. from libreoffice:swriter-01
msgid "You can use the Find All button on the Find & Replace dialog to highlight all places where a word appears, then open the Insert Index Entry dialog to add that word and places to the alphabetical index. However, if you need the same set of alphabetical indexes in multiple documents, the concordance file allows you to enter every word just once, then use the list many times."
msgstr "Du kan använda knappen Hitta alla i dialogrutan Sök och ersätt för att markera alla ställen där ett ord visas. Öppna sedan dialogrutan Infoga indexpost om du vill lägga till ordet och platsen till sakregistret. Behöver du använda samma sakregister i flera dokument, tillåter konkordansfilen bara att varje ord anges en gång, och sedan ska listan användas flera gånger."

#. from libreoffice:swriter-01
msgid "To access the Edit Concordance File dialog:"
msgstr "Så här öppnar du dialogrutan Redigera konkordansfil:"

#. from libreoffice:swriter-01
msgid "In the <emph>Type </emph>box, select \"Alphabetical Index\"."
msgstr "Klicka på \"Sakregister\" i rutan <emph>Typ</emph>."

#. from libreoffice:swriter-01
msgid "In the <emph>Options </emph>area, select the <emph>Concordance file</emph> check box."
msgstr "Markera kryssrutan <emph>Konkordansfil</emph> i området <emph>Tillägg</emph>."

#. from libreoffice:swriter-01
msgid "Click the <emph>File</emph> button, and then choose <emph>New</emph> or <emph>Edit</emph>."
msgstr "Klicka på knappen <emph>Fil</emph> och välj <emph>Ny</emph> eller <emph>Redigera</emph>."

#. from libreoffice:swriter-01
msgid "A concordance file contains the following fields:"
msgstr "En konkordansfil innehåller följande fält:"

#. from libreoffice:swriter-01
msgid "\"Search term\" refers to the index entry that you want to mark in the document."
msgstr "\"Sökord\" är den förteckningspost som du vill markera i dokumentet."

#. from libreoffice:swriter-01
msgid "\"Alternative entry\" refers to the index entry that you want to appear in the index."
msgstr "\"Alternativpost\" är den förteckningspost som du vill visa i förteckningen."

#. from libreoffice:swriter-01
msgid "The 1st and 2nd Keys are parent index entries. The \"Search term\" or the \"Alternative entry\" appears as a subentry under the 1st and 2nd Keys."
msgstr "Nycklarna 1 och 2 är överordnade förteckningsposter. \"Sökord\" eller \"Alternativpost\" visas som en underordnad post under nycklarna 1 och 2."

#. from libreoffice:swriter-01
msgid "\"Match case\" means that uppercase and lowercase letters are considered."
msgstr "\"Exakt\" innebär att versaler och gemener matchas."

#. from libreoffice:swriter-01
msgid "\"Word only\" searches for the term as a single word."
msgstr "\"Hela ord\" söker efter ett uttryck som utgörs av ett helt ord."

#. from libreoffice:swriter-01
msgid "To enable the \"Match case\" or \"Word only\" options, click in the corresponding cell, and then select the check box."
msgstr "Du aktiverar alternativen \"Exakt\" och \"Hela ord\" genom att klicka i motsvarande cell, och sedan markera kryssrutan."

#. from libreoffice:swriter-01
msgid "To create a concordance file without the Edit Concordance File dialog:"
msgstr "Så här skapar du en konkordansfil utan dialogrutan Redigera konkordansfil:"

#. from libreoffice:swriter-01
msgid "Use the following format guidelines when you create a concordance file:"
msgstr "Använd följande riktlinjer för formatering när du skapar en konkordansfil:"

#. from libreoffice:swriter-01
msgid "Each entry in the concordance file is on a separate line."
msgstr "Varje post i konkordansfilen står på en separat rad."

#. from libreoffice:swriter-01
msgid "Commented lines start with #."
msgstr "Kommenterade rader börjar med #."

#. from libreoffice:swriter-01
msgid "Use the following format for the entries:"
msgstr "Använd följande format för posterna:"

#. from libreoffice:swriter-01
msgid "The entries \"Match case\" and \"Word only\" are interpreted as \"No\" or FALSE if they are empty or zero (0). All other contents are interpreted as \"Yes\" or TRUE."
msgstr "Posterna \"Exakt\" och \"Hela ord\" tolkas som \"Nej\" eller FALSE om de är tomma eller lika med noll (0). Allt annat innehåll tolkas som \"Ja\" eller TRUE."

#. from libreoffice:swriter-01
msgid "For example, to include the word \"Boston\" in your alphabetical index under the \"Cities\" entry, enter the following line in the concordance file:"
msgstr "Om du t.ex. vill ta med ordet \"Göteborg\" i sakregistret under posten \"Städer\", skriver du följande rad i konkordansfilen:"

#. from libreoffice:swriter-01
msgid "This also finds \"Boston\" if it is written in lowercase letters."
msgstr "\"Göteborg\" känns igen även om det är skrivet med liten begynnelsebokstav."

#. from libreoffice:swriter-01
msgid "To include the \"Beacon Hill\" district in Boston under the \"Cities\" entry, enter the following line:"
msgstr "Om du vill ta med stadsdelen \"Örgryte\" i Göteborg under posten \"Städer\" skriver du följande rad:"

#. from libreoffice:swriter-01
msgid "Insert Bibliography Entry"
msgstr "Infoga post i litteraturförteckning"

#. from libreoffice:swriter-01
msgid "<variable id=\"literaturvz\"><ahelp hid=\".uno:InsertAuthoritiesEntry\">Inserts a bibliography reference.</ahelp></variable>"
msgstr "<variable id=\"literaturvz\"><ahelp hid=\".uno:InsertAuthoritiesEntry\">Infogar en litteraturreferens.</ahelp></variable>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/bibliographyentry/frombibliography\">Inserts a reference from the bibliography database.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/bibliographyentry/frombibliography\">Infogar en referens från litteraturdatabasen.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/bibliographyentry/fromdocument\">Inserts a reference from the bibliography records that are stored in the current document.</ahelp> An entry that is stored in the document has priority over an entry that is stored in the bibliography database."
msgstr "<ahelp hid=\"modules/swriter/ui/bibliographyentry/fromdocument\">Infogar en referens från de litteraturposter som är sparade i det aktuella dokumentet.</ahelp> En post som är sparad i dokumentet har högre prioritet än en post som är sparad i litteraturdatabasen."

#. from libreoffice:swriter-01
msgid "When you save a document that contains bibliography entries, the corresponding records are automatically saved in a hidden field in the document."
msgstr "När du sparar ett dokument som innehåller litteraturposter så sparas automatiskt tillhörande data i ett dolt fält i dokumentet."

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/bibliographyentry/entrylb\">Select the short name of the bibliography record that you want to insert.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/bibliographyentry/entrylb\">Välj den litteraturpost du vill infoga från listan kort beteckning.</ahelp>"

#. from libreoffice:swriter-01
msgid "Author, Title"
msgstr "Författare, titel"

#. from libreoffice:swriter-01
msgid "If available, the author and the full title of the selected short name are displayed in this area."
msgstr "Författarens namn och den fullständiga titel som motsvarar det markerade korta namnet visas, om uppgifterna är tillgängliga."

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/bibliographyentry/insert\">Inserts the bibliographic reference into the document. If you created a new record, you must also insert it as an entry, otherwise the record is lost when you close the document.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/bibliographyentry/insert\">Infogar litteraturreferensen i dokumentet. Om du har skapat en ny post måste du även infoga den som en post för att den inte ska gå förlorad när du stänger dokumentet.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/bibliographyentry/close\">Closes the dialog.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/bibliographyentry/close\">Stänger dialogen.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/bibliographyentry/new\">Opens the <link href=\"text/swriter/01/04120229.xhp\">Define Bibliography Entry</link> dialog, where you can create a new bibliography record. This record is only stored in the document. To add a record to the bibliography database, choose <emph>Tools - Bibliography Database</emph>.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/bibliographyentry/new\">Öppnar dialogrutan <link href=\"text/swriter/01/04120229.xhp\">Definiera litteraturpost</link> där du kan skapa en ny litteraturpost. Den här dataposten sparas bara i dokumentet. Du kan lägga till en datapost i litteraturdatabasen genom att välja <emph>Verktyg - Litteraturdatabas</emph>.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/bibliographyentry/edit\">Opens the <link href=\"text/swriter/01/04120229.xhp\">Define Bibliography Entry</link> dialog where you can edit the selected bibliography record.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/bibliographyentry/edit\">Öppnar dialogrutan <link href=\"text/swriter/01/04120229.xhp\">Definiera litteraturpost</link> där du kan redigera en markerad litteraturpost.</ahelp>"

#. from libreoffice:swriter-01
msgid "<link href=\"text/swriter/guide/indices_literature.xhp\">Tips for working with bibliography entries</link>"
msgstr "<link href=\"text/swriter/guide/indices_literature.xhp\">Information om att arbeta med litteraturförteckningsposter</link>."

#. from libreoffice:swriter-01
msgid "<variable id=\"rahm\"><ahelp hid=\".uno:InsertFrame\">Inserts a frame that you can use to create a layout of one or more columns of text and objects.</ahelp></variable>"
msgstr "<variable id=\"rahm\"><ahelp hid=\".uno:InsertFrame\">Infogar en ram som du kan använda för att skapa en layout med en eller flera textkolumner och objekt.</ahelp></variable>"

#. from libreoffice:swriter-01
msgid "Icon on the Insert toolbar:"
msgstr "Ikon på verktygsraden Infoga:"

#. from libreoffice:swriter-01
msgid "<variable id=\"syrahmentext\"><ahelp hid=\".uno:InsertFrameInteract\">Draws a frame where you drag in the document. Click the arrow next to the icon to select the number of columns for the frame.</ahelp></variable>"
msgstr "<variable id=\"syrahmentext\"><ahelp hid=\".uno:InsertFrameInteract\">Infogar en ram där du drar med musen i dokumentet. Klicka på pilen bredvid ikonen för att välja antalet kolumner i ramen.</ahelp></variable>"

#. from libreoffice:swriter-01
msgid "To delete a frame, click the border of the frame, and then press Delete."
msgstr "Om du vill ta bort en ram klickar du på ramens kant och trycker på Delete."

#. from libreoffice:swriter-01
msgid "If you see small red arrows at the beginning and the end of text in frame, use the arrow keys to scroll through the remaining text."
msgstr "Om du ser små röda pilar i början och slutet av texten i ramen, kan du använda piltangenterna för att bläddra i den text som inte syns."

#. from libreoffice:swriter-01
msgid "In the preview area of the <emph>Frame</emph> dialog, the frame is represented by a green rectangle, and the reference area by a red rectangle."
msgstr "I förhandsgranskningsfönstret i dialogrutan <emph>Ram</emph> representeras ramen av en grön rektangel och referensområdet av en röd rektangel."

#. from libreoffice:swriter-01
msgid "You can also preview the effects when you change the frame anchor to \"As Character\". The \"Baseline\" is drawn in red, \"Character\" is the font height, and \"line\" is the height of the line, including the frame."
msgstr "Du kan också förhandsgranska effekterna när du ändrar förankringspunkten till \"Som tecken\". Baslinjen ritas i rött, \"Tecken\" är teckensnittets höjd och \"Rad\" är radhöjden inklusive ramen."

#. from libreoffice:swriter-01
msgid "<bookmark_value>moving;objects and frames</bookmark_value><bookmark_value>objects;moving and resizing with keyboard</bookmark_value><bookmark_value>resizing;objects and frames, by keyboard</bookmark_value>"
msgstr "<bookmark_value>Flytta;objekt och ramar</bookmark_value><bookmark_value>Objekt;flytta och ändra storlek på med tangentbordet</bookmark_value><bookmark_value>Ändra storlek på;objekt och ramar, med tangentbordet</bookmark_value>"

#. from libreoffice:swriter-01
msgid "Resizing and Moving Frames, Objects With the Keyboard"
msgstr "Ändra storlek på och flytta ramar och objekt med tangentbordet"

#. from libreoffice:swriter-01
msgid "You can resize and move selected frames and objects with the keyboard."
msgstr "Du kan flytta och ändra storlek på markerade ramar och objekt med tangentbordet."

#. from libreoffice:swriter-01
msgid "To move a selected frame or object, press an arrow key. To move by one pixel, hold down <switchinline select=\"sys\"><caseinline select=\"MAC\">Option</caseinline><defaultinline>Alt</defaultinline></switchinline>, and then press an arrow key."
msgstr "Flytta en markerad ram eller ett markerat objekt genom att trycka på en piltangent. Du flyttar en pixel i taget genom att hålla ned <switchinline select=\"sys\"><caseinline select=\"MAC\">Alternativ</caseinline><defaultinline>Alt</defaultinline></switchinline> och trycka på en piltangent."

#. from libreoffice:swriter-01
msgid "To insert a table from another document, copy the table, and then paste the table into the current document."
msgstr "Om du vill infoga en tabell från ett annat dokument, kopierar du tabellen och klistrar in den i det aktuella dokumentet."

#. from libreoffice:swriter-01
msgid "To convert text into a table, select the text, and then choose <emph>Table - Convert - Text to Table</emph>."
msgstr "Om du vill konvertera text till en tabell markerar du texten och väljer sedan <emph>Tabell - Konvertera - Text till tabell</emph>."

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/inserttable/nameedit\">Enter a name for the table.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/inserttable/nameedit\">Ange ett namn till tabellen.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/inserttable/colspin\">Enter the number of columns that you want in the table.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/inserttable/colspin\">Ange det antal kolumner som ska finnas i tabellen.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/inserttable/rowspin\">Enter the number of rows that you want in the table.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/inserttable/rowspin\">Ange det antal rader som ska finnas i tabellen.</ahelp>"

#. from libreoffice:swriter-01
msgid "Set the options for the table."
msgstr "Ange alternativ för tabellen."

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/inserttable/headercb\">Includes a heading row in the table.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/inserttable/headercb\">Inkludera en rubrikrad i tabellen.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/inserttable/repeatcb\">Repeats the heading of the table at the top of subsequent page if the table spans more than one page.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/inserttable/repeatcb\">Upprepar tabellrubriken överst på följande sida om tabellen sträcker sig över fler än en sida.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/inserttable/dontsplitcb\">Prevents the table from spanning more than one page.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/inserttable/dontsplitcb\">Förhindrar tabellen från att dela sig vid en sidbrytning.</ahelp>"

#. from libreoffice:swriter-01
msgid "Icon on the Insert toolbar"
msgstr "Ikon på verktygsraden Infoga"

#. from libreoffice:swriter-01
msgid "On the Insert toolbar, click the <emph>Table</emph> icon to open the <emph>Insert Table</emph> dialog, where you can insert a table in the current document. You can also click the arrow, drag to select the number of rows and columns to include in the table, and then click in the last cell."
msgstr "Klicka på ikonen <emph>Tabell</emph> på verktygsraden Infoga för att öppna dialogrutan <emph>Infoga tabell</emph> där du kan infoga en tabell i det aktuella dokumentet. Du kan också klicka på pilen och dra om du vill välja det antal rader och kolumner som ska ingå i tabellen, och sedan klicka i den sista cellen."

#. from libreoffice:swriter-01
msgid "<switchinline select=\"sys\"><caseinline select=\"MAC\">%PRODUCTNAME - Preferences</caseinline><defaultinline>Tools - Options</defaultinline></switchinline> - <link href=\"text/shared/optionen/01040500.xhp\">%PRODUCTNAME Writer - Table</link>"
msgstr "<switchinline select=\"sys\"><caseinline select=\"MAC\">%PRODUCTNAME – Inställningar</caseinline><defaultinline>Verktyg – Alternativ</defaultinline></switchinline> – <link href=\"text/shared/optionen/01040500.xhp\">%PRODUCTNAME Writer – Tabell</link>"

#. from libreoffice:swriter-01
msgid "Exchange Database"
msgstr "Byt databas"

#. from libreoffice:swriter-01
msgid "<bookmark_value>databases; exchanging</bookmark_value>  <bookmark_value>address books; exchanging</bookmark_value>  <bookmark_value>exchanging databases</bookmark_value>  <bookmark_value>replacing;databases</bookmark_value>"
msgstr "<bookmark_value>Databaser; byta</bookmark_value><bookmark_value>Adressböcker; byta</bookmark_value><bookmark_value>Byta; databaser</bookmark_value><bookmark_value>Ersätta; databaser</bookmark_value>"

#. from libreoffice:swriter-01
msgid "<link href=\"text/swriter/01/04180400.xhp\">Exchange Database</link>"
msgstr "<link href=\"text/swriter/01/04090006.xhp\">Databas</link>"

#. from libreoffice:swriter-01
msgid "<variable id=\"datenbankaustext\"><ahelp hid=\".uno:ChangeDatabaseField\">Change the data sources for the current document.</ahelp> To correctly display the contents of inserted fields, the replacement database must contain identical field names. </variable>"
msgstr "<variable id=\"datenbankaustext\"><ahelp hid=\".uno:ChangeDatabaseField\">Ändrar datakällorna för det aktuella dokumentet.</ahelp> För att innehållet i de fält som finns i dokumentet ska visas rätt, måste den nya databasen innehålla fält med identiska fältnamn. </variable>"

#. from libreoffice:swriter-01
msgid "For example, if you inserting address fields in a form letter from an address database, you can then exchange the database with another address database to insert different addresses."
msgstr "Om du till exempel infogar ett adressfält i ett standardbrev från en adressdatabas, kan du byta ut databasen till en annan databas med andra adresser."

#. from libreoffice:swriter-01
msgid "You can only change one database at a time in this dialog."
msgstr "Det går bara att byta ut en databas åt gången i den här dialogrutan."

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/exchangedatabases/inuselb\">Lists the databases that are currently in use.</ahelp> The current document contains at least one data field from each of the databases in the list."
msgstr "<ahelp hid=\"modules/swriter/ui/exchangedatabases/inuselb\">Visar en lista över de databaser som används.</ahelp> Det aktuella dokumentet innehåller minst ett datafält från varje databas i listan."

#. from libreoffice:swriter-01
msgid "Available Databases"
msgstr "Tillgängliga databaser"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/exchangedatabases/availablelb\">Lists the databases that are registered in <item type=\"productname\">%PRODUCTNAME</item>.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/exchangedatabases/availablelb\">Anger de databaser som är registrerade i <item type=\"productname\">%PRODUCTNAME</item>.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/exchangedatabases/define\">Replaces the current data source with the data source that you selected in the <emph>Available Databases </emph>list.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/exchangedatabases/define\">Ersätter den aktuella datakällan med den datakälla som du väljer i listan <emph>Tillgängliga databaser</emph>.</ahelp>"

#. from libreoffice:swriter-01
msgid "To exchange a database:"
msgstr "Så byter du ut en databas i ett dokument mot en annan"

#. from libreoffice:swriter-01
msgid "Ensure that both databases contain matching field names and field types."
msgstr "Kontrollera att båda databaserna har fält med samma fältnamn och fälttyp."

#. from libreoffice:swriter-01
msgid "Click in the document that you want to change the data source for."
msgstr "Klicka i det dokument som du vill ändra datakälla för."

#. from libreoffice:swriter-01
msgid "In the <emph>Databases in Use</emph> list, select the database table that you want to replace."
msgstr "I listan <emph>Använda databaser</emph> markerar du den databastabell som du ska ersätta."

#. from libreoffice:swriter-01
msgid "In the <emph>Available Databases</emph> list, select the replacement database table."
msgstr "I listan <emph>Tillgängliga databaser</emph> klickar du på den nya databastabellen."

#. from libreoffice:swriter-01
msgid "Click <emph>Define</emph>."
msgstr "Klicka på <emph>Definiera</emph>."

#. from libreoffice:swriter-01
msgid "To always have the latest version of the contents of a file, insert a section into your document, and then insert a link to the text file in the section. See <link href=\"text/swriter/01/04020100.xhp\">insert a section</link> for details."
msgstr "Genom att infoga ett område i dokumentet och sedan infoga en länk till textfilen i det området, kan du se till att alltid ha den senaste versionen av filens innehåll. Se <link href=\"text/swriter/01/04020100.xhp\">Infoga ett område</link> för mer information."

#. from libreoffice:swriter-01
msgid "<variable id=\"scripttext\"><ahelp hid=\".uno:InsertScript\">Inserts a script at the current cursor position in an HTML or text document.</ahelp></variable>"
msgstr "<variable id=\"scripttext\"><ahelp hid=\".uno:InsertScript\">Infogar ett skript där markören finns i ett HTML- eller textdokument.</ahelp></variable>"

#. from libreoffice:swriter-01
msgid "If your document contains more than one script, the <emph>Edit Script</emph> dialog contains previous and next buttons to jump from script to script."
msgstr "Om dokumentet innehåller mer än ett skript så innehåller dialogrutan <emph>Redigera skript</emph> knappar för föregående och nästa, som du kan använda för att hoppa från skript till skript."

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".\" visibility=\"hidden\">Jump to Previous Script.</ahelp>"
msgstr "<ahelp hid=\".\" visibility=\"hidden\">Hoppa till föregående skript.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".\" visibility=\"hidden\">Jump to Next Script.</ahelp>"
msgstr "<ahelp hid=\".\" visibility=\"hidden\">Hoppa till nästa skript.</ahelp>"

#. from libreoffice:swriter-01
msgid "Script Type"
msgstr "Skripttyp"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/insertscript/scripttype\">Enter the type of script that you want to insert.</ahelp> The script is identified in the HTML source code by the tag <SCRIPT LANGUAGE=\"JavaScript\">."
msgstr "<ahelp hid=\"modules/swriter/ui/insertscript/scripttype\">Ange vilken typ av skript du vill infoga.</ahelp> Skriptet identifieras i HTML-källkoden av taggen <SCRIPT LANGUAGE=\"JavaScript\">."

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/insertscript/urlentry\">Adds a link to a script file. Click the <emph>URL </emph>radio button, and then enter the link in the box. You can also click the <emph>Browse</emph> button, locate the file, and then click <emph>Insert</emph>.</ahelp> The linked script file is identified in the HTML source code by the following tags:"
msgstr "<ahelp hid=\"modules/swriter/ui/insertscript/urlentry\">Lägger till en länk till en skriptfil. Klicka på alternativfältet <emph>URL</emph> och ange sedan länken i rutan. Du kan också klicka på bläddringsknappen (<emph>...</emph>), leta rätt på filen och sedan klicka på <emph>Infoga</emph>.</ahelp> Den länkade skriptfilen identifieras i HTML-källkoden av följande taggar:"

#. from libreoffice:swriter-01
msgid "<SCRIPT LANGUAGE=\"JavaScript\" SRC=\"url\">"
msgstr "<SCRIPT LANGUAGE=\"JavaScript\" SRC=\"url\">"

#. from libreoffice:swriter-01
msgid "/* ignore all text here */"
msgstr "/* allt här ignoreras */"

#. from libreoffice:swriter-01
msgid "</SCRIPT>"
msgstr "</SCRIPT>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/insertscript/browse\">Locate the script file that you want to link to, and then click <emph>Insert</emph>.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/insertscript/browse\">Leta rätt på den skriptfil du vill länka till och klicka sedan på <emph>Infoga</emph>.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/insertscript/text\">Enter the script code that you want to insert.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/insertscript/text\">Ange den skriptkod du vill infoga.</ahelp>"

#. from libreoffice:swriter-01
msgid "<link href=\"text/swriter/01/04220000.xhp\">Header</link>"
msgstr "<link href=\"text/swriter/01/04220000.xhp\">Sidhuvud</link>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".\">Adds or removes a header from the page style that you select in the submenu. The header is added to all of the pages that use the same page style.</ahelp> In a new document, only the \"Default\" page style is listed. Other page styles are added to the list after you apply them in the document."
msgstr "<ahelp hid=\".uno:InsertPageHeader\">Lägger till eller tar bort ett sidhuvud från sidformatmallen som du väljer på undermenyn. Sidhuvudet läggs till i alla sidor som använder samma sidformatmall.</ahelp> I ett nytt dokument visas endast sidformatmallen \"Standard\". Andra sidformatmallar läggs till i listan när du har använt dem i dokumentet."

#. from libreoffice:swriter-01
msgid "The headers are visible only when you view the document in print layout (enable <emph>View - Normal</emph>)."
msgstr "Sidhuvudena syns endast när du visar dokumentet i utskriftslayout (aktivera <emph>Visa - Utskriftslayout</emph>)."

#. from libreoffice:swriter-01
msgid "A check mark is displayed in front of the page styles that have headers."
msgstr "En bockmarkering visas framför de sidformatmallar som har sidhuvuden."

#. from libreoffice:swriter-01
msgid "To remove a header, choose <emph>Insert - Header and Footer - Header</emph>, and then select the page style containing the header. The header is removed from all of the pages that use this page style."
msgstr "Du kan ta bort ett sidhuvud genom att välja <emph>Infoga - Sidhuvud</emph> och sedan markera den sidformatmall som innehåller sidhuvudet. Sidhuvudet tas bort från alla sidor som använder den aktuella sidformatmallen."

#. from libreoffice:swriter-01
msgid "To add or remove headers from all of the page styles that are in use in the document, choose <emph>Insert - Header and Footer - Header - All</emph>."
msgstr "Du kan lägga till och ta bort sidhuvuden från alla sidfotmatmallar som används i dokumentet genom att välja <emph>Infoga - Sidhuvud - Alla</emph>."

#. from libreoffice:swriter-01
msgid "<link href=\"text/swriter/01/04230000.xhp\">Footer</link>"
msgstr "<link href=\"text/swriter/01/04230000.xhp\">Sidfot</link>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".\">Adds or removes a footer from the page style that you select in the submenu. The footer is added to all of the pages that use the same page style.</ahelp> In a new document, only the \"Default\" page style is listed. Other page styles are added to the list after you apply them in the document."
msgstr "<ahelp hid=\".uno:InsertPageFooter\">Lägger till eller tar bort en sidfot från sidformatmallen som du väljer på undermenyn. Sidfoten läggs till i alla sidor som använder samma sidformatmall.</ahelp> I ett nytt dokument visas endast sidformatmallen \"Standard\". Andra sidformatmallar läggs till i listan när du har använt dem i dokumentet."

#. from libreoffice:swriter-01
msgid "The footers are visible only when you view the document in print layout (enable <emph>View - Normal</emph>)."
msgstr "Sidfötterna syns endast när du visar dokumentet i utskriftslayout (aktivera <emph>Visa - Utskriftslayout</emph>)."

#. from libreoffice:swriter-01
msgid "A check mark is displayed in front of the page styles that have footers."
msgstr "En bockmarkering visas framför de sidformatmallar som har sidfötter."

#. from libreoffice:swriter-01
msgid "To remove a footer, choose <emph>Insert - Header and Footer - Footer</emph>, and then select the page style containing the footer. The footer is removed from all of the pages that use this page style."
msgstr "Du kan ta bort en sidfot genom att välja <emph>Infoga - Sidfot</emph> och sedan markera den sidformatmall som innehåller sidfoten. Sidfoten tas bort från alla sidor som använder den aktuella sidformatmallen."

#. from libreoffice:swriter-01
msgid "To add or remove footers from all of the page styles that are in use in the document, choose <emph>Insert - Header and Footer - Footer - All</emph>."
msgstr "Du kan lägga till och ta bort sidfötter från alla sidfotmatmallar som används i dokumentet genom att välja <emph>Infoga - Sidfot - Alla</emph>."

#. from libreoffice:swriter-01
msgid "<link href=\"text/swriter/01/04090000.xhp\">More Fields</link>"
msgstr "<link href=\"text/swriter/01/04090000.xhp\">Andra...</link>"

#. from libreoffice:swriter-01
msgid "<bookmark_value>text flow;at breaks</bookmark_value><bookmark_value>paragraphs;keeping together at breaks</bookmark_value><bookmark_value>protecting;text flow</bookmark_value><bookmark_value>widows</bookmark_value><bookmark_value>orphans</bookmark_value><bookmark_value>block protect, see also widows or orphans</bookmark_value>"
msgstr "<bookmark_value>textflöde;vid brytningar</bookmark_value><bookmark_value>stycken;håll ihop vid brytningar</bookmark_value><bookmark_value>skydda;textflöde </bookmark_value><bookmark_value>änkor</bookmark_value><bookmark_value>horungar</bookmark_value><bookmark_value>blockskydd, se även änkor och horungar</bookmark_value>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"cui/ui/textflowpage/TextFlowPage\">Specify hyphenation and pagination options.</ahelp>"
msgstr "<ahelp hid=\"cui/ui/textflowpage/TextFlowPage\">Ange inställningar för avstavning och sidbrytningar.</ahelp>"

#. from libreoffice:swriter-01
msgid "Specify the <link href=\"text/swriter/guide/using_hyphen.xhp\">hyphenation</link> options for text documents."
msgstr "Ange alternativ för <link href=\"text/swriter/guide/using_hyphen.xhp\">avstavning</link> i textdokument."

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"cui/ui/textflowpage/checkAuto\">Automatically inserts hyphens where they are needed in a paragraph.</ahelp>"
msgstr "<ahelp hid=\"cui/ui/textflowpage/checkAuto\">Infogar bindestreck automatiskt på de ställen där det behövs i stycket.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"cui/ui/textflowpage/spinLineEnd\">Enter the minimum number of characters to leave at the end of the line before a hyphen is inserted.</ahelp>"
msgstr "<ahelp hid=\"cui/ui/textflowpage/spinLineEnd\">Ange det minsta antal tecken som ska lämnas vid slutet av raden framför ett bindestreck.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"cui/ui/textflowpage/spinLineBegin\">Enter the minimum number of characters that must appear at the beginning of the line after the hyphen.</ahelp>"
msgstr "<ahelp hid=\"cui/ui/textflowpage/spinLineBegin\">Ange det minsta antal tecken som måste visas i början av raden efter bindestrecket.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"cui/ui/textflowpage/spinMaxNum\">Enter the maximum number of consecutive lines that can be hyphenated.</ahelp>"
msgstr "<ahelp hid=\"cui/ui/textflowpage/spinMaxNum\">Ange det största tillåtna antalet rader som får avstavas efter varandra.</ahelp>"

#. from libreoffice:swriter-01
msgid "Specify the page or column <link href=\"text/swriter/guide/page_break.xhp\">break</link> options."
msgstr "Ange alternativ för <link href=\"text/swriter/guide/page_break.xhp\">sid- eller kolumnbrytningar</link>."

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"cui/ui/textflowpage/checkInsert\">Select this check box, and then select the break type that you want to use.</ahelp>"
msgstr "<ahelp hid=\"cui/ui/textflowpage/checkInsert\">Markera den här kryssrutan och välj vilken typ av brytningar som du vill använda.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"cui/ui/textflowpage/comboBreakType\">Select the break type that you want to insert.</ahelp>"
msgstr "<ahelp hid=\"cui/ui/textflowpage/comboBreakType\">Välj den typ av brytning som du ska infoga.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"cui/ui/textflowpage/comboBreakPosition\">Select where you want to insert the break.</ahelp>"
msgstr "<ahelp hid=\"cui/ui/textflowpage/comboBreakPosition\">Välj var brytningen ska infogas.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"cui/ui/textflowpage/checkPageStyle\">Select this check box, and then select the page style that you want to use for the first page after the break.</ahelp>"
msgstr "<ahelp hid=\"cui/ui/textflowpage/checkPageStyle\">Markera den här kryssrutan och välj sedan den sidformatmall som du vill använda för den första sidan efter brytningen.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"cui/ui/textflowpage/comboPageStyle\">Select the formatting style to use for the first page after the break.</ahelp>"
msgstr "<ahelp hid=\"cui/ui/textflowpage/comboPageStyle\">Välj den formatmall som ska användas på den första sidan efter brytningen.</ahelp>"

#. from libreoffice:swriter-01
msgid "Specify the text flow options for paragraphs that appear before and after a page break."
msgstr "Ange textflödesalternativ för stycken som finns före och efter en sidbrytning."

#. from libreoffice:swriter-01
msgid "Do not split paragraph"
msgstr "Dela inte stycke"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"cui/ui/textflowpage/checkSplitPara\">Shifts the entire paragraph to the next page or column after a break is inserted.</ahelp>"
msgstr "<ahelp hid=\"cui/ui/textflowpage/checkSplitPara\">Flyttar hela stycket till nästa sida eller kolumn när en brytning infogas.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"cui/ui/textflowpage/checkKeepPara\">Keeps the current paragraph and the following paragraph together when a break or column break is inserted.</ahelp>"
msgstr "<ahelp hid=\"cui/ui/textflowpage/checkKeepPara\">Håller ihop det aktuella stycket med nästa stycke när en sid- eller kolumnbrytning infogas.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"cui/ui/textflowpage/spinOrphan\">Specifies the minimum number of lines in a paragraph before a page break. Select this check box, and then enter a number in the <emph>Lines </emph>box.</ahelp> If the number of lines at the end of the page is less than the amount specified in the <emph>Lines </emph>box, the paragraph is shifted to the next page."
msgstr "<ahelp hid=\"cui/ui/textflowpage/spinOrphan\">Anger det minsta antalet rader i ett stycke innan en sidbrytning. Markera den här kryssrutan och ange ett antal i rutan <emph>Rader</emph>.</ahelp> Om antalet rader i slutet av sidan är mindre än antalet rader i rutan <emph>Rader</emph> flyttas stycket till nästa sida."

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"cui/ui/textflowpage/spinWidow\">Specifies the minimum number of lines in a paragraph in the first page after the break. Select this check box, and then enter a number in the <emph>Lines </emph>box.</ahelp> If the number of lines at the top of the page is less than the amount specified in the <emph>Lines </emph>box, the position of the break is adjusted."
msgstr "<ahelp hid=\"cui/ui/textflowpage/spinWidow\">Anger det minsta antalet rader i ett stycke på den första sidan efter brytningen. Markera den här kryssrutan och ange ett antal i rutan <emph>Rader</emph>.</ahelp> Om antalet rader överst på sidan är mindre än antalet rader i rutan <emph>Rader</emph> flyttas brytningen."

#. from libreoffice:swriter-01
msgid "<bookmark_value>first letters as large capital letters</bookmark_value><bookmark_value>capital letters;starting paragraphs</bookmark_value><bookmark_value>drop caps insertion</bookmark_value>"
msgstr "<bookmark_value>Första bokstaven som versal bokstav i större teckenstorlek</bookmark_value><bookmark_value>Stora bokstäver;inleda stycken</bookmark_value><bookmark_value>Anfangindrag</bookmark_value>"

#. from libreoffice:swriter-01
msgid "<link href=\"text/swriter/01/05030400.xhp\">Drop Caps</link>"
msgstr "<link href=\"text/swriter/01/05030400.xhp\">Anfanger</link>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/dropcapspage/DropCapPage\">Formats the first letter of a paragraph with a large capital letter, that can span several lines. The paragraph must span at least as many lines as you specify in the Lines box.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/dropcapspage/DropCapPage\">Formaterar den första bokstaven i ett stycke med en versal bokstav i större teckenstorlek, som kan sträcka sig över flera rader. Stycket måste omfatta minst det antal rader som du anger i rutan Rader.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/dropcapspage/checkCB_SWITCH\">Applies the drop cap settings to the selected paragraph.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/dropcapspage/checkCB_SWITCH\">Använder anfanginställningen i det markerade stycket.</ahelp>"

#. from libreoffice:swriter-01
msgid "Whole word"
msgstr "Helt ord"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/dropcapspage/checkCB_WORD\">Displays the first letter of the first word in the paragraph as a drop cap, and the remaining letters of the word as large type.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/dropcapspage/checkCB_WORD\">Visar den första bokstaven i det första ordet i stycket med en anfang, och de återstående tecknen i ordet i större stil.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/dropcapspage/spinFLD_DROPCAPS\">Enter the number of characters to convert to drop caps. </ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/dropcapspage/spinFLD_DROPCAPS\">Ange hur många tecken som ska konverteras till anfang. </ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/dropcapspage/spinFLD_LINES\">Enter the number of lines that you want the drop cap to extend downward from the first line of the paragraph. Shorter paragraphs will not get drop caps.</ahelp> The selection is limited to 2-9 lines."
msgstr "<ahelp hid=\"modules/swriter/ui/dropcapspage/spinFLD_LINES\">Ange hur många rader som anfangen kan sträcka sig över, räknat från den första raden i stycket och neråt. Anfanger kan inte sättas in i kortare stycken.</ahelp> Du kan välja ett värde mellan 2 och 9 rader."

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/dropcapspage/spinFLD_DISTANCE\">Enter the amount of space to leave between the drop caps and the rest of the text in the paragraph.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/dropcapspage/spinFLD_DISTANCE\">Ange hur mycket utrymme som ska lämnas mellan anfangen och resten av texten i stycket.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/dropcapspage/entryEDT_TEXT\">Enter the text that you want to display as drop caps instead of the first letters of the paragraph.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/dropcapspage/entryEDT_TEXT\">Ange den text som ska visas som anfang i stället för de första bokstäverna i stycket.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/dropcapspage/comboBOX_TEMPLATE\">Select the formatting style that you want to apply to the drop caps.</ahelp> To use the formatting style of the current paragraph, select [None]."
msgstr "<ahelp hid=\"modules/swriter/ui/dropcapspage/comboBOX_TEMPLATE\">Välj den formatmall som anfangen ska formateras med.</ahelp> Om du vill använda den aktuella formateringen i stycket väljer du [Ingen]."

#. from libreoffice:swriter-01
msgid "Outline level"
msgstr "Visade rubriknivåer"

#. from libreoffice:swriter-01
msgid "<variable id=\"spaltentext\"><ahelp hid=\"modules/swriter/ui/columnpage/ColumnPage\">Specifies the number of columns and the column layout for a page style, frame, or section.</ahelp></variable>"
msgstr "<variable id=\"spaltentext\"><ahelp hid=\"modules/swriter/ui/columnpage/ColumnPage\">Anger antalet kolumner och kolumnlayouten för en sidformatmall, en ram eller ett område.</ahelp></variable>"

#. from libreoffice:swriter-01
msgid "You can select from predefined column layouts, or create your own. When you apply a layout to a page style, all pages that use the style are updated. Similarly, when you apply a column layout to a frame style, all frames that use that style are updated. You can also change the column layout for a single frame."
msgstr "Du kan välja en fördefinierad kolumnlayout eller skapa en egen. När du använder en layout i en sidformatmall kommer alla sidor som använder formatmallen att uppdateras. Om du använder en kolumnlayout i en ramformatmall kommer alla ramar som använder formatmallen att uppdateras. Du kan också ändra kolumnlayouten för en enskild ram."

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/columnpage/colsnf\">Enter the number of columns that you want in the page, frame, or section.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/columnpage/colsnf\">Ange hur många kolumner som ska finnas på sidan, i ramen eller i området.</ahelp>"

#. from libreoffice:swriter-01
msgid "Selection fields"
msgstr "Urvalsfält"

#. from libreoffice:swriter-01
msgid "You can also select one of the predefined column layouts."
msgstr "Du kan också välja en av de fördefinierade kolumnlayouterna."

#. from libreoffice:swriter-01
msgid "Apply to"
msgstr "Använd på"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/columnpage/applytolb\">Select the item that you want to apply the column layout to.</ahelp> This option is only available if you access this dialog by choosing <emph>Format - Columns</emph>."
msgstr "<ahelp hid=\"modules/swriter/ui/columnpage/applytolb\">Välj det objekt som kolumnlayouten ska användas på.</ahelp> Det här alternativet är endast tillgängligt om du har öppnat dialogrutan genom att välja <emph>Format - Kolumner</emph>."

#. from libreoffice:swriter-01
msgid "Evenly distribute contents to all columns"
msgstr "Fördela innehåll jämnt över alla kolumner"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".\" visibility=\"hidden\">Distributes the text in multi-column sections. The text flows into all columns to the same height. The height of the section adjusts automatically.</ahelp> Evenly distributes the text in <link href=\"text/swriter/01/04020000.xhp\">multi-column sections</link>."
msgstr "<ahelp hid=\".\" visibility=\"hidden\">Fördelar texten över avsnitt med flera kolumner. Texten fördelas på alla kolumner till samma höjd. Avsnittets höjd justeras automatiskt.</ahelp> Fördelar texten jämnt över <link href=\"text/swriter/01/04020000.xhp\">avsnitt med flera kolumner</link>."

#. from libreoffice:swriter-01
msgid "The column layout preview only shows the columns and not the surrounding page."
msgstr "Förhandsgranskningen för kolumnlayouten visar endast kolumner och inte den omgivande sidan."

#. from libreoffice:swriter-01
msgid "Width and spacing"
msgstr "Bredd och avstånd"

#. from libreoffice:swriter-01
msgid "AutoWidth"
msgstr "Automatisk bredd"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/columnpage/autowidth\">Creates columns of equal width.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/columnpage/autowidth\">Skapar kolumner som är lika breda.</ahelp>"

#. from libreoffice:swriter-01
msgid "Displays the column number, as well as width and distance to the adjacent columns."
msgstr "Visar kolumnens ordningstal, bredd och avstånd till intilliggande kolumner."

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/columnpage/back\">Moves the column display one column to the left.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/columnpage/back\">Flyttar kolumnen en kolumn till vänster.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/columnpage/next\">Moves the column display one column to the right.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/columnpage/next\">Flyttar kolumnen en kolumn till höger.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/columnpage/width3mf\">Enter the width of the column.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/columnpage/width3mf\">Ange kolumnens bredd.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/columnpage/spacing2mf\">Enter the amount of space that you want to leave between the columns.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/columnpage/spacing2mf\">Ange hur stort utrymme som ska lämnas mellan kolumnerna.</ahelp>"

#. from libreoffice:swriter-01
msgid "Separator line"
msgstr "Skiljelinje"

#. from libreoffice:swriter-01
msgid "This area is only available if your layout contains more than one column."
msgstr "Det här området är endast tillgängligt om layouten innehåller mer än en kolumn."

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/columnpage/linestylelb\">Select the formatting style for the column separator line. If you do not want a separator line, choose \"None\".</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/columnpage/linestylelb\">Välj en formatering för den linje som avgränsar kolumner. Om du inte vill ha en skiljelinje väljer du \"Ingen\".</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/columnpage/lineheightmf\">Enter the length of the separator line as a percentage of the height of the column area.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/columnpage/lineheightmf\">Ange längden på avgränsningslinjen som en procentsats av kolumnområdets höjd.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/columnpage/lineposlb\">Select the vertical alignment of the separator line. This option is only available if <emph>Height</emph> value of the line is less than 100%.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/columnpage/lineposlb\">Välj en vertikal justering för avgränsningslinjen. Det här alternativet är endast tillgängligt om värdet i rutan <emph>Höjd</emph> är mindre än 100 %.</ahelp>"

#. from libreoffice:swriter-01
msgid "Specifies the number of columns and the column layout for the section."
msgstr "Anger antalet kolumner i området, och deras layout."

#. from libreoffice:swriter-01
msgid "Sections follow the text flow behavior of the page they are inserted into."
msgstr "Områden följer textflödet på den plats i dokumentet där de infogas."

#. from libreoffice:swriter-01
msgid "For example, if you insert a section that uses a two-column layout into a page style that uses a four-column layout, the two-column layout is nested inside one of the four columns."
msgstr "Om du t.ex. infogar ett område som använder en tvåkolumnslayout i en sidformatmall som använder en layout med fyra kolumner, så sammanflätas tvåkolumnslayouten inuti någon av de fyra kolumnerna."

#. from libreoffice:swriter-01
msgid "You can also nest sections, that is, you can insert a section into another section."
msgstr "Du kan också sammanfläta områden, d.v.s. du kan infoga ett område i ett annat område."

#. from libreoffice:swriter-01
msgid "Footnotes/Endnotes"
msgstr "Fotnoter/Slutnoter"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".\" visibility=\"visible\">Specifies where footnotes and endnotes are displayed as well as their numbering formats.</ahelp>"
msgstr "<ahelp hid=\".\" visibility=\"visible\">Anger var fotnoter och slutnoter ska visas och deras numreringsformat.</ahelp>"

#. from libreoffice:swriter-01
msgid "Collect at end of text"
msgstr "Samla vid textslut"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/footnotesendnotestabpage/ftnntattextend\" visibility=\"visible\">Adds footnotes at the end of the section. If the section spans more than one page, the footnotes are added to the bottom of the page on which the footnote anchors appear.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/footnotesendnotestabpage/ftnntattextend\" visibility=\"visible\">Lägger till fotnoter i slutet av området. Om området sträcker sig över mer än en sida, läggs fotnoterna till nederst på den sida där fotnotsankare visas.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/footnotesendnotestabpage/ftnntnum\" visibility=\"visible\">Restarts the footnote numbering at the number that you specify.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/footnotesendnotestabpage/ftnntnum\" visibility=\"visible\">Börjar om fotnotsnumreringen på det nummer du anger.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/footnotesendnotestabpage/ftnoffset\" visibility=\"visible\">Enter the number that you want to assign the footnote.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/footnotesendnotestabpage/ftnoffset\" visibility=\"visible\">Ange det nummer du vill tilldela fotnoten.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/footnotesendnotestabpage/ftnntnumfmt\" visibility=\"visible\">Specifies a custom numbering format for footnotes.</ahelp> This check box is only available if the <emph>Restart numbering</emph> check box is selected."
msgstr "<ahelp hid=\"modules/swriter/ui/footnotesendnotestabpage/ftnntnumfmt\" visibility=\"visible\">Anger ett eget numreringsformat för fotnoter.</ahelp> Den här kryssrutan är bara tillgänglig om kryssrutan <emph>Starta numrering på nytt</emph> är markerad."

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/footnotesendnotestabpage/ftnprefix\" visibility=\"visible\">Enter the text that you want to display in front of the footnote number.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/footnotesendnotestabpage/ftnprefix\" visibility=\"visible\">Ange den text som ska visas framför fotnotsnumret.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/footnotesendnotestabpage/ftnsuffix\" visibility=\"visible\">Enter the text that you want to display after the footnote number.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/footnotesendnotestabpage/ftnsuffix\" visibility=\"visible\">Skriv in den text som ska visas efter fotnotsnumret.</ahelp>"

#. from libreoffice:swriter-01
msgid "Collect at end of section"
msgstr "Samla vid områdets slut"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/footnotesendnotestabpage/endntattextend\" visibility=\"visible\">Adds endnotes at the end of the section.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/footnotesendnotestabpage/endntattextend\" visibility=\"visible\">Lägger till slutnoter i slutet av området.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/footnotesendnotestabpage/endntnum\" visibility=\"visible\">Restarts the endnote numbering at the number that you specify.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/footnotesendnotestabpage/endntnum\" visibility=\"visible\">Börjar om slutnotsnumreringen på det nummer du anger.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/footnotesendnotestabpage/endoffset\" visibility=\"visible\">Enter the number that you want to assign the endnote.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/footnotesendnotestabpage/endoffset\" visibility=\"visible\">Ange det nummer du vill tilldela slutnoten.</ahelp>"

#. from libreoffice:swriter-01
msgid "Custom format"
msgstr "Eget format"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/footnotesendnotestabpage/endntnumfmt\" visibility=\"visible\">Specifies a custom numbering format for endnotes.</ahelp> This check box is only available if you the <emph>Restart numbering</emph> check box is selected."
msgstr "<ahelp hid=\"modules/swriter/ui/footnotesendnotestabpage/endntnumfmt\" visibility=\"visible\">Anger ett eget numreringsformat för fotnoter.</ahelp> Den här kryssrutan är bara tillgänglig om kryssrutan <emph>Starta numrering på nytt</emph> är markerad."

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/footnotesendnotestabpage/endprefix\" visibility=\"visible\">Enter the text that you want to display in front of the endnote number</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/footnotesendnotestabpage/endprefix\" visibility=\"visible\">Ange den text som ska visas framför slutnotsnumret.</ahelp>"

#. from libreoffice:swriter-01
msgid "Spin button own format"
msgstr "Rotationsfält eget format"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/footnotesendnotestabpage/endsuffix\" visibility=\"visible\">Enter the text that you want to display after the endnote number.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/footnotesendnotestabpage/endsuffix\" visibility=\"visible\">Skriv in den text som ska visas efter slutnotsnumret.</ahelp>"

#. from libreoffice:swriter-01
msgid "Text Grid"
msgstr "Textraster"

#. from libreoffice:swriter-01
msgid "<link href=\"text/swriter/01/05040800.xhp\">Text Grid</link>"
msgstr "<link href=\"text/swriter/01/05040800.xhp\">Textraster</link>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/textgridpage/radioRB_CHARSGRID\">Adds or removes a text grid for lines or characters to the current page style.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/textgridpage/radioRB_CHARSGRID\">Lägger till eller tar bort textraster för rader eller tecken i den aktuella sidformatmallen.</ahelp>"

#. from libreoffice:swriter-01
msgid "Grid layout"
msgstr "Rasterlayout"

#. from libreoffice:swriter-01
msgid "Lines per page"
msgstr "Rader per sida"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/textgridpage/spinNF_LINESPERPAGE\">Enter the maximum number of lines that you want on a page.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/textgridpage/spinNF_LINESPERPAGE\">Ange det största antalet rader som du vill att en sida ska innehålla.</ahelp>"

#. from libreoffice:swriter-01
msgid "Characters per line"
msgstr "Tecken per rad"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/textgridpage/spinNF_CHARSPERLINE\">Enter the maximum number of characters that you want on a line.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/textgridpage/spinNF_CHARSPERLINE\">Ange det största antalet tecken som du vill att en rad ska innehålla.</ahelp>"

#. from libreoffice:swriter-01
msgid "Max. base text size"
msgstr "Max. storlek bastext"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/textgridpage/spinMF_TEXTSIZE\">Enter the maximum base text size. A large value results in less characters per line.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/textgridpage/spinMF_TEXTSIZE\">Ange den maximala bastextstorleken. Ju större värdet är, desto färre blir antalet tecken per rad.</ahelp>"

#. from libreoffice:swriter-01
msgid "Max. Ruby text size"
msgstr "Max. storlek ruby-text"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/textgridpage/spinMF_RUBYSIZE\">Enter the font size for the Ruby text.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/textgridpage/spinMF_RUBYSIZE\">Ange teckenstorleken för ruby-text.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/textgridpage/checkCB_RUBYBELOW\">Displays Ruby text to the left of or below the base text.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/textgridpage/checkCB_RUBYBELOW\">Visar ruby-text till vänster om eller nedanför bastexten.</ahelp>"

#. from libreoffice:swriter-01
msgid "Grid display"
msgstr "Rastervisning"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/textgridpage/listLB_COLOR\">Specifies the printing and color options of the text grid.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/textgridpage/listLB_COLOR\">Anger utskrifts- och färgalternativ för textrastret.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/frmtypepage/relwidth\">Calculates the width of the selected object as a percentage of the width of the page text area.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/frmtypepage/relwidth\">Beräknar det markerade objektets bredd som en procentandel av bredden på sidans textområde.</ahelp>"

#. from libreoffice:swriter-01
msgid "Relative width relation"
msgstr "Relativ breddrelation"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/frmtypepage/relwidthrelation\">Decides what 100% width means: either text area (excluding margins) or the entire page (including margins).</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/frmtypepage/relwidthrelation\">Bestämmer vad 100% bredd innebär: antingen textytan (exklusive marginaler) eller hela sidan (inklusive marginaler).</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/frmtypepage/relheight\">Calculates the height of the selected object as a percentage of the height of the page text area.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/frmtypepage/relheight\">Beräknar det markerade objektets höjd som en procentandel av höjden på sidans textområde.</ahelp>"

#. from libreoffice:swriter-01
msgid "Relative height relation"
msgstr "Relativ höjdrelation"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/frmtypepage/relheightrelation\">Decides what 100% height means: either text area (excluding margins) or the entire page (including margins).</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/frmtypepage/relheightrelation\">Bestämmer vad 100% höjd innebär: antingen textytan (exklusive marginaler) eller hela sidan (inklusive marginaler).</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/frmtypepage/origsize\">Resets the size settings of the selected object to the original values.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/frmtypepage/origsize\">Återställer storleksinställningarna för det markerade objektet till ursprungsvärdena.</ahelp>"

#. from libreoffice:swriter-01
msgid "This option is not available for frames."
msgstr "Alternativet är inte tillgängligt för ramar."

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/frmtypepage/autoheight\">Automatically adjusts the width or height of a frame to match the contents of the frame. If you want, you can specify a minimum width or minimum height for the frame.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/frmtypepage/autoheight\">Justerar höjden eller bredden på ramen automatiskt så den anpassas efter raminnehållet. Du kan om du vill ange en minsta bredd eller höjd för ramen.</ahelp>"

#. from libreoffice:swriter-01
msgid "To paragraph"
msgstr "Vid stycke"

#. from libreoffice:swriter-01
msgid "To character"
msgstr "Vid tecken"

#. from libreoffice:swriter-01
msgid "As character"
msgstr "Som tecken"

#. from libreoffice:swriter-01
msgid "Specify the location of the selected object on the current page."
msgstr "Ange platsen för det markerade objektet på den aktuella sidan."

#. from libreoffice:swriter-01
msgid "If you anchor an object to a frame with a fixed height, only the \"Bottom\" and \"Center\" alignment options are available."
msgstr "Om du förankrar ett objekt vid en ram med fast höjd, är alla justeringsalternativ utom \"Nederst\" och \"Centrerat\" nedtonade."

#. from libreoffice:swriter-01
msgid "The green rectangle represents the selected object and the red rectangle represents the alignment reference point. If you anchor the object as a character, the reference rectangle changes to a red line."
msgstr "Den gröna rektangeln representerar det markerade objektet och den röda rektangeln representerar referenspunkten för justeringen. Om du förankrar objektet som tecken, ändras referensrektangeln till en röd linje."

#. from libreoffice:swriter-01
msgid "<link href=\"text/shared/01/05260000.xhp\"><emph>Format - Anchor</emph></link>"
msgstr "<link href=\"text/shared/01/05260000.xhp\"><emph>Format - Förankring</emph></link>"

#. from libreoffice:swriter-01
msgid "To wrap text around a table, place the table in a frame, and then wrap the text around the frame."
msgstr "Om du vill anpassa texten runt en tabell, placerar du tabellen i en ram och bryter sedan texten runt ramen."

#. from libreoffice:swriter-01
msgid "Specify the text wrap options."
msgstr "Anger alternativ för textanpassningen."

#. from libreoffice:swriter-01
msgid "First Paragraph"
msgstr "Första stycket"

#. from libreoffice:swriter-01
msgid "In Background"
msgstr "I bakgrunden"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/wrappage/outside\">Wraps text only around the contour of the object, but not in open areas within the object shape.</ahelp> This option is not available for frames."
msgstr "<ahelp hid=\"modules/swriter/ui/wrappage/outside\">Anpassar texten endast runt objektets kontur men inte i öppna områden inne i objektet.</ahelp> Alternativet är inte tillgängligt för ramar."

#. from libreoffice:swriter-01
msgid "Gaps"
msgstr "Hål"

#. from libreoffice:swriter-01
msgid "Specify the amount of space to leave between the selected object and the text."
msgstr "Ange hur stort utrymme som ska lämnas mellan det markerade objektet och texten."

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/wrappage/left\">Enter the amount of space that you want between the left edge of the object and the text.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/wrappage/left\">Ange hur stort utrymme som ska lämnas mellan objektets vänsterkant och texten.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/wrappage/right\">Enter the amount of space that you want between the right edge of the object and the text.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/wrappage/right\">Ange hur stort utrymme som ska lämnas mellan objektets högerkant och texten.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/wrappage/top\">Enter the amount of space that you want between the top edge of the object and the text.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/wrappage/top\">Ange hur stort utrymme som ska lämnas mellan objektets överkant och texten.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/wrappage/bottom\">Enter the amount of space that you want between the bottom edge of the object and the text.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/wrappage/bottom\">Ange hur stort utrymme som ska lämnas mellan objektets nederkant och texten.</ahelp>"

#. from libreoffice:swriter-01
msgid "<variable id=\"konturtext\"><ahelp hid=\".uno:ContourDialog\">Changes the contour of the selected object. $[officename] uses the contour when determining the <link href=\"text/swriter/01/05060200.xhp\">text wrap</link> options for the object.</ahelp></variable>"
msgstr "<variable id=\"konturtext\"><ahelp hid=\".uno:ContourDialog\">Ändrar det markerade objektets kontur. $[officename] använder konturen för att bestämma alternativ för ett objekts <link href=\"text/swriter/01/05060200.xhp\">textanpassning</link>.</ahelp></variable>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"svx/ui/floatingcontour/container\">Displays a preview of the contour.</ahelp>"
msgstr "<ahelp hid=\"svx/ui/floatingcontour/container\">Visar en förhandsvisning av konturen.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"svx/ui/floatingcontour/TBI_APPLY\">Applies the contour to the selected object.</ahelp>"
msgstr "<ahelp hid=\"svx/ui/floatingcontour/TBI_APPLY\">Använder konturen på det markerade objektet.</ahelp>"

#. from libreoffice:swriter-01
msgid "<image id=\"img_id3151253\" src=\"svx/res/nu01.png\" width=\"0.222inch\" height=\"0.222inch\"><alt id=\"alt_id3151253\">Icon</alt></image>"
msgstr "<image id=\"img_id3151253\" src=\"svx/res/nu01.png\" width=\"0.222inch\" height=\"0.222inch\"><alt id=\"alt_id3151253\">Symbol</alt></image>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"svx/ui/floatingcontour/TBI_WORKPLACE\">Deletes the custom contour. Click here, and then click in the preview area.</ahelp>"
msgstr "<ahelp hid=\"svx/ui/floatingcontour/TBI_WORKPLACE\">Raderar den befintliga konturen. Klicka här och klicka sedan i förhandsvisningsfältet.</ahelp>"

#. from libreoffice:swriter-01
msgid "<image id=\"img_id3147585\" src=\"svx/res/cd02.png\" width=\"0.222inch\" height=\"0.222inch\"><alt id=\"alt_id3147585\">Icon</alt></image>"
msgstr "<image id=\"img_id3147585\" src=\"svx/res/cd02.png\" width=\"0.222inch\" height=\"0.222inch\"><alt id=\"alt_id3147585\">Symbol</alt></image>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"svx/ui/floatingcontour/TBI_SELECT\">Changes to selection mode, so that you can select the contour.</ahelp>"
msgstr "<ahelp hid=\"svx/ui/floatingcontour/TBI_SELECT\">Ändrar till markeringsläge, så att du kan markera konturen.</ahelp>"

#. from libreoffice:swriter-01
msgid "<image id=\"img_id3151377\" src=\"cmd/sc_drawselect.png\" width=\"0.222inch\" height=\"0.222inch\"><alt id=\"alt_id3151377\">Icon</alt></image>"
msgstr "<image id=\"img_id3151377\" src=\"cmd/sc_drawselect.png\" width=\"0.222inch\" height=\"0.222inch\"><alt id=\"alt_id3151377\">Symbol</alt></image>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"svx/ui/floatingcontour/TBI_RECT\">Draws a rectangular contour where you drag in the object preview. To draw a square, hold down Shift while you drag.</ahelp>"
msgstr "<ahelp hid=\"svx/ui/floatingcontour/TBI_RECT\">Ritar en rektangulär kontur där du drar i objektets förhandsvisning. Du kan rita en kvadrat genom att hålla ned Skift medan du drar.</ahelp>"

#. from libreoffice:swriter-01
msgid "<image id=\"img_id3149565\" src=\"cmd/sc_rect.png\" width=\"0.222inch\" height=\"0.222inch\"><alt id=\"alt_id3149565\">Icon</alt></image>"
msgstr "<image id=\"img_id3149565\" src=\"cmd/sc_rect.png\" width=\"0.222inch\" height=\"0.222inch\"><alt id=\"alt_id3149565\">Symbol</alt></image>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"svx/ui/floatingcontour/TBI_CIRCLE\">Draws an oval contour where you drag in the object preview.</ahelp> To draw a circle, hold down shift while you drag."
msgstr "<ahelp hid=\"svx/ui/floatingcontour/TBI_CIRCLE\">Ritar en oval kontur där du drar i objektets förhandsvisning.</ahelp> Du kan rita en cirkel genom att hålla ned Skift medan du drar."

#. from libreoffice:swriter-01
msgid "<image id=\"img_id3146338\" src=\"cmd/sc_ellipse.png\" width=\"0.222inch\" height=\"0.222inch\"><alt id=\"alt_id3146338\">Icon</alt></image>"
msgstr "<image id=\"img_id3146338\" src=\"cmd/sc_ellipse.png\" width=\"0.222inch\" height=\"0.222inch\"><alt id=\"alt_id3146338\">Symbol</alt></image>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"svx/ui/floatingcontour/TBI_POLY\">Draws a closed contour consisting of straight line segments. Click where you want to start the polygon, and drag to draw a line segment. Click again to define the end of the line segment, and continue clicking to define the remaining line segments of the polygon. Double-click to finish drawing the polygon. To constrain the polygon to angles of 45 degree, hold down Shift when you click.</ahelp>"
msgstr "<ahelp hid=\"svx/ui/floatingcontour/TBI_POLY\">Ritar en sluten kontur bestående av raka linjesegment. Klicka där du vill att polygonen ska börja och rita ett linjesegment genom att dra. Klicka igen där linjesegmentet ska sluta och skapa resten av polygonens linjesegment genom att fortsätta klicka. Dubbelklicka när polygonen är färdigritad. Om du vill begränsa polygonens vinklar till 45 grader håller du ned Skift medan du klickar.</ahelp>"

#. from libreoffice:swriter-01
msgid "<image id=\"img_id3145311\" src=\"cmd/sc_polygon.png\" width=\"0.222inch\" height=\"0.222inch\"><alt id=\"alt_id3145311\">Icon</alt></image>"
msgstr "<image id=\"img_id3145311\" src=\"cmd/sc_polygon.png\" width=\"0.222inch\" height=\"0.222inch\"><alt id=\"alt_id3145311\">Symbol</alt></image>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"svx/ui/floatingcontour/TBI_POLYEDIT\">Lets you change the shape of the contour. Click here, and then drag the handles of the contour.</ahelp>"
msgstr "<ahelp hid=\"svx/ui/floatingcontour/TBI_POLYEDIT\">Här kan du ändra konturens form. Klicka här och dra sedan i konturens handtag.</ahelp>"

#. from libreoffice:swriter-01
msgid "<image id=\"img_id3154717\" src=\"cmd/sc_toggleobjectbeziermode.png\" width=\"0.222inch\" height=\"0.222inch\"><alt id=\"alt_id3154717\">Icon</alt></image>"
msgstr "<image id=\"img_id3154717\" src=\"cmd/sc_toggleobjectbeziermode.png\" width=\"0.222inch\" height=\"0.222inch\"><alt id=\"alt_id3154717\">Symbol</alt></image>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"svx/ui/floatingcontour/TBI_POLYMOVE\">Lets you drag the handles of the contour to change the shape of the contour.</ahelp>"
msgstr "<ahelp hid=\"svx/ui/floatingcontour/TBI_POLYMOVE\">Här kan du ändra konturens form genom att dra i dess handtag.</ahelp>"

#. from libreoffice:swriter-01
msgid "<image id=\"img_id3146947\" src=\"cmd/sc_beziermove.png\" width=\"0.222inch\" height=\"0.222inch\"><alt id=\"alt_id3146947\">Icon</alt></image>"
msgstr "<image id=\"img_id3146947\" src=\"cmd/sc_beziermove.png\" width=\"0.222inch\" height=\"0.222inch\"><alt id=\"alt_id3146947\">Symbol</alt></image>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"svx/ui/floatingcontour/TBI_POLYINSERT\">Inserts a handle that you can drag to change the shape of the contour. Click here, and then click on the contour outline.</ahelp>"
msgstr "<ahelp hid=\"svx/ui/floatingcontour/TBI_POLYINSERT\">Infogar ett handtag som du kan använda för att ändra konturens form. Klicka här och klicka sedan på konturlinjen.</ahelp>"

#. from libreoffice:swriter-01
msgid "<image id=\"img_id3149363\" src=\"cmd/sc_bezierinsert.png\" width=\"0.222inch\" height=\"0.222inch\"><alt id=\"alt_id3149363\">Icon</alt></image>"
msgstr "<image id=\"img_id3149363\" src=\"cmd/sc_bezierinsert.png\" width=\"0.222inch\" height=\"0.222inch\"><alt id=\"alt_id3149363\">Symbol</alt></image>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"svx/ui/floatingcontour/TBI_POLYDELETE\">Removes a point from the contour outline. Click here, and then click the point that you want to delete.</ahelp>"
msgstr "<ahelp hid=\"svx/ui/floatingcontour/TBI_POLYDELETE\">Tar bort en punkt från konturlinjen. Klicka här och klicka sedan på den punkt du vill radera.</ahelp>"

#. from libreoffice:swriter-01
msgid "<image id=\"img_id3149643\" src=\"cmd/sc_bezierdelete.png\" width=\"0.222inch\" height=\"0.222inch\"><alt id=\"alt_id3149643\">Icon</alt></image>"
msgstr "<image id=\"img_id3149643\" src=\"cmd/sc_bezierdelete.png\" width=\"0.222inch\" height=\"0.222inch\"><alt id=\"alt_id3149643\">Symbol</alt></image>"

#. from libreoffice:swriter-01
msgid "Auto Contour"
msgstr "AutoKontur"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"svx/ui/floatingcontour/TBI_AUTOCONTOUR\">Automatically draws a contour around the object that you can edit.</ahelp>"
msgstr "<ahelp hid=\"svx/ui/floatingcontour/TBI_AUTOCONTOUR\">Ritar automatiskt en kontur runt det objekt som går att redigera.</ahelp>"

#. from libreoffice:swriter-01
msgid "<image id=\"img_id3149621\" src=\"svx/res/cd025.png\" width=\"0.222inch\" height=\"0.222inch\"><alt id=\"alt_id3149621\">Icon</alt></image>"
msgstr "<image id=\"img_id3149621\" src=\"svx/res/cd025.png\" width=\"0.222inch\" height=\"0.222inch\"><alt id=\"alt_id3149621\">Symbol</alt></image>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"svx/ui/floatingcontour/TBI_UNDO\">Reverses the last action.</ahelp>"
msgstr "<ahelp hid=\"svx/ui/floatingcontour/TBI_UNDO\">Ångrar den senaste åtgärden.</ahelp>"

#. from libreoffice:swriter-01
msgid "<image id=\"img_id3149206\" src=\"svx/res/cd020.png\" width=\"0.222inch\" height=\"0.222inch\"><alt id=\"alt_id3149206\">Icon</alt></image>"
msgstr "<image id=\"img_id3149206\" src=\"svx/res/cd020.png\" width=\"0.222inch\" height=\"0.222inch\"><alt id=\"alt_id3149206\">Symbol</alt></image>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"svx/ui/floatingcontour/TBI_REDO\">Reverses the action of the last <emph>Undo </emph>command.</ahelp>"
msgstr "<ahelp hid=\"svx/ui/floatingcontour/TBI_REDO\">Ångrar den senaste användningen av kommandot <emph>Ångra</emph>.</ahelp>"

#. from libreoffice:swriter-01
msgid "<image id=\"img_id3154073\" src=\"cmd/sc_redo.png\" width=\"0.2228inch\" height=\"0.2228inch\"><alt id=\"alt_id3154073\">Icon</alt></image>"
msgstr "<image id=\"img_id3154073\" src=\"cmd/sc_redo.png\" width=\"0.2228inch\" height=\"0.2228inch\"><alt id=\"alt_id3154073\">Symbol</alt></image>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"svx/ui/floatingcontour/TBI_PIPETTE\">Selects the parts of the bitmap that are the same color. Click here, and then click a color in the bitmap. To increase the color range that is selected, increase the value in the <emph>Tolerance</emph> box.</ahelp>"
msgstr "<ahelp hid=\"svx/ui/floatingcontour/TBI_PIPETTE\">Markerar de delar av en bitmap som har samma färg. Klicka här och klicka sedan på en färg i bitmappen. Du kan utöka det markerade färgområdet genom att öka värdet i rutan <emph>Färgtolerans</emph>.</ahelp>"

#. from libreoffice:swriter-01
msgid "<image id=\"img_id3149585\" src=\"sd/res/pipette.png\" width=\"0.222inch\" height=\"0.222inch\"><alt id=\"alt_id3149585\">Icon</alt></image>"
msgstr "<image id=\"img_id3149585\" src=\"sd/res/pipette.png\" width=\"0.222inch\" height=\"0.222inch\"><alt id=\"alt_id3149585\">Symbol</alt></image>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".\">Enter the color tolerance for the Color Replacer as a percentage. To increase the color range that the Color Replacer selects, enter a high percentage.</ahelp>"
msgstr "<ahelp hid=\".\">Ange färgtolerans för pipetten som en procentuell andel. Om du vill utöka det färgområde som pipetten markerar anger du ett högt procenttal.</ahelp>"

#. from libreoffice:swriter-01
msgid "Vertically"
msgstr "Lodrätt"

#. from libreoffice:swriter-01
msgid "Horizontally"
msgstr "horisontalt, på"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/picturepage/entry\">Displays the path to the linked graphic file. To change the link, click the <emph>Browse</emph> button and then locate the file that you want to link to.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/picturepage/entry\">Visar sökvägen till den länkade filen. Om du vill ändra länken klickar du på bläddringsknappen (<emph>...</emph>) och letar rätt på den fil som du vill länka till. </ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/picturepage/browse\">Locate the new graphic file that you want to link to, and then click <emph>Open</emph>.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/picturepage/browse\">Leta rätt på den nya grafikfil som du vill länka till och klicka på <emph>Öppna</emph>.</ahelp>"

#. from libreoffice:swriter-01
msgid "<link href=\"text/shared/01/05240000.xhp\">Format - Flip</link>"
msgstr "<link href=\"text/shared/01/05240000.xhp\">Format - Spegelvänd</link>"

#. from libreoffice:swriter-01
msgid "<link href=\"text/shared/01/02180000.xhp\">Edit - Links</link>"
msgstr "<link href=\"text/shared/01/02180000.xhp\">Redigera - Länkar</link>"

#. from libreoffice:swriter-01
msgid "<link href=\"text/swriter/01/05060700.xhp\">Macro</link>"
msgstr "<link href=\"text/swriter/01/05060700.xhp\">Makro</link>"

#. from libreoffice:swriter-01
msgid "The following table lists the object types and the events that can trigger a macro:"
msgstr "I tabellen nedan finns de objekt och händelser som kan utlösa ett makro"

#. from libreoffice:swriter-01
msgid "object is selected"
msgstr "objektet markeras"

#. from libreoffice:swriter-01
msgid "mouse pointer moves over the object"
msgstr "muspekaren rör sig över objektet"

#. from libreoffice:swriter-01
msgid "hyperlink that is assigned to the object is clicked"
msgstr "hyperlänken som hör till ett objekt klickas"

#. from libreoffice:swriter-01
msgid "mouse pointer moves off the object"
msgstr "muspekaren rör sig bort från objektet"

#. from libreoffice:swriter-01
msgid "text is inputted"
msgstr "text matas in"

#. from libreoffice:swriter-01
msgid "Nonprinting characters, such as tabs and line breaks, are entered"
msgstr "kontrolltecken (t.ex. tabbar och radbrytningar) matas in"

#. from libreoffice:swriter-01
msgid "frame is resized"
msgstr "ramen ändrar storlek"

#. from libreoffice:swriter-01
msgid "frame is moved"
msgstr "ramen flyttas"

#. from libreoffice:swriter-01
msgid "before AutoText is inserted"
msgstr "innan AutoText infogas"

#. from libreoffice:swriter-01
msgid "after AutoText is inserted"
msgstr "efter AutoText infogas"

#. from libreoffice:swriter-01
msgid "For events that are linked to controls in forms, see <link href=\"text/shared/02/01170103.xhp\">Control properties</link> or <link href=\"text/shared/02/01170202.xhp\">Form properties</link>."
msgstr "Mer information om händelser som är kopplade till kontroller i formulär finns i avsnitten <link href=\"text/shared/02/01170103.xhp\">Kontrollegenskaper</link> och <link href=\"text/shared/02/01170202.xhp\">Formuläregenskaper</link>."

#. from libreoffice:swriter-01
msgid "Frames allow you to link certain events to a function that then decides if the event is handled by $[officename] Writer or by the function. See the $[officename] Basic Help for more information."
msgstr "Med ramar kan du länka vissa händelser till en funktion som kontrollerar om händelsen ska hanteras av $[officename] Writer eller av funktionen. Mer information finns i hjälpen till $[officename] Basic."

#. from libreoffice:swriter-01
msgid "<bookmark_value>objects; defining hyperlinks</bookmark_value>         <bookmark_value>frames; defining hyperlinks</bookmark_value>         <bookmark_value>pictures; defining hyperlinks</bookmark_value>         <bookmark_value>hyperlinks; for objects</bookmark_value>"
msgstr "<bookmark_value>objekt; bestämma hyperlänkar</bookmark_value>         <bookmark_value>ramar; bestämma hyperlänkar</bookmark_value>         <bookmark_value>bilder; bestämma hyperlänkar</bookmark_value>         <bookmark_value>hyperlänkar; för objekt</bookmark_value>"

#. from libreoffice:swriter-01
msgid "<link href=\"text/swriter/01/05060800.xhp\">Hyperlink</link>"
msgstr "<link href=\"text/swriter/01/05060800.xhp\">Hyperlänk</link>"

#. from libreoffice:swriter-01
msgid "Set the link properties."
msgstr "Ange egenskaper för länken."

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/frmurlpage/url\">Enter the complete path to the file that you want to open.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/frmurlpage/url\">Ange sökvägen till den fil du vill öppna.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/frmurlpage/name\">Enter a name for the hyperlink.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/frmurlpage/name\">Ange hyperlänkens namn.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/frmurlpage/frame\">Specify the name of the frame where you want to open the targeted file.</ahelp> The predefined target frame names are described <link href=\"text/shared/01/05020400.xhp#targets\">here</link>."
msgstr "<ahelp hid=\"modules/swriter/ui/frmurlpage/frame\">Ange namnet på den HTML-ram där målfilen ska öppnas.</ahelp> De fördefinierade ramnamnen finns beskrivna <link href=\"text/shared/01/05020400.xhp#targets\">här</link>."

#. from libreoffice:swriter-01
msgid "Select the type of <link href=\"text/shared/00/00000002.xhp#imagemap\">ImageMap</link> that you want to use. The ImageMap settings override the hyperlink settings that you enter on this page."
msgstr "Välj den typ av <link href=\"text/shared/00/00000002.xhp#imagemap\">bildkarta</link> som du vill använda. Bildkarteinställningarna åsidosätter hyperlänksinställningarna du anger på sidan."

#. from libreoffice:swriter-01
msgid "Server-side image map"
msgstr "Image map på serversidan"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/frmurlpage/server\">Uses a server-side image map.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/frmurlpage/server\">Använder en image map på serversidan.</ahelp>"

#. from libreoffice:swriter-01
msgid "Client-side image map"
msgstr "Image map på klientsidan"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/frmurlpage/client\">Uses the <link href=\"text/shared/01/02220000.xhp\">image map</link> that you created for the selected object.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/frmurlpage/client\">Använder den <link href=\"text/shared/01/02220000.xhp\">image map</link> som du skapat för det markerade objektet.</ahelp>"

#. from libreoffice:swriter-01
msgid "<link href=\"text/shared/00/00000002.xhp#url\">URL</link>"
msgstr "<link href=\"text/shared/00/00000002.xhp#url\">URL</link>"

#. from libreoffice:swriter-01
msgid "<link href=\"text/swriter/01/05060900.xhp\">Options</link>"
msgstr "<link href=\"text/swriter/01/05060900.xhp\">Alternativ</link>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/frmaddpage/name\">Enter a name for the selected item.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/frmaddpage/name\">Ange ett namn på det markerade objektet.</ahelp>"

#. from libreoffice:swriter-01
msgid "Assign an object, graphic or frame a meaningful name, so that you can quickly locate it afterwards in long documents."
msgstr "Skapa ett användarvänligt namn för ett objekt, en bild eller en ram, så att du snabbt kan hitta till ett visst ställe i ett långt dokument."

#. from libreoffice:swriter-01
msgid "Previous link"
msgstr "Föregående"

#. from libreoffice:swriter-01
msgid "Next link"
msgstr "Följande"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/frmaddpage/vertalign\">Specifies the vertical alignment of the frame's content. Mainly it means text content, but it also affects tables and other objects anchored to the text area (anchored as character, to character or to paragraph), for example frames, graphics or drawings.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/frmaddpage/vertalign\">Anger den vertikala justeringen av innehållet i en ram. Detta innebär i huvudsak text men påverkar även tabeller och andra objekt som förankrats i textytan (förankring som tecken, till tecken eller till stycke) som exempelvis ramar, bilder och teckningar.</ahelp>"

#. from libreoffice:swriter-01
msgid "Specifies print and text options for the selected item."
msgstr "I det här området hittar du alternativ för att skydda grafikobjekt, ramar eller objekt mot oavsiktliga ändringar."

#. from libreoffice:swriter-01
msgid "Editable in read-only document (frames only)"
msgstr "Redigerbar i skrivskyddat dokument (bara vid ramar)"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/frmaddpage/editinreadonly\">Allows you to edit the contents of a frame in a document that is read-only (write-protected).</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/frmaddpage/editinreadonly\">Gör att du kan redigera innehållet i en ram i ett dokument med skrivskydd.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/frmaddpage/printframe\">Includes the selected item when you print the document.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/frmaddpage/printframe\">Tar med det markerade objektet när du skriver ut dokumentet.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/frmaddpage/textflow\">Specifies the preferred text flow direction in a frame. To use the default text flow settings for the page, select <emph>Use superordinate object settings </emph>from the list.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/frmaddpage/textflow\">Anger den önskade textflödesriktningen i en ram. Du kan använda standardinställningarna för textflöde på sidan genom att välja <emph>Använd det överordnade objektets inställningar</emph> i listan.</ahelp>"

#. from libreoffice:swriter-01
msgid "<link href=\"text/shared/01/05040200.xhp\">Text direction</link>."
msgstr "<link href=\"text/shared/01/05040200.xhp\">Textriktning</link>."

#. from libreoffice:swriter-01
msgid "<link href=\"text/swriter/01/05060200.xhp\">Wrap</link>"
msgstr "<link href=\"text/swriter/01/05060200.xhp\">Textanpassning</link>"

#. from libreoffice:swriter-01
msgid "<bookmark_value>tables; positioning</bookmark_value><bookmark_value>tables; inserting text before</bookmark_value>"
msgstr "<bookmark_value>Tabeller; placera</bookmark_value><bookmark_value>Tabeller; infoga text före</bookmark_value>"

#. from libreoffice:swriter-01
msgid "<link href=\"text/swriter/01/05090100.xhp\">Table</link>"
msgstr "<link href=\"text/swriter/01/05090100.xhp\">Tabell</link>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/formattablepage/FormatTablePage\">Specify the size, position, spacing, and alignment options for the selected table.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/formattablepage/FormatTablePage\">Anger alternativ för storlek, placering, avstånd och justering av den markerade tabellen.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/formattablepage/name\">Enter an internal name for the table. You can use this name to quickly locate the table in the Navigator.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/formattablepage/name\">Ange ett internt namn på tabellen. Du kan använda namnet för att snabbt hitta tabellen med Navigator.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/formattablepage/widthmf\">Enter the width of the table.</ahelp> This check box is only available if the <emph>Automatic</emph> option in the <emph>Alignment</emph> area is not selected."
msgstr "<ahelp hid=\"modules/swriter/ui/formattablepage/widthmf\">Ange tabellens bredd.</ahelp> Den här kryssrutan är bara tillgänglig om du har avmarkerat kryssrutan <emph>Automatiskt</emph> under <emph>Justering</emph>."

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/formattablepage/relwidth\">Displays the width of the table as a percentage of the page width.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/formattablepage/relwidth\">Visar tabellens bredd som en procentandel av sidbredden.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/formattablepage/full\">Extends the table horizontally to the left and to the right page margins.</ahelp> This is the recommended setting for tables in HTML documents."
msgstr "<ahelp hid=\"modules/swriter/ui/formattablepage/full\">Utvidgar tabellen vågrätt till vänster och höger sidmarginaler.</ahelp> Det här är den rekommenderade inställningen för tabeller i HTML dokument."

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/formattablepage/left\">Aligns the left edge of the table to the left page margin.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/formattablepage/left\">Justerar tabellens vänstra kant mot vänster sidmarginal.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/formattablepage/fromleft\">Aligns the left edge of the table to the indent that you enter in the <emph>Left </emph>box in the <emph>Spacing </emph>area.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/formattablepage/fromleft\">Justerar tabellens vänsterkant till det indrag du anger i rutan <emph>Till vänster</emph> under <emph>Avstånd</emph>.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/formattablepage/right\">Aligns the right edge of the table to the right page margin.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/formattablepage/right\">Justerar tabellens högra kant mot höger sidmarginal.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/formattablepage/center\">Centers the table horizontally on the page.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/formattablepage/center\">Centrerar tabellen horisontellt på sidan.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/formattablepage/free\">Horizontally aligns the table based on the values that you enter in the <emph>Left</emph> and <emph>Right</emph> boxes in the<emph> Spacing</emph> area.</ahelp> $[officename] automatically calculates the table width. Select this option if you want to specify the individual <link href=\"text/swriter/01/05090200.xhp\">column widths</link>."
msgstr "<ahelp hid=\"modules/swriter/ui/formattablepage/free\">Justerar tabellen horisontellt baserat på de värden du anger i rutorna <emph>Till vänster</emph> och <emph>Till höger</emph> under <emph>Avstånd</emph>.</ahelp> $[officename] beräknar tabellens bredd automatiskt. Markera det här alternativet om du vill ange individuella <link href=\"text/swriter/01/05090200.xhp\">kolumnbredder</link>."

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/formattablepage/leftmf\">Enter the amount of space that you want to leave between the left page margin and the edge of the table.</ahelp> This option is not available if the <emph>Automatic </emph>or the <emph>Left</emph> option is selected in the <emph>Alignment</emph> area."
msgstr "<ahelp hid=\"modules/swriter/ui/formattablepage/leftmf\">Ange hur stort utrymme som ska lämnas mellan vänster sidmarginal och tabellens kant.</ahelp> Det här alternativet är inte tillgängligt om alternativet <emph>Automatiskt</emph> eller <emph>Vänster</emph> är markerad under <emph>Justering</emph>."

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/formattablepage/rightmf\">Enter the amount of space that you want to leave between the right page margin and the edge of the table.</ahelp> This option is not available if the <emph>Automatic </emph>or the <emph>Right</emph> option is selected in the <emph>Alignment</emph> area."
msgstr "<ahelp hid=\"modules/swriter/ui/formattablepage/rightmf\">Ange hur stort utrymme som ska lämnas mellan höger sidmarginal och tabellens kant.</ahelp> Det här alternativet är inte tillgängligt om alternativet <emph>Automatiskt</emph> eller <emph>Höger</emph> är markerad under <emph>Justering</emph>."

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/formattablepage/abovemf\">Enter the amount of space that you want to leave between the top edge of the table and the text above the table.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/formattablepage/abovemf\">Ange hur mycket utrymme som ska lämnas mellan tabellens överkant och texten ovanför tabellen.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/formattablepage/belowmf\">Enter the amount of space that you want to leave between the bottom edge of the table and the text below the table.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/formattablepage/belowmf\">Ange hur mycket utrymme som ska lämnas mellan tabellens nederkant och texten under tabellen.</ahelp>"

#. from libreoffice:swriter-01
msgid "<link href=\"text/swriter/01/05090200.xhp\">Columns</link>"
msgstr "<link href=\"text/swriter/01/05090200.xhp\">Kolumner</link>"

#. from libreoffice:swriter-01
msgid "Specify the column width properties."
msgstr "Ange egenskaperna för kolumnbredden."

#. from libreoffice:swriter-01
msgid "Adapt table width"
msgstr "Anpassa tabellbredd"

#. from libreoffice:swriter-01
msgid "Adjust columns proportionally"
msgstr "Ändra kolumner proportionellt"

#. from libreoffice:swriter-01
msgid "Remaining space"
msgstr "Återstående plats"

#. from libreoffice:swriter-01
msgid "Column width"
msgstr "Kolumnbredd"

#. from libreoffice:swriter-01
msgid "Specify the column widths for the table."
msgstr "Ange kolumnbredden för tabellen."

#. from libreoffice:swriter-01
msgid "Column widths"
msgstr "Kolumnbredder"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/tablecolumnpage/width6\">Enter the width that you want for the column.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/tablecolumnpage/width6\">Ange den nya bredden för kolumnen.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/tablecolumnpage/back\">Displays the table columns found to the left of the current column.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/tablecolumnpage/back\">Visar kolumnerna i tabellen till vänster om den aktuella kolumnen.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/tablecolumnpage/next\">Displays the table columns found to the right of the current column.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/tablecolumnpage/next\">Visar kolumnerna i tabellen till höger om den aktuella kolumnen.</ahelp>"

#. from libreoffice:swriter-01
msgid "Editing Tables Using the Keyboard"
msgstr "Redigera tabeller med tangentbordet"

#. from libreoffice:swriter-01
msgid "<bookmark_value>tables; editing with the keyboard</bookmark_value>"
msgstr "<bookmark_value>Tabeller; redigera med tangentbordet</bookmark_value>"

#. from libreoffice:swriter-01
msgid "<variable id=\"tabelle_tastatur\"><link href=\"text/swriter/01/05090201.xhp\">Editing Tables Using the Keyboard</link></variable>"
msgstr "<variable id=\"tabelle_tastatur\"><link href=\"text/swriter/01/05090201.xhp\">Redigera tabell via tangentbord</link></variable>"

#. from libreoffice:swriter-01
msgid "You can resize and delete table columns with the keyboard."
msgstr "Du kan radera och ändra storlek på tabellkolumner med tangentbordet."

#. from libreoffice:swriter-01
msgid "Resizing Columns and Rows"
msgstr "Ändra storlek på kolumner och rader."

#. from libreoffice:swriter-01
msgid "To resize a column, place the cursor in a table cell, hold down Alt, and then press the left or the right arrow. To resize the column without changing the width of the table, hold down <switchinline select=\"sys\"><caseinline select=\"MAC\">Command+Option</caseinline><defaultinline>Ctrl+Alt</defaultinline></switchinline>, and then press the left or the right arrows."
msgstr "Om du vill ändra storlek på en kolumn placerar du markören i en tabellcell, håller ned Alt och trycker sedan på vänster- eller högerpilen. Om du vill ändra storlek på kolumnen utan att ändra tabellens bredd håller du ned <switchinline select=\"sys\"><caseinline select=\"MAC\">Kommando+Alternativ</caseinline><defaultinline>Ctrl+Alt</defaultinline></switchinline>och trycker sedan på vänster- eller högerpilen."

#. from libreoffice:swriter-01
msgid "To increase the left indent of the table, hold down <switchinline select=\"sys\"><caseinline select=\"MAC\">Option</caseinline><defaultinline>Alt</defaultinline></switchinline>+Shift, and then press the right arrow."
msgstr "Om du vill öka tabellens vänstra indrag håller du ned <switchinline select=\"sys\"><caseinline select=\"MAC\">Alternativ</caseinline><defaultinline>Alt</defaultinline></switchinline>+Skift och trycker sedan på högerpilen."

#. from libreoffice:swriter-01
msgid "To resize a row, place the cursor in the row, hold down <switchinline select=\"sys\"><caseinline select=\"MAC\">Option</caseinline><defaultinline>Alt</defaultinline></switchinline>, and then press the up or the down arrows."
msgstr "Om du vill ändra storlek på en rad placerar du markören i raden, håller ned <switchinline select=\"sys\"><caseinline select=\"MAC\">Alternativ</caseinline><defaultinline>Alt</defaultinline></switchinline> och trycker sedan på uppåtpilen eller nedåtpilen."

#. from libreoffice:swriter-01
msgid "To move the table downwards on the page, hold down <switchinline select=\"sys\"><caseinline select=\"MAC\">Option</caseinline><defaultinline>Alt</defaultinline></switchinline>+Shift, and then press the down arrow."
msgstr "Om du vill flytta tabellen nedåt på sidan håller du ned <switchinline select=\"sys\"><caseinline select=\"MAC\">Alternativ</caseinline><defaultinline>Alt</defaultinline></switchinline>+Skift och trycker sedan på nedåtpilen."

#. from libreoffice:swriter-01
msgid "Inserting and deleting columns or rows"
msgstr "Infoga och radera kolumner och rader"

#. from libreoffice:swriter-01
msgid "To insert a column, place the cursor in a table cell, hold down <switchinline select=\"sys\"><caseinline select=\"MAC\">Option</caseinline><defaultinline>Alt</defaultinline></switchinline> and press Insert, release, and then press the left or the right arrow."
msgstr "Om du vill infoga en kolumn placerar du markören i en tabellcell, håller ned <switchinline select=\"sys\"><caseinline select=\"MAC\">Alternativ</caseinline><defaultinline>Alt</defaultinline></switchinline> och trycker på tangenten Insert, släpper, och trycker sedan på vänster- eller högerpilen."

#. from libreoffice:swriter-01
msgid "To delete a column, place the cursor in the column that you want to delete, hold down <switchinline select=\"sys\"><caseinline select=\"MAC\">Option</caseinline><defaultinline>Alt</defaultinline></switchinline> and press Delete, release, and then press the left or the right arrow."
msgstr "Om du vill radera en kolumn placerar du markören i en tabellcell, håller ned tangenten <switchinline select=\"sys\"><caseinline select=\"MAC\">Alternativ</caseinline><defaultinline>Alt</defaultinline></switchinline> och trycker på tangenten Delete, släpper, och trycker sedan på vänster- eller högerpilen."

#. from libreoffice:swriter-01
msgid "To insert a row, place the cursor in a table cell, hold down <switchinline select=\"sys\"><caseinline select=\"MAC\">Option</caseinline><defaultinline>Alt</defaultinline></switchinline> and press Insert, release, and then press the up or the down arrow."
msgstr "Om du vill infoga en rad placerar du markören i en tabellcell, håller ned <switchinline select=\"sys\"><caseinline select=\"MAC\">Alternativ</caseinline><defaultinline>Alt</defaultinline></switchinline> och trycker på tangenten Insert, släpper, och trycker sedan på uppåt- eller nedåtpilen."

#. from libreoffice:swriter-01
msgid "To delete a row, place the cursor in the row that you want to delete, hold down <switchinline select=\"sys\"><caseinline select=\"MAC\">Option</caseinline><defaultinline>Alt</defaultinline></switchinline> and press Delete, release, and then press the up or the down arrow."
msgstr "Om du vill radera en rad placerar du markören i en tabellcell, håller ned tangenten <switchinline select=\"sys\"><caseinline select=\"MAC\">Alternativ</caseinline><defaultinline>Alt</defaultinline></switchinline> och trycker på tangenten Delete, släpper, och trycker sedan på uppåt- eller nedåtpilen."

#. from libreoffice:swriter-01
msgid "<link href=\"text/swriter/main0204.xhp\">Table Bar</link>"
msgstr "<link href=\"text/swriter/main0204.xhp\">Verktygsraden Tabell</link>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/tabletextflowpage/TableTextFlowPage\">Set the text flow options for the text before and after the table.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/tabletextflowpage/TableTextFlowPage\">Ange inställningar för textflöde före och efter tabellen.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/tabletextflowpage/break\">Select this check box, and then select the type of break that you want to associate with the table.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/tabletextflowpage/break\">Markera den här kryssrutan och välj vilken typ av brytning som ska kopplas till tabellen.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/tabletextflowpage/page\">Inserts a page break before or after the table.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/tabletextflowpage/page\">Infogar en sidbrytning före eller efter tabellen.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/tabletextflowpage/column\">Inserts a column break before or after the table on a multi-column page.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/tabletextflowpage/column\">Infogar en kolumnbrytning före eller efter tabellen på en sida med flera kolumner.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/tabletextflowpage/before\">Inserts a page or column break before the table.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/tabletextflowpage/before\">Infogar en sidbrytning eller kolumnbrytning före tabellen.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/tabletextflowpage/after\">Inserts a page or column break after the table.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/tabletextflowpage/after\">Infogar en sidbrytning eller kolumnbrytning efter tabellen.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/tabletextflowpage/pagestyle\">Applies the page style that you specify to the first page that follows the page break.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/tabletextflowpage/pagestyle\">Använder den sidformatmall som du anger på första sidan som kommer efter sidbrytningen.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/tabletextflowpage/pagestylelb\">Select the page style that you want to apply to the first page that follows the break.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/tabletextflowpage/pagestylelb\">Välj den sidformatmall som du vill använda på den första sidan efter brytningen.</ahelp>"

#. from libreoffice:swriter-01
msgid "Allow table to split across pages and columns"
msgstr "Tillåt tabellen att delas upp mellan sidor och kolumner"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/tabletextflowpage/split\">Allows a page break or column break between the rows of a table.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/tabletextflowpage/split\">Tillåter en sid- eller kolumnbrytning mellan tabellrader.</ahelp>"

#. from libreoffice:swriter-01
msgid "Allow row to break across pages and columns"
msgstr "Tillåt radbrytning i slutet av sidor och kolumner"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/tabletextflowpage/splitrow\">Allows a page break or column break inside a row of the table.</ahelp> This option is not applied to the first row in a table if the <emph>Repeat Heading</emph> option is selected."
msgstr "<ahelp hid=\"modules/swriter/ui/tabletextflowpage/splitrow\">Tillåter en sid- eller kolumnbrytning inuti en tabellrad.</ahelp> Det här alternativet tillämpas inte på den första tabellraden om alternativet <emph>Upprepa rubrik</emph> har valts."

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/tabletextflowpage/keep\">Keeps the table and the following paragraph together when you insert the break.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/tabletextflowpage/keep\">Håller samman tabellen med följande stycke när du infogar brytningen.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/tabletextflowpage/headline\">Repeats the table heading on a new page when the table spans more than one page.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/tabletextflowpage/headline\">Upprepar tabellrubriken på en nästa sida om tabellen sträcker sig över fler än en sida.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/tabletextflowpage/repeatheadernf\">Enter the number of rows to include in the heading.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/tabletextflowpage/repeatheadernf\">Ange hur många rader som ska ingå i rubriken.</ahelp>"

#. from libreoffice:swriter-01
msgid "Text orientation"
msgstr "Textorientering"

#. from libreoffice:swriter-01
msgid "Vertical alignment"
msgstr "Vertikal justering"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/tabletextflowpage/vertorient\">Specify the vertical text alignment for the cells in the table.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/tabletextflowpage/vertorient\">Ange den vertikala textjusteringen för cellerna i tabellen.</ahelp>"

#. from libreoffice:swriter-01
msgid "<link href=\"text/swriter/01/05100000.xhp\">Cell</link>"
msgstr "<link href=\"text/swriter/01/05100000.xhp\">Cell</link>"

#. from libreoffice:swriter-01
msgid "This command is only available if you have selected a table in your document, or if the cursor is in a table cell."
msgstr "Det här kommandot är endast tillgängligt om du har markerat en tabell i dokumentet, eller om markören står i en tabellcell."

#. from libreoffice:swriter-01
msgid "Unprotect"
msgstr "Upphäv skydd"

#. from libreoffice:swriter-01
msgid "<link href=\"text/swriter/01/05100400.xhp\">Unprotect</link>"
msgstr "<link href=\"text/swriter/01/05100400.xhp\">Upphäv skydd</link>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".uno:UnsetCellsReadOnly\">Removes the cell protection for all selected cells in the current table.</ahelp>"
msgstr "<ahelp hid=\".uno:UnsetCellsReadOnly\">Tar bort cellskyddet för alla celler i den aktuella tabellen.</ahelp>"

#. from libreoffice:swriter-01
msgid "You can also remove cell protection from a table in the <link href=\"text/swriter/01/02110000.xhp\">Navigator</link>."
msgstr "Du kan också ta bort cellskyddet från en tabell genom att använda <link href=\"text/swriter/01/02110000.xhp\">Navigator</link>."

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/rowheight/heightmf\">Enter the height that you want for the selected row(s).</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/rowheight/heightmf\" visibility=\"visible\">Ange den nya höjden för de markerade raderna.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/rowheight/fit\">Automatically adjusts the row height to match the contents of the cells.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/rowheight/fit\" visibility=\"visible\">Justerar radhöjden automatiskt beroende på innehållet i cellerna.</ahelp>"

#. from libreoffice:swriter-01
msgid "<variable id=\"breitetext\"><ahelp hid=\".uno:SetColumnWidth\">Changes the width of the selected column(s).</ahelp></variable>"
msgstr "<variable id=\"breitetext\"><ahelp hid=\".uno:SetColumnWidth\">Ändrar bredden på de markerade kolumnerna.</ahelp></variable>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/columnwidth/column\">Enter the column number of the column you want to change the width of.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/columnwidth/column\">Ange numret för den kolumn som du vill ändra bredd på.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/columnwidth/width\">Enter the width that you want for the selected column(s).</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/columnwidth/width\">Ange önskad bredd för markerade kolumner.</ahelp>"

#. from libreoffice:swriter-01
msgid "Insert Columns/Rows"
msgstr "Infoga kolumner/rader"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".\" visibility=\"hidden\">Inserts a row into the table.</ahelp>"
msgstr "<ahelp hid=\".\" visibility=\"hidden\">Infogar en rad i tabellen.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".\" visibility=\"hidden\">Inserts a column into the table.</ahelp>"
msgstr "<ahelp hid=\".\" visibility=\"hidden\">Infogar en kolumn i tabellen.</ahelp>"

#. from libreoffice:swriter-01
msgid "Specifies where to insert the columns or rows."
msgstr "Anger var kolumnerna eller raderna ska infogas."

#. from libreoffice:swriter-01
msgid "Styles in Writer"
msgstr "Formatmallar i Writer"

#. from libreoffice:swriter-01
msgid "Style Category"
msgstr "Mallkategori"

#. from libreoffice:swriter-01
msgid "Use Character Styles to format single characters, or entire words and phrases. If you want, you can nest Character Styles."
msgstr "Använd Teckenformatmallar för att formatera enstaka tecken, ord eller fraser. Om du vill kan du använda ett teckenformat inne i ett annat teckenformat."

#. from libreoffice:swriter-01
msgid "Use Paragraph Styles to format paragraphs, including the font type and size. You can also select the paragraph style to apply to the next paragraph."
msgstr "Använd styckeformatmallar för att formatera stycken, inklusive teckensnitt och teckenstorlek. Du kan också välja den styckeformatmall som ska användas i nästa stycke."

#. from libreoffice:swriter-01
msgid "Use Frame Styles to format text and graphic frames."
msgstr "Använd Ramformatmallar när du ska formatera text- och grafikramar."

#. from libreoffice:swriter-01
msgid "Use Page Styles to organize the structure of the document, and to add page numbers. You can also specify the page style to apply to the first page that follows after a page break."
msgstr "Använd Sidformatmallar för att organisera strukturen i dokumentet och för att lägga till sidnummer. Du kan också ange vilket sidformat som ska användas på den första sidan efter en sidbrytning."

#. from libreoffice:swriter-01
msgid "<link href=\"text/swriter/01/05130002.xhp\">Character Style</link>"
msgstr "<link href=\"text/swriter/01/05130002.xhp\">Teckenformatmall</link>"

#. from libreoffice:swriter-01
msgid "<bookmark_value>styles; conditional</bookmark_value><bookmark_value>conditional styles</bookmark_value>"
msgstr "<bookmark_value>Formatmallar; villkorliga</bookmark_value><bookmark_value>Villkorliga formatmallar</bookmark_value>"

#. from libreoffice:swriter-01
msgid "<link href=\"text/swriter/01/05130100.xhp\">Condition</link>"
msgstr "<link href=\"text/swriter/01/05130100.xhp\">Villkor</link>"

#. from libreoffice:swriter-01
msgid "Define conditions for conditional styles here."
msgstr "Här kan du definiera villkoren för villkorliga formatmallar."

#. from libreoffice:swriter-01
msgid "Conditional styles are paragraph styles that have different properties depending on the context. Once defined, you cannot change the conditional properties of a conditional style."
msgstr "En villkorlig mall är en styckeformatmall som påverkar texten olika beroende på sammanhanget. När du definierar en ny mall kan du ange om den ska vara \"villkorlig\". Du kan inte ändra denna egenskap i efterhand. Däremot kan du ändra själva villkoren."

#. from libreoffice:swriter-01
msgid "$[officename] applies the paragraph properties of conditional styles as follows (the bold terms correspond to the titles of dialog fields): If a paragraph formatted with a conditional style is in a <emph>Context</emph> that has an <emph>Applied Style</emph> linked to it, then the <emph>Paragraph Style</emph> from that condition is used. If no style is linked to the <emph>Context</emph>, then the attributes defined in the conditional style apply. The following example illustrates this relationship:"
msgstr "När du tilldelar styckeegenskaperna i villkorliga mallar i $[officename] händer följande (termer i fetstil motsvarar namnen på fälten i dialogrutan). Om det stycke som har formaterats med en villkorlig mall står i ett <emph>sammanhang</emph> som är kopplat till en <emph>använd mall</emph>, används den <emph>styckeformatmall</emph> som hör till sammanhanget. Om ingen mall har kopplats till <emph>sammanhanget</emph>, gäller de attribut som är definierade i den villkorliga mallen. Följande exempel förtydligar det här sambandet:"

#. from libreoffice:swriter-01
msgid "Then click the <emph>Condition</emph> tab and select the <emph>Conditional style</emph> field to define the new Paragraph Style as a conditional style."
msgstr "Gå sedan till fliken <emph>Villkor</emph> och markera fältet <emph>som villkorlig mall</emph>. På det sättet definierar Du den nya styckeformatmallen som villkorlig mall."

#. from libreoffice:swriter-01
msgid "In <emph>Context</emph>, select the header entry and under <emph>Paragraph Styles</emph> select the style for the header in your business letter; for example, the default Paragraph Style \"Header\". You also can select your own style."
msgstr "Välj posten Sidhuvud under <emph>Sammanhang</emph>, och välj den mall som ska gälla för sidhuvudena i affärsbrevet, t ex den fördefinierade styckeformatmallen \"Sidhuvud\" i listrutan <emph>Styckeformatmallar</emph>. (Naturligtvis kan Du här välja en mall som Du själv har definierat.)"

#. from libreoffice:swriter-01
msgid "You can apply the Paragraph Style to the context by double-clicking the selected entry in the <emph>Paragraph Styles</emph> list box or by using <emph>Apply</emph>."
msgstr "När du dubbelklickar på den valda posten i listrutan <emph>Styckeformatmallar</emph> eller väljer <emph>Tilldela</emph> så används styckeformatmallen i det nya sammanhanget."

#. from libreoffice:swriter-01
msgid "Click <emph>OK</emph> to close the Paragraph Style dialog, and then format all paragraphs in your business letter, including the header, with the new \"Business letter\" conditional Paragraph Style. (When you click in the header, you may need to display <item type=\"literal\">All Styles</item> or <item type=\"literal\">Custom Styles</item> in the style list to use the new business letter style.)"
msgstr "Stäng nu dialogrutan för styckeformatmallar med <emph>OK</emph> och formatera alla stycken i affärsbrevet inklusive sidhuvudet med den nya, villkorliga styckeformatmallen \"Affärsbrev\". (När Du klickar i sidhuvudet kan Du i förekommande fall behöva ta fram alla mallar eller användarmallar i Stylist för att kunna använda den nya mallen \"Affärsbrev\".)"

#. from libreoffice:swriter-01
msgid "The header text now has the attributes you specified in the Header Paragraph Style, while the other parts of the document have the attributes defined in the business letter conditional Paragraph Style."
msgstr "Du ser nu att texten i sidhuvudet har de attribut som har definierats i styckeformatmallen \"Sidhuvud\" (om det var den Du använde), medan alla andra delar av dokumentet har de attribut som Du definierade i den (villkorliga) styckeformatmallen \"Affärsbrev\"."

#. from libreoffice:swriter-01
msgid "The Paragraph Style applied to the context is used when exporting to other formats (RTF, HTML, and so on)."
msgstr "När Du exporterar till ett annat format (RTF, HTML osv) skrivs den styckeformatmall som har tilldelats sammanhanget."

#. from libreoffice:swriter-01
msgid "Conditional style"
msgstr "som villkorlig mall"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/conditionpage/condstyle\">Check this box to define a new style as a conditional style.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/conditionpage/condstyle\">Markera den här rutan för att definiera en ny formatmall som villkorlig mall.</ahelp>"

#. from libreoffice:swriter-01
msgid "Here you can see the list of all Paragraph Styles applied to a context."
msgstr "Här visas en lista över alla styckeformatmallar som har tilldelats ett visst sammanhang."

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/conditionpage/styles\">A list of all Paragraph Styles which can be assigned to a context is contained in the list box.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/conditionpage/styles\">I listrutan finns en lista över alla styckeformatmallar som kan användas till en kontext.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/conditionpage/remove\">Click here to remove the current context assigned to the selected style.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/conditionpage/remove\">Klicka här för att ta bort aktuell kontext som tilldelats den valda formatmallen.</ahelp>"

#. from libreoffice:swriter-01
msgid "<bookmark_value>AutoCorrect function;text documents</bookmark_value>"
msgstr "<bookmark_value>Autokorrigering, funktion;textdokument</bookmark_value>"

#. from libreoffice:swriter-01
msgid "<link href=\"text/swriter/01/05150000.xhp\">AutoCorrect</link>"
msgstr "<link href=\"text/swriter/01/05150000.xhp\">Autokorrigering</link>"

#. from libreoffice:swriter-01
msgid "Automatically formats the file according to the options that you set under <link href=\"text/shared/01/06040000.xhp\"><emph>Tools - AutoCorrect - AutoCorrect Options</emph></link>."
msgstr "Formaterar filen automatiskt enligt de inställningar du har gjort under <link href=\"text/shared/01/06040000.xhp\"><emph>Verktyg – Autokorrigering</emph>            <emph>Alternativ</emph></link>."

#. from libreoffice:swriter-01
msgid "<link href=\"text/shared/01/06040000.xhp\">AutoCorrect Options</link>"
msgstr "<link href=\"text/shared/01/06040000.xhp\">Alternativ för autokorrigering</link>"

#. from libreoffice:swriter-01
msgid "Opens the AutoCorrect dialog."
msgstr "Öppnar dialogrutan Autokorrigering."

#. from libreoffice:swriter-01
msgid "You can use AutoCorrect to format text documents and plain ASCII text files, but not characters that you have manually formatted. Automatic <link href=\"text/shared/01/06040100.xhp\">word completion</link> only occurs after you type a word for the second time in a document."
msgstr "Du kan använda Autokorrigering för att formatera textdokument och vanliga ASCII-textfiler, men inte tecken som du har formaterat manuellt. Automatisk <link href=\"text/shared/01/06040100.xhp\">ordkomplettering</link> sker endast när du har skrivit ett ord för andra gången i ett dokument."

#. from libreoffice:swriter-01
msgid "To reverse the last AutoCorrect action, choose <emph>Edit - </emph><link href=\"text/shared/01/02010000.xhp\"><emph>Undo</emph></link>."
msgstr "Om du vill ångra den senaste automatiska korrigeringen väljer du <emph>Redigera - </emph><link href=\"text/shared/01/02010000.xhp\"><emph>Ångra</emph></link>."

#. from libreoffice:swriter-01
msgid "<link href=\"text/swriter/01/05150200.xhp\">Other AutoCorrect rules</link>"
msgstr "<link href=\"text/swriter/01/05150200.xhp\">Ytterligare regler för Autoformat</link>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"cui/ui/percentdialog/PercentDialog\">Enter the minimum length for combining single-lined paragraphs as a percentage of the page width.</ahelp>"
msgstr "<ahelp hid=\"cui/ui/percentdialog/PercentDialog\">Ange minimilängden för att enradiga stycken ska kombineras, uttryckt som en procentuell andel av sidbredden.</ahelp>"

#. from libreoffice:swriter-01
msgid "<link href=\"text/swriter/01/05150200.xhp\">Apply</link>"
msgstr "<link href=\"text/swriter/01/05150200.xhp\">Använd</link>"

#. from libreoffice:swriter-01
msgid "AutoCorrect for Bullets / Numbering"
msgstr "Autokorrigering för punktuppställning/numrering"

#. from libreoffice:swriter-01
msgid "To create a bulleted list, type a hyphen (-), star (*), or plus sign (+), followed by a space or tab at the beginning of a paragraph."
msgstr "Om du vill skapa en punktlista skriver du ett minustecken (-), en stjärna (*) eller ett plustecken (+) följt av ett mellanslag eller tabbtecken i början av stycket."

#. from libreoffice:swriter-01
msgid "To create a numbered list, type a number followed by a period (.), followed by a space or tab at the beginning of a paragraph."
msgstr "Du kan skapa en numrerad lista genom att skriva en siffra följt av en punkt (.), följt av ett mellanslag eller tabbtecken i början av stycket."

#. from libreoffice:swriter-01
msgid "Apply and Edit Changes"
msgstr "Använd och redigera ändringar"

#. from libreoffice:swriter-01
msgid "<link href=\"text/swriter/01/05150300.xhp\">Apply and Edit Changes</link>"
msgstr "<link href=\"text/swriter/01/05150300.xhp\">Använd och redigera ändringar</link>"

#. from libreoffice:swriter-01
msgid "Edit Changes"
msgstr "Redigera ändringar"

#. from libreoffice:swriter-01
msgid "Load Styles"
msgstr "Läs in formatmallar"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"sfx/ui/loadtemplatedialog/categories\">Lists the available template categories. Click a category to view its contents in the <emph>Templates </emph>list.</ahelp>"
msgstr "<ahelp hid=\"sfx/ui/loadtemplatedialog/categories\">Visar de tillgängliga mallkategorierna. Klicka på en kategori för att visa kategorins innehåll i listan <emph>Dokumentmallar</emph>.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"sfx/ui/loadtemplatedialog/templates\">Lists the available templates for the selected category.</ahelp>"
msgstr "<ahelp hid=\"sfx/ui/loadtemplatedialog/templates\">Visar de mallar som finns i den markerade kategorin.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"sfx/ui/loadtemplatedialog/text\">Loads the paragraph and the character styles from the selected document into the current document.</ahelp>"
msgstr "<ahelp hid=\"sfx/ui/loadtemplatedialog/text\">Läser in stycke- och teckenformatmallar från det markerade dokumentet till det aktuella dokumentet.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"sfx/ui/loadtemplatedialog/frame\">Loads the frame styles from the selected document into the current document.</ahelp>"
msgstr "<ahelp hid=\"sfx/ui/loadtemplatedialog/frame\">Läser in ramformatmallar från det markerade dokumentet till det aktuella dokumentet.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"sfx/ui/loadtemplatedialog/pages\">Loads the page styles from the selected document into the current document.</ahelp>"
msgstr "<ahelp hid=\"sfx/ui/loadtemplatedialog/pages\">Läser in sidformatmallar från det markerade dokumentet till det aktuella dokumentet.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"sfx/ui/loadtemplatedialog/numbering\">Loads the numbering styles from the selected document into the current document.</ahelp>"
msgstr "<ahelp hid=\"sfx/ui/loadtemplatedialog/numbering\">Läser in numreringsformatmallar från det markerade dokumentet till det aktuella dokumentet.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"sfx/ui/loadtemplatedialog/fromfile\">Locate the file containing the styles that you want to load, and then click <emph>Open</emph>.</ahelp>"
msgstr "<ahelp hid=\"sfx/ui/loadtemplatedialog/fromfile\">Leta rätt på filen med de formatmallar som ska läggas till och klicka på <emph>Öppna</emph>.</ahelp>"

#. from libreoffice:swriter-01
msgid "<bookmark_value>tables; splitting</bookmark_value><bookmark_value>splitting tables; at cursor position</bookmark_value><bookmark_value>dividing tables</bookmark_value>"
msgstr "<bookmark_value>Tabeller; dela</bookmark_value><bookmark_value>Dela tabeller; vid markören</bookmark_value><bookmark_value>Dela tabeller</bookmark_value>"

#. from libreoffice:swriter-01
msgid "<link href=\"text/swriter/01/05190000.xhp\">Split Table</link>"
msgstr "<link href=\"text/swriter/01/05190000.xhp\">Dela tabell</link>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".uno:SplitTable\">Splits the current table into two separate tables at the cursor position.</ahelp> You can also access this command by right-clicking in a table cell."
msgstr "<ahelp hid=\".uno:SplitTable\">Delar upp den aktuella tabellen i två separata tabeller vid markörens position.</ahelp> Du kan också komma åt det här kommandot genom att högerklicka i en tabellcell."

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/splittable/copyheading\">Includes the first row of the original table as the first row of the second table.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/splittable/copyheading\">Tar med den första raden i den ursprungliga tabellen som första rad i den andra tabellen.</ahelp>"

#. from libreoffice:swriter-01
msgid "Custom heading (apply style)"
msgstr "Egen rubrik (använd formatmall)"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/splittable/customheadingapplystyle\">Inserts a blank header row in the second table that is formatted with the style of the first row in the original table.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/splittable/customheadingapplystyle\">Infogar en tom rubrikrad i den andra tabellen, som är formaterad med formatmallen i ursprungstabellens första rad.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/splittable/customheading\">Inserts an additional blank row in the second table.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/splittable/customheading\">Infogar en tom extrarad i den andra tabellen.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/splittable/noheading\">Splits the table without copying the header row.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/splittable/noheading\">Delar tabellen utan att kopiera rubrikraden.</ahelp>"

#. from libreoffice:swriter-01
msgid "When you split a table that contains formulas, the formulas may be affected."
msgstr "När du delar upp en tabell som innehåller formler kan formlerna påverkas."

#. from libreoffice:swriter-01
msgid "<bookmark_value>tables; merging</bookmark_value><bookmark_value>merging; tables</bookmark_value>"
msgstr "<bookmark_value>Tabeller; sammanfoga</bookmark_value><bookmark_value>Sammanfoga; tabeller</bookmark_value>"

#. from libreoffice:swriter-01
msgid "<link href=\"text/swriter/01/05200000.xhp\">Merge Table</link>"
msgstr "<link href=\"text/swriter/01/05200000.xhp\">Sammanfoga tabell</link>"

#. from libreoffice:swriter-01
msgid "If you choose this command when the cursor is in the middle of three consecutive tables, you are prompted to select the table that you want to merge with."
msgstr "Om du väljer det här kommandot när markören befinner sig mitt i tre tabeller under/intill varandra, uppmanas du att välja vilken tabell som sammanfogningen ska göras med."

#. from libreoffice:swriter-01
msgid "<link href=\"text/swriter/01/06040000.xhp\">Word Count</link>"
msgstr "<link href=\"text/swriter/01/06040000.xhp\">Antal ord</link>"

#. from libreoffice:swriter-01
msgid "Untitled 1 - 9"
msgstr "Namnlös 1 - 9"

#. from libreoffice:swriter-01
msgid "<link href=\"text/swriter/01/06060100.xhp\">Numbering</link>"
msgstr "<link href=\"text/swriter/01/06060100.xhp\">Numrering</link>"

#. from libreoffice:swriter-01
msgid "<emph>Selection</emph>"
msgstr "<emph>Urval</emph>"

#. from libreoffice:swriter-01
msgid "<emph>Description</emph>"
msgstr "<emph>Funktion</emph>"

#. from libreoffice:swriter-01
msgid "Roman numerals (upper)"
msgstr "Versala romerska siffror"

#. from libreoffice:swriter-01
msgid "Roman numerals (lower)"
msgstr "Gemena romerska siffror"

#. from libreoffice:swriter-01
msgid "No numbering symbol. Only the character or symbol defined in the <emph>Separator</emph> fields appears at the beginning of the numbered line."
msgstr "Inga numreringstecken. Endast de tecken som har definierats som <emph>skiljetecken</emph> visas vid radens början."

#. from libreoffice:swriter-01
msgid "Show sublevels"
msgstr "Visa undernivåer"

#. from libreoffice:swriter-01
msgid "Footnotes/Endnotes Settings"
msgstr "Inställningar för fot-/slutnoter"

#. from libreoffice:swriter-01
msgid "<link href=\"text/swriter/01/06080000.xhp\">Footnotes/Endnotes Settings</link>"
msgstr "<link href=\"text/swriter/01/06080000.xhp\">Inställningar för fot-/slutnoter</link>"

#. from libreoffice:swriter-01
msgid "<variable id=\"fnoten\"><ahelp hid=\".uno:FootnoteDialog\">Specifies the display settings for footnotes and endnotes.</ahelp></variable>"
msgstr "<variable id=\"fnoten\"><ahelp hid=\".uno:FootnoteDialog\">Anger visningsalternativ för fotnoter och slutnoter.</ahelp></variable>"

#. from libreoffice:swriter-01
msgid "Arabic numerals"
msgstr "Arabiska siffror"

#. from libreoffice:swriter-01
msgid "Roman numerals (upper case)"
msgstr "Stora romerska siffror"

#. from libreoffice:swriter-01
msgid "Roman numerals (lower case)"
msgstr "Små romerska siffror"

#. from libreoffice:swriter-01
msgid "Counting"
msgstr "Räkning"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/footnotepage/countinglb\">Select the numbering option for the footnotes.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/footnotepage/countinglb\">Ange numreringsstil för fotnoter.</ahelp>"

#. from libreoffice:swriter-01
msgid "Option"
msgstr "<emph>Alternativ</emph>"

#. from libreoffice:swriter-01
msgid "Restarts the numbering of footnotes at the top of each page. This option is only available if the <emph>End of page </emph>check box is selected in the <emph>Position </emph>area."
msgstr "Börjar om numreringen av fotnoter högst upp på varje sida. Det här alternativet är endast tillgängligt om alternativrutan <emph>Sidslut</emph> är markerad under <emph>Placering</emph>."

#. from libreoffice:swriter-01
msgid "Restarts the numbering of footnotes at the beginning of each chapter."
msgstr "Börjar om numreringen av fotnoter i början av varje kapitel."

#. from libreoffice:swriter-01
msgid "Numbers the footnotes in the document sequentially."
msgstr "Numrerar fotnoterna i dokumentet sekventiellt."

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/footnotepage/prefix\">Enter the text that you want to display in front of the footnote number in the note text.</ahelp> For example, type \"To \" to display \"To 1\"."
msgstr "<ahelp hid=\"modules/swriter/ui/footnotepage/prefix\">Ange den text som ska skrivas framför fotnotens siffra i fotnotstexten.</ahelp> Om du till exempel vill visa \"Not 1\" skriver du \"Not\"."

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/footnotepage/suffix\">Enter the text that you want to display after the footnote number in the note text.</ahelp> For example, type \")\" to display \"1)\"."
msgstr "<ahelp hid=\"modules/swriter/ui/footnotepage/suffix\">Ange den text som ska skrivas efter fotnotens siffra i fotnotstexten.</ahelp> Skriv \")\" om du vill visa \"1)\"."

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/footnotepage/offsetnf\">Enter the number for the first footnote in the document. This option is only available if you selected \"Per Document\" in the <emph>Counting </emph>box.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/footnotepage/offsetnf\">Ange ordningstalet för den första fotnoten i dokumentet. Det här alternativet är bara tillgängligt om du väljer \"Per dokument\" i rutan <emph>Räknar</emph>.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/footnotepage/pospagecb\">Displays footnotes at the bottom of the page.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/footnotepage/pospagecb\">Visar fotnoter längst ned på sidan.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/footnotepage/posdoccb\">Displays footnotes at the end of the document as endnotes.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/footnotepage/posdoccb\">Visar fotnoter i slutet av dokumentet som slutnoter.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/footnotepage/pagestylelb\">Select the page style that you want to use for footnotes.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/footnotepage/pagestylelb\">Välj den sidformatmall som ska användas av fotnoterna.</ahelp>"

#. from libreoffice:swriter-01
msgid "This option is only available if the <emph>End of Document</emph> check box is selected in the <emph>Position</emph> area."
msgstr "Det här alternativet är endast tillgängligt om alternativrutan <emph>Dokumentslut</emph> är markerad under <emph>Placering</emph>."

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/footnotepage/charanchorstylelb\">Select the character style that you want to use for footnote anchors in the text area of your document.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/footnotepage/charanchorstylelb\">Välj det teckenformat som du vill använda för fotnotstecknen i textområdet i dokumentet.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/footnotepage/charstylelb\">Select the character style that you want to use for the footnote numbers in the footnote area.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/footnotepage/charstylelb\">Välj det teckenformat som du vill använda för fotnotsiffrorna i fotnotsområdet.</ahelp>"

#. from libreoffice:swriter-01
msgid "Continuation notice"
msgstr "Hänvisningstext för flersidiga fotnoter"

#. from libreoffice:swriter-01
msgid "End of Footnote"
msgstr "Vid slutet av fotnoten"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/footnotepage/conted\">Enter the text that you want to display when the footnotes are continued on the next page, for example, \"Continued on Page \". $[officename] Writer automatically inserts the number of the following page. </ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/footnotepage/conted\">Ange den text som ska visas om fotnoterna fortsätter på nästa sida, till exempel \"Fortsätter på sida \". $[officename] Writer infogar automatiskt sidnumret för nästa sida. </ahelp>"

#. from libreoffice:swriter-01
msgid "Start of next page"
msgstr "På följande sida"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/footnotepage/contfromed\">Enter the text that you want to display on the page where the footnotes are continued, for example, \"Continued from Page \". $[officename] Writer automatically inserts the number of the previous page.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/footnotepage/contfromed\">Ange den text som ska visas om fotnoterna fortsätter från föregående sida, till exempel \"Fortsättning från sida \". $[officename] infogar automatiskt sidnumret från föregående sida.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/endnotepage/EndnotePage\">Specifies the formatting for endnotes.</ahelp> The type of endnote numbering and the Styles to apply are the options available."
msgstr "<ahelp hid=\"modules/swriter/ui/endnotepage/EndnotePage\">Anger formatering för slutnoter.</ahelp> Här väljer du typ av numrering för slutnoterna och vilka formatmallar som ska användas."

#. from libreoffice:swriter-01
msgid "AutoNumbering"
msgstr "Automatisk numrering"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/endnotepage/offsetnf\">Enter the number for the first endnote in the document.</ahelp> This is useful if want the endnote numbering to span more than one document."
msgstr "<ahelp hid=\"modules/swriter/ui/endnotepage/offsetnf\">Ange numret för den första slutnoten i dokumentet.</ahelp> Det här är användbart om du vill att slutnotsnumreringen ska sträcka sig över mer än ett dokument."

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/endnotepage/prefix\">Enter the text that you want to display in front of the endnote number in the note text.</ahelp> For example, type \"re: \" to display \"re: 1\"."
msgstr "<ahelp hid=\"modules/swriter/ui/endnotepage/prefix\">Ange den text som ska visas framför slutnotsnumret.</ahelp> Du kan t.ex. skriva \"till \" om du vill visa \"till 1\"."

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/endnotepage/suffix\">Enter the text that you want to display after the endnote number in the note text.</ahelp> For example, type \")\" to display \"1)\"."
msgstr "<ahelp hid=\"modules/swriter/ui/endnotepage/suffix\">Ange den text som ska visas efter slutnotsnumret.</ahelp> Skriv till exempel \")\" om du vill visa \"1)\"."

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/endnotepage/pagestylelb\">Select the page style that you want to use for endnotes.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/endnotepage/pagestylelb\">Välj vilken sidformatmall som du vill att slutnoterna ska använda.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/endnotepage/charanchorstylelb\">Select the character style that you want to use for endnote anchors in the text area of your document.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/endnotepage/charanchorstylelb\">Välj den teckenformatmall som du vill använda på slutnotsankare i dokumentets textområde.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/endnotepage/charstylelb\">Select the character style that you want to use for the endnote numbers in the endnote area.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/endnotepage/charstylelb\">Välj den teckenformatmall som du vill använda på slutnotsnummer i slutnotsområdet.</ahelp>"

#. from libreoffice:swriter-01
msgid "<bookmark_value>converting; text, into tables</bookmark_value><bookmark_value>text; converting to tables</bookmark_value><bookmark_value>tables; converting to text</bookmark_value>"
msgstr "<bookmark_value>Konvertera; text, till tabeller</bookmark_value><bookmark_value>Text; konvertera till tabeller</bookmark_value><bookmark_value>Tabeller; konvertera till text</bookmark_value>"

#. from libreoffice:swriter-01
msgid "<link href=\"text/swriter/01/06090000.xhp\">Convert Text to Table</link>"
msgstr "<link href=\"text/swriter/01/06090000.xhp\">Omvandla text till tabell</link>"

#. from libreoffice:swriter-01
msgid "<variable id=\"texttab\"><ahelp hid=\".uno:ConvertTableText\">Converts the selected text into a table, or the selected table into text.</ahelp></variable>"
msgstr "<variable id=\"texttab\"><ahelp hid=\".uno:ConvertTableText\">Konverterar den markerade texten till en tabell eller den markerade tabellen till text.</ahelp></variable>"

#. from libreoffice:swriter-01
msgid "The options available in this dialog depending on the type of conversion."
msgstr "Vilka alternativ som finns tillgängliga i dialogrutan beror på vilken typ av konvertering du gör."

#. from libreoffice:swriter-01
msgid "Separate text at"
msgstr "Skiljetecken i text"

#. from libreoffice:swriter-01
msgid "A separator, such as a tab, marks the column boundaries in the selected text. Each paragraph in the selection is converted into a row in the table. Similarly, when you convert a table into text, the column markers are changed to the character that you specify, and each row is converted into a separate paragraph."
msgstr "En avgränsare, t.ex. ett tabbtecken, markerar kolumngränserna i den markerade texten. Varje stycke i markeringen konverteras till en rad i tabellen. När du ska konvertera en tabell till text ändras kolumnmarkörerna till det tecken du anger, och varje rad konverteras till ett eget stycke."

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/converttexttable/tabs\">Converts the text to a table using tabs as column markers.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/converttexttable/tabs\">Konvertera text till tabell genom att betrakta tabulatortecken som kolumnmarkörer.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/converttexttable/semicolons\">Converts the text to a table using semi-colons (;) as column markers.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/converttexttable/semicolons\">Konverterar text till tabell genom att betrakta semikolon (;) som kolumnmarkörer.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/converttexttable/paragraph\">Converts the text to a table using paragraphs as column markers.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/converttexttable/paragraph\">Konverterar text till tabell genom att betrakta stycken som kolumnmarkörer.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/converttexttable/other\">Converts the text to a table using the character that you type in the box as a column marker.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/converttexttable/other\">Konverterar text till tabell genom att betrakta det tecken som du skriver in i rutan som kolumnmarkör.</ahelp>"

#. from libreoffice:swriter-01
msgid "Text box"
msgstr "Textfält"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/converttexttable/othered\">Type the character that you want to use as a column marker.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/converttexttable/othered\">Skriv in det tecken som du vill använda för som kolumnmarkör.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/converttexttable/keepcolumn\">Creates columns of equal width, regardless of the position of the column marker.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/converttexttable/keepcolumn\">Skapar jämnbreda kolumner, oavsett placering av kolumnmarkör.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".\">Opens the <emph>AutoFormat</emph> dialog, where you can select a predefined layout for table.</ahelp>"
msgstr "<ahelp hid=\".\">Öppnar dialogrutan <emph>Autoformat</emph> där du kan välja en fördefinierad layout för tabellen.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/converttexttable/headingcb\">Formats the first row of the new table as a heading.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/converttexttable/headingcb\">Formaterar första raden av tabellen som tabellrubrik.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/converttexttable/repeatheading\">Repeats the table header on each page that the table spans.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/converttexttable/repeatheading\">Upprepar tabellrubriker på varje ny sida som tabellen sträcker sig över.</ahelp>"

#. from libreoffice:swriter-01
msgid "The first ... rows"
msgstr "De första ... raderna"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".\">Repeats the first n rows as a header.</ahelp>"
msgstr "<ahelp hid=\".\">Upprepar det första antalet rader som en rubrik.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/converttexttable/dontsplitcb\">Does not divide the table across pages.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/converttexttable/dontsplitcb\">Dela inte tabellen vid sidbrytningar.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/converttexttable/bordercb\">Adds a border to the table and the table cells.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/converttexttable/bordercb\">Lägger till tabellinramningar till tabellen och dess celler.</ahelp>"

#. from libreoffice:swriter-01
msgid "<variable id=\"sort\"><ahelp hid=\".uno:SortDialog\">Sorts the selected paragraphs or table rows alphabetically or numerically.</ahelp> You can define up to three sort keys as well as combine alphanumeric and numeric sort keys.</variable>"
msgstr "<variable id=\"sort\"><ahelp hid=\".uno:SortDialog\">Sortera de valda styckena eller tabellraderna alfabetiskt eller numeriskt.</ahelp> Du kan definiera upp till tre olika sorteringsnycklar och kombinera alfanumeriska och numeriska sorteringsnycklar.</variable>"

#. from libreoffice:swriter-01
msgid "Sort criteria"
msgstr "Regel"

#. from libreoffice:swriter-01
msgid "Keys 1 to 3"
msgstr "Nyckel 1 - 3"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/sortdialog/key3\">Specifies additional sorting criteria. You can also combine sort keys.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/sortdialog/key3\">Anger övriga sorteringskriterier. Du kan också kombinera sorteringsnycklar.</ahelp>"

#. from libreoffice:swriter-01
msgid "Column 1 to 3"
msgstr "Kolumn 1 - 3"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/sortdialog/colsb3\">Enter the number of the table column that you want to use as a basis for sorting.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/sortdialog/colsb3\">Ange hur många tabellkolumner som ska användas vid sorteringen.</ahelp>"

#. from libreoffice:swriter-01
msgid "Key type 1 to 3"
msgstr "Nyckeltyp 1 - 3"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/sortdialog/typelb3\">Select the sorting option that you want to use.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/sortdialog/typelb3\">Välj de sorteringsalternativ som du vill använda.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/sortdialog/up3\">Sorts in ascending order, (for example, 1, 2, 3 or a, b, c).</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/sortdialog/up3\">Sorterar i stigande ordning (t.ex. 1, 2, 3 eller a, b, c).</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/sortdialog/down3\">Sorts in descending order (for example, 9, 8, 7 or z, y, x).</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/sortdialog/down3\">Sorterar i fallande ordning (t.ex. 9, 8, 7 eller ö, ä, å).</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/sortdialog/columns\">Sorts the columns in the table according to the current sort options.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/sortdialog/columns\">Sorterar kolumnerna i tabellen enligt sorteringsinställningarna.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/sortdialog/rows\">Sorts the rows in the table or the paragraphs in the selection according to the current sort options.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/sortdialog/rows\">Sorterar raderna i tabellen eller de markerade styckena enligt sorteringsinställningarna.</ahelp>"

#. from libreoffice:swriter-01
msgid "Paragraphs are separated by nonprinting paragraph marks. You can also specify that tabs or a character act as separators when you sort paragraphs."
msgstr "Stycken avgränsas med stycketecken. Du kan också ange att en tabulator eller ett visst tecken ska fungera som avgränsare när du sorterar stycken."

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/sortdialog/tabs\">If the selected paragraphs correspond to a list separated by tabs, select this option.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/sortdialog/tabs\">Om de valda styckena motsvarar en tabbseparerad lista markerar du det här alternativet.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/sortdialog/separator\">Enter the character that you want to use as a separator in the selected area.</ahelp> By using the separator, $[officename] can determine the position of the sorting key in the selected paragraph."
msgstr "<ahelp hid=\"modules/swriter/ui/sortdialog/separator\">Ange det tecken som ska användas som skiljetecken i det markerade området.</ahelp> Med hjälp av skiljetecknet kan $[officename] bestämma sorteringsnyckelns placering i det markerade stycket."

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/sortdialog/delimpb\">Opens the <emph>Special Characters</emph> dialog, where you can select the character that you want to use as a separator.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/sortdialog/delimpb\">Öppnar dialogrutan <emph>Specialtecken</emph> som du kan använda för att välja det tecken som du vill använda som skiljetecken.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/sortdialog/langlb\">Select the language that defines the sorting rules.</ahelp> Some languages sort special characters differently than other languages."
msgstr "<ahelp hid=\"modules/swriter/ui/sortdialog/langlb\">Välj det språk som definierar sorteringsordningen.</ahelp> Sorteringsordningen skiljer sig åt mellan olika språk, t.ex. för bokstäverna å, ä och ö."

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/sortdialog/matchcase\">Distinguishes between uppercase and lowercase letters when you sort a table. For Asian languages special handling applies.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/sortdialog/matchcase\">Skiljer mellan små och stora bokstäver när en tabell sorteras. Asiatiska språk kräver särskild hantering.</ahelp>"

#. from libreoffice:swriter-01
msgid "For Asian languages, select <emph>Match case </emph>to apply multi-level collation. In the multi-level collation, the primitive forms of the entries are first compared with the cases of the forms and diacritics ignored. If the forms are the same, the diacritics of the forms are compared. If the forms are still the same, the cases, character widths, and Japanese Kana differences of the forms are compared."
msgstr "Välj <emph>Exakt sökning</emph> för asiatiska språk om du vill använda flernivåskollation. Vid flernivåskollation jämförs posternas grundform först med kasus för de former och diakritiska tecken som ignorerats. Om formerna är lika jämförs formernas diakritiska tecken. Om formerna fortfarande är lika jämförs formernas kasus, teckenbredd och japanska kana-skillnader."

#. from libreoffice:swriter-01
msgid "<link href=\"text/swriter/01/06110000.xhp\">Calculate</link>"
msgstr "<link href=\"text/swriter/01/06110000.xhp\">Beräkna</link>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".uno:CalculateSel\" visibility=\"visible\">Calculates the selected formula and copies the result to the clipboard.</ahelp>"
msgstr "<ahelp hid=\".uno:CalculateSel\" visibility=\"visible\">Beräknar den markerade formeln och kopierar resultatet till urklippet.</ahelp>"

#. from libreoffice:swriter-01
msgid "<link href=\"text/swriter/01/06120000.xhp\">Page Formatting</link>"
msgstr "<link href=\"text/swriter/01/06120000.xhp\">Sidformatering</link>"

#. from libreoffice:swriter-01
msgid "<ahelp visibility=\"visible\" hid=\".uno:Repaginate\">Updates the page formats in the document and recalculates the total number of pages that is displayed on the <emph>Status Bar</emph>.</ahelp>"
msgstr "<ahelp visibility=\"visible\" hid=\".uno:Repaginate\">Uppdaterar sidformaten i dokumentet och beräknar om antalet sidor som visas på <emph>statusraden</emph>.</ahelp>"

#. from libreoffice:swriter-01
msgid "In long documents, updating the page formatting can take a while."
msgstr "Om dokumentet är stort kan siduppdateringen ta ett tag."

#. from libreoffice:swriter-01
msgid "Current Index"
msgstr "Aktuell förteckning"

#. from libreoffice:swriter-01
msgid "<link href=\"text/swriter/01/06160000.xhp\">Current Index</link>"
msgstr "<link href=\"text/swriter/01/06160000.xhp\">Aktuell förteckning</link>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".uno:UpdateCurIndex\" visibility=\"visible\">Updates the current index.</ahelp> The current index is the one that contains the cursor."
msgstr "<ahelp hid=\".uno:UpdateCurIndex\" visibility=\"visible\">Uppdaterar den aktuella förteckningen.</ahelp> Den aktuella förteckningen är den som innehåller markören."

#. from libreoffice:swriter-01
msgid "You can also right-click in an index or table of contents, and then choose <emph>Update Index or Table of Contents</emph>. The following commands are also available in the context menu:"
msgstr "Du kan också högerklickar i ett sakregister eller en innehållsförteckning och välja <emph>Uppdatera förteckning</emph>. Följande kommandon finns också på snabbmenyn:"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".uno:EditCurIndex\" visibility=\"visible\">Edits the current index or table.</ahelp>"
msgstr "<ahelp hid=\".uno:EditCurIndex\" visibility=\"visible\">Redigerar den aktuella förteckningen.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".uno:RemoveTableOf\" visibility=\"visible\">Deletes the current index or table.</ahelp>"
msgstr "<ahelp hid=\".uno:RemoveTableOf\" visibility=\"visible\">Tar bort den aktuella förteckningen.</ahelp>"

#. from libreoffice:swriter-01
msgid "All Indexes and Tables"
msgstr "Alla förteckningar"

#. from libreoffice:swriter-01
msgid "<link href=\"text/swriter/01/06170000.xhp\">All Indexes and Tables</link>"
msgstr "<link href=\"text/swriter/01/06170000.xhp\">Alla förteckningar</link>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".uno:UpdateAllIndexes\" visibility=\"visible\">Update all indexes and tables of contents in the current document. You do not need to place the cursor in an index or table before you use this command.</ahelp>"
msgstr "<ahelp hid=\".uno:UpdateAllIndexes\" visibility=\"visible\">Uppdatera alla förteckningar i det aktuella dokumentet. Du behöver inte placera markören i en förteckning innan du använder det här kommandot.</ahelp>"

#. from libreoffice:swriter-01
msgid "Line numbers are not available in HTML format."
msgstr "Radnummerfunktionen är inte tillgänglig i HTML-format."

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/linenumbering/shownumbering\">Adds line numbers to the current document.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/linenumbering/shownumbering\">Lägger till radnummer i aktuellt dokument.</ahelp>"

#. from libreoffice:swriter-01
msgid "Set the properties of the line numbering."
msgstr "Ange radnumreringens egenskaper."

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/linenumbering/styledropdown\">Select the formatting style that you want to use for the line numbers.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/linenumbering/styledropdown\">Välj den teckenformatmall som radnumren ska använda.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/linenumbering/positiondropdown\">Select where you want the line numbers to appear.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/linenumbering/positiondropdown\">Ange var radnumreringen ska placeras.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/linenumbering/spacingspin\">Enter the amount of space that you want to leave between the line numbers and the text.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/linenumbering/spacingspin\">Ange hur stort avstånd som ska lämnas mellan radnummer och text.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/linenumbering/intervalspin\">Enter the counting interval for the line numbers.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/linenumbering/intervalspin\">Ange intervallet för hur ofta radnumren skrivs ut.</ahelp>"

#. from libreoffice:swriter-01
msgid "You can enter a separator character to display between line numbers if the counting interval is more than one."
msgstr "Du kan ange ett skiljetecken som ska visas mellan radnumren om intervallet är större än ett."

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/linenumbering/textentry\">Enter the text that you want to use as a separator.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/linenumbering/textentry\">Ange den text som du vill använda som skiljetecken.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/linenumbering/linesspin\">Enter the number of lines to leave between the separators.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/linenumbering/linesspin\">Ange antalet rader som lämnas mellan skiljetecknen.</ahelp>"

#. from libreoffice:swriter-01
msgid "Separators are only displayed in lines that are not numbered."
msgstr "Skiljetecken visas bara i rader och är inte numrerade."

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/linenumbering/blanklines\">Includes empty paragraphs in the line count.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/linenumbering/blanklines\">Räkna även tomma stycken.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\"modules/swriter/ui/linenumbering/restarteverynewpage\">Restarts line numbering at the top of each page in the document.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/linenumbering/restarteverynewpage\">Nollställer radnumreringen vid varje ny sida i dokumentet.</ahelp>"

#. from libreoffice:swriter-01
msgid "<link href=\"text/swriter/01/06190000.xhp\">Update All</link>"
msgstr "<link href=\"text/swriter/01/06190000.xhp\">Uppdatera allt</link>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".uno:UpdateAll\" visibility=\"visible\">Updates all links, fields, indexes, tables of contents, and page formatting in the current document.</ahelp>"
msgstr "<ahelp hid=\".uno:UpdateAll\" visibility=\"visible\">Uppdaterar alla länkar, fält, förteckningar och all sidformatering i det aktuella dokumentet.</ahelp>"

#. from libreoffice:swriter-01
msgid "<link href=\"text/swriter/01/06200000.xhp\">Fields</link>"
msgstr "<link href=\"text/swriter/01/06200000.xhp\">Fält</link>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".uno:UpdateFields\" visibility=\"visible\">Updates the contents of all fields in the current document.</ahelp>"
msgstr "<ahelp hid=\".uno:UpdateFields\" visibility=\"visible\">Uppdaterar innehållet i alla fältkommandon i det aktuella dokumentet.</ahelp>"

#. from libreoffice:swriter-01
msgid "<link href=\"text/swriter/01/06210000.xhp\">Links</link>"
msgstr "<link href=\"text/swriter/01/06210000.xhp\">Länkar</link>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".uno:UpdateAllLinks\" visibility=\"visible\">Updates the links in the current document.</ahelp>"
msgstr "<ahelp hid=\".uno:UpdateAllLinks\" visibility=\"visible\">Uppdaterar länkarna i det aktuella dokumentet.</ahelp>"

#. from libreoffice:swriter-01
msgid "All Charts"
msgstr "Alla diagram"

#. from libreoffice:swriter-01
msgid "<link href=\"text/swriter/01/06220000.xhp\">All Charts</link>"
msgstr "<link href=\"text/swriter/01/06220000.xhp\">Alla diagram</link>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".uno:UpdateCharts\" visibility=\"visible\">Updates the charts in the current document.</ahelp>"
msgstr "<ahelp hid=\".uno:UpdateCharts\" visibility=\"visible\">Uppdaterar diagrammen i det aktuella dokumentet.</ahelp>"

#. from libreoffice:swriter-01
msgid "<bookmark_value>updating; text documents</bookmark_value>"
msgstr "<bookmark_value>Uppdatera; textdokument</bookmark_value>"

#. from libreoffice:swriter-01
msgid "<link href=\"text/swriter/01/06990000.xhp\">Update</link>"
msgstr "<link href=\"text/swriter/01/06990000.xhp\">Uppdatera</link>"

#. from libreoffice:swriter-01
msgid "Updates items in the current document that have dynamic contents, so as fields and indexes."
msgstr "Uppdaterar objekt i det aktuella dokumentet som har dynamiskt innehåll, t.ex. fält och förteckningar."

#. from libreoffice:swriter-01
msgid "<link href=\"text/swriter/01/mailmerge00.xhp\">Mail Merge Wizard</link>"
msgstr "<link href=\"text/swriter/01/mailmerge00.xhp\">Guiden Kopplad utskrift</link>"

#. from libreoffice:swriter-01
msgid "<link href=\"text/swriter/01/01150000.xhp\">Configurable Mail Merge dialog</link>"
msgstr "<link href=\"text/swriter/01/01150000.xhp\">Dialogrutan Konfigurerbar Kopplad utskrift</link>"

#. from libreoffice:swriter-01
msgid "Use the current document"
msgstr "Använd aktuellt dokument"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".\">Uses the current Writer document as the base for the mail merge document.</ahelp>"
msgstr "<ahelp hid=\".\">Använder aktuellt Writer dokument som grund för det kopplade dokumentet.</ahelp>"

#. from libreoffice:swriter-01
msgid "Create a new document"
msgstr "Skapa ett nytt dokument"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".\">Creates a new Writer document to use for the mail merge.</ahelp>"
msgstr "<ahelp hid=\".\">Skapar ett nytt Writer dokument som ska användas vid en kopplad utskrift.</ahelp>"

#. from libreoffice:swriter-01
msgid "Start from existing document"
msgstr "Börja med befintligt dokument"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".\">Select an existing Writer document to use as the base for the mail merge document.</ahelp>"
msgstr "<ahelp hid=\".\">Välj ett befintligt Writer dokument som ska användas som grund för ett kopplat dokument.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".\">Locate the Writer document that you want to use, and then click <emph>Open</emph>.</ahelp>"
msgstr "<ahelp hid=\".\">Lokalisera det Writer-dokument som du vill använda, och klicka på <emph>Öppna</emph>.</ahelp>"

#. from libreoffice:swriter-01
msgid "Start from a template"
msgstr "Börja från mall"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".\">Select the template that you want to create your mail merge document with.</ahelp>"
msgstr "<ahelp hid=\".\">Markera den mall som du vill skapa det kopplade dokumentet med.</ahelp>"

#. from libreoffice:swriter-01
msgid "Start from a recently saved starting document"
msgstr "Börja med ett nyligen sparat startdokument"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".\">Use an existing mail merge document as the base for a new mail merge document.</ahelp>"
msgstr "<ahelp hid=\".\">Utgå från ett befintligt kopplat dokument när du skapar ett nytt.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".\">Select the document.</ahelp>"
msgstr "<ahelp hid=\".\">Markera dokumentet.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".\">Creates a printable mail merge document.</ahelp>"
msgstr "<ahelp hid=\".\">Skapar ett utskrivbart kopplat dokument.</ahelp>"

#. from libreoffice:swriter-01
msgid "Mail Merge Wizard - Addresses"
msgstr "Guiden Kopplad utskrift - Adresser"

#. from libreoffice:swriter-01
msgid "<link href=\"text/swriter/01/mailmerge03.xhp\">Mail Merge Wizard - Addresses</link>"
msgstr "<link href=\"text/swriter/01/mailmerge03.xhp\">Guiden Kopplad utskrift - Adresser</link>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".\">Opens the <link href=\"text/swriter/01/mm_seladdlis.xhp\">Select Address List</link> dialog, where you can choose a data source for the addresses, add new addresses, or type in a new address list.</ahelp>"
msgstr "<ahelp hid=\".\">Öppnar dialogrutan <link href=\"text/swriter/01/mm_seladdlis.xhp\">Välj adresslista</link> där du kan välja en datakälla för adresserna, lägga till nya adresser eller skriva en ny adresslista.</ahelp>"

#. from libreoffice:swriter-01
msgid "When you edit some records in a Calc spreadsheet data source that is currently in use for a mail merge, those changes are not visible in the mail merge."
msgstr "När du redigerar poster i en Calc-tabelldatakälla som för tillfället används för en kopplad utskrift, syns inte ändringarna i den kopplade utskriften."

#. from libreoffice:swriter-01
msgid "This document shall contain an address block"
msgstr "Det här dokumentet ska innehålla ett adressblock."

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".\">Adds an address block to the mail merge document.</ahelp>"
msgstr "<ahelp hid=\".\">Lägger till ett adressblock i det kopplade dokumentet.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".\">Select the address block layout that you want to use.</ahelp>"
msgstr "<ahelp hid=\".\">Markera den layout för adressblock som du vill använda.</ahelp>"

#. from libreoffice:swriter-01
msgid "Suppress lines with just empty fields"
msgstr "Ignorera rader med bara tomma fält"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".\">Enable to leave empty lines out of the address.</ahelp>"
msgstr "<ahelp hid=\".\">Aktivera om du inte vill ha med tomma rader i adressen.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".\">Opens the <link href=\"text/swriter/01/mm_seladdblo.xhp\">Select Address Block</link> dialog.</ahelp>"
msgstr "<ahelp hid=\".\">Öppnar dialogrutan <link href=\"text/swriter/01/mm_seladdblo.xhp\">Välj adressblock</link>.</ahelp>"

#. from libreoffice:swriter-01
msgid "Mail Merge Wizard - Greeting Line"
msgstr "Guiden Kopplad utskrift - Hälsningsrad"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".\">Adds a salutation.</ahelp>"
msgstr "<ahelp hid=\".\">Infogar en hälsningsfras.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".\">Adds a personalized salutation to the mail merge document. To use the default salutation, clear this check box.</ahelp>"
msgstr "<ahelp hid=\".\">Infogar en personanpassad hälsningsfras i en kopplad utskrift. Om du vill använda standardhälsningsfrasen avmarkerar du den här kryssrutan.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".\">Opens the <link href=\"text/swriter/01/mm_cusgrelin.xhp\">Custom Salutation</link> (Female recipient) dialog.</ahelp>"
msgstr "<ahelp hid=\".\">Öppnar dialogrutan <link href=\"text/swriter/01/mm_cusgrelin.xhp\">Anpassa hälsningsfras</link> (kvinnliga mottagare).</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".\">Opens the <link href=\"text/swriter/01/mm_cusgrelin.xhp\">Custom Salutation</link> (Male recipient) dialog.</ahelp>"
msgstr "<ahelp hid=\".\">Öppnar dialogrutan <link href=\"text/swriter/01/mm_cusgrelin.xhp\">Anpassa hälsningsfras</link> (manliga mottagare).</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".\">Select the default salutation that is used when you do not specify a personalized salutation.</ahelp>"
msgstr "<ahelp hid=\".\">Markera den standardhälsning som ska användas när du inte anger en egen.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".\">Displays a preview of the salutation.</ahelp>"
msgstr "<ahelp hid=\".\">Visar en förhandsvisning av hälsningsfrasen.</ahelp>"

#. from libreoffice:swriter-01
msgid "Match fields"
msgstr "Matcha fält"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".\">Opens the <link href=\"text/swriter/01/mm_matfie.xhp\">Match Fields</link> dialog.</ahelp>"
msgstr "<ahelp hid=\".\">Öppnar dialogrutan <link href=\"text/swriter/01/mm_matfie.xhp\">Matcha fält</link>.</ahelp>"

#. from libreoffice:swriter-01
msgid "(Browse buttons)"
msgstr "(Bläddringsknappar)"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".\">Use the browse buttons to preview the information from the previous or next data record.</ahelp>"
msgstr "<ahelp hid=\".\">Använd bläddringsknapparna när du vill förhandsgranska information från föregående eller nästa datapost.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".\">Enter the amount of space to leave between the top edge of the page and the top edge of the address block.</ahelp>"
msgstr "<ahelp hid=\".\">Ange hur mycket utrymme som ska finnas mellan sidans överkant och adressblockets överkant.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".\">Aligns the frame that contains the address block to the left page margin.</ahelp>"
msgstr "<ahelp hid=\".\">Justerar ramen som innehåller adressblock mot vänster sidmarginal.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".\">Enter the amount of space to leave between the left edge of the page and the left edge of the address block.</ahelp>"
msgstr "<ahelp hid=\".\">Ange hur mycket utrymme som ska finnas mellan sidans vänstra kant och adressblockets vänstra kant.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".\">Moves the salutation up.</ahelp>"
msgstr "<ahelp hid=\".\">Flyttar hälsningsfrasen uppåt.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".\">Moves the salutation down.</ahelp>"
msgstr "<ahelp hid=\".\">Flyttar hälsningsfrasen nedåt.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".\">Select a magnification for the print preview.</ahelp>"
msgstr "<ahelp hid=\".\">Välj en förstoring för förhandsgranskningen.</ahelp>"

#. from libreoffice:swriter-01
msgid "Use the commands in the context menu of the preview to move the view up and down."
msgstr "Använd kommandona på snabbmenyn i förhandsgranskningen när du vill flytta vyn uppåt och nedåt."

#. from libreoffice:swriter-01
msgid "Copies To"
msgstr "Kopior till"

#. from libreoffice:swriter-01
msgid "CC"
msgstr "Kopia"

#. from libreoffice:swriter-01
msgid "BCC"
msgstr "Blindkopia"

#. from libreoffice:swriter-01
msgid "Customizes the address list for <link href=\"text/swriter/01/mm_newaddlis.xhp\">mail merge</link> documents."
msgstr "Anpassar adresslistan för dokumenten i den <link href=\"text/swriter/01/mm_newaddlis.xhp\">kopplade utskriften</link>."

#. from libreoffice:swriter-01
msgid "Address list elements"
msgstr "Adresslisteelement"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".\">Select the fields that you want to move, delete, or rename.</ahelp>"
msgstr "<ahelp hid=\".\">Markera de fält som du vill flytta, radera eller byta namn på.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".\">Inserts a new text field.</ahelp>"
msgstr "<ahelp hid=\".\">Infogar ett nytt textfält.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".\">Deletes the selected field.</ahelp>"
msgstr "<ahelp hid=\".\">Tar bort det markerade fältet.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".\">Renames the selected text field.</ahelp>"
msgstr "<ahelp hid=\".\">Byter namn på det markerade textfältet.</ahelp>"

#. from libreoffice:swriter-01
msgid "Custom Salutation"
msgstr "Anpassa hälsningsfras"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".\">Select a field and drag the field to the other list.</ahelp>"
msgstr "<ahelp hid=\".\">Markera ett fält och dra det till den andra listan.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".\">Adds the selected field from the list of salutation elements to the other list. You can add a field more than once.</ahelp>"
msgstr "<ahelp hid=\".\">Lägger till markerade fält från listan över hälsningselement i den andra listan. Du kan lägga till samma fält flera gånger.</ahelp>"

#. from libreoffice:swriter-01
msgid "Drag salutation elements into the box below"
msgstr "Dra hälsningselementen till rutan nedanför."

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".\">Arrange the fields by drag-and-drop or use the arrow buttons.</ahelp>"
msgstr "<ahelp hid=\".\">Ordna fälten genom att dra och släppa eller med hjälp av pilknapparna.</ahelp>"

#. from libreoffice:swriter-01
msgid "Customize salutation"
msgstr "Anpassa hälsningsfras"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".\">Select a value from the list for the salutation and the punctuation mark fields.</ahelp>"
msgstr "<ahelp hid=\".\">Markera ett värde i listan för hälsningen och fälten för skiljetecken.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".\">Displays a preview of the first database record with the current salutation layout.</ahelp>"
msgstr "<ahelp hid=\".\">Visar en förhandsgranskning av den första databasposten med den aktuella hälsningslayouten.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".\">Select an item in the list and click an arrow button to move the item.</ahelp>"
msgstr "<ahelp hid=\".\">Markera en post i listan och klicka på en pilknapp om du vill flytta posten.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".\">Adds a personalized salutation. To use the default salutation, clear this check box.</ahelp>"
msgstr "<ahelp hid=\".\">Infogar en personanpassad hälsningsfras. Om du vill använda standardhälsningsfrasen avmarkerar du den här kryssrutan.</ahelp>"

#. from libreoffice:swriter-01
msgid "Female"
msgstr "Kvinna"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".\">Select the personalized greeting for a female recipient.</ahelp>"
msgstr "<ahelp hid=\".\">Markera den anpassade hälsningen för en kvinnlig mottagare.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".\">Opens the <link href=\"text/swriter/01/mm_cusgrelin.xhp\">Custom Salutation</link> dialog for a female recipient.</ahelp>"
msgstr "<ahelp hid=\".\">Öppnar dialogrutan <link href=\"text/swriter/01/mm_cusgrelin.xhp\">Anpassa hälsningsfras</link> för en kvinnlig mottagare.</ahelp>"

#. from libreoffice:swriter-01
msgid "Male"
msgstr "Man"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".\">Select the personalized greeting for a male recipient.</ahelp>"
msgstr "<ahelp hid=\".\">Markera den anpassade hälsningen för en manlig mottagare.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".\">Opens the <link href=\"text/swriter/01/mm_cusgrelin.xhp\">Custom Salutation</link> dialog for a male recipient.</ahelp>"
msgstr "<ahelp hid=\".\">Öppnar dialogrutan <link href=\"text/swriter/01/mm_cusgrelin.xhp\">Anpassa hälsningsfras</link> för en manlig mottagare.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".\">Select the field name of the address database field that contains the gender information.</ahelp>"
msgstr "<ahelp hid=\".\">Markera fältnamnet för adressdatabasfältet som innehåller information om kön.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".\">Select the field value that indicates the gender of the recipient.</ahelp>"
msgstr "<ahelp hid=\".\">Markera fältvärdet som anger mottagarens kön.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".\">Select the default greeting to use if a personalized salutation cannot be created.</ahelp>"
msgstr "<ahelp hid=\".\">Markera den standardhälsning som ska användas om en personlig hälsningsfras inte kan skapas.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".\">Enter the search term.</ahelp>"
msgstr "<ahelp hid=\".\">Ange sökvillkoret.</ahelp>"

#. from libreoffice:swriter-01
msgid "Find only in"
msgstr "Sök enbart i"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".\">Restricts the search to one data field. </ahelp>"
msgstr "<ahelp hid=\".\">Begränsar sökningen till ett datafält. </ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".\">Displays the next record that contains the search text.</ahelp>"
msgstr "<ahelp hid=\".\">Visar nästa post som innehåller söktexten.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".\">Displays a preview of the values of the first data record.</ahelp>"
msgstr "<ahelp hid=\".\">Visar en förhandsgranskning av värde för den första dataposten.</ahelp>"

#. from libreoffice:swriter-01
msgid "Specify the placement of address data fields in an address block in <link href=\"text/swriter/01/mm_seladdblo.xhp\">mail merge</link> documents."
msgstr "Ange placeringen av adressdatafälten i ett adressblock i de <link href=\"text/swriter/01/mm_seladdblo.xhp\">kopplade</link> dokumenten."

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".\">Select an address field and drag the field to the other list.</ahelp>"
msgstr "<ahelp hid=\".\">Markera ett adressfält och dra fältet till den andra listan.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".\">Adds the selected field from the Address Elements list to the other list.</ahelp> You can add the same field more than once."
msgstr "<ahelp hid=\".\">Lägger till markerade fält från listan Adresselement i den andra listan.</ahelp> Du kan lägga till samma fält flera gånger."

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".\">Removes the selected field from the other list.</ahelp>"
msgstr "<ahelp hid=\".\">Tar bort det markerade fältet från den andra listan.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".\">Arrange the fields with drag-and-drop or use the arrow buttons.</ahelp>"
msgstr "<ahelp hid=\".\">Ordna fälten genom att dra och släppa eller med hjälp av pilknapparna.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".\">Displays a preview of the first database record with the current address block layout.</ahelp>"
msgstr "<ahelp hid=\".\">Visar en förhandsgranskning av den första databasposten med den aktuella adressblockslayouten.</ahelp>"

#. from libreoffice:swriter-01
msgid "(Arrow Buttons)"
msgstr "(Pilknappar)"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".\">Select an item in the list and click an arrow button to move the entry.</ahelp>"
msgstr "<ahelp hid=\".\">Markera en post i listan och klicka på en pilknapp om du vill flytta posten.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".\">Enter or edit the field contents for each mail merge recipient.</ahelp>"
msgstr "<ahelp hid=\".\">Skriv eller redigera fältinnehållet för varje mottagare i den kopplade utskriften.</ahelp>"

#. from libreoffice:swriter-01
msgid "Show Entry Number"
msgstr "Visa postnummer"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".\">Click the buttons to navigate through the records or enter a record number to display a record.</ahelp>"
msgstr "<ahelp hid=\".\">Klicka på knapparna för att flytta genom posterna eller skriv ett postnummer om du vill visa en viss post.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".\">Adds a new blank record to the address list.</ahelp>"
msgstr "<ahelp hid=\".\">Lägger till en tom post i adresslistan.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".\">Deletes the selected record.</ahelp>"
msgstr "<ahelp hid=\".\">Tar bort den markerade posten.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".\">Opens the <link href=\"text/swriter/01/mm_finent.xhp\">Find Entry</link> dialog. You can leave the dialog open while you edit the entries.</ahelp>"
msgstr "<ahelp hid=\".\">Öppnar dialogrutan <link href=\"text/swriter/01/mm_finent.xhp\">Sök post</link>. Dialogrutan kan vara öppen medan du redigerar posterna.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".\">Opens the <link href=\"text/swriter/01/mm_cusaddlis.xhp\">Customize Address List</link> dialog where you can rearrange, rename, add, and delete fields.</ahelp>"
msgstr "<ahelp hid=\".\">Öppnar dialogrutan <link href=\"text/swriter/01/mm_cusaddlis.xhp\">Anpassa adresslista</link> där du kan ordna om, byta namn på, lägga till och radera fält.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".\">Select the block in the list that you want to use for mail merge addresses, and click <emph>OK</emph>.</ahelp>"
msgstr "<ahelp hid=\".\">Markera blocket i listan som du vill använda för adresser i kopplade utskrifter, och klicka på <emph>OK</emph>.</ahelp>"

#. from libreoffice:swriter-01
msgid "Never include country/region"
msgstr "Infoga aldrig land/region"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".\">Excludes country or regional information from the address block.</ahelp>"
msgstr "<ahelp hid=\".\">Utelämnar landsinformation från adressblocket.</ahelp>"

#. from libreoffice:swriter-01
msgid "Always include country/region"
msgstr "Infoga alltid land/region"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".\">Includes country or regional information in the address block.</ahelp>"
msgstr "<ahelp hid=\".\">Infogar landsinformation i adressblocket.</ahelp>"

#. from libreoffice:swriter-01
msgid "Only include country/region if it is not:"
msgstr "Infoga enbart land/region som inte är:"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".\">Only includes country or regional information in the address block if the value differs from the value that you enter in the text box.</ahelp>"
msgstr "<ahelp hid=\".\">Infogar landsinformation i adressblocket bara om värdet är något annat än värdet som du skriver i textrutan.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".\">Enter the country/region string that shall not be printed.</ahelp>"
msgstr "<ahelp hid=\".\">Ange den landssträng som inte ska skrivas ut.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".\">Opens the <link href=\"text/swriter/01/mm_newaddblo.xhp\">New Address Block</link> dialog where you can define a new address block layout.</ahelp>"
msgstr "<ahelp hid=\".\">Öppnar dialogrutan <link href=\"text/swriter/01/mm_newaddblo.xhp\">Nytt adressblock</link> där du kan definiera en ny adressblockslayout.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".\">Deletes the selected address block layout.</ahelp>"
msgstr "<ahelp hid=\".\">Tar bort den markerade adressblockslayouten.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".\">Select the database file that contains the addresses that you want to use as an address list.</ahelp> If the file contains more than one table, the <link href=\"text/swriter/01/mm_seltab.xhp\">Select Table</link> dialog opens."
msgstr "<ahelp hid=\".\">Markera databasfilen som innehåller de adresser som du vill använda som adresslista.</ahelp> Om filen innehåller fler än en tabell öppnas dialogrutan <link href=\"text/swriter/01/mm_seltab.xhp\">Markera tabell</link>."

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".\">Opens the <link href=\"text/swriter/01/mm_newaddlis.xhp\">New Address List</link> dialog, where you can create a new address list.</ahelp>"
msgstr "<ahelp hid=\".\">Öppnar dialogrutan <link href=\"text/swriter/01/mm_newaddlis.xhp\">Ny adresslista</link> där du kan skapa en ny adresslista.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".\">Opens the <link href=\"text/shared/02/12090100.xhp\">Standard Filter</link> dialog , where you can apply filters to the address list to display the recipients that you want to see.</ahelp>"
msgstr "<ahelp hid=\".\">Öppnar dialogrutan <link href=\"text/shared/02/12090100.xhp\">Standardfilter</link> där du kan tillämpa filter på adresslistan om du vill visa speciella mottagare.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".\">Opens the <link href=\"text/swriter/01/mm_newaddlis.xhp\">New Address List</link> dialog, where you can edit the selected address list.</ahelp>"
msgstr "<ahelp hid=\".\">Öppnar dialogrutan <link href=\"text/swriter/01/mm_newaddlis.xhp\">Ny adresslista</link> där du kan redigera den markerade adresslistan.</ahelp>"

#. from libreoffice:swriter-01
msgid "Change Table"
msgstr "Ändra tabell"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".\">Opens the <link href=\"text/swriter/01/mm_seltab.xhp\">Select Table</link> dialog, where you can select another table to use for mail merge.</ahelp>"
msgstr "<ahelp hid=\".\">Öppnar dialogrutan <link href=\"text/swriter/01/mm_seltab.xhp\">Markera tabell</link> där du kan välja en annan tabell för den kopplade utskriften.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".\">Select the table that you want to use for <link href=\"text/swriter/01/mm_seladdlis.xhp\">mail merge</link> addresses.</ahelp>"
msgstr "<ahelp hid=\".\">Markera den tabell som du vill använda för adresser till den <link href=\"text/swriter/01/mm_seladdlis.xhp\">kopplade utskriften</link>.</ahelp>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".\">Opens the <emph>Mail Merge Recipients</emph> dialog.</ahelp>"
msgstr "<ahelp hid=\".\">Öppnar dialogrutan <emph>Mottagare för kopplad utskrift</emph>.</ahelp>"

#. from libreoffice:swriter-01
msgid "<link href=\"text/swriter/01/selection_mode.xhp\">Selection Mode</link>"
msgstr "<link href=\"text/swriter/01/selection_mode.xhp\">Markeringsläge</link>"

#. from libreoffice:swriter-01
msgid "<ahelp hid=\".\">In block selection mode, you can select a rectangular block of text.</ahelp>"
msgstr "<ahelp hid=\".\">I Blockera markeringsläge kan du välja ett rektangulärt textblock.</ahelp>"

#. from libreoffice:swriter-02
msgid "Some of the bullets and numbering options are not available when working in the <link href=\"text/swriter/01/03120000.xhp\">Web Layout</link>."
msgstr "Vissa punktuppställningsalternativ är inte tillgängliga när du arbetar i <link href=\"text/swriter/01/03120000.xhp\">webblayout</link>."

#. from libreoffice:swriter-02
msgid "<link href=\"text/shared/01/06050000.xhp\">Bullets and Numbering</link>"
msgstr "<link href=\"text/shared/01/06050000.xhp\">Punkter och numrering</link>"

#. from libreoffice:swriter-02
msgid "<ahelp hid=\".uno:ChainFrames\" visibility=\"visible\">Links the selected frame to the next frame.</ahelp> The text automatically flows from one frame to another."
msgstr "<ahelp hid=\".uno:ChainFrames\" visibility=\"visible\">Länkar den markerade ramen till nästa ram.</ahelp> Texten bryts automatiskt från ram till ram."

#. from libreoffice:swriter-02
msgid "<bookmark_value>frames;unlinking</bookmark_value><bookmark_value>unlinking frames</bookmark_value>"
msgstr "<bookmark_value>Ramar;upphäva länkning</bookmark_value><bookmark_value>Upphäva länkning av ramar</bookmark_value>"

#. from libreoffice:swriter-02
msgid "<link href=\"text/swriter/02/03220000.xhp\">Unlink Frames</link>"
msgstr "<link href=\"text/swriter/02/03220000.xhp\">Lös upp länkning</link>"

#. from libreoffice:swriter-02
msgid "<ahelp hid=\".uno:UnhainFrames\">Breaks the link between two frames.</ahelp> You can only break the link that extends from the selected frame to the target frame."
msgstr "<ahelp hid=\".uno:UnhainFrames\">Bryter länken mellan två ramar.</ahelp> Du kan bara bryta länken som utvidgas från den markerade ramen till målramen."

#. from libreoffice:swriter-02
msgid "<bookmark_value>tables; inserting rows</bookmark_value><bookmark_value>rows; inserting in tables, using icon</bookmark_value>"
msgstr "<bookmark_value>Tabeller; infoga rader</bookmark_value><bookmark_value>Rader; infoga i tabeller, med hjälp av ikoner</bookmark_value>"

#. from libreoffice:swriter-02
msgid "<link href=\"text/swriter/02/04090000.xhp\">Insert Rows</link>"
msgstr "<link href=\"text/swriter/02/04090000.xhp\">Infoga rader</link>"

#. from libreoffice:swriter-02
msgid "<ahelp hid=\".uno:InsertRows\">Inserts one or more rows in the table, below the selection. You can insert more than one row by opening the dialog (choose <emph>Table - Insert - Rows</emph>), or by selecting more than one row before clicking the icon.</ahelp> The second method inserts rows of the same height as the originally selected rows."
msgstr "<ahelp hid=\".uno:InsertRows\">Infogar en eller flera rader i tabellen, nedanför markeringen. Du kan infoga mer än en rad genom att öppna dialogrutan (Välj <emph>Tabell - Infoga - Rader</emph>), eller genom att markera mer än en rad innan du klickar på ikonen.</ahelp> Den senare metoden infogar rader med samma höjd som de markerade raderna."

#. from libreoffice:swriter-02
msgid "<bookmark_value>tables; inserting columns in</bookmark_value><bookmark_value>columns; inserting in tables</bookmark_value>"
msgstr "<bookmark_value>Tabeller; infoga kolumner i</bookmark_value><bookmark_value>Kolumner; infoga i tabeller</bookmark_value>"

#. from libreoffice:swriter-02
msgid "<link href=\"text/swriter/02/04100000.xhp\">Insert Column</link>"
msgstr "<link href=\"text/swriter/02/04100000.xhp\">Infoga kolumn</link>"

#. from libreoffice:swriter-02
msgid "<ahelp hid=\".uno:InsertColumns\">Inserts one or more columns into the table, after the selection. You can insert several columns at the same time by opening the dialog (choose <emph>Table - Insert - Columns</emph>), or by selecting several columns before clicking the icon.</ahelp> If the latter method is used, the columns inserted will have the same relative width as the selected columns."
msgstr "<ahelp hid=\".uno:InsertColumns\">Infogar en eller flera kolumner i tabellen, nedanför markeringen. Du kan infoga flera kolumner samtidigt genom att öppna dialogrutan (välj <emph>Tabell - Infoga - Kolumner</emph>), eller genom att markera flera kolumner innan du klickar på ikonen.</ahelp> Om du använder den senare metoden får de infogade kolumnerna samma relativa bredd som de markerade kolumnerna."

#. from libreoffice:swriter-02
msgid "<link href=\"text/swriter/02/04220000.xhp\">Table: Fixed</link>"
msgstr "<link href=\"text/swriter/02/04220000.xhp\">Tabell: fast</link>"

#. from libreoffice:swriter-02
msgid "<ahelp hid=\".uno:TableModeFix\" visibility=\"visible\">If this mode is active, changes to a line and/or column affect only the neighboring lines or columns in question.</ahelp>"
msgstr "<ahelp hid=\".uno:TableModeFix\" visibility=\"visible\">Om det här läget är aktivt påverkar ändringar av en linje och/eller kolumn endast de intilliggande linjerna eller kolumnerna.</ahelp>"

#. from libreoffice:swriter-02
msgid "<link href=\"text/swriter/02/04230000.xhp\">Table: Fixed, Proportional</link>"
msgstr "<link href=\"text/swriter/02/04230000.xhp\">Tabell: fast, proportionell</link>"

#. from libreoffice:swriter-02
msgid "<ahelp hid=\".uno:TableModeFixProp\" visibility=\"visible\">If this mode is active, changes to the line and/or column affect the entire table.</ahelp>"
msgstr "<ahelp hid=\".uno:TableModeFixProp\" visibility=\"visible\">Om det här läget är aktivt påverkar ändringar i en rad och/eller kolumn hela tabellen.</ahelp>"

#. from libreoffice:swriter-02
msgid "<link href=\"text/swriter/02/04240000.xhp\">Table: Variable</link>"
msgstr "<link href=\"text/swriter/02/04240000.xhp\">Tabell: variabel</link>"

#. from libreoffice:swriter-02
msgid "<ahelp hid=\".uno:TableModeVariable\" visibility=\"visible\">If this mode is active, changes to a line and/or column affect the size of the table.</ahelp>"
msgstr "<ahelp hid=\".uno:TableModeVariable\" visibility=\"visible\">Om det här läget är aktivt påverkar ändringar i en rad och/eller kolumn storleken på tabellen.</ahelp>"

#. from libreoffice:swriter-02
msgid "<link href=\"text/swriter/02/04250000.xhp\">Sum</link>"
msgstr "<link href=\"text/swriter/02/04250000.xhp\">Summa</link>"

#. from libreoffice:swriter-02
msgid "<ahelp hid=\".uno:AutoSum\">Activates the sum function. Note that the cursor must be in the cell where you want the sum to appear.</ahelp>"
msgstr "<ahelp hid=\".uno:AutoSum\">Aktiverar summafunktionen. Observera att markören måste finnas i den cell där summan ska visas.</ahelp>"

#. from libreoffice:swriter-02
msgid "Click <emph>Apply</emph> to accept the sum formula as it appears in the entry line."
msgstr "Klicka på <emph>Använd</emph> om du vill godkänna summaformeln som den visas på raden."

#. from libreoffice:swriter-02
msgid "<link href=\"text/swriter/02/06090000.xhp\">Insert Unnumbered Entry</link>"
msgstr "<link href=\"text/swriter/02/06090000.xhp\">Infoga post utan nummer </link>"

#. from libreoffice:swriter-02
msgid "<ahelp hid=\".uno:InsertNeutralParagraph\">Inserts a paragraph without numbering. The existing numbering will not be affected.</ahelp>"
msgstr "<ahelp hid=\".uno:InsertNeutralParagraph\">Infogar ett stycke utan numrering. Den löpande numreringen i dokumentet påverkas inte.</ahelp>"

#. from libreoffice:swriter-02
msgid "<link href=\"text/swriter/02/06140000.xhp\">Restart Numbering</link>"
msgstr "<link href=\"text/swriter/02/06140000.xhp\">Starta om numrering</link>"

#. from libreoffice:swriter-02
msgid "The displayed page (x) and the total number of pages (y) are shown in the form <emph>Page x/y</emph> When you scroll through a document with the mouse, the page number is displayed when you release the mouse button. When you scroll using the right scrollbar, the page numbers are displayed as a Help tip. The page numbering format of the status bar and scrollbar is identical."
msgstr "Vilken sida som visas (x) och det totala antalet sidor (y) visas i <emph>Sida x/y</emph> Om du rullar genom dokumentet med hjälp av musen visas sidnumret när du släpper musknappen. Om du rullar igenom dokumentet med hjälp av höger rullningslist visas sidnumren som tipshjälp. Sidnumreringsformatet på statusraden och rullningslisten är identiskt."

#. from libreoffice:swriter-02
msgid "You can turn the <link href=\"text/swriter/01/02110000.xhp\">Navigator</link> display on or off by double-clicking the<emph> Page Number </emph>field."
msgstr "Du kan stänga av eller sätta på visningen av <link href=\"text/swriter/01/02110000.xhp\">Navigator</link> genom att dubbelklicka på fältet <emph>Sidnummer</emph>."

#. from libreoffice:swriter-02
msgid "To go to a specific page, enter the page number in the <emph>Page</emph> spin button in the Navigator and then press Enter."
msgstr "Om du vill gå till en viss sida med hjälp av Navigator, anger du sidnumret i rotationsfältet <emph>Sida </emph> i Navigator och trycker på Retur."

#. from libreoffice:swriter-02
msgid "By pressing the shortcut keys Shift+<switchinline select=\"sys\"><caseinline select=\"MAC\">Command</caseinline><defaultinline>Ctrl</defaultinline></switchinline>+F5, you switch to entering a page number. When you press Enter, the cursor moves to the selected page."
msgstr "Genom att trycka på kortkommandot Skift+<switchinline select=\"sys\"><caseinline select=\"MAC\">Kommando</caseinline><defaultinline>Ctrl</defaultinline></switchinline>+F5 kan du byta till att skriva ett sidnummer. När du trycker på Retur flyttas markören till den valda sidan."

#. from libreoffice:swriter-02
msgid "Combined Display"
msgstr "Kombinerad visning"

#. from libreoffice:swriter-02
msgid "<link href=\"text/swriter/02/08080000.xhp\">Combined Display</link>"
msgstr "<link href=\"text/swriter/02/08080000.xhp\">Kombinerad visning</link>"

#. from libreoffice:swriter-02
msgid "<link href=\"text/swriter/02/10030000.xhp\">Preview Zoom</link>"
msgstr "<link href=\"text/swriter/02/10030000.xhp\">Zoom förhandsgranskning</link>"

#. from libreoffice:swriter-02
msgid "<ahelp hid=\"HID_PVIEW_ZOOM_LB\">Determines the zoom level of the print preview.</ahelp>"
msgstr "<ahelp hid=\"HID_PVIEW_ZOOM_LB\">Bestämmer zoomfaktor för förhandsgranskningen.</ahelp>"

#. from libreoffice:swriter-02
msgid "<ahelp hid=\".uno:PreviewZoom\">Defines the number of pages displayed on screen. Click the arrow next to the icon to open a grid to select the number of pages to be displayed as rows and columns in the preview.</ahelp>"
msgstr "<ahelp hid=\".uno:PreviewZoom\">Definierar antalet sidor som visas på skärmen. Klicka på pilen bredvid ikonen för att öppna ett raster där man kan välja antalet sidor som ska visas som rader och kolumner i förhandsvisningen.</ahelp>"

#. from libreoffice:swriter-02
msgid "<ahelp hid=\"modules/swriter/ui/previewzoomdialog/rows\">Defines the number of rows of pages.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/previewzoomdialog/rows\">Definierar sidornas radantal.</ahelp>"

#. from libreoffice:swriter-02
msgid "<ahelp hid=\"modules/swriter/ui/previewzoomdialog/cols\">Defines the number of pages shown in columns.</ahelp>"
msgstr "<ahelp hid=\"modules/swriter/ui/previewzoomdialog/cols\">Definierar antalet sidor som visas i kolumner.</ahelp>"

#. from libreoffice:swriter-02
msgid "Book preview"
msgstr "Förhandsgranskning av bok"

#. from libreoffice:swriter-02
msgid "<bookmark_value>previews;book preview</bookmark_value><bookmark_value>book previews</bookmark_value>"
msgstr "<bookmark_value>Förhandsgranskningar; förhandsgranskning av bok</bookmark_value><bookmark_value>Förhandsgranskning av bok</bookmark_value>"

#. from libreoffice:swriter-02
msgid "<link href=\"text/swriter/02/10080000.xhp\">Book preview</link>"
msgstr "<link href=\"text/swriter/02/10080000.xhp\">Förhandsgranskning av bok</link>"

#. from libreoffice:swriter-02
msgid "<link href=\"text/swriter/02/10090000.xhp\">Print page view</link>"
msgstr "<link href=\"text/swriter/02/10090000.xhp\">Skriv ut förhandsgranskning</link>"

#. from libreoffice:swriter-02
msgid "<image id=\"img_id3154575\" src=\"cmd/sc_printpagepreview.png\" width=\"0.1665in\" height=\"0.1665in\"><alt id=\"alt_id3154575\">Icon</alt></image>"
msgstr "<image id=\"img_id3154575\" src=\"cmd/sc_printpagepreview.png\" width=\"0.1665in\" height=\"0.1665in\"><alt id=\"alt_id3154575\">Ikon</alt></image>"

#. from libreoffice:swriter-02
msgid "Print page view"
msgstr "Skriv ut förhandsgranskning"

#. from libreoffice:swriter-02
msgid "Cell Reference"
msgstr "Cellreferens"

#. from libreoffice:swriter-02
msgid "<link href=\"text/swriter/02/14010000.xhp\">Cell Reference</link>"
msgstr "<link href=\"text/swriter/02/14010000.xhp\">Cellreferens</link>"

#. from libreoffice:swriter-02
msgid "Displays the position of the cell cursor in a table."
msgstr "Visar positionen för cellmarkören i en tabell."

#. from libreoffice:swriter-02
msgid "<link href=\"text/swriter/02/14020000.xhp\">Formula</link>"
msgstr "<link href=\"text/swriter/02/14020000.xhp\">Formel</link>"

#. from libreoffice:swriter-02
msgid "The formula appears in the input line. To specify a range of cells in a table, select the desired cells with the mouse. The corresponding cell references also appear in the input line. Enter additional parameters, as necessary, and click <emph>Apply</emph> to confirm your entry. You can also enter the formula directly if you know the appropriate syntax. This is necessary, for example, in the <link href=\"text/swriter/01/04090000.xhp\"><emph>Insert Fields</emph></link> and <emph>Edit Fields</emph> dialogs."
msgstr "Formeln visas på inmatningsraden. Om du vill ange ett cellområde i en tabell markerar du cellerna med musen. De motsvarande cellreferenserna visas också på inmatningsraden. Ange övriga parametrar om det behövs och klicka på <emph>Överta</emph> för att bekräfta inmatningen. Du kan också skriva in formeln direkt om du känner till syntaxen för formeln. Det måste du till exempel göra i dialogrutorna <link href=\"text/swriter/01/04090000.xhp\"><emph>Infoga fältkommando</emph></link> och <emph>Redigera fältkommando</emph>."

#. from libreoffice:swriter-02
msgid "Summary of Formula Options"
msgstr "Formelelementens tabeller"

#. from libreoffice:swriter-02
msgid "Basic Calculation Functions"
msgstr "De fyra räknesätten"

#. from libreoffice:swriter-02
msgid "Calculates the total."
msgstr "Beräknar summan."

#. from libreoffice:swriter-02
msgid "Example: <A1> + 8"
msgstr "Exempel: <A1> + 8"

#. from libreoffice:swriter-02
msgid "Example: 10 - <B5>"
msgstr "Exempel: 10 - <B5>"

#. from libreoffice:swriter-02
msgid "MUL or *"
msgstr "MUL eller *"

#. from libreoffice:swriter-02
msgid "Calculates the product."
msgstr "Beräknar produkten."

#. from libreoffice:swriter-02
msgid "DIV or /"
msgstr "DIV eller /"

#. from libreoffice:swriter-02
msgid "Basic Functions in the Submenu"
msgstr "Grundfunktioner på undermenyn"

#. from libreoffice:swriter-02
msgid "Example: SUM <A2:C2> displays the sum of the values in cells A2 to C2"
msgstr "Exempel: SUM <A2:C2> visar summan av värdena i cellerna från A2 till C2"

#. from libreoffice:swriter-02
msgid "Example: 15.678 ROUND 2 displays 15.68"
msgstr "Exempel: 15,678 ROUND 2 visar 15,68"

#. from libreoffice:swriter-02
msgid "|"
msgstr "|"

#. from libreoffice:swriter-02
msgid "Example of using a list:"
msgstr "Exempel på hur en lista används:"

#. from libreoffice:swriter-02
msgid "MIN 10|20|50|<C6>|<A2:B6>|20"
msgstr "MIN 10|20|50|<C6>|<A2:B6>|20"

#. from libreoffice:swriter-02
msgid "EQ or =="
msgstr "EQ eller =="

#. from libreoffice:swriter-02
msgid "NEQ or !="
msgstr "NEQ eller !="

#. from libreoffice:swriter-02
msgid "Less than or Equal"
msgstr "Mindre än eller lika med"

#. from libreoffice:swriter-02
msgid "Greater than or Equal"
msgstr "Större än eller lika med"

#. from libreoffice:swriter-02
msgid "Example: 0 OR 0 displays 0 (false), anything else results in 1 (true)"
msgstr "Exempel: 0 OR 0 visar 0 (falskt), allt annat visar 1 (sant)"

#. from libreoffice:swriter-02
msgid "Boolean X Or"
msgstr "Logiskt Exklusivt Eller"

#. from libreoffice:swriter-02
msgid "Example: 1 XOR 0 displays 1 (true)"
msgstr "Exempel: 1 XOR 0 visar 1 (sant)"

#. from libreoffice:swriter-02
msgid "Example: 1 AND 2 displays 1 (true)"
msgstr "Exempel: 1 AND 2 visar 1 (sant)"

#. from libreoffice:swriter-02
msgid "Example: NOT 1 (true) displays 0 (false)"
msgstr "Exempel: NOT 1 (sant) visar 0 (falskt)"

#. from libreoffice:swriter-02
msgid "Example: MEAN 10|30|20 displays 20"
msgstr "Exempel: MEAN 10|30|20 visar 20,00"

#. from libreoffice:swriter-02
msgid "Example: MIN 10|30|20 displays 10"
msgstr "Exempel: MIN 10|30|20 visar 10,00"

#. from libreoffice:swriter-02
msgid "Example: TAN <A1>"
msgstr "Exempel: TAN <A1>"

#. from libreoffice:swriter-02
msgid "Example: ASIN 1"
msgstr "Exempel: ASIN 1"

#. from libreoffice:swriter-02
msgid "Example: ACOS 1"
msgstr "Exempel: ACOS 1"

#. from libreoffice:swriter-02
msgid "Example: ATAN 1"
msgstr "Exempel: ARCTAN 1"

