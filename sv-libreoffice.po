#. from libreoffice:shared-autopi
msgid "<ahelp hid=\"modules/sabpilot/ui/defaultfieldselectionpage/defaultselectionno\" visibility=\"visible\">Specifies that you do not want any option field to be the default choice.</ahelp>"
msgstr "<ahelp hid=\"modules/sabpilot/ui/defaultfieldselectionpage/defaultselectionno\" visibility=\"visible\">Anger att inget alternativfält ska markeras som standard.</ahelp>"

