msgstr "Öppnar snabbmenyn."

#. from libreoffice:shared-04
msgid "Control Properties Window"
msgstr "Fönstret Kontrollegenskaper"

#. from libreoffice:shared-04
msgid "Opens the combo box."
msgstr "Öppnar kombinationsrutan."

#. from libreoffice:shared-04
msgid "Closes the combo box."
msgstr "Stänger kombinationsrutan."

#. from libreoffice:shared-04
msgid "Inserts a new line."
msgstr "Infogar en ny rad."

#. from libreoffice:shared-04
msgid "Up arrow"
msgstr "Uppåtpil"

#. from libreoffice:shared-04
msgid "Positions the cursor in the previous line."
msgstr "Placerar markören på den föregående raden."

#. from libreoffice:shared-04
msgid "Down arrow"
msgstr "Nedåtpil"

#. from libreoffice:shared-04
msgid "Puts the cursor into the next line."
msgstr "Placerar markören på nästa rad."

#. from libreoffice:shared-04
msgid "Completes the input in the field and places the cursor into the next field."
msgstr "Slutför inmatningen i fältet och placerar markören i nästa fält."

#. from libreoffice:shared-04
msgid "<switchinline select=\"sys\"><caseinline select=\"MAC\">Command</caseinline><defaultinline>Ctrl</defaultinline></switchinline>+F6"
msgstr "<switchinline select=\"sys\"><caseinline select=\"MAC\">Kommando</caseinline><defaultinline>Ctrl</defaultinline></switchinline>+F6"

#. from libreoffice:shared-04
msgid "Sets the focus (if not in design mode) to the first control. The first control is the first one listed in the Form Navigator."
msgstr "Ställer in fokus (inte i utkastläge) på den första kontrollen. Den första kontrollen är den som listas för i Formulär-Navigator."

