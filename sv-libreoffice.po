msgid "<switchinline select=\"sys\"><caseinline select=\"MAC\">Command+Option</caseinline><defaultinline>Ctrl+Alt</defaultinline></switchinline>+Up Arrow"
msgstr "<switchinline select=\"sys\"><caseinline select=\"MAC\">Kommando+Alternativ</caseinline><defaultinline>Ctrl+Alt</defaultinline></switchinline>+Uppåtpil"

