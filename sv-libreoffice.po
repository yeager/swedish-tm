msgstr "<switchinline select=\"sys\"><caseinline select=\"MAC\">Kommando</caseinline><defaultinline>Ctrl</defaultinline></switchinline>+Piltangent"

#. from libreoffice:shared-04
msgid "Moves the selected control in steps of 1 mm in the respective direction. In point edit mode, it changes the size of the selected control."
msgstr "Flyttar den markerade kontrollen i 1 mm långa steg i respektive riktning. I punktredigeringsläge ändrar den storleken för den markerade kontrollen."

#. from libreoffice:shared-04
msgid "<switchinline select=\"sys\"><caseinline select=\"MAC\">Command</caseinline><defaultinline>Ctrl</defaultinline></switchinline>+Tab"
msgstr "<switchinline select=\"sys\"><caseinline select=\"MAC\">Kommando</caseinline><defaultinline>Ctrl</defaultinline></switchinline>+Tabb"

