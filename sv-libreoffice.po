msgid "Defines a scenario for the selected sheet area."
msgstr "Definierar ett scenario för det valda arkområdet."

#. from libreoffice:sc-messages
msgid "Deletes the selected scenario."
msgstr "Tar bort det markerade scenariot."

#. from libreoffice:sc-messages
msgid "Opens the Edit scenario dialog, where you can edit the scenario properties."
msgstr "Öppnar dialogrutan Redigera scenario där du kan redigera scenariots egenskaper."

#. from libreoffice:sc-messages
msgid "Measurement _unit:"
msgstr "Måttenhet:"

#. from libreoffice:sc-messages
