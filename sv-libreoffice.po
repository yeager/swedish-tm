msgstr "Dokumentkonverteraren"

#. from libreoffice:shared-autopi
msgid "<variable id=\"ms\"><ahelp hid=\".\">Copies and converts documents into the OpenDocument XML format used by $[officename].</ahelp></variable>"
msgstr "<variable id=\"ms\"><ahelp hid=\".\">Kopierar och konverterar dokument till OpenDocument XML-formatet som används i $[officename].</ahelp></variable>"

#. from libreoffice:shared-autopi
msgid "The wizard converts documents from Microsoft Word, Excel and PowerPoint. The source files are only read, not edited. New target files are written with the new file name extension in the same or a new folder."
msgstr "Guiden konverterar dokument från Microsoft Word, Excel och PowerPoint. De ursprungliga filerna redigeras inte utan läses endast. De nya filerna skrivs med den nya filändelsen till samma mapp eller till en ny mapp. "

#. from libreoffice:shared-autopi
msgid "The Document Converter Wizard contains the following pages:"
msgstr "Guiden Dokumentkonverteraren innehåller följande sidor:"

#. from libreoffice:shared-autopi
msgid "Document Converter Summary"
msgstr "Dokumentkonverterare Sammanfattning"

#. from libreoffice:shared-autopi
msgid "Displays a summary which shows what will be converted when you click <emph>Convert</emph>."
msgstr "Visar en sammanfattning av vad som kommer att konverteras när du klickar på <emph>Konvertera</emph>."

#. from libreoffice:shared-autopi
msgid "Document Converter Page 1"
msgstr "Dokumentkonverterare sida 1"

#. from libreoffice:shared-autopi
msgid "<link href=\"text/shared/autopi/01130100.xhp\">Document Converter Page 1</link>"
msgstr "<link href=\"text/shared/autopi/01130100.xhp\">Dokumentkonverterare - första sidan</link>"

#. from libreoffice:shared-autopi
msgid "Specifies the type of Microsoft Office documents that will be converted."
msgstr "Anger vilken typ av Microsoft Office-filer som ska konverteras."

#. from libreoffice:shared-autopi
msgid "Converts Microsoft Office documents into the OpenDocument format."
msgstr "Konverterar Microsoft Office dokument till OpenDocument-format."

#. from libreoffice:shared-autopi
msgid "Word documents"
msgstr "Word dokument"

#. from libreoffice:shared-autopi
msgid "<ahelp hid=\"HID_DLGIMPORT_2_CHKWORD\">Converts documents in Microsoft Word format *.doc into OpenDocument *.odt documents.</ahelp>"
msgstr "<ahelp hid=\"HID_DLGIMPORT_2_CHKWORD\">Konverterar Microsoft Word dokument (*.doc) till OpenDocument dokument (*.odt).</ahelp>"

#. from libreoffice:shared-autopi
msgid "Excel documents"
msgstr "Excel dokument"

#. from libreoffice:shared-autopi
msgid "<ahelp hid=\"HID_DLGIMPORT_2_CHKEXCEL\">Converts documents in Microsoft Excel format *.xls into OpenDocument *.ods documents.</ahelp>"
msgstr "<ahelp hid=\"HID_DLGIMPORT_2_CHKEXCEL\">Konverterar Microsoft Excel dokument (*.xls) till OpenDocument dokument (*.ods).</ahelp>"

#. from libreoffice:shared-autopi
msgid "PowerPoint documents"
msgstr "PowerPoint dokument"

#. from libreoffice:shared-autopi
msgid "<ahelp hid=\"HID_DLGIMPORT_2_CHKPOWERPOINT\">Converts documents in Microsoft PowerPoint format *.ppt into OpenDocument *.odp documents.</ahelp>"
msgstr "<ahelp hid=\"HID_DLGIMPORT_2_CHKPOWERPOINT\">Konverterar Microsoft PowerPoint dokument (*.ppt) till OpenDocument dokument (*.odp).</ahelp>"

#. from libreoffice:shared-autopi
msgid "Create Log file"
msgstr "Skapa loggfil"

#. from libreoffice:shared-autopi
msgid "<ahelp hid=\"HID_DLGIMPORT_0_CHKLOGFILE\">Creates a log file in your work directory showing which documents have been converted.</ahelp>"
msgstr "<ahelp hid=\"HID_DLGIMPORT_0_CHKLOGFILE\">Skapar en loggfil i arbetskatalogen som visar vilka dokument som har konverterats.</ahelp>"

#. from libreoffice:shared-autopi
msgid "Continue to the next page of the <link href=\"text/shared/autopi/01130200.xhp\">Document Converter</link>."
msgstr "Här fortsätter du till nästa sida i <link href=\"text/shared/autopi/01130200.xhp\">dokumentkonverteraren</link>"

#. from libreoffice:shared-autopi
msgid "Document converter continuation pages"
msgstr "Följande sidor för Dokumentkonverteraren"

#. from libreoffice:shared-autopi
msgid "<link href=\"text/shared/autopi/01130200.xhp\">Document converter continuation pages</link>"
msgstr "<link href=\"text/shared/autopi/01130200.xhp\">Dokumentkonverterare - följande sidor</link>"

#. from libreoffice:shared-autopi
msgid "Specifies, for each template type and document type, the directory to be read from and the directory to be written to."
msgstr "Anger en läskatalog och en skrivkatalog för varje mall- och dokumenttyp."

#. from libreoffice:shared-autopi
msgid "Determines whether templates are to be converted, and how they are converted."
msgstr "Anger om mallar ska konverteras, och hur mallarna ska konverteras."

#. from libreoffice:shared-autopi
msgid "Text templates"
msgstr "Textmallar"

#. from libreoffice:shared-autopi
msgid "Note that the \"Text templates\" label can change, depending on the selections from the previous page. For example, if Microsoft Word documents have been selected, the label reads \"Word templates\"."
msgstr "Observera att etiketten \"Textmallar\" kan ändras beroende på vilka alternativ du valt på föregående sida. Om du till exempel har valt Microsoft Word dokument får etiketten texten \"Word-mallar\"."

#. from libreoffice:shared-autopi
msgid "<ahelp hid=\"HID_DLGIMPORT_2_CBTEMPLATE\">Specifies that templates are to be converted.</ahelp>"
msgstr "<ahelp hid=\"HID_DLGIMPORT_2_CBTEMPLATE\">Anger att mallarna ska konverteras.</ahelp>"

#. from libreoffice:shared-autopi
msgid "Including subdirectories"
msgstr "inkl. underordnade kataloger"

#. from libreoffice:shared-autopi
msgid "<ahelp hid=\"HID_DLGIMPORT_2_CBDOCUMENTRECURSE\">Indicates that the subdirectories of the selected directory are also searched for matching files.</ahelp>"
msgstr "<ahelp hid=\"HID_DLGIMPORT_2_CBDOCUMENTRECURSE\">Anger att underkatalogerna i de markerade katalogerna också ska sökas igenom efter matchande filer.</ahelp>"

#. from libreoffice:shared-autopi
msgid "Import from"
msgstr "Importera från"

#. from libreoffice:shared-autopi
msgid "<ahelp hid=\"HID_DLGIMPORT_2_LBDOCUMENTPATH\">Specifies the directory containing the source files. </ahelp>"
msgstr "<ahelp hid=\"HID_DLGIMPORT_2_LBDOCUMENTPATH\">Anger den katalog som innehåller källfilerna. </ahelp>"

#. from libreoffice:shared-autopi
msgid "Save to"
msgstr "Spara i"

#. from libreoffice:shared-autopi
msgid "<ahelp hid=\"HID_DLGIMPORT_2_EDDOCUMENTPATH\">Specifies the directory to which the destination files are written.</ahelp>"
msgstr "<ahelp hid=\"HID_DLGIMPORT_2_EDDOCUMENTPATH\">Anger den katalog som målfilerna ska skrivas till.</ahelp>"

#. from libreoffice:shared-autopi
msgid "<ahelp hid=\"HID_DLGIMPORT_2_CMDDOCUMENTPATHSELECT\">Opens a dialog to select the desired path.</ahelp>"
msgstr "<ahelp hid=\"HID_DLGIMPORT_2_CMDDOCUMENTPATHSELECT\">Öppnar en dialogruta där du kan välja sökväg.</ahelp>"

#. from libreoffice:shared-autopi
msgid "Determines whether and how documents are converted."
msgstr "Anger om och hur dokument ska konverteras."

#. from libreoffice:shared-autopi
msgid "Text documents"
msgstr "Textdokument"

#. from libreoffice:shared-autopi
msgid "Note that the \"Text documents\" label can change, depending on the selections from the previous page. For example, if Microsoft Word documents have been selected, the label reads \"Word documents\"."
msgstr "Observera att etiketten \"Textdokument\" kan ändras beroende på vilka alternativ du valt på föregående sida. Om du till exempel har valt Microsoft Word dokument får etiketten texten \"Word dokument\"."

#. from libreoffice:shared-autopi
msgid "<ahelp hid=\"HID_DLGIMPORT_2_CBDOCUMENT\">Indicates that the documents are to be converted.</ahelp>"
msgstr "<ahelp hid=\"HID_DLGIMPORT_2_CBDOCUMENT\">Anger att dokumenten ska konverteras.</ahelp>"

#. from libreoffice:shared-autopi
msgid "Here you can return to the main page of the <link href=\"text/shared/autopi/01130000.xhp\">Document Converter Wizard</link>."
msgstr "Här kan du gå tillbaka till startsidan för guiden <link href=\"text/shared/autopi/01130000.xhp\">Dokumentkonverterare</link>."

#. from libreoffice:shared-autopi
msgid "<bookmark_value>Euro; Euro Converter Wizard</bookmark_value><bookmark_value>wizards; Euro Converter</bookmark_value><bookmark_value>converters; Euro converter</bookmark_value><bookmark_value>currencies; converters</bookmark_value>"
msgstr "<bookmark_value>Euro; guide för Eurokonverteraren</bookmark_value><bookmark_value>Guider; Eurokonverteraren</bookmark_value><bookmark_value>Konverterare; Eurokonverteraren</bookmark_value><bookmark_value>Valutor; konverterare</bookmark_value>"

#. from libreoffice:shared-autopi
msgid "Euro Converter Wizard"
msgstr "Guide för Eurokonverteraren"

#. from libreoffice:shared-autopi
msgid "Only closed files are converted. It is possible, however, to use the Euro Converter in an open $[officename] Calc document. In this case, a separate dialog opens. This dialog is described <link href=\"text/shared/autopi/01150000.xhp\">at the end of this section</link>."
msgstr "Det går bara att konvertera stängda filer. Du kan även använda Eurokonverteraren i ett öppet $[officename] Calc dokument. Om du gör det öppnas en egen dialogruta. Dialogrutan finns beskriven <link href=\"text/shared/autopi/01150000.xhp\">i slutet av det här avsnittet</link>."

#. from libreoffice:shared-autopi
msgid "Only the currencies of the countries participating in the European Monetary Union are converted."
msgstr "Observera att endast valuta från länder som infört euro som gemensam valuta konverteras."

#. from libreoffice:shared-autopi
msgid "Extent"
msgstr "Omfattning"

#. from libreoffice:shared-autopi
msgid "Single $[officename] Calc document"
msgstr "Enstaka $[officename] Calc dokument"

#. from libreoffice:shared-autopi
msgid "Complete Directory"
msgstr "Hela katalogen"

#. from libreoffice:shared-autopi
msgid "Source directory / Source Document"
msgstr "Källkatalog/källdokument"

#. from libreoffice:shared-autopi
msgid "Including Subfolders"
msgstr "Inklusive undermappar"

#. from libreoffice:shared-autopi
msgid "Also convert fields and tables in text documents"
msgstr "Konvertera även fält och tabeller i textdokument"

#. from libreoffice:shared-autopi
msgid "Values in the text document that are not in fields or tables are not converted."
msgstr "Värden i textdokumentet som inte finns i fält eller tabeller konverteras inte."

#. from libreoffice:shared-autopi
msgid "Temporarily unprotect sheet without query"
msgstr "Upphäv tabellskydd temporärt utan säkerhetsfråga"

#. from libreoffice:shared-autopi
msgid "Target Directory"
msgstr "Målmapp"

#. from libreoffice:shared-autopi
msgid "<emph>...</emph>"
msgstr "<emph>...</emph>"

#. from libreoffice:shared-autopi
msgid "During conversion, a page showing the progress status is displayed."
msgstr "Under konverteringen visas en sida med statusmeddelanden om hur konverteringen fortskrider."

#. from libreoffice:shared-autopi
msgid "<image id=\"img_id3150417\" src=\"cmd/sc_euroconverter.png\" width=\"0.222inch\" height=\"0.222inch\"><alt id=\"alt_id3150417\">Icon</alt></image>"
msgstr "<image id=\"img_id3150417\" src=\"cmd/sc_euroconverter.png\" width=\"0.222inch\" height=\"0.222inch\"><alt id=\"alt_id3150417\">Symbol</alt></image>"

#. from libreoffice:shared-autopi
msgid "Euro Converter"
msgstr "Eurokonverterare"

#. from libreoffice:shared-autopi
msgid "The <emph>Euro Converter</emph> dialog contains the following functions:"
msgstr "I dialogrutan <emph>Eurokonverterare</emph> finns följande funktioner:"

#. from libreoffice:shared-autopi
msgid "Entire document"
msgstr "Komplett dokument"

#. from libreoffice:shared-autopi
msgid "Currencies"
msgstr "Valutor:"

#. from libreoffice:shared-autopi
msgid "Select the cells you want to convert in this range, if you did not mark the <emph>Entire document</emph> check box. Select an option and then click the desired entries in the <emph>Templates</emph> / <emph>Currency ranges</emph> field. The selected range will be visible as such in the document. Click <emph>Convert</emph> to carry out the conversion."
msgstr "I det här området väljer du ut cellerna som ska konverteras om du inte har markerat <emph>Komplett dokument</emph>. Välj först ett av alternativen och klicka sedan på de önskade posterna i fältet <emph>Mallar</emph> resp. <emph>Valutaområden</emph> till höger. I dokumentet visas det valda området som markering. När du vill konvertera klickar du på <emph>Konvertera</emph>."

#. from libreoffice:shared-autopi
msgid "Currency cells in the current sheet"
msgstr "Valutaceller i det aktuella tabellarket"

#. from libreoffice:shared-autopi
msgid "Currency cells in the entire document"
msgstr "Valutaceller i hela dokumentet"

#. from libreoffice:shared-autopi
msgid "Selected range"
msgstr "Utvalt område"

#. from libreoffice:shared-autopi
msgid "Templates / Currency ranges"
msgstr "Mallar/Valutaområden"

#. from libreoffice:shared-autopi
msgid "Address Data Source"
msgstr "Adressdatakälla"

#. from libreoffice:shared-autopi
msgid "<link href=\"text/shared/autopi/01170000.xhp\">Address Data Source</link>"
msgstr "<link href=\"text/shared/autopi/01170000.xhp\">Adressdatakälla</link>"

#. from libreoffice:shared-autopi
msgid "<ahelp hid=\".\">This wizard registers an existing address book as a data source in $[officename].</ahelp>"
msgstr "<ahelp hid=\".\">Den här guiden hjälper dig att registrera en befintlig adressbok som datakälla i $[officename].</ahelp>"

#. from libreoffice:shared-autopi
msgid "You can register address data and other data sources in $[officename] at any time:"
msgstr "Du kan när som helst registrera adressdata och andra datakällor i $[officename]:"

#. from libreoffice:shared-autopi
msgid "Please select the type of your external address book"
msgstr "Välj typen för din externa adressbok"

#. from libreoffice:shared-autopi
msgid "Not all types are available on all systems."
msgstr "Alla fungerar inte på alla operativsystem."

#. from libreoffice:shared-autopi
msgid "<ahelp hid=\".\">Select this option if you already use an address book in Thunderbird or Icedove.</ahelp>"
msgstr "<ahelp hid=\".\">Välj detta alternativ om du redan använder en adressbok i Thunderbird eller Icedove.</ahelp>"

#. from libreoffice:shared-autopi
msgid "KDE Address book"
msgstr "KDE-adressboken"

#. from libreoffice:shared-autopi
msgid "<ahelp hid=\".\">Select this option if you already use an address book in KDE Address book.</ahelp>"
msgstr "<ahelp hid=\".\">Välj detta alternativ om du redan använder en adressbok i KDE.</ahelp>"

#. from libreoffice:shared-autopi
msgid "<ahelp hid=\".\">Select this option if you already use an address book in Evolution.</ahelp>"
msgstr "<ahelp hid=\".\">Välj detta alternativ om du redan använder en adressbok i Evolution.</ahelp>"

#. from libreoffice:shared-autopi
msgid "<ahelp hid=\".\">Select this option if you already use an address book in Evolution LDAP.</ahelp>"
msgstr "<ahelp hid=\".\">Välj detta alternativ om du redan använder en adressbok i Evolution LDAP.</ahelp>"

#. from libreoffice:shared-autopi
msgid "<ahelp hid=\".\">Select this option if you already use an address book in Groupwise.</ahelp>"
msgstr "<ahelp hid=\".\">Välj detta alternativ om du redan använder en adressbok i Gruppvis.</ahelp>"

#. from libreoffice:shared-autopi
msgid "<ahelp hid=\"modules/sabpilot/ui/selecttypepage/other\">Select this option if you want to register another data source as address book in $[officename].</ahelp>"
msgstr "<ahelp hid=\"modules/sabpilot/ui/selecttypepage/other\">Markera det här alternativet om du vill registrera en annan datakälla som adressbok i $[officename].</ahelp>"

#. from libreoffice:shared-autopi
msgid "<ahelp hid=\"HID_ABSPILOT_CANCEL\">Exits the wizard without implementing any changes.</ahelp>"
msgstr "<ahelp hid=\"HID_ABSPILOT_CANCEL\">Guiden avslutas utan att några ändringar börjar gälla.</ahelp>"

#. from libreoffice:shared-autopi
msgid "<ahelp hid=\"HID_ABSPILOT_PREVIOUS\" visibility=\"hidden\">Go to previous step.</ahelp>"
msgstr "<ahelp hid=\"HID_ABSPILOT_PREVIOUS\" visibility=\"hidden\">Gå till föregående redigeringssteg.</ahelp>"

#. from libreoffice:shared-autopi
msgid "<ahelp hid=\"HID_ABSPILOT_NEXT\" visibility=\"hidden\">Go to next step.</ahelp>"
msgstr "<ahelp hid=\"HID_ABSPILOT_NEXT\" visibility=\"hidden\">Gå till nästa redigeringssteg.</ahelp>"

#. from libreoffice:shared-autopi
msgid "<ahelp hid=\"HID_ABSPILOT_FINISH\">Establishes the connection to the data source and closes the dialog.</ahelp>"
msgstr "<ahelp hid=\"HID_ABSPILOT_FINISH\">Upprättar kopplingen till datakällan och stänger dialogrutan.</ahelp>"

#. from libreoffice:shared-autopi
msgid "<link href=\"text/shared/autopi/01170200.xhp\">Additional Settings</link>"
msgstr "<link href=\"text/shared/autopi/01170200.xhp\">Ytterligare inställningar</link>"

#. from libreoffice:shared-autopi
msgid "<ahelp hid=\"modules/sabpilot/ui/invokeadminpage/settings\">Calls a dialog in which you can enter additional settings.</ahelp>"
msgstr "<ahelp hid=\"modules/sabpilot/ui/invokeadminpage/settings\">Anropar en dialog där du kan göra ytterligare inställningar.</ahelp>"

#. from libreoffice:shared-autopi
msgid "<link href=\"text/shared/autopi/01170300.xhp\">Select Table</link>"
msgstr "<link href=\"text/shared/autopi/01170300.xhp\">Välj tabell</link>"

#. from libreoffice:shared-autopi
msgid "<ahelp hid=\".\">Specifies a table from the Seamonkey / Netscape address book source that is used as the address book in $[officename].</ahelp>"
msgstr "<ahelp hid=\".\">Anger en tabell i den adressbokkälla från Seamonkey /Netscape som används som adressbok i $[officename].</ahelp>"

#. from libreoffice:shared-autopi
msgid "All tables from the first user profile will be registered for this data source in $[officename]. You must specify one as the table that will be used in the $[officename] templates."
msgstr "Alla tabeller från den första användarprofilen kommer att registreras för den här datakällan i $[officename]. Du måste ange en som den tabell som ska användas i mallarna i $[officename]."

#. from libreoffice:shared-autopi
msgid "List box"
msgstr "Listruta"

#. from libreoffice:shared-autopi
msgid "<ahelp hid=\"modules/sabpilot/ui/selecttablepage/table\">Specifies the table that is to serve as the address book for the $[officename] templates.</ahelp>"
msgstr "<ahelp hid=\"modules/sabpilot/ui/selecttablepage/table\">Anger den tabell som ska användas som adressbok till $[officename]-mallarna.</ahelp>"

#. from libreoffice:shared-autopi
msgid "You can make changes to the templates and documents at a later time by choosing <emph>Edit - Exchange Database</emph>."
msgstr "Det går att göra ändringar i efterhand i mallarna och dokumenten via kommandot <emph>Redigera - Byt databas</emph>."

#. from libreoffice:shared-autopi
msgid "<ahelp hid=\".\">Specifies a location for the address book file and a name under which the data source will be listed in the data source explorer.</ahelp>"
msgstr "<ahelp hid=\".\">Anger en plats för adressboksfilen och ett namn som datakällan sorterar under i Explorer för datakällor.</ahelp>"

#. from libreoffice:shared-autopi
msgid "<ahelp hid=\".\">Specifies the location of the database file.</ahelp>"
msgstr "<ahelp hid=\".\">Anger databasfilens placering.</ahelp>"

#. from libreoffice:shared-autopi
msgid "<ahelp hid=\".\">Specifies the location using a file dialog.</ahelp>"
msgstr "<ahelp hid=\".\">Anger placering med hjälp av en dialogruta.</ahelp>"

#. from libreoffice:shared-autopi
msgid "Make this address book available to all modules in %PRODUCTNAME"
msgstr "Gör adressboken tillgänglig i alla moduler i %PRODUCTNAME"

#. from libreoffice:shared-autopi
msgid "<ahelp hid=\"modules/sabpilot/ui/datasourcepage/name\">Specifies the data source name.</ahelp>"
msgstr "<ahelp hid=\"modules/sabpilot/ui/datasourcepage/name\">Anger datakällans namn.</ahelp>"

#. from libreoffice:shared-autopi
msgid "<link href=\"text/shared/autopi/01170500.xhp\">Field Assignment</link>"
msgstr "<link href=\"text/shared/autopi/01170500.xhp\">Fälttilldelning</link>"

#. from libreoffice:shared-autopi
msgid "<ahelp hid=\".\">Opens a dialog that allows you to specify the field assignment.</ahelp>"
msgstr "<ahelp hid=\".\">Öppnar en dialogruta som du kan använda för att ange fälttilldelningar.</ahelp>"

#. from libreoffice:shared-autopi
msgid "<ahelp hid=\"modules/sabpilot/ui/fieldassignpage/assign\">Opens the <link href=\"text/shared/01/01110101.xhp\">Templates: Address Book Assignment</link> dialog.</ahelp>"
msgstr "<ahelp hid=\"modules/sabpilot/ui/fieldassignpage/assign\">Öppnar dialogrutan <link href=\"text/shared/01/01110101.xhp\"> Mallar: Adressboktilldelning</link>.</ahelp>"

