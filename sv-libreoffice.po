msgstr "Kontrollera om hyperlänkstexten är för kort."

#. from libreoffice:cui-messages
msgid "Check if the hyperlink has an alternative name set."
msgstr "Kontrollera om hyperlänken har ett alternativt namn."

#. from libreoffice:cui-messages
msgid "Check if links and reference fields are used in the header or footer."
msgstr "Kontrollera om länkar och referensfält används i sidhuvudet eller sidfoten."

#. from libreoffice:cui-messages
msgid "Check if text contrast is high enough."
msgstr "Kontrollera om textkontrasten är tillräckligt hög."

#. from libreoffice:cui-messages
msgid "Check if the document contains blinking text."
msgstr "Kontrollera om dokumentet innehåller blinkande text."

#. from libreoffice:cui-messages
msgid "Check if the document contains footnotes."
msgstr "Kontrollera om dokumentet innehåller fotnoter."

#. from libreoffice:cui-messages
msgid "Check if the document contains simulated footnotes."
msgstr "Kontrollera om dokumentet innehåller simulerade fotnoter."

#. from libreoffice:cui-messages
msgid "Check if the document contains simulated captions."
msgstr "Kontrollera om dokumentet innehåller simulerade bildtexter."

#. from libreoffice:cui-messages
msgid "Check if the document contains endnotes."
msgstr "Kontrollera om dokumentet innehåller slutanteckningar."

#. from libreoffice:cui-messages
msgid "Check if the document contains background images."
msgstr "Kontrollera om dokumentet innehåller bakgrundsbilder."

#. from libreoffice:cui-messages
msgid "Check if document contains new lines to create space."
msgstr "Kontrollera om dokumentet innehåller nya rader för att skapa utrymme."

#. from libreoffice:cui-messages
msgid "Check if document contains repeated spaces."
msgstr "Kontrollera om dokumentet innehåller upprepade mellanslag."

#. from libreoffice:cui-messages
msgid "Check if document contains tabs for formatting."
msgstr "Kontrollera om dokumentet innehåller tabbar för formatering."

#. from libreoffice:cui-messages
msgid "Check if document contains new empty lines between numbered paragraphs."
msgstr "Kontrollera om dokumentet innehåller nya tomma rader mellan numrerade stycken."

#. from libreoffice:cui-messages
msgid "Check if the outline levels of all headings are in sequential order."
msgstr "Kontrollera om dispositionsnivåerna för alla rubriker är i ordningsföljd."

#. from libreoffice:cui-messages
msgid "Check if the document contains direct formatting."
msgstr "Kontrollera om dokumentet innehåller direktformatering."

#. from libreoffice:cui-messages
msgid "Check if the document contains interactive input fields."
msgstr "Kontrollera om dokumentet innehåller interaktiva inmatningsfält."

#. from libreoffice:cui-messages
msgid "Check if all Frames/Text boxes are anchored “As Character”."
msgstr "Kontrollera om alla ramar/textrutor är förankrade \"Som tecken\"."

#. from libreoffice:cui-messages
msgid "Check if all tables contain headings."
msgstr "Kontrollera om alla tabeller innehåller rubriker."

#. from libreoffice:cui-messages
msgid "Check if the headings are in correct order."
msgstr "Kontrollera om rubrikerna är i rätt ordning."

#. from libreoffice:cui-messages
msgid "Check if heading order starts with level 1."
msgstr "Kontrollera om rubrikordningen börjar med nivå 1."

#. from libreoffice:cui-messages
msgid "Check if the document contains fontwork objects."
msgstr "Kontrollera om dokumentet innehåller fontwork-objekt."

#. from libreoffice:cui-messages
msgid "Check if document contains empty table cells for formatting."
msgstr "Kontrollera om dokumentet innehåller tomma tabellceller för formatering."

#. from libreoffice:cui-messages
msgid "Check if the document contains content controls in header or footer."
msgstr "Kontrollera om dokumentet innehåller innehållskontroller i sidhuvud eller sidfot."

#. from libreoffice:cui-messages
msgid "Check if a default language is set for the document."
msgstr "Kontrollera om ett standardspråk är inställt för dokumentet."

#. from libreoffice:cui-messages
msgid "Check if styles have a language set."
msgstr "Kontrollera om stilar har ett språk angivet."

#. from libreoffice:cui-messages
msgid "Check if the document title is set."
msgstr "Kontrollera om dokumenttiteln är inställd."

#. from libreoffice:cui-messages
msgid "Please enter a name for the new library:"
msgstr "Ange ett namn för det nya biblioteket:"

#. from libreoffice:cui-messages
msgid "Please enter a name for the new module:"
msgstr "Ange ett namn för den nya modulen:"

