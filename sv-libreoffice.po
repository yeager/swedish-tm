msgid "The known mean of the population."
msgstr "Det kända medelvärdet för populationen."

#. from libreoffice:sc-messages
msgid "The known standard deviation of the population. If omitted, the standard deviation of the given sample is used."
msgstr "Den kända standardavvikelsen för populationen. Om den inte anges så används standardavvikelsen för stickprovet i fråga."

#. from libreoffice:sc-messages
msgid "Returns the chi square independence test."
msgstr "Beräknar chi-två-oberoendetestet."

#. from libreoffice:sc-messages
msgid "Data B"
msgstr "Data B"

#. from libreoffice:sc-messages
msgid "The observed data array."
msgstr "Matrisen för observerade data."

#. from libreoffice:sc-messages
msgid "Data E"
msgstr "Data E"

#. from libreoffice:sc-messages
msgid "The expected data array."
msgstr "Matrisen för förväntade data."

#. from libreoffice:sc-messages
msgid "Calculates the F test."
msgstr "Beräknar F-varianstestet."

#. from libreoffice:sc-messages
msgid "Calculates the t-test."
msgstr "Beräknar t-testet."

#. from libreoffice:sc-messages
msgid "Mode specifies the number of distribution tails to return. 1 = one-tailed, 2 = two-tailed distribution"
msgstr "Läget anger antalet distributionssvansar som skall returneras. 1 = ensvansig, 2 = tvåsvansig distribution"

#. from libreoffice:sc-messages
msgid "The type of the t-test."
msgstr "Typen av t-test."

#. from libreoffice:sc-messages
