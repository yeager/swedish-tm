#. from libreoffice:smath-00
msgid "<variable id=\"neuzeichnen\">Choose <emph>View - AutoUpdate Display</emph></variable>"
msgstr "<variable id=\"neuzeichnen\">Menyn <emph>Visa - Uppdatera visning automatiskt</emph></variable>"

#. from libreoffice:smath-00
msgid "<variable id=\"astopa\">Choose <emph>View - Elements</emph></variable>"
msgstr "<variable id=\"astopa\">Menyn <emph>Visa - Formelelement</emph></variable>"

#. from libreoffice:smath-00
msgid "Open the context menu in the Commands window - choose <emph>Unary/Binary Operators</emph>"
msgstr "Öppna snabbmenyn i kommandofönstret - välj <emph>Unära/Binära operatorer</emph>"

#. from libreoffice:smath-00
msgid "Choose <emph>View - Elements</emph>; then on the Elements pane select <emph>Unary/Binary Operators</emph> from the listbox."
msgstr "Välj <emph>Visa - Element</emph>; välj sedan <emph>Unära/binära operatorer</emph> i rullmenyn på Elementpanelen."

#. from libreoffice:smath-00
msgid "Open the context menu in the Commands window - choose <emph>Relations</emph>"
msgstr "Snabbmenyn i kommandofönstret <emph> - Relationer</emph>"

#. from libreoffice:smath-00
msgid "Choose <emph>View - Elements</emph>; then on the Elements pane select <emph>Relations</emph> from the listbox."
msgstr "Välj <emph>Visa - Element</emph>; välj sedan <emph>Relationer</emph> i rullmenyn på Elementpanelen."

#. from libreoffice:smath-00
msgid "Open the context menu in the Commands window - choose <emph>Operators</emph>"
msgstr "Snabbmenyn i kommandofönstret <emph> - Operatorer</emph>"

#. from libreoffice:smath-00
msgid "Choose <emph>View - Elements</emph>; then on the Elements pane select <emph>Operators</emph> from the listbox."
msgstr "Välj <emph>Visa - Element</emph>; välj sedan <emph>Operatorer</emph> i rullmenyn på Elementpanelen."

#. from libreoffice:smath-00
msgid "Open the context menu in the Commands window - choose <emph>Functions</emph>"
msgstr "Snabbmenyn i kommandofönstret <emph>- Funktioner</emph>"

#. from libreoffice:smath-00
msgid "Choose <emph>View - Elements</emph>; then on the Elements pane select <emph>Functions</emph> from the listbox."
msgstr "Välj <emph>Visa - Element</emph>; välj sedan <emph>Funktioner</emph> i rullmenyn på Elementpanelen."

#. from libreoffice:smath-00
msgid "Open the context menu in the Commands window - choose <emph>Brackets</emph>"
msgstr "Snabbmenyn i kommandofönstret<emph> - Parenteser</emph>"

#. from libreoffice:smath-00
msgid "Choose <emph>View - Elements</emph>; then on the Elements pane select <emph>Brackets</emph> from the listbox."
msgstr "Välj <emph>Visa - Element</emph>; välj sedan <emph>Parenteser</emph> i rullmenyn på Elementpanelen."

#. from libreoffice:smath-00
msgid "Open the context menu in the Commands window - choose <emph>Attributes</emph>"
msgstr "Snabbmenyn i kommandofönstret <emph>- Attribut</emph>"

#. from libreoffice:smath-00
msgid "Choose <emph>View - Elements</emph>; then on the Elements pane select <emph>Attributes</emph> from the listbox."
msgstr "Välj <emph>Visa - Element</emph>; välj sedan <emph>Attribut</emph> i rullmenyn på Elementpanelen."

#. from libreoffice:smath-00
msgid "Open the context menu in the Commands window - choose <emph>Formats</emph>"
msgstr "Snabbmenyn i kommandofönstret <emph>- Formateringar</emph>"

#. from libreoffice:smath-00
msgid "Choose <emph>View - Elements</emph>; then on the Elements pane select <emph>Formats</emph> from the listbox."
msgstr "Välj <emph>Visa - Element</emph>; välj sedan <emph>Formateringar</emph> i rullmenyn på Elementpanelen."

#. from libreoffice:smath-00
msgid "Open the context menu in the Commands window - choose <emph>Set Operations</emph>"
msgstr "Snabbmenyn i kommandofönstret <emph> - Mängdoperationer</emph>"

#. from libreoffice:smath-00
msgid "Choose <emph>View - Elements</emph>; then on the Elements pane select <emph>Set Operations</emph> from the listbox."
msgstr "Välj <emph>Visa - Element</emph>; välj sedan <emph>Mängdoperationer</emph> i rullmenyn på Elementpanelen."

#. from libreoffice:smath-00
msgid "<variable id=\"fmtsfa\">Choose <emph>Format - Fonts</emph></variable>"
msgstr "<variable id=\"fmtsfa\">Menyn <emph>Format - Teckensnitt...</emph></variable>"

#. from libreoffice:smath-00
msgid "<variable id=\"fmtssa\">Choose <emph>Format - Fonts - Modify</emph></variable>"
msgstr "<variable id=\"fmtssa\">Menyn <emph>Format - Teckensnitt - Ändra - ...</emph></variable>"

#. from libreoffice:smath-00
msgid "<variable id=\"fmtsgr\">Choose <emph>Format - Font Size</emph></variable>"
msgstr "<variable id=\"fmtsgr\">Menyn <emph>Format - Teckenstorlekar...</emph></variable>"

#. from libreoffice:smath-00
msgid "<variable id=\"fmtabs\">Choose <emph>Format - Spacing</emph></variable>"
msgstr "<variable id=\"fmtabs\">Menyn <emph>Format - Avstånd...</emph></variable>"

#. from libreoffice:smath-00
msgid "<variable id=\"textmodus\">Choose <emph>Format - Text Mode</emph></variable>"
msgstr "<variable id=\"textmodus\">Menyn <emph>Format - Textläge</emph></variable>"

#. from libreoffice:smath-00
msgid "On the Tools bar, click"
msgstr "På verktygsraden Verktyg klickar du på"

