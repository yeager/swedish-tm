msgstr "<image src=\"cmd/sc_wrapon.png\" id=\"img_id3149048\" width=\"1cm\" height=\"1cm\"><alt id=\"alt_id3149048\">Ikon flöda text på</alt></image>"

#. from libreoffice:swriter-00
