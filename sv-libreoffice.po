msgid "Returns a (1-alpha) confidence interval for a Student's t distribution."
msgstr "Beräknar ett (1-alfa)-konfidensintervall för en students t-fördelning."

#. from libreoffice:sc-messages
msgid "The level of the confidence interval."
msgstr "Nivån för konfidensintervallet."

#. from libreoffice:sc-messages
msgid "The standard deviation of the population."
msgstr "Standardavvikelsen för populationen."

#. from libreoffice:sc-messages
msgid "The size of the population."
msgstr "Populationens storlek."

