msgstr "Anger språkversion för det valda fältet."

#. from libreoffice:cui-messages
msgid "_Locale"
msgstr "_Språkversion"

#. from libreoffice:cui-messages
msgid "So_urce format"
msgstr "Källformat"

#. from libreoffice:cui-messages
msgid "Uses the same number format as the cells containing the data for the chart."
msgstr "Använder samma talformat som de celler som innehåller diagrammets data."

#. from libreoffice:cui-messages
msgid "Enter the number of decimal places that you want to display."
msgstr "Ange antalet decimaler som ska visas."

#. from libreoffice:cui-messages
msgid "With fraction format, enter the number of places for the denominator that you want to display."
msgstr "Med bråkformat anger du antalet platser för nämnaren som du vill visa."

#. from libreoffice:cui-messages
msgid "Enter the maximum number of zeroes to display in front of the decimal point."
msgstr "Ange maximalt antal nollor som ska visas före decimaltecknet."

#. from libreoffice:cui-messages
msgid "_Decimal places:"
msgstr "_Antal decimaler:"

#. from libreoffice:cui-messages
msgid "Den_ominator places:"
msgstr "Nämn_arplatser:"

#. from libreoffice:cui-messages
msgid "Leading _zeroes:"
msgstr "Inledande _nollor:"

#. from libreoffice:cui-messages
msgid "_Negative numbers red"
msgstr "Negativa värden i _rött"

#. from libreoffice:cui-messages
msgid "Changes the font color of negative numbers to red."
msgstr "Ändrar teckenfärgen till rött för negativa tal."

#. from libreoffice:cui-messages
msgid "_Engineering notation"
msgstr "_Teknisk notation"

#. from libreoffice:cui-messages
msgid "With scientific format, Engineering notation ensures that exponent is a multiple of 3."
msgstr "Med vetenskapligt format, säkerställer teknisk notation att exponenten är en multipel av 3."

#. from libreoffice:cui-messages
msgid "_Thousands separator"
msgstr "_Tusentalsavgränsare"

#. from libreoffice:cui-messages
msgid "Inserts a separator between thousands. The type of separator that is used depends on your Languages and Locales settings."
msgstr "Infogar en avgränsare mellan tusental. Vilken typ av separator som används beror på dina språkinställningar."

#. from libreoffice:cui-messages
msgid "Displays the number format code for the selected format. You can also enter a custom format."
msgstr "Visar nummerformatskoden för det valda formatet. Du kan också ange ett anpassat format."

#. from libreoffice:cui-messages
msgid "Adds the number format code that you entered to the user-defined category."
msgstr "Lägger till den talformatbeskrivning du har angett i den användardefinierade kategorin."

#. from libreoffice:cui-messages
msgid "Enter a comment for the selected number format, and then click outside this box."
msgstr "Skriv en kommentar till det markerade talformatet och klicka sedan utanför rutan."

#. from libreoffice:cui-messages
msgid "Remove"
msgstr "Ta bort"

#. from libreoffice:cui-messages
msgid "Deletes the selected number format."
msgstr "Raderar det markerade talformatet."

#. from libreoffice:cui-messages
msgid "Adds a comment to the selected number format."
msgstr "Lägger till en kommentar i det markerade talformatet."

#. from libreoffice:cui-messages
msgid "_Format Code"
msgstr "_Formatkod"

#. from libreoffice:cui-messages
msgid "Specify the formatting options for the selected cell(s)."
msgstr "Ange formateringsalternativ för de markerade cellerna."

#. from libreoffice:cui-messages
msgid "From file..."
msgstr "Från fil..."

#. from libreoffice:cui-messages
msgid "Select the level(s) that you want to define the formatting options for."
msgstr "Markera den nivå/de nivåer du vill ange formateringsalternativ för."

#. from libreoffice:cui-messages
msgid "Number:"
msgstr "Nummer:"

#. from libreoffice:cui-messages
msgid "Select the Character Style that you want to use in the numbered list."
msgstr "Välj den teckenstil som du vill använda i den numrerade listan."

#. from libreoffice:cui-messages
msgid "Enter the number of previous levels to include in the numbering scheme. For example, if you enter \"2\" and the previous level uses the \"A, B, C...\" numbering, the numbering scheme for the current level becomes: \"A.1\"."
msgstr "Ange antalet tidigare nivåer som ska inkluderas i numreringsschemat. Till exempel, om du anger \"2\" och föregående nivå använder \"A, B, C...\"-numrering, blir numreringsschemat för den aktuella nivån: \"A.1\"."

#. from libreoffice:cui-messages
msgid "All sublevels Arabic"
msgstr "Alla undernivåer arabiska"

#. from libreoffice:cui-messages
msgid "Use Arabic numerals for all sublevels (\"Legal\" numbering)."
msgstr "Använd arabiska siffror för alla undernivåer (\"Legal\" numrering)."

#. from libreoffice:cui-messages
msgid "Enter a new starting number for the current level."
msgstr "Ange ett nytt startnummer för den aktuella nivån."

#. from libreoffice:cui-messages
msgid "Start at:"
msgstr "Börja med:"

#. from libreoffice:cui-messages
msgid "Select a numbering scheme for the selected levels."
msgstr "Välj ett numreringsschema för de valda nivåerna."

#. from libreoffice:cui-messages
msgid "Graphics:"
msgstr "Grafik:"

#. from libreoffice:cui-messages
msgid "Top of baseline"
msgstr "Över grundlinjen"

#. from libreoffice:cui-messages
msgid "Center of baseline"
msgstr "Mitten av grundlinjen"

#. from libreoffice:cui-messages
msgid "Bottom of baseline"
msgstr "Under grundlinjen"

#. from libreoffice:cui-messages
msgid "Top of character"
msgstr "Överst på tecken"

#. from libreoffice:cui-messages
msgid "Center of character"
msgstr "Mitten av tecken"

#. from libreoffice:cui-messages
msgid "Bottom of character"
msgstr "Nederst på tecken"

#. from libreoffice:cui-messages
msgid "Top of line"
msgstr "Överst på raden"

#. from libreoffice:cui-messages
msgid "Center of line"
msgstr "Mitten av raden"

#. from libreoffice:cui-messages
msgid "Bottom of line"
msgstr "Nederst på raden"

#. from libreoffice:cui-messages
msgid "Select the alignment option for the graphic."
msgstr "Välj justeringsalternativ för grafikobjektet."

#. from libreoffice:cui-messages
msgid "Select a color for the current numbering scheme."
msgstr "Välj en färg för det aktuella numreringsschemat."

#. from libreoffice:cui-messages
msgid "Enter the amount by which you want to resize the bullet character with respect to the font height of the current paragraph."
msgstr "Ange hur mycket du vill ändra storleken på punktuppställningstecknet i förhållande till teckenhöjden för det aktuella stycket."

#. from libreoffice:cui-messages
msgid "Select the graphic, or locate the graphic file that you want to use as a bullet."
msgstr "Markera det grafiska objektet eller leta reda på grafikfilen som du vill använda som punktuppställningstecken."

#. from libreoffice:cui-messages
msgid "Before:"
msgstr "Före:"

#. from libreoffice:cui-messages
msgid "Separator"
msgstr "Avgränsare"

#. from libreoffice:cui-messages
msgid "Enter a character or the text to display behind the number in the list. To create the numbering scheme \"1.)\", enter \".)\" in this box."
msgstr "Ange ett tecken eller text som ska visas bakom numret i listan. För att skapa numreringsschemat \"1.)\", skriv in \".)\" i denna ruta."

#. from libreoffice:cui-messages
msgid "Enter a character or the text to display in front of the number in the list."
msgstr "Ange ett tecken eller texten som ska visas framför numret i listan."

#. from libreoffice:cui-messages
msgid "After:"
msgstr "Efter:"

#. from libreoffice:cui-messages
msgid "Show sublevels:"
msgstr "Visa undernivåer:"

#. from libreoffice:cui-messages
msgid "Character:"
msgstr "Tecken:"

#. from libreoffice:cui-messages
msgid "_Relative size:"
msgstr "_Relativ storlek:"

#. from libreoffice:cui-messages
msgid "Color:"
msgstr "Färg:"

#. from libreoffice:cui-messages
msgid "Character style:"
msgstr "Teckenformatmall:"

#. from libreoffice:cui-messages
msgid "Width:"
msgstr "Bredd:"

#. from libreoffice:cui-messages
msgid "Height:"
msgstr "Höjd:"

#. from libreoffice:cui-messages
msgid "Enter a width for the graphic."
msgstr "Ange en bredd för grafikobjektet."

#. from libreoffice:cui-messages
msgid "Enter a height for the graphic."
msgstr "Ange en höjd för grafikobjektet."

#. from libreoffice:cui-messages
msgid "_Consecutive numbering"
msgstr "Fort_löpande numrering"

#. from libreoffice:cui-messages
msgid "Increases the numbering by one as you go down each level in the list hierarchy."
msgstr "Numreringen ökas med ett steg i taget för varje nivå du går ned i listhierarkin."

#. from libreoffice:cui-messages
msgid "All Levels"
msgstr "Alla nivåer"

#. from libreoffice:cui-messages
msgid "Select the level(s) that you want to modify."
msgstr "Välj den eller de nivåer som du vill ändra."

#. from libreoffice:cui-messages
msgid "Level"
msgstr "Nivå"

#. from libreoffice:cui-messages
msgid "Followed by:"
msgstr "Följt av:"

#. from libreoffice:cui-messages
msgid "Aligned at:"
msgstr "Justerat vid:"

#. from libreoffice:cui-messages
msgid "Indent at:"
msgstr "Indrag vid:"

#. from libreoffice:cui-messages
msgid "Tab stop at:"
msgstr "Tabulator vid:"

#. from libreoffice:cui-messages
msgid "If you select a tab stop to follow the numbering, you can enter a non-negative value as the tab stop position."
msgstr "Om du väljer att en tabb ska komma efter numreringen kan du ange ett icke-negativt värde som tabbens placering."

#. from libreoffice:cui-messages
msgid "Enter the distance from the left page margin at which the numbering symbol will be aligned."
msgstr "Ange avståndet från vänster sidmarginal som numreringstecknet ska justeras mot."

#. from libreoffice:cui-messages
msgid "Tab stop"
msgstr "Tabbläge"

#. from libreoffice:cui-messages
msgid "Nothing"
msgstr "Ingenting"

#. from libreoffice:cui-messages
msgid "Enter the distance from the left page margin to the start of all lines in the numbered paragraph that follow the first line."
msgstr "Ange avståndet från vänster sidmarginal till början av samtliga rader i det numrerade stycket som följer den första raden."

#. from libreoffice:cui-messages
msgid "Indent:"
msgstr "Indrag:"

#. from libreoffice:cui-messages
msgid "Enter the amount of space to leave between the left page margin (or the left edge of the text object) and the left edge of the numbering area. If the current paragraph style uses an indent, the amount you enter here is added to the indent."
msgstr "Ange hur mycket utrymme som ska lämnas mellan den vänstra sidmarginalen (eller den vänstra kanten av textobjektet) och den vänstra kanten av numreringsområdet. Om det aktuella styckeformatet använder ett indrag läggs beloppet du anger här till indraget."

#. from libreoffice:cui-messages
msgid "Relati_ve"
msgstr "Relati_v"

#. from libreoffice:cui-messages
msgid "Indents the current level relative to the previous level in the list hierarchy."
msgstr "Justerar indrag av den aktuella nivån i förhållande till föregående nivå i listhierarkin."

#. from libreoffice:cui-messages
msgid "Width of numbering:"
msgstr "Numreringsbredd:"

#. from libreoffice:cui-messages
msgid "Enter the width of the numbering area. The numbering symbol can be left, center or right in this area."
msgstr "Ange bredden på numreringsområdet. Numreringssymbolen kan vara till vänster, i mitten eller till höger i detta område."

#. from libreoffice:cui-messages
msgid "The alignment of the numbering symbol is adjusted to get the desired minimum space. If it is not possible because the numbering area is not wide enough, then the start of the text is adjusted."
msgstr "Inriktningen av numreringssymbolen justeras för att få önskat minsta utrymme. Om det inte är möjligt eftersom numreringsområdet inte är tillräckligt brett justeras början av texten."

#. from libreoffice:cui-messages
msgid "Minimum space between\nnumbering and text:"
msgstr "Minsta avstånd mellan\nnumrering och text:"

#. from libreoffice:cui-messages
msgid "Alignment:"
msgstr "Justering:"

#. from libreoffice:cui-messages
msgid "Set the alignment of the numbering symbols. Select \"Start\" to align the numbering symbol to start directly at the \"Aligned at\" position. Select \"End\" to align the symbol to end directly before the \"Aligned at\" position. Select \"Centered\" to center the symbol around the \"Aligned at\" position."
msgstr "Ställ in justeringen av numreringssymbolerna. Välj \"Start\" för att justera numreringssymbolen så att den börjar direkt vid positionen \"Justerat vid\". Välj \"Slut\" för att justera symbolen så att den slutar direkt före positionen \"Justerat vid\". Välj \"Centrerad\" för att centrera symbolen runt positionen \"Justerat vid\"."

#. from libreoffice:cui-messages
msgid "Position and Spacing"
msgstr "Position och avstånd"

#. from libreoffice:cui-messages
msgid "Resets the indent and the spacing values to the default values."
msgstr "Återställer indraget och avståndet till de fördefinierade värdena."

#. from libreoffice:cui-messages
msgid "Enter a name for the selected object. The name will be visible in the Navigator."
msgstr "Ange ett namn för det valda objektet. Namnet kommer att synas i Navigatorn."

#. from libreoffice:cui-messages
msgid "Alt Text"
msgstr "Alternativ text"

#. from libreoffice:cui-messages
msgid "Give a short description of non-text content for users who do not see this object."
msgstr "Ge en kort beskrivning av icke-textinnehåll för användare som inte ser detta objekt."

#. from libreoffice:cui-messages
msgid "Text:"
msgstr "Text:"

#. from libreoffice:cui-messages
msgid "Enter a title text. This short name is visible as an \"alt\" tag in HTML format. Accessibility tools can read this text."
msgstr "Ange en titeltext. Detta korta namn är synligt som en \"alt\"-tagg i HTML-format. Tillgänglighetsverktyg kan läsa denna text."

#. from libreoffice:cui-messages
msgid "Give longer explanation of non-text content that is too complex to be described briefly in “Text”"
msgstr "Ge en längre förklaring av icke-textinnehåll som är för komplext för att kortfattat beskrivas i \"Text\""

#. from libreoffice:cui-messages
msgid "_Alt Text:"
msgstr "_Alternativ text:"

#. from libreoffice:cui-messages
msgid "Enter a description text. The long description text can be entered to describe a complex object or group of objects to users with screen reader software. The description is visible as an alternative tag for accessibility tools."
msgstr "Fastslå en beskrivning.  Beskrivningen används i ALT attributen i HTML element för att hjälpa med tillgänlighetsverktyg."

#. from libreoffice:cui-messages
msgid "Decorative"
msgstr "Dekorativ"

#. from libreoffice:cui-messages
msgid "The item is purely decorative, not part of the document content, and may be ignored by assistive technologies."
msgstr "Objektet är rent dekorativt, inte en del av dokumentets innehåll och kan ignoreras av hjälpmedel."

#. from libreoffice:cui-messages
msgid "Assigns a title and a description to the selected object. These are accessible for accessibility tools and as alternative tags when you export the document."
msgstr "Fastslå rubriken och beskrivningen för objektet.  Dessa syns med hjälp av tillgänglighetverktug och i alternat markering då dokumentet exporteras."

#. from libreoffice:cui-messages
msgid "Allow animated images:"
msgstr "Tillåt animerade bilder:"

#. from libreoffice:cui-messages
msgid "Controls if previewing the animation of animated images (e.g. animated GIFs) is enabled. Select from “System”, “No” and “Yes”.\n“System” previews the animation of animated images according to system settings."
msgstr "Styr om förhandsgranskning av animering av animerade bilder (t.ex. animerade GIF-bilder) är aktiverat. Välj mellan \"System\", \"Nej\" och \"Ja\".\n\"System\" förhandsgranskar animeringen av animerade bilder enligt systeminställningar."

#. from libreoffice:cui-messages
msgid "Allow animated text:"
msgstr "Tillåt animerad text:"

#. from libreoffice:cui-messages
msgid "Controls if previewing the animation of animated text (such as blinking and scrolling) is enabled. Select from “System”, “No” and “Yes”.\n“System” previews the animation of animated text according to system settings."
msgstr "Styr om förhandsgranskning av animering av animerad text (som blinkande och rullning) är aktiverad. Välj mellan \"System\", \"Nej\" och \"Ja\".\n\"System\" förhandsgranskar animeringen av animerad text enligt systeminställningarna."

#. from libreoffice:cui-messages
msgid "Allow other animations:"
msgstr "Tillåt andra animationer:"

#. from libreoffice:cui-messages
msgid "Controls if certain other animations (e.g. 'marching ants' animation when copying a cell in calc) are enabled. Select from “System”, “No” and “Yes”.\n“System” allows showing these certain other animations according to system settings."
msgstr "Styr om vissa andra animationer (t.ex. \"marschmyror\"-animering när du kopierar en cell i calc) är aktiverade. Välj mellan \"System\", \"Nej\" och \"Ja\".\n\"System\" tillåter att visa dessa vissa andra animationer enligt systeminställningar."

#. from libreoffice:cui-messages
msgid "Animations"
msgstr "Animationer"

#. from libreoffice:cui-messages
msgid "High contrast:"
msgstr "Hög kontrast:"

#. from libreoffice:cui-messages
msgid "Disable"
msgstr "Inaktivera"

#. from libreoffice:cui-messages
msgid "Enable"
msgstr "Aktivera"

#. from libreoffice:cui-messages
msgid "Controls if high contrast mode is used. Select from “Automatic”, “Disable” and “Enable”. “Automatic” uses high contrast according to system settings."
msgstr "Styr om högkontrastläge används. Välj mellan \"Automatisk\", \"Inaktivera\" och \"Aktivera\". \"Automatisk\" använder hög kontrast enligt systeminställningar."

#. from libreoffice:cui-messages
msgid "Use automatic font _color for screen display"
msgstr "Använd automatisk tecken_färg för bildskärmsvisning"

#. from libreoffice:cui-messages
msgid "Displays fonts in the office suite using the system color settings. This option only affects the screen display."
msgstr "Visar teckensnitt i kontorssviten med hjälp av systemets färginställningar. Det här alternativet påverkar endast skärmvisningen."

#. from libreoffice:cui-messages
msgid "_Use system colors for page previews"
msgstr "An_vänd systemfärger för förhandsgranskning"

#. from libreoffice:cui-messages
msgid "Applies the high contrast settings of the operating system to page previews."
msgstr "Systemets högkontrastinställningar används vid förhandsvisningar."

#. from libreoffice:cui-messages
msgid "High Contrast"
msgstr "Hög kontrast"

#. from libreoffice:cui-messages
msgid "Use te_xt selection cursor in read-only text documents"
msgstr "Använd markör för te_xtmarkering i skrivskyddade textdokument"

#. from libreoffice:cui-messages
msgid "Displays cursor in read-only documents."
msgstr "Visar markören i skrivskyddade dokument."

#. from libreoffice:cui-messages
msgid "Miscellaneous"
msgstr "Diverse"

#. from libreoffice:cui-messages
msgid "Enable _all"
msgstr "Aktivera _alla"

#. from libreoffice:cui-messages
msgid "Click to enable all the Accessibility check options."
msgstr "Klicka för att aktivera alla alternativ för tillgänglighetskontroll."

#. from libreoffice:cui-messages
msgid "Accessibility Check Options"
msgstr "Alternativ för tillgänglighetskontroll"

#. from libreoffice:cui-messages
msgid "Sets options that make the office suite programs more accessible for users with reduced sight, limited dexterity or other disabilities."
msgstr "Ställer in alternativ som gör kontorssvitprogrammen mer tillgängliga för användare med nedsatt syn, begränsad fingerfärdighet eller andra funktionshinder."

#. from libreoffice:cui-messages
msgid "_Use a Java runtime environment"
msgstr "_Använd Java"

#. from libreoffice:cui-messages
msgid "Allows you to run extensions written with Java."
msgstr "Låter dig köra tillägg skrivna med Java."

#. from libreoffice:cui-messages
msgid "_Java runtime environments (JRE) already installed:"
msgstr "_Redan installerade Java runtime environment (JRE):"

#. from libreoffice:cui-messages
msgid "Add a path to the root folder of a JRE on your computer."
msgstr "Lägg till sökvägen till rotmappen för en JRE på datorn."

#. from libreoffice:cui-messages
msgid "_Parameters..."
msgstr "_Parametrar..."

#. from libreoffice:cui-messages
msgid "Opens the Java Start Parameters dialog."
msgstr "Öppnar dialogrutan Startparametrar för Java."

#. from libreoffice:cui-messages
msgid "_Class Path..."
msgstr "_Klassökväg..."

#. from libreoffice:cui-messages
msgid "Opens the Class Path dialog."
msgstr "Öppnar dialogrutan Klassökväg."

#. from libreoffice:cui-messages
msgid "Vendor"
msgstr "Leverantör"

#. from libreoffice:cui-messages
msgid "Version"
msgstr "Version"

#. from libreoffice:cui-messages
msgid "Select the JRE that you want to use. On some systems, you must wait a minute until the list gets populated. On some systems, you must restart the office suite to use your changed setting."
msgstr "Välj den JRE som du vill använda. På vissa system måste du vänta en minut tills listan fylls i. På vissa system måste du starta om kontorssviten för att använda din ändrade inställning."

#. from libreoffice:cui-messages
msgid "Location: "
msgstr "Plats: "

#. from libreoffice:cui-messages
msgid "Select a Java Runtime Environment"
msgstr "Välj ett Java runtime environment"

#. from libreoffice:cui-messages
msgid "Java Options"
msgstr "Java-alternativ"

#. from libreoffice:cui-messages
msgid "Enable experimental features (may be unstable)"
msgstr "Aktivera experimentella funktioner (kan göra programmet instabilt)"

#. from libreoffice:cui-messages
msgid "Enable experimental features"
msgstr "Aktivera experimentella funktioner"

#. from libreoffice:cui-messages
msgid "Enable macro recording (may be limited)"
msgstr "Aktivera makroinspelning (begränsad)"

#. from libreoffice:cui-messages
msgid "Enable macro recording"
msgstr "Aktivera makroinspelning"

#. from libreoffice:cui-messages
msgid "Open Expert Configuration"
msgstr "Öppna expertinställningar"

#. from libreoffice:cui-messages
msgid "Opens the Expert Configuration dialog for advanced settings and configuration."
msgstr "Öppnar dialogrutan Expertinställningar för avancerade inställningar och konfiguration."

#. from libreoffice:cui-messages
msgid "Optional Features"
msgstr "Valfria alternativ"

#. from libreoffice:cui-messages
msgid "_Western text only"
msgstr "Endast västerländsk text"

#. from libreoffice:cui-messages
msgid "Specifies that kerning is only applied to western text."
msgstr "Anger att kerning endast används vid västerländsk text."

#. from libreoffice:cui-messages
msgid "Western _text and Asian punctuation"
msgstr "Västerländsk text och asiatisk interpunktion"

#. from libreoffice:cui-messages
msgid "Specifies that kerning is applied to both western text and Asian punctuation."
msgstr "Anger att kerning tillämpas på både västerländska texter och asiatisk interpunktion."

#. from libreoffice:cui-messages
msgid "Kerning"
msgstr "Kerning"

#. from libreoffice:cui-messages
msgid "_No compression"
msgstr "_Ingen komprimering"

#. from libreoffice:cui-messages
msgid "Specifies that no compression at all will occur."
msgstr "Anger att ingen komprimering kommer att användas."

#. from libreoffice:cui-messages
msgid "_Compress punctuation only"
msgstr "Komprimera bara _interpunktion"

#. from libreoffice:cui-messages
msgid "Specifies that only the punctuation is compressed."
msgstr "Anger att endast interpunktion komprimeras."

#. from libreoffice:cui-messages
msgid "Compress punctuation and Japanese Kana"
msgstr "Komprimera interpunktion och japansk Kana"

#. from libreoffice:cui-messages
msgid "Specifies that punctuation and Japanese Kana are compressed."
msgstr "Anger att interpunktion och japansk kana komprimeras."

#. from libreoffice:cui-messages
msgid "Specifies the language for which you want to define first and last characters."
msgstr "Anger vilket språk som du vill definiera första och sista tecknen."

#. from libreoffice:cui-messages
msgid "When you mark Default, the following two text boxes are filled with the default characters for the selected language:"
msgstr "När du markerar Standard fylls följande två textrutor med standardtecknen för det markerade språket:"

#. from libreoffice:cui-messages
msgid "Not _at start of line:"
msgstr "Inte i början av rad:"

#. from libreoffice:cui-messages
msgid "Not at _end of line:"
msgstr "Inte i slutet av rad:"

#. from libreoffice:cui-messages
msgid "Specifies the characters that should not appear alone at the beginning of a line."
msgstr "Anger de tecken som inte får visas ensamma i början eller slutet av en rad."

#. from libreoffice:cui-messages
msgid "Specifies the characters that should not appear alone at the end of a line."
msgstr "Anger de tecken som inte får visas ensamma i slutet av en rad."

#. from libreoffice:cui-messages
msgid "Without user-defined line break symbols"
msgstr "Utan användardefinierade radbrytningstecken"

#. from libreoffice:cui-messages
msgid "First and Last Characters"
msgstr "Start- och sluttecken"

#. from libreoffice:cui-messages
msgid "Enable code completion"
msgstr "Aktivera kodkomplettering"

#. from libreoffice:cui-messages
msgid "Display methods of a Basic object."
msgstr "Visa metoder för ett Basic-objekt."

#. from libreoffice:cui-messages
msgid "Code Completion"
msgstr "Kodkomplettering"

#. from libreoffice:cui-messages
msgid "Autoclose procedures"
msgstr "Stäng procedurer automatiskt"

#. from libreoffice:cui-messages
msgid "Automatically insert closing statements for procedures."
msgstr "Infoga automatiskt slutsatser för procedurer."

#. from libreoffice:cui-messages
msgid "Autoclose parenthesis"
msgstr "Stäng parenteser automatiskt"

