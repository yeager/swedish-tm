msgid "Select the area that contains the data for the current pivot table."
msgstr "Markera det område som innehåller data för den aktuella pivottabellen."

#. from libreoffice:sc-messages
msgid "Named range"
msgstr "Namngivet område"

#. from libreoffice:sc-messages
