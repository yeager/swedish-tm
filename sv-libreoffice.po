msgstr "<image src=\"cmd/lc_deleteallannotation.svg\" id=\"img_id501685994350880\" width=\"1cm\" height=\"1cm\"><alt id=\"alt_id131685994350881\">Ikon för Ta bort alla kommentarer</alt></image>"

