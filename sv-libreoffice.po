msgid "<ahelp hid=\"HID_SMA_DOTSAXIS\">This icon inserts an axis-ellipsis (three vertically centered horizontal dots).</ahelp> Command for the <emph>Commands</emph> window: <emph>dotsaxis</emph>"
msgstr "<ahelp hid=\"HID_SMA_DOTSAXIS\">Med den här ikonen infogas en axelellips (tre vertikalt centrerade horisontella punkter).</ahelp> Kommando för <emph>Kommando </emph>-fönstret: <emph>dotsaxis</emph>"

