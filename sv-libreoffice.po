msgstr "<variable id=\"insert_graphic_scan\"><link href=\"text/swriter/guide/insert_graphic_scan.xhp\">Infoga ett grafikobjekt med skanner</link></variable>"

#. from libreoffice:swriter-guide
msgid "To insert a scanned image, the scanner must be connected to your system and the scanner software drivers must be installed."
msgstr "Om du vill infoga en skannad bild måste skannern vara ansluten till systemet och drivrutiner för skannern måste vara installerade."

#. from libreoffice:swriter-guide
msgid "Click in the document where you want to insert the scanned image."
msgstr "Klicka i dokumentet där du vill infoga den skannade bilden."

#. from libreoffice:swriter-guide
msgid "Follow the scanning instructions."
msgstr "Följ anvisningarna för skanningen."

