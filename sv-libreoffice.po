msgstr "Används för att ändra ett definierat utskriftsområde."

#. from libreoffice:sc-messages
msgid "Print Range"
msgstr "Utskriftsområde"

#. from libreoffice:sc-messages
msgid "Choose one or more rows to print on every page. In the right text box enter the row reference, for example, \"1\" or \"$1\" or \"$2:$3\"."
msgstr "Välj en eller flera rader som ska skrivas ut på varje sida. Ange radreferensen i textrutan till höger, t.ex. \"1\" eller \"$1\" eller \"$2:$3\"."

#. from libreoffice:sc-messages
msgid "Rows to Repeat"
msgstr "Upprepa rader"

#. from libreoffice:sc-messages
msgid "- user defined -"
msgstr "- användardefinierat -"

#. from libreoffice:sc-messages
msgid "Choose one or more columns to print on every page. In the right text box enter the column reference, for example, \"A\" or \"AB\" or \"$C:$E\"."
msgstr "Välj en eller flera kolumner som ska skrivas ut på varje sida. I textrutan till höger skriver du in kolumnreferensen, till exempel \"A\" eller \"AB\" eller \"$C:$E\"."

#. from libreoffice:sc-messages
msgid "Columns to Repeat"
msgstr "Upprepa kolumner"

#. from libreoffice:sc-messages
msgid "Opens a dialog where you can specify the print range."
msgstr "Öppnar en dialogruta där du kan ange utskriftsområdet."

#. from libreoffice:sc-messages
msgid "Suppress output of empty pages"
msgstr "Undvik utmatning av tomma sidor"

#. from libreoffice:sc-messages
msgid "If checked, empty pages that have no cell contents or drawing objects are not printed."
msgstr "Om markerad, skrivs inte tomma sidor som inte har något cellinnehåll eller ritobjekt ut."

