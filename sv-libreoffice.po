#. from libreoffice:shared-autopi
msgid "<ahelp hid=\"modules/sabpilot/ui/defaultfieldselectionpage/defselectionfield\" visibility=\"visible\">Select the option field that you want to have as the default when opening the form.</ahelp>"
msgstr "<ahelp hid=\"modules/sabpilot/ui/defaultfieldselectionpage/defselectionfield\" visibility=\"visible\">Välj det alternativfält som du vill ska markeras som standard när du öppnar formuläret.</ahelp>"

