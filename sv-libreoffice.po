msgid "<ahelp hid=\"HID_SMA_DOTSVERT\">This icon inserts a vertical ellipsis (three vertical dots).</ahelp> Command for the <emph>Commands</emph> window: <emph>dotsvert</emph>"
msgstr "<ahelp hid=\"HID_SMA_DOTSVERT\">Med den här ikonen infogas en vertikal ellips (tre vertikala punkter).</ahelp> Kommando för <emph>Kommando </emph>-fönstret: <emph>dotsvert</emph>"

