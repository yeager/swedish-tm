#. from libreoffice:sc-messages
msgid "Text Import"
msgstr "Textimport"

#. from libreoffice:sc-messages
msgid "Ch_aracter set:"
msgstr "_Teckenuppsättning:"

#. from libreoffice:sc-messages
msgid "_Locale:"
msgstr "_Språk:"

#. from libreoffice:sc-messages
msgid "From ro_w:"
msgstr "Från _rad:"

#. from libreoffice:sc-messages
msgid "Specifies the character set to be used in the imported file."
msgstr "Anger vilken teckenuppsättning som ska användas i den importerade filen."

#. from libreoffice:sc-messages
msgid "Determines how the number strings are imported."
msgstr "Avgör hur siffersträngar importeras."

#. from libreoffice:sc-messages
msgid "Specifies the row where you want to start the import."
msgstr "Anger den rad där du vill starta importen."

#. from libreoffice:sc-messages
msgid "_Fixed width"
msgstr "_Fast bredd"

#. from libreoffice:sc-messages
msgid "Separates fixed-width data (equal number of characters) into columns."
msgstr "Delar in data som är åtskilda med fast bredd (samma antal tecken) i kolumner."

#. from libreoffice:sc-messages
msgid "_Separated by"
msgstr "Delad"

#. from libreoffice:sc-messages
msgid "Select the separator used in your data."
msgstr "Välj den avgränsare som används i dina data."

#. from libreoffice:sc-messages
msgid "Detected"
msgstr "Upptäckte"

#. from libreoffice:sc-messages
msgid "Use detected separator."
msgstr "Välj upptäckt separator."

#. from libreoffice:sc-messages
msgid "_Tab"
msgstr "Tabu_lator"

#. from libreoffice:sc-messages
msgid "Separates data delimited by tabs into columns."
msgstr "Delar in data som är avgränsade med tabbar i kolumner."

#. from libreoffice:sc-messages
msgid "Merge _delimiters"
msgstr "Sammanfatta f_ältavgränsare"

#. from libreoffice:sc-messages
msgid "Combines consecutive delimiters and removes blank data fields."
msgstr "Kombinerar flera avgränsare till en enda och tar bort tomma datafält."

#. from libreoffice:sc-messages
msgid "Tr_im spaces"
msgstr "Tr_imma mellanrum"

#. from libreoffice:sc-messages
msgid "Removes starting and trailing spaces from data fields."
msgstr "Tar bort start- och avslutande mellanslag från datafält."

#. from libreoffice:sc-messages
msgid "_Comma"
msgstr "_Komma"

#. from libreoffice:sc-messages
msgid "Separates data delimited by commas into columns."
msgstr "Delar in data som är avgränsade med kommatecken i kolumner."

#. from libreoffice:sc-messages
msgid "S_emicolon"
msgstr "_Semikolon"

#. from libreoffice:sc-messages
msgid "Separates data delimited by semicolons into columns."
msgstr "Delar in data som är avgränsade med semikolon i kolumner."

#. from libreoffice:sc-messages
msgid "S_pace"
msgstr "_Blanksteg"

#. from libreoffice:sc-messages
msgid "Separates data delimited by spaces into columns."
msgstr "Delar in data som är avgränsade med blanksteg i kolumner."

#. from libreoffice:sc-messages
msgid "Othe_r"
msgstr "And_ra"

#. from libreoffice:sc-messages
msgid "Separates data into columns using the custom separator that you specify. Note: The custom separator must also be contained in your data."
msgstr "Separerar data i kolumner med hjälp av den anpassade avgränsare som du anger. Obs: Den anpassade avgränsaren måste också finnas i dina data."

#. from libreoffice:sc-messages
msgid "Strin_g delimiter:"
msgstr "Strän_gavgränsare:"

#. from libreoffice:sc-messages
msgid "Select a character to delimit text data. You can also enter a character in the text box."
msgstr "Välj ett tecken för att avgränsa textdata. Du kan också skriva in ett tecken i textrutan."

#. from libreoffice:sc-messages
msgid "Separator Options"
msgstr "Delningsalternativ"

#. from libreoffice:sc-messages
msgid "Format _quoted field as text"
msgstr "Formatera _citatfält som text"

#. from libreoffice:sc-messages
msgid "When this option is enabled, fields or cells whose values are quoted in their entirety (the first and last characters of the value equal the text delimiter) are imported as text."
msgstr "När detta alternativ är aktivt importeras fält eller celler, vars värden är inom citattecken (första och sista tecknet av värdet är lika med skiljetecknet), som text."

#. from libreoffice:sc-messages
msgid "Detect special _numbers"
msgstr "Identifiera specialtal"

#. from libreoffice:sc-messages
msgid "When this option is enabled, Calc will automatically detect all number formats, including special number formats such as dates, time, and scientific notation."
msgstr "Calc kommer automatiskt att identifiera talformat som datum tid och vetenskaplig notation när detta alternativ är markerat."

#. from libreoffice:sc-messages
msgid "E_valuate formulas"
msgstr "U_tvärdera formler"

#. from libreoffice:sc-messages
msgid "If enabled, cells starting with '=' will be evaluated as formulas."
msgstr "Om det är aktiverat kommer celler som börjar med '=' att utvärderas som formler."

#. from libreoffice:sc-messages
msgid "When this option is enabled, cell content starting with an '=' equal sign is evaluated as formula expression. Otherwise, content is imported as text."
msgstr "När det här alternativet är aktiverat utvärderas cellinnehåll som börjar med ett \"=\" likhetstecken som formeluttryck. Annars importeras innehållet som text."

#. from libreoffice:sc-messages
msgid "S_kip empty cells"
msgstr "Hoppa _över tomma celler"

#. from libreoffice:sc-messages
msgid "If enabled, blank cells in source will not override the target."
msgstr "Om aktiverat, kommer tomma celler i källan inte att åsidosätta målet."

#. from libreoffice:sc-messages
msgid "When this option is enabled, Calc preserves previous content of cells when pasting empty ones. Otherwise, Calc deletes content of previous cells."
msgstr "När det här alternativet är aktiverat bevarar Calc tidigare innehåll i celler när tomma celler klistras in. Annars tar Calc bort innehållet i tidigare celler."

#. from libreoffice:sc-messages
msgid "Detect scientific n_otation"
msgstr "Upptäck vetenskaplig n_otation"

#. from libreoffice:sc-messages
msgid "When this option is enabled, Calc will automatically detect numbers in scientific notation in addition to basic decimal numbers."
msgstr "När det här alternativet är aktiverat kommer Calc automatiskt att upptäcka siffror i vetenskaplig notation utöver grundläggande decimaltal."

#. from libreoffice:sc-messages
msgid "Other Options"
msgstr "Övriga alternativ"

#. from libreoffice:sc-messages
msgid "Column t_ype:"
msgstr "Kolumnt_yp:"

#. from libreoffice:sc-messages
msgid "Choose a column in the preview window and select the data type to be applied the imported data."
msgstr "Markera en kolumn i förhandsgranskningsfönstret och välj den datatyp som data ska importeras i."

#. from libreoffice:sc-messages
msgid "Column break positions"
msgstr "Kolumnbrytningspositioner"

#. from libreoffice:sc-messages
msgid "Data preview"
msgstr "Förhandsgranskning av data"

#. from libreoffice:sc-messages
msgid "Text to Columns"
msgstr "Text till kolumner"

#. from libreoffice:sc-messages
msgid "_Always show on import"
msgstr "_Visa alltid vid import"

#. from libreoffice:sc-messages
msgid "Sets the import options for delimited data."
msgstr "Ställer in importalternativen för data som är avgränsad."

#. from libreoffice:sc-messages
msgid "Import Options"
msgstr "Importalternativ"

#. from libreoffice:sc-messages
msgid "Select the Locale to Use for Import"
msgstr "Välj det språk som ska användas för import"

#. from libreoffice:sc-messages
msgid "Detect special numbers (such as dates)"
msgstr "Identifiera specialtal (exempelvis datum)"

#. from libreoffice:sc-messages
msgid "Detect numbers with _scientific notation"
msgstr "Upptäck siffror med vetenskaplig notation"

#. from libreoffice:sc-messages
msgid "Text Transformation"
msgstr "Texttransformering"

#. from libreoffice:sc-messages
msgid "To Lower"
msgstr "Till gemener"

#. from libreoffice:sc-messages
msgid "To Upper"
msgstr "Till versaler"

#. from libreoffice:sc-messages
msgid "Capitalize"
msgstr "Kapitalisera"

#. from libreoffice:sc-messages
msgid "Trim"
msgstr "Trimma"

#. from libreoffice:sc-messages
msgid "Cols(; Separated)"
msgstr "Kolumner(; Separerade)"

#. from libreoffice:sc-messages
msgid "List of column indexes to perform the text transformation, separated by semicolons."
msgstr "Lista över kolumnindex för att utföra textomvandlingen, separerade med semikolon."

#. from libreoffice:sc-messages
msgid "_Formulas"
msgstr "_Formler"

#. from libreoffice:sc-messages
msgid "Specifies whether to show formulas instead of results in the cells."
msgstr "Anger om formler ska visas i cellerna istället för dess resultat."

#. from libreoffice:sc-messages
msgid "Zero val_ues"
msgstr "_Nollvärden"

#. from libreoffice:sc-messages
msgid "Specifies whether to show numbers with the value of 0."
msgstr "Anger om siffror med värdet 0 ska visas."

#. from libreoffice:sc-messages
msgid "_Comment indicator"
msgstr "~Indikator för kommentar"

#. from libreoffice:sc-messages
msgid "Specifies that a small triangle in the top right corner of the cell indicates that a comment exists."
msgstr "Anger att en liten triangel i det övre högra hörnet av cellen indikerar att det finns en kommentar."

#. from libreoffice:sc-messages
msgid "_Formula indicator and hint"
msgstr "_Formelindikator och tips"

#. from libreoffice:sc-messages
msgid "Draws a blue triangle in the bottom-left corner of a cell that contains a formula. When pointing over the blue triangle, the formula is shown in a tool tip even if a different cell is selected."
msgstr "Ritar en blå triangel i det nedre vänstra hörnet av en cell som innehåller en formel. När du pekar över den blå triangeln visas formeln i ett verktygstips även om en annan cell är markerad."

#. from libreoffice:sc-messages
msgid "Value h_ighlighting"
msgstr "Framhäv _värden"

#. from libreoffice:sc-messages
msgid "Mark the Value highlighting box to show the cell contents in different colors, depending on type. Text cells are formatted in black, formulas in green, number cells in blue, and protected cells are shown with light grey background, no matter how their display is formatted."
msgstr "Markera rutan Framhäv värden om du vill visa cellinnehåll med olika färger beroende på dess typ. Textceller visas i svart, formler i grönt och sifferceller i blått. Skyddade celler visas alltid med en ljusgrå bakgrund oavsett hur deras visning är formaterad."

#. from libreoffice:sc-messages
msgid "_Show references in color"
msgstr "Visa _referenser i färg"

#. from libreoffice:sc-messages
msgid "Specifies that each reference is highlighted in color in the formula. The cell range is also enclosed by a colored border as soon as the cell containing the reference is selected for editing."
msgstr "Anger att varje referens markeras med en färg i formeln. Cellområdet markeras också med en färgad ram när den cell som innehåller referensen redigeras."

#. from libreoffice:sc-messages
msgid "_Anchor"
msgstr "Ankare"

#. from libreoffice:sc-messages
msgid "Specifies whether the anchor icon is displayed when an inserted object, such as a graphic, is selected."
msgstr "Anger om förankringsikonen visas när ett infogat objekt, t.ex. ett grafiskt objekt, markeras."

#. from libreoffice:sc-messages
msgid "Column/Row highlighting"
msgstr "Kolumn/radmarkering"

#. from libreoffice:sc-messages
msgid "Mark the Column/row highlighting box to show row/column highlighting for the row and column of the active cell."
msgstr "Markera rutan kolumn/radmarkering för att visa rad/kolumnmarkering för raden och kolumnen i den aktiva cellen."

#. from libreoffice:sc-messages
msgid "Highlight cell in edit mode"
msgstr "Markera cell i redigeringsläge"

#. from libreoffice:sc-messages
msgid "Mark this box to show highlighted background when the cell is in edit mode."
msgstr "Markera den här rutan för att visa markerad bakgrund när cellen är i redigeringsläge."

#. from libreoffice:sc-messages
msgid "Comment authorship"
msgstr "Författarskap för kommentarer"

#. from libreoffice:sc-messages
msgid "Specifies whether the author of the comment is displayed above the comment."
msgstr "Anger om författaren till kommentaren visas ovanför kommentaren."

#. from libreoffice:sc-messages
msgid "Colu_mn/row headers"
msgstr "Kolu_mn- och radhuvuden"

#. from libreoffice:sc-messages
msgid "Specifies whether to display row and column headers."
msgstr "Anger ifall rad- och kolumnhuvuden ska visas."

#. from libreoffice:sc-messages
msgid "Hori_zontal scroll bar"
msgstr "Horisontell r~ullningslist"

#. from libreoffice:sc-messages
msgid "Specifies whether to display a horizontal scrollbar at the bottom of the document window."
msgstr "Anger om en rullningslist ska visas till höger i dokumentfönstret."

#. from libreoffice:sc-messages
msgid "_Vertical scroll bar"
msgstr "Vertika_l rullningslist"

#. from libreoffice:sc-messages
msgid "Specifies whether to display a vertical scrollbar at the right of the document window."
