msgstr "<image src=\"res/sc06301.png\" id=\"img_id3149026\" width=\"1cm\" height=\"1cm\"><alt id=\"alt_id3149026\">Hoppa till föregående skript ikon</alt></image>"

#. from libreoffice:swriter-00
msgid "Jump to Previous Script"
msgstr "Hoppa till föregående skript"

#. from libreoffice:swriter-00
msgid "<image src=\"res/sc06300.png\" id=\"img_id3151272\" width=\"1cm\" height=\"1cm\"><alt id=\"alt_id3151272\"> Jump to Next Script Icon</alt></image>"
msgstr "<image src=\"res/sc06300.png\" id=\"img_id3151272\" width=\"1cm\" height=\"1cm\"><alt id=\"alt_id3151272\"> Hoppa till nästa skript ikon</alt></image>"

#. from libreoffice:swriter-00
msgid "Jump to Next Script"
msgstr "Hoppa till nästa skript"

#. from libreoffice:swriter-00
msgid "<variable id=\"exportdoc\">Menu <emph>File - Export</emph></variable>"
msgstr "<variable id=\"exportdoc\">Menyn <emph>Arkiv - Exportera</emph></variable>."

#. from libreoffice:swriter-00
msgid "Choose <menuitem>File - Send - Outline to Clipboard</menuitem>"
msgstr "Välj <menuitem>Arkiv - Skicka - Disposition till urklippet</menuitem>"

