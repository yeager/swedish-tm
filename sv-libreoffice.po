msgstr "Kontrollpunkt 1"

#. from libreoffice:cui-messages
msgid "_Radius:"
msgstr "_Radie:"

#. from libreoffice:cui-messages
msgid "Enter the radius of the circle that you want to use to round the corners."
msgstr "Ange den cirkelradie du vill använda för att runda hörnen."

#. from libreoffice:cui-messages
msgid "Corner Radius"
msgstr "Hörnradie"

