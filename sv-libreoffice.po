msgid "%TITLE - %FILENAME - %PRODUCTNAME"
msgstr "%TITLE - %FILENAME - %PRODUCTNAME"

#. from libreoffice:uui-messages
msgid "Document file '$(ARG1)' is locked for editing by yourself on a different system since $(ARG2)\n\nOpen document read-only, or ignore own file locking and open the document for editing.\nSelect Notify to open read-only and get notified when the document becomes editable."
msgstr "Dokumentfilen '$(ARG1)' är låst för redigering av dig själv på ett annat system sedan $(ARG2)\n\nÖppna skrivskyddad dokument eller ignorera egen fillåsning och öppna dokumentet för redigering.\nVälj \"Meddela mig\" för att öppna skrivskyddet och få avisering när dokumentet kan redigeras."

