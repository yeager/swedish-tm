msgstr "Fyll ett cellområde med automatiskt genererade pseudoslumptal med den valda fördelningsfunktionen och dess parametrar."

#. from libreoffice:sc-messages
msgid "Always perform this without prompt in the future."
msgstr "Utför alltid detta utan bekräftelse i framtiden."

#. from libreoffice:sc-messages
msgid "Regression"
msgstr "Regression"

#. from libreoffice:sc-messages
msgid "Independent variable(s) (X) range:"
msgstr "Oberoende variabel(er) (X) område:"

