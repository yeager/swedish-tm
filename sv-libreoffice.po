msgstr "Windows certifikathanterare / CertMgr (X.509)"

#. from libreoffice:xmlsecurity-messages
msgid "NSS Certificate DB in the Mozilla Profile (X.509) at:\n"
msgstr "NSS-certifikat DB i Mozilla-profilen (X.509) på:\n"

#. from libreoffice:xmlsecurity-messages
msgid "Macro security problem!\n\nBroken certificate data: %{data}"
msgstr "Makro säkerhetsproblem!\n\nTrasig certifikatdata: %{data}"

#. from libreoffice:xmlsecurity-messages
msgid "Reload the file to apply the new macro security level"
msgstr "Ladda om filen för att tillämpa den nya makrosäkerhetsnivån"

#. from libreoffice:xmlsecurity-messages
msgid "Security warning: the following OpenPGP public key is untrusted:\n\n%{data}\n\nEncrypting with an untrusted public key increases the risk of a \"man-in-the-middle\" attack. A successful \"man-in-the-middle\" attack gives malicious third parties the ability to decrypt your document.\n\nDo you really want to encrypt your document with this untrusted public key?"
msgstr "Säkerhetsvarning: följande publika OpenPGP-nyckel är otillförlitlig:\n\n%{data}\n\nKryptering med en opålitlig publik nyckel ökar risken för en \"man-in-the-middle\"-attack. En framgångsrik \"man-in-the-middle\"-attack ger illvilliga tredje parter möjligheten att dekryptera ditt dokument.\n\nVill du verkligen kryptera ditt dokument med denna opålitliga publika nyckel?"

#. from libreoffice:xmlsecurity-messages
msgid "Use the value list box to view values and copy them to the clipboard."
msgstr "Använd värdelistrutan om du vill visa värdena och kopiera dem till Urklipp."

#. from libreoffice:xmlsecurity-messages
msgid "The Details page of the View Certificate dialog displays detailed information about the certificate."
msgstr "Sidan Detaljer i dialogrutan Visa certifikat visar detaljerad information om certifikatet."

#. from libreoffice:xmlsecurity-messages
msgid "Certificate Information"
msgstr "Certifikatinformation"

#. from libreoffice:xmlsecurity-messages
msgid "The General page of the View Certificate dialog displays basic information about the certificate."
msgstr "Sidan Allmänt i dialogrutan Visa certifikat visar grundläggande information om certifikatet."

#. from libreoffice:xmlsecurity-messages
msgid "This certificate is validated."
msgstr "Certifikatet är validerat."

#. from libreoffice:xmlsecurity-messages
msgid "Issued to: "
msgstr "Utfärdat till: "

#. from libreoffice:xmlsecurity-messages
msgid "Issued by: "
msgstr "Utfärdat av: "

#. from libreoffice:xmlsecurity-messages
msgid "Valid from:"
msgstr "Giltigt från:"

#. from libreoffice:xmlsecurity-messages
msgid "You have a private key that corresponds to this certificate."
msgstr "Du har en privat nyckel som motsvarar det här certifikatet."

#. from libreoffice:xmlsecurity-messages
msgid "Valid to:"
msgstr "Giltigt till:"

#. from libreoffice:xmlsecurity-messages
msgid "Key type: "
msgstr "Nyckeltyp: "

#. from libreoffice:xmlsecurity-messages
msgid "Certificate status"
msgstr "Certifikatstatus"

#. from libreoffice:xmlsecurity-messages
msgid "The certificate is OK."
msgstr "Certifikatet är OK."

#. from libreoffice:xmlsecurity-messages
msgid "The certificate could not be validated."
msgstr "Certifikatet kunde inte valideras."

#. from libreoffice:xmlsecurity-messages
msgid "The Certificate Path page of the View Certificate dialog displays the location and the status of the certificate."
msgstr "Sidan Sökväg för certifikat i dialogrutan Visa certifikat visar var certifikatet finns och dess status."

#. from libreoffice:xmlsecurity-messages
msgid "The following have signed the document content: "
msgstr "Följande har signerat dokumentets innehåll: "

#. from libreoffice:xmlsecurity-messages
msgid "Signed by "
msgstr "Signerad av "

#. from libreoffice:xmlsecurity-messages
msgid "Digital ID issued by "
msgstr "Digitalt ID utfärdat av "

#. from libreoffice:xmlsecurity-messages
msgid "Signature type"
msgstr "Signaturtyp"

#. from libreoffice:xmlsecurity-messages
msgid "Lists the digital signatures for the current document."
msgstr "Visar digitala signaturer för det aktuella dokumentet."

#. from libreoffice:xmlsecurity-messages
msgid "Opens the View Certificate dialog."
msgstr "Öppnar dialogrutan Visa certifikat."

#. from libreoffice:xmlsecurity-messages
msgid "Sign Document..."
msgstr "Signera dokument..."

#. from libreoffice:xmlsecurity-messages
msgid "Opens the Select Certificate dialog."
msgstr "Öppnar dialogrutan Välj certifikat."

#. from libreoffice:xmlsecurity-messages
msgid "Removes the selected signature from the list. Removes all subsequent signatures as well, in case of PDF."
msgstr "Tar bort den valda signaturen från listan. Tar bort alla efterföljande signaturer i händelse av PDF."

#. from libreoffice:xmlsecurity-messages
msgid "The following have signed the document macro:"
msgstr "Följande har signerat dokumentets makro:"

#. from libreoffice:xmlsecurity-messages
msgid "The signatures in this document are valid"
msgstr "Signaturerna i det här dokument är giltiga"

#. from libreoffice:xmlsecurity-messages
msgid "The signatures in this document are invalid"
msgstr "Signaturerna i det här dokumentet är ogiltiga"

#. from libreoffice:xmlsecurity-messages
msgid "Adds and removes digital signatures to and from your document. You can also use the dialog to view certificates."
msgstr "Lägger till och tar bort digitala signaturer till dina dokument. Du kan också visa certifikat i den."

#. from libreoffice:xmlsecurity-messages
msgid "_Low (not recommended).\nAll macros will be executed without confirmation.\nUse this setting only if you are certain that all documents that will be opened are safe."
msgstr "_Låg (rekommenderas inte).\nAlla makron körs utan bekräftelse.\nAnvänd bara den här inställningen om du är säker på att alla dokument som öppnas är säkra."

#. from libreoffice:xmlsecurity-messages
msgid "A macro can be set to auto-start, and it can perform potentially damaging actions, as for example delete or rename files. This setting is not recommended when you open documents from other authors."
msgstr "Ett makro kan vara inställt att starta automatiskt, och kan utföra åtgärder som kan vara skadliga, som att ta bort eller byta namn på filer. Inställningen rekommenderas inte när du öppnar dokument som andra har skapat."

#. from libreoffice:xmlsecurity-messages
msgid "_Medium.\nConfirmation required before executing macros from untrusted sources."
msgstr "_Medel.\nDu måste bekräfta innan du kan köra makron från icke-betrodda källor."

#. from libreoffice:xmlsecurity-messages
msgid "Trusted sources can be set on the Trusted Sources tab page. Signed macros from a trusted source are allowed to run. In addition, any macro from a trusted file location is allowed to run. All other macros require your confirmation."
msgstr "Tillförlitliga källor kan ställas in på fliken Tillförlitliga källor. Signerade makron från tillförlitliga källor får köras. Dessutom får alla makron från en tillförlitlig filplats köras. För alla andra makron krävs ditt godkännande."

#. from libreoffice:xmlsecurity-messages
msgid "H_igh.\nOnly signed macros and macros from trusted file locations are executed.\nUnsigned macros are disabled."
msgstr "_Hög.\nEndast signerade makron och makron från betrodda filplatser exekveras.\nOsignerade makron är inaktiverade."

#. from libreoffice:xmlsecurity-messages
msgid "Only signed macros or macros from a trusted file location are allowed to run. Macros signed with untrusted certificates will require confirmation to run, when located in untrusted file locations. Trusted certificates and trusted file locations can be set on the Trusted Sources tab page."
msgstr "Endast signerade makron eller makron från en betrodd filplats får köras. Makron signerade med opålitliga certifikat kräver bekräftelse för att köras, när de finns på opålitliga filplatser. Betrodda certifikat och betrodda filplatser kan ställas in på fliken Betrodda källor."

#. from libreoffice:xmlsecurity-messages
msgid "_Very high.\nOnly macros from trusted file locations are allowed to run.\nAll other macros, regardless whether signed or not, are disabled."
msgstr "_Mycket hög.\nDet går bara att köra makron från betrodda källor.\nAlla andra makron inaktiveras, oavsett vem som har signerat dem."

#. from libreoffice:xmlsecurity-messages
msgid "Trusted file locations can be set on the Trusted Sources tab page. Any macro from a trusted file location is allowed to run."
msgstr "Tillförlitliga filplatser kan ställas in på fliken Tillförlitliga källor. Alla makron från en tillförlitlig filplats tillåts köras."

#. from libreoffice:xmlsecurity-messages
msgid "Very high security level"
msgstr "Mycket hög säkerhetsnivå"

#. from libreoffice:xmlsecurity-messages
msgid "High security level"
msgstr "Hög säkerhetsnivå"

#. from libreoffice:xmlsecurity-messages
msgid "Medium security level"
msgstr "Medium säkerhetsnivå"

#. from libreoffice:xmlsecurity-messages
msgid "Low security level"
msgstr "Låg säkerhetsnivå"

#. from libreoffice:xmlsecurity-messages
msgid "File reload needed"
msgstr "Filen måste laddas om"

#. from libreoffice:xmlsecurity-messages
msgid "_View..."
msgstr "_Visa..."

