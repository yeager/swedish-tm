msgid "<variable id=\"redlining_navigation\"><link href=\"text/shared/guide/redlining_navigation.xhp\">Navigating Changes</link></variable>"
msgstr "<variable id=\"redlining_navigation\"><link href=\"text/shared/guide/redlining_navigation.xhp\">Navigera mellan ändringar</link></variable>"

#. from libreoffice:shared-guide
msgid "This feature is Writer-specific."
msgstr "Denna funktion är Writer-specifik."

#. from libreoffice:shared-guide
