msgid "A_uto"
msgstr "A_utomatiskt"

#. from libreoffice:sw-messages
msgid "By w_ord"
msgstr "Efter _ord"

#. from libreoffice:sw-messages
msgid "By _character"
msgstr "Efter _tecken"

#. from libreoffice:sw-messages
msgid "Compare Documents"
msgstr "Jämför dokument"

#. from libreoffice:sw-messages
msgid "Take it into account when comparing"
msgstr "Ta hänsyn till detta vid jämförelse"

#. from libreoffice:sw-messages
msgid "Store it when changing the document"
msgstr "Spara det när dokumentet ändras"

#. from libreoffice:sw-messages
msgid "Random number to improve accuracy of document comparison"
msgstr "Slumpmässiga tal för att öka precisionen hos dokumentjämförelsen"

#. from libreoffice:sw-messages
msgid "Use as _Default"
msgstr "Använd som förval"

#. from libreoffice:sw-messages
msgid "Click to use the current settings on this tab page as the default for further sessions with Writer."
msgstr "Klicka för att använda de aktuella inställningarna på den här fliksidan som standard för ytterligare sessioner med Writer."

#. from libreoffice:sw-messages
msgid "Compatibility options for “%DOCNAME”"
msgstr "Kompatibilitetsalternativ för \"%DOCNAME\""

#. from libreoffice:sw-messages
msgid "Specifies compatibility settings for text documents. These options help in fine-tuning Writer when importing Microsoft Word documents."
msgstr "Anger kompatibilitetsinställningar för textdokument. Dessa alternativ hjälper till att finjustera Writer vid import av Microsoft Word-dokument."

#. from libreoffice:sw-messages
msgid "De_fault:"
msgstr "Standardformatmall:"

#. from libreoffice:sw-messages
msgid "Headin_g:"
msgstr "Rubrik:"

