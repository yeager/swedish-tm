msgstr "<variable id=\"math_keys\"><link href=\"text/smath/04/01020000.xhp\">Kortkommandon för formler</link></variable>"

#. from libreoffice:smath-04
msgid "A list of the shortcut keys specific to creating formulas is contained in this section."
msgstr "Här hittar du tangentkombinationer som kan förenkla arbetet med formeldokument."

