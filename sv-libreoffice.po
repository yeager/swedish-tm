msgid "Values of the inverse of CHISQ.DIST(x;DegreesOfFreedom;TRUE())."
msgstr "Värden för inversen av CHI2.FÖRD(x;frihetsgrader;SANT())."

#. from libreoffice:sc-messages
msgid "Probability"
msgstr "Sannolikhet"

#. from libreoffice:sc-messages
msgid "The probability value for which the inverse of the chi square distribution is to be calculated."
msgstr "Sannolikhetsvärdet för vilket inversen av Chi2-fördelningen ska beräknas."

