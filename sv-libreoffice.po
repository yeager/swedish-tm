#. from libreoffice:shared-05
msgid "Local language support pages"
msgstr "Supportsidor på lokala språk"

#. from libreoffice:shared-05
msgid "Mailing lists"
msgstr "E-postlistor"

#. from libreoffice:shared-05
msgid "Forum"
msgstr "Forum"

