#. from libreoffice:sc-messages
msgid "Data 2"
msgstr "Data 2"

#. from libreoffice:sc-messages
msgid "The second record array."
msgstr "Den andra datapostens matris."

#. from libreoffice:sc-messages
msgid "Calculates future value(s) using additive Exponential Smoothing algorithm."
msgstr "Beräknar framtida värde(n) med hjälp av additiv exponentiell utjämningsalgoritm."

#. from libreoffice:sc-messages
msgid "Calculates future value(s) using multiplicative Exponential Smoothing algorithm."
msgstr "Beräknar framtida värde(n) med hjälp av multiplikativ exponentiell utjämningsalgoritm."

#. from libreoffice:sc-messages
msgid "Returns a prediction interval at the specified target value(s) for additive Exponential Smoothing method"
msgstr "Returnerar ett prediktionsintervall vid det (de) angivna målvärdet (värdena) för additiv exponentiell utjämningsmetod"

#. from libreoffice:sc-messages
msgid "Returns a prediction interval at the specified target value(s) for multiplicative Exponential Smoothing method"
msgstr "Returnerar ett prediktionsintervall vid det (de) angivna målvärdet (värdena) för multiplikativ exponentiell utjämningsmetod"

#. from libreoffice:sc-messages
msgid "Target"
msgstr "~Mål"

#. from libreoffice:sc-messages
msgid "The date (array) for which you want to predict a value."
msgstr "Datumet (matris) för vilket du vill förutsäga ett värde."

#. from libreoffice:sc-messages
msgid "Confidence level (default 0.95); value 0 to 1 (exclusive) for 0 to 100% calculated prediction interval."
msgstr "Konfidensnivå (standard 0,95); värde 0 till 1 (exklusivt) för 0 till 100% beräknat prediktionsintervall."

