msgstr "Byt namn på dialog"

#. from libreoffice:cui-messages
msgid "Please enter a name to rename the dialog:"
msgstr "Ange ett namn för att byta namn på dialogen:"

#. from libreoffice:cui-messages
msgid "Rename Macro"
msgstr "Byt namn på makro"

#. from libreoffice:cui-messages
msgid "Please enter a name to rename the macro:"
