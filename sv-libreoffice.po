msgstr "<variable id=\"number_date_conv\"><link href=\"text/swriter/guide/number_date_conv.xhp\">Stänga av taligenkänning i tabeller</link></variable>"

#. from libreoffice:swriter-guide
msgid "Defining Number Ranges"
msgstr "Definiera nummersekvenser"

#. from libreoffice:swriter-guide
msgid "<bookmark_value>numbering;quotations/similar items</bookmark_value>"
msgstr "<bookmark_value>Numrering;citattecken/liknande objekt</bookmark_value>"

#. from libreoffice:swriter-guide
msgid "<variable id=\"number_sequence\"><link href=\"text/swriter/guide/number_sequence.xhp\">Defining Number Ranges</link></variable>"
msgstr "<variable id=\"number_sequence\"><link href=\"text/swriter/guide/number_sequence.xhp\">Definiera nummersekvenser</link></variable>"

#. from libreoffice:swriter-guide
msgid "You can automatically number similar items, such as quotations, in your document."
msgstr "Du kan numrera liknande objekt automatiskt i dokumentet, t.ex. citat."

#. from libreoffice:swriter-guide
msgid "Type the text that you want to assign numbering to, for example, \"Quotation Number \"."
msgstr "Skriv texten som du vill numrera, t.ex. \"Citat nr \"."

#. from libreoffice:swriter-guide
msgid "Choose <item type=\"menuitem\">Insert - Field - More Fields</item>, and then click the <item type=\"menuitem\">Variables</item> tab."
msgstr "Välj <item type=\"menuitem\">Infoga - Fältkommandon - Andra</item> och klicka sedan på fliken <item type=\"menuitem\">Variabler</item>."

#. from libreoffice:swriter-guide
msgid "Click \"Number range\" in the <item type=\"menuitem\">Type</item> list."
msgstr "Klicka på \"Nummersekvens\" i listan <item type=\"menuitem\">Fälttyp</item>               ."

#. from libreoffice:swriter-guide
msgid "Type \"Quotation\" in the <item type=\"menuitem\">Name</item> box."
msgstr "Skriv \"Citat\" i rutan <item type=\"menuitem\">Namn</item>               ."

#. from libreoffice:swriter-guide
msgid "Type a number in the <emph>Value</emph> box, or leave the box empty to use automatic numbering."
msgstr "Skriv in ett nummer i rutan <emph>Värde</emph> eller lämna den tom för automatisk numrering."

#. from libreoffice:swriter-guide
msgid "Select the outline level where you want the numbering to restart in the <emph>Level </emph>box."
msgstr "Ange hur många gånger som animationen ska visas i rutan <emph>Antal omgångar</emph> (rutan till höger)."

#. from libreoffice:swriter-guide
msgid "Adding Line Numbers"
msgstr "Lägga till radnummer"

#. from libreoffice:swriter-guide
msgid "<variable id=\"numbering_lines\"><link href=\"text/swriter/guide/numbering_lines.xhp\">Adding Line Numbers</link></variable>"
msgstr "<variable id=\"numbering_lines\"><link href=\"text/swriter/guide/numbering_lines.xhp\">Lägga till radnummer</link></variable>"

#. from libreoffice:swriter-guide
msgid "$[officename] can insert line numbers in an entire document or to selected paragraphs in your document. Line numbers are included when you print your document. You can specify the line numbering interval, the starting line number, and whether to count blank lines or lines in frames. You can also add a separator between line numbers."
msgstr "$[officename] innehåller en automatisk räknefunktion som lägger till radnummer för rader i ett helt dokument eller för markerade stycken i dokumentet. Radnummer inkluderas när du skriver ut dokumentet. Du kan ange radnummerintervall, vilket nummer som numreringen ska börja med och om tomma rader eller rader i ramar ska räknas. Du kan även lägga till en avgränsare mellan radnumren."

#. from libreoffice:swriter-guide
msgid "To Add Line Numbers to an Entire Document"
msgstr "Så här lägger du till radnumrering för ett helt dokument"

#. from libreoffice:swriter-guide
msgid "Select <emph>Show numbering</emph>, and then select the options that you want."
msgstr "Markera <emph>Numrering på</emph> och markera sedan alternativen som du vill använda."

#. from libreoffice:swriter-guide
msgid "To Add Line Numbers to Specific Paragraphs"
msgstr "Så här lägger du till radnumrering för vissa stycken"

#. from libreoffice:swriter-guide
msgid "Choose <emph>Tools - Line Numbering</emph>."
msgstr "Välj <emph>Verktyg - Radnumrering</emph>."

#. from libreoffice:swriter-guide
msgid "Select <emph>Show numbering</emph>."
msgstr "Markera <emph>Numrering på</emph>."

#. from libreoffice:swriter-guide
msgid "Right-click the \"Default\" paragraph style and choose <emph>Modify</emph>."
msgstr "Högerklicka på styckeformatmallen \"Standard\" och välj <emph>Ändra</emph>."

#. from libreoffice:swriter-guide
msgid "All paragraph styles are based on the \"Default\" style."
msgstr "Alla styckeformatmallar baseras på mallen \"Standard\"."

#. from libreoffice:swriter-guide
msgid "In the <item type=\"menuitem\">Line Numbering</item> area, clear the <item type=\"menuitem\">Include this paragraph in line numbering</item> check box."
msgstr "Avmarkera kryssrutan <item type=\"menuitem\">Räkna med raderna i det här stycket</item>                under <item type=\"menuitem\">Radnumrering</item>               ."

#. from libreoffice:swriter-guide
msgid "Select the paragraph(s) where you want to add the line numbers."
msgstr "Markera stycket eller styckena där du vill lägga till radnumren."

#. from libreoffice:swriter-guide
msgid "Select <emph>Include this paragraph in line numbering</emph>."
msgstr "Markera <emph>Räkna med raderna i det här stycket</emph>."

#. from libreoffice:swriter-guide
msgid "You can also create a paragraph style that includes line numbering, and apply it to the paragraphs that you want to add line numbers to."
msgstr "Du kan även skapa en styckeformatmall som inkluderar radnumrering och använda den för stycken som du vill lägga till radnummer för."

#. from libreoffice:swriter-guide
msgid "To Specify the Starting Line Number"
msgstr "Så här anger du vilket nummer som numreringen ska börja med"

#. from libreoffice:swriter-guide
msgid "Click in a paragraph."
msgstr "Klicka i ett stycke."

#. from libreoffice:swriter-guide
msgid "Select the <item type=\"menuitem\">Include this paragraph in line numbering</item> check box."
msgstr "Markera kryssrutan <item type=\"menuitem\">Räkna med raderna i det här stycket</item>               ."

#. from libreoffice:swriter-guide
msgid "Select <item type=\"menuitem\">Restart at the paragraph</item> check box."
msgstr "Markera kryssrutan <item type=\"menuitem\">Börja om vid det här stycket</item>               ."

#. from libreoffice:swriter-guide
msgid "Enter a line number in the <item type=\"menuitem\">Start with</item> box."
msgstr "Ange ett radnummer i rutan <item type=\"menuitem\">Börja med</item>               ."

#. from libreoffice:swriter-guide
msgid "<link href=\"text/swriter/01/06180000.xhp\">Tools - Line Numbering</link>"
msgstr "<link href=\"text/swriter/01/06180000.xhp\">Verktyg - Radnumrering</link>"

#. from libreoffice:swriter-guide
msgid "Click in front of the first character of the paragraph that you want to remove the numbering from."
msgstr "Klicka framför det första tecknet i stycket som du vill ta bort numreringen från."

#. from libreoffice:swriter-guide
msgid "To remove the number while preserving the indent of the paragraph, press the Backspace key."
msgstr "Om du vill ändra hierarkinivå för en punkt i en lista klickar du framför stycket och trycker sedan på Tab-tangenten."

#. from libreoffice:swriter-guide
msgid "Inserting and Deleting Page Breaks"
msgstr "Infoga och radera sidbrytningar"

#. from libreoffice:swriter-guide
msgid "<variable id=\"page_break\"><link href=\"text/swriter/guide/page_break.xhp\">Inserting and Deleting Page Breaks</link></variable>"
msgstr "<variable id=\"page_break\"><link href=\"text/swriter/guide/page_break.xhp\">Infoga och radera sidbrytning</link></variable>"

#. from libreoffice:swriter-guide
msgid "To Insert a Manual Page Break"
msgstr "Så här infogar du en manuell sidbrytning"

#. from libreoffice:swriter-guide
msgid "Click in your document where you want the new page to begin."
msgstr "Klicka i dokumentet där du vill att den nya sidan ska börja."

#. from libreoffice:swriter-guide
msgid "To Delete a Manual Page Break"
msgstr "Så här tar du bort du en manuell sidbrytning"

#. from libreoffice:swriter-guide
msgid "Click in front of the first character on the page that follows the manual page break."
msgstr "Klicka framför det första tecknet på sidan som följer efter den manuella sidbrytningen."

#. from libreoffice:swriter-guide
msgid "Press Backspace."
msgstr "Tryck på Delete."

#. from libreoffice:swriter-guide
msgid "To Delete a Manual Page Break That Occurs Before a Table"
msgstr "Så här tar du bort en manuell sidbrytning före en tabell"

#. from libreoffice:swriter-guide
msgid "Right-click in the table, and choose <emph>Table</emph>."
msgstr "Högerklicka i tabellen och välj <emph>Tabell</emph>."

#. from libreoffice:swriter-guide
msgid "Click the <link href=\"text/swriter/01/05090300.xhp\"><emph>Text Flow</emph></link> tab."
msgstr "Klicka på fliken <link href=\"text/swriter/01/05090300.xhp\"><emph>Textflöde</emph></link>."

#. from libreoffice:swriter-guide
msgid "Clear the <emph>Break</emph> check box."
msgstr "Avmarkera kryssrutan <emph>Brytning</emph>."

#. from libreoffice:swriter-guide
msgid "Changing Page Backgrounds"
msgstr "Ändra sidbakgrunder"

#. from libreoffice:swriter-guide
msgid "<bookmark_value>page styles;backgrounds</bookmark_value>  <bookmark_value>backgrounds; different pages</bookmark_value>  <bookmark_value>changing;page backgrounds</bookmark_value>  <bookmark_value>pages;backgrounds</bookmark_value>"
msgstr "<bookmark_value>sidformatmallar;bakgrunder</bookmark_value>      <bookmark_value>bakgrunder; olika sidor</bookmark_value>      <bookmark_value>ändra;sidbakgrunder</bookmark_value>      <bookmark_value>sidor;bakgrunder</bookmark_value>"

#. from libreoffice:swriter-guide
msgid "<variable id=\"pagebackground\"><link href=\"text/swriter/guide/pagebackground.xhp\">Changing Page Background</link></variable>"
msgstr "<variable id=\"pagebackground\"><link href=\"text/swriter/guide/pagebackground.xhp\">Ändra sidbakgrund</link></variable>"

#. from libreoffice:swriter-guide
msgid "$[officename] uses page styles to specify the background of the pages in a document. For example, to change the page background of one or more pages in a document to a watermark, you need to create a page style that uses the watermark background, and then apply the page style to the pages."
msgstr "I $[officename] används sidformatmallar för att ange sidornas bakgrund i ett dokument. Om du till exempel vill ändra sidbakgrunden för en eller flera sidor i ett dokument till ett vattenmärke måste du skapa en sidformatmall med vattenmärkesbakgrund som du tillämpar på sidorna ifråga."

#. from libreoffice:swriter-guide
msgid "To Change the Page Background"
msgstr "Så här ändrar du sidbakgrunden"

#. from libreoffice:swriter-guide
msgid "In the <emph>Next Style</emph> box, select the page style that you want to apply to the next page."
msgstr "Välj den sidformatmall du vill tillämpa på nästa sida i rutan <emph>Nästa formatmall</emph>."

#. from libreoffice:swriter-guide
msgid "To only apply the new page style to a single page, select \"Default\"."
msgstr "Använd önskad sidformatmall på sidorna."

#. from libreoffice:swriter-guide
msgid "To apply the new page style to all subsequent pages, select the name of the new page style."
msgstr "För att använda det nya sidformatet på alla följande sidor så markerar du namnet på det nya sidformatet."

#. from libreoffice:swriter-guide
msgid "To Change the Page Background of All Pages in a Document"
msgstr "Så här ändrar du sidbakgrunden på alla sidor i ett dokument"

#. from libreoffice:swriter-guide
msgid "Double-click the page style that uses the page background that you want to apply."
msgstr "Dubbelklicka på sidformatmallen med den bakgrund du vill använda."

#. from libreoffice:swriter-guide
msgid "To Use Different Page Backgrounds in the Same Document"
msgstr "Så här använder du olika sidbakgrunder i samma dokument"

#. from libreoffice:swriter-guide
msgid "Before you begin, ensure that you have created a page style that uses a page background. See <link href=\"text/swriter/guide/pagebackground.xhp#define\">To Change the Page Background</link> for details."
msgstr "Kontrollera först om du har skapat en sidformatmall med sidbakgrund. Se <link href=\"text/swriter/guide/pagebackground.xhp#define\">Så här ändrar du sidbakgrunden</link> för mer information."

#. from libreoffice:swriter-guide
msgid "Click in front of the first character of the paragraph where you want to change the page background."
msgstr "Klicka framför den första bokstaven i det stycke där du vill tillämpa sidbakgrunden."

#. from libreoffice:swriter-guide
msgid "To change the background of the current page only, select a page style where the Next Style option is set to \"Default\"."
msgstr "För att bara ändra bakgrunden på den nuvarande sidan väljer du en sidformatmall där valet Nästa formatmall är satt till \"Standardformatmall\"."

#. from libreoffice:swriter-guide
msgid "To change the background of the current and subsequent pages, select a page style where the Next Style option is set to the name of the page style."
msgstr "För att ändra bakgrunden för aktuell och följande sidor väljer du en sidformatmall där valet Nästa sida är satt till namnet på själva sidformatmallen."

#. from libreoffice:swriter-guide
msgid "If you want to change the page background later on in the document, repeat steps 1 to 3."
msgstr "Om du senare vill ändra sidbakgrunden i dokumentet upprepar du steg 1 till 3."

#. from libreoffice:swriter-guide
msgid "<bookmark_value>page numbers;inserting/defining/formatting</bookmark_value>      <bookmark_value>page styles;page numbering</bookmark_value>      <bookmark_value>starting page numbers</bookmark_value>      <bookmark_value>formatting;page numbers</bookmark_value>      <bookmark_value>defining;starting page numbers</bookmark_value>      <bookmark_value>inserting;page numbers</bookmark_value>      <bookmark_value>styles;page numbers</bookmark_value>"
msgstr "<bookmark_value>sidnummer;infoga/definiera/formatera</bookmark_value>      <bookmark_value>sidformatmallar;sidnumrering</bookmark_value>      <bookmark_value>startsidnummer</bookmark_value>      <bookmark_value>formatering;sidnummer</bookmark_value>      <bookmark_value>definiera;startsidnummer</bookmark_value>      <bookmark_value>infoga;sidnummer</bookmark_value>      <bookmark_value>formatmallar;sidnummer</bookmark_value>"

#. from libreoffice:swriter-guide
msgid "<variable id=\"pagenumbers\"><link href=\"text/swriter/guide/pagenumbers.xhp\">Page Numbers</link></variable>"
msgstr "<variable id=\"pagenumbers\"><link href=\"text/swriter/guide/pagenumbers.xhp\">Sidnummer</link></variable>"

#. from libreoffice:swriter-guide
msgid "In Writer, a page number is a field that you can insert into your text."
msgstr "I Writer är sidnumret ett fält som du kan infoga i texten."

#. from libreoffice:swriter-guide
msgid "To Insert Page Numbers"
msgstr "Så här infogar du sidnummer"

#. from libreoffice:swriter-guide
msgid "However, these fields will change position when you add or remove text. So it is best to insert the page number field into a header or footer that has the same position and that is repeated on every page."
msgstr "När du lägger till eller tar bort text ändras dock fältens position. Det är därför bäst att infoga sidnummerfält i sidhuvudet eller sidfoten som har samma position och upprepas på varje sida."

#. from libreoffice:swriter-guide
msgid "To Start With a Defined Page Number"
msgstr "Så här gör du för att börja med ett angivet sidnummer"

#. from libreoffice:swriter-guide
msgid "Now you want some more control on page numbers. You are writing a text document that should start with page number 12."
msgstr "Nu vill du kanske ha mer kontroll över sidnumren. Du skriver ett textdokument som ska starta med sidnummer 12."

#. from libreoffice:swriter-guide
msgid "Click into the first paragraph of your document."
msgstr "Klicka i det första stycket i dokumentet."

#. from libreoffice:swriter-guide
msgid "In the Breaks area, enable <emph>Insert</emph>. Enable <emph>With Page Style</emph> just to be able to set the new <emph>Page number</emph>. Click <emph>OK</emph>."
msgstr "Aktivera <emph>Infoga</emph> i området Brytningar. Aktivera <emph>Med sidformatmall</emph> så att du kan ange det nya <emph>sidnumret</emph>. Klicka på <emph>OK</emph>."

#. from libreoffice:swriter-guide
msgid "The new page number is an attribute of the first paragraph of the page."
msgstr "Det nya sidnumret är ett attribut för det första stycket på sidan."

#. from libreoffice:swriter-guide
msgid "You want roman page numbers running i, ii, iii, iv, and so on."
msgstr "Du vill ha löpande romerska sidnummer, i, ii, iii, iv osv."

#. from libreoffice:swriter-guide
msgid "Double-click directly before the page number field. You see the <emph>Edit Fields</emph> dialog."
msgstr "Dubbelklicka direkt framför sidnummerfältet. Dialogrutan <emph>Redigera fältkommando</emph> visas."

#. from libreoffice:swriter-guide
msgid "Select a number format and click <emph>OK</emph>."
msgstr "Markera ett talformat och klicka på <emph>OK</emph>."

#. from libreoffice:swriter-guide
msgid "In Writer, you will need different page styles. The first page style has a footer with a page number field formatted for roman numbers. The following page style has a footer with a page number field formatted in another look."
msgstr "I Writer behöver du olika sidformatmallar. Den första sidformatmallen har en sidfot med sidnummerfältet formaterat för romerska siffror. Den följande sidformatmallen har en sidfot med sidnummerfältet formaterat efter ett annat sidnummerformat."

#. from libreoffice:swriter-guide
msgid "Both page styles must be separated by a page break. In Writer, you can have automatic page breaks and manually inserted page breaks."
msgstr "Båda sidformatmallarna måste avgränsas av en sidbrytning. I Writer kan du infoga automatiska och manuella sidbrytningar."

#. from libreoffice:swriter-guide
msgid "An <emph>automatic page break</emph> appears at the end of a page when the page style has a different \"next style\"."
msgstr "En <emph>automatisk sidbrytning</emph> visas i slutet av sidan när sidformatmallen har en annan \"Nästa formatmall\"."

#. from libreoffice:swriter-guide
msgid "A <emph>manually inserted page break</emph> can be applied without or with a change of page styles."
msgstr "En <emph>manuellt infogad sidbrytning</emph> kan användas med eller utan att sidformatmallar ändras."

#. from libreoffice:swriter-guide
msgid "It depends on your document what is best: to use a manually inserted page break between page styles, or to use an automatic change. If you just need one title page with a different style than the other pages, you can use the automatic method:"
msgstr "Vilket som passar bäst beror på dokumentet: att använda en manuellt infogad sidbrytning mellan sidformatmallar, eller en automatisk ändring. Om du bara behöver en rubriksida med en annan formatmall än de andra sidorna, kan du använda den automatiska metoden."

#. from libreoffice:swriter-guide
msgid "To Apply a Different Page Style to the First Page"
msgstr "Så här använder du en annan formatmall på första sidan"

#. from libreoffice:swriter-guide
msgid "Click into the first page of your document."
msgstr "Klicka på den första sidan i dokumentet."

#. from libreoffice:swriter-guide
msgid "Double-click the \"First Page\" style."
msgstr "Dubbelklicka på formatmallen \"Första sidan\"."

#. from libreoffice:swriter-guide
msgid "To Apply a Manually Inserted Page Style Change"
msgstr "Så här ändrar du sidformatmallen manuellt"

#. from libreoffice:swriter-guide
msgid "Click at the start of the first paragraph on the page where a different page style will be applied."
msgstr "Klicka i början av det första stycket på sidan där du vill använda en annan sidformatmall."

#. from libreoffice:swriter-guide
msgid "In the <item type=\"menuitem\">Style</item> list box, select a page style. You may set a new page number, too. Click <item type=\"menuitem\">OK</item>."
msgstr "Markera en sidformatmall i listrutan <item type=\"menuitem\">Formatmall</item>. Du kan även ange ett nytt sidnummer. Klicka på <item type=\"menuitem\">OK</item>."

#. from libreoffice:swriter-guide
msgid "The selected page style will be used from the current paragraph to the next page break with style. You may need to create the new page style first."
msgstr "Den markerade sidformatmallen används från det aktuella stycket till nästa sidbrytning med formatmall. Du kan behöva skapa den nya sidformatmallen först."

#. from libreoffice:swriter-guide
msgid "Changing Page Orientation (Landscape or Portrait)"
msgstr "Ändra sidorienteringen (liggande eller stående)"

#. from libreoffice:swriter-guide
msgid "<variable id=\"pageorientation\"><link href=\"text/swriter/guide/pageorientation.xhp\">Changing Page Orientation</link></variable>"
msgstr "<variable id=\"pageorientation\"><link href=\"text/swriter/guide/pageorientation.xhp\">Ändra sidorienteringen</link></variable>"

#. from libreoffice:swriter-guide
msgid "All page properties for Writer text documents, like for example the page orientation, are defined by page styles. By default, a new text document uses the “Default” page style for all pages. If you open an existing text document, different page styles may have been applied to the different pages."
msgstr "Alla sidegenskaper för Writer-textdokument (t.ex. sidorientering) anges i formatmallarna. Som standard används sidformatmallen \"Standard\" för alla sidor när ett nytt dokument skapas. Om du öppnar ett befintligt textdokument kan olika sidformatmallar ha angetts för olika sidor."

#. from libreoffice:swriter-guide
msgid "It is important to know that changes that you apply to a page property will only affect the pages that use the current page style. The current page style is listed in the Status Bar at the lower window border."
msgstr "När du ändrar en sidegenskap påverkas bara de sidor där den aktuella formatmallen används. Aktuell sidformatmall visas i statuslisten vid fönstrets nedre kant."

#. from libreoffice:swriter-guide
msgid "To Change the Page Orientation for All Pages"
msgstr "Så här ändrar du sidorientering för alla sidor"

#. from libreoffice:swriter-guide
msgid "If your text document consists only of pages with the same page style, you can change the page properties directly:"
msgstr "Om textdokumentet består enbart av sidor med samma sidformatmall kan du ändra sidegenskaperna direkt:"

#. from libreoffice:swriter-guide
msgid "To Change the Page Orientation Only for Some Pages"
msgstr "Så här ändrar du sidorientering endast för vissa sidor"

#. from libreoffice:swriter-guide
msgid "$[officename] uses page styles to specify the orientation of the pages in a document. Page styles define more page properties, as for example header and footer or page margins. You can either change the “Default” page style for the current document, or you can define own page styles and apply those page styles to any parts of your text."
msgstr "I $[officename] används sidformatmallar för att ange sidorientering i dokument. Även andra sidegenskaper såsom sidhuvuden, sidfötter och marginaler anges i sidformatmallarna. Du kan göra ändringar i sidformatmallen \"Standard\" för det aktuella dokumentet, eller definiera egna sidformatmallar som du kan tillämpa på vilka textavsnitt du vill i dokumentet."

#. from libreoffice:swriter-guide
msgid "At the end of this help page, we'll discuss the scope of page styles in detail. If you are unsure about the page style concept, please read the section at the end of this page."
msgstr "I slutet av den här hjälpsidan diskuteras sidformatmallarnas omfattning utförligt. Läs sista avsnittet på den här sidan om du är osäker på vad begreppet sidformatmall innebär."

#. from libreoffice:swriter-guide
msgid "Unlike character styles or paragraph styles, the page styles don't know a hierarchy. You can create a new page style based on the properties of an existing page style, but when you later change the source style, the new page style does not automatically inherit the changes."
msgstr "Till skillnad från tecken- eller styckeformatmallar är sidformatmallarna inte hierarkiskt ordnade. Du kan skapa en ny formatmall med en befintlig mall som grund, men när du sedan ändrar i den gamla mallen förs ändringarna inte automatiskt över till den nya."

#. from libreoffice:swriter-guide
msgid "To change the page orientation for all pages that share the same page style, you first need a page style, then apply that style:"
msgstr "Om du vill ändra sidorienteringen på alla sidor med samma sidformatmall, måste det finnas en sidformatmall och denna måste tillämpas."

#. from libreoffice:swriter-guide
msgid "Right-click a page style and choose <emph>New</emph>. The new page style initially gets all properties of the selected page style."
msgstr "Högerklicka på en sidformatmall och välj <emph>Ny</emph>. Den nya sidformatmallen ges från början samma egenskaper som den valda mallen."

#. from libreoffice:swriter-guide
msgid "In the <emph>Next Style</emph> box, select the page style that you want to apply to the next page that follows a page with the new style. See the section about the scope of page styles at the end of this help page."
msgstr "I rutan <emph>Nästa formatmall</emph>väljer du den formatmall du vill ska följa på en sida där den nya mallen används. Se även avsnittet om formatmallarnas omfattning i slutet av den här hjälpsidan."

#. from libreoffice:swriter-guide
msgid "Click the <emph>Page</emph> tab."
msgstr "Klicka på fliken <emph>Sida</emph>."

#. from libreoffice:swriter-guide
msgid "Under <item type=\"menuitem\">Paper format</item>, select “Portrait” or “Landscape”."
msgstr "Välj \"Stående\" eller \"Liggande\" under <item type=\"menuitem\">Pappersformat</item>."

#. from libreoffice:swriter-guide
msgid "The Scope of Page Styles"
msgstr "Omfattning för sidformatmallar"

#. from libreoffice:swriter-guide
msgid "You should be aware of the scope of page styles in %PRODUCTNAME. Which pages of your text document get affected by editing a page style?"
msgstr "Det är bra att känna till sidformatmallarnas omfattning i %PRODUCTNAME. Vilka sidor i dokumentet påverkas om en sidformarmall redigeras?"

#. from libreoffice:swriter-guide
msgid "One Page Long Styles"
msgstr "Formatmallar som omfattar en (1) sida"

#. from libreoffice:swriter-guide
msgid "A one page long style starts from the lower border of the current page style range up to the next page break. The next page break appears automatically when the text flows to the next page, which is sometimes called a \"soft page break\". Alternatively, you can insert a manual page break."
msgstr "En formatmall som spänner över en sida löper från nedre gränsen för den aktuella sidformatmallen till nästa sidbrytning. En sidbrytning infogas automatiskt när texten löper vidare till nästa sida (så kallad \"mjuk sidbrytning\"). Du kan också infoga manuella sidbrytningar."

#. from libreoffice:swriter-guide
msgid "Manually Defined Range of a Page style"
msgstr "Manuellt definierat område för sidformatmall"

#. from libreoffice:swriter-guide
msgid "You can insert a \"page break with style\" directly at the cursor position. Alternatively, you can apply the \"page break with style\" property to a paragraph or to a paragraph style."
msgstr "Du kan infoga en \"sidbrytning med formatmall\" direkt där markören står. Du kan också ange \"sidbrytning med formatmall\"som egenskap för ett stycke eller en styckeformatmall."

#. from libreoffice:swriter-guide
msgid "Perform any one of the following commands:"
msgstr "Ange något av följande kommandon:"

#. from libreoffice:swriter-guide
msgid "To insert a \"page break with style\" at the cursor position, choose <item type=\"menuitem\">Insert - Manual Break</item>, select a <emph>Style</emph> name from the listbox, and click OK."
msgstr "Gör så här för att infoga en \"sidbrytning med formatmall\" där markören står: välj <item type=\"menuitem\">Infoga - Manuell brytning</item>, markera en <emph>Formatmall</emph> i listan och klicka på OK."

#. from libreoffice:swriter-guide
msgid "Creating and Applying Page Styles"
msgstr "Skapa och använda sidformatmallar"

#. from libreoffice:swriter-guide
msgid "<variable id=\"pagestyles\"><link href=\"text/swriter/guide/pagestyles.xhp\">Creating and Applying Page Styles</link></variable>"
msgstr "<variable id=\"pagestyles\"><link href=\"text/swriter/guide/pagestyles.xhp\">Skapa och använda sidformatmallar</link> </variable>"

#. from libreoffice:swriter-guide
msgid "$[officename] uses page styles to specify the layout of a page, including the page orientation, background, margins, headers, footers, and text columns. To change the layout of an individual page in a document, you must create and apply a custom page style to the page."
msgstr "I $[officename] används sidformatmallar för att ange sidans layout, inklusive sidorientatering, bakgrund, marginaler, sidhuvud, sidfot och textkolumner. Om du vill ändra layout för en enskild sida i ett dokument måste du skapa och använda en användardefinierad sidformatmall för sidan."

#. from libreoffice:swriter-guide
msgid "To Define a New Page Style"
msgstr "Så här definierar du en ny sidformatmall"

#. from libreoffice:swriter-guide
msgid "Click the <emph>Page Styles</emph> icon."
msgstr "Klicka på ikonen <emph>Sidformatmallar</emph>."

#. from libreoffice:swriter-guide
msgid "In the list of page styles, right-click an item, and then choose <emph>New</emph>."
msgstr "I listan över sidformatmallar högerklickar du på ett objekt och väljer <emph>Ny</emph>."

#. from libreoffice:swriter-guide
msgid "To apply the custom page style to a single page, select the default page style that is used in your document in the <emph>Next Style</emph> box."
msgstr "För att använda en anpassad sidformatmall på en enda sida, markera den sidformatmall som används i ditt dokument i rutan <emph>Nästa formatmall</emph>."

#. from libreoffice:swriter-guide
msgid "To apply the custom page style to more than one page, select its name in the <emph>Next Style</emph> box. To stop using the style, insert a manual page break and assign it a different page style."
msgstr "För att använda en anpassad formatmall på mer än en sida, markera dess namn i rutan <emph>Nästa formatmall</emph>. För att sluta att använda formatmallen, infogar du en manuell sidbrytning och tilldelar den en annan sidformatmall."

#. from libreoffice:swriter-guide
msgid "Use the tabs in the dialog to set the layout options for the page style, and then click <emph>OK</emph>."
msgstr "Ange layoutalternativ för sidformatmallen genom att använda flikarna i dialogrutan och klicka sedan på <emph>OK</emph>."

#. from libreoffice:swriter-guide
msgid "To Apply a Page Style"
msgstr "Så här använder du en sidformatmall"

#. from libreoffice:swriter-guide
msgid "Click in the page that you want to apply the page style to."
msgstr "Klicka på sidan som du vill använda sidformatmallen för."

#. from libreoffice:swriter-guide
msgid "Double-click a name in the list."
msgstr "Dubbelklicka på ett namn i listan."

#. from libreoffice:swriter-guide
msgid "To Apply a Page Style to a New Page"
msgstr "Så här använder du en sidformatmall för en ny sida"

#. from libreoffice:swriter-guide
msgid "Click in the document where you want a new page to start."
msgstr "Klicka i dokumentet där du vill att en ny sida ska börja."

#. from libreoffice:swriter-guide
msgid "Select <emph>Page break</emph>."
msgstr "Markera <emph>Sidbrytning</emph>."

#. from libreoffice:swriter-guide
msgid "Printing a Brochure"
msgstr "Skriva ut en broschyr"

#. from libreoffice:swriter-guide
msgid "<bookmark_value>printing; individual brochures</bookmark_value>      <bookmark_value>booklet printing</bookmark_value>      <bookmark_value>brochures; printing individual</bookmark_value>"
msgstr "<bookmark_value>skriva ut; enstaka broschyrer</bookmark_value>      <bookmark_value>häfte, skriva ut</bookmark_value>      <bookmark_value>broschyrer; skriva ut enstaka</bookmark_value>"

#. from libreoffice:swriter-guide
msgid "<variable id=\"print_brochure\"><link href=\"text/swriter/guide/print_brochure.xhp\">Printing a Brochure</link></variable>"
msgstr "<variable id=\"print_brochure\"><link href=\"text/swriter/guide/print_brochure.xhp\">Skriva ut en broschyr</link></variable>"

#. from libreoffice:swriter-guide
msgid "You can print a Writer document as a brochure or a booklet. That is, Writer prints two pages on each side of the paper, so that when you fold the paper, you can read the document as a book."
msgstr "Du kan skriva ut ett Writer dokument som en broschyr eller ett häfte. Det innebär att två sidor skrivs ut på varje sida av papperet, så att du kan läsa dokumentet som en bok när du viker papperet."

#. from libreoffice:swriter-guide
msgid "When you create a document that you want to print as a brochure, use portrait orientation for the pages. Writer applies the brochure layout when you print the document."
msgstr "När du skapar ett dokument som du vill skriva ut som en broschyr, ska du använda stående orientering för sidorna. I Writer används broschyrlayouten när du skriver ut dokumentet."

#. from libreoffice:swriter-guide
msgid "To Print a Brochure"
msgstr "Skriva ut en broschyr"

#. from libreoffice:swriter-guide
msgid "In the <emph>Print</emph> dialog, click <emph>Properties</emph>."
msgstr "Klicka på <emph>Egenskaper</emph> i dialogrutan <emph>Utskrift</emph>."

#. from libreoffice:swriter-guide
msgid "In the properties dialog for your printer, set the paper orientation to landscape."
msgstr "Ange pappersorienteringen till liggande i dialogrutan för egenskaper för skrivaren."

#. from libreoffice:swriter-guide
msgid "If your printer prints duplex, and because brochures always print in landscape mode, you should use the \"duplex - short edge\" setting in your printer setup dialog."
msgstr "Om skrivaren klarar dubbelsidig utskrift bör du använda inställningen för dubbelsidig utskrift - kort kant i dialogrutan för skrivarinställningar, bl.a. för att broschyrer alltid skrivs ut liggande."

#. from libreoffice:swriter-guide
msgid "Previewing a Page Before Printing"
msgstr "Förhandsgranska en sida före utskrift"

#. from libreoffice:swriter-guide
msgid "<bookmark_value>printing; previews</bookmark_value>      <bookmark_value>previews; print layouts</bookmark_value>      <bookmark_value>print layout checks</bookmark_value>      <bookmark_value>book view</bookmark_value>      <bookmark_value>pages;previews</bookmark_value>"
msgstr "<bookmark_value>skriva ut; förhandsgranskning</bookmark_value>      <bookmark_value>förhandsgranskning; utskriftslayout</bookmark_value>      <bookmark_value>utskriftslayout, kontrollera</bookmark_value>      <bookmark_value>bokvy</bookmark_value>      <bookmark_value>sidor;förhandsgranskning</bookmark_value>"

#. from libreoffice:swriter-guide
msgid "<variable id=\"print_preview\"><link href=\"text/swriter/guide/print_preview.xhp\">Previewing a Page Before Printing</link></variable>"
msgstr "<variable id=\"print_preview\"><link href=\"text/swriter/guide/print_preview.xhp\">Förhandsvisning av utskrift</link></variable>"

#. from libreoffice:swriter-guide
msgid "Use the zoom icons on the <emph>Print Preview</emph> bar to reduce or enlarge the view of the page."
msgstr "Du förminskar eller förstorar visningen av sidan genom att använda zoomikonerna på verktygsraden <emph>Förhandsgranska</emph>."

#. from libreoffice:swriter-guide
msgid "To print your document scaled down, set the print options on the <emph>Page Layout</emph> tab page of the <item type=\"menuitem\">File - Print</item> dialog."
msgstr "Om du vill skriva ut dokumentet i mindre skala anger du önskade utskriftsinställningar på fliken <emph>Sidlayout</emph> i dialogrutan <item type=\"menuitem\">Arkiv – Skriv ut</item>."

#. from libreoffice:swriter-guide
msgid "Printing Multiple Pages on One Sheet"
msgstr "Skriva ut flera sidor på ett ark"

#. from libreoffice:swriter-guide
msgid "<bookmark_value>multi-page view of documents</bookmark_value>      <bookmark_value>pages;printing multiple on one sheet</bookmark_value>      <bookmark_value>overviews;printing multi-page view</bookmark_value>      <bookmark_value>printing;multiple pages per sheet</bookmark_value>      <bookmark_value>reduced printing of multiple pages</bookmark_value>"
msgstr "<bookmark_value>flersidig vy av dokument</bookmark_value>      <bookmark_value>sidor;skriva ut flera på ett blad</bookmark_value>      <bookmark_value>översikter;skriva ut, flersidig vy</bookmark_value>      <bookmark_value>skriva ut;flera sidor per blad</bookmark_value>      <bookmark_value>förminskad utskrift, flera sidor</bookmark_value>"

#. from libreoffice:swriter-guide
msgid "<variable id=\"print_small\"><link href=\"text/swriter/guide/print_small.xhp\">Printing Multiple Pages on One Sheet</link></variable>"
msgstr "<variable id=\"print_small\"><link href=\"text/swriter/guide/print_small.xhp\">Skriva ut flera sidor på ett ark</link></variable>"

#. from libreoffice:swriter-guide
msgid "To print two pages side by side on the same sheet, select \"2\" in the <emph>Pages per sheet</emph> box."
msgstr "Om du vill skriva ut två sidor sida vid sida på samma ark väljer du \"2\" i rutan <emph>Sidor per ark</emph>."

#. from libreoffice:swriter-guide
msgid "To print multiple pages on the same sheet, select the number of pages per sheet and optionally set the order of pages. The small preview shows the arrangement of pages."
msgstr "Om du vill skriva ut flera sidor på samma ark väljer du antalet sidor per ark. Du kan också ange sidornas ordning. Den lilla förhandsgranskningen visar hur sidorna är placerade."

#. from libreoffice:swriter-guide
msgid "Selecting printer paper trays"
msgstr "Välja pappersmagasin på skrivaren"

#. from libreoffice:swriter-guide
msgid "<bookmark_value>selecting;paper trays</bookmark_value>  <bookmark_value>paper tray selection</bookmark_value>"
msgstr "<bookmark_value>välja;pappersmagasin</bookmark_value>      <bookmark_value>pappersmagasin, val</bookmark_value>"

#. from libreoffice:swriter-guide
msgid "<variable id=\"printer_tray\"><link href=\"text/swriter/guide/printer_tray.xhp\">Selecting Printer Paper Trays</link></variable>"
msgstr "<variable id=\"printer_tray\"><link href=\"text/swriter/guide/printer_tray.xhp\">Välja pappersmagasin på skrivaren</link></variable>"

#. from libreoffice:swriter-guide
msgid "Use page styles to specify different paper sources for different pages in your document."
msgstr "Använd sidformatmallar för att ange olika papperskällor för olika sidor i dokumentet."

#. from libreoffice:swriter-guide
msgid "Click the <item type=\"menuitem\">Page Styles</item> icon."
msgstr "Klicka på ikonen <item type=\"menuitem\">Sidformatmallar</item>               ."

#. from libreoffice:swriter-guide
msgid "Right-click the page style in the list that you want to specify the paper source for, and then choose <emph>Modify</emph>."
msgstr "I listan högerklickar du på sidformatmallen som du vill ange papperskälla för och väljer sedan <emph>Ändra</emph>."

#. from libreoffice:swriter-guide
msgid "In the <item type=\"menuitem\">Paper tray</item> box, select the paper tray that you want to use."
msgstr "Välj det pappersmagasin som du vill använda i rutan <item type=\"menuitem\">Pappersmatning</item>               ."

#. from libreoffice:swriter-guide
msgid "Repeat steps 1-5 for each page style that you want to specify the paper for."
msgstr "Upprepa steg 1-5 för varje sidformatmall som du vill ange papper för."

#. from libreoffice:swriter-guide
msgid "Apply the page style to the pages that you want."
msgstr "Använd önskad sidformatmall på sidorna."

#. from libreoffice:swriter-guide
msgid "<link href=\"text/swriter/guide/pagestyles.xhp\">Creating and applying page styles</link>"
msgstr "<link href=\"text/swriter/guide/pagestyles.xhp\">Skapa och använda sidformatmallar</link>"

#. from libreoffice:swriter-guide
msgid "Printing in Reverse Order"
msgstr "Skriva ut i omvänd ordning"

#. from libreoffice:swriter-guide
msgid "<bookmark_value>ordering;printing in reverse order</bookmark_value>      <bookmark_value>printing; reverse order</bookmark_value>"
msgstr "<bookmark_value>ordna;skriva ut i omvänd ordning</bookmark_value>      <bookmark_value>skriva ut; omvänd ordning</bookmark_value>"

#. from libreoffice:swriter-guide
msgid "<variable id=\"printing_order\"><link href=\"text/swriter/guide/printing_order.xhp\">Printing in Reverse Order</link></variable>"
msgstr "<variable id=\"printing_order\"><link href=\"text/swriter/guide/printing_order.xhp\">Skriva ut i omvänd ordning</link></variable>"

#. from libreoffice:swriter-guide
msgid "Click the <emph>General</emph> tab."
msgstr "Klicka på fliken <emph>Sida</emph>."

#. from libreoffice:swriter-guide
msgid "Choose <emph>Print in reverse page order</emph>."
msgstr "Välj <emph>Skriv ut i omvänd sidordning</emph>."

#. from libreoffice:swriter-guide
msgid "Click <emph>Print</emph>."
msgstr "Klicka på <emph>Skriv ut</emph>."

#. from libreoffice:swriter-guide
msgid "Protecting Content in %PRODUCTNAME Writer"
msgstr "Skydda innehåll i %PRODUCTNAME Writer"

#. from libreoffice:swriter-guide
msgid "<link href=\"text/shared/guide/protection.xhp\">Protecting Other Contents</link>"
msgstr "<link href=\"text/shared/guide/protection.xhp\">Skydda annat innehåll</link>"

#. from libreoffice:swriter-guide
msgid "Inserting Cross-References"
msgstr "Infoga korshänvisningar"

#. from libreoffice:swriter-guide
msgid "<bookmark_value>references; inserting cross-references</bookmark_value>  <bookmark_value>cross-references; inserting and updating</bookmark_value>  <bookmark_value>tables; cross-referencing</bookmark_value>  <bookmark_value>pictures; cross-referencing</bookmark_value>  <bookmark_value>objects; cross-referencing</bookmark_value>  <bookmark_value>OLE objects;cross-referencing</bookmark_value>  <bookmark_value>draw objects;cross-referencing</bookmark_value>  <bookmark_value>updating;cross-references</bookmark_value>  <bookmark_value>inserting;cross-references</bookmark_value>"
msgstr "<bookmark_value>referenser; infoga korsreferenser</bookmark_value>      <bookmark_value>korsreferenser; infoga och uppdatera</bookmark_value>      <bookmark_value>tabeller; korsreferera</bookmark_value>      <bookmark_value>bilder; korsreferera</bookmark_value>      <bookmark_value>objekt; korsreferera</bookmark_value>      <bookmark_value>OLE-objekt;korsreferera</bookmark_value>      <bookmark_value>ritobjekt;korsreferera</bookmark_value>      <bookmark_value>uppdatera;korsreferenser</bookmark_value>      <bookmark_value>infoga;korsreferenser</bookmark_value>"

#. from libreoffice:swriter-guide
msgid "<variable id=\"references\"><link href=\"text/swriter/guide/references.xhp\">Inserting Cross-References</link></variable>"
msgstr "<variable id=\"references\"><link href=\"text/swriter/guide/references.xhp\">Infoga korshänvisningar</link></variable>"

#. from libreoffice:swriter-guide
msgid "Cross-references allow you to jump to specific text passages and objects in a single document. A cross-reference consists of a target and a reference that are inserted as <link href=\"text/swriter/guide/fields.xhp\">fields</link> in the document."
msgstr "Med korshänvisningar kan du hoppa till specifika textavsnitt och objekt i ett enskilt dokument. En korshänvisning består av ett mål och en hänvisning som infogas som <link href=\"text/swriter/guide/fields.xhp\">fält</link> i dokumentet."

#. from libreoffice:swriter-guide
msgid "Objects with captions and bookmarks can be used as targets."
msgstr "Objekt med bildtexter och bokmärken kan användas som mål."

#. from libreoffice:swriter-guide
msgid "Cross-Referencing Text"
msgstr "Korshänvisa till text"

#. from libreoffice:swriter-guide
msgid "Before you can insert a cross-reference, you must first specify the targets in your text."
msgstr "Innan du kan infoga en korshänvisning måste du först ange målen i texten."

#. from libreoffice:swriter-guide
msgid "To Insert a Target"
msgstr "Så här infogar du ett mål"

#. from libreoffice:swriter-guide
msgid "Select the text that you want to use as a target for the cross-reference."
msgstr "Markera texten som du vill använda som mål för korshänvisningen."

#. from libreoffice:swriter-guide
msgid "In the <item type=\"menuitem\">Type</item> list, select “Set Reference”."
msgstr "Välj \"Sätt referens\" i listan <item type=\"menuitem\">Fälttyp</item>."

#. from libreoffice:swriter-guide
msgid "Type a name for the target in the <emph>Name</emph> box. The selected text is displayed in the <emph>Value</emph> box."
msgstr "Skriv målets namn i rutan <emph>Namn</emph>. Den markerade texten visas i rutan <emph>Värde</emph>."

#. from libreoffice:swriter-guide
msgid "Click <item type=\"menuitem\">Insert</item>. The name of the target is added to the <item type=\"menuitem\">Selection</item> list."
msgstr "Klicka på <item type=\"menuitem\">Infoga</item>. Målets namn läggs till i listan <item type=\"menuitem\">Urval</item>               ."

#. from libreoffice:swriter-guide
msgid "Leave the dialog open and proceed to the next section."
msgstr "Låt dialogrutan vara öppen och fortsätt till nästa område."

#. from libreoffice:swriter-guide
msgid "To Create a Cross-Reference to a Target"
msgstr "Så här skapar du en korsreferens till ett mål"

#. from libreoffice:swriter-guide
msgid "Position the cursor in the text where you want to insert a cross-reference."
msgstr "Placera markören i där du vill infoga en korsreferens."

#. from libreoffice:swriter-guide
msgid "Choose <emph>Insert - Cross-reference</emph> to open the dialog, if it is not open already."
msgstr "Om du dialogrutan inte är öppen kan du öppnar du den genom att välja <emph>Infoga > Korsreferens </emph>."

#. from libreoffice:swriter-guide
msgid "In the <emph>Type</emph> list, select \"Insert Reference\"."
msgstr "I listan <emph>Fälttyp</emph> markerar du \"Infoga referens\"."

#. from libreoffice:swriter-guide
msgid "In the <emph>Selection</emph> list, select the target that you want to cross-reference."
msgstr "I listan <emph>Urval</emph> markerar du målet som du vill korshänvisa till."

#. from libreoffice:swriter-guide
msgid "Cross-Referencing an Object"
msgstr "Korshänvisa till ett objekt"

#. from libreoffice:swriter-guide
msgid "You can cross-reference most objects in your document, such as graphics, drawing objects, OLE objects, and tables, so long as they have a caption. To add a caption to an object, select the object, and then choose <link href=\"text/swriter/guide/captions.xhp\"><emph>Insert - Caption</emph></link>."
msgstr "Du kan korshänvisa de flesta objekt i dokumentet, t.ex. grafik, ritobjekt, OLE-objekt och tabeller. Om du vill lägga till en bildtext i ett objekt markerar du objektet och väljer <link href=\"text/swriter/guide/captions.xhp\"><emph>Infoga - Bildtext</emph></link>."

#. from libreoffice:swriter-guide
msgid "Click in the document where you want to insert the cross-reference."
msgstr "Klicka i dokumentet där du vill infoga korshänvisningen."

#. from libreoffice:swriter-guide
msgid "Choose <emph>Insert - Cross-reference</emph>."
msgstr "Välj <emph>Infoga - Korshänvisning</emph>."

#. from libreoffice:swriter-guide
msgid "In the <emph>Type</emph> list, select the caption category of the object."
msgstr "Markera bildtextkategorin för objektet i listan <emph>Kategori</emph>."

#. from libreoffice:swriter-guide
msgid "In the <emph>Selection</emph> list, select the caption number of the object that you want to cross-reference."
msgstr "I listan <emph>Urval</emph> markerar du bildtextnumret för objektet som du vill korshänvisa till."

#. from libreoffice:swriter-guide
msgid "Click <emph>Close</emph> when finished."
msgstr "Klicka på <emph>Stäng</emph> när du är färdig"

#. from libreoffice:swriter-guide
msgid "Updating Cross-References"
msgstr "Uppdatera korshänvisningar"

#. from libreoffice:swriter-guide
msgid "To manually update the cross-references in a document, choose <emph>Tools - Update - Fields</emph> from the menu or press F9."
msgstr "För manuell uppdatering av ett dokuments korsreferenser går du till menyn <emph>Verktyg - Uppdatera - Fält</emph> eller trycker F9."

#. from libreoffice:swriter-guide
msgid "Modifying Cross-References"
msgstr "Ändra korshänvisningar"

#. from libreoffice:swriter-guide
msgid "<bookmark_value>references; modifying cross-references</bookmark_value>  <bookmark_value>cross-references; modifying</bookmark_value>  <bookmark_value>editing;cross-references</bookmark_value>  <bookmark_value>searching;cross-references</bookmark_value>"
msgstr "<bookmark_value>referenser; ändra korsreferenser</bookmark_value>      <bookmark_value>korsreferenser; ändra</bookmark_value>      <bookmark_value>redigera;korsreferenser</bookmark_value>      <bookmark_value>söka;korsreferenser</bookmark_value>"

#. from libreoffice:swriter-guide
msgid "<variable id=\"references_modify\"><link href=\"text/swriter/guide/references_modify.xhp\">Modifying Cross-References</link></variable>"
msgstr "<variable id=\"references_modify\"><link href=\"text/swriter/guide/references_modify.xhp\">Ändra korsreferenser</link></variable>"

#. from libreoffice:swriter-guide
msgid "Click in front of the cross-reference that you want to modify."
msgstr "Klicka framför den korsreferens som du vill ändra."

#. from libreoffice:swriter-guide
msgid "Choose <emph>Edit - Fields</emph>."
msgstr "Välj <emph>Redigera - Fältkommando</emph>."

#. from libreoffice:swriter-guide
msgid "Set the options that you want, and then click <emph>OK</emph>."
msgstr "Ange alternativen som du vill använda och klicka på <emph>OK</emph>."

#. from libreoffice:swriter-guide
msgid "Use the arrow buttons in the <item type=\"menuitem\">Edit Fields</item> dialog to browse through the cross-references in the current document."
msgstr "Använd pilknapparna i dialogrutan <item type=\"menuitem\">Redigera fältkommando</item>         om du vill bläddra genom korsreferenserna i det aktuella dokumentet."

#. from libreoffice:swriter-guide
msgid "<bookmark_value>rows; register-true text</bookmark_value>      <bookmark_value>lines of text; register-true</bookmark_value>      <bookmark_value>pages;register-true</bookmark_value>      <bookmark_value>paragraphs;register-true</bookmark_value>      <bookmark_value>register-true;pages and paragraphs</bookmark_value>      <bookmark_value>spacing;register-true text</bookmark_value>      <bookmark_value>formatting;register-true text</bookmark_value>"
msgstr "<bookmark_value>rader; text med register</bookmark_value>      <bookmark_value>textrader; med register</bookmark_value>      <bookmark_value>sidor;med register</bookmark_value>      <bookmark_value>stycken;med register</bookmark_value>      <bookmark_value>register;sidor och stycken</bookmark_value>      <bookmark_value>avstånd;text med register</bookmark_value>      <bookmark_value>formatera;text med register</bookmark_value>"

#. from libreoffice:swriter-guide
msgid "Removing Line Breaks"
msgstr "Ta bort radbrytningar"

#. from libreoffice:swriter-guide
msgid "<bookmark_value>hard returns in pasted text</bookmark_value>      <bookmark_value>line breaks;removing</bookmark_value>      <bookmark_value>deleting; line breaks</bookmark_value>      <bookmark_value>copies;removing line breaks</bookmark_value>      <bookmark_value>paragraph marks;removing</bookmark_value>"
msgstr "<bookmark_value>manuella radbrytningar i inklistrad text</bookmark_value>      <bookmark_value>radbrytningar;ta bort</bookmark_value>      <bookmark_value>ta bort; radbrytningar</bookmark_value>      <bookmark_value>kopior;ta bort radbrytningar</bookmark_value>      <bookmark_value>stycketecken;ta bort</bookmark_value>"

#. from libreoffice:swriter-guide
msgid "<variable id=\"removing_line_breaks\"><link href=\"text/swriter/guide/removing_line_breaks.xhp\">Removing Line Breaks</link></variable>"
msgstr "<variable id=\"removing_line_breaks\"><link href=\"text/swriter/guide/removing_line_breaks.xhp\">Ta bort radbrytningar</link></variable>"

#. from libreoffice:swriter-guide
msgid "Use the AutoCorrect feature to remove line breaks that occur within sentences. Unwanted line breaks can occur when you copy text from another source and paste it into a text document."
msgstr "Använd funktionen Autokorrigering om du vill ta bort radbrytningar i meningar.  Oönskade radbrytningar kan uppstå när du kopierar text från en källa och klistrar in det i ett textdokument."

#. from libreoffice:swriter-guide
msgid "This AutoCorrect feature only works on text that is formatted with the \"Default\" paragraph style."
msgstr "Funktionen Autokorrigering fungerar bara om texten formaterats med \"Standard\"-styckeformatmallen."

#. from libreoffice:swriter-guide
msgid "Choose <item type=\"menuitem\">Tools - AutoCorrect - AutoCorrect Options</item>."
msgstr "Välj <item type=\"menuitem\">Verktyg - Alternativ för autokorrigering</item>."

#. from libreoffice:swriter-guide
msgid "On the <emph>Options</emph> tab, ensure that <emph>Combine single line paragraphs if length greater than 50%</emph> is selected. To change the minimum percentage for the line length, double-click the option in the list, and then enter a new percentage."
msgstr "Kontrollera att <emph>Kombinera enradiga stycken längre än 50 %</emph> är markerad under fliken <emph>Alternativ</emph>. Om du vill ändra den minsta procentsatsen för radlängden dubbelklickar du på alternativet i listan och anger en ny procentsats."

#. from libreoffice:swriter-guide
msgid "Select the text containing the line breaks that you want to remove."
msgstr "Markera texten som innehåller stycketecknen som du vill ta bort."

#. from libreoffice:swriter-guide
msgid "In the <item type=\"menuitem\">Apply Style</item> box on the <item type=\"menuitem\">Formatting</item> bar, choose “Default”."
msgstr "Välj <item type=\"menuitem\">Standard</item> i rutan <item type=\"menuitem\">Använd mall</item> på verktygsraden “Formatering”."

#. from libreoffice:swriter-guide
msgid "Resetting Font Attributes"
msgstr "Återställa teckenattribut"

#. from libreoffice:swriter-guide
msgid "<bookmark_value>formats; resetting</bookmark_value>      <bookmark_value>font attributes; resetting</bookmark_value>      <bookmark_value>fonts; resetting</bookmark_value>      <bookmark_value>resetting; fonts</bookmark_value>      <bookmark_value>direct formatting;exiting</bookmark_value>      <bookmark_value>formatting;exiting direct formatting</bookmark_value>      <bookmark_value>exiting;direct formatting</bookmark_value>"
msgstr "<bookmark_value>format; återställa</bookmark_value>      <bookmark_value>teckenattribut; återställa</bookmark_value>      <bookmark_value>teckensnitt; återställa</bookmark_value>      <bookmark_value>återställa; teckensnitt</bookmark_value>      <bookmark_value>direktformatera; avsluta</bookmark_value>      <bookmark_value>formatera;avsluta direktformatering</bookmark_value>      <bookmark_value>avsluta direktformatering</bookmark_value>"

#. from libreoffice:swriter-guide
msgid "<variable id=\"reset_format\"><link href=\"text/swriter/guide/reset_format.xhp\">Resetting Font Attributes</link></variable>"
msgstr "<variable id=\"reset_format\"><link href=\"text/swriter/guide/reset_format.xhp\">Återställa teckenattribut</link></variable>"

#. from libreoffice:swriter-guide
msgid "To reset all direct formatting of existing text, select that text, then choose the menu command <emph>Format - Clear Direct Formatting</emph>."
msgstr "Du kan återställa all direktformatering i befintlig text genom att markera texten och sedan välja kommandot <emph>Format - Standardformatering</emph>."

#. from libreoffice:swriter-guide
msgid "Docking and Resizing Windows"
msgstr "Förankra och ändra storlek på fönster"

#. from libreoffice:swriter-guide
msgid "<variable id=\"resize_navigator\"><link href=\"text/swriter/guide/resize_navigator.xhp\">Docking and Resizing Windows</link></variable>"
msgstr "<variable id=\"resize_navigator\"><link href=\"text/swriter/guide/resize_navigator.xhp\">Förankra och ändra storlek på fönster</link></variable>"

#. from libreoffice:swriter-guide
msgid "To resize the window, drag a corner or an edge of the window."
msgstr "Om du vill ändra storlek på fönstret drar du i ett av fönstrets hörn eller kanter."

#. from libreoffice:swriter-guide
msgid "Using Rulers"
msgstr "Använda linjaler"

#. from libreoffice:swriter-guide
msgid "<variable id=\"ruler\"><link href=\"text/swriter/guide/ruler.xhp\">Using Rulers</link></variable>"
msgstr "<variable id=\"ruler\"><link href=\"text/swriter/guide/ruler.xhp\">Använda linjaler</link></variable>"

#. from libreoffice:swriter-guide
msgid "To show or hide rulers, choose <emph>View - Ruler</emph>. To show the vertical ruler, choose <switchinline select=\"sys\"><caseinline select=\"MAC\">%PRODUCTNAME - Preferences</caseinline><defaultinline>Tools - Options</defaultinline></switchinline> - <link href=\"text/shared/optionen/01040200.xhp\"><emph>%PRODUCTNAME Writer - View</emph></link>, and then select <emph>Vertical ruler</emph> in the <emph>Ruler</emph> area."
msgstr "Om du vill dölja eller visa linjaler väljer du <emph>Visa – Linjal</emph>. Om du vill visa den vertikala linjalen väljer du <switchinline select=\"sys\"><caseinline select=\"MAC\">%PRODUCTNAME – Inställningar</caseinline><defaultinline>Verktyg – Alternativ</defaultinline></switchinline> – <link href=\"text/shared/optionen/01040200.xhp\"><emph>%PRODUCTNAME Writer – Vy</emph></link> och markerar kryssrutan <emph>Vertikal linjal</emph> under <emph>Linjal</emph>."

#. from libreoffice:swriter-guide
msgid "Adjusting Page Margins"
msgstr "Justera sidmarginaler"

#. from libreoffice:swriter-guide
msgid "The margins of a page are indicated by the filled areas at the ends of the rulers."
msgstr "Marginalerna på sidan representeras av de fyllda områdena vid slutet av linjalerna."

#. from libreoffice:swriter-guide
msgid "Changing Indents"
msgstr "Ändra indrag"

#. from libreoffice:swriter-guide
msgid "Indents are adjusted with the three small triangles on the horizontal ruler."
msgstr "Indrag justeras med de tre trekanterna på den horisontella linjalen."

#. from libreoffice:swriter-guide
msgid "To change the first line indent of a selected paragraph, drag the top left triangle on the horizontal ruler to a new location."
msgstr "Om du vill ändra indraget för den första raden i ett markerat stycke drar du den övre trekanten till vänster på den horisontella linjalen till en ny plats."

#. from libreoffice:swriter-guide
msgid "To change the left or the right paragraph indent, select the paragraph(s) that you want change the indent for, drag the bottom left or the bottom right triangle on the horizontal ruler to a new location."
msgstr "Om du vill ändra vänster eller höger styckeindrag, markerar du de stycken vars indrag du vill ändra och drar den nedre trekanten (vänster resp. höger) till den nya platsen."

#. from libreoffice:swriter-guide
msgid "You can also double-click anywhere on the horizontal ruler, and adjust the indents in the <link href=\"text/shared/01/05030000.xhp\"><emph>Paragraph</emph></link> dialog."
msgstr "Du kan också dubbelklicka var som helst på den horisontella linjalen och justera indragen i dialogrutan <link href=\"text/shared/01/05030000.xhp\"><emph>Stycke</emph></link>."

#. from libreoffice:swriter-guide
msgid "Choose <item type=\"menuitem\">Edit - Find & Replace</item>."
msgstr "Välj <item type=\"menuitem\">Redigera - Sök och ersätt</item>."

#. from libreoffice:swriter-guide
msgid "Click <item type=\"menuitem\">More Options</item> to expand the dialog."
msgstr "Klicka på <item type=\"menuitem\">Fler alternativ</item> om du vill utöka dialogrutan."

#. from libreoffice:swriter-guide
msgid "Select the <item type=\"menuitem\">Regular expressions</item> check box."
msgstr "Markera kryssrutan <item type=\"menuitem\">Reguljärt uttryck</item>."

#. from libreoffice:swriter-guide
msgid "Regular Expression Examples"
msgstr "Exempel på reguljära uttryck"

#. from libreoffice:swriter-guide
msgid "Editing Sections"
msgstr "Redigera områden"

#. from libreoffice:swriter-guide
msgid "<bookmark_value>sections; editing</bookmark_value><bookmark_value>sections;deleting</bookmark_value><bookmark_value>deleting;sections</bookmark_value>      <bookmark_value>editing;sections</bookmark_value>      <bookmark_value>read-only sections</bookmark_value>      <bookmark_value>protecting;sections</bookmark_value>      <bookmark_value>converting;sections, into normal text</bookmark_value>      <bookmark_value>hiding;sections</bookmark_value>"
msgstr "<bookmark_value>avsnitt; redigera</bookmark_value>      <bookmark_value>avsnitt; radera</bookmark_value>      <bookmark_value>radera; avsnitt</bookmark_value>      <bookmark_value>redigera; avsnitt</bookmark_value>      <bookmark_value>skyddade avsnitt</bookmark_value>      <bookmark_value>skydda; avsnitt</bookmark_value>       <bookmark_value>konvertera; avsnitt, till normal text</bookmark_value>      <bookmark_value>dölja; avsnitt</bookmark_value>"

#. from libreoffice:swriter-guide
msgid "<variable id=\"section_edit\"><link href=\"text/swriter/guide/section_edit.xhp\">Editing Sections</link></variable>"
msgstr "<variable id=\"section_edit\"><link href=\"text/swriter/guide/section_edit.xhp\">Redigera områden</link> </variable>"

#. from libreoffice:swriter-guide
msgid "You can protect, hide, and convert sections to normal text in your document."
msgstr "Du kan skydda, dölja och konvertera områden till normal text."

#. from libreoffice:swriter-guide
msgid "Choose <link href=\"text/swriter/01/02170000.xhp\"><emph>Format - Sections</emph></link>."
msgstr "Välj <link href=\"text/swriter/01/02170000.xhp\"><emph>Format - Områden</emph></link>."

#. from libreoffice:swriter-guide
msgid "In the <item type=\"menuitem\">Section</item> list, click the section you want to modify. You can press <switchinline select=\"sys\"><caseinline select=\"MAC\">Command</caseinline><defaultinline>Ctrl</defaultinline></switchinline>+A to select all sections in the list, and you can Shift+click or <switchinline select=\"sys\"><caseinline select=\"MAC\">Command</caseinline><defaultinline>Ctrl</defaultinline></switchinline>+click to select some sections."
msgstr "I listan <item type=\"menuitem\">Avsnitt</item> kan du också trycka på <switchinline select=\"sys\"><caseinline select=\"MAC\">Kommando </caseinline><defaultinline>Ctrl</defaultinline></switchinline>+A, för att välja alla avsnitt i listan, eller använda Shift+Klick eller <switchinline select=\"sys\"><caseinline select=\"MAC\">Kommando </caseinline><defaultinline>Ctrl</defaultinline></switchinline>+Klick för att välja några avsnitt."

#. from libreoffice:swriter-guide
msgid "To convert a section into normal text, click <emph>Remove</emph>."
msgstr "Du väljer vilka egenskaper som autoformatet ska ha genom att klicka på <emph>Fler</emph>."

#. from libreoffice:swriter-guide
msgid "To make a section read-only, select the <emph>Protected</emph> check box in the <emph>Write Protection</emph> area."
msgstr "Det här alternativet är endast tillgängligt om alternativrutan <emph>Dokumentslut</emph> är markerad under <emph>Placering</emph>."

#. from libreoffice:swriter-guide
msgid "To hide a section, select the <emph>Hide</emph> check box in the <emph>Hide</emph> area."
msgstr "Det här alternativet är endast tillgängligt om alternativrutan <emph>Dokumentslut</emph> är markerad under <emph>Placering</emph>."

#. from libreoffice:swriter-guide
msgid "<link href=\"text/swriter/01/02170000.xhp\">Format - Sections</link>"
msgstr "<link href=\"text/swriter/01/02170000.xhp\">Format - Områden</link>"

#. from libreoffice:swriter-guide
msgid "<link href=\"text/swriter/guide/protection.xhp\">Protecting Content in %PRODUCTNAME Writer</link>"
msgstr "<link href=\"text/swriter/guide/protection.xhp\">Skydda innehåll i %PRODUCTNAME Writer</link>"

#. from libreoffice:swriter-guide
msgid "Inserting Sections"
msgstr "Infoga avsnitt"

#. from libreoffice:swriter-guide
msgid "<bookmark_value>sections; inserting</bookmark_value>  <bookmark_value>inserting; sections</bookmark_value>  <bookmark_value>HTML documents;inserting linked sections</bookmark_value>  <bookmark_value>updating;linked sections, manually</bookmark_value>  <bookmark_value>links;inserting sections</bookmark_value>"
msgstr "<bookmark_value>avsnitt; infoga</bookmark_value>      <bookmark_value>infoga; avsnitt</bookmark_value>      <bookmark_value>HTML-dokument;infoga länkade avsnitt</bookmark_value>      <bookmark_value>uppdatera;länkade avsnitt, manuellt</bookmark_value>      <bookmark_value>länkar;infoga avsnitt</bookmark_value>"

#. from libreoffice:swriter-guide
msgid "<variable id=\"section_insert\"><link href=\"text/swriter/guide/section_insert.xhp\">Inserting Sections</link></variable>"
msgstr "<variable id=\"section_insert\"><link href=\"text/swriter/guide/section_insert.xhp\">Infoga områden</link></variable>"

#. from libreoffice:swriter-guide
msgid "You can insert new sections, or links to sections in other documents into the current document. If you insert a section as a link, the content of the link changes when you modify the source document."
msgstr "Du kan infoga nya områden eller länkar till områden i andra dokument i det aktuella dokumentet. Om du infogar ett område som en länk ändras länkens innehåll när du ändrar källdokumentet."

#. from libreoffice:swriter-guide
msgid "To Insert a New Section"
msgstr "Så här infogar du ett nytt avsnitt"

#. from libreoffice:swriter-guide
msgid "Click in your document where you want to insert a new section, or select the text that you want to convert to a section."
msgstr "Klicka i dokumentet där du vill infoga ett nytt område eller markera texten som du vill konvertera till ett område."

#. from libreoffice:swriter-guide
msgid "If you select a text that occurs within a paragraph, the text is automatically converted into a new paragraph."
msgstr "Om du markerar text i ett stycke konverteras texten automatiskt till ett nytt stycke."

#. from libreoffice:swriter-guide
msgid "Set the options for the section, and then click <emph>Insert</emph>."
msgstr "Ange alternativen för området och klicka på <emph>Infoga</emph>."

#. from libreoffice:swriter-guide
msgid "To Insert a Section as a Link"
msgstr "Så här infogar du ett avsnitt som en länk"

#. from libreoffice:swriter-guide
msgid "Before you can insert a section as link, you must first create sections in the source document."
msgstr "Innan du kan infoga ett område som en länk måste du först skapa områden i källdokumentet."

#. from libreoffice:swriter-guide
msgid "When you open a document that contains linked sections, $[officename] prompts you to update the contents of the sections. To manually update a link, choose <emph>Tools - Update - Links</emph>."
msgstr "När du öppnar ett dokument som innehåller länkade områden i $[officename] uppmanas du att uppdatera områdenas innehåll. Om du vill uppdatera en länk manuellt väljer du <emph>Verktyg - Uppdatera - Länkar</emph>."

#. from libreoffice:swriter-guide
msgid "You can also insert linked sections in HTML documents. When you view the page in a web browser, the content of the sections corresponds to the content of the sections at the time the HTML document was last saved."
msgstr "Du kan också infoga länkade avsnitt i HTML-dokument. När du öppnar sidan i en webbläsare så motsvarar innehållet i avsnitten det innehåll som fanns i avsnitten när HTML-dokumentet sparades senast."

#. from libreoffice:swriter-guide
msgid "Click in your document where you want to insert the linked section."
msgstr "Klicka i dokumentet där du vill infoga det länkade område."

#. from libreoffice:swriter-guide
msgid "In the <item type=\"menuitem\">New Section</item> box, type a name for the section."
msgstr "Skriv ett namn på avsnittet i rutan <item type=\"menuitem\">Nytt avsnitt</item>               ."

#. from libreoffice:swriter-guide
msgid "Locate the document containing the section that you want to link to, and then click <emph>Insert</emph>."
msgstr "Leta rätt på dokumentet som innehåller området som du vill länka till och klicka på <emph>Infoga</emph>."

#. from libreoffice:swriter-guide
msgid "In the <item type=\"menuitem\">Section</item> box, select the section that you want to insert."
msgstr "Markera det avsnitt du vill infoga i rutan <item type=\"menuitem\">Avsnitt</item>               ."

#. from libreoffice:swriter-guide
msgid "Using Sections"
msgstr "Använda områden"

#. from libreoffice:swriter-guide
msgid "<bookmark_value>multi-column text</bookmark_value>      <bookmark_value>text; multi-column</bookmark_value>      <bookmark_value>columns; on text pages</bookmark_value>      <bookmark_value>text columns</bookmark_value>      <bookmark_value>sections; columns in/use of</bookmark_value>"
msgstr "<bookmark_value>flera kolumner med text</bookmark_value>      <bookmark_value>text; med flera kolumner</bookmark_value>      <bookmark_value>kolumner; på textsidor</bookmark_value>      <bookmark_value>textkolumner</bookmark_value>      <bookmark_value>avsnitt; kolumner i/använda</bookmark_value>"

#. from libreoffice:swriter-guide
msgid "<variable id=\"sections\"><link href=\"text/swriter/guide/sections.xhp\">Using Sections</link></variable>"
msgstr "<variable id=\"sections\"><link href=\"text/swriter/guide/sections.xhp\">Använda avsnitt</link></variable>"

#. from libreoffice:swriter-guide
msgid "Sections are named blocks of text, including graphics or objects, that you can use in a number of ways:"
msgstr "Områden är namngivna textblock, inklusive grafik och objekt, som du kan använda på flera olika sätt:"

#. from libreoffice:swriter-guide
msgid "To prevent text from being edited."
msgstr "Om du vill förhindra att text redigeras."

#. from libreoffice:swriter-guide
msgid "To show or hide text."
msgstr "Om du vill visa eller dölja text."

#. from libreoffice:swriter-guide
msgid "To reuse text and graphics from other $[officename] documents."
msgstr "Om du vill återanvända text och grafik från andra $[officename] dokument."

#. from libreoffice:swriter-guide
msgid "To insert sections of text that uses a different column layout than the current page style."
msgstr "Om du vill infoga textområden som använder en annan kolumnlayout än den aktuella sidformatmallen."

#. from libreoffice:swriter-guide
msgid "A section contains at least one paragraph. When you select a text and create a section, a paragraph break is automatically inserted at the end of the text."
msgstr "Ett område består av minst ett stycke. När du markerar en text och skapar ett område, infogas en styckebrytning automatiskt i slutet av texten."

#. from libreoffice:swriter-guide
msgid "You can insert sections from a text document, or an entire text document as a section into another text document. You can also insert sections from a text document as links in another text document, or in the same document."
msgstr "Du kan infoga områden från ett annat textdokument eller infoga ett helt textdokument som ett område i ett annat textdokument. Du kan även infoga områden från ett textdokument som länkar i ett annat eller samma textdokument."

#. from libreoffice:swriter-guide
msgid "To insert a new paragraph immediately before or after a section, click in front or behind the section, and then press <switchinline select=\"sys\"><caseinline select=\"MAC\">Option </caseinline><defaultinline>Alt</defaultinline></switchinline>+Enter."
msgstr "Om du vill infoga ett nytt stycke omedelbart före eller efter ett avsnitt så klickar du före eller efter avsnittet och trycker på <switchinline select=\"sys\"><caseinline select=\"MAC\">Alternativ</caseinline><defaultinline>Alt</defaultinline></switchinline>+Retur."

#. from libreoffice:swriter-guide
msgid "Sections and Columns"
msgstr "Områden och kolumner"

#. from libreoffice:swriter-guide
msgid "You can insert sections into an existing section. For example, you can insert a section containing two columns into a section that contains one column."
msgstr "Du kan infoga områden i ett befintligt område. Du kan t.ex. infoga ett område som innehåller två kolumner i ett område som innehåller en kolumn."

#. from libreoffice:swriter-guide
msgid "A section layout, for example on the number of columns, has priority over the page layout defined in a page style."
msgstr "En områdeslayout, t.ex. antalet kolumner, har högre prioritet än den sidlayout som definierats för en sidformatmall."

#. from libreoffice:swriter-guide
msgid "<link href=\"text/shared/00/00000005.xhp#dde\">DDE</link>"
msgstr "<link href=\"text/shared/00/00000005.xhp#dde\">DDE</link>"

#. from libreoffice:swriter-guide
msgid "Saving Text Documents in HTML Format"
msgstr "Spara textdokument i HTML-format"

#. from libreoffice:swriter-guide
msgid "<bookmark_value>text documents; publishing in HTML</bookmark_value>  <bookmark_value>HTML documents; creating from text documents</bookmark_value>  <bookmark_value>homepage creation</bookmark_value>  <bookmark_value>saving;in HTML format</bookmark_value>"
msgstr "<bookmark_value>textdokument; publicera i HTML</bookmark_value>      <bookmark_value>HTML-dokument; skapa från textdokument</bookmark_value>      <bookmark_value>hemsida, skapa</bookmark_value>      <bookmark_value>spara;i HTML-format</bookmark_value>"

#. from libreoffice:swriter-guide
msgid "<variable id=\"send2html\"><link href=\"text/swriter/guide/send2html.xhp\">Saving Text Documents in HTML Format</link></variable>"
msgstr "<variable id=\"send2html\"><link href=\"text/swriter/guide/send2html.xhp\">Spara textdokument i HTML-format</link></variable>"

#. from libreoffice:swriter-guide
msgid "You can save a $[officename] Writer document in HTML format, so that you can view it in a web browser. If you want, you can associate a page break with a specific heading paragraph style to generate a separate HTML page each time the style appears in the document. $[officename] Writer automatically creates a page containing hyperlinks to each of these pages."
msgstr "Du kan spara ett $[officename] Writer dokument i HTML-format så att du kan visa det i en webbläsare. Om du vill kan du associera sidbrytningar med en viss formatmall för styckerubriker att generera en separat HTML-sida varje gång mallen används i dokumentet. $[officename] Writer skapar automatiskt en sida som innehåller hyperlänkar till var och en av dessa sidor."

#. from libreoffice:swriter-guide
msgid "When you save a text document in HTML format, any graphics in the document are saved into the HTML document as embedded data streams. $[officename] tries to keep the original format of graphics, i.e. JPEG pictures or SVG images will be saved into HTML as such. All other graphic formats are saved as PNG."
msgstr "När du sparar ett textdokument i html-format så kommer bilder att sparas som inbäddade dataströmmar i html-dokumentet. $[officename] försöker behålla originalformatet på bilden, dvs png, jpeg-bilder eller svg-bilder kommer att behålla sina format. Alla andra bildformat sparas som png."

#. from libreoffice:swriter-guide
msgid "Apply one of the default $[officename] heading paragraph styles, for example, \"Heading 1\", to the paragraphs where you want to generate a new HTML page."
msgstr "Använd bara en av $[officename]-standardmallarna för styckerubriker, t.ex. \"Rubrik 1\", för de stycken som du vill skapa en ny HTML-sida för."

#. from libreoffice:swriter-guide
msgid "Choose <emph>File - Send - Create HTML Document</emph>."
msgstr "Välj <emph>Arkiv - Skicka - Skapa HTML dokument</emph>."

#. from libreoffice:swriter-guide
msgid "In the <item type=\"menuitem\">Styles</item> box, select the paragraph style that you want to use to generate a new HTML page."
msgstr "Markera den styckeformatmall som du vill använda för att generera en ny HTML-sida i rutan <item type=\"menuitem\">Formatmall</item>               ."

#. from libreoffice:swriter-guide
msgid "Enter a path and a name for the HTML document, and then click <emph>Save</emph>."
msgstr "Ange en sökväg och ett namn för HTML dokumentet och klicka sedan på <emph>Spara</emph>."

#. from libreoffice:swriter-guide
msgid "Applying Text Formatting While You Type"
msgstr "Använda textformatering medan du skriver"

#. from libreoffice:swriter-guide
msgid "<bookmark_value>text; formatting bold while typing</bookmark_value>      <bookmark_value>formatting; bold, while typing</bookmark_value>      <bookmark_value>keyboard;bold formatting</bookmark_value>      <bookmark_value>bold;formatting while typing</bookmark_value>      <bookmark_value>shortcut keys;bold formatting</bookmark_value>"
msgstr "<bookmark_value>text; formatera i fetstil medan du skriver</bookmark_value>      <bookmark_value>formatera; fetstil, medan du skriver</bookmark_value>      <bookmark_value>tangentbord;formatera i fetstil</bookmark_value>      <bookmark_value>fetstil;formatera medan du skriver</bookmark_value>      <bookmark_value>kortkommandon;formatera i fetstil</bookmark_value>"

#. from libreoffice:swriter-guide
msgid "<variable id=\"shortcut_writing\"><link href=\"text/swriter/guide/shortcut_writing.xhp\">Applying Text Formatting While You Type</link></variable>"
msgstr "<variable id=\"shortcut_writing\"><link href=\"text/swriter/guide/shortcut_writing.xhp\">Använda textformatering medan du skriver</link></variable>"

#. from libreoffice:swriter-guide
msgid "To apply bold formatting"
msgstr "Så här använder du fetstil"

#. from libreoffice:swriter-guide
msgid "To apply italic formatting"
msgstr "Så här använder du fetstil"

#. from libreoffice:swriter-guide
msgid "Select the text that you want to format."
msgstr "Markera texten som du vill formatera."

#. from libreoffice:swriter-guide
msgid "Press <switchinline select=\"sys\"><caseinline select=\"MAC\">Command</caseinline><defaultinline>Ctrl</defaultinline></switchinline>+I."
msgstr "Tryck på <switchinline select=\"sys\"><caseinline select=\"MAC\">Kommando</caseinline><defaultinline>Ctrl</defaultinline></switchinline>+B."

#. from libreoffice:swriter-guide
msgid "You can also press <switchinline select=\"sys\"><caseinline select=\"MAC\">Command</caseinline><defaultinline>Ctrl</defaultinline></switchinline>+I, type the text that you want to format in italic, and then press <switchinline select=\"sys\"><caseinline select=\"MAC\">Command</caseinline><defaultinline>Ctrl</defaultinline></switchinline>+I when you are finished."
msgstr "Du kan också trycka på <switchinline select=\"sys\"><caseinline select=\"MAC\">Kommando </caseinline><defaultinline>Ctrl</defaultinline></switchinline>+B, skriva den text du vill ska vara i fetstil och sedan trycka på <switchinline select=\"sys\"><caseinline select=\"MAC\">Kommando </caseinline><defaultinline>Ctrl</defaultinline></switchinline>+B när du är klar."

#. from libreoffice:swriter-guide
msgid "To underline text"
msgstr "Stryka under text"

#. from libreoffice:swriter-guide
msgid "Select the text that you want to underline."
msgstr "Markera den text du vill omvandla till stora bokstäver."

#. from libreoffice:swriter-guide
msgid "Press <switchinline select=\"sys\"><caseinline select=\"MAC\">Command</caseinline><defaultinline>Ctrl</defaultinline></switchinline>+U."
msgstr "Tryck på <switchinline select=\"sys\"><caseinline select=\"MAC\">Kommando</caseinline><defaultinline>Ctrl</defaultinline></switchinline>+B."

#. from libreoffice:swriter-guide
msgid "You can also press <switchinline select=\"sys\"><caseinline select=\"MAC\">Command</caseinline><defaultinline>Ctrl</defaultinline></switchinline>+U, type the text that you want underlined, and then press <switchinline select=\"sys\"><caseinline select=\"MAC\">Command</caseinline><defaultinline>Ctrl</defaultinline></switchinline>+U when you are finished."
msgstr "Du kan också trycka på <switchinline select=\"sys\"><caseinline select=\"MAC\">Kommando </caseinline><defaultinline>Ctrl</defaultinline></switchinline>+B, skriva den text du vill ska vara i fetstil och sedan trycka på <switchinline select=\"sys\"><caseinline select=\"MAC\">Kommando </caseinline><defaultinline>Ctrl</defaultinline></switchinline>+B när du är klar."

#. from libreoffice:swriter-guide
msgid "<link href=\"text/swriter/04/01020000.xhp\">Keyboard shortcut for text documents</link>"
msgstr "<link href=\"text/swriter/04/01020000.xhp\">Kortkommandon för textdokument</link>"

#. from libreoffice:swriter-guide
msgid "<link href=\"text/shared/main0400.xhp\">Keyboard shortcut in $[officename]</link>"
msgstr "<link href=\"text/shared/main0400.xhp\">Kortkommandon i $[officename]</link>"

#. from libreoffice:swriter-guide
msgid "Using Smart Tags"
msgstr "Använda smarta etiketter"

#. from libreoffice:swriter-guide
msgid "<bookmark_value>smart tags</bookmark_value><bookmark_value>AutoCorrect function; smart tags</bookmark_value><bookmark_value>options;smart tags</bookmark_value><bookmark_value>disabling;smart tags</bookmark_value><bookmark_value>installing;smart tags</bookmark_value>"
msgstr "<bookmark_value>smarta etiketter</bookmark_value><bookmark_value>Autokorrigeringsfunktion; smarta etiketter</bookmark_value><bookmark_value>alternativ;smarta etiketter</bookmark_value><bookmark_value>inaktivera;smarta etiketter</bookmark_value><bookmark_value>installera;smarta etiketter</bookmark_value>"

#. from libreoffice:swriter-guide
msgid "<variable id=\"smarttags\"><link href=\"text/swriter/guide/smarttags.xhp\">Using Smart Tags</link></variable>"
msgstr "<variable id=\"smarttags\"><link href=\"text/swriter/guide/smarttags.xhp\">Använda smarta etiketter</link></variable>"

#. from libreoffice:swriter-guide
msgid "Smart Tags provide additional information and functionality to specified words in a Writer document. The available features can be different for different Smart Tags extensions."
msgstr "Smarta etiketter ger ytterligare information och funktionalitet till angivna ord i ett Writer-dokument. Tillgängliga funktioner kan skilja sig från olika paket för smarta etiketter."

#. from libreoffice:swriter-guide
msgid "Installing Smart Tags"
msgstr "Installera smarta etiketter"

#. from libreoffice:swriter-guide
msgid "Smart Tags can be supplied as <link href=\"text/shared/01/packagemanager.xhp\">extensions</link> to %PRODUCTNAME Writer."
msgstr "Smarta etiketter kan användas som <link href=\"text/shared/01/packagemanager.xhp\">paket</link> till %PRODUCTNAME Writer."

#. from libreoffice:swriter-guide
msgid "To install a Smart Tag, do one of the following:"
msgstr "Installera en smart etikett genom att göra något av följande:"

#. from libreoffice:swriter-guide
msgid "Click a Smart Tag *.oxt file link on a web page and open the link with the default application. This requires a properly configured Web browser."
msgstr "Klicka på en *.oxt-fillänk för en smart etikett på en webbsida och öppna länken i standardwebbläsaren. Det kräver en korrekt installerad webbläsare."

#. from libreoffice:swriter-guide
msgid "Smart Tags Menu"
msgstr "Menyn Smarta etiketter"

#. from libreoffice:swriter-guide
msgid "In the Smart Tags menu you see the available actions that are defined for this Smart Tag. Choose an option from the menu. The <item type=\"menuitem\">Smart Tags Options</item> command opens the <link href=\"text/shared/01/06040700.xhp\">Smart Tags</link> page of Tools - Autocorrect Options."
msgstr "I menyn Smarta etiketter ser du de tillgängliga åtgärder som är definierade för just den smarta etiketten. Välj ett alternativ ur menyn. Kommadot <item type=\"menuitem\">Alternativ Smarta etiketter</item> öppnar sidan <link href=\"text/shared/01/06040700.xhp\">Smarta etiketter</link> i Verktyg - Autokorrigering."

#. from libreoffice:swriter-guide
msgid "To Enable and Disable Smart Tags"
msgstr "Så här gör du för att aktivera och inaktivera smarta etiketter"

#. from libreoffice:swriter-guide
msgid "Text that is recognized as a Smart Tag is not checked by the automatic spellcheck."
msgstr "Text som identifieras som smart etikett kontrolleras inte av stavningskontrollen."

#. from libreoffice:swriter-guide
msgid "Checking Spelling and Grammar"
msgstr "Kontrollera stavning och grammatik"

#. from libreoffice:swriter-guide
msgid "<bookmark_value>spellcheck; checking text documents manually</bookmark_value>  <bookmark_value>checking spelling;manually</bookmark_value>  <bookmark_value>grammar checker</bookmark_value>"
msgstr "<bookmark_value>rättstavning; kontrollera textdokument manuellt</bookmark_value>      <bookmark_value>kontrollera stavning;manuellt</bookmark_value>      <bookmark_value>kontrollera grammatik</bookmark_value>"

#. from libreoffice:swriter-guide
msgid "<variable id=\"spellcheck_dialog\"><link href=\"text/swriter/guide/spellcheck_dialog.xhp\">Checking Spelling and Grammar</link></variable>"
msgstr "<variable id=\"spellcheck_dialog\"><link href=\"text/swriter/guide/spellcheck_dialog.xhp\">Kontrollera stavning och grammatik</link></variable>"

#. from libreoffice:swriter-guide
msgid "You can manually check the spelling and grammar of a text selection or the entire document."
msgstr "Du kan kontrollera stavningen och grammatiken manuellt i ett markerat textavsnitt eller i hela dokumentet."

#. from libreoffice:swriter-guide
msgid "The spellcheck starts at the current cursor position, or at the beginning of the text selection."
msgstr "Rättstavningskontrollen börjar vid markörens aktuella position, eller i början av det markerade textområdet."

#. from libreoffice:swriter-guide
msgid "Click in the document, or select the text that you want to check."
msgstr "Klicka i dokumentet eller markera den text som du vill kontrollera."

#. from libreoffice:swriter-guide
msgid "To accept a correction, click the suggestion, and then click <emph>Correct</emph>."
msgstr "Om du vill acceptera korrigeringen klickar du på <emph>Ändra</emph>."

#. from libreoffice:swriter-guide
msgid "Edit the sentence in the upper text box, and then click <emph>Correct</emph>."
msgstr "Skriv en mening i övre textrutan, och klicka sedan på <emph>Ändra</emph>."

#. from libreoffice:swriter-guide
msgid "To add the unknown word to a user-defined dictionary, click <emph>Add to Dictionary</emph>."
msgstr "Lägg till ordet i en användarordlista genom att klicka på <emph>Lägg till i ordlista</emph>."

#. from libreoffice:swriter-guide
msgid "Applying Styles in Fill Format Mode"
msgstr "Använda formatmallar med hjälp av tilldelningsläget"

#. from libreoffice:swriter-guide
msgid "<bookmark_value>fill format mode</bookmark_value>      <bookmark_value>copying; styles, by fill format mode</bookmark_value>      <bookmark_value>brush for copying styles</bookmark_value>      <bookmark_value>styles; transferring</bookmark_value>      <bookmark_value>formats; copying and pasting</bookmark_value>      <bookmark_value>text formats; copying and pasting</bookmark_value>"
msgstr "<bookmark_value>tilldelningsläge</bookmark_value>      <bookmark_value>kopiera; formatmallar, via tilldelningsläge</bookmark_value>      <bookmark_value>pensel för att kopiera formatmallar</bookmark_value>      <bookmark_value>formatmallar; överföra</bookmark_value>      <bookmark_value>format; kopiera och klistra in</bookmark_value>      <bookmark_value>textformat; kopiera och klistra in</bookmark_value>"

#. from libreoffice:swriter-guide
msgid "<variable id=\"stylist_fillformat\"><link href=\"text/swriter/guide/stylist_fillformat.xhp\">Applying Styles in Fill Format Mode</link></variable>"
msgstr "<variable id=\"stylist_fillformat\"><link href=\"text/swriter/guide/stylist_fillformat.xhp\">Använda mallar i tilldelningsläge</link></variable>"

#. from libreoffice:swriter-guide
msgid "Click the icon of the style category that you want to apply."
msgstr "Klicka på ikonen för den formatmallskategori som du vill använda."

#. from libreoffice:swriter-guide
msgid "Move the mouse pointer to where you want to apply the style in the document, and click. To apply the style to more than one item, drag to select the items, and then release."
msgstr "Flytta muspekaren till platsen där du vill använda mallen i dokumentet och klicka. Om du vill använda mallen för mer än ett objekt drar du och markerar objekten och släpper."

#. from libreoffice:swriter-guide
msgid "Press <item type=\"keycode\">Esc</item> when finished."
msgstr "Tryck på <item type=\"keycode\">Esc</item> när du är klar."

#. from libreoffice:swriter-guide
msgid "Creating New Styles From Selections"
msgstr "Skapa nya formatmallar från markeringar"

#. from libreoffice:swriter-guide
msgid "<bookmark_value>styles; creating from selections</bookmark_value>  <bookmark_value>drag and drop;creating new styles</bookmark_value>  <bookmark_value>copying;styles, from selections</bookmark_value>"
msgstr "<bookmark_value>formatmallar; skapa från markeringar</bookmark_value>      <bookmark_value>dra och släpp;skapa nya formatmallar</bookmark_value>      <bookmark_value>kopiera;formatmallar, från markeringar</bookmark_value>"

#. from libreoffice:swriter-guide
msgid "<variable id=\"stylist_fromselect\"><link href=\"text/swriter/guide/stylist_fromselect.xhp\">Creating New Styles From Selections</link></variable>"
msgstr "<variable id=\"stylist_fromselect\"><link href=\"text/swriter/guide/stylist_fromselect.xhp\">Skapa nya formatmallar av markering</link></variable>"

#. from libreoffice:swriter-guide
msgid "To Create a New Style From a Manually Formatted Selection"
msgstr "Så här skapar du en ny formatmall av en manuellt formaterad markering"

#. from libreoffice:swriter-guide
msgid "To Create a New Style by Drag-And-Drop"
msgstr "Så här skapar du en ny formatmall genom att dra och släppa"

#. from libreoffice:swriter-guide
msgid "Updating Styles From Selections"
msgstr "Uppdatera formatmallar från markeringar"

#. from libreoffice:swriter-guide
msgid "<variable id=\"stylist_update\"><link href=\"text/swriter/guide/stylist_update.xhp\">Updating Styles From Selections</link></variable>"
msgstr "<variable id=\"stylist_update\"><link href=\"text/swriter/guide/stylist_update.xhp\">Uppdatera formatmall från markering</link></variable>"

#. from libreoffice:swriter-guide
msgid "Click the icon of the style category that you want to update."
msgstr "Klicka på ikonen för den formatmallskategori som du vill uppdatera."

#. from libreoffice:swriter-guide
msgid "In the document, click from where you want to copy the updated style. For example, click a paragraph to which you applied some manual formatting that you want to copy now."
msgstr "Klicka på den plats i dokumentet från vilken du vill kopiera den uppdaterade formatmallen. Du kan t.ex. klicka på ett stycke där du har tillämpat manuell formatering som du vill kopiera nu."

#. from libreoffice:swriter-guide
msgid "Making Text Superscript or Subscript"
msgstr "Använda upphöjd eller nedsänkt text"

#. from libreoffice:swriter-guide
msgid "<variable id=\"subscript\"><link href=\"text/swriter/guide/subscript.xhp\">Making Text Superscript or Subscript</link></variable>"
msgstr "<variable id=\"subscript\"><link href=\"text/swriter/guide/subscript.xhp\">Använda upphöjd och nedsänkt text</link></variable>"

#. from libreoffice:swriter-guide
msgid "Select the text that you want to make superscript or subscript."
msgstr "Markera texten som du vill göra upphöjd eller nedsänkt."

#. from libreoffice:swriter-guide
msgid "Choose <emph>Format - Character - Position</emph>, and then select <emph>Superscript</emph> or <emph>Subscript</emph>."
msgstr "Välj <emph>Format - Tecken - Placering</emph> och välj <emph>Upphöjt</emph> eller <emph>Nedsänkt</emph>."

#. from libreoffice:swriter-guide
msgid "<link href=\"text/shared/01/05020500.xhp\">Format - Character - Position</link>"
msgstr "<link href=\"text/shared/01/05020500.xhp\">Format - Tecken - Position</link>"

#. from libreoffice:swriter-guide
msgid "<link href=\"text/shared/01/06040200.xhp\">Tools - AutoCorrect - Replace</link>"
msgstr "<link href=\"text/shared/01/06040200.xhp\">Verktyg - Autokorrigering - Ersätt</link>"

#. from libreoffice:swriter-guide
msgid "Merging and Splitting Cells"
msgstr "Sammanfoga och dela upp celler"

#. from libreoffice:swriter-guide
msgid "<bookmark_value>cells; merging/splitting</bookmark_value>      <bookmark_value>tables; merging cells</bookmark_value>      <bookmark_value>cell merges</bookmark_value>      <bookmark_value>splitting cells;by menu command</bookmark_value>      <bookmark_value>merging;cells</bookmark_value>"
msgstr "<bookmark_value>celler; sammanfoga/dela upp</bookmark_value>      <bookmark_value>tabeller; sammanfoga celler</bookmark_value>      <bookmark_value>cellsammanfogning</bookmark_value>      <bookmark_value>dela upp celler;med menykommando</bookmark_value>      <bookmark_value>sammanfoga;celler</bookmark_value>"

#. from libreoffice:swriter-guide
msgid "<variable id=\"table_cellmerge\"><link href=\"text/swriter/guide/table_cellmerge.xhp\">Merging and Splitting Cells</link></variable>"
msgstr "<variable id=\"table_cellmerge\"><link href=\"text/swriter/guide/table_cellmerge.xhp\">Sammanfoga och dela upp celler</link></variable>"

#. from libreoffice:swriter-guide
msgid "You can select adjacent cells, then merge them into a single cell. Conversely, you can take a large cell and divide it into individual cells."
msgstr "Du kan sammanfoga angränsande celler till en enda cell. Du kan även dela upp en stor cell i individuella celler."

#. from libreoffice:swriter-guide
msgid "To Merge Cells"
msgstr "Så här sammanfogar du celler"

#. from libreoffice:swriter-guide
msgid "Select the adjacent cells."
msgstr "Välj angränsande celler."

#. from libreoffice:swriter-guide
msgid "Choose <emph>Table - Merge Cells</emph>."
msgstr "Välj <emph>Tabell - Sammanfoga celler</emph>."

#. from libreoffice:swriter-guide
msgid "To Split Cells"
msgstr "Så här delar du upp celler"

#. from libreoffice:swriter-guide
msgid "Place the cursor in the cell to be split."
msgstr "Placera markören i cellen som ska delas."

#. from libreoffice:swriter-guide
msgid "Choose <emph>Table - Split Cells</emph>."
msgstr "Välj <emph>Tabell - Dela celler</emph>."

#. from libreoffice:swriter-guide
msgid "A dialog allows you to split the cell into two or more cells, horizontally or vertically."
msgstr "I dialogrutan kan du välja att dela upp cellen i två eller fler celler, horisontellt eller vertikalt."

#. from libreoffice:swriter-guide
msgid "Deleting Tables or the Contents of a Table"
msgstr "Ta bort tabeller eller innehållet i en tabell"

#. from libreoffice:swriter-guide
msgid "<bookmark_value>deleting; tables or table contents</bookmark_value>      <bookmark_value>tables; deleting</bookmark_value>"
msgstr "<bookmark_value>ta bort; tabeller eller tabellinnehåll</bookmark_value>      <bookmark_value>tabeller; ta bort</bookmark_value>"

#. from libreoffice:swriter-guide
msgid "<variable id=\"table_delete\"><link href=\"text/swriter/guide/table_delete.xhp\">Deleting Tables or the Contents of a Table</link></variable>"
msgstr "<variable id=\"table_delete\"><link href=\"text/swriter/guide/table_delete.xhp\">Ta bort tabeller eller innehållet i en tabell</link></variable>"

#. from libreoffice:swriter-guide
msgid "You can delete a table from your document, or delete the contents of the table."
msgstr "Du kan ta bort en tabell från dokumentet eller ta bort innehållet i tabellen."

#. from libreoffice:swriter-guide
msgid "To delete a whole table, click in the table, and then choose <emph>Table - Delete - Table</emph>."
msgstr "Om du vill ta bort en hel tabell klickar du i tabellen och väljer <emph>Tabell - Radera - Tabell</emph>."

#. from libreoffice:swriter-guide
msgid "To delete the contents of a table, click in the table, press <switchinline select=\"sys\"><caseinline select=\"MAC\">Command</caseinline><defaultinline>Ctrl</defaultinline></switchinline>+A until all cells are selected, and then press Delete or Backspace."
msgstr "Om du vill ta bort innehållet i en tabell klickar du i tabellen, trycker på <switchinline select=\"sys\"><caseinline select=\"MAC\">Kommando</caseinline><defaultinline>Ctrl</defaultinline></switchinline>+A tills alla celler har markerats och trycker sedan på Delete eller Backsteg."

#. from libreoffice:swriter-guide
msgid "Inserting Tables"
msgstr "Infoga tabeller"

#. from libreoffice:swriter-guide
msgid "<bookmark_value>tables; inserting text tables</bookmark_value>      <bookmark_value>inserting; tables in text</bookmark_value>      <bookmark_value>DDE; inserting tables</bookmark_value>      <bookmark_value>OLE objects; inserting tables in</bookmark_value>      <bookmark_value>cells;inserting from spreadsheets</bookmark_value>      <bookmark_value>tables in spreadsheets;inserting in text</bookmark_value>      <bookmark_value>spreadsheets;inserting tables from</bookmark_value>"
msgstr "<bookmark_value>Tabeller; infoga texttabeller</bookmark_value><bookmark_value>Infoga; tabeller i text</bookmark_value><bookmark_value>DDE; infoga tabeller</bookmark_value><bookmark_value>OLE-objekt; infoga tabeller i</bookmark_value><bookmark_value>Celler; infoga från kalkylblad</bookmark_value><bookmark_value>Tabeller i kalkylblad; infoga i text</bookmark_value><bookmark_value>Kalkylblad; infoga tabeller från</bookmark_value>"

#. from libreoffice:swriter-guide
msgid "<variable id=\"table_insert\"><link href=\"text/swriter/guide/table_insert.xhp\">Inserting Tables</link></variable>"
msgstr "<variable id=\"table_insert\"><link href=\"text/swriter/guide/table_insert.xhp\">Infoga tabell</link></variable>"

#. from libreoffice:swriter-guide
msgid "There are several ways to create a table in a text document. You can insert a table from a toolbar, through a menu command, or from a spreadsheet."
msgstr "Det finns flera sätt att skapa en tabell i ett textdokument. Du kan infoga en tabell från en verktygsrad, med ett menykommando eller från ett kalkylblad."

#. from libreoffice:swriter-guide
msgid "To Insert a Table From a Toolbar"
msgstr "Så här infogar du en tabell från verktygsraden Infoga"

#. from libreoffice:swriter-guide
msgid "On the <emph>Standard</emph> or the <emph>Insert</emph> bar, click the arrow next to the <emph>Table</emph> icon."
msgstr "Klicka på pilen bredvid ikonen <emph>Tabell</emph> på verktygsraden <emph>Standard</emph> eller <emph>Infoga</emph>."

#. from libreoffice:swriter-guide
msgid "In the table grid, drag to select the numbers of rows and columns that you want, and then release."
msgstr "Dra och markera antalet rader och kolumner som du vill ha i tabellgittret och släpp sedan."

#. from libreoffice:swriter-guide
msgid "To cancel, drag to the other side until <emph>Cancel</emph> appears in the preview area of the grid."
msgstr "Om du vill avbryta drar du till den andra sidan tills <emph>Avbryt</emph> visas i gittrets granskningsruta."

#. from libreoffice:swriter-guide
msgid "To Insert a Table With a Menu Command"
msgstr "Så här infogar du en tabell med ett menykommando"

#. from libreoffice:swriter-guide
msgid "Place the cursor in your document where you want to insert the table."
msgstr "Placera markören i dokumentet där du vill infoga tabellen."

#. from libreoffice:swriter-guide
msgid "In the <emph>Size</emph> area, enter the number of rows and columns."
msgstr "Under <emph>Storlek</emph> anger du antalet rader och kolumner."

#. from libreoffice:swriter-guide
msgid "Select the options that you want, click <emph>OK</emph>."
msgstr "Markera alternativen som du vill använda och klicka på <emph>OK</emph>."

#. from libreoffice:swriter-guide
msgid "To Insert a Table From a Calc Spreadsheet"
msgstr "Så här infogar du en tabell från ett Calc-kalkylblad"

#. from libreoffice:swriter-guide
msgid "In your text document, do one of the following:"
msgstr "I textdokumentet gör du något av följande:"

#. from libreoffice:swriter-guide
msgid "Choose <emph>Edit - Paste</emph>. The cell range is pasted as an OLE object. To edit the contents of the cells, double-click the object."
msgstr "Välj <emph>Redigera - Klistra in</emph>. Cellområdet klistras in som ett OLE-objekt. För att redigera cellernas innehåll så dubbelklickar du på objektet."

#. from libreoffice:swriter-guide
msgid "Choose <emph>Edit - Paste Special</emph>, and choose from the following options:"
msgstr "Välj <emph>Redigera - Förteckningspost</emph> och gör något av följande:"

#. from libreoffice:swriter-guide
msgid "Is inserted as..."
msgstr "<emph>Klistras in som...</emph>"

#. from libreoffice:swriter-guide
msgid "$[officename] $[officeversion] Spreadsheet"
msgstr "\"$[officename] $[officeversion]-tabell\" eller \"Star Embed Source\""

#. from libreoffice:swriter-guide
msgid "OLE object - as with <switchinline select=\"sys\"><caseinline select=\"MAC\">Command</caseinline><defaultinline>Ctrl</defaultinline></switchinline>+V or drag-and-drop"
msgstr "OLE-objekt - som med <switchinline select=\"sys\"><caseinline select=\"MAC\">Kommando</caseinline><defaultinline>Ctrl</defaultinline></switchinline>+V eller dra och släpp"

#. from libreoffice:swriter-guide
msgid "GDIMetaFile"
msgstr "GDI-metafil"

#. from libreoffice:swriter-guide
msgid "HTML table"
msgstr "HTML-tabell"

#. from libreoffice:swriter-guide
msgid "Text only, tab stops as separators"
msgstr "Bara text, tabbar som avgränsare"

#. from libreoffice:swriter-guide
msgid "Formatted text [RTF]"
msgstr "Formaterad text [RTF]"

#. from libreoffice:swriter-guide
msgid "Text table"
msgstr "Texttabell"

#. from libreoffice:swriter-guide
msgid "Drag-and-Drop a Cell Range From a Calc Spreadsheet"
msgstr "Dra-och-släpp ett cellområde från ett Calc kalkylblad"

#. from libreoffice:swriter-guide
msgid "Open the $[officename] Calc spreadsheet containing the cell range that you want to insert."
msgstr "Öppna kalkylbladet för $[officename] Calc som innehåller cellintervallet som du vill infoga."

#. from libreoffice:swriter-guide
msgid "In the spreadsheet, drag to select the cells."
msgstr "Markera cellerna i kalkylbladet genom att dra med musen."

#. from libreoffice:swriter-guide
msgid "Click and hold the mouse button in the selected cells."
msgstr "Klicka i de markerade cellerna och håll ned musknappen."

#. from libreoffice:swriter-guide
msgid "Drag the selected cells into the text document."
msgstr "Dra de markerade cellerna till textdokumentet."

#. from libreoffice:swriter-guide
msgid "Repeating a Table Header on a New Page"
msgstr "Upprepa en tabellrubrik på en ny sida"

#. from libreoffice:swriter-guide
msgid "<variable id=\"table_repeat_multiple_headers\"><link href=\"text/swriter/guide/table_repeat_multiple_headers.xhp\">Repeating a Table Heading on a New Page</link></variable>"
msgstr "<variable id=\"table_repeat_multiple_headers\"><link href=\"text/swriter/guide/table_repeat_multiple_headers.xhp\">Upprepa en tabellrubrik på en ny sida</link></variable>"

#. from libreoffice:swriter-guide
msgid "You can repeat a table heading on each new page that the table spans."
msgstr "Du kan upprepa en tabellrubrik på varje ny sida som tabellen spänner över."

#. from libreoffice:swriter-guide
msgid "Select the number of rows and columns for the table."
msgstr "Markera antalet rader och kolumner för tabellen."

#. from libreoffice:swriter-guide
msgid "Selecting Tables, Rows, and Columns"
msgstr "Markera tabeller, rader och kolumner"

#. from libreoffice:swriter-guide
msgid "<bookmark_value>selecting;tables</bookmark_value><bookmark_value>tables;selecting</bookmark_value><bookmark_value>columns;selecting</bookmark_value><bookmark_value>rows;selecting</bookmark_value>"
msgstr "<bookmark_value>Markera;tabeller</bookmark_value><bookmark_value>Tabeller;markera</bookmark_value><bookmark_value>Kolumner;markera</bookmark_value><bookmark_value>Rader;markera</bookmark_value>"

#. from libreoffice:swriter-guide
msgid "<variable id=\"table_select\"><link href=\"text/swriter/guide/table_select.xhp\">Selecting Tables, Rows, and Columns</link></variable>"
msgstr "<variable id=\"table_select\"><link href=\"text/swriter/guide/table_select.xhp\">Markera tabeller, rader och kolumner</link></variable>"

#. from libreoffice:swriter-guide
msgid "You can select a table in a text document with a keyboard or with a mouse."
msgstr "Du kan markera en tabell i ett textdokument med tangentbordet eller musen."

#. from libreoffice:swriter-guide
msgid "To select a table with the keyboard, move the cursor into the table, and then press <switchinline select=\"sys\"><caseinline select=\"MAC\">Command</caseinline><defaultinline>Ctrl</defaultinline></switchinline>+A until all the cells are selected."
msgstr "Om du vill markera en tabell med tangentbordet, placerar du markören i tabellen och trycker sedan på <switchinline select=\"sys\"><caseinline select=\"MAC\">Kommando </caseinline><defaultinline>Ctrl</defaultinline></switchinline>+A tills alla celler har markerats."

#. from libreoffice:swriter-guide
msgid "To select a table with the mouse, move the mouse pointer to a position just above and left of the table. The mouse pointer becomes a diagonal arrow. Click to select the table."
msgstr "Om du vill markera en tabell med musen placerar du muspekaren strax ovanför och till vänster om tabellen. Muspekaren ändras till en diagonal pil. Markera tabellen genom att klicka."

#. from libreoffice:swriter-guide
msgid "To select a row or column with the mouse, point to a position just left of the row or above the column. The mouse pointer becomes an arrow. Click to select the row or column."
msgstr "Du markerar en rad eller kolumn med musen genom att peka på en plats strax till vänster om raden eller ovanför kolumnen. Muspekaren ändras till en pil. Markera raden eller kolumnen genom att klicka."

#. from libreoffice:swriter-guide
msgid "Resizing Rows and Columns in a Text Table"
msgstr "Ändra storlek på rader och kolumner i en texttabell"

#. from libreoffice:swriter-guide
msgid "<bookmark_value>cells; enlarging and reducing in text tables</bookmark_value><bookmark_value>table cells; enlarging/reducing in text</bookmark_value><bookmark_value>keyboard; resizing rows/columns</bookmark_value><bookmark_value>resizing;rows and columns in text tables</bookmark_value><bookmark_value>enlarging columns,cells and table rows</bookmark_value><bookmark_value>reducing rows and columns in text tables</bookmark_value><bookmark_value>tables; resizing/juxtaposing</bookmark_value><bookmark_value>juxtaposing tables</bookmark_value><bookmark_value>heights of table rows</bookmark_value><bookmark_value>widths of table columns</bookmark_value><bookmark_value>rows;resizing in tables</bookmark_value><bookmark_value>columns;resizing in tables</bookmark_value><bookmark_value>column widths in tables</bookmark_value>"
msgstr "<bookmark_value>celler; förstora och förminska i texttabeller</bookmark_value>      <bookmark_value>tabellceller; förstora/förminska i text</bookmark_value>      <bookmark_value>tangentbord; ändra storlek på rader/kolumner</bookmark_value>      <bookmark_value>ändra storlek på; rader och kolumner i texttabeller</bookmark_value>      <bookmark_value>förstora kolumner, celler och tabellrader</bookmark_value>      <bookmark_value>förminska rader och kolumner i texttabeller</bookmark_value>      <bookmark_value>tabeller; ändra storlek på/kasta om.</bookmark_value>      <bookmark_value>kasta om tabeller</bookmark_value><bookmark_value>höjd på tabellrader</bookmark_value><bookmark_value>bredd på tabellrader</bookmark_value><bookmark_value>rader; ändra storlek i tabeller</bookmark_value><bookmark_value>kolumner; ändra storlek i tabeller</bookmark_value><bookmark_value>kolumnbredd i tabeller</bookmark_value>"

#. from libreoffice:swriter-guide
msgid "<variable id=\"table_sizing\"><link href=\"text/swriter/guide/table_sizing.xhp\">Resizing Rows and Columns in a Text Table</link></variable>"
msgstr "<variable id=\"table_sizing\"><link href=\"text/swriter/guide/table_sizing.xhp\">Ändra storlek på rader och kolumner i en texttabell</link></variable>"

#. from libreoffice:swriter-guide
msgid "You can resize the width of table cells and columns, as well as change the height of table rows."
msgstr "Du kan ändra bredd och höjd för celler, kolumner och rader i en tabell."

#. from libreoffice:swriter-guide
msgid "Changing the Width of Columns and Cells"
msgstr "Ändra bredd för kolumner och celler"

#. from libreoffice:swriter-guide
msgid "To Change the Width of a Column"
msgstr "Så här ändrar du bredden på en kolumn"

#. from libreoffice:swriter-guide
msgid "Rest the mouse pointer over the column dividing line until the pointer becomes a separator icon, and then drag the line to a new location."
msgstr "Vila muspekaren ovanför kolumndelningslinjen tills pekaren blir en avgränsarsymbol och dra sedan linjen till en ny plats."

#. from libreoffice:swriter-guide
msgid "Rest the mouse pointer over the column dividing line on the ruler until the pointer becomes a separator icon, and then drag the line to a new location."
msgstr "Vila muspekaren ovanför kolumndelningslinjen på linjalen tills pekaren blir en avgränsarsymbol och dra sedan linjen till en ny plats."

#. from libreoffice:swriter-guide
msgid "You can specify the behavior for the arrow keys by choosing <switchinline select=\"sys\"><caseinline select=\"MAC\"><emph>%PRODUCTNAME - Preferences</emph></caseinline><defaultinline><emph>Tools - Options</emph></defaultinline></switchinline><emph> - %PRODUCTNAME Writer - Table</emph>, and selecting the options that you want in the <emph>Keyboard handling</emph> area."
msgstr "Du kan ange hur piltangenterna ska fungera genom att välja <switchinline select=\"sys\"><caseinline select=\"MAC\"><emph>%PRODUCTNAME – Inställningar</emph></caseinline><defaultinline><emph>Verktyg – Alternativ</emph></defaultinline></switchinline><emph> – %PRODUCTNAME Writer – Tabell</emph> och markera de alternativ du vill använda under <emph>Användning av tangentbordet</emph>."

#. from libreoffice:swriter-guide
msgid "To Change the Width of a Cell"
msgstr "Så här ändrar du bredden på en cell"

#. from libreoffice:swriter-guide
msgid "Hold down <switchinline select=\"sys\"><caseinline select=\"MAC\">Option+Command</caseinline><defaultinline>Alt+Ctrl</defaultinline></switchinline>, and then press the left or the right arrow key"
msgstr "Håll ned <switchinline select=\"sys\"><caseinline select=\"MAC\">Alternativ+Kommando</caseinline><defaultinline>Alt+Ctrl</defaultinline></switchinline> och tryck sedan på vänster eller höger piltangent"

#. from libreoffice:swriter-guide
msgid "Changing the Height of a Row"
msgstr "Ändra höjden för en rad"

#. from libreoffice:swriter-guide
msgid "To change the height of a row, place the cursor in a cell in the row, hold down the <switchinline select=\"sys\"><caseinline select=\"MAC\">Option</caseinline><defaultinline>Alt</defaultinline></switchinline> key, and then press the up or the down arrow key."
msgstr "Om du vill ändra höjden för en rad placerar du markören i en cell i raden, håller ned <switchinline select=\"sys\"><caseinline select=\"MAC\">Alternativ</caseinline><defaultinline>Alt</defaultinline></switchinline> och trycker sedan på uppåtpil- eller nedåtpiltangenten."

#. from libreoffice:swriter-guide
msgid "Resizing a Whole Table"
msgstr "Ändra storlek på en hel tabell"

#. from libreoffice:swriter-guide
msgid "To change the width and height of a table, do one of the following:"
msgstr "Om du vill ändra bredd och höjd på en tabell gör du något av följande:"

#. from libreoffice:swriter-guide
msgid "Click inside the table. In the rulers, drag the border between the white and the gray area to resize the table."
msgstr "Klicka på tabellen. Om du vill ändra storlek på tabellen drar du i kanten mellan det vita och grå området på linjalerna"

#. from libreoffice:swriter-guide
msgid "Tables within HTML pages do not offer the full range of properties and commands as tables in OpenDocument format."
msgstr "Det går inte att tilldela tabeller på HTML-sidor alla de egenskaper och kommandon som du kan tilldela tabeller i OpenDocument-format."

#. from libreoffice:swriter-guide
msgid "Modifying Rows and Columns by Keyboard"
msgstr "Ändra rader och kolumner med tangentbordet"

#. from libreoffice:swriter-guide
msgid "<bookmark_value>table mode selection</bookmark_value><bookmark_value>proportional distribution of tables</bookmark_value><bookmark_value>relative distribution of table cells</bookmark_value><bookmark_value>tables; adapting the width by keyboard</bookmark_value><bookmark_value>cells; adapting the width by keyboard</bookmark_value><bookmark_value>keyboard;modifying the behavior of rows/columns</bookmark_value><bookmark_value>behavior of rows/columns</bookmark_value>"
msgstr "<bookmark_value>Tabellmarkeringsläge</bookmark_value><bookmark_value>Relativ fördelning av tabeller</bookmark_value><bookmark_value>Relativ fördelning av tabellceller</bookmark_value><bookmark_value>Tabeller; anpassa bredden med tangentbordet</bookmark_value><bookmark_value>Celler; anpassa bredden med tangentbordet</bookmark_value><bookmark_value>Tangentbordet;ändra rad- och kolumnbeteendet</bookmark_value><bookmark_value>Rad- och kolumnbeteende</bookmark_value>"

#. from libreoffice:swriter-guide
msgid "<variable id=\"tablemode\"><link href=\"text/swriter/guide/tablemode.xhp\">Modifying Rows and Columns by Keyboard</link></variable>"
msgstr "<variable id=\"tablemode\"><link href=\"text/swriter/guide/tablemode.xhp\">Ändra rader och kolumner med tangentbordet</link></variable>"

#. from libreoffice:swriter-guide
msgid "When you insert or delete cells, rows or columns in a table, the <item type=\"menuitem\">Behavior of rows/columns</item> options determine how the neighboring elements are affected. For example, you can only insert new rows and columns into a table with fixed row and column dimensions if space permits."
msgstr "När du infogar eller tar bort celler, rader eller kolumner i en tabell så bestämmer alternativen i <item type=\"menuitem\">Effekt av ändringar</item> hur angränsande element påverkas. Du kan bara infoga nya rader och kolumner i en tabell med fasta rad- och kolumnmått om utrymmet är tillräckligt."

#. from libreoffice:swriter-guide
msgid "Note that these properties are valid only for changes to the column width that are made using the keyboard. Using the mouse, you are free to make any column width changes."
msgstr "Observera att egenskaperna i fråga endast gäller ändringar av kolumnbredden som görs med hjälp av tangentbordet. Använder du musen kan du göra alla slags ändringar av kolumnbredden."

#. from libreoffice:swriter-guide
msgid "<emph>Fixed</emph> - changes only affect the adjacent cell, and not the entire table. For example, when you widen a cell, the adjacent cell becomes narrower, but the width of the table remains constant."
msgstr "<emph>Fast</emph> - Endast angränsande celler påverkas och inte hela tabellen. När du t.ex. breddar en cell förblir tabellens bredd konstant, men angränsande celler blir smalare."

#. from libreoffice:swriter-guide
msgid "<emph>Fixed, proportional</emph> - changes affect the entire table, and wide cells shrink more than narrow cells. For example, when you widen a cell, the adjacent cells become proportionally narrower, but the width of the table remains constant."
msgstr "<emph>Fast, proportionell</emph> - Hela tabellen påverkas och breda celler förminskas mer än smala. När du t.ex. breddar en cell förblir tabellens bredd konstant, men angränsande celler blir proportionellt smalare."

#. from libreoffice:swriter-guide
msgid "<emph>Variable</emph> - changes affect the table size. For example, when you widen a cell, the width of the table increases."
msgstr "<emph>Variabel</emph> - Tabellens storlek påverkas. När du t.ex. breddar en cell ökar tabellens bredd."

#. from libreoffice:swriter-guide
msgid "<bookmark_value>formatting styles; styles and templates</bookmark_value>      <bookmark_value>styles; styles and templates</bookmark_value>      <bookmark_value>organizing; templates (guide)</bookmark_value>      <bookmark_value>templates; organizing (guide)</bookmark_value>"
msgstr "<bookmark_value>mallar; formatmallar och dokumentmallar</bookmark_value>      <bookmark_value>formatmallar; format och mallar</bookmark_value>      <bookmark_value>administrera; dokumentmallar (guide)</bookmark_value>      <bookmark_value>dokumentmallar; administrera (guide)</bookmark_value>"

#. from libreoffice:swriter-guide
msgid "<variable id=\"templates_styles\"><link href=\"text/swriter/guide/templates_styles.xhp\">Templates and Styles</link></variable>"
msgstr "<variable id=\"templates_styles\"><link href=\"text/swriter/guide/templates_styles.xhp\">Dokumentmallar och formatmallar</link></variable>"

#. from libreoffice:swriter-guide
msgid "A template is a document that contains specific formatting styles, graphics, tables, objects, and other information. A template is used as the basis for creating other documents. For example, you can define paragraph and character styles in a document, save the document as a template, and then use the template to create a new document with the same styles."
msgstr "En dokumentmall är ett dokument som kan innehålla specifika formatmallar, grafik, tabeller, objekt och annan information. En dokumentmall kan användas som bas när du skapar andra dokument. Du kan t.ex. definiera styckeformatmallar och teckenformatmallar i ett dokument, spara dokumentet som en dokumentmall och sedan använda dokumentmallen för att skapa nya dokument med samma formatmallar."

#. from libreoffice:swriter-guide
msgid "Animating Text"
msgstr "Animera text"

#. from libreoffice:swriter-guide
msgid "<bookmark_value>text animation</bookmark_value>  <bookmark_value>effects; text animation</bookmark_value>  <bookmark_value>animations;text</bookmark_value>"
msgstr "<bookmark_value>animerad text</bookmark_value>      <bookmark_value>effekter; animerad text</bookmark_value>      <bookmark_value>animeringar;text</bookmark_value>"

#. from libreoffice:swriter-guide
msgid "<variable id=\"text_animation\"><link href=\"text/swriter/guide/text_animation.xhp\">Animating Text</link></variable>"
msgstr "<variable id=\"text_animation\"><link href=\"text/swriter/guide/text_animation.xhp\">Använda animerad text</link></variable>"

#. from libreoffice:swriter-guide
msgid "You can only animate text that is contained in a drawing object, such as rectangles, lines, or text objects. For example, draw a rectangle, then double-click the rectangle and enter your text."
msgstr "Du kan bara animera text som finns i ritobjekt, t.ex. rektanglar, linjer eller textobjekt. Dra till exempel en rektangel och dubbelklicka sedan på den och skriv in din text."

#. from libreoffice:swriter-guide
msgid "Select the drawing object containing the text that you want to animate."
msgstr "Markera ritobjektet som innehåller texten som du vill animera."

#. from libreoffice:swriter-guide
msgid "Choose <item type=\"menuitem\">Format - Object - Text Attributes</item>, and then click the <item type=\"menuitem\">Text Animation</item> tab."
msgstr "Välj <item type=\"menuitem\">Format - Objekt - Textattribut</item> och klicka på fliken                <item type=\"menuitem\">Animerad text</item>."

#. from libreoffice:swriter-guide
msgid "In the <item type=\"menuitem\">Effect</item> box, select the animation that you want."
msgstr "Markera den animering som du vill använda i rutan <item type=\"menuitem\">Effekt</item>               ."

#. from libreoffice:swriter-guide
msgid "Set the properties of the effect, and then click <emph>OK</emph>."
msgstr "Ange egenskaperna för effekten och klicka på <emph>OK</emph>."

#. from libreoffice:swriter-guide
msgid "Changing the Case of Text"
msgstr "Ändra skiftläget i en text"

#. from libreoffice:swriter-guide
msgid "<bookmark_value>characters; uppercase or lowercase</bookmark_value>      <bookmark_value>text; uppercase or lowercase</bookmark_value>      <bookmark_value>lowercase letters; text</bookmark_value>      <bookmark_value>uppercase; formatting text</bookmark_value>      <bookmark_value>capital letters;changing to small letters</bookmark_value>      <bookmark_value>changing;cases of text</bookmark_value>      <bookmark_value>initial capitals in titles</bookmark_value>      <bookmark_value>small capitals (guide)</bookmark_value>"
msgstr "<bookmark_value>bokstäver; versaler eller gemener</bookmark_value>      <bookmark_value>text; versaler eller gemener</bookmark_value>      <bookmark_value>gemener; text</bookmark_value>      <bookmark_value>versaler; formatera text</bookmark_value>      <bookmark_value>stora bokstäver;ändra till små bokstäver</bookmark_value>      <bookmark_value>ändra;skiftläge i text</bookmark_value>      <bookmark_value>inledande versaler i rubriker</bookmark_value>      <bookmark_value>kapitäler (guide)</bookmark_value>"

#. from libreoffice:swriter-guide
msgid "<variable id=\"text_capital\"><link href=\"text/swriter/guide/text_capital.xhp\">Changing the Case of Text</link></variable>"
msgstr "<variable id=\"text_capital\"><link href=\"text/swriter/guide/text_capital.xhp\">Skriva text med stora eller små bokstäver</link></variable>"

#. from libreoffice:swriter-guide
msgid "You can change the case of text, format text with small capitals, or capitalize the first letter of each word in a selection."
msgstr "Du kan ändra skiftläge för text, formatera text med kapitäler eller börja varje ord i en markering med stor bokstav."

#. from libreoffice:swriter-guide
msgid "To Capitalize Text"
msgstr "Så här ändrar du text till versaler"

#. from libreoffice:swriter-guide
msgid "Select the text that you want to capitalize."
msgstr "Markera den text du vill omvandla till stora bokstäver."

#. from libreoffice:swriter-guide
msgid "Choose <item type=\"menuitem\">Format - Character</item>, click the Font Effects tab, then select the type of capitalization in the Effects box. \"Capitals\" capitalizes all letters. \"Title\" capitalizes the first letter of each word. \"Small capitals\" capitalizes all letters, but in a reduced font size."
msgstr "Välj <item type=\"menuitem\">Format – Tecken</item>, klicka på fliken Teckeneffekt och välj sedan typ av effekt i rutan Effekter. \"Versaler\" gör alla bokstäver stora. \"Titel\" ändrar den första bokstaven i varje ord till stor bokstav. \"Kapitäler\" ändrar alla bokstäver i markeringen till stor bokstav, men i förminskad storlek."

#. from libreoffice:swriter-guide
msgid "To Change Text to Lowercase"
msgstr "Så här ändrar du text till gemener"

#. from libreoffice:swriter-guide
msgid "Select the text that you want to change to lowercase."
msgstr "Markera den text du vill ändra till små bokstäver."

#. from libreoffice:swriter-guide
msgid "Choose <item type=\"menuitem\">Format - Character</item>, click the Font Effects tab, then select \"Lowercase\" in the Effects box."
msgstr "Välj <item type=\"menuitem\">Format – Tecken</item>, klicka på fliken Teckeneffekt och välj sedan \"Gemener\" i rutan Effekter."

#. from libreoffice:swriter-guide
msgid "Using a Frame to Center Text on a Page"
msgstr "Centrera text på en sida genom att använda en ram"

#. from libreoffice:swriter-guide
msgid "<variable id=\"text_centervert\"><link href=\"text/swriter/guide/text_centervert.xhp\">Using a Frame to Center Text on a Page</link></variable>"
msgstr "<variable id=\"text_centervert\"><link href=\"text/swriter/guide/text_centervert.xhp\">Centrera text på en sida genom att använda en ram</link></variable>"

#. from libreoffice:swriter-guide
msgid "Select the text that you want to center on the page."
msgstr "Markera texten som du vill centrera på sidan."

#. from libreoffice:swriter-guide
msgid "Choose <emph>Insert - Frame</emph>."
msgstr "Välj <emph>Infoga - Ram</emph>."

#. from libreoffice:swriter-guide
msgid "In the <item type=\"menuitem\">Anchor</item> area, select <item type=\"menuitem\">To page</item>."
msgstr "Markera <item type=\"menuitem\">Vid sidan</item> under <item type=\"menuitem\">Förankring</item>               ."

#. from libreoffice:swriter-guide
msgid "In the <item type=\"menuitem\">Size</item> area, set the dimensions of the frame."
msgstr "Ange kantlinjens mått under <item type=\"menuitem\">Storlek</item>               ."

#. from libreoffice:swriter-guide
msgid "In the <item type=\"menuitem\">Position</item> area, select \"Center\" in the <item type=\"menuitem\">Horizontal</item> and <item type=\"menuitem\">Vertical</item> boxes."
msgstr "Under <item type=\"menuitem\">Position </item>               markerar du \"Centrerat\" i rutorna <item type=\"menuitem\">Horisontellt</item>                och <item type=\"menuitem\">Vertikalt</item>               ."

#. from libreoffice:swriter-guide
msgid "To resize the frame, drag the edges of the frame."
msgstr "Om du vill ändra storlek på ramen drar du i ramens kanter."

#. from libreoffice:swriter-guide
msgid "Using the Direct Cursor"
msgstr "Använda direktmarkören"

#. from libreoffice:swriter-guide
msgid "<bookmark_value>text; cursor</bookmark_value><bookmark_value>entering text with direct cursor</bookmark_value><bookmark_value>direct cursor; settings</bookmark_value><bookmark_value>writing with direct cursor</bookmark_value><bookmark_value>cursor;direct cursor</bookmark_value><bookmark_value>settings;direct cursor</bookmark_value>"
msgstr "<bookmark_value>Text; markör</bookmark_value><bookmark_value>Ange text med direktmarkör</bookmark_value><bookmark_value>Direktmarkör; inställningar</bookmark_value><bookmark_value>Skriva med direktmarkör</bookmark_value><bookmark_value>Markör; direktmarkör</bookmark_value><bookmark_value>Inställningar; direktmarkör</bookmark_value>"

#. from libreoffice:swriter-guide
msgid "<variable id=\"text_direct_cursor\"><link href=\"text/swriter/guide/text_direct_cursor.xhp\">Using the Direct Cursor</link></variable>"
msgstr "<variable id=\"text_direct_cursor\"><link href=\"text/swriter/guide/text_direct_cursor.xhp\">Mata in text var som helst på en sida</link></variable>"

#. from libreoffice:swriter-guide
msgid "The direct cursor allows you to enter text anywhere on a page."
msgstr "Med direktmarkören kan du mata in text var som helst på en sida."

#. from libreoffice:swriter-guide
msgid "Click in a free space in the text document. The mouse pointer changes to reflect the alignment that will be applied to the text that you type:"
msgstr "Klicka på en tom yta i textdokumentet. Muspekaren ändras efter den justering som används för texten som du skriver:"

#. from libreoffice:swriter-guide
msgid "Type your text. %PRODUCTNAME automatically inserts the required number of blank lines, and, if the options are enabled, tabs and spaces."
msgstr "Skriv texten. I %PRODUCTNAME infogas det nödvändiga antalet tomma rader automatiskt och, om alternativen är aktiverade, även tabbar och blanksteg."

#. from libreoffice:swriter-guide
msgid "Emphasizing Text"
msgstr "Framhäva text"

#. from libreoffice:swriter-guide
msgid "<bookmark_value>text; emphasizing</bookmark_value>      <bookmark_value>emphasizing text</bookmark_value>"
msgstr "<bookmark_value>text; framhäva</bookmark_value>      <bookmark_value>framhäva text</bookmark_value>"

#. from libreoffice:swriter-guide
msgid "<variable id=\"text_emphasize\"><link href=\"text/swriter/guide/text_emphasize.xhp\">Emphasizing Text</link></variable>"
msgstr "<variable id=\"text_emphasize\"><link href=\"text/swriter/guide/text_emphasize.xhp\">Framhäva text</link></variable>"

#. from libreoffice:swriter-guide
msgid "Here are a few examples of how to emphasize text in a document:"
msgstr "Här följer några exempel på hur du framhäver text i ett dokument:"

#. from libreoffice:swriter-guide
msgid "Select the text and apply a different font style or effect, such as <emph>bold</emph>."
msgstr "Markera texten och använd ett annat teckensnitt eller en effekt, t.ex. <emph>fet</emph>."

#. from libreoffice:swriter-guide
msgid "Right-click in a paragraph, choose <emph>Paragraph, </emph>set the options that you want, for example, the background color, and then click <emph>OK</emph>."
msgstr "Högerklicka i ett stycke, välj <emph>Stycke</emph>, ange alternativen som du vill använda, t.ex. bakgrundsfärg och klicka sedan på <emph>OK</emph>."

#. from libreoffice:swriter-guide
msgid "Select the text, and then choose <item type=\"menuitem\">Insert - Frame</item>."
msgstr "Markera texten och välj <item type=\"menuitem\">Infoga - Ram</item>."

#. from libreoffice:swriter-guide
msgid "Use the Text tool on the Drawing toolbar."
msgstr "Använd textverktyget på verktygsraden Ritverktyg."

#. from libreoffice:swriter-guide
msgid "Use Fontwork. To open the Fontwork window, click the Fontwork Gallery icon on the Drawing bar."
msgstr "Använd Fontwork. Du öppnar Fontwork-fönstret genom att klicka på ikonen Fontwork-galleri på Ritverktygsraden."

#. from libreoffice:swriter-guide
msgid "Select the text that you want to include in the frame."
msgstr "Markera texten som du vill inkludera i ramen."

#. from libreoffice:swriter-guide
msgid "To Hide Text From Printing"
msgstr "Så här döljer du textramar vid utskrift"

#. from libreoffice:swriter-guide
msgid "Click the edge of a frame that you want to link. Selection handles appear on the edges of the frame."
msgstr "Klicka på kanten på en ram som du vill länka. Markeringshandtag visas på ramens kanter."

#. from libreoffice:swriter-guide
msgid "Click the frame that you want to link to."
msgstr "Klicka på ramen som du vill länka till."

#. from libreoffice:swriter-guide
msgid "You can only link frames if:"
msgstr "Du kan bara länka ramar om:"

#. from libreoffice:swriter-guide
msgid "The target frame is empty."
msgstr "Målramen är tom."

#. from libreoffice:swriter-guide
msgid "The target frame is not linked to another frame."
msgstr "Målramen inte är länkad till en annan ram."

#. from libreoffice:swriter-guide
msgid "The source and the target frames are in the same section. For example, you cannot link a header frame to a footer frame."
msgstr "Käll- och målramarna är i samma område. Du kan t.ex. inte länka en sidhuvudram till en sidfotsram."

#. from libreoffice:swriter-guide
msgid "The source frame does not have a next link."
msgstr "Källramen har inte en nästa länk."

#. from libreoffice:swriter-guide
msgid "The target or the source frame are not contained in each other."
msgstr "Mål- eller källramen är inte inneslutna i varandra."

#. from libreoffice:swriter-guide
msgid "When you select a linked frame, a line is displayed that connects the linked frames."
msgstr "När du markerar en länkad ram visas en linje som kopplar ihop de länkade ramarna."

#. from libreoffice:swriter-guide
msgid "The AutoSize feature is available only for the last frame in a chain of linked frames."
msgstr "Funktionen Automatisk storlek är endast tillgänglig för den sista ramen i en kedja av länkade ramar."

#. from libreoffice:swriter-guide
msgid "Navigating and Selecting With the Keyboard"
msgstr "Navigera och välja med tangentbordet"

#. from libreoffice:swriter-guide
msgid "<bookmark_value>text; navigating and selecting with keyboard</bookmark_value>      <bookmark_value>navigating; in text, with keyboard</bookmark_value>      <bookmark_value>selecting;text, with keyboard</bookmark_value>      <bookmark_value>keyboard; navigating and selecting in text</bookmark_value>"
msgstr "<bookmark_value>text; navigera och markera med tangentbordet</bookmark_value>      <bookmark_value>navigera; i text, med tangentbordet</bookmark_value>      <bookmark_value>markera;text, med tangentbordet</bookmark_value>      <bookmark_value>tangentbordet; navigera och markera text</bookmark_value>"

#. from libreoffice:swriter-guide
msgid "<variable id=\"text_nav_keyb\"><link href=\"text/swriter/guide/text_nav_keyb.xhp\">Navigating and Selecting With the Keyboard</link></variable>"
msgstr "<variable id=\"text_nav_keyb\"><link href=\"text/swriter/guide/text_nav_keyb.xhp\">Navigera och markera med tangentbordet</link></variable>"

#. from libreoffice:swriter-guide
msgid "You can navigate through a document and make selections with the keyboard."
msgstr "Du kan navigera genom ett dokument och göra markeringar genom att använda tangentbordet."

#. from libreoffice:swriter-guide
msgid "To move the cursor, press the key or key combination given in the following table."
msgstr "För att flytta markören trycker du på den tangent eller tangentkombination som ges i följande tabell."

#. from libreoffice:swriter-guide
msgid "To select the characters under the moving cursor, additionally hold down the Shift key when you move the cursor."
msgstr "Om du vill markera tecken under markören när du flyttar denna håller du ned Skift-tangenten samtidigt som du flyttar markören."

#. from libreoffice:swriter-guide
msgid "<emph>+</emph><switchinline select=\"sys\"><caseinline select=\"MAC\"><emph>Command key</emph></caseinline><defaultinline><emph>Ctrl key</emph></defaultinline></switchinline>"
msgstr "<emph>+</emph><switchinline select=\"sys\"><caseinline select=\"MAC\"><emph>Kommandotangent</emph></caseinline><defaultinline><emph>Ctrl-tangent</emph></defaultinline></switchinline>"

#. from libreoffice:swriter-guide
msgid "Right, left arrow keys"
msgstr "Höger-, vänsterpil"

#. from libreoffice:swriter-guide
msgid "Moves the cursor one character to the left or to the right."
msgstr "Flyttar markören ett tecken till vänster eller höger."

#. from libreoffice:swriter-guide
msgid "Moves the cursor one word to the left or to the right."
msgstr "Flyttar markören ett ord till vänster eller höger."

#. from libreoffice:swriter-guide
msgid "Up, down arrow keys"
msgstr "Uppåt- och nedåtpilar"

#. from libreoffice:swriter-guide
msgid "Moves the cursor up or down one line."
msgstr "Flyttar markören upp en rad eller ned en rad."

#. from libreoffice:swriter-guide
msgid "(<switchinline select=\"sys\"><caseinline select=\"MAC\">Command+Option</caseinline><defaultinline>Ctrl+Alt</defaultinline></switchinline>) Moves the current paragraph up or down."
msgstr "(<switchinline select=\"sys\"><caseinline select=\"MAC\">Kommando+Alternativ</caseinline><defaultinline>Ctrl+Alt</defaultinline></switchinline>) Flyttar det aktuella stycket uppåt eller nedåt."

#. from libreoffice:swriter-guide
msgid "Moves the cursor to the beginning of the current line."
msgstr "Flyttar markören till början av den aktuella raden."

#. from libreoffice:swriter-guide
msgid "Moves the cursor to the beginning of the document."
msgstr "Flyttar markören till början av dokumentet."

#. from libreoffice:swriter-guide
msgid "Moves the cursor to the beginning of the contents in the current cell."
msgstr "Flyttar markören till början av innehållet i den aktuella cellen."

#. from libreoffice:swriter-guide
msgid "Moves the cursor to the beginning of the contents of the current cell. Press again to move the cursor to the first cell in the table. Press again to move the cursor to the beginning of the document."
msgstr "Flyttar markören till början'Œ av innehållet i den aktuella cellen. Tryck igen om du vill flytta markören till den första cellen i tabellen. Tryck igen om du vill flytta markören till början av dokumentet."

#. from libreoffice:swriter-guide
msgid "Moves the cursor to the end of the current line."
msgstr "Flyttar markören till slutet av den aktuella raden."

#. from libreoffice:swriter-guide
msgid "Moves the cursor to the end of the document"
msgstr "Flyttar markören till slutet av dokumentet."

#. from libreoffice:swriter-guide
msgid "In a table"
msgstr "i en tabell"

#. from libreoffice:swriter-guide
msgid "Moves to the end of the contents in the current cell."
msgstr "Flyttar markören till slutet av innehållet i den aktuella cellen."

#. from libreoffice:swriter-guide
msgid "Moves the cursor to the end of the contents of the current cell. Press again to move the cursor to the last cell in the table. Press again to move the cursor to the end of the document."
msgstr "Flyttar markören till slutet av innehållet i den aktuella cellen. Tryck igen om du vill flytta markören till den sista cellen i tabellen. Tryck igen om du vill flytta markören till slutet av dokumentet."

#. from libreoffice:swriter-guide
msgid "PgUp"
msgstr "Page Up"

#. from libreoffice:swriter-guide
msgid "Scrolls up one page."
msgstr "Rullar upp en sida."

#. from libreoffice:swriter-guide
msgid "Moves the cursor to the header."
msgstr "Flyttar markören till sidhuvudet."

#. from libreoffice:swriter-guide
msgid "PgDn"
msgstr "Page Down"

#. from libreoffice:swriter-guide
msgid "Scroll down one page."
msgstr "Rullar ned en sida."

#. from libreoffice:swriter-guide
msgid "Moves the cursor to the footer."
msgstr "Flyttar markören till sidfoten."

#. from libreoffice:swriter-guide
msgid "<variable id=\"text_rotate\"><link href=\"text/swriter/guide/text_rotate.xhp\">Rotating Text</link></variable>"
msgstr "<variable id=\"text_rotate\"><link href=\"text/swriter/guide/text_rotate.xhp\">Rotera text</link></variable>"

#. from libreoffice:swriter-guide
msgid "Drag in your document to draw the text object, and then type your text."
msgstr "Rita textobjektet genom att dra i dokumentet, och skriv sedan texten."

#. from libreoffice:swriter-guide
msgid "Drag one of the corner handles of the text object."
msgstr "Dra något av textobjektets hörnhandtag."

#. from libreoffice:swriter-guide
msgid "You can also right-click the text object, choose <emph>Position and Size</emph>, click the <emph>Rotation</emph> tab, and then enter a rotation angle or a new position for the object."
msgstr "Du kan också högerklicka i textobjektet, välja <emph>Position och storlek</emph>, klicka på fliken <emph>Rotation</emph> och sedan ange en rotationsvinkel eller en ny position för objektet."

#. from libreoffice:swriter-guide
msgid "<link href=\"text/shared/02/01140000.xhp\">Show Draw Functions</link>"
msgstr "<link href=\"text/shared/02/01140000.xhp\">Visa ritfunktioner</link>"

#. from libreoffice:swriter-guide
msgid "Inserting an Entire Text Document"
msgstr "Infoga ett helt textdokument"

#. from libreoffice:swriter-guide
msgid "<bookmark_value>sections;inserting external content</bookmark_value>      <bookmark_value>text documents;merging</bookmark_value>      <bookmark_value>links;inserting text documents as</bookmark_value>      <bookmark_value>inserting;text documents</bookmark_value>"
msgstr "<bookmark_value>avsnitt;infoga externt innehåll</bookmark_value>      <bookmark_value>textdokument;sammanfoga</bookmark_value>      <bookmark_value>länkar;infoga textdokument som</bookmark_value>      <bookmark_value>infoga;textdokument</bookmark_value>"

#. from libreoffice:swriter-guide
msgid "<variable id=\"textdoc_inframe\"><link href=\"text/swriter/guide/textdoc_inframe.xhp\">Inserting an Entire Text Document</link></variable>"
msgstr "<variable id=\"textdoc_inframe\"><link href=\"text/swriter/guide/textdoc_inframe.xhp\">Infoga ett helt textdokument</link></variable>"

#. from libreoffice:swriter-guide
msgid "To Insert a Text File"
msgstr "Så här infogar du en textfil"

#. from libreoffice:swriter-guide
msgid "Locate the text document that you want to insert, and then click <emph>OK</emph>."
msgstr "Leta rätt på textdokumentet som du vill infoga och klicka på <emph>OK</emph>."

#. from libreoffice:swriter-guide
msgid "The contents of the text document are embedded into the current document and are not updated if the source file is changed. If you want the contents to automatically update when you change the source document, insert the file as a link."
msgstr "Innehållet i textdokumentet bäddas in i det aktuella dokumentet och uppdateras inte om källfilen ändras. Om du vill att innehållet ska uppdateras när du ändrar källdokumentet ska du infoga filen som en länk."

#. from libreoffice:swriter-guide
msgid "To Insert an Entire Text Document as a Link"
msgstr "Så här infogar du ett helt textdokument som en länk"

#. from libreoffice:swriter-guide
msgid "Place the cursor in the document where you want to insert the file."
msgstr "Placera markören i dokumentet där du vill infoga filen."

#. from libreoffice:swriter-guide
msgid "Choose <emph>Insert - Section</emph>."
msgstr "Välj <emph>Infoga - Område</emph>."

#. from libreoffice:swriter-guide
msgid "Type a name in the <emph>New Section</emph> box, and then select the <emph>Link</emph> check box."
msgstr "Skriv ett namn i rutan <emph>Nytt område</emph> och markera kryssrutan <emph>Länk</emph>."

#. from libreoffice:swriter-guide
msgid "In the <item type=\"menuitem\">File Name</item> box, type the name of the file that you want to insert, or click the <item type=\"menuitem\">Browse</item> button and locate the file."
msgstr "Skriv namnet på den fil som du vill infoga i rutan <item type=\"menuitem\">Filnamn</item>               . Du kan också leta upp filen genom att använda bläddringsknappen (<item type=\"menuitem\">...</item>)."

#. from libreoffice:swriter-guide
msgid "If the target text document contains sections, you can select the section that you want to insert in the               <item type=\"menuitem\">Sections</item> box."
msgstr "Om måldokumentet innehåller avsnitt kan du markera det avsnitt som du vill infoga i rutan                <item type=\"menuitem\">Avsnitt</item>."

#. from libreoffice:swriter-guide
msgid "If you want, set the formatting options for the section."
msgstr "Om du vill kan du ange formateringsalternativ för området."

#. from libreoffice:swriter-guide
msgid "$[officename] automatically updates the contents of the inserted section whenever the source document is changed. To manually update the contents of the section, choose <emph>Tools - Update - Update All</emph>."
msgstr "I $[officename] uppdateras innehållet i infogade områden automatiskt när källdokumentet ändras. Om du vill uppdatera innehållet i området manuellt väljer du <emph>Verktyg - Uppdatera - Uppdatera allt</emph>."

#. from libreoffice:swriter-guide
msgid "<bookmark_value>hyphenation;manual/automatic</bookmark_value>      <bookmark_value>separation, see hyphenation</bookmark_value>      <bookmark_value>automatic hyphenation in text</bookmark_value>      <bookmark_value>manual hyphenation in text</bookmark_value>"
msgstr "<bookmark_value>avstavning;manuell/automatisk</bookmark_value>      <bookmark_value>särskrivning, se avstavning</bookmark_value>      <bookmark_value>automatisk avstavning i text</bookmark_value>      <bookmark_value>manuell avstavning i text</bookmark_value>"

#. from libreoffice:swriter-guide
msgid "Automatic Hyphenation"
msgstr "Automatisk avstavning"

#. from libreoffice:swriter-guide
msgid "Automatic hyphenation inserts hyphens where they are needed in a paragraph. This option is only available for paragraph styles and individual paragraphs."
msgstr "Automatisk avstavning infogar bindestreck där det behövs i ett stycke. Alternativet är bara tillgängligt för styckeformatmallar och enskilda stycken."

#. from libreoffice:swriter-guide
msgid "To Automatically Hyphenate Text in a Paragraph"
msgstr "Så här avstavar du text automatiskt i ett stycke"

#. from libreoffice:swriter-guide
msgid "Right-click in a paragraph, and choose <emph>Paragraph</emph>."
msgstr "Högerklicka i stycket och välj <emph>Stycke</emph>."

#. from libreoffice:swriter-guide
msgid "Click the <link href=\"text/swriter/01/05030200.xhp\"><emph>Text Flow</emph></link> tab."
msgstr "Klicka på fliken <link href=\"text/swriter/01/05030200.xhp\"><emph>Textflöde</emph></link>."

#. from libreoffice:swriter-guide
msgid "In the Hyphenation area, select the Automatically check box."
msgstr "Markera kryssrutan Automatisk i området Avstavning."

#. from libreoffice:swriter-guide
msgid "To Automatically Hyphenate Text in Multiple Paragraphs"
msgstr "Så här avstavar du text automatiskt i flera stycken"

#. from libreoffice:swriter-guide
msgid "If you want to automatically hyphenate more than one paragraph, use a paragraph style."
msgstr "Om du vill avstava mer än ett stycke automatiskt använder du en styckeformatmall."

#. from libreoffice:swriter-guide
msgid "For example, enable the automatic hyphenation option for the \"Default\" paragraph style, and then apply the style to the paragraphs that you want to hyphenate."
msgstr "Du kan t.ex. aktivera alternativet för automatisk avstavning för styckeformatmallen \"Standard\", och sedan använda styckeformatmallen i de stycken som du vill avstava."

#. from libreoffice:swriter-guide
msgid "Right-click the paragraph style that you want to hyphenate, and then choose <emph>Modify</emph>."
msgstr "Högerklicka på den styckeformatmall du vill avstava och välj sedan <emph>Ändra</emph>."

#. from libreoffice:swriter-guide
msgid "Click the Text Flow tab."
msgstr "Klicka på fliken Textflöde."

#. from libreoffice:swriter-guide
msgid "In the <emph>Hyphenation</emph> area, select the <emph>Automatically</emph> check box."
msgstr "Markera kryssrutan <emph>Automatisk</emph> i området <emph>Avstavning</emph>."

#. from libreoffice:swriter-guide
msgid "Apply the style to the paragraphs that you want to hyphenate."
msgstr "Använd formatmallen i de stycken som du vill avstava."

#. from libreoffice:swriter-guide
msgid "Manual Hyphenation"
msgstr "Den manuella avstavningen"

#. from libreoffice:swriter-guide
msgid "You can insert a hyphen where you want on a line, or let $[officename] search for the words to hyphenate, and then offer a suggested hyphenation."
msgstr "Du kan infoga ett bindestreck var du vill på en rad, eller låta $[officename] söka efter ord som ska avstavas och sedan föreslå en avstavning."

#. from libreoffice:swriter-guide
msgid "To Manually Hyphenate Single Words"
msgstr "Så här avstavar du enstaka ord manuellt"

#. from libreoffice:swriter-guide
msgid "To quickly insert a hyphen, click in the word where you want to add the hyphen, and then press <switchinline select=\"sys\"><caseinline select=\"MAC\">Command</caseinline><defaultinline>Ctrl</defaultinline></switchinline>+Hyphen(-)."
msgstr "Du kan snabbt infoga ett bindestreck genom att klicka i det ord där bindestrecket ska läggas till och trycka på <switchinline select=\"sys\"><caseinline select=\"MAC\">Kommando</caseinline><defaultinline>Ctrl</defaultinline></switchinline>+Bindestreck(-)."

#. from libreoffice:swriter-guide
msgid "If you insert a manual hyphen in a word, the word is only hyphenated at the manual hyphen. No additional automatic hyphenation is applied for this word. A word with a manual hyphen will be hyphenated without regard to the settings on the <emph>Text Flow</emph> tab page."
msgstr "Om du infogar ett manuellt bindestreck i ett ord så blir ordet bara avstavat vid det manuella bindestrecket. Ingen automatisk avstavning läggs till i det manuellt avstavade ordet. När ett ord avstavas manuellt ignoreras de inställningar som är gjorda under fliken <emph>Textflöde</emph>."

#. from libreoffice:swriter-guide
msgid "To Manually Hyphenate Text in a Selection"
msgstr "Så här avstavar du text manuellt i en markering"

#. from libreoffice:swriter-guide
msgid "Select the text that you want to hyphenate."
msgstr "Markera den text som du vill avstava."

#. from libreoffice:swriter-guide
msgid "Choose <emph>Tools - Language - Hyphenation</emph>."
msgstr "Välj <emph>Verktyg - Språk - Avstavning</emph>."

#. from libreoffice:swriter-guide
msgid "Adding Bullets"
msgstr "Lägga till punktuppställning"

#. from libreoffice:swriter-guide
msgid "<variable id=\"using_numbered_lists\"><link href=\"text/swriter/guide/using_numbered_lists.xhp\">Adding Bullets</link></variable>"
msgstr "<variable id=\"using_numbered_lists\"><link href=\"text/swriter/guide/using_numbered_lists.xhp\">Lägga till punktuppställning</link></variable>"

#. from libreoffice:swriter-guide
msgid "To Add Bullets"
msgstr "Så här lägger du till punkter"

#. from libreoffice:swriter-guide
msgid "Select the paragraph(s) that you want to add bullets to."
msgstr "Markera stycket eller styckena där du vill lägga till en punktuppställning."

#. from libreoffice:swriter-guide
msgid "To Format Bullets"
msgstr "Så här formaterar du punkter"

#. from libreoffice:swriter-guide
msgid "Adding Numbering"
msgstr "Lägga till numrering"

#. from libreoffice:swriter-guide
msgid "To Add Numbering to a List"
msgstr "Så här lägger du till numrering i en lista"

#. from libreoffice:swriter-guide
msgid "Select the paragraph(s) that you want to add numbering to."
msgstr "Markera stycket eller styckena där du vill lägga till numreringen."

#. from libreoffice:swriter-guide
msgid "You can apply numbering to a paragraph manually or with a paragraph style."
msgstr "Du kan tilldela numrering i ett stycke manuellt eller med en styckeformatmall."

#. from libreoffice:swriter-guide
msgid "To Apply Numbering Manually"
msgstr "Så här tillämpar du numrering manuellt"

#. from libreoffice:swriter-guide
msgid "When you press Enter in a numbered or bulleted list, <item type=\"productname\">%PRODUCTNAME</item> automatically numbers the next paragraph. To remove the numbering or bullet from the new paragraph, press Enter again."
msgstr "När du trycker på Retur i en numrerad eller punktuppställd lista, numrerar <item type=\"productname\">%PRODUCTNAME</item> automatiskt nästa stycke. Om du vill ta bort numreringen eller punktuppställningen från det nya stycket trycker du på Retur igen."

#. from libreoffice:swriter-guide
msgid "To change the bullets or numbering format for the current paragraph only, select a character or word in the paragraph, choose <item type=\"menuitem\">Format - Bullets and Numbering</item>, and then click a new format."
msgstr "Om du vill ändra numrerings- eller punktuppställningsformat enbart för det aktuella stycket markerar du ett tecken eller ord i stycket, väljer <item type=\"menuitem\">Format - Punktuppställningstecken</item> och klickar sedan på ett nytt format."

#. from libreoffice:swriter-guide
msgid "To change the bullet or numbering format for all paragraphs in the list, ensure that the cursor is in the list, choose <item type=\"menuitem\">Format - Bullets and Numbering</item>, and then click a new format."
msgstr "Om du vill ändra numrerings- eller punktuppställningsformat för alla stycken i listan kontrollerar du att markören finns i listan, väljer <item type=\"menuitem\">Format - Punktuppställningstecken</item> och klickar sedan på ett nytt format."

#. from libreoffice:swriter-guide
msgid "To Apply Numbering With a Paragraph Style"
msgstr "Så här tillämpar du numrering med en styckeformatmall"

#. from libreoffice:swriter-guide
msgid "Right-click the paragraph style that you want to apply numbering to, and then choose <emph>Modify</emph>."
msgstr "Högerklicka på den styckeformatmall där du vill tilldela numrering och välj sedan <emph>Ändra</emph>."

#. from libreoffice:swriter-guide
msgid "<bookmark_value>thesaurus; related words</bookmark_value>      <bookmark_value>related words in thesaurus</bookmark_value>      <bookmark_value>spelling in thesaurus</bookmark_value>      <bookmark_value>dictionaries; thesaurus</bookmark_value>      <bookmark_value>lexicon, see thesaurus</bookmark_value>      <bookmark_value>synonyms in thesaurus</bookmark_value>      <bookmark_value>searching;synonyms</bookmark_value>"
msgstr "<bookmark_value>synonymordlista; närliggande ord</bookmark_value>      <bookmark_value>närliggande ord i synonymordlista</bookmark_value>      <bookmark_value>stavning i synonymordlista</bookmark_value>      <bookmark_value>ordlistor; synonymordlista</bookmark_value>      <bookmark_value>lexikon, se synonymordlista</bookmark_value>      <bookmark_value>synonymer i synonymordlista</bookmark_value>      <bookmark_value>söka;synonymer</bookmark_value>"

#. from libreoffice:swriter-guide
msgid "<variable id=\"using_thesaurus\"><link href=\"text/swriter/guide/using_thesaurus.xhp\">Thesaurus</link></variable>"
msgstr "<variable id=\"using_thesaurus\"><link href=\"text/swriter/guide/using_thesaurus.xhp\">Synonymordlista</link></variable>"

#. from libreoffice:swriter-guide
msgid "Click in the word that you want to look up or replace."
msgstr "Klicka i det ord som du vill söka eller ersätta."

#. from libreoffice:swriter-guide
msgid "Choose <emph>Tools - Language - Thesaurus</emph>, or press <switchinline select=\"sys\"><caseinline select=\"MAC\">Command</caseinline><defaultinline>Ctrl</defaultinline></switchinline>+F7."
msgstr "Välj <emph>Verktyg - Språk - Synonymordlista</emph> eller tryck på <switchinline select=\"sys\"><caseinline select=\"MAC\">Kommando</caseinline><defaultinline>Ctrl</defaultinline></switchinline>+F7."

#. from libreoffice:swriter-guide
msgid "In the Alternatives list, click an entry to copy that related term to the \"Replace with\" text box."
msgstr "Klicka på en post i listan Alternativ för att kopiera den närliggande termen till textrutan \"Ersätt med\"."

#. from libreoffice:swriter-guide
msgid "Optionally double-click an entry to look up related terms for that entry. On your keyboard, you can also press the arrow up or down keys to select an entry. Then press Return to replace, or press the spacebar to look up."
msgstr "Du kan söka efter närliggande termer för en post genom att dubbelklicka på posten. Du kan också markera en post med tangentbordet genom att använda uppåtpil och nedåtpil. Tryck sedan på Retur för att göra ersättningen, eller på mellanslagstangenten om du vill göra en sökning."

#. from libreoffice:swriter-guide
msgid "Initially, the thesaurus uses the language of the selected word in the document, if a thesaurus library for that language is installed. The title bar of the Thesaurus dialog displays the language in use."
msgstr "Från början använder synonymordlistan samma språk som det markerade ordet i dokumentet, om ett bibliotek för synonymordlistor har installerats för det språket. Titellisten i dialogrutan Synonymordlista anger vilket språk som används."

#. from libreoffice:swriter-guide
msgid "If a thesaurus library is installed for the language of a word, the context menu of the word shows a Synonyms submenu. Select any of the terms from the submenu to replace the word."
msgstr "Om ett bibliotek för synonymordlistor är installerat för det språk som ordet tillhör så innehåller ordets snabbmeny undermenyn Synonymer. Ersätt ordet med någon av termerna på undermenyn."

#. from libreoffice:swriter-guide
msgid "<link href=\"text/shared/01/06020000.xhp\">Thesaurus</link>"
msgstr "<link href=\"text/shared/01/06020000.xhp\">Synonymordlista</link>"

#. from libreoffice:swriter-guide
msgid "Word Completion for Text Documents"
msgstr "Ordkomplettering för textdokument"

#. from libreoffice:swriter-guide
msgid "<bookmark_value>automatic word completion</bookmark_value>      <bookmark_value>completion of words</bookmark_value>      <bookmark_value>AutoCorrect function; word completion</bookmark_value>      <bookmark_value>word completion;using/disabling</bookmark_value>      <bookmark_value>disabling;word completion</bookmark_value>      <bookmark_value>switching off;word completion</bookmark_value>      <bookmark_value>deactivating;word completion</bookmark_value>      <bookmark_value>refusing word completions</bookmark_value>      <bookmark_value>rejecting word completions</bookmark_value>"
msgstr "<bookmark_value>automatisk ordkomplettering</bookmark_value>      <bookmark_value>komplettering av ord</bookmark_value>      <bookmark_value>Autokorrigering, funktion; ordkomplettering</bookmark_value>      <bookmark_value>ordkomplettering;använda/inaktivera</bookmark_value>      <bookmark_value>inaktivera;ordkomplettering</bookmark_value>      <bookmark_value>stänga av;ordkomplettering</bookmark_value>      <bookmark_value>inaktivera;ordkomplettering</bookmark_value>      <bookmark_value>neka ordkompletteringar</bookmark_value>      <bookmark_value>avvisa ordkompletteringar</bookmark_value>"

#. from libreoffice:swriter-guide
msgid "<variable id=\"word_completion\"><link href=\"text/swriter/guide/word_completion.xhp\">Word Completion for Text Documents</link></variable>"
msgstr "<variable id=\"word_completion\"><link href=\"text/swriter/guide/word_completion.xhp\">Ordkomplettering för textdokument</link></variable>"

#. from libreoffice:swriter-guide
msgid "$[officename] collects words that you frequently use in the current session. When you later type the first three letters of a collected word, $[officename] automatically completes the word."
msgstr "$[officename] lagrar ord som du använder ofta under den aktuella sessionen. När du senare skriver de tre första bokstäverna i ett lagrat ord, fylls resten av ordet automatiskt i av $[officename]."

#. from libreoffice:swriter-guide
msgid "If there is more than one word in the AutoCorrect memory that matches the three letters that you type, press <switchinline select=\"sys\"><caseinline select=\"MAC\">Command</caseinline><defaultinline>Ctrl</defaultinline></switchinline>+Tab to cycle through the available words. To cycle in the opposite direction, press <switchinline select=\"sys\"><caseinline select=\"MAC\">Command</caseinline><defaultinline>Ctrl</defaultinline></switchinline>+Shift+Tab."
msgstr "Om det finns mer än ett ord i autokorrigeringsminnet som matchar de första tre bokstäverna så kan du växla mellan orden genom att trycka på <switchinline select=\"sys\"><caseinline select=\"MAC\">Kommando</caseinline><defaultinline>Ctrl</defaultinline></switchinline>+Tabb. Om du vill visa listan i omvänd ordning trycker du på <switchinline select=\"sys\"><caseinline select=\"MAC\">Kommando</caseinline><defaultinline>Ctrl</defaultinline></switchinline>+Skift+Tabb."

#. from libreoffice:swriter-guide
msgid "To Accept/Reject a Word Completion"
msgstr "Så här gör du för att acceptera/avvisa en ordkomplettering"

#. from libreoffice:swriter-guide
msgid "By default, you accept the word completion by pressing the Enter key."
msgstr "Du godkänner som standard ordkompletteringen genom att trycka på Retur."

#. from libreoffice:swriter-guide
msgid "To reject the word completion, continue typing with any other key."
msgstr "Om du inte vill använda det ord ordkompletteringen föreslår fortsätter du bara att skriva."

#. from libreoffice:swriter-guide
msgid "To Switch off the Word Completion"
msgstr "Så här stänger du av ordkomplettering"

#. from libreoffice:swriter-guide
msgid "Choose <item type=\"menuitem\">Tools - AutoCorrect - AutoCorrect Options - Word Completion</item>."
msgstr "Välj <item type=\"menuitem\">Verktyg - Alternativ för autokorrigering - Ordkomplettering</item>."

#. from libreoffice:swriter-guide
msgid "<link href=\"text/swriter/guide/word_completion_adjust.xhp\">Fine-Tuning the Word Completion</link>"
msgstr "<link href=\"text/swriter/guide/word_completion_adjust.xhp\">Finjustera ordkompletteringen</link>"

#. from libreoffice:swriter-guide
msgid "Fine-Tuning the Word Completion for Text Documents"
msgstr "Finjustera ordkompletteringen för textdokument"

#. from libreoffice:swriter-guide
msgid "<bookmark_value>settings;word completion</bookmark_value>      <bookmark_value>word completion;settings</bookmark_value>      <bookmark_value>text documents;word completion settings</bookmark_value>      <bookmark_value>weekdays; automatically completing</bookmark_value>      <bookmark_value>months; automatically completing</bookmark_value>"
msgstr "<bookmark_value>inställningar;ordkomplettering</bookmark_value>      <bookmark_value>ordkomplettering;inställningar</bookmark_value>      <bookmark_value>textdokument;ordkomplettering, inställningar</bookmark_value>      <bookmark_value>veckodagar; komplettera automatiskt</bookmark_value>      <bookmark_value>månader; komplettera automatiskt</bookmark_value>"

#. from libreoffice:swriter-guide
msgid "<variable id=\"word_completion_adjust\"><link href=\"text/swriter/guide/word_completion_adjust.xhp\">Fine-Tuning the Word Completion for Text Documents</link></variable>"
msgstr "<variable id=\"word_completion_adjust\"><link href=\"text/swriter/guide/word_completion_adjust.xhp\">Finjustera ordkompletteringen för textdokument</link></variable>"

#. from libreoffice:swriter-guide
msgid "If you like it that $[officename] automatically completes the words that you frequently use, you can make further adjustments to refine that behavior. If you want, you can also save the current list of collected words so that it can be used in the next session."
msgstr "Om du vill att $[officename] automatiskt ska fylla i ord som du använder ofta kan du anpassa funktionen ytterligare. Om du vill kan du spara listan över lagrade ord så att den kan användas även i följande session."

#. from libreoffice:swriter-guide
msgid "To fine-tune the word completion choose <item type=\"menuitem\">Tools – AutoCorrect Options - Word Completion</item> and select any of the following options:"
msgstr "Så här finjusterar du ordkompletteringen: Välj <item type=\"menuitem\">Verktyg – Alternativ för autokorrigering – Ordkomplettering</item> och markera något av alternativen nedan."

#. from libreoffice:swriter-guide
msgid "To Insert an Additional Space Character"
msgstr "Så här infogar du ett extra mellanslag"

#. from libreoffice:swriter-guide
msgid "Select <emph>Append space</emph>."
msgstr "Välj <emph>Tillfoga blanksteg</emph>."

#. from libreoffice:swriter-guide
msgid "The space character is appended after you type the first character of the next word after the auto-completed word. The space character is suppressed if the next character is a delimiter, such as a full stop or a new line character."
msgstr "Mellanslagstecknet läggs till när du har skrivit första tecknet i nästa ord efter det automatiskt kompletterade ordet. Mellanslagstecknet uteblir om nästa tecken är ett skiljetecken, till exempel en punkt eller ett bindestreck."

#. from libreoffice:swriter-guide
msgid "To Define the Accept Key"
msgstr "Så här definierar du en tangent för godkännande"

#. from libreoffice:swriter-guide
msgid "Choose the key to accept the suggested word using the <emph>Accept with</emph> list box."
msgstr "Använd listrutan <emph>Acceptera med</emph> för att bestämma en tangent att godkänna det föreslagna ordet med."

#. from libreoffice:swriter-guide
msgid "To Select the Minimum Number of Characters"
msgstr "Så här anger du minsta antalet tecken"

#. from libreoffice:swriter-guide
msgid "Use the <emph>Min. word length</emph> box to set the minimum number of characters a word must have to be collected into the list."
msgstr "Använd rutan <emph>Min. ordlängd</emph> för att ange det minsta antal bokstäver ett ord måste bestå av för att registreras i listan."

#. from libreoffice:swriter-guide
msgid "To Select the Scope of Collected Words"
msgstr "Så här väljer du antalet registrerade ord"

#. from libreoffice:swriter-guide
msgid "Disable the option <emph>When closing a document, remove the words collected from it from the list</emph>."
msgstr "Inaktivera alternativet <emph>När du stänger ett dokument bör du ta bort orden som du samlat därifrån från listan</emph>."

#. from libreoffice:swriter-guide
msgid "Now the list is also valid for other documents that you open. When you close the last %PRODUCTNAME document, the word list is deleted."
msgstr "Nu gäller listan även för andra dokument som du öppnar. När du stänger det sista %PRODUCTNAME-dokumentet tas ordlistan bort."

#. from libreoffice:swriter-guide
msgid "If you enable the checkbox, the list is only valid as long as the current document is open."
msgstr "Om du aktiverar kryssrutan gäller listan endast så länge det aktuella dokumentet är öppet."

#. from libreoffice:swriter-guide
msgid "If you want the word list to exist longer than the current %PRODUCTNAME session, save it as a document, as described in the following section."
msgstr "Om du vill kunna använda ordlistan fler gånger i %PRODUCTNAME  sparar du den som ett dokument enligt anvisningarna i följande avsnitt."

#. from libreoffice:swriter-guide
msgid "To Use the Word List for Further Sessions"
msgstr "Så här använder du ordförteckningen för fler sessioner"

#. from libreoffice:swriter-guide
msgid "If the automatic spellcheck option is enabled, only the words that are recognized by the spellcheck are collected."
msgstr "Om alternativet för automatisk stavningskontroll har aktiverats registreras endast de ord som känns igen av stavningskontrollen."

#. from libreoffice:swriter-guide
msgid "Use the word list to always start with a defined set of technical terms for the word completion feature."
msgstr "Med hjälp av ordlistan kan du alltid utgå från en bestämd uppsättning tekniska termer för ordkomplettering."

#. from libreoffice:swriter-guide
msgid "Open the text document that contains the terms that you want to use for word completion."
msgstr "Öppna dokumentet som innehåller termerna du vill ska användas vid ordkompletteringen."

#. from libreoffice:swriter-guide
msgid "The word completion feature collects the words."
msgstr "Funktionen för ordkomplettering registrerar orden."

#. from libreoffice:swriter-guide
msgid "Select all or some of the words in the list."
msgstr "Markera alla eller ett urval av orden i listan."

#. from libreoffice:swriter-guide
msgid "Use <switchinline select=\"sys\"><caseinline select=\"MAC\">Command </caseinline><defaultinline>Ctrl</defaultinline></switchinline>+C to copy all selected words into the clipboard. Paste the clipboard into a new document and save it to get a reference list of collected words."
msgstr "Använd <switchinline select=\"sys\"><caseinline select=\"MAC\">Kommando</caseinline><defaultinline>Ctrl</defaultinline></switchinline>+C för att kopiera alla markerade ord till Urklipp. Klistra in innehållet i Urklipp i ett nytt dokument och spara det som en referenslista över registrerade ord."

#. from libreoffice:swriter-guide
msgid "Later you can open the reference list and automatically collect the words, so that the word completion feature starts with a defined set of words."
msgstr "Du kan sedan öppna referenslistan och automatiskt registrera orden så att funktionen för ordkomplettering har en bestämd uppsättning ord att börja med."

#. from libreoffice:swriter-guide
msgid "<link href=\"text/shared/01/06040600.xhp\">Word Completion</link>"
msgstr "<link href=\"text/shared/01/06040600.xhp\">Ordkomplettering</link>"

#. from libreoffice:swriter-guide
msgid "<link href=\"text/swriter/guide/word_completion.xhp\">Using Word Completion</link>"
msgstr "<link href=\"text/swriter/guide/word_completion.xhp\">Använda ordkomplettering</link>"

#. from libreoffice:swriter-guide
msgid "Counting Words"
msgstr "Räknar ord"

#. from libreoffice:swriter-guide
msgid "<bookmark_value>words; counting in text</bookmark_value>      <bookmark_value>number of words</bookmark_value>      <bookmark_value>documents; number of words/characters</bookmark_value>      <bookmark_value>text; number of words/characters</bookmark_value>      <bookmark_value>characters; counting</bookmark_value>      <bookmark_value>number of characters</bookmark_value>      <bookmark_value>counting words</bookmark_value>      <bookmark_value>word counts</bookmark_value>"
msgstr "<bookmark_value>ord; räkna i text</bookmark_value>      <bookmark_value>antal ord</bookmark_value>      <bookmark_value>dokument; antal ord/tecken</bookmark_value>      <bookmark_value>text; antal ord/tecken</bookmark_value>      <bookmark_value>tecken; räkna</bookmark_value>      <bookmark_value>Antal tecken</bookmark_value>      <bookmark_value>räkna ord</bookmark_value>      <bookmark_value>ordräkning</bookmark_value>"

#. from libreoffice:swriter-guide
msgid "<variable id=\"words_count\"><link href=\"text/swriter/guide/words_count.xhp\">Counting Words</link></variable>"
msgstr "<variable id=\"words_count\"><link href=\"text/swriter/guide/words_count.xhp\">Antal ord</link></variable>"

#. from libreoffice:swriter-guide
msgid "Word and character count is shown in the status bar, and is kept up to date as you edit."
msgstr "Antalet ord och tecken visas i statusraden och uppdateras medan du skriver."

#. from libreoffice:swriter-guide
msgid "If you want to count only some text of your document, select the text."
msgstr "Om du bara vill räkna viss text i dokumentet markerar du texten."

#. from libreoffice:swriter-guide
msgid "To display extended statistics such as count of characters without spaces, double click the word count in the status bar, or choose <emph>Tools - Word Count</emph>."
msgstr "För att visa mer statistik så som antal ord och tecken utan blanksteg, dubbelklicka på antal i statusraden eller välj <emph>Verktyg - Antal ord</emph>."

#. from libreoffice:swriter-guide
msgid "How does %PRODUCTNAME count words?"
msgstr "Hur görs ordräkning i %PRODUCTNAME?"

#. from libreoffice:swriter-guide
msgid "In general, every string of characters between two spaces is a word. Dashes, tabs, line breaks, and paragraph breaks are word limits, too."
msgstr "Varje teckensträng mellan två blanksteg är i princip ett ord. Bindestreck, tabbar, radbrytningar och styckebrytningar är också ordavgränsare."

#. from libreoffice:swriter-guide
msgid "Words with always visible hyphens, as in plug-in, add-on, user/config, are counted as one word each."
msgstr "Ord med tankstreck eller ständigt synliga bindestreck, som till exempel plugin-program eller nästa/föregående, räknas som ett ord."

#. from libreoffice:swriter-guide
msgid "The words can be a mix of letters, numbers, and special characters. So the following text counts as four words: abc123 1.23 \"$\" http://www.example.com."
msgstr "Orden kan vara en blandning av bokstäver, tal och specialtecken. Följande text räknas alltså som fyra ord: abc123 1.23 \"$\" http://www.exempel.com."

#. from libreoffice:swriter-guide
msgid "To get some more statistics about the document, choose <emph>File - Properties - Statistics</emph>."
msgstr "Mer statistik om dokumentet får du om du väljer <emph>Arkiv - Egenskaper - Statistik</emph>."

#. from libreoffice:swriter-guide
msgid "<link href=\"text/shared/01/01100400.xhp\">File - Properties - Statistics</link>"
msgstr "<link href=\"text/shared/01/01100400.xhp\">Arkiv - Egenskaper - Statistik</link>"

#. from libreoffice:swriter-guide
msgid "Wrapping Text Around Objects"
msgstr "Skriva text kring objekt"

#. from libreoffice:swriter-guide
msgid "<bookmark_value>text wrap around objects</bookmark_value>  <bookmark_value>contour editor</bookmark_value>  <bookmark_value>contour wrap</bookmark_value>  <bookmark_value>text; formatting around objects</bookmark_value>  <bookmark_value>formatting; contour wrap</bookmark_value>  <bookmark_value>objects; contour wrap</bookmark_value>  <bookmark_value>wrapping text;editing contours</bookmark_value>  <bookmark_value>editors;contour editor</bookmark_value>"
msgstr "<bookmark_value>textanpassning runt objekt</bookmark_value>      <bookmark_value>konturredigerare</bookmark_value>      <bookmark_value>konturanpassning</bookmark_value>      <bookmark_value>text; formatera runt objekt</bookmark_value>      <bookmark_value>formatera; konturanpassning</bookmark_value>      <bookmark_value>objekt; konturanpassning</bookmark_value>      <bookmark_value>anpassa text;redigera konturer</bookmark_value>      <bookmark_value>redigerare;konturredigerare</bookmark_value>"

#. from libreoffice:swriter-guide
msgid "<variable id=\"wrap\"><link href=\"text/swriter/guide/wrap.xhp\">Wrapping Text Around Objects</link></variable>"
msgstr "<variable id=\"wrap\"><link href=\"text/swriter/guide/wrap.xhp\">Textanpassning runt objekt</link></variable>"

#. from libreoffice:swriter-guide
msgid "To Wrap Text Around an Object"
msgstr "Så här anpassar du text runt ett objekt"

#. from libreoffice:swriter-guide
msgid "The current wrapping style is indicated by a bullet."
msgstr "Den aktuella textanpassningsmallen indikeras med en punkt."

#. from libreoffice:swriter-guide
msgid "To Specify the Wrapping Properties"
msgstr "Så här anger du egenskaper för textanpassning"

#. from libreoffice:swriter-guide
msgid "Set the options that you want."
msgstr "Ange de alternativ som du vill använda."

#. from libreoffice:swriter-guide
msgid "To Change the Wrapping Contour of a Graphic"
msgstr "Så här ändrar du textanpassningskontur för ett grafiskt objekt"

#. from libreoffice:swriter-guide
msgid "You can change the shape that the text wraps around."
msgstr "Du kan ändra formen som texten anpassas till."

#. from libreoffice:swriter-guide
msgid "Select the graphic, right-click, and then choose <emph>Wrap - Edit Contour</emph>."
msgstr "Markera det grafiska objektet, högerklicka och välj sedan <emph>Textanpassning - Redigera kontur</emph>."

#. from libreoffice:swriter-guide
msgid "Use the tools to draw a new contour, and then click the <item type=\"menuitem\">Apply</item> icon (green check mark)."
msgstr "Dra en ny kontur med hjälp av verktygen och klicka sedan på ikonen <item type=\"menuitem\">Tilldela</item>               (grön bock)."

#. from libreoffice:swriter-guide
msgid "Close the <item type=\"menuitem\">Contour Editor</item> window."
msgstr "Stäng fönstret <item type=\"menuitem\">Konturredigerare</item>               ."

#. from libreoffice:swriter-guide
msgid "<link href=\"text/swriter/01/05060201.xhp\">Contour Editor</link>"
msgstr "<link href=\"text/swriter/01/05060201.xhp\">Konturredigerare</link>"

#. from libreoffice:swriter-librelogo
msgid "LibreLogo Toolbar"
msgstr "Verktygsraden LibreLogo"

#. from libreoffice:swriter-librelogo
msgid "<bookmark_value>LibreLogo</bookmark_value><bookmark_value>Logo</bookmark_value><bookmark_value>Turtle graphics</bookmark_value>"
msgstr "<bookmark_value>LibreLogo</bookmark_value><bookmark_value>Logo</bookmark_value><bookmark_value>Sköldpaddsgrafik</bookmark_value>"

#. from libreoffice:swriter-librelogo
msgid "LibreLogo is a simple, localized, Logo-like programming environment with turtle vector graphics for teaching of computing (programming and word processing), DTP and graphic design. See <link href=\"http://www.numbertext.org/logo/librelogo.pdf\">http://www.numbertext.org/logo/librelogo.pdf</link>."
msgstr "LibreLogo är en enkel Logo-liknande programmeringsmiljö med sköldpaddegrafik som skapats för att utbilda informationskunskap (programmering och ordbehandling), DTP och grafikdesign. Se <link href=\"http://www.numbertext.org/logo/librelogo.pdf\">http://www.numbertext.org/logo/librelogo.pdf</link>."

#. from libreoffice:swriter-librelogo
msgid "LibreLogo toolbar"
msgstr "Verktygsraden LibreLogo"

#. from libreoffice:swriter-librelogo
msgid "The LibreLogo toolbar (<item type=\"menuitem\">View - Toolbars - Logo</item>) contains turtle moving, program start, stop, home, clear screen, program editor/syntax highlighting/translating icons and an input bar (command line)."
msgstr "Verktygsraden LibreLogo (<item type=\"menuitem\">Visa - Verktygsrader - Logo</item>) innehåller förflyttning av sköldpadda, start/stop av programkörning, hem, rensa skärmen, syntaxmarkering/-översättning och en inmatningsrad (kommandorad)."

#. from libreoffice:swriter-librelogo
msgid "Turtle moving icons"
msgstr "Ikoner för sköldpaddsförflyttningar"

#. from libreoffice:swriter-librelogo
msgid "They are equivalents of the Logo commands “FORWARD 10”, “BACK 10”, “LEFT 15”, “RIGHT 15”. Clicking on one of the icons will also focus the turtle shape scrolling the page to its position."
msgstr "De motsvarar Logo-kommandona \"FORWARD 10\", \"BACK 10\", \"LEFT 15\", \"RIGHT 15\". Genom att klicka på en av ikonerna så kommer markören att fokusera på sköldpaddan och sidan kommer rullas till dess position."

#. from libreoffice:swriter-librelogo
msgid "Start Logo program"
msgstr "Starta Logo-program"

#. from libreoffice:swriter-librelogo
msgid "Click on the icon “Start Logo program” to execute the text (or only the selected) text of the Writer document as a LibreLogo program. In an empty document an example program will be inserted and executed."
msgstr "Klicka på ikonen \"Starta Logoprogram\" för att köra texten i dokumentet (eller i markeringen) som ett LibreLogoprogram. I ett tomt dokument infogas ett exempelprogram och körs."

#. from libreoffice:swriter-librelogo
msgid "Click on the icon “Stop” to stop the program execution."
msgstr "Klicka på “Stopp”-ikonen för att stoppa programmet."

#. from libreoffice:swriter-librelogo
msgid "Click on the icon “Home” to reset the position and settings of the turtle."
msgstr "Klicka på \"Hem\"-ikonen för att återställa sköldpaddans position och inställningar."

#. from libreoffice:swriter-librelogo
msgid "Clear screen"
msgstr "Rensa skärmen."

#. from libreoffice:swriter-librelogo
msgid "Click on the icon “Clear screen” to remove the drawing objects of the document."
msgstr "Klicka på ikonen “Rensa skärm” för att ta bort teckningsobjekt från dokumentet."

#. from libreoffice:swriter-librelogo
msgid "Program editor/Syntax highlighting/Translating"
msgstr "Program redigerare/Syntax märkning/Översättning"

#. from libreoffice:swriter-librelogo
msgid "Command line"
msgstr "Kommandorad"

#. from libreoffice:swriter-librelogo
msgid "Hit Enter in the command line to execute its content. To stop the program use the icon “Stop”."
msgstr "Tyck Enter i kommandoraden för att köra dess innehåll. För att stoppa programmet använder du ikonen \"Stop\"."

#. from libreoffice:swriter-librelogo
msgid "Hold down the Enter to repeat the command line, for example, on the following command sequence:"
msgstr "Håll nere Enter för att upprepa kommandot, till exempel på följande kommandosekvens:"

#. from libreoffice:swriter-librelogo
msgid "FORWARD 200 LEFT 89<br/>"
msgstr "FORWARD 200 LEFT 89<br/>"

#. from libreoffice:swriter-librelogo
msgid "Graphical user interface of basic turtle settings"
msgstr "Användargränssnitt för grundläggande sköldpaddeinställningar"

#. from libreoffice:swriter-librelogo
msgid "Program editing"
msgstr "Programredigering"

#. from libreoffice:swriter-librelogo
msgid "LibreLogo drawings and programs use the same Writer document. The LibreLogo canvas is on the first page of the Writer document. You can insert a page break before the LibreLogo programs and set page zoom using the “magic wand” icon of the Logo toolbar, also change the font size for a comfortable 2-page layout for LibreLogo programming: left (first) page is the canvas, right (second) page is the LibreLogo program editor."
msgstr "LibreLogo-teckningar och program använder samma dokument. Ritytan för LibreLogo är på första sidan i Writer-dokumentet. Du kan infoga en sidbrytning före LibreLogo-programmet och ange sidans zoomningsgrad med hjälp av \"trollstavs\"-ikonen i verktygsraden Logo. Förslagsvis kan du även förstora teckenstorleken så att texten blir mer lättläst i den tvåsidiga layouten. Med detta tillvägagångssätt får du ritytan på sida ett och programredigeraren på sidan två."

#. from libreoffice:swriter-librelogo
msgid "LibreLogo programming language"
msgstr "Programmeringsspråket LibreLogo"

#. from libreoffice:swriter-librelogo
msgid "LibreLogo is an easily localizable, Logo-like programming language, localized in several languages by LibreOffice native language communities. It is back-compatible with the older Logo systems in the case of the simple Logo programs used in education, eg."
msgstr "LibreLogo är ett Logo-liknande programmeringsspråk som lätt kan översättas. Det har redan översatts till flera språk av LibreOffice lokala gemenskaper. Det är bakåtkompatibelt med äldre Logo-system om det handlar om enkla Logoprogram som t.ex. används inom utbildningar."

#. from libreoffice:swriter-librelogo
msgid "TO triangle :size<br/> REPEAT 3 [<br/>   FORWARD :size<br/>   LEFT 120<br/> ]<br/> END<br/> <br/> triangle 10 triangle 100 triangle 200<br/>"
msgstr "TO triangle :size<br/> REPEAT 3 [<br/>   FORWARD :size<br/>   LEFT 120<br/> ]<br/> END<br/> <br/> triangle 10 triangle 100 triangle 200<br/>"

#. from libreoffice:swriter-librelogo
msgid "Differences from the Logo programming language"
msgstr "Skillnader från Logo programmeringsspråk"

#. from libreoffice:swriter-librelogo
msgid "List members are comma separated: POSITION [0, 0]"
msgstr "Listinnehåll är kommaseparerat: POSITION [0, 0]"

#. from libreoffice:swriter-librelogo
msgid "Program blocks and lists are different"
msgstr "Programblock och listor är annorlunda"

#. from libreoffice:swriter-librelogo
msgid "Program blocks need space or new line at parenthesization: REPEAT 10 [ FORWARD 10 LEFT 36 ]"
msgstr "Programblock behöver blanksteg eller ny rad vid parenteser: REPEAT 10 [ FORWARD 10 LEFT 36 ]"

#. from libreoffice:swriter-librelogo
msgid "Lists need close parenthesization: POSITION [0, 0], and not POSITION [ 0, 0 ]"
msgstr "Listor kräver angränsande parenteser (utan blanksteg): POSITION [0, 0], och inte POSITION [ 0, 0 ]"

#. from libreoffice:swriter-librelogo
msgid "1-line function declarations are not supported (TO and END need new lines)."
msgstr "1-rads funktionsdeklarationer stöds ej (TO och END behöver radbrytningar)."

#. from libreoffice:swriter-librelogo
msgid "Other features of LibreLogo"
msgstr "Andra funktioner i LibreLogo"

#. from libreoffice:swriter-librelogo
msgid "The colon is optional before the variable names."
msgstr "Kolon är valfritt före variabelnamn."

#. from libreoffice:swriter-librelogo
msgid "TO triangle size<br/>   REPEAT 3 [ FORWARD size LEFT 120 ]<br/> END<br/>"
msgstr "TO triangle size<br/>   REPEAT 3 [ FORWARD size LEFT 120 ]<br/> END<br/>"

#. from libreoffice:swriter-librelogo
msgid "String notation supports also orthographical and Python syntax."
msgstr "Strängnotation stöder också ortografi och python-syntax."

#. from libreoffice:swriter-librelogo
msgid "PRINT \"word ; original Logo syntax<br/> PRINT “Arbitrary text.” ; orthography, Writer<br/> PRINT 'Arbitrary text.' ; Python syntax<br/>"
msgstr "PRINT \"ord ; original Logo-syntax<br/> PRINT “Godtyklig text.” ; ortografi, Writer<br/> PRINT 'Godtycklig text.' ; Python-syntax<br/>"

#. from libreoffice:swriter-librelogo
msgid "Python list and string handling"
msgstr "Python list- och stränghantering"

#. from libreoffice:swriter-librelogo
msgid "PRINT “text”[2] ; print “x”<br/> PRINT “text”[1:3] ; print “ex”<br/>"
msgstr "PRINT “text”[2] ; skriver ut “x”<br/> PRINT “text”[1:3] ; skriver ut “ex”<br/>"

#. from libreoffice:swriter-librelogo
msgid "Python-like FOR loop"
msgstr "Python-liknande FOR-loop"

#. from libreoffice:swriter-librelogo
msgid "Python-like variable declaration:"
msgstr "Python-liknande variabeldeklaration:"

#. from libreoffice:swriter-librelogo
msgid "x = 15<br/> PRINT x<br/>"
msgstr "x = 15<br/> PRINT x<br/>"

#. from libreoffice:swriter-librelogo
msgid "There are no extra query functions:"
msgstr "Det finns inga extra sökfunktioner:"

#. from libreoffice:swriter-librelogo
msgid "PRINT FILLCOLOR<br/> p = POSITION<br/> PRINT p<br/> REPEAT 10 [ POSITION ANY POSITION p ]<br/>"
msgstr "PRINT FILLCOLOR<br/> p = POSITION<br/> PRINT p<br/> REPEAT 10 [ POSITION ANY POSITION p ]<br/>"

#. from libreoffice:swriter-librelogo
msgid "Alternative parenthesization in function calls"
msgstr "Alternativ användning av parenteser i funktionsanrop"

#. from libreoffice:swriter-librelogo
msgid "LibreLogo commands"
msgstr "LibreLogo-kommandon"

#. from libreoffice:swriter-librelogo
msgid "Basic syntax"
msgstr "Grundläggande syntax"

#. from libreoffice:swriter-librelogo
msgid "Case sensitivity"
msgstr "Skiftlägeskänslighet"

#. from libreoffice:swriter-librelogo
msgid "Commands, color constants are case insensitive:"
msgstr "Kommando och färgkonstanter är inte skiftlägeskänsliga:"

#. from libreoffice:swriter-librelogo
msgid "PRINT “Hello, World!”<br/> print “Hello, World, again!”<br/>"
msgstr "PRINT “Hello, World!”<br/> print “Hello, World, igen!”<br/>"

#. from libreoffice:swriter-librelogo
msgid "Variable names are case sensitive:"
msgstr "Variabelnamn är skiftlägeskänsliga:"

#. from libreoffice:swriter-librelogo
msgid "a = 5<br/> A = 7<br/> PRINT a<br/> PRINT A<br/>"
msgstr "a = 5<br/> A = 7<br/> PRINT a<br/> PRINT A<br/>"

#. from libreoffice:swriter-librelogo
msgid "Program lines"
msgstr "Programrader"

#. from libreoffice:swriter-librelogo
msgid "PRINT “Hello, World!” PRINT “LibreLogo”<br/>"
msgstr "PRINT “Hello, World!” PRINT “LibreLogo”<br/>"

#. from libreoffice:swriter-librelogo
msgid "Lines or line parts are comments from a semicolon to the end of the line (paragraph):"
msgstr "Rader eller delar av rader kan göras till kommentarer genom att lägga till ett semikolon, allt som följer semikolon (i samma stycke) räknas som en kommentar."

#. from libreoffice:swriter-librelogo
msgid "; some comments<br/> PRINT 5 * 5 ; some comments<br/>"
msgstr "; en kommentar<br/> PRINT 5 * 5 ; ytterligare en kommentar<br/>"

#. from libreoffice:swriter-librelogo
msgid "Break program lines to multiple paragraphs"
msgstr "Dela upp programrader i flera stycken"

#. from libreoffice:swriter-librelogo
msgid "It’s possible to break a program line for more paragraphs using the character tilde at the end of the line:"
msgstr "Det är möjligt att dela upp en programrad i flera stycken med hjälp av tecknet ~ (tilde) vid radens slut:"

#. from libreoffice:swriter-librelogo
msgid "PRINT “This is a very long ” + ~<br/>       “warning message”<br/>"
msgstr "PRINT “Detta är ett väldigt långt ” + ~<br/>       “varningsmeddelande”<br/>"

#. from libreoffice:swriter-librelogo
msgid "Turtle moving"
msgstr "Sköldpaddsförflyttningar"

#. from libreoffice:swriter-librelogo
msgid "FORWARD (fd)"
msgstr "FORWARD (fd)"

#. from libreoffice:swriter-librelogo
msgid "FORWARD 10 ; move forward 10pt (1pt = 1/72 inch)<br/> FORWARD 10pt ; see above<br/> FORWARD 0.5in ; move forward 0.5 inch (1 inch = 2.54 cm)<br/> FORWARD 1\" ; see above<br/> FD 1mm<br/> FD 1cm<br/>"
msgstr "FORWARD 10 ; flyttar framåt 10pt (1pt = 1/72 inch = 0,35 mm)<br/> FORWARD 10pt ; se ovan<br/> FORWARD 0.5in ; flytta framåt 0.5 inch (1 inch = 2,54 cm)<br/> FORWARD 1\" ; se ovan<br/> FD 1mm<br/> FD 1cm<br/>"

#. from libreoffice:swriter-librelogo
msgid "BACK (bk)"
msgstr "BACK (bk)"

#. from libreoffice:swriter-librelogo
msgid "BACK 10 ; move back 10pt<br/>"
msgstr "BACK 10 ; flytta bakåt 10pt<br/>"

#. from libreoffice:swriter-librelogo
msgid "LEFT (lt)"
msgstr "LEFT (lt)"

#. from libreoffice:swriter-librelogo
msgid "LEFT 90 ; turn counterclockwise 90 degrees<br/> LEFT 90° ; see above<br/> LT 3h ; see above (clock position)<br/> LT any ; turn to a random position<br/>"
msgstr "LEFT 90 ; sväng 90 grader motsols<br/> LEFT 90° ; se ovan<br/> LT 3h ; sväng 3 timmar mot klockans riktning, dvs 90 grader motsols<br/> LT any ; sväng åt ett slumpmässigt håll<br/>"

#. from libreoffice:swriter-librelogo
msgid "RIGHT (rt)"
msgstr "RIGHT (rt)"

#. from libreoffice:swriter-librelogo
msgid "RIGHT 90 ; turn clockwise 90 degrees<br/>"
msgstr "RIGHT 90 ; sväng 90 grader medsols<br/>"

#. from libreoffice:swriter-librelogo
msgid "PENUP (pu)"
msgstr "PENUP (pu)"

#. from libreoffice:swriter-librelogo
msgid "PENUP ; turtle will move without drawing<br/>"
msgstr "PENUP ; flytta sköldpaddan utan att rita något<br/>"

#. from libreoffice:swriter-librelogo
msgid "PENDOWN (pd)"
msgstr "PENDOWN (pd)"

#. from libreoffice:swriter-librelogo
msgid "PENDOWN ; turtle will move with drawing<br/>"
msgstr "PENDOWN ; rita medan du flyttar sköldpaddan<br/>"

#. from libreoffice:swriter-librelogo
msgid "POSITION (pos)"
msgstr "POSITION (pos)"

#. from libreoffice:swriter-librelogo
msgid "POSITION [0, 0] ; turn and move to the top-left corner<br/> POSITION PAGESIZE ; turn and move to the bottom-right corner<br/> POSITION [PAGESIZE[0], 0] ; turn and move to the top-right corner<br/> POSITION ANY ; turn and move to a random position<br/>"
msgstr "POSITION [0, 0] ; sväng och flytta till översta, vänstra hörnet<br/> POSITION PAGESIZE ; sväng och flytta till nedersta högra hörnet<br/> POSITION [PAGESIZE[0], 0] ; sväng och flytta till översta, högra hörnet<br/> POSITION ANY ; sväng och flytta till en slumpmässig position<br/>"

#. from libreoffice:swriter-librelogo
msgid "HEADING (seth)"
msgstr "HEADING (seth)"

#. from libreoffice:swriter-librelogo
msgid "HEADING 0 ; turn north<br/> HEADING 12h ; see above<br/> HEADING [0, 0] ; turn to the top-left corner<br/> HEADING ANY ; turn to a random direction<br/>"
msgstr "HEADING 0 ; sväng norrut<br/> HEADING 12h ; se ovan<br/> HEADING [0, 0] ; sväng mot vänstra övre hörnet<br/> HEADING ANY ; sväng i en slumpmässig riktning<br/>"

#. from libreoffice:swriter-librelogo
msgid "Other turtle commands"
msgstr "Andra skölpaddekommandon"

#. from libreoffice:swriter-librelogo
msgid "HIDETURTLE (ht)"
msgstr "HIDETURTLE (ht)"

#. from libreoffice:swriter-librelogo
msgid "HIDETURTLE ; hide turtle (until the showturtle command)<br/>"
msgstr "HIDETURTLE ; döljer sköldpaddan (tills kommandot showturtle används)<br/>"

#. from libreoffice:swriter-librelogo
msgid "SHOWTURTLE (st)"
msgstr "SHOWTURTLE (st)"

#. from libreoffice:swriter-librelogo
msgid "SHOWTURTLE ; show turtle<br/>"
msgstr "SHOWTURTLE ; visa sköldpadda<br/>"

#. from libreoffice:swriter-librelogo
msgid "HOME"
msgstr "HOME"

#. from libreoffice:swriter-librelogo
msgid "HOME ; reset initial turtle position<br/>"
msgstr "HOME ; nollställ sköldpaddans ursprungliga position<br/>"

#. from libreoffice:swriter-librelogo
msgid "CLEARSCREEN (cs)"
msgstr "CLEARSCREEN (cs)"

#. from libreoffice:swriter-librelogo
msgid "CLEARSCREEN ; remove drawing objects of the document<br/>"
msgstr "CLEARSCREEN ; tar bort ritade objekt från dokumentet<br/>"

#. from libreoffice:swriter-librelogo
msgid "FILL and CLOSE"
msgstr "FILL och CLOSE"

#. from libreoffice:swriter-librelogo
msgid "FILL ; close and fill the actual line shape or points<br/> CLOSE ; close the actual line shape or join the actual points<br/>"
msgstr "FILL ; stäng och fyll den aktuella streckfiguren eller punkter<br/> CLOSE ; stänger den aktuella streckfiguren eller förbinder de aktuella punkterna<br/>"

#. from libreoffice:swriter-librelogo
msgid "Example: filling a regular triangle:"
msgstr "Exempel: fyllning av en vanlig triangel:"

#. from libreoffice:swriter-librelogo
msgid "FORWARD 50 LEFT 120 FORWARD 50 FILL<br/>"
msgstr "FRAM 50 VÄNSTER 120 FRAM 50 FYLL<br/>"

#. from libreoffice:swriter-librelogo
msgid "Example: drawing a regular triangle:"
msgstr "Exempel: ritning av en vanlig triangel:"

#. from libreoffice:swriter-librelogo
msgid "FORWARD 50 LEFT 120 FORWARD 50 CLOSE<br/>"
msgstr "FRAM 50 VÄNSTER 120 FRAM 50 STÄNG<br/>"

#. from libreoffice:swriter-librelogo
msgid "Pen settings"
msgstr "Penninställningar"

#. from libreoffice:swriter-librelogo
msgid "PENSIZE (ps)"
msgstr "PENSIZE (ps)"

#. from libreoffice:swriter-librelogo
msgid "PENCOLOR/PENCOLOUR (pc)"
msgstr "PENCOLOR/PENCOLOUR (pc)"

#. from libreoffice:swriter-librelogo
msgid "PENCOLOR “red” ; set red pen color (by color name, see color constants)<br/> PENCOLOR [255, 255, 0] ; set yellow color (RGB list)<br/> PENCOLOR 0xffff00 ; set yellow color (hexa code)<br/> PENCOLOR 0 ; set black color (0x000000)<br/> PENCOLOR ANY ; random color<br/> PENCOLOR [5] ; set red color (by color identifier, see color constants)<br/> PENCOLOR “invisible” ; invisible pen color for shapes without visible outline<br/> PENCOLOR “~red” ; set random red color<br/>"
msgstr "PENCOLOR “red” ; ange pennfärgen till röd (via färgnamn, se färgkonstanter)<br/> PENCOLOR [255, 255, 0] ; anger en gul färg (RGB lista)<br/> PENCOLOR 0xffff00 ; anger gul färg (hexadecimal kod)<br/> PENCOLOR 0 ; anger svart färg (0x000000)<br/> PENCOLOR ANY ; slumpmässig färg<br/> PENCOLOR [5] ; anger röd färg (via färgidentifierare, se färgkonstanter)<br/> PENCOLOR “invisible” ; genomskinlig \"färg\" för former utan synligt område<br/> PENCOLOR “~red” ; ange en slumpmässig röd färg<br/>"

#. from libreoffice:swriter-librelogo
msgid "PENTRANSPARENCY"
msgstr "PENTRANSPARENCY"

#. from libreoffice:swriter-librelogo
msgid "PENTRANSPARENCY 80 ; set the transparency of the actual pen color to 80%<br/>"
msgstr "PENTRANSPARENCY 80 ; ange transparensen för pennans färg till 80%<br/>"

#. from libreoffice:swriter-librelogo
msgid "PENCAP/LINECAP"
msgstr "PENCAP/LINECAP"

#. from libreoffice:swriter-librelogo
msgid "PENCAP “none” ; without extra line end (default)<br/> PENCAP “round” ; rounded line end<br/> PENCAP “square” ; square line end<br/>"
msgstr "PENCAP “none” ; utan extra linjeslut (standard)<br/> PENCAP “round” ; avrundat linjeslut<br/> PENCAP “square” ; fyrkantigt linjeslut<br/>"

#. from libreoffice:swriter-librelogo
msgid "PENJOINT/LINEJOINT"
msgstr "PENJOINT/LINEJOINT"

#. from libreoffice:swriter-librelogo
msgid "PENJOINT “rounded” ; rounded line joint (default)<br/> PENJOINT “miter” ; sharp line joint<br/> PENJOINT “bevel” ; bevel line joint<br/> PENJOINT “none” ; without line joint<br/>"
msgstr "PENJOINT “rounded” ; avrundade linjeskarvar (standard)<br/> PENJOINT “miter” ; skarpa linjeskarvar<br/> PENJOINT “bevel” ; kapade linjeskarvar<br/> PENJOINT “none” ; ingen linjeskarv<br/>"

#. from libreoffice:swriter-librelogo
msgid "PENSTYLE"
msgstr "PENSTYLE"

#. from libreoffice:swriter-librelogo
msgid "PENSTYLE “solid” ; solid line (default)<br/> PENSTYLE “dotted” ; dotted line<br/> PENSTYLE “dashed” ; dashed line<br/> <br/> ; custom dot–dash pattern specified by a list with the following arguments:<br/> ; – number of the neighbouring dots<br/> ; – length of a dot<br/> ; – number of the neighbouring dashes<br/> ; – length of a dash<br/> ; – distance of the dots/dashes<br/> ; – type (optional):<br/> ;   0 = dots are rectangles (default)<br/> ;   2 = dots are squares (lengths and distances are relative to the pensize)<br/> <br/> PENSTYLE [3, 1mm, 2, 4mm, 2mm, 2] ; ...––...––...––<br/>"
msgstr "PENSTYLE “solid” ; solid linje (default)<br/> PENSTYLE “dotted” ; prickad linje<br/> PENSTYLE “dashed” ; streckad linje<br/> <br/> ; anpassat mönster av prickar och streck angivet av en lista med följande argument:<br/> ; – antal intilliggande punkter<br/> ; – prickarnas längd<br/> ; – antal intilliggande streck<br/> ; – streckens längd<br/> ; – avstånd mellan strickar/streck<br/> ; – typ (valfri):<br/> ;   0 = prickar är rektangulära (default)<br/> ;   2 = prickar är kvadratiska (avstånd och längd anges i förhållande till pennstorleken)<br/> <br/> PENSTYLE [3, 1mm, 2, 4mm, 2mm, 2] ; ...––...––...––<br/>"

#. from libreoffice:swriter-librelogo
msgid "Fill settings"
msgstr "Fyllningsinställningar"

#. from libreoffice:swriter-librelogo
msgid "FILLCOLOR/FILLCOLOUR (fc)"
msgstr "FILLCOLOR/FILLCOLOUR (fc)"

#. from libreoffice:swriter-librelogo
msgid "FILLTRANSPARENCY"
msgstr "FILLTRANSPARENCY"

#. from libreoffice:swriter-librelogo
msgid "FILLTRANSPARENCY 80 ; set the transparency of the actual fill color to 80%<br/> FILLTRANSPARENCY [80] ; set linear transparency gradient from 80% to 0%<br/> FILLTRANSPARENCY [80, 20] ; set linear transparency gradient from 80% to 20%<br/> FILLTRANSPARENCY [80, 20, 1, 90] ; set axial transparency gradient rotated with 90 degrees from the actual heading of the turtle<br/> FILLTRANSPARENCY [80, 20, 2, 0, 20, 50, 50] ; set radial transparency gradient from outer 80% to inner 20% transparency with 20% border and with 50-50% horizontal and vertical positions of the center<br/>"
msgstr "FILLTRANSPARENCY 80 ; anger att aktuella fyllnadsfärgen ska vara 80% transparent (genomskinlig)<br/> FILLTRANSPARENCY [80] ; anger linjär transparent toning från 80% till 0%<br/> FILLTRANSPARENCY [80, 20] ; anger linjär transparent toning från 80% till 20%<br/> FILLTRANSPARENCY [80, 20, 1, 90] ; anger axiell transparent toning roterat med 90 grader från sköldpaddans aktuella position<br/> FILLTRANSPARENCY [80, 20, 2, 0, 20, 50, 50] ; anger radiell transparent toning från yttre 80% till inre 20% transparens med 20% inramning och 50-50% horisontell och vertikal position från mitten<br/>"

#. from libreoffice:swriter-librelogo
msgid "FILLSTYLE"
msgstr "FILLSTYLE"

#. from libreoffice:swriter-librelogo
msgid "FILLSTYLE 0 ; fill without hatches (default)<br/> FILLSTYLE 1 ; black single hatches (horizontal)<br/> FILLSTYLE 2 ; black single hatches (45 degrees)<br/> FILLSTYLE 3 ; black single hatches (-45 degrees)<br/> FILLSTYLE 4 ; black single hatches (vertical)<br/> FILLSTYLE 5 ; red crossed hatches (45 degrees)<br/> FILLSTYLE 6 ; red crossed hatches (0 degrees)<br/> FILLSTYLE 7 ; blue crossed hatches (45 degrees)<br/> FILLSTYLE 8 ; blue crossed hatches (0 degrees)<br/> FILLSTYLE 9 ; blue triple crossed<br/> FILLSTYLE 10 ; black wide single hatches (45 degrees)<br/> <br/> ; custom hatches specified by a list with the following arguments:<br/> ; – style (1 = single, 2 = double, 3 = triple hatching)<br/> ; – color<br/> ; – distance<br/> ; – degree<br/> <br/> FILLSTYLE [2, “green”, 3pt, 15°] ; green crossed hatches (15 degrees)<br/>"
msgstr "FILLSTYLE 0 ; fyll utan skraffering (default)<br/> FILLSTYLE 1 ; enkel svart skraffering (horisontell)<br/> FILLSTYLE 2 ; enkel svart skraffering (45 grader)<br/> FILLSTYLE 3 ; enkel svart skraffering (-45 grader)<br/> FILLSTYLE 4 ; enkel svart skraffering (vertikal)<br/> FILLSTYLE 5 ; röd skraffering i kors (45 degrees)<br/> FILLSTYLE 6 ; röd skraffering i kors (0 grader)<br/> FILLSTYLE 7 ; blå skraffering i kors (45 degrees)<br/> FILLSTYLE 8 ; blå skraffering i kors (0 grader)<br/> FILLSTYLE 9 ; blå skraffering trippelkryssad<br/> FILLSTYLE 10 ; enkel svart skraffering (bred) (45 grader)<br/> <br/> ; anpassad skraffering anger en lista med följande argument:<br/> ; – style (1 = enkel, 2 = dubbel, 3 = trippel skraffering)<br/> ; – färg<br/> ; – avstånd<br/> ; – grader<br/> <br/> FILLSTYLE [2, “green”, 3pt, 15°] ; grön korsad skraffering (15 grader)<br/>"

#. from libreoffice:swriter-librelogo
msgid "CIRCLE"
msgstr "CIRCLE"

#. from libreoffice:swriter-librelogo
msgid "CIRCLE 100 ; draw a circle shape (diameter = 100pt)<br/>"
msgstr "CIRCLE 100 ; rita en cirkel (diameter = 100pt)<br/>"

#. from libreoffice:swriter-librelogo
msgid "ELLIPSE"
msgstr "ELLIPSE"

#. from libreoffice:swriter-librelogo
msgid "ELLIPSE [50, 100] ; draw an ellipse with 50 and 100 diameters<br/> ELLIPSE [50, 100, 2h, 12h] ; draw an elliptical sector (from 2h clock position to 12h)<br/> ELLIPSE [50, 100, 2h, 12h, 2]  ; draw an elliptical segment<br/> ELLIPSE [50, 100, 2h, 12h, 3]  ; draw an elliptical arc<br/>"
msgstr "ELLIPSE [50, 100] ; rita en ellips med 50pt samt 100pt i diameter<br/> ELLIPSE [50, 100, 2h, 12h] ; rita en elliptisk sektor (från positionen kl 2 till kl 12)<br/> ELLIPSE [50, 100, 2h, 12h, 2]  ; rita ett elliptiskt segment<br/> ELLIPSE [50, 100, 2h, 12h, 3]  ; rita en elliptisk båge<br/>"

#. from libreoffice:swriter-librelogo
msgid "SQUARE"
msgstr "SQUARE"

#. from libreoffice:swriter-librelogo
msgid "SQUARE 100 ; draw a square shape (size = 100pt)<br/>"
msgstr "SQUARE 100 ; rita en kvadrat (storlek = 100pt)<br/>"

#. from libreoffice:swriter-librelogo
msgid "RECTANGLE"
msgstr "RECTANGLE"

#. from libreoffice:swriter-librelogo
msgid "RECTANGLE [50, 100] ; draw a rectangle shape (50×100pt)<br/> RECTANGLE [50, 100, 10] ; draw a rectangle with rounded corners<br/>"
msgstr "REKTANGEL [50, 100] ; rita en rektangelform (50×100pt)<br/> REKTANGEL [50, 100, 10] ; rita en rektangel med avrundade hörn<br/>"

#. from libreoffice:swriter-librelogo
msgid "POINT"
msgstr "POINT"

#. from libreoffice:swriter-librelogo
msgid "POINT ; draw a point with size and color of the pen<br/>"
msgstr "POINT ; rita en punkt med pennans storlek och färg<br/>"

#. from libreoffice:swriter-librelogo
msgid "CLOSE can join the last points, FILL can fill the shape defined by points. For example, it’s easy to draw a “flat” star starting from its center:"
msgstr "STÄNG kan förbinda de sista punkterna, FYLL kan fylla formen definierad av punkter. Till exempel, det är enkelt att rita en \"platt\" stjärna som börjar från centrum:"

#. from libreoffice:swriter-librelogo
msgid "LABEL"
msgstr "LABEL"

#. from libreoffice:swriter-librelogo
msgid "LABEL “text” ; print text in the turtle position<br/> LABEL 'text' ; see above<br/> LABEL \"text ; see above (only for single words)<br/>"
msgstr "LABEL “text” ; skriver ut text vid sköldpaddans position<br/> LABEL 'text' ; se ovan<br/> LABEL \"text ; se ovan (endast för enstaka ord)<br/>"

#. from libreoffice:swriter-librelogo
msgid "CIRCLE 10 TEXT “text” ; set text of the actual drawing object<br/>"
msgstr "CIRCLE 10 TEXT “text” ; ange texten för det aktuella objektet<br/>"

#. from libreoffice:swriter-librelogo
msgid "Font settings"
msgstr "Teckensnittsinställningar"

#. from libreoffice:swriter-librelogo
msgid "FONTCOLOR/FONTCOLOUR"
msgstr "FONTCOLOR/FONTCOLOUR"

#. from libreoffice:swriter-librelogo
msgid "FONTCOLOR “green” ; set font color<br/>"
msgstr "FONTCOLOR “green” ; anger teckensnittsfärgen till grön<br/>"

#. from libreoffice:swriter-librelogo
msgid "FONTFAMILY"
msgstr "FONTFAMILY"

#. from libreoffice:swriter-librelogo
msgid "FONTFAMILY “Linux Libertine G” ; set font (family)<br/> FONTFAMILY “Linux Libertine G:smcp=1” ; set also font feature (small caps)<br/> FONTFAMILY “Linux Libertine G:smcp=1&onum=1” ; small caps + old figures<br/>"
msgstr "FONTFAMILY “Linux Libertine G” ; anger teckensnitt (-sfamilj)<br/> FONTFAMILY “Linux Libertine G:smcp=1” ; anger även teckensnittseffekt (små bokstäver)<br/> FONTFAMILY “Linux Libertine G:smcp=1&onum=1” ; små bokstäver + gammeldags stil<br/>"

#. from libreoffice:swriter-librelogo
msgid "FONTSIZE"
msgstr "FONTSIZE"

#. from libreoffice:swriter-librelogo
msgid "FONTSIZE 12 ; set 12pt<br/>"
msgstr "FONTSIZE 12 ; anger 12pt<br/>"

#. from libreoffice:swriter-librelogo
msgid "FONTWEIGHT"
msgstr "FONTWEIGHT"

#. from libreoffice:swriter-librelogo
msgid "FONTWEIGHT “bold” ; set bold font<br/> FONTWEIGHT “normal” ; set normal weight<br/>"
msgstr "FONTWEIGHT “bold” ; anger fet stil<br/> FONTWEIGHT “normal” ; anger normal teckentjocklek<br/>"

#. from libreoffice:swriter-librelogo
msgid "FONTSTYLE"
msgstr "FONTSTYLE"

#. from libreoffice:swriter-librelogo
msgid "FONTSTYLE “italic” ; set italic variant<br/> FONTSTYLE “normal” ; set normal variant<br/>"
msgstr "FONTSTYLE “italic” ; anger kursiv stil<br/> FONTSTYLE “normal” ; återställer kursiv stil till normal<br/>"

#. from libreoffice:swriter-librelogo
msgid "PICTURE (pic)"
msgstr "PICTURE (pic)"

#. from libreoffice:swriter-librelogo
msgid "PICTURE is for"
msgstr "PICTURE är till"

#. from libreoffice:swriter-librelogo
msgid "shape grouping;"
msgstr "gruppering av figurer;"

#. from libreoffice:swriter-librelogo
msgid "starting new line shapes;"
msgstr "börja på nya linjeformer;"

#. from libreoffice:swriter-librelogo
msgid "saving SVG images and SVG/SMIL animations;"
msgstr "sparar svg-bilder och svg-/smil-animationer;"

#. from libreoffice:swriter-librelogo
msgid "keeping the consistency of positions and line shapes at the left border."
msgstr "behåll konsekvens mellan linjefigurers position och den vänstra kanten."

#. from libreoffice:swriter-librelogo
msgid "Shape grouping"
msgstr "Gruppering av figurer"

#. from libreoffice:swriter-librelogo
msgid "; PICTURE [ LibreLogo_commands ]<br/> PICTURE [ FORWARD 100 CIRCLE 100 ] ; tree-like grouped shape<br/>"
msgstr "; PICTURE [ LibreLogo_kommandon]<br/> PICTURE [ FORWARD 100 CIRCLE 100 ] ; trädliknande grupperad figur<br/>"

#. from libreoffice:swriter-librelogo
msgid "Starting new line shapes"
msgstr "Att påbörja nya streckfigurer"

#. from libreoffice:swriter-librelogo
msgid "PICTURE ; start a new line shape<br/> FORWARD 10 PICTURE FORWARD 10 ; two line shapes<br/>"
msgstr "PICTURE ; påbörja en ny streckfigur<br/> FORWARD 10 PICTURE FORWARD 10 ; två streckfigurer<br/>"

#. from libreoffice:swriter-librelogo
msgid "Saving SVG images"
msgstr "Sparar svg-bilder"

#. from libreoffice:swriter-librelogo
msgid "PICTURE “example.svg” [ CIRCLE 5 ] ; save the picture as an SVG image file in the user folder<br/> PICTURE “Desktop/example.svg” [ FORWARD 100 CIRCLE 5 ] ; as above, with a relative path<br/> PICTURE “/home/user/example.svg” [ CIRCLE 5 ] ; absolute path for Unix/Linux<br/> PICTURE “C:\\example.svg” [ CIRCLE 5 ] ; absolute path for Windows<br/>"
msgstr "PICTURE “example.svg” [ CIRCLE 5 ] ; spara bilden som en SVG-bildfil i användarmappen<br/> PICTURE “Desktop/example.svg” [ FORWARD 100 CIRCLE 5 ] ; som ovan, med en relativ sökväg<br/> PICTURE “/home/user/example.svg” [ CIRCLE 5 ]; absolut sökväg för Unix/Linux <br/> PICTURE “C:\\example.svg” [ CIRCLE 5 ] ; absolut sökväg för Windows<br/>"

#. from libreoffice:swriter-librelogo
msgid "Saving SVG/SMIL animations (drawings with SLEEP commands)"
msgstr "Sparar svg-/smil-animationer (teckningar med SLEEP-kommandon)"

#. from libreoffice:swriter-librelogo
msgid "PICTURE “animation.svg” [ CIRCLE 5 SLEEP 1000 CIRCLE 99 ] ; save as an SVG/SMIL animation (see also SLEEP)<br/> PICTURE “animation2.svg” [ CIRCLE 5 SLEEP 1000 CIRCLE 99 SLEEP 2000 ] ; as above, but using SLEEP after the last object will result looping: after 2 seconds the SVG animation restarts in SMIL-conformant browsers"
msgstr "PICTURE “animation.svg” [ CIRCLE 5 SLEEP 1000 CIRCLE 99 ] ; spara som en svg-/smil-animation (se även SLEEP)<br/> PICTURE “animation2.svg” [ CIRCLE 5 SLEEP 1000 CIRCLE 99 SLEEP 2000 ] ; som ovan, men med SLEEP efter sista objektet vilket resulterar i en loop: efter 2 sekunder så startas svg-animationen om i webbläsare som stöder smil."

#. from libreoffice:swriter-librelogo
msgid "Consistency at the left border"
msgstr "Konsekvent vid vänster kant"

#. from libreoffice:swriter-librelogo
msgid "Use PICTURE to keep the consistency of positions and line shapes at the left border of Writer:"
msgstr "Använd BILD för att behålla linjefigurers placering konsekvent vid vänsterkanten av Writer:"

#. from libreoffice:swriter-librelogo
msgid "PICTURE [ CIRCLE 20 POSITION [-100, 100] CIRCLE 20 ]<br/>"
msgstr "PICTURE [ CIRCLE 20 POSITION [-100, 100] CIRCLE 20 ]<br/>"

#. from libreoffice:swriter-librelogo
msgid "REPEAT"
msgstr "REPEAT"

#. from libreoffice:swriter-librelogo
msgid "; REPEAT number [ commands ]<br/> <br/> REPEAT 10 [ FORWARD 10 LEFT 45 CIRCLE 10 ] ; repeat 10 times<br/>"
msgstr "; REPEAT antal [ kommandon]<br/> <br/> REPEAT 10 [ FORWARD 10 LEFT 45 CIRCLE 10 ] ; upprepa 10 gånger<br/>"

#. from libreoffice:swriter-librelogo
msgid "; number is optional<br/> <br/> REPEAT [ POSITION ANY ] ; endless loop<br/>"
msgstr "; antal är valfritt<br/> <br/> REPEAT [ POSITION ANY ] ; oändlig loop<br/>"

#. from libreoffice:swriter-librelogo
msgid "REPCOUNT"
msgstr "REPCOUNT"

#. from libreoffice:swriter-librelogo
msgid "Loop variable (also in the FOR and WHILE loops)."
msgstr "Loopvariabel (även i FOR- och WHILE-loopar)."

#. from libreoffice:swriter-librelogo
msgid "REPEAT 100 [ FORWARD REPCOUNT LEFT 90 ]<br/>"
msgstr "REPEAT 100 [ FORWARD REPCOUNT LEFT 90 ]<br/>"

#. from libreoffice:swriter-librelogo
msgid "FOR IN"
msgstr "FOR IN"

#. from libreoffice:swriter-librelogo
msgid "Loop for the list elements:"
msgstr "Loop för listposterna:"

#. from libreoffice:swriter-librelogo
msgid "FOR i IN [1, 5, 7, 9, 11] [<br/>   FORWARD i<br/>   LEFT 90<br/> ]<br/>"
msgstr "FOR i IN [1, 5, 7, 9, 11] [<br/>   FORWARD i<br/>   LEFT 90<br/> ]<br/>"

#. from libreoffice:swriter-librelogo
msgid "Loop for the characters of a character sequence:"
msgstr "En slinga (loop) för alla tecken i en teckensekvens:"

#. from libreoffice:swriter-librelogo
msgid "FOR i IN “text” [<br/>   LABEL i<br/>   FORWARD 10<br/> ]<br/>"
msgstr "FOR i IN “text” [<br/>   LABEL i<br/>   FORWARD 10<br/> ]<br/>"

#. from libreoffice:swriter-librelogo
msgid "WHILE"
msgstr "WHILE"

#. from libreoffice:swriter-librelogo
msgid "WHILE TRUE [ POSITION ANY ] ; endless loop<br/> WHILE REPCOUNT <= 10 [ FORWARD 50 LEFT 36 ] ; as REPEAT 10 [ ... ]<br/>"
msgstr "WHILE TRUE [ POSITION ANY ] ; oändlig loop<br/> WHILE REPCOUNT <= 10 [ FORWARD 50 LEFT 36 ] ; as REPEAT 10 [ ... ]<br/>"

#. from libreoffice:swriter-librelogo
msgid "BREAK"
msgstr "BREAK"

#. from libreoffice:swriter-librelogo
msgid "Stop the loop."
msgstr "Avbryt loopen."

#. from libreoffice:swriter-librelogo
msgid "REPEAT [ ; endless loop<br/>   POSITION ANY<br/>   IF REPCOUNT = 100 [ BREAK ]  ; equivalent of the REPEAT 100 [ ... ]<br/> ]<br/>"
msgstr "REPEAT [ ; oändlig loop<br/>   POSITION ANY<br/>   IF REPCOUNT = 100 [ BREAK ]  ; motsvarigheten för REPEAT 100 [ ... ]<br/> ]<br/>"

#. from libreoffice:swriter-librelogo
msgid "CONTINUE"
msgstr "CONTINUE"

#. from libreoffice:swriter-librelogo
msgid "Jump into the next iteration of the loop."
msgstr "Hoppa till nästa steg i loopen."

#. from libreoffice:swriter-librelogo
msgid "REPEAT 100 [<br/>   POSITION ANY<br/>   IF REPCOUNT % 2 = 0 [ CONTINUE ]<br/>   CIRCLE 10 ; draw circles on every 2nd positions<br/> ]<br/>"
msgstr "REPEAT 100 [<br/>  POSITION ANY<br/>  IF REPCOUNT % 2 = 0 [ CONTINUE ]<br/>  CIRCLE 10 ; rita cirklar på varannan position<br/> ]<br/>"

#. from libreoffice:swriter-librelogo
msgid "; IF condition [ true block ]<br/> ; IF condition [ true block ] [ false block ]<br/> <br/> IF a < 10 [ PRINT “Small” ]<br/> IF a < 10 [ PRINT “Small” ] [ PRINT “Big” ]<br/>"
msgstr "; IF villkor [ sant block ]<br/> ; IF villkor[ sant block ] [ falskt block ]<br/> <br/> IF a < 10 [ PRINT “Small” ]<br/> IF a < 10 [ PRINT “Small” ] [ PRINT “Big” ]<br/>"

#. from libreoffice:swriter-librelogo
msgid "AND, OR, NOT"
msgstr "AND, OR, NOT"

#. from libreoffice:swriter-librelogo
msgid "Logical operators."
msgstr "Logiska operatorer"

#. from libreoffice:swriter-librelogo
msgid "IF a < 10 AND NOT a = 5 [ PRINT “0, 1, 2, 3, 4, 6, 7, 8 or 9” ]<br/> IF a < 10 AND a != 5 [ PRINT “0, 1, 2, 3, 4, 6, 7, 8 or 9” ] ; as above<br/>"
msgstr "IF a < 10 AND NOT a = 5 [ PRINT “0, 1, 2, 3, 4, 6, 7, 8 or 9” ]<br/> IF a < 10 AND a != 5 [ PRINT “0, 1, 2, 3, 4, 6, 7, 8 or 9\" ] ; som ovan<br/>"

#. from libreoffice:swriter-librelogo
msgid "Subroutines"
msgstr "Subrutiner"

#. from libreoffice:swriter-librelogo
msgid "TO, END"
msgstr "TO, END"

#. from libreoffice:swriter-librelogo
msgid "New word (or procedure)."
msgstr "Nytt ord (eller procedur)."

#. from libreoffice:swriter-librelogo
msgid "OUTPUT"
msgstr "OUTPUT"

#. from libreoffice:swriter-librelogo
msgid "Return value of the function."
msgstr "Returvärde från funktionen."

#. from libreoffice:swriter-librelogo
msgid "TO randomletter<br/>   OUTPUT RANDOM “qwertzuiopasdfghjklyxcvbnm”<br/> END<br/> <br/> PRINT randomletter + randomletter + randomletter ; print 3-letter random character sequence<br/>"
msgstr "TO randomletter<br/>   OUTPUT RANDOM “qwertzuiopasdfghjklyxcvbnm”<br/> END<br/> <br/> PRINT randomletter + randomletter + randomletter ; skriver ut 3 slumpmässigt valda tecken<br/>"

#. from libreoffice:swriter-librelogo
msgid "STOP"
msgstr "STOP"

#. from libreoffice:swriter-librelogo
msgid "Return from the procedure."
msgstr "Avslutar process."

#. from libreoffice:swriter-librelogo
msgid "TO example number<br/>   IF number < 0 [ STOP ]<br/>   PRINT SQRT number ; print square root<br/> ]<br/> <br/> example 100<br/> example -1 ; without output and error<br/> example 25<br/>"
msgstr "TO example number<br/>   IF number < 0 [ STOP ]<br/>   PRINT SQRT number ; skriver ut kvadratroten<br/> ]<br/> <br/> example 100<br/> example -1 ; utan utdata och fel<br/> example 25<br/>"

#. from libreoffice:swriter-librelogo
msgid "Default variables"
msgstr "Standardvariabler"

#. from libreoffice:swriter-librelogo
msgid "ANY"
msgstr "ANY"

#. from libreoffice:swriter-librelogo
msgid "Default random value of colors, etc."
msgstr "Standard slumpmässiga färgvärden etc."

#. from libreoffice:swriter-librelogo
msgid "PENCOLOR ANY ; random pen color<br/>"
msgstr "PENCOLOR ANY ; slumpmässig pennfärg<br/>"

#. from libreoffice:swriter-librelogo
msgid "WHILE TRUE [ POSITION ANY ] ; endless loop<br/> PRINT TRUE ; print true<br/>"
msgstr "WHILE TRUE [ POSITION ANY ] ; ändlös loop<br/> PRINT TRUE ; skriver ut true<br/>"

#. from libreoffice:swriter-librelogo
msgid "Logical value."
msgstr "Logiskt värde."

#. from libreoffice:swriter-librelogo
msgid "WHILE NOT FALSE [ POSITION ANY ] ; endless loop<br/> PRINT FALSE ; print false<br/>"
msgstr "WHILE NOT FALSE [ POSITION ANY ] ; ändlös loop<br/> PRINT FALSE ; skriver ut false<br/>"

#. from libreoffice:swriter-librelogo
msgid "PAGESIZE"
msgstr "PAGESIZE"

#. from libreoffice:swriter-librelogo
msgid "PRINT PAGESIZE ; print list of the page sizes in points, eg. [595.30, 841.89]<br/>"
msgstr "PRINT PAGESIZE ; skriver ut pappersstorlekar i punkter, t.ex. [595.30, 841.89]<br/>"

#. from libreoffice:swriter-librelogo
msgid "PI/π"
msgstr "PI/π"

#. from libreoffice:swriter-librelogo
msgid "PRINT PI ; print 3.14159265359<br/>"
msgstr "PRINT PI ; skriver ut 3.14159265359<br/>"

#. from libreoffice:swriter-librelogo
msgid "Input/Output"
msgstr "Input/Output"

#. from libreoffice:swriter-librelogo
msgid "PRINT"
msgstr "PRINT"

#. from libreoffice:swriter-librelogo
msgid "PRINT “text” ; print “text” in a dialog box<br/> PRINT 5 + 10 ; print 15<br/>"
msgstr "PRINT “text” ; skriver ut “text” i en dialogruta<br/> PRINT 5 + 10 ; skriver ut 15<br/>"

#. from libreoffice:swriter-librelogo
msgid "INPUT"
msgstr "INPUT"

#. from libreoffice:swriter-librelogo
msgid "PRINT INPUT “Input value?” ; ask and print a string by a query dialog box<br/> PRINT FLOAT (INPUT “First number?”) + FLOAT (INPUT “Second number?”) ; simple calculator<br/>"
msgstr "PRINT INPUT “Inmatningsvärde?” ; frågar efter och skriver ut en sträng via en frågedialog<br/> PRINT FLOAT (INPUT “Första numret?”) + FLOAT (INPUT “Andra numret?”) ; enkel kalkylator som adderar två värden<br/>"

#. from libreoffice:swriter-librelogo
msgid "SLEEP"
msgstr "SLEEP"

#. from libreoffice:swriter-librelogo
msgid "SLEEP 1000 ; wait for 1000 ms (1 sec)<br/>"
msgstr "SLEEP 1000 ; vänta i 1000 ms (1 sekund)<br/>"

#. from libreoffice:swriter-librelogo
msgid "GLOBAL"
msgstr "GLOBAL"

#. from libreoffice:swriter-librelogo
msgid "Set global variables used in procedures."
msgstr "Anger globala variabler som används i procedurer."

#. from libreoffice:swriter-librelogo
msgid "GLOBAL about<br/> about = “LibreLogo”<br/> <br/> TO example<br/>   PRINT about<br/>   GLOBAL about ; when we want to add a new value<br/>   about = “new value for the global variable”<br/> END<br/> <br/> example<br/> PRINT about<br/>"
msgstr "GLOBAL about<br/> about = “LibreLogo”<br/> <br/> TO example<br/>   PRINT about<br/>   GLOBAL about ; när vi vill lägga till ett nytt värde<br/>   about = “nytt värde för den globala variabeln”<br/> END<br/> <br/> example<br/> PRINT about<br/>"

#. from libreoffice:swriter-librelogo
msgid "RANDOM"
msgstr "RANDOM"

#. from libreoffice:swriter-librelogo
msgid "PRINT RANDOM 100 ; random float number (0 <= x < 100)<br/> PRINT RANDOM “text” ; random letter of the “text”<br/> PRINT RANDOM [1, 2] ; random list element (1 or 2)<br/>"
msgstr "PRINT RANDOM 100 ; slumpmässigt flyttal (0 <= x < 100)<br/> PRINT RANDOM “text” ; slumpmässigt tecken från \"text\"<br/> PRINT RANDOM [1, 2] ; slumpmässig post från listan (1 eller 2)<br/>"

#. from libreoffice:swriter-librelogo
msgid "PRINT INT 3.8 ; print 3 (integer part of 3.8)<br/> PRINT INT RANDOM 100 ; random integer number (0 <= x < 100)<br/> PRINT INT “7” ; convert the string parameter to integer<br/>"
msgstr "PRINT INT 3.8 ; skriver ut 3 (heltalsdelen (integer-delen) av 3.8)<br/> PRINT INT RANDOM 100 ; slumpmässigt heltal (0 <= x < 100)<br/> PRINT INT “7” ; konverterar en strängparameter till ett heltal (en integer)<br/>"

#. from libreoffice:swriter-librelogo
msgid "FLOAT"
msgstr "FLOAT"

#. from libreoffice:swriter-librelogo
msgid "; convert the string parameter to float number<br/> PRINT 2 * FLOAT “5.5” ; print 11.0<br/>"
msgstr "; konverterar strängparametern till ett flyttal<br/> PRINT 2 * FLOAT \"5.5\" ; skriver ut 11.0<br/>"

#. from libreoffice:swriter-librelogo
msgid "STR"
msgstr "STR"

#. from libreoffice:swriter-librelogo
msgid "; convert the number parameter to string<br/> PRINT “Result: ” + STR 5 ; print “Result: 5”<br/> PRINT 10 * STR 5 ; print 5555555555<br/>"
msgstr "; konverterar den numeriska parametern till en sträng<br/> PRINT “Resultat: ” + STR 5 ; skriver ut “Resultat: 5”<br/> PRINT 10 * STR 5 ; skriver ut 5555555555<br/>"

#. from libreoffice:swriter-librelogo
msgid "PRINT SQRT 100 ; print 10, square root of 100<br/>"
msgstr "PRINT SQRT 100 ; skriver ut 10, kvadratroten av 100<br/>"

#. from libreoffice:swriter-librelogo
msgid "PRINT SIN 90 * PI/180 ; print 1.0 (sinus of 90° in radians)<br/>"
msgstr "PRINT SIN 90 * PI/180 ; skriver ut 1.0 (sinus av 90° i radianer)<br/>"

#. from libreoffice:swriter-librelogo
msgid "PRINT COS 0 * PI/180 ; print 1.0 (cosinus of 0° in radians)<br/>"
msgstr "PRINT COS 0 * PI/180 ; skriver ut 1.0 (cosinus av 0° i radianer)<br/>"

#. from libreoffice:swriter-librelogo
msgid "PRINT LOG10 100 ; print 2.0 (common logarithm of 100)<br/>"
msgstr "PRINT LOG10 100 ; skriv ut 2.0 (logaritmen av 100)<br/>"

#. from libreoffice:swriter-librelogo
msgid "PRINT ROUND 3.8 ; print 4 (rounding 3.8)<br/> PRINT ROUND RANDOM 100 ; random integer number (0 <= x <= 100)<br/>"
msgstr "PRINT ROUND 3.8 ; skriver ut 4 (avrundar 3.8)<br/> PRINT ROUND RANDOM 100 ; slumpmässigt heltal (0 <= x <= 100)<br/>"

#. from libreoffice:swriter-librelogo
msgid "PRINT ABS -10 ; print 10, absolute value of -10<br/>"
msgstr "PRINT ABS -10 ; skriver ut 10, det absoluta värdet av -10<br/>"

#. from libreoffice:swriter-librelogo
msgid "PRINT COUNT “text” ; print 4, character count of “text”<br/> PRINT COUNT [1, 2, 3] ; print 3, size of the list<br/>"
msgstr "PRINT COUNT “text” ; skriver ut 4, det antal tecken som strängen “text” innehåller<br/> PRINT COUNT [1, 2, 3] ; skriver ut 3, listans storlek<br/>"

#. from libreoffice:swriter-librelogo
msgid "SET"
msgstr "SET"

#. from libreoffice:swriter-librelogo
msgid "; Convert list to Python set<br/> PRINT SET [4, 5, 6, 6] ; print {4, 5, 6}<br/> PRINT SET [4, 5, 6, 6] | SET [4, 1, 9] ; print {1, 4, 5, 6, 9}, union<br/> PRINT SET [4, 5, 6, 6] & SET [4, 1, 9] ; print {4}, intersection<br/> PRINT SET ([4, 5, 6, 6]) - SET [4, 1, 9] ; print {5, 6}, difference<br/> PRINT SET [4, 5, 6, 6] ^ SET [4, 1, 9] ; print {1, 5, 6, 9}, symmetric difference  <br/>"
msgstr "; konverterar listan till ett Python-set<br/> PRINT SET [4, 5, 6, 6] ; skriver ut {4, 5, 6}<br/> PRINT SET [4, 5, 6, 6] | SET [4, 1, 9] ; skriver ut {1, 4, 5, 6, 9}, union<br/> PRINT SET [4, 5, 6, 6] & SET [4, 1, 9] ; skriver ut {4}, skärningspunkten<br/> PRINT SET ([4, 5, 6, 6]) - SET [4, 1, 9] ; skriver ut {5, 6}, differensen<br/> PRINT SET [4, 5, 6, 6] ^ SET [4, 1, 9] ; skriver ut {1, 5, 6, 9}, symmetriska differensen  <br/>"

#. from libreoffice:swriter-librelogo
msgid "RANGE"
msgstr "RANGE"

#. from libreoffice:swriter-librelogo
msgid "LIST"
msgstr "LIST"

#. from libreoffice:swriter-librelogo
msgid "; remove the repeating elements of a list using set and list conversion<br/> PRINT LIST (SET [1, 3, 5, 5, 2, 1]) ; print [1, 3, 5, 2]<br/>"
msgstr "; tar bort upprepade poster från en lista med set och listkonvertering<br/> PRINT LIST (SET [1, 3, 5, 5, 2, 1]) ; skriver ut [1, 3, 5, 2]<br/>"

#. from libreoffice:swriter-librelogo
msgid "TUPLE"
msgstr "TUPLE"

#. from libreoffice:swriter-librelogo
msgid "Conversion to Python tuple (non-modifiable list)"
msgstr "Konverterar till en Python tuple (lista som inte går att ändra)"

#. from libreoffice:swriter-librelogo
msgid "PRINT TUPLE [4, 5]<br/>"
msgstr "PRINT TUPLE [4, 5]<br/>"

#. from libreoffice:swriter-librelogo
msgid "SORTED"
msgstr "SORTED"

#. from libreoffice:swriter-librelogo
msgid "It returns with a sorted list."
msgstr "Returnerar en sorterad lista."

#. from libreoffice:swriter-librelogo
msgid "PRINT SORTED [5, 1, 3, 4] ; print [1, 3, 4, 5]<br/>"
msgstr "PRINT SORTED [5, 1, 3, 4]; skriver ut [1, 3, 4, 5]<br/>"

#. from libreoffice:swriter-librelogo
msgid "SUB"
msgstr "SUB"

#. from libreoffice:swriter-librelogo
msgid "Substitute character sequences using regex (regular expression) patterns."
msgstr "Ersätter teckensekvenser med hjälp av regex-mönster (reguljära uttryck)."

#. from libreoffice:swriter-librelogo
msgid "PRINT SUB (“t”, “T”, “text”) ; print “Text”, replacing “t” with “T”<br/> PRINT SUB (“(.)”, “\\\\1\\\\1”, “text”) ; print “tteexxtt”, doubling every characters<br/>"
msgstr "PRINT SUB(\"t\", \"T\", \"text\"); skriver ut \"Text\", ersätter \"t\" med \"T\"<br/>PRINT SUB(\"(.)\", \"\\\\1\\\\1\", \"text\"; skriver ut \"tteexxtt\", dubblerar alla tecken<br/>"

#. from libreoffice:swriter-librelogo
msgid "Search character sequences patterns using regex patterns."
msgstr "Söker efter teckensekvenser med hjälp av reguljära uttryck."

#. from libreoffice:swriter-librelogo
msgid "FINDALL"
msgstr "FINDALL"

#. from libreoffice:swriter-librelogo
msgid "Find all character sequences in the input string matching the given regex pattern."
msgstr "Hittar alla teckensekvenser i en sträng som matchar ett givet reguljärt uttryck."

#. from libreoffice:swriter-librelogo
msgid "PRINT FINDALL(“\\w+”, “Dogs, cats.”) ; print [“Dogs”, “cats”], the list of the words.<br/>"
msgstr "PRINT FINDALL(\"\\w+\",\"Hundar,  katter.\"); skriver ut \"Hundar\", \"katter\"], listan med ord.<br/>"

#. from libreoffice:swriter-librelogo
msgid "PRINT MIN [1, 2, 3] ; print 1, the lowest element of the list<br/>"
msgstr "PRINT MIN [1, 2, 3]; skriver ut 1, listans minsta element<br/>"

#. from libreoffice:swriter-librelogo
msgid "PRINT MAX [1, 2, 3] ; print 3, the greatest element of the list<br/>"
msgstr "PRINT MAX [1, 2, 3]; skriver ut 3, det största elementet i listan<br/>"

#. from libreoffice:swriter-librelogo
msgid "Color constants"
msgstr "Färgkonstanter"

#. from libreoffice:swriter-librelogo
msgid "PENCOLOR “SILVER” ; set by name<br/> PENCOLOR [1] ; set by identifiers<br/> PENCOLOR “~SILVER” ; random silver color<br/> <br/>"
msgstr "PENCOLOR \"SILVER\"; välj färg via namn<br/>PENCOLOR[1], väljer färg via identifierare<br/>PENCOLOR \"~SILVER\"; slumpmässig silverfärg<br/><br/>"

