msgstr "<variable id=\"keyboard\"><link href=\"text/swriter/guide/keyboard.xhp\">Använda kortkommandon (tillgänglighet för $[officename] Writer)</link></variable>"

#. from libreoffice:swriter-guide
msgid "To open a context menu, press Shift+F10. To close a context menu, press Escape."
msgstr "Om du vill öppna en snabbmeny trycker du på Skift+F10. Om du vill stänga en snabbmeny trycker du på Esc."

#. from libreoffice:swriter-guide
msgid "To Insert Sections"
msgstr "Så här infogar du avsnitt"

#. from libreoffice:swriter-guide
msgid "Choose <emph>View - Toolbars - Insert</emph> to open the <emph>Insert</emph> toolbar."
msgstr "Välj <emph>Visa - Verktygsrader - Infoga</emph> om du vill öppna verktygsraden <emph>Infoga</emph>."

#. from libreoffice:swriter-guide
msgid "Press F6 until the focus is on the               <item type=\"menuitem\">Insert</item> toolbar."
msgstr "Tryck på F6 tills verktygsraden               <item type=\"menuitem\">Infoga</item> markeras."

#. from libreoffice:swriter-guide
msgid "Press the right arrow key until the <emph>Section</emph> icon is selected."
msgstr "Tryck på högerpiltangenten tills ikonen <emph>Område</emph> markeras."

#. from libreoffice:swriter-guide
msgid "Press the down arrow key, and then press the right arrow key to set the width of the section that you want to insert."
msgstr "Tryck på nedåtpiltangenten och ange bredden på området som du vill infoga genom att trycka på högerpilen."

#. from libreoffice:swriter-guide
msgid "To Insert Text Tables"
msgstr "Så här infogar du texttabeller"

#. from libreoffice:swriter-guide
msgid "Press F6 until the focus is on the               <item type=\"menuitem\">Standard</item> toolbar."
msgstr "Tryck på F6 tills verktygsraden               <item type=\"menuitem\">Standard</item> markeras."

#. from libreoffice:swriter-guide
msgid "Press the right arrow key until the <emph>Table</emph> icon is selected."
msgstr "Tryck på högerpiltangenten tills ikonen <emph>Tabell</emph> markeras."

#. from libreoffice:swriter-guide
msgid "Press the down arrow key, and then use the arrow keys to select the number of columns and rows to include in the table."
msgstr "Tryck på nedåtpiltangenten och markera antalet kolumner och rader som tabellen ska innehålla genom att använda piltangenterna."

#. from libreoffice:swriter-guide
msgid "Press F6 to place the cursor inside the document."
msgstr "Tryck på F6 så att markören placeras i dokumentet."

#. from libreoffice:swriter-guide
msgid "Using Styles From Another Document or Template"
msgstr "Använda formatmallar från andra dokument eller dokumentmallar"

#. from libreoffice:swriter-guide
msgid "<variable id=\"load_styles\"><link href=\"text/swriter/guide/load_styles.xhp\">Using Styles From Another Document or Template</link></variable>"
msgstr "<variable id=\"load_styles\"><link href=\"text/swriter/guide/load_styles.xhp\">Använda formatmallar från andra dokument eller dokumentmallar</link></variable>"

#. from libreoffice:swriter-guide
msgid "You can import styles from another document or template into the current document."
msgstr "Du kan importera formatmallar från ett annat dokument eller en dokumentmall till det aktuella dokumentet."

#. from libreoffice:swriter-guide
msgid "Use the check boxes at the bottom of the dialog to select the style types that you want to import. To replace styles in the current document that have the same name as the ones you are importing, select <emph>Overwrite</emph>."
msgstr "Använd kryssrutorna nedtill i dialogrutan för att välja de formatmallstyper som du vill importera. Du kan ersätta formatmallar i det aktuella dokumentet som har samma namn som de du importerar genom att välja <emph>Skriv över</emph>."

#. from libreoffice:swriter-guide
msgid "Click an entry in the <emph>Categories</emph> list, then click the template containing the styles that you want to use in the <emph>Templates</emph> list, and then click <emph>OK</emph>."
msgstr "Markera ett val i listan <emph>Kategorier</emph>, klicka sidan på den mall som innehåller de formatmallar som du vill använda i listan med <emph>Mallar</emph> avsluta med att klicka på <emph>OK</emph>."

#. from libreoffice:swriter-guide
msgid "Click <emph>From File</emph>, locate the file containing the styles that you want to use, and then click name, and then click <emph>Open</emph>."
msgstr "Klicka på <emph>Från fil</emph>, leta rätt på filen du vill använda som formatförlaga och klicka på <emph>Öppna</emph>."

