msgstr "<variable id=\"viewing_file_properties\"><variable id=\"viewing\"><link href=\"text/shared/guide/viewing_file_properties.xhp\">Visa filegenskaper</link></variable></variable>"

#. from libreoffice:shared-guide
msgid "File properties, such as author name, subject, and keywords, help you manage and identify your documents. $[officename] also tracks file statistics, including the number of words and the number of pages in a document, and automatically adds the statistics as part of the file property."
msgstr "Genom att använda filegenskaper, t.ex. författarnamn, ämne och nyckelord, kan du hantera och identifiera dokumenten. I $[officename] kan du också föra filstatistik, t.ex. antalet ord och sidor i ett dokument och automatiskt lägga till statistiken som en del av filegenskaperna."

#. from libreoffice:shared-guide
msgid "To view file properties for the current document:"
msgstr "Så här visar du filegenskaperna för det aktuella dokumentet."

#. from libreoffice:shared-guide
msgid "Choose <emph>File - Properties</emph>."
msgstr "Välj <emph>Arkiv - Egenskaper</emph>."

