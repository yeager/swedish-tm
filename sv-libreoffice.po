msgid "Paragraph end _zone:"
msgstr "Styckets slut_zon:"

#. from libreoffice:cui-messages
msgid "Column end _zone:"
msgstr "Kolumnens slut_zon:"

#. from libreoffice:cui-messages
msgid "Page end _zone:"
msgstr "Sidans slut_zone:"

#. from libreoffice:cui-messages
msgid "Spread end _zone:"
msgstr "Uppslagets slut_zon:"

#. from libreoffice:cui-messages
msgid "Move Line"
msgstr "Flytta rad"

#. from libreoffice:cui-messages
msgid "Deselect this check box, if you don't want to move the entire hyphenated line to the next text block."
msgstr "Avmarkera den här kryssrutan om du inte vill flytta hela avstavningsraden till nästa textblock."

#. from libreoffice:cui-messages
msgid "Hyphenation across"
msgstr "Avstavning över"

#. from libreoffice:cui-messages
msgid "_Insert"
msgstr "_Infoga"

#. from libreoffice:cui-messages
msgid "Select this check box, and then select the break type that you want to use."
msgstr "Markera den här kryssrutan och välj vilken typ av brytningar som du vill använda."

#. from libreoffice:cui-messages
msgid "With page st_yle:"
msgstr "Med sidformatma_ll:"

#. from libreoffice:cui-messages
msgid "Select this check box, and then select the page style that you want to use for the first page after the break."
msgstr "Markera den här kryssrutan och välj sedan den sidformatmall som du vill använda för den första sidan efter brytningen."

#. from libreoffice:cui-messages
msgid "_Type:"
msgstr "Typ:"

#. from libreoffice:cui-messages
msgid "Enter the page number for the first page that follows the break. If you want to continue the current page numbering, leave the checkbox unchecked."
msgstr "Ange sidnumret för den första sidan som följer efter brytningen. Om du vill fortsätta med den aktuella sidnumreringen lämnar du kryssrutan omarkerad."

#. from libreoffice:cui-messages
msgid "Page _number:"
msgstr "S_idnummer:"

#. from libreoffice:cui-messages
msgid "Assigns the page number that you specify to the page that follows the manual page break. This option is only available if you assign an arbitrary page style to the page that follows manual page break."
msgstr "Tilldelar det sidnummer du anger till sidan som följer den manuella sidbrytningen. Det här alternativet är bara tillgängligt om du tilldelar en godtycklig sidstil till sidan som följer den manuella sidbrytningen."

#. from libreoffice:cui-messages
msgid "Position:"
msgstr "Placering:"

#. from libreoffice:cui-messages
msgid "Select the formatting style to use for the first page after the break."
msgstr "Välj den formatmall som ska användas på den första sidan efter brytningen."

#. from libreoffice:cui-messages
msgid "Select the break type that you want to insert."
msgstr "Välj den typ av brytning som du ska infoga."

#. from libreoffice:cui-messages
msgid "Select where you want to insert the break."
msgstr "Välj var brytningen ska infogas."

#. from libreoffice:cui-messages
msgid "Breaks"
msgstr "Brytningar"

#. from libreoffice:cui-messages
msgid "_Allow to split paragraph"
msgstr "_Tillåt att dela stycke"

#. from libreoffice:cui-messages
msgid "Shifts the entire paragraph to the next page or column after a break is inserted."
msgstr "Flyttar hela stycket till nästa sida eller kolumn när en brytning infogas."

#. from libreoffice:cui-messages
msgid "_Keep with next paragraph"
msgstr "Håll ih_op med följande stycke"

#. from libreoffice:cui-messages
msgid "Keeps the current paragraph and the following paragraph together when a break or column break is inserted."
msgstr "Håller ihop det aktuella stycket med nästa stycke när en sid- eller kolumnbrytning infogas."

#. from libreoffice:cui-messages
msgid "Don’t split at _beginning of paragraph"
msgstr "Dela inte upp i _början av stycket"

#. from libreoffice:cui-messages
msgid "Minimum number of lines in a paragraph before a page break."
msgstr "Minsta antal rader i ett stycke före en sidbrytning."

#. from libreoffice:cui-messages
msgid "Don’t split at _end of paragraph"
msgstr "Dela inte upp i _slutet av stycket"

#. from libreoffice:cui-messages
msgid "Minimum number of lines in a paragraph in the first page after the break."
msgstr "Minsta antal rader i ett stycke på den första sidan efter radbrytningen."

#. from libreoffice:cui-messages
msgid "Specifies the minimum number of lines in a paragraph before a page break. Select this check box, and then enter a number in the Lines box."
msgstr "Anger det minsta antalet rader i ett stycke innan en sidbrytning. Markera den här kryssrutan och ange ett antal i rutan Rader."

#. from libreoffice:cui-messages
msgid "Specifies the minimum number of lines in a paragraph in the first page after the break. Select this check box, and then enter a number in the Lines box."
msgstr "Anger det minsta antalet rader i ett stycke på den första sidan efter brytningen. Markera den här kryssrutan och ange ett antal i rutan Rader."

#. from libreoffice:cui-messages
msgid "lines"
msgstr "rader"

#. from libreoffice:cui-messages
msgid "Split Options"
msgstr "Delningsalternativ"

#. from libreoffice:cui-messages
msgid "Specify hyphenation and pagination options."
msgstr "Ange inställningar för avstavning och sidbrytningar."

#. from libreoffice:cui-messages
msgid "Thesaurus"
msgstr "Synonymordlista"

#. from libreoffice:cui-messages
msgid "_Replace"
msgstr "_Ersätt"

#. from libreoffice:cui-messages
msgid "Current word:"
msgstr "Aktuellt ord:"

#. from libreoffice:cui-messages
msgid "Alternatives:"
msgstr "Alternativ:"

#. from libreoffice:cui-messages
msgid "Replace with:"
msgstr "Ersätt med:"

#. from libreoffice:cui-messages
msgid "The word or words in the \"Replace with\" text box will replace the original word in the document when you click the Replace button. You can also type text directly in this box."
msgstr "Ordet eller orden i textrutan \"Ersätt med\" ersätter det ursprungliga ordet i dokumentet när du klickar på knappen Ersätt. Du kan också skriva in text direkt i den här rutan."

#. from libreoffice:cui-messages
msgid "Recalls the previous contents of the \"Current word\" text box."
msgstr "Återskapar tidigare innehåll i textrutan \"Aktuellt ord\"."

#. from libreoffice:cui-messages
msgid "Select a language for the thesaurus."
msgstr "Välj ett språk för synonymordlistan."

#. from libreoffice:cui-messages
msgid "Displays the current word, or the related term that you selected by double-clicking a line in the Alternatives list. You can also type text directly in this box to look up your text."
msgstr "Visar det aktuella ordet, eller en närliggande term som du har valt genom att dubbelklicka på en rad i listan Alternativ. Du kan skriva text som du vill söka efter direkt i den här rutan."

#. from libreoffice:cui-messages
msgid "Click an entry in the Alternatives list to copy the related term to the \"Replace with\" text box. Double-click an entry to copy the related term to the \"Current word\" text box and to look up that term."
msgstr "Klicka på en post i listan Alternativ för att kopiera den närliggande termen till textrutan \"Ersätt med\". Dubbelklicka på en post för att kopiera den närliggande termen till textrutan \"Aktuellt ord\" och söka efter den termen."

#. from libreoffice:cui-messages
msgid "No alternatives found."
msgstr "Inga alternativ hittades."

#. from libreoffice:cui-messages
msgid "Opens a dialog box to replace the current word with a synonym, or a related term."
msgstr "Öppnar en dialogruta för att ersätta det aktuella ordet med en synonym eller en närliggande term."

#. from libreoffice:cui-messages
msgid "Tip of the Day"
msgstr "Dagens tips"

#. from libreoffice:cui-messages
msgid "_Next Tip"
msgstr "_Nästa tips"

#. from libreoffice:cui-messages
msgid "Did you know?"
msgstr "Visste du att?"

#. from libreoffice:cui-messages
msgid "Link"
msgstr "Länk"

#. from libreoffice:cui-messages
msgid "_Show tips on startup"
msgstr "_Visa tips vid start"

#. from libreoffice:cui-messages
msgid "Enable the dialog again at Tools - Options - %PRODUCTNAME - General, or Help - Show Tip of the Day"
msgstr "Aktivera dialogrutan igen under Verktyg - Alternativ - %PRODUCTNAME - Allmänt eller hjälp - Visa dagens tips"

#. from libreoffice:cui-messages
msgid "Visible"
msgstr "Synlig"

#. from libreoffice:cui-messages
msgid "Locked"
msgstr "Låst"

#. from libreoffice:cui-messages
msgid "Context-sensitive"
msgstr "Kontextkänslig"

#. from libreoffice:cui-messages
msgid "_Lock all:"
msgstr "_Lås alla:"

#. from libreoffice:cui-messages
msgid "_No transparency"
msgstr "Ingen transparens"

#. from libreoffice:cui-messages
msgid "Turns off color transparency."
msgstr "Stänger av färggenomskinlighet."

#. from libreoffice:cui-messages
msgid "_Transparency:"
msgstr "Transparens:"

#. from libreoffice:cui-messages
msgid "Turns on color transparency. Select this option, and then enter a number in the box, where 0% is fully opaque and 100% is fully transparent."
msgstr "Aktiverar färggenomskinlighet. Markera det här alternativet och ange sedan ett värde i rutan. 0 % står för helt ogenomskinligt och 100 % för helt transparent."

#. from libreoffice:cui-messages
msgid "_Gradient"
msgstr "Övertoning"

#. from libreoffice:cui-messages
msgid "Applies a transparency gradient to the current fill color. Select this option, and then set the gradient properties."
msgstr "Använder en genomskinlighetsgradient för den aktuella fyllnadsfärgen. Välj det här alternativet och ange egenskaperna för gradienten."

#. from libreoffice:cui-messages
msgid "Adjusts the transparency of the current fill color. Enter a number between 0% (opaque) and 100% (transparent)."
