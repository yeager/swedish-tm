#. from libreoffice:sbasic-guide
msgid "Access2Base"
msgstr "Access2Base"

#. from libreoffice:sbasic-guide
msgid "What is Access2Base?"
msgstr "Vad är Access2Base?"

#. from libreoffice:sbasic-guide
msgid "The API provided by Access2Base is intended to be more concise, intuitive and easy to learn than the standard UNO API (API = Application Programming Interface)."
msgstr "Det API som Access2Base ger är tänkt att vara kortfattat, intuitivt och enklare att lära sig än det normala UNO API (API = Application Programming Interface)."

#. from libreoffice:sbasic-guide
msgid "<emph>The library is documented online on </emph><link href=\"http://www.access2base.com\"><emph>http://www.access2base.com</emph></link>."
msgstr "<emph>Biblioteket finns dokumenterat online på </emph><link href=\"http://www.access2base.com\"><emph>http://www.access2base.com</emph></link>."

#. from libreoffice:sbasic-guide
msgid "The implemented macros include:"
msgstr "De makron som är implementerade inkluderar:"

#. from libreoffice:sbasic-guide
msgid "a simplified and extensible API for <emph>forms</emph>, <emph>dialogs</emph> and <emph>controls</emph> manipulations similar with the Microsoft Access object model,"
msgstr "ett förenklat och utvidgningsbart API för <emph>formulär</emph>, <emph>dialoger</emph> och <emph>kontroll</emph> manipuleringar liknande Microsoft Access objektmodellen,"

#. from libreoffice:sbasic-guide
msgid "an API for database access with the <emph>table</emph>, <emph>query</emph>, <emph>recordset</emph> and <emph>field</emph> objects,"
msgstr "ett API för databasåtkomst med <emph>tabell</emph>, <emph>fråga</emph>, <emph>post</emph> och <emph>fält</emph> objekt,"

#. from libreoffice:sbasic-guide
msgid "a number of <emph>actions</emph> with a syntax identical to their corresponding Microsoft Access macros/actions,"
msgstr "ett antal <emph>åtgärder</emph> med en syntax identisk med motsvarande Microsoft Access makron/åtgärder,"

#. from libreoffice:sbasic-guide
msgid "the <emph>DLookup</emph>, <emph>DSum</emph>, ... database functions,"
msgstr "<emph>DLookup</emph>, <emph>DSum</emph>, ... databasfunktionerna,"

#. from libreoffice:sbasic-guide
msgid "the support of the shortcut notations like <item type=\"literal\">Forms!myForm!myControl</item>"
msgstr "stöd för kortkommandon som <item type=\"literal\">Forms!myForm!myControl</item>"

#. from libreoffice:sbasic-guide
msgid "in addition"
msgstr "dessutom"

#. from libreoffice:sbasic-guide
msgid "a consistent errors and exceptions handler,"
msgstr "en konsekvent fel- och undantagshantering,"

#. from libreoffice:sbasic-guide
msgid "facilities for programming form, dialog and control <emph>events</emph> and"
msgstr "hjälpmedel för att programmera formulär, dialoger och kontroll <emph>händelser</emph> och"

#. from libreoffice:sbasic-guide
msgid "the support of both embedded forms and standalone (Writer) forms."
msgstr "stöd för både inbäddade formulär och fristående (Writer) formulär."

#. from libreoffice:sbasic-guide
msgid "Compare Access2Base with Microsoft Access VBA"
msgstr "Jämför Access2Base med Microsoft Access VBA"

