msgid "To _page"
msgstr "Till _sida"

#. from libreoffice:cui-messages
msgid "Anchors the selection to the current page."
msgstr "Förankrar markeringen till den aktuella sidan."

#. from libreoffice:cui-messages
msgid "To paragrap_h"
msgstr "Till stycke"

