msgid "Changes in the <emph>Commands</emph> window are automatically updated if <emph>AutoUpdate Display</emph> is activated."
msgstr "Ändringar som du gör i fönstret <emph>Kommandon</emph> uppdateras automatiskt om <emph>Uppdatera visning automatiskt</emph> är aktiverat."

#. from libreoffice:smath-01
msgid "AutoUpdate Display"
msgstr "Autouppdatera visning"

