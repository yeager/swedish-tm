msgid "<variable id=\"h1\"><link href=\"text/swriter/track_changes_toolbar.xhp\">Track Changes Toolbar</link></variable>"
msgstr "<variable id=\"h1\"><link href=\"text/swriter/track_changes_toolbar.xhp\">Verktygsraden Spåra ändringar</link></variable>"

