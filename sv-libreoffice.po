msgid "A connection to the MediaWiki system at '$ARG1' could not be created."
msgstr "Det gick inte att skapa en anslutning till MediaWiki-systemet på $ARG1."

#. from libreoffice:Office-Custom
msgid "User name or password is incorrect. Please try again, or leave the fields blank for an anonymous connection."
msgstr "Användarnamnet eller lösenordet är felaktigt. Försök igen eller lämna fälten tomma för en anonym anslutning."

#. from libreoffice:Office-Custom
msgid "A connection could not be created because the URL is invalid."
msgstr "Det gick inte att skapa en anslutning eftersom URL:en är ogiltig."

#. from libreoffice:Office-Custom
msgid "Specify a MediaWiki server by providing a URL."
msgstr "Ange en MediaWiki-server genom att ange en URL."

#. from libreoffice:Office-Custom
