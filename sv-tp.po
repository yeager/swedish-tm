msgstr "rssize"

#. from tp:procps-ng-man-4.0.6rc1
msgid "see\nB<rss>.\n(alias\nB<rss>, B<rsz>)."
msgstr "se\nB<rss>.\n(alias\nB<rss>, B<rsz>)."

#. from tp:procps-ng-man-4.0.6rc1
msgid "rsz"
msgstr "rsz"

#. from tp:procps-ng-man-4.0.6rc1
msgid "RSZ"
msgstr "RSZ"

#. from tp:procps-ng-man-4.0.6rc1
msgid "see\nB<rss>.\n(alias\nB<rss>, B<rssize>)."
msgstr "se\nB<rss>.\n(alias\nB<rss>, B<rssize>)."

#. from tp:procps-ng-man-4.0.6rc1
msgid "rtprio"
msgstr "rtprio"

#. from tp:procps-ng-man-4.0.6rc1
