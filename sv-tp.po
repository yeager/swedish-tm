msgstr "Misslyckades med att sätta pbkdf-parametrar."

#. from tp:cryptsetup-2.8.2-rc0
msgid "Reduced data offset is allowed only for detached LUKS header."
msgstr "Förminskad dataförskjutning är endast tillåten för fristående LUKS-huvuden."

#. from tp:cryptsetup-2.8.2-rc0
msgid "LUKS file container %s is too small for activation, there is no remaining space for data."
msgstr "LUKS-filcontainern %s är för liten för att kunna aktiveras, det finns inget kvarvarande utrymme för data."

#. from tp:cryptsetup-2.8.2-rc0
msgid "Cannot determine volume key size for LUKS without keyslots, please use --key-size option."
msgstr "Det går inte att avgöra volymens nyckelstorlek för LUKS utan nyckelplatser, använd flaggan --key-size."

#. from tp:cryptsetup-2.8.2-rc0
msgid "Device requires two volume keys."
msgstr "Enheten kräver två volymnycklar."

#. from tp:cryptsetup-2.8.2-rc0
msgid "Some specified activation parameters were ignored with OPAL hw-only encryption."
msgstr "Vissa angivna aktiveringsparametrar ignorerades med OPAL hw-only-kryptering."

#. from tp:cryptsetup-2.8.2-rc0
msgid "Device activated but cannot make flags persistent."
msgstr "Enheten aktiverades men det går inte att spara undan flaggorna."

#. from tp:cryptsetup-2.8.2-rc0
msgid "Keyslot %d is selected for deletion."
msgstr "Nyckelplats %d markerad för borttagning."

#. from tp:cryptsetup-2.8.2-rc0
msgid "This is the last keyslot. Device will become unusable after purging this key."
msgstr "Detta är sista nyckelplatsen. Enheten kommer att bli oanvändbar efter att denna nyckel tagits bort."

