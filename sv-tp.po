msgid "Known IQ2000 CPUs (for use with the -mcpu= option):"
msgstr "Kända IQ2000-CPU:er (för användning med flaggan -mcpu=):"

#. from tp:gcc-16.1-b20260222
msgid "Use ROM instead of RAM."
msgstr "Använd ROM i stället för RAM."

#. from tp:gcc-16.1-b20260222
msgid "Use GP relative sdata/sbss sections."
msgstr "Använd GP-relativa sdata-/sbss-sektioner."

#. from tp:gcc-16.1-b20260222
msgid "No default crt0.o."
msgstr "Ingen standardfil crt0.o."

#. from tp:gcc-16.1-b20260222
msgid "Put uninitialized constants in ROM (needs -membedded-data)."
msgstr "Placera oinitierade konstanter i ROM (kräver -membedded-data)."

#. from tp:gcc-16.1-b20260222
msgid "Generate Solaris CTF."
msgstr "Generera Solaris CTF."

#. from tp:gcc-16.1-b20260222
msgid "Clear hardware capabilities when linking."
msgstr "Nollställ maskinvarufunktioner vid länkning."

#. from tp:gcc-16.1-b20260222
msgid "Pass -z text to linker."
msgstr "Skicka -z text till länkaren."

