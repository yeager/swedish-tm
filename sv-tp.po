msgstr "Visa information om filsystemet där varje FIL ligger, eller annars alla\nfilsystem.\n"

#. from tp:coreutils-9.10-pre1
msgid "  -a, --all\n         include pseudo, duplicate, inaccessible file systems\n"
msgstr "  -a, --all\n         tag med pseudo-, dubblett-, oåtkomliga filsystem\n"

#. from tp:coreutils-9.10-pre1
msgid "  -B, --block-size=SIZE\n         scale sizes by SIZE before printing them; see SIZE format below;\n         E.g., '-BM' prints sizes in units of 1,048,576 bytes\n"
msgstr "  -B, --block-size=STRL\n         skala storlekar med STRL före de skrivs ut; se format på STRL nedan;\n         t.ex. skriver ”-BM” storlekar i enheter av 1 048 576 byte\n"

#. from tp:coreutils-9.10-pre1
msgid "  -h, --human-readable\n         print sizes in powers of 1024 (e.g., 1023M)\n"
msgstr "  -h, --human-readable\n         skriv storlekar i potenser av 1024 (t.ex. 1023M)\n"

#. from tp:coreutils-9.10-pre1
msgid "  -H, --si\n         print sizes in powers of 1000 (e.g., 1.1G)\n"
msgstr "  -H, --si\n         skriv storlekar i potenser av 1000 (t.ex. 1,1G)\n"

#. from tp:coreutils-9.10-pre1
msgid "  -i, --inodes\n         list inode information instead of block usage\n"
msgstr "  -i, --inodes\n         skriv inodinformation istället för blockanvändning\n"

#. from tp:coreutils-9.10-pre1
msgid "  -k\n         like --block-size=1K\n"
msgstr "  -k\n         som --block-size=1K\n"

#. from tp:coreutils-9.10-pre1
msgid "  -l, --local\n         limit listing to local file systems\n"
msgstr "  -l, --local\n         visa endast lokala filsystem\n"

#. from tp:coreutils-9.10-pre1
msgid "      --no-sync\n         do not invoke sync before getting usage info (default)\n"
msgstr "      --no-sync\n         anropa inte sync innan information hämtas (normalfall)\n"

#. from tp:coreutils-9.10-pre1
msgid "      --output[=FIELD_LIST]\n         use the output format defined by FIELD_LIST,\n         or print all fields if FIELD_LIST is omitted\n"
msgstr "      --output[=FÄLTLISTA]\n         använd utformatet definierat av FÄLTLISTA,\n         eller skriv alla fält om FÄLTLISTA utelämnas.\n"

#. from tp:coreutils-9.10-pre1
msgid "  -P, --portability\n         use the POSIX output format\n"
msgstr "  -P, --portability\n         använd POSIX-utmatningsformat\n"

#. from tp:coreutils-9.10-pre1
msgid "      --sync\n         invoke sync before getting usage info\n"
msgstr "      --sync\n         anropa sync före användningsinformation inhämtas\n"

#. from tp:coreutils-9.10-pre1
msgid "      --total\n         elide all entries insignificant to available space,\n         and produce a grand total\n"
msgstr "      --total\n         utelämna alla poster som inte påverkar tillgängligt\n         utrymme, och skriv en totalsumma\n"

#. from tp:coreutils-9.10-pre1
msgid "  -t, --type=TYPE\n         limit listing to file systems of type TYPE\n"
msgstr "  -t, --type=TYP\n         begränsa listningen till filsystem av typen TYP\n"

#. from tp:coreutils-9.10-pre1
msgid "  -T, --print-type\n         print file system type\n"
msgstr "  -T, --print-type\n         skriv ut filsystemtyp\n"

#. from tp:coreutils-9.10-pre1
msgid "  -x, --exclude-type=TYPE\n         limit listing to file systems not of type TYPE\n"
msgstr "  -x, --exclude-type=TYP\n         utelämna filsystem av typen TYP\n"

#. from tp:coreutils-9.10-pre1
msgid "  -v\n         (ignored)\n"
msgstr "  -v\n         (ignorerad)\n"

#. from tp:coreutils-9.10-pre1
msgid "\nFIELD_LIST is a comma-separated list of columns to be included.  Valid\nfield names are: 'source', 'fstype', 'itotal', 'iused', 'iavail', 'ipcent',\n'size', 'used', 'avail', 'pcent', 'file' and 'target' (see info page).\n"
msgstr "\nFÄLTLISTA är en kommaseparerad lista med kolumner som skall vara med.  Giltiga\nfältnamn är: ”source”, ”fstype”, ”itotal”, ”iused”, ”iavail”, ”ipcent”,\n”size”, ”used”, ”avail”, ”pcent”, ”file” och ”target” (se infosidan).\n"

#. from tp:coreutils-9.10-pre1
msgid "options %s and %s are mutually exclusive"
msgstr "flaggorna %s och %s är ömsesidigt uteslutande"

#. from tp:coreutils-9.10-pre1
msgid "file system type %s both selected and excluded"
msgstr "filsystemstypen %s är både vald och exkluderad"

#. from tp:coreutils-9.10-pre1
msgid "Warning: "
msgstr "Varning: "

#. from tp:coreutils-9.10-pre1
msgid "cannot read table of mounted file systems"
msgstr "kan inte läsa tabellen över monterade filsystem"

#. from tp:coreutils-9.10-pre1
msgid "no file systems processed"
msgstr "inga filsystem bearbetade"

#. from tp:coreutils-9.10-pre1
msgid "H. Peter Anvin"
msgstr "H. Peter Anvin"

#. from tp:coreutils-9.10-pre1
msgid "Output commands to set the LS_COLORS environment variable.\n\nDetermine format of output:\n"
msgstr "Skriv ut kommandon för att sätta miljövariabeln LS_COLORS.\n\nBestäm utformat:\n"

#. from tp:coreutils-9.10-pre1
msgid "  -b, --sh, --bourne-shell\n         output Bourne shell code to set LS_COLORS\n"
msgstr "  -b, --sh, --bourne-shell\n         skriv kod för att sätta LS_COLORS i Bourne-skal\n"

#. from tp:coreutils-9.10-pre1
msgid "  -c, --csh, --c-shell\n         output C shell code to set LS_COLORS\n"
msgstr "  -c, --csh, --c-shell\n         skriv kod för att sätta LS_COLORS i C-skal\n"

#. from tp:coreutils-9.10-pre1
msgid "  -p, --print-database\n         output defaults\n"
msgstr "  -p, --print-database\n         visa standardvärden\n"

#. from tp:coreutils-9.10-pre1
msgid "      --print-ls-colors\n         output fully escaped colors for display\n"
msgstr "      --print-ls-colors\n         skriv ut färger med kompletta escape-sekvenser för visning\n"

#. from tp:coreutils-9.10-pre1
msgid "\nIf FILE is specified, read it to determine which colors to use for which\nfile types and extensions.  Otherwise, a precompiled database is used.\nFor details on the format of these files, run 'dircolors --print-database'.\n"
msgstr "\nOm FIL anges, läs den för att bestämma vilka färger som skall användas till\nvilka filtyper och ändelser.  Annars används en fördefinierad databas.  För\ndetaljer om formatet på dessa filer, kör ”dircolors --print-database”.\n"

#. from tp:coreutils-9.10-pre1
msgid "%s:%td: invalid line;  missing second token"
msgstr "%s:%td: ogiltig rad;  inget andra element"

#. from tp:coreutils-9.10-pre1
msgid "%s:%td: unrecognized keyword %s"
msgstr "%s:%td: okänt nyckelord %s"

#. from tp:coreutils-9.10-pre1
msgid "<internal>"
msgstr "<intern>"

#. from tp:coreutils-9.10-pre1
msgid "the options to output non shell syntax,\nand to select a shell syntax are mutually exclusive"
msgstr "flaggorna för att skriva ut icke-skalsyntax,\noch att välja en skalsyntax är ömsesidigt uteslutande"

#. from tp:coreutils-9.10-pre1
msgid "options --print-database and --print-ls-colors are mutually exclusive"
msgstr "flaggorna --print-database och --print-ls-colors är ömsesidigt uteslutande"

#. from tp:coreutils-9.10-pre1
msgid "file operands cannot be combined with --print-database (-p)"
msgstr "filoperander kan inte kombineras med --print-database (-p)"

#. from tp:coreutils-9.10-pre1
msgid "no SHELL environment variable, and no shell type option given"
msgstr "ingen SHELL-miljövariabel, och ingen flagga för skalvariant angiven"

#. from tp:coreutils-9.10-pre1
msgid "Usage: %s [OPTION] NAME...\n"
msgstr "Användning: %s [FLAGGA] NAMN…\n"

#. from tp:coreutils-9.10-pre1
msgid "Output each NAME with its last non-slash component and trailing slashes\nremoved; if NAME contains no /'s, output '.' (meaning the current directory).\n\n"
msgstr "Skriv ut NAMN med dess sista snedstrecksfria komponent och avslutande snedstreck\nborttagna; om NAMN inte innehåller några /, skriv ”.” (som betyder aktuell\nkatalog)\n\n"

#. from tp:coreutils-9.10-pre1
msgid "\nExamples:\n  %s /usr/bin/          -> \"/usr\"\n  %s dir1/str dir2/str  -> \"dir1\" followed by \"dir2\"\n  %s stdio.h            -> \".\"\n"
msgstr "\nExempel:\n  %s /usr/bin/          → ”/usr”\n  %s dir1/str dir2/str  → ”dir1” följt av ”dir2”\n  %s stdio.h            → ”.”\n"

#. from tp:coreutils-9.10-pre1
msgid "Usage: %s [OPTION]... [FILE]...\n  or:  %s [OPTION]... --files0-from=F\n"
msgstr "Användning: %s [FLAGGA]... [FIL]...\n   eller:   %s [FLAGGA]... --files0-from=F\n"

#. from tp:coreutils-9.10-pre1
msgid "Summarize device usage of the set of FILEs, recursively for directories.\n"
msgstr "Sammanfatta enhetsanvändningen för uppsättningen FILer, rekursivt för kataloger.\n"

#. from tp:coreutils-9.10-pre1
msgid "  -0, --null\n         end each output line with NUL, not newline\n"
msgstr "  -0, --null\n         avsluta varje utmatad rad med NUL, inte nyrad\n"

#. from tp:coreutils-9.10-pre1
msgid "  -a, --all\n         write counts for all files, not just directories\n"
msgstr "  -a, --all\n         skriv ut värden för alla filer, inte bara kataloger\n"

#. from tp:coreutils-9.10-pre1
msgid "  -A, --apparent-size\n         print apparent sizes rather than device usage;\n         although the apparent size is usually smaller, it may be\n         larger due to holes in ('sparse') files,\n         internal fragmentation, indirect blocks, etc.\n"
msgstr "  -A, --apparent-size\n         skriv skenbar storlek istället för enhetsanvändning;\n         även om den skenbara storleken normalt är mindre, kan\n         den vara större på grund av hål i (”glesa”) filer,\n         intern fragmentering, indirekta block, etc.\n"

#. from tp:coreutils-9.10-pre1
msgid "  -B, --block-size=SIZE\n         scale sizes by SIZE before printing them; See SIZE format below;\n         E.g., '-BM' prints sizes in units of 1,048,576 bytes\n"
msgstr "  -B, --block-size=STRL\n         skala storlekar med STRL före de skrivs ut; se format på STRL nedan;\n         t.ex. skriver ”-BM” storlekar i enheter av 1 048 576 byte;\n"

#. from tp:coreutils-9.10-pre1
msgid "  -b, --bytes\n         equivalent to '--apparent-size --block-size=1'\n"
msgstr "  -b, --bytes\n         likvärdigt med ”--apparent-size --block-size=1”\n"

#. from tp:coreutils-9.10-pre1
msgid "  -c, --total\n         produce a grand total\n"
msgstr "  -c, --total\n         rapportera totalsumman\n"

#. from tp:coreutils-9.10-pre1
msgid "  -D, --dereference-args\n         dereference only symlinks that are listed on the command line\n"
msgstr "  -D, --dereference-args\n         följ endast symboliska länkar som är uppräknade på kommandoraden\n"

#. from tp:coreutils-9.10-pre1
msgid "  -d, --max-depth=N\n         print the total for a directory (or file, with --all)\n         only if it is N or fewer levels below the command\n         line argument;  --max-depth=0 is the same as --summarize\n"
msgstr "  -d, --max-depth=N\n         skriv summan för en katalog (eller fil, med --all) endast\n         om den är N eller färre nivåer nedanför kommandoradsargumentet;\n         --max-depth=0 är detsamma som --summarize\n"

#. from tp:coreutils-9.10-pre1
msgid "      --files0-from=F\n         summarize device usage of the NUL-terminated file names\n         specified in file F;  if F is -, read names from standard input\n"
msgstr "      --files0-from=F\n         summera enhetsanvändning för de NUL-avslutade filnamnen\n         som anges i filen F; om F är - läs namn från standard in\n"

#. from tp:coreutils-9.10-pre1
msgid "  -H\n         equivalent to --dereference-args (-D)\n"
msgstr "  -H\n         detsamma som --dereference-args (-D)\n"

#. from tp:coreutils-9.10-pre1
msgid "  -h, --human-readable\n         print sizes in human readable format (e.g., 1K 234M 2G)\n"
msgstr "  -h, --human-readable\n         skriv storlekar i läsbart format (t.ex. 1K 234M 2G)\n"

#. from tp:coreutils-9.10-pre1
msgid "      --inodes\n         list inode usage information instead of block usage\n"
msgstr "      --inodes\n         lista information om inodsanvändning istället för blockanvändning\n"

#. from tp:coreutils-9.10-pre1
msgid "  -L, --dereference\n         dereference all symbolic links\n"
msgstr "  -L, --dereference\n         följ alla symboliska länkar\n"

#. from tp:coreutils-9.10-pre1
msgid "  -l, --count-links\n         count sizes many times if hard linked\n"
msgstr "  -l, --count-links\n         räkna storlek flera gånger för hårda länkar\n"

#. from tp:coreutils-9.10-pre1
msgid "  -m\n         like --block-size=1M\n"
msgstr "  -m\n         som --block-size=1M\n"

#. from tp:coreutils-9.10-pre1
msgid "  -P, --no-dereference\n         don't follow any symbolic links (this is the default)\n"
msgstr "  -P, --no-dereference\n         följ inga symboliska länkar (detta är normalfallet)\n"

#. from tp:coreutils-9.10-pre1
msgid "  -S, --separate-dirs\n         for directories do not include size of subdirectories\n"
msgstr "  -S, --separate-dirs\n         ta för kataloger inte med storlek på underkataloger\n"

#. from tp:coreutils-9.10-pre1
msgid "      --si\n         like -h, but use powers of 1000 not 1024\n"
msgstr "      --si\n         som -h men i potenser av 1000 istället för 1024\n"

#. from tp:coreutils-9.10-pre1
msgid "  -s, --summarize\n         display only a total for each argument\n"
msgstr "  -s, --summarize\n         visa bara summan för varje argument\n"

#. from tp:coreutils-9.10-pre1
msgid "  -t, --threshold=SIZE\n         exclude entries smaller than SIZE if positive,\n         or entries greater than SIZE if negative\n"
msgstr "  -t, --threshold=STORLEK\n         uteslut poster som är mindre än STORLEK om den är positiv,\n         eller poster större än STORLEK om den är negativ\n"

#. from tp:coreutils-9.10-pre1
msgid "      --time\n         show time of the last modification of any file in the directory,\n         or any of its subdirectories\n"
msgstr "      --time\n         visa tiden för senaste ändring av filer i katalogen,\n         eller någon av dess underkataloger\n"

#. from tp:coreutils-9.10-pre1
msgid "      --time=WORD\n         show time as WORD instead of modification time:\n         atime, access, use, ctime or status\n"
msgstr "      --time=ORD\n         visa tid som ORD istället för modifieringstid:\n         atime, access, use, ctime eller status\n"

#. from tp:coreutils-9.10-pre1
msgid "      --time-style=STYLE\n         time/date format with --time; see TIME_STYLE below\n"
msgstr "      --time-style=STIL\n         tid-/datumformat med --time; se TIME_STYLE nedan\n"

#. from tp:coreutils-9.10-pre1
msgid "  -X, --exclude-from=FILE\n         exclude files that match any pattern in FILE\n"
msgstr "  -X, --exclude-from=FIL\n         utelämna filer som matchar något mönster i FIL\n"

#. from tp:coreutils-9.10-pre1
msgid "      --exclude=PATTERN\n         exclude files that match PATTERN\n"
msgstr "      --exclude=MÖNSTER\n         utelämna filer som matchar MÖNSTER\n"

#. from tp:coreutils-9.10-pre1
msgid "  -x, --one-file-system\n         skip directories on different file systems\n"
msgstr "  -x, --one-file-system\n         hoppa över kataloger på andra filsystem\n"

#. from tp:coreutils-9.10-pre1
msgid "\nThe --time-style STYLE argument can be full-iso, long-iso, iso, or +FORMAT.\nFORMAT is interpreted like in date(1).\nAlso the TIME_STYLE environment variable sets the default style to use.\n"
msgstr "\nArgumentet STIL till --time-style kan vara full-iso, long-iso, iso eller +FORMAT.\nFORMAT tolkas som i date(1).\nVidare anger miljövariabeln TIME_STYLE standardstilen att använda.\n"

#. from tp:coreutils-9.10-pre1
msgid "fts_read failed: %s"
msgstr "fts_read misslyckades: %s"

#. from tp:coreutils-9.10-pre1
msgid "invalid maximum depth %s"
msgstr "ogiltigt maxdjup %s"

#. from tp:coreutils-9.10-pre1
msgid "invalid --threshold argument '-0'"
msgstr "felaktigt argument till --threshold ”-0”"

#. from tp:coreutils-9.10-pre1
msgid "cannot both summarize and show all entries"
msgstr "kan inte samtidigt bara visa summan och alla storlekar"

#. from tp:coreutils-9.10-pre1
msgid "warning: summarizing is the same as using --max-depth=0"
msgstr "varning: att summera är detsamma som att använda --max-depth=0"

#. from tp:coreutils-9.10-pre1
msgid "warning: summarizing conflicts with --max-depth=%td"
msgstr "varning: att summera står i konflikt med --max-depth=%td"

#. from tp:coreutils-9.10-pre1
msgid "warning: options --apparent-size and -b are ineffective with --inodes"
msgstr "varning: flaggorna --apparent-size och -b har ingen effekt med --inodes"

#. from tp:coreutils-9.10-pre1
msgid "file operands cannot be combined with --files0-from"
msgstr "filoperander kan inte kombineras med --files0-from"

#. from tp:coreutils-9.10-pre1
msgid "when reading file names from standard input, no file name of %s allowed"
msgstr "när filnamn läses från standard in tillåts inte filnamnet %s"

#. from tp:coreutils-9.10-pre1
msgid "invalid zero-length file name"
msgstr "ogiltigt filnamn med längd noll"

#. from tp:coreutils-9.10-pre1
msgid "Brian Fox"
msgstr "Brian Fox"

#. from tp:coreutils-9.10-pre1
msgid "Chet Ramey"
msgstr "Chet Ramey"

#. from tp:coreutils-9.10-pre1
msgid "Usage: %s [SHORT-OPTION]... [STRING]...\n  or:  %s LONG-OPTION\n"
msgstr "Användning: %s [KORT_FLAGGA]... [STRÄNG]...\n   eller:   %s LÅNG_FLAGGA\n"

#. from tp:coreutils-9.10-pre1
msgid "Echo the STRING(s) to standard output.\n\n"
msgstr "Eka STRÄNG(arna) till standard ut.\n\n"

#. from tp:coreutils-9.10-pre1
msgid "  -n     do not output the trailing newline\n"
msgstr "  -n     skriv inte ut den avslutande nyraden\n"

#. from tp:coreutils-9.10-pre1
msgid "  -e     enable interpretation of backslash escapes (default)\n"
msgstr "  -e     slå på tolkning av sekvenser med omvänt snedstreck (standard)\n"

#. from tp:coreutils-9.10-pre1
msgid "  -e     enable interpretation of backslash escapes\n"
msgstr "  -e     slå på tolkning av sekvenser med omvänt snedstreck\n"

#. from tp:coreutils-9.10-pre1
msgid "  -E     disable interpretation of backslash escapes\n"
msgstr "  -E     slå av tolkning av sekvenser med omvänt snedstreck\n"

#. from tp:coreutils-9.10-pre1
msgid "  -E     disable interpretation of backslash escapes (default)\n"
msgstr "  -E     slå av tolkning av sekvenser med omvänt snedstreck (standard)\n"

#. from tp:coreutils-9.10-pre1
msgid "\nIf -e is in effect, the following sequences are recognized:\n\n"
msgstr "\nOm -e är påslaget tolkas följande sekvenser:\n\n"

#. from tp:coreutils-9.10-pre1
msgid "  \\\\      backslash\n  \\a      alert (BEL)\n  \\b      backspace\n  \\c      produce no further output\n  \\e      escape\n  \\f      form feed\n  \\n      new line\n  \\r      carriage return\n  \\t      horizontal tab\n  \\v      vertical tab\n"
msgstr "  \\\\     omvänt snedstreck\n  \\a     varning (SIGNAL)\n  \\b     backsteg\n  \\c     producera ingen ytterligare utmatning\n  \\e     escape-tecken\n  \\f     sidmatning\n  \\n     nyrad\n  \\r     vagnretur\n  \\t     horisontell tabulator\n  \\v     vertikal tabulator\n"

#. from tp:coreutils-9.10-pre1
msgid "  \\0NNN   byte with octal value NNN (1 to 3 digits)\n  \\xHH    byte with hexadecimal value HH (1 to 2 digits)\n"
msgstr "  \\0NNN   byte med oktalt värde NNN (1 till 3 siffror)\n  \\xHH    byte med hexadecimalt värde HH (1 till 2 siffror)\n"

#. from tp:coreutils-9.10-pre1
msgid "\nConsider using the printf(1) command instead,\nas it avoids problems when outputting option-like strings.\n"
msgstr "\nÖverväg att använda kommandot printf(1) istället,\neftersom det undviker problem med att mata ut flaggliknande strängar.\n"

#. from tp:coreutils-9.10-pre1
msgid "Richard Mlynarik"
msgstr "Richard Mlynarik"

#. from tp:coreutils-9.10-pre1
msgid "Usage: %s [OPTION]... [-] [NAME=VALUE]... [COMMAND [ARG]...]\n"
msgstr "Användning: %s [FLAGGA]... [-] [NAMN=VÄRDE]... [KOMMANDO [ARG]...]\n"

#. from tp:coreutils-9.10-pre1
msgid "Set each NAME to VALUE in the environment and run COMMAND.\n"
msgstr "Sätt varje NAMN till VÄRDE i miljön och kör KOMMANDO.\n"

#. from tp:coreutils-9.10-pre1
msgid "  -a, --argv0=ARG\n         pass ARG as the zeroth argument of COMMAND\n"
msgstr "  -a, --argv0=ARG\n         skicka ARG som det nollte argumentet till KOMMANDO\n"

#. from tp:coreutils-9.10-pre1
msgid "  -i, --ignore-environment\n         start with an empty environment\n"
msgstr "  -i, --ignore-environment\n         börja med en tom miljö\n"

#. from tp:coreutils-9.10-pre1
msgid "  -u, --unset=NAME\n         remove variable from the environment\n"
msgstr "  -u, --unset=NAMN\n         ta bort variabeln från miljön\n"

#. from tp:coreutils-9.10-pre1
msgid "  -C, --chdir=DIR\n         change working directory to DIR\n"
msgstr "  -C, --chdir=KAT\n         byt arbetskatalog till KAT\n"

#. from tp:coreutils-9.10-pre1
msgid "  -S, --split-string=S\n         process and split S into separate arguments;\n         used to pass multiple arguments on shebang lines\n"
msgstr "  -S, --split-string=S\n         bearbeta och dela S i separata argument; används för\n         att skicka flera argument på shebang-rader\n"

#. from tp:coreutils-9.10-pre1
msgid "      --block-signal[=SIG]\n         block delivery of SIG signal(s) to COMMAND\n"
msgstr "      --block-signal[=SIG]\n         blockera leverans av SIG-signaler till KOMMANDO\n"

#. from tp:coreutils-9.10-pre1
msgid "      --default-signal[=SIG]\n         reset handling of SIG signal(s) to the default\n"
msgstr "      --default-signal[=SIG]\n         återställ hanteringen av SIG-signaler till standard\n"

#. from tp:coreutils-9.10-pre1
msgid "      --ignore-signal[=SIG]\n         set handling of SIG signal(s) to do nothing\n"
msgstr "      --ignore-signal[=SIG]\n         ställ in hanteringen av SIG-signaler till att inte göra något\n"

#. from tp:coreutils-9.10-pre1
msgid "      --list-signal-handling\n         list non default signal handling to standard error\n"
msgstr "      --list-signal-handling\n         lista signalhantering som avviker från standard till standard fel\n"

#. from tp:coreutils-9.10-pre1
msgid "  -v, --debug\n         print verbose information for each processing step\n"
msgstr "  -v, --debug\n         skriv utförlig information för varje bearbetningssteg\n"

#. from tp:coreutils-9.10-pre1
msgid "\nA mere - implies -i.  If no COMMAND, print the resulting environment.\n"
msgstr "\nEtt ensamt - medför -i.  Om inget KOMMANDO, skriv ut den resulterande miljön.\n"

#. from tp:coreutils-9.10-pre1
msgid "\nSIG may be a signal name like 'PIPE', or a signal number like '13'.\nWithout SIG, all known signals are included.  Multiple signals can be\ncomma-separated.  An empty SIG argument is a no-op.\n"
msgstr "\nSIG kan vara ett signalnamn som ”PIPE” eller ett signalnummer som ”13”.\nUtan SIG inkluderas alla kända signaler. Flera signaler kan separeras\nmed komma. Ett tomt SIG-argument har ingen effekt.\n"

#. from tp:coreutils-9.10-pre1
msgid "cannot unset %s"
msgstr "kan inte ta bort %s"

#. from tp:coreutils-9.10-pre1
msgid "'\\c' must not appear in double-quoted -S string"
msgstr "”\\c” får inte förekomma i en dubbelciterad -S-sträng"

#. from tp:coreutils-9.10-pre1
msgid "invalid backslash at end of string in -S"
msgstr "felaktigt omvänt snedstreck vid slutet av strängen i -S"

#. from tp:coreutils-9.10-pre1
msgid "invalid sequence '\\%c' in -S"
msgstr "felaktig sekvens ”\\%c” i -S"

#. from tp:coreutils-9.10-pre1
msgid "only ${VARNAME} expansion is supported, error at: %s"
msgstr "endast expansion av ${VARNAMN} stödjs, fel vid: %s"

#. from tp:coreutils-9.10-pre1
msgid "no terminating quote in -S string"
msgstr "inget avslutande citationstecken i -S-strängen"

#. from tp:coreutils-9.10-pre1
msgid "%s: invalid signal"
msgstr "%s: felaktig signal"

#. from tp:coreutils-9.10-pre1
msgid "failed to get signal action for signal %d"
msgstr "misslyckades med att hämta signalåtgärden för signal %d"

#. from tp:coreutils-9.10-pre1
msgid "failed to set signal action for signal %d"
msgstr "misslyckades med att sätta signalåtgärden för signalen %d"

#. from tp:coreutils-9.10-pre1
msgid "failed to block signal %d"
msgstr "misslyckades med att blockera signal %d"

