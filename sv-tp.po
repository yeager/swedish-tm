msgid "Choose Custom Template"
msgstr "Välj anpassad mall"

#. from tp:denemo-2.6-rc2
msgid "Attaches (or removes) this ornament from the current note/chord."
msgstr "Fäster (eller tar bort) detta ornament från den aktuella noten/ackordet."

#. from tp:denemo-2.6-rc2
msgid "The file \""
msgstr "Filen \""

#. from tp:denemo-2.6-rc2
msgid "\"\ndoes not (yet) exist, or no longer exists.\nTypesetting will silently fail until the file exists.\nEither create the file or delete the Graphic Title Page now"
msgstr "\"\ninte (ännu) existerar, eller inte längre existerar.\nSättningen kommer att misslyckas tills filen finns.\nSkapa antingen filen eller ta bort den grafiska titelsidan nu"

#. from tp:denemo-2.6-rc2
