msgstr "Följ standarden ISO 2017 C (publicerades 2018) med GNU-utökningar."

#. from tp:gcc-16.1-b20260222
msgid "Conform to the ISO 2023 C standard (published in 2024) with GNU extensions."
msgstr "Följ standarden ISO 2023 C (publicerades 2024) med GNU-utökningar."

#. from tp:gcc-16.1-b20260222
msgid "Deprecated in favor of -std=gnu23."
msgstr "Föråldrad till förmån för -std=gnu23."

#. from tp:gcc-16.1-b20260222
msgid "Conform to the ISO 202Y C standard draft with GNU extensions (experimental and incomplete support)."
msgstr "Följ standardutkastet ISO 202Y C med GNU-utökningar (experimentellt och ofullständigt stöd)."

#. from tp:gcc-16.1-b20260222
msgid "Conform to the ISO 1990 C standard with GNU extensions."
msgstr "Följ standarden ISO 1990 C med GNU-utökningar."

#. from tp:gcc-16.1-b20260222
msgid "Conform to the ISO 1999 C standard with GNU extensions."
msgstr "Följ standarden ISO 1999 C med GNU-utökningar."

#. from tp:gcc-16.1-b20260222
msgid "Deprecated in favor of -std=gnu99."
msgstr "Föråldrad till förmån för -std=gnu99."

#. from tp:gcc-16.1-b20260222
msgid "Conform to the ISO 1990 C standard as amended in 1994."
msgstr "Följ standarden ISO 1990 C med tillägg från 1994."

#. from tp:gcc-16.1-b20260222
msgid "Deprecated in favor of -std=iso9899:1999."
msgstr "Föråldrad till förmån för -std=iso9899:1999."

#. from tp:gcc-16.1-b20260222
msgid "-stdlib=[libstdc++|libc++]	The standard library to be used for C++ headers and runtime."
msgstr "-stdlib=[libstdc++|libc++]	Standardbiblioteket att använda för C++-huvuden och körtid."

#. from tp:gcc-16.1-b20260222
msgid "Enable traditional preprocessing."
msgstr "Aktivera traditionell preprocessning."

#. from tp:gcc-16.1-b20260222
msgid "-trigraphs	Support ISO C trigraphs."
msgstr "-trigraphs	Stöd trigrafer enligt ISO C."

#. from tp:gcc-16.1-b20260222
msgid "Do not predefine system-specific and GCC-specific macros."
msgstr "Fördefiniera inte systemspecifika och GCC-specifika makron."

#. from tp:gcc-16.1-b20260222
msgid "Accept COBOL constructs used by non-ISO compilers."
msgstr "Acceptera COBOL-konstruktioner som används av icke-ISO-kompilatorer."

#. from tp:gcc-16.1-b20260222
msgid "-fcobol-exceptions=<n>	Enable some exceptions by default."
msgstr "-fcobol-exceptions=<n>	Aktivera några undantag som standard."

#. from tp:gcc-16.1-b20260222
msgid "Define alternative implicit copybook filename extension."
msgstr "Definiera en alternativ implicit copybook-filnamnsändelse."

#. from tp:gcc-16.1-b20260222
msgid "Set the default execution character set for NATIONAL data items."
msgstr "Ställ in standardexekveringsteckenuppsättningen för dataobjekt NATIONAL."

#. from tp:gcc-16.1-b20260222
msgid "Warn if CDF defines Level 78 constant."
msgstr "Varna om CDF definierar en Level 78-konstant."

#. from tp:gcc-16.1-b20260222
msgid "Warn if BINARY-LONG-LONG is used."
msgstr "Varna om BINARY-LONG-LONG används."

#. from tp:gcc-16.1-b20260222
msgid "Warn if CALL ... GIVING is used."
msgstr "Varna om CALL … GIVING används."

#. from tp:gcc-16.1-b20260222
msgid "Warn if CALL is used is used with a literal parameter by reference."
msgstr "Varna om CALL används med en litteral parameter via referens."

#. from tp:gcc-16.1-b20260222
msgid "Warn if CDF %<$IF%> is used."
msgstr "Varna om CDF %<$IF%> används."

#. from tp:gcc-16.1-b20260222
msgid "Warn if COMPUTATIONAL-6 is used."
msgstr "Varna om COMPUTATIONAL-6 används."

#. from tp:gcc-16.1-b20260222
msgid "Warn if Level 78 is used."
msgstr "Varna om nivå 78 används."

#. from tp:gcc-16.1-b20260222
msgid "Warn if ANY LENGTH is used in outermost program."
msgstr "Varna om ANY LENGTH används i det yttersta programmet."

#. from tp:gcc-16.1-b20260222
msgid "Warn if numeric string is invalid."
msgstr "Varna om en numerisk sträng är felaktig."

#. from tp:gcc-16.1-b20260222
msgid "Warn if referenced CDF PARAMETER is not defined."
msgstr "Varna om en refererarad CDF PARAMETER inte är definierad."

#. from tp:gcc-16.1-b20260222
msgid "Warn if referenced CDF name is not defined."
msgstr "Varna om ett refererat CDF-namn inte är definierat."

#. from tp:gcc-16.1-b20260222
msgid "Print message when include file is processed."
msgstr "Skriv ett meddelande när en inkluderad fil bearbetas."

#. from tp:gcc-16.1-b20260222
msgid "Warn if concatenated literals use different encodings."
msgstr "Varna om sammanslagna litteraler använder olika kodningar."

#. from tp:gcc-16.1-b20260222
msgid "Warn if IBM-style EJECT is used (instead of error)."
msgstr "Varna om EJECT i IBM-stil används (i stället för fel)."

#. from tp:gcc-16.1-b20260222
msgid "Warn if IBM-style STOP <number> is used (instead of error)."
msgstr "Varna om STOP <nummer> i IBM-stil används (i stället för fel)."

#. from tp:gcc-16.1-b20260222
msgid "Set Working-Storage data items to the supplied value."
msgstr "Sätt Working-Storage-dataposter till det angivna värdet."

#. from tp:gcc-16.1-b20260222
msgid "Enable Cobol lex debugging."
msgstr "Aktivera Cobol lex-felsökning."

#. from tp:gcc-16.1-b20260222
msgid "-findicator-column=<n>	Column after which Region A begins."
msgstr "-findicator-column=<n>	Kolumn efter vilken region A börjar."

#. from tp:gcc-16.1-b20260222
msgid "Enable/disable static linkage for CALL literals."
msgstr "Aktivera/avaktivera statisk länkning för CALL-litteraler."

#. from tp:gcc-16.1-b20260222
msgid "Enable Cobol parser debugging."
msgstr "Aktivera Cobol-parserfelsökning."

#. from tp:gcc-16.1-b20260222
msgid "Enable Cobol yacc debugging."
msgstr "Aktivera Cobol yacc-felsökning."

#. from tp:gcc-16.1-b20260222
msgid "Preprocess <source_filter> before compiling."
msgstr "Preprocessa <source_filter> före kompilering."

#. from tp:gcc-16.1-b20260222
msgid "-main	The first program-id in the next source file is called by a generated main() entry point."
msgstr "-main	Det första program-id:t i nästa källkodsfil anropas av en genererad ingångspunkt main()."

#. from tp:gcc-16.1-b20260222
msgid "-main=<source_file> source_file/PROGRAM-ID is called by the generated main()."
msgstr "-main=<källkodsfil> källkodsfil/PROGRAM-ID anropas av den genererade main()."

#. from tp:gcc-16.1-b20260222
msgid "-nomain	No main() function is created from COBOL source files."
msgstr "-nomain	Ingen funktion main() skapas från COBOL-källkodsfiler."

#. from tp:gcc-16.1-b20260222
msgid "-Hd <dir>	Write D interface files to directory <dir>."
msgstr "-Hd <kat>	Skriv D-gränssnittsfiler till katalogen <kat>."

#. from tp:gcc-16.1-b20260222
msgid "-Hf <file>	Write D interface to <file>."
msgstr "-Hf <fil>	Skriv D-gränssnitt till <fil>."

#. from tp:gcc-16.1-b20260222
msgid "Warn about casts that will produce a null result."
msgstr "Varna för typkonverteringar som kommer att ge ett nullvärde."

#. from tp:gcc-16.1-b20260222
msgid "Warn when a special enum is declared with the wrong base type."
msgstr "Varna när en speciell uppräkningstyp deklareras med fel bastyp."

#. from tp:gcc-16.1-b20260222
msgid "Warn from speculative compiles such as __traits(compiles)."
msgstr "Varna för spekulativa kompileringar såsom __traits(compiles)."

#. from tp:gcc-16.1-b20260222
msgid "Generate JSON file."
msgstr "Generera JSON-fil."

#. from tp:gcc-16.1-b20260222
msgid "-Xf <file>	Write JSON output to the given <file>."
msgstr "-Xf <fil>	Skriv JSON-utdata till angiven <fil>."

#. from tp:gcc-16.1-b20260222
msgid "Debug library to use instead of phobos."
msgstr "Felsökningsbibliotek att använda istället för phobos."

#. from tp:gcc-16.1-b20260222
msgid "Default library to use instead of phobos."
msgstr "Standardbibliotek att använda istället för phobos."

#. from tp:gcc-16.1-b20260222
msgid "Do link the standard D startup files in the compilation."
msgstr "Länka med standard D-uppstartsfiler i kompileringen."

#. from tp:gcc-16.1-b20260222
msgid "Generate code for all template instantiations."
msgstr "Generera kod för alla mallinstansieringar."

#. from tp:gcc-16.1-b20260222
msgid "-fbounds-check=[on|safeonly|off]	Turn array bounds checks on, in @safe code only, or off."
msgstr "-fbounds-check=[on|safeonly|off]	Låt gränskontroller för vektorer vara på, endast i @safe-kod eller av."

#. from tp:gcc-16.1-b20260222
msgid "-fcheckaction=[throw,halt,context]	Behavior on contract failure."
msgstr "-fcheckaction=[throw,halt,context]	Beteende vid kontraktsbrott."

#. from tp:gcc-16.1-b20260222
msgid "Compile in debug code."
msgstr "Kompilera in felsökningskod."

#. from tp:gcc-16.1-b20260222
msgid "-fdebug=<ident>	Compile in debug code identified by <ident>."
msgstr "-fdebug=<ident>	Kompilera in felsökningskod identifierad av <ident>."

#. from tp:gcc-16.1-b20260222
msgid "Generate documentation."
msgstr "Generera dokumentation."

#. from tp:gcc-16.1-b20260222
msgid "-fdoc-dir=<dir>	Write documentation file to directory <dir>."
msgstr "-fdoc-dir=<kat>	Skriv dokumentationsfilen till katalogen <kat>."

#. from tp:gcc-16.1-b20260222
msgid "-fdoc-file=<file>	Write documentation to <file>."
msgstr "-fdoc-file=<fil>	Skriv dokumentation till <fil>."

#. from tp:gcc-16.1-b20260222
msgid "-fdoc-inc=<file>	Include a Ddoc macro <file>."
msgstr "-fdoc-inc=<fil>		Inkludera ett Ddoc-makro <fil>."

#. from tp:gcc-16.1-b20260222
msgid "Assume that standard D runtime libraries and \"D main\" exist."
msgstr "Anta att standard D-körtidsbibliotek och ”D main” finns."

#. from tp:gcc-16.1-b20260222
msgid "Add comments for ignored declarations in the generated C++ header."
msgstr "Lägg till kommentarer om ignorerade deklarationer i det genererade C++-huvudet."

#. from tp:gcc-16.1-b20260222
msgid "-fdump-cxx-spec=<filename>	Write all declarations as C++ code to <filename>."
msgstr "-fdump-cxx-spec=<filnamn>	Skriv alla deklarationer som C++-kod till <filnamn>."

#. from tp:gcc-16.1-b20260222
msgid "Display the frontend AST after parsing and semantic passes."
msgstr "Visa framände-AST:n efter tolkning och semantiska pass."

#. from tp:gcc-16.1-b20260222
msgid "-fextern-std=<standard>	Set C++ name mangling compatibility with <standard>."
msgstr "-fextern-std=<standard>	Ange C++-namnmanglingskompatibilitet med <standard>."

#. from tp:gcc-16.1-b20260222
msgid "Ignore unsupported pragmas."
msgstr "Ignorera pragma som inte stödjs."

#. from tp:gcc-16.1-b20260222
msgid "Include imported modules in the compilation."
msgstr "Inkludera importerade moduler i kompileringen."

#. from tp:gcc-16.1-b20260222
msgid "Generate code for class invariant contracts."
msgstr "Generera kod för klassinvarianskontrakt."

#. from tp:gcc-16.1-b20260222
msgid "Generate a default D main() function when compiling."
msgstr "Generera en standard D-funktion main() vid kompilering."

#. from tp:gcc-16.1-b20260222
msgid "-fmodule-file=<package.module>=<filespec>	use <filespec> as source file for <package.module>."
msgstr "-fmodule-file=<paket.modul>=<filspec>\tAnvänd <filspec> som källfil för <paket.modul>."

#. from tp:gcc-16.1-b20260222
msgid "Generate ModuleInfo struct for output module."
msgstr "Generera ModuleInfo-post för utdatamodulen."

#. from tp:gcc-16.1-b20260222
msgid "Process all modules specified on the command line, but only generate code for the module specified by the argument."
msgstr "Bearbeta alla moduler som anges på kommandoraden, men generera endast kod för den modul som anges av argumentet."

#. from tp:gcc-16.1-b20260222
msgid "Generate code for postcondition contracts."
msgstr "Generera kod för eftervillkorskontrakt."

#. from tp:gcc-16.1-b20260222
msgid "Generate code for precondition contracts."
msgstr "Generera kod för förvillkorskontrakt."

#. from tp:gcc-16.1-b20260222
msgid "Turn on all upcoming D language features."
msgstr "Slå på alla kommande funktioner i språket D."

#. from tp:gcc-16.1-b20260222
msgid "Implement D bit-fields."
msgstr "Implementera D-bitfält."

#. from tp:gcc-16.1-b20260222
msgid "Implement DIP1000: Scoped pointers."
msgstr "Implementera DIP1000: pekare med räckvidd."

#. from tp:gcc-16.1-b20260222
msgid "Implement DIP1008: Allow exceptions in @nogc code."
msgstr "Implementera DIP1008: tillåt undantag i @nogc-kod."

#. from tp:gcc-16.1-b20260222
msgid "Implement DIP1021: Mutable function arguments."
msgstr "Implementera DIP1021: föränderliga funktionsargument."

#. from tp:gcc-16.1-b20260222
msgid "Destruct fields of partially constructed objects."
msgstr "Destruera fält i partiellt konstruerade objekt."

#. from tp:gcc-16.1-b20260222
msgid "Use field-wise comparisons for struct equality."
msgstr "Använd fältvisa jämförelser för postlikhet."

#. from tp:gcc-16.1-b20260222
msgid "When a symbol is resolved, check `alias this' scope before going to upper scopes."
msgstr "När en symbol löses upp, kontrollera räckvidden för ”alias this” innan högre räckvidder genomsöks."

#. from tp:gcc-16.1-b20260222
msgid "Disallow unsound immutable conversions that were formerly incorrectly permitted."
msgstr "Tillåt inte osunda oföränderliga konverteringar som tidigare felaktigt tilläts."

#. from tp:gcc-16.1-b20260222
msgid "Implement 'in' parameters to mean scope const."
msgstr "Implementera ”in”-parametrar att betyda räckvidds-const."

#. from tp:gcc-16.1-b20260222
msgid "Implement 'in' contracts of overridden methods to be a superset of parent contract."
msgstr "Implementera ”in”-kontrakt för åsidosatta metoder att vara en övermängd av föräldrakontraktet."

#. from tp:gcc-16.1-b20260222
msgid "Disable access to shared memory objects."
msgstr "Avaktivera åtkomst till delade minnesobjekt."

#. from tp:gcc-16.1-b20260222
msgid "Enable safety checks on all functions by default."
msgstr "Aktivera säkerhetskontroller av alla funktioner som standard."

#. from tp:gcc-16.1-b20260222
msgid "Enable rvalue arguments to ref parameters."
msgstr "Aktivera r-värdesargument till ref-parametrar."

#. from tp:gcc-16.1-b20260222
msgid "Disable access to variables marked `@system' from @safe code."
msgstr "Avaktivera åtkomst till varialer markerade ”@system” från @safe kod."

#. from tp:gcc-16.1-b20260222
msgid "Compile release version."
msgstr "Kompilera utgåveversion."

#. from tp:gcc-16.1-b20260222
msgid "Turn off all revertable D language features."
msgstr "Slå av alla återställbara funktioner i språket D."

#. from tp:gcc-16.1-b20260222
msgid "Revert DIP1000: Scoped pointers."
msgstr "Återställ DIP1000: pekare med räckvidd."

#. from tp:gcc-16.1-b20260222
msgid "Don't destruct fields of partially constructed objects."
msgstr "Destruera inte fält i partiellt konstruerade objekt."

#. from tp:gcc-16.1-b20260222
msgid "Don't use C-style integral promotion for unary '+', '-' and '~'."
msgstr "Använd inte heltalskonvertering i C-stil för unära ”+”, ”-” och ”~”."

#. from tp:gcc-16.1-b20260222
msgid "-fsave-mixins=<filename>	Expand and save mixins to file specified by <filename>."
msgstr "-fsave-mixins=<filnamn>	Expandera och spara mixin:er till en fil angiven av <filnamn>."

#. from tp:gcc-16.1-b20260222
msgid "Generate code for switches without a default case."
msgstr "Generera kod för switch:ar utan ett standardfall."

#. from tp:gcc-16.1-b20260222
msgid "List information on all D language transitions."
msgstr "Lista information om alla övergångar i språket D."

#. from tp:gcc-16.1-b20260222
msgid "List all non-mutable fields which occupy an object instance."
msgstr "Lista alla oföränderliga fält som upptar en objektinstans."

#. from tp:gcc-16.1-b20260222
msgid "List all usages of 'in' on parameter."
msgstr "Lista alla användningar av ”in” på parametrar."

#. from tp:gcc-16.1-b20260222
msgid "List all hidden GC allocations."
msgstr "Lista alla dolda GC-allokeringar."

#. from tp:gcc-16.1-b20260222
msgid "List statistics on template instantiations."
msgstr "Visa statistik om mallinstansieringar."

#. from tp:gcc-16.1-b20260222
msgid "List all variables going into thread local storage."
msgstr "Lista alla variabler som hamnar i trådlokal lagring."

#. from tp:gcc-16.1-b20260222
msgid "Compile in unittest code."
msgstr "Kompilera in enhetstestkod."

#. from tp:gcc-16.1-b20260222
msgid "-fversion=<ident>	Compile in version code identified by <ident>."
msgstr "-fversion=<ident>	Kompilera in versionskod identifierad av <ident>."

#. from tp:gcc-16.1-b20260222
msgid "Emit template instantiations as weak symbols."
msgstr "Skapa mallinstansieringar som svaga symboler."

#. from tp:gcc-16.1-b20260222
msgid "Do not link the standard D library in the compilation."
msgstr "Länka inte med standard-D-biblioteket i kompileringen."

#. from tp:gcc-16.1-b20260222
msgid "Link the standard D library statically in the compilation."
msgstr "Länka standard D-biblioteket statiskt i kompileringen."

#. from tp:gcc-16.1-b20260222
msgid "Link the standard D library dynamically in the compilation."
msgstr "Länka standard D-biblioteket dynamiskt i kompileringen."

#. from tp:gcc-16.1-b20260222
msgid "Conform to the 2024 D language edition."
msgstr "Följ D-språksutgåvan 2024."

#. from tp:gcc-16.1-b20260222
msgid "Conform to the latest 202Y D language edition (experimental)."
msgstr "Följ den senaste D-språksutgåvan 202Y (experimentellt)."

#. from tp:gcc-16.1-b20260222
msgid "a callee-copied argument is stored in the current function's frame"
msgstr "Ett argument som kopierats av den anropade lagras i den aktuella funktionens ram."

#. from tp:gcc-16.1-b20260222
