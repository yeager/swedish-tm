msgstr "NAMELIST-objektet %qs har USE-associerade PRIVATE-komponenter och kan inte vara medlem av namnlistan %qs vid %L"

#. from tp:gcc-16.1-b20260222
msgid "NAMELIST object %qs has PRIVATE components and cannot be a member of PUBLIC namelist %qs at %L"
msgstr "NAMELIST-objektet %qs har PRIVATE-komponenter och kan inte vara medlem av PUBLIC-namnlistan %qs vid %L"

