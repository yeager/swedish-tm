msgid "-d, --minimal                try hard to find a smaller set of changes"
msgstr "-d, --minimal                försök hitta en mindre mängd ändringar"

#. from tp:diffutils-3.10.242
msgid "-H, --speed-large-files      assume large files, many scattered small changes"
msgstr "-H, --speed-large-files      förutsätt stora filer och många spridda små ändringar"

#. from tp:diffutils-3.10.242
msgid "    --diff-program=PROGRAM   use PROGRAM to compare files"
msgstr "    --diff-program=PROGRAM   använd PROGRAM för att jämföra filer"

#. from tp:diffutils-3.10.242
msgid "    --help                   display this help and exit"
msgstr "    --help                   visa denna hjälp och avsluta"

#. from tp:diffutils-3.10.242
msgid "-v, --version                output version information and exit"
msgstr "-v, --version                visa versionsinformation och avsluta"

#. from tp:diffutils-3.10.242
msgid "Side-by-side merge of differences between FILE1 and FILE2."
msgstr "Sammanslagning sida vid sida av skillnader mellan FIL1 och FIL2."

#. from tp:diffutils-3.10.242
msgid "cannot interactively merge standard input"
msgstr "det går inte att slå samman standardindata interaktivt"

#. from tp:diffutils-3.10.242
msgid "both files to be compared are directories"
msgstr "båda objekten som ska jämföras är kataloger"

#. from tp:diffutils-3.10.242
msgid "ed:	Edit then use both versions, each decorated with a header.\neb:	Edit then use both versions.\nel or e1:	Edit then use the left version.\ner or e2:	Edit then use the right version.\ne:	Discard both versions then edit a new one.\nl or 1:	Use the left version.\nr or 2:	Use the right version.\ns:	Silently include common lines.\nv:	Verbosely include common lines.\nq:	Quit.\n"
msgstr "ed:\tRedigera och använd sedan båda versionerna, var och en med en rubrik.\neb:\tRedigera och använd sedan båda versionerna.\nel eller e1:\tRedigera och använd sedan vänstra versionen.\ner eller e2:\tRedigera och använd sedan högra versionen.\ne:\tFörkasta båda versionerna och redigera sedan en ny.\nl eller 1:\tAnvänd vänstra versionen.\nr eller 2:\tAnvänd högra versionen.\ns:\tTa med gemensamma rader utan utskrift.\nv:\tTa med gemensamma rader med utförlig utskrift.\nq:\tAvsluta.\n"

#. from tp:diffutils-3.10.242
