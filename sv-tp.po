msgstr "Spara de aktuella kommandona och kortkommandona som standard"

#. from tp:denemo-2.6-rc2
msgid "Manage Command Set"
msgstr "Hantera kommandouppsättning"

#. from tp:denemo-2.6-rc2
msgid "View help, change and save keyboard shortcuts"
msgstr "Visa hjälp, ändra och spara kortkommandon"

#. from tp:denemo-2.6-rc2
msgid "Swap Staffs"
msgstr "Byt plats på notsystem"

#. from tp:denemo-2.6-rc2
msgid "Swap this staff with the one higher up.\nBe aware that if you have inserted directives to move a voice to another staff\nthese may need re-making."
msgstr "Byt ut den här staven mot den högre upp.\nTänk på att om du har lagt in direktiv om att flytta en röst till en annan stab\nkan dessa behöva göras om."

#. from tp:denemo-2.6-rc2
msgid "Split Voices"
msgstr "Dela upp stämmor"

