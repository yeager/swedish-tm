msgstr "Upphängningsprydnad (Off/On)"

#. from tp:denemo-2.6-rc2
msgid "Tremblement Appuyé"
msgstr "Tremblement Appuyé"

#. from tp:denemo-2.6-rc2
msgid "Attaches tremblement appuyé to the note/chord at the cursor, or removes it if already present."
msgstr "Lägger till tremblement appuyé till noten/ackordet vid markören, eller tar bort det om det redan finns."

#. from tp:denemo-2.6-rc2
msgid "Tremblement"
msgstr "Förödmjukelse"

