msgstr "Diskgeometri matchar inte en DASD-enhet av typ 3390."

#. from tp:parted-3.4.64.2
msgid "device is too small for GPT"
msgstr "enheten är för liten för GPT"

#. from tp:parted-3.4.64.2
msgid "The format of the GPT partition table is version %x, which is newer than what Parted can recognise.  Please report this!"
msgstr "Formatet på GPT-partitionstabellen är version %x vilket är nyare än vad Parted kan känna igen.  Rapportera detta!"

#. from tp:parted-3.4.64.2
msgid "Not all of the space available to %s appears to be used, you can fix the GPT to use all of the space (an extra %llu blocks) or continue with the current setting? "
msgstr "Inte allt utrymme tillgängligt för %s verkar vara använt, du kan fixa GPT:n så att allt utrymme används (%llu block extra) eller fortsätta med de aktuella inställningar? "

#. from tp:parted-3.4.64.2
msgid "The backup GPT table is not at the end of the disk, as it should be.  Fix, by moving the backup to the end (and removing the old backup)?"
msgstr "Säkerhetskopian av GPT-tabellen finns inte i slutet på disken som den borde.  Fixa detta genom att flytta säkerhetskopia till slutet (och ta bort den gamla säkerhetskopian)?"

#. from tp:parted-3.4.64.2
msgid "Both the primary and backup GPT tables are corrupt.  Try making a fresh table, and using Parted's rescue feature to recover partitions."
msgstr "Både den primära och säkerhetskopian av GPT:n är korrupta.  Försök att skapa en ny tabell och använd Parteds räddningsfunktion för att återskapa partitioner."

#. from tp:parted-3.4.64.2
msgid "The backup GPT table is corrupt, but the primary appears OK, so that will be used."
msgstr "Säkerhetskopian av GPT:n är korrupt, men den primära verkar vara OK, så den används."

#. from tp:parted-3.4.64.2
msgid "The primary GPT table is corrupt, but the backup appears OK, so that will be used."
msgstr "Den primära GPT:n är korrupt, men säkerhetskopian verkar vara OK, så den används."

#. from tp:parted-3.4.64.2
msgid "primary partition table array CRC mismatch"
msgstr "crc-fel i primär partitionstabellsvektor"

#. from tp:parted-3.4.64.2
msgid "failed to translate partition name"
msgstr "kunde inte översätta partitionsnamn"

#. from tp:parted-3.4.64.2
msgid "Invalid signature %x for Mac disk labels."
msgstr "Ogiltig signatur %x för en Mac-disketikett."

#. from tp:parted-3.4.64.2
msgid "Partition map has no partition map entry!"
msgstr "Partitionstabellen saknar uppgift om sig själv!"

#. from tp:parted-3.4.64.2
msgid "%s is too small for a Mac disk label!"
msgstr "%s är för liten för en Mac-disketikett!"

#. from tp:parted-3.4.64.2
msgid "Partition %d has an invalid signature %x."
msgstr "Partition %d har en ogiltig signatur %x."

#. from tp:parted-3.4.64.2
msgid "Partition %d has an invalid length of 0 bytes!"
msgstr "Partition %d har en ogiltig längd, 0 byte!"

#. from tp:parted-3.4.64.2
msgid "The data region doesn't start at the start of the partition."
msgstr "Dataområdet börjar inte vid partitionens början."

#. from tp:parted-3.4.64.2
msgid "The partition's boot region doesn't occupy the entire partition."
msgstr "Partitionens startområde tar inte upp hela partitionens utrymme."

#. from tp:parted-3.4.64.2
msgid "The partition's data region doesn't occupy the entire partition."
msgstr "Partitionens dataområde tar inte upp hela partitionens utrymme."

#. from tp:parted-3.4.64.2
msgid "Weird block size on device descriptor: %d bytes is not divisible by 512."
msgstr "Konstig blockstorlek på enhetens handtag: %d byte är inte jämnt delbart med 512."

#. from tp:parted-3.4.64.2
msgid "The driver descriptor says the physical block size is %d bytes, but Linux says it is %d bytes."
msgstr "Enhetens handtag påstår att den fysiska blockstorleken är %d byte, men Linux påstår att den är %d byte."

#. from tp:parted-3.4.64.2
msgid "No valid partition map found."
msgstr "Ingen giltig partitionstabell kunde hittas."

#. from tp:parted-3.4.64.2
msgid "Conflicting partition map entry sizes!  Entry 1 says it is %d, but entry %d says it is %d!"
msgstr "Motsägelsefulla storleksdata i partitionstabellen! Post 1 påstår att den är %d, men post %d påstår att den är %d!"

#. from tp:parted-3.4.64.2
msgid "Weird!  There are 2 partitions map entries!"
msgstr "Konstigt! Det finns 2 poster i partitionstabellen!"

#. from tp:parted-3.4.64.2
msgid "Changing the name of a root or swap partition will prevent Linux from recognising it as such."
msgstr "Att ändra namnet på en rot- eller växlingspartition gör att Linux inte kan känna igen dem."

#. from tp:parted-3.4.64.2
msgid "Can't add another partition -- the partition map is too small!"
msgstr "Kan inte lägga till ytterligare en partition -- partitionstabellen är för liten!"

#. from tp:parted-3.4.64.2
msgid "Invalid partition table on %s."
msgstr "Ogiltig partitionstabell på %s."

#. from tp:parted-3.4.64.2
msgid "Partition %d isn't aligned to cylinder boundaries.  This is still unsupported."
msgstr "Partition %d ligger inte på jämna cylindergränser.  Detta stöds fortfarande inte."

#. from tp:parted-3.4.64.2
msgid "Can't add another partition."
msgstr "Kan inte lägga till ännu en partition."

#. from tp:parted-3.4.64.2
msgid "partition length of %jd sectors exceeds the %s-partition-table-imposed maximum of %jd"
msgstr "partitionslängden på %jd sektorer överstiger maximum för %s-partition-table-imposed på %jd"

#. from tp:parted-3.4.64.2
msgid "starting sector number, %jd exceeds the %s-partition-table-imposed maximum of %jd"
msgstr "sektornumret för början, %jd överstiger maximum för %s-partition-table-imposed maximum på %jd"

#. from tp:parted-3.4.64.2
msgid "%s : Bad checksum on block %llu of type %s."
msgstr "%s : Felaktig kontrollsumma på block %llu av typen %s."

#. from tp:parted-3.4.64.2
msgid "%s : Didn't find rdb block, should never happen."
msgstr "%s : Hittade inte rdb-blocket, detta ska aldrig hända."

#. from tp:parted-3.4.64.2
msgid "%s : Loop detected at block %d."
msgstr "%s : Slinga upptäcktes på block %d."

#. from tp:parted-3.4.64.2
msgid "%s : The %s list seems bad at block %s."
msgstr "%s : %s-listan verkar vara felaktig på block %s."

#. from tp:parted-3.4.64.2
msgid "%s : Failed to list bad blocks."
msgstr "%s : Misslyckades med att lista felaktiga block."

