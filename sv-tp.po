msgid "  -0, --null                   items are separated by a null, not whitespace;\n                                 disables quote and backslash processing and\n                                 logical EOF processing\n"
msgstr "  -0, --null                   saker avgränsas av noll, inte blanktecken;\n                                 inaktiverar behandling av citationstecken och\n                                 omvänt snedstreck samt behandling av logiskt\n                                 filslut\n"

