#. from tp:sharutils-4.15.2
msgid "unshar (GNU sharutils) - unpack a shar archive\nUsage:  %s [ -<flag> [<val>] | --<name>[{=| }<val>] ]... [<file>...]\n"
msgstr "unshar (GNU sharutils) - packa upp ett shar-arkiv\nAnvändning:  %s [ -<flagga> [<värde>] | --<namn>[{=| }<värde>] ]… [<fil>…]\n"

#. from tp:sharutils-4.15.2
msgid "\nIf no arguments are provided, input arguments are read from stdin,\none per line; blank and '#'-prefixed lines are comments.\n'stdin' may not be a terminal (tty).\n"
msgstr "\nOm inga argument anges kommer indataargument att läsas från standard\nin, ett per rad; tomma rader och rader som prefixas med ”#” är kommentarer.\n”stdin” får inte vara en terminal (tty).\n"

#. from tp:sharutils-4.15.2
msgid "Unshar scans the input files (typically email messages) looking for the\nstart of a shell archive.  If no files are given, then standard input is\nprocessed instead.  It then passes each archive discovered through an\ninvocation of the shell program to unpack it.\n"
msgstr "Unshar letar genom indatafiler (typiskt e-postmeddelanden) efter början\npå ett skalarkiv. Om inga filer anges kommer standard in att behandlas\nistället. Det skickar sedan varje identifierat arkiv genom en körning av\nskalprogrammet för att packa upp det.\n"

#. from tp:sharutils-4.15.2
msgid "unshar (GNU sharutils) 4.15.2"
msgstr "unshar (GNU sharutils) 4.15.2"

#. from tp:sharutils-4.15.2
msgid "unshar (GNU sharutils) - unpack a shar archive\nUsage:  unshar [ -<flag> [<val>] | --<name>[{=| }<val>] ]... [<file>...]\n\n"
msgstr "unshar (GNU sharutils) - packa upp ett shar-arkiv\nAnvändning:  unshar [ -<flagga> [<värde>] | --<namn>[{=| }<värde>] ]… [<fil>…]\n\n"

#. from tp:sharutils-4.15.2
msgid "   -d, --directory=DIR        unpack into the directory DIR\n"
msgstr "   -d, --directory=KAT        dekomprimera i katalogen KAT\n"

#. from tp:sharutils-4.15.2
msgid "   -c, --overwrite            overwrite any pre-existing files\n"
msgstr "   -c, --overwrite            skriv över filer som redan existerar\n"

#. from tp:sharutils-4.15.2
msgid "   -f, --force                an alias for the 'overwrite' option\n"
msgstr "   -f, --force                ett alias för flaggan ”overwrite”\n"

#. from tp:sharutils-4.15.2
msgid "   -E, --split-at=SPLIT-PAT   split input on SPLIT-PAT lines\n"
msgstr "   -E, --split-at=DELN-MÖNST  dela indata på DELN-MÖNST-rader\n"

#. from tp:sharutils-4.15.2
msgid "   -e, --exit-0               split input on \"exit 0\" lines\n                                - prohibits the option 'split-at'\n"
msgstr "   -e, --exit-0               dela indata på ”exit 0”-rader\n                                - förbjuder flaggan ”split-at”\n"

#. from tp:sharutils-4.15.2
msgid "   -D, --debug                debug the shell code\n"
msgstr "   -D, --debug                felsök skalkoden\n"

#. from tp:sharutils-4.15.2
msgid "   -R, --save-opts[=FILE]     save the option state to the config file FILE\n"
msgstr "   -R, --save-opts[=FIL]      spara flaggtillståndet till konfigurationsfilen FIL\n"

#. from tp:sharutils-4.15.2
msgid "   -r, --load-opts=FILE       load options from the config file FILE\n                                - disabled as '--no-load-opts'\n                                - may appear multiple times\n\n"
msgstr "   -r, --load-opts=FIL        läs in flaggor från konfigurationsfilen FIL\n                                - inaktiveras som ”--no-load-opts”\n                                - får förekomma flera gånger\n\n"

#. from tp:sharutils-4.15.2
msgid "Options are specified by doubled hyphens and their name or by a single\nhyphen and the flag character.\n\n"
msgstr "Flaggor anges med dubbla bindestreck och deras namn eller med ett\nenkelt bindestreck och flaggtecknet.\n\n"

#. from tp:sharutils-4.15.2
msgid "If no arguments are provided, input arguments are read from stdin,\none per line; blank and '#'-prefixed lines are comments.\n'stdin' may not be a terminal (tty).\n\n"
msgstr "Om inga argument anges kommer indataargument att läsas från standard\nin, ett per rad; tomma rader och rader som prefixas med ”#” är kommentarer.\n”stdin” får inte vara en terminal (tty).\n\n"

#. from tp:sharutils-4.15.2
msgid " - reading file $HOME/.sharrc\n\n'unshar' scans the input files (typically email messages) looking for the\nstart of a shell archive.  If no files are given, then standard input is\nprocessed instead.  It then passes each archive discovered through an\ninvocation of the shell program to unpack it.\n\n"
msgstr " - läser filen $HOME/.sharrc\n\n'unshar' letar genom indatafilerna (typiskt e-postmeddelanden) och letar\nefter början på ett skalarkiv. Om inga filer anges kommer standard in att\nbehandlas istället. Det skickar sedan varje hittat arkiv genom en körning\nav skalprogrammet för att packa upp det.\n\n"

#. from tp:sharutils-4.15.2
msgid "Please send bug reports to:  <bug-gnu-utils@gnu.org>\n"
msgstr "Skicka felrapporter till:  <bug-gnu-utils@gnu.org>\nSkicka synpunkter på översättningen till: tp-sv@listor.tp-sv.org>\n"

