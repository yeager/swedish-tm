msgid "Add Note"
msgstr "Lägg till not"

#. from tp:denemo-2.6-rc2
msgid "Menu:\nAdding notes to a note or chord at the cursor to make chords"
msgstr "Meny - Lägg till noter\nLägga till noter till en not eller ett ackord vid markören för att skapa ackord"

#. from tp:denemo-2.6-rc2
msgid "Chords Symbols"
msgstr "Ackordsymboler"

#. from tp:denemo-2.6-rc2
msgid "Menu:\nAdding Chord Symbols over music"
msgstr "Meny:\nLägga till ackordsymboler över musik"

#. from tp:denemo-2.6-rc2
msgid "Figured Bass"
msgstr "Generalbas"

#. from tp:denemo-2.6-rc2
msgid "Menu:\nAdding Figured Bass Figures"
msgstr "Meny:\nLägga till generalbassiffror"

#. from tp:denemo-2.6-rc2
msgid "Measures"
msgstr "Takter"

#. from tp:denemo-2.6-rc2
msgid "Menu:\nMeasures: adding, deleting, navigating etc"
msgstr "Meny:\nTakter: lägga till, ta bort, navigera etc"

#. from tp:denemo-2.6-rc2
msgid "Menu:\nInserting notes, measures, staffs, keysignatures etc"
msgstr "Meny:\nInfoga noter, takter, notsystem, tonartsbeteckningar etc"

#. from tp:denemo-2.6-rc2
msgid "Add Staff"
msgstr "Lägg till notsystem"

#. from tp:denemo-2.6-rc2
msgid "Menu:\nInsert a new staff postioned relative to current staff"
msgstr "Meny:\nInfoga ett nytt notsystem i förhållande till det aktuella notsystemet"

#. from tp:denemo-2.6-rc2
msgid "Insert Movement"
msgstr "Infoga sats"

#. from tp:denemo-2.6-rc2
msgid "Menu:\nInsert a new movement positioned relative to current movement"
msgstr "Meny:\nInfoga en ny rörelse placerad i förhållande till den aktuella rörelsen"

#. from tp:denemo-2.6-rc2
msgid "Insert at Cursor"
msgstr "Infoga vid markör"

#. from tp:denemo-2.6-rc2
msgid "Menu:\nInserting notes of a given duration at cursor note height"
msgstr "Meny:\nInfoga noter med en viss tidsvärde på markörens tonhöjd"

#. from tp:denemo-2.6-rc2
msgid "Change"
msgstr "Ändra"

#. from tp:denemo-2.6-rc2
