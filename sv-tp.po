msgid "  -a, --[fetch]all  retrieve old and new messages\n"
msgstr "  -a, --[fetch]all  hämta gamla och nya meddelanden\n"

#. from tp:fetchmail-6.6.0.rc3
msgid "  -K, --nokeep      delete new messages after retrieval\n"
msgstr "  -K, --nokeep      ta bort nya meddelanden efter hämtning\n"

#. from tp:fetchmail-6.6.0.rc3
msgid "  -k, --keep        save new messages after retrieval\n"
msgstr "  -k, --keep        spara nya meddelanden efter hämtning\n"

#. from tp:fetchmail-6.6.0.rc3
msgid "      --moveto      move message to the given IMAP folder instead of deleting it\n"
msgstr "      --moveto      flytta meddelandet till den angivna IMAP-mappen i stället för att ta bort det\n"

