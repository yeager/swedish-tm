#. from tp:m4-1.4.21
msgid "Warning: definition of `%s' contains sequence `%s'"
msgstr "Varning: definition av ”%s” innehåller sekvens ”%s”"

#. from tp:m4-1.4.21
msgid "error checking --warn-macro-sequence for macro `%s'"
