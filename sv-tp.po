msgid "  -C, --line-bytes=SIZE\n         put at most SIZE bytes of records per output file\n"
msgstr "  -C, --line-bytes=STORLEK\n         placera max STORLEK byte med poster per utfil\n"

#. from tp:coreutils-9.10-pre1
