msgid "Fatal error while reencrypting chunk starting at %<PRIu64>, %<PRIu64> sectors long."
msgstr "Ödesdigert fel vid omkryptering av ett stycke som börjar vid %<PRIu64> och är %<PRIu64> sektorer långt."

#. from tp:cryptsetup-2.8.2-rc0
msgid "Online reencryption failed."
msgstr "Omkryptering under drift misslyckades."

