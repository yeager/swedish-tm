#. from tp:gettext-tools-1.0-pre2
msgid "Extract translatable strings from given input files.\n"
msgstr "Extrahera översättbara strängar från givna infiler.\n"

#. from tp:gettext-tools-1.0-pre2
msgid "  -d, --default-domain=NAME   use NAME.po for output (instead of messages.po)\n"
msgstr "  -d, --default-domain=NAMN   använd NAMN.po som utfil (istället för messages.po)\n"

#. from tp:gettext-tools-1.0-pre2
msgid "  -o, --output=FILE           write output to specified file\n"
msgstr "  -o, --output=FIL            skriv resultatet till FIL\n"

#. from tp:gettext-tools-1.0-pre2
msgid "  -p, --output-dir=DIR        output files will be placed in directory DIR\n"
msgstr "  -p, --output-dir=KATALOG    utfiler placeras i katalogen KATALOG\n"

#. from tp:gettext-tools-1.0-pre2
msgid "Choice of input file language:\n"
msgstr "Språkval i infiler:\n"

#. from tp:gettext-tools-1.0-pre2
msgid "  -L, --language=NAME         recognise the specified language\n                                (C, C++, ObjectiveC, PO, Python, Java,\n                                JavaProperties, C#, JavaScript, TypeScript, TSX,\n                                Scheme, Guile, Lisp, EmacsLisp, librep, Rust,\n                                Go, Ruby, Shell, awk, Lua, Modula-2, D, OCaml,\n                                Smalltalk, Vala, Tcl, Perl, PHP, GCC-source,\n                                YCP, NXStringTable, RST, RSJ, Glade, GSettings,\n                                Desktop)\n"
msgstr "  -L, --language=NAMN         känn igen det angivna språket\n                                (C, C++, ObjectiveC, PO, Python, Java,\n                                JavaProperties, C#, JavaScript, TypeScript, TSX,\n                                Scheme, Guile, Lisp, EmacsLisp, librep, Rust,\n                                Go, Ruby, Shell, awk, Lua, Modula-2, D, OCaml,\n                                Smalltalk, Vala, Tcl, Perl, PHP, GCC-source,\n                                YCP, NXStringTable, RST, RSJ, Glade, GSettings,\n                                Desktop)\n"

#. from tp:gettext-tools-1.0-pre2
msgid "  -C, --c++                   shorthand for --language=C++\n"
msgstr "  -C, --c++                   samma som --language=C++\n"

#. from tp:gettext-tools-1.0-pre2
msgid "By default the language is guessed depending on the input file name extension.\n"
msgstr "I normalläge gissas språket från filändelsen på infilen.\n"

#. from tp:gettext-tools-1.0-pre2
msgid "      --from-code=NAME        encoding of input files\n                                (except for Python, Tcl, Glade)\n"
msgstr "      --from-code=NAMN        kodning av infiler\n                                (utom för Python, Tcl, Glade)\n"

#. from tp:gettext-tools-1.0-pre2
msgid "By default the input files are assumed to be in ASCII.\n"
msgstr "Som standard antas indatafilerna vara ASCII-kodade.\n"

#. from tp:gettext-tools-1.0-pre2
msgid "  -j, --join-existing         join messages with existing file\n"
msgstr "  -j, --join-existing         slå ihop meddelanden med existerande fil\n"

#. from tp:gettext-tools-1.0-pre2
msgid "  -x, --exclude-file=FILE.po  entries from FILE.po are not extracted\n"
msgstr "  -x, --exclude-file=FIL.po   poster från FIL.po extraheras inte\n"

#. from tp:gettext-tools-1.0-pre2
msgid "  -cTAG, --add-comments=TAG   place comment blocks starting with TAG and\n                                preceding keyword lines in output file\n  -c, --add-comments          place all comment blocks preceding keyword lines\n                                in output file\n"
msgstr "  -cMÄRKE, --add-comments=MÄRKE  skriv kommentarsblock som börjar med MÄRKE\n                                 och föregående nyckelordsrader till resultatet\n  -c, --add-comments             skriv alla kommentarsblock före nyckelordsrader\n                                 till resultatet\n"

#. from tp:gettext-tools-1.0-pre2
msgid "      --check=NAME            perform syntax check on messages\n                                (ellipsis-unicode, space-ellipsis,\n                                 quote-unicode, bullet-unicode)\n"
msgstr "      --check=NAMN            utför syntaxkontroll av meddelanden\n                                (ellipsis-unicode, space-ellipsis,\n                                 quote-unicode, bullet-unicode)\n"

#. from tp:gettext-tools-1.0-pre2
msgid "      --no-check=NAME         don't perform syntax check on messages\n                                (url, email)\n"
msgstr "      --check=NAMN            utför inte syntaxkontroll av meddelanden\n                                (url, email)\n"

#. from tp:gettext-tools-1.0-pre2
msgid "      --sentence-end=TYPE     type describing the end of sentence\n                                (single-space, which is the default, \n                                 or double-space)\n"
msgstr "      --sentence-end=TYP      typen beskriver slut på meningar\n                                (single-space, som är standard, \n                                 eller double-space)\n"

