msgstr "Lägg till en liten sekund som ackordnot i förhållande till den högsta tonen nedåt."

#. from tp:denemo-2.6-rc2
msgid "Add Minor 3rd below top"
msgstr "Lägg till moll 3:e under toppen"

#. from tp:denemo-2.6-rc2
msgid "Add a minor third as chordnote relative to the highest note downwards."
msgstr "Lägg till en liten terts som ackordnot i förhållande till den högsta tonen nedåt."

#. from tp:denemo-2.6-rc2
msgid "Add Minor 6th below top"
msgstr "Lägg till liten sext under översta tonen"

#. from tp:denemo-2.6-rc2
msgid "Add a minor sixth as chordnote relative to the highest note downwards."
msgstr "Lägg till en liten sext som ackordnot i förhållande till den högsta tonen nedåt."

#. from tp:denemo-2.6-rc2
msgid "Add Minor 7th below top"
msgstr "Lägg till liten septima under översta tonen"

#. from tp:denemo-2.6-rc2
msgid "Add a minor seventh as chordnote relative to the highest note downwards."
msgstr "Lägg till en liten septim som ackordnot i förhållande till den högsta tonen nedåt."

#. from tp:denemo-2.6-rc2
msgid "Add Perfect 1st below top"
msgstr "Lägg till ren prim under översta tonen"

#. from tp:denemo-2.6-rc2
msgid "Add a perfect prime as chordnote relative to the highest note downwards."
msgstr "Lägg till en perfekt grundton som ackordnot i förhållande till den högsta tonen nedåt."

#. from tp:denemo-2.6-rc2
msgid "Add Perfect 4th below top"
msgstr "Lägg till ren kvart under översta tonen"

#. from tp:denemo-2.6-rc2
msgid "Add a perfect fourth as chordnote relative to the highest note downwards."
msgstr "Lägg till en perfekt kvart som ackordnot i förhållande till den högsta tonen nedåt."

#. from tp:denemo-2.6-rc2
msgid "Add Perfect 5th below top"
msgstr "Lägg till ren kvint under översta tonen"

#. from tp:denemo-2.6-rc2
