msgstr "Det går inte att avgöra om enheten %s är aktiverad eller inte.\nÄr du säker på att du vill fortsätta omkrypteringen i offlineläge?\nDet kan leda till dataskador om enheten faktiskt är aktiverad.\nFör att kryptera om under drift, använd parametern --active-name i stället.\n"

#. from tp:cryptsetup-2.8.2-rc0
msgid "Device %s is not a block device. Can not auto-detect if it is active or not.\nUse --force-offline-reencrypt to bypass the check and run in offline mode (dangerous!)."
msgstr "Enheten %s är inte en blockenhet. Det går inte att automatiskt upptäcka om den är aktiv eller inte.\nAnvänd --force-offline-reencrypt för att kringgå kontrollen och köra i offline-läge (farligt!)."

#. from tp:cryptsetup-2.8.2-rc0
msgid "Requested --resilience option cannot be applied to current reencryption operation."
msgstr "Det går inte att tillämpa begärd flagga --resilience på aktuell omkrypteringsåtgärd."

#. from tp:cryptsetup-2.8.2-rc0
msgid "Device is not in LUKS2 encryption. Conflicting option --encrypt."
msgstr "Enheten är inte under LUKS2-kryptering. Motsägelsefull flagga --encrypt."

#. from tp:cryptsetup-2.8.2-rc0
msgid "Device is not in LUKS2 decryption. Conflicting option --decrypt."
msgstr "Enheten är inte i LUKS2-dekryptering. Motsägelsefull flagga --decrypt."

#. from tp:cryptsetup-2.8.2-rc0
msgid "Device is in reencryption using datashift resilience. Requested --resilience option cannot be applied."
msgstr "Enheten omkrypteras med återhämtningsskydd av typen datashift. Den begärda flaggan --resilience kan inte tillämpas."

#. from tp:cryptsetup-2.8.2-rc0
msgid "Cannot determine volume key size for LUKS without keyslots, please use --new-key-size option."
msgstr "Det går inte att avgöra volymens nyckelstorlek för LUKS utan nyckelplatser, använd flaggan --new-key-size."

#. from tp:cryptsetup-2.8.2-rc0
msgid "Device requires reencryption recovery. Run repair first."
msgstr "Enheten kräver omkrypteringsåterställning. Starta repair först."

#. from tp:cryptsetup-2.8.2-rc0
msgid "Device %s is already in LUKS2 reencryption. Do you wish to resume previously initialised operation?"
msgstr "Enheten %s är redan under LUKS2-omkryptering. Vill du återuppta tidigare initierad åtgärd?"

#. from tp:cryptsetup-2.8.2-rc0
msgid "Legacy LUKS2 reencryption is no longer supported."
msgstr "Stöder inte längre föråldrad LUKS2-omkryptering."

#. from tp:cryptsetup-2.8.2-rc0
msgid "Can not reencrypt LUKS2 device configured to use OPAL."
msgstr "Det går inte att kryptera om LUKS2-enhet som konfigurerats för att använda OPAL."

#. from tp:cryptsetup-2.8.2-rc0
msgid "Reencryption of device with integrity profile is not supported."
msgstr "Omkryptering för enhet med integritetsprofil stöds inte."

#. from tp:cryptsetup-2.8.2-rc0
msgid "Requested --sector-size %<PRIu32> is incompatible with %s superblock\n(block size: %<PRIu32> bytes) detected on device %s."
msgstr "Begärd --sector-size %<PRIu32> är inkompatibel med superblock %s\n(blockstorlek: %<PRIu32> byte) identifierad på enheten %s."

#. from tp:cryptsetup-2.8.2-rc0
msgid "Encryption without detached header (--header) is not possible without data device size reduction (--reduce-device-size)."
msgstr "Kryptering utan fristående huvud (--header) är inte möjlig utan att minska dataenhetens storlek (--reduce-device-size)."

#. from tp:cryptsetup-2.8.2-rc0
msgid "Requested data offset must be less than or equal to half of --reduce-device-size parameter."
msgstr "Begärd dataförskjutning måste vara mindre än eller lika med hälften av parametern --reduce-device-size."

#. from tp:cryptsetup-2.8.2-rc0
msgid "Adjusting --reduce-device-size value to twice the --offset %<PRIu64> (sectors).\n"
msgstr "Justerar --reduce-device-size-värdet till dubbla --offset %<PRIu64> (sektorer).\n"

#. from tp:cryptsetup-2.8.2-rc0
msgid "Temporary header file %s already exists. Aborting."
msgstr "Tillfällig huvudfil %s finns redan. Avbryter."

#. from tp:cryptsetup-2.8.2-rc0
msgid "Cannot create temporary header file %s."
msgstr "Det går inte att skapa tillfällig huvudfil %s."

#. from tp:cryptsetup-2.8.2-rc0
msgid "LUKS2 metadata size is larger than data shift value."
msgstr "LUKS2-metadatastorleken är större än dataskift-värdet."

#. from tp:cryptsetup-2.8.2-rc0
msgid "Failed to place new header at head of device %s."
msgstr "Misslyckades med att placera nytt huvud i början på enheten %s."

#. from tp:cryptsetup-2.8.2-rc0
msgid "%s/%s is now active and ready for online encryption.\n"
msgstr "%s/%s är nu aktiv och redo för kryptering under drift.\n"

#. from tp:cryptsetup-2.8.2-rc0
msgid "Active device %s is not LUKS2."
msgstr "Aktiva enheten: %s är inte LUKS2."

#. from tp:cryptsetup-2.8.2-rc0
msgid "Restoring original LUKS2 header."
msgstr "Återställer ursprungligt LUKS2-huvud."

#. from tp:cryptsetup-2.8.2-rc0
msgid "Original LUKS2 header restore failed."
msgstr "Misslyckades med återställning av ursprungligt LUKS2-huvud."

#. from tp:cryptsetup-2.8.2-rc0
msgid "Header file %s does not exist. Do you want to initialize LUKS2 decryption of device %s and export LUKS2 header to file %s?"
msgstr "Huvudfilen %s finns inte. Vill du initiera LUKS2-dekryptering av enheten %s och exportera LUKS2-huvudet till filen %s?"

#. from tp:cryptsetup-2.8.2-rc0
msgid "Failed to add read/write permissions to exported header file."
msgstr "Misslyckades med att lägga till läs- och skrivbehörighet för den exporterade huvudfilen."

#. from tp:cryptsetup-2.8.2-rc0
msgid "Reencryption initialization failed. Header backup is available in %s."
msgstr "Misslyckades med initiering av omkryptering. Säkerhetskopian av huvudet är tillgänglig i %s."

#. from tp:cryptsetup-2.8.2-rc0
msgid "LUKS2 decryption is supported with detached header device only (with data offset set to 0)."
msgstr "LUKS2-dekryptering stöds endast för enheter med fristående huvud (med dataförskjutning satt till 0)."

#. from tp:cryptsetup-2.8.2-rc0
msgid "No token could unlock the device."
msgstr "Ingen token kunde låsa upp enheten."

#. from tp:cryptsetup-2.8.2-rc0
msgid "Not enough free keyslots for reencryption."
msgstr "Inte nog med fria nyckelplatser för omkryptering."

#. from tp:cryptsetup-2.8.2-rc0
msgid "Key file or keyring key description can be used only with --key-slot or with exactly one key slot active."
msgstr "Nyckelfil eller nyckelringsnyckelbeskrivning kan endast användas med --key-slot eller precis en aktiv nyckelplats."

#. from tp:cryptsetup-2.8.2-rc0
msgid "Enter passphrase for key slot %d: "
msgstr "Ange lösenfras för nyckelplats %d: "

#. from tp:cryptsetup-2.8.2-rc0
msgid "Switching data encryption cipher to %s.\n"
msgstr "Byter krypteringschiffer till %s.\n"

#. from tp:cryptsetup-2.8.2-rc0
msgid "Use --force-no-keyslots to reencrypt device with active keyslots by passing volume keys directly."
msgstr "Använd --force-no-keyslots för att omkryptera enheten med aktiva nyckelplatser genom att ange volymnycklar direkt."

#. from tp:cryptsetup-2.8.2-rc0
msgid "Option --new-volume-key-file must be paired with --new-key-size"
msgstr "Flaggan --new-volume-key-file måste kombineras med --new-key-size"

#. from tp:cryptsetup-2.8.2-rc0
msgid "No data segment parameters changed. Reencryption aborted."
msgstr "Inga parametrar för datasegment ändrades. Omkryptering avbruten."

#. from tp:cryptsetup-2.8.2-rc0
msgid "Encryption sector size increase on offline device is not supported.\nActivate the device first or use --force-offline-reencrypt option (dangerous!)."
msgstr "Ökning av krypteringssektorstorleken på en enhet i offlineläge stöds inte.\nAktivera enheten först eller använd flaggan --force-offline-reencrypt (farligt!)."

#. from tp:cryptsetup-2.8.2-rc0
msgid "\nReencryption interrupted."
msgstr "\nOmkryptering avbruten."

#. from tp:cryptsetup-2.8.2-rc0
msgid "Resuming LUKS reencryption in forced offline mode.\n"
msgstr "Återupptar LUKS-omkryptering i framtvingat offlineläge.\n"

#. from tp:cryptsetup-2.8.2-rc0
msgid "Device %s contains broken LUKS metadata. Aborting operation."
msgstr "Enheten %s innehåller felaktig LUKS-metadata. Avbryter åtgärden."

#. from tp:cryptsetup-2.8.2-rc0
msgid "Device %s is already LUKS device. Aborting operation."
msgstr "Enheten %s är redan en LUKS-enhet. Avbryter åtgärd."

#. from tp:cryptsetup-2.8.2-rc0
msgid "Device %s is already in LUKS reencryption. Aborting operation."
msgstr "Enheten %s är redan i LUKS-omkryptering. Avbryter åtgärd."

#. from tp:cryptsetup-2.8.2-rc0
msgid "LUKS2 decryption requires --header option."
msgstr "LUKS2-dekryptering kräver flaggan --header."

#. from tp:cryptsetup-2.8.2-rc0
msgid "Command requires device as argument."
msgstr "Kommandot kräver en enhet som argument."

