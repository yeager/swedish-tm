msgid "Create and Extend Selection"
msgstr "Skapa och utöka markeringen"

#. from tp:denemo-2.6-rc2
msgid "Create/Extend the selection."
msgstr "Skapa/utöka markeringen."

#. from tp:denemo-2.6-rc2
msgid "Copy the music selected to the Denemo clipboard"
msgstr "Kopiera den markerade musiken till Denemos urklipp"

#. from tp:denemo-2.6-rc2
msgid "Cut the music selected to the Denemo clipboard"
msgstr "Klipp ut den markerade musiken till Denemos urklipp"

#. from tp:denemo-2.6-rc2
msgid "Paste the Denemo clipboard into the score where the cursor is positioned"
msgstr "Klistra in innehållet i Denemos urklipp i partituret där markören står"

#. from tp:denemo-2.6-rc2
msgid "Paste LilyPond notes"
msgstr "Klistra in LilyPond-noter"

#. from tp:denemo-2.6-rc2
msgid "Paste LilyPond notes from the text clipboard\nThis will import music written as LilyPond syntax\nYou open the LilyPond file in a texteditor, copy the stretch of notes (control-c command in your texteditor usually) and then use this command."
msgstr "Klistra in LilyPond-noter från texturklippet\nDetta importerar musik skriven med LilyPond-syntax.\nÖppna LilyPond-filen i en textredigerare, kopiera följden av noter (vanligtvis med Ctrl+C i textredigeraren) och använd sedan detta kommando."

#. from tp:denemo-2.6-rc2
msgid "Paste a Comment"
msgstr "Klistra in en kommentar"

#. from tp:denemo-2.6-rc2
msgid "Paste the text clipboard as a comment inserted at the cursor."
msgstr "Klistra in texten i urklippet som en kommentar vid markören."

