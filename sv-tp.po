msgstr "@exstrong{EXEMPEL}\n       foo    gör ingenting\n\n"

#. from tp:help2man-texi-1.47.17
msgid "       foo @exstrong{--option}\n              the same thing, giving `--option'\n\n"
msgstr "       foo @exstrong{--flagga}\n              samma sak med ”--flagga”\n\n"

#. from tp:help2man-texi-1.47.17
msgid "@exstrong{AUTHOR}\n       Written by A. Programmer.\n\n"
msgstr "@exstrong{UPPHOVSMAN}\n       Skrivet av E. N. Programmerare.\n\n"

#. from tp:help2man-texi-1.47.17
msgid "@exstrong{REPORTING BUGS}\n       Report bugs to <bug-gnu-utils@@gnu.org>.\n\n"
msgstr "@exstrong{RAPPORTERA FEL}\n       Rapportera fel till <bug-gnu-utils@@gnu.org>.\n\n"

