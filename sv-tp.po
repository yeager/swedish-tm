msgstr "Meny:\nLägga till eller redigera tidsvärden"

#. from tp:denemo-2.6-rc2
msgid "Cursor"
msgstr "Markör"

#. from tp:denemo-2.6-rc2
msgid "Menu:\nMoving the cursor"
msgstr "Meny:\nFlytta markören"

#. from tp:denemo-2.6-rc2
