msgstr "misslyckades med att ta status"

#. from tp:coreutils-9.10-pre1
msgid "read failed"
msgstr "misslyckades med att läsa"

#. from tp:coreutils-9.10-pre1
msgid "string transformation failed"
msgstr "strängtransformation misslyckades"

#. from tp:coreutils-9.10-pre1
msgid "the original string was %s"
msgstr "originalsträngen var %s"

#. from tp:coreutils-9.10-pre1
msgid "^ no match for key\n"
msgstr "^ ingen match för nyckel\n"

#. from tp:coreutils-9.10-pre1
msgid "obsolescent key %s used; consider %s instead"
msgstr "förlegad nyckel %s använd, överväg %s istället"

#. from tp:coreutils-9.10-pre1
msgid "key %lu has zero width and will be ignored"
msgstr "nyckel %lu har noll bredd och kommer att ignoreras"

#. from tp:coreutils-9.10-pre1
msgid "leading blanks are significant in key %lu; consider also specifying 'b'"
msgstr "inledande blanksteg är betydande i nyckel %lu, överväg att även ange ”b”"

#. from tp:coreutils-9.10-pre1
msgid "key %lu is numeric and spans multiple fields"
msgstr "nyckel %lu är numerisk och spänner över flera fält"

#. from tp:coreutils-9.10-pre1
msgid "field separator %s is treated as a group separator in numbers"
msgstr "fältseparatorn %s behandlas som en gruppseparator i tal"

#. from tp:coreutils-9.10-pre1
msgid "field separator %s is treated as a decimal point in numbers"
msgstr "fältseparatorn %s behandlas som ett decimaltecken i tal"

#. from tp:coreutils-9.10-pre1
msgid "field separator %s is treated as a minus sign in numbers"
msgstr "fältseparatorn %s behandlas som ett minustecken i tal"

#. from tp:coreutils-9.10-pre1
msgid "field separator %s is treated as a plus sign in numbers"
msgstr "fältseparatorn %s behandlas som ett plustecken i tal"

#. from tp:coreutils-9.10-pre1
msgid "numbers use %s as a decimal point in this locale"
msgstr "tal använder %s som ett decimaltecken i denna lokal"

#. from tp:coreutils-9.10-pre1
msgid "the multi-byte number group separator in this locale is not supported"
msgstr "talgruppsseparatorn i denna lokal består av flera byte och stöds inte"

#. from tp:coreutils-9.10-pre1
msgid "option '-r' only applies to last-resort comparison"
msgstr "flaggan ”-r” gäller bara jämförelsen som används som sista utväg"

#. from tp:coreutils-9.10-pre1
msgid "write failed"
msgstr "misslyckades med att skriva"

#. from tp:coreutils-9.10-pre1
msgid "%s: %s:%ju: disorder: "
msgstr "%s: %s:%ju: oordning: "

#. from tp:coreutils-9.10-pre1
msgid "standard error"
msgstr "standard fel"

#. from tp:coreutils-9.10-pre1
msgid "%s: invalid field specification %s"
msgstr "%s: felaktig fältspecifikation %s"

#. from tp:coreutils-9.10-pre1
msgid "options '-%s' are incompatible"
msgstr "flaggorna ”-%s” är inkompatibla"

#. from tp:coreutils-9.10-pre1
