msgstr "@exstrong{BESKRIVNING}\n       GNU ”foo” gör ingenting intressant förutom att fungera som exempel\n       för ”help2man”.\n\n"

#. from tp:help2man-texi-1.47.17
msgid "@exstrong{OPTIONS}\n       @exstrong{-a}, @exstrong{--option}\n              an option\n\n"
