msgstr "Kan inte hämta enhetsstorlek för speciell enhet ”COMPACT”."

#. from tp:parted-3.4.64.2
msgid "\"%s\" has invalid syntax for locations."
msgstr "”%s” innehåller en ogiltig syntax för platser."

