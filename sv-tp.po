msgstr "Oggbitströmmen innehåller inte en stödd datatyp."

#. from tp:vorbis-tools-1.4.3
msgid "Corrupt secondary header."
msgstr "Felaktigt sekundär-huvud."

#. from tp:vorbis-tools-1.4.3
msgid "EOF before end of Vorbis headers."
msgstr "Filslut före slutet på Vorbishuvuden."

#. from tp:vorbis-tools-1.4.3
msgid "Corrupt or missing data, continuing..."
msgstr "Data felaktigt eller saknas, fortsätter..."

#. from tp:vorbis-tools-1.4.3
msgid "Error writing stream to output. Output stream may be corrupted or truncated."
msgstr "Fel under skrivande av utström.  Kan vara felaktig eller avhuggen."

#. from tp:vorbis-tools-1.4.3
