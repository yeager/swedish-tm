msgstr "ogiltig grupplista %s"

#. from tp:coreutils-9.10-pre1
msgid "Usage: %s [OPTION]... NEWROOT [COMMAND [ARG]...]\n"
msgstr "Användning: %s [FLAGGA]… NYROT [KOMMANDO [ARG]…]\n"

#. from tp:coreutils-9.10-pre1
msgid "Run COMMAND with root directory set to NEWROOT.\n\n"
msgstr "Kör KOMMANDO med rotkatalogen satt till NYROT.\n\n"

#. from tp:coreutils-9.10-pre1
msgid "      --groups=G_LIST\n         specify supplementary groups as g1,g2,..,gN\n"
msgstr "      --groups=G_LISTA\n         ange tilläggsgrupper som g1,g2,…,gN\n"

#. from tp:coreutils-9.10-pre1
msgid "      --userspec=USER:GROUP\n         specify user and group (ID or name) to use\n"
msgstr "      --userspec=ANV:GRUPP\n         ange användare och grupp (ID eller namn) att använda\n"

#. from tp:coreutils-9.10-pre1
msgid "      --skip-chdir\n         do not change working directory to %s\n"
msgstr "      --skip-chdir\n         byt inte arbetskatalog till %s\n"

#. from tp:coreutils-9.10-pre1
msgid "\nIf no command is given, run '\"$SHELL\" -i' (default: '/bin/sh -i').\n"
msgstr "\nOm inget kommando angivs, kör ”\"$SHELL\" -i” (standard: ”/bin/sh -i”).\n"

#. from tp:coreutils-9.10-pre1
msgid "option --skip-chdir only permitted if NEWROOT is old %s"
msgstr "flaggan --skip-chdir är endast tillåten om NYROT är gamla %s"

#. from tp:coreutils-9.10-pre1
msgid "cannot change root directory to %s"
msgstr "kan inte ändra rotkatalog till %s"

#. from tp:coreutils-9.10-pre1
msgid "cannot chdir to root directory"
msgstr "kan inte byta katalog till rotkatalog"

#. from tp:coreutils-9.10-pre1
msgid "no group specified for unknown uid: %ju"
msgstr "ingen grupp angiven för okänt uid: %ju"

