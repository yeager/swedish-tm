msgstr "Använder inbyggda specifikationer.\n"

#. from tp:gcc-16.1-b20260222
msgid "Setting spec %s to '%s'\n\n"
msgstr "Anger specifikationen %s till ”%s”\n"

#. from tp:gcc-16.1-b20260222
