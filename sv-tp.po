#. from tp:coreutils-9.10-pre1
msgid "cannot operate on dangling symlink %s"
msgstr "det går inte att ändra den symboliska länken %s vars mål saknas"

#. from tp:coreutils-9.10-pre1
msgid "cannot dereference %s"
msgstr "kan inte följa %s"

#. from tp:coreutils-9.10-pre1
msgid "changing permissions of %s"
msgstr "ändrar rättigheter på %s"

#. from tp:coreutils-9.10-pre1
msgid "%s: new permissions are %s, not %s"
msgstr "%s: nya rättigheter är %s, inte %s"

#. from tp:coreutils-9.10-pre1
msgid "Usage: %s [OPTION]... MODE[,MODE]... FILE...\n  or:  %s [OPTION]... OCTAL-MODE FILE...\n  or:  %s [OPTION]... --reference=RFILE FILE...\n"
msgstr "Användning: %s [FLAGGA]... RÄTTIGHET[,RÄTTIGHET]... FIL...\n   eller:   %s [FLAGGA]... OKTAL-RÄTTIGHET FIL...\n   eller:   %s [FLAGGA]... --reference=RFIL FIL...\n"

#. from tp:coreutils-9.10-pre1
msgid "Change the mode of each FILE to MODE.\nWith --reference, change the mode of each FILE to that of RFILE.\n\n"
msgstr "Ändra rättigheterna för varje FIL till RÄTTIGHET.\nMed --reference, ändra rättigheter för varje FIL till dem hos RFIL.\n\n"

#. from tp:coreutils-9.10-pre1
msgid "  -c, --changes\n         like verbose but report only when a change is made\n"
msgstr "  -c, --changes\n         som ”verbose” men rapportera bara när ändringar görs\n"

#. from tp:coreutils-9.10-pre1
msgid "  -f, --silent, --quiet\n         suppress most error messages\n"
msgstr "  -f, --silent, --quiet\n         utelämna de flesta felmeddelanden\n"

#. from tp:coreutils-9.10-pre1
msgid "      --dereference\n         affect the referent of each symbolic link,\n         rather than the symbolic link itself\n"
msgstr "      --dereference\n         ändra målet för varje symbolisk länk,\n         i stället för den symboliska länken själv\n"

#. from tp:coreutils-9.10-pre1
msgid "  -h, --no-dereference\n         affect each symbolic link, rather than the referent\n"
msgstr "  -h, --no-dereference\n         ändra varje symbolisk länk i stället för dess mål\n"

#. from tp:coreutils-9.10-pre1
msgid "      --reference=RFILE\n         use RFILE's mode instead of specifying MODE values.\n         RFILE is always dereferenced if a symbolic link.\n"
msgstr "      --reference=RFIL\n         använd RFIL:s rättigheter istället för att ange RÄTTIGHETS-värden.\n         RFIL derefereras alltid om det är en symbolisk länk.\n"

#. from tp:coreutils-9.10-pre1
msgid "  -R, --recursive\n         change files and directories recursively\n"
msgstr "  -R, --recursive\n         ändra filer och kataloger rekursivt\n"

#. from tp:coreutils-9.10-pre1
msgid "\nEach MODE is of the form '[ugoa]*([-+=]([rwxXst]*|[ugo]))+|[-+=][0-7]+'.\n"
msgstr "\nVarje RÄTTIGHET har formen ”[ugoa]*([-+=]([rwxXst]*|[ugo]))+|[-+=][0-7]+”.\n"

#. from tp:coreutils-9.10-pre1
msgid "cannot combine mode and --reference options"
msgstr "det går inte att kombinera rättighets- och --reference-flaggor"

#. from tp:coreutils-9.10-pre1
msgid "changed ownership of %s from %s to %s\n"
msgstr "bytte ägare av %s från %s till %s\n"

#. from tp:coreutils-9.10-pre1
msgid "changed group of %s from %s to %s\n"
msgstr "bytte grupp av %s från %s till %s\n"

#. from tp:coreutils-9.10-pre1
msgid "no change to ownership of %s\n"
msgstr "inget byte av ägare av %s\n"

#. from tp:coreutils-9.10-pre1
msgid "failed to change ownership of %s from %s to %s\n"
msgstr "kunde inte byta ägare på %s från %s till %s\n"

#. from tp:coreutils-9.10-pre1
msgid "failed to change group of %s from %s to %s\n"
msgstr "kunde inte byta grupp för %s från %s till %s\n"

#. from tp:coreutils-9.10-pre1
msgid "failed to change ownership of %s\n"
msgstr "kunde inte byta ägare på %s\n"

#. from tp:coreutils-9.10-pre1
msgid "failed to change ownership of %s to %s\n"
msgstr "kunde inte byta ägare på %s till %s\n"

#. from tp:coreutils-9.10-pre1
msgid "failed to change group of %s to %s\n"
msgstr "kunde inte byta grupp för %s till %s\n"

#. from tp:coreutils-9.10-pre1
msgid "ownership of %s retained as %s\n"
msgstr "ägare av %s bevarad som %s\n"

#. from tp:coreutils-9.10-pre1
msgid "group of %s retained as %s\n"
msgstr "grupp av %s bevarad som %s\n"

#. from tp:coreutils-9.10-pre1
msgid "ownership of %s retained\n"
msgstr "ägare av %s bevarad\n"

#. from tp:coreutils-9.10-pre1
msgid "changing ownership of %s"
msgstr "byter ägare av %s"

#. from tp:coreutils-9.10-pre1
msgid "changing group of %s"
msgstr "byter grupp av %s"

#. from tp:coreutils-9.10-pre1
msgid "Usage: %s [OPTION]... %s FILE...\n  or:  %s [OPTION]... --reference=RFILE FILE...\n"
msgstr "Användning: %s [FLAGGA]… %s FIL…\n   eller:   %s [FLAGGA]… --reference=RFIL FIL…\n"

#. from tp:coreutils-9.10-pre1
msgid "[OWNER][:[GROUP]]"
msgstr "[ÄGARE][:[GRUPP]]"

#. from tp:coreutils-9.10-pre1
msgid "GROUP"
msgstr "GRUPP"

#. from tp:coreutils-9.10-pre1
msgid "Change the owner and/or group of each FILE to OWNER and/or GROUP.\nWith --reference, change the owner and group of each FILE to those of RFILE.\n\n"
msgstr "Ändra ägaren och/eller gruppen på varje FIL till ÄGARE och/eller GRUPP.\nMed --reference, ändra ägaren och gruppen för varje FIL till dem för RFIL.\n\n"

#. from tp:coreutils-9.10-pre1
msgid "Change the group of each FILE to GROUP.\nWith --reference, change the group of each FILE to that of RFILE.\n\n"
msgstr "Ändra grupp för varje FIL till GRUPP.\nMed --reference, ändra gruppen för varje FIL till den hos RFIL.\n\n"

#. from tp:coreutils-9.10-pre1
msgid "  -h, --no-dereference\n         affect symbolic links instead of any referenced file;\n         useful only on systems that can change the ownership of a symlink\n"
msgstr "  -h, --no-dereference\n         ändra symboliska länkar istället för den refererade filen;\n         endast användbart på system som kan ändra ägare av en symlänk\n"

#. from tp:coreutils-9.10-pre1
msgid "      --from=CURRENT_OWNER:CURRENT_GROUP\n         change the ownership of each file only if its\n         current owner and/or group match those specified here.\n         Either may be omitted, in which case a match\n         is not required for the omitted attribute\n"
msgstr "      --from=NUVARANDE_ÄGARE:NUVARANDE_GRUPP\n         byt ägarskapet på varje fil endast om dess\n         nuvarande ägare och/eller grupp stämmer med de som\n         anges här. Endera kan utelämnas, i vilket fall ingen\n         matchning krävs för det utelämnade attributet\n"

#. from tp:coreutils-9.10-pre1
msgid "      --reference=RFILE\n         use RFILE's ownership rather than specifying values.\n         RFILE is always dereferenced if a symbolic link.\n"
msgstr "      --reference=RFIL\n         använd RFIL:s ägarskap istället för att ange värden.\n         RFIL derefereras alltid om det är en symbolisk länk.\n"

#. from tp:coreutils-9.10-pre1
msgid "\nOwner is unchanged if missing.  Group is unchanged if missing, but changed\nto login group if implied by a ':' following a symbolic OWNER.\nOWNER and GROUP may be numeric as well as symbolic.\n"
msgstr "\nÄgaren byts inte om den utelämnas.  Grupp byts inte om utelämnad,\nmen byts till inloggningsgrupp om underförstådd av ”:” efter en\nsymbolisk ÄGARE.  ÄGARE och GRUPP kan vara numeriska såväl som\nsymboliska.\n"

#. from tp:coreutils-9.10-pre1
msgid "\nExamples:\n  %s root /u        Change the owner of /u to \"root\".\n  %s root:staff /u  Likewise, but also change its group to \"staff\".\n  %s -hR root /u    Change the owner of /u and subfiles to \"root\".\n"
msgstr "\nExempel:\n  %s root /u        Ändra ägare av /u till ”root”.\n  %s root:staff /u  Samma, men ändra även dess grupp till ”staff”.\n  %s -hR root /u    Ändra ägare av /u och underfiler till ”root”.\n"

#. from tp:coreutils-9.10-pre1
msgid "\nExamples:\n  %s staff /u      Change the group of /u to \"staff\".\n  %s -hR staff /u  Change the group of /u and subfiles to \"staff\".\n"
msgstr "\nExempel:\n  %s staff /u      Ändra gruppen för /u till ”staff”.\n  %s -hR staff /u  Ändra gruppen för /u och underfiler till ”staff”.\n"

#. from tp:coreutils-9.10-pre1
msgid "Roland McGrath"
msgstr "Roland McGrath"

