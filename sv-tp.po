msgid "Catch-all information"
msgstr "Matcha-alla-information"

#. from tp:vmm-0.7.0
msgid "	Mail to unknown local-parts in domain %s will be sent to:"
msgstr "	Post till okända lokala delar i domän %s kommer att skickas till:"

