msgid "Save Parts: each staff becomes a file in lilypond format"
msgstr "Spara stämmor: varje notsystem blir en fil i LilyPond-format"

#. from tp:denemo-2.6-rc2
msgid "Export Lilypond"
msgstr "Exportera LilyPond"

#. from tp:denemo-2.6-rc2
