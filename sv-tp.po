msgstr "Ogiltiga parametrar för omkrypteringens återhämtningsskydd."

#. from tp:cryptsetup-2.8.2-rc0
msgid "Moved segment too large. Requested size %<PRIu64>, available space for: %<PRIu64>."
msgstr "Det flyttade segmentet är för stort. Begärd storlek %<PRIu64>, tillgängligt utrymme: %<PRIu64>."

