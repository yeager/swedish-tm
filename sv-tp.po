msgstr "  -r, --folder      ange namn på fjärrmapp\n"

#. from tp:fetchmail-6.6.0.rc3
msgid "      --showdots    show progress dots even in logfiles\n"
msgstr "      --showdots    visa förloppspunkter även i loggfiler\n"

