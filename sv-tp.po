msgid "%A Addr %D Date %F Addr+Name %G Groupname %M Message-ID %N Name %C First Name"
msgstr "%A Addr %D Datum %F Addr+Namn %G Gruppnamn %M Meddelande-ID %N Namn %C Förnamn"

