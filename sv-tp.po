msgid "'%s' needs a PIC, FROM, TO, USING, VALUE, BELL, BLANK or ERASE clause"
msgstr "”%s” behöver PIC-, FROM-, TO-, USING-, VALUE-, BELL-, BLANK- eller ERASE-klausul"

#. from tp:gnucobol-3.2
msgid "cannot use AUTO, FULL, PROMPT, REQUIRED or SECURE on elementary item without TO or USING"
msgstr "det går inte att använda AUTO, FULL, PROMPT, REQUIRED eller SECURE på elementärt objekt utan TO eller USING"

#. from tp:gnucobol-3.2
msgid "cannot use BLANK WHEN ZERO, JUSTIFIED, OCCURS or SIGN on item without FROM, TO or USING"
msgstr "det går inte att använda BLANK WHEN ZERO, JUSTIFIED, OCCURS eller SIGN på objekt utan FROM, TO eller USING"

#. from tp:gnucobol-3.2
msgid "cannot use AUTO, FULL, REQUIRED or SECURE on elementary item without FROM, TO or USING"
msgstr "det går inte att använda AUTO, FULL, REQUIRED eller SECURE på elementärt objekt utan FROM, TO eller USING"

#. from tp:gnucobol-3.2
msgid "cannot use BLANK WHEN ZERO, JUSTIFIED or SIGN without FROM, TO or USING"
msgstr "det går inte att använda BLANK WHEN ZERO, JUSTIFIED eller SIGN utan FROM, TO eller USING"

#. from tp:gnucobol-3.2
msgid "cannot have BLANK WHEN ZERO without PIC"
msgstr "det går inte att ha BLANK WHEN ZERO utan PIC"

#. from tp:gnucobol-3.2
msgid "cannot have JUSTIFIED without PIC"
msgstr "det går inte att ha JUSTIFIED utan PIC"

#. from tp:gnucobol-3.2
msgid "cannot have AUTO without FROM, TO or USING"
msgstr "det går inte att ha AUTO utan FROM, TO eller USING"

#. from tp:gnucobol-3.2
msgid "cannot use FULL or REQUIRED on item without TO or USING"
msgstr "det går inte att använda FULL eller REQUIRED på objekt utan TO eller USING"

#. from tp:gnucobol-3.2
msgid "SECURE can be used with TO only"
msgstr "SECURE kan bara användas med TO"

#. from tp:gnucobol-3.2
msgid "SECURE must be used with TO"
msgstr "SECURE måste användas med TO"

#. from tp:gnucobol-3.2
msgid "'%s' does nothing"
msgstr "”%s” gör inget"

#. from tp:gnucobol-3.2
msgid "'%s' 77 level is not allowed here"
msgstr "”%s” 77-nivå är inte tillåten här"

#. from tp:gnucobol-3.2
msgid "OCCURS and multi COLUMNs is not allowed"
msgstr "OCCURS och flera COLUMN är inte tillåtna"

#. from tp:gnucobol-3.2
msgid "duplicate LINE %d ignored"
msgstr "duplicerad LINE %d ignoreras"

#. from tp:gnucobol-3.2
msgid "ignoring SYNCHRONIZED for group item '%s'"
msgstr "hoppar över SYNCHRONIZED för gruppobjekt ”%s”"

#. from tp:gnucobol-3.2
msgid "larger REDEFINES"
msgstr "större REDEFINES"

#. from tp:gnucobol-3.2
msgid "size of '%s' larger than size of '%s'"
msgstr "Storleken på ”%s” är större än storleken på ”%s”"

#. from tp:gnucobol-3.2
msgid "'%s' cannot be larger than %d bytes"
msgstr "”%s” får inte vara större än %d byte"

#. from tp:gnucobol-3.2
msgid "'%s' binary field cannot be larger than %d digits"
msgstr "binärfält ”%s” får inte vara större än %d siffror"

#. from tp:gnucobol-3.2
msgid "variable-length PICTURE"
msgstr "PICTURE med variabel längd"

#. from tp:gnucobol-3.2
msgid "literal type does not match numeric data type"
msgstr "litteraltyp matchar inte numerisk datatyp"

#. from tp:gnucobol-3.2
msgid "THRU item '%s' may not come before '%s'"
msgstr "THRU-objekt ”%s” får inte komma före ”%s”"

#. from tp:gnucobol-3.2
msgid "RENAMES cannot start/end at the OCCURS item '%s'"
msgstr "RENAMES får inte starta/sluta vid OCCURS-objektet ”%s”"

#. from tp:gnucobol-3.2
msgid "cannot use RENAMES on part of the table '%s'"
msgstr "får inte använda RENAMES för en del av tabellen ”%s”"

#. from tp:gnucobol-3.2
msgid "RENAMES may not contain '%s' as it is a pointer or object reference"
msgstr "RENAMES får inte innehålla ”%s” då det är en pekare eller objektreferens"

#. from tp:gnucobol-3.2
msgid "RENAMES may not contain '%s' as it is an OCCURS DEPENDING table"
msgstr "RENAMES får inte innehålla ”%s” då det är en OCCURS DEPENDING-tabell"

#. from tp:gnucobol-3.2
msgid "RENAMES may not reference a level 88"
msgstr "RENAMES får inte referera till nivå 88"

#. from tp:gnucobol-3.2
msgid "'%s' must immediately follow the record '%s'"
msgstr "”%s” måste omedelbart följa på posten ”%s”"

#. from tp:gnucobol-3.2
msgid "THRU item must be different to '%s'"
msgstr "THRU-objekt måste vara annorlunda än ”%s”"

#. from tp:gnucobol-3.2
msgid "'%s' and '%s' must be in the same record"
msgstr "”%s” och ”%s” måste vara i samma post"

#. from tp:gnucobol-3.2
msgid "THRU item '%s' may not be subordinate to '%s'"
msgstr "THRU-objekt ”%s” får inte vara underordnat ”%s”"

#. from tp:gnucobol-3.2
msgid "  -fstack-size=<number>	define PERFORM stack size\n                       * default: 255"
msgstr "  -fstack-size=<number>	ange PERFORM-stackstorlek\n                       * standard: 255"

#. from tp:gnucobol-3.2
msgid "  -fif-cutoff=<number>  define cutoff depth for IF statements\n                        * default: 3"
msgstr "  -fif-cutoff=<number>  ange brytdjup för IF-satser\n                        * standard: 3"

#. from tp:gnucobol-3.2
msgid "  -fsign=[ASCII|EBCDIC]	define display sign representation\n                        * default: machine native"
msgstr "  -fsign=[ASCII|EBCDIC]	ange teckenrepresentation för DISPLAY\n                        * standard: maskinens inbyggda"

#. from tp:gnucobol-3.2
msgid "  -ffold-copy=[UPPER|LOWER]	fold COPY subject to value\n                        * default: no transformation"
msgstr "  -ffold-copy=[UPPER|LOWER]	ändra skiftläge för COPY enligt värdet\n                        * standard: ingen omvandling"

#. from tp:gnucobol-3.2
msgid "  -ffold-call=[UPPER|LOWER]	fold PROGRAM-ID, CALL, CANCEL subject to value\n                        * default: no transformation"
msgstr "  -ffold-call=[UPPER|LOWER]	ändra skiftläge för PROGRAM-ID, CALL, CANCEL enligt värdet\n                        * standard: ingen omvandling"

#. from tp:gnucobol-3.2
msgid "  -fmax-errors=<number>	maximum number of errors to report before\n                        compilation is aborted\n                        * default: 128"
msgstr "  -fmax-errors=<number>	maximalt antal fel att rapportera innan\n                        kompileringen avbryts\n                        * standard: 128"

#. from tp:gnucobol-3.2
msgid "  -fintrinsics=[ALL|intrinsic function name(,name,...)]\n                        intrinsics to be used without FUNCTION keyword"
msgstr "  -fintrinsics=[ALL|intrinsic function name(,name,...)]\n                        inbyggda funktioner som får användas utan FUNCTION-nyckelord"

#. from tp:gnucobol-3.2
msgid "  -fdump=<scope>        dump data fields on abort, <scope> may be\n                        a combination of: ALL, WS, LS, RD, FD, SC, LO"
msgstr "  -fdump=<scope>        dumpa datafält vid avbrott, <scope> kan vara\n                        en kombination av: ALL, WS, LS, RD, FD, SC, LO"

#. from tp:gnucobol-3.2
msgid "  -fno-dump=<scope>     exclude data fields from dumping on abort, <scope> may\n                        be a combination of: ALL, WS, LS, RD, FD, SC, LO\n                        default if no scope specified: ALL"
msgstr "  -fno-dump=<scope>     uteslut datafält från dumpning vid avbrott, <scope> kan\n                        vara en kombination av: ALL, WS, LS, RD, FD, SC, LO\n                        standard om inget scope anges: ALL"

#. from tp:gnucobol-3.2
msgid "  -fcallfh=<name>       specifies <name> to be used for I/O\n                        as external provided EXTFH interface module"
msgstr "  -fcallfh=<name>       anger <name> som ska användas för I/O\n                        som extern EXTFH-gränssnittsmodul"

#. from tp:gnucobol-3.2
msgid "  -febcdic-table=<cconv-table>/<file>	EBCDIC/ASCII translation table\n                        * e.g. default, ebcdic500_latin1..."
msgstr "  -febcdic-table=<cconv-table>/<file>	EBCDIC/ASCII-översättningstabell\n                        * t.ex. default, ebcdic500_latin1..."

#. from tp:gnucobol-3.2
msgid "  -fdefault-colseq=[ASCII|EBCDIC|NATIVE]	define default collating sequence\n                        * default: NATIVE"
msgstr "  -fdefault-colseq=[ASCII|EBCDIC|NATIVE]	ange standardkollationsordning\n                        * standard: NATIVE"

#. from tp:gnucobol-3.2
msgid "  -fwinmain             generate WinMain instead of main when compiling\n                        as executable"
msgstr "  -fwinmain             generera WinMain i stället för main vid kompilering\n                        som körbar fil"

#. from tp:gnucobol-3.2
msgid "  -fcomputed-goto       generate computed goto C statements"
msgstr "  -fcomputed-goto       generera beräknade goto-satser i C"

#. from tp:gnucobol-3.2
msgid "  -fextra-brace         generate extra braces in C source"
msgstr "  -fextra-brace         generera extra klamrar i C-källkod"

#. from tp:gnucobol-3.2
msgid "  -fcorrect-numeric     attempt correction of invalid numeric display items"
msgstr "  -fcorrect-numeric     försök rätta ogiltiga numeriska DISPLAY-objekt"

#. from tp:gnucobol-3.2
msgid "  -fstack-on-heap       PERFORM stack allocated on heap"
msgstr "  -fstack-on-heap       PERFORM-stack allokeras på heapen"

#. from tp:gnucobol-3.2
msgid "  -fstack-extended      store origin of entrypoints and PERFORM\n                        * turned on by --debug/-fdump"
msgstr "  -fstack-extended      lagra ursprunget för startpunkter och PERFORM\n                        * aktiveras av --debug/-fdump"

#. from tp:gnucobol-3.2
msgid "  -fno-fast-compare     disables inline comparisions"
msgstr "  -fno-fast-compare     inaktiverar inline-jämförelser"

#. from tp:gnucobol-3.2
msgid "  -fno-remove-unreachable	disable remove of unreachable code\n                        * turned off by -g"
msgstr "  -fno-remove-unreachable\tinaktivera borttagning av oåtkomlig kod\n                        * inaktiveras av -g"

#. from tp:gnucobol-3.2
msgid "  -ftrace               generate trace code\n                        * scope: executed SECTION/PARAGRAPH"
msgstr "  -ftrace               generera spårningskod\n                        * omfång: körda SECTION/PARAGRAPH"

#. from tp:gnucobol-3.2
msgid "  -ftraceall            generate trace code\n                        * scope: executed SECTION/PARAGRAPH/STATEMENTS"
msgstr "  -ftraceall            generera spårningskod\n                        * omfång: körda SECTION/PARAGRAPH/STATEMENTS"

#. from tp:gnucobol-3.2
msgid "  -fsyntax-only         syntax error checking only; don't emit any output"
msgstr "  -fsyntax-only         endast syntaxfelskontroll; mata inte ut någon utdata"

#. from tp:gnucobol-3.2
msgid "  -fdebugging-line      enable debugging lines\n                        * 'D' in indicator column or floating >>D"
msgstr "  -fdebugging-line      aktivera felsökningsrader\n                        * 'D' i indikatorkolumn eller flytande >>D"

#. from tp:gnucobol-3.2
msgid "  -fsource-location     generate source location code\n                        * turned on by --debug/-ftraceall/-fec/-fdump"
msgstr "  -fsource-location     generera källkodsplatskod\n                        * aktiveras av --debug/-ftraceall/-fec/-fdump"

#. from tp:gnucobol-3.2
msgid "  -fimplicit-init       automatic initialization of the COBOL runtime system"
msgstr "  -fimplicit-init       automatisk initiering av COBOL-körtidssystemet"

#. from tp:gnucobol-3.2
msgid "  -fno-recursive-check  disable check of recursive program call;\n                        effectively compiling as RECURSIVE program"
msgstr "  -fno-recursive-check  inaktivera kontroll av rekursivt programanrop;\n                        innebär i praktiken kompilering som RECURSIVE-program"

#. from tp:gnucobol-3.2
msgid "  -fstack-check         PERFORM stack checking\n                        * turned on by --debug/-g"
msgstr "  -fstack-check         PERFORM-stackkontroll\n                        * aktiveras av --debug/-g"

#. from tp:gnucobol-3.2
msgid "  -fmemory-check=<scope>     checks for invalid writes to internal storage,\n                        <scope> may be one of: all, pointer, using, none\n                        * default: none, set to all by --debug"
msgstr "  -fmemory-check=<scope>     kontrollerar ogiltiga skrivningar till intern lagring,\n                        <scope> kan vara en av: all, pointer, using, none\n                        * standard: none, sätts till all av --debug"

#. from tp:gnucobol-3.2
msgid "  -fsection-exit-check  check that code execution does not leave the scope of SECTIONs"
msgstr "  -fsection-exit-check  kontrollera att kodkörning inte lämnar SECTION-omfånget"

#. from tp:gnucobol-3.2
msgid "  -fimplicit-goback-check	check that code execution does not end implicit at end of PROCEDURE DIVISION"
msgstr "  -fimplicit-goback-check	kontrollera att kodkörning inte avslutas implicit vid slutet av PROCEDURE DIVISION"

#. from tp:gnucobol-3.2
msgid "  -fwrite-after         use AFTER 1 for WRITE of LINE SEQUENTIAL\n                        * default: BEFORE 1"
msgstr "  -fwrite-after         använd AFTER 1 vid WRITE av LINE SEQUENTIAL\n                        * standard: BEFORE 1"

#. from tp:gnucobol-3.2
msgid "  -fmfcomment           '*' in column 1 treated as comment with listing suppression\n                        * FIXED/COBOL85/VARIABLE format only"
msgstr "  -fmfcomment           '*' i kolumn 1 behandlas som kommentar med listningsundertryckning\n                        * endast FIXED/COBOL85/VARIABLE-format"

#. from tp:gnucobol-3.2
msgid "  -facucomment          '$' in indicator area treated as '*',\n                        '|' treated as floating comment"
msgstr "  -facucomment          '$' i indikatorområdet behandlas som '*',\n                        '|' behandlas som flytande kommentar"

#. from tp:gnucobol-3.2
msgid "  -fno-trunc            allow numeric field overflow\n                        * non-ANSI behaviour"
msgstr "  -fno-trunc            tillåt överflöde i numeriska fält\n                        * icke-ANSI-beteende"

#. from tp:gnucobol-3.2
msgid "  -fsingle-quote        use a single quote (apostrophe) for QUOTE\n                        * default: double quote"
msgstr "  -fsingle-quote        använd ett enkelt citationstecken (apostrof) för QUOTE\n                        * standard: dubbla citationstecken"

#. from tp:gnucobol-3.2
msgid "  -foptional-file       treat all files as OPTIONAL\n                        * unless NOT OPTIONAL specified"
msgstr "  -foptional-file       behandla alla filer som OPTIONAL\n                        * om inte NOT OPTIONAL anges"

#. from tp:gnucobol-3.2
msgid "  -fstatic-call         output static function calls for the CALL statement"
msgstr "  -fstatic-call         mata ut statiska funktionsanrop för CALL-satsen"

#. from tp:gnucobol-3.2
msgid "  -fno-gen-c-decl-static-call	disable generation of C function declarations\n                        for subroutines with static CALL"
msgstr "  -fno-gen-c-decl-static-call	inaktivera generering av C-funktionsdeklarationer\n                        för subrutiner med statisk CALL"

#. from tp:gnucobol-3.2
msgid "  -fgen-c-line-directives	generate source location directives in C code;\n                        * turned on by -g/--coverage"
msgstr "  -fgen-c-line-directives	generera källkodsplatsdirektiv i C-kod;\n                        * aktiveras av -g/--coverage"

#. from tp:gnucobol-3.2
msgid "  -fgen-c-labels        generate extra labels in C sources;\n                        * turned on by -g"
msgstr "  -fgen-c-labels        generera extra etiketter i C-källor;\n                        * aktiveras av -g"

#. from tp:gnucobol-3.2
msgid "  -fno-theaders         suppress all headers from listing while keeping\n                        page breaks"
msgstr "  -fno-theaders         undertryck alla rubriker i listning men behåll\n                        sidbrytningar"

#. from tp:gnucobol-3.2
msgid "  -fno-tsource          suppress source from listing"
msgstr "  -fno-tsource          undertryck källkod i listning"

#. from tp:gnucobol-3.2
msgid "  -fno-tmessages        suppress warning and error summary from listing"
msgstr "  -fno-tmessages        undertryck varnings- och felsammanfattning i listning"

#. from tp:gnucobol-3.2
msgid "  -ftsymbols            specify symbols in listing"
msgstr "  -ftsymbols            ange symboler i listning"

#. from tp:gnucobol-3.2
msgid "  -ftcmd                specify command line in listing"
msgstr "  -ftcmd                ange kommandorad i listning"

#. from tp:gnucobol-3.2
msgid "  -fno-ttimestamp       suppress timestamp in listing headers"
msgstr "  -fno-ttimestamp       undertryck tidsstämpel i listningsrubriker"

#. from tp:gnucobol-3.2
msgid "  -fttitle=<title>      set listing title with '_' replaced by spaces;\n                        defaults to package name and version"
msgstr "  -fttitle=<title>      ange listningstitel med '_' ersatt av blanksteg;\n                        standard är paketnamn och version"

#. from tp:gnucobol-3.2
msgid "  -fno-diagnostics-show-option	suppress output of option that directly\n                        controls the diagnostic"
msgstr "  -fno-diagnostics-show-option	undertryck utskrift av flaggan som direkt\n                        styr diagnostiken"

#. from tp:gnucobol-3.2
msgid "  -fno-diagnostics-show-caret	do not display source context on warning/error diagnostic"
msgstr "  -fno-diagnostics-show-caret	visa inte källkontext vid varnings-/fel-diagnostik"

#. from tp:gnucobol-3.2
msgid "  -fno-diagnostics-show-line-numbers	suppress display of line numbers in diagnostics"
msgstr "  -fno-diagnostics-show-line-numbers	undertryck visning av radnummer i diagnostik"

#. from tp:gnucobol-3.2
msgid "GnuCOBOL compiler for most COBOL dialects with lots of extensions"
msgstr "GnuCOBOL-kompilator för de flesta COBOL-dialekter med många utökningar"

#. from tp:gnucobol-3.2
msgid "Usage: %s [options]... file..."
msgstr "Användning: %s [flaggor]… fil…"

#. from tp:gnucobol-3.2
msgid "Report bugs to: %s\nor (preferably) use the issue tracker via the home page."
msgstr "Rapportera fel till: %s\neller, helst, via felhanteraren på webbplatsen."

#. from tp:gnucobol-3.2
msgid "GnuCOBOL home page: <%s>"
msgstr "GnuCOBOLs webbplats: <%s>"

#. from tp:gnucobol-3.2
msgid "  -h, --help            display this help and exit"
msgstr "  -h, --help            visa denna hjälp och avsluta"

#. from tp:gnucobol-3.2
msgid "  -V, --version         display compiler version information and exit"
msgstr "  -V, --version         visa versionsinformation för kompilatorn och avsluta"

#. from tp:gnucobol-3.2
msgid "  -dumpversion          display compiler version and exit"
msgstr "  -dumpversion          visa kompilatorversion och avsluta"

#. from tp:gnucobol-3.2
msgid "  -i, --info            display compiler information (build/environment)\n                        and exit"
msgstr "  -i, --info            visa kompilatorinformation (bygge/miljö)\n                        och avsluta"

#. from tp:gnucobol-3.2
msgid "  -v, --verbose         verbose mode, display additional information;\n                        multiple -v options increase the verbosity,\n                        the maximum is 3 as follows:\n                        (1) display compiler version and the commands\n                        invoked by the compiler,\n                        (2) pass verbose option to assembler/compiler\n                        (3) pass verbose option to linker"
msgstr "  -v, --verbose         utförligt läge, visa extra information;\n                        flera -v-alternativ ökar detaljgraden,\n                        det högsta är 3 enligt följande:\n                        (1) visa kompilatorversionen och kommandona\n                        som anropas av kompilatorn,\n                        (2) skicka utförligt läge till assembler/kompilator\n                        (3) skicka utförligt läge till länkaren"

#. from tp:gnucobol-3.2
msgid "  -q, --brief           reduced displays, commands invoked not shown"
msgstr "  -q, --brief           begränsade utskrifter, körda kommandon visas inte"

#. from tp:gnucobol-3.2
msgid "  -###                  like -v but commands not executed"
msgstr "  -###                  som -v men kommandon körs inte"

#. from tp:gnucobol-3.2
msgid "  -x                    build an executable program"
msgstr "  -x                    bygg ett körbart program"

#. from tp:gnucobol-3.2
msgid "  -m                    build a dynamically loadable module (default)"
msgstr "  -m                    bygg en dynamiskt inläsningsbar modul (standard)"

#. from tp:gnucobol-3.2
msgid "  -j [<args>], --job[=<args>]	run program after build, passing <args>"
msgstr "  -j [<arg>], --job[=<arg>]\tkör programmet efter bygget och skicka vidare <arg>"

#. from tp:gnucobol-3.2
msgid "  -std=<dialect>        warnings/features for a specific dialect\n                        <dialect> can be one of:\n                        default, cobol2014, cobol2002, cobol85, xopen,\n                        ibm-strict, ibm, mvs-strict, mvs,\n                        mf-strict, mf, bs2000-strict, bs2000,\n                        acu-strict, acu, rm-strict, rm, gcos-strict,\n                        gcos;\n                        see configuration files in directory config"
msgstr "  -std=<dialekt>        varningar/funktioner för en specifik dialekt\n                        <dialekt> kan vara endera av:\n                        default, cobol2014, cobol2002, cobol85, xopen,\n                        ibm-strict, ibm, mvs-strict, mvs,\n                        mf-strict, mf, bs2000-strict, bs2000,\n                        acu-strict, acu, rm-strict, rm, gcos-strict,\n                        gcos;\n                        se konfigurationsfiler i katalogen config"

#. from tp:gnucobol-3.2
msgid "  -F, --free            use free source format (alias for -fformat=free)"
msgstr "  -F, --free            använd fritt källkodsformat (alternativnamn för -fformat=free)"

#. from tp:gnucobol-3.2
msgid "  --fixed               use fixed source format (default; alias for\n                        -fformat=fixed)"
msgstr "  --fixed               använd fast källkodsformat (standard; alternativnamn för\n                        -fformat=fixed)"

#. from tp:gnucobol-3.2
msgid "  -O, -O2, -O3, -Os     enable optimization"
msgstr "  -O, -O2, -O3, -Os     aktivera optimering"

#. from tp:gnucobol-3.2
msgid "  -O0                   disable optimization"
msgstr "  -O0                   inaktivera optimering"

#. from tp:gnucobol-3.2
msgid "  -g                    enable C compiler debug and stack check"
msgstr "  -g                    aktivera C-kompilatorns felsökning och stackkontroll"

#. from tp:gnucobol-3.2
msgid "  -d, --debug           enable all run-time error checking,\n                        equal to -fstack-check -fec=EC-ALL"
msgstr "  -d, --debug           aktivera all körtidsfelkontroll,\n                        motsvarar -fstack-check -fec=EC-ALL"

#. from tp:gnucobol-3.2
msgid "  -fec=<exception-name>	enable code generation for <exception-name>,\n                        see --list-exceptions for the possible values,\n                        sets -fsource-location"
msgstr "  -fec=<undantagsnamn>	aktivera kodgenerering för <undantagsnamn>,\n                        se --list-exceptions för möjliga värden,\n                        sätter -fsource-location"

#. from tp:gnucobol-3.2
msgid "  -fno-ec=<exception-name>	disable code generation for <exception-name>"
msgstr "  -fno-ec=<undantagsnamn>	inaktivera kodgenerering för <undantagsnamn>"

#. from tp:gnucobol-3.2
msgid "  -o <file>             place the output into <file>"
msgstr "  -o <fil>              skriv utdata till <fil>"

#. from tp:gnucobol-3.2
msgid "  -b                    combine all input files into a single\n                        dynamically loadable module"
msgstr "  -b                    kombinera alla indatafiler i en enda\n                        dynamiskt inläsningsbar modul"

#. from tp:gnucobol-3.2
msgid "  -E                    preprocess only; do not compile or link"
msgstr "  -E                    preprocessa bara; kompilera och länka inte"

#. from tp:gnucobol-3.2
msgid "  -C                    translation only; convert COBOL to C"
