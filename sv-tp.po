msgid "Notes/Rests"
msgstr "Noter/pauser"

#. from tp:denemo-2.6-rc2
msgid "Menu:\nCommands for notes/rests"
msgstr "Meny:\nKommandon för noter/pauser"

#. from tp:denemo-2.6-rc2
msgid "Rest Insertion"
msgstr "Pausinfogning"

#. from tp:denemo-2.6-rc2
msgid "Menu:\nModeless entry of rests"
msgstr "Meny:\nInmatning av pauser utan lägesbyte"

#. from tp:denemo-2.6-rc2
msgid "Educational"
msgstr "Utbildning"

#. from tp:denemo-2.6-rc2
msgid "Menu:\nEducational Games"
msgstr "Meny:\nPedagogiska spel"

#. from tp:denemo-2.6-rc2
msgid "Edit Directive(s)"
msgstr "Redigera direktiv(en)"

#. from tp:denemo-2.6-rc2
msgid "Menu:\nEditing directives"
msgstr "Meny:\nRedigera direktiv"

#. from tp:denemo-2.6-rc2
msgid "Change Note"
msgstr "Ändra not"

#. from tp:denemo-2.6-rc2
msgid "Menu:\nChanging the note at the cursor to the nearest ..."
msgstr "Menu:\nÄndra noten vid markören till närmaste ..."

#. from tp:denemo-2.6-rc2
msgid "Edit Duration"
msgstr "Redigera tidsvärde"

#. from tp:denemo-2.6-rc2
msgid "Menu:\nChanges the duration of the current note"
msgstr "Meny:\nÄndrar den aktuella notens tidsvärde"

