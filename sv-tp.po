msgid "Your shield is already at full efficiency"
msgstr "Din sköld har redan full effektivitet"

#. from tp:meritous-1.5
msgid "Press button 2 to upgrade shields (%d crystals)"
msgstr "Tryck på knapp 2 för att uppgradera sköldar (%d kristaller)"

#. from tp:meritous-1.5
msgid "Press ENTER to upgrade shields (%d crystals)"
msgstr "Tryck på RETUR för att uppgradera sköldar (%d kristaller)"

#. from tp:meritous-1.5
msgid "Your circuit charge rate is already at its highest"
msgstr "Din kretsladdningshastighet är redan på max"

#. from tp:meritous-1.5
msgid "Press button 2 to upgrade circuit charge (%d crystals)"
msgstr "Tryck på knapp 2 för att uppgradera kretsladdning (%d kristaller)"

#. from tp:meritous-1.5
msgid "Press ENTER to upgrade circuit charge (%d crystals)"
msgstr "Tryck på RETUR för att uppgradera kretsladdning (%d kristaller)"

#. from tp:meritous-1.5
msgid "Your circuit refill rate is already at its highest"
msgstr "Din kretsåterfyllnadshastighet är redan på max"

#. from tp:meritous-1.5
msgid "Press button 2 to upgrade circuit refill (%d crystals)"
msgstr "Tryck på knapp 2 för att uppgradera kretsåterfyllnad (%d kristaller)"

#. from tp:meritous-1.5
msgid "Press ENTER to upgrade circuit refill (%d crystals)"
msgstr "Tryck på RETUR för att uppgradera kretsåterfyllnad (%d kristaller)"

#. from tp:meritous-1.5
msgid "Press button 2 to record your progress"
msgstr "Tryck på knapp 2 för att spara dina framsteg"

#. from tp:meritous-1.5
msgid "Press ENTER to record your progress"
msgstr "Tryck på Retur för att spara dina framsteg"

#. from tp:meritous-1.5
msgid "This is a crystal device. It isn't working at the moment."
msgstr "Detta är en kristallenhet. Den fungerar inte för tillfället."

#. from tp:meritous-1.5
msgid "Press button 2 to activate the crystal device"
msgstr "Tryck på knapp 2 för att aktivera kristallenheten"

#. from tp:meritous-1.5
msgid "Press ENTER to activate the crystal device"
msgstr "Tryck på RETUR för att aktivera kristallenheten"

#. from tp:meritous-1.5
msgid "The artifact is tainted with shadow. You must slay more of the shadow first."
msgstr "Artefakten är besudlad av skugga. Du måste först besegra mer av skuggan."

#. from tp:meritous-1.5
