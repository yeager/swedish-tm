msgid "Standalone Segno (for barlines)"
msgstr "Standalone Segno (för barlines)"

#. from tp:denemo-2.6-rc2
msgid "Typesets a segno over the barline."
msgstr "Sätter en segno över barlinjen."

#. from tp:denemo-2.6-rc2
msgid "String: "
msgstr "Sträng: "

