#. from tp:coreutils-9.10-pre1
msgid "\nATTR_LIST is a comma-separated list of attributes. Attributes are 'mode' for\npermissions (including any ACL and xattr permissions), 'ownership' for user\nand group, 'timestamps' for file timestamps, 'links' for hard links, 'context'\nfor security context, 'xattr' for extended attributes, and 'all' for all\nattributes.\n"
msgstr "\nATTRLISTA är en kommaseparerad lista av attribut. Attribut är ”mode” för\nrättigheter (inklusive eventuella ACL- och xattr-rättigheter), ”ownership” för\nanvändare och grupp, ”timestamps” för filtidsstämplar, ”links” för hårda\nlänkar, ”context” för säkerhetskontext, ”xattr” för utökade attribut och ”all”\nför alla attribut.\n"

#. from tp:coreutils-9.10-pre1
msgid "\nBy default, sparse SOURCE files are detected by a crude heuristic and the\ncorresponding DEST file is made sparse as well.  That is the behavior\nselected by --sparse=auto.  Specify --sparse=always to create a sparse DEST\nfile whenever the SOURCE file contains a long enough sequence of zero bytes.\nUse --sparse=never to inhibit creation of sparse files.\n"
msgstr "\nNormalt upptäcks en gles KÄLLA med en grov heuristik och motsvarande\nDEST görs likaledes gles.  Det beteendet väljs av --sparse=auto.  Ange\n--sparse=always för att alltid göra DEST gles när KÄLLA innehåller\ntillräckligt långa nollbytesekvenser.  Ange --sparse=never för att\nhindra skapandet av glesa filer.\n"

#. from tp:coreutils-9.10-pre1
msgid "\nBy default or with --reflink=auto, cp will try a lightweight copy, where the\ndata blocks are copied only when modified, falling back to a standard copy\nif this is not possible.  With --reflink[=always] cp will fail if CoW is not\nsupported, while --reflink=never ensures a standard copy is performed.\n"
msgstr "\nSom standard eller med --reflink=auto kommer cp försöka med en\nlättviktskopiering, där datablocken endast kopieras när de ändras, och\nfaller tillbaka till en standardkopiering om detta inte är möjligt.\nMed --reflink[=always] kommer cp misslyckas om CoW inte stödjs, medan\n--reflink=never säkerställer att en standardkopiering görs.\n"

#. from tp:coreutils-9.10-pre1
msgid "\nAs a special case, cp makes a backup of SOURCE when the force and backup\noptions are given and SOURCE and DEST are the same name for an existing,\nregular file.\n"
msgstr "\nSom ett specialfall gör cp en säkerhetskopia av KÄLLA när force- och\nbackup-flaggorna är givna, och KÄLLA och DEST är samma namn på en befintlig\nnormal fil.\n"

#. from tp:coreutils-9.10-pre1
msgid "failed to preserve times for %s"
msgstr "misslyckades med att bevara tider för %s"

#. from tp:coreutils-9.10-pre1
msgid "failed to preserve permissions for %s"
msgstr "misslyckades med att bevara rättigheter på %s"

#. from tp:coreutils-9.10-pre1
msgid "cannot make directory %s"
msgstr "kan inte skapa katalog %s"

#. from tp:coreutils-9.10-pre1
msgid "%s exists but is not a directory"
msgstr "%s finns men är inte en katalog"

#. from tp:coreutils-9.10-pre1
msgid "missing file operand"
msgstr "filoperand saknas"

#. from tp:coreutils-9.10-pre1
msgid "missing destination file operand after %s"
msgstr "destinationsfilsoperand saknas efter %s"

#. from tp:coreutils-9.10-pre1
msgid "cannot combine --target-directory (-t) and --no-target-directory (-T)"
msgstr "det går inte att kombinera --target-directory (-t) och --no-target-directory (-T)"

#. from tp:coreutils-9.10-pre1
msgid "target directory %s"
msgstr "målkatalog %s"

#. from tp:coreutils-9.10-pre1
msgid "target %s"
msgstr "mål %s"

#. from tp:coreutils-9.10-pre1
msgid "with --parents, the destination must be a directory"
msgstr "med --parents måste destinationen vara en katalog"

#. from tp:coreutils-9.10-pre1
msgid "multiple target directories specified"
msgstr "multipla målkataloger angivna"

#. from tp:coreutils-9.10-pre1
msgid "warning: ignoring --context"
msgstr "varning: ignorerar --context"

#. from tp:coreutils-9.10-pre1
msgid "warning: ignoring --context; it requires an SELinux-enabled kernel"
msgstr "varning: ignorerar --context; det kräver en kärna som har SELinux aktiverat"

#. from tp:coreutils-9.10-pre1
msgid "cannot make both hard and symbolic links"
msgstr "kan inte göra både hårda och symboliska länkar"

#. from tp:coreutils-9.10-pre1
msgid "--backup is mutually exclusive with -n or --update=none-fail"
msgstr "--backup är ömsesidigt uteslutande med -n eller --update=none-fail"

#. from tp:coreutils-9.10-pre1
msgid "--reflink can be used only with --sparse=auto"
msgstr "--reflink kan endast användas med --sparse=auto"

#. from tp:coreutils-9.10-pre1
msgid "backup type"
msgstr "säkerhetskopietyp"

#. from tp:coreutils-9.10-pre1
msgid "cannot set target context and preserve it"
msgstr "det går inte att både sätta målkontext och bevara den"

#. from tp:coreutils-9.10-pre1
msgid "cannot preserve security context without an SELinux-enabled kernel"
msgstr "kan inte bevara säkerhetskontext utan en kärna med SELinux"

#. from tp:coreutils-9.10-pre1
msgid "cannot preserve extended attributes, cp is built without xattr support"
msgstr "kan inte bevara utökade attribut, cp byggdes utan stöd för xattr"

#. from tp:coreutils-9.10-pre1
msgid "Stuart Kemp"
msgstr "Stuart Kemp"

#. from tp:coreutils-9.10-pre1
msgid "%s: line number out of range"
msgstr "%s: radnummer utanför intervallet"

#. from tp:coreutils-9.10-pre1
msgid "%s: %s: line number out of range"
msgstr "%s: %s: radnummer utanför intervallet"

#. from tp:coreutils-9.10-pre1
msgid " on repetition %jd\n"
msgstr " vid upprepning %jd\n"

#. from tp:coreutils-9.10-pre1
msgid "%s: %s: match not found"
msgstr "%s: %s: ingen träff"

#. from tp:coreutils-9.10-pre1
msgid "error in regular expression search"
msgstr "fel i sökning med reguljärt uttryck"

#. from tp:coreutils-9.10-pre1
msgid "write error for %s"
msgstr "skrivfel för %s"

#. from tp:coreutils-9.10-pre1
msgid "%s: integer expected after delimiter"
msgstr "%s: heltal förväntades efter avskiljare"

#. from tp:coreutils-9.10-pre1
msgid "%s: '}' is required in repeat count"
msgstr "%s: upprepningsoperatorn måste avslutas med ”}”"

#. from tp:coreutils-9.10-pre1
msgid "%s}: integer required between '{' and '}'"
msgstr "%s}: heltal krävs mellan ”{” och ”}”"

#. from tp:coreutils-9.10-pre1
msgid "%s: closing delimiter '%c' missing"
msgstr "%s: avslutande avskiljare ”%c” saknas"

#. from tp:coreutils-9.10-pre1
msgid "%s: invalid regular expression: %s"
msgstr "%s: felaktigt reguljärt uttryck: %s"

#. from tp:coreutils-9.10-pre1
msgid "%s: invalid pattern"
msgstr "%s: felaktigt mönster"

#. from tp:coreutils-9.10-pre1
msgid "%s: line number must be greater than zero"
msgstr "%s: radnummer måste vara större än noll"

#. from tp:coreutils-9.10-pre1
msgid "line number %s is smaller than preceding line number, %jd"
msgstr "radnummer %s är lägre än föregående radnummer, %jd"

#. from tp:coreutils-9.10-pre1
msgid "warning: line number %s is the same as preceding line number"
msgstr "varning: radnummer %s är detsamma som föregående radnummer"

#. from tp:coreutils-9.10-pre1
msgid "missing conversion specifier in suffix"
msgstr "saknar formatbeskrivning i ändelse"

#. from tp:coreutils-9.10-pre1
msgid "invalid conversion specifier in suffix: %c"
msgstr "felaktig formatbeskrivning i ändelse: %c"

#. from tp:coreutils-9.10-pre1
msgid "invalid conversion specifier in suffix: \\%.3o"
msgstr "felaktig formatbeskrivning i ändelse: \\%.3o"

#. from tp:coreutils-9.10-pre1
msgid "invalid flags in conversion specification: %%%c%c"
msgstr "ogiltiga flaggor i formatbeskrivning: %%%c%c"

#. from tp:coreutils-9.10-pre1
msgid "too many %% conversion specifications in suffix"
msgstr "för många %%-formatbeskrivningar i ändelse"

#. from tp:coreutils-9.10-pre1
msgid "missing %% conversion specification in suffix"
msgstr "saknar %%-formatbeskrivning i ändelse"

#. from tp:coreutils-9.10-pre1
msgid "Usage: %s [OPTION]... FILE PATTERN...\n"
msgstr "Användning: %s [FLAGGA]... FIL MÖNSTER...\n"

#. from tp:coreutils-9.10-pre1
msgid "Output pieces of FILE separated by PATTERN(s) to files 'xx00', 'xx01', ...,\nand output byte counts of each piece to standard output.\n"
msgstr "Skriv ut delar av FIL avdelade med MÖNSTER till filer ”xx00”, ”xx01”, …,\noch skriv ut antal byte för varje del till standard ut.\n"

#. from tp:coreutils-9.10-pre1
msgid "\nRead standard input if FILE is -\n"
msgstr "\nLäs standard in om FIL är -\n"

#. from tp:coreutils-9.10-pre1
msgid "  -b, --suffix-format=FORMAT\n         use sprintf FORMAT instead of %02d\n"
msgstr "  -b, --suffix-format=FORMAT\n         använd sprintf-FORMAT i stället för %02d\n"

#. from tp:coreutils-9.10-pre1
msgid "  -f, --prefix=PREFIX\n         use PREFIX instead of 'xx'\n"
msgstr "  -f, --prefix=PREFIX\n         använd PREFIX i stället för ”xx”\n"

#. from tp:coreutils-9.10-pre1
msgid "  -k, --keep-files\n         do not remove output files on errors\n"
msgstr "  -k, --keep-files\n         ta inte bort utfiler vid fel\n"

#. from tp:coreutils-9.10-pre1
msgid "      --suppress-matched\n         suppress the lines matching PATTERN\n"
msgstr "      --suppress-matched\n         utelämna rader som matchar MÖNSTER\n"

#. from tp:coreutils-9.10-pre1
msgid "  -n, --digits=DIGITS\n         use specified number of digits instead of 2\n"
msgstr "  -n, --digits=SIFFROR\n         använd angivet antal siffror istället för 2\n"

#. from tp:coreutils-9.10-pre1
msgid "  -s, --quiet, --silent\n         do not print counts of output file sizes\n"
msgstr "  -s, --quiet, --silent\n         skriv inte ut storleken på utmatningsfiler\n"

#. from tp:coreutils-9.10-pre1
msgid "  -z, --elide-empty-files\n         suppress empty output files\n"
msgstr "  -z, --elide-empty-files\n         utelämna tomma utmatningsfiler\n"

#. from tp:coreutils-9.10-pre1
msgid "\nEach PATTERN may be:\n  INTEGER            copy up to but not including specified line number\n  /REGEXP/[OFFSET]   copy up to but not including a matching line\n  %REGEXP%[OFFSET]   skip to, but not including a matching line\n  {INTEGER}          repeat the previous pattern specified number of times\n  {*}                repeat the previous pattern as many times as possible\n\nA line OFFSET is an integer optionally preceded by '+' or '-'\n"
msgstr "\nVarje MÖNSTER kan vara:\n  HELTAL              kopiera fram till men inte inklusive angiven rad\n  /REGUTTR/[FÖRSKJUTNING]  kopiera fram till men inte inklusive matchande rad\n  %REGUTTR%[FÖRSKJUTNING]  hoppa fram till men inte inklusive matchande rad\n  {HELTAL}            upprepa föregående mönster HELTAL gånger\n  {*}                 upprepa föregående mönster så många gånger som möjligt\n\nEn radförskjutning är ett heltal som kan föregås av ”+” eller ”-”.\n"

#. from tp:coreutils-9.10-pre1
msgid "David M. Ihnat"
msgstr "David M. Ihnat"

#. from tp:coreutils-9.10-pre1
msgid "Usage: %s OPTION... [FILE]...\n"
msgstr "Användning: %s FLAGGA... [FIL]...\n"

#. from tp:coreutils-9.10-pre1
msgid "Print selected parts of lines from each FILE to standard output.\n"
msgstr "Skriv valda delar av rader från varje FIL till standard ut.\n"

#. from tp:coreutils-9.10-pre1
msgid "  -b, --bytes=LIST\n         select only these bytes\n"
msgstr "  -b, --bytes=LISTA\n         välj endast dessa byte\n"

#. from tp:coreutils-9.10-pre1
msgid "  -c, --characters=LIST\n         select only these characters\n"
msgstr "  -c, --characters=LISTA\n         välj endast dessa tecken\n"

#. from tp:coreutils-9.10-pre1
msgid "  -d, --delimiter=DELIM\n         use DELIM instead of TAB for field delimiter\n"
msgstr "  -d, --delimiter=AVSKILJ\n         använd AVSKILJ i stället för TAB som fältavskiljare\n"

#. from tp:coreutils-9.10-pre1
msgid "  -f, --fields=LIST\n         select only these fields;  also print any line that contains\n         no delimiter character, unless the -s option is specified\n"
msgstr "  -f, --fields=LISTA\n         välj endast dessa fält; skriv även ut rader som inte har något\n         avskiljande tecken, om inte flaggan -s anges\n"

#. from tp:coreutils-9.10-pre1
msgid "  -n\n         (ignored)\n"
msgstr "  -n\n         (ignorerad)\n"

#. from tp:coreutils-9.10-pre1
msgid "      --complement\n         complement the set of selected bytes, characters or fields\n"
msgstr "      --complement\n         välj de byte, tecken eller fält som inte ingår i urvalet\n"

#. from tp:coreutils-9.10-pre1
msgid "  -s, --only-delimited\n         do not print lines not containing delimiters\n"
msgstr "  -s, --only-delimited\n         skriv inte ut rader som saknar fältavskiljare\n"

#. from tp:coreutils-9.10-pre1
msgid "      --output-delimiter=STRING\n         use STRING as the output delimiter;\n         the default is to use the input delimiter\n"
msgstr "      --output-delimiter=STRÄNG\n         använd STRÄNG som avskiljare vid utmatning;\n         standard är att använda inmatningsavskiljaren\n"

#. from tp:coreutils-9.10-pre1
msgid "\nUse one, and only one of -b, -c or -f.  Each LIST is made up of one\nrange, or many ranges separated by commas.  Selected input is written\nin the same order that it is read, and is written exactly once.\n"
msgstr "\nAnvänd en och endast en av -b, -c eller -f.  Varje LISTA består av ett\nintervall, eller flera intervall avskiljda med komman.  Utvald indata\nskrivs i samma ordning som den läses, och skrivs exakt en gång.\n"

#. from tp:coreutils-9.10-pre1
msgid "Each range is one of:\n\n  N     N'th byte, character or field, counted from 1\n  N-    from N'th byte, character or field, to end of line\n  N-M   from N'th to M'th (included) byte, character or field\n  -M    from first to M'th (included) byte, character or field\n"
msgstr "Varje intervall har någon av följande former:\n\n  N     N:e byte, tecken eller fält, räknat från 1\n  N-    från N:e byte, tecken eller fält, till radslut\n  N-M   från N:e till och med M:e byte, tecken eller fält\n  -M    från första till och med M:e byte, tecken eller fält\n"

#. from tp:coreutils-9.10-pre1
msgid "only one list may be specified"
msgstr "endast en lista kan anges"

#. from tp:coreutils-9.10-pre1
msgid "the delimiter must be a single character"
msgstr "avskiljaren måste vara endast ett tecken"

#. from tp:coreutils-9.10-pre1
msgid "you must specify a list of bytes, characters, or fields"
msgstr "du måste specificera en lista med byte, tecken eller fält"

#. from tp:coreutils-9.10-pre1
msgid "an input delimiter may be specified only when operating on fields"
msgstr "en indataavskiljare kan endast specificeras vid arbete på fält"

#. from tp:coreutils-9.10-pre1
msgid "suppressing non-delimited lines makes sense\n	only when operating on fields"
msgstr "att undertrycka ej avskiljda rader är endast rimligt\n	vid arbete på fält"

#. from tp:coreutils-9.10-pre1
msgid "Usage: %s [OPTION]... [+FORMAT]\n  or:  %s [OPTION]... MMDDhhmm[[CC]YY][.ss]\n"
msgstr "Användning: %s [FLAGGA]… [+FORMAT]\n   eller:   %s [FLAGGA]… MMDDhhmm[[ÅÅ]ÅÅ][.ss]\n"

#. from tp:coreutils-9.10-pre1
msgid "Display date and time in the given FORMAT.\nWith -s, or with MMDDhhmm[[CC]YY][.ss], set the date and time first.\n"
msgstr "Visa datum och tid med angivet FORMAT.\nMed -s, eller med MMDDhhmm[[ÅÅ]ÅÅ][.ss], ställ först in datum och tid.\n"

#. from tp:coreutils-9.10-pre1
msgid "  -d, --date=STRING\n         display time described by STRING, not 'now'\n"
msgstr "  -d, --date=STRÄNG\n         visa tiden som beskrivs av STRÄNG, inte ”nu”\n"

#. from tp:coreutils-9.10-pre1
msgid "      --debug\n         annotate the parsed date,\n         and warn about questionable usage to standard error\n"
msgstr "      --debug\n         annotera det tolkade datumet,\n         och varna för tveksam användning till standard fel\n"

#. from tp:coreutils-9.10-pre1
msgid "  -f, --file=DATEFILE\n         like --date; once for each line of DATEFILE;\n         if DATEFILE is -, read names from standard input\n"
msgstr "  -f, --file=DATUMFIL\n         som --date; en gång för varje rad i DATUMFIL;\n         om DATUMFIL är -, läs namn från standard in\n"

#. from tp:coreutils-9.10-pre1
msgid "  -I[FMT], --iso-8601[=FMT]\n         output date/time in ISO 8601 format.\n         FMT='date' (default), 'hours', 'minutes', 'seconds', or 'ns'\n         for date and time to the indicated precision.\n         Example: 2006-08-14T02:34:56-06:00\n"
msgstr "  -I[FMT], --iso-8601[=FMT]\n         skriv ut datum/tid i ISO 8601-format.\n         FMT=”date” (standard), ”hours”, ”minutes”, ”seconds” eller ”ns”\n         för datum och tid med den angivna precisionen.\n         Exempel: 2006-08-14T02:34:56+01:00\n"

#. from tp:coreutils-9.10-pre1
msgid "      --resolution\n         output the available resolution of timestamps.\n         Example: 0.000000001\n"
msgstr "      --resolution\n         skriv ut den tillgängliga upplösningen på tidsstämplar.\n         Exempel: 0.000000001\n"

#. from tp:coreutils-9.10-pre1
msgid "  -R, --rfc-email\n         output date and time in RFC 5322 format.\n         Example: Mon, 14 Aug 2006 02:34:56 +0000\n"
msgstr "  -R, --rfc-email\n         skriv ut tid och datum enligt formatet RFC 5322.\n         Exempel: Mon, 14 Aug 2006 10:34:56 +0200\n"

#. from tp:coreutils-9.10-pre1
msgid "      --rfc-3339=FMT\n         output date/time in RFC 3339 format.\n         FMT='date', 'seconds', or 'ns'\n         for date and time to the indicated precision.\n         Example: 2006-08-14 02:34:56-06:00\n"
msgstr "      --rfc-3339=FMT\n         skriv ut tid och datum enligt formatet RFC 3339.\n         FMT=”date”, ”seconds” eller ”ns”\n         för tid och datum med angiven precision.\n         Exempel: 2006-08-14 10:34:56+02:00\n"

#. from tp:coreutils-9.10-pre1
msgid "  -r, --reference=FILE\n         display the last modification time of FILE\n"
msgstr "  -r, --reference=FIL\n         visa den tidpunkt då FIL senast modifierades\n"

#. from tp:coreutils-9.10-pre1
msgid "  -s, --set=STRING\n         set time described by STRING\n"
msgstr "  -s, --set=STRÄNG\n         sätt tiden som den beskrivs av STRÄNG\n"

#. from tp:coreutils-9.10-pre1
msgid "  -u, --utc, --universal\n         print or set Coordinated Universal Time (UTC)\n"
msgstr "  -u, --utc, --universal\n         visa eller sätt koordinerad universell tid (UTC)\n"

#. from tp:coreutils-9.10-pre1
msgid "\nAll options that specify the date to display are mutually exclusive.\nI.e.: --date, --file, --reference, --resolution.\n"
msgstr "\nAlla flaggor som anger datumet att visa är ömsesidigt uteslutande.\nD.v.s.: --date, --file, --reference, --resolution.\n"

#. from tp:coreutils-9.10-pre1
msgid "\nFORMAT controls the output.  Interpreted sequences are:\n\n  %%   a literal %\n  %a   locale's abbreviated weekday name (e.g., Sun)\n"
msgstr "\nFORMAT styr utskriften.  Tolkade sekvenser är:\n\n  %%   ett literalt %\n  %a   lokalens förkortade veckodagsnamn (t.ex. sön)\n"

#. from tp:coreutils-9.10-pre1
msgid "  %A   locale's full weekday name (e.g., Sunday)\n  %b   locale's abbreviated month name (e.g., Jan)\n  %B   locale's full month name (e.g., January)\n  %c   locale's date and time (e.g., Thu Mar  3 23:05:25 2005)\n"
msgstr "  %A   lokalens fullständiga veckodagsnamn (t.ex. söndag)\n  %b   lokalens förkortade månadsnamn (t.ex. jan)\n  %B   lokalens fullständiga månadsnamn (t.ex. januari)\n  %c   lokalens dag och tid (t.ex. ons  5 okt 2005 22.02.05)\n"

#. from tp:coreutils-9.10-pre1
msgid "  %C   century; like %Y, except omit last two digits (e.g., 20)\n  %d   day of month (e.g., 01)\n  %D   date (ambiguous); same as %m/%d/%y\n  %e   day of month, space padded; same as %_d\n"
msgstr "  %C   århundrade, som %Y, fast utelämna de sista två siffrorna (t.ex. 20)\n  %d   dag i månad (t.ex., 01)\n  %D   datum (tvetydigt); samma som %m/%d/%y\n  %e   dag i månad, blankutfyllt, samma som %_d\n"

#. from tp:coreutils-9.10-pre1
msgid "  %F   full date; like %+4Y-%m-%d\n  %g   last two digits of year of ISO week number (ambiguous; 00-99); see %G\n  %G   year of ISO week number; normally useful only with %V\n"
msgstr "  %F   fullständigt datum, samma som %+4Y-%m-%d\n  %g   de sista två siffrorna i året för ISO-veckonumret (tvetydigt; 00-99);\n         se %G\n  %G   året motsvarande ISO-veckonumret; normalt endast användbart med %V\n"

#. from tp:coreutils-9.10-pre1
msgid "  %h   same as %b\n  %H   hour (00..23)\n  %I   hour (01..12)\n  %j   day of year (001..366)\n"
msgstr "  %h   samma som %b\n  %H   timme (00-23)\n  %I   timme (01-12)\n  %j   dag på året (001-366)\n"

#. from tp:coreutils-9.10-pre1
msgid "  %k   hour, space padded ( 0..23); same as %_H\n  %l   hour, space padded ( 1..12); same as %_I\n  %m   month (01..12)\n  %M   minute (00..59)\n"
msgstr "  %k   timme, blankutfyllt ( 0-23); samma som %_H\n  %l   timme, blankutfyllt ( 1-12); samma som %_I\n  %m   månad (01-12)\n  %M   minut (00-59)\n"

#. from tp:coreutils-9.10-pre1
msgid "  %n   a newline\n  %N   nanoseconds (000000000..999999999)\n  %p   locale's equivalent of either AM or PM; blank if not known\n  %P   like %p, but lower case\n  %q   quarter of year (1..4)\n  %r   locale's 12-hour clock time (e.g., 11:11:04 PM)\n  %R   24-hour hour and minute; same as %H:%M\n  %s   seconds since the Epoch (1970-01-01 00:00 UTC)\n"
msgstr "  %n   en ny rad\n  %N   nanosekunder (000000000-999999999)\n  %p   lokalens FM- eller EM-indikator; tom om okänd\n  %P   som %p, men gemener\n  %q   kvartal av året (1..4)\n  %r   lokalens tid, 12-timmars (t.ex. 10:04:26)\n  %R   24-timmars timme och minut, samma som %H:%M\n  %s   sekunder sedan Epoken (1970-01-01 00.00 UTC)\n"

#. from tp:coreutils-9.10-pre1
msgid "  %S   second (00..60)\n  %t   a tab\n  %T   time; same as %H:%M:%S\n  %u   day of week (1..7); 1 is Monday\n"
msgstr "  %S   sekunder (00-60)\n  %t   en tabulator\n  %T   tid, samma som %H:%M:%S\n  %u   dag i veckan (1-7), 1 är måndag\n"

#. from tp:coreutils-9.10-pre1
msgid "  %U   week number of year, with Sunday as first day of week (00..53)\n  %V   ISO week number, with Monday as first day of week (01..53)\n  %w   day of week (0..6); 0 is Sunday\n  %W   week number of year, with Monday as first day of week (00..53)\n"
msgstr "  %U   veckonummer, med söndag som första dag i veckan (00-53)\n  %V   ISO-veckonummer, med måndag som första dag i veckan (01-53)\n  %w   veckodag (0-6); 0 är söndag\n  %W   veckonummer, med måndag som första dag i veckan (00-53)\n"

#. from tp:coreutils-9.10-pre1
msgid "  %x   locale's date (can be ambiguous; e.g., 12/31/99)\n  %X   locale's time representation (e.g., 23:13:48)\n  %y   last two digits of year (ambiguous; 00..99)\n  %Y   year\n"
msgstr "  %x   lokalens datum (kan vara tvetydigt; t.ex. 10/11/12)\n  %X   lokalens tidrepresentation (t.ex 23.13.48)\n  %y   sista två siffrorna i årtalet (tvetydigt; 00..99)\n  %Y   år\n"

#. from tp:coreutils-9.10-pre1
msgid "  %z   +hhmm numeric time zone (e.g., -0400)\n  %:z  +hh:mm numeric time zone (e.g., -04:00)\n  %::z  +hh:mm:ss numeric time zone (e.g., -04:00:00)\n  %:::z  numeric time zone with : to necessary precision (e.g., -04, +05:30)\n  %Z   alphabetic time zone abbreviation (e.g., EDT)\n\nBy default, date pads numeric fields with zeroes.\n"
msgstr "  %z   +hhmm numerisk tidszon (t.ex., -0400)\n  %:z  +hh:mm numerisk tidszon (t.ex., -04:00)\n  %::z  +hh:mm:ss numerisk tidszon (t.ex., -04:00:00)\n  %:::z  numerisk tidszon med : som behövs för precisionen (t.ex., -04, +05:30)\n  %Z   alfabetisk tidszonsförkortning (t.ex., CET)\n\nNormalt fyller date ut numeriska fält med nollor.\n"

#. from tp:coreutils-9.10-pre1
msgid "The following optional flags may follow '%':\n\n  -  (hyphen) do not pad the field\n  _  (underscore) pad with spaces\n  0  (zero) pad with zeros\n  +  pad with zeros, and put '+' before future years with >4 digits\n  ^  use upper case if possible\n  #  use opposite case if possible\n"
msgstr "Följande frivilliga flaggor kan komma efter ”%”:\n\n  -  (bindestreck) fyll inte ut fältet\n  _  (understrykning) fyll ut med blanksteg\n  0  (noll) fyll ut med nollor\n  +  fyll ut med nollor, och skriv ut ”+” före framtida år med >4 siffror\n  ^  använd versaler om möjligt\n  #  använd motsatt skiftläge om möjligt\n"

#. from tp:coreutils-9.10-pre1
msgid "\nAfter any flags comes an optional field width, as a decimal number;\nthen an optional modifier, which is either\nE to use the locale's alternate representations if available, or\nO to use the locale's alternate numeric symbols if available.\n"
msgstr "\nEfter eventuella flaggor följer en valfri fältbredd, som ett decimalt\ntal, sedan en valfri modifierare, som är antingen\nE för att använda lokalens alternativa representationer om tillgängliga, eller\nO för att använda lokalens alternativa numeriska symboler om tillgängliga.\n"

#. from tp:coreutils-9.10-pre1
msgid "\nExamples:\nConvert seconds since the Epoch (1970-01-01 UTC) to a date\n  $ date --date='@2147483647'\n\nShow the time on the west coast of the US (use tzselect(1) to find TZ)\n  $ TZ='America/Los_Angeles' date\n\nShow the local time for 9AM next Friday on the west coast of the US\n  $ date --date='TZ=\"America/Los_Angeles\" 09:00 next Fri'\n"
msgstr "\nExempel:\nKonvertera sekunder sedan Epoken (1970-01-01 UTC) till ett datum\n  $ date --date='@2147483647'\n\nVisa tiden i Helsingfors i Finland (använd tzselect(1) för att hitta TZ)\n  $ TZ='Europe/Helsinki' date\n\nVisa den lokala tiden för klockan 9 nästa fredag i Helsingfors i Finland\n  $ date --date='TZ=\"Europe/Helsinki\" 09:00 next Fri'\n"

#. from tp:coreutils-9.10-pre1
msgid "output format: %s"
msgstr "utdataformat: %s"

#. from tp:coreutils-9.10-pre1
msgid "invalid date %s"
msgstr "ogiltigt datum %s"

#. from tp:coreutils-9.10-pre1
msgid "the options to specify dates for printing are mutually exclusive"
msgstr "flaggorna för att ange datum för utskrift är ömsesidigt uteslutande"

#. from tp:coreutils-9.10-pre1
msgid "the options to print and set the time may not be used together"
msgstr "flaggorna för utskrift och för tidsinställning får inte användas tillsammans"

#. from tp:coreutils-9.10-pre1
msgid "only using last of multiple -d options"
msgstr "använder bara den sista av flera -d-flaggor"

#. from tp:coreutils-9.10-pre1
msgid "only using last of multiple -s options"
msgstr "använder bara den sista av flera -s-flaggor"

#. from tp:coreutils-9.10-pre1
msgid "multiple output formats specified"
msgstr "multipla utformat angivna"

#. from tp:coreutils-9.10-pre1
msgid "the argument %s lacks a leading '+';\nwhen using an option to specify date(s), any non-option\nargument must be a format string beginning with '+'"
msgstr "argumentet %s saknar ett inledande ”+”;\nnär en flagga används för att ange datum måste varje argument som inte\när en flagga vara en formatsträng som börjar med ”+”"

#. from tp:coreutils-9.10-pre1
msgid "cannot set date"
msgstr "kan inte ställa klockan"

#. from tp:coreutils-9.10-pre1
msgid "Paul Rubin"
msgstr "Paul Rubin"

#. from tp:coreutils-9.10-pre1
msgid "Usage: %s [OPERAND]...\n  or:  %s OPTION\n"
msgstr "Användning: %s [OPERAND]...\n   eller:   %s FLAGGA\n"

#. from tp:coreutils-9.10-pre1
msgid "Copy a file, converting and formatting according to the operands.\n\n"
msgstr "Kopiera en fil med konvertering och formatering enligt operanderna.\n\n"

#. from tp:coreutils-9.10-pre1
msgid "  bs=BYTES        read and write up to BYTES bytes at a time (default: 512);\n                  overrides ibs and obs\n"
msgstr "  bs=BYTE         läs och skriv upp till BYTE byte åt gången (standard: 512);\n                    åsidosätter ibs och obs\n"

#. from tp:coreutils-9.10-pre1
msgid "  cbs=BYTES       convert BYTES bytes at a time\n"
msgstr "  cbs=BYTE        konvertera BYTE byte åt gången\n"

#. from tp:coreutils-9.10-pre1
msgid "  conv=CONVS      convert the file as per the comma separated symbol list\n"
msgstr "  conv=KONV:ar    konvertera filen enligt den kommaseparerade symbollistan\n"

#. from tp:coreutils-9.10-pre1
msgid "  count=N         copy only N input blocks\n"
msgstr "  count=N         kopiera endast N inblock\n"

#. from tp:coreutils-9.10-pre1
msgid "  ibs=BYTES       read up to BYTES bytes at a time (default: 512)\n"
msgstr "  ibs=BYTE        läs upp till BYTE byte åt gången (standard: 512)\n"

#. from tp:coreutils-9.10-pre1
msgid "  if=FILE         read from FILE instead of standard input\n"
msgstr "  if=FIL          läs från FIL istället för standard in\n"

#. from tp:coreutils-9.10-pre1
msgid "  iflag=FLAGS     read as per the comma separated symbol list\n"
msgstr "  iflag=FLAGGOR   läs enligt den kommaseparerade symbollistan\n"

#. from tp:coreutils-9.10-pre1
msgid "  obs=BYTES       write BYTES bytes at a time (default: 512)\n"
msgstr "  obs=BYTE        skriv BYTE byte åt gången (standard: 512)\n"

#. from tp:coreutils-9.10-pre1
msgid "  of=FILE         write to FILE instead of standard output\n"
msgstr "  of=FIL          skriv till FIL istället för standard ut\n"

#. from tp:coreutils-9.10-pre1
msgid "  oflag=FLAGS     write as per the comma separated symbol list\n"
msgstr "  oflag=FLAGGOR   skriv enligt den kommaseparerade symbollistan\n"

#. from tp:coreutils-9.10-pre1
msgid "  seek=N          (or oseek=N) skip N obs sized output blocks\n"
msgstr "  seek=N          (eller oseek=N) hoppa över N obs-stora utdatablock\n"

#. from tp:coreutils-9.10-pre1
msgid "  skip=N          (or iseek=N) skip N ibs sized input blocks\n"
msgstr "  skip=N          (eller iseek=N) hoppa över N ibs-stora indatablock\n"

#. from tp:coreutils-9.10-pre1
msgid "  status=LEVEL    The LEVEL of information to print to standard error;\n                  'none' suppresses everything but error messages,\n                  'noxfer' suppresses the final transfer statistics,\n                  'progress' shows periodic transfer statistics\n"
msgstr "  status=NIVÅ     NIVÅ för informationen som ska skrivas till standard fel;\n                  ”none” utelämnar allt utom felmeddelanden,\n                  ”noxfer” utelämnar den avslutande överföringsstatistiken,\n                  ”progress” visar periodiskt överföringsstatistik\n"

#. from tp:coreutils-9.10-pre1
msgid "\nN and BYTES may be followed by the following multiplicative suffixes:\nc=1, w=2, b=512, kB=1000, K=1024, MB=1000*1000, M=1024*1024, xM=M,\nGB=1000*1000*1000, G=1024*1024*1024, and so on for T, P, E, Z, Y, R, Q.\nBinary prefixes can be used, too: KiB=K, MiB=M, and so on.\nIf N ends in 'B', it counts bytes not blocks.\n\nEach CONV symbol may be:\n\n"
msgstr "\nN och BYTE kan följas av de följande multiplikativa ändelserna:\nc=1, w=2, b=512, kB=1000, K=1024, MB=1000·1000, M=1024·1024, xM=M,\nGB=1000·1000·1000, G=1024·1024·1024, och så vidare för T, P, E, Z, Y, R, Q.\nBinära prefix kan också användas: KiB=K, MiB=M, och så vidare.\nOm N slutar i ”B” räknar den byte inte block.\n\nVarje KONV-symbol kan vara:\n\n"

#. from tp:coreutils-9.10-pre1
msgid "  ascii     from EBCDIC to ASCII\n  ebcdic    from ASCII to EBCDIC\n  ibm       from ASCII to alternate EBCDIC\n  block     pad newline-terminated records with spaces to cbs-size\n  unblock   replace trailing spaces in cbs-size records with newline\n  lcase     change upper case to lower case\n  ucase     change lower case to upper case\n  sparse    try to seek rather than write all-NUL output blocks\n  swab      swap every pair of input bytes\n  sync      pad every input block with NULs to ibs-size; when used\n            with block or unblock, pad with spaces rather than NULs\n"
msgstr "  ascii     från EBCDIC till ASCII\n  ebcdic    från ASCII till EBCDIC\n  ibm       från ASCII till en alternativ EBCDIC\n  block     fyll ut nyradsavslutade poster med blanktecken till cbs-storlek\n  unblock   ersätt avslutande blanktecken med nyrad i cbs-stora poster\n  lcase     ändra versaler till gemener\n  ucase     ändra gemener till versaler\n  sparse    försök flytta filpositionen i stället för att skriva utdatablock\n            som enbart består av NUL-tecken\n  swab      byt plats på varje par av byte i indata\n  sync      fyll ut varje indatablock med NUL-tecken till ibs-storlek;\n            med block eller unblock, använd blanktecken i stället\n"

#. from tp:coreutils-9.10-pre1
msgid "  excl      fail if the output file already exists\n  nocreat   do not create the output file\n  notrunc   do not truncate the output file\n  noerror   continue after read errors\n  fdatasync  physically write output file data before finishing\n  fsync     likewise, but also write metadata\n"
msgstr "  excl      misslyckas om utfilen redan finns\n  nocreat   skapa inte utfilen\n  notrunc   hugg inte av utfilen\n  noerror   fortsätt efter läsfel\n  fdatasync  skriv fysiskt data till utfilen före avslut\n  fsync     d:o, men skriv även metadata\n"

#. from tp:coreutils-9.10-pre1
msgid "\nEach FLAG symbol may be:\n\n  append    append mode (makes sense only for output; conv=notrunc suggested)\n"
msgstr "\nVarje FLAGG-symbol kan vara:\n\n  append    lägg-till-läge (meningsfullt endast för utmatning, conv=notrunc\n              rekommenderas)\n"

#. from tp:coreutils-9.10-pre1
msgid "  cio       use concurrent I/O for data\n"
msgstr "  cio       använd samtidig I/O för data\n"

#. from tp:coreutils-9.10-pre1
msgid "  direct    use direct I/O for data\n"
msgstr "  direct    använd direkt I/O för data\n"

#. from tp:coreutils-9.10-pre1
msgid "  directory  fail unless a directory\n"
msgstr "  directory  misslyckas om filen inte är en katalog\n"

#. from tp:coreutils-9.10-pre1
msgid "  dsync     use synchronized I/O for data\n"
msgstr "  dsync     använd synkroniserad I/O för data\n"

#. from tp:coreutils-9.10-pre1
msgid "  sync      likewise, but also for metadata\n"
msgstr "  sync      d:o, men även för metadata\n"

#. from tp:coreutils-9.10-pre1
msgid "  fullblock  accumulate full blocks of input (iflag only)\n"
msgstr "  fullblock  ackumulera hela block av indata (endast iflag)\n"

#. from tp:coreutils-9.10-pre1
msgid "  nonblock  use non-blocking I/O\n"
msgstr "  nonblock  använd icke blockerande I/O\n"

#. from tp:coreutils-9.10-pre1
msgid "  noatime   do not update access time\n"
msgstr "  noatime   uppdatera inte åtkomsttiden\n"

#. from tp:coreutils-9.10-pre1
msgid "  nocache   Request to drop cache.  See also oflag=sync\n"
msgstr "  nocache   begär att släppa cachen.  Se även oflag=sync\n"

#. from tp:coreutils-9.10-pre1
msgid "  noctty    do not assign controlling terminal from file\n"
msgstr "  noctty    tilldela inte styrterminal från fil\n"

#. from tp:coreutils-9.10-pre1
msgid "  nofollow  do not follow symlinks\n"
msgstr "  nofollow  följ inte symboliska länkar\n"

#. from tp:coreutils-9.10-pre1
msgid "  nolinks   fail if multiply-linked\n"
msgstr "  nolinks   misslyckas om filen har fler än en hård länk\n"

#. from tp:coreutils-9.10-pre1
msgid "  binary    use binary I/O for data\n"
msgstr "  binary    använd binär I/O för data\n"

#. from tp:coreutils-9.10-pre1
msgid "  text      use text I/O for data\n"
msgstr "  text      använd text-I/O för data\n"

#. from tp:coreutils-9.10-pre1
msgid "\nSending a %s signal to a running 'dd' process makes it\nprint I/O statistics to standard error and then resume copying.\n\nOptions are:\n\n"
msgstr "\nAtt skicka en %s-signal till en körande ”dd”-process får den att\nskriva in-/utstatistik på standard fel, och sedan fortsätta kopiera.\n\nFlaggorna är:\n\n"

