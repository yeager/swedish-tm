msgid "			   NOTE: all using same name and password!\n"
msgstr "			   OBSERVERA: alla använder samma namn och lösenord!\n"

#. from tp:fetchmail-6.6.0.rc3
msgid "      --fetchdomains fetch mail for specified domains\n"
msgstr "      --fetchdomains hämta post för angivna domäner\n"

#. from tp:fetchmail-6.6.0.rc3
msgid "  -D, --smtpaddress set SMTP delivery domain to use\n"
msgstr "  -D, --smtpaddress ange SMTP-leveransdomän som ska användas\n"

#. from tp:fetchmail-6.6.0.rc3
msgid "      --smtpname    set SMTP full name username@domain\n"
msgstr "      --smtpname    ange fullständigt SMTP-namn användarnamn@domän\n"

