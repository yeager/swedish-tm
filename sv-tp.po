msgstr "Använd vektorinstruktioner som lades till i ISA 3.0."

#. from tp:gcc-16.1-b20260222
msgid "Use the new min/max instructions defined in ISA 3.0."
msgstr "Använd de nya min-/maxinstruktionerna som definierades i ISA 3.0."

#. from tp:gcc-16.1-b20260222
msgid "Generate the integer modulo instructions."
msgstr "Generera heltalsmoduloinstruktioner."

#. from tp:gcc-16.1-b20260222
msgid "Enable IEEE 128-bit floating point via the __float128 keyword."
msgstr "Aktivera IEEE-flyttal med 128 bitar via nyckelordet __float128."

#. from tp:gcc-16.1-b20260222
msgid "Enable using IEEE 128-bit floating point instructions."
msgstr "Aktivera användning av IEEE-flyttalsinstruktioner med 128 bitar."

#. from tp:gcc-16.1-b20260222
msgid "Enable default conversions between __float128 & long double."
msgstr "Aktivera standardkonverteringar mellan __float128 och long double."

#. from tp:gcc-16.1-b20260222
msgid "Use given stack-protector guard."
msgstr "Använd angiven stackskyddsvakt."

#. from tp:gcc-16.1-b20260222
