#. from tp:parted-3.4.64.2
msgid "Could not write VTOC FMT9 DSCB."
msgstr "Kunde inte skriva VTOC FMT9 DSCB."

#. from tp:parted-3.4.64.2
msgid "Out of memory."
msgstr "Slut på minne."

#. from tp:parted-3.4.64.2
