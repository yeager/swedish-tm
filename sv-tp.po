msgid "Relocated information"
msgstr "Omplaceringsinformation"

#. from tp:vmm-0.7.0
msgid "	User '%(addr)s' has moved to '%(dest)s'"
msgstr "	Användare ”%(addr)s” har flyttat till ”%(dest)s”"

#. from tp:vmm-0.7.0
msgid "Existing domains"
msgstr "Existerande domäner"

#. from tp:vmm-0.7.0
msgid "Matching domains"
msgstr "Matchande domäner"

#. from tp:vmm-0.7.0
msgid "user accounts"
msgstr "användarkonton"

#. from tp:vmm-0.7.0
msgid "user accounts and aliases"
msgstr "användarkonton och alias"

#. from tp:vmm-0.7.0
msgid "user accounts and relocated users"
msgstr "användarkonton och omplacerade användare"

#. from tp:vmm-0.7.0
msgid "aliases and relocated users"
msgstr "alias och omplacerade användare"

#. from tp:vmm-0.7.0
msgid "addresses"
msgstr "adresser"

#. from tp:vmm-0.7.0
msgid "Matching %s"
msgstr "Matchar %s"

#. from tp:vmm-0.7.0
msgid "Existing %s"
msgstr "Befintliga %s"

#. from tp:vmm-0.7.0
msgid "Invalid address type for list: '%s'"
msgstr "Ogiltig adresstyp för lista: ”%s”"

#. from tp:vmm-0.7.0
msgid "Alias domain information"
msgstr "Aliasdomäninformation"

#. from tp:vmm-0.7.0
msgid "	The alias domain %(alias)s belongs to:\n	    * %(domain)s"
msgstr "	Aliasdomänen %(alias)s tillhör:\n	    * %(domain)s"

#. from tp:vmm-0.7.0
msgid "No such file: '%s'"
msgstr "Ingen sådan fil: ”%s”"

#. from tp:vmm-0.7.0
msgid "File is not executable: '%s'"
msgstr "Filen är inte körbar: ”%s”"

#. from tp:vmm-0.7.0
msgid "%(size)s %(prefix)s"
msgstr "%(size)s %(prefix)s"

#. from tp:vmm-0.7.0
msgid "Invalid transport '%(transport)s' for mailbox format '%(mbfmt)s'."
msgstr "Ogiltig transport ”%(transport)s” för brevlådeformat ”%(mbfmt)s”."

#. from tp:vmm-0.7.0
msgid "%s [domain default]"
msgstr "%s [domänstandard]"

#. from tp:vmm-0.7.0
msgid "Not a boolean: '%s'"
msgstr "Inte ett booleskt värde: ”%s”"

#. from tp:vmm-0.7.0
msgid "Bad format: '%s' - expected: section.option"
msgstr "Felaktigt format: ”%s” - förväntat: avsnitt.flagga"

#. from tp:vmm-0.7.0
msgid "* Section: %s\n"
msgstr "* Avsnitt: %s\n"

#. from tp:vmm-0.7.0
msgid "Check of configuration file %s failed.\n"
msgstr "Kontroll av konfigurationsfil %s misslyckades.\n"

#. from tp:vmm-0.7.0
msgid "Missing options, which have no default value.\n"
msgstr "Saknar flaggor som saknar standardvärden.\n"

#. from tp:vmm-0.7.0
msgid "Invalid configuration values.\n"
msgstr "Ogiltiga konfigurationsvärden.\n"

#. from tp:vmm-0.7.0
msgid "Unknown pgsql SSL mode: '%s'"
msgstr "Okänt pgsql SSL-läge: ”%s”"

#. from tp:vmm-0.7.0
msgid "Unsupported mailbox format: '%s'"
msgstr "Brevlådeformat stöds inte: ”%s”"

#. from tp:vmm-0.7.0
msgid "No such directory: %s"
msgstr "Ingen sådan katalog: %s"

#. from tp:vmm-0.7.0
msgid "Not a valid size value: '%s'"
msgstr "Inte ett giltigt storleksvärde: ”%s”"

#. from tp:vmm-0.7.0
msgid "Not a valid Dovecot version: '%s'"
msgstr "Inte en giltig Dovecot-version: ”%s”"

#. from tp:vmm-0.7.0
msgid "vmm requires Dovecot >= %s"
msgstr "vmm kräver Dovecot >= %s"

#. from tp:vmm-0.7.0
msgid "The domain '%s' is an alias domain."
msgstr "Domänen ”%s” är en aliasdomän."

#. from tp:vmm-0.7.0
msgid "There are %(account_count)u accounts, %(alias_count)u aliases and %(relocated_count)u relocated users."
msgstr "Det finns %(account_count)u konton, %(alias_count)u alias och %(relocated_count)u omplacerade användare."

#. from tp:vmm-0.7.0
msgid "The domain '%s' already exists."
msgstr "Domänen ”%s” finns redan."

#. from tp:vmm-0.7.0
msgid "The domain name is too long"
msgstr "Domännamnet är för långt"

#. from tp:vmm-0.7.0
msgid "The domain name '%s' is invalid"
msgstr "Domännamnet ”%s” är ogiltigt"

#. from tp:vmm-0.7.0
msgid "Missing the '@' sign in address: '%s'"
msgstr "Saknar snabel-a ”@” i adress: ”%s”"

#. from tp:vmm-0.7.0
msgid "Too many '@' signs in address: '%s'"
msgstr "För många snabel-a ”@” i adress: ”%s”"

#. from tp:vmm-0.7.0
msgid "Missing local-part in address: '%s'"
msgstr "Saknar lokal-del i adress: ”%s”"

#. from tp:vmm-0.7.0
msgid "Missing domain name in address: '%s'"
msgstr "Saknar domännamn i adress: ”%s”"

#. from tp:vmm-0.7.0
msgid "The local-part '%s' is too long."
msgstr "Lokaldelen ”%s” är allt för lång."

#. from tp:vmm-0.7.0
msgid "The local-part '%(l_part)s' contains invalid characters: %(i_chars)s"
msgstr "Lokaldelen ”%(l_part)s” innehåller ogiltiga tecken: %(i_chars)s"

#. from tp:vmm-0.7.0
msgid "The value '%s' does not look like a valid Postfix configuration parameter name."
msgstr "Värdet ”%s” ser inte ut som ett giltigt namn på en Postfix-konfigurationsparameter."

#. from tp:vmm-0.7.0
msgid "an account"
msgstr "ett konto"

#. from tp:vmm-0.7.0
msgid "an alias"
msgstr "ett alias"

#. from tp:vmm-0.7.0
msgid "a relocated user"
msgstr "en omplacerad användare"

#. from tp:vmm-0.7.0
msgid "You are not root.\n	Good bye!\n"
msgstr "Du är inte root.\n	Hejdå!\n"

#. from tp:vmm-0.7.0
msgid "Could not find '%(cfg_file)s' in: '%(cfg_path)s'"
msgstr "Det gick inte att hitta ”%(cfg_file)s” i: ”%(cfg_path)s”"

#. from tp:vmm-0.7.0
msgid "wrong permissions for '%(file)s': %(perms)s\n`chmod 0600 %(file)s` would be great."
msgstr "felaktiga rättigheter för ”%(file)s”: %(perms)s\n”chmod 0600 %(file)s” hade varit utmärkt."

#. from tp:vmm-0.7.0
msgid "'%(path)s' is not a directory.\n(%(cfg_file)s: section 'misc', option 'base_directory')"
msgstr "”%(path)s” är inte en katalog.\n(%(cfg_file)s: avsnitt ”misc”, flagga ”base_directory”)"

#. from tp:vmm-0.7.0
msgid "\n(%(cfg_file)s: section 'bin', option '%(option)s')"
msgstr "\n(%(cfg_file)s: avsnitt ”bin”, flagga ”%(option)s”)"

#. from tp:vmm-0.7.0
msgid "There is already %(a_type)s with the address '%(address)s'."
