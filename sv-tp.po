msgstr "Tryck på retur för att bekräfta."

#. from tp:meritous-1.5
msgid "G A M E   O V E R"
msgstr "S P E L E T   Ä R   Ö V E R"

#. from tp:meritous-1.5
msgid "Psi Circuit"
msgstr "Psi-krets"

#. from tp:meritous-1.5
msgid "This is a checkpoint, but it doesn't seem to be working"
msgstr "Det här är en kontrollpunkt, men den verkar inte fungera"

#. from tp:meritous-1.5
