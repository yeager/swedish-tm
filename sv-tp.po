msgstr "oldaddlyrics stöds inte längre.\n Använd addlyrics eller lyricsto istället.\n"

#. from tp:lilypond-2.23.80
msgid "keySignature property not reversed any more\nMIDI 47: orchestral strings -> orchestral harp"
msgstr "keySignature-egenskapen är inte omvänd längre\nMIDI 47: orchestral strings -> orchestral harp"

