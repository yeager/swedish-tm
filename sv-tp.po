msgid "Linux documentation at: <https://docs.kernel.org/block/pr.html> iSCSI specification at: <https://datatracker.ietf.org/doc/html/rfc3720> NVMe-oF specification at: <https://nvmexpress.org/nvme-over-fabrics-part-two/>"
msgstr "Linux-dokumentation på: <https://docs.kernel.org/block/pr.html> iSCSI-specifikation på: <https://datatracker.ietf.org/doc/html/rfc3720> NVMe-oF-specifikation på: <https://nvmexpress.org/nvme-over-fabrics-part-two/>"

#. from tp:util-linux-man-2.41.2-rc1
msgid "chcpu(8)"
msgstr "chcpu(8)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "chcpu - configure CPUs"
msgstr "chcpu - konfigurera processorer"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*chcpu* *-c*|*-d*|*-e*|*-g* _cpu-list_"
msgstr "*chcpu* *-c*|*-d*|*-e*|*-g* _cpu-list_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*chcpu* *-p* _mode_"
msgstr "*chcpu* *-p* _läge_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*chcpu* *-r*|*-h*|*-V*"
msgstr "*chcpu* *-r*|*-h*|*-V*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*chcpu* can modify the state of CPUs. It can enable or disable CPUs, scan for new CPUs, change the CPU dispatching _mode_ of the underlying hypervisor, and request CPUs from the hypervisor (configure) or return CPUs to the hypervisor (deconfigure)."
msgstr "*chcpu* kan ändra processorns tillstånd. Den kan aktivera eller inaktivera processorer, söka efter nya processorer, ändra den underliggande hypervisorns _läge_ för processordistribution och begära processorer från hypervisorn (konfigurera) eller returnera processorer till hypervisorn (avkonfigurera)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Some options have a _cpu-list_ argument. Use this argument to specify a comma-separated list of CPUs. The list can contain individual CPU addresses or ranges of addresses. For example, *0,5,7,9-11* makes the command applicable to the CPUs with the addresses 0, 5, 7, 9, 10, and 11."
msgstr "Vissa flaggor har ett _cpu-list_-argument. Använd detta argument för att ange en kommaseparerad lista med processorer. Listan kan innehålla enskilda CPU-adresser eller adressintervall. Exempel: *0,5,7,9-11* gör att kommandot kan användas för processorer med adresserna 0, 5, 7, 9, 10 och 11."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-c*, *--configure* _cpu-list_"
msgstr "*-c*, *--configure* _cpu-list_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Configure the specified CPUs. Configuring a CPU means that the hypervisor takes a CPU from the CPU pool and assigns it to the virtual hardware on which your kernel runs."
msgstr "Konfigurera de angivna processorerna. Att konfigurera en CPU innebär att hypervisor tar en CPU från CPU-poolen och tilldelar den till den virtuella maskinvaran som din kärna körs på."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-d*, *--disable* _cpu-list_"
msgstr "*-d*, *--disable* _cpu-list_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Disable the specified CPUs. Disabling a CPU means that the kernel sets it offline."
msgstr "Inaktivera de angivna processorerna. Att inaktivera en CPU innebär att kärnan sätter den offline."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-e*, *--enable* _cpu-list_"
msgstr "*-e*, *--enable* _cpu-list_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Enable the specified CPUs. Enabling a CPU means that the kernel sets it online. A CPU must be configured, see *-c*, before it can be enabled."
msgstr "Aktivera de angivna processorerna. Aktivering av en processor innebär att kärnan sätter den online. En CPU måste konfigureras, se *-c*, innan den kan aktiveras."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-g*, *--deconfigure* _cpu-list_"
msgstr "*-g*, *--deconfigure* _cpu-list_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Deconfigure the specified CPUs. Deconfiguring a CPU means that the hypervisor removes the CPU from the virtual hardware on which the Linux instance runs and returns it to the CPU pool. A CPU must be offline, see *-d*, before it can be deconfigured."
msgstr "Dekonfigurera de angivna processorerna. Att avkonfigurera en processor innebär att hypervisorn tar bort processorn från den virtuella maskinvaran som Linux-instansen körs på och återför den till processorpoolen. En processor måste vara offline, se *-d*, innan den kan avkonfigureras."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*chcpu -g* is not supported on IBM z/VM, CPUs are always in a configured state."
msgstr "*chcpu -g* stöds inte på IBM z/VM, processorer är alltid i ett konfigurerat tillstånd."

#. from tp:util-linux-man-2.41.2-rc1
msgid "if *chcpu -g* is supported, any *disabled* CPUs should be *deconfigured* to inform the hypervisor that these CPUs won't be used, avoiding potential performance penalties."
msgstr "om *chcpu -g* stöds bör alla *inaktiverade* processorer *dekonfigureras* för att informera hypervisorn om att dessa processorer inte kommer att användas, för att undvika potentiella prestandaförluster."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-p*, *--dispatch* _mode_"
msgstr "*-p*, *--dispatch* _läge_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Set the CPU dispatching _mode_ (polarization). This option has an effect only if your hardware architecture and hypervisor support CPU polarization. Available _modes_ are:"
msgstr "Ställ in CPU-dispatching _läge_ (polarisering). Den här flaggan har endast effekt om maskinvaruarkitekturen och hypervisorn stöder CPU-polarisering. Tillgängliga _modes_ är:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*horizontal*"
msgstr "*horisontellt*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "The workload is spread across all available CPUs."
msgstr "Arbetsbelastningen fördelas på alla tillgängliga processorer."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*vertical*"
msgstr "*vertikal*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "The workload is concentrated on few CPUs."
msgstr "Arbetsbelastningen koncentreras till ett fåtal processorer."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-r*, *--rescan*"
msgstr "*-r*, *--rescan*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Trigger a rescan of CPUs. After a rescan, the Linux kernel recognizes the new CPUs. Use this option on systems that do not automatically detect newly attached CPUs."
msgstr "Starta en ny genomsökning av processorerna. Efter en ny genomsökning känner Linux-kärnan igen de nya processorerna. Använd den här flaggan på system som inte automatiskt upptäcker nyanslutna processorer."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*chcpu* has the following exit status values:"
msgstr "*chcpu* har följande värden för utgångsstatus:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "partial success"
msgstr "delvis framgång"

#. from tp:util-linux-man-2.41.2-rc1
msgid "mailto:heiko.carstens@de.ibm.com[Heiko Carstens]"
msgstr "mailto:heiko.carstens@de.ibm.com[Heiko Carstens]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Copyright IBM Corp. 2011"
msgstr "Upphovsrätt IBM Corp. 2011"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*lscpu*(1)"
msgstr "*lscpu*(1)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "chmem(8)"
msgstr "chmem(8)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "chmem - configure memory"
msgstr "chmem - konfigurera minne"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*chmem* [*-h] [*-V*] [*-v*] [*-e*|*-d*] [_SIZE_|_RANGE_ *-b* _BLOCKRANGE_] [*-z* _ZONE_]"
msgstr "*chmem* [*-h] [*-V*] [*-v*] [*-e*|*-d*] [_SIZE_|_RANGE_ *-b* _BLOCKRANGE_] [*-z* _ZONE_]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "The chmem command sets a particular size or range of memory online or offline."
msgstr "Kommandot chmem ställer in en viss storlek eller ett visst minnesintervall online eller offline."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Specify _SIZE_ as <size>[m|M|g|G]. With m or M, <size> specifies the memory size in MiB (1024 x 1024 bytes). With g or G, <size> specifies the memory size in GiB (1024 x 1024 x 1024 bytes). The default unit is MiB."
msgstr "Ange _SIZE_ som <size>[m|M|g|G]. Med m eller M anger <size> minnesstorleken i MiB (1024 x 1024 byte). Med g eller G anger <size> minnesstorleken i GiB (1024 x 1024 x 1024 byte). Standardenheten är MiB."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Specify _RANGE_ in the form 0x<start>-0x<end> as shown in the output of the *lsmem*(1) command. <start> is the hexadecimal address of the first byte and <end> is the hexadecimal address of the last byte in the memory range."
msgstr "Ange _RANGE_ i formen 0x<start>-0x<end> som visas i utdata från kommandot *lsmem*(1). <start> är den hexadecimala adressen för den första byten och <end> är den hexadecimala adressen för den sista byten i minnesområdet."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Specify _BLOCKRANGE_ in the form <first>-<last> or <block> as shown in the output of the *lsmem*(1) command. <first> is the number of the first memory block and <last> is the number of the last memory block in the memory range. Alternatively a single block can be specified. _BLOCKRANGE_ requires the *--blocks* option."
msgstr "Ange _BLOCKRANGE_ i formen <first>-<last> eller <block> som visas i utdata från kommandot *lsmem*(1). <first> är numret på det första minnesblocket och <last> är numret på det sista minnesblocket i minnesintervallet. Alternativt kan ett enda block specificeras. _BLOCKRANGE_ kräver flaggan *--blocks*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Specify _ZONE_ as the name of a memory zone, as shown in the output of the *lsmem -o +ZONES* command. The output shows one or more valid memory zones for each memory range. If multiple zones are shown, then the memory range currently belongs to the first zone. By default, *chmem* will set memory online to the zone Movable, if this is among the valid zones. This default can be changed by specifying the *--zone* option with another valid zone. For memory ballooning, it is recommended to select the zone Movable for memory online and offline, if possible. Memory in this zone is much more likely to be able to be offlined again, but it cannot be used for arbitrary kernel allocations, only for migratable pages (e.g., anonymous and page cache pages). Use the *--help* option to see all available zones."
msgstr "Ange _ZONE_ som namn på en minneszon, enligt vad som visas i utdata från kommandot *lsmem -o +ZONES*. Utmatningen visar en eller flera giltiga minneszoner för varje minnesintervall. Om flera zoner visas tillhör minnesområdet för närvarande den första zonen. Som standard kommer *chmem* att ställa in minnet online till zonen Movable, om denna finns bland de giltiga zonerna. Denna standard kan ändras genom att ange flaggan *--zone* med en annan giltig zon. För minnesballongering rekommenderas att zonen Movable väljs för minne online och offline, om möjligt. Det är mycket mer sannolikt att minnet i den här zonen kan offlinas igen, men det kan inte användas för godtyckliga kärnallokeringar, bara för migrerbara sidor (t.ex. anonyma sidor och sidcachesidor). Använd flaggan *--help* för att se alla tillgängliga zoner."

#. from tp:util-linux-man-2.41.2-rc1
msgid "_SIZE_ and _RANGE_ must be aligned to the Linux memory block size, as shown in the output of the *lsmem*(1) command."
msgstr "_STRL_ och _RANGE_ måste vara anpassade till Linux minnesblockstorlek, vilket visas i utdata från kommandot *lsmem*(1)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Setting memory online can fail for various reasons. On virtualized systems it can fail if the hypervisor does not have enough memory left, for example because memory was overcommitted. Setting memory offline can fail if Linux cannot free the memory. If only part of the requested memory can be set online or offline, a message tells you how much memory was set online or offline instead of the requested amount."
msgstr "Att ställa in minne online kan misslyckas av olika skäl. På virtualiserade system kan det misslyckas om hypervisorn inte har tillräckligt med minne kvar, till exempel för att minnet har överbelastats. Att ställa in minne offline kan misslyckas om Linux inte kan frigöra minnet. Om bara en del av det begärda minnet kan ställas in online eller offline, visas ett meddelande om hur mycket minne som ställdes in online eller offline i stället för den begärda mängden."

#. from tp:util-linux-man-2.41.2-rc1
msgid "When setting memory online *chmem* starts with the lowest memory block numbers. When setting memory offline *chmem* starts with the highest memory block numbers."
msgstr "När minnet ställs in online börjar *chmem* med de lägsta minnesblocksnumren. När du ställer in minnet offline börjar *chmem* med de högsta minnesblocksnumren."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-b*, *--blocks*"
msgstr "*-b*, *--blocks*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Use a _BLOCKRANGE_ parameter instead of _RANGE_ or _SIZE_ for the *--enable* and *--disable* options."
msgstr "Använd en _BLOCKRANGE_-parameter i stället för _RANGE_ eller _SIZE_ för flaggorna *--enable* och *--disable*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-d*, *--disable*"
msgstr "*-d*, *--disable*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Set the specified _RANGE_, _SIZE_, or _BLOCKRANGE_ of memory offline."
msgstr "Ställ in det angivna _RANGE_, _SIZE_ eller _BLOCKRANGE_ av minne offline."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-e*, *--enable*"
msgstr "*-e*, *--enable*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Set the specified _RANGE_, _SIZE_, or _BLOCKRANGE_ of memory online."
msgstr "Ställ in det angivna _RANGE_, _SIZE_ eller _BLOCKRANGE_ av minne online."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-z*, *--zone*"
msgstr "*-z*, *--zone*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Select the memory _ZONE_ where to set the specified _RANGE_, _SIZE_, or _BLOCKRANGE_ of memory online or offline. By default, memory will be set online to the zone Movable, if possible."
msgstr "Välj minnes _ZONE_ där du vill ställa in det angivna _RANGE_, _SIZE_ eller _BLOCKRANGE_ för minnet online eller offline. Som standard kommer minnet att ställas in online till zonen Movable, om möjligt."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Verbose mode. Causes *chmem* to print debugging messages about its progress."
msgstr "Utförligt läge. Gör att *chmem* skriver ut felsökningsmeddelanden om hur arbetet fortskrider."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*chmem* has the following exit status values:"
msgstr "*chmem* har följande värden för utgångsstatus:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*chmem --enable 1024*"
msgstr "*chmem --enable 1024*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "This command requests 1024 MiB of memory to be set online."
msgstr "Detta kommando begär att 1024 MiB minne ska sättas online."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*chmem -e 2g*"
msgstr "*chmem -e 2g*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "This command requests 2 GiB of memory to be set online."
msgstr "Detta kommando begär att 2 GiB minne ska ställas in online."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*chmem --disable 0x00000000e4000000-0x00000000f3ffffff*"
msgstr "*chmem --disable 0x00000000e4000000-0x00000000f3ffffff*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "This command requests the memory range starting with 0x00000000e4000000 and ending with 0x00000000f3ffffff to be set offline."
msgstr "Detta kommando begär att minnesområdet som börjar med 0x00000000e4000000 och slutar med 0x00000000f3ffffff ska sättas offline."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*chmem -b -d 10*"
msgstr "*chmem -b -d 10*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "This command requests the memory block number 10 to be set offline."
msgstr "Detta kommando begär att minnesblock nummer 10 ska sättas offline."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*lsmem*(1)"
msgstr "*lsmem*(1)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "choom(1)"
msgstr "choom(1)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "choom - display and adjust OOM-killer score."
msgstr "choom - visa och justera poäng för OOM-killer."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*choom* *-p* _PID_"
msgstr "*choom* *-p* _PID_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*choom* *-p* _PID_ *-n* _number_"
msgstr "*choom* *-p* _PID_ *-n* _nummer_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*choom* *-n* _number_ [--] _command_ [_argument_ ...]"
msgstr "*choom* *-n* _nummer_ [--] _kommando_ [_argument_ ...]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "The *choom* command displays and adjusts Out-Of-Memory killer score setting."
msgstr "Kommandot *choom* visar och justerar inställningen för Out-Of-Memory killer score."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Specifies process ID."
msgstr "Anger process-ID."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-n*, *--adjust* _value_"
msgstr "*-n*, *--adjust* _värde_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Specify the adjust score value."
msgstr "Ange värdet för justeringspoängen."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Linux kernel uses the badness heuristic to select which process gets killed in out of memory conditions."
msgstr "Linux-kärnan använder badness-heuristiken för att välja vilken process som ska dödas när minnet inte räcker till."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The badness heuristic assigns a value to each candidate task ranging from 0 (never kill) to 1000 (always kill) to determine which process is targeted. The units are roughly a proportion along that range of allowed memory the process may allocate from based on an estimation of its current memory and swap use. For example, if a task is using all allowed memory, its badness score will be 1000. If it is using half of its allowed memory, its score will be 500."
msgstr "Badness-heuristiken tilldelar varje kandidatuppgift ett värde från 0 (dödar aldrig) till 1000 (dödar alltid) för att avgöra vilken process som är målet. Enheterna är ungefär en proportion längs det intervall av tillåtet minne som processen kan allokera från baserat på en uppskattning av dess aktuella minnes- och växlingsanvändning. Om en uppgift till exempel använder allt tillåtet minne kommer dess badness-poäng att vara 1000. Om den använder hälften av det tillåtna minnet blir poängen 500."

#. from tp:util-linux-man-2.41.2-rc1
msgid "There is an additional factor included in the badness score: the current memory and swap usage is discounted by 3% for root processes."
msgstr "Det finns ytterligare en faktor som ingår i poängen för dålighet: den aktuella minnes- och växlingsanvändningen diskonteras med 3% feller rotprocesser."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The amount of \"allowed\" memory depends on the context in which the oom killer was called. If it is due to the memory assigned to the allocating task's cpuset being exhausted, the allowed memory represents the set of mems assigned to that cpuset. If it is due to a mempolicy's node(s) being exhausted, the allowed memory represents the set of mempolicy nodes. If it is due to a memory limit (or swap limit) being reached, the allowed memory is that configured limit. Finally, if it is due to the entire system being out of memory, the allowed memory represents all allocatable resources."
msgstr "Mängden \"tillåtet\" minne beror på i vilket sammanhang oom killer anropades. Om det beror på att det minne som tilldelats den allokerande uppgiftens cpuset är uttömt, representerar det tillåtna minnet den uppsättning mems som tilldelats det cpuset. Om det beror på att en mempolicys nod(er) är uttömd, representerar det tillåtna minnet uppsättningen mempolicy-noder. Om det beror på att en minnesgräns (eller växlingsgräns) har nåtts, är det tillåtna minnet den konfigurerade gränsen. Slutligen, om det beror på att hela systemet har slut på minne, representerar det tillåtna minnet alla allokeringsbara resurser."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The adjust score value is added to the badness score before it is used to determine which task to kill. Acceptable values range from -1000 to +1000. This allows userspace to polarize the preference for oom killing either by always preferring a certain task or completely disabling it. The lowest possible value, -1000, is equivalent to disabling oom killing entirely for that task since it will always report a badness score of 0."
msgstr "Adjust score-värdet läggs till badness-poängen innan det används för att avgöra vilken uppgift som ska dödas. Acceptabla värden sträcker sig från -1000 till +1000. Detta gör det möjligt för userspace att polarisera preferensen för oom killing antingen genom att alltid föredra en viss uppgift eller genom att helt inaktivera den. Det lägsta möjliga värdet, -1000, motsvarar att oom killing inaktiveras helt för den uppgiften eftersom den alltid kommer att rapportera en badness score på 0."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Setting an adjust score value of +500, for example, is roughly equivalent to allowing the remainder of tasks sharing the same system, cpuset, mempolicy, or memory controller resources to use at least 50% more memory. A value of -500, on the other hand, would be roughly equivalent to discounting 50% of the task's allowed memory from being considered as scoring against the task."
msgstr "Om du till exempel anger ett värde för justeringspoäng på +500 motsvarar det ungefär att resten av de uppgifter som delar samma resurser för system, cpuset, mempolicy eller minneskontroller får använda minst 50 % mer minne. Ett värde på -500, å andra sidan, skulle ungefär motsvara att 50% of av uppgiftens tillåtna minne inte skulle betraktas som poäng mot uppgiften."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*proc*(5)"
msgstr "*proc*(5)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "ctrlaltdel(8)"
msgstr "ctrlaltdel(8)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "ctrlaltdel - set the function of the Ctrl-Alt-Del combination"
msgstr "ctrlaltdel - ställ in funktionen för kombinationen Ctrl-Alt-Del"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*ctrlaltdel* *hard*|*soft*"
msgstr "*ctrlaltdel* *hard*|*soft*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Based on examination of the _linux/kernel/reboot.c_ code, it is clear that there are two supported functions that the <Ctrl-Alt-Del> sequence can perform."
msgstr "Baserat på en undersökning av koden _linux/kernel/reboot.c_ är det tydligt att det finns två funktioner som stöds och som <Ctrl-Alt-Del> -sekvensen kan utföra."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*hard*"
msgstr "*hard*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Immediately reboot the computer without calling *sync*(2) and without any other preparation. This is the default."
msgstr "Starta om datorn omedelbart utan att anropa *sync*(2) och utan några andra förberedelser. Detta är standardinställningen."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*soft*"
msgstr "*soft*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Make the kernel send the *SIGINT* (interrupt) signal to the *init* process (this is always the process with PID 1). If this option is used, the *init*(8) program must support this feature. Since there are now several *init*(8) programs in the Linux community, please consult the documentation for the version that you are currently using."
msgstr "Få kärnan att skicka signalen *SIGINT* (avbrott) till *init*-processen (detta är alltid processen med PID 1). Om denna flagga används måste *init*(8)-programmet stödja denna funktion. Eftersom det nu finns flera *init*(8)-program i Linux-gemenskapen, bör du läsa dokumentationen för den version som du använder för närvarande."

#. from tp:util-linux-man-2.41.2-rc1
msgid "When the command is run without any argument, it will display the current setting."
msgstr "När kommandot körs utan något argument visas den aktuella inställningen."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The function of *ctrlaltdel* is usually set in the _/etc/rc.local_ file."
msgstr "Funktionen för *ctrlaltdel* ställs vanligtvis in i filen _/etc/rc.local_."

#. from tp:util-linux-man-2.41.2-rc1
msgid "_/etc/rc.local_"
msgstr "_/etc/rc.local_ _/etc/rc.local"

#. from tp:util-linux-man-2.41.2-rc1
msgid "mailto:poe@daimi.aau.dk[Peter Orbaek]"
msgstr "mailto:poe@daimi.aau.dk[Peter Orbaek]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*init*(8), *systemd*(1)"
msgstr "*init*(8), *systemd*(1)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "dmesg(1)"
msgstr "dmesg(1)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "dmesg - print or control the kernel ring buffer"
msgstr "dmesg - skriva ut eller kontrollera kärnans ringbuffert"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*dmesg* [options]"
msgstr "*dmesg* [flaggor]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*dmesg* *--clear*"
msgstr "*dmesg* *--clear*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*dmesg* *--read-clear* [options]"
msgstr "*dmesg* *--read-clear* [flaggor]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*dmesg* *--console-level* _level_"
msgstr "*dmesg* *--konsolnivå* _nivå_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*dmesg* *--console-on*"
msgstr "*dmesg* *--konsol-på*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*dmesg* *--console-off*"
msgstr "*dmesg* *--konsol-av*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*dmesg* is used to examine or control the kernel ring buffer."
msgstr "*dmesg* används för att undersöka eller kontrollera kärnans ringbuffert."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The default action is to display all messages from the kernel ring buffer."
msgstr "Standardåtgärden är att visa alla meddelanden från kärnans ringbuffert."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The *--clear*, *--read-clear*, *--console-on*, *--console-off*, and *--console-level* options are mutually exclusive."
msgstr "Flaggorna *--clear*, *--read-clear*, *--console-on*, *--console-off* och *--console-level* är ömsesidigt uteslutande."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Clear the ring buffer."
msgstr "Rensa ringbufferten."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-c*, *--read-clear*"
msgstr "*-c*, *--read-clear*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Clear the ring buffer after first printing its contents."
msgstr "Rensa ringbufferten efter den första utskriften av dess innehåll."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-D*, *--console-off*"
msgstr "*-D*, *--console-off*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Disable the printing of messages to the console."
msgstr "Inaktivera utskrift av meddelanden till konsolen."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-d*, *--show-delta*"
msgstr "*-d*, *--show-delta*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Display the timestamp and the time delta spent between messages. If used together with *--notime* then only the time delta without the timestamp is printed."
msgstr "Visar tidsstämpel och tidsdelta mellan meddelanden. Om det används tillsammans med *--notime* skrivs endast tidsdelta utan tidsstämpel ut."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-E*, *--console-on*"
msgstr "*-E*, *--console-on*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Enable printing messages to the console."
msgstr "Aktivera utskrift av meddelanden till konsolen."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-e*, *--reltime*"
msgstr "*-e*, *--reltime*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Display the local time and the delta in human-readable format. Be aware that conversion to the local time could be inaccurate (see *-T* for more details)."
msgstr "Visa den lokala tiden och deltat i ett läsbart format. Tänk på att konverteringen till lokal tid kan vara felaktig (se *-T* för mer information)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-F*, *--file* _file_"
msgstr "*-F*, *--file* _fil_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Read the syslog messages from the given _file_. Note that *-F* does not support messages in kmsg format. See *-K* instead."
msgstr "Läser syslog-meddelanden från den angivna _filen_. Observera att *-F* inte stöder meddelanden i kmsg-format. Se *-K* istället."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-f*, *--facility* _list_"
msgstr "*-f*, *--facility* _lista_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Restrict output to the given (comma-separated) _list_ of facilities. For example:"
msgstr "Begränsa utdata till den angivna (kommaseparerade) _listan_ med faciliteter. Till exempel:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*dmesg --facility=daemon*"
msgstr "*dmesg --facility=daemon*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "will print messages from system daemons only. For all supported facilities see the *--help* output."
msgstr "skriver endast ut meddelanden från systemets daemons. För alla funktioner som stöds, se *--help*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-H*, *--human*"
msgstr "*-H*, *--human*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Enable human-readable output. See also *--color*, *--reltime* and *--nopager*."
msgstr "Aktiverar utdata som är läsbar för människor. Se även *--color*, *--reltime* och *--nopager*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Use JSON output format. The time output format is in \"sec.usec\" format only, log priority level is not decoded by default (use *--decode* to split into facility and priority), the other options to control the output format or time format are silently ignored."
msgstr "Använd JSON-utmatningsformat. Utdataformatet för tid är endast i formatet \"sec.usec\", loggens prioritetsnivå avkodas inte som standard (använd *--decode* för att dela upp i facilitet och prioritet), övriga flaggor för att styra utdataformatet eller tidsformatet ignoreras i tysthet."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-K*, *--kmsg-file* _file_"
msgstr "*-K*, *--kmsg-file* _fil_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Read the /dev/kmsg messages from the given _file_. Different record as expected to be separated by a NULL byte."
msgstr "Läser /dev/kmsg-meddelanden från den angivna _filen_. Olika poster som förväntas vara separerade med en NULL-byte."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-k*, *--kernel*"
msgstr "*-k*, *--kernel*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Print kernel messages."
msgstr "Skriv ut kernel-meddelanden."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Colorize the output. The optional argument _when_ can be *auto*, *never* or *always*. If the _when_ argument is omitted, it defaults to *auto*. The colors can be disabled; for the current built-in default see the *--help* output. See also the *COLORS* section below."
msgstr "Färglägger utdata. Det valfria argumentet _när_ kan vara *auto*, *never* eller *always*. Om argumentet _när_ utelämnas är standardvärdet *auto*. Färgerna kan inaktiveras; för den aktuella inbyggda standardinställningen, se utdata *--help*. Se även avsnittet *FÄRGER* nedan."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-l*, *--level* _list_"
msgstr "*-l*, *--level* _lista_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Restrict output to the given (comma-separated) _list_ of levels. For example:"
msgstr "Begränsa utdata till den angivna (kommaseparerade) _listan_ med nivåer. Till exempel:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*dmesg --level=err,warn*"
msgstr "*dmesg --level=err,warn*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "will print error and warning messages only. For all supported levels see the *--help* output."
msgstr "skriver endast ut fel- och varningsmeddelanden. För alla nivåer som stöds, se *--help*-utskriften."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Appending a plus *+* to a level name also includes all higher levels. For example:"
msgstr "Om du lägger till ett plus *+* till ett nivånamn inkluderas även alla högre nivåer. Till exempel:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*dmesg --level=err+*"
msgstr "*dmesg --nivå=err+*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "will print levels *err*, *crit*, *alert* and *emerg*."
msgstr "kommer att skriva ut nivåerna *err*, *crit*, *alert* och *emerg*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Prepending it will include all lower levels."
msgstr "Prepending det kommer att omfatta alla lägre nivåer."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-n*, *--console-level* _level_"
msgstr "*-n*, *--console-level* _nivå_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Set the _level_ at which printing of messages is done to the console. The _level_ is a level number or abbreviation of the level name. For all supported levels see the *--help* output."
msgstr "Ange på vilken _nivå_ meddelanden ska skrivas ut till konsolen. _nivå_ är ett nivånummer eller en förkortning av nivåns namn. För alla nivåer som stöds, se *--help*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "For example, *-n 1* or *-n emerg* prevents all messages, except emergency (panic) messages, from appearing on the console. All levels of messages are still written to _/proc/kmsg_, so *syslogd*(8) can still be used to control exactly where kernel messages appear. When the *-n* option is used, *dmesg* will _not_ print or clear the kernel ring buffer."
msgstr "Till exempel förhindrar *-n 1* eller *-n emerg* att alla meddelanden, utom nödmeddelanden (panikmeddelanden), visas på konsolen. Alla nivåer av meddelanden skrivs fortfarande till _/proc/kmsg_, så *syslogd*(8) kan fortfarande användas för att kontrollera exakt var kärnmeddelanden visas. När flaggan *-n* används kommer *dmesg* _inte_ att skriva ut eller rensa kärnans ringbuffert."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--noescape*"
msgstr "*--noescape*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "The unprintable and potentially unsafe characters (e.g., broken multi-byte sequences, terminal controlling chars, etc.) are escaped in format \\x<hex> for security reason by default. This option disables this feature at all. It's usable for example for debugging purpose together with *--raw*. Be careful and don't use it by default."
msgstr "De otryckbara och potentiellt osäkra tecknen (t.ex. brutna multibyte-sekvenser, terminalstyrande tecken etc.) escapas i formatet \\x<hex> av säkerhetsskäl som standard. Denna flagga inaktiverar denna funktion helt och hållet. Det är användbart för t.ex. felsökning tillsammans med *--raw*. Var försiktig och använd det inte som standard."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-P*, *--nopager*"
msgstr "*-P*, *--nopager*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Do not pipe output into a pager. A pager is enabled by default for *--human* output."
msgstr "Pipa inte utdata till en personsökare. En personsökare är aktiverad som standard för *--mänsklig* utdata."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-p*, *--force-prefix*"
msgstr "*-p*, *--force-prefix*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Add facility, level or timestamp information to each line of a multi-line message."
msgstr "Lägg till information om facilitet, nivå eller tidsstämpel på varje rad i ett meddelande med flera rader."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Print the raw message buffer, i.e., do not strip the log-level prefixes, but all unprintable characters are still escaped (see also *--noescape*)."
msgstr "Skriv ut den råa meddelandebufferten, d.v.s. ta inte bort prefixen på loggnivån, men alla tecken som inte kan skrivas ut escapas ändå (se även *--noescape*)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Note that the real raw format depends on the method how *dmesg* reads kernel messages. The _/dev/kmsg_ device uses a different format than *syslog*(2). For backward compatibility, *dmesg* returns data always in the *syslog*(2) format. It is possible to read the real raw data from _/dev/kmsg_ by, for example, the command 'dd if=/dev/kmsg iflag=nonblock'."
msgstr "Observera att det verkliga råformatet beror på metoden för hur *dmesg* läser kärnmeddelanden. Enheten _/dev/kmsg_ använder ett annat format än *syslog*(2). För bakåtkompatibilitet returnerar *dmesg* alltid data i *syslog*(2)-format. Det är möjligt att läsa riktiga rådata från _/dev/kmsg_ med t.ex. kommandot 'dd if=/dev/kmsg iflag=nonblock'."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-S*, *--syslog*"
msgstr "*-S*, *--syslog*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Force *dmesg* to use the *syslog*(2) kernel interface to read kernel messages. The default is to use _/dev/kmsg_ rather than *syslog*(2) since kernel 3.5.0."
msgstr "Tvinga *dmesg* att använda *syslog*(2)-kärngränssnittet för att läsa kärnmeddelanden. Standardinställningen är att använda _/dev/kmsg_ i stället för *syslog*(2) sedan kärnan 3.5.0."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-s*, *--buffer-size* _size_"
msgstr "*-s*, *--buffer-size* _storlek_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Use a buffer of _size_ to query the kernel ring buffer. This is 16392 by default. (The default kernel syslog buffer size was 4096 at first, 8192 since 1.3.54, 16384 since 2.1.113.) If you have set the kernel buffer to be larger than the default, then this option can be used to view the entire buffer."
msgstr "Använd en buffert av storleken _storlek_ för att fråga efter kärnans ringbuffert. Denna är 16392 som standard. (Standardstorleken för syslog-bufferten i kärnan var 4096 i början, 8192 sedan 1.3.54, 16384 sedan 2.1.113.) Om du har ställt in kärnbufferten så att den är större än standardvärdet kan du använda den här flaggan för att visa hela bufferten."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-T*, *--ctime*"
msgstr "*-T*, *--ctime*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Print human-readable timestamps."
msgstr "Skriv ut tidsmarkörer som är läsbara för människor."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*Be aware that the timestamp could be inaccurate!* The *time* source used for the logs is *not updated after* system *SUSPEND*/*RESUME*. Timestamps are adjusted according to current delta between boottime and monotonic clocks, this works only for messages printed after last resume."
msgstr "*Tänk på att tidsstämpeln kan vara felaktig!* *Tidskällan* som används för loggarna *uppdateras inte efter* systemets *VÄNTELÄGE*/*ÅTERUPPTAGNING*. Tidsstämplar justeras enligt aktuellt delta mellan starttid och monotona klockor, detta fungerar endast för meddelanden som skrivs ut efter senaste återupptagningen."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--since* _time_"
msgstr "*--since* _time_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Display record since the specified time. Supported is the subsecond granularity. The time is possible to specify in absolute way as well as by relative notation (e.g. '1 hour ago'). Be aware that the timestamp could be inaccurate and see *--ctime* for more details."
msgstr "Visar poster sedan den angivna tiden. Subsekunders granularitet stöds. Det går att ange tiden både absolut och relativt (t.ex. \"för 1 timme sedan\"). Tänk på att tidsstämpeln kan vara felaktig och se *--ctime* för mer information."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--until* _time_"
msgstr "*--until* _time_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Display record until the specified time. Supported is the subsecond granularity. The time is possible to specify in absolute way as well as by relative notation (e.g. '1 hour ago'). Be aware that the timestamp could be inaccurate and see *--ctime* for more details."
msgstr "Visa poster fram till angiven tidpunkt. Subsekundersgranularitet stöds. Det är möjligt att ange tiden både absolut och relativt (t.ex. \"för 1 timme sedan\"). Tänk på att tidsstämpeln kan vara felaktig och se *--ctime* för mer information."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-t*, *--notime*"
msgstr "*-t*, *--notime*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Do not print kernel's timestamps."
msgstr "Skriv inte ut kärnans tidsstämplar."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Print timestamps using the given _format_, which can be *ctime*, *reltime*, *delta*, *iso* or *raw*. The first three formats are aliases of the time-format-specific options. The *raw* format uses the default timestamp format showing seconds since boot. The *iso* format is a *dmesg* implementation of the ISO-8601 timestamp format. The purpose of this format is to make the comparing of timestamps between two systems, and any other parsing, easy. The definition of the *iso* timestamp is: YYYY-MM-DD<T>HH:MM:SS,<microseconds><-+><timezone offset from UTC>."
msgstr "Skriv ut tidsstämplar med det angivna _formatet_, som kan vara *ctime*, *reltime*, *delta*, *iso* eller *raw*. De tre första formaten är alias för de tidsformatspecifika flaggor. Formatet *raw* använder standardformatet för tidsstämpel som visar sekunder sedan start. Formatet *iso* är en *dmesg*-implementering av tidsstämpelformatet ISO-8601. Syftet med det här formatet är att göra det enkelt att jämföra tidsstämplar mellan två system och att göra andra analyser. Definitionen av *iso*-tidsstämpeln är: YYYY-MM-DD<T>HH:MM:SS,<microseconds><-+><timezone offset from UTC>."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The *iso* format has the same issue as *ctime*: the time may be inaccurate when a system is suspended and resumed."
msgstr "Formatet *iso* har samma problem som *ctime*: tiden kan vara felaktig när ett system avbryts och återupptas."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--time-format* may be used multiple times with different values for _format_ to output each specified format."
msgstr "*--time-format* kan användas flera gånger med olika värden för _format_ för att mata ut varje angivet format."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The *delta* always follows *ctime* or *raw* if specified together."
msgstr "*Delta* följer alltid efter *ctime* eller *raw* om de anges tillsammans."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-u*, *--userspace*"
msgstr "*-u*, *--userspace*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Print userspace messages."
msgstr "Skriv ut meddelanden i användarutrymmet."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-w*, *--follow*"
msgstr "*-w*, *--follow*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Wait for new messages. This feature is supported only on systems with a readable _/dev/kmsg_ (since kernel 3.5.0)."
msgstr "Vänta på nya meddelanden. Denna funktion stöds endast på system med en läsbar _/dev/kmsg_ (sedan kernel 3.5.0)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-W*, *--follow-new*"
msgstr "*-W*, *--follow-new*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Wait and print only new messages."
msgstr "Vänta och skriv endast ut nya meddelanden."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-x*, *--decode*"
msgstr "*-x*, *--decode*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Decode facility and level (priority) numbers to human-readable prefixes."
msgstr "Avkoda facilitet- och nivånummer (prioritet) till prefix som kan läsas av människor."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The logical color names supported by *dmesg* are:"
msgstr "De logiska färgnamn som stöds av *dmesg* är:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*subsys*"
msgstr "*subsys*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "The message sub-system prefix (e.g., \"ACPI:\")."
msgstr "Prefixet för meddelandets undersystem (t.ex. \"ACPI:\")."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The message timestamp."
msgstr "Meddelandets tidsstämpel."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*timebreak*"
msgstr "*tidsbrytning*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "The message timestamp in short ctime format in *--reltime* or *--human* output."
msgstr "Meddelandets tidsstämpel i kort ctime-format i *--reltime*- eller *--human*-utdata."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*alert*"
msgstr "*alert*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "The text of the message with the alert log priority."
msgstr "Texten i meddelandet med prioritet för varningsloggen."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*crit*"
msgstr "*crit*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "The text of the message with the critical log priority."
msgstr "Texten i meddelandet med den kritiska loggprioriteten."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*err*"
msgstr "*fel*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "The text of the message with the error log priority."
msgstr "Texten i meddelandet med prioritet för felloggen."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The text of the message with the warning log priority."
msgstr "Texten i meddelandet med prioritet för varningsloggen."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*segfault*"
msgstr "*segfault*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "The text of the message that inform about segmentation fault."
msgstr "Texten i meddelandet som informerar om segmenteringsfelet."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*dmesg* can fail reporting permission denied error. This is usually caused by *dmesg_restrict* kernel setting, please see *syslog*(2) for more details."
msgstr "*dmesg* kan misslyckas med att rapportera felet \"permission denied\". Detta orsakas vanligtvis av *dmesg_restrict*-kärninställningen, se *syslog*(2) för mer information."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*dmesg* was originally written by mailto:tytso@athena.mit.edu[Theodore Ts'o]."
msgstr "*dmesg* skrevs ursprungligen av mailto:tytso@athena.mit.edu[Theodore Ts'o]."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*terminal-colors.d*(5), *syslogd*(8)"
msgstr "*terminal-colors.d*(5), *syslogd*(8)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "eject(1)"
msgstr "eject(1)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "eject - eject removable media"
msgstr "eject - mata ut flyttbara media"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*eject* [options] _device_|_mountpoint_"
msgstr "*eject* [flaggor] _enhet_|_monteringspunkt_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*eject* allows removable media (typically a CD-ROM, floppy disk, tape, JAZ, ZIP or USB disk) to be ejected under software control. The command can also control some multi-disc CD-ROM changers, the auto-eject feature supported by some devices, and close the disc tray of some CD-ROM drives."
msgstr "*eject* gör det möjligt att mata ut flyttbara media (vanligtvis en CD-ROM, diskett, band, JAZ-, ZIP- eller USB-disk) under programvarukontroll. Kommandot kan också styra vissa cd-rom-växlare med flera skivor, den automatiska utmatningsfunktionen som stöds av vissa enheter och stänga skivfacket på vissa cd-rom-enheter."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The device corresponding to _device_ or _mountpoint_ is ejected. If no name is specified, the default name */dev/cdrom* is used. The device may be addressed by device name (e.g., 'sda'), device path (e.g., '/dev/sda'), UUID=__uuid__ or LABEL=__label__ tags."
msgstr "Den enhet som motsvarar _enhet_ eller _monteringspunkt_ matas ut. Om inget namn anges används standardnamnet */dev/cdrom*. Enheten kan adresseras med enhetsnamn (t.ex. 'sda'), enhetssökväg (t.ex. '/dev/sda'), UUID=__uuid__ eller LABEL=__etikett__-taggar."

#. from tp:util-linux-man-2.41.2-rc1
msgid "There are four different methods of ejecting, depending on whether the device is a CD-ROM, SCSI device, removable floppy, or tape. By default *eject* tries all four methods in order until it succeeds."
msgstr "Det finns fyra olika metoder för utmatning, beroende på om enheten är en CD-ROM, en SCSI-enhet, en flyttbar diskett eller ett band. Som standard försöker *eject* alla fyra metoderna i tur och ordning tills den lyckas."

#. from tp:util-linux-man-2.41.2-rc1
msgid "If a device partition is specified, the whole-disk device is used."
msgstr "Om en enhetspartition anges används enheten för hela disken."

#. from tp:util-linux-man-2.41.2-rc1
msgid "If the device or a device partition is currently mounted, it is unmounted before ejecting. The eject is processed on exclusive open block device file descriptor if *--no-unmount* or *--force* are not specified."
msgstr "Om enheten eller en enhetspartition för närvarande är monterad, avmonteras den innan den matas ut. Utmatningen bearbetas på en exklusiv öppen blockenhetsfildeskriptor om *--no-unmount* eller *--force* inte har angetts."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-a*, **--auto on**|*off*"
msgstr "*-a*, **--auto on**|*off*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "This option controls the auto-eject mode, supported by some devices. When enabled, the drive automatically ejects when the device is closed."
msgstr "Den här flaggan styr läget för automatisk utmatning, som stöds av vissa enheter. När det är aktiverat matas enheten ut automatiskt när enheten stängs."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-c*, *--changerslot* _slot_"
msgstr "*-c*, *--changerslot* _slot_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "With this option a CD slot can be selected from an ATAPI/IDE CD-ROM changer. The CD-ROM drive cannot be in use (mounted data CD or playing a music CD) for a change request to work. Please also note that the first slot of the changer is referred to as 0, not 1."
msgstr "Med denna flagga kan en CD-plats väljas från en ATAPI/IDE CD-ROM-växlare. CD-ROM-enheten får inte vara i bruk (monterad data-CD eller spela en musik-CD) för att en ändringsbegäran ska fungera. Observera också att den första kortplatsen i växlaren kallas 0, inte 1."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-d*, *--default*"
msgstr "*-d*, *--default*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "List the default device name."
msgstr "Lista standardnamnet på enheten."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-F*, *--force*"
msgstr "*-F*, *--force*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Force eject, don't check device type, don't open device with exclusive lock. The successful result may be false positive on non hot-pluggable devices."
msgstr "Forcera utmatning, kontrollera inte enhetstyp, öppna inte enhet med exklusivt lås. Det lyckade resultatet kan vara falskt positivt på enheter som inte kan anslutas direkt."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-f*, *--floppy*"
msgstr "*-f*, *--floppy*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "This option specifies that the drive should be ejected using a removable floppy disk eject command."
msgstr "Den här flaggan anger att enheten ska matas ut med hjälp av kommandot för utmatning av flyttbar diskett."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-i*, **--manualeject on**|*off*"
msgstr "*-i*, **--manualeject on**|*off*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "This option controls locking of the hardware eject button. When enabled, the drive will not be ejected when the button is pressed. This is useful when you are carrying a laptop in a bag or case and don't want it to eject if the button is inadvertently pressed."
msgstr "Den här flaggan styr låsningen av utmatningsknappen för maskinvara. När detta är aktiverat matas inte hårddisken ut när knappen trycks in. Detta är användbart när du bär med dig en bärbar dator i en väska eller fodral och inte vill att den ska matas ut om knappen trycks in av misstag."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-M*, *--no-partitions-unmount*"
msgstr "*-M*, *--no-partitions-unmount*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "The option tells *eject* to not try to unmount other partitions on partitioned devices. If another partition is still mounted, the program will not attempt to eject the media. It will attempt to unmount only the device or mountpoint given on the command line."
msgstr "Flaggan säger till *eject* att inte försöka avmontera andra partitioner på partitionerade enheter. Om en annan partition fortfarande är monterad kommer programmet inte att försöka mata ut mediet. Det kommer bara att försöka avmontera den enhet eller monteringspunkt som anges på kommandoraden."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-m*, *--no-unmount*"
msgstr "*-m*, *--no-unmount*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "The option tells *eject* to not try to unmount at all. If this option is not specified then *eject* opens the device with *O_EXCL* flag to be sure that the device is not used (since v2.35)."
msgstr "Flaggan säger till *eject* att inte försöka avmontera alls. Om den här flaggan inte anges öppnar *eject* enheten med flaggan *O_EXCL* för att vara säker på att enheten inte används (sedan v2.35)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-n*, *--noop*"
msgstr "*-n*, *--noop*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "With this option the selected device is displayed but no action is performed."
msgstr "Med denna flagga visas den valda enheten, men ingen åtgärd utförs."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-p*, *--proc*"
msgstr "*-p*, *--proc*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "This option allows you to use _/proc/mounts_ instead _/etc/mtab_. It also passes the *-n* option to *umount*(8)."
msgstr "Med den här flaggan kan du använda _/proc/mounts_ i stället för _/etc/mtab_. Det skickar också flaggan *-n* till *umount*(8)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-q*, *--tape*"
msgstr "*-q*, *--tape*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "This option specifies that the drive should be ejected using a tape drive offline command."
msgstr "Den här flaggan anger att enheten ska matas ut med hjälp av ett offlinekommando för bandstationen."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-r*, *--cdrom*"
msgstr "*-r*, *--cdrom*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "This option specifies that the drive should be ejected using a CDROM eject command."
msgstr "Denna flagga anger att enheten ska matas ut med hjälp av ett CDROM-utmatningskommando."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-s*, *--scsi*"
msgstr "*-s*, *--scsi*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "This option specifies that the drive should be ejected using SCSI commands."
msgstr "Denna flagga anger att enheten ska matas ut med hjälp av SCSI-kommandon."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-T*, *--traytoggle*"
msgstr "*-T*, *--traytoggle*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "With this option the drive is given a CD-ROM tray close command if it's opened, and a CD-ROM tray eject command if it's closed. Not all devices support this command, because it uses the above CD-ROM tray close command."
msgstr "Med denna flagga får enheten ett kommando för att stänga CD-ROM-facket om det öppnas och ett kommando för att mata ut CD-ROM-facket om det stängs. Detta kommando stöds inte av alla enheter, eftersom det använder kommandot \"CD-ROM tray close\" ovan."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-t*, *--trayclose*"
msgstr "*-t*, *--trayclose*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "With this option the drive is given a CD-ROM tray close command. Not all devices support this command."
msgstr "Med denna flagga får enheten ett kommando för att stänga CD-ROM-facket. Detta kommando stöds inte av alla enheter."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Run in verbose mode; more information is displayed about what the command is doing."
msgstr "Körs i utförligt läge; mer information visas om vad kommandot gör."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-X*, *--listspeed*"
msgstr "*-X*, *--listspeed*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "With this option the CD-ROM drive will be probed to detect the available speeds. The output is a list of speeds which can be used as an argument of the *-x* option. This only works with Linux 2.6.13 or higher, on previous versions solely the maximum speed will be reported. Also note that some drives may not correctly report the speed and therefore this option does not work with them."
msgstr "Med denna flagga kommer CD-ROM-enheten att undersökas för att upptäcka tillgängliga hastigheter. Utdata är en lista över hastigheter som kan användas som argument för flaggan *-x*. Detta fungerar endast med Linux 2.6.13 eller senare, på tidigare versioner kommer endast den maximala hastigheten att rapporteras. Observera också att vissa enheter kanske inte rapporterar hastigheten korrekt och att den här flaggan därför inte fungerar med dem."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-x*, *--cdspeed* _speed_"
msgstr "*-x*, *--cdspeed* _hastighet_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "With this option the drive is given a CD-ROM select speed command. The _speed_ argument is a number indicating the desired speed (e.g., 8 for 8X speed), or 0 for maximum data rate. Not all devices support this command and you can only specify speeds that the drive is capable of. Every time the media is changed this option is cleared. This option can be used alone, or with the *-t* and *-c* options."
msgstr "Med denna flagga får enheten ett kommando för att välja CD-ROM-hastighet. Argumentet _hastighet_ är ett tal som anger önskad hastighet (t.ex. 8 för 8X-hastighet), eller 0 för maximal datahastighet. Alla enheter stöder inte detta kommando och du kan bara ange hastigheter som enheten klarar av. Varje gång mediet byts ut rensas denna flagga. Denna flagga kan användas ensam eller tillsammans med flaggorna *-t* och *-c*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*eject* only works with devices that support one or more of the four methods of ejecting. This includes most CD-ROM drives (IDE, SCSI, and proprietary), some SCSI tape drives, JAZ drives, ZIP drives (parallel port, SCSI, and IDE versions), and LS120 removable floppies. Users have also reported success with floppy drives on Sun SPARC and Apple Macintosh systems. If *eject* does not work, it is most likely a limitation of the kernel driver for the device and not the *eject* program itself."
msgstr "*eject* fungerar bara med enheter som stöder en eller flera av de fyra metoderna för utmatning. Detta inkluderar de flesta CD-ROM-enheter (IDE, SCSI och egenutvecklade), vissa SCSI-bandenheter, JAZ-enheter, ZIP-enheter (parallellport-, SCSI- och IDE-versioner) och LS120 flyttbara disketter. Användare har också rapporterat framgångar med diskettenheter på Sun SPARC och Apple Macintosh-system. Om *eject* inte fungerar är det troligen en begränsning i kärndrivrutinen för enheten och inte i själva *eject*-programmet."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The *-r*, *-s*, *-f*, and *-q* options allow controlling which methods are used to eject. More than one method can be specified. If none of these options are specified, it tries all four (this works fine in most cases)."
msgstr "Flaggorna *-r*, *-s*, *-f* och *-q* gör det möjligt att styra vilka metoder som används för att mata ut. Mer än en metod kan anges. Om inget av dessa flaggor anges, försöker alla fyra (detta fungerar bra i de flesta fall)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*eject* may not always be able to determine if the device is mounted (e.g., if it has several names). If the device name is a symbolic link, *eject* will follow the link and use the device that it points to."
msgstr "*eject* kanske inte alltid kan avgöra om enheten är monterad (t.ex. om den har flera namn). Om enhetsnamnet är en symbolisk länk kommer *eject* att följa länken och använda den enhet som den pekar på."

#. from tp:util-linux-man-2.41.2-rc1
msgid "If *eject* determines that the device can have multiple partitions, it will attempt to unmount all mounted partitions of the device before ejecting (see also *--no-partitions-unmount*). If an unmount fails, the program will not attempt to eject the media."
msgstr "Om *eject* fastställer att enheten kan ha flera partitioner, kommer det att försöka avmontera alla monterade partitioner på enheten innan utmatning (se även *--no-partitions-unmount*). Om en avmontering misslyckas kommer programmet inte att försöka mata ut mediet."

#. from tp:util-linux-man-2.41.2-rc1
msgid "You can eject an audio CD. Some CD-ROM drives will refuse to open the tray if the drive is empty. Some devices do not support the tray close command."
msgstr "Du kan mata ut en ljud-CD. Vissa CD-ROM-enheter vägrar att öppna facket om enheten är tom. Vissa enheter stöder inte kommandot för att stänga facket."

#. from tp:util-linux-man-2.41.2-rc1
msgid "If the auto-eject feature is enabled, then the drive will always be ejected after running this command. Not all Linux kernel CD-ROM drivers support the auto-eject mode. There is no way to find out the state of the auto-eject mode."
msgstr "Om funktionen för automatisk utmatning är aktiverad kommer enheten alltid att matas ut efter att detta kommando har körts. Det är inte alla CD-ROM-drivrutiner i Linux-kärnan som stöder auto-eject-läget. Det finns inget sätt att ta reda på statusen för auto-eject-läget."

#. from tp:util-linux-man-2.41.2-rc1
msgid "You need appropriate privileges to access the device files. Running as root is required to eject some devices (e.g., SCSI devices)."
msgstr "Du behöver lämpliga behörigheter för att komma åt enhetsfilerna. För att mata ut vissa enheter (t.ex. SCSI-enheter) krävs att du kör som root."

#. from tp:util-linux-man-2.41.2-rc1
msgid "mailto:tranter@pobox.com[Jeff Tranter] - original author, mailto:kzak@redhat.com[Karel Zak] and mailto:mluscon@redhat.com[Michal Luscon] - util-linux version."
msgstr "mailto:tranter@pobox.com[Jeff Tranter] - originalförfattare, mailto:kzak@redhat.com[Karel Zak] och mailto:mluscon@redhat.com[Michal Luscon] - util-linux-version."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*findmnt*(8), *lsblk*(8), *mount*(8), *umount*(8)"
msgstr "*findmnt*(8), *lsblk*(8), *mount*(8), *umount*(8)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "fallocate(1)"
msgstr "fallocate(1)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "fallocate - preallocate or deallocate space to a file"
msgstr "fallocate - förallokera eller avallokera utrymme till en fil"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*fallocate* [*-c*|*-p*|*-z*] [*-o* _offset_] *-l* _length_ [*-n*] _filename_"
msgstr "*fallocate* [*-c*|*-p*|*-z*] [*-o* _offset_] *-l* _längd_ [*-n*] _filename_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*fallocate* *-d* [*-o* _offset_] [*-l* _length_] _filename_"
msgstr "*fallocate* *-d* [*-o* _offset_] [*-l* _längd_] _filnamn_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*fallocate* *-x* [*-o* _offset_] *-l* _length filename_"
msgstr "*fallocate* *-x* [*-o* _offset_] *-l* _längd filnamn"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*fallocate* is used to manipulate the allocated disk space for a file, either to deallocate or preallocate it. For filesystems which support the *fallocate*(2) system call, preallocation is done quickly by allocating blocks and marking them as uninitialized, requiring no IO to the data blocks. This is much faster than creating a file by filling it with zeroes."
msgstr "*fallocate* används för att manipulera det allokerade diskutrymmet för en fil, antingen för att avallokera eller förallokera det. För filsystem som stöder systemanropet *fallocate*(2) sker förallokering snabbt genom att block allokeras och markeras som oinitialiserade, vilket inte kräver någon IO till datablocken. Detta är mycket snabbare än att skapa en fil genom att fylla den med nollor."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The exit status returned by *fallocate* is 0 on success and 1 on failure."
msgstr "Avslutningsstatusen som returneras av *fallocate* är 0 vid framgång och 1 vid misslyckande."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The _length_ and _offset_ arguments may be followed by the multiplicative suffixes KiB (=1024), MiB (=1024*1024), and so on for GiB, TiB, PiB, EiB, ZiB, and YiB (the \"iB\" is optional, e.g., \"K\" has the same meaning as \"KiB\") or the suffixes KB (=1000), MB (=1000*1000), and so on for GB, TB, PB, EB, ZB, and YB."
msgstr "Argumenten _längd_ och _offset_ kan följas av de multiplikativa suffixen KiB (=1024), MiB (=1024*1024) och så vidare för GiB, TiB, PiB, EiB, ZiB och YiB (iB är valfritt, t.ex. har \"K\" samma betydelse som \"KiB\") eller suffixen KB (=1000), MB (=1000*1000) och så vidare för GB, TB, PB, EB, ZB och YB."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The options *--collapse-range*, *--dig-holes*, *--punch-hole*, *--zero-range* and *--posix* are mutually exclusive."
msgstr "Flaggorna *--collapse-range*, *--dig-holes*, *--punch-hole*, *--zero-range* och *--posix* är ömsesidigt uteslutande."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-c*, *--collapse-range*"
msgstr "*-c*, *--collapse-range*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Removes a byte range from a file, without leaving a hole. The byte range to be collapsed starts at _offset_ and continues for _length_ bytes. At the completion of the operation, the contents of the file starting at the location __offset__+_length_ will be appended at the location _offset_, and the file will be _length_ bytes smaller. The option *--keep-size* may not be specified for the collapse-range operation."
msgstr "Tar bort ett byteintervall från en fil utan att lämna ett hål. Byteintervallet som ska kollapsas börjar vid _offset_ och fortsätter i _längd_ bytes. När operationen är klar kommer innehållet i filen som börjar på platsen __offset__+_längd_ att läggas till på platsen _offset_, och filen kommer att vara _längd_ bytes mindre. Flaggan *--keep-size* får inte anges för operationen collapse-range."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Available since Linux 3.15 for ext4 (only for extent-based files) and XFS."
msgstr "Tillgänglig sedan Linux 3.15 för ext4 (endast för extent-baserade filer) och XFS."

#. from tp:util-linux-man-2.41.2-rc1
msgid "A filesystem may place limitations on the granularity of the operation, in order to ensure efficient implementation. Typically, _offset_ and _length_ must be a multiple of the filesystem logical block size, which varies according to the filesystem type and configuration. If a filesystem has such a requirement, the operation will fail with the error *EINVAL* if this requirement is violated."
msgstr "Ett filsystem kan lägga begränsningar på operationens granularitet för att säkerställa en effektiv implementering. Vanligtvis måste _offset_ och _längd_ vara en multipel av filsystemets logiska blockstorlek, som varierar beroende på filsystemets typ och konfiguration. Om ett filsystem har ett sådant krav kommer åtgärden att misslyckas med felet *EINVAL* om detta krav inte uppfylls."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-d*, *--dig-holes*"
msgstr "*-d*, *--dig-holes*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Detect and dig holes. This makes the file sparse in-place, without using extra disk space. The minimum size of the hole depends on filesystem I/O block size (usually 4096 bytes). Also, when using this option, *--keep-size* is implied. If no range is specified by *--offset* and *--length*, then the entire file is analyzed for holes."
msgstr "Upptäck och gräv hål. Detta gör filen gles på plats, utan att använda extra diskutrymme. Den minsta storleken på hålet beror på filsystemets I/O-blockstorlek (vanligtvis 4096 byte). När du använder den här flaggan är *--keep-size* underförstått. Om inget intervall anges med *--offset* och *--length* analyseras hela filen efter hål."

#. from tp:util-linux-man-2.41.2-rc1
msgid "You can think of this option as doing a \"*cp --sparse*\" and then renaming the destination file to the original, without the need for extra disk space."
msgstr "Du kan se den här flaggan som att göra en \"*cp --sparse*\" och sedan byta namn på destinationsfilen till originalfilen, utan att det behövs extra diskutrymme."

#. from tp:util-linux-man-2.41.2-rc1
msgid "See *--punch-hole* for a list of supported filesystems."
msgstr "Se *--punch-hole* för en lista över filsystem som stöds."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-i*, *--insert-range*"
msgstr "*-i*, *--insert-range*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Insert a hole of _length_ bytes from _offset_, shifting existing data."
msgstr "Infoga ett hål på _längd_ byte från _offset_ och flytta befintliga data."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Specifies the length of the range, in bytes."
msgstr "Anger längden på intervallet i byte."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-n*, *--keep-size*"
msgstr "*-n*, *--keep-size*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Do not modify the apparent length of the file. This may effectively allocate blocks past EOF, which can be removed with a truncate."
msgstr "Ändra inte den synliga längden på filen. Detta kan effektivt allokera block efter EOF, som kan tas bort med en truncate."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Specifies the beginning offset of the range, in bytes."
msgstr "Anger startoffset för intervallet, i byte."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-p*, *--punch-hole*"
msgstr "*-p*, *--punch-hole*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Deallocates space (i.e., creates a hole) in the byte range starting at _offset_ and continuing for _length_ bytes. Within the specified range, partial filesystem blocks are zeroed, and whole filesystem blocks are removed from the file. After a successful call, subsequent reads from this range will return zeroes. This option may not be specified at the same time as the *--zero-range* option. Also, when using this option, *--keep-size* is implied."
msgstr "Avallokerar utrymme (dvs. skapar ett hål) i byteintervallet som börjar vid _offset_ och fortsätter i _längd_ bytes. Inom det angivna intervallet nollställs partiella filsystemblock och hela filsystemblock tas bort från filen. Efter ett lyckat anrop kommer efterföljande läsningar från detta intervall att returnera nollor. Den här flaggan får inte anges samtidigt som flaggan *--zero-range*. När du använder den här flaggan är *--keep-size* underförstått."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Supported for XFS (since Linux 2.6.38), ext4 (since Linux 3.0), Btrfs (since Linux 3.7), tmpfs (since Linux 3.5) and gfs2 (since Linux 4.16)."
msgstr "Stöd för XFS (sedan Linux 2.6.38), ext4 (sedan Linux 3.0), Btrfs (sedan Linux 3.7), tmpfs (sedan Linux 3.5) och gfs2 (sedan Linux 4.16)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Enable verbose mode."
msgstr "Aktivera utförligt läge."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-x*, *--posix*"
msgstr "*-x*, *--posix*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Enable POSIX operation mode. In that mode allocation operation always completes, but it may take longer time when fast allocation is not supported by the underlying filesystem."
msgstr "Aktivera POSIX-operationsläge. I det läget slutförs allokeringen alltid, men det kan ta längre tid när snabb allokering inte stöds av det underliggande filsystemet."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-z*, *--zero-range*"
msgstr "*-z*, *--zero-range*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Zeroes space in the byte range starting at _offset_ and continuing for _length_ bytes. Within the specified range, blocks are preallocated for the regions that span the holes in the file. After a successful call, subsequent reads from this range will return zeroes."
msgstr "Nollställer utrymmet i byteintervallet som börjar vid _offset_ och fortsätter i _längd_ bytes. Inom det angivna intervallet förallokeras block för de regioner som sträcker sig över hålen i filen. Efter ett lyckat anrop kommer efterföljande läsningar från detta intervall att returnera nollor."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Zeroing is done within the filesystem preferably by converting the range into unwritten extents. This approach means that the specified range will not be physically zeroed out on the device (except for partial blocks at the either end of the range), and I/O is (otherwise) required only to update metadata."
msgstr "Nollställningen görs inom filsystemet, företrädesvis genom att omvandla intervallet till oskrivna extenter. Detta tillvägagångssätt innebär att det angivna intervallet inte kommer att nollställas fysiskt på enheten (med undantag för partiella block i vardera änden av intervallet), och I/O krävs (annars) endast för att uppdatera metadata."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Option *--keep-size* can be specified to prevent file length modification."
msgstr "Flaggan *--keep-size* kan anges för att förhindra ändring av fillängd."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Available since Linux 3.14 for ext4 (only for extent-based files) and XFS."
msgstr "Tillgänglig sedan Linux 3.14 för ext4 (endast för extent-baserade filer) och XFS."

#. from tp:util-linux-man-2.41.2-rc1
msgid "mailto:sandeen@redhat.com[Eric Sandeen], mailto:kzak@redhat.com[Karel Zak]"
msgstr "mailto:sandeen@redhat.com[Eric Sandeen], mailto:kzak@redhat.com[Karel Zak]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*truncate*(1), *fallocate*(2), *posix_fallocate*(3)"
msgstr "*truncate*(1), *fallocate*(2), *posix_fallocate*(3)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "flock(1)"
msgstr "flock(1)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "flock - manage locks from shell scripts"
msgstr "flock - hantera lås från skalskript"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*flock* [options] _file_|_directory_ _command_ [_arguments_]"
msgstr "*flock* [flaggor] _fil_|_katalog_ _kommando_ [_arguments_]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*flock* [options] _file_|_directory_ *-c* _command_"
msgstr "*flock* [flaggor] _fil_|_katalog_ *-c* _kommando_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*flock* [options] _number_"
msgstr "*flock* [flaggor] _nummer_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "This utility manages *flock*(2) locks from within shell scripts or from the command line."
msgstr "Detta verktyg hanterar *flock*(2)-lås inifrån skalskript eller från kommandoraden."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The first and second of the above forms wrap the lock around the execution of a _command_, in a manner similar to *su*(1) or *newgrp*(1). They lock a specified _file_ or _directory_, which is created (assuming appropriate permissions) if it does not already exist. By default, if the lock cannot be immediately acquired, *flock* waits until the lock is available."
msgstr "Den första och andra av ovanstående former låser utförandet av ett _kommando_, på ett sätt som liknar *su*(1) eller *newgrp*(1). De låser en angiven _fil_ eller _katalog_, som skapas (med lämpliga behörigheter) om den inte redan finns. Om låset inte kan förvärvas omedelbart väntar *flock* som standard tills låset är tillgängligt."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The third form uses an open file by its file descriptor _number_. See the examples below for how that can be used."
msgstr "Den tredje formen använder en öppen fil med dess filbeskrivare _nummer_. Se exemplen nedan för hur det kan användas."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Pass a single _command_, without arguments, to the shell with *-c*."
msgstr "Skicka ett enda _kommando_, utan argument, till skalet med *-c*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-E*, *--conflict-exit-code* _number_"
msgstr "*-E*, *--conflict-exit-code* _nummer_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "The exit status used when the *-n* option is in use, and the conflicting lock exists, or the *-w* option is in use, and the timeout is reached. The default value is *1*. The _number_ has to be in the range of 0 to 255."
msgstr "Avslutningsstatus som används när flaggan *-n* används och det finns ett motstridigt lås, eller när flaggan *-w* används och tidsgränsen har uppnåtts. Standardvärdet är *1*. _nummer_ måste ligga inom intervallet 0 till 255."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Do not fork before executing _command_. Upon execution the flock process is replaced by _command_ which continues to hold the lock. This option is incompatible with *--close* as there would otherwise be nothing left to hold the lock."
msgstr "Gör ingen fork innan du utför _kommando_. När flock-processen exekveras ersätts den av _kommando_ som fortsätter att hålla låset. Den här flaggan är inte kompatibelt med *--close* eftersom det annars inte skulle finnas något kvar att hålla låset."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-e*, *-x*, *--exclusive*"
msgstr "*-e*, *-x*, *--exclusive*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Obtain an exclusive lock, sometimes called a write lock. This is the default."
msgstr "Skaffa ett exklusivt lås, ibland kallat skrivlås. Detta är standardinställningen."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-n*, *--nb*, *--nonblock*"
msgstr "*-n*, *--nb*, *--nonblock*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Fail rather than wait if the lock cannot be immediately acquired. See the *-E* option for the exit status used."
msgstr "Misslyckas i stället för att vänta om låset inte kan förvärvas omedelbart. Se flaggan *-E* för den avslutsstatus som används."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-o*, *--close*"
msgstr "*-o*, *--close*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Close the file descriptor on which the lock is held before executing _command_. This is useful if _command_ spawns a child process which should not be holding the lock."
msgstr "Stäng filbeskrivaren som låset hålls på innan du utför _kommando_. Detta är användbart om _kommando_ startar en underordnad process som inte bör hålla låset."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-s*, *--shared*"
msgstr "*-s*, *--shared*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Obtain a shared lock, sometimes called a read lock."
msgstr "Få ett delat lås, ibland kallat ett läslås."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-u*, *--unlock*"
msgstr "*-u*, *--unlock*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Drop a lock. This is usually not required, since a lock is automatically dropped when the file is closed. However, it may be required in special cases, for example if the enclosed command group may have forked a background process which should not be holding the lock."
msgstr "Släpp ett lås. Detta är vanligtvis inte nödvändigt, eftersom ett lås automatiskt släpps när filen stängs. Det kan dock krävas i särskilda fall, t.ex. om den bifogade kommandogruppen kan ha förgrenat en bakgrundsprocess som inte borde hålla låset."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-w*, *--wait*, *--timeout* _seconds_"
msgstr "*-w*, *--wait*, *--timeout* _seconds_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Fail if the lock cannot be acquired within _seconds_. Decimal fractional values are allowed. See the *-E* option for the exit status used. The zero number of _seconds_ is interpreted as *--nonblock*."
msgstr "Misslyckas om låset inte kan förvärvas inom _sekunder_. Decimala fraktionerade värden är tillåtna. Se flaggan *-E* för den avslutsstatus som används. Noll antal _sekunder_ tolkas som *--nonblock*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--fcntl*"
msgstr "*--fcntl*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Instead of flock(2), apply an fcntl(2) open file description lock (that is, using the F_OFD_SETLK (non-blocking) or F_OFD_SETLKW (blocking) commands). These locks are independent of those applied via flock(2), but, unlike traditional POSIX fcntl() locks (F_SETLK, F_SETLKW), have semantics matching those of flock(2)."
msgstr "Istället för flock(2) kan du använda ett fcntl(2)-lås för beskrivning av öppen fil (dvs. använda kommandona F_OFD_SETLK (icke-blockerande) eller F_OFD_SETLKW (blockerande)). Dessa lås är oberoende av de som används via flock(2), men till skillnad från traditionella POSIX fcntl()-lås (F_SETLK, F_SETLKW) har de en semantik som matchar den i flock(2)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "This is only available on kernel versions >= 3.15."
msgstr "Detta är endast tillgängligt för kärnversioner >= 3.15."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Report how long it took to acquire the lock, or why the lock could not be obtained."
msgstr "Rapportera hur lång tid det tog att skaffa låset eller varför låset inte kunde skaffas."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The command uses <sysexits.h> exit status values for everything, except when using either of the options *-n* or *-w* which report a failure to acquire the lock with an exit status given by the *-E* option, or 1 by default. The exit status given by *-E* has to be in the range of 0 to 255."
msgstr "Kommandot använder <sysexits.h> utgångsstatusvärden för allt, utom när något av flaggorna *-n* eller *-w* används, som rapporterar ett misslyckande med att förvärva låset med en utgångsstatus som anges av flaggan *-E*, eller 1 som standard. Utgångsstatusen som ges av *-E* måste ligga inom intervallet 0 till 255."

#. from tp:util-linux-man-2.41.2-rc1
msgid "When using the _command_ variant, and executing the child worked, then the exit status is that of the child command."
msgstr "När _kommando_-varianten används och det underordnade kommandot utförs, är utgångsstatusen den som gäller för det underordnade kommandot."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*flock* does not detect deadlock. See *flock*(2) for details."
msgstr "*flock* upptäcker inte deadlock. Se *flock*(2) för mer information."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Some file systems (e. g. NFS and CIFS) have a limited implementation of *flock*(2) and flock may always fail. For details see *flock*(2), *nfs*(5) and *mount.cifs*(8). Depending on mount options, flock can always fail there."
msgstr "Vissa filsystem (t.ex. NFS och CIFS) har en begränsad implementering av *flock*(2) och flock kan alltid misslyckas. För detaljer se *flock*(2), *nfs*(5) och *mount.cifs*(8). Beroende på monterinsflaggor kan flock alltid misslyckas där."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Note that \"shell> \" in examples is a command line prompt."
msgstr "Observera att \"shell> \" i exemplen är en kommandoradsprompt."

#. from tp:util-linux-man-2.41.2-rc1
msgid "shell1> flock /tmp -c cat; shell2> flock -w .007 /tmp -c echo; /bin/echo $?"
msgstr "shell1> flock /tmp -c cat; shell2> flock -w .007 /tmp -c echo; /bin/echo $?"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Set exclusive lock to directory _/tmp_ and the second command will fail."
msgstr "Sätt exklusivt lås på katalogen _/tmp_ och det andra kommandot kommer att misslyckas."

#. from tp:util-linux-man-2.41.2-rc1
msgid "shell1> flock -s /tmp -c cat; shell2> flock -s -w .007 /tmp -c echo; /bin/echo $?"
msgstr "shell1> flock -s /tmp -c cat; shell2> flock -s -w .007 /tmp -c echo; /bin/echo $?"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Set shared lock to directory _/tmp_ and the second command will not fail. Notice that attempting to get exclusive lock with second command would fail."
msgstr "Sätt shared lock till katalogen _/tmp_ så kommer det andra kommandot inte att misslyckas. Observera att försök att få exklusivt lås med det andra kommandot skulle misslyckas."

#. from tp:util-linux-man-2.41.2-rc1
msgid "shell> flock -x local-lock-file echo 'a b c'"
msgstr "shell> flock -x local-lock-fil echo 'a b c'"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Grab the exclusive lock \"local-lock-file\" before running echo with 'a b c'."
msgstr "Hämta det exklusiva låset \"local-lock-file\" innan du kör echo med 'a b c'."

#. from tp:util-linux-man-2.41.2-rc1
msgid "(; flock -n 9 || exit 1; # ... commands executed under lock ...; ) 9>/var/lock/mylockfile"
msgstr "(; flock -n 9 || exit 1; # ... kommandon utförda under lås ...; ) 9>/var/lock/mylockfile"

#. from tp:util-linux-man-2.41.2-rc1
msgid "The form is convenient inside shell scripts. The mode used to open the file doesn't matter to *flock*; using _>_ or _>>_ allows the lockfile to be created if it does not already exist, however, write permission is required. Using _<_ requires that the file already exists but only read permission is required."
msgstr "Formuläret är praktiskt i skalskript. Det läge som används för att öppna filen spelar ingen roll för *flock*; om du använder _>_ eller _>>_ kan låsfilen skapas om den inte redan finns, men skrivbehörighet krävs. Om du använder _<_ krävs att filen redan finns, men endast läsbehörighet krävs."

#. from tp:util-linux-man-2.41.2-rc1
msgid "[ \"$\\{FLOCKER}\" != \"$0\" ] && exec env FLOCKER=\"$0\" flock -en \"$0\" \"$0\" \"$@\" || : "
msgstr "[ \"$\\{FLOCKER}\" != \"$0\" ] && exec env FLOCKER=\"$0\" flock -en \"$0\" \"$0\" \"$@\" || : "

#. from tp:util-linux-man-2.41.2-rc1
msgid "This is useful boilerplate code for shell scripts. Put it at the top of the shell script you want to lock and it'll automatically lock itself on the first run. If the environment variable *$FLOCKER* is not set to the shell script that is being run, then execute *flock* and grab an exclusive non-blocking lock (using the script itself as the lock file) before re-execing itself with the right arguments. It also sets the *FLOCKER* environment variable to the right value so it doesn't run again."
msgstr "Detta är användbar standardkod för skalskript. Lägg den högst upp i det skalskript som du vill låsa så låser det sig automatiskt vid första körningen. Om miljövariabeln *$FLOCKER* inte är inställd på det skalskript som körs, exekveras *flock* och tar ett exklusivt icke-blockerande lås (med själva skriptet som låsfil) innan det exekveras igen med rätt argument. Det ställer också in miljövariabeln *FLOCKER* till rätt värde så att det inte körs igen."

#. from tp:util-linux-man-2.41.2-rc1
msgid "shell> exec 4<>/var/lock/mylockfile; shell> flock -n 4"
msgstr "shell> exec 4<>/var/lock/mylockfile; shell> flock -n 4"

#. from tp:util-linux-man-2.41.2-rc1
msgid "This form is convenient for locking a file without spawning a subprocess. The shell opens the lock file for reading and writing as file descriptor 4, then *flock* is used to lock the descriptor."
msgstr "Denna form är lämplig för att låsa en fil utan att starta en subprocess. Shell öppnar låsfilen för läsning och skrivning som fildeskriptor 4, sedan används *flock* för att låsa deskriptorn."

#. from tp:util-linux-man-2.41.2-rc1
msgid "mailto:hpa@zytor.com[H. Peter Anvin]"
msgstr "mailto:hpa@zytor.com[H. Peter Anvin]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Copyright {copyright} 2003-2006 H. Peter Anvin. This is free software; see the source for copying conditions. There is NO warranty; not even for MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE."
msgstr "Copyright {copyright} 2003-2006 H. Peter Anvin. Detta är fri programvara; se källan för kopieringsvillkor. Det finns INGEN garanti; inte ens för SÄLJBARHET eller LÄMPLIGHET FÖR ETT BESTÄMMT SYFTE."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*flock*(2), *fcntl*(2)"
msgstr "*flock*(2), *fcntl*(2)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "fsfreeze(8)"
msgstr "fsfreeze(8)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "fsfreeze - suspend access to a filesystem (Ext3/4, ReiserFS, JFS, XFS)"
msgstr "fsfreeze - avbryt åtkomst till ett filsystem (Ext3/4, ReiserFS, JFS, XFS)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*fsfreeze* *--freeze*|*--unfreeze* _mountpoint_"
msgstr "*fsfreeze* *--freeze*|*--unfreeze* _monteringspunkt_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*fsfreeze* suspends or resumes access to a filesystem."
msgstr "*fsfreeze* stänger av eller återupptar åtkomst till ett filsystem."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*fsfreeze* halts any new access to the filesystem and creates a stable image on disk. *fsfreeze* is intended to be used with hardware RAID devices that support the creation of snapshots."
msgstr "*fsfreeze* stoppar all ny åtkomst till filsystemet och skapar en stabil avbildning på disken. *fsfreeze* är avsedd att användas med RAID-enheter i maskinvara som stöder skapandet av ögonblicksbilder."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*fsfreeze* is unnecessary for *device-mapper* devices. The device-mapper (and LVM) automatically freezes a filesystem on the device when a snapshot creation is requested. For more details see the *dmsetup*(8) man page."
msgstr "*fsfreeze* är onödigt för *enhet-mappare*-enheter. Device-mappern (och LVM) fryser automatiskt ett filsystem på enheten när en snapshot-skapelse begärs. För mer information se man-sidan *dmsetup*(8)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The _mountpoint_ argument is the pathname of the directory where the filesystem is mounted. The filesystem must be mounted to be frozen (see *mount*(8))."
msgstr "Argumentet _monteringspunkt_ är sökvägsnamnet till den katalog där filsystemet är monterat. Filsystemet måste vara monterat för att kunna frysas (se *mount*(8))."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Note that access-time updates are also suspended if the filesystem is mounted with the traditional atime behavior (mount option *strictatime*, for more details see *mount*(8))."
msgstr "Observera att uppdateringar av åtkomsttid också avbryts om filsystemet är monterat med det traditionella atime-beteendet (monteringsflaggor *strictatime*, för mer information se *mount*(8))."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-f*, *--freeze*"
msgstr "*-f*, *--freeze*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "This option requests the specified filesystem to be frozen from new modifications. When this is selected, all ongoing transactions in the filesystem are allowed to complete, new *write*(2) system calls are halted, other calls which modify the filesystem are halted, and all dirty data, metadata, and log information are written to disk. Any process attempting to write to the frozen filesystem will block waiting for the filesystem to be unfrozen."
msgstr "Denna flagga begär att det angivna filsystemet ska frysas från nya modifieringar. När detta är valt tillåts alla pågående transaktioner i filsystemet att slutföras, nya *write*(2)-systemanrop stoppas, andra anrop som modifierar filsystemet stoppas och alla smutsiga data, metadata och logginformation skrivs till disk. Alla processer som försöker skriva till det frysta filsystemet kommer att blockeras i väntan på att filsystemet ska frysas upp igen."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Note that even after freezing, the on-disk filesystem can contain information on files that are still in the process of unlinking. These files will not be unlinked until the filesystem is unfrozen or a clean mount of the snapshot is complete."
msgstr "Observera att även efter frysning kan filsystemet på disken innehålla information om filer som fortfarande håller på att kopplas bort. Dessa filer kommer inte att avlänkas förrän filsystemet har frysts upp eller en ren montering av ögonblicksbilden har slutförts."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-u*, *--unfreeze*"
msgstr "*-u*, *--unfreeze*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "This option is used to un-freeze the filesystem and allow operations to continue. Any filesystem modifications that were blocked by the freeze are unblocked and allowed to complete."
msgstr "Denna flagga används för att häva frysningen av filsystemet och tillåta att operationer fortsätter. Alla ändringar av filsystemet som blockerades av frysningen avblockeras och tillåts slutföras."

#. from tp:util-linux-man-2.41.2-rc1
msgid "FILESYSTEM SUPPORT"
msgstr "STÖD FÖR FILSYSTEM"

#. from tp:util-linux-man-2.41.2-rc1
msgid "This command will work only if filesystem supports has support for freezing. List of these filesystems include (2016-12-18) *btrfs*, *ext2/3/4*, *f2fs*, *jfs*, *nilfs2*, *reiserfs*, and *xfs*. Previous list may be incomplete, as more filesystems get support. If in doubt easiest way to know if a filesystem has support is create a small loopback mount and test freezing it."
msgstr "Detta kommando fungerar endast om filsystemet har stöd för freezing. Lista över dessa filsystem inkluderar (2016-12-18) *btrfs*, *ext2/3/4*, *f2fs*, *jfs*, *nilfs2*, *reiserfs* och *xfs*. Tidigare lista kan vara ofullständig, eftersom fler filsystem får stöd. Om du är osäker är det enklaste sättet att veta om ett filsystem har stöd att skapa ett litet loopback-mount och testa att frysa det."

#. from tp:util-linux-man-2.41.2-rc1
msgid "This man page is based on *xfs_freeze*(8)."
msgstr "Denna man-sida är baserad på *xfs_freeze*(8)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Written by Hajime Taira."
msgstr "Skriven av Hajime Taira."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*mount*(8)"
msgstr "*montering*(8)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "fstab(5)"
msgstr "fstab(5)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "fstab - static information about the filesystems"
msgstr "fstab - statisk information om filsystem"

#. from tp:util-linux-man-2.41.2-rc1
msgid "The file *fstab* contains descriptive information about the filesystems the system can mount. *fstab* is only read by programs, and not written; it is the duty of the system administrator to properly create and maintain this file. The order of records in *fstab* is important because *fsck*(8), *mount*(8), and *umount*(8) sequentially iterate through *fstab* doing their thing."
msgstr "Filen *fstab* innehåller beskrivande information om de filsystem som systemet kan montera. *fstab* läses endast av program och skrivs inte; det är systemadministratörens skyldighet att skapa och underhålla filen på rätt sätt. Ordningen på posterna i *fstab* är viktig eftersom *fsck*(8), *mount*(8) och *umount*(8) sekventiellt itererar genom *fstab* och gör sina saker."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The file is not read by *mount*(8) only but often is used by many other tools and daemons, and proper functionality may require additional steps. For example, on systemd-based systems, it's recommended to use *systemctl daemon-reload* after *fstab* modification."
msgstr "Filen läses inte bara av *mount*(8) utan används ofta av många andra verktyg och demoner, och för att den ska fungera korrekt kan det krävas ytterligare åtgärder. På systemd-baserade system rekommenderas t.ex. att *systemctl daemon-reload* används efter att *fstab* har ändrats."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Each filesystem is described on a separate line, with fields separated by tabs or spaces. The line is split into fields before being parsed. This means that any spaces or tabs within the fields must be escaped using \\040 or \\011, even within quoted strings (e.g. LABEL=\"foo\\040bar\")."
msgstr "Varje filsystem beskrivs på en egen rad, med fält som separeras med tabbar eller mellanslag. Raden delas upp i fält innan den analyseras. Detta innebär att eventuella mellanslag eller tabbar i fälten måste escapas med \\040 eller \\011, även inom citerade strängar (t.ex. LABEL=\"foo\\040bar\")."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Lines starting with '#' are comments. Blank lines are ignored."
msgstr "Rader som börjar med \"#\" är kommentarer. Tomma rader ignoreras."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The following is a typical example of an *fstab* entry:"
msgstr "Följande är ett typiskt exempel på en *fstab*-post:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "LABEL=t-home2   /home      ext4    defaults,auto_da_alloc      0  2\n"
msgstr "LABEL=t-home2 /home ext4 defaults,auto_da_alloc 0 2\n"

#. from tp:util-linux-man-2.41.2-rc1
msgid "The first field (_fs_spec_)."
msgstr "Det första fältet (_fs_spec_)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "This field describes the block special device, remote filesystem or filesystem image for loop device to be mounted or swap file or swap device to be enabled."
msgstr "Detta fält beskriver den blockspecifika enhet, fjärrfilsystem eller filsystemavbildning för loop-enhet som ska monteras eller växlingsfil eller växlingsenhet som ska aktiveras."

#. from tp:util-linux-man-2.41.2-rc1
msgid "For ordinary mounts, it will hold (a link to) a block special device node (as created by *mknod*(2)) for the device to be mounted, like _/dev/cdrom_ or _/dev/sdb7_. For NFS mounts, this field is _<host>:<dir>_, e.g., _knuth.aeb.nl:/_. For filesystems with no storage, any string can be used, and will show up in *df*(1) output, for example. Typical usage is _proc_ for *procfs*; _mem_, _none_, or _tmpfs_ for *tmpfs*. Other special filesystems, like *udev* and *sysfs*, are typically not listed in *fstab*."
msgstr "För vanliga monteringar kommer det att innehålla (en länk till) en blockspecifik enhetsnod (som skapats av *mknod*(2)) för den enhet som ska monteras, t.ex. _/dev/cdrom_ eller _/dev/sdb7_. För NFS-monteringar är det här fältet _<host>:<dir>_, t.ex. _knuth.aeb.nl:/_. För filsystem utan lagringsutrymme kan vilken sträng som helst användas och visas t.ex. i *df*(1)-utdata. Typisk användning är _proc_ för *procfs*; _mem_, _none_ eller _tmpfs_ för *tmpfs*. Andra speciella filsystem, som *udev* och *sysfs*, är vanligtvis inte listade i *fstab*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "LABEL=<label> or UUID=<uuid> may be given instead of a device name. This is the recommended method, as device names are often a coincidence of hardware detection order, and can change when other disks are added or removed. For example, 'LABEL=Boot' or 'UUID=3e6be9de-8139-11d1-9106-a43f08d823a6'. (Use a filesystem-specific tool like *e2label*(8), *xfs_admin*(8), or *fatlabel*(8) to set LABELs on filesystems)."
msgstr "LABEL=<label> eller UUID=<uuid> kan anges i stället för ett enhetsnamn. Detta är den rekommenderade metoden, eftersom enhetsnamn ofta är en tillfällighet som beror på maskinvarans identifieringsordning och kan ändras när andra diskar läggs till eller tas bort. Till exempel 'LABEL=Boot' eller 'UUID=3e6be9de-8139-11d1-9106-a43f08d823a6'. (Använd ett filsystemspecifikt verktyg som *e2label*(8), *xfs_admin*(8) eller *fatlabel*(8) för att ställa in LABEL på filsystem)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "It's also possible to use *PARTUUID=* and *PARTLABEL=*. These partitions identifiers are supported for example for GUID Partition Table (GPT)."
msgstr "Det är också möjligt att använda *PARTUUID=* och *PARTLABEL=*. Dessa partitionsidentifierare stöds t.ex. för GUID Partition Table (GPT)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "See *mount*(8), *blkid*(8) or *lsblk*(8) for more details about device identifiers."
msgstr "Se *mount*(8), *blkid*(8) eller *lsblk*(8) för mer information om enhetsidentifierare."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Note that *mount*(8) uses UUIDs as strings. The string representation of the UUID should be based on lower case characters. But when specifying the volume ID of FAT or NTFS file systems upper case characters are used (e.g UUID=\"A40D-85E7\" or UUID=\"61DB7756DB7779B3\")."
msgstr "Observera att *mount*(8) använder UUID:er som strängar. Strängrepresentationen av UUID bör baseras på gemener. Men när du anger volym-ID för FAT- eller NTFS-filsystem används versaler (t.ex. UUID=\"A40D-85E7\" eller UUID=\"61DB7756DB7779B3\")."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The second field (_fs_file_)."
msgstr "Det andra fältet (_fs_fil_)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "This field describes the mount point (target) for the filesystem. For swap area, this field should be specified as `none'. If the name of the mount point contains spaces or tabs these can be escaped as `\\040' and '\\011' respectively."
msgstr "Detta fält beskriver monteringspunkten (target) för filsystemet. För växlingsområden bör detta fält anges som `none'. Om namnet på monteringspunkten innehåller mellanslag eller tabbar kan dessa escapas som `\\040' respektive '\\011'."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The third field (_fs_vfstype_)."
msgstr "Det tredje fältet (_fs_vfstype_)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "This field describes the type of the filesystem. Linux supports many filesystem types: ext4, xfs, btrfs, f2fs, vfat, ntfs, hfsplus, tmpfs, sysfs, proc, iso9660, udf, squashfs, nfs, cifs, and many more. For more details, see *mount*(8)."
msgstr "Detta fält beskriver typen av filsystem. Linux stöder många filsystemtyper: ext4, xfs, btrfs, f2fs, vfat, ntfs, hfsplus, tmpfs, sysfs, proc, iso9660, udf, squashfs, nfs, cifs och många fler. För mer information, se *mount*(8)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "An entry _swap_ denotes a file or partition to be used for swapping, cf. *swapon*(8). An entry _none_ is useful for bind or move mounts."
msgstr "En post _swap_ betecknar en fil eller partition som ska användas för swapping, jfr *swapon*(8). En post _none_ är användbar för bindnings- eller flyttmonteringar."

#. from tp:util-linux-man-2.41.2-rc1
msgid "More than one type may be specified in a comma-separated list."
msgstr "Mer än en typ kan anges i en kommaseparerad lista."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*mount*(8) and *umount*(8) support filesystem _subtypes_. The subtype is defined by '.subtype' suffix. For example 'fuse.sshfs'. It's recommended to use subtype notation rather than add any prefix to the first fstab field (for example 'sshfs#example.com' is deprecated)."
msgstr "*mount*(8) och *umount*(8) stöder filsystemets _subtypes_. Subtypen definieras av suffixet '.subtype'. Till exempel 'fuse.sshfs'. Vi rekommenderar att du använder subtypsnotation i stället för att lägga till något prefix i det första fstab-fältet (t.ex. 'sshfs#example.com' är föråldrat)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The fourth field (_fs_mntops_)."
msgstr "Det fjärde fältet (_fs_mntops_)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "This field describes the mount options associated with the filesystem."
msgstr "I det här fältet beskrivs de monteringsflaggor som är kopplade till filsystemet."

#. from tp:util-linux-man-2.41.2-rc1
msgid "It is formatted as a comma-separated list of options and is optional for *mount*(8) or *swapon*(8). The usual convention is to use at least \"defaults\" keyword there."
msgstr "Den är formaterad som en kommaseparerad lista med flaggor och är valfria för *mount*(8) eller *swapon*(8). Den vanliga konventionen är att använda åtminstone nyckelordet \"defaults\" där."

#. from tp:util-linux-man-2.41.2-rc1
msgid "It usually contains the type of mount (*ro* or *rw*, the default is *rw*), plus any additional options appropriate to the filesystem type (including performance-tuning options). For details, see *mount*(8) or *swapon*(8)."
msgstr "Den innehåller vanligtvis typen av montering (*ro* eller *rw*, standard är *rw*), plus eventuella ytterligare flaggor som är lämpliga för filsystemtypen (inklusive prestandajusteringsflaggor). För mer information, se *mount*(8) eller *swapon*(8)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Basic filesystem-independent options are:"
msgstr "Grundläggande filsystemoberoende flaggor är:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*defaults*"
msgstr "*defaults*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "use default options. The default depends on the kernel and the filesystem. *mount*(8) does not have any hardcoded set of default options. The kernel default is usually rw, suid, dev, exec, auto, nouser, and async."
msgstr "använd standardflaggor. Standardinställningen beror på kärnan och filsystemet. *mount*(8) har inte någon hårdkodad uppsättning standardflaggor. Kärnans standard är vanligtvis rw, suid, dev, exec, auto, nouser och async."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*noauto*"
msgstr "*noauto*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "do not mount when *mount -a* is given (e.g., at boot time)"
msgstr "inte montera när *mount -a* anges (t.ex. vid start)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*user*"
msgstr "*user*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "allow a user to mount"
msgstr "tillåta en användare att montera"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*owner*"
msgstr "*owner*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "allow device owner to mount"
msgstr "tillåta enhetens ägare att montera"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*comment*"
msgstr "*comment*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "or *x-<name>* for use by fstab-maintaining programs"
msgstr "eller *x-<name>* för användning av fstab-underhållande program"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*nofail*"
msgstr "*nofail*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "do not report errors for this device if it does not exist."
msgstr "rapportera inte fel för den här enheten om den inte finns."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The fifth field (_fs_freq_)."
msgstr "Det femte fältet (_fs_freq_)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "This field is used by *dump*(8) to determine which filesystems need to be dumped. Defaults to zero (don't dump) if not present."
msgstr "Detta fält används av *dump*(8) för att avgöra vilka filsystem som behöver dumpas. Standardvärdet är noll (dumpas inte) om fältet inte finns med."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The sixth field (_fs_passno_)."
msgstr "Det sjätte fältet (_fs_passno_)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "This field is used by *fsck*(8) to determine the order in which filesystem checks are done at boot time. The root filesystem should be specified with a _fs_passno_ of 1. Other filesystems should have a _fs_passno_ of 2. Filesystems within a drive will be checked sequentially, but filesystems on different drives will be checked at the same time to utilize parallelism available in the hardware. Defaults to zero (don't check the filesystem) if not present."
msgstr "Detta fält används av *fsck*(8) för att bestämma i vilken ordning filsystemet kontrolleras vid uppstart. Rotfilsystemet bör anges med _fs_passno_ på 1. Andra filsystem bör ha _fs_passno_ på 2. Filsystem inom en enhet kontrolleras sekventiellt, men filsystem på olika enheter kontrolleras samtidigt för att utnyttja den parallellitet som finns i maskinvaran. Standardvärdet är noll (kontrollera inte filsystemet) om den inte finns."

#. from tp:util-linux-man-2.41.2-rc1
msgid "_/etc/fstab_, _<fstab.h>_"
msgstr "_/etc/fstab_, _<fstab.h>_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "The proper way to read records from *fstab* is to use the routines *getmntent*(3) or *libmount*."
msgstr "Det korrekta sättet att läsa poster från *fstab* är att använda rutinerna *getmntent*(3) eller *libmount*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The keyword *ignore* as a filesystem type (3rd field) is no longer supported by the pure libmount based mount utility (since util-linux v2.22)."
msgstr "Nyckelordet *ignore* som filsystemtyp (3:e fältet) stöds inte längre av det rent libmount-baserade mount-verktyget (sedan util-linux v2.22)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "This document describes handling of *fstab* by *util-linux* and *libmount*. For *systemd*, read *systemd* documentation. There are slight differences."
msgstr "Det här dokumentet beskriver hur *fstab* hanteras av *util-linux* och *libmount*. För *systemd*, läs dokumentationen för *systemd*. Det finns små skillnader."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The ancestor of this *fstab* file format appeared in 4.0BSD."
msgstr "Föregångaren till detta *fstab*-filformat dök upp i 4.0BSD."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*getmntent*(3), *fs*(5), *findmnt*(8), *mount*(8), *swapon*(8)"
msgstr "*getmntent*(3), *fs*(5), *findmnt*(8), *mount*(8), *swapon*(8)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "fstrim(8)"
msgstr "fstrim(8)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "fstrim - discard unused blocks on a mounted filesystem"
msgstr "fstrim - ta bort oanvända block på ett monterat filsystem"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*fstrim* [*-v*] [*-o* _offset_] [*-l* _length_] [*-m* _minimum-size_] *-A*|*-a*|_mountpoint_"
msgstr "*fstrim* [*-v*] [*-o* _offset_] [*-l* _längd_] [*-m* _minsta storlek_] *-A*|*-a*|_monteringspunkt_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*fstrim* is used on a mounted filesystem to discard (or \"trim\") blocks which are not in use by the filesystem. This is useful for solid-state drives (SSDs) and thinly-provisioned storage."
msgstr "*fstrim* används på ett monterat filsystem för att ta bort (eller \"trimma\") block som inte används av filsystemet. Detta är användbart för SSD-enheter (Solid State Drives) och lagringsutrymme med tunn provisionering."

#. from tp:util-linux-man-2.41.2-rc1
msgid "By default, *fstrim* will discard all unused blocks in the filesystem. Options may be used to modify this behavior based on range or size, as explained below."
msgstr "Som standard kommer *fstrim* att förkasta alla oanvända block i filsystemet. Flaggor kan användas för att ändra detta beteende baserat på intervall eller storlek, enligt vad som förklaras nedan."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The _mountpoint_ argument is the pathname of the directory where the filesystem is mounted and is required when *_-A_*, *_-a_*, *_--fstab_*, or *_--all_* are unspecified."
msgstr "Argumentet _monteringspunkt_ är sökvägsnamnet för den katalog där filsystemet är monterat och krävs när *_-A_*, *_-a_*, *_--fstab_* eller *_--all_* är ospecificerade."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Running *fstrim* frequently, or even using *mount -o discard*, might negatively affect the lifetime of poor-quality SSD devices. For most desktop and server systems a sufficient trimming frequency is once a week. Note that not all devices support a queued trim, so each trim command incurs a performance penalty on whatever else might be trying to use the disk at the time."
msgstr "Om du kör *fstrim* ofta eller till och med använder *mount -o discard* kan det påverka livslängden negativt för SSD-enheter av dålig kvalitet. För de flesta skrivbords- och serversystem är en tillräcklig trimningsfrekvens en gång i veckan. Observera att inte alla enheter har stöd för trimning i kö, så varje trimningskommando medför en prestandaförlust för allt annat som försöker använda disken vid samma tidpunkt."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The _offset_, _length_, and _minimum-size_ arguments may be followed by the multiplicative suffixes KiB (=1024), MiB (=1024*1024), and so on for GiB, TiB, PiB, EiB, ZiB and YiB (the \"iB\" is optional, e.g., \"K\" has the same meaning as \"KiB\") or the suffixes KB (=1000), MB (=1000*1000), and so on for GB, TB, PB, EB, ZB and YB."
msgstr "Argumenten _offset_, _längd_ och _minimum-size_ kan följas av de multiplikativa suffixen KiB (=1024), MiB (=1024*1024), och så vidare för GiB, TiB, PiB, EiB, ZiB och YiB (iB är valfritt, t.ex, \"K\" har samma betydelse som \"KiB\") eller suffixen KB (=1000), MB (=1000*1000), och så vidare för GB, TB, PB, EB, ZB och YB."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-A, --fstab*"
msgstr "*-A, --fstab*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Trim all mounted filesystems mentioned in _/etc/fstab_ on devices that support the discard operation. The root filesystem is determined from kernel command line if missing in the file. The other supplied options, like *--offset*, *--length* and *--minimum*, are applied to all these devices. Errors from filesystems that do not support the discard operation, read-only devices, autofs and read-only filesystems are silently ignored. Filesystems with \"X-fstrim.notrim\" mount option are skipped."
msgstr "Trimma alla monterade filsystem som nämns i _/etc/fstab_ på enheter som stöder discard-operationen. Rotfilsystemet bestäms från kommandoraden i kärnan om det saknas i filen. De andra angivna flaggorna, som *--offset*, *--length* och *--minimum*, tillämpas på alla dessa enheter. Fel från filsystem som inte stöder discard-operationen, skrivskyddade enheter, autofs och skrivskyddade filsystem ignoreras i tysthet. Filsystem med monteringsflaggan \"X-fstrim.notrim\" hoppas över."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-a, --all*"
msgstr "*-a, --all*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Trim all mounted filesystems on devices that support the discard operation. The other supplied options, like *--offset*, *--length* and *--minimum*, are applied to all these devices. Errors from filesystems that do not support the discard operation, read-only devices and read-only filesystems are silently ignored."
msgstr "Trim alla monterade filsystem på enheter som stöder discard-operationen. De andra angivna flaggorna, t.ex. *--offset*, *--length* och *--minimum*, tillämpas på alla dessa enheter. Fel från filsystem som inte stöder discard-operationen, skrivskyddade enheter och skrivskyddade filsystem ignoreras i tysthet."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-n, --dry-run*"
msgstr "*-n, --dry-run*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "This option does everything apart from actually call *FITRIM* ioctl."
msgstr "Denna flagga gör allt utom att faktiskt anropa *FITRIM* ioctl."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-o, --offset* _offset_"
msgstr "*-o, --offset* _offset_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Byte offset in the filesystem from which to begin searching for free blocks to discard. The default value is zero, starting at the beginning of the filesystem."
msgstr "Byteoffset i filsystemet från vilken sökningen efter lediga block att förkasta ska påbörjas. Standardvärdet är noll, med start i början av filsystemet."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-l, --length* _length_"
msgstr "*-l, --length* _längd_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "The number of bytes (after the starting point) to search for free blocks to discard. If the specified value extends past the end of the filesystem, *fstrim* will stop at the filesystem size boundary. The default value extends to the end of the filesystem."
msgstr "Antalet byte (efter startpunkten) som ska sökas efter lediga block som ska kasseras. Om det angivna värdet sträcker sig längre än till slutet av filsystemet, kommer *fstrim* att stanna vid filsystemets storleksgräns. Standardvärdet sträcker sig till slutet av filsystemet."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-I, --listed-in* _list_"
msgstr "*-I, --listed-in* _lista_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Specifies a colon-separated list of files in fstab or kernel mountinfo format. All missing or empty files are silently ignored. The evaluation of the _list_ stops after first non-empty file. For example:"
msgstr "Anger en kolonseparerad lista med filer i formatet fstab eller kernel mountinfo. Alla filer som saknas eller är tomma ignoreras. Utvärderingen av _lista_ stoppas efter den första icke-tomma filen. Till exempel: _lista_:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--listed-in /etc/fstab:/proc/self/mountinfo*."
msgstr "*--listed-in /etc/fstab:/proc/self/mountinfo*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Filesystems with \"X-fstrim.notrim\" mount option in fstab are skipped."
msgstr "Filsystem med monteringsflaggan \"X-fstrim.notrim\" i fstab hoppas över."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-m, --minimum* _minimum-size_"
msgstr "*-m, --minimum* _minimum-size_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Minimum contiguous free range to discard, in bytes. (This value is internally rounded up to a multiple of the filesystem block size.) Free ranges smaller than this will be ignored and *fstrim* will adjust the minimum if it's smaller than the device's minimum, and report that (fstrim_range.minlen) back to userspace. By increasing this value, the *fstrim* operation will complete more quickly for filesystems with badly fragmented freespace, although not all blocks will be discarded. The default value is zero, discarding every free block."
msgstr "Minsta sammanhängande fria intervall som ska kasseras, i byte. (Detta värde avrundas internt uppåt till en multipel av filsystemets blockstorlek) Fria intervall som är mindre än detta ignoreras och *fstrim* justerar minimum om det är mindre än enhetens minimum och rapporterar detta (fstrim_range.minlen) tillbaka till userspace. Genom att öka detta värde kommer *fstrim*-operationen att slutföras snabbare för filsystem med dåligt fragmenterat friutrymme, även om inte alla block kommer att kasseras. Standardvärdet är noll, vilket innebär att alla lediga block kasseras."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Specifies allowed or forbidden filesystem types when used with *--all* or *--fstab*.  The _list_ is a comma-separated list of the filesystem names. The _list_ follows how *mount -t* evaluates type patterns. Only specified filesystem types are allowed. All specified types are forbidden if the list is prefixed by \"no\" or each filesystem prefixed by \"no\" is forbidden. If the option is not used, then all filesystems (except \"autofs\") are allowed."
msgstr "Anger tillåtna eller förbjudna filsystemtyper när de används med *--all* eller *--fstab*.  _lista_ är en kommaseparerad lista över filsystemens namn. _lista_ följer hur *mount -t* utvärderar typmönster. Endast specificerade filsystemtyper är tillåtna. Alla angivna typer är förbjudna om listan inleds med \"no\" eller om varje filsystem som inleds med \"no\" är förbjudet. Om flaggan inte används är alla filsystem (utom \"autofs\") tillåtna."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-v, --verbose*"
msgstr "*-v, --verbose*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Verbose execution. With this option *fstrim* will output the number of bytes passed from the filesystem down the block stack to the device for potential discard. This number is a maximum discard amount from the storage device's perspective, because _FITRIM_ ioctl called repeated will keep sending the same sectors for discard repeatedly."
msgstr "Utförlig körning. Med den här flaggan kommer *fstrim* att visa antalet byte som skickas från filsystemet ner genom blockstacken till enheten för potentiell kassering. Detta antal är en maximal mängd som kan kasseras ur lagringsenhetens perspektiv, eftersom _FITRIM_ ioctl som anropas upprepade gånger kommer att skicka samma sektorer för kassering upprepade gånger."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*fstrim* will report the same potential discard bytes each time, but only sectors which had been written to between the discards would actually be discarded by the storage device. Further, the kernel block layer reserves the right to adjust the discard ranges to fit raid stripe geometry, non-trim capable devices in a LVM setup, etc. These reductions would not be reflected in fstrim_range.len (the *--length* option)."
msgstr "*fstrim* kommer att rapportera samma potentiella byte för kassering varje gång, men endast sektorer som har skrivits till mellan kasseringarna kommer faktiskt att kasseras av lagringsenheten. Dessutom förbehåller sig kärnans blocklager rätten att justera discard-intervallerna för att passa raid stripe-geometri, enheter som inte kan trimmas i en LVM-konfiguration osv. Dessa minskningar skulle inte återspeglas i fstrim_range.len (flaggan *--length*)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--quiet-unsupported*"
msgstr "*--quiet-unsupported*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Suppress error messages if trim operation (ioctl) is unsupported. This option is meant to be used in *systemd* service file or in *cron*(8) scripts to hide warnings that are result of known problems, such as NTFS driver reporting _Bad file descriptor_ when device is mounted read-only, or lack of file system support for ioctl _FITRIM_ call. This option also cleans exit status when unsupported filesystem specified on *fstrim* command line."
msgstr "Undertryck felmeddelanden om trimoperationen (ioctl) inte stöds. Den här flaggan är avsett att användas i servicefilen *systemd* eller i *cron*(8)-skript för att dölja varningar som är resultatet av kända problem, t.ex. NTFS-drivrutinen som rapporterar _Bad file descriptor_ när enheten är monterad som skrivskyddad, eller avsaknad av filsystemstöd för ioctl-anropet _FITRIM_. Denna flagga rensar också utgångsstatus när ett filsystem som inte stöds anges på kommandoraden *fstrim*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "some filesystem discards have succeeded, some failed"
msgstr "vissa filsystemdiskar har lyckats, andra misslyckades"

#. from tp:util-linux-man-2.41.2-rc1
msgid "The command *fstrim --all* returns 0 (all succeeded), 32 (all failed) or 64 (some failed, some succeeded)."
msgstr "Kommandot *fstrim --all* returnerar 0 (alla lyckades), 32 (alla misslyckades) eller 64 (några misslyckades, några lyckades)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*blkdiscard*(8), *mount*(8)"
msgstr "*blkdiscard*(8), *mount*(8)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "hwclock(8)"
msgstr "hwclock(8)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "hwclock - time clocks utility"
msgstr "hwclock - verktyg för tidsklockor"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*hwclock* [_function_] [_option_...]"
msgstr "*hwclock* [_function_] [_option_...]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*hwclock* is an administration tool for the time clocks. It can: display the Hardware Clock time; set the Hardware Clock to a specified time; set the Hardware Clock from the System Clock; set the System Clock from the Hardware Clock; compensate for Hardware Clock drift; correct the System Clock timescale; set the kernel's timezone, NTP timescale, and epoch (Alpha only); and predict future Hardware Clock values based on its drift rate."
msgstr "*hwclock* är ett administrationsverktyg för tidsklockorna. Det kan: visa maskinvaruklockans tid; ställa in maskinvaruklockan till en angiven tid; ställa in maskinvaruklockan från systemklockan; ställa in systemklockan från maskinvaruklockan; kompensera för drift av maskinvaruklockan; korrigera systemklockans tidsskala; ställa in kärnans tidszon, NTP-tidsskala och epok (endast Alpha); och förutsäga framtida värden för maskinvaruklockan baserat på dess drifthastighet."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Since v2.26 important changes were made to the *--hctosys* function and the *--directisa* option, and a new option *--update-drift* was added. See their respective descriptions below."
msgstr "Sedan v2.26 har viktiga ändringar gjorts i funktionen *--hctosys* och flaggan *--directisa*, och en ny flagga *--update-drift* har lagts till. Se deras respektive beskrivningar nedan."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The following functions are mutually exclusive, only one can be given at a time. If none is given, the default is *--show*."
msgstr "Följande funktioner är ömsesidigt uteslutande, endast en kan anges åt gången. Om ingen anges är standardvärdet *--show*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-a, --adjust*"
msgstr "*-a, --adjust*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Add or subtract time from the Hardware Clock to account for systematic drift since the last time the clock was set or adjusted. See the discussion below, under *The Adjust Function*."
msgstr "Lägg till eller dra ifrån tid från hårdvaruklockan för att ta hänsyn till systematisk drift sedan klockan senast ställdes in eller justerades. Se diskussionen nedan under *Justeringsfunktionen*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--getepoch*; *--setepoch*"
msgstr "*--getepoch*; *--setepoch*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "These functions are for Alpha machines only, and are only available through the Linux kernel RTC driver."
msgstr "Dessa funktioner är endast avsedda för Alpha-maskiner och är endast tillgängliga via RTC-drivrutinen i Linux-kärnan."

#. from tp:util-linux-man-2.41.2-rc1
msgid "They are used to read and set the kernel's Hardware Clock epoch value. Epoch is the number of years into AD to which a zero year value in the Hardware Clock refers. For example, if the machine's BIOS sets the year counter in the Hardware Clock to contain the number of full years since 1952, then the kernel's Hardware Clock epoch value must be 1952."
msgstr "De används för att läsa och ställa in kärnans epokvärde för maskinvaruklockan. Epoch är det antal år in i AD som ett nollårsvärde i maskinvaruklockan hänvisar till. Om maskinens BIOS t.ex. ställer in årsräknaren i maskinvaruklockan så att den innehåller antalet hela år sedan 1952, måste kärnans epokvärde för maskinvaruklockan vara 1952."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The *--setepoch* function requires using the *--epoch* option to specify the year. For example:"
msgstr "Funktionen *--setepoch* kräver att man använder flaggan *--epoch* för att ange årtalet. Till exempel:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "**hwclock --setepoch --epoch=1952**"
msgstr "**hwclock --setepoch --epoch=1952**"

#. from tp:util-linux-man-2.41.2-rc1
msgid "The RTC driver attempts to guess the correct epoch value, so setting it may not be required."
msgstr "RTC-drivrutinen försöker gissa sig till rätt epokvärde, så det kanske inte är nödvändigt att ställa in det."

#. from tp:util-linux-man-2.41.2-rc1
msgid "This epoch value is used whenever *hwclock* reads or sets the Hardware Clock on an Alpha machine. For ISA machines the kernel uses the fixed Hardware Clock epoch of 1900."
msgstr "Detta epokvärde används när *hwclock* läser av eller ställer in maskinvaruklockan på en Alpha-maskin. För ISA-maskiner använder kärnan den fasta epoken för maskinvaruklockan 1900."

#. from tp:util-linux-man-2.41.2-rc1
msgid "**--param-get=**__parameter__; **--param-set=**__parameter__=__value__"
msgstr "**--param-get=**__parameter__; **--param-set=**__parameter__=__värde__"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Read and set the RTC's parameter. This is useful, for example, to retrieve the RTC's feature or set the RTC's Backup Switchover Mode."
msgstr "Läs och ställ in RTC:s parameter. Detta är användbart för att t.ex. hämta RTC:ns funktion eller ställa in RTC:ns backup-omkopplingsläge."

#. from tp:util-linux-man-2.41.2-rc1
msgid "_parameter_ is either a numeric RTC parameter value (see the Kernel's _include/uapi/linux/rtc.h_) or an alias. See *--help* for a list of valid aliases. _parameter_ and _value_, if prefixed with 0x, are interpreted as hexadecimal, otherwise decimal values."
msgstr "_parameter_ är antingen ett numeriskt RTC-parametervärde (se Kernels _include/uapi/linux/rtc.h_) eller ett alias. Se *--help* för en lista över giltiga alias. _parameter_ och _värde_, om de föregås av 0x, tolkas som hexadecimala värden, annars som decimala värden."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--predict*"
msgstr "*--predict*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Predict what the Hardware Clock will read in the future based upon the time given by the *--date* option and the information in _{ADJTIME_PATH}_. This is useful, for example, to account for drift when setting a Hardware Clock wakeup (aka alarm). See *rtcwake*(8)."
msgstr "Förutse vad maskinvaruklockan kommer att visa i framtiden baserat på den tid som anges med flaggan *--date* och informationen i _{ADJTIME_PATH}_. Detta är användbart, till exempel för att ta hänsyn till drift när du ställer in en väckning (även kallat larm) av maskinvaruklockan. Se *rtcwake*(8)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Do not use this function if the Hardware Clock is being modified by anything other than the current operating system's *hwclock* command, such as '11 minute mode' or from dual-booting another OS."
msgstr "Använd inte den här funktionen om maskinvaruklockan ändras av något annat än det aktuella operativsystemets *hwclock*-kommando, t.ex. i \"11-minutersläge\" eller om du dubbelstartar ett annat operativsystem."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-r*, *--show*; *--get*"
msgstr "*-r*, *--show*; *--get*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Read the Hardware Clock and print its time to standard output in the *ISO 8601* format. The time shown is always in local time, even if you keep your Hardware Clock in UTC. See the *--localtime* option."
msgstr "Läs av maskinvaruklockan och skriv ut dess tid till standardutdata i formatet *ISO 8601*. Tiden som visas är alltid i lokal tid, även om du håller maskinvaruklockan i UTC. Se flaggan *--localtime*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Showing the Hardware Clock time is the default when no function is specified."
msgstr "Showing the Hardware Clock time är standardinställningen när ingen funktion anges."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The *--get* function also applies drift correction to the time read, based upon the information in _{ADJTIME_PATH}_. Do not use this function if the Hardware Clock is being modified by anything other than the current operating system's *hwclock* command, such as '11 minute mode' or from dual-booting another OS."
msgstr "Funktionen *--get* tillämpar också driftkorrigering på den avlästa tiden, baserat på informationen i _{ADJTIME_PATH}_. Använd inte den här funktionen om maskinvaruklockan modifieras av något annat än det aktuella operativsystemets *hwclock*-kommando, t.ex. i \"11-minutersläge\" eller genom att dubbelstarta ett annat operativsystem."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-s*, *--hctosys*"
msgstr "*-s*, *--hctosys*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Set the System Clock from the Hardware Clock. The time read from the Hardware Clock is compensated to account for systematic drift before using it to set the System Clock. See the discussion below, under *The Adjust Function*."
msgstr "Ställ in systemklockan från maskinvaruklockan. Den tid som avläses från maskinvaruklockan kompenseras för systematisk drift innan den används för att ställa in systemklockan. Se diskussionen nedan under *Justeringsfunktionen*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The System Clock must be kept in the UTC timescale for date-time applications to work correctly in conjunction with the timezone configured for the system. If the Hardware Clock is kept in local time then the time read from it must be shifted to the UTC timescale before using it to set the System Clock. The *--hctosys* function does this based upon the information in the _{ADJTIME_PATH}_ file or the command line arguments *--localtime* and *--utc*. Note: no daylight saving adjustment is made. See the discussion below, under *LOCAL vs UTC*."
msgstr "Systemklockan måste ställas in på UTC-tidsskalan för att datum- och tidstillämpningar ska fungera korrekt tillsammans med den tidszon som har konfigurerats för systemet. Om maskinvaruklockan hålls i lokal tid måste den tid som läses från den flyttas till UTC-tidsskalan innan den används för att ställa in systemklockan. Funktionen *--hctosys* gör detta baserat på informationen i filen _{ADJTIME_PATH}_ eller kommandoradsargumenten *--localtime* och *--utc*. Observera: ingen justering för sommartid görs. Se diskussionen nedan under *LOCAL vs UTC*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The kernel also keeps a timezone value, the *--hctosys* function sets it to the timezone configured for the system. The system timezone is configured by the *TZ* environment variable or the _/etc/localtime_ file, as *tzset*(3) would interpret them. The obsolete _tz_dsttime_ field of the kernel's timezone value is set to zero. (For details on what this field used to mean, see *settimeofday*(2).)"
msgstr "Kärnan håller också ett tidszonsvärde, funktionen *--hctosys* ställer in det till den tidszon som konfigurerats för systemet. Systemets tidszon konfigureras av miljövariabeln *TZ* eller filen _/etc/localtime_, som *tzset*(3) skulle tolka dem. Det föråldrade fältet _tz_dsttime_ i kärnans tidszonsvärde sätts till noll. (För detaljer om vad det här fältet brukade betyda, se *settimeofday*(2)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "When used in a startup script, making the *--hctosys* function the first caller of *settimeofday*(2) from boot, it will set the NTP '11 minute mode' timescale via the _persistent_clock_is_local_ kernel variable. If the Hardware Clock's timescale configuration is changed then a reboot is required to inform the kernel. See the discussion below, under *Automatic Hardware Clock Synchronization by the Kernel*."
msgstr "När funktionen *--hctosys* används i ett startskript och blir den första funktionen som anropar *settimeofday*(2) från start, kommer den att ställa in NTP:s tidsskala '11 minute mode' via kärnvariabeln _persistent_klocka_is_local_. Om konfigurationen av hårdvaruklockans tidsskala ändras krävs en omstart för att informera kärnan. Se diskussionen nedan under *Automatisk synkronisering av maskinvaruklockan via kärnan*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "This is a good function to use in one of the system startup scripts before the file systems are mounted read/write."
msgstr "Det här är en bra funktion att använda i ett av systemets startskript innan filsystemen monteras för läsning/skrivning."

#. from tp:util-linux-man-2.41.2-rc1
msgid "This function should never be used on a running system. Jumping system time will cause problems, such as corrupted filesystem timestamps. Also, if something has changed the Hardware Clock, like NTP's '11 minute mode', then *--hctosys* will set the time incorrectly by including drift compensation."
msgstr "Den här funktionen ska aldrig användas på ett system som körs. Att hoppa över systemtiden kommer att orsaka problem, t.ex. korrupta tidsstämplar i filsystemet. Om något har ändrat hårdvaruklockan, som NTP:s \"11-minutersläge\", kommer *--hctosys* att ställa in tiden felaktigt genom att inkludera driftkompensation."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Drift compensation can be inhibited by setting the drift factor in _{ADJTIME_PATH}_ to zero. This setting will be persistent as long as the *--update-drift* option is not used with *--systohc* at shutdown (or anywhere else). Another way to inhibit this is by using the *--noadjfile* option when calling the *--hctosys* function. A third method is to delete the _{ADJTIME_PATH}_ file. *Hwclock* will then default to using the UTC timescale for the Hardware Clock. If the Hardware Clock is ticking local time it will need to be defined in the file. This can be done by calling *hwclock --localtime --adjust*; when the file is not present this command will not actually adjust the Clock, but it will create the file with local time configured, and a drift factor of zero."
msgstr "Driftkompensering kan förhindras genom att driftfaktorn i _{ADJTIME_PATH}_ sätts till noll. Denna inställning kommer att vara bestående så länge flaggan *--update-drift* inte används med *--systohc* vid avstängning (eller någon annanstans). Ett annat sätt att förhindra detta är att använda flaggan *--noadjfile* när du anropar funktionen *--hctosys*. En tredje metod är att radera filen _{ADJTIME_PATH}_. *Hwclock* kommer då som standard att använda UTC-tidsskalan för maskinvaruklockan. Om maskinvaruklockan tickar lokal tid måste den definieras i filen. Detta kan göras genom att anropa *hwclock --localtime --adjust*; när filen inte finns kommer detta kommando inte att justera klockan, men det kommer att skapa filen med lokal tid konfigurerad och en driftfaktor på noll."

#. from tp:util-linux-man-2.41.2-rc1
msgid "A condition under which inhibiting *hwclock*'s drift correction may be desired is when dual-booting multiple operating systems. If while this instance of Linux is stopped, another OS changes the Hardware Clock's value, then when this instance is started again the drift correction applied will be incorrect."
msgstr "En situation där det kan vara önskvärt att inhibera *hwclock*:s driftkorrigering är när man dubbelstartar flera operativsystem. Om ett annat operativsystem ändrar hårdvaruklockans värde medan den här Linux-instansen är stoppad, kommer den driftkorrigering som tillämpas att vara felaktig när den här instansen startas igen."

#. from tp:util-linux-man-2.41.2-rc1
msgid "For *hwclock*'s drift correction to work properly it is imperative that nothing changes the Hardware Clock while its Linux instance is not running."
msgstr "För att *hwclock*:s driftkorrigering ska fungera korrekt är det absolut nödvändigt att inget ändrar hårdvaruklockan när dess Linux-instans inte körs."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--set*"
msgstr "*--set*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Set the Hardware Clock to the time given by the *--date* option, and update the timestamps in _{ADJTIME_PATH}_. With the *--update-drift* option also (re)calculate the drift factor. Try it without the option if *--set* fails. See *--update-drift* below."
msgstr "Ställ in hårdvaruklockan på den tid som anges av flaggan *--date* och uppdatera tidsstämplarna i _{ADJTIME_PATH}_. Med flaggan *--update-drift* (om)beräknar du även driftfaktorn. Prova utan flaggan om *--set* misslyckas. Se *--update-drift* nedan."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--systz*"
msgstr "*--systz*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "This is an alternate to the *--hctosys* function that does not read the Hardware Clock nor set the System Clock; consequently there is not any drift correction. It is intended to be used in a startup script on systems with kernels above version 2.6 where you know the System Clock has been set from the Hardware Clock by the kernel during boot."
msgstr "Detta är en flagga till funktionen *--hctosys* som inte läser av hårdvaruklockan eller ställer in systemklockan; följaktligen sker ingen driftkorrigering. Den är avsedd att användas i ett uppstartsskript på system med kärnor över version 2.6 där du vet att systemklockan har ställts in från maskinvaruklockan av kärnan under uppstarten."

#. from tp:util-linux-man-2.41.2-rc1
msgid "It does the following things that are detailed above in the *--hctosys* function:"
msgstr "Den gör följande saker som beskrivs ovan i funktionen *--hctosys*:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Corrects the System Clock timescale to UTC as needed. Only instead of accomplishing this by setting the System Clock, *hwclock* simply informs the kernel and it handles the change."
msgstr "Korrigerar systemklockans tidsskala till UTC efter behov. Men istället för att göra detta genom att ställa in systemklockan, informerar *hwclock* helt enkelt kärnan som hanterar ändringen."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Sets the kernel's NTP '11 minute mode' timescale."
msgstr "Ställer in kärnans NTP-tidsskala för \"11-minutersläge\"."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Sets the kernel's timezone."
msgstr "Ställer in kernelns tidszon."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The first two are only available on the first call of *settimeofday*(2) after boot. Consequently this option only makes sense when used in a startup script. If the Hardware Clocks timescale configuration is changed then a reboot would be required to inform the kernel."
msgstr "De två första är endast tillgängliga vid det första anropet av *settimeofday*(2) efter uppstart. Följaktligen är denna flagga bara meningsfullt när det används i ett startskript. Om konfigurationen av tidsskalan för hårdvaruklockor ändras krävs en omstart för att informera kärnan."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-w*, *--systohc*"
msgstr "*-w*, *--systohc*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Set the Hardware Clock from the System Clock, and update the timestamps in _{ADJTIME_PATH}_. With the *--update-drift* option also (re)calculate the drift factor. Try it without the option if *--systohc* fails. See *--update-drift* below."
msgstr "Ställ in hårdvaruklockan från systemklockan och uppdatera tidsstämplarna i _{ADJTIME_PATH}_. Med flaggan *--update-drift* (om)beräknar du även driftfaktorn. Prova utan flaggan om *--systohc* misslyckas. Se *--update-drift* nedan."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--vl-read*, *--vl-clear*"
msgstr "*--vl-read*, *--vl-clear*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Some RTC devices are able to monitor the voltage of the backup battery and thus provide a way for the user to know that the battery should be replaced. The *--vl-read* function retrieves the Voltage Low information and decodes the result into human-readable form. The *--vl-clear* function resets the Voltage Low information, which is necessary for some RTC devices after a battery replacement."
msgstr "Vissa RTC-enheter kan övervaka spänningen i reservbatteriet och på så sätt ge användaren möjlighet att veta att batteriet bör bytas ut. Funktionen *--vl-read* hämtar Voltage Low-informationen och avkodar resultatet till läsbar form för människor. Funktionen *--vl-clear* återställer Voltage Low-informationen, vilket är nödvändigt för vissa RTC-enheter efter ett batteribyte."

#. from tp:util-linux-man-2.41.2-rc1
msgid "See the Kernel's _include/uapi/linux/rtc.h_ for details on which pieces of information may be returned. Note that not all RTC devices have this monitoring capability, nor do all drivers necessarily support reading the information."
msgstr "Se kärnans _include/uapi/linux/rtc.h_ för mer information om vilka delar av informationen som kan returneras. Observera att inte alla RTC-enheter har den här övervakningsmöjligheten och att alla drivrutiner inte nödvändigtvis stöder läsning av informationen."

#. from tp:util-linux-man-2.41.2-rc1
msgid "**--adjfile=**__filename__"
msgstr "**--adjfile=**__filename__"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Override the default _{ADJTIME_PATH}_ file path."
msgstr "Åsidosätt standardfilsökvägen _{ADJTIME_PATH}_."

#. from tp:util-linux-man-2.41.2-rc1
msgid "**--date=**__date_string__"
msgstr "**--date=**__date_sträng__"

#. from tp:util-linux-man-2.41.2-rc1
msgid "This option must be used with the *--set* or *--predict* functions, otherwise it is ignored."
msgstr "Denna flagga måste användas tillsammans med funktionerna *--set* eller *--predict*, annars ignoreras det."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*hwclock --set --date='16:45'*"
msgstr "*hwclock --set --date='16:45'*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*hwclock --predict --date='2525-08-14 07:11:05'*"
msgstr "*hwclock --predict --date='2525-08-14 07:11:05'*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "The argument must be in local time, even if you keep your Hardware Clock in UTC. See the *--localtime* option. Therefore, the argument should not include any timezone information. It also should not be a relative time like \"+5 minutes\", because *hwclock*'s precision depends upon correlation between the argument's value and when the enter key is pressed. Fractional seconds are silently dropped. This option is capable of understanding many time and date formats, but the previous parameters should be observed."
msgstr "Argumentet måste vara i lokal tid, även om du håller din hårdvaruklocka i UTC. Se flaggan *--localtime*. Därför bör argumentet inte innehålla någon tidszonsinformation. Det bör inte heller vara en relativ tid som \"+5 minuter\", eftersom *hwclock*:s precision beror på korrelationen mellan argumentets värde och när enter-tangenten trycks in. Bråkdelar av sekunder faller bort. Den här flaggan kan förstå många tids- och datumformat, men de föregående parametrarna bör följas."

#. from tp:util-linux-man-2.41.2-rc1
msgid "**--delay=**__seconds__"
msgstr "**--delay=**__seconds__"

#. from tp:util-linux-man-2.41.2-rc1
msgid "This option can be used to overwrite the internally used delay when setting the clock time. The default is 0.5 (500ms) for rtc_cmos, for another RTC types the delay is 0. If RTC type is impossible to determine (from sysfs) then it defaults also to 0.5 to be backwardly compatible."
msgstr "Denna flagga kan användas för att skriva över den interna fördröjning som används när klocktiden ställs in. Standardvärdet är 0,5 (500 ms) för rtc_cmos, för andra RTC-typer är fördröjningen 0. Om RTC-typen är omöjlig att bestämma (från sysfs) är standardvärdet också 0,5 för att vara bakåtkompatibel."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The 500ms default is based on commonly used MC146818A-compatible (x86) hardware clock. This Hardware Clock can only be set to any integer time plus one half second. The integer time is required because there is no interface to set or get a fractional second. The additional half second delay is because the Hardware Clock updates to the following second precisely 500 ms after setting the new time. Unfortunately, this behavior is hardware specific and in some cases another delay is required."
msgstr "Standardvärdet 500 ms baseras på en vanligt förekommande MC146818A-kompatibel (x86) hårdvaruklocka. Denna maskinvaruklocka kan endast ställas in på en heltalstid plus en halv sekund. Heltalstiden krävs eftersom det inte finns något gränssnitt för att ställa in eller hämta en bråkdels sekund. Den extra fördröjningen på en halv sekund beror på att maskinvaruklockan uppdateras till följande sekund exakt 500 ms efter att den nya tiden har ställts in. Tyvärr är detta beteende maskinvaruspecifikt och i vissa fall krävs ytterligare en fördröjning."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-D*, *--debug*"
msgstr "*-D*, *--debug*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Use *--verbose*. The *--debug* option has been deprecated and may be repurposed or removed in a future release."
msgstr "Använd *--verbose*. Flaggan *--debug* har utgått och kan komma att återanvändas eller tas bort i en framtida version."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--directisa*"
msgstr "*--directisa*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "This option is meaningful for ISA compatible machines in the x86 and x86_64 family. For other machines, it has no effect. This option tells *hwclock* to use explicit I/O instructions to access the Hardware Clock. Without this option, *hwclock* will use the rtc device file, which it assumes to be driven by the Linux RTC device driver. As of v2.26 it will no longer automatically use directisa when the rtc driver is unavailable; this was causing an unsafe condition that could allow two processes to access the Hardware Clock at the same time. Direct hardware access from userspace should only be used for testing, troubleshooting, and as a last resort when all other methods fail. See the *--rtc* option."
msgstr "Denna flagga är meningsfull för ISA-kompatibla maskiner i x86- och x86_64-familjen. För andra maskiner har det ingen effekt. Den här flaggan talar om för *hwclock* att använda explicita I/O-instruktioner för att komma åt maskinvaruklockan. Utan den här flaggan kommer *hwclock* att använda enhetsfilen rtc, som antas drivas av Linux RTC-enhetsdrivrutin. Från och med v2.26 används inte längre automatiskt directisa när rtc-drivrutinen inte är tillgänglig; detta orsakade ett osäkert tillstånd som kunde göra det möjligt för två processer att komma åt maskinvaruklockan samtidigt. Direkt hårdvaruåtkomst från userspace bör endast användas för testning, felsökning och som en sista utväg när alla andra metoder misslyckas. Se flaggan *--rtc*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "**--epoch=**__year__"
msgstr "**--epoch=**__year__"

#. from tp:util-linux-man-2.41.2-rc1
msgid "This option is required when using the *--setepoch* function. The minimum _year_ value is 1900. The maximum is system dependent (*ULONG_MAX - 1*)."
msgstr "Denna flagga krävs när du använder funktionen *--setepoch*. Det minsta _year_-värdet är 1900. Maxvärdet är systemberoende (*ULONG_MAX - 1*)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-f*, **--rtc=**__filename__"
msgstr "*-f*, **--rtc=**__filename__"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Override *hwclock*'s default rtc device file name. Otherwise it will use the first one found in this order: _/dev/rtc0_, _/dev/rtc_, _/dev/misc/rtc_. For *IA-64:* _/dev/efirtc_ _/dev/misc/efirtc_"
msgstr "Åsidosätter *hwclock*:s standardfilnamn för rtc-enheten. Annars kommer den att använda den första som hittas i den här ordningen: _/dev/rtc0_, _/dev/rtc_, _/dev/misc/rtc_. För *IA-64:* _/dev/efirtc_ _/dev/misc/efirtc_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-l*, *--localtime*; *-u*, *--utc*"
msgstr "*-l*, *--localtime*; *-u*, *--utc*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Indicate which timescale the Hardware Clock is set to."
msgstr "Anger vilken tidsskala hårdvaruklockan är inställd på."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The Hardware Clock may be configured to use either the UTC or the local timescale, but nothing in the clock itself says which alternative is being used. The *--localtime* or *--utc* options give this information to the *hwclock* command. If you specify the wrong one (or specify neither and take a wrong default), both setting and reading the Hardware Clock will be incorrect."
msgstr "Hårdvaruklockan kan konfigureras att använda antingen UTC eller den lokala tidsskalan, men inget i själva klockan säger vilket alternativ som används. Flaggorna *--localtime* eller *--utc* ger denna information till kommandot *hwclock*. Om du anger fel flagga (eller inte anger någon av flaggorna och använder en felaktig standard) blir både inställning och avläsning av hårdvaruklockan felaktig."

#. from tp:util-linux-man-2.41.2-rc1
msgid "If you specify neither *--utc* nor *--localtime* then the one last given with a set function (*--set*, *--systohc*, or *--adjust*), as recorded in _{ADJTIME_PATH}_, will be used. If the adjtime file doesn't exist, the default is UTC."
msgstr "Om du varken anger *--utc* eller *--localtime* används den tid som senast angavs med en set-funktion (*--set*, *--systohc* eller *--adjust*) och som finns registrerad i _{ADJTIME_PATH}_. Om adjtime-filen inte finns är standard UTC."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Note: daylight saving time changes may be inconsistent when the Hardware Clock is kept in local time. See the discussion below, under *LOCAL vs UTC*."
msgstr "Observera: ändringar av sommartid kan vara inkonsekventa när maskinvaruklockan hålls i lokal tid. Se diskussionen nedan under *LOKALTID vs UTC*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--noadjfile*"
msgstr "*--noadjfile*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Disable the facilities provided by _{ADJTIME_PATH}_. *hwclock* will not read nor write to that file with this option. Either *--utc* or *--localtime* must be specified when using this option."
msgstr "Inaktivera de funktioner som tillhandahålls av _{ADJTIME_PATH}_. *hwclock* kommer inte att läsa eller skriva till den filen med den här flaggan. Antingen *--utc* eller *--localtime* måste anges när denna flagga används."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--test*"
msgstr "*--test*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Do not actually change anything on the system, that is, the Clocks or _{ADJTIME_PATH}_ (*--verbose* is implicit with this option)."
msgstr "Ändra faktiskt ingenting i systemet, dvs. inte klockorna eller _{ADJTIME_PATH}_ (*--verbose* är implicit med denna flagga)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--update-drift*"
msgstr "*--update-drift*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Update the Hardware Clock's drift factor in _{ADJTIME_PATH}_. It can only be used with *--set* or *--systohc*."
msgstr "Uppdatera hårdvaruklockans driftfaktor i _{ADJTIME_PATH}_. Den kan endast användas med *--set* eller *--systohc*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "A minimum four hour period between settings is required. This is to avoid invalid calculations. The longer the period, the more precise the resulting drift factor will be."
msgstr "Det måste gå minst fyra timmar mellan inställningarna. Detta för att undvika ogiltiga beräkningar. Ju längre perioden är, desto mer exakt blir den resulterande driftfaktorn."

#. from tp:util-linux-man-2.41.2-rc1
msgid "This option was added in v2.26, because it is typical for systems to call *hwclock --systohc* at shutdown; with the old behavior this would automatically (re)calculate the drift factor which caused several problems:"
msgstr "Denna flagga lades till i v2.26, eftersom det är vanligt att system anropar *hwclock --systohc* vid avstängning; med det gamla beteendet skulle detta automatiskt (om)beräkna driftfaktorn, vilket orsakade flera problem:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "When using NTP with an '11 minute mode' kernel the drift factor would be clobbered to near zero."
msgstr "Vid användning av NTP med en \"11 minuters mode\"-kärna skulle driftfaktorn bli nära noll."

#. from tp:util-linux-man-2.41.2-rc1
msgid "It would not allow the use of 'cold' drift correction. With most configurations using 'cold' drift will yield favorable results. Cold, means when the machine is turned off which can have a significant impact on the drift factor."
msgstr "Det skulle inte tillåta användning av korrigering av \"kall\" drift. Med de flesta konfigurationer ger användning av \"kall\" drift goda resultat. Kall innebär att maskinen är avstängd, vilket kan ha en betydande inverkan på driftfaktorn."

#. from tp:util-linux-man-2.41.2-rc1
msgid "(Re)calculating drift factor on every shutdown delivers suboptimal results. For example, if ephemeral conditions cause the machine to be abnormally hot the drift factor calculation would be out of range."
msgstr "att (om)beräkna driftfaktorn vid varje avstängning ger suboptimala resultat. Om t.ex. tillfälliga förhållanden gör att maskinen blir onormalt varm skulle beräkningen av driftfaktorn hamna utanför intervallet."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Significantly increased system shutdown times (as of v2.31 when not using *--update-drift* the RTC is not read)."
msgstr "Betydligt längre avstängningstid för systemet (från och med v2.31 när *--update-drift* inte används läses inte RTC)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Having *hwclock* calculate the drift factor is a good starting point, but for optimal results it will likely need to be adjusted by directly editing the _{ADJTIME_PATH}_ file. For most configurations once a machine's optimal drift factor is crafted it should not need to be changed. Therefore, the old behavior to automatically (re)calculate drift was changed and now requires this option to be used. See the discussion below, under *The Adjust Function*."
msgstr "Att låta *hwclock* beräkna driftfaktorn är en bra utgångspunkt, men för optimala resultat måste den sannolikt justeras genom att direkt redigera filen _{ADJTIME_PATH}_. För de flesta konfigurationer bör den optimala driftfaktorn för en maskin inte behöva ändras när den väl har skapats. Därför har det gamla beteendet att automatiskt (om)beräkna drift ändrats och kräver nu att denna flagga används. Se diskussionen nedan, under *Justeringsfunktionen*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "This option requires reading the Hardware Clock before setting it. If it cannot be read, then this option will cause the set functions to fail. This can happen, for example, if the Hardware Clock is corrupted by a power failure. In that case, the clock must first be set without this option. Despite it not working, the resulting drift correction factor would be invalid anyway."
msgstr "Denna flagga kräver att hårdvaruklockan läses av innan den ställs in. Om den inte kan läsas av, kommer denna flagga att leda till att de inställda funktionerna misslyckas. Detta kan t.ex. inträffa om hårdvaruklockan skadas av ett strömavbrott. I så fall måste klockan först ställas in utan denna flagga. Även om det inte fungerar kommer den resulterande driftkorrigeringsfaktorn ändå att vara ogiltig."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Display more details about what *hwclock* is doing internally."
msgstr "Visa mer detaljer om vad *hwclock* gör internt."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Clocks in a Linux System"
msgstr "Klockor i ett Linux-system"

#. from tp:util-linux-man-2.41.2-rc1
msgid "There are two types of date-time clocks:"
msgstr "Det finns två typer av datum- och tidsklockor:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*The Hardware Clock:* This clock is an independent hardware device, with its own power domain (battery, capacitor, etc), that operates when the machine is powered off, or even unplugged."
msgstr "*Hårdvaruklockan:* Denna klocka är en oberoende hårdvaruenhet med egen strömförsörjning (batteri, kondensator etc.) som fungerar när maskinen är avstängd eller till och med urkopplad."

#. from tp:util-linux-man-2.41.2-rc1
msgid "On an ISA compatible system, this clock is specified as part of the ISA standard. A control program can read or set this clock only to a whole second, but it can also detect the edges of the 1 second clock ticks, so the clock actually has virtually infinite precision."
msgstr "På ett ISA-kompatibelt system är denna klocka specificerad som en del av ISA-standarden. Ett styrprogram kan bara läsa av eller ställa in den här klockan på en hel sekund, men det kan också upptäcka kanterna på klockans 1 sekunds tick, så klockan har faktiskt praktiskt taget oändlig precision."

#. from tp:util-linux-man-2.41.2-rc1
msgid "This clock is commonly called the hardware clock, the real time clock, the RTC, the BIOS clock, and the CMOS clock. Hardware Clock, in its capitalized form, was coined for use by *hwclock*. The Linux kernel also refers to it as the persistent clock."
msgstr "Denna klocka kallas vanligen hårdvaruklockan, realtidsklockan, RTC, BIOS-klockan och CMOS-klockan. Hårdvaruklocka, i sin kapitaliserade form, myntades för användning av *hwclock*. Linuxkärnan hänvisar också till den som den permanenta klockan."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Some non-ISA systems have a few real time clocks with only one of them having its own power domain. A very low power external I2C or SPI clock chip might be used with a backup battery as the hardware clock to initialize a more functional integrated real-time clock which is used for most other purposes."
msgstr "Vissa system som inte är ISA-anslutna har flera realtidsklockor, men bara en av dem har en egen spänningsdomän. Ett externt I2C- eller SPI-klockchip med mycket låg effekt kan användas med ett reservbatteri som hårdvaruklocka för att initiera en mer funktionell integrerad realtidsklocka som används för de flesta andra ändamål."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*The System Clock:* This clock is part of the Linux kernel and is driven by a timer interrupt. (On an ISA machine, the timer interrupt is part of the ISA standard.) It has meaning only while Linux is running on the machine. The System Time is the number of seconds since 00:00:00 January 1, 1970 UTC (or more succinctly, the number of seconds since 1969 UTC). The System Time is not an integer, though. It has virtually infinite precision."
msgstr "*Systemklockan:* Denna klocka är en del av Linuxkärnan och drivs av ett timeravbrott. (På en ISA-maskin är timeravbrottet en del av ISA-standarden.) Den har betydelse endast när Linux körs på maskinen. Systemtiden är antalet sekunder sedan 00:00:00 den 1 januari 1970 UTC (eller mer kortfattat, antalet sekunder sedan 1969 UTC). Systemtiden är dock inte ett heltal. Den har praktiskt taget oändlig precision."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The System Time is the time that matters. The Hardware Clock's basic purpose is to keep time when Linux is not running so that the System Clock can be initialized from it at boot. Note that in DOS, for which ISA was designed, the Hardware Clock is the only real time clock."
msgstr "Systemtiden är den tid som är viktig. Hårdvaruklockans grundläggande syfte är att hålla tiden när Linux inte körs så att systemklockan kan initialiseras från den vid uppstart. Observera att i DOS, som ISA utformades för, är maskinvaruklockan den enda realtidsklockan."

#. from tp:util-linux-man-2.41.2-rc1
msgid "It is important that the System Time not have any discontinuities such as would happen if you used the *date*(1) program to set it while the system is running. You can, however, do whatever you want to the Hardware Clock while the system is running, and the next time Linux starts up, it will do so with the adjusted time from the Hardware Clock. Note: currently this is not possible on most systems because *hwclock --systohc* is called at shutdown."
msgstr "Det är viktigt att systemtiden inte har några diskontinuiteter, vilket skulle hända om du använde programmet *date*(1) för att ställa in den medan systemet körs. Du kan dock göra vad du vill med maskinvaruklockan medan systemet körs, och nästa gång Linux startar kommer det att göra det med den justerade tiden från maskinvaruklockan. Observera: För närvarande är detta inte möjligt på de flesta system eftersom *hwclock --systohc* anropas vid avstängning."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The Linux kernel's timezone is set by *hwclock*. But don't be misled -- almost nobody cares what timezone the kernel thinks it is in. Instead, programs that care about the timezone (perhaps because they want to display a local time for you) almost always use a more traditional method of determining the timezone: They use the *TZ* environment variable or the _/etc/localtime_ file, as explained in the man page for *tzset*(3). However, some programs and fringe parts of the Linux kernel such as filesystems use the kernel's timezone value. An example is the vfat filesystem. If the kernel timezone value is wrong, the vfat filesystem will report and set the wrong timestamps on files. Another example is the kernel's NTP '11 minute mode'. If the kernel's timezone value and/or the _persistent_clock_is_local_ variable are wrong, then the Hardware Clock will be set incorrectly by '11 minute mode'. See the discussion below, under *Automatic Hardware Clock Synchronization by the Kernel*."
msgstr "Linuxkärnans tidszon ställs in av *hwclock*. Men låt dig inte vilseledas - nästan ingen bryr sig om vilken tidszon kärnan tror att den befinner sig i. Istället använder program som bryr sig om tidszonen (kanske för att de vill visa en lokal tid för dig) nästan alltid en mer traditionell metod för att bestämma tidszonen: De använder miljövariabeln *TZ* eller filen _/etc/localtime_, vilket förklaras i man-sidan för *tzset*(3). Vissa program och delar av Linux-kärnan, t.ex. filsystem, använder dock kärnans tidszonsvärde. Ett exempel är filsystemet vfat. Om kärnans tidszonsvärde är fel kommer filsystemet vfat att rapportera och sätta fel tidsstämplar på filer. Ett annat exempel är kärnans NTP '11 minuters läge'. Om kärnans tidszonsvärde och/eller variabeln _persistent_klocka_is_local_ är fel, kommer hårdvaruklockan att ställas in felaktigt av \"11-minutersläget\". Se diskussionen nedan, under *Automatisk synkronisering av maskinvaruklockan av kärnan*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*hwclock* sets the kernel's timezone to the value indicated by *TZ* or _/etc/localtime_ with the *--hctosys* or *--systz* functions."
msgstr "*hwclock* ställer in kärnans tidszon till det värde som anges av *TZ* eller _/etc/localtime_ med funktionerna *--hctosys* eller *--systz*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The kernel's timezone value actually consists of two parts: 1) a field tz_minuteswest indicating how many minutes local time (not adjusted for DST) lags behind UTC, and 2) a field tz_dsttime indicating the type of Daylight Savings Time (DST) convention that is in effect in the locality at the present time. This second field is not used under Linux and is always zero. See also *settimeofday*(2)."
msgstr "Kärnans tidszonsvärde består egentligen av två delar: 1) ett fält tz_minuteswest som anger hur många minuter lokal tid (ej justerad för sommartid) ligger efter UTC, och 2) ett fält tz_dsttime som anger vilken typ av sommartidskonvention som gäller på den aktuella platsen för närvarande. Det andra fältet används inte under Linux och är alltid noll. Se även *settimeofday*(2)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Hardware Clock Access Methods"
msgstr "Metoder för åtkomst till hårdvaruklocka"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*hwclock* uses many different ways to get and set Hardware Clock values. The most normal way is to do I/O to the rtc device special file, which is presumed to be driven by the rtc device driver. Also, Linux systems using the rtc framework with udev, are capable of supporting multiple Hardware Clocks. This may bring about the need to override the default rtc device by specifying one with the *--rtc* option."
msgstr "*hwclock* använder många olika sätt att hämta och ställa in värden för maskinvaruklockan. Det mest normala sättet är att göra I/O till specialfilen rtc device, som förutsätts drivas av drivrutinen rtc device. Linux-system som använder rtc-ramverket med udev kan dessutom stödja flera maskinvaruklockor. Detta kan medföra ett behov av att åsidosätta standard rtc-enheten genom att ange en med flaggan *--rtc*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "However, this method is not always available as older systems do not have an rtc driver. On these systems, the method of accessing the Hardware Clock depends on the system hardware."
msgstr "Denna metod är dock inte alltid tillgänglig eftersom äldre system inte har någon rtc-drivrutin. På dessa system beror metoden för att komma åt hårdvaruklockan på systemets maskinvara."

#. from tp:util-linux-man-2.41.2-rc1
msgid "On an ISA compatible system, *hwclock* can directly access the \"CMOS memory\" registers that constitute the clock, by doing I/O to Ports 0x70 and 0x71. It does this with actual I/O instructions and consequently can only do it if running with superuser effective userid. This method may be used by specifying the *--directisa* option."
msgstr "På ett ISA-kompatibelt system kan *hwclock* få direkt tillgång till de register i \"CMOS-minnet\" som utgör klockan genom att göra I/O till portarna 0x70 och 0x71. Den gör detta med faktiska I/O-instruktioner och kan därför bara göra det om den körs med superuser effective userid. Den här metoden kan användas genom att ange flaggan *--directisa*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "This is a really poor method of accessing the clock, for all the reasons that userspace programs are generally not supposed to do direct I/O and disable interrupts. *hwclock* provides it for testing, troubleshooting, and because it may be the only method available on ISA systems which do not have a working rtc device driver."
msgstr "Det här är en riktigt dålig metod för att komma åt klockan, av alla de skäl som gör att program i användarutrymmet i allmänhet inte ska göra direkta I/O och inaktivera avbrott. *hwclock* tillhandahåller den för testning, felsökning och för att det kan vara den enda tillgängliga metoden på ISA-system som inte har en fungerande rtc-enhetsdrivrutin."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The Adjust Function"
msgstr "Justeringsfunktionen"

#. from tp:util-linux-man-2.41.2-rc1
msgid "The Hardware Clock is usually not very accurate. However, much of its inaccuracy is completely predictable - it gains or loses the same amount of time every day. This is called systematic drift. *hwclock*'s *--adjust* function lets you apply systematic drift corrections to the Hardware Clock."
msgstr "Hårdvaruklockan är vanligtvis inte särskilt exakt. En stor del av dess felaktighet är dock helt förutsägbar - den vinner eller förlorar samma tid varje dag. Detta kallas systematisk drift. *med hwclock*:s *--adjust*-funktion kan du korrigera den systematiska driften i maskinvaruklockan."

#. from tp:util-linux-man-2.41.2-rc1
msgid "It works like this: *hwclock* keeps a file, _{ADJTIME_PATH}_, that keeps some historical information. This is called the adjtime file."
msgstr "Det fungerar på följande sätt: *hwclock* har en fil, _{ADJTIME_PATH}_, som innehåller viss historisk information. Denna fil kallas adjtime-filen."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Suppose you start with no adjtime file. You issue a *hwclock --set* command to set the Hardware Clock to the true current time. *hwclock* creates the adjtime file and records in it the current time as the last time the clock was calibrated. Five days later, the clock has gained 10 seconds, so you issue a *hwclock --set --update-drift* command to set it back 10 seconds. *hwclock* updates the adjtime file to show the current time as the last time the clock was calibrated, and records 2 seconds per day as the systematic drift rate. 24 hours go by, and then you issue a *hwclock --adjust* command. *hwclock* consults the adjtime file and sees that the clock gains 2 seconds per day when left alone and that it has been left alone for exactly one day. So it subtracts 2 seconds from the Hardware Clock. It then records the current time as the last time the clock was adjusted. Another 24 hours go by and you issue another *hwclock --adjust*. *hwclock* does the same thing: subtracts 2 seconds and updates the adjtime file with the current time as the last time the clock was adjusted."
msgstr "Anta att du börjar med att inte ha någon adjtime-fil. Du ger kommandot *hwclock --set* för att ställa in maskinvaruklockan till den verkliga aktuella tiden. *hwclock* skapar adjtime-filen och registrerar i den den aktuella tiden när klockan senast kalibrerades. Fem dagar senare har klockan gått fram 10 sekunder, så du ger kommandot *hwclock --set --update-drift* för att ställa tillbaka den 10 sekunder. *hwclock* uppdaterar adjtime-filen så att den visar den aktuella tiden som den senaste gången klockan kalibrerades, och registrerar 2 sekunder per dag som den systematiska drifthastigheten. 24 timmar går, och sedan ger du kommandot *hwclock --adjust*. *hwclock* konsulterar adjtime-filen och ser att klockan vinner 2 sekunder per dag när den lämnas i fred och att den har lämnats i fred i exakt en dag. Så den subtraherar 2 sekunder från maskinvaruklockan. Sedan registreras den aktuella tiden som den senaste gången klockan justerades. Ytterligare 24 timmar går och du utfärdar en ny *hwclock --adjust*. *hwclock* gör samma sak: subtraherar 2 sekunder och uppdaterar adjtime-filen med den aktuella tiden då klockan senast justerades."

#. from tp:util-linux-man-2.41.2-rc1
msgid "When you use the *--update-drift* option with *--set* or *--systohc*, the systematic drift rate is (re)calculated by comparing the fully drift corrected current Hardware Clock time with the new set time, from that it derives the 24 hour drift rate based on the last calibrated timestamp from the adjtime file. This updated drift factor is then saved in _{ADJTIME_PATH}_."
msgstr "När du använder flaggan *--update-drift* med *--set* eller *--systohc*, beräknas den systematiska driftfaktorn (på nytt) genom att jämföra den helt driftkorrigerade aktuella hårdvaruklockans tid med den nya inställda tiden, från vilken den 24 timmars driftfaktorn härleds baserat på den senast kalibrerade tidsstämpeln från adjtime-filen. Denna uppdaterade driftfaktor sparas sedan i _{ADJTIME_PATH}_."

#. from tp:util-linux-man-2.41.2-rc1
msgid "A small amount of error creeps in when the Hardware Clock is set, so *--adjust* refrains from making any adjustment that is less than 1 second. Later on, when you request an adjustment again, the accumulated drift will be more than 1 second and *--adjust* will make the adjustment including any fractional amount."
msgstr "En liten mängd fel smyger sig in när hårdvaruklockan ställs in, så *--adjust* avstår från att göra någon justering som är mindre än 1 sekund. Senare, när du begär en justering igen, kommer den ackumulerade avvikelsen att vara mer än 1 sekund och *--adjust* kommer att göra justeringen inklusive eventuella bråkdelar."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*hwclock --hctosys* also uses the adjtime file data to compensate the value read from the Hardware Clock before using it to set the System Clock. It does not share the 1 second limitation of *--adjust*, and will correct sub-second drift values immediately. It does not change the Hardware Clock time nor the adjtime file. This may eliminate the need to use *--adjust*, unless something else on the system needs the Hardware Clock to be compensated."
msgstr "*hwclock --hctosys* använder också data från adjtime-filen för att kompensera det värde som läses från maskinvaruklockan innan det används för att ställa in systemklockan. Den har inte samma begränsning på 1 sekund som *--adjust*, och korrigerar driftvärden på under en sekund omedelbart. Den ändrar inte hårdvaruklockans tid och inte heller adjtime-filen. Detta kan eliminera behovet av att använda *--adjust*, såvida inte något annat i systemet kräver att maskinvaruklockan kompenseras."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The Adjtime File"
msgstr "Adjtime-filen"

#. from tp:util-linux-man-2.41.2-rc1
msgid "While named for its historical purpose of controlling adjustments only, it actually contains other information used by *hwclock* from one invocation to the next."
msgstr "Den har fått sitt namn på grund av sitt historiska syfte att endast kontrollera justeringar, men den innehåller faktiskt annan information som används av *hwclock* från ett anrop till nästa."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The format of the adjtime file is, in ASCII:"
msgstr "Formatet på filen adjtime är i ASCII:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Line 1: Three numbers, separated by blanks: 1) the systematic drift rate in seconds per day, floating point decimal; 2) the resulting number of seconds since 1969 UTC of most recent adjustment or calibration, decimal integer; 3) zero (for compatibility with *clock*(8)) as a floating point decimal."
msgstr "Rad 1: Tre tal, åtskilda av blanksteg: 1) den systematiska drifthastigheten i sekunder per dag, decimal med flyttal; 2) det resulterande antalet sekunder sedan 1969 UTC för senaste justering eller kalibrering, heltal med decimal; 3) noll (för kompatibilitet med *clock*(8)) som decimal med flyttal."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Line 2: One number: the resulting number of seconds since 1969 UTC of most recent calibration. Zero if there has been no calibration yet or it is known that any previous calibration is moot (for example, because the Hardware Clock has been found, since that calibration, not to contain a valid time). This is a decimal integer."
msgstr "Linje 2: Ett tal: det resulterande antalet sekunder sedan 1969 UTC för den senaste kalibreringen. Noll om ingen kalibrering har gjorts ännu eller om det är känt att någon tidigare kalibrering är ogiltig (t.ex. för att hårdvaruklockan efter den kalibreringen inte har visat sig innehålla en giltig tid). Detta är ett heltal med decimaltal."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Line 3: \"UTC\" or \"LOCAL\". Tells whether the Hardware Clock is set to Coordinated Universal Time or local time. You can always override this value with options on the *hwclock* command line."
msgstr "Rad 3: \"UTC\" eller \"LOKAL\". Anger om maskinvaruklockan är inställd på Coordinated Universal Time eller lokal tid. Du kan alltid åsidosätta detta värde med flaggor på kommandoraden *hwclock*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "You can use an adjtime file that was previously used with the *clock*(8) program with *hwclock*."
msgstr "Du kan använda en adjtime-fil som tidigare har använts med programmet *clock*(8) med *hwclock*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Automatic Hardware Clock Synchronization by the Kernel"
msgstr "Automatisk synkronisering av hårdvaruklockan genom kärnan"

#. from tp:util-linux-man-2.41.2-rc1
msgid "You should be aware of another way that the Hardware Clock is kept synchronized in some systems. The Linux kernel has a mode wherein it copies the System Time to the Hardware Clock every 11 minutes. This mode is a compile time option, so not all kernels will have this capability. This is a good mode to use when you are using something sophisticated like NTP to keep your System Clock synchronized. (NTP is a way to keep your System Time synchronized either to a time server somewhere on the network or to a radio clock hooked up to your system. See RFC 1305.)"
msgstr "Du bör känna till ett annat sätt som maskinvaruklockan hålls synkroniserad på i vissa system. Linuxkärnan har ett läge där den kopierar systemtiden till maskinvaruklockan var 11:e minut. Det här läget är en kompileringsflagga, så det är inte alla kärnor som har den här möjligheten. Det här är ett bra läge att använda när du använder något sofistikerat som NTP för att hålla systemklockan synkroniserad. (NTP är ett sätt att hålla systemtiden synkroniserad antingen med en tidsserver någonstans i nätverket eller med en radioklocka som är ansluten till systemet. Se RFC 1305.)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "If the kernel is compiled with the '11 minute mode' option it will be active when the kernel's clock discipline is in a synchronized state. When in this state, bit 6 (the bit that is set in the mask 0x0040) of the kernel's _time_status_ variable is unset. This value is output as the 'status' line of the *adjtimex --print* or *ntptime* commands."
msgstr "Om kärnan är kompilerad med flaggan '11 minute mode' kommer det att vara aktivt när kärnans klockdisciplin är i ett synkroniserat tillstånd. I detta läge är bit 6 (den bit som sätts i masken 0x0040) i kärnans _time_status_-variabel osatt. Detta värde visas som \"status\"-raden i kommandona *adjtimex --print* eller *ntptime*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "It takes an outside influence, like the NTP daemon to put the kernel's clock discipline into a synchronized state, and therefore turn on '11 minute mode'. It can be turned off by running anything that sets the System Clock the old fashioned way, including *hwclock --hctosys*. However, if the NTP daemon is still running, it will turn '11 minute mode' back on again the next time it synchronizes the System Clock."
msgstr "Det krävs en yttre påverkan, som NTP-daemon, för att sätta kärnans klockdisciplin i ett synkroniserat tillstånd och därmed aktivera \"11-minutersläget\". Det kan stängas av genom att köra något som ställer in systemklockan på det gamla sättet, inklusive *hwclock --hctosys*. Men om NTP-daemon fortfarande körs kommer den att slå på \"11-minutersläget\" igen nästa gång den synkroniserar systemklockan."

#. from tp:util-linux-man-2.41.2-rc1
msgid "If your system runs with '11 minute mode' on, it may need to use either *--hctosys* or *--systz* in a startup script, especially if the Hardware Clock is configured to use the local timescale. Unless the kernel is informed of what timescale the Hardware Clock is using, it may clobber it with the wrong one. The kernel uses UTC by default."
msgstr "Om ditt system körs med \"11-minutersläget\" aktiverat kan det behöva använda antingen *--hctosys* eller *--systz* i ett startskript, speciellt om maskinvaruklockan är konfigurerad att använda den lokala tidsskalan. Om inte kärnan får information om vilken tidsskala maskinvaruklockan använder, kan den komma att använda fel tidsskala. Kärnan använder UTC som standard."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The first userspace command to set the System Clock informs the kernel what timescale the Hardware Clock is using. This happens via the _persistent_clock_is_local_ kernel variable. If *--hctosys* or *--systz* is the first, it will set this variable according to the adjtime file or the appropriate command-line argument. Note that when using this capability and the Hardware Clock timescale configuration is changed, then a reboot is required to notify the kernel."
msgstr "Det första kommandot i userspace för att ställa in systemklockan informerar kärnan om vilken tidsskala hårdvaruklockan använder. Detta sker via kärnvariabeln _persistent_klocka_is_local_. Om *--hctosys* eller *--systz* är det första kommandot kommer det att ställa in denna variabel enligt adjtime-filen eller lämpligt kommandoradsargument. Observera att när den här funktionen används och konfigurationen av tidsskalan för maskinvaruklockan ändras, krävs en omstart för att kärnan ska informeras."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*hwclock --adjust* should not be used with NTP '11 minute mode'."
msgstr "*hwclock --adjust* bör inte användas med NTP \"11 minuters läge\"."

#. from tp:util-linux-man-2.41.2-rc1
msgid "ISA Hardware Clock Century value"
msgstr "ISA hårdvaruklocka Century-värde"

#. from tp:util-linux-man-2.41.2-rc1
msgid "There is some sort of standard that defines CMOS memory Byte 50 on an ISA machine as an indicator of what century it is. *hwclock* does not use or set that byte because there are some machines that don't define the byte that way, and it really isn't necessary anyway, since the year-of-century does a good job of implying which century it is."
msgstr "Det finns någon form av standard som definierar CMOS-minnesbyte 50 på en ISA-maskin som en indikator på vilket århundrade det är. *hwclock* använder eller ställer inte in den byten eftersom det finns vissa maskiner som inte definierar byten på det sättet, och det är egentligen inte nödvändigt ändå, eftersom årtalet gör ett bra jobb med att antyda vilket århundrade det är."

#. from tp:util-linux-man-2.41.2-rc1
msgid "If you have a bona fide use for a CMOS century byte, contact the *hwclock* maintainer; an option may be appropriate."
msgstr "Om du har en bona fide-användning för en CMOS century byte, kontakta *hwclock*-underhållaren; en flagga kan vara lämpligt."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Note that this section is only relevant when you are using the \"direct ISA\" method of accessing the Hardware Clock. ACPI provides a standard way to access century values, when they are supported by the hardware."
msgstr "Observera att detta avsnitt endast är relevant när du använder \"direkt ISA\"-metoden för att komma åt maskinvaruklockan. ACPI tillhandahåller ett standardiserat sätt att komma åt century-värden, när de stöds av maskinvaran."

#. from tp:util-linux-man-2.41.2-rc1
msgid "DATE-TIME CONFIGURATION"
msgstr "KONFIGURATION AV DATUM OCH TID"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Keeping Time without External Synchronization"
msgstr "Hålla tiden utan extern synkronisering"

#. from tp:util-linux-man-2.41.2-rc1
msgid "This discussion is based on the following conditions:"
msgstr "Denna diskussion baseras på följande förutsättningar:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Nothing is running that alters the date-time clocks, such as NTP daemon or a cron job.\""
msgstr "Inget körs som ändrar datum- och tidsklockorna, t.ex. NTP-daemon eller ett cron-jobb.\""

#. from tp:util-linux-man-2.41.2-rc1
msgid "The system timezone is configured for the correct local time. See below, under *POSIX vs 'RIGHT'*."
msgstr "Systemets tidszon är konfigurerad för korrekt lokal tid. Se nedan, under *POSIX vs 'RIGHT'*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Early during startup the following are called, in this order: *adjtimex --tick* _value_ *--frequency* _value_ *hwclock --hctosys*"
msgstr "Tidigt under uppstarten anropas följande, i denna ordning: *adjtimex --tick* _värde_ *--frequency* _värde_ *hwclock --hctosys*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "During shutdown the following is called: *hwclock --systohc*"
msgstr "Under avstängningen anropas följande: *hwclock --systohc*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Systems without *adjtimex* may use *ntptime*."
msgstr "System utan *adjtimex* kan använda *ntptime*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Whether maintaining precision time with NTP daemon or not, it makes sense to configure the system to keep reasonably good date-time on its own."
msgstr "Oavsett om du använder NTP-daemon för att hålla exakt tid eller inte, är det vettigt att konfigurera systemet så att det håller en någorlunda bra datumtid på egen hand."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The first step in making that happen is having a clear understanding of the big picture. There are two completely separate hardware devices running at their own speed and drifting away from the 'correct' time at their own rates. The methods and software for drift correction are different for each of them. However, most systems are configured to exchange values between these two clocks at startup and shutdown. Now the individual device's time keeping errors are transferred back and forth between each other. Attempt to configure drift correction for only one of them, and the other's drift will be overlaid upon it."
msgstr "Det första steget för att åstadkomma detta är att ha en tydlig förståelse för helheten. Det är två helt separata hårdvaruenheter som körs i sin egen hastighet och som avviker från den \"korrekta\" tiden i sin egen takt. Metoderna och programvaran för driftkorrigering är olika för var och en av dem. De flesta system är dock konfigurerade för att utbyta värden mellan dessa två klockor vid start och avstängning. Nu överförs de enskilda enheternas fel i tidshållningen fram och tillbaka mellan varandra. Om du försöker konfigurera driftkorrigering för endast en av dem, kommer den andra enhetens drift att överlagras på den."

#. from tp:util-linux-man-2.41.2-rc1
msgid "This problem can be avoided when configuring drift correction for the System Clock by simply not shutting down the machine. This, plus the fact that all of *hwclock*'s precision (including calculating drift factors) depends upon the System Clock's rate being correct, means that configuration of the System Clock should be done first."
msgstr "Detta problem kan undvikas vid konfigurering av driftkorrigering för systemklockan genom att helt enkelt inte stänga av maskinen. Detta, plus det faktum att all *hwclock*:s precision (inklusive beräkning av driftfaktorer) är beroende av att systemklockans takt är korrekt, innebär att konfigurationen av systemklockan bör göras först."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The System Clock drift is corrected with the *adjtimex*(8) command's *--tick* and *--frequency* options. These two work together: tick is the coarse adjustment and frequency is the fine adjustment. (For systems that do not have an *adjtimex* package, *ntptime -f* _ppm_ may be used instead.)"
msgstr "Systemklockans drift korrigeras med kommandot *adjtimex*(8) med flaggan *--tick* och *--frequency*. Dessa två fungerar tillsammans: tick är grovjusteringen och frekvensen är finjusteringen. (För system som inte har ett *adjtimex*-paket kan *ntptime -f* _ppm_ användas istället)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Some Linux distributions attempt to automatically calculate the System Clock drift with *adjtimex*'s compare operation. Trying to correct one drifting clock by using another drifting clock as a reference is akin to a dog trying to catch its own tail. Success may happen eventually, but great effort and frustration will likely precede it. This automation may yield an improvement over no configuration, but expecting optimum results would be in error. A better choice for manual configuration would be *adjtimex*'s *--log* options."
msgstr "Vissa Linux-distributioner försöker automatiskt beräkna systemklockans drift med *adjtimex*:s jämförelseoperation. Att försöka korrigera en driftande klocka genom att använda en annan driftande klocka som referens är som en hund som försöker fånga sin egen svans. Framgång kan ske så småningom, men stora ansträngningar och frustration kommer sannolikt att föregå det. Denna automatisering kan ge en förbättring jämfört med ingen konfiguration, men att förvänta sig optimala resultat skulle vara felaktigt. Ett bättre val för manuell konfiguration skulle vara *adjtimex*:s *--log*-flaggor."

#. from tp:util-linux-man-2.41.2-rc1
msgid "It may be more effective to simply track the System Clock drift with *sntp*, or *date -Ins* and a precision timepiece, and then calculate the correction manually."
msgstr "Det kan vara mer effektivt att helt enkelt följa systemklockans drift med *sntp* eller *date -Ins* och ett precisionsur och sedan beräkna korrigeringen manuellt."

#. from tp:util-linux-man-2.41.2-rc1
msgid "After setting the tick and frequency values, continue to test and refine the adjustments until the System Clock keeps good time. See *adjtimex*(2) for more information and the example demonstrating manual drift calculations."
msgstr "När du har ställt in värdena för tick och frekvens fortsätter du att testa och förfina justeringarna tills systemklockan håller rätt tid. Se *adjtimex*(2) för mer information och ett exempel som visar manuella driftberäkningar."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Once the System Clock is ticking smoothly, move on to the Hardware Clock."
msgstr "När systemklockan tickar jämnt kan du gå vidare till hårdvaruklockan."

#. from tp:util-linux-man-2.41.2-rc1
msgid "As a rule, cold drift will work best for most use cases. This should be true even for 24/7 machines whose normal downtime consists of a reboot. In that case the drift factor value makes little difference. But on the rare occasion that the machine is shut down for an extended period, then cold drift should yield better results."
msgstr "Som regel fungerar kall drift bäst för de flesta användningsfall. Detta bör gälla även för 24/7-maskiner vars normala stilleståndstid består av en omstart. I det fallet gör värdet på driftfaktorn ingen större skillnad. Men i de sällsynta fall då maskinen är avstängd under en längre period bör kall drift ge bättre resultat."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*Steps to calculate cold drift:*"
msgstr "*Steg för att beräkna kölddrift:*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*Ensure that NTP daemon will not be launched at startup.*"
msgstr "*Se till att NTP-daemon inte startas vid uppstart.*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "The _System Clock_ time must be correct at shutdown!"
msgstr "Tiden för _Systemklockan_ måste vara korrekt vid avstängning!"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Shut down the system."
msgstr "Stäng av systemet."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Let an extended period pass without changing the Hardware Clock."
msgstr "Låt en längre period gå utan att ändra hårdvaruklockan."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Start the system."
msgstr "Starta systemet."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Immediately use *hwclock* to set the correct time, adding the *--update-drift* option."
msgstr "Använd omedelbart *hwclock* för att ställa in rätt tid, och lägg till flaggan *--update-drift*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Note: if step 6 uses *--systohc*, then the System Clock must be set correctly (step 6a) just before doing so."
msgstr "Obs: Om steg 6 använder *--systohc*, måste systemklockan ställas in korrekt (steg 6a) precis innan detta görs."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Having *hwclock* calculate the drift factor is a good starting point, but for optimal results it will likely need to be adjusted by directly editing the _{ADJTIME_PATH}_ file. Continue to test and refine the drift factor until the Hardware Clock is corrected properly at startup. To check this, first make sure that the System Time is correct before shutdown and then use *sntp*, or *date -Ins* and a precision timepiece, immediately after startup."
msgstr "Att låta *hwclock* beräkna driftfaktorn är en bra utgångspunkt, men för optimala resultat måste den sannolikt justeras genom att direkt redigera filen _{ADJTIME_PATH}_. Fortsätt att testa och förfina driftfaktorn tills maskinvaruklockan korrigeras korrekt vid uppstart. För att kontrollera detta ska du först se till att systemtiden är korrekt före avstängning och sedan använda *sntp*, eller *date -Ins* och ett precisionsur, omedelbart efter uppstart."

#. from tp:util-linux-man-2.41.2-rc1
msgid "LOCAL vs UTC"
msgstr "LOCAL vs UTC"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Keeping the Hardware Clock in a local timescale causes inconsistent daylight saving time results:"
msgstr "Att hålla hårdvaruklockan i en lokal tidsskala ger inkonsekventa resultat för sommartid:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "If Linux is running during a daylight saving time change, the time written to the Hardware Clock will be adjusted for the change."
msgstr "Om Linux körs under en sommartidsändring kommer den tid som skrivs till maskinvaruklockan att justeras för ändringen."

#. from tp:util-linux-man-2.41.2-rc1
msgid "If Linux is NOT running during a daylight saving time change, the time read from the Hardware Clock will NOT be adjusted for the change."
msgstr "Om Linux INTE körs under en sommartidsändring kommer den tid som avläses från maskinvaruklockan INTE att justeras för ändringen."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The Hardware Clock on an ISA compatible system keeps only a date and time, it has no concept of timezone nor daylight saving. Therefore, when *hwclock* is told that it is in local time, it assumes it is in the 'correct' local time and makes no adjustments to the time read from it."
msgstr "Hårdvaruklockan på ett ISA-kompatibelt system håller bara datum och tid, den har ingen uppfattning om tidszon eller sommartid. När *hwclock* får veta att den är i lokal tid, antar den därför att den är i \"rätt\" lokal tid och gör inga justeringar av den tid som läses från den."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Linux handles daylight saving time changes transparently only when the Hardware Clock is kept in the UTC timescale. Doing so is made easy for system administrators as *hwclock* uses local time for its output and as the argument to the *--date* option."
msgstr "Linux hanterar sommartidsändringar på ett transparent sätt endast när maskinvaruklockan hålls i UTC-tidsskalan. Detta görs enkelt för systemadministratörer eftersom *hwclock* använder lokal tid för utdata och som argument för flaggan *--date*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "POSIX systems, like Linux, are designed to have the System Clock operate in the UTC timescale. The Hardware Clock's purpose is to initialize the System Clock, so also keeping it in UTC makes sense."
msgstr "POSIX-system, som Linux, är utformade för att systemklockan ska fungera i UTC-tidsskalan. Hårdvaruklockans syfte är att initiera systemklockan, så det är vettigt att även hålla den i UTC."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Linux does, however, attempt to accommodate the Hardware Clock being in the local timescale. This is primarily for dual-booting with older versions of MS Windows. From Windows 7 on, the RealTimeIsUniversal registry key is supposed to be working properly so that its Hardware Clock can be kept in UTC."
msgstr "Linux försöker dock hantera att hårdvaruklockan befinner sig i den lokala tidsskalan. Detta är främst för dubbelstart med äldre versioner av MS Windows. Från och med Windows 7 är det meningen att registernyckeln RealTimeIsUniversal ska fungera korrekt så att maskinvaruklockan kan hållas i UTC."

#. from tp:util-linux-man-2.41.2-rc1
msgid "POSIX vs 'RIGHT'"
msgstr "POSIX kontra \"RIGHT"

#. from tp:util-linux-man-2.41.2-rc1
msgid "A discussion on date-time configuration would be incomplete without addressing timezones, this is mostly well covered by *tzset*(3). One area that seems to have no documentation is the 'right' directory of the Time Zone Database, sometimes called tz or zoneinfo."
msgstr "En diskussion om konfiguration av datum och tid skulle vara ofullständig utan att ta upp tidszoner, och detta täcks för det mesta väl av *tzset*(3). Ett område som inte verkar ha någon dokumentation är den \"rätta\" katalogen för Time Zone Database, ibland kallad tz eller zoneinfo."

#. from tp:util-linux-man-2.41.2-rc1
msgid "There are two separate databases in the zoneinfo system, posix and 'right'. 'Right' (now named zoneinfo-leaps) includes leap seconds and posix does not. To use the 'right' database the System Clock must be set to (UTC {plus} leap seconds), which is equivalent to (TAI - 10). This allows calculating the exact number of seconds between two dates that cross a leap second epoch. The System Clock is then converted to the correct civil time, including UTC, by using the 'right' timezone files which subtract the leap seconds. Note: this configuration is considered experimental and is known to have issues."
msgstr "Det finns två separata databaser i zoneinfo-systemet, posix och \"right\". \"Right\" (som nu heter zoneinfo-leaps) innehåller skottsekunder och posix gör det inte. För att använda den \"rätta\" databasen måste systemklockan ställas in på (UTC {plus} skottsekunder), vilket motsvarar (TAI - 10). Detta gör det möjligt att beräkna det exakta antalet sekunder mellan två datum som korsar en skottsekundeepok. Systemklockan konverteras sedan till rätt civil tid, inklusive UTC, genom att använda de \"rätta\" tidszonsfilerna som subtraherar skottsekunderna. Observera: denna konfiguration betraktas som experimentell och är känd för att ha problem."

#. from tp:util-linux-man-2.41.2-rc1
msgid "To configure a system to use a particular database all of the files located in its directory must be copied to the root of _/usr/share/zoneinfo_. Files are never used directly from the posix or 'right' subdirectories, e.g., TZ='_right/Europe/Dublin_'. This habit was becoming so common that the upstream zoneinfo project restructured the system's file tree by moving the posix and 'right' subdirectories out of the zoneinfo directory and into sibling directories:"
msgstr "För att konfigurera ett system att använda en viss databas måste alla filer som finns i dess katalog kopieras till roten av _/usr/share/zoneinfo_. Filer används aldrig direkt från posix- eller \"right\"-underkatalogerna, t.ex. TZ='_right/Europe/Dublin_'. Denna vana började bli så vanlig att uppströmsprojektet zoneinfo omstrukturerade systemets filträd genom att flytta posix- och \"höger\"-underkatalogerna från zoneinfo-katalogen till syskonkataloger:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "_/usr/share/zoneinfo_, _/usr/share/zoneinfo-posix_, _/usr/share/zoneinfo-leaps_"
msgstr "_/usr/share/zoneinfo_, _/usr/share/zoneinfo-posix_, _/usr/share/zoneinfo-leaps_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Unfortunately, some Linux distributions are changing it back to the old tree structure in their packages. So the problem of system administrators reaching into the 'right' subdirectory persists. This causes the system timezone to be configured to include leap seconds while the zoneinfo database is still configured to exclude them. Then when an application such as a World Clock needs the South_Pole timezone file; or an email MTA, or *hwclock* needs the UTC timezone file; they fetch it from the root of _/usr/share/zoneinfo_ , because that is what they are supposed to do. Those files exclude leap seconds, but the System Clock now includes them, causing an incorrect time conversion."
msgstr "Tyvärr ändrar vissa Linux-distributioner tillbaka till den gamla trädstrukturen i sina paket. Så problemet med att systemadministratörer hamnar i \"rätt\" underkatalog kvarstår. Detta gör att systemets tidszon konfigureras för att inkludera skottsekunder medan zoneinfo-databasen fortfarande är konfigurerad för att utesluta dem. När sedan en applikation som ett världsklocka behöver tidszonsfilen för South_Pole, eller en e-post-MTA, eller *hwclock* behöver UTC-tidszonsfilen, hämtar de den från roten till _/usr/share/zoneinfo_, eftersom det är vad de ska göra. Dessa filer utesluter skottsekunder, men systemklockan inkluderar dem nu, vilket orsakar en felaktig tidsomvandling."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Attempting to mix and match files from these separate databases will not work, because they each require the System Clock to use a different timescale. The zoneinfo database must be configured to use either posix or 'right', as described above, or by assigning a database path to the _TZDIR_ environment variable."
msgstr "Att försöka blanda och matcha filer från dessa separata databaser kommer inte att fungera, eftersom de kräver att systemklockan använder olika tidsskalor. Zoneinfo-databasen måste konfigureras för att använda antingen posix eller 'right', enligt beskrivningen ovan, eller genom att tilldela en databassökväg till miljövariabeln _TZDIR_."

#. from tp:util-linux-man-2.41.2-rc1
msgid "One of the following exit values will be returned:"
msgstr "Ett av följande utgångsvärden kommer att returneras:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*EXIT_SUCCESS* ('0' on POSIX systems)"
msgstr "*EXIT_SUCCESS* ('0' på POSIX-system)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*EXIT_FAILURE* ('1' on POSIX systems)"
msgstr "*EXIT_FAILURE* ('1' på POSIX-system)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "The operation failed or the command syntax was not valid."
msgstr "Åtgärden misslyckades eller kommandosyntaxen var inte giltig."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*TZ*"
msgstr "*TZ*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "If this variable is set its value takes precedence over the system configured timezone."
msgstr "Om denna variabel är inställd har dess värde företräde framför den systemkonfigurerade tidszonen."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*TZDIR*"
msgstr "*TZDIR*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "If this variable is set its value takes precedence over the system configured timezone database directory path."
msgstr "Om denna variabel är inställd har dess värde företräde framför den systemkonfigurerade sökvägen till tidszonsdatabasen."

#. from tp:util-linux-man-2.41.2-rc1
msgid "_{ADJTIME_PATH}_"
msgstr "_{ADJTIME_PATH}_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "The configuration and state file for *hwclock*. See also *adjtime_config*(5)."
msgstr "Konfigurations- och tillståndsfilen för *hwclock*. Se även *adjtime_config*(5)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "_/etc/localtime_"
msgstr "_/etc/localtime_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "The system timezone file."
msgstr "Filen för systemets tidszon."

#. from tp:util-linux-man-2.41.2-rc1
msgid "_/usr/share/zoneinfo/_"
msgstr "_/usr/share/zoneinfo/_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "The system timezone database directory."
msgstr "Databasens katalog för systemets tidszon."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Device files *hwclock* may try for Hardware Clock access: _/dev/rtc0_ _/dev/rtc_ _/dev/misc/rtc_ _/dev/efirtc_ _/dev/misc/efirtc_"
msgstr "Enhetsfiler *hwclock* kan försöka få åtkomst till Hardware Clock: _/dev/rtc0_ _/dev/rtc_ _/dev/misc/rtc_ _/dev/efirtc_ _/dev/misc/efirtc_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*date*(1), *adjtime_config*(5), *adjtimex*(8), *gettimeofday*(2), *settimeofday*(2), *crontab*(1p), *tzset*(3)"
msgstr "*date*(1), *adjtime_config*(5), *adjtimex*(8), *gettimeofday*(2), *settimeofday*(2), *crontab*(1p), *tzset*(3)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Written by mailto:bryanh@giraffe-data.com[Bryan Henderson], September 1996, based on work done on the *clock*(8) program by Charles Hedrick, Rob Hooft, and Harald Koenig. See the source code for complete history and credits."
msgstr "Skrivet av mailto:bryanh@giraffe-data.com[Bryan Henderson], september 1996, baserat på arbete som utförts på programmet *clock*(8) av Charles Hedrick, Rob Hooft och Harald Koenig. Se källkoden för fullständig historik och krediteringar."

#. from tp:util-linux-man-2.41.2-rc1
msgid "ipcmk(1)"
msgstr "ipcmk(1)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "ipcmk - make various IPC resources"
msgstr "ipcmk - skapa olika IPC-resurser"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*ipcmk* [options]"
msgstr "*ipcmk* [flaggor]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*ipcmk* allows you to create POSIX and System V inter-process communication (IPC) objects: shared memory segments, message queues, and semaphore (arrays for System V)."
msgstr "*med ipcmk* kan du skapa IPC-objekt (inter-process communication) för POSIX och System V: delade minnessegment, meddelandeköer och semaforer (matriser för System V)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Resources can be specified with these options:"
msgstr "Resurser kan specificeras med dessa flaggor:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-M*, *--shmem* _size_"
msgstr "*-M*, *--shmem* _storlek_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Create a shared memory segment of _size_ bytes. The _size_ argument may be followed by the multiplicative suffixes KiB (=1024), MiB (=1024*1024), and so on for GiB, etc. (the \"iB\" is optional, e.g., \"K\" has the same meaning as \"KiB\") or the suffixes KB (=1000), MB (=1000*1000), and so on for GB, etc."
msgstr "Skapa ett delat minnessegment på _storlek_ bytes. Argumentet _storlek_ kan följas av de multiplikativa suffixen KiB (=1024), MiB (=1024*1024), och så vidare för GiB, etc. (\"iB\" är valfritt, t.ex. har \"K\" samma betydelse som \"KiB\") eller suffixen KB (=1000), MB (=1000*1000), och så vidare för GB, etc."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-m*, *--posix-shmem* _size_"
msgstr "*-m*, *--posix-shmem* _storlek_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Create a POSIX shared memory segment of _size_ bytes. The _size_ argument may be followed by the multiplicative suffixes KiB (=1024), MiB (=1024*1024), and so on for GiB, etc. (the \"iB\" is optional, e.g., \"K\" has the same meaning as \"KiB\") or the suffixes KB (=1000), MB (=1000*1000), and so on for GB, etc."
msgstr "Skapa ett POSIX-delat minnessegment på _storlek_ bytes. Argumentet _storlek_ kan följas av de multiplikativa suffixen KiB (=1024), MiB (=1024*1024), och så vidare för GiB, etc. (\"iB\" är valfritt, t.ex. har \"K\" samma betydelse som \"KiB\") eller suffixen KB (=1000), MB (=1000*1000), och så vidare för GB, etc."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-Q*, *--queue*"
msgstr "*-Q*, *--queue*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Create a message queue."
msgstr "Skapa en meddelandekö."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-q*, *--posix-mqueue*"
msgstr "*-q*, *--posix-mqueue*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Create a POSIX message queue."
msgstr "Skapa en POSIX-meddelandekö."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-S*, *--semaphore* _number_"
msgstr "*-S*, *--semaphore* _nummer_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Create a semaphore array with _number_ of elements."
msgstr "Skapa en semaforarray med _antal_ element."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-s*, *--posix-semaphore*"
msgstr "*-s*, *--posix-semaphore*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Create a POSIX named semaphore."
msgstr "Skapa en POSIX-namngiven semafor."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-n*, *--name* _name_"
msgstr "*-n*, *--name* _namn_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Name of the POSIX IPC object. This option is mandatory for POSIX IPC objects."
msgstr "Namn på POSIX IPC-objektet. Denna flagga är obligatoriskt för POSIX IPC-objekt."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Other options are:"
msgstr "Andra flaggor är:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-p*, *--mode* _mode_"
msgstr "*-p*, *--mode* _läge_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Access permissions for the resource. Default is 0644."
msgstr "Åtkomstbehörighet för resursen. Standardvärdet är 0644."

#. from tp:util-linux-man-2.41.2-rc1
msgid "mailto:hayden.james@gmail.com[Hayden A. James], mailto:paithankarprasanna@gmail.com[Prasanna Paithankar]"
msgstr "mailto:hayden.james@gmail.com[Hayden A. James], mailto:paithankarprasanna@gmail.com[Prasanna Paithankar]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*ipcrm*(1), *ipcs*(1), *lsipc*(1), *sysvipc*(7)"
msgstr "*ipcrm*(1), *ipcs*(1), *lsipc*(1), *sysvipc*(7)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "ipcrm(1)"
msgstr "ipcrm(1)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "ipcrm - remove certain IPC resources"
msgstr "ipcrm - ta bort vissa IPC-resurser"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*ipcrm* [options]"
msgstr "*ipcrm* [flaggor]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*ipcrm* [*shm*|*msg*|*sem*] _ID_ ..."
msgstr "*ipcrm* [*shm*|*msg*|*sem*] _ID_ ..."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*ipcrm* removes POSIX and System V inter-process communication (IPC) objects and associated data structures from the system. In order to delete such objects, you must be superuser, or the creator or owner of the object."
msgstr "*ipcrm* tar bort POSIX- och System V-objekt för interprocesskommunikation (IPC) och tillhörande datastrukturer från systemet. För att kunna ta bort sådana objekt måste du vara superuser eller skapare eller ägare av objektet."

#. from tp:util-linux-man-2.41.2-rc1
msgid "POSIX and System V IPC objects are of three types: shared memory, message queues, and semaphores. Deletion of a message queue or semaphore object is immediate (regardless of whether any process still holds an IPC identifier for the object). A shared memory object is only removed after all currently attached processes have detached (*shmdt*(2)) the object from their virtual address space."
msgstr "POSIX och System V IPC-objekt är av tre typer: delat minne, meddelandeköer och semaforer. Borttagning av en meddelandekö eller ett semaforobjekt sker omedelbart (oavsett om någon process fortfarande har en IPC-identifierare för objektet). Ett objekt med delat minne tas bort först när alla processer som för närvarande är anslutna till objektet har avlägsnat det (*shmdt*(2)) från sitt virtuella adressutrymme."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Two syntax styles are supported. The old Linux historical syntax specifies a three-letter keyword indicating which class of object is to be deleted, followed by one or more IPC identifiers for objects of this type."
msgstr "Två syntaxstilar stöds. Den gamla historiska Linux-syntaxen anger ett nyckelord med tre bokstäver som anger vilken klass av objekt som ska raderas, följt av en eller flera IPC-identifierare för objekt av denna typ."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The SUS-compliant syntax allows the specification of zero or more objects of all three types in a single command line, with objects specified either by key or by identifier (see below). Both keys and identifiers may be specified in decimal, hexadecimal (specified with an initial '0x' or '0X'), or octal (specified with an initial '0')."
msgstr "Den SUS-kompatibla syntaxen gör det möjligt att specificera noll eller flera objekt av alla tre typerna på en enda kommandorad, där objekten specificeras antingen med nyckel eller med identifierare (se nedan). Både nycklar och identifierare kan anges i decimal, hexadecimal (anges med en inledande '0x' eller '0X') eller oktal (anges med en inledande '0')."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The details of the removes are described in *shmctl*(2), *shm_unlink*(3), *msgctl*(2), *mq_unlink*(3), *semctl*(2), and *sem_unlink*(3). The identifiers and keys can be found by using *lsipc*(1) or *ipcs*(1)."
msgstr "Detaljerna för avlägsnandet beskrivs i *shmctl*(2), *shm_unlink*(3), *msgctl*(2), *mq_unlink*(3), *semctl*(2) och *sem_unlink*(3). Identifierarna och nycklarna kan hittas med hjälp av *lsipc*(1) eller *ipcs*(1)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-a*, *--all* [*shm*] [*pshm*] [*msg*] [*pmsg*] [*sem*] [*psem*]"
msgstr "*-a*, *--all* [*shm*] [*pshm*] [*msg*] [*pmsg*] [*sem*] [*psem*]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Remove all resources. When an option argument is provided, the removal is performed only for the specified resource types."
msgstr "Ta bort alla resurser. Om ett option-argument anges utförs borttagningen endast för de angivna resurstyperna."

#. from tp:util-linux-man-2.41.2-rc1
msgid "_Warning!_ Do not use *-a* if you are unsure how the software using the resources might react to missing objects. Some programs create these resources at startup and may not have any code to deal with an unexpected disappearance."
msgstr "_Varning!_ Använd inte *-a* om du är osäker på hur programvaran som använder resurserna kan reagera på saknade objekt. Vissa program skapar dessa resurser vid uppstart och kanske inte har någon kod för att hantera ett oväntat försvinnande."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-M*, *--shmem-key* _shmkey_"
msgstr "*-M*, *--shmem-key* _shmkey_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Remove the shared memory segment created with _shmkey_ after the last detach is performed."
msgstr "Ta bort det delade minnessegmentet som skapats med _shmkey_ efter att den sista borttagningen har utförts."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-m*, *--shmem-id* _shmid_"
msgstr "*-m*, *--shmem-id* _shmid_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Remove the shared memory segment identified by _shmid_ after the last detach is performed."
msgstr "Ta bort det delade minnessegmentet som identifieras av _shmid_ efter att den sista borttagningen har utförts."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--posix-shmem* _name_"
msgstr "*--posix-shmem* _namn_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Remove the POSIX shared memory segment created with _name_."
msgstr "Ta bort det POSIX-delade minnessegmentet som skapades med _namn_."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-Q*, *--queue-key* _msgkey_"
msgstr "*-Q*, *--queue-key* _msgkey_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Remove the message queue created with _msgkey_."
msgstr "Ta bort den meddelandekö som skapats med _msgkey_."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-q*, *--queue-id* _msgid_"
msgstr "*-q*, *--queue-id* _msgid_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Remove the message queue identified by _msgid_."
msgstr "Ta bort den meddelandekö som identifieras av _msgid_."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--posix-mqueue* _name_"
msgstr "*--posix-mqueue* _namn_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Remove the POSIX message queue created with _name_."
msgstr "Ta bort POSIX-meddelandekön som skapats med _namn_."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-S*, *--semaphore-key* _semkey_"
msgstr "*-S*, *--semaphore-key* _semkey_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Remove the semaphore created with _semkey_."
msgstr "Ta bort semaforen som skapats med _semkey_."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-s*, *--semaphore-id* _semid_"
msgstr "*-s*, *--semaphore-id* _semid_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Remove the semaphore identified by _semid_."
msgstr "Ta bort semaforen som identifieras av _semid_."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--posix-semaphore* _name_"
msgstr "*--posix-semaphore* _namn_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Remove the POSIX named semaphore created with _name_."
msgstr "Ta bort den POSIX-namngivna semaforen som skapats med _namn_."

#. from tp:util-linux-man-2.41.2-rc1
msgid "In its first Linux implementation, *ipcrm* used the deprecated syntax shown in the second line of the *SYNOPSIS*. Functionality present in other {asterisk}nix implementations of *ipcrm* has since been added, namely the ability to delete resources by key (not just identifier), and to respect the same command-line syntax. For backward compatibility the previous syntax is still supported."
msgstr "I sin första Linux-implementation använde *ipcrm* den föråldrade syntax som visas på andra raden i *SYNOPSIS*. Funktionalitet som finns i andra {asterisk}nix-implementationer av *ipcrm* har sedan dess lagts till, nämligen möjligheten att ta bort resurser med nyckel (inte bara identifierare) och att respektera samma kommandoradssyntax. För bakåtkompatibilitet stöds fortfarande den tidigare syntaxen."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*ipcmk*(1), *ipcs*(1), *lsipc*(1), *msgctl*(2), *mq_unlink*(3), *msgget*(2), *semctl*(2), *semget*(2), *sem_unlink*(3), *shmctl*(2), *shmdt*(2), *shmget*(2), *shm_unlink*(3), *ftok*(3), *sysvipc*(7)"
msgstr "*ipcmk*(1), *ipcs*(1), *lsipc*(1), *msgctl*(2), *mq_unlink*(3), *msgget*(2), *semctl*(2), *semget*(2), *sem_unlink*(3), *shmctl*(2), *shmdt*(2), *shmget*(2), *shm_unlink*(3), *ftok*(3), *sysvipc*(7)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "ipcs(1)"
msgstr "ipcs(1)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "ipcs - show information on IPC facilities"
msgstr "ipcs - visa information om IPC-faciliteter"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*ipcs* [options]"
msgstr "*ipcs* [flaggor]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*ipcs* shows information on System V inter-process communication facilities. By default it shows information about all three resources: shared memory segments, message queues, and semaphore arrays."
msgstr "*ipcs* visar information om System V:s faciliteter för kommunikation mellan processer. Som standard visas information om alla tre resurserna: delade minnessegment, meddelandeköer och semaforarrayer."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-i*, *--id* _id_"
msgstr "*-i*, *--id* _id_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Show full details on just the one resource element identified by _id_. This option needs to be combined with one of the three resource options: *-m*, *-q* or *-s*."
msgstr "Visa fullständig information om endast det resurselement som identifieras av _id_. Denna flagga måste kombineras med en av de tre resursflaggorna: *-m*, *-q* eller *-s*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Resource options"
msgstr "Resursflaggor"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-m*, *--shmems*"
msgstr "*-m*, *--shmems*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Write information about active shared memory segments."
msgstr "Skriv information om aktiva delade minnessegment."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-q*, *--queues*"
msgstr "*-q*, *--queues*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Write information about active message queues."
msgstr "Skriv information om aktiva meddelandeköer."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-s*, *--semaphores*"
msgstr "*-s*, *--semaphores*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Write information about active semaphore sets."
msgstr "Skriv information om aktiva semaforuppsättningar."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Write information about all three resources (default)."
msgstr "Skriv information om alla tre resurserna (standard)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Output formats"
msgstr "Utmatningsformat"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Of these options only one takes effect: the last one specified."
msgstr "Av dessa flaggor är det bara ett som gäller: det sist angivna."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-c*, *--creator*"
msgstr "*-c*, *--creator*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Show creator and owner."
msgstr "Showens skapare och ägare."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-l*, *--limits*"
msgstr "*-l*, *--limits*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Show resource limits."
msgstr "Visa resursbegränsningar."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Show PIDs of creator and last operator."
msgstr "Visa PID för skaparen och den senaste operatören."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Write time information. The time of the last control operation that changed the access permissions for all facilities, the time of the last *msgsnd*(2) and *msgrcv*(2) operations on message queues, the time of the last *shmat*(2) and *shmdt*(2) operations on shared memory, and the time of the last *semop*(2) operation on semaphores."
msgstr "Information om skrivtid. Tidpunkten för den senaste kontrollåtgärden som ändrade åtkomstbehörigheterna för alla faciliteter, tidpunkten för de senaste *msgsnd*(2) och *msgrcv*(2) åtgärderna på meddelandeköer, tidpunkten för de senaste *shmat*(2) och *shmdt*(2) åtgärderna på delat minne och tidpunkten för den senaste *semop*(2) åtgärden på semaforer."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-u*, *--summary*"
msgstr "*-u*, *--summary*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Show status summary."
msgstr "Visa statusöversikt."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Representation"
msgstr "Representation"

#. from tp:util-linux-man-2.41.2-rc1
msgid "These affect only the *-l* (*--limits*) option."
msgstr "Dessa påverkar endast flaggan *-l* (*--limits*)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--human*"
msgstr "*--human*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Print sizes in human-readable format."
msgstr "Skriv ut storlekar i ett läsbart format."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The Linux *ipcs* utility is not fully compatible to the POSIX *ipcs* utility. The Linux version does not support the POSIX *-a*, *-b* and *-o* options, but does support the *-l* and *-u* options not defined by POSIX. A portable application shall not use the *-a*, *-b*, *-o*, *-l*, and *-u* options."
msgstr "Linux *ipcs*-verktyget är inte helt kompatibelt med POSIX *ipcs*-verktyget. Linux-versionen stöder inte POSIX-flaggorna *-a*, *-b* och *-o*, men stöder flaggorna *-l* och *-u* som inte definieras av POSIX. En portabel applikation skall inte använda flaggorna *-a*, *-b*, *-o*, *-l* och *-u*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The current implementation of *ipcs* obtains information about available IPC resources by parsing the files in _/proc/sysvipc_. Before util-linux version v2.23, an alternate mechanism was used: the *IPC_STAT* command of *msgctl*(2), *semctl*(2), and *shmctl*(2). This mechanism is also used in later util-linux versions in the case where _/proc_ is unavailable. A limitation of the *IPC_STAT* mechanism is that it can only be used to retrieve information about IPC resources for which the user has read permission."
msgstr "Den aktuella implementeringen av *ipcs* hämtar information om tillgängliga IPC-resurser genom att analysera filerna i _/proc/sysvipc_. Före util-linux version v2.23 användes en alternativ mekanism: kommandot *IPC_STAT* i *msgctl*(2), *semctl*(2) och *shmctl*(2). Denna mekanism används också i senare util-linux-versioner i de fall _/proc_ inte är tillgängligt. En begränsning med *IPC_STAT*-mekanismen är att den endast kan användas för att hämta information om IPC-resurser som användaren har läsbehörighet för."

#. from tp:util-linux-man-2.41.2-rc1
msgid "mailto:balasub@cis.ohio-state.edu[Krishna Balasubramanian]"
msgstr "mailto:balasub@cis.ohio-state.edu[Krishna Balasubramanian]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*ipcmk*(1), *ipcrm*(1), *msgrcv*(2), *msgsnd*(2), *semget*(2), *semop*(2), *shmat*(2), *shmdt*(2), *shmget*(2), *sysvipc*(7)"
msgstr "*ipcmk*(1), *ipcrm*(1), *msgrcv*(2), *msgsnd*(2), *semget*(2), *semop*(2), *shmat*(2), *shmdt*(2), *shmget*(2), *sysvipc*(7)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "irqtop(1)"
msgstr "irqtop(1)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "irqtop - utility to display kernel interrupt information"
msgstr "irqtop - verktyg för att visa information om avbrott i kärnan"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*irqtop* [options]"
msgstr "*irqtop* [flaggor]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Display kernel interrupt counter information in *top*(1) style view."
msgstr "Visa information om kärnans avbrottsräknare i en *top*(1)-vy."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The default output is subject to change. So whenever possible, you should avoid using default outputs in your scripts. Always explicitly define expected columns by using *--output*."
msgstr "Standardutdata kan komma att ändras. Så när det är möjligt bör du undvika att använda standardutdata i dina skript. Definiera alltid förväntade kolumner explicit genom att använda *--output*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Specify which output columns to print. Use *--help* to get a list of all supported columns. The default list of columns may be extended if list is specified in the format _+list_."
msgstr "Ange vilka utdatakolumner som ska skrivas ut. Använd *--help* för att få en lista över alla kolumner som stöds. Standardlistan med kolumner kan utökas om list anges i formatet _+list_."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-c*, *--cpu-stat* _mode_"
msgstr "*-c*, *--cpu-stat* _läge_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Show per-cpu statistics by specified mode. Available modes are: *auto*, *enable*, *disable*. The default option *auto* detects the width of window, then shows the per-cpu statistics if the width of window is large enough to show a full line of statistics."
msgstr "Visa statistik per processor i angivet läge. Tillgängliga lägen är: *auto*, *aktivera*, *inaktivera*. Standardflaggan *auto* känner av fönstrets bredd och visar sedan statistik per processor om fönstrets bredd är tillräckligt stor för att visa en hel rad med statistik."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-C*, *--cpu-list* _list_"
msgstr "*-C*, *--cpu-list* _lista_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Specify cpus in list format to show."
msgstr "Ange vilka cpusar som ska visas i listformat."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-d*, *--delay* _seconds_"
msgstr "*-d*, *--delay* _seconds_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Update interrupt output every _seconds_ intervals."
msgstr "Uppdatera avbrottsutgången med _sekunders_ intervall."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-s*, *--sort* _column_"
msgstr "*-s*, *--sort* _column_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Specify sort criteria by column name. See *--help* output to get column names. The sort criteria may be changes in interactive mode."
msgstr "Ange sorteringskriterier efter kolumnnamn. Se *--help*-utdata för att få kolumnnamn. Sorteringskriterierna kan ändras i interaktivt läge."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-S*, *--softirq*"
msgstr "*-S*, *--softirq*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Show softirqs information."
msgstr "Visa softirqs-information."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-t*, *--threshold* _min_"
msgstr "*-t*, *--threshold* _min_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Only show IRQs with counters above the specified threshold. Human readable values are supported (e.g. 1.2K)."
msgstr "Visa endast IRQ:er med räknare över det angivna tröskelvärdet. Värden som kan läsas av människor stöds (t.ex. 1,2K)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "INTERACTIVE MODE KEY COMMANDS"
msgstr "NYCKELKOMMANDON FÖR INTERAKTIVT LÄGE"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*i*"
msgstr "*i*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "sort by short irq name or number field"
msgstr "sortera efter kort irq-namn eller nummerfält"

#. from tp:util-linux-man-2.41.2-rc1
msgid "sort by total count of interrupts (the default)"
msgstr "sortera efter totalt antal avbrott (standard)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "sort by delta count of interrupts"
msgstr "sortera efter deltaantal av avbrott"

#. from tp:util-linux-man-2.41.2-rc1
msgid "sort by long descriptive name field"
msgstr "sortera efter långt beskrivande namnfält"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*q Q*"
msgstr "*q Q*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "stop updates and exit program"
msgstr "stoppa uppdateringar och avsluta programmet"

#. from tp:util-linux-man-2.41.2-rc1
msgid "mailto:pizhenwei@bytedance.com[Zhenwei Pi], mailto:kerolasa@iki.fi[Sami Kerola], mailto:kzak@redhat.com[Karel Zak] mailto:robin@jarry.cc[Robin Jarry]"
msgstr "mailto:pizhenwei@bytedance.com[Zhenwei Pi], mailto:kerolasa@iki.fi[Sami Kerola], mailto:kzak@redhat.com[Karel Zak] mailto:robin@jarry.cc[Robin Jarry]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "ldattach(8)"
msgstr "ldattach(8)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "ldattach - attach a line discipline to a serial line"
msgstr "ldattach - koppla en linjedisciplin till en seriell linje"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*ldattach* [*-1278denoVh*] [*-i* _iflag_] [*-s* _speed_] _ldisc device_"
msgstr "*ldattach* [*-1278denoVh*] [*-i* _iflag_] [*-s* _hastighet_] _ldisc device_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "The *ldattach* daemon opens the specified _device_ file (which should refer to a serial device) and attaches the line discipline _ldisc_ to it for processing of the sent and/or received data. It then goes into the background keeping the device open so that the line discipline stays loaded."
msgstr "Daemon *ldattach* öppnar den angivna filen _enhet_ (som bör referera till en seriell enhet) och kopplar linjedisciplinen _ldisc_ till den för bearbetning av skickade och/eller mottagna data. Den går sedan in i bakgrunden och håller enheten öppen så att linjedisciplinen förblir laddad."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The line discipline _ldisc_ may be specified either by name or by number."
msgstr "Linjedisciplinen _ldisc_ kan anges antingen med namn eller med nummer."

#. from tp:util-linux-man-2.41.2-rc1
msgid "In order to detach the line discipline, *kill*(1) the *ldattach* process."
msgstr "För att koppla bort linjedisciplinen, *kill*(1) *ldattach*-processen."

#. from tp:util-linux-man-2.41.2-rc1
msgid "With no arguments, *ldattach* prints usage information."
msgstr "Utan argument skriver *ldattach* ut användningsinformation."

#. from tp:util-linux-man-2.41.2-rc1
msgid "LINE DISCIPLINES"
msgstr "LINJEDISCIPLINER"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Depending on the kernel release, the following line disciplines are supported:"
msgstr "Beroende på kernelversionen stöds följande linjediscipliner:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*TTY*(*0*)"
msgstr "*TTY*(*0*)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "The default line discipline, providing transparent operation (raw mode) as well as the habitual terminal line editing capabilities (cooked mode)."
msgstr "Den förinställda linjedisciplinen ger transparent drift (raw mode) samt terminalens vanliga möjligheter att redigera linjer (cooked mode)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*SLIP*(*1*)"
msgstr "*SLIP*(*1*)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Serial Line IP (SLIP) protocol processor for transmitting TCP/IP packets over serial lines."
msgstr "SLIP-protokollprocessor (Serial Line IP) för överföring av TCP/IP-paket över seriella linjer."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*MOUSE*(*2*)"
msgstr "*MOUSE*(*2*)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Device driver for RS232 connected pointing devices (serial mice)."
msgstr "Drivrutin för RS232-anslutna pekdon (seriemöss)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*PPP*(*3*)"
msgstr "*PPP*(*3*)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Point to Point Protocol (PPP) processor for transmitting network packets over serial lines."
msgstr "PPP-processor (Point to Point Protocol) för överföring av nätverkspaket över seriella linjer."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*STRIP*(*4*); *AX25*(*5*); *X25*(*6*)"
msgstr "*BAND*(*4*); *AX25*(*5*); *X25*(*6*)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Line driver for transmitting X.25 packets over asynchronous serial lines."
msgstr "Linjedrivrutin för överföring av X.25-paket över asynkrona seriella linjer."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*6PACK*(*7*); *R3964*(*9*)"
msgstr "*6PACK*(*7*); *R3964*(*9*)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Driver for Simatic R3964 module."
msgstr "Drivrutin för Simatic R3964-modul."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*IRDA*(*11*)"
msgstr "*IRDA*(*11*)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Linux IrDa (infrared data transmission) driver - see http://irda.sourceforge.net/"
msgstr "Linux IrDa-drivrutin (infraröd dataöverföring) - se http://irda.sourceforge.net/"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*HDLC*(*13*)"
msgstr "*HDLC*(*13*)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Synchronous HDLC driver."
msgstr "Synkron HDLC-drivrutin."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*SYNC_PPP*(*14*)"
msgstr "*SYNC_PPP*(*14*)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Synchronous PPP driver."
msgstr "Synkron PPP-drivrutin."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*HCI*(*15*)"
msgstr "*HCI*(*15*)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Bluetooth HCI UART driver."
msgstr "Bluetooth HCI UART-drivrutin."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*GIGASET_M101*(*16*)"
msgstr "*GIGASET_M101*(*16*)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Driver for Siemens Gigaset M101 serial DECT adapter."
msgstr "Drivrutin för Siemens Gigaset M101 seriell DECT-adapter."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*PPS*(*18*)"
msgstr "*PPS*(*18*)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Driver for serial line Pulse Per Second (PPS) source."
msgstr "Drivrutin för PPS-källa (Pulse Per Second) för seriell linje."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*GSM0710*(*21*)"
msgstr "*GSM0710*(*21*)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Driver for GSM 07.10 multiplexing protocol modem (CMUX)."
msgstr "Drivrutin för GSM 07.10 multiplexing protocol modem (CMUX)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-1*, *--onestopbit*"
msgstr "*-1*, *--onestopbit*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Set the number of stop bits of the serial line to one."
msgstr "Ställ in antalet stoppbitar för den seriella linjen till ett."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-2*, *--twostopbits*"
msgstr "*-2*, *--twostopbits*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Set the number of stop bits of the serial line to two."
msgstr "Ställ in antalet stoppbitar för den seriella linjen till två."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-7*, *--sevenbits*"
msgstr "*-7*, *--sevenbits*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Set the character size of the serial line to 7 bits."
msgstr "Ställ in teckenstorleken för den seriella linjen till 7 bitar."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-8*, *--eightbits*"
msgstr "*-8*, *--eightbits*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Set the character size of the serial line to 8 bits."
msgstr "Ställ in teckenstorleken för den seriella linjen till 8 bitar."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Keep *ldattach* in the foreground so that it can be interrupted or debugged, and to print verbose messages about its progress to standard error output."
msgstr "Håll *ldattach* i förgrunden så att den kan avbrytas eller felsökas och för att skriva ut utförliga meddelanden om hur den fortskrider till standardfelutmatningen."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-e*, *--evenparity*"
msgstr "*-e*, *--evenparity*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Set the parity of the serial line to even."
msgstr "Ställ in pariteten på den seriella linjen till jämn."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-i*, *--iflag* [*-*]_value_..."
msgstr "*-i*, *--iflag* [*-*]_värde_..."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Set the specified bits in the c_iflag word of the serial line. The given _value_ may be a number or a symbolic name. If _value_ is prefixed by a minus sign, the specified bits are cleared instead. Several comma-separated values may be given in order to set and clear multiple bits."
msgstr "Ställer in de angivna bitarna i c_iflag-ordet på den seriella linjen. Det angivna _värdet_ kan vara ett tal eller ett symboliskt namn. Om _värde_ föregås av ett minustecken rensas de angivna bitarna istället. Flera kommaseparerade värden kan anges för att ställa in och rensa flera bitar."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-n*, *--noparity*"
msgstr "*-n*, *--noparity*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Set the parity of the serial line to none."
msgstr "Ställ in pariteten för den seriella linjen till none."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-o*, *--oddparity*"
msgstr "*-o*, *--oddparity*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Set the parity of the serial line to odd."
msgstr "Ställ in pariteten på den seriella linjen till udda."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-s*, *--speed* _value_"
msgstr "*-s*, *--speed* _värde_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Set the speed (the baud rate) of the serial line to the specified _value_."
msgstr "Ställ in hastigheten (baudhastigheten) för den seriella linjen till det angivna _värdet_."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-c*, *--intro-command* _string_"
msgstr "*-c*, *--intro-command* _sträng_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Define an intro command that is sent through the serial line before the invocation of *ldattach*. E.g. in conjunction with line discipline GSM0710, the command 'AT+CMUX=0\\r' is commonly suitable to switch the modem into the CMUX mode."
msgstr "Definiera ett introkommando som skickas via den seriella linjen innan *ldattach* anropas. T.ex. i samband med linjedisciplin GSM0710 är kommandot 'AT+CMUX=0\\r' vanligtvis lämpligt för att växla modemet till CMUX-läge."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-p*, *--pause* _value_"
msgstr "*-p*, *--pause* _värde_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Sleep for _value_ seconds before the invocation of *ldattach*. Default is one second."
msgstr "Sömn i _värde_ sekunder före anropet av *ldattach*. Standard är en sekund."

#. from tp:util-linux-man-2.41.2-rc1
msgid "mailto:tilman@imap.cc[Tilman Schmidt]"
msgstr "mailto:tilman@imap.cc[Tilman Schmidt]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*inputattach*(1), *ttys*(4)"
msgstr "*inputattach*(1), *ttys*(4)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "losetup(8)"
msgstr "losetup(8)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "losetup - set up and control loop devices"
msgstr "losetup - ställa in och styra loop-enheter"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Get info:"
msgstr "Hämta information:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*losetup* [_loopdev_]"
msgstr "*losetup* [_loopdev_]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*losetup* *-l* [*-a*]"
msgstr "*losetup* *-l* [*-a*]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*losetup* *-j* _file_ [*-o* _offset_]"
msgstr "*losetup* *-j* _fil_ [*-o* _offset_]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Detach a loop device:"
msgstr "Koppla loss en loop-enhet:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*losetup* *-d* _loopdev_ ..."
msgstr "*losetup* *-d* _loopdev_ ..."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Detach all associated loop devices:"
msgstr "Koppla bort alla associerade loop-enheter:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*losetup* *-D*"
msgstr "*losetup* *-D*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Set up a loop device:"
msgstr "Ställ in en loop-enhet:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*losetup* [*-o* _offset_] [*--sizelimit* _size_] [*--sector-size* _size_] [*--loop-ref* _name_] [*-Pr*] [*--show*] *-f*|_loopdev file_"
msgstr "*losetup* [*-o* _offset_] [*--sizelimit* _storlek_] [*--sector-size* _storlek_] [*--loop-ref* _namn_] [*-Pr*] [*--show*] *-f*|_loopdev file_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Resize a loop device:"
msgstr "Ändra storlek på en loop-enhet:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*losetup* *-c* _loopdev_"
msgstr "*losetup* *-c* _loopdev_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*losetup* is used to associate loop devices with regular files or block devices, to detach loop devices, and to query the status of a loop device. If only the _loopdev_ argument is given, the status of the corresponding loop device is shown. If no option is given, all loop devices are shown."
msgstr "*losetup* används för att associera loop-enheter med vanliga filer eller blockenheter, för att koppla bort loop-enheter och för att fråga om status för en loop-enhet. Om endast argumentet _loopdev_ anges visas statusen för motsvarande loop-enhet. Om ingen flagga anges visas alla loop-enheter."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Note that the old output format (i.e., *losetup -a*) with comma-delimited strings is deprecated in favour of the *--list* output format."
msgstr "Observera att det gamla utmatningsformatet (dvs. *losetup -a*) med kommaseparerade strängar inte längre används till förmån för utmatningsformatet *--list*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "It's possible to create more independent loop devices for the same backing file. *This setup may be dangerous, can cause data loss, corruption and overwrites.* Use *--nooverlap* with *--find* during setup to avoid this problem."
msgstr "Det är möjligt att skapa fler oberoende loop-enheter för samma backing-fil. *Denna inställning kan vara farlig och kan orsaka dataförlust, korruption och överskrivningar.* Använd *--nooverlap* med *--find* under installationen för att undvika detta problem."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The loop device setup is not an atomic operation when used with *--find*, and *losetup* does not protect this operation by any lock. The number of attempts is internally restricted to a maximum of 16. It is recommended to use for example *flock*(1) to avoid a collision in heavily parallel use cases."
msgstr "Loop device setup är inte en atomär operation när den används med *--find*, och *losetup* skyddar inte denna operation med något lås. Antalet försök är internt begränsat till maximalt 16. Vi rekommenderar att du använder t.ex. *flock*(1) för att undvika kollisioner i mycket parallella användningsfall."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The _size_ and _offset_ arguments may be followed by the multiplicative suffixes KiB (=1024), MiB (=1024*1024), and so on for GiB, TiB, PiB, EiB, ZiB and YiB (the \"iB\" is optional, e.g., \"K\" has the same meaning as \"KiB\") or the suffixes KB (=1000), MB (=1000*1000), and so on for GB, TB, PB, EB, ZB and YB."
msgstr "Argumenten _storlek_ och _offset_ kan följas av de multiplikativa suffixen KiB (=1024), MiB (=1024*1024), och så vidare för GiB, TiB, PiB, EiB, ZiB och YiB (iB är valfritt, t.ex. har \"K\" samma betydelse som \"KiB\") eller suffixen KB (=1000), MB (=1000*1000), och så vidare för GB, TB, PB, EB, ZB och YB."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Show the status of all loop devices. Note that not all information is accessible for non-root users. See also *--list*. The old output format (as printed without *--list*) is deprecated."
msgstr "Visa status för alla loop-enheter. Observera att all information inte är tillgänglig för användare som inte är root. Se även *--list*. Det gamla utdataformatet (som skrivs ut utan *--list*) är föråldrat."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-d*, *--detach* _loopdev_..."
msgstr "*-d*, *--detach* _loopdev_..."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Detach the file or device associated with the specified loop device(s). Note that since Linux v3.7 kernel uses \"lazy device destruction\". The detach operation does not return *EBUSY* error anymore if device is actively used by system, but it is marked by autoclear flag and destroyed later. Even if the device is not used, the loop device can be destroyed later. If you need to wait for a complete removal of the loop device, call *udevadm settle* after *losetup*."
msgstr "Avlägsna filen eller enheten som är associerad med den eller de angivna loop-enheterna. Observera att sedan Linux v3.7 använder kärnan \"lazy device destruction\". Detach-operationen returnerar inte *EBUSY*-felet längre om enheten används aktivt av systemet, men den är markerad med autoclear-flaggan och förstörs senare. Även om enheten inte används kan loop-enheten förstöras senare. Om du behöver vänta på att loopenheten ska tas bort helt och hållet, anropar du *udevadm settle* efter *losetup*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-D*, *--detach-all*"
msgstr "*-D*, *--detach-all*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Detach all associated loop devices."
msgstr "Koppla bort alla tillhörande loop-enheter."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-f*, *--find* [_file_]"
msgstr "*-f*, *--find* [_fil_]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Find the first unused loop device. If a _file_ argument is present, use the found device as loop device. Otherwise, just print its name."
msgstr "Hitta den första oanvända loop-enheten. Om ett _fil_-argument finns, använd den funna enheten som loop-enhet. Annars skrivs bara dess namn ut."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--show*"
msgstr "*--show*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Display the name of the assigned loop device if the *-f* option and a _file_ argument are present."
msgstr "Visa namnet på den tilldelade loop-enheten om flaggan *-f* och ett _fil_-argument finns."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-L*, *--nooverlap*"
msgstr "*-L*, *--nooverlap*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Check for conflicts between loop devices to avoid situation when the same backing file is shared between more loop devices. If the file is already used by another device then re-use the device rather than a new one. The option makes sense only with *--find*."
msgstr "Kontrollera om det finns konflikter mellan loop-enheter för att undvika situationer där samma backingfil delas av flera loop-enheter. Om filen redan används av en annan enhet, återanvänd då enheten i stället för att skapa en ny. Flaggan är endast meningsfullt med *--find*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-j*, *--associated* _file_ [*-o* _offset_]"
msgstr "*-j*, *--associated* _fil_ [*-o* _offset_]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Show the status of all loop devices associated with the given _file_."
msgstr "Visar status för alla loop-enheter som är kopplade till den angivna _filen_."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The data start is moved _offset_ bytes into the specified file or device. The _offset_ may be followed by the multiplicative suffixes; see above."
msgstr "Datastarten flyttas _offset_ byte in i den angivna filen eller enheten. _offset_ kan följas av de multiplikativa suffixen, se ovan."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--loop-ref* _string_"
msgstr "*--loop-ref* _sträng_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Set reference string. The backwardly compatible default is to use the backing filename as a reference in loop setup ioctl (aka lo_file_name). This option can overwrite this default behavior and set the reference to the _string_. The reference may be used by udevd in /dev/loop/by-ref. Linux kernel does not use the reference at all, but it could be used by some old utils that cannot read the backing file from sysfs. The reference is readable only for the root user (see *--output* +REF) and it is restricted to 64 bytes."
msgstr "Ange referenssträng. Den bakåtkompatibla standardinställningen är att använda backingfilnamnet som referens i loop setup ioctl (aka lo_fil_name). Denna flagga kan skriva över detta standardbeteende och ställa in referensen till _strängen_. Referensen kan användas av udevd i /dev/loop/by-ref. Linuxkärnan använder inte referensen alls, men den kan användas av vissa gamla verktyg som inte kan läsa stödfilen från sysfs. Referensen är endast läsbar för root-användaren (se *--output* +REF) och den är begränsad till 64 byte."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--sizelimit* _size_"
msgstr "*--sizelimit* _storlek_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "The data end is set to no more than _size_ bytes after the data start. The _size_ may be followed by the multiplicative suffixes; see above."
msgstr "Dataslutet sätts till högst _storlek_ bytes efter datastarten. _storlek_ kan följas av de multiplikativa suffixen, se ovan."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-b*, *--sector-size* _size_"
msgstr "*-b*, *--sector-size* _storlek_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Set the logical sector size of the loop device in bytes (since Linux 4.14). The option may be used when creating a new loop device as well as a stand-alone command to modify sector size of the already existing loop device."
msgstr "Ange den logiska sektorstorleken för loop-enheten i byte (sedan Linux 4.14). Flaggan kan användas när du skapar en ny loop-enhet samt som ett fristående kommando för att ändra sektorstorleken på en redan befintlig loop-enhet."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-c*, *--set-capacity* _loopdev_"
msgstr "*-c*, *--set-capacity* _loopdev_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Force the loop driver to reread the size of the file associated with the specified loop device."
msgstr "Tvinga loopdrivrutinen att läsa om storleken på filen som är associerad med den angivna loopenheten."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-P*, *--partscan*"
msgstr "*-P*, *--partscan*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Force the kernel to scan the partition table on a newly created loop device. Note that the partition table parsing depends on sector sizes. The default is sector size is 512 bytes, otherwise you need to use the option *--sector-size* together with *--partscan*."
msgstr "Tvinga kärnan att skanna partitionstabellen på en nyskapad loop-enhet. Observera att tolkningen av partitionstabellen beror på sektorstorleken. Standard är att sektorstorleken är 512 byte, annars måste du använda flaggan *--sector-size* tillsammans med *--partscan*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Set up a read-only loop device."
msgstr "Ställ in en skrivskyddad loop-enhet."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--direct-io*[**=on**|*off*]"
msgstr "*--direct-io*[**=on**|*off*]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Enable or disable direct I/O for the backing file. The default is *off*. Specifying either *--direct-io* or *--direct-io=on* will enable it. But, *--direct-io=off* can be provided to explicitly turn it off."
msgstr "Aktivera eller inaktivera direkt I/O för stödfilen. Standardinställningen är *off*. Om du anger antingen *--direct-io* eller *--direct-io=on* aktiveras det. Men *--direct-io=off* kan anges för att uttryckligen stänga av det."

#. from tp:util-linux-man-2.41.2-rc1
msgid "If a loop device or the *-a* option is specified, print the default columns for either the specified loop device or all loop devices; the default is to print info about all devices. See also *--output*, *--noheadings*, *--raw*, and *--json*."
msgstr "Om en slingenhet eller flaggan *-a* anges, skriv ut standardkolumnerna för antingen den angivna slingenheten eller alla slingenheter; standard är att skriva ut information om alla enheter. Se även *--output*, *--noheadings*, *--raw* och *--json*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-O*, *--output* _column_[,_column_]..."
msgstr "*-O*, *--output* _column_[,_column_]..."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Specify the columns that are to be printed for the *--list* output. Use *--help* to get a list of all supported columns."
msgstr "Ange de kolumner som ska skrivas ut för *--list*-utdata. Använd *--help* för att få en lista över alla kolumner som stöds."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Don't print headings for *--list* output format."
msgstr "Skriv inte ut rubriker för utdataformatet *--list*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--raw*"
msgstr "*--raw*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Use the raw *--list* output format."
msgstr "Använd det råa utdataformatet *--list*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Use JSON format for *--list* output."
msgstr "Använd JSON-format för *--list*-utdata."

#. from tp:util-linux-man-2.41.2-rc1
msgid "ENCRYPTION"
msgstr "ENCRYPTION"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*Cryptoloop is no longer supported in favor of dm-crypt.* For more details see *cryptsetup*(8)."
msgstr "*Cryptoloop stöds inte längre till förmån för dm-crypt.* För mer information se *cryptsetup*(8)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*losetup* returns 0 on success, nonzero on failure. When *losetup* displays the status of a loop device, it returns 1 if the device is not configured and 2 if an error occurred which prevented determining the status of the device."
msgstr "*losetup* returnerar 0 vid framgång, icke-noll vid misslyckande. När *losetup* visar status för en loop-enhet returnerar den 1 om enheten inte är konfigurerad och 2 om ett fel inträffade som gjorde det omöjligt att fastställa enhetens status."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Since version 2.37 *losetup* uses *LOOP_CONFIGURE* ioctl to setup a new loop device by one ioctl call. The old versions use *LOOP_SET_FD* and *LOOP_SET_STATUS64* ioctls to do the same."
msgstr "Sedan version 2.37 använder *losetup* *LOOP_CONFIGURE* ioctl för att konfigurera en ny loop-enhet med ett ioctl-anrop. De gamla versionerna använder *LOOP_SET_FD* och *LOOP_SET_STATUS64* ioctls för att göra samma sak."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*LOOPDEV_DEBUG*=all"
msgstr "*LOOPDEV_DEBUG*=all"

#. from tp:util-linux-man-2.41.2-rc1
msgid "_/dev/loop[0..N]_"
msgstr "_/dev/loop[0..N]_ _/dev/loop[0..N]_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "loop block devices"
msgstr "enheter för slingblock"

#. from tp:util-linux-man-2.41.2-rc1
msgid "_/dev/loop-control_"
msgstr "_/dev/loop-kontroll_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "loop control device"
msgstr "kontrollenhet för slinga"

#. from tp:util-linux-man-2.41.2-rc1
msgid "The following commands can be used as an example of using the loop device."
msgstr "Följande kommandon kan användas som exempel på hur loop-enheten används."

#. from tp:util-linux-man-2.41.2-rc1
msgid " # dd if=/dev/zero of=~/file.img bs=1024k count=10\n # losetup --find --show ~/file.img\n /dev/loop0\n # mkfs -t ext2 /dev/loop0\n # mount /dev/loop0 /mnt\n ...\n # umount /dev/loop0\n # losetup --detach /dev/loop0\n"
msgstr " # dd if=/dev/zero of=~/file.img bs=1024k count=10\n # losetup --find --show ~/file.img\n /dev/loop0\n # mkfs -t ext2 /dev/loop0\n # mount /dev/loop0 /mnt\n ...\n # umount /dev/loop0\n # losetup --detach /dev/loop0\n"

#. from tp:util-linux-man-2.41.2-rc1
msgid "mailto:kzak@redhat.com[Karel Zak], based on the original version from mailto:tytso@athena.mit.edu[Theodore Ts'o]."
msgstr "mailto:kzak@redhat.com[Karel Zak], baserad på originalversionen från mailto:tytso@athena.mit.edu[Theodore Ts'o]."

#. from tp:util-linux-man-2.41.2-rc1
msgid "lscpu(1)"
msgstr "lscpu(1)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "lscpu - display information about the CPU architecture"
msgstr "lscpu - visa information om CPU-arkitekturen"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*lscpu* [options]"
msgstr "*lscpu* [flaggor]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*lscpu* gathers CPU architecture information from _sysfs_, _/proc/cpuinfo_ and any applicable architecture-specific libraries (e.g. *librtas* on Powerpc). The command output can be optimized for parsing or for easy readability by humans. The information includes, for example, the number of CPUs, threads, cores, sockets, and Non-Uniform Memory Access (NUMA) nodes. There is also information about the CPU caches and cache sharing, family, model, bogoMIPS, byte order, and stepping."
msgstr "*lscpu* samlar in information om processorarkitektur från _sysfs_, _/proc/cpuinfo_ och eventuella tillämpliga arkitekturspecifika bibliotek (t.ex. *librtas* på Powerpc). Kommandoutmatningen kan optimeras för parsning eller för att vara lättläst för människor. Informationen omfattar t.ex. antalet processorer, trådar, kärnor, socklar och NUMA-noder (Non-Uniform Memory Access). Det finns också information om processorernas cacheminnen och cacheminnesdelning, familj, modell, bogoMIPS, byteordning och stepping."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The default output formatting on terminal is subject to change and maybe optimized for better readability. The output for non-terminals (e.g., pipes) is never affected by this optimization and it is always in \"Field: data\\n\" format. Use for example \"*lscpu | less*\" to see the default output without optimizations."
msgstr "Standardformateringen för utdata på terminaler kan ändras och kan optimeras för bättre läsbarhet. Utdata för icke-terminaler (t.ex. pipes) påverkas aldrig av den här optimeringen och visas alltid i formatet \"Field: data\\n\". Använd t.ex. \"*lscpu | less*\" för att se standardutdata utan optimeringar."

#. from tp:util-linux-man-2.41.2-rc1
msgid "In virtualized environments, the CPU architecture information displayed reflects the configuration of the guest operating system which is typically different from the physical (host) system. On architectures that support retrieving physical topology information, *lscpu* also displays the number of physical sockets, chips, cores in the host system."
msgstr "I virtualiserade miljöer återspeglar den CPU-arkitekturinformation som visas konfigurationen av gästoperativsystemet, som vanligtvis skiljer sig från det fysiska (värd-)systemet. På arkitekturer som stöder hämtning av information om fysisk topologi visar *lscpu* även antalet fysiska socklar, chips och kärnor i värdsystemet."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Options that result in an output table have a _list_ argument. Use this argument to customize the command output. Specify a comma-separated list of column labels to limit the output table to only the specified columns, arranged in the specified order. See *COLUMNS* for a list of valid column labels. The column labels are not case sensitive."
msgstr "Flaggor som resulterar i en utdatatabell har ett _lista_-argument. Använd detta argument för att anpassa kommandots utdata. Ange en kommaseparerad lista med kolumnbeteckningar för att begränsa utdatatabellen till endast de angivna kolumnerna, ordnade i angiven ordning. Se *COLUMNS* för en lista över giltiga kolumnbeteckningar. Kolumnbeteckningarna är inte skiftlägeskänsliga."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Not all columns are supported on all architectures. If an unsupported column is specified, *lscpu* prints the column but does not provide any data for it."
msgstr "Alla kolumner stöds inte på alla arkitekturer. Om en kolumn som inte stöds anges, skriver *lscpu* ut kolumnen men tillhandahåller inga data för den."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The cache sizes are reported as summary from all CPUs. The versions before v2.34 reported per-core sizes, but this output was confusing due to complicated CPUs topology and the way how caches are shared between CPUs. For more details about caches see *--cache*. Since version v2.37 *lscpu* follows cache IDs as provided by Linux kernel and it does not always start from zero."
msgstr "Cachestorlekarna rapporteras som en sammanfattning från alla processorer. Versionerna före v2.34 rapporterade storlekar per kärna, men denna utdata var förvirrande på grund av komplicerad processortopologi och hur cacheminnen delas mellan processorerna. För mer information om cacheminnen, se *--cache*. Sedan version v2.37 följer *lscpu* cache-ID:n som tillhandahålls av Linux-kärnan och börjar inte alltid från noll."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Include lines for online and offline CPUs in the output (default for *-e*). This option may only be specified together with option *-e* or *-p*."
msgstr "Inkludera rader för online- och offlineprocessorer i utdata (standard för *-e*). Denna flagga kan endast anges tillsammans med flaggan *-e* eller *-p*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-B*, *--bytes*"
msgstr "*-B*, *--bytes*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-b*, *--online*"
msgstr "*-b*, *--online*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Limit the output to online CPUs (default for *-p*). This option may only be specified together with option *-e* or *-p*."
msgstr "Begränsa utdata till online-processorer (standard för *-p*). Denna flagga kan endast anges tillsammans med flaggan *-e* eller *-p*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-C*, *--caches*[**=**_list_]"
msgstr "*-C*, *--caches*[**=**_lista_]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Display details about CPU caches. For details about available information see *--help* output."
msgstr "Visa information om CPU-cacher. För mer information om tillgänglig information, se *--help*-utdata."

#. from tp:util-linux-man-2.41.2-rc1
msgid "If the _list_ argument is omitted, all columns for which data is available are included in the command output."
msgstr "Om argumentet _lista_ utelämnas inkluderas alla kolumner för vilka data finns tillgängliga i kommandoutmatningen."

#. from tp:util-linux-man-2.41.2-rc1
msgid "When specifying the _list_ argument, the string of option, equal sign (=), and _list_ must not contain any blanks or other whitespace. Examples: *-C=NAME,ONE-SIZE* or *--caches=NAME,ONE-SIZE*."
msgstr "När du anger argumentet _lista_ får strängen med option, likhetstecknet (=) och _lista_ inte innehålla några blanksteg eller andra blanksteg. Exempel på flagga: *-C=NAME,ONE-SIZE* eller *--caches=NAME,ONE-SIZE*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The default list of columns may be extended if list is specified in the format +list (e.g., **lscpu -C=+ALLOC-POLICY**)."
msgstr "Standardlistan med kolumner kan utökas om list anges i formatet +list (t.ex. **lscpu -C=+ALLOC-POLICY**)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-c*, *--offline*"
msgstr "*-c*, *--offline*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Limit the output to offline CPUs. This option may only be specified together with option *-e* or *-p*."
msgstr "Begränsa utdata till offline-processorer. Denna flagga kan endast anges tillsammans med flaggan *-e* eller *-p*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--hierarchic*[**=**_when_]"
msgstr "*--hierarchic*[**=**_när_]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Use subsections in summary output. For backward compatibility, the default is to use subsections only when output on a terminal and flattened output on a non-terminal. The optional argument _when_ can be *never*, *always* or *auto*. If the _when_ argument is omitted, it defaults to \"always\"."
msgstr "Använd underavsnitt i sammanfattningsutdata. För bakåtkompatibilitet är standardinställningen att endast använda underavsnitt vid utmatning på en terminal och plattad utmatning på en icke-terminal. Det valfria argumentet _när_ kan vara *never*, *always* eller *auto*. Om argumentet _när_ utelämnas är standardvärdet \"always\"."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-e*, *--extended*[**=**_list_]"
msgstr "*-e*, *--extended*[**=**_lista_]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Display the CPU information in human-readable format."
msgstr "Visa CPU-informationen i ett lättläst format."

#. from tp:util-linux-man-2.41.2-rc1
msgid "If the _list_ argument is omitted, the default columns are included in the command output.  The default output is subject to change."
msgstr "Om argumentet _lista_ utelämnas inkluderas standardkolumnerna i kommandoutmatningen.  Standardutmatningen kan komma att ändras."

#. from tp:util-linux-man-2.41.2-rc1
msgid "When specifying the _list_ argument, the string of option, equal sign (=), and _list_ must not contain any blanks or other whitespace. Examples: '*-e=cpu,node*' or '*--extended=cpu,node*'."
msgstr "När du anger argumentet _lista_ får strängen med option, likhetstecknet (=) och _lista_ inte innehålla några blanksteg eller andra blanksteg. Exempel på detta: '*-e=cpu,node*' eller '*--extended=cpu,node*'."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The default list of columns may be extended if list is specified in the format +list (e.g., lscpu -e=+MHZ)."
msgstr "Standardlistan med kolumner kan utökas om list anges i formatet +list (t.ex. lscpu -e=+MHZ)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Use JSON output format for the default summary or extended output (see *--extended*).  For backward compatibility, JSON output follows the default summary behavior for non-terminals (e.g., pipes) where subsections are missing. See also *--hierarchic*."
msgstr "Använd JSON-utdataformat för standardsammanfattningen eller utökad utdata (se *--utökad*).  Av bakåtkompatibilitetsskäl följer JSON-utdata standardbeteendet för sammanfattning för icke-terminaler (t.ex. pipes) där underavsnitt saknas. Se även *--hierarkisk*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-p*, *--parse*[**=**_list_]"
msgstr "*-p*, *--parse*[**=**_lista_]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Optimize the command output for easy parsing."
msgstr "Optimera kommandoutmatningen så att den blir lätt att tolka."

#. from tp:util-linux-man-2.41.2-rc1
msgid "If the _list_ argument is omitted, the command output is compatible with earlier versions of *lscpu*. In this compatible format, two commas are used to separate CPU cache columns. If no CPU caches are identified the cache column is omitted. If the _list_ argument is used, cache columns are separated with a colon (:)."
msgstr "Om argumentet _lista_ utelämnas är kommandoutmatningen kompatibel med tidigare versioner av *lscpu*. I detta kompatibla format används två kommatecken för att separera CPU-cachekolumner. Om inga CPU-cacheminnen identifieras utelämnas cachekolumnen. Om argumentet _lista_ används separeras cachekolumnerna med ett kolon (:)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "When specifying the _list_ argument, the string of option, equal sign (=), and _list_ must not contain any blanks or other whitespace. Examples: '*-p=cpu,node*' or '*--parse=cpu,node*'."
msgstr "När du anger argumentet _lista_ får strängen med option, likhetstecknet (=) och _lista_ inte innehålla några blanksteg eller andra blanksteg. Exempel på detta: '*-p=cpu,node*' eller '*--parse=cpu,node*'."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The default list of columns may be extended if list is specified in the format +list (e.g., lscpu -p=+MHZ)."
msgstr "Standardlistan med kolumner kan utökas om list anges i formatet +list (t.ex. lscpu -p=+MHZ)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Produce output in its raw format. This option is only applicable for the *--extended*, *--parse*, and *--caches* outputs."
msgstr "Producera utdata i sitt råformat. Denna flagga är endast tillämpligt för utdata *--extended*, *--parse* och *--caches*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-s*, *--sysroot* _directory_"
msgstr "*-s*, *--sysroot* _katalog_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Gather CPU data for a Linux instance other than the instance from which the *lscpu* command is issued. The specified _directory_ is the system root of the Linux instance to be inspected."
msgstr "Samlar in CPU-data för en annan Linux-instans än den instans från vilken kommandot *lscpu* utfärdades. Den angivna _katalogen_ är systemroten för den Linux-instans som ska inspekteras."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Use hexadecimal masks for CPU sets (for example \"ff\"). The default is to print the sets in list format (for example 0,1). Note that before version 2.30 the mask has been printed with 0x prefix."
msgstr "Använd hexadecimala masker för CPU-uppsättningar (t.ex. \"ff\"). Standardinställningen är att skriva ut uppsättningarna i listformat (t.ex. 0,1). Observera att före version 2.30 har masken skrivits ut med prefixet 0x."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-y*, *--physical*"
msgstr "*-y*, *--physical*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Display physical IDs for all columns with topology elements (core, socket, etc.). Other than logical IDs, which are assigned by *lscpu*, physical IDs are platform-specific values that are provided by the kernel. Physical IDs are not necessarily unique and they might not be arranged sequentially. If the kernel could not retrieve a physical ID for an element *lscpu* prints the dash (-) character."
msgstr "Visa fysiska ID:n för alla kolumner med topologielement (kärna, uttag etc.). Till skillnad från logiska ID:n, som tilldelas av *lscpu*, är fysiska ID:n plattformsspecifika värden som tillhandahålls av kärnan. Fysiska ID:n är inte nödvändigtvis unika och de kanske inte är ordnade sekventiellt. Om kärnan inte kunde hämta ett fysiskt ID för ett element skriver *lscpu* ut tecknet bindestreck (-)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The CPU logical numbers are not affected by this option."
msgstr "CPU:ns logiska nummer påverkas inte av denna flagga."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Output all available columns. This option must be combined with either *--extended*, *--parse* or *--caches*."
msgstr "Skriv ut alla tillgängliga kolumner. Denna flagga måste kombineras med antingen *--extended*, *--parse* eller *--caches*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The basic overview of CPU models is based on heuristics, taking into account differences such as CPU model names and implementer IDs. In some (unusual) cases, CPUs may differentiate in flags or BogoMIPS, but these differences are ignored in the lscpu overview."
msgstr "Den grundläggande översikten över CPU-modeller baseras på heuristik, med hänsyn till skillnader som CPU-modellnamn och implementerings-ID. I vissa (ovanliga) fall kan processorer skilja sig åt i flaggor eller BogoMIPS, men dessa skillnader ignoreras i lscpu-översikten."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Sometimes in Xen Dom0 the kernel reports wrong data."
msgstr "Ibland rapporterar kärnan fel data i Xen Dom0."

#. from tp:util-linux-man-2.41.2-rc1
msgid "On virtual hardware the number of cores per socket, etc. can be wrong."
msgstr "På virtuell hårdvara kan antalet kärnor per uttag etc. vara fel."

#. from tp:util-linux-man-2.41.2-rc1
msgid "mailto:qcai@redhat.com[Cai Qian], mailto:kzak@redhat.com[Karel Zak], mailto:heiko.carstens@de.ibm.com[Heiko Carstens]"
msgstr "mailto:qcai@redhat.com[Cai Qian], mailto:kzak@redhat.com[Karel Zak], mailto:heiko.carstens@de.ibm.com[Heiko Carstens]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*chcpu*(8)"
msgstr "*chcpu*(8)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "lsipc(1)"
msgstr "lsipc(1)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "lsipc - show information on IPC facilities currently employed in the system"
msgstr "lsipc - visa information om IPC-faciliteter som för närvarande används i systemet"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*lsipc* [options]"
msgstr "*lsipc* [flaggor]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*lsipc* shows information on the POSIX and System V inter-process communication facilities for which the calling process has read access."
msgstr "*lsipc* visar information om POSIX- och System V-faciliteterna för kommunikation mellan processer för vilka den anropande processen har läsbehörighet."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The default output, as well as the default output from options with predefined output columns (like *--shmems*, etc.), is subject to change. So whenever possible, you should avoid using default outputs in your scripts. Always explicitly define expected columns by using *--output* _columns-list_ in environments where a stable output is required."
msgstr "Standardutdata, liksom standardutdata från flaggor med fördefinierade utdatakolumner (som *--shmems*, etc.), kan ändras. Så när det är möjligt bör du undvika att använda standardutdata i dina skript. Definiera alltid uttryckligen förväntade kolumner genom att använda *--output* _columns-list_ i miljöer där en stabil utdata krävs."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Show full details on just the one resource element (System V) identified by _id_. This option needs to be combined with one of the three resource options: *-m*, *-q* or *-s*. It is possible to override the default output format for this option with the *--list*, *--raw*, *--json* or *--export* option."
msgstr "Visa fullständig information om endast ett resurselement (System V) som identifieras av _id_. Denna flagga måste kombineras med en av de tre resursflaggorna: *-m*, *-q* eller *-s*. Det är möjligt att åsidosätta standardutdataformatet för denna flagga med flaggan *--list*, *--raw*, *--json* eller *--export*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Show full details on just the one resource element (POSIX) identified by _name_. This option needs to be combined with one of the three resource options: *-M*, *-Q* or *-S*. It is possible to override the default output format for this option with the *--list*, *--raw*, *--json* or *--export* option."
msgstr "Visa fullständig information om endast ett resurselement (POSIX) som identifieras av _namn_. Denna flagga måste kombineras med en av de tre resursflaggorna: *-M*, *-Q* eller *-S*. Det är möjligt att åsidosätta standardutdataformatet för denna flagga med flaggan *--list*, *--raw*, *--json* eller *--export*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-g*, *--global*"
msgstr "*-g*, *--global*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Show system-wide usage and limits of IPC resources. This option may be combined with one of the three resource options: *-m*, *-q* or *-s*. The default is to show information about all resources."
msgstr "Visa systemomfattande användning och gränser för IPC-resurser. Denna flagga kan kombineras med en av de tre resursflaggorna: *-m*, *-q* eller *-s*. Standardinställningen är att visa information om alla resurser."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Write information about active System V shared memory segments."
msgstr "Skriv information om aktiva delade minnessegment i System V."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-M*, *--posix-shmems*"
msgstr "*-M*, *--posix-shmems*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Write information about active POSIX shared memory segments."
msgstr "Skriv information om aktiva POSIX-delade minnessegment."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Write information about active System V message queues."
msgstr "Skriv information om aktiva System V-meddelandeköer."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-Q*, *--posix-mqueues*"
msgstr "*-Q*, *--posix-mqueues*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Write information about active POSIX message queues."
msgstr "Skriv information om aktiva POSIX-meddelandeköer."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Write information about active System V semaphore sets."
msgstr "Skriv information om aktiva semaforuppsättningar i System V."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-S*, *--posix-semaphores*"
msgstr "*-S*, *--posix-semaphores*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Write information about active POSIX named semaphores."
msgstr "Skriv information om aktiva POSIX-namngivna semaforer."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Output formatting"
msgstr "Formatering av utdata"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Use the JSON output format."
msgstr "Använd JSON-utdataformatet."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Use the list output format. This is the default, except when *--id* is used."
msgstr "Använd listans utmatningsformat. Detta är standardinställningen, utom när *--id* används."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Print size in bytes rather than in human readable format."
msgstr "Utskriftsstorlek i bytes i stället för i läsbart format."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-P*, *--numeric-perms*"
msgstr "*-P*, *--numeric-perms*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Print numeric permissions in PERMS column."
msgstr "Skriv ut numeriska behörigheter i kolumnen PERMS."

#. from tp:util-linux-man-2.41.2-rc1
msgid "if a serious error occurs."
msgstr "om ett allvarligt fel inträffar."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The *lsipc* utility is inspired by the *ipcs*(1) utility."
msgstr "Verktyget *lsipc* är inspirerat av verktyget *ipcs*(1)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "lsirq(1)"
msgstr "lsirq(1)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "lsirq - utility to display kernel interrupt information"
msgstr "lsirq - verktyg för att visa information om avbrott i kärnan"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*lsirq* [options]"
msgstr "*lsirq* [flaggor]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Display kernel interrupt counter information."
msgstr "Visa information om kärnans avbrottsräknare."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Specify sort criteria by column name. See *--help* output to get column names."
msgstr "Ange sorteringskriterier efter kolumnnamn. Se *--help*-utdata för att få kolumnnamn."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Produce output in the form of key=\"value\" pairs. All potentially unsafe characters are hex-escaped (\\x<code>)."
msgstr "Producerar utdata i form av nyckel=\"värde\"-par. Alla potentiellt osäkra tecken är hexadecalerade (\\x<code>)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Only show interrupt counters on the specified CPU list."
msgstr "Visa endast avbrottsräknare på den angivna CPU-listan."

#. from tp:util-linux-man-2.41.2-rc1
msgid "lsmem(1)"
msgstr "lsmem(1)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "lsmem - list the ranges of available memory with their online status"
msgstr "lsmem - listar tillgängliga minnesintervall med deras onlinestatus"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*lsmem* [options]"
msgstr "*lsmem* [flaggor]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "The *lsmem* command lists the ranges of available memory with their online status. The listed memory blocks correspond to the memory block representation in sysfs. The command also shows the memory block size and the amount of memory in online and offline state."
msgstr "Kommandot *lsmem* listar de tillgängliga minnesområdena med deras onlinestatus. De listade minnesblocken motsvarar minnesblocksrepresentationen i sysfs. Kommandot visar även minnesblockens storlek och mängden minne i online- och offline-läge."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The default output is compatible with original implementation from s390-tools, but it's strongly recommended to avoid using default outputs in your scripts. Always explicitly define expected columns by using the *--output* option together with a columns list in environments where a stable output is required."
msgstr "Standardutmatningen är kompatibel med den ursprungliga implementeringen från s390-tools, men det rekommenderas starkt att undvika att använda standardutmatningar i dina skript. Definiera alltid förväntade kolumner explicit genom att använda flaggan *--output* tillsammans med en kolumnlista i miljöer där en stabil utdata krävs."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The *lsmem* command lists a new memory range always when the current memory block distinguish from the previous block by some output column. This default behavior is possible to override by the *--split* option (e.g., *lsmem --split=ZONES*). The special word \"none\" may be used to ignore all differences between memory blocks and to create as large as possible continuous ranges. The opposite semantic is *--all* to list individual memory blocks."
msgstr "Kommandot *lsmem* listar alltid ett nytt minnesområde när det aktuella minnesblocket skiljer sig från det föregående blocket genom någon utmatningskolumn. Detta standardbeteende kan åsidosättas med flaggan *--split* (t.ex. *lsmem --split=ZONES*). Specialordet \"none\" kan användas för att ignorera alla skillnader mellan minnesblock och för att skapa så stora kontinuerliga intervall som möjligt. Den motsatta semantiken är *--all* för att lista enskilda minnesblock."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Note that some output columns may provide inaccurate information if a split policy forces *lsmem* to ignore differences in some attributes. For example if you merge removable and non-removable memory blocks to the one range than all the range will be marked as non-removable on *lsmem* output."
msgstr "Observera att vissa utdatakolumner kan ge felaktig information om en delningsprincip tvingar *lsmem* att ignorera skillnader i vissa attribut. Om du t.ex. sammanfogar flyttbara och icke-flyttbara minnesblock till ett intervall kommer hela intervallet att markeras som icke-flyttbart i *lsmem*-utdata."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Not all columns are supported on all systems. If an unsupported column is specified, *lsmem* prints the column but does not provide any data for it."
msgstr "Alla kolumner stöds inte av alla system. Om en kolumn som inte stöds anges, skriver *lsmem* ut kolumnen men tillhandahåller inga data för den."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Use the *--help* option to see the columns description."
msgstr "Använd flaggan *--help* för att se en beskrivning av kolumnerna."

#. from tp:util-linux-man-2.41.2-rc1
msgid "List each individual memory block, instead of combining memory blocks with similar attributes."
msgstr "Lista varje enskilt minnesblock, istället för att kombinera minnesblock med liknande attribut."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Specify which output columns to print. Use *--help* to get a list of all supported columns. The default list of columns may be extended if _list_ is specified in the format **+**__list__ (e.g., *lsmem -o +NODE*)."
msgstr "Ange vilka utdatakolumner som ska skrivas ut. Använd *--help* för att få en lista över alla kolumner som stöds. Standardlistan med kolumner kan utökas om _lista_ anges i formatet **+**__lista__ (t.ex. *lsmem -o +NODE*)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Produce output in the form of key=\"value\" pairs. All potentially unsafe value characters are hex-escaped (\\x<code>)."
msgstr "Producerar utdata i form av nyckel=\"värde\"-par. Alla potentiellt osäkra värde-tecken är hexadecalerade (\\x<code>)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-S*, *--split* _list_"
msgstr "*-S*, *--split* _lista_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Specify which columns (attributes) use to split memory blocks to ranges. The supported columns are STATE, REMOVABLE, NODE and ZONES, or \"none\". The other columns are silently ignored. For more details see *DESCRIPTION* above."
msgstr "Ange vilka kolumner (attribut) som ska användas för att dela upp minnesblock i intervall. De kolumner som stöds är STATE, REMOVABLE, NODE och ZONES, eller \"none\". De andra kolumnerna ignoreras i tysthet. För mer information se *DESCRIPTION* ovan."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Gather memory data for a Linux instance other than the instance from which the *lsmem* command is issued. The specified _directory_ is the system root of the Linux instance to be inspected."
msgstr "Samlar in minnesdata för en annan Linux-instans än den instans från vilken kommandot *lsmem* utfärdades. Den angivna _katalogen_ är systemroten för den Linux-instans som ska inspekteras."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--summary*[**=**_when_]"
msgstr "*--summary*[**=**_när_]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "This option controls summary lines output. The optional argument _when_ can be *never*, *always* or *only*. If the _when_ argument is omitted, it defaults to *\"only\"*. The summary output is suppressed for *--raw*, *--pairs* and *--json*."
msgstr "Denna flagga styr utmatningen av sammanfattningsrader. Det valfria argumentet _när_ kan vara *never*, *always* eller *only*. Om argumentet _när_ utelämnas är standardvärdet *\"only\"*. Sammanfattningsutmatningen undertrycks för *--raw*, *--pairs* och *--json*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*lsmem* was originally written by Gerald Schaefer for s390-tools in Perl. The C version for util-linux was written by Clemens von Mann, Heiko Carstens and Karel Zak."
msgstr "*lsmem* skrevs ursprungligen av Gerald Schaefer för s390-tools i Perl. C-versionen för util-linux skrevs av Clemens von Mann, Heiko Carstens och Karel Zak."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*chmem*(8)"
msgstr "*chmem*(8)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "lsns(8)"
msgstr "lsns(8)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "lsns - list namespaces"
msgstr "lsns - lista namnrymder"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*lsns* [options] [_namespace_]"
msgstr "*lsns* [flaggor] [_namnrymd_]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*lsns* lists information about all the currently accessible namespaces or about the given _namespace_. The _namespace_ identifier is an inode number."
msgstr "*lsns* listar information om alla namnrymder som för närvarande är tillgängliga eller om en viss _namnrymd_. Identifieraren för _namnrymden_ är ett inodnummer."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The default output is subject to change. So whenever possible, you should avoid using default outputs in your scripts. Always explicitly define expected output mode (*--tree* or *--list*) and columns by using the *--output* option together with a columns list in environments where a stable output is required."
msgstr "Standardutdata kan komma att ändras. Så när det är möjligt bör du undvika att använda standardutdata i dina skript. Definiera alltid uttryckligen förväntat utdataläge (*--tree* eller *--list*) och kolumner genom att använda flaggan *--output* tillsammans med en kolumnlista i miljöer där en stabil utdata krävs."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The *NSFS* column, printed when *net* is specified for the *--type* option, is special; it uses multi-line cells. Use the option *--nowrap* to switch to \",\"-separated single-line representation."
msgstr "Kolumnen *NSFS*, som skrivs ut när *net* anges för flaggan *--type*, är speciell; den använder celler med flera rader. Använd flaggan *--nowrap* för att byta till \",\"-separerad enradig representation."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Note that *lsns* reads information directly from the _/proc_ filesystem and for non-root users it may return incomplete information. The current _/proc_ filesystem may be unshared and affected by a PID namespace (see *unshare --mount-proc* for more details). *lsns* is not able to see persistent namespaces without processes where the namespace instance is held by a bind mount to /proc/_pid_/ns/_type_."
msgstr "Observera att *lsns* läser information direkt från filsystemet _/proc_ och för användare som inte är root kan den returnera ofullständig information. Det aktuella filsystemet _/proc_ kan vara odelat och påverkas av ett PID-namnområde (se *unshare --mount-proc* för mer information). *lsns* kan inte se beständiga namnrymder utan processer där namnrymdsinstansen hålls av en bind mount till /proc/_pid_/ns/_typ_."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Use list output format."
msgstr "Använd utmatningsformat för lista."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The default list of columns may be extended if _list_ is specified in the format **+**__list__ (e.g., *lsns -o +PATH*)."
msgstr "Standardlistan med kolumner kan utökas om _lista_ anges i formatet **+**__lista__ (t.ex. *lsns -o +PATH*)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-P*, *--persistent*"
msgstr "*-P*, *--persistent*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Display only the namespaces without processes (aka persistent namespaces), created by bind mounting /proc/pid/ns/type files to a filesystem path."
msgstr "Visa endast namnrymder utan processer (även kallade beständiga namnrymder), som skapas genom att binda monteringsfiler av typen /proc/pid/ns/type till en filsystemssökväg."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-p*, *--task* _PID_"
msgstr "*-p*, *--task* _PID_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Display only the namespaces held by the process with this _PID_."
msgstr "Visa endast de namnrymder som innehas av processen med detta _PID_."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Print only the namespaces that meet the conditions specified by the expr."
msgstr "Skriv bara ut de namnrymder som uppfyller de villkor som anges av expr."

#. from tp:util-linux-man-2.41.2-rc1
msgid "This feature is EXPERIMENTAL. See also *scols-filter*(5). For example exclude root as username, but print every namespaces more than one process belongs to:"
msgstr "Denna funktion är EXPERIMENTELL. Se även *scols-filter*(5). Uteslut t.ex. root som användarnamn, men skriv ut alla namnrymder som mer än en process tillhör:"

#. from tp:util-linux-man-2.41.2-rc1
msgid " lsns --filter 'USER != \"root\" and NPROCS > 1'\n"
msgstr " lsns --filter 'USER != \"root\" och NPROCS > 1'\n"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Display the specified _type_ of namespaces only. The supported types are *mnt*, *net*, *ipc*, *user*, *pid*, *uts*, *cgroup* and *time*. This option may be given more than once."
msgstr "Visar endast den angivna _typen_ av namnrymder. De typer som stöds är *mnt*, *net*, *ipc*, *user*, *pid*, *uts*, *cgroup* och *time*. Denna flagga kan anges mer än en gång."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-W*, *--nowrap*"
msgstr "*-W*, *--nowrap*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Do not use multi-line text in columns."
msgstr "Använd inte flerradig text i kolumner."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-T*, *--tree*[**=**__rel__]"
msgstr "*-T*, *--tree*[**=**__rel__]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Use tree-like output format. If *process* is given as _rel_, print process tree(s) in each name space. This is default when *--tree* is not specified. If *parent* is given, print tree(s) constructed by the parent/child relationship. If *owner* is given, print tree(s) constructed by the owner/owned relationship. *owner* is used as default when _rel_ is omitted."
msgstr "Använd trädliknande utdataformat. Om *process* anges som _rel_, skriv ut processträd i varje namnrymd. Detta är standard när *--tree* inte har angetts. Om *parent* anges skrivs träd ut som konstruerats av förälder/barn-relationen. Om *owner* anges skrivs träd ut som konstruerats genom förhållandet ägare/ägd. *owner* används som standard när _rel_ utelämnas."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The *lsns* utility exits with one of the following values:"
msgstr "Verktyget *lsns* avslutas med något av följande värden:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "General error."
msgstr "Allmänt fel."

#. from tp:util-linux-man-2.41.2-rc1
msgid "An ioctl was unknown to the kernel."
msgstr "En ioctl var okänd för kärnan."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*LSNS_DEBUG*=all"
msgstr "*LSNS_DEBUG*=all"

#. from tp:util-linux-man-2.41.2-rc1
msgid "enables *lsns* debug output."
msgstr "aktiverar *lsns* felsökningsutmatning."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*nsenter*(1), *unshare*(1), *clone*(2), *namespaces*(7), *ioctl_ns*(2), *ip-netns*(8)  *scols-filter*(5)"
msgstr "*nsenter*(1), *unshare*(1), *clone*(2), *namespaces*(7), *ioctl_ns*(2), *ip-netns*(8) *scols-filter*(5)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "mount(8)"
msgstr "mount(8)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "mount - mount a filesystem"
msgstr "mount - montera ett filsystem"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*mount* [*-h*|*-V*]"
msgstr "*mount* [*-h*|*-V*]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*mount* [*-l*] [*-t* _fstype_]"
msgstr "*mount* [*-l*] [*-t* _fstype_]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*mount* *-a* [*-fFnrsvw*] [*-t* _fstype_] [*-O* _optlist_]"
msgstr "*mount* *-a* [*-fFnrsvw*] [*-t* _fstype_] [*-O* _optlist_]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*mount* [*-fnrsvw*] [*-o* _options_] _device_|_mountpoint_"
msgstr "*mount* [*-fnrsvw*] [*-o* _options_] _enhet_|_monteringspunkt_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*mount* [*-fnrsvw*] [*-t* _fstype_] [*-o* _options_] _device mountpoint_"
msgstr "*mount* [*-fnrsvw*] [*-t* _fstype_] [*-o* _options_] _device mountpoint_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*mount* *--bind*|*--rbind*|*--move* _olddir newdir_"
msgstr "*mount* *--bind*|*--rbind*|*--move* _olddir newdir_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*mount* *--make-*[*shared*|*slave*|*private*|*unbindable*|*rshared*|*rslave*|*rprivate*|*runbindable*] _mountpoint_"
msgstr "*mount* *--make-*[*shared*|*slave*|*private*|*unbindable*|*rshared*|*rslave*|*rprivate*|*runbindable*] _monteringspunkt_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "All files accessible in a Unix system are arranged in one big tree, the file hierarchy, rooted at _/_. These files can be spread out over several devices. The *mount* command serves to attach the filesystem found on some device to the big file tree. Conversely, the *umount*(8) command will detach it again. The filesystem is used to control how data is stored on the device or provided in a virtual way by network or other services."
msgstr "Alla filer som är tillgängliga i ett Unix-system är ordnade i ett stort träd, filhierarkin, med rötterna i _/_. Dessa filer kan vara utspridda på flera enheter. Kommandot *mount* används för att koppla filsystemet på en enhet till det stora filträdet. Omvänt kommer kommandot *umount*(8) att koppla loss det igen. Filsystemet används för att styra hur data lagras på enheten eller tillhandahålls på ett virtuellt sätt av nätverkstjänster eller andra tjänster."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The standard form of the *mount* command is:"
msgstr "Standardformen av kommandot *mount* är:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*mount -t* _type device dir_"
msgstr "*mount -t* _typ enhet dir_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "This tells the kernel to attach the filesystem found on _device_ (which is of type _type_) at the directory _dir_. The option *-t* _type_ is optional. The *mount* command is usually able to detect a filesystem. The root permissions are necessary to mount a filesystem by default. See section \"Non-superuser mounts\" below for more details. The previous contents (if any) and owner and mode of _dir_ become invisible, and as long as this filesystem remains mounted, the pathname _dir_ refers to the root of the filesystem on _device_."
msgstr "Detta talar om för kärnan att koppla filsystemet som finns på _enhet_ (som är av typen _typ_) till katalogen _dir_. Flaggan *-t* _typ_ är valfri. Kommandot *mount* kan vanligtvis upptäcka ett filsystem. Som standard krävs root-behörighet för att montera ett filsystem. Se avsnittet \"Mounts för icke-superanvändare\" nedan för mer information. Det tidigare innehållet (om det finns något) och ägare och läge för _dir_ blir osynliga, och så länge detta filsystem är monterat hänvisar sökvägen _dir_ till roten av filsystemet på _enhet_."

#. from tp:util-linux-man-2.41.2-rc1
msgid "If only the directory or the device is given, for example:"
msgstr "Om endast katalogen eller enheten anges, t.ex:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*mount* _/dir_"
msgstr "*mount* _/dir_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "then *mount* looks for a mountpoint (and if not found then for a device) in the _/etc/fstab_ file. It's possible to use the *--target* or *--source* options to avoid ambiguous interpretation of the given argument. For example:"
msgstr "letar *mount* efter en monteringspunkt (och om den inte hittas efter en enhet) i filen _/etc/fstab_. Det är möjligt att använda flaggorna *--target* eller *--source* för att undvika tvetydig tolkning av det angivna argumentet. Ett exempel:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*mount --target* _/mountpoint_"
msgstr "*mount --mål* _/mountpoint_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "The same filesystem may be mounted more than once, and in some cases (e.g., network filesystems) the same filesystem may be mounted on the same mountpoint multiple times. The *mount* command does not implement any policy to control this behavior. All behavior is controlled by the kernel and it is usually specific to the filesystem driver. The exception is *--all*, in this case already mounted filesystems are ignored (see *--all* below for more details)."
msgstr "Samma filsystem kan monteras mer än en gång, och i vissa fall (t.ex. nätverksfilsystem) kan samma filsystem monteras på samma monteringspunkt flera gånger. Kommandot *mount* implementerar inte någon policy för att kontrollera detta beteende. Alla beteenden styrs av kärnan och är vanligtvis specifika för filsystemets drivrutin. Undantaget är *--all*, i det här fallet ignoreras redan monterade filsystem (se *--all* nedan för mer information)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Listing the mounts"
msgstr "Listning av fästena"

#. from tp:util-linux-man-2.41.2-rc1
msgid "The listing mode is maintained for backward compatibility only."
msgstr "Listningsläget bibehålls endast för bakåtkompatibilitet."

#. from tp:util-linux-man-2.41.2-rc1
msgid "For more robust and customizable output use *findmnt*(8), *especially in your scripts*. Note that control characters in the mountpoint name are replaced with '?'."
msgstr "För mer robusta och anpassningsbara utdata använder du *findmnt*(8), *särskilt i dina skript*. Observera att kontrolltecken i namnet på monteringspunkten ersätts med '?'."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The following command lists all mounted filesystems (of type _type_):"
msgstr "Följande kommando listar alla monterade filsystem (av typen _typ_):"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*mount* [*-l*] [*-t* _type_]"
msgstr "*mount* [*-l*] [*-t* _typ_]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "The option *-l* adds labels to this listing. See below."
msgstr "Flaggan *-l* lägger till etiketter till denna lista. Se nedan."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Indicating the device and filesystem"
msgstr "Anger enhet och filsystem"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Most devices are indicated by a filename (of a block special device), like _/dev/sda1_, but there are other possibilities. For example, in the case of an NFS mount, _device_ may look like _knuth.cwi.nl:/dir_."
msgstr "De flesta enheter anges med ett filnamn (för en blockspecifik enhet), t.ex. _/dev/sda1_, men det finns andra möjligheter. I fallet med en NFS-montering kan _enhet_ till exempel se ut som _knuth.cwi.nl:/dir_."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The device names of disk partitions are unstable; hardware reconfiguration, and adding or removing a device can cause changes in names. This is the reason why it's strongly recommended to use filesystem or partition identifiers like UUID or LABEL. Currently supported identifiers (tags):"
msgstr "Enhetsnamnen på diskpartitioner är instabila; omkonfigurering av maskinvara och tillägg eller borttagning av en enhet kan orsaka ändringar i namnen. Detta är anledningen till att det är starkt rekommenderat att använda filsystem- eller partitionsidentifierare som UUID eller LABEL. Identifierare (taggar) som stöds för närvarande:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "LABEL=__label__"
msgstr "LABEL=__etikett__"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Human readable filesystem identifier. See also *-L*."
msgstr "Mänskligt läsbar filsystemidentifierare. Se även *-L*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "UUID=__uuid__"
msgstr "UUID=__uuid__"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Filesystem universally unique identifier. The format of the UUID is usually a series of hex digits separated by hyphens. See also *-U*."
msgstr "Filsystemets universellt unika identifierare. Formatet för UUID är vanligtvis en serie hexadecimala siffror åtskilda av bindestreck. Se även *-U*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Note that *mount* uses UUIDs as strings. The UUIDs from the command line or from *fstab*(5) are not converted to internal binary representation. The string representation of the UUID should be based on lower case characters."
msgstr "Observera att *mount* använder UUID:er som strängar. UUID:er från kommandoraden eller från *fstab*(5) konverteras inte till intern binär representation. Strängrepresentationen av UUID bör baseras på gemena tecken."

#. from tp:util-linux-man-2.41.2-rc1
msgid "PARTLABEL=__label__"
msgstr "PARTLABEL=__etikett__"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Human readable partition identifier. This identifier is independent on filesystem and does not change by *mkfs* or *mkswap* operations. It's supported for example for GUID Partition Tables (GPT)."
msgstr "Partitionens identifierare som är läsbar för människor. Denna identifierare är oberoende av filsystemet och ändras inte av *mkfs*- eller *mkswap*-operationer. Den stöds till exempel för GUID-partitionstabeller (GPT)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "PARTUUID=__uuid__"
msgstr "PARTUUID=__uuid__"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Partition universally unique identifier. This identifier is independent on filesystem and does not change by *mkfs* or *mkswap* operations. It's supported for example for GUID Partition Tables (GPT)."
msgstr "Partitionens universellt unika identifierare. Denna identifierare är oberoende av filsystemet och ändras inte av *mkfs*- eller *mkswap*-operationer. Det stöds till exempel för GUID-partitionstabeller (GPT)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "ID=__id__"
msgstr "ID=__id__"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Hardware block device ID as generated by udevd. This identifier is usually based on WWN (unique storage identifier) and assigned by the hardware manufacturer. See *ls /dev/disk/by-id* for more details, this directory and running udevd is required. This identifier is not recommended for generic use as the identifier is not strictly defined and it depends on udev, udev rules and hardware."
msgstr "ID för hårdvarublockenhet som genereras av udevd. Denna identifierare är vanligtvis baserad på WWN (unik lagringsidentifierare) och tilldelas av hårdvarutillverkaren. Se *ls /dev/disk/by-id* för mer information, den här katalogen och att udevd körs krävs. Den här identifieraren rekommenderas inte för allmän användning eftersom identifieraren inte är strikt definierad och den beror på udev, udev-regler och maskinvara."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The command *lsblk --fs* provides an overview of filesystems, LABELs and UUIDs on available block devices. The command *blkid -p <device>* provides details about a filesystem on the specified device."
msgstr "Kommandot *lsblk --fs* ger en översikt över filsystem, LABELs och UUIDs på tillgängliga blockenheter. Kommandot *blkid -p <device>* ger information om ett filsystem på den angivna enheten."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Don't forget that there is no guarantee that UUIDs and labels are really unique, especially if you move, share or copy the device. Use *lsblk -o +UUID,PARTUUID* to verify that the UUIDs are really unique in your system."
msgstr "Glöm inte att det inte finns någon garanti för att UUID:er och etiketter verkligen är unika, särskilt om du flyttar, delar eller kopierar enheten. Använd *lsblk -o +UUID,PARTUUID* för att kontrollera att UUID:erna verkligen är unika i ditt system."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The recommended setup is to use tags (e.g. *UUID*=_uuid_) rather than _/dev/disk/by-{label,uuid,id,partuuid,partlabel}_ udev symlinks in the _/etc/fstab_ file. Tags are more readable, robust and portable. The *mount*(8) command internally uses udev symlinks, so the use of symlinks in _/etc/fstab_ has no advantage over tags. For more details see *libblkid*(3)."
msgstr "Den rekommenderade installationen är att använda taggar (t.ex. *UUID*=_uuid_) i stället för _/dev/disk/by-{label,uuid,id,partuuid,partlabel}_ udev-symlänkar i filen _/etc/fstab_. Taggar är mer läsbara, robusta och portabla. Kommandot *mount*(8) använder internt udev-symlänkar, så användningen av symlinks i _/etc/fstab_ har ingen fördel jämfört med taggar. För mer information se *libblkid*(3)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The _proc_ filesystem is not associated with a special device, and when mounting it, an arbitrary keyword - for example, __proc__ - can be used instead of a device specification. (The customary choice _none_ is less fortunate: the error message 'none already mounted' from *mount* can be confusing.)"
msgstr "Filsystemet _proc_ är inte associerat med någon speciell enhet, och när det monteras kan ett godtyckligt nyckelord - till exempel __proc__ - användas i stället för en enhetsspecifikation. (Det vanliga valet _none_ är mindre lyckosamt: felmeddelandet \"none already mounted\" från *mount* kan vara förvirrande)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "The files /etc/fstab, /etc/mtab and /proc/mounts"
msgstr "Filerna /etc/fstab, /etc/mtab och /proc/mounts"

#. from tp:util-linux-man-2.41.2-rc1
msgid "The file _/etc/fstab_ (see *fstab*(5)), may contain lines describing what devices are usually mounted where, using which options. The default location of the *fstab*(5) file can be overridden with the *--fstab* _path_ command-line option (see below for more details)."
msgstr "Filen _/etc/fstab_ (se *fstab*(5)) kan innehålla rader som beskriver vilka enheter som vanligtvis monteras var, med vilka flaggor. Standardplatsen för filen *fstab*(5) kan åsidosättas med kommandoradsflaggan *--fstab* _sökväg_ (se nedan för mer information)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The command"
msgstr "Kommandot"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*mount -a* [*-t* _type_] [*-O* _optlist_]"
msgstr "*mount -a* [*-t* _typ_] [*-O* _optlist_]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "(usually given in a bootscript) causes all filesystems mentioned in _fstab_ (of the proper type and/or having or not having the proper options) to be mounted as indicated, except for those whose line contains the *noauto* keyword. Adding the *-F* option will make *mount* fork, so that the filesystems are mounted in parallel."
msgstr "(anges vanligen i ett bootskript) gör att alla filsystem som nämns i _fstab_ (av rätt typ och/eller med eller utan rätta flaggor) monteras på angivet sätt, utom de vars rad innehåller nyckelordet *noauto*. Om du lägger till flaggan *-F* blir *mount* fork, så att filsystemen monteras parallellt."

#. from tp:util-linux-man-2.41.2-rc1
msgid "When mounting a filesystem mentioned in _fstab_ or _mtab_, it suffices to specify on the command line only the device, or only the mount point."
msgstr "När du monterar ett filsystem som nämns i _fstab_ eller _mtab_ räcker det med att ange endast enheten eller monteringspunkten på kommandoraden."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The programs *mount* and *umount*(8) traditionally maintained a list of currently mounted filesystems in the file _/etc/mtab_. The support for regular classic _/etc/mtab_ is completely disabled at compile time by default, because on current Linux systems it is better to make _/etc/mtab_ a symlink to _/proc/mounts_ instead. The regular _mtab_ file maintained in userspace cannot reliably work with namespaces, containers and other advanced Linux features. If the regular _mtab_ support is enabled, then it's possible to use the file as well as the symlink."
msgstr "Programmen *mount* och *umount*(8) upprätthöll traditionellt en lista över aktuella monterade filsystem i filen _/etc/mtab_. Stödet för vanlig klassisk _/etc/mtab_ är helt inaktiverat vid kompileringstillfället som standard, eftersom det på nuvarande Linux-system är bättre att göra _/etc/mtab_ till en symlänk till _/proc/mounts_ istället. Den vanliga _mtab_-filen i userspace kan inte på ett tillförlitligt sätt arbeta med namnrymder, containrar och andra avancerade Linux-funktioner. Om det vanliga _mtab_-stödet är aktiverat är det möjligt att använda både filen och symlänken."

#. from tp:util-linux-man-2.41.2-rc1
msgid "If no arguments are given to *mount*, the list of mounted filesystems is printed."
msgstr "Om inga argument ges till *mount* skrivs listan över monterade filsystem ut."

#. from tp:util-linux-man-2.41.2-rc1
msgid "If you want to override mount options from _/etc/fstab_, you have to use the *-o* option:"
msgstr "Om du vill åsidosätta monteringsflaggorna från _/etc/fstab_ måste du använda flaggan *-o*:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*mount* __device__|__dir__ *-o* _options_"
msgstr "*mount* __enhet__|__dir__ *-o* _options_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "and then the mount options from the command line will be appended to the list of options from _/etc/fstab_. This default behaviour can be changed using the *--options-mode* command-line option. The usual behavior is that the last option wins if there are conflicting ones."
msgstr "och då kommer monteringsflaggor från kommandoraden att läggas till i listan över flaggor från _/etc/fstab_. Detta standardbeteende kan ändras med hjälp av kommandoradsflaggan *--options-mode*. Det vanliga beteendet är att den sista flaggan vinner om det finns motstridiga flaggor."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The *mount* program does not read the _/etc/fstab_ file if both _device_ (or LABEL, UUID, ID, PARTUUID or PARTLABEL) and _dir_ are specified. For example, to mount device *foo* at */dir*:"
msgstr "Programmet *mount* läser inte filen _/etc/fstab_ om både _enhet_ (eller LABEL, UUID, ID, PARTUUID eller PARTLABEL) och _dir_ anges. Till exempel, för att montera enhet *foo* på */dir*:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*mount /dev/foo /dir*"
msgstr "*montera /dev/foo /dir*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "This default behaviour can be changed by using the *--options-source-force* command-line option to always read configuration from _fstab_. For non-root users *mount* always reads the _fstab_ configuration."
msgstr "Detta standardbeteende kan ändras genom att använda kommandoradsflaggan *--options-source-force* för att alltid läsa konfigurationen från _fstab_. För användare som inte är root läser *mount* alltid konfigurationen från _fstab_."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Non-superuser mounts"
msgstr "Monteringar för icke-superanvändare"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Normally, only the superuser can mount filesystems. However, when _fstab_ contains the *user* option on a line, anybody can mount the corresponding filesystem."
msgstr "Normalt är det bara superanvändaren som kan montera filsystem. Men när _fstab_ innehåller flaggan *user* på en rad kan vem som helst montera motsvarande filsystem."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Thus, given a line"
msgstr "Således, givet en rad"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*/dev/cdrom /cd iso9660 ro,user,noauto,unhide*"
msgstr "*/dev/cdrom /cd iso9660 ro,user,noauto,unhide*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "any user can mount the iso9660 filesystem found on an inserted CDROM using the command:"
msgstr "alla användare kan montera filsystemet iso9660 som finns på en insatt CDROM med kommandot:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*mount /cd*"
msgstr "*montera /cd*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Note that *mount* is very strict about non-root users and all paths specified on command line are verified before _fstab_ is parsed or a helper program is executed. It's strongly recommended to use a valid mountpoint to specify filesystem, otherwise *mount* may fail. For example it's a bad idea to use NFS or CIFS source on command line."
msgstr "Observera att *mount* är mycket strikt när det gäller icke-root-användare och att alla sökvägar som anges på kommandoraden verifieras innan _fstab_ analyseras eller ett hjälpprogram körs. Det rekommenderas starkt att använda en giltig monteringspunkt för att ange filsystem, annars kan *mount* misslyckas. Det är t.ex. en dålig idé att använda NFS- eller CIFS-källa på kommandoraden."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Since util-linux 2.35, *mount* does not exit when user permissions are inadequate according to libmount's internal security rules. Instead, it drops suid permissions and continues as regular non-root user. This behavior supports use-cases where root permissions are not necessary (e.g., fuse filesystems, user namespaces, etc)."
msgstr "Sedan util-linux 2.35 avslutas inte *mount* när användarrättigheterna är otillräckliga enligt libmounts interna säkerhetsregler. Istället släpper den suid-behörigheterna och fortsätter som vanlig användare utan root-behörighet. Detta beteende stöder användningsfall där root-behörigheter inte är nödvändiga (t.ex. fuse-filsystem, användarnamnområden etc.)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "For more details, see *fstab*(5). Only the user that mounted a filesystem can unmount it again. If any user should be able to unmount it, then use *users* instead of *user* in the _fstab_ line. The *owner* option is similar to the *user* option, with the restriction that the user must be the owner of the special file. This may be useful e.g. for _/dev/fd_ if a login script makes the console user owner of this device. The *group* option is similar, with the restriction that the user must be a member of the group of the special file."
msgstr "För mer information, se *fstab*(5). Endast den användare som har monterat ett filsystem kan avmontera det igen. Om vilken användare som helst ska kunna avmontera det, använd *users* istället för *user* på raden _fstab_. Flaggan *owner* liknar flaggan *user*, med den begränsningen att användaren måste vara ägare till den speciella filen. Detta kan vara användbart t.ex. för _/dev/fd_ om ett inloggningsskript gör konsolanvändaren till ägare av den här enheten. Flaggan *group* är liknande, med begränsningen att användaren måste vara medlem i gruppen för specialfilen."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The *user* mount option is accepted if no username is specified. If used in the format *user=someone*, the option is silently ignored and visible only for external mount helpers (/sbin/mount.<type>) for compatibility with some network filesystems."
msgstr "Monteringsflaggan *user* accepteras om inget användarnamn har angetts. Om flaggan används i formatet *user=someone* ignoreras det i tysthet och är endast synligt för externa monteringshjälpare (/sbin/mount.<type>) för kompatibilitet med vissa nätverksfilsystem."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Bind mount operation"
msgstr "Bind montering operation"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Remount part of the file hierarchy somewhere else. The call is:"
msgstr "Omlokalisera en del av filhierarkin till en annan plats. Samtalet är:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*mount --bind* _olddir newdir_"
msgstr "*mount --bind* _olddir newdir_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "or by using this _fstab_ entry:"
msgstr "eller genom att använda denna _fstab_-post:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "**/**__olddir__ **/**__newdir__ *none bind*"
msgstr "**/**__olddir__ **/**__newdir__ *none bind*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "After this call the same contents are accessible in two places."
msgstr "Efter detta samtal finns samma innehåll tillgängligt på två ställen."

#. from tp:util-linux-man-2.41.2-rc1
msgid "It is important to understand that \"bind\" does not create any second-class or special node in the kernel VFS. The \"bind\" is just another operation to attach a filesystem. There is nowhere stored information that the filesystem has been attached by a \"bind\" operation. The _olddir_ and _newdir_ are independent and the _olddir_ may be unmounted."
msgstr "Det är viktigt att förstå att \"bind\" inte skapar någon andra klassens eller speciell nod i kärnans VFS. \"Bind\" är bara en annan operation för att koppla ett filsystem. Det finns ingenstans lagrad information om att filsystemet har anslutits genom en \"bind\"-operation. _olddir_ och _newdir_ är oberoende av varandra och _olddir_ kan avmonteras."

#. from tp:util-linux-man-2.41.2-rc1
msgid "One can also remount a single file (on a single file). It's also possible to use a bind mount to create a mountpoint from a regular directory, for example:"
msgstr "Man kan också återmontera en enskild fil (på en enskild fil). Det är också möjligt att använda en bind mount för att skapa en mountpoint från en vanlig katalog, till exempel:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*mount --bind foo foo*"
msgstr "*mount --bind foo foo*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "The bind mount call attaches only (part of) a single filesystem, not possible submounts. The entire file hierarchy including submounts can be attached a second place by using:"
msgstr "Anropet bind mount kopplar endast (en del av) ett enda filsystem, inte eventuella undermonteringar. Hela filhierarkin inklusive submounts kan kopplas till en andra plats genom att använda:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*mount --rbind* _olddir newdir_"
msgstr "*mount --rbind* _olddir newdir_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Note that the filesystem mount options maintained by the kernel will remain the same as those on the original mount point. The userspace mount options (e.g., _netdev) will not be copied by *mount* and it's necessary to explicitly specify the options on the *mount* command line."
msgstr "Observera att filsystemets monteringsflaggor som hanteras av kärnan förblir desamma som på den ursprungliga monteringspunkten. Monteringsflaggoren för userspace (t.ex. _netdev) kopieras inte av *mount* och det är nödvändigt att uttryckligen ange flaggorna på kommandoraden för *mount*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Since util-linux 2.27 *mount* permits changing the mount options by passing the relevant options along with *--bind*. For example:"
msgstr "Sedan util-linux 2.27 tillåter *mount* att man ändrar monteringsflaggorna genom att skicka de relevanta flaggor tillsammans med *--bind*. Till exempel: *--bind*:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*mount -o bind,ro foo foo*"
msgstr "*mount -o bind,ro foo foo*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "This feature is not supported by the Linux kernel; it is implemented in userspace by an additional *mount*(2) remounting system call. This solution is not atomic."
msgstr "Den här funktionen stöds inte av Linux-kärnan, utan implementeras i användarutrymmet med ett extra systemanrop för återmontering, *mount*(2). Den här lösningen är inte atomär."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The alternative (classic) way to create a read-only bind mount is to use the remount operation, for example:"
msgstr "Det alternativa (klassiska) sättet att skapa en skrivskyddad bind mount är att använda remount-operationen, till exempel:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*mount -o remount,bind,ro* _olddir newdir_"
msgstr "*mount -o remount,bind,ro* _olddir newdir_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Note that a read-only bind will create a read-only mountpoint (VFS entry), but the original filesystem superblock will still be writable, meaning that the _olddir_ will be writable, but the _newdir_ will be read-only."
msgstr "Observera att en skrivskyddad bindning skapar en skrivskyddad monteringspunkt (VFS-post), men det ursprungliga filsystemets superblock kommer fortfarande att vara skrivbart, vilket innebär att _olddir_ kommer att vara skrivbart, men _newdir_ kommer att vara skrivskyddat."

#. from tp:util-linux-man-2.41.2-rc1
msgid "It's also possible to change nosuid, nodev, noexec, noatime, nodiratime, relatime and nosymfollow VFS entry flags via a \"remount,bind\" operation. The other flags (for example filesystem-specific flags) are silently ignored. The classic *mount*(2) system call does not allow to change mount options recursively (for example with *-o rbind,ro*). The recursive semantic is possible with a new *mount_setattr*(2) kernel system call and it's supported since libmount from util-linux v2.39 by a new experimental \"recursive\" option argument (e.g. *-o rbind,ro=recursive*). For more details see the *FILESYSTEM-INDEPENDENT MOUNT OPTIONS* section."
msgstr "Det går också att ändra VFS-flaggorna nosuid, nodev, noexec, noatime, nodiratime, relatime och nosymfollow via en \"remount,bind\"-operation. De andra flaggorna (t.ex. filsystemspecifika flaggor) ignoreras i tysthet. Det klassiska systemanropet *mount*(2) gör det inte möjligt att ändra monteringsflaggor rekursivt (t.ex. med *-o rbind,ro*). Den rekursiva semantiken är möjlig med ett nytt *mount_setattr*(2)-systemanrop i kärnan och det stöds sedan libmount från util-linux v2.39 med ett nytt experimentellt \"rekursivt\" flaggargument (t.ex. *-o rbind,ro=recursive*). Mer information finns i avsnittet *FILSYSTEMSOBEROENDE MONTERINGSFLAGGOR*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Since util-linux 2.31, *mount* ignores the *bind* flag from _/etc/fstab_ on a *remount* operation (if *-o remount* is specified on command line). This is necessary to fully control mount options on remount by command line. In previous versions the bind flag has been always applied and it was impossible to re-define mount options without interaction with the bind semantic. This *mount* behavior does not affect situations when \"remount,bind\" is specified in the _/etc/fstab_ file."
msgstr "Sedan util-linux 2.31 ignorerar *mount* flaggan *bind* från _/etc/fstab_ vid en *remount*-operation (om *-o remount* anges på kommandoraden). Detta är nödvändigt för att fullt ut kontrollera monteringsflaggor vid återmontering via kommandoraden. I tidigare versioner har bind-flaggan alltid använts och det var omöjligt att omdefiniera monteringsflaggor utan att interagera med bind-semantiken. Detta *monterings*-beteende påverkar inte situationer när \"remount,bind\" anges i filen _/etc/fstab_."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Since util-linux 2.39, *mount* may use the new kernel mount API if it is available. This new kernel interface provides a more precise way to work with mountpoint attributes. For example, the *-o bind,rw* operation will create a read-write node even if the original node was read-only. This was impossible with the old classic mount(2) syscall, where the read-only VFS flag was inherited from the original node."
msgstr "Sedan util-linux 2.39 kan *mount* använda det nya kernel mount API om det är tillgängligt. Detta nya kärngränssnitt ger ett mer exakt sätt att arbeta med monteringspunktsattribut. Till exempel kommer operationen *-o bind,rw* att skapa en skrivskyddad nod även om den ursprungliga noden var skrivskyddad. Detta var omöjligt med det gamla klassiska syscallet mount(2), där den skrivskyddade VFS-flaggan ärvdes från den ursprungliga noden."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The move operation"
msgstr "Flyttoperationen"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Move a *mounted tree* to another place (atomically). The call is:"
msgstr "Flytta ett *monterat träd* till en annan plats (atomiskt). Samtalet är:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*mount --move* _olddir newdir_"
msgstr "*mount --move* _olddir newdir_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "This will cause the contents which previously appeared under _olddir_ to now be accessible under _newdir_. The physical location of the files is not changed. Note that _olddir_ has to be a mountpoint."
msgstr "Detta leder till att innehållet som tidigare fanns under _olddir_ nu finns tillgängligt under _newdir_. Den fysiska platsen för filerna ändras inte. Observera att _olddir_ måste vara en monteringspunkt."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Note also that moving a mount residing under a shared mount is invalid and unsupported. Use *findmnt -o TARGET,PROPAGATION* to see the current propagation flags."
msgstr "Observera också att det är ogiltigt och inte stöds att flytta en montering som finns under en delad montering. Använd *findmnt -o TARGET,PROPAGATION* för att se de aktuella propagationsflaggorna."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Shared subtree operations"
msgstr "Operationer för delade delträd"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Since Linux 2.6.15 it is possible to mark a mount and its submounts as shared, private, slave or unbindable. A shared mount provides the ability to create mirrors of that mount such that mounts and unmounts within any of the mirrors propagate to the other mirror. A slave mount receives propagation from its master, but not vice versa. A private mount carries no propagation abilities. An unbindable mount is a private mount which cannot be cloned through a bind operation. The detailed semantics are documented in _Documentation/filesystems/sharedsubtree.txt_ file in the kernel source tree; see also *mount_namespaces*(7)."
msgstr "Sedan Linux 2.6.15 är det möjligt att markera ett mount och dess submounts som shared, private, slave eller unbindable. En delad montering gör det möjligt att skapa speglar av monteringen så att monteringar och avmonteringar i någon av speglarna sprids till den andra spegeln. En slavmonterad montering får spridning från sin master, men inte tvärtom. En privat montering har inga spridningsmöjligheter. En obindbar montering är en privat montering som inte kan klonas genom en bindningsoperation. Den detaljerade semantiken finns dokumenterad i filen _Documentation/filesystems/sharedsubtree.txt_ i kärnans källträd; se även *mount_namespaces*(7)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Supported operations are:"
msgstr "Operationer som stöds är:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "mount --make-shared mountpoint\nmount --make-slave mountpoint\nmount --make-private mountpoint\nmount --make-unbindable mountpoint\n"
msgstr "montera --skapa delad monteringspunkt\nmount --make-slave mountpoint\nmount --make-private mountpoint\nmount --make-unbindable mountpoint\n"

#. from tp:util-linux-man-2.41.2-rc1
msgid "The following commands allow one to recursively change the type of all the mounts under a given mountpoint."
msgstr "Med följande kommandon kan du rekursivt ändra typen för alla monteringar under en viss monteringspunkt."

#. from tp:util-linux-man-2.41.2-rc1
msgid "mount --make-rshared mountpoint\nmount --make-rslave mountpoint\nmount --make-rprivate mountpoint\nmount --make-runbindable mountpoint\n"
msgstr "mount --make-rshared monteringspunkt\nmount --make-rslave monteringspunkt\nmount --make-rprivate mountpoint\nmount --make-runbindable mountpoint\n"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*mount* *does not read* *fstab*(5) when a *--make-** operation is requested. All necessary information has to be specified on the command line."
msgstr "*mount* *läser inte* *fstab*(5) när en *--make-** operation begärs. All nödvändig information måste anges på kommandoraden."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Note that the Linux kernel does not allow changing multiple propagation flags with a single *mount*(2) system call, and the flags cannot be mixed with other mount options and operations."
msgstr "Observera att Linux-kärnan inte tillåter ändring av flera propagationsflaggor med ett enda *mount*(2)-systemanrop, och flaggorna kan inte blandas med andra monteringsflaggor och operationer."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Since util-linux 2.23 the *mount* command can be used to do more propagation (topology) changes by one *mount*(8) call and do it also together with other mount operations. The propagation flags are applied by additional *mount*(2) system calls when the preceding mount operations were successful. Note that this use case is not atomic. It is possible to specify the propagation flags in *fstab*(5) as mount options (*private*, *slave*, *shared*, *unbindable*, *rprivate*, *rslave*, *rshared*, *runbindable*)."
msgstr "Sedan util-linux 2.23 kan kommandot *mount* användas för att göra fler propagationsändringar (topologi) med ett *mount*(8)-anrop och även göra det tillsammans med andra monteringsoperationer. Propageringsflaggorna appliceras genom ytterligare *mount*(2)-systemanrop när de föregående monteringsoperationerna lyckades. Observera att det här användningsfallet inte är atomiskt. Det är möjligt att ange spridningsflaggorna i *fstab*(5) som monteringsflaggor (*private*, *slave*, *shared*, *unbindable*, *rprivate*, *rslave*, *rshared*, *runbindable*)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "mount --make-private --make-unbindable /dev/sda1 /foo\n"
msgstr "mount --make-private --make-unbindable /dev/sda1 /foo\n"

#. from tp:util-linux-man-2.41.2-rc1
msgid "is the same as:"
msgstr "är samma sak som:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "mount /dev/sda1 /foo\nmount --make-private /foo\nmount --make-unbindable /foo\n"
msgstr "mount /dev/sda1 /foo\nmount --make-private /foo\nmount --make-unbindable /foo\n"

#. from tp:util-linux-man-2.41.2-rc1
msgid "COMMAND-LINE OPTIONS"
msgstr "KOMMANDORADSFLAGGOR"

#. from tp:util-linux-man-2.41.2-rc1
msgid "The full set of mount options used by an invocation of *mount* is determined by first extracting the mount options for the filesystem from the _fstab_ table, then applying any options specified by the *-o* argument, and finally applying a *-r* or *-w* option, when present."
msgstr "Den fullständiga uppsättning monteringsflaggor som används vid ett anrop av *mount* bestäms genom att först extrahera monteringsflaggor för filsystemet från tabellen _fstab_, sedan tillämpa eventuella flaggor som anges av argumentet *-o* och slutligen tillämpa en flagga *-r* eller *-w*, om ett sådant finns."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The *mount* command does not pass all command-line options to the **/sbin/mount.**__suffix__ mount helpers. The interface between *mount* and the mount helpers is described below in the *EXTERNAL HELPERS* section."
msgstr "Kommandot *mount* skickar inte alla kommandoradsflaggor till monteringshjälpprogrammen **/sbin/mount.**__suffix__. Gränssnittet mellan *mount* och monteringshjälpfunktionerna beskrivs nedan i avsnittet *EXTERNA HJÄLPFUNKTIONER*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Command-line options available for the *mount* command are:"
msgstr "Kommandoradsflaggor som är tillgängliga för kommandot *mount* är:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Mount all filesystems (of the given types) mentioned in _fstab_ (except for those whose line contains the *noauto* keyword). The filesystems are mounted following their order in _fstab_. The *mount* command compares filesystem source, target (and fs root for bind mount or btrfs) to detect already mounted filesystems. The kernel table with already mounted filesystems is cached during *mount --all*. This means that all duplicated _fstab_ entries will be mounted."
msgstr "Montera alla filsystem (av de angivna typerna) som nämns i _fstab_ (utom de vars rad innehåller nyckelordet *noauto*). Filsystemen monteras i den ordning de står i _fstab_. Kommandot *mount* jämför filsystemets källa, mål (och fs root för bind mount eller btrfs) för att upptäcka redan monterade filsystem. Kärntabellen med redan monterade filsystem cachelagras under *mount --all*. Detta innebär att alla duplicerade _fstab_-poster kommer att monteras."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The correct functionality depends on _/proc_ (to detect already mounted filesystems) and on _/sys_ (to evaluate filesystem tags like UUID= or LABEL=). It's strongly recommended to mount _/proc_ and _/sys_ filesystems before *mount -a* is executed, or keep /proc and /sys at the beginning of _fstab_."
msgstr "Den korrekta funktionen beror på _/proc_ (för att upptäcka redan monterade filsystem) och på _/sys_ (för att utvärdera filsystemtaggar som UUID= eller LABEL=). Vi rekommenderar starkt att du monterar filsystemen _/proc_ och _/sys_ innan *mount -a* körs, eller behåller /proc och /sys i början av _fstab_."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The option *--all* is possible to use for remount operation too. In this case all filters (*-t* and *-O*) are applied to the table of already mounted filesystems."
msgstr "Flaggan *--all* är också möjligt att använda för återmonteringsoperationer. I det här fallet tillämpas alla filter (*-t* och *-O*) på tabellen över redan monterade filsystem."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Since version 2.35 it is possible to use the command line option *-o* to alter mount options from _fstab_ (see also *--options-mode*)."
msgstr "Sedan version 2.35 är det möjligt att använda kommandoradsflaggan *-o* för att ändra monteringsflaggor från _fstab_ (se även *--options-mode*)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Note that it is a bad practice to use *mount -a* for _fstab_ checking. The recommended solution is *findmnt --verify*."
msgstr "Observera att det är en dålig idé att använda *mount -a* för _fstab_-kontroll. Den rekommenderade lösningen är *findmnt --verify*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-B*, *--bind*"
msgstr "*-B*, *--bind*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Remount a subtree somewhere else (so that its contents are available in both places). See above, under *Bind mount operation*."
msgstr "Ommontera en delträd någon annanstans (så att dess innehåll är tillgängligt på båda ställena). Se ovan, under *Bind mount operation*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-c*, *--no-canonicalize*"
msgstr "*-c*, *--no-canonicalize*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Do not canonicalize any paths or tags during the mount process. The *mount* command automatically canonicalizes all paths (from the command line or _fstab_). This option can be used in conjunction with the *-f* flag for paths that are already canonicalized. This option is intended for mount helpers that call *mount -i*. It is highly recommended to not use this command-line option for regular mount operations. See also the X-mount.nocanonicalize mount options."
msgstr "Kanonisera inte några sökvägar eller taggar under monteringsprocessen. Kommandot *mount* kanoniserar automatiskt alla sökvägar (från kommandoraden eller _fstab_). Den här flaggan kan användas tillsammans med flaggan *-f* för sökvägar som redan har kanoniserats. Den här flaggan är avsett för mount-hjälpfunktioner som anropar *mount -i*. Det är starkt rekommenderat att inte använda detta kommandoradsflaggor för vanliga monteringsoperationer. Se även monteringsflaggorna för X-mount.nocanonicalize."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Note that *mount* does not pass this option to the **/sbin/mount.**__type__ helpers."
msgstr "Observera att *mount* inte skickar denna flagga till hjälpprogrammen **/sbin/mount.**__typ__."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-F*, *--fork*"
msgstr "*-F*, *--fork*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "(Used in conjunction with *-a*.) Fork off a new incarnation of *mount* for each device. This will do the mounts on different devices or different NFS servers in parallel. This has the advantage that it is faster; also NFS timeouts proceed in parallel. A disadvantage is that the order of the mount operations is undefined. Thus, you cannot use this option if you want to mount both _/usr_ and _/usr/spool_."
msgstr "(Används tillsammans med *-a*.) Starta en ny inkarnation av *mount* för varje enhet. Detta kommer att göra monteringen på olika enheter eller olika NFS-servrar parallellt. Fördelen med detta är att det är snabbare; även NFS-timeouts sker parallellt. En nackdel är att ordningen på mount-operationerna är odefinierad. Därför kan du inte använda den här flaggan om du vill montera både _/usr_ och _/usr/spool_."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-f, --fake*"
msgstr "*-f, --fake*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Causes everything to be done except for the mount-related system calls. The *--fake* option was originally designed to write an entry to _/etc/mtab_ without actually mounting."
msgstr "Gör att allt görs utom de mount-relaterade systemanropen. Flaggan *--fake* utformades ursprungligen för att skriva en post till _/etc/mtab_ utan att faktiskt montera."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The _/etc/mtab_ is no longer maintained in userspace, and starting from version 2.39, the mount operation can be a complex chain of operations with dependencies between the syscalls. The *--fake* option forces libmount to skip all mount source preparation, mount option analysis, and the actual mounting process."
msgstr "_/etc/mtab_ underhålls inte längre i userspace, och från och med version 2.39 kan monteringen vara en komplex kedja av operationer med beroenden mellan syscalls. Flaggan *--fake* tvingar libmount att hoppa över all förberedelse av monteringskällan, analys av monteringsflaggor och den faktiska monteringsprocessen."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The difference between fake and non-fake execution is huge. This is the reason why the *--fake* option has minimal significance for the current *mount*(8) implementation and it is maintained mostly for backward compatibility."
msgstr "Skillnaden mellan falsk och icke-falsk exekvering är enorm. Detta är anledningen till att flaggan *--fake* har minimal betydelse för den aktuella implementeringen av *mount*(8) och att det mest bibehålls för bakåtkompatibilitet."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-i, --internal-only*"
msgstr "*-i, --internal-only*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Don't call the **/sbin/mount.**__filesystem__ helper even if it exists."
msgstr "Anropa inte hjälpen **/sbin/mount.**__filsystem__ även om den finns."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Mount the partition that has the specified _label_."
msgstr "Montera den partition som har den angivna _etikett_."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-l*, *--show-labels*"
msgstr "*-l*, *--show-labels*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Add the labels in the mount output. *mount* must have permission to read the disk device (e.g. be set-user-ID root) for this to work. One can set such a label for ext2, ext3 or ext4 using the *e2label*(8) utility, or for XFS using *xfs_admin*(8), or for reiserfs using *reiserfstune*(8)."
msgstr "Lägg till etiketterna i mount-utdata. *mount* måste ha behörighet att läsa diskenheten (t.ex. vara set-user-ID root) för att detta ska fungera. Man kan ange en sådan etikett för ext2, ext3 eller ext4 med hjälp av verktyget *e2label*(8), för XFS med *xfs_admin*(8) eller för reiserfs med *reiserfstune*(8)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-M*, *--move*"
msgstr "*-M*, *--move*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Move a subtree to some other place. See above, the subsection *The move operation*."
msgstr "Flytta ett delträd till någon annan plats. Se ovan, underavsnittet *Flyttoperationen*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-m*, *--mkdir*[**=**__mode__]"
msgstr "*-m*, *--mkdir*[**=**__läge__]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Allow to make a target directory (mountpoint) if it does not exist yet. Alias to \"-o X-mount.mkdir[=mode]\", the default mode is 0755. For more details see *X-mount.mkdir* below."
msgstr "Gör det möjligt att skapa en målkatalog (mountpoint) om den inte finns ännu. Alias till \"-o X-mount.mkdir[=mode]\", standardläget är 0755. För mer information se *X-mount.mkdir* nedan."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--map-groups*, *--map-users* _inner_:_outer_:_count_"
msgstr "*--map-groups*, *--map-users* _inner_:_outer_:_count_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Add the specified user/group mapping to an *X-mount.idmap* map. These options can be given multiple times to build up complete mappings for users and groups. For more details see *X-mount.idmap* below."
msgstr "Lägg till den angivna mappningen för användare/grupper till en *X-mount.idmap*-mappning. Dessa flaggor kan anges flera gånger för att bygga upp kompletta mappningar för användare och grupper. För mer information se *X-mount.idmap* nedan."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--map-users* /proc/_PID_/ns/user"
msgstr "*--map-users* /proc/_PID_/ns/user"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Use the specified user namespace for user and group mapping in an id-mapped mount. This is an alias for \"-o X-mount.idmap=/proc/_PID_/ns/user\" and cannot be used twice nor together with the _inner_:_outer_:_count_ option format above. For more details see *X-mount.idmap* below."
msgstr "Använd det angivna användarnamnområdet för mappning av användare och grupper i en id-mappad montering. Detta är ett alias för \"-o X-mount.idmap=/proc/_PID_/ns/user\" och kan inte användas två gånger eller tillsammans med flaggformatet _inner_:_outer_:_count_ ovan. För mer information se *X-mount.idmap* nedan."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-n*, *--no-mtab*"
msgstr "*-n*, *--no-mtab*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Mount without writing in _/etc/mtab_. This is necessary for example when _/etc_ is on a read-only filesystem."
msgstr "Montera utan att skriva i _/etc/mtab_. Detta är nödvändigt t.ex. när _/etc_ finns på ett skrivskyddat filsystem."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-N*, *--namespace* _ns_"
msgstr "*-N*, *--namespace* _ns_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Perform the mount operation in the mount namespace specified by _ns_. _ns_ is either PID of process running in that namespace or special file representing that namespace."
msgstr "Utför mount-operationen i det mount-namnområde som anges av _ns_. _ns_ är antingen PID för en process som körs i det namnområdet eller en speciell fil som representerar det namnområdet."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*mount* switches to the mount namespace when it reads _/etc/fstab_, writes _/etc/mtab: (or writes to _/run/mount_) and calls *mount*(2), otherwise it runs in the original mount namespace. This means that the target namespace does not have to contain any libraries or other requirements necessary to execute the *mount*(2) call."
msgstr "*mount* växlar till mount-namnrymden när den läser _/etc/fstab_, skriver _/etc/mtab: (eller skriver till _/run/mount_) och anropar *mount*(2), annars körs den i det ursprungliga mount-namnområdet. Detta innebär att målnamnrymden inte behöver innehålla några bibliotek eller andra krav som är nödvändiga för att utföra *mount*(2)-anropet."

#. from tp:util-linux-man-2.41.2-rc1
msgid "See *mount_namespaces*(7) for more information."
msgstr "Se *mount_namespaces*(7) för mer information."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-O*, *--test-opts* _opts_"
msgstr "*-O*, *--test-opts* _opts_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Limit the set of filesystems to which the *-a* option applies. In this regard it is like the *-t* option except that *-O* is useless without *-a*. For example, the command"
msgstr "Begränsa uppsättningen av filsystem som flaggan *-a* gäller för. I det här avseendet är det som flaggan *-t*, förutom att *-O* är värdelöst utan *-a*. Till exempel kan kommandot"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*mount -a -O no_netdev*"
msgstr "*montera -a -O no_netdev*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "mounts all filesystems except those which have the option _netdev_ specified in the options field in the _/etc/fstab_ file."
msgstr "monterar alla filsystem utom de som har flaggan _netdev_ angivet i fältet options i filen _/etc/fstab_."

#. from tp:util-linux-man-2.41.2-rc1
msgid "It is different from *-t* in that each option is matched exactly; a leading *no* at the beginning of one option does not negate the rest."
msgstr "Det skiljer sig från *-t* genom att varje flagga matchas exakt; ett inledande *no* i början av en flagga upphäver inte resten."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The *-t* and *-O* options are cumulative in effect; that is, the command"
msgstr "Flaggorna *-t* och *-O* har kumulativ effekt, vilket innebär att kommandot"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*mount -a -t ext2 -O _netdev*"
msgstr "*mount -a -t ext2 -O _netdev*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "mounts all ext2 filesystems with the _netdev option, not all filesystems that are either ext2 or have the _netdev option specified."
msgstr "monterar alla ext2-filsystem med flaggan _netdev, men inte alla filsystem som antingen är ext2 eller har flaggan _netdev angivet."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-o*, *--options* _opts_"
msgstr "*-o*, *--options* _opts_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Use the specified mount options. The _opts_ argument is a comma-separated list. For example:"
msgstr "Använd de angivna monteringsflaggorna. Argumentet _opts_ är en kommaseparerad lista. Till exempel: _opts_:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*mount LABEL=mydisk -o noatime,nodev,nosuid*"
msgstr "*mount LABEL=mydisk -o noatime,nodev,nosuid*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Note that the order of the options matters, as the last option wins if there are conflicting ones. The options from the command line also overwrite options from fstab by default."
msgstr "Observera att ordningen på flaggorna är viktig, eftersom det sista flaggan vinner om det finns motstridiga flaggor. Flaggorna från kommandoraden skriver också över flaggor från fstab som standard."

#. from tp:util-linux-man-2.41.2-rc1
msgid "For more details, see the *FILESYSTEM-INDEPENDENT MOUNT OPTIONS* and *FILESYSTEM-SPECIFIC MOUNT OPTIONS* sections."
msgstr "Mer information finns i avsnitten *FILESYSTEM-INDEPENDENT MOUNT OPTIONS* och *FILESYSTEM-SPECIFIC MOUNT OPTIONS*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--onlyonce*"
msgstr "*--onlyonce*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Forces *mount* command to check if the filesystem is already mounted. This behavior is the default for *--all*; otherwise, it depends on the kernel filesystem driver. Some filesystems may be mounted more than once on the same mount point (e.g. tmpfs)."
msgstr "Tvingar kommandot *mount* att kontrollera om filsystemet redan är monterat. Detta beteende är standard för *--all*; annars beror det på filsystemdrivrutinen i kärnan. Vissa filsystem kan vara monterade mer än en gång på samma monteringspunkt (t.ex. tmpfs)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--options-mode* _mode_"
msgstr "*--options-mode* _läge_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Controls how to combine options from _fstab_/_mtab_ with options from the command line. _mode_ can be one of *ignore*, *append*, *prepend* or *replace*. For example, *append* means that options from _fstab_ are appended to options from the command line. The default value is *prepend* -- it means command line options are evaluated after _fstab_ options. Note that the last option wins if there are conflicting ones."
msgstr "Styr hur flaggor från _fstab_/_mtab_ ska kombineras med flaggor från kommandoraden. _läge_ kan vara något av *ignore*, *append*, *prepend* eller *replace*. Exempelvis innebär *append* att flaggor från _fstab_ läggs till flaggor från kommandoraden. Standardvärdet är *prepend* - det innebär att flaggor på kommandoraden utvärderas efter flaggor i _fstab_. Observera att det sista flaggan vinner om det finns motstridiga flaggor."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--options-source* _source_"
msgstr "*--options-source* _source_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Source of default options. _source_ is a comma-separated list of *fstab*, *mtab* and *disable*. *disable* disables *fstab* and *mtab* and enables *--options-source-force*. The default value is *fstab,mtab*."
msgstr "Källa för standardflaggor. _source_ är en kommaseparerad lista med *fstab*, *mtab* och *disable*. *disable* inaktiverar *fstab* och *mtab* och aktiverar *--options-source-force*. Standardvärdet är *fstab,mtab*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--options-source-force*"
msgstr "*--options-source-force*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Use options from _fstab_/_mtab_ even if both _device_ and _dir_ are specified."
msgstr "Använd flaggor från _fstab_/_mtab_ även om både _enhet_ och _dir_ har angetts."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-R*, *--rbind*"
msgstr "*-R*, *--rbind*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Remount a subtree and all possible submounts somewhere else (so that its contents are available in both places). See above, the subsection *Bind mount operation*."
msgstr "Montera om ett delträd och alla möjliga undermonterade träd någon annanstans (så att innehållet är tillgängligt på båda ställena). Se ovan, underavsnittet *Bind mount operation*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Mount the filesystem read-only. A synonym is *-o ro*."
msgstr "Montera filsystemet skrivskyddat. En synonym är *-o ro*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Note that, depending on the filesystem type, state and kernel behavior, the system may still write to the device. For example, ext3 and ext4 will replay the journal if the filesystem is dirty. To prevent this kind of write access, you may want to mount an ext3 or ext4 filesystem with the *ro,noload* mount options or set the block device itself to read-only mode, see the *blockdev*(8) command."
msgstr "Observera att beroende på filsystemets typ, tillstånd och kärnans beteende kan systemet fortfarande skriva till enheten. Till exempel kommer ext3 och ext4 att spela upp journalen igen om filsystemet är smutsigt. För att förhindra den här typen av skrivåtkomst kan du montera ett ext3- eller ext4-filsystem med monteringsflaggan *ro,noload* eller ställa in blockenheten i skrivskyddat läge, se kommandot *blockdev*(8)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Tolerate sloppy mount options rather than failing. This will ignore mount options not supported by a filesystem type. Not all filesystems support this option. Currently it's supported by the *mount.nfs* mount helper only."
msgstr "Tolererar slarviga monteringsflaggor i stället för att misslyckas. Detta ignorerar monteringsflaggor som inte stöds av en filsystemtyp. Inte alla filsystem stöder denna flagga. För närvarande stöds det endast av monteringshjälpen *mount.nfs*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--source* _device_"
msgstr "*--source* _enhet_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "If only one argument for the *mount* command is given, then the argument might be interpreted as the target (mountpoint) or source (device). This option allows you to explicitly define that the argument is the mount source."
msgstr "Om endast ett argument för kommandot *mount* anges kan argumentet tolkas som mål (mountpoint) eller källa (enhet). Med denna flagga kan du uttryckligen definiera att argumentet är mount-källan."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--target* _directory_"
msgstr "*--target* _katalog_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "If only one argument for the mount command is given, then the argument might be interpreted as the target (mountpoint) or source (device). This option allows you to explicitly define that the argument is the mount target."
msgstr "Om endast ett argument för mount-kommandot anges kan argumentet tolkas som mål (mountpoint) eller källa (device). Med denna flagga kan du uttryckligen definiera att argumentet är mount-målet."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--target-prefix* _directory_"
msgstr "*--target-prefix* _katalog_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Prepend the specified directory to all mount targets. This option can be used to follow _fstab_, but mount operations are done in another place, for example:"
msgstr "Lägg till den angivna katalogen i alla monteringsmål. Den här flaggan kan användas för att följa _fstab_, men monteringsoperationer görs t.ex. på ett annat ställe:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*mount --all --target-prefix /chroot -o X-mount.mkdir*"
msgstr "*mount --all --målprefix /chroot -o X-mount.mkdir*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "mounts all from system _fstab_ to _/chroot_, all missing mountpoint are created (due to X-mount.mkdir). See also *--fstab* to use an alternative _fstab_."
msgstr "monterar allt från system _fstab_ till _/chroot_, alla saknade monteringspunkter skapas (på grund av X-mount.mkdir). Se även *--fstab* för att använda en alternativ _fstab_."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-T*, *--fstab* _path_"
msgstr "*-T*, *--fstab* _sökväg_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Specifies an alternative _fstab_ file. If _path_ is a directory, then the files in the directory are sorted by *strverscmp*(3); files that start with \".\" or without an _.fstab_ extension are ignored. The option can be specified more than once. This option is mostly designed for initramfs or chroot scripts where additional configuration is specified beyond standard system configuration."
msgstr "Anger en alternativ _fstab_-fil. Om _sökväg_ är en katalog sorteras filerna i katalogen enligt *strverscmp*(3); filer som börjar med \".\" eller som saknar tillägget _.fstab_ ignoreras. Flaggan kan anges mer än en gång. Den här flaggan är främst avsett för initramfs- eller chroot-skript där ytterligare konfiguration anges utöver standardkonfigurationen för systemet."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Note that *mount* does not pass the option *--fstab* to the **/sbin/mount.**__type__ helpers, meaning that the alternative _fstab_ files will be invisible for the helpers. This is no problem for normal mounts, but user (non-root) mounts always require _fstab_ to verify the user's rights."
msgstr "Observera att *mount* inte skickar flaggan *--fstab* till hjälpprogrammen **/sbin/mount.**__typ__, vilket innebär att de alternativa _fstab_-filerna kommer att vara osynliga för hjälpprogrammen. Detta är inget problem för normala monteringar, men användarmonteringar (icke-root) kräver alltid _fstab_ för att verifiera användarens rättigheter."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-t*, *--types* _fstype_"
msgstr "*-t*, *--types* _fstype_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "The argument following the *-t* is used to indicate the filesystem type. The filesystem types which are currently supported depend on the running kernel. See _/proc/filesystems_ and _/lib/modules/$(uname -r)/kernel/fs_ for a complete list of the filesystems. The most common are ext2, ext3, ext4, xfs, btrfs, vfat, sysfs, proc, nfs and cifs."
msgstr "Argumentet efter *-t* används för att ange filsystemtypen. Vilka filsystemtyper som för närvarande stöds beror på vilken kärna som körs. Se _/proc/filesystems_ och _/lib/modules/$(uname -r)/kernel/fs_ för en fullständig lista över filsystem. De vanligaste är ext2, ext3, ext4, xfs, btrfs, vfat, sysfs, proc, nfs och cifs."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The programs *mount* and *umount*(8) support filesystem subtypes. The subtype is defined by a '.subtype' suffix. For example 'fuse.sshfs'. It's recommended to use subtype notation rather than add any prefix to the mount source (for example 'sshfs#example.com' is deprecated)."
msgstr "Programmen *mount* och *umount*(8) stöder subtyper av filsystem. Subtypen definieras av suffixet '.subtype'. Till exempel 'fuse.sshfs'. Vi rekommenderar att du använder subtypsnotation i stället för att lägga till något prefix till mount-källan (till exempel 'sshfs#example.com' är föråldrat)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "If no *-t* option is given, or if the *auto* type is specified, *mount* will try to guess the desired type. *mount* uses the *libblkid*(3) library for guessing the filesystem type; if that does not turn up anything that looks familiar, *mount* will try to read the file _/etc/filesystems_, or, if that does not exist, _/proc/filesystems_. All of the filesystem types listed there will be tried, except for those that are labeled \"nodev\" (e.g. _devpts_, _proc_ and _nfs_). If _/etc/filesystems_ ends in a line with a single {asterisk}, mount will read _/proc/filesystems_ afterwards. While trying, all filesystem types will be mounted with the mount option *silent*."
msgstr "Om ingen *-t*-flagga anges, eller om *auto*-typen anges, kommer *mount* att försöka gissa sig till önskad typ. *mount* använder biblioteket *libblkid*(3) för att gissa filsystemtypen; om det inte ger något som ser bekant ut försöker *mount* läsa filen _/etc/filesystems_ eller, om den inte finns, _/proc/filesystems_. Alla filsystemtyper som listas där kommer att provas, utom de som är märkta \"nodev\" (t.ex. _devpts_, _proc_ och _nfs_). Om _/etc/filesystems_ slutar på en rad med ett enda {asterisk} kommer mount att läsa _/proc/filesystems_ efteråt. Under försöket kommer alla filsystemtyper att monteras med mount-flaggan *silent*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The *auto* type may be useful for user-mounted floppies. Creating a file _/etc/filesystems_ can be useful to change the probe order (e.g., to try vfat before msdos or ext3 before ext2) or if you use a kernel module autoloader."
msgstr "Typen *auto* kan vara användbar för disketter som monterats av användaren. Att skapa en fil _/etc/filesystems_ kan vara användbart för att ändra probeordningen (t.ex. för att prova vfat före msdos eller ext3 före ext2) eller om du använder en autoladdare för kärnmoduler."

#. from tp:util-linux-man-2.41.2-rc1
msgid "More than one type may be specified in a comma-separated list, for the *-t* option as well as in an _/etc/fstab_ entry. The list of filesystem types for the *-t* option can be prefixed with *no* to specify the filesystem types on which no action should be taken. The prefix *no* has no effect when specified in an _/etc/fstab_ entry."
msgstr "Mer än en typ kan anges i en kommaseparerad lista, både för flaggan *-t* och i en post i _/etc/fstab_. Listan med filsystemtyper för flaggan *-t* kan föregås av *no* för att ange filsystemtyper som inte ska åtgärdas. Prefixet *no* har ingen effekt när det anges i en post i _/etc/fstab_."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The prefix *no* can be meaningful with the *-a* option. For example, the command"
msgstr "Prefixet *no* kan vara meningsfullt med flaggan *-a*. Till exempel kommandot"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*mount -a -t nomsdos,smbfs*"
msgstr "*mount -a -t nomsdos,smbfs*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "mounts all filesystems except those of type _msdos_ and _smbfs_."
msgstr "monterar alla filsystem utom de av typen _msdos_ och _smbfs_."

#. from tp:util-linux-man-2.41.2-rc1
msgid "For most types all the *mount* program has to do is issue a simple *mount*(2) system call, and no detailed knowledge of the filesystem type is required. For a few types however (like nfs, nfs4, cifs, smbfs, ncpfs) an ad hoc code is necessary. The nfs, nfs4, cifs, smbfs, and ncpfs filesystems have a separate mount program. In order to make it possible to treat all types in a uniform way, *mount* will execute the program **/sbin/mount.**__type__ (if that exists) when called with type _type_. Since different versions of the *smbmount* program have different calling conventions, */sbin/mount.smbfs* may have to be a shell script that sets up the desired call."
msgstr "För de flesta typer behöver *mount*-programmet bara göra ett enkelt *mount*(2)-systemanrop, och det krävs ingen detaljerad kunskap om filsystemtypen. För ett fåtal typer (som nfs, nfs4, cifs, smbfs, ncpfs) krävs dock en ad hoc-kod. Filsystemen nfs, nfs4, cifs, smbfs och ncpfs har ett separat monteringsprogram. För att göra det möjligt att behandla alla typer på ett enhetligt sätt kommer *mount* att köra programmet **/sbin/mount.**__typ__ (om det finns) när det anropas med typen _typ_. Eftersom olika versioner av programmet *smbmount* har olika anropskonventioner kan */sbin/mount.smbfs* behöva vara ett skalskript som ställer in det önskade anropet."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Mount the partition that has the specified _uuid_."
msgstr "Montera den partition som har den angivna _uuid_."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Enables verbose mode. Starting from version 2.41, if the new kernel mount API is available, it will also print kernel info messages."
msgstr "Aktiverar utförligt läge. Från och med version 2.41, om det nya kernel mount API:et är tillgängligt, skrivs även kernel info-meddelanden ut."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-w*, *--rw*, *--read-write*"
msgstr "*-w*, *--rw*, *--read-write*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Mount the filesystem read/write. Read-write is the kernel default and the *mount* default is to try read-only if the previous *mount*(2) syscall with read-write flags on write-protected devices failed."
msgstr "Montera filsystemet läs/skriv. Read-write är kärnans standard och *mount* standard är att försöka med read-only om föregående *mount*(2) syscall med read-write flaggor på skrivskyddade enheter misslyckades."

#. from tp:util-linux-man-2.41.2-rc1
msgid "A synonym is *-o rw*."
msgstr "En synonym är *-o rw*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Note that specifying *-w* on the command line forces *mount* to never try read-only mount on write-protected devices or already mounted read-only filesystems."
msgstr "Observera att om du anger *-w* på kommandoraden tvingar du *mount* att aldrig försöka montera skrivskyddat på skrivskyddade enheter eller redan monterade skrivskyddade filsystem."

#. from tp:util-linux-man-2.41.2-rc1
msgid "FILESYSTEM-INDEPENDENT MOUNT OPTIONS"
msgstr "FILSYSTEMSOBEROENDE MONTERINGSFLAGGOR"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Some of these options are only useful when they appear in the _/etc/fstab_ file."
msgstr "Vissa av dessa flaggor är bara användbara när de finns i filen _/etc/fstab_."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Some of these options could be enabled or disabled by default in the system kernel. To check the current setting see the options in _/proc/mounts_. Note that filesystems also have per-filesystem specific default mount options (see for example *tune2fs -l* output for ext__N__ filesystems)."
msgstr "Vissa av dessa flaggor kan vara aktiverade eller inaktiverade som standard i systemkärnan. För att kontrollera den aktuella inställningen, se flaggorna i _/proc/mounts_. Observera att filsystem också har filsystemspecifika standardmonteringsflaggor (se t.ex. *tune2fs -l*-utdata för ext__N__-filsystem)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Virtual Filesystem Notes"
msgstr "Virtuella filsystem Anmärkningar"

#. from tp:util-linux-man-2.41.2-rc1
msgid "The Virtual File System (VFS) is the abstract layer in the kernel that provides the filesystem interface to userspace programs. It also provides an abstraction within the kernel which allows different filesystem implementations to coexist. Some of the mount options only apply to this layer."
msgstr "Virtual File System (VFS) är det abstrakta lagret i kärnan som tillhandahåller filsystemgränssnittet till program i användarutrymmet. Det tillhandahåller också en abstraktion inom kärnan som gör det möjligt för olika filsystemimplementeringar att samexistera. Vissa av monteringsflaggor gäller endast för detta lager."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The options *nosuid*, *noexec*, *nodiratime*, *relatime*, *noatime*, *strictatime*, and *nosymfollow* are interpreted only by the virtual-filesystem kernel layer and are applied to the mountpoint node rather than to the filesystem itself. To get a complete overview of filesystems and VFS options, try:"
msgstr "Flaggorna *nosuid*, *noexec*, *nodiratime*, *relatime*, *noatime*, *strictatime* och *nosymfollow* tolkas endast av det virtuella filsystemets kärnlager och tillämpas på monteringspunktsnoden snarare än på själva filsystemet. För att få en fullständig översikt över filsystem och VFS-flaggor, prova:"

#. from tp:util-linux-man-2.41.2-rc1
msgid " findmnt -o TARGET,VFS-OPTIONS,FS-OPTIONS\n"
msgstr " findmnt -o TARGET,VFS-OPTIONS,FS-OPTIONS\n"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Since v2.39, libmount can use a new kernel mount interface to set the VFS attributes recursively. For backward compatibility, this feature is not enabled by default, even if recursive operation (e.g. rbind) has been requested. The new option argument \"recursive\" can be specified, for example:"
msgstr "Sedan v2.39 kan libmount använda ett nytt kernel mount-gränssnitt för att ställa in VFS-attributen rekursivt. För bakåtkompatibilitet är den här funktionen inte aktiverad som standard, även om en rekursiv operation (t.ex. rbind) har begärts. Det nya flaggargumentet \"recursive\" kan anges, till exempel:"

#. from tp:util-linux-man-2.41.2-rc1
msgid " mount -orbind,ro=recursive,noexec=recursive,nosuid /foo /bar\n"
msgstr " mount -orbind,ro=recursive,noexec=recursive,nosuid /foo /bar\n"

#. from tp:util-linux-man-2.41.2-rc1
msgid "This recursively binds filesystems from /foo to /bar, making /bar and all submounts read-only and noexec, but only /bar itself will be \"nosuid\". The \"recursive\" optional argument for VFS mount options is an EXPERIMENTAL feature."
msgstr "Detta binder rekursivt filsystem från /foo till /bar, vilket gör /bar och alla undermonteringar skrivskyddade och noexec, men endast /bar själv kommer att vara \"nosuid\". Det valfria argumentet \"recursive\" för VFS-monteringsflaggor är en EXPERIMENTELL funktion."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Read-only Setting Notes"
msgstr "Skrivskyddad Inställning Anmärkningar"

#. from tp:util-linux-man-2.41.2-rc1
msgid "The read-only setting (*ro* or *rw*) is interpreted by the virtual-filesystem and the filesystem, and it depends on how the option is specified on the *mount*(8) command line. For backward compatibility, the default is to use it for both layers during standard mount operations."
msgstr "Den skrivskyddade inställningen (*ro* eller *rw*) tolkas av det virtuella filsystemet och filsystemet, och beror på hur flaggan anges på kommandoraden *mount*(8). För bakåtkompatibilitet är standardinställningen att använda det för båda lagren under standardmonteringsoperationer."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The operation \"-o bind,remount,ro\" is applied only to the VFS mountpoint, while the operation \"-o remount,ro\" is applied to both the VFS and filesystem superblock.  This semantic allows for the creation of a read-only mountpoint while keeping the filesystem writable from another mountpoint."
msgstr "Operationen \"-o bind,remount,ro\" tillämpas endast på VFSmonteringspunkten, medan operationen \"-o remount,ro\" tillämpas på både VFS och filsystemets superblock.  Denna semantik gör det möjligt att skapa en skrivskyddad monteringspunkt samtidigt som filsystemet är skrivbart från en annan monteringspunkt."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Since version 2.41, libmount has the ability to use optional arguments _vfs_ and _fs_ (e.g. ro=fs) to specify where the read-only setting should be applied.  For example, using the command:"
msgstr "Sedan version 2.41 har libmount möjlighet att använda de valfria argumenten _vfs_ och _fs_ (t.ex. ro=fs) för att ange var inställningen för skrivskydd ska tillämpas.  Till exempel genom att använda kommandot:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "mount -o ro=vfs /dev/sdc1 /A"
msgstr "mount -o ro=vfs /dev/sdc1 /A"

#. from tp:util-linux-man-2.41.2-rc1
msgid "will mount the filesystem as read-write on the superblock level, but the /A node will be set as read-only. In previous versions, this required an additional \"-o bind,remount,ro\" operation to achieve the same result."
msgstr "kommer att montera filsystemet som skrivläsning på superblocknivå, men /A-noden kommer att ställas in som skrivskyddad. I tidigare versioner krävdes det ytterligare en operation \"-o bind,remount,ro\" för att uppnå samma resultat."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Generic Mount Options"
msgstr "Allmänna monteringsflaggor"

#. from tp:util-linux-man-2.41.2-rc1
msgid "The following options apply to any filesystem that is being mounted, but not every filesystem actually honors them. For example, the *sync* option only has an effect on ext2, ext3, ext4, fat, vfat, ufs, and xfs filesystems."
msgstr "Följande flaggor gäller för alla filsystem som monteras, men det är inte alla filsystem som faktiskt uppfyller dem. Till exempel har flaggan *sync* endast effekt på filsystem av typen ext2, ext3, ext4, fat, vfat, ufs och xfs."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*async*"
msgstr "*async*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "All I/O to the filesystem should be done asynchronously. (See also the *sync* option.)"
msgstr "Alla I/O till filsystemet bör göras asynkront. (Se även flaggan *sync*.)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*atime*"
msgstr "*atime*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Do not use the *noatime* feature, so the inode access time is controlled by kernel defaults. See also the descriptions of the *relatime* and *strictatime* mount options."
msgstr "Använd inte funktionen *noatime*, så styrs inodens åtkomsttid av kärnans standardvärden. Se även beskrivningarna av monteringsflaggorna *relatime* och *strictatime*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*noatime*"
msgstr "*ingen tid*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Do not update inode access times on this filesystem (e.g. for faster access on the news spool to speed up news servers). This works for all inode types (directories too), so it implies *nodiratime*."
msgstr "Uppdatera inte åtkomsttider för inoder i det här filsystemet (t.ex. för snabbare åtkomst på nyhetspoolen för att snabba upp nyhetsservrar). Detta fungerar för alla inodtyper (även kataloger), så det innebär *nodiratime*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*auto*"
msgstr "*auto*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Can be mounted with the *-a* option."
msgstr "Kan monteras med tillvalet *-a*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Can only be mounted explicitly (i.e., the *-a* option will not cause the filesystem to be mounted)."
msgstr "Kan endast monteras explicit (dvs. flaggan *-a* kommer inte att leda till att filsystemet monteras)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "**context=**__context__, **fscontext=**__context__, **defcontext=**__context__, and **rootcontext=**__context__"
msgstr "**context=**__kontext__, **fscontext=**__kontext__, **defcontext=**__kontext__, and **rootcontext=**__kontext__"

#. from tp:util-linux-man-2.41.2-rc1
msgid "The *context=* option is useful when mounting filesystems that do not support extended attributes, such as a floppy or hard disk formatted with VFAT, or systems that are not normally running under SELinux, such as an ext3 or ext4 formatted disk from a non-SELinux workstation. You can also use *context=* on filesystems you do not trust, such as a floppy. It also helps in compatibility with xattr-supporting filesystems on earlier 2.4.<x> kernel versions. Even where xattrs are supported, you can save time not having to label every file by assigning the entire disk one security context."
msgstr "Flaggan *context=* är användbart vid montering av filsystem som inte stöder utökade attribut, t.ex. en diskett eller hårddisk formaterad med VFAT, eller system som normalt inte körs under SELinux, t.ex. en ext3- eller ext4-formaterad disk från en arbetsstation som inte använder SELinux. Du kan också använda *context=* på filsystem som du inte litar på, t.ex. en diskett. Det hjälper också till med kompatibiliteten med xattr-stödda filsystem på tidigare 2.4.<x> kärnversioner. Även där xattrs stöds kan du spara tid genom att inte behöva märka varje fil genom att tilldela hela disken en säkerhetskontext."

#. from tp:util-linux-man-2.41.2-rc1
msgid "A commonly used option for removable media is *context=\"system_u:object_r:removable_t*."
msgstr "En vanlig flagga för flyttbara media är *context=\"system_u:object_r:removable_t*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The *fscontext=* option works for all filesystems, regardless of their xattr support. The fscontext option sets the overarching filesystem label to a specific security context. This filesystem label is separate from the individual labels on the files. It represents the entire filesystem for certain kinds of permission checks, such as during mount or file creation. Individual file labels are still obtained from the xattrs on the files themselves. The context option actually sets the aggregate context that fscontext provides, in addition to supplying the same label for individual files."
msgstr "Flaggan *fscontext=* fungerar för alla filsystem, oavsett om de har stöd för xattr eller inte. Flaggan fscontext anger den övergripande filsystemetiketten till ett specifikt säkerhetssammanhang. Denna filsystemetikett är skild från de enskilda etiketter som finns på filerna. Den representerar hela filsystemet vid vissa typer av behörighetskontroller, t.ex. vid montering eller filskapande. Enskilda filers etiketter erhålls fortfarande från xattrs på själva filerna. Flaggan context ställer faktiskt in det aggregerade sammanhang som fscontext tillhandahåller, förutom att tillhandahålla samma etikett för enskilda filer."

#. from tp:util-linux-man-2.41.2-rc1
msgid "You can set the default security context for unlabeled files using *defcontext=* option. This overrides the value set for unlabeled files in the policy and requires a filesystem that supports xattr labeling."
msgstr "Du kan ange standardsäkerhetskontext för omärkta filer med hjälp av flaggan *defcontext=*. Detta åsidosätter det värde som anges för omärkta filer i policyn och kräver ett filsystem som stöder xattr-märkning."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The *rootcontext=* option allows you to explicitly label the root inode of a FS being mounted before that FS or inode becomes visible to userspace. This was found to be useful for things like stateless Linux. The special value *@target* can be used to assign the current context of the target mountpoint location."
msgstr "Med flaggan *rootcontext=* kan du uttryckligen märka rotinoden för en FS som monteras innan FS eller inoden blir synlig för userspace. Detta har visat sig vara användbart för saker som statslös Linux. Specialvärdet *@target* kan användas för att tilldela den aktuella kontexten för målets monteringspunkt."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Note that the kernel rejects any remount request that includes the context option, *even* when unchanged from the current context."
msgstr "Observera att kärnan avvisar varje begäran om återmontering som innehåller kontextflaggan, *även* om det är oförändrat från den aktuella kontexten."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*Warning: the* _context_ *value might contain commas*, in which case the value has to be properly quoted, otherwise *mount* will interpret the comma as a separator between mount options. Don't forget that the shell strips off quotes and thus *double quoting is required*. For example:"
msgstr "*Varning: värdet* _kontext_ *kan innehålla kommatecken*, och i så fall måste värdet citeras korrekt, annars tolkar *mount* kommatecknet som en separator mellan monteringsflaggor. Glöm inte att skalet tar bort citattecken och därför *krävs dubbla citattecken*. Till exempel:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "mount -t tmpfs none /mnt -o \\\n'context=\"system_u:object_r:tmp_t:s0:c127,c456\",noexec'\n"
msgstr "mount -t tmpfs none /mnt -o \\\n'context=\"system_u:object_r:tmp_t:s0:c127,c456\",noexec'\n"

#. from tp:util-linux-man-2.41.2-rc1
msgid "For more details, see *selinux*(8)."
msgstr "För mer information, se *selinux*(8)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Use the default options: *rw*, *suid*, *dev*, *exec*, *auto*, *nouser*, and *async*."
msgstr "Använd standardflaggorna: *rw*, *suid*, *dev*, *exec*, *auto*, *nouser* och *async*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Note that the real set of all default mount options depends on the kernel and filesystem type. See the beginning of this section for more details."
msgstr "Observera att den verkliga uppsättningen av alla standardmonteringsflaggor beror på kärnan och filsystemets typ. Se början av det här avsnittet för mer information."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*dev*"
msgstr "*dev*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Interpret character or block special devices on the filesystem."
msgstr "Tolka tecken- eller blockspecifika enheter i filsystemet."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*nodev*"
msgstr "*nodev*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Do not interpret character or block special devices on the filesystem."
msgstr "Tolka inte tecken eller blockera specialenheter i filsystemet."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*diratime*"
msgstr "*diratime*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Update directory inode access times on this filesystem. This is the default. (This option is ignored when *noatime* is set.)"
msgstr "Uppdatera katalogens inodeåtkomsttider på detta filsystem. Detta är standardinställningen. (Denna flagga ignoreras när *noatime* är angivet)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*nodiratime*"
msgstr "*nodiratime*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Do not update directory inode access times on this filesystem. (This option is implied when *noatime* is set.)"
msgstr "Uppdatera inte åtkomsttider för kataloginoder på det här filsystemet. (Denna flagga är underförstått när *noatime* är angivet)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*dirsync*"
msgstr "*dirsync*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "All directory updates within the filesystem should be done synchronously. This affects the following system calls: *creat*(2), *link*(2), *unlink*(2), *symlink*(2), *mkdir*(2), *rmdir*(2), *mknod*(2) and *rename*(2)."
msgstr "Alla kataloguppdateringar inom filsystemet bör göras synkront. Detta påverkar följande systemanrop: *creat*(2), *link*(2), *unlink*(2), *symlink*(2), *mkdir*(2), *rmdir*(2), *mknod*(2) och *rename*(2)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*exec*"
msgstr "*exec*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Permit execution of binaries and other executable files."
msgstr "Tillåt körning av binära filer och andra körbara filer."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*noexec*"
msgstr "*noexec*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Do not permit direct execution of any binaries on the mounted filesystem."
msgstr "Tillåt inte direkt exekvering av några binärfiler på det monterade filsystemet."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*group*"
msgstr "*group*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Allow an ordinary user to mount the filesystem if one of that user's groups matches the group of the device. This option implies the options *nosuid* and *nodev* (unless overridden by subsequent options, as in the option line *group,dev,suid*)."
msgstr "Tillåter en vanlig användare att montera filsystemet om en av användarens grupper matchar enhetens grupp. Denna flagga innebär flaggorna *nosuid* och *nodev* (om de inte åsidosätts av efterföljande flaggor, som i flaggraden *group,dev,suid*)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*iversion*"
msgstr "*iversion*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Every time the inode is modified, the i_version field will be incremented."
msgstr "Varje gång inoden ändras kommer fältet i_version att inkrementeras."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*noiversion*"
msgstr "*noiversion*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Do not increment the i_version inode field."
msgstr "Inkrementera inte inodefältet i_version."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*mand*"
msgstr "*mand*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Allow mandatory locks on this filesystem. See *fcntl*(2). This option was deprecated in Linux 5.15."
msgstr "Tillåt obligatoriska lås på detta filsystem. Se *fcntl*(2). Denna flagga uteslöts i Linux 5.15."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*nomand*"
msgstr "*nomand*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Do not allow mandatory locks on this filesystem."
msgstr "Tillåt inte obligatoriska lås på detta filsystem."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*_netdev*"
msgstr "*_netdev*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "The filesystem resides on a device that requires network access (used to prevent the system from attempting to mount these filesystems until the network has been enabled on the system)."
msgstr "Filsystemet finns på en enhet som kräver nätverksåtkomst (används för att förhindra att systemet försöker montera dessa filsystem innan nätverket har aktiverats på systemet)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Do not report errors for this device if it does not exist."
msgstr "Rapportera inte fel för den här enheten om den inte finns."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*relatime*"
msgstr "*relatime*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Update inode access times relative to modify or change time. Access time is only updated if the previous access time was earlier than or equal to the current modify or change time. (Similar to *noatime*, but it doesn't break *mutt*(1) or other applications that need to know if a file has been read since the last time it was modified.)"
msgstr "Uppdatera inodens åtkomsttid i förhållande till modifierings- eller ändringstiden. Åtkomsttiden uppdateras endast om den föregående åtkomsttiden var tidigare än eller lika med den aktuella modifierings- eller ändringstiden. (Liknar *noatime*, men det bryter inte *mutt*(1) eller andra program som behöver veta om en fil har lästs sedan den senast modifierades)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Since Linux 2.6.30, the kernel defaults to the behavior provided by this option (unless *noatime* was specified), and the *strictatime* option is required to obtain traditional semantics. In addition, since Linux 2.6.30, the file's last access time is always updated if it is more than 1 day old."
msgstr "Sedan Linux 2.6.30 använder kärnan som standard det beteende som anges i denna flagga (om inte *noatime* har angetts), och flaggan *strictatime* krävs för att få traditionell semantik. Sedan Linux 2.6.30 uppdateras dessutom alltid filens senaste åtkomsttid om den är mer än 1 dag gammal."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*norelatime*"
msgstr "*norelatime*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Do not use the *relatime* feature. See also the *strictatime* mount option."
msgstr "Använd inte funktionen *relatime*. Se även monteringsflaggan *strictatime*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*strictatime*"
msgstr "*strictatime*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Allows to explicitly request full atime updates. This makes it possible for the kernel to default to *relatime* or *noatime* but still allow userspace to override it. For more details about the default system mount options see _/proc/mounts_."
msgstr "Gör det möjligt att uttryckligen begära fullständiga atime-uppdateringar. Detta gör det möjligt för kärnan att som standard använda *relatime* eller *noatime* men ändå tillåta att userspace åsidosätter det. För mer information om standardflaggor för systemmontering, se _/proc/mounts_."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*nostrictatime*"
msgstr "*nostrictatime*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Use the kernel's default behavior for inode access time updates."
msgstr "Använd kärnans standardbeteende för uppdateringar av inodens åtkomsttid."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*lazytime*"
msgstr "*lazytime*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Only update times (atime, mtime, ctime) on the in-memory version of the file inode."
msgstr "Endast uppdateringstider (atime, mtime, ctime) för den minnesbaserade versionen av filen inode."

#. from tp:util-linux-man-2.41.2-rc1
msgid "This mount option significantly reduces writes to the inode table for workloads that perform frequent random writes to preallocated files."
msgstr "Denna monteringsflagga minskar avsevärt skrivningar till inodtabellen för arbetsbelastningar som ofta utför slumpmässiga skrivningar till förallokerade filer."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The on-disk timestamps are updated only when:"
msgstr "Tidsstämplarna på disken uppdateras endast när:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "the inode needs to be updated for some change unrelated to file timestamps"
msgstr "inoden behöver uppdateras för någon förändring som inte är relaterad till filernas tidsstämplar"

#. from tp:util-linux-man-2.41.2-rc1
msgid "the application employs *fsync*(2), *syncfs*(2), or *sync*(2)"
msgstr "programmet använder *fsync*(2), *syncfs*(2) eller *sync*(2)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "an undeleted inode is evicted from memory"
msgstr "en inode som inte raderats tas bort från minnet"

#. from tp:util-linux-man-2.41.2-rc1
msgid "more than 24 hours have passed since the inode was written to disk."
msgstr "det har gått mer än 24 timmar sedan inoden skrevs till disken."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*nolazytime*"
msgstr "*nolazytime*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Do not use the lazytime feature."
msgstr "Använd inte lazytime-funktionen."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*suid*"
msgstr "*suid*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Honor set-user-ID and set-group-ID bits or file capabilities when executing programs from this filesystem."
msgstr "Respektera set-user-ID och set-group-ID-bitar eller filfunktioner när du kör program från detta filsystem."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*nosuid*"
msgstr "*nosuid*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Do not honor set-user-ID and set-group-ID bits or file capabilities when executing programs from this filesystem. In addition, SELinux domain transitions require permission _nosuid_transition_, which in turn needs also policy capability _nnp_nosuid_transition_."
msgstr "Respektera inte set-user-ID- och set-group-ID-bitar eller filfunktioner när program körs från detta filsystem. Dessutom kräver SELinux-domänövergångar behörigheten _nosuid_transition_, som i sin tur också behöver policykapaciteten _nnp_nosuid_transition_."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*silent*"
msgstr "*silent*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Turn on the silent flag."
msgstr "Slå på den tysta flaggan."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*loud*"
msgstr "*loud*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Turn off the silent flag."
msgstr "Stäng av den tysta flaggan."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Allow an ordinary user to mount the filesystem if that user is the owner of the device. This option implies the options *nosuid* and *nodev* (unless overridden by subsequent options, as in the option line *owner,dev,suid*)."
msgstr "Tillåter en vanlig användare att montera filsystemet om användaren är ägare till enheten. Denna flagga förutsätter flaggorna *nosuid* och *nodev* (om de inte åsidosätts av efterföljande flaggor, som i flaggraden *owner,dev,suid*)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*remount*"
msgstr "*remount*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Attempt to remount an already-mounted filesystem. This is commonly used to change the mount flags for a filesystem, especially to make a readonly filesystem writable. It does not change device or mount point."
msgstr "Försök att återmontera ett redan monterat filsystem. Detta används vanligen för att ändra monteringsflaggorna för ett filsystem, särskilt för att göra ett skrivskyddat filsystem skrivbart. Det ändrar inte enhet eller monteringspunkt."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The remount operation together with the *bind* flag has special semantics. See above, the subsection *Bind mount operation*."
msgstr "Återmonteringsoperationen tillsammans med flaggan *bind* har en speciell semantik. Se ovan, underavsnittet *Bind mount operation*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The default kernel behavior for VFS mount flags (nodev,nosuid,noexec,ro) is to reset all unspecified flags on remount. That's why *mount*(8) tries to keep the current setting according to _fstab_ or _/proc/self/mountinfo_. This default behavior is possible to change by *--options-mode*. The recursive change of the mount flags (supported since v2.39 on systems with *mount_setattr*(2)  syscall), for example, *mount -o remount,ro=recursive*, do not use \"reset-unspecified\" behavior, and it works as a simple add/remove operation and unspecified flags are not modified."
msgstr "Kärnans standardbeteende för VFS-monteringsflaggor (nodev,nosuid,noexec,ro) är att återställa alla ospecificerade flaggor vid återmontering. Det är därför *mount*(8) försöker behålla den aktuella inställningen enligt _fstab_ eller _/proc/self/mountinfo_. Detta standardbeteende är möjligt att ändra med *--options-mode*. Den rekursiva ändringen av monteringsflaggorna (stöds sedan v2.39 på system med syscall *mount_setattr*(2)), t.ex. *mount -o remount,ro=recursive*, använder inte \"reset-unspecified\"-beteendet, och det fungerar som en enkel lägg till/ta bort-operation och ospecificerade flaggor ändras inte."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The remount functionality follows the standard way the *mount* command works with options from _fstab_. This means that *mount* does not read _fstab_ (or _mtab_) only when both _device_ and _dir_ are specified."
msgstr "Remount-funktionaliteten följer standardmetoden för hur kommandot *mount* arbetar med flaggor från _fstab_. Detta innebär att *mount* inte läser _fstab_ (eller _mtab_) endast när både _enhet_ och _dir_ anges."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*mount -o remount,rw /dev/foo /dir*"
msgstr "*mount -o remount,rw /dev/foo /dir*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "After this call all old mount options are replaced and arbitrary stuff from _fstab_ (or _mtab_) is ignored, except the *loop=* option which is internally generated and maintained by the *mount* command."
msgstr "Efter detta anrop ersätts alla gamla mount-flaggor och godtyckliga saker från _fstab_ (eller _mtab_) ignoreras, utom flaggan *loop=* som genereras internt och underhålls av kommandot *mount*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*mount -o remount,rw /dir*"
msgstr "*mount -o remount,rw /dir*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "After this call, *mount* reads _fstab_ and merges these options with the options from the command line (*-o*). If no mountpoint is found in _fstab_, then it defaults to mount options from _/proc/self/mountinfo_."
msgstr "Efter detta anrop läser *mount* _fstab_ och slår samman dessa flaggor med flaggorna från kommandoraden (*-o*). Om ingen monteringspunkt hittas i _fstab_ används som standard monteringsflaggor från _/proc/self/mountinfo_."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*mount* allows the use of *--all* to remount all already mounted filesystems which match a specified filter (*-O* and *-t*). For example:"
msgstr "*mount* gör det möjligt att använda *--all* för att återmontera alla redan monterade filsystem som matchar ett angivet filter (*-O* och *-t*). Till exempel:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*mount --all -o remount,ro -t vfat*"
msgstr "*mount --all -o remount,ro -t vfat*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "remounts all already mounted vfat filesystems in read-only mode. Each of the filesystems is remounted by *mount -o remount,ro* _/dir_ semantic. This means the *mount* command reads _fstab_ or _mtab_ and merges these options with the options from the command line."
msgstr "återmonterar alla redan monterade vfat-filsystem i skrivskyddat läge. Varje filsystem återmonteras med *mount -o remount,ro* _/dir_ semantik. Detta innebär att kommandot *mount* läser _fstab_ eller _mtab_ och sammanfogar dessa flaggor med flaggorna från kommandoraden."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*ro*[**=**(*recursive*|*vfs*|*fs*)]"
msgstr "*ro*[**=**(*recursive*|*vfs*|*fs*)]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Mount the filesystem read-only. The optional argument is an experimental feature supported only by the file-descriptor based kernel mount API and it is silently ignored for the old *mount*(2) syscall."
msgstr "Montera filsystemet skrivskyddat. Det valfria argumentet är en experimentell funktion som endast stöds av det filbeskrivningsbaserade kärnmonterings-API:t och det ignoreras tyst för det gamla *mount*(2)-systemuppropet."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The *recursive* argument forces the VFS attribute to be applied recursively."
msgstr "Argumentet *recursive* tvingar VFSattributet att tillämpas rekursivt."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The *vfs* and *fs* arguments specify the layer where the read-only flag should be applied. The *fs* specifies the filesystem superblock (unique filesystem instance in the kernel), and *vfs* specifies the mount node. If no attribute is specified, then both layers are set to read-only."
msgstr "Argumenten *vfs* och *fs* anger det lager där flaggan för skrivskyddad fil ska användas. *fs* anger filsystemets superblock (unik filsysteminstans i kärnan) och *vfs* anger monteringsnoden. Om inget attribut anges sätts båda lagren till skrivskyddade."

#. from tp:util-linux-man-2.41.2-rc1
msgid "For more details, please refer to the *Read-only Setting Notes* section."
msgstr "Mer information finns i avsnittet *Anvisningar om inställningar för skrivskyddad läsning*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*rw*[**=**(*recursive*|*vfs*|*fs*)]"
msgstr "*rw*[**=**(*recursive*|*vfs*|*fs*)]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Mount the filesystem read-write."
msgstr "Montera filsystemet som skriv-läsning."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*sync*"
msgstr "*sync*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "All I/O to the filesystem should be done synchronously. In the case of media with a limited number of write cycles (e.g. some flash drives), *sync* may cause life-cycle shortening."
msgstr "All I/O till filsystemet bör ske synkront. När det gäller media med ett begränsat antal skrivcykler (t.ex. vissa flashminnen) kan *sync* leda till att livscykeln förkortas."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Allow an ordinary user to mount the filesystem. The name of the mounting user is written to the _mtab_ file (or to the private libmount file in _/run/mount_ on systems without a regular _mtab_) so that this same user can unmount the filesystem again. This option implies the options *noexec*, *nosuid*, and *nodev* (unless overridden by subsequent options, as in the option line *user,exec,dev,suid*)."
msgstr "Tillåt en vanlig användare att montera filsystemet. Namnet på den användare som monterar skrivs till filen _mtab_ (eller till den privata libmount-filen i _/run/mount_ på system utan en vanlig _mtab_) så att samma användare kan avmontera filsystemet igen. Denna flagga innebär flaggorna *noexec*, *nosuid* och *nodev* (om de inte åsidosätts av efterföljande flaggor, som i flaggraden *user,exec,dev,suid*)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*nouser*"
msgstr "*nouser*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Forbid an ordinary user to mount the filesystem. This is the default; it does not imply any other options."
msgstr "Förbjud en vanlig användare att montera filsystemet. Detta är standardvärdet; det innebär inte några andra flaggor."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*users*"
msgstr "*users*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Allow any user to mount and to unmount the filesystem, even when some other ordinary user mounted it. This option implies the options *noexec*, *nosuid*, and *nodev* (unless overridden by subsequent options, as in the option line *users,exec,dev,suid*)."
msgstr "Tillåter alla användare att montera och avmontera filsystemet, även när någon annan vanlig användare har monterat det. Denna flagga innebär flaggorna *noexec*, *nosuid* och *nodev* (om de inte åsidosätts av efterföljande flaggor, som i flaggraden *users,exec,dev,suid*)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*X-**"
msgstr "*X-**"

#. from tp:util-linux-man-2.41.2-rc1
msgid "All options prefixed with \"X-\" are interpreted as comments or as userspace application-specific options. These options are not stored in user space (e.g., _mtab_ file), nor sent to the mount._type_ helpers nor to the *mount*(2) system call. The suggested format is **X-**__appname__._option_."
msgstr "Alla flaggor med prefixet \"X-\" tolkas som kommentarer eller som applikationsspecifika flaggor i användarutrymmet. Dessa flaggor lagras inte i användarutrymmet (t.ex. i filen _mtab_) och skickas inte heller till hjälpprogrammen mount._typ_ eller systemanropet *mount*(2). Det föreslagna formatet är **X-**__programnamn__._flagga_."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*x-**"
msgstr "*x-**"

#. from tp:util-linux-man-2.41.2-rc1
msgid "The same as *X-** options, but stored permanently in user space. This means the options are also available for *umount*(8) or other operations. Note that maintaining mount options in user space is tricky, because it's necessary to use libmount-based tools and there is no guarantee that the options will be always available (for example after a move mount operation or in unshared namespace)."
msgstr "Samma som *X-**-flaggor, men lagras permanent i användarutrymmet. Detta innebär att flaggorna även är tillgängliga för *umount*(8) eller andra operationer. Observera att det är svårt att behålla monteringsflaggor i användarutrymmet, eftersom det är nödvändigt att använda libmount-baserade verktyg och det inte finns någon garanti för att flaggorna alltid kommer att vara tillgängliga (t.ex. efter en flyttad monteringsoperation eller i odelad namnrymd)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Note that before util-linux v2.30 the x-* options have not been maintained by libmount and stored in user space (functionality was the same as for X-* now), but due to the growing number of use-cases (in initrd, systemd etc.) the functionality has been extended to keep existing _fstab_ configurations usable without a change."
msgstr "Observera att före util-linux v2.30 har x-*-flaggor inte underhållits av libmount och lagrats i användarutrymmet (funktionaliteten var densamma som för X-* nu), men på grund av det växande antalet användningsfall (i initrd, systemd etc.) har funktionaliteten utökats så att befintliga _fstab_-konfigurationer kan användas utan ändring."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*X-mount.auto-fstypes*=_list_"
msgstr "*X-mount.auto-fstypes*=_lista_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Specifies allowed or forbidden filesystem types for automatic filesystem detection."
msgstr "Anger tillåtna eller förbjudna filsystemtyper för automatisk filsystemdetektering."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The _list_ is a comma-separated list of the filesystem names. The automatic filesystem detection is triggered by the \"auto\" filesystem type or when the filesystem type is not specified."
msgstr "_lista_ är en kommaseparerad lista över filsystemens namn. Den automatiska filsystemdetekteringen utlöses av filsystemtypen \"auto\" eller när filsystemtypen inte har angetts."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The _list_ follows how mount evaluates type patterns (see *-t* for more details). Only specified filesystem types are allowed, or all specified types are forbidden if the list is prefixed by \"no\"."
msgstr "_lista_ följer hur mount utvärderar typmönster (se *-t* för mer information). Endast angivna filsystemtyper är tillåtna, eller så är alla angivna typer förbjudna om listan inleds med \"no\"."

#. from tp:util-linux-man-2.41.2-rc1
msgid "For example, X-mount.auto-fstypes=\"ext4,btrfs\" accepts only ext4 and btrfs, and X-mount.auto-fstypes=\"novfat,xfs\" accepts all filesystems except vfat and xfs."
msgstr "Till exempel accepterar X-mount.auto-fstypes=\"ext4,btrfs\" endast ext4 och btrfs, och X-mount.auto-fstypes=\"novfat,xfs\" accepterar alla filsystem utom vfat och xfs."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Note that comma is used as a separator between mount options, it means that auto-fstypes values have to be properly quoted, don’t forget that the shell strips off quotes and thus double quoting is required. For example:"
msgstr "Observera att kommatecken används som avgränsare mellan monteringsflaggor, vilket innebär att värden för auto-fstypes måste citeras korrekt. Glöm inte att skalet tar bort citattecken och att dubbla citattecken därför krävs. Till exempel:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "mount -t auto -o'X-mount.auto-fstypes=\"noext2,ext3\"' /dev/sdc1 /mnt/test"
msgstr "mount -t auto -o'X-mount.auto-fstypes=\"noext2,ext3\"' /dev/sdc1 /mnt/test"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*X-mount.mkdir*[**=**_mode_]"
msgstr "*X-mount.mkdir*[**=**_läge_]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Allow to make a target directory (mountpoint) if it does not exist yet. The optional argument _mode_ specifies the filesystem access mode used for *mkdir*(2) in octal notation. The default mode is 0755. This functionality is supported only for root users or when *mount* is executed without suid permissions. The option is also supported as *x-mount.mkdir*, but this notation is deprecated since v2.30. See also *--mkdir* command line option."
msgstr "Gör det möjligt att skapa en målkatalog (mountpoint) om den inte finns ännu. Det valfria argumentet _läge_ anger det åtkomstläge för filsystemet som används för *mkdir*(2) i oktalnotation. Standardläget är 0755. Den här funktionen stöds endast för root-användare eller när *mount* körs utan suid-behörighet. Flaggan stöds även som *x-mount.mkdir*, men denna notation är föråldrad sedan v2.30. Se även kommandoradsflaggan *--mkdir*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*X-mount.nocanonicalize*[**=**_type_]"
msgstr "*X-mount.nocanonicalize*[**=**_typ_]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Allows disabling of canonicalization for mount source and target paths. By default, the `mount` command resolves all paths to their absolute paths without symlinks. However, this behavior may not be desired in certain situations, such as when binding a mount over a symlink, or a symlink over a directory or another symlink. The optional argument _type_ can be either \"source\" or \"target\" (mountpoint). If no _type_ is specified, then canonicalization is disabled for both types. This mount option does not affect the conversion of source tags (e.g. LABEL= or UUID=) and fstab processing."
msgstr "Gör det möjligt att inaktivera kanonisering för mount-käll- och målsökvägar. Som standard löser kommandot `mount` upp alla sökvägar till deras absoluta sökvägar utan symlinks. Detta beteende kan dock vara oönskat i vissa situationer, t.ex. när du binder en mount över en symbollänk, eller en symbollänk över en katalog eller en annan symbollänk. Det valfria argumentet _typ_ kan vara antingen \"source\" eller \"target\" (mountpoint). Om ingen _typ_ anges inaktiveras kanonisering för båda typerna. Denna mount-flagga påverkar inte konverteringen av källtaggar (t.ex. LABEL= eller UUID=) och fstab-behandling."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The command-line option *--no-canonicalize* overrides this mount option and affects all path and tag conversions in all situations, but for backward compatibility, it does not modify open_tree syscall flags and does not allow the bind-mount over a symlink use case."
msgstr "Kommandoradsflaggan *--no-canonicalize* åsidosätter detta monteringsflagga och påverkar alla sökvägs- och taggkonverteringar i alla situationer, men för bakåtkompatibilitet ändrar det inte open_tree syscall-flaggor och tillåter inte användningsfallet bind-mount över en symlänk."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Note that *mount*(8) still sanitizes and canonicalizes the source and target paths specified on the command line by non-root users, regardless of the X-mount.nocanonicalize setting."
msgstr "Observera att *mount*(8) fortfarande rensar och kanoniserar de käll- och målsökvägar som anges på kommandoraden av användare som inte är root, oavsett inställningen X-mount.nocanonicalize."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*X-mount.noloop*"
msgstr "*X-mount.noloop*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Do not create and mount a loop device, even if the source of the mount is a regular file."
msgstr "Skapa och montera inte en loop-enhet, även om källan till monteringen är en vanlig fil."

#. from tp:util-linux-man-2.41.2-rc1
msgid "**X-mount.subdir=**_directory_"
msgstr "**X-mount.subdir=**_katalog_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Allow mounting a subdirectory of a filesystem instead of the root directory. This is effective only when a new instance of a filesystem is attached to the system. The option is silently ignored for operations like remount, bind mount, or move."
msgstr "Tillåt montering av en underkatalog i ett filsystem i stället för rotkatalogen. Detta är endast effektivt när en ny instans av ett filsystem ansluts till systemet. Flaggan ignoreras tyst för operationer som remount, bind mount eller move."

#. from tp:util-linux-man-2.41.2-rc1
msgid "For now, this feature is implemented by a temporary filesystem root-directory mount in an unshared namespace and then binding the sub-directory to the final mount point and unmounting the root of the filesystem. The sub-directory mount shows up atomically for the rest of the system although it is implemented by multiple *mount*(2) syscalls."
msgstr "För närvarande implementeras den här funktionen genom en tillfällig montering av filsystemets rotkatalog i ett odelat namnområde och sedan binda underkatalogen till den slutliga monteringspunkten och avmontera filsystemets rot. Monteringen av underkatalogen visas atomiskt för resten av systemet även om den implementeras med flera *mount*(2) syscalls."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Note that this feature will not work in session with an unshared private mount namespace (after *unshare --mount*) on old kernels or with *mount*(8) without support for file-descriptors-based mount kernel API. In this case, you need *unshare --mount --propagation shared*."
msgstr "Observera att den här funktionen inte fungerar i sessioner med ett odelat privat namnområde för montering (efter *unshare --mount*) på gamla kärnor eller med *mount*(8) utan stöd för filbeskrivningsbaserat API för monteringskärnor. I det här fallet behöver du *unshare --mount --propagation shared*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "This feature is EXPERIMENTAL."
msgstr "Denna funktion är EXPERIMENTELL."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*X-mount.owner*=_username_|_UID_, *X-mount.group*=_group_|_GID_"
msgstr "*X-mount.owner*=_användarnamn_|_UID_, *X-mount.group*=_grupp_|_GID_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Set _mountpoint_'s ownership after mounting. Names resolved in the target mount namespace, see *-N*."
msgstr "Ställ in _monteringspunkt_:s ägarskap efter montering. Namn som löses i namnrymden för målmonteringen, se *-N*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*X-mount.mode*=_mode_"
msgstr "*X-montering.mode*=_läge_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Set _mountpoint_'s mode after mounting."
msgstr "Ställ in _monteringspunkt_:s läge efter montering."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*X-mount.idmap*=__id-type__:__id-mount__:__id-host__:__id-range__ [__id-type__:__id-mount__:__id-host__:__id-range__], *X-mount.idmap*=__file__"
msgstr "*X-mount.idmap*=__id-type__:__id-mount__:__id-host__:__id-range__ [__id-type__:__id-mount__:__id-host__:__id-range__], *X-mount.idmap*=__fil__"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Use this option to create an idmapped mount.  An idmapped mount allows to change ownership of all files located under a mount according to the ID-mapping associated with a user namespace.  The ownership change is tied to the lifetime and localized to the relevant mount.  The relevant ID-mapping can be specified in two ways:"
msgstr "Använd den här flaggan för att skapa en idmappad montering.  En idmappad montering gör det möjligt att ändra ägandeskapet för alla filer som finns under en montering enligt den ID-mappning som är associerad med ett användarnamnområde.  Ägarbytet är knutet till livstiden och lokaliseras till den relevanta monteringen.  Den relevanta ID-mappningen kan specificeras på två sätt:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "A user can specify the ID-mapping directly."
msgstr "En användare kan ange ID-mappningen direkt."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The ID-mapping must be specified using the syntax __id-type__:__id-mount__:__id-host__:__id-range__.  Specifying *u* as the __id-type__ prefix creates a UID-mapping, *g* creates a GID-mapping and omitting __id-type__ or specifying *b* creates both a UID- and GID-mapping.  The __id-mount__ parameter indicates the starting ID in the new mount.  The __id-host__ parameter indicates the starting ID in the filesystem.  The __id-range__ parameter indicates how many IDs are to be mapped.  It is possible to specify multiple ID-mappings."
msgstr "ID-mappningen måste anges med syntaxen __id-type__:__id-mount__:__id-host__:__id-range__.  Om du anger *u* som prefix för __id-type__ skapas en UID-mappning, *g* skapar en GID-mappning och om du utelämnar __id-type__ eller anger *b* skapas både en UID- och en GID-mappning.  Parametern __id-mount__ anger start-ID i den nya monteringen.  Parametern __id-host__ anger start-ID i filsystemet.  Parametern __id-range__ anger hur många ID:n som ska mappas.  Det är möjligt att ange flera ID-mappningar."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The individual ID mappings must be separated by spaces. Please note that in the __/etc/fstab__ file, spaces are interpreted as separators between fields. To avoid this, you must escape them using \\040. For example, X-mount.idmap=0:0:1\\040500:1000:1."
msgstr "De enskilda ID-mappningarna måste separeras med mellanslag. Observera att i filen __/etc/fstab__ tolkas mellanslag som separatorer mellan fält. För att undvika detta måste du escapen dem med \\040. Till exempel X-mount.idmap=0:0:1\\040500:1000:1."

#. from tp:util-linux-man-2.41.2-rc1
msgid "For example, the ID-mapping *X-mount.idmap=u:1000:0:1 g:1001:1:2 5000:1000:2* creates an idmapped mount where UID 0 is mapped to UID 1000, GID 1 is mapped to GUID 1001, GID 2 is mapped to GID 1002, UID and GID 1000 are mapped to 5000, and UID and GID 1001 are mapped to 5001 in the mount."
msgstr "ID-mappningen *X-mount.idmap=u:1000:0:1 g:1001:1:2 5000:1000:2* skapar t.ex. en id-mappad montering där UID 0 mappas till UID 1000, GID 1 mappas till GUID 1001, GID 2 mappas till GID 1002, UID och GID 1000 mappas till 5000 och UID och GID 1001 mappas till 5001 i monteringen."

#. from tp:util-linux-man-2.41.2-rc1
msgid "When an ID-mapping is specified directly a new user namespace will be allocated with the requested ID-mapping.  The newly created user namespace will be attached to the mount."
msgstr "När en ID-mappning anges direkt kommer ett nytt användarnamnområde att allokeras med den begärda ID-mappningen.  Det nyskapade användarnamnområdet kommer att kopplas till fästet."

#. from tp:util-linux-man-2.41.2-rc1
msgid "A user can specify a user namespace file."
msgstr "En användare kan ange en användarnamnområdesfil."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The user namespace will then be attached to the mount and the ID-mapping of the user namespace will become the ID-mapping of the mount."
msgstr "Användarnamnområdet kommer då att kopplas till fästet och ID-mappningen av användarnamnområdet kommer att bli ID-mappningen av fästet."

#. from tp:util-linux-man-2.41.2-rc1
msgid "For example, *X-mount.idmap=/proc/PID/ns/user* will attach the user namespace of the process PID to the mount."
msgstr "Till exempel kommer *X-mount.idmap=/proc/PID/ns/user* att koppla användarnamnområdet för processens PID till monteringen."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*nosymfollow*"
msgstr "*nosymfollow*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Do not follow symlinks when resolving paths. Symlinks can still be created, and *readlink*(1), *readlink*(2), *realpath*(1), and *realpath*(3) all still work properly."
msgstr "Följ inte symlinks när du löser sökvägar. Symlinks kan fortfarande skapas, och *readlink*(1), *readlink*(2), *realpath*(1) och *realpath*(3) fungerar fortfarande korrekt."

#. from tp:util-linux-man-2.41.2-rc1
msgid "FILESYSTEM-SPECIFIC MOUNT OPTIONS"
msgstr "FILSYSTEMSSPECIFIKA MONTERINGSFLAGGOR"

#. from tp:util-linux-man-2.41.2-rc1
msgid "This section lists options that are specific to particular filesystems. Where possible, you should first consult filesystem-specific manual pages for details. Some of those pages are listed in the following table."
msgstr "I det här avsnittet listas flaggor som är specifika för vissa filsystem. När det är möjligt bör du först läsa de filsystemspecifika manualsidorna för mer information. Några av dessa sidor listas i följande tabell."

#. from tp:util-linux-man-2.41.2-rc1
msgid "|*Filesystem(s)* |*Manual page*\n|btrfs |*btrfs*(5)\n|cifs |*mount.cifs*(8)\n|ext2, ext3, ext4 |*ext4*(5)\n|fuse |*fuse*(8)\n|nfs |*nfs*(5)\n|tmpfs |*tmpfs*(5)\n|xfs |*xfs*(5)\n"
msgstr "|*Filsystem* |*Manualsida*\n|btrfs |*btrfs*(5)\n|cifs |*mount.cifs*(8)\n|ext2, ext3, ext4 |*ext4*(5)\n|fuse |*fuse*(8)\n|nfs |*nfs*(5)\n|tmpfs |*tmpfs*(5)\n|xfs |*xfs*(5)\n"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Note that some of the pages listed above might be available only after you install the respective userland tools."
msgstr "Observera att vissa av de sidor som anges ovan kan vara tillgängliga först efter att du har installerat respektive användarverktyg."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The following options apply only to certain filesystems. We sort them by filesystem. All options follow the *-o* flag."
msgstr "Följande flaggor gäller endast för vissa filsystem. Vi sorterar dem efter filsystem. Alla flaggor följer flaggan *-o*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "What options are supported depends a bit on the running kernel. Further information may be available in filesystem-specific files in the kernel source subdirectory _Documentation/filesystems_."
msgstr "Vilka flaggor som stöds beror lite på den körande kärnan. Ytterligare information kan finnas i filsystemspecifika filer i underkatalogen _Documentation/filesystems_ för kärnkällan."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Mount options for adfs"
msgstr "Flaggor för montering av adfs"

#. from tp:util-linux-man-2.41.2-rc1
msgid "**uid=**__value__ and **gid=**__value__"
msgstr "**uid=**__värde__ and **gid=**__värde__"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Set the owner and group of the files in the filesystem (default: uid=gid=0)."
msgstr "Ange ägare och grupp för filerna i filsystemet (standard: uid=gid=0)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "**ownmask=**__value__ and **othmask=**__value__"
msgstr "**ownmask=**__värde__ and **othmask=**__värde__"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Set the permission mask for ADFS 'owner' permissions and 'other' permissions, respectively (default: 0700 and 0077, respectively). See also _/usr/src/linux/Documentation/filesystems/adfs.rst_."
msgstr "Ställ in behörighetsmasken för ADFS \"ägar\"-behörigheter respektive \"andra\"-behörigheter (standard: 0700 respektive 0077). Se även _/usr/src/linux/Documentation/filesystems/adfs.rst_."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Mount options for affs"
msgstr "Monteringsflaggor för affs"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Set the owner and group of the root of the filesystem (default: uid=gid=0, but with option *uid* or *gid* without specified value, the UID and GID of the current process are taken)."
msgstr "Ange ägare och grupp för roten till filsystemet (standard: uid=gid=0, men med flaggan *uid* eller *gid* utan angivet värde används UID och GID för den aktuella processen)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "**setuid=**__value__ and **setgid=**__value__"
msgstr "**setuid=**__värde__ and **setgid=**__värde__"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Set the owner and group of all files."
msgstr "Ange ägare och grupp för alla filer."

#. from tp:util-linux-man-2.41.2-rc1
msgid "**mode=**__value__"
msgstr "**mode=**__värde__"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Set the mode of all files to _value_ & 0777 disregarding the original permissions. Add search permission to directories that have read permission. The value is given in octal."
msgstr "Ställ in läget för alla filer till _värde_ & 0777 utan hänsyn till de ursprungliga behörigheterna. Lägg till sökbehörighet i kataloger som har läsbehörighet. Värdet anges i oktal."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*protect*"
msgstr "*protect*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Do not allow any changes to the protection bits on the filesystem."
msgstr "Tillåt inte några ändringar av filsystemets skyddsbitar."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*usemp*"
msgstr "*usemp*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Set UID and GID of the root of the filesystem to the UID and GID of the mount point upon the first sync or umount, and then clear this option. Strange..."
msgstr "Ställ in UID och GID för roten av filsystemet till UID och GID för monteringspunkten vid första synkroniseringen eller umount, och avmarkera sedan denna flagga. Märkligt..."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*verbose*"
msgstr "*verbose*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Print an informational message for each successful mount."
msgstr "Skriv ut ett informationsmeddelande för varje lyckad montering."

#. from tp:util-linux-man-2.41.2-rc1
msgid "**prefix=**__string__"
msgstr "**prefix=**__sträng__"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Prefix used before volume name, when following a link."
msgstr "Prefix som används före volymnamn när man följer en länk."

#. from tp:util-linux-man-2.41.2-rc1
msgid "**volume=**__string__"
msgstr "**volume=**__sträng__"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Prefix (of length at most 30) used before '/' when following a symbolic link."
msgstr "Prefix (med en längd på högst 30) som används före '/' när man följer en symbolisk länk."

#. from tp:util-linux-man-2.41.2-rc1
msgid "**reserved=**__value__"
msgstr "**reserved=**__värde__"

#. from tp:util-linux-man-2.41.2-rc1
msgid "(Default: 2.) Number of unused blocks at the start of the device."
msgstr "(Standard: 2.) Antal oanvända block i början av enheten."

#. from tp:util-linux-man-2.41.2-rc1
msgid "**root=**__value__"
msgstr "**root=**__värde__"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Give explicitly the location of the root block."
msgstr "Ange uttryckligen var rotblocket är placerat."

#. from tp:util-linux-man-2.41.2-rc1
msgid "**bs=**__value__"
msgstr "**bs=**__värde__"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Give blocksize. Allowed values are 512, 1024, 2048, 4096."
msgstr "Ange blockstorlek. Tillåtna värden är 512, 1024, 2048, 4096."

#. from tp:util-linux-man-2.41.2-rc1
msgid "**grpquota**|**noquota**|**quota**|*usrquota*"
msgstr "**grpquota**|**noquota**|**quota**|*usrquota*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "These options are accepted but ignored. (However, quota utilities may react to such strings in _/etc/fstab_.)"
msgstr "Dessa flaggor accepteras men ignoreras. (Kvotverktyg kan dock reagera på sådana strängar i _/etc/fstab_)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Mount options for debugfs"
msgstr "Flaggor för montering av debugfs"

#. from tp:util-linux-man-2.41.2-rc1
msgid "The debugfs filesystem is a pseudo filesystem, traditionally mounted on _/sys/kernel/debug_. As of kernel version 3.4, debugfs has the following options:"
msgstr "Debugfs-filsystemet är ett pseudo-filsystem som traditionellt monteras på _/sys/kernel/debug_. Från och med kärnversion 3.4 har debugfs följande flaggor:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "**uid=**__n__**, gid=**__n__"
msgstr "**uid=**__n__**, gid=**__n__"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Set the owner and group of the mountpoint."
msgstr "Ange ägare och grupp för monteringspunkten."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Sets the mode of the mountpoint."
msgstr "Ställer in läget för monteringspunkten."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Mount options for devpts"
msgstr "Flaggor för montering av devpts"

#. from tp:util-linux-man-2.41.2-rc1
msgid "The devpts filesystem is a pseudo filesystem, traditionally mounted on _/dev/pts_. In order to acquire a pseudo terminal, a process opens _/dev/ptmx_; the number of the pseudo terminal is then made available to the process and the pseudo terminal slave can be accessed as _/dev/pts/_<number>."
msgstr "Filsystemet devpts är ett pseudofilsystem som traditionellt monteras på _/dev/pts_. För att skaffa en pseudoterminal öppnar en process _/dev/ptmx_; numret på pseudoterminalen görs sedan tillgängligt för processen och pseudoterminalens slav kan nås som _/dev/pts/_<number>."

#. from tp:util-linux-man-2.41.2-rc1
msgid "This sets the owner or the group of newly created pseudo terminals to the specified values. When nothing is specified, they will be set to the UID and GID of the creating process. For example, if there is a tty group with GID 5, then *gid=5* will cause newly created pseudo terminals to belong to the tty group."
msgstr "Detta ställer in ägaren eller gruppen av nyskapade pseudoterminaler till de angivna värdena. Om inget anges kommer de att ställas in till UID och GID för den skapande processen. Om det t.ex. finns en tty-grupp med GID 5, kommer *gid=5* att leda till att nyskapade pseudoterminaler tillhör tty-gruppen."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Set the mode of newly created pseudo terminals to the specified value. The default is 0600. A value of *mode=620* and *gid=5* makes \"mesg y\" the default on newly created pseudo terminals."
msgstr "Ställ in läget för nyskapade pseudoterminaler till det angivna värdet. Standardvärdet är 0600. Ett värde på *mode=620* och *gid=5* gör \"mesg y\" till standard för nyskapade pseudoterminaler."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*newinstance*"
msgstr "*nyinstans*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Create a private instance of the devpts filesystem, such that indices of pseudo terminals allocated in this new instance are independent of indices created in other instances of devpts."
msgstr "Skapa en privat instans av filsystemet devpts, så att index för pseudoterminaler som tilldelas i denna nya instans är oberoende av index som skapas i andra instanser av devpts."

#. from tp:util-linux-man-2.41.2-rc1
msgid "All mounts of devpts without this *newinstance* option share the same set of pseudo terminal indices (i.e., legacy mode). Each mount of devpts with the *newinstance* option has a private set of pseudo terminal indices."
msgstr "Alla monteringar av devpts utan denna *newinstance*-flagga delar samma uppsättning pseudoterminalindex (dvs. äldre läge). Varje montering av devpts med flaggan *newinstance* har en privat uppsättning pseudoterminalindex."

#. from tp:util-linux-man-2.41.2-rc1
msgid "This option is mainly used to support containers in the Linux kernel. It is implemented in Linux kernel versions starting with 2.6.29. Further, this mount option is valid only if *CONFIG_DEVPTS_MULTIPLE_INSTANCES* is enabled in the kernel configuration."
msgstr "Denna flagga används främst för att stödja containrar i Linux-kärnan. Det är implementerat i Linux-kärnans versioner från och med 2.6.29. Dessutom är det här monteringsflaggan endast giltigt om *CONFIG_DEVPTS_MULTIPLE_INSTANCES* är aktiverat i kärnkonfigurationen."

#. from tp:util-linux-man-2.41.2-rc1
msgid "To use this option effectively, _/dev/ptmx_ must be a symbolic link to _pts/ptmx_. See _Documentation/filesystems/devpts.txt_ in the Linux kernel source tree for details."
msgstr "För att använda den här flaggan effektivt måste _/dev/ptmx_ vara en symbolisk länk till _pts/ptmx_. Se _Documentation/filesystems/devpts.txt_ i Linux-kärnans källträd för mer information."

#. from tp:util-linux-man-2.41.2-rc1
msgid "**ptmxmode=**__value__"
msgstr "**ptmxmode=**__värde__"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Set the mode for the new _ptmx_ device node in the devpts filesystem."
msgstr "Ställ in läget för den nya enhetsnoden _ptmx_ i filsystemet devpts."

#. from tp:util-linux-man-2.41.2-rc1
msgid "With the support for multiple instances of devpts (see *newinstance* option above), each instance has a private _ptmx_ node in the root of the devpts filesystem (typically _/dev/pts/ptmx_)."
msgstr "Med stöd för flera instanser av devpts (se flaggan *newinstance* ovan) har varje instans en privat _ptmx_-nod i roten till devpts-filsystemet (vanligtvis _/dev/pts/ptmx_)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "For compatibility with older versions of the kernel, the default mode of the new _ptmx_ node is 0000. **ptmxmode=**__value__ specifies a more useful mode for the _ptmx_ node and is highly recommended when the *newinstance* option is specified."
msgstr "För kompatibilitet med äldre versioner av kärnan är standardläget för den nya _ptmx_-noden 0000. **ptmxmode=**__värde__ anger ett mer användbart läge för _ptmx_-noden och rekommenderas starkt när flaggan *newinstance* anges."

#. from tp:util-linux-man-2.41.2-rc1
msgid "This option is only implemented in Linux kernel versions starting with 2.6.29. Further, this option is valid only if *CONFIG_DEVPTS_MULTIPLE_INSTANCES* is enabled in the kernel configuration."
msgstr "Den här flaggan är endast implementerat i Linux-kärnversioner som börjar med 2.6.29. Dessutom är den här flaggan endast giltig om *CONFIG_DEVPTS_MULTIPLE_INSTANCES* är aktiverat i kärnkonfigurationen."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Mount options for fat"
msgstr "Monteringsflaggor för fat"

#. from tp:util-linux-man-2.41.2-rc1
msgid "(Note: _fat_ is not a separate filesystem, but a common part of the _msdos_, _umsdos_ and _vfat_ filesystems.)"
msgstr "(Obs: _fat_ är inte ett separat filsystem, utan en gemensam del av filsystemen _msdos_, _umsdos_ och _vfat_)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*blocksize=*{**512**|**1024**|*2048*}"
msgstr "*blocksize=*{**512**|**1024**|*2048*}"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Set blocksize (default 512). This option is obsolete."
msgstr "Ställ in blockstorlek (standard 512). Denna flagga är föråldrat."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Set the owner and group of all files. (Default: the UID and GID of the current process.)"
msgstr "Ange ägare och grupp för alla filer. (Standard: UID och GID för den aktuella processen.)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "**umask=**__value__"
msgstr "**umask=**__värde__"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Set the umask (the bitmask of the permissions that are *not* present). The default is the umask of the current process. The value is given in octal."
msgstr "Ställ in umask (bitmasken för de behörigheter som *inte* finns). Standardvärdet är umask för den aktuella processen. Värdet anges i oktal."

#. from tp:util-linux-man-2.41.2-rc1
msgid "**dmask=**__value__"
msgstr "**dmask=**__värde__"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Set the umask applied to directories only. The default is the umask of the current process. The value is given in octal."
msgstr "Ställ in umask som endast tillämpas på kataloger. Standardvärdet är umask för den aktuella processen. Värdet anges i oktal."

#. from tp:util-linux-man-2.41.2-rc1
msgid "**fmask=**__value__"
msgstr "**fmask=**__värde__"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Set the umask applied to regular files only. The default is the umask of the current process. The value is given in octal."
msgstr "Ställ in umask som endast tillämpas på vanliga filer. Standardvärdet är umask för den aktuella processen. Värdet anges i oktal."

#. from tp:util-linux-man-2.41.2-rc1
msgid "**allow_utime=**__value__"
msgstr "**allow_utime=**__värde__"

#. from tp:util-linux-man-2.41.2-rc1
msgid "This option controls the permission check of mtime/atime."
msgstr "Denna flagga styr behörighetskontrollen av mtime/atime."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*20*"
msgstr "*20*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "If current process is in group of file's group ID, you can change timestamp."
msgstr "Om den aktuella processen är i grupp med filens grupp-ID kan du ändra tidsstämpel."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Other users can change timestamp."
msgstr "Andra användare kan ändra tidsstämpel."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The default is set from 'dmask' option. (If the directory is writable, *utime*(2) is also allowed. I.e. ~dmask & 022)"
msgstr "Standardvärdet anges av flaggan \"dmask\". (Om katalogen är skrivbar är *utime*(2) också tillåtet. Dvs. ~dmask & 022)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Normally *utime*(2) checks that the current process is owner of the file, or that it has the *CAP_FOWNER* capability. But FAT filesystems don't have UID/GID on disk, so the normal check is too inflexible. With this option you can relax it."
msgstr "Normalt kontrollerar *utime*(2) att den aktuella processen är ägare till filen, eller att den har *CAP_FOWNER*-kapaciteten. Men FAT-filsystem har inte UID/GID på disken, så den normala kontrollen är alltför oflexibel. Med den här flaggan kan du lätta på den."

#. from tp:util-linux-man-2.41.2-rc1
msgid "**check=**__value__"
msgstr "**check=**__värde__"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Three different levels of pickiness can be chosen:"
msgstr "Tre olika nivåer av kräsenhet kan väljas:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*r*[*elaxed*]"
msgstr "*r*[*elaxerad*]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Upper and lower case are accepted and equivalent, long name parts are truncated (e.g. _verylongname.foobar_ becomes _verylong.foo_), leading and embedded spaces are accepted in each name part (name and extension)."
msgstr "Versaler och gemener accepteras och är likvärdiga, långa namndelar trunkeras (t.ex. _verylongname.foobar_ blir _verylong.foo_), inledande och inbäddade mellanslag accepteras i varje namndel (namn och tillägg)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*n*[*ormal*]"
msgstr "*n*[*ormal*]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Like \"relaxed\", but many special characters (*, ?, <, spaces, etc.) are rejected. This is the default."
msgstr "Som \"relaxed\", men många specialtecken (*, ?, <, mellanslag etc.) avvisas. Detta är standardinställningen."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*s*[*trict*]"
msgstr "*s*[*trikt*]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Like \"normal\", but names that contain long parts or special characters that are sometimes used on Linux but are not accepted by MS-DOS (+, =, etc.) are rejected."
msgstr "Som \"normal\", men namn som innehåller långa delar eller specialtecken som ibland används på Linux men som inte accepteras av MS-DOS (+, =, etc.) avvisas."

#. from tp:util-linux-man-2.41.2-rc1
msgid "**codepage=**__value__"
msgstr "**codepage=**__värde__"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Sets the codepage for converting to shortname characters on FAT and VFAT filesystems. By default, codepage 437 is used."
msgstr "Ställer in kodsidan för konvertering till kortnamnstecken på FAT- och VFAT-filsystem. Som standard används kodsida 437."

#. from tp:util-linux-man-2.41.2-rc1
msgid "**conv=**__mode__"
msgstr "**conv=**__läge__"

#. from tp:util-linux-man-2.41.2-rc1
msgid "This option is obsolete and may fail or be ignored."
msgstr "Denna flagga är föråldrad och kan misslyckas eller ignoreras."

#. from tp:util-linux-man-2.41.2-rc1
msgid "**cvf_format=**__module__"
msgstr "**cvf_format=**__module__"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Forces the driver to use the CVF (Compressed Volume File) module cvf___module__ instead of auto-detection. If the kernel supports *kmod*, the **cvf_format=**__xxx__ option also controls on-demand CVF module loading. This option is obsolete."
msgstr "Tvingar drivrutinen att använda CVF-modulen (Compressed Volume File) cvf___module__ i stället för automatisk detektering. Om kärnan stöder *kmod*, kontrollerar flaggan **cvf_format=**__xxx__ också CVF-modulens laddning på begäran. Denna flagga är föråldrad."

#. from tp:util-linux-man-2.41.2-rc1
msgid "**cvf_option=**__option__"
msgstr "**cvf_option=**__option__"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Option passed to the CVF module. This option is obsolete."
msgstr "Flagga som skickas till CVF-modulen. Denna flagga är föråldrat."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*debug*"
msgstr "*debug*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Turn on the _debug_ flag. A version string and a list of filesystem parameters will be printed (these data are also printed if the parameters appear to be inconsistent)."
msgstr "Slå på flaggan _debug_. En versionssträng och en lista över filsystemets parametrar skrivs ut (dessa data skrivs också ut om parametrarna verkar vara inkonsekventa)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*discard*"
msgstr "*discard*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "If set, causes discard/TRIM commands to be issued to the block device when blocks are freed. This is useful for SSD devices and sparse/thinly-provisioned LUNs."
msgstr "Om inställningen är Set, kommer discard/TRIM-kommandon att skickas till blockenheten när block frigörs. Detta är användbart för SSD-enheter och LUN:er med gles/tunn provisionering."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*dos1xfloppy*"
msgstr "*dos1xfloppy*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "If set, use a fallback default BIOS Parameter Block configuration, determined by backing device size. These static parameters match defaults assumed by DOS 1.x for 160 kiB, 180 kiB, 320 kiB, and 360 kiB floppies and floppy images."
msgstr "Om den är inställd används en standardkonfiguration för BIOS Parameter Block, som bestäms av storleken på lagringsenheten. Dessa statiska parametrar motsvarar de standardvärden som DOS 1.x antar för 160 kB, 180 kB, 320 kB och 360 kB disketter och diskettavbildningar."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*errors=*{**panic**|**continue**|*remount-ro*}"
msgstr "*fel=*{**panic**|**continue**|*remount-ro*}"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Specify FAT behavior on critical errors: panic, continue without doing anything, or remount the partition in read-only mode (default behavior)."
msgstr "Ange FAT:s beteende vid kritiska fel: panik, fortsätt utan att göra något eller ommontera partitionen i skrivskyddat läge (standardbeteende)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*fat=*{**12**|**16**|*32*}"
msgstr "*fat=*{**12**|**16**|*32*}"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Specify a 12, 16 or 32 bit fat. This overrides the automatic FAT type detection routine. Use with caution!"
msgstr "Ange en 12-, 16- eller 32-bitars fettkod. Detta åsidosätter den automatiska rutinen för detektering av FAT-typ. Använd med försiktighet!"

#. from tp:util-linux-man-2.41.2-rc1
msgid "**iocharset=**__value__"
msgstr "**iocharset=**__värde__"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Character set to use for converting between 8 bit characters and 16 bit Unicode characters. The default is iso8859-1. Long filenames are stored on disk in Unicode format."
msgstr "Teckenuppsättning som ska användas för konvertering mellan 8-bitars tecken och 16-bitars Unicode-tecken. Standardvärdet är iso8859-1. Långa filnamn lagras på disken i Unicode-format."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*nfs=*{**stale_rw**|*nostale_ro*}"
msgstr "*nfs=*{**stale_rw**|*nostale_ro*}"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Enable this only if you want to export the FAT filesystem over NFS."
msgstr "Aktivera detta endast om du vill exportera FAT-filsystemet via NFS."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*stale_rw*: This option maintains an index (cache) of directory inodes which is used by the nfs-related code to improve look-ups. Full file operations (read/write) over NFS are supported but with cache eviction at NFS server, this could result in spurious *ESTALE* errors."
msgstr "*stale_rw*: Denna flagga upprätthåller ett index (cache) över kataloginoder som används av den NFS-relaterade koden för att förbättra uppslagningar. Fullständiga filoperationer (läsa/skriva) över NFS stöds, men med cache-utrymning på NFS-servern kan detta resultera i falska *ESTALE*-fel."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*nostale_ro*: This option bases the inode number and file handle on the on-disk location of a file in the FAT directory entry. This ensures that *ESTALE* will not be returned after a file is evicted from the inode cache. However, it means that operations such as rename, create and unlink could cause file handles that previously pointed at one file to point at a different file, potentially causing data corruption. For this reason, this option also mounts the filesystem readonly."
msgstr "*nostale_ro*: Den här flaggan baserar inodnumret och filhandtaget på filens plats på disken i FAT-katalogposten. Detta säkerställer att *ESTALE* inte returneras efter att en fil har tagits bort från inodecachen. Det innebär dock att operationer som att byta namn på, skapa och ta bort länkar kan leda till att filhandtag som tidigare pekade på en fil nu pekar på en annan fil, vilket kan orsaka datakorruption. Av denna anledning monterar denna flagga även filsystemet skrivskyddat."

#. from tp:util-linux-man-2.41.2-rc1
msgid "To maintain backward compatibility, *-o nfs* is also accepted, defaulting to *stale_rw*."
msgstr "För att upprätthålla bakåtkompatibilitet accepteras även *-o nfs*, med *stale_rw* som standard."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*tz=UTC*"
msgstr "*tz=UTC*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "This option disables the conversion of timestamps between local time (as used by Windows on FAT) and UTC (which Linux uses internally). This is particularly useful when mounting devices (like digital cameras) that are set to UTC in order to avoid the pitfalls of local time."
msgstr "Den här flaggan inaktiverar omvandlingen av tidsstämplar mellan lokal tid (som används av Windows på FAT) och UTC (som Linux använder internt). Detta är särskilt användbart när du monterar enheter (t.ex. digitalkameror) som är inställda på UTC för att undvika fallgroparna med lokal tid."

#. from tp:util-linux-man-2.41.2-rc1
msgid "**time_offset=**__minutes__"
msgstr "**time_offset=**__minutes__"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Set offset for conversion of timestamps from local time used by FAT to UTC. I.e., _minutes_ will be subtracted from each timestamp to convert it to UTC used internally by Linux. This is useful when the time zone set in the kernel via *settimeofday*(2) is not the time zone used by the filesystem. Note that this option still does not provide correct time stamps in all cases in presence of DST - time stamps in a different DST setting will be off by one hour."
msgstr "Ställ in offset för konvertering av tidsstämplar från lokal tid som används av FAT till UTC. D.v.s. _minuter_ kommer att subtraheras från varje tidsstämpel för att konvertera den till UTC som används internt av Linux. Detta är användbart när den tidszon som ställs in i kärnan via *settimeofday*(2) inte är den tidszon som används av filsystemet. Observera att den här flaggan fortfarande inte ger korrekta tidsstämplar i alla fall när det gäller sommartid - tidsstämplar med en annan inställning för sommartid kommer att vara en timme fel."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*quiet*"
msgstr "*tyst*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Turn on the _quiet_ flag. Attempts to chown or chmod files do not return errors, although they fail. Use with caution!"
msgstr "Slå på flaggan _quiet_. Försök att chown- eller chmod-filer returnerar inte fel, även om de misslyckas. Använd med försiktighet!"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*rodir*"
msgstr "*rodir*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "FAT has the *ATTR_RO* (read-only) attribute. On Windows, the *ATTR_RO* of the directory will just be ignored, and is used only by applications as a flag (e.g. it's set for the customized folder)."
msgstr "FAT har attributet *ATTR_RO* (skrivskyddad). I Windows ignoreras *ATTR_RO* för katalogen och används endast av program som en flagga (t.ex. är den inställd för den anpassade mappen)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "If you want to use *ATTR_RO* as read-only flag even for the directory, set this option."
msgstr "Om du vill använda *ATTR_RO* som skrivskyddad flagga även för katalogen ska du ange denna flagga."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*showexec*"
msgstr "*showexec*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "If set, the execute permission bits of the file will be allowed only if the extension part of the name is .EXE, .COM, or .BAT. Not set by default."
msgstr "Om den är inställd tillåts körningsbehörighetsbitarna i filen endast om tilläggsdelen av namnet är .EXE, .COM eller .BAT. Inte inställd som standard."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*sys_immutable*"
msgstr "*sys_immutable*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "If set, *ATTR_SYS* attribute on FAT is handled as *IMMUTABLE* flag on Linux. Not set by default."
msgstr "Om den är inställd hanteras *ATTR_SYS*-attributet på FAT som flaggan *IMMUTABLE* på Linux. Ej inställd som standard."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*flush*"
msgstr "*spola*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "If set, the filesystem will try to flush to disk more early than normal. Not set by default."
msgstr "Om den är inställd kommer filsystemet att försöka spola till disk tidigare än normalt. Ej inställd som standard."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*usefree*"
msgstr "*användningsfri*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Use the \"free clusters\" value stored on *FSINFO*. It'll be used to determine number of free clusters without scanning disk. But it's not used by default, because recent Windows don't update it correctly in some case. If you are sure the \"free clusters\" on *FSINFO* is correct, by this option you can avoid scanning disk."
msgstr "Använd värdet \"free clusters\" som finns lagrat på *FSINFO*. Det kommer att användas för att bestämma antalet lediga kluster utan att skanna disken. Men det används inte som standard, eftersom nya Windows i vissa fall inte uppdaterar det korrekt. Om du är säker på att \"lediga kluster\" i *FSINFO* är korrekt kan du undvika att skanna disken med den här flaggan."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*dots*, *nodots*, *dotsOK=*[**yes**|*no*]"
msgstr "*prickar*, *noddar*, *prickarOK=*[**ja**|*nej*]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Various misguided attempts to force Unix or DOS conventions onto a FAT filesystem."
msgstr "Olika missriktade försök att tvinga in Unix- eller DOS-konventioner i ett FAT-filsystem."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Mount options for hfs"
msgstr "Flaggor för montering av hfs"

#. from tp:util-linux-man-2.41.2-rc1
msgid "**creator=**__cccc__**, type=**__cccc__"
msgstr "**creator=**__cccc__**, type=**__cccc__"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Set the creator/type values as shown by the MacOS finder used for creating new files. Default values: '????'."
msgstr "Ställ in värdena för skapare/typ som visas av MacOS-sökaren som används för att skapa nya filer. Standardvärden: '????'."

#. from tp:util-linux-man-2.41.2-rc1
msgid "**dir_umask=**__n__**, file_umask=**__n__**, umask=**__n__"
msgstr "**dir_umask=**__n__**, file_umask=**__n__**, umask=**__n__"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Set the umask used for all directories, all regular files, or all files and directories. Defaults to the umask of the current process."
msgstr "Ange den umask som används för alla kataloger, alla vanliga filer eller alla filer och kataloger. Standardvärdet är umask för den aktuella processen."

#. from tp:util-linux-man-2.41.2-rc1
msgid "**session=**__n__"
msgstr "**session=**__n__"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Select the CDROM session to mount. Defaults to leaving that decision to the CDROM driver. This option will fail with anything but a CDROM as underlying device."
msgstr "Välj den CDROM-session som ska monteras. Standardinställningen är att överlåta detta beslut till CDROM-drivrutinen. Den här flaggan misslyckas med allt annat än en CDROM som underliggande enhet."

#. from tp:util-linux-man-2.41.2-rc1
msgid "**part=**__n__"
msgstr "**part=**__n__"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Select partition number n from the device. Only makes sense for CDROMs. Defaults to not parsing the partition table at all."
msgstr "Välj partitionsnummer n från enheten. Detta är bara meningsfullt för CDROM-skivor. Standardvärdet är att inte analysera partitionstabellen alls."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Don't complain about invalid mount options."
msgstr "Klagar inte på ogiltiga monteringsflaggor."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Mount options for hpfs"
msgstr "Flaggor för montering av hpfs"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*case=*{**lower**|*asis*}"
msgstr "*case=*{**lower**|*asis*}"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Convert all files names to lower case, or leave them. (Default: *case=lower*.)"
msgstr "Konvertera alla filnamn till gemener eller låt dem vara kvar. (Standard: *case=lower*.)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "This option is obsolete and may fail or being ignored."
msgstr "Denna flagga är föråldrad och kan misslyckas eller ignoreras."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*nocheck*"
msgstr "*nocheck*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Do not abort mounting when certain consistency checks fail."
msgstr "Avbryt inte monteringen när vissa konsistenskontroller misslyckas."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Mount options for iso9660"
msgstr "Monteringsflaggor för iso9660"

#. from tp:util-linux-man-2.41.2-rc1
msgid "ISO 9660 is a standard describing a filesystem structure to be used on CD-ROMs. (This filesystem type is also seen on some DVDs. See also the _udf_ filesystem.)"
msgstr "ISO 9660 är en standard som beskriver en filsystemstruktur som ska användas på cd-romskivor. (Den här typen av filsystem finns också på vissa DVD-skivor. Se även filsystemet _udf_)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Normal _iso9660_ filenames appear in an 8.3 format (i.e., DOS-like restrictions on filename length), and in addition all characters are in upper case. Also there is no field for file ownership, protection, number of links, provision for block/character devices, etc."
msgstr "Normala _iso9660_-filnamn visas i ett 8.3-format (dvs. DOS-liknande begränsningar av filnamnslängden), och dessutom är alla tecken versaler. Det finns inte heller något fält för filägande, skydd, antal länkar, block/karaktär-enheter etc."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Rock Ridge is an extension to iso9660 that provides all of these UNIX-like features. Basically there are extensions to each directory record that supply all of the additional information, and when Rock Ridge is in use, the filesystem is indistinguishable from a normal UNIX filesystem (except that it is read-only, of course)."
msgstr "Rock Ridge är ett tillägg till iso9660 som tillhandahåller alla dessa UNIX-liknande funktioner. I princip finns det tillägg till varje katalogpost som ger all ytterligare information, och när Rock Ridge används kan filsystemet inte skiljas från ett vanligt UNIX-filsystem (förutom att det är skrivskyddat, förstås)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*norock*"
msgstr "*norock*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Disable the use of Rock Ridge extensions, even if available. Cf. *map*."
msgstr "Inaktivera användningen av Rock Ridge-tillägg, även om de är tillgängliga. Se t.ex. *karta*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*nojoliet*"
msgstr "*nojoliet*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Disable the use of Microsoft Joliet extensions, even if available. Cf. *map*."
msgstr "Inaktivera användningen av Microsoft Joliet-tillägg, även om de är tillgängliga. Jfr. *map*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*check=*{*r*[*elaxed*]|*s*[*trict*]}"
msgstr "*check=*{*r*[*elaxed*]|*s*[*trict*]}"

#. from tp:util-linux-man-2.41.2-rc1
msgid "With *check=relaxed*, a filename is first converted to lower case before doing the lookup. This is probably only meaningful together with *norock* and *map=normal*. (Default: *check=strict*.)"
msgstr "Med *check=relaxed* konverteras ett filnamn först till gemener innan uppslagningen görs. Detta är förmodligen bara meningsfullt tillsammans med *norock* och *map=normal*. (Standard: *check=strict*.)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Give all files in the filesystem the indicated user or group id, possibly overriding the information found in the Rock Ridge extensions. (Default: *uid=0,gid=0*.)"
msgstr "Ge alla filer i filsystemet det angivna användar- eller grupp-ID:t, vilket kan åsidosätta den information som finns i Rock Ridge-tilläggen. (Standard: *uid=0,gid=0*.)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*map=*{*n*[*ormal*]|*o*[*ff*]|*a*[*corn*]}"
msgstr "*map=*{*n*[*ormal*]|*o*[*ff*]|*a*[*corn*]}"

#. from tp:util-linux-man-2.41.2-rc1
msgid "For non-Rock Ridge volumes, normal name translation maps upper to lower case ASCII, drops a trailing ';1', and converts ';' to '.'. With *map=off* no name translation is done. See *norock*. (Default: *map=normal*.) *map=acorn* is like *map=normal* but also apply Acorn extensions if present."
msgstr "För icke-Rock Ridge-volymer omvandlar normal namnöversättning versaler till gemener i ASCII, tar bort ett efterföljande ';1' och konverterar ';' till '.'. Med *map=off* görs ingen namnöversättning. Se *norock*. (Standard: *map=normal*.) *map=acorn* är som *map=normal* men tillämpar även Acorn-tillägg om sådana finns."

#. from tp:util-linux-man-2.41.2-rc1
msgid "For non-Rock Ridge volumes, give all files the indicated mode. (Default: read and execute permission for everybody.) Octal mode values require a leading 0."
msgstr "För volymer som inte tillhör Rock Ridge, ge alla filer det angivna läget. (Standard: läs- och exekveringsbehörighet för alla.) Oktala lägesvärden kräver en inledande 0."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*unhide*"
msgstr "*avslöja*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Also show hidden and associated files. (If the ordinary files and the associated or hidden files have the same filenames, this may make the ordinary files inaccessible.)"
msgstr "Visa även dolda och associerade filer. (Om de vanliga filerna och de associerade eller dolda filerna har samma filnamn kan detta göra de vanliga filerna otillgängliga)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*block=*{**512**|**1024**|*2048*}"
msgstr "*block=*{**512**|**1024**|*2048*}"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Set the block size to the indicated value. (Default: *block=1024*.)"
msgstr "Ställ in blockstorleken till det angivna värdet. (Standard: *block=1024*.)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*cruft*"
msgstr "*cruft*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "If the high byte of the file length contains other garbage, set this mount option to ignore the high order bits of the file length. This implies that a file cannot be larger than 16 MB."
msgstr "Om den högsta byten i fillängden innehåller annat skräp kan du ställa in den här monteringsflaggan så att de högsta bitarna i fillängden ignoreras. Detta innebär att en fil inte kan vara större än 16 MB."

#. from tp:util-linux-man-2.41.2-rc1
msgid "**session=**__x__"
msgstr "**session=**__x__"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Select number of session on a multisession CD."
msgstr "Välj antal sessioner på en CD med flera sessioner."

#. from tp:util-linux-man-2.41.2-rc1
msgid "**sbsector=**__xxx__"
msgstr "**sbsector=**__xxx__"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Session begins from sector xxx."
msgstr "Sessionen börjar från sektor xxx."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The following options are the same as for vfat and specifying them only makes sense when using discs encoded using Microsoft's Joliet extensions."
msgstr "Följande flaggor är desamma som för vfat och det är bara meningsfullt att ange dem när du använder skivor som är kodade med Microsofts Joliet-tillägg."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Character set to use for converting 16 bit Unicode characters on CD to 8 bit characters. The default is iso8859-1."
msgstr "Teckenuppsättning som ska användas för att konvertera 16-bitars Unicode-tecken på CD till 8-bitars tecken. Standardvärdet är iso8859-1."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*utf8*"
msgstr "*utf8*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Convert 16 bit Unicode characters on CD to UTF-8."
msgstr "Konvertera 16 bitars Unicode-tecken på CD till UTF-8."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Mount options for jfs"
msgstr "Flaggor för montering av jfs"

#. from tp:util-linux-man-2.41.2-rc1
msgid "**iocharset=**__name__"
msgstr "**iocharset=**__namn__"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Character set to use for converting from Unicode to ASCII. The default is to do no conversion. Use *iocharset=utf8* for UTF8 translations. This requires *CONFIG_NLS_UTF8* to be set in the kernel _.config_ file."
msgstr "Teckenuppsättning som ska användas vid konvertering från Unicode till ASCII. Standardinställningen är att ingen konvertering görs. Använd *iocharset=utf8* för UTF8-översättningar. Detta kräver att *CONFIG_NLS_UTF8* är inställd i filen kernel _.config_."

#. from tp:util-linux-man-2.41.2-rc1
msgid "**resize=**__value__"
msgstr "**resize=**__värde__"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Resize the volume to _value_ blocks. JFS only supports growing a volume, not shrinking it. This option is only valid during a remount, when the volume is mounted read-write. The *resize* keyword with no value will grow the volume to the full size of the partition."
msgstr "Ändra storlek på volymen till _värde_ block. JFS stöder endast att en volym växer, inte att den krymper. Denna flagga är endast giltigt under en ommontering, när volymen är monterad som skrivskyddad. Nyckelordet *resize* utan värde gör att volymen växer till partitionens fulla storlek."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*nointegrity*"
msgstr "*nointegrity*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Do not write to the journal. The primary use of this option is to allow for higher performance when restoring a volume from backup media. The integrity of the volume is not guaranteed if the system abnormally ends."
msgstr "Skriv inte till journalen. Den primära användningen av denna flagga är att möjliggöra högre prestanda vid återställning av en volym från säkerhetskopieringsmedia. Volymens integritet garanteras inte om systemet avslutas på ett onormalt sätt."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*integrity*"
msgstr "*integritet*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Default. Commit metadata changes to the journal. Use this option to remount a volume where the *nointegrity* option was previously specified in order to restore normal behavior."
msgstr "Standard. Överför metadataförändringar till journalen. Använd den här flaggan för att återmontera en volym där flaggan *nointegrity* tidigare har angetts för att återställa normalt beteende."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*errors=*{**continue**|**remount-ro**|*panic*}"
msgstr "*fel=*{**continue**|**remount-ro**|*panic*}"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Define the behavior when an error is encountered. (Either ignore errors and just mark the filesystem erroneous and continue, or remount the filesystem read-only, or panic and halt the system.)"
msgstr "Definiera beteendet när ett fel påträffas. (Antingen ignorerar du fel och markerar bara filsystemet som felaktigt och fortsätter, eller så återmonterar du filsystemet som skrivskyddat, eller så får du panik och stoppar systemet)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "**noquota**|**quota**|**usrquota**|*grpquota*"
msgstr "**noquota**|**quota**|**usrquota**|*grpquota*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "These options are accepted but ignored."
msgstr "Dessa flaggor accepteras men ignoreras."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Mount options for msdos"
msgstr "Flaggor för montering av msdos"

#. from tp:util-linux-man-2.41.2-rc1
msgid "See mount options for fat. If the _msdos_ filesystem detects an inconsistency, it reports an error and sets the file system read-only. The filesystem can be made writable again by remounting it."
msgstr "Se monteringsflaggor för fat. Om filsystemet _msdos_ upptäcker en inkonsekvens rapporterar det ett fel och sätter filsystemet i skrivskyddat läge. Filsystemet kan göras skrivbart igen genom att återmontera det."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Mount options for ncpfs"
msgstr "Monteringsflaggor för ncpfs"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Just like _nfs_, the _ncpfs_ implementation expects a binary argument (a _struct ncp_mount_data_) to the *mount*(2) system call. This argument is constructed by *ncpmount*(8) and the current version of *mount* (2.12) does not know anything about ncpfs."
msgstr "Precis som _nfs_ förväntar sig implementeringen av _ncpfs_ ett binärt argument (en _struct ncp_mount_data_) till systemanropet *mount*(2). Detta argument konstrueras av *ncpmount*(8) och den aktuella versionen av *mount* (2.12) vet ingenting om ncpfs."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Mount options for ntfs"
msgstr "Monteringsflaggor för ntfs"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Character set to use when returning file names. Unlike VFAT, NTFS suppresses names that contain nonconvertible characters. Deprecated."
msgstr "Teckenuppsättning som ska användas vid returnering av filnamn. Till skillnad från VFAT undertrycker NTFS namn som innehåller icke-konvertibla tecken. Föråldrad."

#. from tp:util-linux-man-2.41.2-rc1
msgid "**nls=**__name__"
msgstr "**nls=**__namn__"

#. from tp:util-linux-man-2.41.2-rc1
msgid "New name for the option earlier called _iocharset_."
msgstr "Nytt namn för det flaggan som tidigare kallades _iocharset_."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Use UTF-8 for converting file names."
msgstr "Använd UTF-8 för att konvertera filnamn."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*uni_xlate=*{**0**|**1**|*2*}"
msgstr "*uni_xlate=*{**0**|**1**|*2*}"

#. from tp:util-linux-man-2.41.2-rc1
msgid "For 0 (or 'no' or 'false'), do not use escape sequences for unknown Unicode characters. For 1 (or 'yes' or 'true') or 2, use vfat-style 4-byte escape sequences starting with \":\". Here 2 gives a little-endian encoding and 1 a byteswapped bigendian encoding."
msgstr "För 0 (eller 'nej' eller 'false'), använd inte escape-sekvenser för okända Unicode-tecken. För 1 (eller 'yes' eller 'true') eller 2, använd 4-byte escape-sekvenser i vfat-stil som börjar med \":\". Här ger 2 en little-endian-kodning och 1 en byteswappad bigendian-kodning."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*posix=[0|1]*"
msgstr "*posix=[0|1]*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "If enabled (posix=1), the filesystem distinguishes between upper and lower case. The 8.3 alias names are presented as hard links instead of being suppressed. This option is obsolete."
msgstr "Om detta är aktiverat (posix=1) skiljer filsystemet mellan stora och små bokstäver. 8.3 aliasnamnen presenteras som hårda länkar istället för att undertryckas. Denna flagga är föråldrat."

#. from tp:util-linux-man-2.41.2-rc1
msgid "**uid=**__value__, **gid=**__value__ and **umask=**__value__"
msgstr "**uid=**__värde__, **gid=**__värde__ and **umask=**__värde__"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Set the file permission on the filesystem. The umask value is given in octal. By default, the files are owned by root and not readable by somebody else."
msgstr "Ställer in filbehörigheten på filsystemet. Umask-värdet anges i oktal. Som standard ägs filerna av root och är inte läsbara av någon annan."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Mount options for overlay"
msgstr "Monteringsflaggor för overlay"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Since Linux 3.18 the overlay pseudo filesystem implements a union mount for other filesystems."
msgstr "Sedan Linux 3.18 implementerar pseudofilsystemet Overlay en unionsmontering för andra filsystem."

#. from tp:util-linux-man-2.41.2-rc1
msgid "An overlay filesystem combines two filesystems - an *upper* filesystem and a *lower* filesystem. When a name exists in both filesystems, the object in the upper filesystem is visible while the object in the lower filesystem is either hidden or, in the case of directories, merged with the upper object."
msgstr "Ett overlay-filsystem kombinerar två filsystem - ett *övre* filsystem och ett *nedre* filsystem. När ett namn finns i båda filsystemen är objektet i det övre filsystemet synligt medan objektet i det nedre filsystemet antingen är dolt eller, när det gäller kataloger, sammanfogat med det övre objektet."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The lower filesystem can be any filesystem supported by Linux and does not need to be writable. The lower filesystem can even be another overlayfs. The upper filesystem will normally be writable and if it is it must support the creation of trusted.* extended attributes, and must provide a valid d_type in readdir responses, so NFS is not suitable."
msgstr "Det lägre filsystemet kan vara vilket filsystem som helst som stöds av Linux och behöver inte vara skrivbart. Det nedre filsystemet kan till och med vara ett annat overlayfs. Det övre filsystemet kommer normalt att vara skrivbart och om det är det måste det stödja skapandet av trusted.*-utökade attribut och måste tillhandahålla en giltig d_type i readdir-svar, så NFS är inte lämpligt."

#. from tp:util-linux-man-2.41.2-rc1
msgid "A read-only overlay of two read-only filesystems may use any filesystem type. The options *lowerdir* and *upperdir* are combined into a merged directory by using:"
msgstr "En skrivskyddad överlagring av två skrivskyddade filsystem kan använda vilken filsystemstyp som helst. Flaggorna *lowerdir* och *upperdir* kombineras till en sammanslagen katalog genom att använda:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "mount -t overlay  overlay  \\\n  -olowerdir=/lower,upperdir=/upper,workdir=/work  /merged\n"
msgstr "mount -t överlägg överlägg \\\n  -olowerdir=/lower,upperdir=/upper,workdir=/work /merged\n"

#. from tp:util-linux-man-2.41.2-rc1
msgid "**lowerdir=**__directory__"
msgstr "**lowerdir=**__katalog__"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Any filesystem, does not need to be on a writable filesystem."
msgstr "Alla filsystem, behöver inte vara på ett skrivbart filsystem."

#. from tp:util-linux-man-2.41.2-rc1
msgid "**upperdir=**__directory__"
msgstr "**upperdir=**__katalog__"

#. from tp:util-linux-man-2.41.2-rc1
msgid "The upperdir is normally on a writable filesystem."
msgstr "Upperdir ligger normalt på ett skrivbart filsystem."

#. from tp:util-linux-man-2.41.2-rc1
msgid "**workdir=**__directory__"
msgstr "**workdir=**__katalog__"

#. from tp:util-linux-man-2.41.2-rc1
msgid "The workdir needs to be an empty directory on the same filesystem as upperdir."
msgstr "Workdir måste vara en tom katalog i samma filsystem som upperdir."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*userxattr*"
msgstr "*användarexattr*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Use the \"*user.overlay.*\" xattr namespace instead of \"*trusted.overlay.*\". This is useful for unprivileged mounting of overlayfs."
msgstr "Använd namnrymden \"*user.overlay.*\" xattr-namnrymden istället för \"*trusted.overlay.*\". Detta är användbart för icke-privilegierad montering av overlayfs."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*redirect_dir=*{**on**|**off**|**follow**|**nofollow**}"
msgstr "*redirect_dir=*{**on**|**off**|**follow**|**nofollow**}"

#. from tp:util-linux-man-2.41.2-rc1
msgid "If the _redirect_dir_ feature is enabled, then the directory will be copied up (but not the contents). Then the \"{**trusted**|**user**}.overlay.redirect\" extended attribute is set to the path of the original location from the root of the overlay. Finally the directory is moved to the new location."
msgstr "Om funktionen _redirect_dir_ är aktiverad kommer katalogen att kopieras upp (men inte innehållet). Sedan sätts det utökade attributet \"{**trusted**|**user**}.overlay.redirect\" till sökvägen till den ursprungliga platsen från roten av överlägget. Slutligen flyttas katalogen till den nya platsen."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*on*"
msgstr "*på*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Redirects are enabled."
msgstr "Omdirigeringar är aktiverade."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*off*"
msgstr "*av*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Redirects are not created and only followed if \"redirect_always_follow\" feature is enabled in the kernel/module config."
msgstr "Omdirigeringar skapas inte och följs endast om funktionen \"redirect_always_follow\" är aktiverad i konfigurationen för kärnan/modulen."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*follow*"
msgstr "*följ*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Redirects are not created, but followed."
msgstr "Omdirigeringar skapas inte, utan följs."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*nofollow*"
msgstr "*nofollow*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Redirects are not created and not followed (equivalent to \"redirect_dir=off\" if \"redirect_always_follow\" feature is not enabled)."
msgstr "Omdirigeringar skapas inte och följs inte (motsvarar \"redirect_dir=off\" om funktionen \"redirect_always_follow\" inte är aktiverad)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*index=*{**on**|**off**}"
msgstr "*index=*{**on**|**off**}"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Inode index. If this feature is disabled and a file with multiple hard links is copied up, then this will \"break\" the link. Changes will not be propagated to other names referring to the same inode."
msgstr "Inode-index. Om den här funktionen är inaktiverad och en fil med flera hårda länkar kopieras upp, kommer länken att \"brytas\". Ändringar kommer inte att spridas till andra namn som hänvisar till samma inode."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*uuid=*{**on**|**off**}"
msgstr "*uuid=*{**on**|**off**}"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Can be used to replace UUID of the underlying filesystem in file handles with null, and effectively disable UUID checks. This can be useful in case the underlying disk is copied and the UUID of this copy is changed. This is only applicable if all lower/upper/work directories are on the same filesystem, otherwise it will fallback to normal behaviour."
msgstr "Kan användas för att ersätta UUID för det underliggande filsystemet i filhandtag med null, och effektivt inaktivera UUID-kontroller. Detta kan vara användbart om den underliggande disken kopieras och UUID för denna kopia ändras. Detta är endast tillämpligt om alla lägre/övre/arbetskataloger finns på samma filsystem, annars återgår det till normalt beteende."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*nfs_export=*{**on**|**off**}"
msgstr "*nfs_export=*{**on**|**off**}"

#. from tp:util-linux-man-2.41.2-rc1
msgid "When the underlying filesystems supports NFS export and the \"nfs_export\" feature is enabled, an overlay filesystem may be exported to NFS."
msgstr "När det underliggande filsystemet stöder NFS-export och funktionen \"nfs_export\" är aktiverad, kan ett överliggande filsystem exporteras till NFS."

#. from tp:util-linux-man-2.41.2-rc1
msgid "With the \"nfs_export\" feature, on copy_up of any lower object, an index entry is created under the index directory. The index entry name is the hexadecimal representation of the copy up origin file handle. For a non-directory object, the index entry is a hard link to the upper inode. For a directory object, the index entry has an extended attribute \"{**trusted**|**user**}.overlay.upper\" with an encoded file handle of the upper directory inode."
msgstr "Med funktionen \"nfs_export\" skapas en indexpost under indexkatalogen vid copy_up av ett lägre objekt. Namnet på indexposten är den hexadecimala representationen av ursprungsfilhandtaget för uppkopieringen. För ett objekt som inte är en katalog är indexposten en hård länk till den övre inoden. För ett katalogobjekt har indexposten ett utökat attribut \"{**trusted**|**user**}.overlay.upper\" med ett kodat filhandtag för den övre katalogens inod."

#. from tp:util-linux-man-2.41.2-rc1
msgid "When encoding a file handle from an overlay filesystem object, the following rules apply"
msgstr "Vid kodning av ett filhandtag från ett overlay-filsystemobjekt gäller följande regler"

#. from tp:util-linux-man-2.41.2-rc1
msgid "For a non-upper object, encode a lower file handle from lower inode"
msgstr "För ett objekt som inte är högre, koda ett lägre filhandtag från lägre inode"

#. from tp:util-linux-man-2.41.2-rc1
msgid "For an indexed object, encode a lower file handle from copy_up origin"
msgstr "För ett indexerat objekt, koda ett lägre filhandtag från copy_up origin"

#. from tp:util-linux-man-2.41.2-rc1
msgid "For a pure-upper object and for an existing non-indexed upper object, encode an upper file handle from upper inode"
msgstr "För ett rent övre objekt och för ett befintligt icke-indexerat övre objekt, koda ett övre filhandtag från övre inode"

#. from tp:util-linux-man-2.41.2-rc1
msgid "The encoded overlay file handle includes"
msgstr "Handtaget för den kodade overlay-filen innehåller"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Header including path type information (e.g. lower/upper)"
msgstr "Header med information om typ av tågläge (t.ex. nedre/övre)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "UUID of the underlying filesystem"
msgstr "UUID för det underliggande filsystemet"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Underlying filesystem encoding of underlying inode"
msgstr "Underliggande filsystemkodning av underliggande inode"

#. from tp:util-linux-man-2.41.2-rc1
msgid "This encoding format is identical to the encoding format of file handles that are stored in extended attribute \"{**trusted**|**user**}.overlay.origin\". When decoding an overlay file handle, the following steps are followed"
msgstr "Detta kodningsformat är identiskt med kodningsformatet för filhandtag som lagras i det utökade attributet \"{**trusted**|**user**}.overlay.origin\". Vid avkodning av ett overlay-filhandtag följs följande steg"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Find underlying layer by UUID and path type information."
msgstr "Hitta underliggande lager med hjälp av UUID och information om sökvägstyp."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Decode the underlying filesystem file handle to underlying dentry."
msgstr "Avkodar det underliggande filsystemets filhandtag till underliggande dentry."

#. from tp:util-linux-man-2.41.2-rc1
msgid "For a lower file handle, lookup the handle in index directory by name."
msgstr "För ett lägre filhandtag, leta upp handtaget i indexkatalogen efter namn."

#. from tp:util-linux-man-2.41.2-rc1
msgid "If a whiteout is found in index, return **ESTALE**. This represents an overlay object that was deleted after its file handle was encoded."
msgstr "Om en whiteout hittas i index, returneras **ESTALE**. Detta representerar ett overlay-objekt som raderades efter att dess filhandtag kodades."

#. from tp:util-linux-man-2.41.2-rc1
msgid "For a non-directory, instantiate a disconnected overlay dentry from the decoded underlying dentry, the path type and index inode, if found."
msgstr "För en icke-katalog, instansiera en frånkopplad överläggsdentry från den avkodade underliggande dentry, sökvägstypen och indexinoden, om den hittas."

#. from tp:util-linux-man-2.41.2-rc1
msgid "For a directory, use the connected underlying decoded dentry, path type and index, to lookup a connected overlay dentry."
msgstr "För en katalog, använd den anslutna underliggande avkodade dentry, sökvägstyp och index, för att söka upp en ansluten överliggande dentry."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Decoding a non-directory file handle may return a disconnected dentry. copy_up of that disconnected dentry will create an upper index entry with no upper alias."
msgstr "Avkodning av ett filhandtag som inte finns i en katalog kan returnera en frånkopplad dentry. copy_up av denna frånkopplade dentry kommer att skapa en övre indexpost utan övre alias."

#. from tp:util-linux-man-2.41.2-rc1
msgid "When overlay filesystem has multiple lower layers, a middle layer directory may have a \"redirect\" to lower directory. Because middle layer \"redirects\" are not indexed, a lower file handle that was encoded from the \"redirect\" origin directory, cannot be used to find the middle or upper layer directory.  Similarly, a lower file handle that was encoded from a descendant of the \"redirect\" origin directory, cannot be used to reconstruct a connected overlay path. To mitigate the cases of directories that cannot be decoded from a lower file handle, these directories are copied up on encode and encoded as an upper file handle. On an overlay filesystem with no upper layer this mitigation cannot be used NFS export in this setup requires turning off redirect follow (e.g. \"__redirect_dir=nofollow__\")."
msgstr "När ett överliggande filsystem har flera lägre lager kan en katalog i mellanlagret ha en \"omdirigering\" till en lägre katalog. Eftersom \"omdirigeringar\" i mellanskiktet inte indexeras, kan ett lägre filhandtag som kodats från ursprungskatalogen för \"omdirigering\" inte användas för att hitta katalogen i mellanskiktet eller det övre skiktet.  På samma sätt kan ett lägre filhandtag som kodats från en efterkommande till ursprungskatalogen för \"redirect\" inte användas för att rekonstruera en ansluten överlagringsväg. För att minska antalet kataloger som inte kan avkodas från ett lägre filhandtag kopieras dessa kataloger upp vid kodningen och kodas som ett övre filhandtag. På ett överliggande filsystem utan övre lager kan denna begränsning inte användas NFS export i denna konfiguration kräver att man stänger av redirect follow (t.ex. \"__redirect_dir=nofollow__\")."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The overlay filesystem does not support non-directory connectable file handles, so exporting with the _subtree_check_ exportfs configuration will cause failures to lookup files over NFS."
msgstr "Overlay-filsystemet stöder inte anslutningsbara filhandtag som inte är katalogiserade, så export med konfigurationen _subtree_check_ exportfs kommer att orsaka fel vid sökning av filer via NFS."

#. from tp:util-linux-man-2.41.2-rc1
msgid "When the NFS export feature is enabled, all directory index entries are verified on mount time to check that upper file handles are not stale. This verification may cause significant overhead in some cases."
msgstr "När funktionen NFS export är aktiverad verifieras alla katalogindexposter vid monteringen för att kontrollera att de övre filhandtagen inte är inaktuella. Denna verifiering kan orsaka betydande overhead i vissa fall."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Note: the mount options __index=off,nfs_export=on__ are conflicting for a read-write mount and will result in an error."
msgstr "Observera: Monteringsflaggoren __index=off,nfs_export=on__ är motstridiga för en skrivläsningsmontering och kommer att resultera i ett fel."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*xino=*{**on**|**off**|**auto**}"
msgstr "*xino=*{**on**|**off**|**auto**}"

#. from tp:util-linux-man-2.41.2-rc1
msgid "The \"xino\" feature composes a unique object identifier from the real object st_ino and an underlying fsid index. The \"xino\" feature uses the high inode number bits for fsid, because the underlying filesystems rarely use the high inode number bits. In case the underlying inode number does overflow into the high xino bits, overlay filesystem will fall back to the non xino behavior for that inode."
msgstr "\"xino\"-funktionen består av en unik objektidentifierare från det verkliga objektet st_ino och ett underliggande fsid-index. \"xino\"-funktionen använder de höga inodnummerbitarna för fsid, eftersom de underliggande filsystemen sällan använder de höga inodnummerbitarna. Om det underliggande inodnumret övergår till de höga xino-bitarna kommer overlay-filsystemet att återgå till icke-xino-beteendet för den inoden."

#. from tp:util-linux-man-2.41.2-rc1
msgid "For a detailed description of the effect of this option please refer to https://docs.kernel.org/filesystems/overlayfs.html"
msgstr "För en detaljerad beskrivning av effekten av denna flagga hänvisas till https://docs.kernel.org/filesystems/overlayfs.html"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*metacopy=*{**on**|**off**}"
msgstr "*metacopy=*{**on**|**off**}"

#. from tp:util-linux-man-2.41.2-rc1
msgid "When metadata only copy up feature is enabled, overlayfs will only copy up metadata (as opposed to whole file), when a metadata specific operation like chown/chmod is performed. Full file will be copied up later when file is opened for WRITE operation."
msgstr "När funktionen för att endast kopiera upp metadata är aktiverad kommer overlayfs endast att kopiera upp metadata (i motsats till hela filen) när en metadataspecifik åtgärd som chown/chmod utförs. Hela filen kommer att kopieras upp senare när filen öppnas för WRITE-operationen."

#. from tp:util-linux-man-2.41.2-rc1
msgid "In other words, this is delayed data copy up operation and data is copied up when there is a need to actually modify data."
msgstr "Med andra ord är detta en fördröjd datakopieringsoperation och data kopieras upp när det finns ett behov av att faktiskt modifiera data."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*volatile*"
msgstr "*volatile*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Volatile mounts are not guaranteed to survive a crash. It is strongly recommended that volatile mounts are only used if data written to the overlay can be recreated without significant effort."
msgstr "Det är inte garanterat att flyktiga mounts överlever en krasch. Det rekommenderas starkt att flyktiga monteringar endast används om data som skrivits till överlagringen kan återskapas utan större ansträngning."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The advantage of mounting with the \"volatile\" option is that all forms of sync calls to the upper filesystem are omitted."
msgstr "Fördelen med att montera med flaggan \"volatile\" är att alla former av synkroniseringsanrop till det övre filsystemet utelämnas."

#. from tp:util-linux-man-2.41.2-rc1
msgid "In order to avoid a giving a false sense of safety, the syncfs (and fsync) semantics of volatile mounts are slightly different than that of the rest of VFS. If any writeback error occurs on the upperdir’s filesystem after a volatile mount takes place, all sync functions will return an error. Once this condition is reached, the filesystem will not recover, and every subsequent sync call will return an error, even if the upperdir has not experience a new error since the last sync call."
msgstr "För att undvika att ge en falsk känsla av säkerhet är syncfs (och fsync) semantiken för flyktiga monteringar något annorlunda än för resten av VFS. Om något återskrivningsfel inträffar på upperdir-filsystemet efter att en flyktig montering har ägt rum, kommer alla syncfunktioner att returnera ett fel. När detta tillstånd har uppnåtts kommer filsystemet inte att återhämta sig och varje efterföljande synkroniseringsanrop kommer att returnera ett fel, även om det inte har uppstått något nytt fel i upperdir sedan det senaste synkroniseringsanropet."

#. from tp:util-linux-man-2.41.2-rc1
msgid "When overlay is mounted with \"volatile\" option, the directory \"$workdir/work/incompat/volatile\" is created. During next mount, overlay checks for this directory and refuses to mount if present. This is a strong indicator that user should throw away upper and work directories and create fresh one. In very limited cases where the user knows that the system has not crashed and contents of upperdir are intact, The \"volatile\" directory can be removed."
msgstr "När overlay monteras med flaggan \"volatile\" skapas katalogen \"$workdir/work/incompat/volatile\". Under nästa montering kontrollerar overlay om denna katalog finns och vägrar att montera om den finns. Detta är en stark indikator på att användaren bör kasta bort de övre och arbetskatalogerna och skapa nya. I mycket begränsade fall där användaren vet att systemet inte har kraschat och innehållet i upperdir är intakt, kan katalogen \"volatile\" tas bort."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Mount options for reiserfs"
msgstr "Monteringsflaggor för reiserfs"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Reiserfs is a journaling filesystem."
msgstr "Reiserfs är ett journalerande filsystem."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*conv*"
msgstr "*conv*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Instructs version 3.6 reiserfs software to mount a version 3.5 filesystem, using the 3.6 format for newly created objects. This filesystem will no longer be compatible with reiserfs 3.5 tools."
msgstr "Instruerar reiserfs-programvaran version 3.6 att montera ett version 3.5-filsystem med 3.6-formatet för nyskapade objekt. Detta filsystem kommer inte längre att vara kompatibelt med reiserfs 3.5-verktyg."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*hash=*{**rupasov**|**tea**|**r5**|*detect*}"
msgstr "*hash=*{**rupasov**|**tea**|**r5**|*detect*}"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Choose which hash function reiserfs will use to find files within directories."
msgstr "Välj vilken hashfunktion reiserfs ska använda för att hitta filer i kataloger."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*rupasov*"
msgstr "*rupasov*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "A hash invented by Yury Yu. Rupasov. It is fast and preserves locality, mapping lexicographically close file names to close hash values. This option should not be used, as it causes a high probability of hash collisions."
msgstr "En hash uppfunnen av Yury Yu. Rupasov. Den är snabb och bevarar lokalitet genom att mappa lexikografiskt närliggande filnamn till närliggande hashvärden. Denna flagga bör inte användas, eftersom det orsakar en hög sannolikhet för hashkollisioner."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*tea*"
msgstr "*tea*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "A Davis-Meyer function implemented by Jeremy Fitzhardinge. It uses hash permuting bits in the name. It gets high randomness and, therefore, low probability of hash collisions at some CPU cost. This may be used if *EHASHCOLLISION* errors are experienced with the r5 hash."
msgstr "En Davis-Meyer-funktion implementerad av Jeremy Fitzhardinge. Den använder hashpermutation av bitar i namnet. Den får hög slumpmässighet och därför låg sannolikhet för hashkollisioner till viss CPU-kostnad. Den här funktionen kan användas om *EHASHCOLLISION*-fel uppstår med r5-hashen."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*r5*"
msgstr "*r5*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "A modified version of the rupasov hash. It is used by default and is the best choice unless the filesystem has huge directories and unusual file-name patterns."
msgstr "En modifierad version av rupasov-hash. Den används som standard och är det bästa valet om inte filsystemet har stora kataloger och ovanliga filnamnsmönster."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*detect*"
msgstr "*detect*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Instructs *mount* to detect which hash function is in use by examining the filesystem being mounted, and to write this information into the reiserfs superblock. This is only useful on the first mount of an old format filesystem."
msgstr "Instruerar *mount* att upptäcka vilken hashfunktion som används genom att undersöka filsystemet som monteras och att skriva denna information till superblocket reiserfs. Detta är endast användbart vid den första monteringen av ett filsystem i gammalt format."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*hashed_relocation*"
msgstr "*hashed_relocation*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Tunes the block allocator. This may provide performance improvements in some situations."
msgstr "Justerar blockallokeringen. Detta kan ge prestandaförbättringar i vissa situationer."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*no_unhashed_relocation*"
msgstr "*no_unhashed_relocation*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*noborder*"
msgstr "*noborder*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Disable the border allocator algorithm invented by Yury Yu. Rupasov. This may provide performance improvements in some situations."
msgstr "Inaktivera algoritmen för gränsfördelning som uppfanns av Yury Yu. Rupasov. Detta kan ge prestandaförbättringar i vissa situationer."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*nolog*"
msgstr "*nolog*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Disable journaling. This will provide slight performance improvements in some situations at the cost of losing reiserfs's fast recovery from crashes. Even with this option turned on, reiserfs still performs all journaling operations, save for actual writes into its journaling area. Implementation of _nolog_ is a work in progress."
msgstr "Inaktivera journalföring. Detta kommer att ge små prestandaförbättringar i vissa situationer på bekostnad av att reiserfs förlorar sin snabba återhämtning från krascher. Även om den här flaggan är aktiverat utför reiserfs fortfarande alla journaleringsoperationer, förutom faktiska skrivningar i journalområdet. Implementeringen av _nolog_ är ett pågående arbete."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*notail*"
msgstr "*notail*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "By default, reiserfs stores small files and 'file tails' directly into its tree. This confuses some utilities such as *lilo*(8). This option is used to disable packing of files into the tree."
msgstr "Som standard lagrar reiserfs små filer och \"filsvansar\" direkt i sitt träd. Detta förvirrar vissa verktyg såsom *lilo*(8). Denna flagga används för att inaktivera packning av filer i trädet."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*replayonly*"
msgstr "*replayonly*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Replay the transactions which are in the journal, but do not actually mount the filesystem. Mainly used by _reiserfsck_."
msgstr "Spela upp de transaktioner som finns i journalen, men som inte faktiskt monterar filsystemet. Används huvudsakligen av _reiserfsck_."

#. from tp:util-linux-man-2.41.2-rc1
msgid "**resize=**__number__"
msgstr "**resize=**__nummer__"

#. from tp:util-linux-man-2.41.2-rc1
msgid "A remount option which permits online expansion of reiserfs partitions. Instructs reiserfs to assume that the device has _number_ blocks. This option is designed for use with devices which are under logical volume management (LVM). There is a special _resizer_ utility which can be obtained from _ftp://ftp.namesys.com/pub/reiserfsprogs_."
msgstr "En remount-flagga som tillåter online-expansion av reiserfs-partitioner. Instruerar reiserfs att anta att enheten har _antal_ block. Denna flagga är utformat för att användas med enheter som är under LVM (Logical Volume Management). Det finns ett speciellt _resizer_-verktyg som kan erhållas från _ftp://ftp.namesys.com/pub/reiserfsprogs_."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*user_xattr*"
msgstr "*user_xattr*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Enable Extended User Attributes. See the *attr*(1) manual page."
msgstr "Aktivera utökade användarattribut. Se manualsidan för *attr*(1)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*acl*"
msgstr "*acl*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Enable POSIX Access Control Lists. See the *acl*(5) manual page."
msgstr "Aktivera POSIX Access Control Lists. Se manualsidan för *acl*(5)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*barrier=none* / *barrier=flush*"
msgstr "*barrier=none* / *barrier=flush*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "This disables / enables the use of write barriers in the journaling code. *barrier=none* disables, *barrier=flush* enables (default). This also requires an IO stack which can support barriers, and if reiserfs gets an error on a barrier write, it will disable barriers again with a warning. Write barriers enforce proper on-disk ordering of journal commits, making volatile disk write caches safe to use, at some performance penalty. If your disks are battery-backed in one way or another, disabling barriers may safely improve performance."
msgstr "Detta inaktiverar/aktiverar användningen av skrivbarriärer i journalkoden. *barrier=none* inaktiverar, *barrier=flush* aktiverar (standard). Detta kräver också en IO-stack som kan stödja barriärer, och om reiserfs får ett fel på en barriärskrivning kommer den att inaktivera barriärer igen med en varning. Skrivbarriärer upprätthåller korrekt ordning på disken för journalförbindelser, vilket gör att flyktiga diskskrivcacher är säkra att använda, med viss prestandaförlust. Om dina diskar är batteridrivna på ett eller annat sätt kan det vara säkert att förbättra prestandan genom att inaktivera barriärerna."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Mount options for ubifs"
msgstr "Monteringsflaggor för ubifs"

#. from tp:util-linux-man-2.41.2-rc1
msgid "UBIFS is a flash filesystem which works on top of UBI volumes. Note that *atime* is not supported and is always turned off."
msgstr "UBIFS är ett flashfilsystem som fungerar ovanpå UBI-volymer. Observera att *atime* inte stöds och alltid är avstängt."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The device name may be specified as"
msgstr "Enhetsnamnet kan anges som"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*ubiX_Y*"
msgstr "*ubiX_Y*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "UBI device number *X*, volume number *Y*"
msgstr "UBI enhetsnummer *X*, volymnummer *Y*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*ubiY*"
msgstr "*ubiY*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "UBI device number *0*, volume number *Y*"
msgstr "UBI-enhetsnummer *0*, volymnummer *Y*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*ubiX:NAME*"
msgstr "*ubiX:NAME*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "UBI device number *X*, volume with name *NAME*"
msgstr "UBI-enhetsnummer *X*, volym med namn *NAME*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*ubi:NAME*"
msgstr "*ubi:NAME*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "UBI device number *0*, volume with name *NAME*"
msgstr "UBI-enhetsnummer *0*, volym med namn *NAME*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Alternative *!* separator may be used instead of *:*."
msgstr "Alternativ *!*-avgränsare kan användas i stället för *:*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The following mount options are available:"
msgstr "Följande monteringsflaggor finns tillgängliga:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*bulk_read*"
msgstr "*bulk_läs*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Enable bulk-read. VFS read-ahead is disabled because it slows down the filesystem. Bulk-Read is an internal optimization. Some flashes may read faster if the data are read at one go, rather than at several read requests. For example, OneNAND can do \"read-while-load\" if it reads more than one NAND page."
msgstr "Aktivera bulk-läsning. VFS read-ahead är inaktiverat eftersom det gör filsystemet långsammare. Bulk-Read är en intern optimering. Vissa flashminnen kan läsa snabbare om data läses på en gång i stället för vid flera läsförfrågningar. OneNAND kan t.ex. göra \"read-while-load\" om den läser mer än en NAND-sida."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*no_bulk_read*"
msgstr "*no_bulk_read*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Do not bulk-read. This is the default."
msgstr "Läs inte i bulk. Detta är standardinställningen."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*chk_data_crc*"
msgstr "*chk_data_crc*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Check data CRC-32 checksums. This is the default."
msgstr "Kontrollera CRC-32-kontrollsummor för data. Detta är standardinställningen."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*no_chk_data_crc*"
msgstr "*no_chk_data_crc*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Do not check data CRC-32 checksums. With this option, the filesystem does not check CRC-32 checksum for data, but it does check it for the internal indexing information. This option only affects reading, not writing. CRC-32 is always calculated when writing the data."
msgstr "Kontrollera inte CRC-32-kontrollsummor för data. Med den här flaggan kontrollerar filsystemet inte CRC-32-kontrollsumman för data, men det gör det för den interna indexeringsinformationen. Denna flagga påverkar endast läsning, inte skrivning. CRC-32 beräknas alltid när data skrivs."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*compr=*{**none**|**lzo**|*zlib*}"
msgstr "*komp=*{**none**|**lzo**|*zlib*}"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Select the default compressor which is used when new files are written. It is still possible to read compressed files if mounted with the *none* option."
msgstr "Välj den standardkompressor som ska användas när nya filer skrivs. Det är fortfarande möjligt att läsa komprimerade filer om de monteras med flaggan *none*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Mount options for udf"
msgstr "Monteringsflaggor för udf"

#. from tp:util-linux-man-2.41.2-rc1
msgid "UDF is the \"Universal Disk Format\" filesystem defined by OSTA, the Optical Storage Technology Association, and is often used for DVD-ROM, frequently in the form of a hybrid UDF/ISO-9660 filesystem. It is, however, perfectly usable by itself on disk drives, flash drives and other block devices. See also _iso9660_."
msgstr "UDF är filsystemet \"Universal Disk Format\" som definieras av OSTA, Optical Storage Technology Association, och används ofta för DVD-ROM, ofta i form av ett hybridfilsystem UDF/ISO-9660. Det är dock fullt användbart i sig självt på hårddiskar, flash-enheter och andra blockenheter. Se även _iso9660_."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*uid=*"
msgstr "*uid=*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Make all files in the filesystem belong to the given user. uid=forget can be specified independently of (or usually in addition to) uid=<user> and results in UDF not storing uids to the media. In fact the recorded uid is the 32-bit overflow uid -1 as defined by the UDF standard. The value is given as either <user> which is a valid user name or the corresponding decimal user id, or the special string \"forget\"."
msgstr "Gör så att alla filer i filsystemet tillhör den angivna användaren. uid=forget kan anges oberoende av (eller vanligtvis som tillägg till) uid=<user> och resulterar i att UDF inte lagrar uid på media. I själva verket är det registrerade uid 32-bitars overflow uid -1 enligt definitionen i UDF-standarden. Värdet anges antingen som <user>, vilket är ett giltigt användarnamn eller motsvarande decimalt användar-ID, eller som specialsträngen \"forget\"."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*gid=*"
msgstr "*gid=*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Make all files in the filesystem belong to the given group. gid=forget can be specified independently of (or usually in addition to) gid=<group> and results in UDF not storing gids to the media. In fact the recorded gid is the 32-bit overflow gid -1 as defined by the UDF standard. The value is given as either <group> which is a valid group name or the corresponding decimal group id, or the special string \"forget\"."
msgstr "Gör så att alla filer i filsystemet tillhör den angivna gruppen. gid=forget kan anges oberoende av (eller vanligtvis som tillägg till) gid=<group> och resulterar i att UDF inte lagrar gid på media. I själva verket är den registrerade gid 32-bitars overflow gid -1 enligt definitionen i UDF-standarden. Värdet anges antingen som <group>, vilket är ett giltigt gruppnamn eller motsvarande decimala grupp-ID, eller som specialsträngen \"forget\"."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*umask=*"
msgstr "*umask=*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Mask out the given permissions from all inodes read from the filesystem. The value is given in octal."
msgstr "Maskera de angivna behörigheterna från alla inoder som läses från filsystemet. Värdet anges i oktal."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*mode=*"
msgstr "*läge=*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "If *mode=* is set the permissions of all non-directory inodes read from the filesystem will be set to the given mode. The value is given in octal."
msgstr "Om *mode=* anges kommer behörigheterna för alla inoder som inte är kataloginoder och som läses från filsystemet att anges i det angivna läget. Värdet anges i oktal."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*dmode=*"
msgstr "*dmode=*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "If *dmode=* is set the permissions of all directory inodes read from the filesystem will be set to the given dmode. The value is given in octal."
msgstr "Om *dmode=* anges kommer behörigheterna för alla kataloginoder som läses från filsystemet att sättas till det angivna dmode. Värdet anges i oktal."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*bs=*"
msgstr "*bs=*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Set the block size. Default value prior to kernel version 2.6.30 was 2048. Since 2.6.30 and prior to 4.11 it was logical device block size with fallback to 2048. Since 4.11 it is logical block size with fallback to any valid block size between logical device block size and 4096."
msgstr "Ställ in blockstorleken. Standardvärdet före kärnversion 2.6.30 var 2048. Sedan 2.6.30 och före 4.11 var det logisk enhetsblockstorlek med fallback till 2048. Sedan 4.11 är det logisk blockstorlek med fallback till valfri giltig blockstorlek mellan logisk enhetsblockstorlek och 4096."

#. from tp:util-linux-man-2.41.2-rc1
msgid "For other details see the *mkudffs*(8) 2.0+ manpage, see the *COMPATIBILITY* and *BLOCK SIZE* sections."
msgstr "Mer information finns på *mkudffs*(8) 2.0+ manpage, se avsnitten *KOMPATIBILITET* och *BLOCKSTORLEK*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Show otherwise hidden files."
msgstr "Visa annars dolda filer."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*undelete*"
msgstr "*undelete*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Show deleted files in lists."
msgstr "Visa raderade filer i listor."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*adinicb*"
msgstr "*adinicb*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Embed data in the inode. (default)"
msgstr "Bädda in data i inoden. (standard)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*noadinicb*"
msgstr "*noadinicb*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Don't embed data in the inode."
msgstr "Bädda inte in data i inoden."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*shortad*"
msgstr "*kortad*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Use short UDF address descriptors."
msgstr "Använd korta UDF-adressdeskriptorer."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*longad*"
msgstr "*longad*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Use long UDF address descriptors. (default)"
msgstr "Använd långa UDF-adressdeskriptorer. (standard)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*nostrict*"
msgstr "*nostrict*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Unset strict conformance."
msgstr "Upphäv strikt överensstämmelse."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*iocharset=*"
msgstr "*iocharset=*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Set the NLS character set. This requires kernel compiled with *CONFIG_UDF_NLS* option."
msgstr "Ställ in NLS-teckenuppsättningen. Detta kräver en kärna kompilerad med flaggan *CONFIG_UDF_NLS*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Set the UTF-8 character set."
msgstr "Ange teckenuppsättningen UTF-8."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Mount options for debugging and disaster recovery"
msgstr "Monteringsflaggor för felsökning och katastrofåterställning"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*novrs*"
msgstr "*novrs*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Ignore the Volume Recognition Sequence and attempt to mount anyway."
msgstr "Ignorera volymigenkänningssekvensen och försök att montera ändå."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*session=*"
msgstr "*session=*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Select the session number for multi-session recorded optical media. (default= last session)"
msgstr "Välj sessionsnummer för optiska medier med inspelning av flera sessioner. (standard= sista sessionen)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*anchor=*"
msgstr "*anchor=*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Override standard anchor location. (default= 256)"
msgstr "Åsidosätter standardplacering för ankare. (standard= 256)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*lastblock=*"
msgstr "*lastblock=*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Set the last block of the filesystem."
msgstr "Ställ in det sista blocket i filsystemet."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Unused historical mount options that may be encountered and should be removed"
msgstr "Oanvända historiska monteringsflaggor som kan förekomma och som bör tas bort"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*uid=ignore*"
msgstr "*uid=ignore*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Ignored, use uid=<user> instead."
msgstr "Ignoreras, använd istället uid=<user>."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*gid=ignore*"
msgstr "*gid=ignore*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Ignored, use gid=<group> instead."
msgstr "Ignoreras, använd gid=<group> istället."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*volume=*"
msgstr "*volume=*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Unimplemented and ignored."
msgstr "Inte implementerad och ignoreras."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*partition=*"
msgstr "*partition=*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*fileset=*"
msgstr "*fileset=*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*rootdir=*"
msgstr "*rootdir=*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Mount options for ufs"
msgstr "Monteringsflaggor för ufs"

#. from tp:util-linux-man-2.41.2-rc1
msgid "**ufstype=**__value__"
msgstr "**ufstype=**__värde__"

#. from tp:util-linux-man-2.41.2-rc1
msgid "UFS is a filesystem widely used in different operating systems. The problem are differences among implementations. Features of some implementations are undocumented, so its hard to recognize the type of ufs automatically. That's why the user must specify the type of ufs by mount option. Possible values are:"
msgstr "UFS är ett filsystem som används i många olika operativsystem. Problemet är skillnader mellan olika implementeringar. Funktioner i vissa implementeringar är odokumenterade, så det är svårt att känna igen typen av ufs automatiskt. Det är därför användaren måste ange typen av ufs med mount option. Möjliga värden är:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*old*"
msgstr "*old*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Old format of ufs, this is the default, read only. (Don't forget to give the *-r* option.)"
msgstr "Gammalt format av ufs, detta är standard, skrivskyddad. (Glöm inte att ange flaggan *-r*)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*44bsd*"
msgstr "*44bsd*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "For filesystems created by a BSD-like system (NetBSD, FreeBSD, OpenBSD)."
msgstr "För filsystem som skapats av ett BSD-liknande system (NetBSD, FreeBSD, OpenBSD)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*ufs2*"
msgstr "*ufs2*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Used in FreeBSD 5.x supported as read-write."
msgstr "Används i FreeBSD 5.x och stöds som read-write."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*5xbsd*"
msgstr "*5xbsd*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Synonym for ufs2."
msgstr "Synonym för ufs2."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*sun*"
msgstr "*sol*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "For filesystems created by SunOS or Solaris on Sparc."
msgstr "För filsystem som skapats av SunOS eller Solaris på Sparc."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*sunx86*"
msgstr "*sunx86*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "For filesystems created by Solaris on x86."
msgstr "För filsystem som skapats av Solaris på x86."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*hp*"
msgstr "*hp*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "For filesystems created by HP-UX, read-only."
msgstr "För filsystem som skapats av HP-UX, skrivskyddad."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*nextstep*"
msgstr "*nextstep*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "For filesystems created by NeXTStep (on NeXT station) (currently read only)."
msgstr "För filsystem som skapats av NeXTStep (på NeXT-station) (för närvarande endast läsbar)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*nextstep-cd*"
msgstr "*nextstep-cd*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "For NextStep CDROMs (block_size == 2048), read-only."
msgstr "För NextStep CDROM (block_size == 2048), skrivskyddad."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*openstep*"
msgstr "*openstep*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "For filesystems created by OpenStep (currently read only). The same filesystem type is also used by macOS."
msgstr "För filsystem som skapats av OpenStep (för närvarande endast läsbar). Samma filsystemtyp används också av macOS."

#. from tp:util-linux-man-2.41.2-rc1
msgid "**onerror=**__value__"
msgstr "**onerror=**__värde__"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Set behavior on error:"
msgstr "Ställ in beteende vid fel:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*panic*"
msgstr "*panic*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "If an error is encountered, cause a kernel panic."
msgstr "Om ett fel påträffas, orsaka en kernel panic."

#. from tp:util-linux-man-2.41.2-rc1
msgid "[**lock**|**umount**|*repair*]"
msgstr "[**lock**|**umount**|*repair*]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "These mount options don't do anything at present; when an error is encountered only a console message is printed."
msgstr "Dessa mount-flaggor gör ingenting i nuläget; när ett fel uppstår skrivs endast ett konsolmeddelande ut."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Mount options for umsdos"
msgstr "Monteringsflaggor för umsdos"

#. from tp:util-linux-man-2.41.2-rc1
msgid "See mount options for msdos. The *dotsOK* option is explicitly killed by _umsdos_."
msgstr "Se monteringsflaggor för msdos. Flaggan *dotsOK* dödas uttryckligen av _umsdos_."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Mount options for vfat"
msgstr "Monteringsflaggor för vfat"

#. from tp:util-linux-man-2.41.2-rc1
msgid "First of all, the mount options for _fat_ are recognized. The *dotsOK* option is explicitly killed by _vfat_. Furthermore, there are"
msgstr "Först och främst känns mount-flaggor för _fat_ igen. Flaggan *dotsOK* dödas uttryckligen av _vfat_. Dessutom finns det"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*uni_xlate*"
msgstr "*uni_xlate*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Translate unhandled Unicode characters to special escaped sequences. This lets you backup and restore filenames that are created with any Unicode characters. Without this option, a '?' is used when no translation is possible. The escape character is ':' because it is otherwise invalid on the vfat filesystem. The escape sequence that gets used, where u is the Unicode character, is: ':', (u & 0x3f), ((u>>6) & 0x3f), (u>>12)."
msgstr "Översätt ohanterade Unicode-tecken till speciella escapade sekvenser. Detta gör att du kan säkerhetskopiera och återställa filnamn som skapas med alla Unicode-tecken. Utan den här flaggan används ett '?' när ingen översättning är möjlig. Escape-tecknet är ':' eftersom det annars är ogiltigt i filsystemet vfat. Den escape-sekvens som används, där u är Unicode-tecknet, är: ':', (u & 0x3f), ((u>>6) & 0x3f), (u>>12)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*posix*"
msgstr "*posix*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Allow two files with names that only differ in case. This option is obsolete."
msgstr "Tillåt två filer med namn som bara skiljer sig åt i versaler. Denna flagga är föråldrat."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*nonumtail*"
msgstr "*nonumtail*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "First try to make a short name without sequence number, before trying _name~num.ext_."
msgstr "Försök först att skapa ett kort namn utan sekvensnummer innan du försöker med _name~num.ext_."

#. from tp:util-linux-man-2.41.2-rc1
msgid "UTF8 is the filesystem safe 8-bit encoding of Unicode that is used by the console. It can be enabled for the filesystem with this option or disabled with utf8=0, utf8=no or utf8=false. If _uni_xlate_ gets set, UTF8 gets disabled."
msgstr "UTF8 är den filsystemssäkra 8-bitars kodningen av Unicode som används av konsolen. Den kan aktiveras för filsystemet med den här flaggan eller inaktiveras med utf8=0, utf8=no eller utf8=false. Om _uni_xlate_ anges inaktiveras UTF8."

#. from tp:util-linux-man-2.41.2-rc1
msgid "**shortname=**__mode__"
msgstr "**shortname=**__läge__"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Defines the behavior for creation and display of filenames which fit into 8.3 characters. If a long name for a file exists, it will always be the preferred one for display. There are four __mode__s:"
msgstr "Definierar beteendet för skapande och visning av filnamn som ryms inom 8,3 tecken. Om det finns ett långt namn för en fil kommer det alltid att föredras för visning. Det finns fyra __läge__s:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*lower*"
msgstr "*lower*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Force the short name to lower case upon display; store a long name when the short name is not all upper case."
msgstr "Tvinga det korta namnet att använda gemener när det visas; lagra ett långt namn om det korta namnet inte enbart består av versaler."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*win95*"
msgstr "*win95*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Force the short name to upper case upon display; store a long name when the short name is not all upper case."
msgstr "Tvinga det korta namnet att använda versaler vid visning; lagra ett långt namn när det korta namnet inte enbart innehåller versaler."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*winnt*"
msgstr "*winnt*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Display the short name as is; store a long name when the short name is not all lower case or all upper case."
msgstr "Visa det korta namnet som det är; lagra ett långt namn om det korta namnet inte bara är gemener eller versaler."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*mixed*"
msgstr "*mixed*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Display the short name as is; store a long name when the short name is not all upper case. This mode is the default since Linux 2.6.32."
msgstr "Visa det korta namnet som det är; lagra ett långt namn om det korta namnet inte enbart består av versaler. Detta läge är standard sedan Linux 2.6.32."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Mount options for usbfs"
msgstr "Monteringsflaggor för usbfs"

#. from tp:util-linux-man-2.41.2-rc1
msgid "**devuid=**__uid__ and **devgid=**__gid__ and **devmode=**__mode__"
msgstr "**devuid=**__uid__ and **devgid=**__gid__ and **devmode=**__läge__"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Set the owner and group and mode of the device files in the usbfs filesystem (default: uid=gid=0, mode=0644). The mode is given in octal."
msgstr "Ange ägare, grupp och läge för enhetsfilerna i filsystemet usbfs (standard: uid=gid=0, mode=0644). Läget anges i oktal."

#. from tp:util-linux-man-2.41.2-rc1
msgid "**busuid=**__uid__ and **busgid=**__gid__ and **busmode=**__mode__"
msgstr "**busuid=**__uid__ and **busgid=**__gid__ and **busmode=**__läge__"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Set the owner and group and mode of the bus directories in the usbfs filesystem (default: uid=gid=0, mode=0555). The mode is given in octal."
msgstr "Ange ägare, grupp och läge för bus-katalogerna i filsystemet usbfs (standard: uid=gid=0, läge=0555). Läget anges i oktal."

#. from tp:util-linux-man-2.41.2-rc1
msgid "**listuid=**__uid__ and **listgid=**__gid__ and **listmode=**__mode__"
msgstr "**listuid=**__uid__ and **listgid=**__gid__ and **listmode=**__läge__"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Set the owner and group and mode of the file _devices_ (default: uid=gid=0, mode=0444). The mode is given in octal."
msgstr "Ange ägare, grupp och läge för filen _devices_ (standard: uid=gid=0, mode=0444). Läget anges i oktal."

#. from tp:util-linux-man-2.41.2-rc1
msgid "DM-VERITY SUPPORT"
msgstr "STÖD FÖR DM-VERITY"

#. from tp:util-linux-man-2.41.2-rc1
msgid "The device-mapper verity target provides read-only transparent integrity checking of block devices using kernel crypto API. The *mount* command can open the dm-verity device and do the integrity verification before the device filesystem is mounted. Requires libcryptsetup with in libmount (optionally via *dlopen*(3)). If libcryptsetup supports extracting the root hash of an already mounted device, existing devices will be automatically reused in case of a match. Mount options for dm-verity:"
msgstr "Device-mapper verity target tillhandahåller skrivskyddad transparent integritetskontroll av blockenheter med hjälp av kernel crypto API. Kommandot *mount* kan öppna dm-verity-enheten och göra integritetsverifieringen innan enhetens filsystem monteras. Kräver libcryptsetup med i libmount (valfritt via *dlopen*(3)). Om libcryptsetup stöder extrahering av rot-hash för en redan monterad enhet, kommer befintliga enheter automatiskt att återanvändas vid en matchning. Monteringsflaggor för dm-verity:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "**verity.hashdevice=**__path__"
msgstr "**verity.hashdevice=**__sökväg__"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Path to the hash tree device associated with the source volume to pass to dm-verity."
msgstr "Sökväg till den enhet i hashträdet som är associerad med källvolymen och som ska skickas till dm-verity."

#. from tp:util-linux-man-2.41.2-rc1
msgid "**verity.roothash=**__hex__"
msgstr "**verity.roothash=**__hex__"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Hex-encoded hash of the root of _verity.hashdevice_. Mutually exclusive with _verity.roothashfile._"
msgstr "Hex-kodad hash av roten till _verity.hashdevice_. Ömsesidigt exklusiv med _verity.roothashfile._"

#. from tp:util-linux-man-2.41.2-rc1
msgid "**verity.roothashfile=**__path__"
msgstr "**verity.roothashfile=**__sökväg__"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Path to file containing the hex-encoded hash of the root of _verity.hashdevice._ Mutually exclusive with _verity.roothash._"
msgstr "Sökväg till fil som innehåller den hex-kodade hashen av roten till _verity.hashdevice._ Mutually exclusive with _verity.roothash._"

#. from tp:util-linux-man-2.41.2-rc1
msgid "**verity.hashoffset=**__offset__"
msgstr "**verity.hashoffset=**__offset__"

#. from tp:util-linux-man-2.41.2-rc1
msgid "If the hash tree device is embedded in the source volume, _offset_ (default: 0) is used by dm-verity to get to the tree."
msgstr "Om enheten för hashträdet är inbäddad i källvolymen används _offset_ (standard: 0) av dm-verity för att komma till trädet."

#. from tp:util-linux-man-2.41.2-rc1
msgid "**verity.fecdevice=**__path__"
msgstr "**verity.fecdevice=**__sökväg__"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Path to the Forward Error Correction (FEC) device associated with the source volume to pass to dm-verity. Optional. Requires kernel built with *CONFIG_DM_VERITY_FEC*."
msgstr "Sökväg till den FEC-enhet (Forward Error Correction) som är associerad med källvolymen och som ska skickas till dm-verity. Valfritt. Kräver en kärna byggd med *CONFIG_DM_VERITY_FEC*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "**verity.fecoffset=**__offset__"
msgstr "**verity.fecoffset=**__offset__"

#. from tp:util-linux-man-2.41.2-rc1
msgid "If the FEC device is embedded in the source volume, _offset_ (default: 0) is used by dm-verity to get to the FEC area. Optional."
msgstr "Om FEC-enheten är inbäddad i källvolymen används _offset_ (standard: 0) av dm-verity för att komma till FEC-området. Valfritt."

#. from tp:util-linux-man-2.41.2-rc1
msgid "**verity.fecroots=**__value__"
msgstr "**verity.fecroots=**__värde__"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Parity bytes for FEC (default: 2). Optional."
msgstr "Paritetsbyte för FEC (standard: 2). Valfritt."

#. from tp:util-linux-man-2.41.2-rc1
msgid "**verity.roothashsig=**__path__"
msgstr "**verity.roothashsig=**__sökväg__"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Path to *pkcs7*(1ssl) signature of root hash hex string. Requires crypt_activate_by_signed_key() from cryptsetup and kernel built with *CONFIG_DM_VERITY_VERIFY_ROOTHASH_SIG*. For device reuse, signatures have to be either used by all mounts of a device or by none. Optional."
msgstr "Sökväg till *pkcs7*(1ssl)-signatur av hexsträng för rothash. Kräver crypt_activate_by_signed_key() från cryptsetup och en kärna byggd med *CONFIG_DM_VERITY_VERIFY_ROOTHASH_SIG*. För återanvändning av enheter måste signaturer antingen användas av alla monteringar på en enhet eller av ingen. Valfritt att använda."

#. from tp:util-linux-man-2.41.2-rc1
msgid "**verity.oncorruption=**__ignore__|__restart__|__panic__"
msgstr "**verity.oncorruption=**__ignore__|__restart__|__panic__"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Instruct the kernel to ignore, reboot or panic when corruption is detected. By default the I/O operation simply fails. Requires Linux 4.1 or newer, and libcrypsetup 2.3.4 or newer. Optional."
msgstr "Instruera kärnan att ignorera, starta om eller få panik när korruption upptäcks. Som standard misslyckas I/O-operationen helt enkelt. Kräver Linux 4.1 eller nyare och libcrypsetup 2.3.4 eller nyare. Valfritt att använda."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Supported since util-linux v2.35."
msgstr "Stöds sedan util-linux v2.35."

#. from tp:util-linux-man-2.41.2-rc1
msgid "For example commands:"
msgstr "Exempel på kommandon:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "mksquashfs /etc /tmp/etc.raw\nveritysetup format /tmp/etc.raw /tmp/etc.verity --root-hash-file=/tmp/etc.roothash\nopenssl smime -sign -in /tmp/etc.roothash -nocerts -inkey private.key \\\n-signer private.crt -noattr -binary -outform der -out /tmp/etc.roothash.p7s\nmount -o verity.hashdevice=/tmp/etc.verity,verity.roothashfile=/tmp/etc.roothash,\\\nverity.roothashsig=/tmp/etc.roothash.p7s /tmp/etc.raw /mnt\n"
msgstr "mksquashfs /etc /tmp/etc.raw\nveritysetup format /tmp/etc.raw /tmp/etc.verity --root-hash-file=/tmp/etc.roothash\nopenssl smime -sign -in /tmp/etc.roothash -nocerts -inkey private.key \\\n-signer private.crt -noattr -binary -outform der -out /tmp/etc.roothash.p7s\nmount -o verity.hashdevice=/tmp/etc.verity,verity.roothashfile=/tmp/etc.roothash,\\\nverity.roothashsig=/tmp/etc.roothash.p7s /tmp/etc.raw /mnt\n"

#. from tp:util-linux-man-2.41.2-rc1
msgid "create squashfs image from _/etc_ directory, verity hash device and mount verified filesystem image to _/mnt_. The kernel will verify that the root hash is signed by a key from the kernel keyring if roothashsig is used."
msgstr "skapa squashfs-avbildning från _/etc_-katalogen, verifiera hashenheten och montera den verifierade filsystemavbildningen på _/mnt_. Om roothashsig används kommer kärnan att verifiera att rot-hash är signerad med en nyckel från kärnans nyckelring."

#. from tp:util-linux-man-2.41.2-rc1
msgid "LOOP-DEVICE SUPPORT"
msgstr "STÖD FÖR LOOP-ENHETER"

#. from tp:util-linux-man-2.41.2-rc1
msgid "One further possible type is a mount via the loop device. For example, the command"
msgstr "Ytterligare en möjlig typ är montering via loop-enheten. Till exempel kommandot"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*mount /tmp/disk.img /mnt -t vfat -o loop=/dev/loop3*"
msgstr "*mount /tmp/disk.img /mnt -t vfat -o loop=/dev/loop3*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "will set up the loop device _/dev/loop3_ to correspond to the file _/tmp/disk.img_, and then mount this device on _/mnt_."
msgstr "kommer att konfigurera loop-enheten _/dev/loop3_ så att den motsvarar filen _/tmp/disk.img_ och sedan montera denna enhet på _/mnt_."

#. from tp:util-linux-man-2.41.2-rc1
msgid "If no explicit loop device is mentioned (but just an option '**-o loop**' is given), then *mount* will try to find some unused loop device and use that, for example"
msgstr "Om ingen explicit loop-enhet nämns (utan bara flaggan \"**-o loop**\" anges), kommer *mount* att försöka hitta någon oanvänd loop-enhet och använda den, till exempel"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*mount /tmp/disk.img /mnt -o loop*"
msgstr "*mount /tmp/disk.img /mnt -o loop*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "The *mount* command *automatically* creates a loop device from a regular file if a filesystem type is not specified or the filesystem is known for libblkid, for example:"
msgstr "Kommandot *mount* skapar *automatiskt* en loop-enhet från en vanlig fil om en filsystemtyp inte anges eller om filsystemet är känt för t.ex. libblkid:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*mount /tmp/disk.img /mnt*"
msgstr "*mount /tmp/disk.img /mnt*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*mount -t ext4 /tmp/disk.img /mnt*"
msgstr "*mount -t ext4 /tmp/disk.img /mnt*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "This type of mount knows about three options, namely *loop*, *offset* and *sizelimit*, that are really options to *losetup*(8). (These options can be used in addition to those specific to the filesystem type.)"
msgstr "Den här typen av mount känner till tre flaggor, nämligen *loop*, *offset* och *sizelimit*, som egentligen är flaggor till *losetup*(8). (Dessa flaggor kan användas utöver de som är specifika för filsystemtypen)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Since Linux 2.6.25 auto-destruction of loop devices is supported, meaning that any loop device allocated by *mount* will be freed by *umount* independently of _/etc/mtab_."
msgstr "Sedan Linux 2.6.25 stöds automatisk destruktion av loop-enheter, vilket innebär att alla loop-enheter som allokerats av *mount* kommer att frigöras av *umount* oberoende av _/etc/mtab_."

#. from tp:util-linux-man-2.41.2-rc1
msgid "You can also free a loop device by hand, using *losetup -d* or *umount -d*."
msgstr "Du kan också frigöra en loop-enhet för hand med hjälp av *losetup -d* eller *umount -d*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Since util-linux v2.29, *mount* re-uses the loop device rather than initializing a new device if the same backing file is already used for some loop device with the same offset and sizelimit. This is necessary to avoid a filesystem corruption."
msgstr "Sedan util-linux v2.29 återanvänder *mount* loop-enheten i stället för att initiera en ny enhet om samma backingfil redan används för en loop-enhet med samma offset och sizelimit. Detta är nödvändigt för att undvika korruption i filsystemet."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*mount* has the following exit status values (the bits can be ORed):"
msgstr "*mount* har följande värden för utgångsstatus (bitarna kan vara ORed):"

#. from tp:util-linux-man-2.41.2-rc1
msgid "incorrect invocation or permissions"
msgstr "felaktigt anrop eller felaktiga behörigheter"

#. from tp:util-linux-man-2.41.2-rc1
msgid "system error (out of memory, cannot fork, no more loop devices)"
msgstr "systemfel (slut på minne, kan inte förgrena sig, inga fler loop-enheter)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "internal *mount* bug"
msgstr "intern *mount*-bugg"

#. from tp:util-linux-man-2.41.2-rc1
msgid "user interrupt"
msgstr "användaravbrott"

#. from tp:util-linux-man-2.41.2-rc1
msgid "problems writing or locking _/etc/mtab_"
msgstr "problem med att skriva eller låsa _/etc/mtab_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "mount failure"
msgstr "monteringsfel"

#. from tp:util-linux-man-2.41.2-rc1
msgid "some mount succeeded"
msgstr "vissa monter lyckades"

#. from tp:util-linux-man-2.41.2-rc1
msgid "The command *mount -a* returns 0 (all succeeded), 32 (all failed), or 64 (some failed, some succeeded)."
msgstr "Kommandot *mount -a* returnerar 0 (alla lyckades), 32 (alla misslyckades) eller 64 (några misslyckades, några lyckades)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*126*"
msgstr "*126*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "failed to execute external /sbin/mount.<type> mount helper (since util-linux v2.41)"
msgstr "misslyckades med att köra extern /sbin/mount.<type> mount helper (sedan util-linux v2.41)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "EXTERNAL HELPERS"
msgstr "EXTERNA HJÄLPARE"

#. from tp:util-linux-man-2.41.2-rc1
msgid "The syntax of external mount helpers is:"
msgstr "Syntaxen för externa monteringshjälpmedel är:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "**/sbin/mount.**__suffix__ _spec dir_ [*-sfnv*] [*-N* _namespace_] [*-o* _options_] [*-t* __type__**.**_subtype_]"
msgstr "**/sbin/mount.**__suffix__ _spec dir_ [*-sfnv*] [*-N* _namnrymd_] [*-o* _options_] [*-t* __typ__**.**_subtype_]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "where the _suffix_ is the filesystem type and the *-sfnvoN* options have the same meaning as the normal mount options. The *-t* option is used for filesystems with subtypes support (for example */sbin/mount.fuse -t fuse.sshfs*)."
msgstr "där _suffix_ är filsystemtypen och flaggorna *-sfnvoN* har samma betydelse som de normala mount-flaggor. Flaggan *-t* används för filsystem med stöd för undertyper (t.ex. */sbin/mount.fuse -t fuse.sshfs*)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The command *mount* does not pass the mount options *unbindable*, *runbindable*, *private*, *rprivate*, *slave*, *rslave*, *shared*, *rshared*, *auto*, *noauto*, *comment*, *x-**, *loop*, *offset* and *sizelimit* to the mount.<suffix> helpers. All other options are used in a comma-separated list as an argument to the *-o* option."
msgstr "Kommandot *mount* skickar inte monteringsflaggorna *unbindable*, *runbindable*, *private*, *rprivate*, *slave*, *rslave*, *shared*, *rshared*, *auto*, *noauto*, *comment*, *x-**, *loop*, *offset* och *sizelimit* till mount.<suffix> helpers. Alla andra alternativ används i en kommaseparerad lista som ett argument till flaggan *-o*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The exit status value of the helper is returned as the exit status of *mount*(8). The value 126 is sed if the mount helper program is found, but the execl() failed."
msgstr "Värdet för utgångsstatus för hjälpprogrammet returneras som utgångsstatus för *mount*(8). Värdet 126 är sed om mount-hjälpprogrammet hittades, men execl() misslyckades."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*LIBMOUNT_FORCE_MOUNT2*={always|never|auto}"
msgstr "*LIBMOUNT_FORCE_MOUNT2*={always|never|auto}"

#. from tp:util-linux-man-2.41.2-rc1
msgid "force to use classic *mount*(2) system call (requires support for new file descriptors based mount API). The default is *auto*; in this case, libmount tries to be smart and use classic *mount*(2) only for well-known issues. If the new mount API is unavailable, libmount can still use traditional *mount*(2), although LIBMOUNT_FORCE_MOUNT2 is set to *never*."
msgstr "tvinga till användning av det klassiska systemanropet *mount*(2) (kräver stöd för det nya API:et för montering baserat på filbeskrivare). Standardvärdet är *auto*; i det här fallet försöker libmount vara smart och använda klassisk *mount*(2) endast för välkända problem. Om det nya API:et för montering inte är tillgängligt kan libmount fortfarande använda traditionell *mount*(2), även om LIBMOUNT_FORCE_MOUNT2 är satt till *never*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "overrides the default location of the _fstab_ file (ignored for suid)"
msgstr "åsidosätter standardplatsen för filen _fstab_ (ignoreras för suid)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "enables libblkid debug output"
msgstr "aktiverar libblkid felsökningsutmatning"

#. from tp:util-linux-man-2.41.2-rc1
msgid "enables loop device setup debug output"
msgstr "aktiverar felsökingsutmatning för loop-enhetens inställning"

#. from tp:util-linux-man-2.41.2-rc1
msgid "See also \"*The files /etc/fstab, /etc/mtab and /proc/mounts*\" section above."
msgstr "Se även avsnittet \"*Filerna /etc/fstab, /etc/mtab och /proc/mounts*\" ovan."

#. from tp:util-linux-man-2.41.2-rc1
msgid "filesystem table"
msgstr "filsystemtabell"

#. from tp:util-linux-man-2.41.2-rc1
msgid "_/run/mount_"
msgstr "_/run/mount_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "libmount private runtime directory"
msgstr "libmount privat körtidskatalog"

#. from tp:util-linux-man-2.41.2-rc1
msgid "_/etc/mtab_"
msgstr "_/etc/mtab_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "table of mounted filesystems or symlink to _/proc/mounts_"
msgstr "tabell över monterade filsystem eller symlänk till _/proc/mounts_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "_/etc/mtab~_"
msgstr "_/etc/mtab~_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "lock file (unused on systems with _mtab_ symlink)"
msgstr "låsa fil (oanvänd på system med _mtab_ symlänk)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "_/etc/mtab.tmp_"
msgstr "_/etc/mtab.tmp_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "temporary file (unused on systems with _mtab_ symlink)"
msgstr "temporär fil (oanvänd på system med _mtab_ symlänk)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "_/etc/filesystems_"
msgstr "_/etc/filesystems_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "a list of filesystem types to try"
msgstr "en lista över filsystemtyper som ska provas"

#. from tp:util-linux-man-2.41.2-rc1
msgid "A *mount* command existed in Version 5 AT&T UNIX."
msgstr "Ett *mount*-kommando fanns i version 5 av AT&T UNIX."

#. from tp:util-linux-man-2.41.2-rc1
msgid "It is possible for a corrupted filesystem to cause a crash."
msgstr "Det är möjligt att ett skadat filsystem kan orsaka en krasch."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Some Linux filesystems don't support *-o sync* and *-o dirsync* (the ext2, ext3, ext4, fat and vfat filesystems _do_ support synchronous updates (a la BSD) when mounted with the *sync* option)."
msgstr "Vissa Linux-filsystem stöder inte *-o sync* och *-o dirsync* (filsystemen ext2, ext3, ext4, fat och vfat _stödjer_ synkrona uppdateringar (a la BSD) när de monteras med flaggan *sync*)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The *-o remount* may not be able to change mount parameters (all _ext2fs_-specific parameters, except *sb*, are changeable with a remount, for example, but you can't change *gid* or *umask* for the _fatfs_)."
msgstr "Det är inte säkert att *-o remount* kan ändra monteringsparametrar (alla _ext2fs_-specifika parametrar, utom *sb*, kan t.ex. ändras med en remount, men du kan inte ändra *gid* eller *umask* för _fatfs_)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "It is possible that the files _/etc/mtab_ and _/proc/mounts_ don't match on systems with a regular _mtab_ file. The first file is based only on the *mount* command options, but the content of the second file also depends on the kernel and others settings (e.g. on a remote NFS server -- in certain cases the *mount* command may report unreliable information about an NFS mount point and the _/proc/mount_ file usually contains more reliable information.) This is another reason to replace the _mtab_ file with a symlink to the _/proc/mounts_ file."
msgstr "Det är möjligt att filerna _/etc/mtab_ och _/proc/mounts_ inte matchar varandra på system med en vanlig _mtab_-fil. Den första filen baseras endast på flaggan i kommandot *mount*, men innehållet i den andra filen beror också på kärnan och andra inställningar (t.ex. på en fjärr-NFS-server -- i vissa fall kan kommandot *mount* rapportera opålitlig information om en NFS-monteringspunkt och filen _/proc/mount_ innehåller vanligtvis mer tillförlitlig information) Detta är ytterligare ett skäl till att ersätta filen _mtab_ med en symlänk till filen _/proc/mounts_."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Checking files on NFS filesystems referenced by file descriptors (i.e. the *fcntl* and *ioctl* families of functions) may lead to inconsistent results due to the lack of a consistency check in the kernel even if the *noac* mount option is used."
msgstr "Kontroll av filer på NFS-filsystem som refereras till av filbeskrivare (dvs. funktionerna *fcntl* och *ioctl*) kan leda till inkonsekventa resultat på grund av att det inte finns någon konsistenskontroll i kärnan, även om monteringsflaggan *noac* används."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The *loop* option with the *offset* or *sizelimit* options used may fail when using older kernels if the *mount* command can't confirm that the size of the block device has been configured as requested. This situation can be worked around by using the *losetup*(8) command manually before calling *mount* with the configured loop device."
msgstr "Flaggan *loop* med flaggorna *offset* eller *sizelimit* kan misslyckas vid användning av äldre kärnor om kommandot *mount* inte kan bekräfta att storleken på blockenheten har konfigurerats enligt begäran. Den här situationen kan undvikas genom att använda kommandot *losetup*(8) manuellt innan *mount* anropas med den konfigurerade loop-enheten."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*mount*(2), *umount*(2), *filesystems*(5), *fstab*(5), *nfs*(5), *xfs*(5), *mount_namespaces*(7), *xattr*(7), *e2label*(8), *findmnt*(8), *losetup*(8), *lsblk*(8), *mke2fs*(8), *mountd*(8), *nfsd*(8), *swapon*(8), *tune2fs*(8), *umount*(8), *xfs_admin*(8)"
msgstr "*mount*(2), *umount*(2), *filesystems*(5), *fstab*(5), *nfs*(5), *xfs*(5), *mount_namespaces*(7), *xattr*(7), *e2label*(8), *findmnt*(8), *losetup*(8), *lsblk*(8), *mke2fs*(8), *mountd*(8), *nfsd*(8), *swapon*(8), *tune2fs*(8), *umount*(8), *xfs_admin*(8)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "mountpoint(1)"
msgstr "mountpoint(1)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "mountpoint - see if a directory or file is a mountpoint"
msgstr "mountpoint - se om en katalog eller fil är en mountpoint"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*mountpoint* [*-d*|*-q*] _directory_|_file_"
msgstr "*mountpoint* [*-d*|*-q*] _katalog_|_fil_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*mountpoint* *-x* _device_"
msgstr "*mountpoint* *-x* _enhet_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*mountpoint* checks whether the given _directory_ or _file_ is mentioned in the _/proc/self/mountinfo_ file."
msgstr "*mountpoint* kontrollerar om den angivna _katalogen_ eller _filen_ nämns i filen _/proc/self/mountinfo_."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-d*, *--fs-devno*"
msgstr "*-d*, *--fs-devno*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Show the major/minor numbers of the device that is mounted on the given directory."
msgstr "Visa major/minor-numren för den enhet som är monterad på den angivna katalogen."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Be quiet - don't print anything."
msgstr "Var tyst - skriv inte ut något."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--nofollow*"
msgstr "*--nofollow*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Do not follow symbolic link if it the last element of the _directory_ path."
msgstr "Följ inte en symbolisk länk om den är det sista elementet i sökvägen _katalog_."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-x*, *--devno*"
msgstr "*-x*, *--devno*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Show the major/minor numbers of the given blockdevice on standard output."
msgstr "Visa major/minor-numren för den angivna blockdevice på standardutdata."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*mountpoint* has the following exit status values:"
msgstr "*mountpoint* har följande värden för utgångsstatus:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "success; the directory is a mountpoint, or device is block device on *--devno*"
msgstr "lyckades; katalogen är en monteringspunkt, eller enheten är en blockenhet på *--devno*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "failure; incorrect invocation, permissions or system error"
msgstr "fel; felaktigt anrop, felaktiga behörigheter eller systemfel"

#. from tp:util-linux-man-2.41.2-rc1
msgid "failure; the directory is not a mountpoint, or device is not a block device on *--devno*"
msgstr "fel; katalogen är inte en monteringspunkt, eller enheten är inte en blockenhet på *--devno*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "The util-linux *mountpoint* implementation was written from scratch for libmount. The original version for sysvinit suite was written by Miquel van Smoorenburg."
msgstr "Implementationen av *mountpoint* för util-linux skrevs från grunden för libmount. Den ursprungliga versionen för sysvinit-sviten skrevs av Miquel van Smoorenburg."

#. from tp:util-linux-man-2.41.2-rc1
msgid "nsenter(1)"
msgstr "nsenter(1)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "nsenter - run program in different namespaces"
msgstr "nsenter - kör programmet i olika namnrymder"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*nsenter* [options] [_program_ [_arguments_]]"
msgstr "*nsenter* [flaggor] [_program_ [_argument_]]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "The *nsenter* command executes _program_ in the namespace(s) that are specified in the command-line options (described below). If _program_ is not given, then \"$\\{SHELL}\" is run (default: _/bin/sh_)."
msgstr "Kommandot *nsenter* exekverar _program_ i det eller de namnområden som anges i kommandoradsflaggor (beskrivs nedan). Om _program_ inte anges körs \"$\\{SHELL}\" (standard: _/bin/sh_)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Enterable namespaces are:"
msgstr "Enterable namnområden är:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*mount namespace*"
msgstr "*montera namnrymd*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Mounting and unmounting filesystems will not affect the rest of the system, except for filesystems which are explicitly marked as shared (with *mount --make-shared*; see _/proc/self/mountinfo_ for the *shared* flag). For further details, see *mount_namespaces*(7) and the discussion of the *CLONE_NEWNS* flag in *clone*(2)."
msgstr "Montering och avmontering av filsystem påverkar inte resten av systemet, utom för filsystem som uttryckligen markeras som delade (med *mount --make-shared*; se _/proc/self/mountinfo_ för flaggan *shared*). För mer information, se *mount_namespaces*(7) och diskussionen om flaggan *CLONE_NEWNS* i *clone*(2)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*UTS namespace*"
msgstr "*UTS namnrymd*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Setting hostname or domainname will not affect the rest of the system. For further details, see *uts_namespaces*(7)."
msgstr "Inställning av värdnamn eller domännamn påverkar inte resten av systemet. För ytterligare information, se *uts_namespaces*(7)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*IPC namespace*"
msgstr "*IPC-namnområde*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "The process will have an independent namespace for POSIX message queues as well as System V message queues, semaphore sets and shared memory segments. For further details, see *ipc_namespaces*(7)."
msgstr "Processen kommer att ha en oberoende namnrymd för POSIX-meddelandeköer samt System V-meddelandeköer, semaforuppsättningar och delade minnessegment. För ytterligare information, se *ipc_namespaces*(7)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*network namespace*"
msgstr "*nätverkets namnrymd*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "The process will have independent IPv4 and IPv6 stacks, IP routing tables, firewall rules, the _/proc/net_ and _/sys/class/net_ directory trees, sockets, etc. For further details, see *network_namespaces*(7)."
msgstr "Processen kommer att ha oberoende IPv4- och IPv6-stackar, IP-routingtabeller, brandväggsregler, katalogträden _/proc/net_ och _/sys/class/net_, uttag, etc. För ytterligare information, se *network_namespaces*(7)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*PID namespace*"
msgstr "*PID namnområde*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Children will have a set of PID to process mappings separate from the *nsenter* process. *nsenter* will fork by default if changing the PID namespace, so that the new program and its children share the same PID namespace and are visible to each other. If *--no-fork* is used, the new program will be exec'ed without forking. For further details, see *pid_namespaces*(7)."
msgstr "Barn kommer att ha en uppsättning PID-till-processmappningar som är separata från *nsenter*-processen. *nsenter* kommer som standard att förgrena sig om PID-namnområdet ändras, så att det nya programmet och dess barn delar samma PID-namnområde och är synliga för varandra. Om *--no-fork* används kommer det nya programmet att exekveras utan förgrening. För ytterligare information, se *pid_namespaces*(7)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*user namespace*"
msgstr "*användarens namnområde*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "The process will have a distinct set of UIDs, GIDs and capabilities. For further details, see *user_namespaces*(7)."
msgstr "Processen kommer att ha en distinkt uppsättning UID:er, GID:er och kapaciteter. För ytterligare information, se *user_namespaces*(7)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*cgroup namespace*"
msgstr "*cgroup namnområde*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "The process will have a virtualized view of _/proc/self/cgroup_, and new cgroup mounts will be rooted at the namespace cgroup root. For further details, see *cgroup_namespaces*(7)."
msgstr "Processen kommer att ha en virtualiserad vy av _/proc/self/cgroup_, och nya cgroup-monteringar kommer att ha sin rot i namnrymden cgroup root. För ytterligare information, se *cgroup_namespaces*(7)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*time namespace*"
msgstr "*tid namnrymd*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "The process can have a distinct view of *CLOCK_MONOTONIC* and/or *CLOCK_BOOTTIME* which can be changed using _/proc/self/timens_offsets_. For further details, see *time_namespaces*(7)."
msgstr "Processen kan ha en egen syn på *CLOCK_MONOTONIC* och/eller *CLOCK_BOOTTIME* som kan ändras med _/proc/self/timens_offsets_. För ytterligare information, se *time_namespaces*(7)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Various of the options below that relate to namespaces take an optional _file_ argument. This should be one of the _/proc/[pid]/ns/{asterisk}_ files described in *namespaces*(7), or the pathname of a bind mount that was created on one of those files."
msgstr "Flera av flaggorna nedan som relaterar till namnrymder har ett valfritt _fil_-argument. Detta bör vara en av filerna _/proc/[pid]/ns/{asterisk}_ som beskrivs i *namespaces*(7), eller sökvägen till ett bind-mount som skapades på en av dessa filer."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Enter all namespaces of the target process by the default _/proc/[pid]/ns/{asterisk}_ namespace paths. The default paths to the target process namespaces may be overwritten by namespace specific options (e.g., *--all --mount*=[_path_])."
msgstr "Ange alla namnrymder för målprocessen med standardsökvägarna till namnrymden _/proc/[pid]/ns/{asterisk}_. Standardsökvägarna till målprocessens namnrymder kan skrivas över med namnrymdsspecifika flaggor (t.ex. *--all --mount*=[_sökväg_])."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The user namespace will be ignored if the same as the caller's current user namespace. It prevents a caller that has dropped capabilities from regaining those capabilities via a call to setns(). See *setns*(2) for more details."
msgstr "Användarnamnområdet ignoreras om det är detsamma som anroparens aktuella användarnamnområde. Det förhindrar en anropare som har tappat kapacitet från att återfå denna kapacitet via ett anrop till setns(). Se *setns*(2) för mer information."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-t*, *--target* _PID_"
msgstr "*-t*, *--target* _PID_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Specify a target process to get contexts from. The paths to the contexts specified by _pid_ are:"
msgstr "Ange en målprocess att hämta kontexter från. Sökvägarna till de kontexter som anges av _pid_ är:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "_/proc/pid/ns/mnt_"
msgstr "_/proc/pid/ns/mnt_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "the mount namespace"
msgstr "namnrymden för montering"

#. from tp:util-linux-man-2.41.2-rc1
msgid "_/proc/pid/ns/uts_"
msgstr "_/proc/pid/ns/uts_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "the UTS namespace"
msgstr "uTS namnrymd"

#. from tp:util-linux-man-2.41.2-rc1
msgid "_/proc/pid/ns/ipc_"
msgstr "_/proc/pid/ns/ipc_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "the IPC namespace"
msgstr "iPC-namnrymden"

#. from tp:util-linux-man-2.41.2-rc1
msgid "_/proc/pid/ns/net_"
msgstr "_/proc/pid/ns/net_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "the network namespace"
msgstr "namnrymden för nätverket"

#. from tp:util-linux-man-2.41.2-rc1
msgid "_/proc/pid/ns/pid_"
msgstr "_/proc/pid/ns/pid_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "the PID namespace"
msgstr "namnrymden för PID"

#. from tp:util-linux-man-2.41.2-rc1
msgid "_/proc/pid/ns/user_"
msgstr "_/proc/pid/ns/user_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "the user namespace"
msgstr "användarens namnrymd"

#. from tp:util-linux-man-2.41.2-rc1
msgid "_/proc/pid/ns/cgroup_"
msgstr "_/proc/pid/ns/cgroup_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "the cgroup namespace"
msgstr "namnrymden cgroup"

#. from tp:util-linux-man-2.41.2-rc1
msgid "_/proc/pid/ns/time_"
msgstr "_/proc/pid/ns/time_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "the time namespace"
msgstr "namnrymden för tid"

#. from tp:util-linux-man-2.41.2-rc1
msgid "_/proc/pid/root_"
msgstr "_/proc/pid/root_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "the root directory"
msgstr "rotkatalogen"

#. from tp:util-linux-man-2.41.2-rc1
msgid "_/proc/pid/cwd_"
msgstr "_/proc/pid/cwd_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "the working directory respectively"
msgstr "arbetskatalogen respektive"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-m*, *--mount*[**=**_file_]"
msgstr "*-m*, *--mount*[**=**_fil_]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Enter the mount namespace. If no file is specified, enter the mount namespace of the target process. If _file_ is specified, enter the mount namespace specified by _file_."
msgstr "Ange namnrymden för monteringen. Om ingen fil anges, ange målprocessens namnområde för montering. Om _fil_ anges, anges det namnområde för montering som anges av _fil_."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-u*, *--uts*[**=**_file_]"
msgstr "*-u*, *--uts*[**=**_fil_]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Enter the UTS namespace. If no file is specified, enter the UTS namespace of the target process. If _file_ is specified, enter the UTS namespace specified by _file_."
msgstr "Ange UTS-namnområdet. Om ingen fil anges, ange UTS-namnområdet för målprocessen. Om _fil_ anges, anges det UTS-namnområde som anges av _fil_."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-i*, *--ipc*[**=**_file_]"
msgstr "*-i*, *--ipc*[**=**_fil_]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Enter the IPC namespace. If no file is specified, enter the IPC namespace of the target process. If _file_ is specified, enter the IPC namespace specified by _file_."
msgstr "Ange IPC-namnområdet. Om ingen fil anges, ange IPC-namnområdet för målprocessen. Om _fil_ anges, anges det IPC-namnområde som anges av _fil_."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-n*, *--net*[**=**_file_]"
msgstr "*-n*, *--net*[**=**_fil_]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Enter the network namespace. If no file is specified, enter the network namespace of the target process. If _file_ is specified, enter the network namespace specified by _file_."
msgstr "Ange nätverkets namnområde. Om ingen fil anges, anges målprocessens nätverksnamnområde. Om _fil_ anges, anges det nätverksnamnområde som anges av _fil_."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-N*, *--net-socket* _fd_"
msgstr "*-N*, *--net-socket* _fd_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Enter the network namespace of the target process's socket. It requires *--target* process specified. Supported since Linux 5.6."
msgstr "Ange nätverksnamnrymden för målprocessens uttag. Det kräver att *--target*-processen specificeras. Stöds sedan Linux 5.6."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-p*, *--pid*[**=**_file_]"
msgstr "*-p*, *--pid*[**=**_fil_]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Enter the PID namespace. If no file is specified, enter the PID namespace of the target process. If _file_ is specified, enter the PID namespace specified by _file_."
msgstr "Ange PID-namnområdet. Om ingen fil anges, ange PID-namnområdet för målprocessen. Om _fil_ anges, anges det PID-namnområde som anges av _fil_."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-U*, *--user*[**=**_file_]"
msgstr "*-U*, *--user*[**=**_fil_]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Enter the user namespace. If no file is specified, enter the user namespace of the target process. If _file_ is specified, enter the user namespace specified by _file_. See also the *--setuid* and *--setgid* options."
msgstr "Ange användarens namnområde. Om ingen fil anges, ange användarnamnområdet för målprocessen. Om _fil_ anges, anges det användarnamnområde som anges av _fil_. Se även flaggorna *--setuid* och *--setgid*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--user-parent*"
msgstr "*--user-parent*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Enter the parent user namespace. Parent user namespace will be acquired from any other enabled namespace.  If combined with *--user* option the parent user namespace will be fetched from the user namespace and replace it."
msgstr "Ange det överordnade användarnamnområdet. Det överordnade användarnamnområdet kommer att hämtas från alla andra aktiverade namnområden.  Om det kombineras med flaggan *--user* kommer det överordnade användarnamnområdet att hämtas från användarnamnområdet och ersätta det."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-C*, *--cgroup*[**=**_file_]"
msgstr "*-C*, *--cgroup*[**=**_fil_]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Enter the cgroup namespace. If no file is specified, enter the cgroup namespace of the target process. If _file_ is specified, enter the cgroup namespace specified by _file_."
msgstr "Ange namnrymden för cgroup. Om ingen fil anges, ange cgroup-namnområdet för målprocessen. Om _fil_ anges, anges det cgroup-namnområde som anges av _fil_."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-T*, *--time*[**=**_file_]"
msgstr "*-T*, *--time*[**=**_fil_]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Enter the time namespace. If no file is specified, enter the time namespace of the target process. If _file_ is specified, enter the time namespace specified by _file_."
msgstr "Ange tidsnamnrymden. Om ingen fil anges, ange tidnamnrymden för målprocessen. Om _fil_ anges, anges det tidsnamnområde som anges av _fil_."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-G*, *--setgid* _gid_"
msgstr "*-G*, *--setgid* _gid_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Set the group ID which will be used in the entered namespace and drop supplementary groups.  *nsenter* always sets GID for user namespaces, the default is 0.  If the argument \"follow\" is specified the GID of the target process is used."
msgstr "Ange det grupp-ID som ska användas i det angivna namnområdet och släpp tilläggsgrupper.  *nsenter* anger alltid GID för användarnamnområden, standardvärdet är 0. Om argumentet \"follow\" anges används GID för målprocessen."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-S*, *--setuid* _uid_"
msgstr "*-S*, *--setuid* _uid_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Set the user ID which will be used in the entered namespace.  *nsenter* always sets UID for user namespaces, the default is 0.  If the argument \"follow\" is specified the UID of the target process is used."
msgstr "Ange det användar-ID som ska användas i den angivna namnrymden.  *nsenter* anger alltid UID för användarnamnområden, standardvärdet är 0. Om argumentet \"follow\" anges används UID för målprocessen."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--keep-caps*"
msgstr "*--keep-caps*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "When the *--user* option is given, ensure that capabilities granted in the user namespace are preserved in the child process."
msgstr "När flaggan *--user* anges ska du se till att de möjligheter som ges i användarnamnområdet bevaras i barnprocessen."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--preserve-credentials*"
msgstr "*--preserve-credentials*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Don't modify UID and GID when enter user namespace. The default is to drops supplementary groups and sets GID and UID to 0."
msgstr "Ändra inte UID och GID när du anger användarnamnområde. Standardinställningen är att släppa tilläggsgrupper och sätta GID och UID till 0."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-r*, *--root*[**=**_directory_]"
msgstr "*-r*, *--root*[**=**_katalog_]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Set the root directory. If no directory is specified, set the root directory to the root directory of the target process. If directory is specified, set the root directory to the specified directory. The specified _directory_ is open before it switches to the requested namespaces."
msgstr "Ange rotkatalogen. Om ingen katalog anges, anges rotkatalogen till målprocessens rotkatalog. Om directory anges, anges rotkatalogen till den angivna katalogen. Den angivna _katalogen_ är öppen innan den växlar till de begärda namnrymderna."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-w*, *--wd*[**=**_directory_]"
msgstr "*-w*, *--wd*[**=**_katalog_]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Set the working directory. If no directory is specified, set the working directory to the working directory of the target process. If directory is specified, set the working directory to the specified directory. The specified _directory_ is open before it switches to the requested namespaces, it means the specified directory works as \"tunnel\" to the current namespace. See also *--wdns*."
msgstr "Ställ in arbetskatalogen. Om ingen katalog har angetts, anges arbetskatalogen till målprocessens arbetskatalog. Om directory har angetts, anges arbetskatalogen till den angivna katalogen. Den angivna _katalogen_ är öppen innan den växlar till de begärda namnrymderna, vilket innebär att den angivna katalogen fungerar som en \"tunnel\" till den aktuella namnrymden. Se även *--wdns*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-W*, *--wdns*[**=**_directory_]"
msgstr "*-W*, *--wdns*[**=**_katalog_]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Set the working directory. The _directory_ is open after switch to the requested namespaces and after *chroot*(2) call. The options *--wd* and *--wdns* are mutually exclusive."
msgstr "Ställ in arbetskatalogen. Katalogen _katalog_ är öppen efter byte till de begärda namnrymderna och efter anrop av *chroot*(2). Flaggorna *--wd* och *--wdns* är ömsesidigt uteslutande."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-e*, *--env*"
msgstr "*-e*, *--env*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Pass environment variables from the target process to the new process being created. If this option is not provided, the environment variables will remain the same as in the current namespace.."
msgstr "Överför miljövariabler från målprocessen till den nya process som skapas. Om denna flagga inte anges kommer miljövariablerna att vara desamma som i den aktuella namnrymden..."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Do not fork before exec'ing the specified program. By default, when entering a PID namespace, *nsenter* calls *fork* before calling *exec* so that any children will also be in the newly entered PID namespace."
msgstr "Gör ingen fork innan det angivna programmet körs. När *nsenter* går in i ett PID-namnområde anropar *nsenter* som standard *fork* innan *exec* anropas, så att eventuella barn också befinner sig i det nyinmatade PID-namnområdet."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-Z*, *--follow-context*"
msgstr "*-Z*, *--follow-context*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Set the SELinux security context used for executing a new process according to already running process specified by *--target* PID. (The util-linux has to be compiled with SELinux support otherwise the option is unavailable.)"
msgstr "Ställ in det SELinux-säkerhetskontext som används för att köra en ny process enligt en redan pågående process som anges av *--target* PID. (Util-linux måste vara kompilerat med SELinux-stöd, annars är flaggan inte tillgängligt)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-c*, *--join-cgroup*"
msgstr "*-c*, *--join-cgroup*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Add the initiated process to the cgroup of the target process."
msgstr "Lägg till den initierade processen i målprocessens c-grupp."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The *--user-parent* option requires Linux 4.9 or higher, older kernels will raise inappropriate ioctl for device error."
msgstr "Flaggan *--user-parent* kräver Linux 4.9 eller senare, äldre kärnor ger upphov till olämpliga ioctl för enhetsfel."

#. from tp:util-linux-man-2.41.2-rc1
msgid "mailto:biederm@xmission.com[Eric Biederman], mailto:kzak@redhat.com[Karel Zak]"
msgstr "mailto:biederm@xmission.com[Eric Biederman], mailto:kzak@redhat.com[Karel Zak]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*clone*(2), *setns*(2), *namespaces*(7)"
msgstr "*clone*(2), *setns*(2), *namnrymder*(7)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "pivot_root(8)"
msgstr "pivot_root(8)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "pivot_root - change the root filesystem"
msgstr "pivot_root - ändra rotfilsystemet"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*pivot_root* _new_root_ _put_old_"
msgstr "*pivot_root* _new_root_ _put_old_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*pivot_root* moves the root file system of the current process to the directory _put_old_ and makes _new_root_ the new root file system. Since *pivot_root*(8) simply calls *pivot_root*(2), we refer to the man page of the latter for further details."
msgstr "*pivot_root* flyttar rotfilsystemet för den aktuella processen till katalogen _put_old_ och gör _new_root_ till det nya rotfilsystemet. Eftersom *pivot_root*(8) helt enkelt anropar *pivot_root*(2) hänvisar vi till man-sidan för den senare för ytterligare information."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Note that, depending on the implementation of *pivot_root*, root and current working directory of the caller may or may not change. The following is a sequence for invoking *pivot_root* that works in either case, assuming that *pivot_root* and *chroot* are in the current *PATH*:"
msgstr "Observera att beroende på implementeringen av *pivot_root* kan root och den aktuella arbetskatalogen för den som anropar ändras eller inte. Följande är en sekvens för att anropa *pivot_root* som fungerar i båda fallen, förutsatt att *pivot_root* och *chroot* finns i den aktuella *PATH*:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "cd new_root\npivot_root . put_old\nexec chroot . command\n"
msgstr "cd ny_root\npivot_root . put_old\nexekvera chroot . kommando\n"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Note that *chroot* must be available under the old root and under the new root, because *pivot_root* may or may not have implicitly changed the root directory of the shell."
msgstr "Observera att *chroot* måste vara tillgängligt under den gamla roten och under den nya roten, eftersom *pivot_root* kanske eller kanske inte implicit har ändrat rotkatalogen i skalet."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Note that *exec chroot* changes the running executable, which is necessary if the old root directory should be unmounted afterwards. Also note that standard input, output, and error may still point to a device on the old root file system, keeping it busy. They can easily be changed when invoking *chroot* (see below; note the absence of leading slashes to make it work whether *pivot_root* has changed the shell's root or not)."
msgstr "Observera att *exec chroot* ändrar den körbara filen, vilket är nödvändigt om den gamla rotkatalogen ska kunna avmonteras efteråt. Observera också att standardinmatning, -utmatning och -fel fortfarande kan peka på en enhet i det gamla rotfilsystemet, vilket håller den upptagen. De kan enkelt ändras när *chroot* anropas (se nedan; notera avsaknaden av inledande snedstreck för att det ska fungera oavsett om *pivot_root* har ändrat skalets rot eller inte)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Change the root file system to _/dev/hda1_ from an interactive shell:"
msgstr "Ändra rotfilsystemet till _/dev/hda1_ från ett interaktivt skal:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "mount /dev/hda1 /new-root\ncd /new-root\npivot_root . old-root\nexec chroot . sh <dev/console >dev/console 2>&1\numount /old-root\n"
msgstr "montera /dev/hda1 /ny-root\ncd /ny-root\npivot_root . gammal-root\nexec chroot . sh <dev/console >dev/console 2>&1\numount /gammal-root\n"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Mount the new root file system over NFS from 10.0.0.1:/my_root and run *init*:"
msgstr "Montera det nya rotfilsystemet via NFS från 10.0.0.1:/my_root och kör *init*:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "ifconfig lo 127.0.0.1 up   # for portmap\n# configure Ethernet or such\nportmap   # for lockd (implicitly started by mount)\nmount -o ro 10.0.0.1:/my_root /mnt\nkillall portmap   # portmap keeps old root busy\ncd /mnt\npivot_root . old_root\nexec chroot . sh -c 'umount /old_root; exec /sbin/init' \\\n  <dev/console >dev/console 2>&1\n"
msgstr "ifconfig lo 127.0.0.1 up # för portmap\n# konfigurera Ethernet eller liknande\nportmap # för lockd (startas implicit av mount)\nmount -o ro 10.0.0.1:/my_root /mnt\nkillall portmap # portmap håller den gamla roten upptagen\ncd /mnt\npivot_root . gammal_root\nexec chroot . sh -c 'umount /old_root; exec /sbin/init' \\\n  <dev/console >dev/console 2>&1\n"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*chroot*(1), *pivot_root*(2), *mount*(8), *switch_root*(8), *umount*(8)"
msgstr "*chroot*(1), *pivot_root*(2), *mount*(8), *switch_root*(8), *umount*(8)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "prlimit(1)"
msgstr "prlimit(1)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "prlimit - get and set process resource limits"
msgstr "prlimit - hämta och ställa in gränser för processresurser"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*prlimit* [options] [**--**_resource_[**=**_limits_]] [*--pid* _PID_]"
msgstr "*prlimit* [flaggor] [**--**_resource_[**=**_limits_]] [*--pid* _PID_] [*--pid* _PID_]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*prlimit* [options] [**--**_resource_[**=**_limits_]] _command_ [_argument_...]"
msgstr "*prlimit* [flaggor] [**--**_resource_[**=**_limits_]] _kommando_ [_argument_...]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Given a process ID and one or more resources, *prlimit* tries to retrieve and/or modify the limits."
msgstr "Med ett process-ID och en eller flera resurser försöker *prlimit* hämta och/eller ändra gränserna."

#. from tp:util-linux-man-2.41.2-rc1
msgid "When _command_ is given, *prlimit* will run this command with the given arguments."
msgstr "När _kommando_ anges kommer *prlimit* att köra detta kommando med de angivna argumenten."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The _limits_ parameter is composed of a soft and a hard value, separated by a colon (:), in order to modify the existing values. If no _limits_ are given, *prlimit* will display the current values. If one of the values is not given, then the existing one will be used. To specify the unlimited or infinity limit (*RLIM_INFINITY*), the -1 or 'unlimited' string can be passed."
msgstr "Parametern _limits_ består av ett mjukt och ett hårt värde, åtskilda av ett kolon (:), för att ändra de befintliga värdena. Om inga _limits_ anges kommer *prlimit* att visa de aktuella värdena. Om något av värdena inte anges används det befintliga värdet. För att ange en obegränsad eller oändlig gräns (*RLIM_INFINITY*) kan strängen -1 eller \"unlimited\" skickas."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Because of the nature of limits, the soft limit must be lower or equal to the high limit (also called the ceiling). To see all available resource limits, refer to the *RESOURCE OPTIONS* section."
msgstr "På grund av begränsningarnas natur måste den mjuka gränsen vara lägre än eller lika med den höga gränsen (även kallad taket). För att se alla tillgängliga resursgränser, se avsnittet *RESURSFLAGGOR*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "_soft_{colon}__hard__ Specify both limits."
msgstr "_mjuk_{colon}__hård__ Ange båda gränserna."

#. from tp:util-linux-man-2.41.2-rc1
msgid "_soft_{colon} Specify only the soft limit."
msgstr "_soft_{colon} Ange endast den mjuka gränsen."

#. from tp:util-linux-man-2.41.2-rc1
msgid "{colon}__hard__ Specify only the hard limit."
msgstr "{colon}__hard__ Ange endast den hårda gränsen."

#. from tp:util-linux-man-2.41.2-rc1
msgid "_value_ Specify both limits to the same value."
msgstr "_värde_ Ange båda gränserna till samma värde."

#. from tp:util-linux-man-2.41.2-rc1
msgid "GENERAL OPTIONS"
msgstr "ALLMÄNNA FLAGGOR"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Define the output columns to use. If no output arrangement is specified, then a default set is used. Use *--help* to get a list of all supported columns."
msgstr "Definiera vilka utmatningskolumner som ska användas. Om inget utdataarrangemang anges används en standarduppsättning. Använd *--help* för att få en lista över alla kolumner som stöds."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-p*, *--pid* _PID_"
msgstr "*-p*, *--pid* _PID_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Specify the process ID.  Without this option (and without a _command_), the running process will be used."
msgstr "Ange processens ID.  Utan denna flagga (och utan ett _kommando_) används den process som körs."

#. from tp:util-linux-man-2.41.2-rc1
msgid "RESOURCE OPTIONS"
msgstr "RESURSFLAGGOR"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-c*, *--core*[**=**_limits_]"
msgstr "*-c*, *--core*[**=**_limits_]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Maximum size of a core file."
msgstr "Maximal storlek på en kärnfil."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-d*, *--data*[**=**_limits_]"
msgstr "*-d*, *--data*[**=**_limits_]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Maximum data size."
msgstr "Maximal datastorlek."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-e*, *--nice*[**=**_limits_]"
msgstr "*-e*, *--nice*[**=**_limits_]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Maximum nice priority allowed to raise."
msgstr "Högsta tillåtna prioritet att höja."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-f*, *--fsize*[**=**_limits_]"
msgstr "*-f*, *--fsize*[**=**_limits_]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Maximum file size."
msgstr "Maximal filstorlek."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-i*, *--sigpending*[**=**_limits_]"
msgstr "*-i*, *--sigpending*[**=**_limits_]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Maximum number of pending signals."
msgstr "Maximalt antal väntande signaler."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-l*, *--memlock*[**=**_limits_]"
msgstr "*-l*, *--memlock*[**=**_limits_]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Maximum locked-in-memory address space."
msgstr "Maximalt adressutrymme som är låst i minnet."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-m*, *--rss*[**=**_limits_]"
msgstr "*-m*, *--rss*[**=**_limits_]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Maximum Resident Set Size (RSS)."
msgstr "Maximal storlek på invånaruppsättningen (RSS)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-n*, *--nofile*[**=**_limits_]"
msgstr "*-n*, *--nofile*[**=**_limits_]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Maximum number of open files."
msgstr "Maximalt antal öppna filer."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-q*, *--msgqueue*[**=**_limits_]"
msgstr "*-q*, *--msgqueue*[**=**_limits_]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Maximum number of bytes in POSIX message queues."
msgstr "Maximalt antal byte i POSIX-meddelandeköer."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-r*, *--rtprio*[**=**_limits_]"
msgstr "*-r*, *--rtprio*[**=**_limits_]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Maximum real-time priority."
msgstr "Maximal realtidsprioritet."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-s*, *--stack*[**=**_limits_]"
msgstr "*-s*, *--stack*[**=**_limits_]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Maximum size of the stack."
msgstr "Stapelns maximala storlek."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-t*, *--cpu*[**=**_limits_]"
msgstr "*-t*, *--cpu*[**=**_limits_]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "CPU time, in seconds."
msgstr "CPU-tid i sekunder."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-u*, *--nproc*[**=**_limits_]"
msgstr "*-u*, *--nproc*[**=**_limits_]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Maximum number of processes."
msgstr "Maximalt antal processer."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-v*, *--as*[**=**_limits_]"
msgstr "*-v*, *--as*[**=**_limits_]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Address space limit."
msgstr "Gräns för adressutrymme."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-x*, *--locks*[**=**_limits_]"
msgstr "*-x*, *--locks*[**=**_limits_]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Maximum number of file locks held."
msgstr "Maximalt antal fillås som hålls."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-y*, *--rttime*[**=**_limits_]"
msgstr "*-y*, *--rttime*[**=**_limits_]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Timeout for real-time tasks."
msgstr "Timeout för realtidsuppgifter."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The *prlimit*(2) system call is supported since Linux 2.6.36, older kernels will break this program."
msgstr "Systemanropet *prlimit*(2) stöds sedan Linux 2.6.36, äldre kärnor kommer att bryta detta program."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*prlimit --pid 13134*"
msgstr "*prlimit --pid 13134*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Display limit values for all current resources."
msgstr "Visa gränsvärden för alla aktuella resurser."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*prlimit --pid 13134 --rss --nofile=1024:4095*"
msgstr "*prlimit --pid 13134 --rss --nofile=1024:4095*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Display the limits of the RSS, and set the soft and hard limits for the number of open files to 1024 and 4095, respectively."
msgstr "Visa gränserna för RSS och ställ in de mjuka och hårda gränserna för antalet öppna filer till 1024 respektive 4095."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*prlimit --pid 13134 --nproc=512:*"
msgstr "*prlimit --pid 13134 --nproc=512:*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Modify only the soft limit for the number of processes."
msgstr "Ändra endast den mjuka gränsen för antalet processer."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*prlimit --pid $$ --nproc=unlimited*"
msgstr "*prlimit --pid $$ --nproc=obegränsad*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Set for the current process both the soft and ceiling values for the number of processes to unlimited."
msgstr "Ställ in både det mjuka värdet och takvärdet för antalet processer till obegränsat för den aktuella processen."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*prlimit --cpu=10 sort -u hugefile*"
msgstr "*prlimit --cpu=10 sort -u hugefile*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Set both the soft and hard CPU time limit to ten seconds and run *sort*(1)."
msgstr "Ställ in både den mjuka och hårda CPU-tidsgränsen till tio sekunder och kör *sort*(1)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "mailto:dave@gnu.org[Davidlohr Bueso] - In memory of Dennis M. Ritchie."
msgstr "mailto:dave@gnu.org[Davidlohr Bueso] - Till minne av Dennis M. Ritchie."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*ulimit*(1p), *prlimit*(2)"
msgstr "*ulimit*(1p), *prlimit*(2)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "readprofile(8)"
msgstr "läsa profil(8)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "readprofile - read kernel profiling information"
msgstr "readprofile - läser information om kärnprofilering"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*readprofile* [options]"
msgstr "*readprofile* [flaggor]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "This manpage documents version 2.0 of the program."
msgstr "Denna manpage dokumenterar version 2.0 av programmet."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The *readprofile* command uses the _/proc/profile_ information to print ascii data on standard output. The output is organized in three columns: the first is the number of clock ticks, the second is the name of the C function in the kernel where those many ticks occurred, and the third is the normalized `load' of the procedure, calculated as a ratio between the number of ticks and the length of the procedure. The output is filled with blanks to ease readability."
msgstr "Kommandot *readprofile* använder informationen _/proc/profile_ för att skriva ut ascii-data på standardutmatningen. Utdata är organiserade i tre kolumner: den första är antalet klockticks, den andra är namnet på den C-funktion i kärnan där dessa många ticks inträffade och den tredje är procedurens normaliserade `load', beräknad som en kvot mellan antalet ticks och procedurens längd. Utdata är fyllda med blanksteg för att underlätta läsbarheten."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Print all symbols in the mapfile. By default the procedures with reported ticks are not printed."
msgstr "Skriv ut alla symboler i kartfilen. Som standard skrivs inte procedurer med rapporterade ticks ut."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-b*, *--histbin*"
msgstr "*-b*, *--histbin*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Print individual histogram-bin counts."
msgstr "Skriv ut individuella histogram-bin-räkningar."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Info. This makes *readprofile* only print the profiling step used by the kernel. The profiling step is the resolution of the profiling buffer, and is chosen during kernel configuration (through *make config*), or in the kernel's command line. If the *-t* (terse) switch is used together with *-i* only the decimal number is printed."
msgstr "Info. Detta gör att *readprofile* endast skriver ut det profileringssteg som används av kärnan. Profileringssteget är upplösningen på profileringsbufferten och väljs under konfigurationen av kärnan (via *make config*) eller i kärnans kommandorad. Om omkopplaren *-t* (terse) används tillsammans med *-i* skrivs endast decimaltalet ut."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-m*, *--mapfile* _mapfile_"
msgstr "*-m*, *--mapfile* _mapfile_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Specify a mapfile, which by default is _/usr/src/linux/System.map_. You should specify the map file on cmdline if your current kernel isn't the last one you compiled, or if you keep System.map elsewhere. If the name of the map file ends with _.gz_ it is decompressed on the fly."
msgstr "Ange en mapfil, som standard är _/usr/src/linux/System.map_. Du bör ange map-filen på cmdline om din nuvarande kärna inte är den senaste du kompilerade, eller om du har System.map någon annanstans. Om namnet på map-filen slutar med _.gz_ dekomprimeras den i farten."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-M*, *--multiplier* _multiplier_"
msgstr "*-M*, *--multiplier* _multiplier_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "On some architectures it is possible to alter the frequency at which the kernel delivers profiling interrupts to each CPU. This option allows you to set the frequency, as a multiplier of the system clock frequency, HZ. Linux 2.6.16 dropped multiplier support for most systems. This option also resets the profiling buffer, and requires superuser privileges."
msgstr "På vissa arkitekturer är det möjligt att ändra den frekvens med vilken kärnan levererar profileringsavbrott till varje processor. Med den här flaggan kan du ställa in frekvensen som en multiplikator av systemklockfrekvensen, HZ. I Linux 2.6.16 försvann stödet för multiplikatorer för de flesta system. Den här flaggan återställer också profileringsbufferten och kräver superanvändarprivilegier."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-p*, *--profile* _pro-file_"
msgstr "*-p*, *--profile* _pro-file_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Specify a different profiling buffer, which by default is _/proc/profile_. Using a different pro-file is useful if you want to `freeze' the kernel profiling at some time and read it later. The _/proc/profile_ file can be copied using *cat*(1) or *cp*(1). There is no more support for compressed profile buffers, like in *readprofile-1.1*, because the program needs to know the size of the buffer in advance."
msgstr "Ange en annan profileringsbuffert, som standard är _/proc/profile_. Att använda en annan pro-fil är användbart om du vill `frysa' kärnprofileringen vid en viss tidpunkt och läsa den senare. Filen _/proc/profile_ kan kopieras med hjälp av *cat*(1) eller *cp*(1). Det finns inte längre något stöd för komprimerade profilbuffertar, som i *readprofile-1.1*, eftersom programmet måste känna till storleken på bufferten i förväg."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-r*, *--reset*"
msgstr "*-r*, *--reset*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Reset the profiling buffer. This can only be invoked by root, because _/proc/profile_ is readable by everybody but writable only by the superuser. However, you can make *readprofile* set-user-ID 0, in order to reset the buffer without gaining privileges."
msgstr "Återställer profileringsbufferten. Detta kan bara göras av root, eftersom _/proc/profile_ är läsbart för alla men endast skrivbart för superanvändaren. Du kan dock göra så att *readprofile* set-user-ID 0, för att återställa bufferten utan att få privilegier."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-s, --counters*"
msgstr "*-s, --counters*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Print individual counters within functions."
msgstr "Skriv ut enskilda räknare inom funktioner."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Verbose. The output is organized in four columns and filled with blanks. The first column is the RAM address of a kernel function, the second is the name of the function, the third is the number of clock ticks and the last is the normalized load."
msgstr "Utförlig. Utdata är organiserade i fyra kolumner och fyllda med blanksteg. Den första kolumnen är RAM-adressen för en kernelfunktion, den andra är namnet på funktionen, den tredje är antalet klockslag och den sista är den normaliserade belastningen."

#. from tp:util-linux-man-2.41.2-rc1
msgid "_/proc/profile_"
msgstr "_/proc/profile_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "A binary snapshot of the profiling buffer."
msgstr "En binär ögonblicksbild av profileringsbufferten."

#. from tp:util-linux-man-2.41.2-rc1
msgid "_/usr/src/linux/System.map_"
msgstr "_/usr/src/linux/System.map"

#. from tp:util-linux-man-2.41.2-rc1
msgid "The symbol table for the kernel."
msgstr "Symboltabellen för kärnan."

#. from tp:util-linux-man-2.41.2-rc1
msgid "_/usr/src/linux/*_"
msgstr "_/usr/src/linux/*_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "The program being profiled :-)"
msgstr "Det program som profileras :-)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*readprofile* only works with a 1.3.x or newer kernel, because _/proc/profile_ changed in the step from 1.2 to 1.3."
msgstr "*readprofile* fungerar bara med en 1.3.x eller nyare kärna, eftersom _/proc/profile_ ändrades i steget från 1.2 till 1.3."

#. from tp:util-linux-man-2.41.2-rc1
msgid "This program only works with ELF kernels. The change for a.out kernels is trivial, and left as an exercise to the a.out user."
msgstr "Det här programmet fungerar bara med ELF-kärnor. Ändringen för a.out-kärnor är trivial och lämnas som en övning till a.out-användaren."

#. from tp:util-linux-man-2.41.2-rc1
msgid "To enable profiling, the kernel must be rebooted, because no profiling module is available, and it wouldn't be easy to build. To enable profiling, you can specify *profile*=_2_ (or another number) on the kernel commandline. The number you specify is the two-exponent used as profiling step."
msgstr "För att aktivera profilering måste kärnan startas om, eftersom ingen profileringsmodul finns tillgänglig och det inte skulle vara lätt att bygga en sådan. För att aktivera profilering kan du ange *profile*=_2_ (eller ett annat nummer) på kommandoraden för kärnan. Det tal du anger är den tvåexponent som används som profileringssteg."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Profiling is disabled when interrupts are inhibited. This means that many profiling ticks happen when interrupts are re-enabled. Watch out for misleading information."
msgstr "Profileringen är inaktiverad när avbrotten är avstängda. Detta innebär att många profileringsticks inträffar när avbrotten återaktiveras. Se upp för vilseledande information."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Browse the profiling buffer ordering by clock ticks:"
msgstr "Bläddra i profileringsbufferten med ordning efter klockticks:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "   readprofile | sort -nr | less\n"
msgstr "   readprofile | sort -nr | less\n"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Print the 20 most loaded procedures:"
msgstr "Skriv ut de 20 mest laddade procedurerna:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "   readprofile | sort -nr +2 | head -20\n"
msgstr "   readprofile | sort -nr +2 | head -20\n"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Print only filesystem profile:"
msgstr "Skriv endast ut filsystemets profil:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "   readprofile | grep _ext2\n"
msgstr "   readprofile | grep _ext2\n"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Look at all the kernel information, with ram addresses:"
msgstr "Titta på all kärninformation, med ramadresser:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "   readprofile -av | less\n"
msgstr "   readprofile -av | less\n"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Browse a 'frozen' profile buffer for a non current kernel:"
msgstr "Bläddra i en \"frusen\" profilbuffert för en icke aktuell kärna:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "   readprofile -p ~/profile.freeze -m /zImage.map.gz\n"
msgstr "   readprofile -p ~/profile.freeze -m /zImage.map.gz\n"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Request profiling at 2kHz per CPU, and reset the profiling buffer:"
msgstr "Begär profilering vid 2 kHz per CPU och återställ profileringsbufferten:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "   sudo readprofile -M 20\n"
msgstr "   sudo readprofile -M 20\n"

#. from tp:util-linux-man-2.41.2-rc1
msgid "renice(1)"
msgstr "renice(1)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "renice - alter priority of running processes"
msgstr "renice - ändra prioritet för pågående processer"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*renice* [*--priority|--relative*] _priority_ [*-g*|*-p*|*-u*] _identifier_..."
msgstr "*renice* [*--prioritet|--relativ*] _prioritet_ [*-g*|*-p*|*-u*] _identifierare_..."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*renice* alters the scheduling priority of one or more running processes. The first argument is the _priority_ value to be used. The other arguments are interpreted as process IDs (by default), process group IDs, user IDs, or user names. *renice*'ing a process group causes all processes in the process group to have their scheduling priority altered. *renice*'ing a user causes all processes owned by the user to have their scheduling priority altered."
msgstr "*renice* ändrar schemaläggningsprioriteten för en eller flera processer som körs. Det första argumentet är det _priority_-värde som ska användas. De andra argumenten tolkas som process-ID (som standard), processgrupp-ID, användar-ID eller användarnamn. *renice*'ing av en processgrupp leder till att alla processer i processgruppen får sin schemaläggningsprioritet ändrad. *renice*'ing a user gör att alla processer som ägs av användaren får ändrad schemaläggningsprioritet."

#. from tp:util-linux-man-2.41.2-rc1
msgid "If no *-n*, *--priority* or *--relative* option is used, then the priority is set as *absolute*."
msgstr "Om ingen av flaggorna *-n*, *--priority* eller *--relative* används, sätts prioriteten till *absolute*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-n* _priority_"
msgstr "*-n* _priority_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Specify the *absolute* or *relative* (depending on environment variable POSIXLY_CORRECT) scheduling _priority_ to be used for the process, process group, or user. Use of the option *-n* is optional, but when used, it must be the first argument. See *NOTES* for more information."
msgstr "Ange den *absoluta* eller *relativa* (beroende på miljövariabeln POSIXLY_CORRECT) _prioritet_ för schemaläggning som ska användas för processen, processgruppen eller användaren. Användningen av flaggan *-n* är valfritt, men när det används måste det vara det första argumentet. Se *NOTES* för mer information."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--priority* _priority_"
msgstr "*--priority* _priority_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Specify an *absolute* scheduling _priority_. _Priority_ is set to the given value. This is the default, when no option is specified."
msgstr "Ange en *absolut* _prioritet_ för schemaläggning. _Priority_ sätts till det angivna värdet. Detta är standardvärdet när ingen flagga anges."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--relative* _priority_"
msgstr "*--relative* _priority_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Specify a *relative* scheduling _priority_. Same as the standard POSIX *-n* option. _Priority_ gets _incremented/decremented_ by the given value."
msgstr "Ange en *relativ* _prioritet_ för schemaläggning. Samma som POSIX standardflagga *-n*. _Priority_ blir _incrementerad/decrementerad_ med det angivna värdet."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-g*, *--pgrp*"
msgstr "*-g*, *--pgrp*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Interpret the succeeding arguments as process group IDs."
msgstr "Tolka de efterföljande argumenten som processgrupps-ID."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Interpret the succeeding arguments as process IDs (the default)."
msgstr "Tolka de efterföljande argumenten som process-ID (standard)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-u*, *--user*"
msgstr "*-u*, *--user*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Interpret the succeeding arguments as usernames or UIDs."
msgstr "Tolka de efterföljande argumenten som användarnamn eller UID."

#. from tp:util-linux-man-2.41.2-rc1
msgid "_/etc/passwd_"
msgstr "_/etc/passwd"

#. from tp:util-linux-man-2.41.2-rc1
msgid "to map user names to user IDs"
msgstr "för att mappa användarnamn till användar-ID"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Users other than the superuser may only alter the priority of processes they own. Furthermore, an unprivileged user can only _increase_ the \"nice value\" (i.e., choose a lower priority) and such changes are irreversible unless (since Linux 2.6.12) the user has a suitable \"nice\" resource limit (see *ulimit*(1p) and *getrlimit*(2))."
msgstr "Andra användare än superanvändaren kan bara ändra prioriteten för processer som de själva äger. Dessutom kan en icke-privilegierad användare bara _höja_ det \"fina värdet\" (dvs. välja en lägre prioritet) och sådana ändringar är irreversibla såvida inte (sedan Linux 2.6.12) användaren har en lämplig \"fin\" resursgräns (se *ulimit*(1p) och *getrlimit*(2))."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The superuser may alter the priority of any process and set the priority to any value in the range -20 to 19. Useful priorities are: 19 (the affected processes will run only when nothing else in the system wants to), 0 (the \"base\" scheduling priority), anything negative (to make things go very fast)."
msgstr "Superanvändaren kan ändra prioriteten för alla processer och sätta prioriteten till valfritt värde inom intervallet -20 till 19. Användbara prioriteringar är: 19 (de berörda processerna körs endast när inget annat i systemet vill göra det), 0 (den \"grundläggande\" schemaläggningsprioriteten), allt negativt (för att få saker att gå mycket snabbt)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "For historical reasons in this implementation, the *-n* option did not follow the POSIX specification. Therefore, instead of setting a *relative* priority, it sets an *absolute* priority by default. As this may not be desirable, this behavior can be controlled by setting the environment variable POSIXLY_CORRECT to be fully POSIX compliant. See the *-n* option for details. See *--relative* and *--priority* for options that do not change behavior depending on environment variables."
msgstr "Av historiska skäl i den här implementationen följde inte flaggan *-n* POSIX-specifikationen. I stället för att ange en *relativ* prioritet anger det därför en *absolut* prioritet som standard. Eftersom detta kanske inte är önskvärt kan beteendet kontrolleras genom att ställa in miljövariabeln POSIXLY_CORRECT så att den är helt POSIX-kompatibel. Se flaggan *-n* för mer information. Se *--relative* och *--priority* för flaggor som inte ändrar beteende beroende på miljövariabler."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The *renice* command appeared in 4.0BSD."
msgstr "Kommandot *renice* dök upp i 4.0BSD."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The following command would change the priority of the processes with PIDs 987 and 32, plus all processes owned by the users daemon and root:"
msgstr "Följande kommando ändrar prioriteten för processerna med PID 987 och 32, samt alla processer som ägs av användarna daemon och root:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*renice +1 987 -u daemon root -p 32*"
msgstr "*renice +1 987 -u daemon root -p 32*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*nice*(1), *chrt*(1), *getpriority*(2), *setpriority*(2), *credentials*(7), *sched*(7)"
msgstr "*nice*(1), *chrt*(1), *getpriority*(2), *setpriority*(2), *credentials*(7), *sched*(7)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "rfkill(8)"
msgstr "rfkill(8)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "rfkill - tool for enabling and disabling wireless devices"
msgstr "rfkill - verktyg för att aktivera och inaktivera trådlösa enheter"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*rfkill* [options] [_command_] [_ID_|_type_ ...]"
msgstr "*rfkill* [flaggor] [_kommando_] [_ID_|_typ_ ...]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*rfkill* lists, enabling and disabling wireless devices."
msgstr "*rfkill* listar, aktiverar och inaktiverar trådlösa enheter."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The command \"list\" output format is deprecated and maintained for backward compatibility only. The new output format is the default when no command is specified or when the option *--output* is used."
msgstr "Utmatningsformatet för kommandot \"list\" är föråldrat och bibehålls endast för bakåtkompatibilitet. Det nya utdataformatet är standard när inget kommando anges eller när flaggan *--output* används."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The default output is subject to change. So whenever possible, you should avoid using default outputs in your scripts. Always explicitly define expected columns by using the *--output* option together with a columns list in environments where a stable output is required."
msgstr "Standardutdata kan komma att ändras. Så när det är möjligt bör du undvika att använda standardutdata i dina skript. Definiera alltid förväntade kolumner explicit genom att använda flaggan *--output* tillsammans med en kolumnlista i miljöer där en stabil utdata krävs."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Specify which output columns to print. Use *--help* to get a list of available columns."
msgstr "Ange vilka utdatakolumner som ska skrivas ut. Använd *--help* för att få en lista över tillgängliga kolumner."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*help*"
msgstr "*hjälp*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*event*"
msgstr "*händelse*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Listen for rfkill events and display them on stdout."
msgstr "Lyssna efter rfkill-händelser och visa dem på stdout."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*list* [__id__|__type__ ...]"
msgstr "*lista* [__id__|__typ__ ...]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "List the current state of all available devices. The command output format is deprecated, see the *DESCRIPTION* section. It is a good idea to check with *list* command _id_ or _type_ scope is appropriate before setting *block* or *unblock*. Special _all_ type string will match everything. Use of multiple _ID_ or _type_ arguments is supported. Possible types are all, {wlan | wifi}, bluetooth, {uwb | ultrawideband}, wimax, wwan, gps, fm, nfc."
msgstr "Lista det aktuella tillståndet för alla tillgängliga enheter. Kommandots utdataformat är föråldrat, se avsnittet *DESCRIPTION*. Det är en god idé att kontrollera med *list*-kommandot _id_ eller _typ_ att omfattningen är lämplig innan du ställer in *block* eller *unblock*. Den speciella typsträngen _all_ matchar allt. Användning av flera _ID_- eller _typ_-argument stöds. Möjliga typer är all, {wlan | wifi}, bluetooth, {uwb | ultrawideband}, wimax, wwan, gps, fm, nfc."

#. from tp:util-linux-man-2.41.2-rc1
msgid "**block** __id__|__type__ [...]"
msgstr "**block** __id__|__typ__ [...]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Disable the corresponding device."
msgstr "Inaktivera motsvarande enhet."

#. from tp:util-linux-man-2.41.2-rc1
msgid "**unblock** __id__|__type__ [...]"
msgstr "**unblock** __id__|__typ__ [...]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Enable the corresponding device. If the device is hard-blocked, for example via a hardware switch, it will remain unavailable though it is now soft-unblocked."
msgstr "Aktivera motsvarande enhet. Om enheten är hårt blockerad, t.ex. via en hårdvaruswitch, kommer den att förbli otillgänglig även om den nu är mjukt avblockerad."

#. from tp:util-linux-man-2.41.2-rc1
msgid "**toggle** __id__|__type__ [...]"
msgstr "**toggle** __id__|__typ__ [...]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Enable or disable the corresponding device."
msgstr "Aktivera eller inaktivera motsvarande enhet."

#. from tp:util-linux-man-2.41.2-rc1
msgid "  rfkill --output ID,TYPE\n  rfkill block all\n  rfkill unblock wlan\n  rfkill block bluetooth uwb wimax wwan gps fm nfc\n"
msgstr "  rfkill --output ID,TYPE\n  rfkill block all\n  rfkill unblock wlan\n  rfkill block bluetooth uwb wimax wwan gps fm nfc\n"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*rfkill* was originally written by mailto:johannes@sipsolutions.net[Johannes Berg] and mailto:marcel@holtmann.org[Marcel Holtmann]. The code has been later modified by mailto:kerolasa@iki.fi[Sami Kerola] and mailto:kzak@redhat.com[Karel Zak] for the util-linux project."
msgstr "*rfkill* skrevs ursprungligen av mailto:johannes@sipsolutions.net[Johannes Berg] och mailto:marcel@holtmann.org[Marcel Holtmann]. Koden har senare modifierats av mailto:kerolasa@iki.fi[Sami Kerola] och mailto:kzak@redhat.com[Karel Zak] för util-linux-projektet."

#. from tp:util-linux-man-2.41.2-rc1
msgid "This manual page was written by mailto:linux@youmustbejoking.demon.co.uk[Darren Salt] for the Debian project (and may be used by others)."
msgstr "Den här manualsidan skrevs av mailto:linux@youmustbejoking.demon.co.uk[Darren Salt] för Debian-projektet (och kan användas av andra)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*powertop*(8), *systemd-rfkill*(8), https://docs.kernel.org/driver-api/rfkill.html[Linux kernel documentation]"
msgstr "*powertop*(8), *systemd-rfkill*(8), https://docs.kernel.org/driver-api/rfkill.html[Dokumentation om Linux-kärnan]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "rtcwake(8)"
msgstr "rtcwake(8)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "rtcwake - enter a system sleep state until specified wakeup time"
msgstr "rtcwake - försätter systemet i viloläge tills angiven väckningstid"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*rtcwake* [options] [*-d* _device_] [*-m* _standby_mode_] {*-s* _seconds_|*-t* _time_t_}"
msgstr "*rtcwake* [flaggor] [*-d* _enhet_] [*-m* _standby_läge_] {*-s* _sekunder_|*-t* _tid_t_}"

#. from tp:util-linux-man-2.41.2-rc1
msgid "This program is used to enter a system sleep state and to automatically wake from it at a specified time."
msgstr "Detta program används för att försätta systemet i viloläge och väcka det automatiskt vid en angiven tidpunkt."

#. from tp:util-linux-man-2.41.2-rc1
msgid "This uses cross-platform Linux interfaces to enter a system sleep state, and leave it no later than a specified time. It uses any RTC framework driver that supports standard driver model wakeup flags."
msgstr "Detta använder plattformsoberoende Linux-gränssnitt för att gå in i systemets viloläge och lämna det senast vid en angiven tidpunkt. Den använder alla drivrutiner för RTC-ramverk som stöder standardflaggor för väckning av drivrutinsmodeller."

#. from tp:util-linux-man-2.41.2-rc1
msgid "This is normally used like the old *apmsleep* utility, to wake from a suspend state like ACPI S1 (standby) or S3 (suspend-to-RAM). Most platforms can implement those without analogues of BIOS, APM, or ACPI."
msgstr "Detta används normalt som det gamla verktyget *apmsleep*, för att väcka från ett suspenderat tillstånd som ACPI S1 (standby) eller S3 (suspend-to-RAM). De flesta plattformar kan implementera dessa utan motsvarigheter till BIOS, APM eller ACPI."

#. from tp:util-linux-man-2.41.2-rc1
msgid "On some systems, this can also be used like *nvram-wakeup*, waking from states like ACPI S4 (suspend to disk). Not all systems have persistent media that are appropriate for such suspend modes."
msgstr "På vissa system kan detta också användas som *nvram-wakeup*, för att väcka från tillstånd som ACPI S4 (suspend to disk). Det är inte alla system som har permanenta media som är lämpliga för sådana suspensionslägen."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Note that alarm functionality depends on hardware; not every RTC is able to setup an alarm up to 24 hours in the future."
msgstr "Observera att larmfunktionen beror på maskinvaran; inte alla RTC kan ställa in ett larm upp till 24 timmar framåt i tiden."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The suspend setup may be interrupted by active hardware; for example wireless USB input devices that continue to send events for some fraction of a second after the return key is pressed. *rtcwake* tries to avoid this problem and it waits to the terminal to settle down before entering a system sleep."
msgstr "Suspend-inställningen kan avbrytas av aktiv maskinvara, t.ex. trådlösa USB-ingångar som fortsätter att skicka händelser under en bråkdel av en sekund efter att returtangenten har tryckts ned. *rtcwake* försöker undvika detta problem och väntar på att terminalen ska lugna ner sig innan den går in i systemvila."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-A*, *--adjfile* _file_"
msgstr "*-A*, *--adjfile* _fil_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Specify an alternative path to the adjust file."
msgstr "Ange en alternativ sökväg till justeringsfilen."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Read the clock mode (whether the hardware clock is set to UTC or local time) from the _adjtime_ file, where *hwclock*(8) stores that information. This is the default."
msgstr "Läs klockläget (om maskinvaruklockan är inställd på UTC eller lokal tid) från filen _adjtime_, där *hwclock*(8) lagrar den informationen. Detta är standardinställningen."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--date* _timestamp_"
msgstr "*--date* _timestamp_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Set the wakeup time to the value of the timestamp. Format of the timestamp can be any of the following:"
msgstr "Ställ in väckningstiden till värdet för tidsstämpeln. Tidsstämpelns format kan vara något av följande:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "|YYYYMMDDhhmmss |\n|YYYY-MM-DD hh:mm:ss |\n|YYYY-MM-DD hh:mm |(seconds will be set to 00)\n|YYYY-MM-DD |(time will be set to 00:00:00)\n|hh:mm:ss |(date will be set to today)\n|hh:mm |(date will be set to today, seconds to 00)\n|tomorrow |(time is set to 00:00:00)\n|+5min |\n"
msgstr "|YYYYMMDDhhmmss | |YYYYMMDDhhmmss\n|YYYY-MM-DD hh:mm:ss |YYY-MM-DD hh:mm\n|YYYY-MM-DD hh:mm |(sekunder ställs in på 00)\n|YYYY-MM-DD |(tiden sätts till 00:00:00)\n|hh:mm:ss |(datumet kommer att ställas in till idag)\n|hh:mm |(datum ställs in till idag, sekunder till 00)\n|tomorrow |(tiden ställs in på 00:00:00)\n+5min\n"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-d*, *--device* _device_"
msgstr "*-d*, *--device* _enhet_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Use the specified _device_ instead of *rtc0* as realtime clock. This option is only relevant if your system has more than one RTC. You may specify *rtc1*, *rtc2*, ... here."
msgstr "Använd den angivna _enheten_ i stället för *rtc0* som realtidsklocka. Denna flaggan är endast relevant om ditt system har mer än en RTC. Du kan ange *rtc1*, *rtc2*, ... här."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-l*, *--local*"
msgstr "*-l*, *--local*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Assume that the hardware clock is set to local time, regardless of the contents of the _adjtime_ file."
msgstr "Antag att hårdvaruklockan är inställd på lokal tid, oavsett innehållet i filen _adjtime_."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--list-modes*"
msgstr "*--list-modes*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "List available *--mode* option arguments."
msgstr "Lista tillgängliga *--mode*-flaggargument."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-m*, *--mode* _mode_"
msgstr "*-m*, *--mode* _läge_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Go into the given standby state. Valid values for _mode_ are:"
msgstr "Gå in i det angivna standby-läget. Giltiga värden för _läge_ är:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*standby*"
msgstr "*standby*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "ACPI state S1. This state offers minimal, though real, power savings, while providing a very low-latency transition back to a working system. This is the default mode."
msgstr "ACPI-tillstånd S1. Detta tillstånd ger minimala, men verkliga, energibesparingar, samtidigt som det ger en övergång med mycket låg latens tillbaka till ett fungerande system. Detta är standardläget."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*freeze*"
msgstr "*frys*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "The processes are frozen, all the devices are suspended and all the processors idled. This state is a general state that does not need any platform-specific support, but it saves less power than Suspend-to-RAM, because the system is still in a running state. (Available since Linux 3.9.)"
msgstr "Processerna är frysta, alla enheter är avstängda och alla processorer går på tomgång. Detta tillstånd är ett allmänt tillstånd som inte behöver något plattformsspecifikt stöd, men det sparar mindre ström än Suspend-to-RAM, eftersom systemet fortfarande är i drift. (Finns sedan Linux 3.9.)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*mem*"
msgstr "*mem*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "ACPI state S3 (Suspend-to-RAM). This state offers significant power savings as everything in the system is put into a low-power state, except for memory, which is placed in self-refresh mode to retain its contents."
msgstr "ACPI-tillstånd S3 (Suspend-to-RAM). Detta tillstånd ger betydande energibesparingar eftersom allt i systemet försätts i lågeffektläge, utom minnet som försätts i självuppdateringsläge för att behålla sitt innehåll."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*disk*"
msgstr "*diskett*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "ACPI state S4 (Suspend-to-disk). This state offers the greatest power savings, and can be used even in the absence of low-level platform support for power management. This state operates similarly to Suspend-to-RAM, but includes a final step of writing memory contents to disk."
msgstr "ACPI-tillstånd S4 (Suspend-to-disk). Detta tillstånd ger de största energibesparingarna och kan användas även om det inte finns något plattformsstöd på låg nivå för strömhantering. Detta tillstånd fungerar på samma sätt som Suspend-to-RAM, men innehåller ett sista steg där minnesinnehållet skrivs till disk."

#. from tp:util-linux-man-2.41.2-rc1
msgid "ACPI state S5 (Poweroff). This is done by calling '/sbin/shutdown'. Not officially supported by ACPI, but it usually works."
msgstr "ACPI-tillstånd S5 (Avstängning). Detta görs genom att anropa \"/sbin/shutdown\". Stöds inte officiellt av ACPI, men det brukar fungera."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*no*"
msgstr "*nej*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Don't suspend, only set the RTC wakeup time."
msgstr "Avbryt inte, ställ bara in RTC:s väckningstid."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Don't suspend, but read the RTC device until an alarm time appears. This mode is useful for debugging."
msgstr "Avbryt inte, utan läs av RTC-enheten tills en larmtid visas. Detta läge är användbart för felsökning."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Disable a previously set alarm."
msgstr "Inaktivera ett tidigare inställt larm."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*show*"
msgstr "*visa*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Print alarm information in format: \"alarm: off|on <time>\". The time is in ctime() output format, e.g., \"alarm: on Tue Nov 16 04:48:45 2010\"."
msgstr "Skriv ut larminformation i format: \"alarm: off|on <time>\". Tiden anges i ctime()-utmatningsformat, t.ex. \"alarm: on Tue Nov 16 04:48:45 2010\"."

#. from tp:util-linux-man-2.41.2-rc1
msgid "This option does everything apart from actually setting up the alarm, suspending the system, or waiting for the alarm."
msgstr "Den här flaggan gör allt utom att faktiskt ställa in larmet, stänga av systemet eller vänta på larmet."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-s*, *--seconds* _seconds_"
msgstr "*-s*, *--seconds* _seconds_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Set the wakeup time to _seconds_ in the future from now."
msgstr "Ställ in väckningstiden till _sekunder_ i framtiden från och med nu."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-t*, *--time* _time_t_"
msgstr "*-t*, *--time* _time_t_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Set the wakeup time to the absolute time _time_t_. _time_t_ is the time in seconds since 1970-01-01, 00:00 UTC. Use the *date*(1) tool to convert between human-readable time and _time_t_."
msgstr "Ställ in väckningstiden till den absoluta tiden _time_t_. _time_t_ är tiden i sekunder sedan 1970-01-01, 00:00 UTC. Använd verktyget *date*(1) för att konvertera mellan mänskligt läsbar tid och _time_t_."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-u*, *--utc*"
msgstr "*-u*, *--utc*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Assume that the hardware clock is set to UTC (Universal Time Coordinated), regardless of the contents of the _adjtime_ file."
msgstr "Antag att hårdvaruklockan är inställd på UTC (Universal Time Coordinated), oavsett innehållet i filen _adjtime_."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Some PC systems can't currently exit sleep states such as *mem* using only the kernel code accessed by this driver. They need help from userspace code to make the framebuffer work again."
msgstr "Vissa PC-system kan för närvarande inte lämna vilolägen som *mem* med hjälp av endast den kärnkod som den här drivrutinen har åtkomst till. De behöver hjälp från userspace-koden för att få rambufferten att fungera igen."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The program was posted several times on LKML and other lists before appearing in kernel commit message for Linux 2.6 in the GIT commit 87ac84f42a7a580d0dd72ae31d6a5eb4bfe04c6d."
msgstr "Programmet publicerades flera gånger på LKML och andra listor innan det dök upp i kernel commit message för Linux 2.6 i GIT commit 87ac84f42a7a580d0dd72ae31d6a5eb4bfe04c6d."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The program was written by mailto:dbrownell@users.sourceforge.net[David Brownell] and improved by mailto:bwalle@suse.de[Bernhard Walle]."
msgstr "Programmet är skrivet av mailto:dbrownell@users.sourceforge.net[David Brownell] och förbättrat av mailto:bwalle@suse.de[Bernhard Walle]."

#. from tp:util-linux-man-2.41.2-rc1
msgid "This is free software. You may redistribute copies of it under the terms of the link:http://www.gnu.org/licenses/gpl.html[GNU General Public License]. There is NO WARRANTY, to the extent permitted by law."
msgstr "Detta är fri programvara. Du får vidaredistribuera kopior av den enligt villkoren i länken:http://www.gnu.org/licenses/gpl.html[GNU General Public License]. Det finns INGEN GARANTI, i den utsträckning som tillåts enligt lag."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*adjtime_config*(5), *hwclock*(8), *date*(1)"
msgstr "*adjtime_config*(5), *hwclock*(8), *date*(1)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "setarch(8)"
msgstr "setarch(8)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "setarch - change reported architecture in new program environment and/or set personality flags"
msgstr "setarch - ändra rapporterad arkitektur i ny programmiljö och/eller sätt personlighetsflaggor"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*setarch* [_arch_] [options] [_program_ [_argument_...]]"
msgstr "*setarch* [_arch_] [flaggor] [_program_ [_argument_...]]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*setarch* *--list*|*-h*|*-V*"
msgstr "*setarch* *--lista*|*-h*|*-V*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*arch* [options] [_program_ [_argument_...]]"
msgstr "*arch* [flaggor] [_program_ [_argument_...]]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*setarch* modifies execution domains and process personality flags."
msgstr "*setarch* ändrar exekveringsdomäner och processpersonlighetsflaggor."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The execution domains currently only affects the output of *uname -m*. For example, on an AMD64 system, running *setarch i386* _program_ will cause _program_ to see i686 instead of _x86_64_ as the machine type. It can also be used to set various personality options. The default _program_ is */bin/sh*."
msgstr "Exekveringsdomänerna påverkar för närvarande endast utdata från *uname -m*. Om du t.ex. kör *setarch i386* _program_ på ett AMD64-system kommer _program_ att se i686 i stället för _x86_64_ som maskintyp. Det kan också användas för att ställa in olika personlighetsflaggor. Standardinställningen för _program_ är */bin/sh*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Since version 2.33 the _arch_ command line argument is optional and *setarch* may be used to change personality flags (ADDR_LIMIT_*, SHORT_INODE, etc) without modification of the execution domain."
msgstr "Sedan version 2.33 är kommandoradsargumentet _arch_ valfritt och *setarch* kan användas för att ändra personlighetsflaggor (ADDR_LIMIT_*, SHORT_INODE, etc) utan att ändra exekveringsdomänen."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--list*"
msgstr "*--list*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "List the architectures that *setarch* knows about. Whether *setarch* can actually set each of these architectures depends on the running kernel."
msgstr "Lista de arkitekturer som *setarch* känner till. Huruvida *setarch* faktiskt kan ställa in var och en av dessa arkitekturer beror på den körande kärnan."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--show[=personality]*"
msgstr "*--show[=personality]*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Show the currently active personality and flags.  If the *personality* argument is provided, it is shown instead of the current one.  *personality* is a hexadecimal number with values was described in *sys/personality.h*."
msgstr "Visar den aktuella aktiva personligheten och flaggorna.  Om argumentet *personality* anges visas det i stället för den aktuella personligheten.  *personality* är ett hexadecimalt tal med värden som beskrivs i *sys/personality.h*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--uname-2.6*"
msgstr "*--uname-2.6*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Causes the _program_ to see a kernel version number beginning with 2.6. Turns on *UNAME26*."
msgstr "Gör att _programmet_ ser ett kärnversionsnummer som börjar med 2.6. Aktiverar *UNAME26*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-3*, *--3gb*"
msgstr "*-3*, *--3gb*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Specifies _program_ should use a maximum of 3GB of address space. Supported on x86. Turns on *ADDR_LIMIT_3GB*."
msgstr "Anger att _program_ ska använda maximalt 3 GB adressutrymme. Stöds på x86. Aktiverar *ADDR_LIMIT_3GB*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--4gb*"
msgstr "*--4gb*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "This option has no effect. It is retained for backward compatibility only, and may be removed in future releases."
msgstr "Denna flagga har ingen effekt. Det behålls endast för bakåtkompatibilitet och kan komma att tas bort i framtida versioner."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-B*, *--32bit*"
msgstr "*-B*, *--32bit*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Limit the address space to 32 bits to emulate hardware. Supported on ARM and Alpha. Turns on *ADDR_LIMIT_32BIT*."
msgstr "Begränsa adressrymden till 32 bitar för att emulera hårdvara. Stöds av ARM och Alpha. Slår på *ADDR_LIMIT_32BIT*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-F*, *--fdpic-funcptrs*"
msgstr "*-F*, *--fdpic-funcptrs*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Treat user-space function pointers to signal handlers as pointers to address descriptors. This option has no effect on architectures that do not support *FDPIC* ELF binaries. In kernel v4.14 support is limited to ARM, Blackfin, Fujitsu FR-V, and SuperH CPU architectures."
msgstr "Behandla funktionspekare till signalhanterare i användarrymden som pekare till adressdeskriptorer. Denna flagga har ingen effekt på arkitekturer som inte stöder *FDPIC* ELF-binärfiler. I kärnan v4.14 är stödet begränsat till ARM-, Blackfin-, Fujitsu FR-V- och SuperH-processorarkitekturer."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-I*, *--short-inode*"
msgstr "*-I*, *--short-inode*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Obsolete bug emulation flag. Turns on *SHORT_INODE*."
msgstr "Föråldrad flagga för felemulering. Slår på *SHORT_INODE*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-L*, *--addr-compat-layout*"
msgstr "*-L*, *--addr-compat-layout*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Provide legacy virtual address space layout. Use when the _program_ binary does not have *PT_GNU_STACK* ELF header. Turns on *ADDR_COMPAT_LAYOUT*."
msgstr "Tillhandahåller layout för äldre virtuellt adressutrymme. Används när _program_ binärfilen inte har *PT_GNU_STACK* ELF-huvud. Slår på *ADDR_COMPAT_LAYOUT*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-R*, *--addr-no-randomize*"
msgstr "*-R*, *--addr-no-randomize*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Disables randomization of the virtual address space. Turns on *ADDR_NO_RANDOMIZE*."
msgstr "Inaktiverar randomisering av det virtuella adressutrymmet. Aktiverar *ADDR_NO_RANDOMIZE*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-S*, *--whole-seconds*"
msgstr "*-S*, *--whole-seconds*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Obsolete bug emulation flag. Turns on *WHOLE_SECONDS*."
msgstr "Föråldrad flagga för felemulering. Slår på *WHOLE_SECONDS*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-T*, *--sticky-timeouts*"
msgstr "*-T*, *--sticky-timeouts*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "This makes *select*(2), *pselect*(2), and *ppoll*(2) system calls preserve the timeout value instead of modifying it to reflect the amount of time not slept when interrupted by a signal handler. Use when _program_ depends on this behavior. For more details see the timeout description in *select*(2) manual page. Turns on *STICKY_TIMEOUTS*."
msgstr "Detta gör att systemanropen *select*(2), *pselect*(2) och *ppoll*(2) behåller timeout-värdet istället för att ändra det för att återspegla den tid som inte sovits när de avbryts av en signalhanterare. Används när _program_ är beroende av detta beteende. Mer information finns i beskrivningen av timeout på manualsidan för *select*(2). Slår på *STICKY_TIMEOUTS*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-X*, *--read-implies-exec*"
msgstr "*-X*, *--read-implies-exec*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "If this is set then *mmap*(2) *PROT_READ* will also add the *PROT_EXEC* bit - as expected by legacy x86 binaries. Notice that the ELF loader will automatically set this bit when it encounters a legacy binary. Turns on *READ_IMPLIES_EXEC*."
msgstr "Om detta är inställt kommer *mmap*(2) *PROT_READ* också att lägga till *PROT_EXEC*-biten - vilket förväntas av äldre x86-binärfiler. Observera att ELF-laddaren automatiskt kommer att sätta denna bit när den stöter på en äldre binärfil. Slår på *READ_IMPLIES_EXEC*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-Z*, *--mmap-page-zero*"
msgstr "*-Z*, *--mmap-page-zero*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "SVr4 bug emulation that will set *mmap*(2) page zero as read-only. Use when _program_ depends on this behavior, and the source code is not available to be fixed. Turns on *MMAP_PAGE_ZERO*."
msgstr "SVr4-buggemulering som sätter *mmap*(2)-sidan noll som skrivskyddad. Används när _program_ är beroende av detta beteende och källkoden inte är tillgänglig för att åtgärdas. Slår på *MMAP_PAGE_ZERO*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "setarch --addr-no-randomize mytestprog\nsetarch ppc32 rpmbuild --target=ppc --rebuild foo.src.rpm\nsetarch ppc32 -v -vL3 rpmbuild --target=ppc --rebuild bar.src.rpm\nsetarch ppc32 --32bit rpmbuild --target=ppc --rebuild foo.src.rpm\n"
msgstr "setarch --addr-no-randomize mytestprog\nsetarch ppc32 rpmbuild --target=ppc --rebuild foo.src.rpm\nsetarch ppc32 -v -vL3 rpmbuild --target=ppc --rebuild bar.src.rpm\nsetarch ppc32 --32bit rpmbuild --target=ppc --rebuild foo.src.rpm\n"

#. from tp:util-linux-man-2.41.2-rc1
msgid "mailto:sopwith@redhat.com[Elliot Lee], mailto:jnovy@redhat.com[Jindrich Novy], mailto:kzak@redhat.com[Karel Zak]"
msgstr "mailto:sopwith@redhat.com[Elliot Lee], mailto:jnovy@redhat.com[Jindrich Novy], mailto:kzak@redhat.com[Karel Zak]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*personality*(2), *select*(2)"
msgstr "*personlighet*(2), *välja*(2)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "setpgid(1)"
msgstr "setpgid(1)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "setpgid - run a program in a new process group"
msgstr "setpgid - kör ett program i en ny processgrupp"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*setpgid* [options] _program_ [_arguments_]"
msgstr "*setpgid* [flaggor] _program_ [_argument_]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*setpgid* runs a program in a new process group."
msgstr "*setpgid* kör ett program i en ny processgrupp."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-f*, *--foreground*"
msgstr "*-f*, *--foreground*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Make the new process group the foreground process group of the controlling terminal if there is a controlling terminal."
msgstr "Gör den nya processgruppen till den kontrollerande terminalens förgrundsprocessgrupp om det finns en kontrollerande terminal."

#. from tp:util-linux-man-2.41.2-rc1
msgid "mailto:daan.j.demeyer@gmail.com[Daan De Meyer]"
msgstr "mailto:daan.j.demeyer@gmail.com[Daan De Meyer]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*setpgid*(2)"
msgstr "*setpgid*(2)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "setpriv(1)"
msgstr "setpriv(1)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "setpriv - run a program with different Linux privilege settings"
msgstr "setpriv - kör ett program med olika inställningar för Linux-privilegier"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*setpriv* [options] _program_ [_arguments_]"
msgstr "*setpriv* [flaggor] _program_ [_argument_]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Sets or queries various Linux privilege settings that are inherited across *execve*(2)."
msgstr "Ställer in eller frågar efter olika Linux-privilegieinställningar som ärvs av *execve*(2)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "In comparison to *su*(1) and *runuser*(1), *setpriv* neither uses PAM, nor does it prompt for a password. It is a simple, non-set-user-ID wrapper around *execve*(2), and can be used to drop privileges in the same way as *setuidgid*(8) from *daemontools*, *chpst*(8) from *runit*, or similar tools shipped by other service managers."
msgstr "I jämförelse med *su*(1) och *runuser*(1) använder *setpriv* varken PAM eller frågar efter lösenord. Det är en enkel, icke-set-user-ID-omslag runt *execve*(2), och kan användas för att släppa privilegier på samma sätt som *setuidgid*(8) från *daemontools*, *chpst*(8) från *runit*, eller liknande verktyg som levereras av andra tjänstehanterare."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--clear-groups*"
msgstr "*--clear-groups*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Clear supplementary groups."
msgstr "Tydliga tilläggsgrupper."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-d*, *--dump*"
msgstr "*-d*, *--dump*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Dump the current privilege state. This option can be specified more than once to show extra, mostly useless, information. Incompatible with all other options."
msgstr "Dumpa det aktuella privilegietillståndet. Denna flagga kan anges mer än en gång för att visa extra, oftast värdelös, information. Inkompatibelt med alla andra flaggor."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--groups* _group_..."
msgstr "*--groups* _grupp_..."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Set supplementary groups. The argument is a comma-separated list of GIDs or names."
msgstr "Ange kompletterande grupper. Argumentet är en kommaseparerad lista med GID eller namn."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--inh-caps* (*+*|*-*)_cap_..."
msgstr "*--inh-caps* (*+*|*-*)_cap_..."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--ambient-caps* (*+*|*-*)_cap_..."
msgstr "*--ambient-caps* (*+*|*-*)_cap_..."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--bounding-set* (*+*|*-*)_cap_..."
msgstr "*--bounding-set* (*+*|*-*)_cap_..."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Set the inheritable capabilities, ambient capabilities or the capability bounding set. See *capabilities*(7). The argument is a comma-separated list of **+**__cap__ and **-**__cap__ entries, which add or remove an entry respectively. _cap_ can either be a human-readable name as seen in *capabilities*(7) without the _cap__ prefix or of the format *cap_N*, where _N_ is the internal capability index used by Linux. *+all* and *-all* can be used to add or remove all caps."
msgstr "Ställ in de ärftliga kapaciteterna, omgivande kapaciteter eller kapacitetens avgränsande uppsättning. Se *capabilities*(7). Argumentet är en kommaseparerad lista med **+**__cap__- och **-**__cap__-poster, som lägger till respektive tar bort en post. _cap_ kan antingen vara ett mänskligt läsbart namn som i *capabilities*(7) utan prefixet _cap__ eller i formatet *cap_N*, där _N_ är det interna kapacitetsindex som används av Linux. *+all* och *-all* kan användas för att lägga till eller ta bort alla versaler."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The set of capabilities starts out as the current inheritable set for *--inh-caps*, the current ambient set for *--ambient-caps* and the current bounding set for *--bounding-set*."
msgstr "Uppsättningen av funktioner börjar som den aktuella ärftliga uppsättningen för *--inh-caps*, den aktuella omgivande uppsättningen för *--ambient-caps* och den aktuella avgränsande uppsättningen för *--bounding-set*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Note the following restrictions (detailed in *capabilities*(7)) regarding modifications to these capability sets:"
msgstr "Observera följande restriktioner (som beskrivs i *capabilities*(7)) beträffande modifieringar av dessa kapacitetsuppsättningar:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "A capability can be added to the inheritable set only if it is currently present in the bounding set."
msgstr "En förmåga kan endast läggas till i den ärftliga uppsättningen om den för närvarande finns i den avgränsande uppsättningen."

#. from tp:util-linux-man-2.41.2-rc1
msgid "A capability can be added to the ambient set only if it is currently present in both the permitted and inheritable sets."
msgstr "En förmåga kan endast läggas till i den omgivande uppsättningen om den för närvarande finns i både den tillåtna och den ärftliga uppsättningen."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Notwithstanding the syntax offered by *setpriv*, the kernel does not permit capabilities to be added to the bounding set."
msgstr "Trots den syntax som erbjuds av *setpriv* tillåter inte kärnan att förmågor läggs till i den avgränsande uppsättningen."

#. from tp:util-linux-man-2.41.2-rc1
msgid "If you drop a capability from the bounding set without also dropping it from the inheritable set, you are likely to become confused. Do not do that."
msgstr "Om du tar bort en kapacitet från den avgränsande uppsättningen utan att samtidigt ta bort den från den ärftliga uppsättningen, kommer du sannolikt att bli förvirrad. Gör inte så."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--keep-groups*"
msgstr "*--keep-groups*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Preserve supplementary groups. Only useful in conjunction with *--rgid*, *--egid*, or *--regid*."
msgstr "Bevara kompletterande grupper. Används endast i kombination med *--rgid*, *--egid* eller *--regid*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--init-groups*"
msgstr "*--init-groups*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Initialize supplementary groups using initgroups3. Only useful in conjunction with *--ruid* or *--reuid*."
msgstr "Initiera tilläggsgrupper med hjälp av initgroups3. Endast användbar i samband med *--ruid* eller *--reuid*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--list-caps*"
msgstr "*--list-caps*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "List all known capabilities. This option must be specified alone."
msgstr "Lista alla kända funktioner. Denna flagga måste anges ensamt."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--no-new-privs*"
msgstr "*--no-new-privs*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Set the _no_new_privs_ bit. With this bit set, *execve*(2) will not grant new privileges. For example, the set-user-ID and set-group-ID bits as well as file capabilities will be disabled. (Executing binaries with these bits set will still work, but they will not gain privileges. Certain LSMs, especially AppArmor, may result in failures to execute certain programs.) This bit is inherited by child processes and cannot be unset. See *prctl*(2) and _Documentation/prctl/no_new_privs.txt_ in the Linux kernel source."
msgstr "Ställ in biten _no_new_privs_. Om den här biten är aktiverad kommer *execve*(2) inte att bevilja nya privilegier. Exempelvis kommer bitarna set-user-ID och set-group-ID samt filfunktioner att inaktiveras. (Exekvering av binärfiler med dessa bitar aktiverade kommer fortfarande att fungera, men de kommer inte att få några privilegier. Vissa LSM:er, särskilt AppArmor, kan leda till att vissa program inte kan köras) Denna bit ärvs av underordnade processer och kan inte inaktiveras. Se *prctl*(2) och _Documentation/prctl/no_new_privs.txt_ i Linux-kärnans källkod."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The _no_new_privs_ bit is supported since Linux 3.5."
msgstr "Biten _no_new_privs_ stöds sedan Linux 3.5."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--rgid* _gid_, *--egid* _gid_, *--regid* _gid_"
msgstr "*--rgid* _gid_, *--egid* _gid_, *--regid* _gid_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Set the real, effective, or both GIDs. The _gid_ argument can be given as a textual group name."
msgstr "Ange det verkliga, det effektiva eller båda GID:en. Argumentet _gid_ kan anges som ett gruppnamn i textform."

#. from tp:util-linux-man-2.41.2-rc1
msgid "For safety, you must specify one of *--clear-groups*, *--groups*, *--keep-groups*, or *--init-groups* if you set any primary _gid_."
msgstr "För säkerhets skull måste du ange något av *--clear-groups*, *--groups*, *--keep-groups* eller *--init-groups* om du anger någon primär _gid_."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--ruid* _uid_, *--euid* _uid_, *--reuid* _uid_"
msgstr "*--ruid* _uid_, *--euid* _uid_, *--reuid* _uid_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Set the real, effective, or both UIDs. The _uid_ argument can be given as a textual login name."
msgstr "Ange det verkliga, det effektiva eller båda UID:erna. Argumentet _uid_ kan anges som ett inloggningsnamn i textform."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Setting a _uid_ or _gid_ does not change capabilities, although the exec call at the end might change capabilities. This means that, if you are root, you probably want to do something like:"
msgstr "Att ställa in en _uid_ eller _gid_ ändrar inte kapaciteten, även om exec-anropet i slutet kan ändra kapaciteten. Det innebär att om du är root vill du förmodligen göra något i stil med:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*setpriv --reuid=1000 --regid=1000 --inh-caps=-all*"
msgstr "*setpriv --reuid=1000 --regid=1000 --inh-caps=-all*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--securebits* (**+**|*-*)__securebit__..."
msgstr "*--securebits* (**+**|*-*)__securebit__..."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Set or clear securebits. The argument is a comma-separated list. The valid securebits are _noroot_, _noroot_locked_, _no_setuid_fixup_, _no_setuid_fixup_locked_, and _keep_caps_locked_. _keep_caps_ is cleared by *execve*(2) and is therefore not allowed."
msgstr "Ställ in eller rensa securebits. Argumentet är en kommaseparerad lista. De giltiga securebits är _noroot_, _noroot_locked_, _no_setuid_fixup_, _no_setuid_fixup_locked_ och _keep_caps_locked_. _keep_caps_ rensas av *execve*(2) och är därför inte tillåtet."

#. from tp:util-linux-man-2.41.2-rc1
msgid "**--pdeathsig keep**|**clear**|*<signal>*"
msgstr "**--pdeathsig keep**|**clear**|*<signal>*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Keep, clear or set the parent death signal. Some LSMs, most notably SELinux and AppArmor, clear the signal when the process' credentials change. Using *--pdeathsig keep* will restore the parent death signal after changing credentials to remedy that situation."
msgstr "Behåll, rensa eller ställ in den överordnade processens dödssignal. Vissa LSM:er, framför allt SELinux och AppArmor, rensar signalen när processens autentiseringsuppgifter ändras. Om du använder *--pdeathsig keep* återställs den överordnade dödssignalen efter att autentiseringsuppgifterna har ändrats för att åtgärda den situationen."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--ptracer* _pid_|**any**|**none**"
msgstr "*--ptracer* _pid_|**any**|**none**"

#. from tp:util-linux-man-2.41.2-rc1
msgid "When Yama's restricted ptrace mode is in effect (that is, when _/proc/sys/kernel/yama/ptrace_scope_ is set to 1), allow being traced via **ptrace**(2) by the process with the specified PID, or any process, or no process. See **PR_SET_PTRACER**(2const). (Note that this is not inherited by child processes, though it is preserved across **execve**(2).) This option has no effect when Yama is not enabled or is in a mode other than restricted ptrace."
msgstr "När Yamas begränsade ptrace-läge är i kraft (det vill säga när _/proc/sys/kernel/yama/ptrace_scope_ är satt till 1), tillåt att spåras via **ptrace**(2) av processen med den angivna PID:n, eller någon process, eller ingen process. Se **PR_SET_PTRACER**(2const). (Observera att detta inte ärvs av underordnade processer, även om det bevaras över **execve**(2)) Denna flagga har ingen effekt när Yama inte är aktiverat eller är i ett annat läge än restricted ptrace."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--selinux-label* _label_"
msgstr "*--selinux-label* _etikett_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Request a particular SELinux transition (using a transition on exec, not dyntrans). This will fail and cause *setpriv* to abort if SELinux is not in use, and the transition may be ignored or cause *execve*(2) to fail at SELinux's whim. (In particular, this is unlikely to work in conjunction with _no_new_privs_.) This is similar to *runcon*(1)."
msgstr "Begär en viss SELinux-övergång (använder en övergång på exec, inte dyntrans). Detta kommer att misslyckas och leda till att *setpriv* avbryts om SELinux inte används, och övergången kan ignoreras eller leda till att *execve*(2) misslyckas om SELinux så önskar. (I synnerhet är det osannolikt att detta fungerar tillsammans med _no_new_privs_.) Detta liknar *runcon*(1)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--apparmor-profile* _profile_"
msgstr "*--apparmor-profile* _profile_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Request a particular AppArmor profile (using a transition on exec). This will fail and cause *setpriv* to abort if AppArmor is not in use, and the transition may be ignored or cause *execve*(2) to fail at AppArmor's whim."
msgstr "Begär en viss AppArmor-profil (med hjälp av en övergång på exec). Detta kommer att misslyckas och leda till att *setpriv* avbryts om AppArmor inte används, och övergången kan ignoreras eller leda till att *execve*(2) misslyckas om AppArmor så önskar."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--landlock-access* _access_"
msgstr "*--landlock-access* _access_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Enable landlock restrictions for a specific set of system accesses.  To allow specific subgroups of accesses use *--landlock-rule*."
msgstr "Aktivera landlock-begränsningar för en viss uppsättning systemåtkomster.  För att tillåta specifika undergrupper av åtkomster använd *--landlock-rule*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Block all filesystem access:"
msgstr "Blockera all åtkomst till filsystemet:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*setpriv --landlock-access fs*"
msgstr "*setpriv --landlock-åtkomst fs*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Block all file deletions and directory creations:"
msgstr "Blockera all radering av filer och skapande av kataloger:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*setpriv --landlock-access fs:remove-file,make-dir*"
msgstr "*setpriv --landlock-åtkomst fs:remove-file,make-dir*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "For a complete set of supported access categories use *setpriv --help*."
msgstr "För en fullständig uppsättning av åtkomstkategorier som stöds, använd *setpriv --help*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--landlock-rule* _rule_"
msgstr "*--landlock-rule* _rule_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Allow one specific access from the categories blocked by *--landlock-access*."
msgstr "Tillåt en specifik åtkomst från de kategorier som blockeras av *--landlock-access*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The syntax is as follows:"
msgstr "Syntaxen är som följer:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--landlock-rule $ruletype:$access:$rulearg*"
msgstr "*--landlock-rule $ruletype:$access:$rulearg*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "For example grant file read access to everything under */boot*:"
msgstr "Ge t.ex. läsåtkomst till allt under */boot*:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--landlock-rule path-beneath:read-file:/boot*"
msgstr "*--landlock-rule path-beneath:read-file:/boot*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--seccomp-filter* _file_"
msgstr "*--seccomp-filter* _fil_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Load raw BPF seccomp filter code from a file."
msgstr "Ladda rå BPF seccomp filterkod från en fil."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Filters can for example be created with *enosys*."
msgstr "Filter kan t.ex. skapas med *enosys*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--reset-env*"
msgstr "*--reset-env*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Clears all the environment variables except *TERM*; initializes the environment variables *HOME*, *SHELL*, *USER*, *LOGNAME* according to the user's passwd entry; sets *PATH* to _/usr/local/bin:/bin:/usr/bin_ for a regular user and to _/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin_ for root."
msgstr "Rensar alla miljövariabler utom *TERM*; initierar miljövariablerna *HOME*, *SHELL*, *USER*, *LOGNAME* enligt användarens passwd-post; sätter *PATH* till _/usr/local/bin:/bin:/usr/bin_ för en vanlig användare och till _/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin:/usr/bin_ för root."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The environment variable *PATH* may be different on systems where _/bin_ and _/sbin_ are merged into _/usr_. The environment variable *SHELL* defaults to */bin/sh* if none is given in the user's passwd entry."
msgstr "Miljövariabeln *PATH* kan vara annorlunda på system där _/bin_ och _/sbin_ är sammanslagna till _/usr_. Miljövariabeln *SHELL* är som standard */bin/sh* om ingen sådan anges i användarens passwd-post."

#. from tp:util-linux-man-2.41.2-rc1
msgid "If applying any specified option fails, _program_ will not be run and *setpriv* will return with exit status 127."
msgstr "Om tillämpningen av någon av de angivna flaggorna misslyckas kommer _program_ inte att köras och *setpriv* kommer att returneras med utgångsstatus 127."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Be careful with this tool -- it may have unexpected security consequences. For example, setting _no_new_privs_ and then execing a program that is SELinux-confined (as this tool would do) may prevent the SELinux restrictions from taking effect."
msgstr "Var försiktig med det här verktyget - det kan få oväntade konsekvenser för säkerheten. Om du till exempel ställer in _no_new_privs_ och sedan kör ett program som är SELinux-begränsat (som det här verktyget skulle göra) kan det hända att SELinux-begränsningarna inte träder i kraft."

#. from tp:util-linux-man-2.41.2-rc1
msgid "If you're looking for behavior similar to *su*(1)/*runuser*(1), or *sudo*(8) (without the *-g* option), try something like:"
msgstr "Om du vill ha ett beteende som liknar *su*(1)/*runuser*(1) eller *sudo*(8) (utan flaggan *-g*) kan du prova något liknande:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*setpriv --reuid=1000 --regid=1000 --init-groups*"
msgstr "*setpriv --reuid=1000 --regid=1000 --init-groups*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "If you want to mimic daemontools' *setuid*(8), try:"
msgstr "Om du vill efterlikna daemontools *setuid*(8) kan du prova:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*setpriv --reuid=1000 --regid=1000 --clear-groups*"
msgstr "*setpriv --reuid=1000 --regid=1000 --clear-groups*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "mailto:luto@amacapital.net[Andy Lutomirski]"
msgstr "mailto:luto@amacapital.net[Andy Lutomirski]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*runuser*(1), *su*(1), *prctl*(2), *capabilities*(7)  *landlock*(7)"
msgstr "*runuser*(1), *su*(1), *prctl*(2), *capabilities*(7) *landlock*(7)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "setsid(1)"
msgstr "setsid(1)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "setsid - run a program in a new session"
msgstr "setsid - kör ett program i en ny session"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*setsid* [options] _program_ [_arguments_]"
msgstr "*setsid* [flaggor] _program_ [_argument_]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*setsid* runs a program in a new session. The command calls *fork*(2) if already a process group leader. Otherwise, it executes a program in the current process. This default behavior is possible to override by the *--fork* option."
msgstr "*setsid* kör ett program i en ny session. Kommandot anropar *fork*(2) om det redan är en processgruppledare. Annars körs ett program i den aktuella processen. Detta standardbeteende är möjligt att åsidosätta med flaggan *--fork*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-c*, *--ctty*"
msgstr "*-c*, *--ctty*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Set the controlling terminal to the current one."
msgstr "Ställ in den styrande terminalen till den aktuella."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-f*, *--fork*"
msgstr "*-f*, *--fork*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Always create a new process."
msgstr "Skapa alltid en ny process."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-w*, *--wait*"
msgstr "*-w*, *--wait*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Wait for the execution of the program to end, and return the exit status of this program as the exit status of *setsid*."
msgstr "Vänta på att programmet ska avslutas och returnera programmets utgångsstatus som utgångsstatus för *setsid*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "mailto:jrs@world.std.com[Rick Sladkey]"
msgstr "mailto:jrs@world.std.com[Rick Sladkey]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*setsid*(2)"
msgstr "*setid*(2)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "swapon(8)"
msgstr "swapon(8)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "swapon, swapoff - enable/disable devices and files for paging and swapping"
msgstr "swapon, swapoff - aktivera/inaktivera enheter och filer för paging och växling"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*swapon* [options] [_specialfile_...]"
msgstr "*swapon* [flaggor] [_specialfil_...]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*swapoff* [*-va*] [_specialfile_...]"
msgstr "*swapoff* [*-va*] [_specialfil_...]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*swapon* is used to specify devices on which paging and swapping are to take place."
msgstr "*swapon* används för att ange enheter på vilka paging och swapping ska ske."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The device or file used is given by the _specialfile_ parameter. It may be of the form *-L* _label_ or *-U* _uuid_ to indicate a device by label or uuid."
msgstr "Den enhet eller fil som används anges av parametern _specialfile_. Den kan vara av formen *-L* _etikett_ eller *-U* _uuid_ för att ange en enhet med label eller uuid."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Calls to *swapon* normally occur in the system boot scripts making all swap devices available, so that the paging and swapping activity is interleaved across several devices and files."
msgstr "Anrop till *swapon* sker normalt i systemets startskript som gör alla swap-enheter tillgängliga, så att paging- och swapping-aktiviteten fördelas över flera enheter och filer."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*swapoff* disables swapping on the specified devices and files. When the *-a* flag is given, swapping is disabled on all known swap devices and files (as found in _/proc/swaps_ or _/etc/fstab_)."
msgstr "*swapoff* inaktiverar swapping på de angivna enheterna och filerna. När flaggan *-a* anges inaktiveras swapping på alla kända swap-enheter och -filer (som finns i _/proc/swaps_ eller _/etc/fstab_)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "All devices marked as \"swap\" in _/etc/fstab_ are made available, except for those with the \"noauto\" option. Devices that are already being used as swap are silently skipped."
msgstr "Alla enheter som är markerade som \"swap\" i _/etc/fstab_ görs tillgängliga, utom de som har flaggan \"noauto\". Enheter som redan används som swap hoppas över i tysthet."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Specifies an alternative fstab file for compatibility with *mount*(8). If _path_ is a directory, then the files in the directory are sorted by *strverscmp*(3); files that start with \".\" or without an .fstab extension are ignored. The option can be specified more than once. This option is mostly designed for initramfs or chroot scripts where additional configuration is specified beyond standard system configuration."
msgstr "Anger en alternativ fstab-fil för kompatibilitet med *mount*(8). Om _sökväg_ är en katalog sorteras filerna i katalogen enligt *strverscmp*(3); filer som börjar med \".\" eller som saknar .fstab-tillägg ignoreras. Flaggan kan anges mer än en gång. Den här flaggan är främst avsett för initramfs- eller chroot-skript där ytterligare konfiguration anges utöver standardkonfigurationen för systemet."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-d*, *--discard*[**=**__policy__]"
msgstr "*-d*, *--discard*[**=**__policy__]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Enable swap discards, if the swap backing device supports the discard or trim operation. This may improve performance on some Solid State Devices, but often it does not. The option allows one to select between two available swap discard policies:"
msgstr "Aktivera swap discards, om swap backing-enheten stöder discard- eller trim-operationen. Detta kan förbättra prestanda på vissa Solid State-enheter, men ofta gör det inte det. Flaggan gör det möjligt att välja mellan två tillgängliga policyer för swap discard:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--discard=once*"
msgstr "*--discard=once*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "to perform a single-time discard operation for the whole swap area at swapon; or"
msgstr "för att utföra en engångskastning för hela växlingsområdet vid swapon; eller"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--discard=pages*"
msgstr "*--discard=pages*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "to asynchronously discard freed swap pages before they are available for reuse."
msgstr "för att asynkront kasta bort frigjorda växlingssidor innan de är tillgängliga för återanvändning."

#. from tp:util-linux-man-2.41.2-rc1
msgid "If no policy is selected, the default behavior is to enable both discard types. The _/etc/fstab_ mount options *discard*, *discard=once*, or *discard=pages* may also be used to enable discard flags."
msgstr "Om ingen policy har valts är standardbeteendet att aktivera båda diskningstyperna. Monteringsflaggorna _/etc/fstab_ *discard*, *discard=once* eller *discard=pages* kan också användas för att aktivera discard-flaggor."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-e*, *--ifexists*"
msgstr "*-e*, *--ifexists*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Silently skip devices that do not exist. The _/etc/fstab_ mount option *nofail* may also be used to skip non-existing device."
msgstr "Hoppa tyst över enheter som inte finns. Monteringsflaggan *nofail* i _/etc/fstab_ kan också användas för att hoppa över icke-existerande enheter."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-f*, *--fixpgsz*"
msgstr "*-f*, *--fixpgsz*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Reinitialize (exec mkswap) the swap space if its page size does not match that of the current running kernel. *mkswap*(8) initializes the whole device and does not check for bad blocks."
msgstr "Återinitialisera (exekvera mkswap) swaputrymmet om dess sidstorlek inte matchar den för den aktuella kärnan. *mkswap*(8) initierar hela enheten och kontrollerar inte om det finns dåliga block."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-L* _label_"
msgstr "*-L* _etikett_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Use the partition that has the specified _label_. (For this, access to _/proc/partitions_ is needed.)"
msgstr "Använd den partition som har den angivna _etikett_. (För detta krävs åtkomst till _/proc/partitions_.)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Specify swap options by an __fstab__-compatible comma-separated string. For example:"
msgstr "Ange växlingsflaggor med en kommaseparerad sträng som är kompatibel med __fstab__. Till exempel:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*swapon -o pri=1,discard=pages,nofail /dev/sda2*"
msgstr "*swapon -o pri=1,discard=pages,nofail /dev/sda2*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "The _opts_ string is evaluated last and overrides all other command line options."
msgstr "Strängen _opts_ utvärderas sist och åsidosätter alla andra kommandoradsflaggor."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Specify the priority of the swap device. _priority_ is a value between 0 and 32767. Higher numbers indicate higher priority. See *swapon*(2) for a full description of swap priorities. Add **pri=**__value__ to the option field of _/etc/fstab_ for use with *swapon -a*. When no priority is defined, Linux kernel defaults to negative numbers."
msgstr "Ange prioriteten för växlingsenheten. _priority_ är ett värde mellan 0 och 32767. Högre siffror anger högre prioritet. Se *swapon*(2) för en fullständig beskrivning av växlingsprioriteter. Lägg till **pri=**__värde__ i flaggfältet i _/etc/fstab_ för användning med *swapon -a*. När ingen prioritet är definierad använder Linux-kärnan negativa tal som standard."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-s*, *--summary*"
msgstr "*-s*, *--summary*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Display swap usage summary by device. Equivalent to *cat /proc/swaps*. This output format is DEPRECATED in favour of *--show* that provides better control on output data."
msgstr "Visa en sammanfattning av växlingsanvändningen per enhet. Motsvarar *cat /proc/swaps*. Detta utdataformat är FÖRÅLDRAT till förmån för *--show* som ger bättre kontroll över utdata."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--show*[**=**__column__...]"
msgstr "*--show*[**=**__column__...]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Display a definable table of swap areas. See the *--help* output for a list of available columns."
msgstr "Visar en definierbar tabell över växlingsområden. Se *--help* för en lista över tillgängliga kolumner."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Do not print headings when displaying *--show* output."
msgstr "Skriv inte ut rubriker när du visar *--show*-utdata."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Display *--show* output without aligning table columns."
msgstr "Visa *--visa* utdata utan att justera tabellkolumnerna."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--bytes*"
msgstr "*--bytes*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Display swap size in bytes in *--show* output instead of in user-friendly units."
msgstr "Visa växlingsstorlek i byte i *--show*-utdata istället för i användarvänliga enheter."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-U* _uuid_"
msgstr "*-U* _uuid_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Use the partition that has the specified _uuid_."
msgstr "Använd den partition som har den angivna _uuid_."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*swapoff* has the following exit status values since v2.36:"
msgstr "*swapoff* har följande utgångsstatusvärden sedan v2.36:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "system has insufficient memory to stop swapping (OOM)"
msgstr "systemet har inte tillräckligt med minne för att stoppa växlingen (OOM)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*swapoff*(2) syscall failed for another reason"
msgstr "*swapoff*(2) syscall misslyckades av annan anledning"

#. from tp:util-linux-man-2.41.2-rc1
msgid "non-*swapoff*(2) syscall system error (out of memory, ...)"
msgstr "non-*swapoff*(2) syscall systemfel (slut på minne, ...)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "usage or syntax error"
msgstr "användnings- eller syntaxfel"

#. from tp:util-linux-man-2.41.2-rc1
msgid "all swapoff failed on *--all*"
msgstr "alla swapoff misslyckades på *--all*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "some swapoff succeeded on *--all*"
msgstr "vissa swapoff lyckades på *--all*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "The command *swapoff --all* returns 0 (all succeeded), 32 (all failed), or 64 (some failed, some succeeded)."
msgstr "Kommandot *swapoff --all* returnerar 0 (alla lyckades), 32 (alla misslyckades) eller 64 (några misslyckades, några lyckades)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The old versions before v2.36 has no documented exit status, 0 means success in all versions."
msgstr "De gamla versionerna före v2.36 har ingen dokumenterad utgångsstatus, 0 betyder framgång i alla versioner."

#. from tp:util-linux-man-2.41.2-rc1
msgid "_/dev/sd??_"
msgstr "_/dev/sd??_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "standard paging devices"
msgstr "standardutrustning för personsökning"

#. from tp:util-linux-man-2.41.2-rc1
msgid "ascii filesystem description table"
msgstr "ascii-tabell för beskrivning av filsystem"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Files with holes"
msgstr "Filar med hål"

#. from tp:util-linux-man-2.41.2-rc1
msgid "The swap file implementation in the kernel expects to be able to write to the file directly, without the assistance of the filesystem. This is a problem on files with holes or on copy-on-write files on filesystems like Btrfs."
msgstr "Implementeringen av växlingsfilen i kärnan förväntar sig att kunna skriva till filen direkt, utan hjälp av filsystemet. Detta är ett problem på filer med hål eller på copy-on-write-filer på filsystem som Btrfs."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Commands like *cp*(1) or *truncate*(1) create files with holes. These files will be rejected by *swapon*."
msgstr "Kommandon som *cp*(1) eller *truncate*(1) skapar filer med hål. Dessa filer kommer att avvisas av *swapon*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Preallocated files created by *fallocate*(1) may be interpreted as files with holes too depending of the filesystem. Preallocated swap files are supported on XFS since Linux 4.18."
msgstr "Förallokerade filer som skapats av *fallocate*(1) kan tolkas som filer med hål beroende på filsystemet. Förallokerade växlingsfiler stöds på XFS sedan Linux 4.18."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The most portable solution to create a swap file is to use *dd*(1) and _/dev/zero_."
msgstr "Den mest portabla lösningen för att skapa en växlingsfil är att använda *dd*(1) och _/dev/zero_."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Btrfs"
msgstr "Btrfs"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Swap files on Btrfs are supported since Linux 5.0 on files with *nocow* attribute. See the *btrfs*(5) manual page for more details."
msgstr "Växlingsfiler på Btrfs stöds sedan Linux 5.0 på filer med *nocow*-attributet. Se manualsidan för *btrfs*(5) för mer information."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Since version 2.41, the command *mkswap --file* can create a new swap file with the *nocow* attribute."
msgstr "Sedan version 2.41 kan kommandot *mkswap --file* skapa en ny växlingsfil med attributet *nocow*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "NFS"
msgstr "NFS"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Swap over *NFS* may not work."
msgstr "Växling över *NFS* kanske inte fungerar."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*swapon* automatically detects and rewrites a swap space signature with old software suspend data (e.g., *S1SUSPEND*, *S2SUSPEND*, ...). The problem is that if we don't do it, then we get data corruption the next time an attempt at unsuspending is made."
msgstr "*swapon* upptäcker automatiskt och skriver om en signatur för ett swaputrymme med gamla väntelägesdata för programvara (t.ex. *S1SUSPEND*, *S2SUSPEND*, ...). Problemet är att om vi inte gör det får vi datakorruption nästa gång ett försök till unsuspending görs."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The *swapon* command appeared in 4.0BSD."
msgstr "Kommandot *swapon* dök upp i 4.0BSD."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*swapoff*(2), *swapon*(2), *fstab*(5), *init*(8), *fallocate*(1), *mkswap*(8), *mount*(8), *rc*(8)"
msgstr "*swapoff*(2), *swapon*(2), *fstab*(5), *init*(8), *fallocate*(1), *mkswap*(8), *mount*(8), *rc*(8)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "switch_root(8)"
msgstr "switch_root(8)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "switch_root - switch to another filesystem as the root of the mount tree"
msgstr "switch_root - byt till ett annat filsystem som rot i monteringsträdet"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*switch_root* [*-hV*]"
msgstr "*switch_root* [*-hV*]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*switch_root* _newroot init_ [_arg_...]"
msgstr "*switch_root* _newroot init_ [_arg_...]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*switch_root* moves already mounted _/proc_, _/dev_, _/sys_ and _/run_ to _newroot_ and makes _newroot_ the new root filesystem and starts _init_ process."
msgstr "*switch_root* flyttar redan monterade _/proc_, _/dev_, _/sys_ och _/run_ till _newroot_ och gör _newroot_ till det nya rotfilsystemet och startar _init_-processen."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*WARNING: switch_root removes recursively all files and directories on the current root filesystem.*"
msgstr "*VARNING: switch_root tar rekursivt bort alla filer och kataloger på det aktuella rotfilsystemet.*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*switch_root* returns 1 on failure, it never returns on success."
msgstr "*switch_root* returnerar 1 vid misslyckande, den returnerar aldrig vid framgång."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*switch_root* will fail to function if _newroot_ is not the root of a mount. If you want to switch root into a directory that does not meet this requirement then you can first use a bind-mounting trick to turn any directory into a mount point:"
msgstr "*switch_root* kommer inte att fungera om _newroot_ inte är roten till en montering. Om du vill byta rot till en katalog som inte uppfyller det här kravet kan du först använda ett bind-mounting-trick för att göra vilken katalog som helst till en monteringspunkt:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "mount --bind $DIR $DIR\n"
msgstr "mount --bind $DIR $DIR\n"

#. from tp:util-linux-man-2.41.2-rc1
msgid "mailto:pjones@redhat.com[Peter Jones], mailto:katzj@redhat.com[Jeremy Katz], mailto:kzak@redhat.com[Karel Zak]"
msgstr "mailto:pjones@redhat.com[Peter Jones], mailto:katzj@redhat.com[Jeremy Katz], mailto:kzak@redhat.com[Karel Zak]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*chroot*(2), *init*(8), *mkinitrd*(8), *mount*(8)"
msgstr "*chroot*(2), *init*(8), *mkinitrd*(8), *mount*(8)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "tunelp(8)"
msgstr "tunelp(8)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "tunelp - set various parameters for the lp device"
msgstr "tunelp - ställ in olika parametrar för lp-enheten"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*tunelp* [options] _device_"
msgstr "*tunelp* [flaggor] _enhet_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*tunelp* sets several parameters for the /dev/lp__?__ devices, for better performance (or for any performance at all, if your printer won't work without it...) Without parameters, it tells whether the device is using interrupts, and if so, which one. With parameters, it sets the device characteristics accordingly."
msgstr "*tunelp* ställer in flera parametrar för /dev/lp__?__-enheterna, för bättre prestanda (eller för någon prestanda alls, om din skrivare inte fungerar utan den ...) Utan parametrar berättar den om enheten använder avbrott, och i så fall vilket. Med parametrar ställer den in enhetens egenskaper i enlighet med detta."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-i*, *--irq* _argument_"
msgstr "*-i*, *--irq* _argument_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "specifies the IRQ to use for the parallel port in question. If this is set to something non-zero, *-t* and *-c* have no effect. If your port does not use interrupts, this option will make printing stop. The command *tunelp -i 0* restores non-interrupt driven (polling) action, and your printer should work again. If your parallel port does support interrupts, interrupt-driven printing should be somewhat faster and efficient, and will probably be desirable."
msgstr "anger den IRQ som ska användas för parallellporten i fråga. Om detta är inställt på något annat än noll har *-t* och *-c* ingen effekt. Om din port inte använder avbrott kommer den här flaggan att stoppa utskriften. Med kommandot *tunelp -i 0* återställs den icke avbrottsdrivna (polling) funktionen och skrivaren bör fungera igen. Om din parallellport har stöd för avbrott bör avbrottsstyrd utskrift vara något snabbare och effektivare, och är förmodligen önskvärd."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*NOTE*: This option will have no effect with kernel 2.1.131 or later since the irq is handled by the parport driver. You can change the parport irq for example via _/proc/parport/*/irq_. Read _/usr/src/linux/Documentation/admin-guide/parport.rst_ for more details on parport."
msgstr "*OBS*: Denna flagga kommer inte att ha någon effekt med kärnan 2.1.131 eller senare eftersom irq hanteras av parport-drivrutinen. Du kan t.ex. ändra parports irq via _/proc/parport/*/irq_. Läs _/usr/src/linux/Documentation/admin-guide/parport.rst_ för mer information om parport."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-t*, *--time* _milliseconds_"
msgstr "*-t*, *--time* _millisekunder_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "is the amount of time in jiffies that the driver waits if the printer doesn't take a character for the number of tries dictated by the *-c* parameter. 10 is the default value. If you want fastest possible printing, and don't care about system load, you may set this to 0. If you don't care how fast your printer goes, or are printing text on a slow printer with a buffer, then 500 (5 seconds) should be fine, and will give you very low system load. This value generally should be lower for printing graphics than text, by a factor of approximately 10, for best performance."
msgstr "är den tid i jiffies som drivrutinen väntar om skrivaren inte tar emot ett tecken under det antal försök som anges i parametern *-c*. 10 är standardvärdet. Om du vill ha snabbast möjliga utskrift och inte bryr dig om systembelastningen kan du sätta värdet till 0. Om du inte bryr dig om hur snabb skrivaren är, eller skriver ut text på en långsam skrivare med buffert, bör 500 (5 sekunder) vara bra och ge dig mycket låg systembelastning. Detta värde bör i allmänhet vara lägre för utskrift av grafik än text, med en faktor på cirka 10, för bästa prestanda."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-c*, *--chars* _characters_"
msgstr "*-c*, *--chars* _characters_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "is the number of times to try to output a character to the printer before sleeping for *-t* _TIME_. It is the number of times around a loop that tries to send a character to the printer. 120 appears to be a good value for most printers in polling mode. 1000 is the default, because there are some printers that become jerky otherwise, but you _must_ set this to '1' to handle the maximal CPU efficiency if you are using interrupts. If you have a very fast printer, a value of 10 might make more sense even if in polling mode. If you have a _really_ old printer, you can increase this further."
msgstr "är antalet gånger som man försöker skicka ut ett tecken till skrivaren innan man sover i *-t* _TIME_. Det är antalet gånger runt en slinga som försöker skicka ett tecken till skrivaren. 120 verkar vara ett bra värde för de flesta skrivare i polling-läge. 1000 är standardvärdet, eftersom det finns vissa skrivare som blir ryckiga annars, men du _måste_ sätta detta till '1' för att hantera maximal CPU-effektivitet om du använder avbrott. Om du har en mycket snabb skrivare kan ett värde på 10 vara mer meningsfullt även i polling-läge. Om du har en _riktigt_ gammal skrivare kan du öka detta ytterligare."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Setting *-t* _TIME_ to 0 is equivalent to setting *-c* _CHARS_ to infinity."
msgstr "Att sätta *-t* _TIME_ till 0 motsvarar att sätta *-c* _CHARS_ till oändligheten."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-w*, *--wait* _milliseconds_"
msgstr "*-w*, *--wait* _millisekunder_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "is the number of usec we wait while playing with the strobe signal. While most printers appear to be able to deal with an extremely short strobe, some printers demand a longer one. Increasing this from the default 1 may make it possible to print with those printers. This may also make it possible to use longer cables. It's also possible to decrease this value to 0 if your printer is fast enough or your machine is slow enough."
msgstr "är antalet usec som vi väntar på medan vi leker med strobesignalen. De flesta skrivare verkar kunna hantera en extremt kort strobesignal, men vissa skrivare kräver en längre strobesignal. Om du ökar detta från standardvärdet 1 kan det bli möjligt att skriva ut med dessa skrivare. Detta kan också göra det möjligt att använda längre kablar. Det är också möjligt att minska värdet till 0 om skrivaren är tillräckligt snabb eller maskinen är tillräckligt långsam."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-a*, *--abort* _<on|off>_"
msgstr "*-a*, *--abort* _<on|off>_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "This is whether to abort on printer error - the default is not to. If you are sitting at your computer, you probably want to be able to see an error and fix it, and have the printer go on printing. On the other hand, if you aren't, you might rather that your printer spooler find out that the printer isn't ready, quit trying, and send you mail about it. The choice is yours."
msgstr "Detta är en fråga om huruvida skrivaren ska avbrytas vid fel - standardinställningen är att inte göra det. Om du sitter vid din dator vill du förmodligen kunna se ett fel och åtgärda det, så att skrivaren kan fortsätta skriva ut. Å andra sidan, om du inte gör det, kanske du hellre vill att din skrivarspooler upptäcker att skrivaren inte är klar, slutar försöka och skickar ett e-postmeddelande om det till dig. Valet är ditt."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-o*, *--check-status* _<on|off>_"
msgstr "*-o*, *--check-status* _<on|off>_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "This option is much like *-a*. It makes any *open*(2) of this device check to see that the device is on-line and not reporting any out of paper or other errors. This is the correct setting for most versions of *lpd*."
msgstr "Denna flagga är ungefär som *-a*. Det gör att alla *open*(2) för den här enheten kontrollerar att enheten är online och inte rapporterar några pappersfel eller andra fel. Detta är den korrekta inställningen för de flesta versioner av *lpd*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-C*, *--careful* _<on|off>_"
msgstr "*-C*, *--careful* _<on|off>_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "This option adds extra (\"careful\") error checking. When this option is on, the printer driver will ensure that the printer is on-line and not reporting any out of paper or other errors before sending data. This is particularly useful for printers that normally appear to accept data when turned off."
msgstr "Denna flagga ger extra (\"noggrann\") felkontroll. När den här flaggan är aktiverat kommer skrivardrivrutinen att kontrollera att skrivaren är online och inte rapporterar några pappersfel eller andra fel innan data skickas. Detta är särskilt användbart för skrivare som normalt verkar acceptera data när de är avstängda."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*NOTE*: This option is obsolete because it's the default in 2.1.131 kernel or later."
msgstr "*OBS*: Den här flaggan är föråldrat eftersom det är standard i 2.1.131 kernel eller senare."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-s*, *--status*"
msgstr "*-s*, *--status*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "This option returns the current printer status, both as a decimal number from 0..255, and as a list of active flags. When this option is specified, *-q* off, turning off the display of the current IRQ, is implied."
msgstr "Denna flagga returnerar aktuell skrivarstatus, både som ett decimaltal från 0..255 och som en lista över aktiva flaggor. När denna flagga anges är *-q* off, som stänger av visningen av aktuell IRQ, underförstått."

#. from tp:util-linux-man-2.41.2-rc1
msgid "This option resets the port. It requires a Linux kernel version of 1.1.80 or later."
msgstr "Denna flagga återställer porten. Det kräver en Linux-kärnversion på 1.1.80 eller senare."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-q*, *--print-irq* _<on|off>_"
msgstr "*-q*, *--print-irq* _<on|off>_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "This option sets printing the display of the current IRQ setting."
msgstr "Med denna flagga kan du skriva ut visningen av den aktuella IRQ-inställningen."

#. from tp:util-linux-man-2.41.2-rc1
msgid "_/dev/lp?_, _/proc/parport/*/*_"
msgstr "_/dev/lp?_, _/proc/parport/*/*_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-o*, *-C*, and *-s* all require a Linux kernel version of 1.1.76 or later."
msgstr "*-o*, *-C* och *-s* kräver alla en Linux-kärnversion på 1.1.76 eller senare."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-C* requires a Linux version prior to 2.1.131."
msgstr "*-C* requires a Linux version prior to 2.1.131."

#. from tp:util-linux-man-2.41.2-rc1
msgid "umount(8)"
msgstr "umount(8)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "umount - unmount filesystems"
msgstr "umount - avmontera filsystem"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*umount* *-a* [*-dflnrv*] [*-t* _fstype_] [*-O* _option_...]"
msgstr "*umount* *-a* [*-dflnrv*] [*-t* _fstype_] [*-O* _option_...]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*umount* [*-dflnrv*] {_directory_|_device_}"
msgstr "*umount* [*-dflnrv*] {_katalog_|_enhet_}"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*umount* *-h*|*-V*"
msgstr "*umount* *-h*|*-V*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "The *umount* command detaches the mentioned filesystem(s) from the file hierarchy. A filesystem is specified by giving the directory where it has been mounted. Giving the special device on which the filesystem lives may also work, but is obsolete, mainly because it will fail in case this device was mounted on more than one directory."
msgstr "Kommandot *umount* tar bort det eller de filsystem som anges från filhierarkin. Ett filsystem specificeras genom att ange den katalog där det har monterats. Att ange den speciella enhet som filsystemet finns på kan också fungera, men är föråldrat, främst eftersom det kommer att misslyckas om denna enhet var monterad på mer än en katalog."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Note that a filesystem cannot be unmounted when it is 'busy' - for example, when there are open files on it, or when some process has its working directory there, or when a swap file on it is in use. The offending process could even be *umount* itself - it opens libc, and libc in its turn may open for example locale files. A lazy unmount avoids this problem, but it may introduce other issues. See *--lazy* description below."
msgstr "Observera att ett filsystem inte kan avmonteras när det är \"upptaget\" - t.ex. när det finns öppna filer på det, eller när någon process har sin arbetskatalog där, eller när en växlingsfil på det används. Den felande processen kan till och med vara *umount* själv - den öppnar libc, och libc kan i sin tur öppna t.ex. locale-filer. En lazy unmount undviker detta problem, men det kan medföra andra problem. Se *--lazy*-beskrivningen nedan."

#. from tp:util-linux-man-2.41.2-rc1
msgid "All of the filesystems described in _/proc/self/mountinfo_ (or in deprecated _/etc/mtab_) are unmounted, except the proc, devfs, devpts, sysfs, rpc_pipefs and nfsd filesystems. This list of the filesystems may be replaced by *--types* umount option."
msgstr "Alla filsystem som beskrivs i _/proc/self/mountinfo_ (eller i föråldrade _/etc/mtab_) avmonteras, utom filsystemen proc, devfs, devpts, sysfs, rpc_pipefs och nfsd. Denna lista över filsystem kan ersättas med flaggan *--types* umount."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-A*, *--all-targets*"
msgstr "*-A*, *--all-targets*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Unmount all mountpoints in the current mount namespace for the specified filesystem. The filesystem can be specified by one of the mountpoints or the device name (or UUID, etc.). When this option is used together with *--recursive*, then all nested mounts within the filesystem are recursively unmounted. This option is only supported on systems where _/etc/mtab_ is a symlink to _/proc/mounts_."
msgstr "Avmontera alla mountpoints i det aktuella mount-namnrymden för det angivna filsystemet. Filsystemet kan anges med en av monteringspunkterna eller enhetsnamnet (eller UUID, etc.). När den här flaggan används tillsammans med *--recursive* avmonteras alla nästlade monteringar inom filsystemet rekursivt. Den här flaggan stöds endast på system där _/etc/mtab_ är en symbolisk länk till _/proc/mounts_."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Do not canonicalize paths. The paths canonicalization is based on *stat*(2) and *readlink*(2) system calls. These system calls may hang in some cases (for example on NFS if server is not available). The option has to be used with canonical path to the mount point."
msgstr "Kanonisera inte sökvägar. Kanoniseringen av sökvägar baseras på systemanropen *stat*(2) och *readlink*(2). Dessa systemanrop kan hänga sig i vissa fall (t.ex. på NFS om servern inte är tillgänglig). Flaggan måste användas med en kanonisk sökväg till monteringspunkten."

#. from tp:util-linux-man-2.41.2-rc1
msgid "This option is silently ignored by *umount* for non-root users."
msgstr "Denna flagga ignoreras i tysthet av *umount* för användare som inte är root."

#. from tp:util-linux-man-2.41.2-rc1
msgid "For more details about this option see the *mount*(8) man page. Note that *umount* does not pass this option to the **/sbin/umount.**__type__ helpers."
msgstr "Mer information om den här flaggan finns i manuskriptet *mount*(8). Observera att *umount* inte skickar den här flaggan till hjälpprogrammen **/sbin/umount.**__typ__."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-d*, *--detach-loop*"
msgstr "*-d*, *--detach-loop*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "When the unmounted device was a loop device, also free this loop device. This option is unnecessary for devices initialized by *mount*(8), in this case \"autoclear\" functionality is enabled by default."
msgstr "Om den omonterade enheten var en loop-enhet, frigör även denna loop-enhet. Denna flagga är inte nödvändig för enheter som initieras med *mount*(8), i detta fall är \"autoclear\"-funktionen aktiverad som standard."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--fake*"
msgstr "*--fake*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Causes everything to be done except for the actual system call or umount helper execution; this 'fakes' unmounting the filesystem. It can be used to remove entries from the deprecated _/etc/mtab_ that were unmounted earlier with the *-n* option."
msgstr "Gör att allt görs utom det faktiska systemanropet eller umount-hjälpen; detta \"fejkar\" avmontering av filsystemet. Det kan användas för att ta bort poster från den föråldrade _/etc/mtab_ som tidigare avmonterats med flaggan *-n*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Force an unmount (in case of an unreachable NFS system)."
msgstr "Tvinga fram en avmontering (i händelse av ett oåtkomligt NFS-system)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Note that this option does not guarantee that umount command does not hang. It's strongly recommended to use absolute paths without symlinks to avoid unwanted *readlink*(2) and *stat*(2) system calls on unreachable NFS in *umount*."
msgstr "Observera att denna flagga inte garanterar att umount-kommandot inte hänger sig. Det rekommenderas starkt att använda absoluta sökvägar utan symlinks för att undvika oönskade *readlink*(2) och *stat*(2) systemanrop på oåtkomlig NFS i *umount*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-i*, *--internal-only*"
msgstr "*-i*, *--internal-only*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Do not call the **/sbin/umount.**__filesystem__ helper even if it exists. By default such a helper program is called if it exists."
msgstr "Anropa inte hjälpprogrammet **/sbin/umount.**__filsystem__ även om det finns. Som standard anropas ett sådant hjälpprogram om det finns."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-l*, *--lazy*"
msgstr "*-l*, *--lazy*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Lazy unmount. Detach the filesystem from the file hierarchy now, and clean up all references to this filesystem as soon as it is not busy anymore."
msgstr "Lat avmontering. Ta bort filsystemet från filhierarkin nu och rensa bort alla referenser till detta filsystem så snart det inte längre är upptaget."

#. from tp:util-linux-man-2.41.2-rc1
msgid "A system reboot would be expected in near future if you're going to use this option for network filesystem or local filesystem with submounts. The recommended use-case for *umount -l* is to prevent hangs on shutdown due to an unreachable network share where a normal *umount* will hang due to a downed server or a network partition. Remounts of the share will not be possible."
msgstr "En omstart av systemet kan förväntas inom en snar framtid om du ska använda den här flaggan för nätverksfilsystem eller lokala filsystem med undermonteringar. Det rekommenderade användningsfallet för *umount -l* är att förhindra att det hänger sig vid avstängning på grund av en oåtkomlig nätverksdelning där en normal *umount* kommer att hänga sig på grund av en nedstängd server eller en nätverkspartition. Det kommer inte att vara möjligt att göra nya inläsningar av delningen."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Perform *umount* in the mount namespace specified by _ns_. _ns_ is either PID of process running in that namespace or special file representing that namespace."
msgstr "Utför *umount* i det mount-namnområde som anges av _ns_. _ns_ är antingen PID för en process som körs i det namnområdet eller en speciell fil som representerar det namnområdet."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*umount* switches to the namespace when it reads _/etc/fstab_, writes _/etc/mtab_ (or writes to _/run/mount_) and calls *umount*(2) system call, otherwise it runs in the original namespace. It means that the target mount namespace does not have to contain any libraries or other requirements necessary to execute *umount*(2) command."
msgstr "*umount* byter till namnrymden när den läser _/etc/fstab_, skriver _/etc/mtab_ (eller skriver till _/run/mount_) och anropar systemanropet *umount*(2), annars körs den i den ursprungliga namnrymden. Det innebär att namnrymden för målmonteringen inte behöver innehålla några bibliotek eller andra krav som är nödvändiga för att utföra kommandot *umount*(2)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Unmount without writing in _/etc/mtab_."
msgstr "Avmontera utan att skriva i _/etc/mtab_."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-O*, *--test-opts* _option_..."
msgstr "*-O*, *--test-opts* _option_..."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Unmount only the filesystems that have the specified option set in _/etc/fstab_. More than one option may be specified in a comma-separated list. Each option can be prefixed with *no* to indicate that no action should be taken for this option."
msgstr "Avmontera endast de filsystem som har den angivna flaggan inställd i _/etc/fstab_. Fler än en flagga kan anges i en kommaseparerad lista. Varje flagga kan inledas med *no* för att ange att ingen åtgärd ska vidtas för denna flagga."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Suppress \"not mounted\" error messages."
msgstr "Undertrycker felmeddelanden om \"ej monterad\"."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-R*, *--recursive*"
msgstr "*-R*, *--recursive*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Recursively unmount each specified directory. Recursion for each directory will stop if any unmount operation in the chain fails for any reason. The relationship between mountpoints is determined by _/proc/self/mountinfo_ entries. The filesystem must be specified by mountpoint path; a recursive unmount by device name (or UUID) is unsupported. Since version 2.37 it umounts also all over-mounted filesystems (more filesystems on the same mountpoint)."
msgstr "Avmontera varje angiven katalog rekursivt. Rekursionen för varje katalog stoppas om någon avmonteringsoperation i kedjan misslyckas av någon anledning. Relationen mellan monteringspunkterna bestäms av posterna _/proc/self/mountinfo_. Filsystemet måste anges med monteringspunktens sökväg; en rekursiv avmontering med enhetsnamn (eller UUID) stöds inte. Sedan version 2.37 avmonteras även alla övermonterade filsystem (fler filsystem på samma monteringspunkt)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "When an unmount fails, try to remount the filesystem read-only."
msgstr "När en avmontering misslyckas, försök att återmontera filsystemet skrivskyddat."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-t*, *--types* _type_..."
msgstr "*-t*, *--types* _typ_..."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Indicate that the actions should only be taken on filesystems of the specified _type_. More than one type may be specified in a comma-separated list. The list of filesystem types can be prefixed with *no* to indicate that no action should be taken for all of the mentioned types. Note that *umount* reads information about mounted filesystems from kernel (_/proc/mounts_) and filesystem names may be different than filesystem names used in the _/etc/fstab_ (e.g., \"nfs4\" vs. \"nfs\")."
msgstr "Anger att åtgärderna endast ska vidtas på filsystem av den angivna _typen_. Mer än en typ kan anges i en kommaseparerad lista. Listan med filsystemtyper kan inledas med *no* för att ange att ingen åtgärd ska vidtas för alla de angivna typerna. Observera att *umount* läser information om monterade filsystem från kärnan (_/proc/mounts_) och att filsystemnamn kan skilja sig från filsystemnamn som används i _/etc/fstab_ (t.ex. \"nfs4\" jämfört med \"nfs\")."

#. from tp:util-linux-man-2.41.2-rc1
msgid "NON-SUPERUSER UMOUNTS"
msgstr "UMOUNTS FÖR ICKE-SUPERANVÄNDARE"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Normally, only the superuser can umount filesystems. However, when _fstab_ contains the *user* option on a line, anybody can umount the corresponding filesystem. For more details see *mount*(8) man page."
msgstr "Normalt är det bara superanvändaren som kan umounta filsystem. Men när _fstab_ innehåller flaggan *user* på en rad kan vem som helst umounta motsvarande filsystem. För mer information, se manualsidan *mount*(8)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Since version 2.34 the *umount* command can be used to perform umount operation also for fuse filesystems if kernel mount table contains user's ID. In this case _fstab_ *user=* mount option is not required."
msgstr "Sedan version 2.34 kan kommandot *umount* användas för att utföra umount-operation även för fuse-filsystem om kernel mount-tabellen innehåller användarens ID. I det här fallet krävs inte monteringsflaggan _fstab_ *user=*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Since version 2.35 *umount* command does not exit when user permissions are inadequate by internal *libmount* security rules. It drops suid permissions and continue as regular non-root user. This can be used to support use-cases where root permissions are not necessary (e.g., fuse filesystems, user namespaces, etc)."
msgstr "Sedan version 2.35 avslutas inte kommandot *umount* när användarrättigheterna är otillräckliga enligt de interna säkerhetsreglerna för *libmount*. Det släpper suid-behörigheterna och fortsätter som vanlig användare utan root-behörighet. Detta kan användas för att stödja användningsfall där root-behörigheter inte är nödvändiga (t.ex. fuse-filsystem, användarnamnområden etc.)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "LOOP DEVICE"
msgstr "LOOP-ENHET"

#. from tp:util-linux-man-2.41.2-rc1
msgid "The *umount* command will automatically detach loop device previously initialized by *mount*(8) command independently of _/etc/mtab_."
msgstr "Kommandot *umount* kommer automatiskt att koppla bort loop-enheter som tidigare initierats med kommandot *mount*(8) oberoende av _/etc/mtab_."

#. from tp:util-linux-man-2.41.2-rc1
msgid "In this case the device is initialized with \"autoclear\" flag (see *losetup*(8) output for more details), otherwise it's necessary to use the option *--detach-loop* or call *losetup -d* _device_. The autoclear feature is supported since Linux 2.6.25."
msgstr "I det här fallet initieras enheten med flaggan \"autoclear\" (se *losetup*(8) för mer information), annars måste du använda flaggan *--detach-loop* eller anropa *losetup -d* _enhet_. Funktionen autoclear stöds sedan Linux 2.6.25."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Note that since Linux v3.7 kernel uses \"lazy device destruction\". The system just marks the loop device by autoclear flag and destroys it later. If you need to wait for a complete removal of the loop device, call *udevadm settle* after *umount*."
msgstr "Observera att sedan Linux v3.7 använder kärnan \"lazy device destruction\". Systemet markerar bara loop-enheten med autoclear-flaggan och förstör den senare. Om du behöver vänta på att loopenheten ska tas bort helt och hållet, anropar du *udevadm settle* efter *umount*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*umount* has the following exit status values (the bits can be ORed):"
msgstr "*umount* har följande värden för utgångsstatus (bitarna kan vara ORed):"

#. from tp:util-linux-man-2.41.2-rc1
msgid "some umount succeeded"
msgstr "vissa umount lyckades"

#. from tp:util-linux-man-2.41.2-rc1
msgid "The command *umount -a* returns 0 (all succeeded), 32 (all failed), or 64 (some failed, some succeeded)."
msgstr "Kommandot *umount -a* returnerar 0 (alla lyckades), 32 (alla misslyckades) eller 64 (några misslyckades, några lyckades)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "failed to execute external /sbin/umount.<type> mount helper (since util-linux v2.41)"
msgstr "misslyckades med att köra extern /sbin/umount.<type> mount helper (sedan util-linux v2.41)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "The syntax of external unmount helpers is:"
msgstr "Syntaxen för externa avmonteringshjälpmedel är:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "**umount.**__suffix__ {__directory__|_device_} [*-flnrv*] [*-N* _namespace_] [*-t* _type_._subtype_]"
msgstr "**umount.**__suffix__ {__katalog__|_enhet_} [*-flnrv*] [*-N* _namnrymd_] [*-t* _typ_._subtype_]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "where _suffix_ is the filesystem type (or the value from a *uhelper=* or *helper=* marker in the mtab file). The *-t* option can be used for filesystems that have subtype support. For example:"
msgstr "där _suffix_ är filsystemets typ (eller värdet från en *uhelper=*- eller *helper=*-markör i mtab-filen). Flaggan *-t* kan användas för filsystem som har stöd för subtyper. Till exempel: *-t*:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*umount.fuse -t fuse.sshfs*"
msgstr "*umount.fuse -t fuse.sshfs*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "A **uhelper=**__something__ marker (unprivileged helper) can appear in the _/etc/mtab_ file when ordinary users need to be able to unmount a mountpoint that is not defined in _/etc/fstab_ (for example for a device that was mounted by *udisks*(1))."
msgstr "En **uhelper=**__något__-markör (unprivileged helper) kan förekomma i filen _/etc/mtab_ när vanliga användare behöver kunna avmontera en monteringspunkt som inte är definierad i _/etc/fstab_ (till exempel för en enhet som monterades av *udisks*(1))."

#. from tp:util-linux-man-2.41.2-rc1
msgid "A **helper=**__type__ marker in the _mtab_ file will redirect all unmount requests to the **/sbin/umount.**__type__ helper independently of UID."
msgstr "En **helper=**__typ__-markör i filen _mtab_ kommer att omdirigera alla avmonteringsbegäranden till hjälpen **/sbin/umount.**__typ__ oberoende av UID."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Note that _/etc/mtab_ is currently deprecated and *helper=* and other userspace mount options are maintained by *libmount*."
msgstr "Observera att _/etc/mtab_ för närvarande är föråldrad och att *helper=* och andra monteringsflaggor i användarutrymmet hanteras av *libmount*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The exit status value of the helper is returned as the exit status of *umount*(8). The value 126 is used if the mount helper program is found, but the execl() failed."
msgstr "Värdet för utgångsstatus för hjälpprogrammet returneras som utgångsstatus för *umount*(8). Värdet 126 används om mount-hjälpprogrammet hittas, men execl() misslyckades."

#. from tp:util-linux-man-2.41.2-rc1
msgid "overrides the default location of the _fstab_ file (ignored for *suid*)"
msgstr "åsidosätter standardplatsen för _fstab_-filen (ignoreras för *suid*)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "enables *libmount* debug output"
msgstr "aktiverar *libmount* felsökningsutmatning"

#. from tp:util-linux-man-2.41.2-rc1
msgid "table of mounted filesystems (deprecated and usually replaced by symlink to _/proc/mounts_)"
msgstr "tabell över monterade filsystem (föråldrad och ersätts vanligtvis av symlänk till _/proc/mounts_)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "table of known filesystems"
msgstr "tabell över kända filsystem"

#. from tp:util-linux-man-2.41.2-rc1
msgid "_/proc/self/mountinfo_"
msgstr "_/proc/self/mountinfo"

#. from tp:util-linux-man-2.41.2-rc1
msgid "table of mounted filesystems generated by kernel."
msgstr "tabell över monterade filsystem som genereras av kärnan."

#. from tp:util-linux-man-2.41.2-rc1
msgid "A *umount* command appeared in Version 6 AT&T UNIX."
msgstr "Ett *umount*-kommando dök upp i version 6 av AT&T UNIX."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*umount*(2), *losetup*(8), *mount_namespaces*(7), *mount*(8)"
msgstr "*umount*(2), *losetup*(8), *mount_namespaces*(7), *mount*(8)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "unshare(1)"
msgstr "unshare(1)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "unshare - run program in new namespaces"
msgstr "unshare - kör program i nya namnområden"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*unshare* [options] [_program_ [_arguments_]]"
msgstr "*unshare* [flaggor] [_program_ [_argument_]]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "The *unshare* command creates new namespaces (as specified by the command-line options described below) and then executes the specified _program_. If _program_ is not given, then \"${SHELL}\" is run (default: _/bin/sh_)."
msgstr "Kommandot *unshare* skapar nya namnrymder (som anges med kommandoradsflaggor som beskrivs nedan) och kör sedan det angivna _programmet_. Om _program_ inte anges körs \"${SHELL}\" (standard: _/bin/sh_)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "By default, a new namespace persists only as long as it has member processes. A new namespace can be made persistent even when it has no member processes by bind mounting /proc/_pid_/ns/_type_ files to a filesystem path. A namespace that has been made persistent in this way can subsequently be entered with *nsenter*(1) even after the _program_ terminates (except PID namespaces where a permanently running init process is required). Once a persistent namespace is no longer needed, it can be unpersisted by using *umount*(8) to remove the bind mount. See the *EXAMPLES* section for more details."
msgstr "Som standard finns ett nytt namnområde bara kvar så länge det har medlemsprocesser. Ett nytt namnområde kan göras beständigt även när det inte har några medlemsprocesser genom att binda montering av /proc/_pid_/ns/_typ_-filer till en filsystemssökväg. Ett namnområde som har gjorts beständigt på det här sättet kan därefter beträdas med *nsenter*(1) även efter att _programmet_ har avslutats (utom PID-namnområden där en permanent init-process krävs). När en persistent namnrymd inte längre behövs kan den avpersisteras genom att använda *umount*(8) för att ta bort bind mount. Se avsnittet *EXEMPEL* för mer information."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*unshare* since util-linux version 2.36 uses _/proc/[pid]/ns/pid_for_children_ and _/proc/[pid]/ns/time_for_children_ files for persistent PID and TIME namespaces. This change requires Linux kernel 4.17 or newer."
msgstr "*unshare* eftersom util-linux version 2.36 använder _/proc/[pid]/ns/pid_for_children_ och _/proc/[pid]/ns/time_for_children_-filer för beständiga PID- och TIME-namnområden. Denna ändring kräver Linux-kärnan 4.17 eller nyare."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The following types of namespaces can be created with *unshare*:"
msgstr "Följande typer av namnrymder kan skapas med *unshare*:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Mounting and unmounting filesystems will not affect the rest of the system, except for filesystems which are explicitly marked as shared (with *mount --make-shared*; see _/proc/self/mountinfo_ or *findmnt -o+PROPAGATION* for the *shared* flags). For further details, see *mount_namespaces*(7)."
msgstr "Montering och avmontering av filsystem påverkar inte resten av systemet, utom för filsystem som uttryckligen markeras som delade (med *mount --make-shared*; se _/proc/self/mountinfo_ eller *findmnt -o+PROPAGATION* för flaggorna *shared*). För ytterligare information, se *mount_namespaces*(7)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*unshare* since util-linux version 2.27 automatically sets propagation to *private* in a new mount namespace to make sure that the new namespace is really unshared. It's possible to disable this feature with option *--propagation unchanged*. Note that *private* is the kernel default."
msgstr "*unshare* sedan util-linux version 2.27 ställer automatiskt in propagering till *private* i ett nytt mount-namnområde för att säkerställa att det nya namnområdet verkligen är unshared. Det är möjligt att inaktivera den här funktionen med flaggan *--propagation oförändrad*. Observera att *private* är kärnans standardinställning."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Children will have a distinct set of PID-to-process mappings from their parent. For further details, see *pid_namespaces*(7)."
msgstr "Barn kommer att ha en annan uppsättning PID-till-process-mappningar än sin förälder. För ytterligare information, se *pid_namespaces*(7)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-i*, *--ipc*[**=**__file__]"
msgstr "*-i*, *--ipc*[**=**__fil__]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Create a new IPC namespace. If _file_ is specified, then the namespace is made persistent by creating a bind mount at _file_."
msgstr "Skapa ett nytt IPC-namnområde. Om _fil_ anges görs namnrymden beständig genom att skapa en bind mount på _fil_."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-m*, *--mount*[**=**__file__]"
msgstr "*-m*, *--mount*[**=**__fil__]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Create a new mount namespace. If _file_ is specified, then the namespace is made persistent by creating a bind mount at _file_. Note that _file_ must be located on a mount whose propagation type is not *shared* (or an error results). Use the command *findmnt -o+PROPAGATION* when not sure about the current setting. See also the examples below."
msgstr "Skapa ett nytt mount-namnområde. Om _fil_ anges görs namnområdet beständigt genom att ett bind-mount skapas på _fil_. Observera att _fil_ måste finnas på en mount vars propagationstyp inte är *shared* (annars uppstår ett fel). Använd kommandot *findmnt -o+PROPAGATION* om du inte är säker på den aktuella inställningen. Se även exemplen nedan."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-n*, *--net*[**=**__file__]"
msgstr "*-n*, *--net*[**=**__fil__]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Create a new network namespace. If _file_ is specified, then the namespace is made persistent by creating a bind mount at _file_."
msgstr "Skapa ett nytt nätverksnamnområde. Om _fil_ anges görs namnrymden beständig genom att skapa en bind mount på _fil_."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-p*, *--pid*[**=**__file__]"
msgstr "*-p*, *--pid*[**=**__fil__]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Create a new PID namespace. If _file_ is specified, then the namespace is made persistent by creating a bind mount at _file_. (Creation of a persistent PID namespace will fail if the *--fork* option is not also specified.)"
msgstr "Skapa ett nytt PID-namnområde. Om _fil_ anges görs namnrymden beständig genom att skapa en bind mount på _fil_. (Skapandet av ett beständigt PID-namnområde misslyckas om flaggan *--fork* inte också anges)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "See also the *--fork* and *--mount-proc* options."
msgstr "Se även flaggorna *--fork* och *--mount-proc*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-u*, *--uts*[**=**__file__]"
msgstr "*-u*, *--uts*[**=**__fil__]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Create a new UTS namespace. If _file_ is specified, then the namespace is made persistent by creating a bind mount at _file_."
msgstr "Skapa ett nytt UTS-namnområde. Om _fil_ anges görs namnrymden beständig genom att skapa en bind mount på _fil_."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-U*, *--user*[**=**__file__]"
msgstr "*-U*, *--user*[**=**__fil__]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Create a new user namespace. If _file_ is specified, then the namespace is made persistent by creating a bind mount at _file_."
msgstr "Skapa ett nytt användarnamnområde. Om _fil_ anges görs namnområdet beständigt genom att skapa en bind mount på _fil_."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-C*, *--cgroup*[**=**__file__]"
msgstr "*-C*, *--cgroup*[**=**__fil__]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Create a new cgroup namespace. If _file_ is specified, then the namespace is made persistent by creating a bind mount at _file_."
msgstr "Skapa ett nytt cgroup-namnområde. Om _fil_ anges görs namnområdet beständigt genom att skapa en bind mount på _fil_."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-T*, *--time*[**=**__file__]"
msgstr "*-T*, *--time*[**=**__fil__]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Create a new time namespace. If _file_ is specified, then the namespace is made persistent by creating a bind mount at _file_. The *--monotonic* and *--boottime* options can be used to specify the corresponding offset in the time namespace."
msgstr "Skapa ett nytt tidsnamnområde. Om _fil_ anges görs namnrymden beständig genom att skapa en bind mount på _fil_. Flaggorna *--monotonic* och *--boottime* kan användas för att ange motsvarande förskjutning i tidsnamnrymden."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Fork the specified _program_ as a child process of *unshare* rather than running it directly. This is useful when creating a new PID namespace. Note that when *unshare* is waiting for the child process, then it ignores *SIGINT* and *SIGTERM* and does not forward any signals to the child. It is necessary to send signals to the child process."
msgstr "Fork det angivna _programmet_ som en underordnad process till *unshare* i stället för att köra det direkt. Detta är användbart när du skapar ett nytt PID-namnområde. Observera att när *unshare* väntar på barnprocessen ignorerar den *SIGINT* och *SIGTERM* och vidarebefordrar inga signaler till barnprocessen. Det är nödvändigt att skicka signaler till den underordnade processen."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--kill-child*[**=**__signame__]"
msgstr "*--kill-child*[**=**__signame__]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "When *unshare* terminates, have _signame_ be sent to the forked child process. Combined with *--pid* this allows for an easy and reliable killing of the entire process tree below *unshare*. If not given, _signame_ defaults to *SIGKILL*. This option implies *--fork*."
msgstr "När *unshare* avslutas ska _signame_ skickas till den förgrenade barnprocessen. Kombinerat med *--pid* möjliggör detta en enkel och tillförlitlig dödande av hela processträdet under *unshare*. Om _signame_ inte anges är standardvärdet *SIGKILL*. Denna flagga implicerar *--fork*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--mount-proc*[**=**__mountpoint__]"
msgstr "*--mount-proc*[**=**__monteringspunkt__]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Just before running the program, mount the proc filesystem at _mountpoint_ (default is _/proc_). This is useful when creating a new PID namespace. It also implies creating a new mount namespace since the _/proc_ mount would otherwise mess up existing programs on the system. The new proc filesystem is explicitly mounted as private (with *MS_PRIVATE*|*MS_REC*)."
msgstr "Precis innan du kör programmet ska du montera proc-filsystemet på _monteringspunkt_ (standard är _/proc_). Detta är användbart när du skapar ett nytt PID-namnområde. Det innebär också att man skapar ett nytt mount-namnområde eftersom _/proc_-monteringen annars skulle störa befintliga program på systemet. Det nya proc-filsystemet är uttryckligen monterat som privat (med *MS_PRIVATE*|*MS_REC*)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--mount-binfmt*[**=**__mountpoint__]"
msgstr "*--mount-binfmt*[**=**__monteringspunkt__]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Just before running the program, mount the binfmt_misc filesystem at _mountpoint_ (default is /proc/sys/fs/binfmt_misc).  It also implies creating a new mount namespace since the binfmt_misc mount would otherwise mess up existing programs on the system.  The new binfmt_misc filesystem is explicitly mounted as private (with *MS_PRIVATE*|*MS_REC*)."
msgstr "Precis innan du kör programmet ska du montera filsystemet binfmt_misc på _monteringspunkt_ (standard är /proc/sys/fs/binfmt_misc).  Det innebär också att ett nytt namnområde för montering skapas eftersom monteringen av binfmt_misc annars skulle störa befintliga program på systemet.  Det nya binfmt_misc-filsystemet är uttryckligen monterat som privat (med *MS_PRIVATE*|*MS_REC*)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--map-user* __uid__|__name__"
msgstr "*--map-user* __uid__|__namn__"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Run the program only after the current effective user ID has been mapped to _uid_. If this option is specified multiple times, the last occurrence takes precedence. This option implies *--user*."
msgstr "Kör programmet först efter att det aktuella effektiva användar-ID:t har mappats till _uid_. Om denna flagga anges flera gånger har den sista förekomsten företräde. Denna flagga implicerar *--user*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--map-users* __inneruid__**:**__outeruid__**:**__count__|**auto**|**subids**|**all**"
msgstr "*--map-users* __inneruid__**:**__outeruid__**:**__count__|**auto**|**subids**|**all**"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Run the program only after the block of user IDs of size _count_ beginning at _outeruid_ has been mapped to the block of user IDs beginning at _inneruid_. This mapping is created with **newuidmap**(1) if *unshare* was run unprivileged. If the range of user IDs overlaps with the mapping specified by *--map-user*, then a \"hole\" will be removed from the mapping. This may result in the highest user ID of the mapping not being mapped. Use *--map-users* multiple times to map more than one block of user IDs. The special value *auto* will map the first block of user IDs owned by the effective user from _/etc/subuid_ to a block starting at user ID 0. The special value *subids* will identity map the same block. The special value *all* will create a pass-through map for every user ID available in the parent namespace. This option implies *--user*."
msgstr "Kör programmet först efter att blocket med användar-ID:n av storleken _count_ som börjar på _outeruid_ har mappats till blocket med användar-ID:n som börjar på _inneruid_. Denna mappning skapas med **newuidmap**(1) om *unshare* kördes utan privilegier. Om intervallet med användar-ID:n överlappar med den mappning som anges av *--map-user*, kommer ett \"hål\" att tas bort från mappningen. Detta kan resultera i att det högsta användar-ID:t i mappningen inte mappas. Använd *--map-users* flera gånger för att mappa mer än ett block med användar-ID:n. Specialvärdet *auto* mappar det första blocket med användar-ID som ägs av den faktiska användaren från _/etc/subuid_ till ett block som börjar med användar-ID 0. Det särskilda värdet *subids* identitetsmappar samma block. Specialvärdet *all* skapar en pass-through-mappning för varje användar-ID som finns i det överordnade namnområdet. Denna flagga implicerar *--user*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Before util-linux version 2.39, this option expected a comma-separated argument of the form _outeruid_**,**_inneruid_**,**_count_ but that format is now deprecated for consistency with the ordering used in _/proc/[pid]/uid_map_ and the _X-mount.idmap_ mount option."
msgstr "Före util-linux version 2.39 förväntade sig den här flaggan ett kommaseparerat argument av formen _outeruid_**,**_inneruid_**,**_count_ men det formatet är nu borttaget för att överensstämma med den ordning som används i _/proc/[pid]/uid_map_ och monteringsflaggan _X-mount.idmap_."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--map-group* __gid__|__name__"
msgstr "*--map-group* __gid__|__namn__"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Run the program only after the current effective group ID has been mapped to _gid_. If this option is specified multiple times, the last occurrence takes precedence. This option implies *--setgroups=deny* and *--user*."
msgstr "Kör programmet först efter att det aktuella effektiva grupp-ID:t har mappats till _gid_. Om den här flaggan anges flera gånger har den sista förekomsten företräde. Den här flaggan förutsätter *--setgroups=deny* och *--user*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--map-groups* __innergid__**:**__outergid__**:**__count__|**auto**|**subids**|**all**"
msgstr "*--map-groups* __innergid__**:**__outergid__**:**__count__|**auto**|**subids**|**all**"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Run the program only after the block of group IDs of size _count_ beginning at _outergid_ has been mapped to the block of group IDs beginning at _innergid_. This mapping is created with **newgidmap**(1) if *unshare* was run unprivileged. If the range of group IDs overlaps with the mapping specified by *--map-group*, then a \"hole\" will be removed from the mapping. This may result in the highest group ID of the mapping not being mapped. Use *--map-groups* multiple times to map more than one block of group IDs. The special value *auto* will map the first block of user IDs owned by the effective user from _/etc/subgid_ to a block starting at group ID 0. The special value *subids* will identity map the same block. The special value *all* will create a pass-through map for every group ID available in the parent namespace. This option implies *--user*."
msgstr "Kör programmet först efter att blocket med grupp-ID:n av storleken _count_ som börjar på _outergid_ har mappats till blocket med grupp-ID:n som börjar på _innergid_. Denna mappning skapas med **newgidmap**(1) om *unshare* kördes utan privilegier. Om intervallet med grupp-ID:n överlappar med den mappning som anges av *--map-group*, kommer ett \"hål\" att tas bort från mappningen. Detta kan resultera i att det högsta grupp-ID:t i mappningen inte mappas. Använd *--map-groups* flera gånger för att mappa mer än ett block med grupp-ID:n. Specialvärdet *auto* mappar det första blocket med användar-ID som ägs av den faktiska användaren från _/etc/subgid_ till ett block som börjar med grupp-ID 0. Specialvärdet *subids* identitetsmappar samma block. Specialvärdet *all* skapar en pass-through-mappning för varje grupp-ID som är tillgängligt i den överordnade namnrymden. Denna flagga förutsätter *--user*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Before util-linux version 2.39, this option expected a comma-separated argument of the form _outergid_**,**_innergid_**,**_count_ but that format is now deprecated for consistency with the ordering used in _/proc/[pid]/gid_map_ and the _X-mount.idmap_ mount option."
msgstr "Före util-linux version 2.39 förväntade sig den här flaggan ett kommaseparerat argument av formen _outergid_**,**_innergid_**,**_count_ men det formatet är nu borttaget för att överensstämma med den ordning som används i _/proc/[pid]/gid_map_ och monteringsflaggan _X-mount.idmap_."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--map-auto*"
msgstr "*--map-auto*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Map the first block of user IDs owned by the effective user from _/etc/subuid_ to a block starting at user ID 0. In the same manner, also map the first block of group IDs owned by the effective group from _/etc/subgid_ to a block starting at group ID 0. This option is intended to handle the common case where the first block of subordinate user and group IDs can map the whole user and group ID space. This option is equivalent to specifying *--map-users=auto* and *--map-groups=auto*."
msgstr "Mappa det första blocket med användar-ID som ägs av den faktiska användaren från _/etc/subuid_ till ett block som börjar på användar-ID 0. På samma sätt mappar du även det första blocket med grupp-ID:n som ägs av den effektiva gruppen från _/etc/subgid_ till ett block som börjar på grupp-ID 0. Den här flaggan är avsett att hantera det vanliga fallet där det första blocket med underordnade användar- och grupp-ID:n kan mappa hela användar- och grupp-ID-utrymmet. Den här flaggan är likvärdigt med att ange *--map-users=auto* och *--map-groups=auto*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--map-subids*"
msgstr "*--map-subids*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Identity map the first block of user IDs owned by the effective user from _/etc/subuid_. In the same manner, also identity map the first block of group IDs owned by the effective group from _/etc/subgid_. This option is equivalent to specifying *--map-users=subids* and *--map-groups=subids*."
msgstr "Identitetsmappa det första blocket med användar-ID:n som ägs av den faktiska användaren från _/etc/subuid_. På samma sätt identitetskartläggs även det första blocket med grupp-ID:n som ägs av den faktiska gruppen från _/etc/subgid_. Denna flagga är likvärdigt med att ange *--map-users=subids* och *--map-groups=subids*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-r*, *--map-root-user*"
msgstr "*-r*, *--map-root-user*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Run the program only after the current effective user and group IDs have been mapped to the superuser UID and GID in the newly created user namespace. This makes it possible to conveniently gain capabilities needed to manage various aspects of the newly created namespaces (such as configuring interfaces in the network namespace or mounting filesystems in the mount namespace) even when run unprivileged. As a mere convenience feature, it does not support more sophisticated use cases, such as mapping multiple ranges of UIDs and GIDs. This option implies *--setgroups=deny* and *--user*. This option is equivalent to *--map-user=0 --map-group=0*."
msgstr "Kör programmet först efter att de aktuella effektiva användar- och grupp-ID:n har mappats till superanvändarens UID och GID i den nyskapade användarnamnrymden. Detta gör det möjligt att på ett bekvämt sätt få de funktioner som behövs för att hantera olika aspekter av de nyskapade namnrymderna (t.ex. konfigurera gränssnitt i nätverksnamnrymden eller montera filsystem i mount-namnrymden) även när programmet körs utan privilegier. Det är en ren bekvämlighetsfunktion och stöder inte mer sofistikerade användningsfall, t.ex. mappning av flera UID- och GID-intervall. Den här flaggan förutsätter *--setgroups=deny* och *--user*. Den här flaggan är likvärdigt med *--map-user=0 --map-group=0*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-c*, *--map-current-user*"
msgstr "*-c*, *--map-current-user*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Run the program only after the current effective user and group IDs have been mapped to the same UID and GID in the newly created user namespace. This option implies *--setgroups=deny* and *--user*. This option is equivalent to *--map-user=$(id -ru) --map-group=$(id -rg)*."
msgstr "Kör programmet först efter att de aktuella effektiva användar- och grupp-ID:n har mappats till samma UID och GID i det nyskapade användarnamnområdet. Den här flaggan förutsätter *--setgroups=deny* och *--user*. Den här flaggan motsvarar *--map-user=$(id -ru) --map-group=$(id -rg)*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--propagation* **private**|**shared**|**slave**|**unchanged**"
msgstr "*--propagation* **private**|**shared**|**slave**|**unchanged**"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Recursively set the mount propagation flag in the new mount namespace. The default is to set the propagation to _private_. It is possible to disable this feature with the argument *unchanged*. The option is silently ignored when the mount namespace (*--mount*) is not requested."
msgstr "Ställer rekursivt in flaggan för mount-propagering i det nya mount-namnområdet. Standardinställningen är att sätta spridningen till _private_. Det är möjligt att inaktivera den här funktionen med argumentet *unchanged*. Flaggan ignoreras i tysthet när namnområdet för montering (*--mount*) inte begärs."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--setgroups* **allow**|**deny**"
msgstr "*--setgroups* **allow**|**deny**"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Allow or deny the *setgroups*(2) system call in a user namespace."
msgstr "Tillåt eller neka systemanropet *setgroups*(2) i ett användarnamnområde."

#. from tp:util-linux-man-2.41.2-rc1
msgid "To be able to call *setgroups*(2), the calling process must at least have *CAP_SETGID*. But since Linux 3.19 a further restriction applies: the kernel gives permission to call *setgroups*(2) only after the GID map (**/proc/**__pid__*/gid_map*) has been set. The GID map is writable by root when *setgroups*(2) is enabled (i.e., *allow*, the default), and the GID map becomes writable by unprivileged processes when *setgroups*(2) is permanently disabled (with *deny*)."
msgstr "För att kunna anropa *setgroups*(2) måste den anropande processen åtminstone ha *CAP_SETGID*. Men sedan Linux 3.19 gäller ytterligare en begränsning: kärnan ger tillstånd att anropa *setgroups*(2) först efter att GID-kartan (**/proc/**__pid__*/gid_map*) har ställts in. GID-kartan är skrivbar av root när *setgroups*(2) är aktiverad (dvs. *allow*, standard), och GID-kartan blir skrivbar av oprivilegierade processer när *setgroups*(2) är permanent inaktiverad (med *deny*)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-R*, *--root* __dir__"
msgstr "*-R*, *--root* __dir__"

#. from tp:util-linux-man-2.41.2-rc1
msgid "run the command with root directory set to _dir_."
msgstr "kör kommandot med rotkatalogen inställd på _dir_."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-w*, *--wd* __dir__"
msgstr "*-w*, *--wd* __dir__"

#. from tp:util-linux-man-2.41.2-rc1
msgid "change working directory to _dir_."
msgstr "ändra arbetskatalog till _dir_."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Set the user ID which will be used in the entered namespace."
msgstr "Ange det användar-ID som ska användas i den angivna namnrymden."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Set the group ID which will be used in the entered namespace and drop supplementary groups."
msgstr "Ange det grupp-ID som ska användas i den angivna namnrymden och släpp tilläggsgrupper."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-l*, *--load-interp* __string__"
msgstr "*-l*, *--load-interp* __sträng__"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Load binfmt_misc definition in the namespace (implies *--mount-binfmt*). The __string__ argument is ``:name:type:offset:magic:mask:interpreter:flags``. For more details about new binary type registration see https://www.kernel.org/doc/Documentation/admin-guide/binfmt-misc.rst.  To manage the F flag in ``flags`` with *--root* parameter, binfmt_misc is mounted twice, once before the chroot to load the interpreter from the caller filesystem and once after to make it available from the chroot userspace."
msgstr "Ladda binfmt_misc-definitionen i namnrymden (innebär *--mount-binfmt*). Argumentet __sträng__ är ``:namn:typ:offset:magic:mask:tolk:flaggor``. För mer information om registrering av nya binära typer, se https://www.kernel.org/doc/Documentation/admin-guide/binfmt-misc.rst.  För att hantera F-flaggan i ``flags`` med parametern *--root* monteras binfmt_misc två gånger, en gång före chroot för att ladda tolken från det anropande filsystemet och en gång efter för att göra den tillgänglig från chroot-användarutrymmet."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--monotonic* _offset_"
msgstr "*--monotonic* _offset_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Set the offset of *CLOCK_MONOTONIC* which will be used in the entered time namespace. This option requires unsharing a time namespace with *--time*."
msgstr "Ställ in den offset för *CLOCK_MONOTONIC* som ska användas i den angivna tidsnamnrymden. Denna flagga kräver att en tidsnamnrymd inte delas med *--time*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--boottime* _offset_"
msgstr "*--boottime* _offset_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Set the offset of *CLOCK_BOOTTIME* which will be used in the entered time namespace. This option requires unsharing a time namespace with *--time*."
msgstr "Ställ in den offset för *CLOCK_BOOTTIME* som ska användas i den angivna tidsnamnrymden. Denna flagga kräver att en tidsnamnrymd inte delas med *--time*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The proc and sysfs filesystems mounting as root in a user namespace have to be restricted so that a less privileged user cannot get more access to sensitive files that a more privileged user made unavailable. In short the rule for proc and sysfs is as close to a bind mount as possible."
msgstr "Filsystemen proc och sysfs som monteras som root i ett användarnamnområde måste begränsas så att en mindre privilegierad användare inte kan få mer tillgång till känsliga filer som en mer privilegierad användare gjorde otillgängliga. Kort sagt är regeln för proc och sysfs så nära en bind mount som möjligt."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The following command creates a PID namespace, using *--fork* to ensure that the executed command is performed in a child process that (being the first process in the namespace) has PID 1. The *--mount-proc* option ensures that a new mount namespace is also simultaneously created and that a new *proc*(5) filesystem is mounted that contains information corresponding to the new PID namespace. When the *readlink*(1) command terminates, the new namespaces are automatically torn down."
msgstr "Följande kommando skapar ett PID-namnområde och använder *--fork* för att se till att kommandot utförs i en underordnad process som (eftersom den är den första processen i namnområdet) har PID 1. Flaggan *--mount-proc* säkerställer att en ny mount-namnrymd samtidigt skapas och att ett nytt *proc*(5)-filsystem monteras som innehåller information som motsvarar den nya PID-namnrymden. När kommandot *readlink*(1) avslutas rivs de nya namnrymderna automatiskt."

#. from tp:util-linux-man-2.41.2-rc1
msgid "# unshare --fork --pid --mount-proc readlink /proc/self\n1\n"
msgstr "# unshare --fork --pid --mount-proc readlink /proc/self\n1\n"

#. from tp:util-linux-man-2.41.2-rc1
msgid "As an unprivileged user, create a new user namespace where the user's credentials are mapped to the root IDs inside the namespace:"
msgstr "Skapa en ny användarnamnrymd som en icke-privilegierad användare där användarens autentiseringsuppgifter mappas till rot-ID:n i namnrymden:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "$ id -u; id -g\n1000\n1000\n$ unshare --user --map-root-user \\\n        sh -c 'whoami; cat /proc/self/uid_map /proc/self/gid_map'\nroot\n         0       1000          1\n         0       1000          1\n"
msgstr "$ id -u; id -g\n1000\n1000\n$ unshare --user --map-root-user \\\n        sh -c 'whoami; cat /proc/self/uid_map /proc/self/gid_map'\nroot\n         0 1000 1\n         0 1000 1\n"

#. from tp:util-linux-man-2.41.2-rc1
msgid "As an unprivileged user, create a user namespace where the first 65536 IDs are all mapped, and the user's credentials are mapped to the root IDs inside the namespace. The map is determined by the subordinate IDs assigned in *subuid*(5) and *subgid*(5). Demonstrate this mapping by creating a file with user ID 1 and group ID 1. For brevity, only the user ID mappings are shown:"
msgstr "Som en icke-privilegierad användare skapar du ett användarnamnområde där de första 65536 ID:n mappas och användarens autentiseringsuppgifter mappas till rot-ID:n i namnområdet. Mappningen bestäms av de underordnade ID:n som tilldelats i *subuid*(5) och *subgid*(5). Demonstrera denna mappning genom att skapa en fil med användar-ID 1 och grupp-ID 1. I korthet visas endast mappningarna av användar-ID:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "$ id -u\n1000\n$ cat /etc/subuid\n1000:100000:65536\n$ unshare --user --map-auto --map-root-user\n# id -u\n0\n# cat /proc/self/uid_map\n         0       1000          1\n         1     100000      65535\n# touch file; chown 1:1 file\n# ls -ln --time-style=+ file\n-rw-r--r-- 1 1 1 0  file\n# exit\n$ ls -ln --time-style=+ file\n-rw-r--r-- 1 100000 100000 0  file\n"
msgstr "$ id -u\n1000\n$ katt /etc/subuid\n1000:100000:65536\n$ unshare --user --map-auto --map-root-user\n# id -u\n0\n# cat /proc/self/uid_map\n         0 1000 1\n         1 100000 65535\n# touch fil; chown 1:1 fil\n# ls -ln --time-style=+ file\n-rw-r--r-- 1 1 1 0 fil\n# exit\n$ ls -ln --time-style=+ fil\n-rw-r--r-- 1 100000 100000 0 fil\n"

#. from tp:util-linux-man-2.41.2-rc1
msgid "The first of the following commands creates a new persistent UTS namespace and modifies the hostname as seen in that namespace. The namespace is then entered with *nsenter*(1) in order to display the modified hostname; this step demonstrates that the UTS namespace continues to exist even though the namespace had no member processes after the *unshare* command terminated. The namespace is then destroyed by removing the bind mount."
msgstr "Det första av följande kommandon skapar ett nytt beständigt UTS-namnområde och ändrar värdnamnet så som det visas i det namnområdet. Namnrymden öppnas sedan med *nsenter*(1) för att visa det modifierade värdnamnet; detta steg visar att UTS-namnrymden fortsätter att existera även om namnrymden inte hade några medlemsprocesser efter att kommandot *unshare* avslutades. Namnrymden förstörs sedan genom att bind mount tas bort."

#. from tp:util-linux-man-2.41.2-rc1
msgid "# touch /root/uts-ns\n# unshare --uts=/root/uts-ns hostname FOO\n# nsenter --uts=/root/uts-ns hostname\nFOO\n# umount /root/uts-ns\n"
msgstr "# touch /root/uts-ns\n# unshare --uts=/root/uts-ns hostname FOO\n# nsenter --uts=/root/uts-ns hostname\nFOO\n# umount /root/uts-ns\n"

#. from tp:util-linux-man-2.41.2-rc1
msgid "The following commands establish a persistent mount namespace referenced by the bind mount _/root/namespaces/mnt_. In order to ensure that the creation of that bind mount succeeds, the parent directory (_/root/namespaces_) is made a bind mount whose propagation type is not *shared*."
msgstr "Följande kommandon upprättar ett beständigt namnområde för montering som refereras av bindningsmonteringen _/root/namespaces/mnt_. För att säkerställa att skapandet av denna bind-mount lyckas görs den överordnade katalogen (_/root/namespaces_) till en bind-mount vars spridningstyp inte är *shared*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "# mount --bind /root/namespaces /root/namespaces\n# mount --make-private /root/namespaces\n# touch /root/namespaces/mnt\n# unshare --mount=/root/namespaces/mnt\n"
msgstr "# mount --bind /root/namespaces /root/namespaces\n# mount --make-private /root/namespaces\n# touch /root/namespaces/mnt\n# unshare --mount=/root/namespaces/mnt\n"

#. from tp:util-linux-man-2.41.2-rc1
msgid "The following commands demonstrate the use of the *--kill-child* option when creating a PID namespace, in order to ensure that when *unshare* is killed, all of the processes within the PID namespace are killed."
msgstr "Följande kommandon visar hur du använder flaggan *--kill-child* när du skapar en PID-namnrymd, för att säkerställa att alla processer inom PID-namnrymden dödas när *unshare* dödas."

#. from tp:util-linux-man-2.41.2-rc1
msgid "# set +m                # Don't print job status messages\n"
msgstr "# set +m # Skriv inte ut statusmeddelanden för jobb\n"

#. from tp:util-linux-man-2.41.2-rc1
msgid "# unshare --pid --fork --mount-proc --kill-child -- \\\n       bash --norc -c '(sleep 555 &) && (ps a &) && sleep 999' &\n[1] 53456\n#     PID TTY      STAT   TIME COMMAND\n      1 pts/3    S+     0:00 sleep 999\n      3 pts/3    S+     0:00 sleep 555\n      5 pts/3    R+     0:00 ps a\n"
msgstr "# unshare --pid --fork --mount-proc --kill-child -- \\\n       bash --norc -c '(sleep 555 &) && (ps a &) && sleep 999' &\n[1] 53456\n# PID TTY STAT TID KOMMANDO\n      1 pts/3 S+ 0:00 sömn 999\n      3 pts/3 S+ 0:00 sömn 555\n      5 pts/3 R+ 0:00 ps a\n"

#. from tp:util-linux-man-2.41.2-rc1
msgid "# ps h -o 'comm' $!     # Show that background job is unshare(1)\nunshare\n# kill $!               # Kill unshare(1)\n# pidof sleep\n"
msgstr "# ps h -o 'comm' $!     # Visa att bakgrundsjobbet är unshare(1)\nunshare\n# kill $!               # Kill unshare(1)\n# pidof sömn\n"

#. from tp:util-linux-man-2.41.2-rc1
msgid "The *pidof*(1) command prints no output, because the *sleep* processes have been killed. More precisely, when the *sleep* process that has PID 1 in the namespace (i.e., the namespace's init process) was killed, this caused all other processes in the namespace to be killed. By contrast, a similar series of commands where the *--kill-child* option is not used shows that when *unshare* terminates, the processes in the PID namespace are not killed:"
msgstr "Kommandot *pidof*(1) ger ingen utdata, eftersom *sleep*-processerna har dödats. Närmare bestämt, när *sleep*-processen som har PID 1 i namnrymden (dvs. namnrymdens init-process) dödades, ledde detta till att alla andra processer i namnrymden dödades. Däremot visar en liknande serie kommandon där flaggan *--kill-child* inte används att processerna i PID-namnområdet inte dödas när *unshare* avslutas:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "# unshare --pid --fork --mount-proc -- \\\n       bash --norc -c '(sleep 555 &) && (ps a &) && sleep 999' &\n[1] 53479\n#     PID TTY      STAT   TIME COMMAND\n      1 pts/3    S+     0:00 sleep 999\n      3 pts/3    S+     0:00 sleep 555\n      5 pts/3    R+     0:00 ps a\n"
msgstr "# unshare --pid --fork --mount-proc -- \\\n       bash --norc -c '(sleep 555 &) && (ps a &) && sleep 999' &\n[1] 53479\n# PID TTY STAT TID KOMMANDO\n      1 pts/3 S+ 0:00 sömn 999\n      3 pts/3 S+ 0:00 sömn 555\n      5 pts/3 R+ 0:00 ps a\n"

#. from tp:util-linux-man-2.41.2-rc1
msgid "# kill $!\n# pidof sleep\n53482 53480\n"
msgstr "# kill $!\n# pidof sömn\n53482 53480\n"

#. from tp:util-linux-man-2.41.2-rc1
msgid "The following example demonstrates the creation of a time namespace where the boottime clock is set to a point several years in the past:"
msgstr "Följande exempel visar hur man skapar ett tidsnamnområde där klockan boottime är inställd på en tidpunkt flera år bakåt i tiden:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "# uptime -p             # Show uptime in initial time namespace\nup 21 hours, 30 minutes\n# unshare --time --fork --boottime 300000000 uptime -p\nup 9 years, 28 weeks, 1 day, 2 hours, 50 minutes\n"
msgstr "# uptime -p # Visa upptid i det ursprungliga tidsnamnrymden\nupp 21 timmar, 30 minuter\n# unshare --time --fork --boottime 300000000 uptime -p\nupp 9 år, 28 veckor, 1 dag, 2 timmar, 50 minuter\n"

#. from tp:util-linux-man-2.41.2-rc1
msgid "The following example execute a chroot into the directory /chroot/powerpc/jessie and install the interpreter /bin/qemu-ppc-static to execute the powerpc binaries."
msgstr "Följande exempel kör en chroot till katalogen /chroot/powerpc/jessie och installerar tolken /bin/qemu-ppc-static för att köra powerpc-binärerna."

#. from tp:util-linux-man-2.41.2-rc1
msgid "$  unshare --map-root-user --fork --pid --load-interp=\":qemu-ppc:M::\\\\x7fELF\\x01\\\\x02\\\\x01\\\\x00\\\\x00\\\\x00\\\\x00\\\\x00\\\\x00\\\\x00\\\\x00\\\\x00\\\\x00\\\\x02\\\\x00\\\\x14:\\\\xff\\\\xff\\\\xff\\\\xff\\\\xff\\\\xff\\\\xff\\\\x00\\\\xff\\\\xff\\\\xff\\\\xff\\\\xff\\\\xff\\\\xff\\\\xff\\\\xff\\\\xfe\\\\xff\\\\xff:/bin/qemu-ppc-static:OCF\" --root=/chroot/powerpc/jessie /bin/bash -l\n"
msgstr "$ unshare --map-root-user --fork --pid --load-interp=\":qemu-ppc:M::\\\\x7fELF\\x01\\\\x02\\\\x01\\\\x00\\\\x00\\\\x00\\\\x00\\\\x00\\\\x00\\\\x00\\\\x00\\\\x00\\\\x00\\\\x02\\\\x00\\\\x14:\\\\xff\\\\xff\\\\xff\\\\xff\\\\xff\\\\xff\\\\xff\\\\x00\\\\xff\\\\xff\\\\xff\\\\xff\\\\xff\\\\xff\\\\xff\\\\xff\\\\xff\\\\xfe\\\\xff\\\\xff:/bin/qemu-ppc-static:OCF\" --root=/chroot/powerpc/jessie /bin/bash -l\n"

#. from tp:util-linux-man-2.41.2-rc1
msgid "The ``load-interp`` parameter can be read as following"
msgstr "Parametern ``load-interp`` kan läsas på följande sätt"

#. from tp:util-linux-man-2.41.2-rc1
msgid "``qemu-ppc``"
msgstr "``qemu-ppc``"

#. from tp:util-linux-man-2.41.2-rc1
msgid "is the name of the new file created below ``/proc/sys/fs/binfmt_misc`` to register the interpreter"
msgstr "är namnet på den nya fil som skapas under ``/proc/sys/fs/binfmt_misc`` för att registrera tolken"

#. from tp:util-linux-man-2.41.2-rc1
msgid "``M``"
msgstr "``M``"

#. from tp:util-linux-man-2.41.2-rc1
msgid "defines the interpreter for a given type of magic number"
msgstr "definierar tolken för en viss typ av magiskt tal"

#. from tp:util-linux-man-2.41.2-rc1
msgid "``\\\\x7fELF\\x01\\\\x02\\\\x01\\\\x00\\\\x00\\\\x00\\\\x00\\\\x00\\\\x00\\\\x00\\\\x00\\\\x00\\\\x00\\\\x02\\\\x00\\\\x1``"
msgstr "``\\\\x7fELF\\x01\\\\x02\\\\x01\\\\x00\\\\x00\\\\x00\\\\x00\\\\x00\\\\x00\\\\x00\\\\x00\\\\x00\\\\x00\\\\x02\\\\x00\\\\x1``"

#. from tp:util-linux-man-2.41.2-rc1
msgid "is the magic number to recognize the file to interpret (in this case, the ELF header for PPC32)"
msgstr "är det magiska talet för att känna igen filen som ska tolkas (i det här fallet ELF-headern för PPC32)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "``\\\\xff\\\\xff\\\\xff\\\\xff\\\\xff\\\\xff\\\\xff\\\\x00\\\\xff\\\\xff\\\\xff\\\\xff\\\\xff\\\\xff\\\\xff\\\\xff\\\\xff\\\\xfe\\\\xff\\\\xff``"
msgstr "``\\\\xff\\\\xff\\\\xff\\\\xff\\\\xff\\\\xff\\\\xff\\\\x00\\\\xff\\\\xff\\\\xff\\\\xff\\\\xff\\\\xff\\\\xff\\\\xff\\\\xff\\\\xfe\\\\xff\\\\xff``"

#. from tp:util-linux-man-2.41.2-rc1
msgid "the mask to apply to the magic number"
msgstr "den mask som ska tillämpas på det magiska numret"

#. from tp:util-linux-man-2.41.2-rc1
msgid "``/bin/qemu-ppc-static``"
msgstr "``/bin/qemu-ppc-static``"

#. from tp:util-linux-man-2.41.2-rc1
msgid "the interpreter to use with the file"
msgstr "den tolk som ska användas med filen"

#. from tp:util-linux-man-2.41.2-rc1
msgid "``OCF``"
msgstr "``OCF``"

#. from tp:util-linux-man-2.41.2-rc1
msgid "the file is open by the kernel with credential and security tokens of the file itself and loaded as soon as we register it."
msgstr "filen öppnas av kärnan med legitimation och säkerhetstoken för själva filen och laddas så snart vi registrerar den."

#. from tp:util-linux-man-2.41.2-rc1
msgid "mailto:dottedmag@dottedmag.net[Mikhail Gusarov], mailto:kzak@redhat.com[Karel Zak]"
msgstr "mailto:dottedmag@dottedmag.net[Mikhail Gusarov], mailto:kzak@redhat.com[Karel Zak]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*newuidmap*(1), *newgidmap*(1), *clone*(2), *unshare*(2), *namespaces*(7), *mount*(8)"
msgstr "*newuidmap*(1), *newgidmap*(1), *clone*(2), *unshare*(2), *namespaces*(7), *mount*(8)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "wdctl(8)"
msgstr "wdctl(8)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "wdctl - show hardware watchdog status"
msgstr "wdctl - visa status för hårdvaruövervakning"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*wdctl* [options] [_device_...]"
msgstr "*wdctl* [flaggor] [_enhet_...]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Show hardware watchdog status. The default device is _/dev/watchdog_. If more than one device is specified then the output is separated by one blank line."
msgstr "Visa status för hårdvarans watchdog. Standardenheten är _/dev/watchdog_. Om mer än en enhet anges separeras utdata med en tom rad."

#. from tp:util-linux-man-2.41.2-rc1
msgid "If the device is already used or user has no permissions to read from the device, then *wdctl* reads data from sysfs. In this case information about supported features (flags) might be missing."
msgstr "Om enheten redan används eller om användaren inte har behörighet att läsa från enheten, läser *wdctl* data från sysfs. I det här fallet kan information om funktioner som stöds (flaggor) saknas."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Note that the number of supported watchdog features is hardware specific."
msgstr "Observera att antalet watchdog-funktioner som stöds är maskinvaruspecifikt."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-f*, *--flags* _list_"
msgstr "*-f*, *--flags* _lista_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Print only the specified flags."
msgstr "Skriv bara ut de angivna flaggorna."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-F*, *--noflags*"
msgstr "*-F*, *--noflags*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Do not print information about flags."
msgstr "Skriv inte ut information om flaggor."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-I*, *--noident*"
msgstr "*-I*, *--noident*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Do not print watchdog identity information."
msgstr "Skriv inte ut identitetsinformation för vakthund."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Do not print a header line for flags table."
msgstr "Skriv inte ut en rubrikrad för flaggtabeller."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Define the output columns to use in table of watchdog flags. If no output arrangement is specified, then a default set is used. Use *--help* to get list of all supported columns."
msgstr "Definiera de utdatakolumner som ska användas i tabellen med watchdog-flaggor. Om inget utdataarrangemang anges används en standarduppsättning. Använd *--help* för att få en lista över alla kolumner som stöds."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-O*, *--oneline*"
msgstr "*-O*, *--oneline*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Print all wanted information on one line in key=\"value\" output format."
msgstr "Skriv ut all önskad information på en rad i utdataformatet key=\"value\"."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-p*, *--setpretimeout* _seconds_"
msgstr "*-p*, *--setpretimeout* _seconds_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Set the watchdog pre-timeout in seconds. A watchdog pre-timeout is a notification generated by the watchdog before the watchdog reset might occur in the event the watchdog has not been serviced. This notification is handled by the kernel and can be configured to take an action using sysfs or by *--setpregovernor*."
msgstr "Ställ in watchdog pre-timeout i sekunder. En watchdog pre-timeout är ett meddelande som genereras av watchdog innan återställning av watchdog kan ske om watchdog inte har servats. Detta meddelande hanteras av kärnan och kan konfigureras att vidta en åtgärd med sysfs eller med *--setpregovernor*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-g*, *--setpregovernor* _governor_"
msgstr "*-g*, *--setpregovernor* _styrfaktor_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Set pre-timeout governor name. For available governors see default **wdctl** output."
msgstr "Ange namn på guvernör före timeout. För tillgängliga administratörer se standardutmatningen **wdctl**."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-s*, *--settimeout* _seconds_"
msgstr "*-s*, *--settimeout* _seconds_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Set the watchdog timeout in seconds."
msgstr "Ställ in tidsgränsen för watchdog i sekunder."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-T*, *--notimeouts*"
msgstr "*-T*, *--notimeouts*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Do not print watchdog timeouts."
msgstr "Skriv inte ut watchdog timeouts."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-x*, *--flags-only*"
msgstr "*-x*, *--flags-only*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Same as *-I -T*."
msgstr "Samma som *-I -T*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "mailto:kzak@redhat.com[Karel Zak], mailto:lennart@poettering.net[Lennart Poettering]"
msgstr "mailto:kzak@redhat.com[Karel Zak], mailto:lennart@poettering.net[Lennart Poettering]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "zramctl(8)"
msgstr "zramctl(8)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "zramctl - set up and control zram devices"
msgstr "zramctl - konfigurera och styra zram-enheter"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Get info: "
msgstr "Hämta information: "

#. from tp:util-linux-man-2.41.2-rc1
msgid "*zramctl* [options]"
msgstr "*zramctl* [flaggor]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Reset zram: "
msgstr "Återställ zram: "

#. from tp:util-linux-man-2.41.2-rc1
msgid "*zramctl* *-r* _zramdev_..."
msgstr "*zramctl* *-r* _zramdev_..."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Print name of first unused zram device: "
msgstr "Skriv ut namnet på den första oanvända zram-enheten: "

#. from tp:util-linux-man-2.41.2-rc1
msgid "*zramctl* *-f*"
msgstr "*zramctl* *-f*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Set up a zram device: "
msgstr "Ställ in en zram-enhet: "

#. from tp:util-linux-man-2.41.2-rc1
msgid "*zramctl* [*-f* | _zramdev_] [*-s* _size_] [*-t* _number_] [*-a* _algorithm_]"
msgstr "*zramctl* [*-f* | _zramdev_] [*-s* _storlek_] [*-t* _nummer_] [*-a* _algorithm_]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*zramctl* is used to quickly set up zram device parameters, to reset zram devices, and to query the status of used zram devices."
msgstr "*zramctl* används för att snabbt ställa in parametrar för zram-enheter, återställa zram-enheter och för att fråga om status för använda zram-enheter."

#. from tp:util-linux-man-2.41.2-rc1
msgid "If no option is given, all non-zero size zram devices are shown."
msgstr "Om ingen flagga anges visas alla zram-enheter som inte har noll i storlek."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Note that _zramdev_ node specified on command line has to already exist. The command *zramctl* creates a new _/dev/zram<N>_ nodes only when *--find* option specified. It's possible (and common) that after system boot _/dev/zram<N>_ nodes are not created yet."
msgstr "Observera att _zramdev_-noden som anges på kommandoraden redan måste existera. Kommandot *zramctl* skapar en ny _/dev/zram<N>_-nod endast när flaggan *--find* har angetts. Det är möjligt (och vanligt) att _/dev/zram<N>_-noder inte har skapats ännu efter systemstart."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-a*, **--algorithm lzo**|**lz4**|**lz4hc**|**deflate**|**842**|**zstd**"
msgstr "*-a*, **--algorithm lzo**|**lz4**|**lz4hc**|**deflate**|**842**|**zstd**"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Set the compression algorithm to be used for compressing data in the zram device."
msgstr "Ange vilken komprimeringsalgoritm som ska användas för att komprimera data i zram-enheten."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The *list of supported algorithms could be inaccurate* as it depends on the current kernel configuration. A basic overview can be obtained by using the command \"cat /sys/block/zram0/comp_algorithm\"; however, please note that this list might also be incomplete. This is due to the fact that ZRAM utilizes the Crypto API, and if certain algorithms were built as modules, it becomes impossible to enumerate all of them."
msgstr "*Listan över algoritmer som stöds kan vara felaktig* eftersom den beror på den aktuella kärnkonfigurationen. En grundläggande översikt kan erhållas genom att använda kommandot \"cat /sys/block/zram0/comp_algorithm\", men observera att även denna lista kan vara ofullständig. Detta beror på att ZRAM använder Crypto API, och om vissa algoritmer byggdes som moduler blir det omöjligt att räkna upp dem alla."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-f*, *--find*"
msgstr "*-f*, *--find*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Find the first unused zram device. If a *--size* argument is present, then initialize the device."
msgstr "Hitta den första oanvända zram-enheten. Om ett *--size*-argument finns initialiseras enheten."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Define the status output columns to be used. If no output arrangement is specified, then a default set is used. Use *--help* to get a list of all supported columns."
msgstr "Definiera de kolumner för statusutmatning som ska användas. Om inget utdataarrangemang anges används en standarduppsättning. Använd *--help* för att få en lista över alla kolumner som stöds."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The default list of columns may be extended if _list_ is specified in the format _+list_ (e.g., *zramctl -o+COMP-RATIO*)."
msgstr "Standardlistan med kolumner kan utökas om _lista_ anges i formatet _+list_ (t.ex. *zramctl -o+COMP-RATIO*)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-p*, *--algorithm-params*"
msgstr "*-p*, *--algorithm-params*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Set the algorithm parameters, for example, *level=9 dict=/etc/dictionary* to set compression level and pre-trained dictionary. Parameters are algorithm specific."
msgstr "Ange algoritmparametrarna, t.ex. *level=9 dict=/etc/dictionary* för att ange komprimeringsnivå och förtränad ordbok. Parametrarna är algoritmspecifika."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Use the raw format for status output."
msgstr "Använd råformat för statusutmatning."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Reset the options of the specified zram device(s). Zram device settings can be changed only after a reset."
msgstr "Återställ flaggorna för den eller de angivna zram-enheterna. Zram-enhetens inställningar kan ändras först efter en återställning."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Create a zram device of the specified _size_. Zram devices are aligned to memory pages; when the requested _size_ is not a multiple of the page size, it will be rounded up to the next multiple. When not otherwise specified, the unit of the _size_ parameter is bytes."
msgstr "Skapa en zram-enhet med den angivna _storleken_. Zram-enheter är anpassade till minnessidor; när den begärda _storlek_ inte är en multipel av sidstorleken avrundas den uppåt till nästa multipel. Om inget annat anges är enheten för parametern _storlek_ bytes."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The _size_ argument may be followed by the multiplicative suffixes KiB (=1024), MiB (=1024*1024), and so on for GiB, TiB, PiB, EiB, ZiB and YiB (the \"iB\" is optional, e.g., \"K\" has the same meaning as \"KiB\") or the suffixes KB (=1000), MB (=1000*1000), and so on for GB, TB, PB, EB, ZB and YB."
msgstr "Argumentet _storlek_ kan följas av de multiplikativa suffixen KiB (=1024), MiB (=1024*1024) och så vidare för GiB, TiB, PiB, EiB, ZiB och YiB (iB är valfritt, t.ex. har \"K\" samma betydelse som \"KiB\") eller suffixen KB (=1000), MB (=1000*1000) och så vidare för GB, TB, PB, EB, ZB och YB."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-t*, *--streams* _number_"
msgstr "*-t*, *--streams* _nummer_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Set the maximum number of compression streams that can be used for the device. The default is use all CPUs and one stream for kernels older than 4.6."
msgstr "Ställ in det maximala antalet komprimeringsströmmar som kan användas för enheten. Standardvärdet är använd alla processorer och en ström för kärnor äldre än 4.6."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*zramctl* returns 0 on success, nonzero on failure."
msgstr "*zramctl* returnerar 0 vid framgång, icke-noll vid misslyckande."

#. from tp:util-linux-man-2.41.2-rc1
msgid "_/dev/zram[0..N]_"
msgstr "_/dev/zram[0..N]_ _/dev/zram[0..N]_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "zram block devices"
msgstr "zram-blockenheter"

#. from tp:util-linux-man-2.41.2-rc1
msgid "The following commands set up a zram device with a size of one gigabyte and use it as swap device."
msgstr "Följande kommandon skapar en zram-enhet med en storlek på en gigabyte och använder den som växlingsenhet."

#. from tp:util-linux-man-2.41.2-rc1
msgid " # zramctl --find --size 1024M\n /dev/zram0\n # mkswap /dev/zram0\n # swapon /dev/zram0\n ...\n # swapoff /dev/zram0\n # zramctl --reset /dev/zram0\n"
msgstr " # zramctl --find --size 1024M\n /dev/zram0\n # mkswap /dev/zram0\n # swapon /dev/zram0\n ...\n # swapoff /dev/zram0\n # zramctl --reset /dev/zram0\n"

#. from tp:util-linux-man-2.41.2-rc1
msgid "mailto:nefelim4ag@gmail.com[Timofey Titovets], mailto:kzak@redhat.com[Karel Zak]"
msgstr "mailto:nefelim4ag@gmail.com[Timofey Titovets], mailto:kzak@redhat.com[Karel Zak]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "link:https://docs.kernel.org/admin-guide/blockdev/zram.html[Linux kernel documentation]"
msgstr "länk:https://docs.kernel.org/admin-guide/blockdev/zram.html[Dokumentation om Linux-kärnan]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "agetty(8)"
msgstr "agetty(8)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "agetty - alternative Linux getty"
msgstr "agetty - alternativ Linux getty"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*agetty* [options] _port_ [_baud_rate_...] [_term_]"
msgstr "*agetty* [flaggor] _port_ [_baud_rate_...] [_term_]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*agetty* opens a tty port, prompts for a login name and invokes the /bin/login command. It is normally invoked by *init*(8)."
msgstr "*agetty* öppnar en tty-port, frågar efter ett inloggningsnamn och startar kommandot /bin/login. Det anropas normalt av *init*(8)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*agetty* has several _non-standard_ features that are useful for hardwired and for dial-in lines:"
msgstr "*agetty* har flera _icke-standardiserade_ funktioner som är användbara både för fasta och uppringda linjer:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Adapts the tty settings to parity bits and to erase, kill, end-of-line and uppercase characters when it reads a login name. The program can handle 7-bit characters with even, odd, none or space parity, and 8-bit characters with no parity. The following special characters are recognized: Control-U (kill); DEL and backspace (erase); carriage return and line feed (end of line). See also the *--erase-chars* and *--kill-chars* options."
msgstr "Anpassar tty-inställningarna till paritetsbitar och till radering, dödande, radavslutande och versala tecken när det läser ett inloggningsnamn. Programmet kan hantera 7-bitars tecken med jämn, udda, ingen eller mellanslagsparitet och 8-bitars tecken utan paritet. Följande specialtecken känns igen: Control-U (kill); DEL och backspace (radera); carriage return och line feed (slutet av raden). Se även flaggorna *--erase-chars* och *--kill-chars*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Optionally deduces the baud rate from the CONNECT messages produced by Hayes(tm)-compatible modems."
msgstr "Alternativt kan baudhastigheten härledas från CONNECT-meddelandena som produceras av Hayes(tm)-kompatibla modem."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Optionally does not hang up when it is given an already opened line (useful for call-back applications)."
msgstr "Om du vill kan du välja att inte lägga på när du får en redan öppen linje (användbart för återuppringning)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Optionally does not display the contents of the _/etc/issue_ file."
msgstr "Eventuellt visas inte innehållet i filen _/etc/issue_."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Optionally displays an alternative issue files or directories instead of _/etc/issue_ or _/etc/issue.d_."
msgstr "Visar valfritt alternativa issue-filer eller -kataloger i stället för _/etc/issue_ eller _/etc/issue.d_."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Optionally does not ask for a login name."
msgstr "Eventuellt frågar inte efter ett inloggningsnamn."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Optionally invokes a non-standard login program instead of _/bin/login_."
msgstr "Alternativt anropas ett icke-standardiserat inloggningsprogram i stället för _/bin/login_."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Optionally turns on hardware flow control."
msgstr "Valfritt att aktivera flödeskontroll för hårdvara."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Optionally forces the line to be local with no need for carrier detect."
msgstr "Om du vill kan du tvinga linjen att vara lokal utan att behöva använda carrier detect."

#. from tp:util-linux-man-2.41.2-rc1
msgid "This program does not use the _/etc/gettydefs_ (System V) or _/etc/gettytab_ (SunOS 4) files."
msgstr "Detta program använder inte filerna _/etc/gettydefs_ (System V) eller _/etc/gettytab_ (SunOS 4)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "_port_"
msgstr "port"

#. from tp:util-linux-man-2.41.2-rc1
msgid "A path name relative to the _/dev_ directory. If a \"-\" is specified, *agetty* assumes that its standard input is already connected to a tty port and that a connection to a remote user has already been established."
msgstr "Ett sökvägsnamn i förhållande till katalogen _/dev_. Om ett \"-\" anges antar *agetty* att dess standardinmatning redan är ansluten till en tty-port och att en anslutning till en fjärranvändare redan har upprättats."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Under System V, a \"-\" _port_ argument should be preceded by a \"--\"."
msgstr "Enligt System V ska ett \"-\" _port_-argument föregås av ett \"--\"."

#. from tp:util-linux-man-2.41.2-rc1
msgid "_baud_rate_,..."
msgstr "_baud_rate_,..."

#. from tp:util-linux-man-2.41.2-rc1
msgid "A comma-separated list of one or more baud rates. Each time *agetty* receives a BREAK character it advances through the list, which is treated as if it were circular."
msgstr "En kommaseparerad lista med en eller flera baudhastigheter. Varje gång *agetty* tar emot ett BREAK-tecken avancerar den genom listan, som behandlas som om den vore cirkulär."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Baud rates should be specified in descending order, so that the null character (Ctrl-@) can also be used for baud-rate switching."
msgstr "Baudhastigheterna bör anges i fallande ordning, så att nolltecknet (Ctrl-@) också kan användas för att byta baudrate."

#. from tp:util-linux-man-2.41.2-rc1
msgid "This argument is optional and unnecessary for *virtual terminals*."
msgstr "Detta argument är valfritt och onödigt för *virtuella terminaler*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The default for *serial terminals* is keep the current baud rate (see *--keep-baud*) and if unsuccessful then default to '9600'."
msgstr "Standardinställningen för *seriella terminaler* är att behålla den aktuella baudhastigheten (se *--keep-baud*) och om det inte lyckas så är standardinställningen '9600'."

#. from tp:util-linux-man-2.41.2-rc1
msgid "_term_"
msgstr "_term_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "The value to be used for the *TERM* environment variable. This overrides whatever *init*(1) may have set, and is inherited by login and the shell."
msgstr "Det värde som ska användas för miljövariabeln *TERM*. Detta åsidosätter vad *init*(1) kan ha ställt in, och ärvs av inloggning och skalet."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The default is 'vt100', or 'linux' for Linux on a virtual terminal, or 'hurd' for GNU Hurd on a virtual terminal."
msgstr "Standardvärdet är \"vt100\" eller \"linux\" för Linux på en virtuell terminal eller \"hurd\" för GNU Hurd på en virtuell terminal."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-8*, *--8bits*"
msgstr "*-8*, *--8bits*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Assume that the tty is 8-bit clean, hence disable parity detection."
msgstr "Antag att tty:n är 8-bitars ren och inaktivera därför paritetsdetektering."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-a*, *--autologin* _username_"
msgstr "*-a*, *--autologin* _username_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Automatically log in the specified user without asking for a username or password. Using this option causes an *-f* _username_ option and argument to be added to the */bin/login* command line. See *--login-options*, which can be used to modify this option's behavior."
msgstr "Loggar automatiskt in den angivna användaren utan att fråga efter användarnamn eller lösenord. Om du använder den här flaggan läggs flaggan *-f* _användarnamn_ och ett argument till på kommandoraden */bin/login*. Se *--login-options*, som kan användas för att ändra denna flaggas beteende."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Note that *--autologin* may affect the way in which *getty* initializes the serial line, because on auto-login *agetty* does not read from the line and it has no opportunity optimize the line setting."
msgstr "Observera att *--autologin* kan påverka hur *getty* initierar den seriella linjen, eftersom *agetty* inte läser från linjen vid auto-login och inte har någon möjlighet att optimera linjeinställningen."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-c*, *--noreset*"
msgstr "*-c*, *--noreset*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Do not reset terminal cflags (control modes). See *termios*(3) for more details."
msgstr "Återställ inte terminalens cflags (kontrollägen). Se *termios*(3) för mer information."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-E*, *--remote*"
msgstr "*-E*, *--remote*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Typically the *login*(1) command is given a remote hostname when called by something such as *telnetd*(8). This option allows *agetty* to pass what it is using for a hostname to *login*(1) for use in *utmp*(5). See *--host*, *login*(1), and *utmp*(5)."
msgstr "Vanligtvis får kommandot *login*(1) ett fjärrvärdsnamn när det anropas av t.ex. *telnetd*(8). Med den här flaggan kan *agetty* skicka det som används som värdnamn till *login*(1) för användning i *utmp*(5). Se *--host*, *login*(1) och *utmp*(5)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "If the *--host* _fakehost_ option is given, then an *-h* _fakehost_ option and argument are added to the _/bin/login_ command line."
msgstr "Om flaggan *--host* _fakehost_ anges, läggs flaggan *-h* _fakehost_ och argumentet till på kommandoraden _/bin/login_."

#. from tp:util-linux-man-2.41.2-rc1
msgid "If the *--nohostname* option is given, then an *-H* option is added to the */bin/login* command line."
msgstr "Om flaggan *--nohostname* anges, läggs flaggan *-H* till på kommandoraden */bin/login*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "See *--login-options*."
msgstr "Se *--login-options*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-f*, *--issue-file* _path_"
msgstr "*-f*, *--issue-file* _sökväg_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Specifies a \":\" delimited list of files and directories to be displayed instead of _/etc/issue_ (or other). All specified files and directories are displayed, missing or empty files are silently ignored. If the specified path is a directory then display all files with __.issue__ file extension in version-sort order from the directory. This allows custom messages to be displayed on different terminals. The *--noissue* option will override this option."
msgstr "Anger en \":\"-avgränsad lista med filer och kataloger som ska visas i stället för _/etc/issue_ (eller annat). Alla angivna filer och kataloger visas, filer som saknas eller är tomma ignoreras. Om den angivna sökvägen är en katalog visas alla filer med filändelsen __.issue__ i versionssorteringsordning från katalogen. Detta gör att anpassade meddelanden kan visas på olika terminaler. Flaggan *--noissue* åsidosätter denna flagga."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--show-issue*"
msgstr "*--show-issue*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Display the current issue file (or other) on the current terminal and exit. Use this option to review the current setting, it is not designed for any other purpose. Note that output may use some default or incomplete information as proper output depends on terminal and *agetty* command line."
msgstr "Visa aktuell issue-fil (eller annan) på den aktuella terminalen och avsluta. Använd den här flaggan för att granska den aktuella inställningen, det är inte avsett för något annat ändamål. Observera att utdata kan använda viss standardinformation eller ofullständig information eftersom korrekt utdata beror på terminal och *agetty*-kommandoraden."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-h, --flow-control*"
msgstr "*-h, --flow-control*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Enable hardware (RTS/CTS) flow control. It is left up to the application to disable software (XON/XOFF) flow protocol where appropriate."
msgstr "Aktivera flödeskontroll för hårdvara (RTS/CTS). Det är upp till applikationen att inaktivera flödesprotokoll för programvara (XON/XOFF) där så är lämpligt."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-H*, *--host* _fakehost_"
msgstr "*-H*, *--host* _fakehost_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Write the specified _fakehost_ into the utmp file. Normally, no login host is given, since *agetty* is used for local hardwired connections and consoles. However, this option can be useful for identifying terminal concentrators and the like."
msgstr "Skriv in den angivna _fakehost_ i utmp-filen. Normalt anges ingen inloggningsvärd, eftersom *agetty* används för lokala trådbundna anslutningar och konsoler. Den här flaggan kan dock vara användbar för att identifiera terminalkoncentratorer och liknande."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-i*, *--noissue*"
msgstr "*-i*, *--noissue*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Do not display the contents of _/etc/issue_ (or other) before writing the login prompt. Terminals or communications hardware may become confused when receiving lots of text at the wrong baud rate; dial-up scripts may fail if the login prompt is preceded by too much text."
msgstr "Visa inte innehållet i _/etc/issue_ (eller annat) innan du skriver inloggningsprompten. Terminaler eller kommunikationshårdvara kan bli förvirrade när de tar emot mycket text i fel baudhastighet; uppringda skript kan misslyckas om inloggningsprompten föregås av för mycket text."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-I*, *--init-string* _initstring_"
msgstr "*-I*, *--init-string* _initstring_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Set an initial string to be sent to the tty or modem before sending anything else. This may be used to initialize a modem. Non-printable characters may be sent by writing their octal code preceded by a backslash (\\). For example, to send a linefeed character (ASCII 10, octal 012), write \\12."
msgstr "Ställ in en initial sträng som ska skickas till tty eller modem innan något annat skickas. Detta kan användas för att initiera ett modem. Icke-tryckbara tecken kan skickas genom att deras oktalkod föregås av ett backslash (\\). Om du t.ex. vill skicka ett radmatningstecken (ASCII 10, oktal 012) skriver du \\12."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-J*, *--noclear*"
msgstr "*-J*, *--noclear*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Do not clear the screen before prompting for the login name. By default the screen is cleared."
msgstr "Töm inte skärmen innan du frågar efter inloggningsnamnet. Som standard rensas skärmen."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-l*, *--login-program* _login_program_"
msgstr "*-l*, *--login-program* _login_program_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Invoke the specified _login_program_ instead of /bin/login. This allows the use of a non-standard login program. Such a program could, for example, ask for a dial-up password or use a different password file. See *--login-options*."
msgstr "Anropar det angivna _login_programmet_ istället för /bin/login. Detta gör det möjligt att använda ett inloggningsprogram som inte är standard. Ett sådant program kan t.ex. be om ett uppringningslösenord eller använda en annan lösenordsfil. Se *--login-options*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-L*, *--local-line*[**=**__mode__]"
msgstr "*-L*, *--local-line*[**=**__läge__]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Control the CLOCAL line flag. The optional _mode_ argument is *auto*, *always* or *never*. If the _mode_ argument is omitted, then the default is *always*. If the *--local-line* option is not given at all, then the default is *auto*."
msgstr "Kontrollerar linjeflaggan CLOCAL. Det valfria _läge_-argumentet är *auto*, *always* eller *never*. Om argumentet _läge_ utelämnas är standardvärdet *always*. Om flaggan *--local-line* inte anges alls är standardvärdet *auto*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "_always_"
msgstr "_always_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Forces the line to be a local line with no need for carrier detect. This can be useful when you have a locally attached terminal where the serial line does not set the carrier-detect signal."
msgstr "Tvingar linjen att vara en lokal linje utan behov av bärvågsdetektering. Detta kan vara användbart när du har en lokalt ansluten terminal där den seriella linjen inte ställer in signalen för bärvågsdetektering."

#. from tp:util-linux-man-2.41.2-rc1
msgid "_never_"
msgstr "_never_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Explicitly clears the CLOCAL flag from the line setting and the carrier-detect signal is expected on the line."
msgstr "Rensar explicit CLOCAL-flaggan från linjeinställningen och den bärvågsdetekterande signalen förväntas på linjen."

#. from tp:util-linux-man-2.41.2-rc1
msgid "_auto_"
msgstr "_auto_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "The *agetty* default. Does not modify the CLOCAL setting and follows the setting enabled by the kernel."
msgstr "Den *goda* standardinställningen. Ändrar inte CLOCAL-inställningen och följer den inställning som aktiveras av kärnan."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-m*, *--extract-baud*"
msgstr "*-m*, *--extract-baud*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Try to extract the baud rate from the CONNECT status message produced by Hayes(tm)-compatible modems. These status messages are of the form: \"<junk><speed><junk>\". *agetty* assumes that the modem emits its status message at the same speed as specified with (the first) _baud_rate_ value on the command line."
msgstr "Försök att utläsa baudhastigheten ur statusmeddelandet CONNECT som produceras av Hayes(tm)-kompatibla modem. Dessa statusmeddelanden är av formen: \"<junk><speed><junk>\". *agetty* förutsätter att modemet sänder ut sitt statusmeddelande med samma hastighet som anges med (det första) _baud_rate_-värdet på kommandoraden."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Since the *--extract-baud* feature may fail on heavily-loaded systems, you still should enable BREAK processing by enumerating all expected baud rates on the command line."
msgstr "Eftersom funktionen *--extract-baud* kan misslyckas på tungt belastade system, bör du ändå aktivera BREAK-behandling genom att räkna upp alla förväntade baudhastigheter på kommandoraden."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--list-speeds*"
msgstr "*--list-speeds*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Display supported baud rates. These are determined at compilation time."
msgstr "Visar stödda baudhastigheter. Dessa bestäms vid kompileringstillfället."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-n*, *--skip-login*"
msgstr "*-n*, *--skip-login*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Do not prompt the user for a login name. This can be used in connection with the *--login-program* option to invoke a non-standard login process such as a BBS system. Note that with the *--skip-login* option, *agetty* gets no input from the user who logs in and therefore will not be able to figure out parity, character size, and newline processing of the connection. It defaults to space parity, 7 bit characters, and ASCII CR (13) end-of-line character. Beware that the program that *agetty* starts (usually /bin/login) is run as root."
msgstr "Fråga inte användaren efter ett inloggningsnamn. Detta kan användas i samband med flaggan *--login-program* för att starta en icke-standardiserad inloggningsprocess, t.ex. ett BBS-system. Observera att med flaggan *--skip-login* får *agetty* ingen information från den användare som loggar in och kan därför inte räkna ut paritet, teckenstorlek och newline-behandling för anslutningen. Standardinställningen är mellanslagsparitet, 7-bitars tecken och ASCII CR (13) som tecken i slutet av raden. Tänk på att det program som *agetty* startar (vanligtvis /bin/login) körs som root."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-N*, *--nonewline*"
msgstr "*-N*, *--nonewline*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Do not print a newline before writing out _/etc/issue_."
msgstr "Skriv inte ut en ny rad innan du skriver ut _/etc/issue_."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-o*, *--login-options* _login_options_"
msgstr "*-o*, *--login-options* _login_options_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Options and arguments that are passed to *login*(1). Where \\u is replaced by the login name. For example:"
msgstr "Flaggor och argument som skickas till *login*(1). Där \\u ersätts av inloggningsnamnet. Till exempel:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--login-options '-h darkstar \\-- \\u'*"
msgstr "*--login-options '-h darkstar \\-- \\u'*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "See *--autologin*, *--login-program* and *--remote*."
msgstr "Se *--autologin*, *--inloggningsprogram* och *--remote*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Please read the *SECURITY NOTICE* below before using this option."
msgstr "Läs *SÄKERHETSANMÄRKNING* nedan innan du använder denna flagga."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-p*, *--login-pause*"
msgstr "*-p*, *--login-pause*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Wait for any key before dropping to the login prompt. Can be combined with *--autologin* to save memory by lazily spawning shells."
msgstr "Vänta på en tangent innan du går till inloggningsprompten. Kan kombineras med *--autologin* för att spara minne genom att slentrianmässigt skapa skal."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-r*, *--chroot* _directory_"
msgstr "*-r*, *--chroot* _katalog_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Change root to the specified directory."
msgstr "Byt rot till den angivna katalogen."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-R*, *--hangup*"
msgstr "*-R*, *--hangup*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Call *vhangup*(2) to do a virtual hangup of the specified terminal."
msgstr "Ring *vhangup*(2) för att göra en virtuell upphängning av den angivna terminalen."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-s*, *--keep-baud*"
msgstr "*-s*, *--keep-baud*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Try to keep the existing baud rate. The baud rates from the command line are used when *agetty* receives a BREAK character. If another baud rates specified then the original baud rate is also saved to the end of the wanted baud rates list. This can be used to return to the original baud rate after unexpected BREAKs."
msgstr "Försök att behålla den befintliga baudhastigheten. Baudhastigheterna från kommandoraden används när *agetty* tar emot ett BREAK-tecken. Om en annan baudhastighet anges sparas även den ursprungliga baudhastigheten i slutet av listan över önskade baudhastigheter. Detta kan användas för att återgå till den ursprungliga baudhastigheten efter oväntade BREAKs."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-t*, *--timeout* _timeout_"
msgstr "*-t*, *--timeout* _tidsgräns_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Terminate if no user name could be read within _timeout_ seconds. Use of this option with hardwired terminal lines is not recommended."
msgstr "Avsluta om inget användarnamn kunde läsas inom _tidsgräns_ sekunder. Användning av denna flagga med fast anslutna terminallinjer rekommenderas inte."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-U*, *--detect-case*"
msgstr "*-U*, *--detect-case*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Turn on support for detecting an uppercase-only terminal. This setting will detect a login name containing only capitals as indicating an uppercase-only terminal and turn on some upper-to-lower case conversions. Note that this has no support for any Unicode characters."
msgstr "Aktivera stöd för att upptäcka en terminal med enbart versaler. Den här inställningen kommer att upptäcka att ett inloggningsnamn som bara innehåller versaler indikerar en terminal med enbart versaler och aktivera vissa konverteringar från versaler till gemener. Observera att detta inte har något stöd för några Unicode-tecken."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-w*, *--wait-cr*"
msgstr "*-w*, *--wait-cr*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Wait for the user or the modem to send a carriage-return or a linefeed character before sending the _/etc/issue_ file (or others) and the login prompt. This is useful with the *--init-string* option."
msgstr "Vänta på att användaren eller modemet skickar en carriage-return eller ett linefeed-tecken innan filen _/etc/issue_ (eller andra) och inloggningsprompten skickas. Detta är användbart med flaggan *--init-string*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--nohints*"
msgstr "*--nohints*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Do not print hints about Num, Caps and Scroll Locks."
msgstr "Skriv inte ut tips om Num-, Caps- och Scroll-lås."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--nohostname*"
msgstr "*--nohostname*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "By default the hostname will be printed. With this option enabled, no hostname at all will be shown. This setting is also possible to able by LOGIN_PLAIN_PROMPT option in the _/etc/login.defs_ configuration file (see below for more details)."
msgstr "Som standard kommer värdnamnet att skrivas ut. Om den här flaggan är aktiverat visas inget värdnamn alls. Den här inställningen är också möjlig att göra med flaggan LOGIN_PLAIN_PROMPT i konfigurationsfilen _/etc/login.defs_ (se nedan för mer information)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--long-hostname*"
msgstr "*--long-hostname*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "By default the hostname is only printed until the first dot. With this option enabled, the fully qualified hostname by *gethostname*(3P) or (if not found) by *getaddrinfo*(3) is shown."
msgstr "Som standard skrivs värdnamnet bara ut fram till den första punkten. Om den här flaggan är aktiverat visas det fullständigt kvalificerade värdnamnet med *gethostname*(3P) eller (om det inte hittas) med *getaddrinfo*(3)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--erase-chars* _string_"
msgstr "*--erase-chars* _sträng_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "This option specifies additional characters that should be interpreted as a backspace (\"ignore the previous character\") when the user types the login name. The default additional 'erase' has been '#', but since util-linux 2.23 no additional erase characters are enabled by default."
msgstr "Den här flaggan anger ytterligare tecken som ska tolkas som ett backsteg (\"ignorera föregående tecken\") när användaren skriver inloggningsnamnet. Standardvärdet för ytterligare \"erase\" har varit \"#\", men sedan util-linux 2.23 aktiveras inga ytterligare erase-tecken som standard."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--kill-chars* _string_"
msgstr "*--kill-chars* _sträng_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "This option specifies additional characters that should be interpreted as a kill (\"ignore all previous characters\") when the user types the login name. The default additional 'kill' has been '@', but since util-linux 2.23 no additional kill characters are enabled by default."
msgstr "Den här flaggan anger ytterligare tecken som ska tolkas som en kill (\"ignorera alla tidigare tecken\") när användaren skriver inloggningsnamnet. Standardvärdet för ytterligare \"kill\" har varit \"@\", men sedan util-linux 2.23 är inga ytterligare \"kill\"-tecken aktiverade som standard."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--chdir* _directory_"
msgstr "*--chdir* _katalog_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Change directory before the login."
msgstr "Byt katalog före inloggningen."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--delay* _number_"
msgstr "*--delay* _nummer_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Sleep seconds before open tty."
msgstr "Sova några sekunder innan tty öppnas."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--nice* _number_"
msgstr "*--nice* _nummer_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Run login with this priority."
msgstr "Kör inloggning med denna prioritet."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--reload*"
msgstr "*--reload*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Ask all running *agetty* instances to reload and update their displayed prompts, if the user has not yet commenced logging in. After doing so the command will exit. This feature might be unsupported on systems without Linux *inotify*(7)."
msgstr "Be alla *agetty*-instanser som körs att ladda om och uppdatera de meddelanden som visas, om användaren ännu inte har börjat logga in. När detta har gjorts avslutas kommandot. Den här funktionen kanske inte stöds på system utan Linux *inotify*(7)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*agetty* reads the _/etc/login.defs_ configuration file (see *login.defs*(5)).  Note that the configuration file could be distributed with another package (usually shadow-utils).  The following configuration items are relevant for *agetty*:"
msgstr "*agetty* läser konfigurationsfilen _/etc/login.defs_ (se *login.defs*(5)).  Observera att konfigurationsfilen kan distribueras med ett annat paket (vanligtvis shadow-utils).  Följande konfigurationsobjekt är relevanta för *agetty*:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Tell *agetty* that printing the hostname should be suppressed in the login: prompt. This is an alternative to the *--nohostname* command line option. The default value is _no_."
msgstr "Berätta för *agetty* att utskrift av värdnamnet ska undertryckas i login: prompten. Detta är ett alternativ till kommandoradsflaggan *--nohostname*. Standardvärdet är _no_."

#. from tp:util-linux-man-2.41.2-rc1
msgid "This section shows examples for the process field of an entry in the _/etc/inittab_ file. You'll have to prepend appropriate values for the other fields. See *inittab*(5) for more details."
msgstr "I det här avsnittet visas exempel på processfältet i en post i filen _/etc/inittab_. Du måste ange lämpliga värden för de andra fälten. Se *inittab*(5) för mer information."

#. from tp:util-linux-man-2.41.2-rc1
msgid "For a hardwired line or a console tty:"
msgstr "För en kabelansluten linje eller en konsol-tty:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*/sbin/agetty 9600 ttyS1*"
msgstr "*/sbin/agetty 9600 ttyS1*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "For a directly connected terminal without proper carrier-detect wiring (try this if your terminal just sleeps instead of giving you a password: prompt):"
msgstr "För en direktansluten terminal utan korrekt kabeldragning för bärvågsdetektering (prova detta om din terminal bara sover i stället för att ge dig ett lösenord: prompt):"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*/sbin/agetty --local-line 9600 ttyS1 vt100*"
msgstr "*/sbin/agetty --local-line 9600 ttyS1 vt100*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "For an old-style dial-in line with a 9600/2400/1200 baud modem:"
msgstr "För en gammaldags uppringd linje med ett modem på 9600/2400/1200 baud:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*/sbin/agetty --extract-baud --timeout 60 ttyS1 9600,2400,1200*"
msgstr "*/sbin/agetty --extract-baud --timeout 60 ttyS1 9600,2400,1200*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "For a Hayes modem with a fixed 115200 bps interface to the machine (the example init string turns off modem echo and result codes, makes modem/computer DCD track modem/modem DCD, makes a DTR drop cause a disconnection, and turns on auto-answer after 1 ring):"
msgstr "För ett Hayes-modem med ett fast 115200 bps-gränssnitt till maskinen (exemplets init-sträng stänger av modemeko och resultatkoder, gör att modem/dator DCD följer modem/modem DCD, gör att ett DTR-fall orsakar en frånkoppling och aktiverar autosvar efter 1 ringning):"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*/sbin/agetty --wait-cr --init-string 'ATE0Q1&D2&C1S0=1\\015' 115200 ttyS1*"
msgstr "*/sbin/agetty --wait-cr --init-string 'ATE0Q1&D2&C1S0=1\\015' 115200 ttyS1*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "SECURITY NOTICE"
msgstr "SÄKERHETSMEDDELANDE"

#. from tp:util-linux-man-2.41.2-rc1
msgid "If you use the *--login-program* and *--login-options* options, be aware that a malicious user may try to enter lognames with embedded options, which then get passed to the used login program. *agetty* does check for a leading \"-\" and makes sure the logname gets passed as one parameter (so embedded spaces will not create yet another parameter), but depending on how the login binary parses the command line that might not be sufficient. Check that the used login program cannot be abused this way."
msgstr "Om du använder flaggorna *--login-program* och *--login-options* bör du vara medveten om att en illvillig användare kan försöka ange loggnamn med inbäddade alternativ, som sedan skickas till det inloggningsprogram som används. *agetty* kontrollerar om det finns ett inledande \"-\" och ser till att loggnamnet skickas som en parameter (så att inbäddade mellanslag inte skapar ytterligare en parameter), men beroende på hur inloggningsbinärprogrammet analyserar kommandoraden kanske det inte är tillräckligt. Kontrollera att det inloggningsprogram som används inte kan missbrukas på det här sättet."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Some programs use \"--\" to indicate that the rest of the command line should not be interpreted as options. Use this feature if available by passing \"--\" before the username gets passed by \\u."
msgstr "Vissa program använder \"--\" för att ange att resten av kommandoraden inte ska tolkas som flaggor. Använd denna funktion om den är tillgänglig genom att skicka \"--\" innan användarnamnet skickas vidare till \\u."

#. from tp:util-linux-man-2.41.2-rc1
msgid "ISSUE FILES"
msgstr "FRÅGESTÄLLNING FILER"

#. from tp:util-linux-man-2.41.2-rc1
msgid "The default issue file is _/etc/issue_. If the file exists, then *agetty* also checks for _/etc/issue.d_ directory. The directory is optional extension to the default issue file and content of the directory is printed after _/etc/issue_ content. If the _/etc/issue_ does not exist, then the directory is ignored. All files *with .issue extension* from the directory are printed in version-sort order. The directory can be used to maintain 3rd-party messages independently on the primary system _/etc/issue_ file."
msgstr "Standardutgåvofilen är _/etc/issue_. Om filen finns kontrollerar *agetty* även om katalogen _/etc/issue.d_ finns. Katalogen är ett valfritt tillägg till standardutgåvofilen och innehållet i katalogen skrivs ut efter innehållet i _/etc/issue_. Om _/etc/issue_ inte finns ignoreras katalogen. Alla filer *med .issue-tillägg* från katalogen skrivs ut i versionssorterad ordning. Katalogen kan användas för att underhålla meddelanden från tredje part oberoende av det primära systemets _/etc/issue_-fil."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Since version 2.35, additional locations for the issue file and directory are supported. *agetty* checks for the files _/run/issue_ and _/run/issue.d_, and then for _/usr/lib/issue_ and _/usr/lib/issue.d_. The directory _/etc_ is expected for host-specific configuration, _/run_ is expected for generated content, and _/usr/lib_ is used for static configuration maintained by the distribution."
msgstr "Sedan version 2.35 stöds ytterligare platser för issue-filen och -katalogen. *agetty* söker efter filerna _/run/issue_ och _/run/issue.d_ och sedan efter _/usr/lib/issue_ och _/usr/lib/issue.d_. Katalogen _/etc_ förväntas innehålla värdspecifik konfiguration, _/run_ förväntas innehålla genererat innehåll och _/usr/lib_ används för statisk konfiguration som underhålls av distributionen."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Note that in versions 2.35 to 2.40, the additional locations were only read if the default _/etc/issue_ file did not exist. However, since version 2.41, the additional locations are always read, regardless of the existence of the _/etc/issue_ file. This change allows for the generation of issue files by default."
msgstr "Observera att i versionerna 2.35 till 2.40 lästes de ytterligare platserna endast om standardfilen _/etc/issue_ inte fanns. Men sedan version 2.41 läses de ytterligare platserna alltid, oavsett om filen _/etc/issue_ finns eller inte. Denna ändring gör det möjligt att generera issue-filer som standard."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The default paths maybe completely overridden by *--issue-file* option. In this case specified path has to be file or directory and all the default issue file and directory locations are ignored."
msgstr "Standardsökvägarna kan åsidosättas helt med flaggan *--issue-file*. I detta fall måste den angivna sökvägen vara en fil eller katalog och alla standardplatser för issue-filer och -kataloger ignoreras."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The issue file feature can be completely disabled by *--noissue* option."
msgstr "Funktionen för problemfiler kan inaktiveras helt med flaggan *--noissue*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "It is possible to review the current issue file by *agetty --show-issue* on the current terminal."
msgstr "Det är möjligt att granska den aktuella utgivningsfilen genom *agetty --show-issue* på den aktuella terminalen."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The issue files may contain certain escape codes to display the system name, date, time et cetera. All escape codes consist of a backslash (\\) immediately followed by one of the characters listed below."
msgstr "Emissionsfilerna kan innehålla vissa escape-koder för att visa systemnamn, datum, tid etc. Alla escape-koder består av ett backslash (\\) omedelbart följt av något av de tecken som anges nedan."

#. from tp:util-linux-man-2.41.2-rc1
msgid "4 or 4{_interface_}"
msgstr "4 eller 4{_interface_}"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Insert the IPv4 address of the specified network interface (for example: \\4\\{eth0}). If the _interface_ argument is not specified, then select the first fully configured (UP, non-LOCALBACK, RUNNING) interface. If no configured interface is found, fall back to the IP address of the machine's hostname."
msgstr "Ange IPv4-adressen för det angivna nätverksgränssnittet (t.ex. \\4\\{eth0}). Om argumentet _interface_ inte anges, väljs det första fullt konfigurerade (UP, non-LOCALBACK, RUNNING) gränssnittet. Om inget konfigurerat gränssnitt hittas, faller du tillbaka till IP-adressen för maskinens värdnamn."

#. from tp:util-linux-man-2.41.2-rc1
msgid "6 or 6{_interface_}"
msgstr "6 eller 6{_interface_}"

#. from tp:util-linux-man-2.41.2-rc1
msgid "The same as \\4 but for IPv6."
msgstr "Samma sak som \\4 men för IPv6."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Insert the baudrate of the current line."
msgstr "Infoga baudrate för den aktuella raden."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Insert the current date."
msgstr "Infoga aktuellt datum."

#. from tp:util-linux-man-2.41.2-rc1
msgid "e or e{_name_}"
msgstr "e eller e{_name_}"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Translate the human-readable _name_ to an escape sequence and insert it (for example: \\e{red}Alert text.\\e{reset}). If the _name_ argument is not specified, then insert \\033. The currently supported names are: black, blink, blue, bold, brown, cyan, darkgray, gray, green, halfbright, lightblue, lightcyan, lightgray, lightgreen, lightmagenta, lightred, magenta, red, reset, reverse, yellow and white. All unknown names are silently ignored."
msgstr "Översätt det mänskligt läsbara _namn_ till en escape-sekvens och infoga den (t.ex.: \\e{red}Alert text.\\e{reset}). Om argumentet _namn_ inte har angetts infogas \\033. De namn som för närvarande stöds är: svart, blink, blå, fet, brun, cyan, mörkgrå, grå, grön, halvljus, ljusblå, ljuscyan, ljusgrå, ljusgrön, ljusmagenta, ljusröd, magenta, röd, reset, reverse, gul och vit. Alla okända namn ignoreras i tysthet."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Insert the system name (the name of the operating system). Same as 'uname -s'. See also the \\S escape code."
msgstr "Infoga systemnamnet (namnet på operativsystemet). Samma som \"uname -s\". Se även escape-koden \\S."

#. from tp:util-linux-man-2.41.2-rc1
msgid "S or S{VARIABLE}"
msgstr "S eller S{VARIABLE}"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Insert the VARIABLE data from _/etc/os-release_. If this file does not exist then fall back to _/usr/lib/os-release_. If the VARIABLE argument is not specified, then use PRETTY_NAME from the file or the system name (see \\s). This escape code can be used to keep _/etc/issue_ distribution and release independent. Note that \\S{ANSI_COLOR} is converted to the real terminal escape sequence."
msgstr "Infoga VARIABLE-data från _/etc/os-release_. Om denna fil inte finns, återgår man till _/usr/lib/os-release_. Om VARIABLE-argumentet inte anges används PRETTY_NAME från filen eller systemnamnet (se \\s). Denna escape code kan användas för att hålla distributionen av _/etc/issue_ och releasen oberoende av varandra. Observera att \\S{ANSI_COLOR} konverteras till den riktiga terminalens escape-sekvens."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Insert the name of the current tty line."
msgstr "Infoga namnet på den aktuella tty-linjen."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Insert the architecture identifier of the machine. Same as *uname -m*."
msgstr "Infoga maskinens arkitekturidentifierare. Samma som *uname -m*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Insert the nodename of the machine, also known as the hostname. Same as *uname -n*."
msgstr "Ange maskinens nodnamn, även känt som värdnamnet. Samma som *uname -n*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Insert the NIS domainname of the machine. Same as *hostname -d*."
msgstr "Ange NIS-domännamnet för maskinen. Samma som *hostname -d*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Insert the DNS domainname of the machine."
msgstr "Ange maskinens DNS-domännamn."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Insert the release number of the OS. Same as *uname -r*."
msgstr "Ange versionsnumret för operativsystemet. Samma som *uname -r*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Insert the current time."
msgstr "Ange aktuell tid."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Insert the number of current users logged in."
msgstr "Ange antalet användare som är inloggade för närvarande."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Insert the string \"1 user\" or \"<n> users\" where <n> is the number of current users logged in."
msgstr "Infoga strängen \"1 user\" eller \"<n> users\" där <n> är antalet inloggade användare för närvarande."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Insert the version of the OS, that is, the build-date and such."
msgstr "Ange versionen av operativsystemet, det vill säga byggdatum och liknande."

#. from tp:util-linux-man-2.41.2-rc1
msgid "An example. On my system, the following _/etc/issue_ file:"
msgstr "Ett exempel. På mitt system finns följande fil _/etc/issue_:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "This is \\n.\\o (\\s \\m \\r) \\t\n"
msgstr "Detta är \\n.\\o (\\s \\m \\r) \\t\n"

#. from tp:util-linux-man-2.41.2-rc1
msgid "displays as:"
msgstr "visas som:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "This is thingol.orcan.dk (Linux i386 1.1.9) 18:29:30\n"
msgstr "Detta är thingol.orcan.dk (Linux i386 1.1.9) 18:29:30\n"

#. from tp:util-linux-man-2.41.2-rc1
msgid "_/var/run/utmp_"
msgstr "_/var/run/utmp_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "the system status file."
msgstr "systemstatusfilen."

#. from tp:util-linux-man-2.41.2-rc1
msgid "_/etc/issue_"
msgstr "_/etc/issue_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "printed before the login prompt."
msgstr "skrivs ut före inloggningsuppmaningen."

#. from tp:util-linux-man-2.41.2-rc1
msgid "_/etc/os-release /usr/lib/os-release_"
msgstr "_/etc/os-release /usr/lib/os-release"

#. from tp:util-linux-man-2.41.2-rc1
msgid "operating system identification data."
msgstr "identifieringsdata för operativsystemet."

#. from tp:util-linux-man-2.41.2-rc1
msgid "_/dev/console_"
msgstr "_/dev/konsol"

#. from tp:util-linux-man-2.41.2-rc1
msgid "problem reports (if *syslog*(3) is not used)."
msgstr "problemrapporter (om *syslog*(3) inte används)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "_/etc/inittab_"
msgstr "_/etc/inittab_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*init*(8) configuration file for SysV-style init daemon."
msgstr "*init*(8) Konfigurationsfil för SysV-liknande init-daemon."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*agetty* supports configuration via systemd credentials (see https://systemd.io/CREDENTIALS/). *agetty* reads the following systemd credentials:"
msgstr "*agetty* stöder konfiguration via systemd-autentiseringsuppgifter (se https://systemd.io/CREDENTIALS/). *agetty* läser följande systemd-autentiseringsuppgifter:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*agetty.autologin* (string)"
msgstr "*agetty.autologin* (sträng)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "If set, configures *agetty* to automatically log in the specified user without asking for a username or password, similarly to the *--autologin* option."
msgstr "Om den är inställd konfigurerar *agetty* att automatiskt logga in den angivna användaren utan att fråga efter användarnamn eller lösenord, på samma sätt som med flaggan *--autologin*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The baud-rate detection feature (the *--extract-baud* option) requires that *agetty* be scheduled soon enough after completion of a dial-in call (within 30 ms with modems that talk at 2400 baud). For robustness, always use the *--extract-baud* option in combination with a multiple baud rate command-line argument, so that BREAK processing is enabled."
msgstr "Funktionen för baudhastighetsdetektering (flaggan *--extract-baud*) kräver att *agetty* schemaläggs tillräckligt snart efter att ett uppringt samtal har avslutats (inom 30 ms med modem som talar med 2400 baud). För robusthetens skull bör du alltid använda flaggan *--extract-baud* i kombination med ett kommandoradsargument för flera baudhastigheter, så att BREAK-behandling aktiveras."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The text in the _/etc/issue_ file (or other) and the login prompt are always output with 7-bit characters and space parity."
msgstr "Texten i filen _/etc/issue_ (eller annan) och inloggningsprompten matas alltid ut med 7-bitars tecken och mellanslagsparitet."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The baud-rate detection feature (the *--extract-baud* option) requires that the modem emits its status message _after_ raising the DCD line."
msgstr "Funktionen för detektering av baudhastighet (flaggan *--extract-baud*) kräver att modemet sänder ut sitt statusmeddelande _efter_ att DCD-linjen har lyfts."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Depending on how the program was configured, all diagnostics are written to the console device or reported via the *syslog*(3) facility. Error messages are produced if the _port_ argument does not specify a terminal device; if there is no utmp entry for the current process (System V only); and so on."
msgstr "Beroende på hur programmet har konfigurerats skrivs all diagnostik till konsolenheten eller rapporteras via *syslog*(3)-funktionen. Felmeddelanden genereras om argumentet _port_ inte anger en terminalenhet, om det inte finns någon utmp-post för den aktuella processen (endast System V), och så vidare."

#. from tp:util-linux-man-2.41.2-rc1
msgid "mailto:werner@suse.de[Werner Fink], mailto:kzak@redhat.com[Karel Zak]"
msgstr "mailto:werner@suse.de[Werner Fink], mailto:kzak@redhat.com[Karel Zak]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "The original *agetty* for serial terminals was written by mailto:wietse@wzv.win.tue.nl[W.Z. Venema] and ported to Linux by mailto:poe@daimi.aau.dk[Peter Orbaek]."
msgstr "Den ursprungliga *agetty* för seriella terminaler skrevs av mailto:wietse@wzv.win.tue.nl[W.Z. Venema] och portades till Linux av mailto:poe@daimi.aau.dk[Peter Orbaek]."

#. from tp:util-linux-man-2.41.2-rc1
msgid "mesg(1)"
msgstr "mesg(1)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "mesg - display (or do not display) messages from other users"
msgstr "mesg - visa (eller inte visa) meddelanden från andra användare"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*mesg* [_option_] [*n*|*y*]"
msgstr "*mesg* [_option_] [*n*|*y*]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "The *mesg* utility is invoked by a user to control write access others have to the terminal device associated with standard error output. If write access is allowed, then programs such as *talk*(1) and *write*(1) may display messages on the terminal."
msgstr "Verktyget *mesg* anropas av en användare för att kontrollera skrivåtkomst som andra har till den terminalenhet som är associerad med standardfelutmatningen. Om skrivåtkomst tillåts kan program som *talk*(1) och *write*(1) visa meddelanden på terminalen."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Traditionally, write access is allowed by default. However, as users become more conscious of various security risks, there is a trend to remove write access by default, at least for the primary login shell."
msgstr "Traditionellt är skrivåtkomst tillåten som standard. Men i takt med att användarna blir mer medvetna om olika säkerhetsrisker finns det en trend att ta bort skrivåtkomst som standard, åtminstone för det primära inloggningsskalet."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The initial permissions for the terminal are set by *login*(1) according to TTYPERM and TTYGROUP from /etc/login.defs. The default is mode _0620_ if a tty group is used, and _0600_ without the group. The default tty group name is \"tty\"."
msgstr "De initiala behörigheterna för terminalen sätts av *login*(1) enligt TTYPERM och TTYGROUP från /etc/login.defs. Standardinställningen är läge _0620_ om en tty-grupp används, och _0600_ utan grupp. Standardnamnet för tty-gruppen är \"tty\"."

#. from tp:util-linux-man-2.41.2-rc1
msgid "To ensure that your ttys are set in a portable and independent manner from system settings, *mesg* should be executed in your login scripts."
msgstr "För att säkerställa att dina ttys ställs in på ett portabelt och oberoende sätt från systeminställningarna bör *mesg* köras i dina inloggningsskript."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*mesg* modifies the write permissions for a group on the current terminal device. Since version 2.41, *mesg* can no longer be compiled to make the terminal writable for _others_ and strictly modifies only _group_ permissions.  The usual setup is to use a \"tty\" group and add relevant users to this group.  Alternatively, a less secure solution is to set utilities like *write*(1) or *wall*(1) to setgid for the \"tty\" group."
msgstr "*mesg* ändrar skrivrättigheterna för en grupp på den aktuella terminalenheten. Sedan version 2.41 kan *mesg* inte längre kompileras för att göra terminalen skrivbar för _andra_ och ändrar strikt endast _grupp_-behörigheter.  Den vanliga inställningen är att använda en \"tty\"-grupp och lägga till relevanta användare i denna grupp.  Alternativt, en mindre säker lösning, är att ställa in verktyg som *write*(1) eller *wall*(1) till setgid för gruppen \"tty\"."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The *mesg* utility silently exits with error status 2 if not executed on a terminal. In this case executing *mesg* is pointless. The command line option *--verbose* forces *mesg* to print a warning in this situation. This behaviour has been introduced in version 2.33."
msgstr "Verktyget *mesg* avslutas i tysthet med felstatus 2 om det inte körs på en terminal. I detta fall är det meningslöst att köra *mesg*. Kommandoradsflaggan *--verbose* tvingar *mesg* att skriva ut en varning i den här situationen. Detta beteende har införts i version 2.33."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Disallow messages."
msgstr "Avvisa meddelanden."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*y*"
msgstr "*y*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Allow messages to be displayed."
msgstr "Tillåt att meddelanden visas."

#. from tp:util-linux-man-2.41.2-rc1
msgid "If no arguments are given, *mesg* shows the current message status on standard error output."
msgstr "Om inga argument anges visar *mesg* den aktuella meddelandestatusen på standardfelutmatningen."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The *mesg* utility exits with one of the following values:"
msgstr "Verktyget *mesg* avslutas med något av följande värden:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Messages are allowed."
msgstr "Meddelanden är tillåtna."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Messages are not allowed."
msgstr "Meddelanden är inte tillåtna."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*>1*"
msgstr "*>1*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "An error has occurred."
msgstr "Ett fel har inträffat."

#. from tp:util-linux-man-2.41.2-rc1
msgid "_/dev/[pt]ty*_, _/dev/pts/[0-9]*_"
msgstr "_/dev/[pt]ty*_, _/dev/pts/[0-9]*_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*mesg* (I) appears in the UNIX Programmer's Manual.  It used to invert the current state with no argument before Version 7 AT&T UNIX."
msgstr "*mesg* (I) förekommer i UNIX Programmer's Manual.  Det brukade invertera det aktuella tillståndet utan argument före version 7 AT&T UNIX."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*login*(1), *talk*(1), *write*(1), *wall*(1), *xterm*(1)"
msgstr "*login*(1), *talk*(1), *write*(1), *wall*(1), *xterm*(1)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "script(1)"
msgstr "script(1)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "script - make typescript of terminal session"
msgstr "script - skapa ett maskinskrivet manus av terminalsessionen"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*script* [options] [_file_]"
msgstr "*script* [flaggor] [_fil_]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*script* makes a typescript of everything on your terminal session. The terminal data are stored in raw form to the log file and information about timing to another (optional) structured log file. The timing log file is necessary to replay the session later by *scriptreplay*(1) and to store additional information about the session."
msgstr "*script* gör ett typskript av allt som händer i din terminalsession. Terminaldata lagras i rå form i loggfilen och information om timing i en annan (valfri) strukturerad loggfil. Loggfilen med tidsangivelser behövs för att senare kunna spela upp sessionen med *scriptreplay*(1) och för att lagra ytterligare information om sessionen."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Since version 2.35, *script* supports multiple streams and allows the logging of input and output to separate files or all the one file. This version also supports a new timing file which records additional information. The command *scriptreplay --summary* then provides all the information."
msgstr "Sedan version 2.35 har *script* stöd för flera strömmar och gör det möjligt att logga in- och utdata i separata filer eller i en och samma fil. Den här versionen stöder också en ny timingfil som registrerar ytterligare information. Kommandot *scriptreplay --summary* ger då all information."

#. from tp:util-linux-man-2.41.2-rc1
msgid "If the argument _file_ or option *--log-out* _file_ is given, *script* saves the dialogue in this _file_. If no filename is given, the dialogue is saved in the file _typescript_."
msgstr "Om argumentet _fil_ eller flaggan *--log-out* _fil_ anges, sparar *script* dialogen i denna _fil_. Om inget filnamn anges sparas dialogen i filen _typescript_."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Note that logging input using *--log-in* or *--log-io* may record security-sensitive information as the log file contains all terminal session input (e.g., passwords) independently of the terminal echo flag setting."
msgstr "Observera att loggning av inmatning med *--log-in* eller *--log-io* kan registrera säkerhetskänslig information eftersom loggfilen innehåller all inmatning från terminalsessionen (t.ex. lösenord) oberoende av inställningen för terminalens ekoflagga."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Below, the _size_ argument may be followed by the multiplicative suffixes KiB (=1024), MiB (=1024*1024), and so on for GiB, TiB, PiB, EiB, ZiB and YiB (the \"iB\" is optional, e.g., \"K\" has the same meaning as \"KiB\"), or the suffixes KB (=1000), MB (=1000*1000), and so on for GB, TB, PB, EB, ZB and YB."
msgstr "Nedan kan _storlek_-argumentet följas av de multiplikativa suffixen KiB (=1024), MiB (=1024*1024), och så vidare för GiB, TiB, PiB, EiB, ZiB och YiB (\"iB\" är valfritt, t.ex. har \"K\" samma betydelse som \"KiB\"), eller suffixen KB (=1000), MB (=1000*1000), och så vidare för GB, TB, PB, EB, ZB och YB."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Append the output to _file_ or to _typescript_, retaining the prior contents."
msgstr "Lägg till utdata till _fil_ eller till _typescript_, med bibehållande av tidigare innehåll."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Run the _command_ rather than an interactive shell. This makes it easy for a script to capture the output of a program that behaves differently when its stdout is not a tty."
msgstr "Kör _kommandot_ i stället för ett interaktivt skal. Detta gör det enkelt för ett skript att fånga upp utdata från ett program som beter sig annorlunda när dess stdout inte är en tty."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-E*, *--echo* _when_"
msgstr "*-E*, *--echo* _när_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "This option controls the *ECHO* flag for the slave end of the session's pseudoterminal. The supported modes are _always_, _never_, or _auto_."
msgstr "Denna flagga styr flaggan *ECHO* för slavänden av sessionens pseudoterminal. De lägen som stöds är _always_, _never_ eller _auto_."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The default is _auto_ -- in this case, *ECHO* enabled for the pseudoterminal slave; if the current standard input is a terminal, *ECHO* is disabled for it to prevent double echo; if the current standard input is not a terminal (for example pipe: *echo date | script*) then keeping *ECHO* enabled for the pseudoterminal slave enables the standard input data to be viewed on screen while being recorded to session log simultaneously."
msgstr "Standardinställningen är _auto_ - i det här fallet är *ECHO* aktiverat för pseudoterminalens slav; om den aktuella standardinmatningen är en terminal inaktiveras *ECHO* för att förhindra dubbeleko; om den aktuella standardinmatningen inte är en terminal (t.ex. pipe: *echo date | script*) gör aktiveringen av *ECHO* för pseudoterminalens slav att standardinmatningsdata kan visas på skärmen samtidigt som de registreras i sessionsloggen."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Note that 'never' mode affects content of the session output log, because users input is not repeated on output."
msgstr "Observera att läget \"never\" påverkar innehållet i sessionens utdatalogg, eftersom användarens inmatning inte upprepas i utdata."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-e*, *--return*"
msgstr "*-e*, *--return*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Return the exit status of the child process. Uses the same format as bash termination on signal termination (i.e., exit status is 128 {plus} the signal number). The exit status of the child process is always stored in the type script file too."
msgstr "Returnerar utgångsstatus för underordnad process. Använder samma format som bash-terminering vid signalavslutning (dvs. exitstatus är 128 {plus} signalnumret). Avslutningsstatusen för den underordnade processen lagras alltid även i skriptfilen av typen."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-f*, *--flush*"
msgstr "*-f*, *--flush*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Flush output after each write. This is nice for telecooperation: one person does *mkfifo* _foo_; *script -f* _foo_, and another can supervise in real-time what is being done using *cat* _foo_. Note that flush has an impact on performance; it's possible to use *SIGUSR1* to flush logs on demand."
msgstr "Spola utdata efter varje skrivning. Detta är bra för telekooperation: en person gör *mkfifo* _foo_; *script -f* _foo_, och en annan kan övervaka i realtid vad som görs med hjälp av *cat* _foo_. Observera att flush påverkar prestandan; det är möjligt att använda *SIGUSR1* för att spola loggar på begäran."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--force*"
msgstr "*--force*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Allow the default output file _typescript_ to be a hard or symbolic link. The command will follow a symbolic link."
msgstr "Låt standardutdatafilen _typescript_ vara en hård eller symbolisk länk. Kommandot kommer att följa en symbolisk länk."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-B*, *--log-io* _file_"
msgstr "*-B*, *--log-io* _fil_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Log input and output to the same _file_. Note, this option makes sense only if *--log-timing* is also specified, otherwise it's impossible to separate output and input streams from the log _file_."
msgstr "Logga in- och utdata till samma _fil_. Observera att den här flaggan endast är meningsfullt om *--log-timing* också anges, annars är det omöjligt att separera in- och utdataströmmar från loggfilen _fil_."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-I*, *--log-in* _file_"
msgstr "*-I*, *--log-in* _fil_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Log input to the _file_. The log output is disabled if only *--log-in* specified."
msgstr "Logga inmatning till _fil_. Loggutmatningen är inaktiverad om endast *--log-in* anges."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Use this logging functionality carefully as it logs all input, including input when terminal has disabled echo flag (for example, password inputs)."
msgstr "Använd denna loggningsfunktion med försiktighet eftersom den loggar all inmatning, även inmatning när terminalen har inaktiverat ekoflaggan (t.ex. lösenordsinmatning)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-O*, *--log-out* _file_"
msgstr "*-O*, *--log-out* _fil_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Log output to the _file_. The default is to log output to the file with name _typescript_ if the option *--log-out* or *--log-in* is not given. The log output is disabled if only *--log-in* specified."
msgstr "Logga utdata till _fil_. Standardinställningen är att logga utdata till filen med namnet _typescript_ om flaggan *--log-out* eller *--log-in* inte anges. Loggutmatningen inaktiveras om endast *--log-in* anges."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-T*, *--log-timing* _file_"
msgstr "*-T*, *--log-timing* _fil_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Log timing information to the _file_. Two timing file formats are supported now. The classic format is used when only one stream (input or output) logging is enabled. The multi-stream format is used on *--log-io* or when *--log-in* and *--log-out* are used together. See also *--logging-format*."
msgstr "Logga tidsinformation till _filen_. Nu finns stöd för två filformat för timing. Det klassiska formatet används när endast loggning av en ström (in- eller utmatning) är aktiverad. Multistream-formatet används vid *--log-io* eller när *--log-in* och *--log-out* används tillsammans. Se även *--loggningsformat*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-m*, *--logging-format* _format_"
msgstr "*-m*, *--logging-format* _format_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Force use of _advanced_ or _classic_ timing log format. The default is the classic format to log only output and the advanced format when input as well as output logging is requested."
msgstr "Tvinga fram användning av _avancerat_ eller _klassiskt_ loggningsformat för timing. Standard är det klassiska formatet för att logga endast utdata och det avancerade formatet när loggning av både inmatning och utdata begärs."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*Classic format*"
msgstr "*Klassiskt format*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "The timing log contains two fields, separated by a space. The first field indicates how much time elapsed since the previous output. The second field indicates how many characters were output this time."
msgstr "Tidsloggen innehåller två fält som åtskiljs av ett mellanslag. Det första fältet anger hur lång tid som har gått sedan föregående utmatning. Det andra fältet anger hur många tecken som matades ut den här gången."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*Advanced (multi-stream) format*"
msgstr "*Avancerat format (flera strömmar)*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "The first field is an entry type identifier ('I'nput, 'O'utput, 'H'eader, 'S'ignal). The second field is how much time elapsed since the previous entry, and the rest of the entry is type-specific data."
msgstr "Det första fältet är en identifiering av posttyp (\"I'nput\", \"O'utput\", \"H'eader\", \"S'ignal\"). Det andra fältet anger hur lång tid som förflutit sedan föregående inmatning, och resten av inmatningen är typspecifika data."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-o*, *--output-limit* _size_"
msgstr "*-o*, *--output-limit* _storlek_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Limit the size of the typescript and timing files to _size_ and stop the child process after this size is exceeded. The calculated file size does not include the start and done messages that the *script* command prepends and appends to the child process output. Due to buffering, the resulting output file might be larger than the specified value."
msgstr "Begränsa storleken på typskript- och tidsfilerna till _storlek_ och stoppa barnprocessen när denna storlek överskrids. Den beräknade filstorleken inkluderar inte de start- och slutmeddelanden som kommandot *script* preppar och lägger till i den underordnade processens utdata. På grund av buffring kan den resulterande utdatafilen vara större än det angivna värdet."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Be quiet (do not write start and done messages to standard output)."
msgstr "Var tyst (skriv inte start- och slutmeddelanden till standardutdata)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-t*[_file_], *--timing*[**=**_file_]"
msgstr "*-t*[_fil_], *--timing*[**=**_fil_]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Output timing data to standard error, or to _file_ when given. This option is deprecated in favour of *--log-timing* where the _file_ argument is not optional."
msgstr "Skriv ut tidsdata till standardfelet, eller till _fil_ om det anges. Denna flagga är inte längre aktuellt till förmån för *--log-timing* där argumentet _fil_ inte är valfritt."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Upon receiving *SIGUSR1*, *script* immediately flushes the output files."
msgstr "När *SIGUSR1* tas emot rensar *script* omedelbart utdatafilerna."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The following environment variable is utilized by *script*:"
msgstr "Följande miljövariabel används av *script*:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*SHELL*"
msgstr "*SKAL*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "If the variable *SHELL* exists, the shell forked by *script* will be that shell. If *SHELL* is not set, the Bourne shell is assumed. (Most shells set this variable automatically)."
msgstr "Om variabeln *SHELL* finns, kommer det skal som *script* förgrenar sig till att vara detta skal. Om *SHELL* inte är inställd, antas Bourne-skalet. (De flesta skal ställer in denna variabel automatiskt)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The script ends when the forked shell exits (a _control-D_ for the Bourne shell (*sh*(1p)), and _exit_, _logout_ or _control-d_ (if _ignoreeof_ is not set) for the C-shell, *csh*(1))."
msgstr "Skriptet avslutas när det förgrenade skalet avslutas (en _control-D_ för Bourne-skalet (*sh*(1p)), och _exit_, _logout_ eller _control-d_ (om _ignoreeof_ inte är inställt) för C-skalet, *csh*(1))."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Certain interactive commands, such as *vi*(1), create garbage in the typescript file. *script* works best with commands that do not manipulate the screen, the results are meant to emulate a hardcopy terminal."
msgstr "Vissa interaktiva kommandon, t.ex. *vi*(1), skapar skräp i typescript-filen. *script* fungerar bäst med kommandon som inte manipulerar skärmen, resultaten är avsedda att emulera en terminal för papperskopiering."

#. from tp:util-linux-man-2.41.2-rc1
msgid "It is not recommended to run *script* in non-interactive shells. The inner shell of *script* is always interactive, and this could lead to unexpected results. If you use *script* in the shell initialization file, you have to avoid entering an infinite loop. You can use for example the *.profile* file, which is read by login shells only:"
msgstr "Det är inte rekommenderat att köra *script* i icke-interaktiva skal. Det inre skalet i *script* är alltid interaktivt, och det kan leda till oväntade resultat. Om du använder *script* i skalets initieringsfil måste du undvika att hamna i en oändlig slinga. Du kan t.ex. använda filen *.profile*, som endast läses av inloggade skal:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "if test -t 0 ; then\n    script\n    exit\nfi\n"
msgstr "if test -t 0 ; då\n    skript\n    avsluta\nfi\n"

#. from tp:util-linux-man-2.41.2-rc1
msgid "You should also avoid use of *script* in command pipes, as *script* can read more input than you would expect."
msgstr "Du bör också undvika att använda *script* i kommandorör, eftersom *script* kan läsa mer indata än du förväntar dig."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The *script* command appeared in 3.0BSD."
msgstr "Kommandot *script* dök upp i 3.0BSD."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*script* places _everything_ in the log file, including linefeeds and backspaces. This is not what the naive user expects."
msgstr "*script* placerar _allt_ i loggfilen, inklusive radmatningar och mellanslag. Detta är inte vad den naiva användaren förväntar sig."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*script* is primarily designed for interactive terminal sessions. When stdin is not a terminal (for example: *echo foo | script*), then the session can hang, because the interactive shell within the script session misses EOF and *script* has no clue when to close the session. See the *NOTES* section for more information."
msgstr "*script* är främst utformat för interaktiva terminalsessioner. När stdin inte är en terminal (t.ex. *echo foo | script*) kan sessionen hänga sig, eftersom det interaktiva skalet i skriptsessionen missar EOF och *script* inte har någon aning om när sessionen ska stängas. Se avsnittet *NOTER* för mer information."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*csh*(1) (for the _history_ mechanism), *scriptreplay*(1), *scriptlive*(1)"
msgstr "*csh*(1) (för _history_-mekanismen), *scriptreplay*(1), *scriptlive*(1)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "scriptlive(1)"
msgstr "scriptlive(1)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "scriptlive - re-run session typescripts, using timing information"
msgstr "scriptlive - kör om sessionens typskript med hjälp av tidsinformation"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*scriptlive* [options] _timingfile_ _typescript_"
msgstr "*scriptlive* [flaggor] _timingfile_ _typescript_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "This program re-runs a typescript, using stdin typescript and timing information to ensure that input happens in the same rhythm as it originally appeared when the script was recorded."
msgstr "Det här programmet kör om ett typskript med hjälp av typskript och tidsinformation från stdin för att säkerställa att inmatningen sker i samma rytm som den ursprungligen såg ut när skriptet spelades in."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The *session is executed* in a newly created pseudoterminal with the user's $SHELL (or defaults to _/bin/bash_)."
msgstr "Sessionen körs* i en nyskapad pseudoterminal med användarens $SHELL (eller standard _/bin/bash_)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*Be careful!* The typescript may contain arbitrary commands. It is recommended to use *\"scriptreplay --stream in --log-in typescript\"* (or with *--log-io* instead of *--log-in*) to verify the typescript before it is executed with *scriptlive*."
msgstr "*Var försiktig!* Typskriptet kan innehålla godtyckliga kommandon. Vi rekommenderar att du använder *\"scriptreplay --stream in --log-in typescript\"* (eller med *--log-io* i stället för *--log-in*) för att verifiera typescriptet innan det körs med *scriptlive*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The timing information is what *script*(1) outputs to the file specified by *--log-timing*. The typescript has to contain stdin information, and is what *script*(1) outputs to the file specified by *--log-in* or *--log-io*."
msgstr "Tidsinformationen är det som *script*(1) matar ut till filen som specificeras av *--log-timing*. Typskriptet måste innehålla stdin-information och är det som *script*(1) matar ut till den fil som anges av *--log-in* eller *--log-io*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "File containing *script*'s terminal input."
msgstr "Fil som innehåller *script*:s terminalinmatning."

#. from tp:util-linux-man-2.41.2-rc1
msgid "File containing *script*'s terminal output and input."
msgstr "Fil som innehåller *script*:s terminalutdata och -inmatning."

#. from tp:util-linux-man-2.41.2-rc1
msgid "This option controls the *ECHO* flag for the slave end of the session's pseudoterminal. The supported modes are *always*, *never*, and *auto*."
msgstr "Denna flagga styr flaggan *ECHO* för slavänden av sessionens pseudoterminal. De lägen som stöds är *always*, *never* och *auto*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The default is *auto* -- in which case *ECHO* is enabled. This default behavior is subject to change."
msgstr "Standardinställningen är *auto* - i så fall aktiveras *ECHO*. Detta standardbeteende kan komma att ändras."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-t*, *--timing* _file_"
msgstr "*-t*, *--timing* _fil_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "File containing *script*'s timing output.  This option replaces the _timingfile_ positional argument."
msgstr "Fil som innehåller *script*:s tidsutdata.  Denna flagga ersätter det positionella argumentet _timingfile_."

#. from tp:util-linux-man-2.41.2-rc1
msgid "An alias for *-t*; maintained for compatibility with the *script*(1)  command-line options."
msgstr "Ett alias för *-t*; bibehålls för kompatibilitet med kommandoradsflaggorna för *script*(1)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Speed up the replay displaying this _number_ of times. The argument is a floating-point number. It's called divisor because it divides the timings by this factor. This option overrides old-style arguments."
msgstr "Påskynda uppspelningen genom att visa detta _antal_ gånger. Argumentet är ett flyttal. Det kallas divisor eftersom det dividerar tidsangivelserna med denna faktor. Den här flaggan åsidosätter gamla argument."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-m*, *--maxdelay* _number_"
msgstr "*-m*, *--maxdelay* _nummer_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Set the maximum delay between updates to _number_ of seconds. The argument is a floating-point number. This can be used to avoid long pauses in the typescript replay."
msgstr "Ställ in den maximala fördröjningen mellan uppdateringar till _antal_ sekunder. Argumentet är ett flyttal. Detta kan användas för att undvika långa pauser i uppspelningen av typskriften."

#. from tp:util-linux-man-2.41.2-rc1
msgid "% script --log-timing file.tm --log-in script.in\nScript started, file is script.out\n% date\n<etc, etc>\n% exit\nScript done, file is script.out\n% scriptlive --log-timing file.tm --log-in script.in\n"
msgstr "% script --log-timing file.tm --log-in script.in\nSkriptet startat, filen är script.out\n% date\n<etc, etc> <etc, etc\n% exit\nSkriptet är klart, filen är script.out\n% scriptlive --log-timing fil.tm --log-in skript.in\n"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Copyright {copyright} 2019 Karel Zak"
msgstr "Copyright {copyright} 2019 Karel Zak"

#. from tp:util-linux-man-2.41.2-rc1
msgid "This is free software; see the source for copying conditions. There is NO warranty; not even for MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE."
msgstr "Detta är fri programvara; se källan för kopieringsvillkor. Det finns INGEN garanti; inte ens för SÄLJBARHET eller LÄMPLIGHET FÖR ETT BESTÄMMT SYFTE."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Released under the GNU General Public License version 2 or later."
msgstr "Utgiven under GNU General Public License version 2 eller senare."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*script*(1), *scriptreplay*(1)"
msgstr "*script*(1), *scriptreplay*(1)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "scriptreplay(1)"
msgstr "scriptreplay(1)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "scriptreplay - play back typescripts, using timing information"
msgstr "scriptreplay - spela upp typsnitt med hjälp av tidsinformation"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*scriptreplay* [options] _timingfile_ [_typescript_ [_divisor_]]"
msgstr "*scriptreplay* [flaggor] _timingfile_ [_typescript_ [_divisor_]]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "This program replays a typescript, using timing information to ensure that output happens in the same rhythm as it originally appeared when the script was recorded."
msgstr "Det här programmet spelar upp ett typskript och använder tidsinformation för att säkerställa att utmatningen sker i samma rytm som den ursprungligen såg ut när manuset spelades in."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The replay simply displays the information again; the programs that were run when the typescript was being recorded are *not run again*. Since the same information is simply being displayed, *scriptreplay* is only guaranteed to work properly if run on the same type of terminal the typescript was recorded on. Otherwise, any escape characters in the typescript may be interpreted differently by the terminal to which *scriptreplay* is sending its output."
msgstr "Uppspelningen visar helt enkelt informationen igen; de program som kördes när typskriptet spelades in *körs inte igen*. Eftersom samma information bara visas, kan *scriptreplay* bara garanteras fungera korrekt om den körs på samma typ av terminal som typskriptet spelades in på. I annat fall kan eventuella escape-tecken i typskriptet tolkas annorlunda av den terminal som *scriptreplay* skickar sin utdata till."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The timing information is what *script*(1) outputs to file specified by *--log-timing*."
msgstr "Tidsinformationen är det som *script*(1) matar ut till den fil som anges av *--log-timing*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "By default, the _typescript_ to display is assumed to be named *typescript*, but other filenames may be specified, as the second parameter or with option *--log-out*."
msgstr "Som standard antas det _typescript_ som ska visas ha namnet *typescript*, men andra filnamn kan anges som den andra parametern eller med flaggan *--log-out*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "If the third parameter or *--divisor* is specified, it is used as a speed-up multiplier. For example, a speed-up of 2 makes *scriptreplay* go twice as fast, and a speed-down of 0.1 makes it go ten times slower than the original session."
msgstr "Om den tredje parametern eller *--divisor* anges används den som en multiplikator för hastighetshöjning. Om t.ex. hastigheten ökas med 2 går *scriptreplay* dubbelt så snabbt och om hastigheten minskas med 0,1 går den tio gånger långsammare än den ursprungliga sessionen."

#. from tp:util-linux-man-2.41.2-rc1
msgid "During the replay, you can interactively speed up, slow down, or pause the playback using the Up, Down, and Space keys."
msgstr "Under uppspelningen kan du interaktivt öka hastigheten, sänka hastigheten eller pausa uppspelningen med hjälp av tangenterna Upp, Ned och Mellanslag."

#. from tp:util-linux-man-2.41.2-rc1
msgid "File containing *script*'s terminal output."
msgstr "Fil som innehåller *script*:s terminalutdata."

#. from tp:util-linux-man-2.41.2-rc1
msgid "This is an alias for *-t*, maintained for compatibility with *script*(1) command-line options."
msgstr "Detta är ett alias för *-t*, som bibehålls för kompatibilitet med kommandoradsflaggorna för *script*(1)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-s*, *--typescript* _file_"
msgstr "*-s*, *--typescript* _fil_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Deprecated alias of *--log-out*."
msgstr "Föråldrat alias för *--log-out*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-c*, *--cr-mode* _mode_"
msgstr "*-c*, *--cr-mode* _läge_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Specifies how to handle the CR (carriage return, 0x0D) character from log files. The default mode is *auto*, in which case CR is replaced with a line break for the stdin log, because otherwise *scriptreplay* would overwrite the same line. The other modes are *never* and *always*."
msgstr "Anger hur CR-tecknet (carriage return, 0x0D) ska hanteras i loggfiler. Standardläget är *auto*, i vilket fall CR ersätts med en radbrytning för stdin-loggen, eftersom *scriptreplay* annars skulle skriva över samma rad. De andra lägena är *never* och *always*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--summary*"
msgstr "*--summary*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Display details about the session recorded in the specified timing file and exit. The session must have been recorded using the *advanced* format (see *script*(1) option *--logging-format* for more details)."
msgstr "Visar detaljer om sessionen som spelades in i den angivna tidsfilen och avslutar. Sessionen måste ha spelats in med hjälp av formatet *advanced* (se *script*(1)-flaggan *--logging-format* för mer information)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-x*, *--stream* _type_"
msgstr "*-x*, *--stream* _typ_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Forces *scriptreplay* to print only the specified stream. The supported stream types are *in*, *out*, *signal*, and *info*. This option is recommended for multi-stream logs (created with *--log-io*) in order to print only the desired data."
msgstr "Tvingar *scriptreplay* att endast skriva ut den angivna strömmen. De strömtyper som stöds är *in*, *out*, *signal* och *info*. Denna flagga rekommenderas för loggar med flera strömmar (skapade med *--log-io*) för att endast skriva ut önskade data."

#. from tp:util-linux-man-2.41.2-rc1
msgid "% script --log-timing file.tm --log-out script.out\nScript started, file is script.out\n% ls\n<etc, etc>\n% exit\nScript done, file is script.out\n% scriptreplay --log-timing file.tm --log-out script.out\n"
msgstr "% sskript --log-timing fil.tm --log-out skript.ut\nSkriptet startat, filen är script.out\n% ls\n<etc, etc>\n% exit\nSkriptet är klart, filen är script.out\n% scriptreplay --log-timing file.tm --log-out script.out\n"

#. from tp:util-linux-man-2.41.2-rc1
msgid "KEY BINDINGS"
msgstr "BINDNINGAR FÖR NYCKEL"

#. from tp:util-linux-man-2.41.2-rc1
msgid "The following keys control the playback of the script:"
msgstr "Följande knappar styr uppspelningen av skriptet:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*Space*: Toggles pause and unpause. Press this key to pause the playback, and press it again to resume."
msgstr "*Mellanslag*: Växlar mellan paus och avpaus. Tryck på denna knapp för att pausa uppspelningen och tryck på den igen för att återuppta den."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*Up Arrow*: Increases the playback speed. Each press of this key will make the script replay faster by x0.1."
msgstr "*Pil uppåt*: Ökar uppspelningshastigheten. Varje tryckning på denna knapp gör att skriptet spelas upp x0,1 snabbare."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*Down Arrow*: Decreases the playback speed. Each press of this key will slow down the script replay by x0.1."
msgstr "*Nedåtpil*: Minskar uppspelningshastigheten. Varje tryckning på denna knapp gör att uppspelningen av skriptet går x0,1 långsammare."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The original *scriptreplay* program was written by mailto:joey@kitenet.net[Joey Hess]. The program was re-written in C by mailto:jay@gnu.org[James Youngman] and mailto:kzak@redhat.com[Karel Zak]"
msgstr "Det ursprungliga *scriptreplay*-programmet skrevs av mailto:joey@kitenet.net[Joey Hess]. Programmet skrevs om i C av mailto:jay@gnu.org[James Youngman] och mailto:kzak@redhat.com[Karel Zak]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Copyright {copyright} 2008 James Youngman"
msgstr "Copyright {copyright} 2008 James Youngman"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Copyright {copyright} 2008-2019 Karel Zak"
msgstr "Copyright {copyright} 2008-2019 Karel Zak"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Copyright {copyright} 2024 Jonathan Ketchker"
msgstr "Copyright {copyright} 2024 Jonathan Ketchker"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*script*(1), *scriptlive*(1)"
msgstr "*script*(1), *scriptlive*(1)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "setterm(1)"
msgstr "setterm(1)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "setterm - set terminal attributes"
msgstr "setterm - ställa in terminalattribut"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*setterm* [options]"
msgstr "*setterm* [flaggor]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*setterm* writes to standard output a character string that will invoke the specified terminal capabilities. Where possible, _terminfo_ is consulted to find the string to use. Some options (marked \"virtual consoles only\" below)  do not correspond to a *terminfo*(5) capability. In these cases, if the terminal type is \"con\" or \"linux\", the string that invokes the specified capability on the PC Minix virtual console is output. Options that are not implemented by the terminal are ignored."
msgstr "*setterm* skriver till standardutdata en teckensträng som aktiverar de angivna terminalfunktionerna. Om möjligt konsulteras _terminfo_ för att hitta den sträng som ska användas. Vissa flaggor (markerade med \"endast virtuella konsoler\" nedan) motsvarar inte någon *terminfo*(5)-funktion. I dessa fall, om terminaltypen är \"con\" eller \"linux\", skrivs den sträng ut som anropar den angivna funktionen på PC Minix virtuella konsol. Flaggor som inte implementeras av terminalen ignoreras."

#. from tp:util-linux-man-2.41.2-rc1
msgid "For boolean options (*on* or *off*), the default is *on*."
msgstr "För booleska flaggor (*on* eller *off*) är standardvärdet *on*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Below, an _8-color_ can be *black*, *red*, *green*, *yellow*, *blue*, *magenta*, *cyan*, or *white*."
msgstr "Nedan kan en _8-färg_ vara *svart*, *röd*, *grön*, *gul*, *blå*, *magenta*, *cyan* eller *vit*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "A _16-color_ can be an _8-color_, or *grey*, or *bright* followed by *red*, *green*, *yellow*, *blue*, *magenta*, *cyan*, or *white*."
msgstr "En _16-färg_ kan vara en _8-färg_, eller *grå*, eller *ljus* följt av *röd*, *grön*, *gul*, *blå*, *magenta*, *cyan*, eller *vit*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The various color options may be set independently, at least on virtual consoles, though the results of setting multiple modes (for example, *--underline* and *--half-bright*) are hardware-dependent."
msgstr "De olika färgflaggorna kan ställas in oberoende av varandra, åtminstone på virtuella konsoler, även om resultatet av att ställa in flera lägen (t.ex. *--underline* och *--half-bright*) är maskinvaruberoende."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The optional arguments are recommended with '=' (equals sign) and not space between the option and the argument. For example --option=argument. *setterm* can interpret the next non-option argument as an optional argument too."
msgstr "De valfria argumenten rekommenderas med '=' (likhetstecken) och inte med mellanslag mellan flaggan och argumentet. Till exempel --option=argument. kan *setterm* även tolka nästa argument som inte är en flagga som ett valfritt argument."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--appcursorkeys* **on**|**off**"
msgstr "*--appcursorkeys* **on**|**off**"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Sets Cursor Key Application Mode on or off. When on, ESC O A, ESC O B, etc. will be sent for the cursor keys instead of ESC [ A, ESC [ B, etc. See the _vi and Cursor-Keys_ section of the _Text-Terminal-HOWTO_ for how this can cause problems for *vi* users. Virtual consoles only."
msgstr "Aktiverar eller inaktiverar tillämpningsläget för markörknapparna. När läget är på skickas ESC O A, ESC O B osv. för markörknapparna i stället för ESC [ A, ESC [ B osv. Se avsnittet _vi and Cursor-Keys_ i _Text-Terminal-HOWTO_ för information om hur detta kan orsaka problem för *vi*-användare. Endast virtuella konsoler."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--append* _console_number_"
msgstr "*--append* _console_nummer_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Like *--dump*, but appends to the snapshot file instead of overwriting it. Only works if no *--dump* options are given."
msgstr "Som *--dump*, men lägger till snapshot-filen i stället för att skriva över den. Fungerar bara om inga *--dump*-flaggor har angetts."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--background* __8-color__|**default**"
msgstr "*--background* __8-color__|**default**"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Sets the background text color."
msgstr "Ställer in bakgrundsfärgen för texten."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--blank*[**=0**-**60**|**force**|**poke**]"
msgstr "*--blank*[**=0**-**60**|**force**|**poke**]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Sets the interval of inactivity, in minutes, after which the screen will be automatically blanked (using APM if available). Without an argument, it gets the blank status (returns which vt was blanked, or zero for an unblanked vt). Virtual consoles only."
msgstr "Ställer in intervallet för inaktivitet, i minuter, efter vilket skärmen automatiskt kommer att tömmas (med APM om tillgängligt). Utan ett argument får den blankstatus (returnerar vilken vt som blankades, eller noll för en oblankerad vt). Endast virtuella konsoler."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The *force* argument keeps the screen blank even if a key is pressed."
msgstr "Argumentet *force* gör att skärmen förblir tom även om en tangent trycks in."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The *poke* argument unblanks the screen."
msgstr "Argumentet *poke* avbländar skärmen."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--bfreq*[**=**_number_]"
msgstr "*--bfreq*[**=**_nummer_]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Sets the bell frequency in Hertz. Without an argument, it defaults to *0*. Virtual consoles only."
msgstr "Ställer in klockfrekvensen i Hertz. Utan argument är standardvärdet *0*. Endast virtuella konsoler."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--blength*[**=0**-**2000**]"
msgstr "*--blength*[**=0**-**2000**]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Sets the bell duration in milliseconds. Without an argument, it defaults to *0*. Virtual consoles only."
msgstr "Ställer in klockans varaktighet i millisekunder. Utan ett argument är standardvärdet *0*. Endast virtuella konsoler."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--blink* **on**|**off**"
msgstr "*--blink* **on**|**off**"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Turns blink mode on or off. Except on a virtual console, *--blink off* turns off all attributes (bold, half-brightness, blink, reverse)."
msgstr "Slår på eller av blinkningsläget. Förutom på en virtuell konsol stänger *--blink off* av alla attribut (fetstil, halv ljusstyrka, blink, omvänd)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--bold* **on**|**off**"
msgstr "*--bold* **on**|**off**"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Turns bold (extra bright) mode on or off. Except on a virtual console, *--bold off* turns off all attributes (bold, half-brightness, blink, reverse)."
msgstr "Slår på eller av läget bold (extra ljus). Förutom på en virtuell konsol stänger *--bold off* av alla attribut (fet, halv ljusstyrka, blinkning, omvänd)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--clear*[**=all**|**rest**]"
msgstr "*--clear*[**=all**|**rest**]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Without an argument or with the argument *all*, the entire screen is cleared and the cursor is set to the home position, just like *clear*(1) does. With the argument *rest*, the screen is cleared from the current cursor position to the end."
msgstr "Utan argument eller med argumentet *all* rensas hela skärmen och markören ställs in på startpositionen, precis som *clear*(1) gör. Med argumentet *rest* rensas skärmen från markörens aktuella position till slutet."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--clrtabs*[**=**_tab1 tab2 tab3_ ...]"
msgstr "*--clrtabs*[**=**_tab1 tab2 tab3_ ...]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Clears tab stops from the given horizontal cursor positions, in the range *1*-*160*. Without arguments, it clears all tab stops. Virtual consoles only."
msgstr "Rensar tabbstopp från de angivna horisontella markörpositionerna, i intervallet *1*-*160*. Utan argument rensas alla tabbstopp. Endast virtuella konsoler."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--cursor* **on**|**off**"
msgstr "*--cursor* **on**|**off**"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Turns the terminal's cursor on or off."
msgstr "Slår på eller av terminalens markör."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--default*"
msgstr "*--default*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Sets the terminal's rendering options to the default values."
msgstr "Ställer in terminalens renderingsflaggor till standardvärdena."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--dump*[**=**_console_number_]"
msgstr "*--dump*[**=**_console_nummer_]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Writes a snapshot of the virtual console with the given number to the file specified with the *--file* option, overwriting its contents; the default is _screen.dump_. Without an argument, it dumps the current virtual console. This overrides *--append*."
msgstr "Skriver en ögonblicksbild av den virtuella konsolen med det angivna numret till den fil som anges med flaggan *--file* och skriver över dess innehåll; standard är _screen.dump_. Utan argument dumpas den aktuella virtuella konsolen. Detta åsidosätter *--append*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--file* _filename_"
msgstr "*--file* _filename_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Sets the snapshot file name for any *--dump* or *--append* options on the same command line. If this option is not present, the default is _screen.dump_ in the current directory. A path name that exceeds the system maximum will be truncated, see *PATH_MAX* from _linux/limits.h_ for the value."
msgstr "Anger filnamnet för ögonblicksbilden för alla flaggor som *--dump* eller *--append* på samma kommandorad. Om den här flaggan inte finns är standardvärdet _screen.dump_ i den aktuella katalogen. Ett sökvägsnamn som överskrider systemets maxgräns kommer att trunkeras, se *PATH_MAX* från _linux/limits.h_ för värdet."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--foreground* __8-color__|**default**"
msgstr "*--foreground* __8-color__|**default**"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Sets the foreground text color."
msgstr "Ställer in förgrundsfärgen för texten."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--half-bright* **on**|**off**"
msgstr "*--half-bright* **on**|**off**"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Turns dim (half-brightness) mode on or off. Except on a virtual console, *--half-bright off* turns off all attributes (bold, half-brightness, blink, reverse)."
msgstr "Sätter på eller stänger av dim-läget (halv ljusstyrka). Förutom på en virtuell konsol stänger *--half-bright off* av alla attribut (fetstil, halvljus, blinkning, omvänd)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--hbcolor* _16-color_"
msgstr "*--hbcolor* _16-color_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Sets the color for half-bright characters."
msgstr "Ställer in färgen för halvljusa tecken."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--initialize*"
msgstr "*--initialize*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Displays the terminal initialization string, which typically sets the terminal's rendering options, and other attributes to the default values."
msgstr "Visar terminalens initialiseringssträng, som vanligtvis ställer in terminalens renderingsflaggor och andra attribut till standardvärdena."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--inversescreen* **on**|**off**"
msgstr "*--inversescreen* **on**|**off**"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Swaps foreground and background colors for the whole screen."
msgstr "Byter förgrunds- och bakgrundsfärg för hela skärmen."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--linewrap* **on**|**off**"
msgstr "*--linewrap* **on**|**off**"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Makes the terminal continue on a new line when a line is full."
msgstr "Gör att terminalen fortsätter på en ny linje när en linje är full."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--msg* **on**|**off**"
msgstr "*--msg* **on**|**off**"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Enables or disables the sending of kernel *printk*() messages to the console. Virtual consoles only."
msgstr "Aktiverar eller inaktiverar sändning av kärnans *printk*()-meddelanden till konsolen. Endast virtuella konsoler."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--msglevel* **0**-**8**"
msgstr "*--msglevel* **0**-**8**"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Sets the console logging level for kernel *printk()* messages. All messages strictly more important than this will be printed, so a logging level of *0* has the same effect as *--msg on* and a logging level of *8* will print all kernel messages. *klogd*(8) may be a more convenient interface to the logging of kernel messages."
msgstr "Ställer in konsolloggningsnivån för kärnans *printk()*-meddelanden. Alla meddelanden som är viktigare än detta kommer att skrivas ut, så en loggningsnivå på *0* har samma effekt som *--msg on* och en loggningsnivå på *8* kommer att skriva ut alla kärnmeddelanden. *klogd*(8) kan vara ett mer praktiskt gränssnitt för loggning av kärnmeddelanden."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Virtual consoles only."
msgstr "Endast virtuella konsoler."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--powerdown*[**=0**-**60**]"
msgstr "*--powerdown*[**=0**-**60**]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Sets the VESA powerdown interval in minutes. Without an argument, it defaults to *0* (disable powerdown). If the console is blanked or the monitor is in suspend mode, then the monitor will go into vsync suspend mode or powerdown mode respectively after this period of time has elapsed."
msgstr "Ställer in VESA:s avstängningsintervall i minuter. Utan ett argument är standardvärdet *0* (inaktivera strömavbrott). Om konsolen är tom eller om bildskärmen är i suspenderat läge kommer bildskärmen att gå in i suspenderat vsync-läge respektive strömavstängningsläge efter att den här tidsperioden har löpt ut."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--powersave* _mode_"
msgstr "*--powersave* _läge_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Valid values for _mode_ are:"
msgstr "Giltiga värden för _läge_ är:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*vsync*|*on*"
msgstr "*vsync*|*on*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Puts the monitor into VESA vsync suspend mode."
msgstr "Sätter bildskärmen i VESA vsync suspend-läge."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*hsync*"
msgstr "*hsync*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Puts the monitor into VESA hsync suspend mode."
msgstr "Sätter bildskärmen i VESA hsync suspend-läge."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*powerdown*"
msgstr "*avstängning*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Puts the monitor into VESA powerdown mode."
msgstr "Sätter monitorn i VESA-läge för strömavbrott."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Turns the monitor's powersaving features off."
msgstr "Slår av monitorns energisparfunktioner."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--regtabs*[**=1**-**160**]"
msgstr "*--regtabs*[**=1**-**160**]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Clears all tab stops, then sets a regular tab stop pattern, with one tab every specified number of positions. Without an argument, it defaults to *8*. Virtual consoles only."
msgstr "Rensar alla tabulatorstopp och anger sedan ett vanligt tabulatorstoppsmönster med en tabulator varje angivet antal positioner. Utan argument är standardvärdet *8*. Endast virtuella konsoler."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--repeat* **on**|**off**"
msgstr "*--repeat* **on**|**off**"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Turns keyboard repeat on or off. Virtual consoles only."
msgstr "Slår på eller av tangentbordsrepetition. Endast virtuella konsoler."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--reset*"
msgstr "*--reset*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Displays the terminal reset string, which typically resets the terminal to its power-on state."
msgstr "Visar terminalens återställningssträng, som vanligtvis återställer terminalen till dess strömläge."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--resize*"
msgstr "*--resize*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Reset terminal size by assessing maximum row and column. This is useful when actual geometry and kernel terminal driver are not in sync. Most notable use case is with serial consoles, that do not use *ioctl*(2) but just byte streams and breaks."
msgstr "Återställ terminalstorleken genom att bedöma maximal rad och kolumn. Detta är användbart när den faktiska geometrin och kärnans terminaldrivrutin inte är synkroniserade. Det mest anmärkningsvärda användningsfallet är med seriella konsoler, som inte använder *ioctl*(2) utan bara byte-strömmar och pauser."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--reverse* **on**|**off**"
msgstr "*--reverse* **on**|**off**"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Turns reverse video mode on or off. Except on a virtual console, *--reverse off* turns off all attributes (bold, half-brightness, blink, reverse)."
msgstr "Slår på eller av omvänt videoläge. Förutom på en virtuell konsol stänger *--reverse off* av alla attribut (fetstil, halv ljusstyrka, blinkning, omvänd)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--store*"
msgstr "*--store*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Stores the terminal's current rendering options (foreground and background colors) as the values to be used at reset-to-default. Virtual consoles only."
msgstr "Lagrar terminalens aktuella renderingsflaggor (förgrunds- och bakgrundsfärger) som de värden som ska användas vid återställning till standard. Endast virtuella konsoler."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--tabs*[**=**_tab1 tab2 tab3_ ...]"
msgstr "*--tabs*[**=**_tab1 tab2 tab3_ ...]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Sets tab stops at the given horizontal cursor positions, in the range *1*-*160*. Without arguments, it shows the current tab stop settings."
msgstr "Ställer in tabbstopp vid de angivna horisontella markörpositionerna, i intervallet *1*-*160*. Utan argument visas de aktuella inställningarna för tabbstopp."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--term* _terminal_name_"
msgstr "*--term* _terminal_namn_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Overrides the *TERM* environment variable."
msgstr "Åsidosätter miljövariabeln *TERM*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--ulcolor* _16-color_"
msgstr "*--ulcolor* _16-color_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Sets the color for underlined characters. Virtual consoles only."
msgstr "Ställer in färgen för understrukna tecken. Endast virtuella konsoler."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*--underline* **on**|**off**"
msgstr "*--underline* **on**|**off**"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Turns underline mode on or off."
msgstr "Aktiverar eller inaktiverar understrykningsläget."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Use of *setterm* in combination with stdout redirection can have unexpected results, as some options operate on stdin. To prevent problems, always redirect both stdin and stdout to the same device."
msgstr "Användning av *setterm* i kombination med omdirigering av stdout kan ge oväntade resultat, eftersom vissa flaggor fungerar på stdin. För att undvika problem bör du alltid omdirigera både stdin och stdout till samma enhet."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Since version 2.25 *setterm* has support for long options with two hyphens, for example *--help*, beside the historical long options with a single hyphen, for example *-help*. In scripts it is better to use the backward-compatible single hyphen rather than the double hyphen. Currently there are no plans nor good reasons to discontinue single-hyphen compatibility."
msgstr "Sedan version 2.25 har *setterm* stöd för långa flaggor med två bindestreck, t.ex. *--help*, vid sidan av de historiska långa alternativen med ett enda bindestreck, t.ex. *-help*. I skript är det bättre att använda det bakåtkompatibla enkla bindestrecket i stället för det dubbla bindestrecket. För närvarande finns det inga planer eller goda skäl att upphöra med kompatibiliteten med enkelt bindestreck."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Differences between the Minix and Linux versions are not documented."
msgstr "Skillnader mellan Minix- och Linux-versionerna är inte dokumenterade."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*stty*(1), *tput*(1), *tty*(4), *terminfo*(5)"
msgstr "*stty*(1), *tput*(1), *tty*(4), *terminfo*(5)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "wall(1)"
msgstr "wall(1)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "wall - write a message to all users"
msgstr "wall - skriv ett meddelande till alla användare"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*wall* [*-n*] [*-t* _timeout_] [*-g* _group_] [_message_ | _file_]"
msgstr "*wall* [*-n*] [*-t* _tidsgräns_] [*-g* _grupp_] [_message_ | _fil_]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*wall* displays a _message_, or the contents of a _file_, or otherwise its standard input, on the terminals of all currently logged in users. The command will wrap lines that are longer than 79 characters. Short lines are whitespace padded to have 79 characters. The command will always put a carriage return and new line at the end of each line."
msgstr "*wall* visar ett _meddelande_, eller innehållet i en _fil_, eller på annat sätt dess standardinmatning, på terminalerna för alla användare som för närvarande är inloggade. Kommandot ombryter rader som är längre än 79 tecken. Korta rader fylls på med blanksteg för att få 79 tecken. Kommandot sätter alltid en vagnsretur och en ny rad i slutet av varje rad."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Only the superuser can write on the terminals of users who have chosen to deny messages or are using a program which automatically denies messages."
msgstr "Endast superanvändaren kan skriva på terminaler som tillhör användare som har valt att neka meddelanden eller som använder ett program som automatiskt nekar meddelanden."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Reading from a _file_ is refused when the invoker is not superuser and the program is set-user-ID or set-group-ID."
msgstr "Läsning från en _fil_ nekas när den som anropar inte är superuser och programmet är set-user-ID eller set-group-ID."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-n*, *--nobanner*"
msgstr "*-n*, *--nobanner*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Suppress the banner."
msgstr "Undertrycka bannern."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Abandon the write attempt to the terminals after _timeout_ seconds. This _timeout_ must be a positive integer. The default value is 300 seconds, which is a legacy from the time when people ran terminals over modem lines."
msgstr "Överge skrivförsöket till terminalerna efter _tidsgräns_ sekunder. Denna _tidsgräns_ måste vara ett positivt heltal. Standardvärdet är 300 sekunder, vilket är ett arv från den tid då man använde terminaler via modemlinjer."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-g*, *--group* _group_"
msgstr "*-g*, *--group* _grupp_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Limit printing message to members of group defined as a _group_ argument. The argument can be group name or GID."
msgstr "Begränsa utskriftsmeddelandet till medlemmar i en grupp som definieras med argumentet _grupp_. Argumentet kan vara gruppnamn eller GID."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Some sessions, such as *wdm*(1x), that have in the beginning of *utmp*(5) ut_type data a ':' character will not get the message from *wall*. This is done to avoid write errors."
msgstr "Vissa sessioner, t.ex. *wdm*(1x), som i början av *utmp*(5) ut_type data har ett ':'-tecken kommer inte att få meddelandet från *wall*. Detta görs för att undvika skrivfel."

#. from tp:util-linux-man-2.41.2-rc1
msgid "A *wall* command appeared in Version 7 AT&T UNIX."
msgstr "Ett *wall*-kommando dök upp i version 7 AT&T UNIX."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*mesg*(1), *talk*(1), *write*(1), *shutdown*(8)"
msgstr "*mesg*(1), *talk*(1), *write*(1), *shutdown*(8)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "write(1)"
msgstr "write(1)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "write - send a message to another user"
msgstr "write - skicka ett meddelande till en annan användare"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*write* _user_ [_ttyname_]"
msgstr "*write* _användare_ [_ttyname_]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*write* allows you to communicate with other users, by copying lines from your terminal to theirs."
msgstr "*write* gör att du kan kommunicera med andra användare genom att kopiera rader från din terminal till deras."

#. from tp:util-linux-man-2.41.2-rc1
msgid "When you run the *write* command, the user you are writing to gets a message of the form:"
msgstr "När du kör kommandot *write* får den användare du skriver till ett meddelande av följande typ:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Message from yourname@yourhost on yourtty at hh:mm ...\n"
msgstr "Meddelande från yourname@yourhost på yourtty kl. hh:mm ...\n"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Any further lines you enter will be copied to the specified user's terminal. If the other user wants to reply, they must run *write* as well."
msgstr "Eventuella ytterligare rader som du skriver in kopieras till den angivna användarens terminal. Om den andra användaren vill svara måste han eller hon också köra *write*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "When you are done, type an end-of-file or interrupt character. The other user will see the message *EOF* indicating that the conversation is over."
msgstr "När du är klar skriver du ett tecken för slutet av filen eller ett avbrottstecken. Den andra användaren kommer att se meddelandet *EOF* som indikerar att konversationen är över."

#. from tp:util-linux-man-2.41.2-rc1
msgid "You can prevent people (other than the superuser) from writing to you with the *mesg*(1) command. Some commands, for example *nroff*(1) and *pr*(1), may automatically disallow writing, so that the output they produce isn't overwritten."
msgstr "Du kan hindra andra (än superanvändaren) från att skriva till dig med kommandot *mesg*(1). Vissa kommandon, t.ex. *nroff*(1) och *pr*(1), kan automatiskt förhindra skrivning, så att de utdata de producerar inte skrivs över."

#. from tp:util-linux-man-2.41.2-rc1
msgid "If the user you want to write to is logged in on more than one terminal, you can specify which terminal to write to by giving the terminal name as the second operand to the *write* command. Alternatively, you can let *write* select one of the terminals - it will pick the one with the shortest idle time. This is so that if the user is logged in at work and also dialed up from home, the message will go to the right place."
msgstr "Om den användare som du vill skriva till är inloggad på mer än en terminal kan du ange vilken terminal som ska skrivas till genom att ange terminalnamnet som andra operand i kommandot *write*. Alternativt kan du låta *write* välja en av terminalerna - den väljer då den terminal som har kortast inaktivitetstid. Detta för att meddelandet ska gå till rätt ställe om användaren är inloggad på jobbet och samtidigt ringer upp hemifrån."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The traditional protocol for writing to someone is that the string _-o_, either at the end of a line or on a line by itself, means that it's the other person's turn to talk. The string _oo_ means that the person believes the conversation to be over."
msgstr "Det traditionella protokollet för att skriva till någon är att strängen _-o_, antingen i slutet av en rad eller på en rad för sig själv, betyder att det är den andra personens tur att prata. Strängen _oo_ betyder att personen anser att konversationen är över."

#. from tp:util-linux-man-2.41.2-rc1
msgid "A *write* command appeared in Version 5 AT&T UNIX (Jun 1974)."
msgstr "Ett *write*-kommando dök upp i version 5 av AT&T UNIX (juni 1974)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*mesg*(1), *talk*(1), *who*(1)"
msgstr "*mesg*(1), *talk*(1), *who*(1)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "col(1)"
msgstr "col(1)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "col - filter reverse line feeds from input"
msgstr "col - filtrera omvända radflöden från inmatningen"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*col* _options_"
msgstr "*col* _optioner"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*col* filters out reverse (and half-reverse) line feeds so the output is in the correct order, with only forward and half-forward line feeds. It also replaces any whitespace characters with tabs where possible. This can be useful in processing the output of *nroff*(1) and *tbl*(1)."
msgstr "*col* filtrerar bort omvända (och halvt omvända) radmatningar så att utdata är i rätt ordning, med endast framåtriktade och halvt framåtriktade radmatningar. Den ersätter också alla blankstegstecken med tabbar där det är möjligt. Detta kan vara användbart vid bearbetning av utdata från *nroff*(1) och *tbl*(1)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*col* reads from standard input and writes to standard output."
msgstr "*col* läser från standardinmatningen och skriver till standardutmatningen."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-b*, *--no-backspaces*"
msgstr "*-b*, *--no-backspaces*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Do not output any backspaces, printing only the last character written to each column position."
msgstr "Skriv inte ut några backspaces, utan skriv bara ut det sista tecknet som skrivits till varje kolumnposition."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-f*, *--fine*"
msgstr "*-f*, *--fine*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Permit half-forward line feeds. Normally characters destined for a half-line boundary are printed on the following line."
msgstr "Tillåt halvframåtriktade radmatningar. Normalt skrivs tecken som är avsedda för en halv rads gräns ut på nästa rad."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-h*, *--tabs*"
msgstr "*-h*, *--tabs*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Output tabs instead of multiple spaces."
msgstr "Skriv ut tabbar i stället för flera mellanslag."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-l*, *--lines* _number_"
msgstr "*-l*, *--lines* _nummer_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Buffer at least _number_ lines in memory. By default, 128 lines are buffered."
msgstr "Buffra minst _antal_ rader i minnet. Som standard är 128 rader buffrade."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-p*, *--pass*"
msgstr "*-p*, *--pass*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Force unknown control sequences to be passed through unchanged. Normally *col* will filter out any control sequences other than those recognized and interpreted by itself, which are listed below."
msgstr "Tvinga okända kontrollsekvenser att passera oförändrade. Normalt filtrerar *col* bort alla andra kontrollsekvenser än de som den själv känner igen och tolkar, vilka listas nedan."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-x*, *--spaces*"
msgstr "*-x*, *--spaces*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Output multiple spaces instead of tabs."
msgstr "Skriv ut flera mellanslag i stället för tabbar."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-H*, *--help*"
msgstr "*-H*, *--help*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "The *col* utility conforms to the Single UNIX Specification, Version 2. The *-l* option is an extension to the standard."
msgstr "Verktyget *col* överensstämmer med Single UNIX Specification, version 2. Flaggan *-l* är en utvidgning av standarden."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The control sequences for carriage motion that *col* understands and their decimal values are listed in the following table:"
msgstr "De styrsekvenser för vagnsrörelser som *col* förstår och deras decimalvärden listas i följande tabell:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*ESC-7*"
msgstr "*ESC-7*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "reverse line feed (escape then 7)"
msgstr "omvänd radmatning (escape sedan 7)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*ESC-8*"
msgstr "*ESC-8*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "half reverse line feed (escape then 8)"
msgstr "halv omvänd radmatning (escape sedan 8)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*ESC-9*"
msgstr "*ESC-9*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "half forward line feed (escape then 9)"
msgstr "halv framåt radmatning (escape sedan 9)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*backspace*"
msgstr "*backspace*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "moves back one column (8); ignored in the first column"
msgstr "flyttar tillbaka en kolumn (8); ignoreras i första kolumnen"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*newline*"
msgstr "*nytt streck*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "forward line feed (10); also does carriage return"
msgstr "framåt radmatning (10); gör även vagnsretur"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*carriage return*"
msgstr "*vagnretur*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "(13)"
msgstr "(13)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*shift in*"
msgstr "*skifta in*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "shift to normal character set (15)"
msgstr "växla till normal teckenuppsättning (15)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*shift out*"
msgstr "*skifta ut*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "shift to alternate character set (14)"
msgstr "växla till alternativ teckenuppsättning (14)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*space*"
msgstr "*utrymme*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "moves forward one column (32)"
msgstr "flyttar fram en kolumn (32)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*tab*"
msgstr "*flik*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "moves forward to next tab stop (9)"
msgstr "går vidare till nästa tabstopp (9)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*vertical tab*"
msgstr "*vertikal flik*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "reverse line feed (11)"
msgstr "omvänd radmatning (11)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "All unrecognized control characters and escape sequences are discarded."
msgstr "Alla oigenkända styrtecken och escape-sekvenser kasseras."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*col* keeps track of the character set as characters are read and makes sure the character set is correct when they are output."
msgstr "*col* håller reda på teckenuppsättningen när tecknen läses och ser till att teckenuppsättningen är korrekt när de skrivs ut."

#. from tp:util-linux-man-2.41.2-rc1
msgid "If the input attempts to back up to the last flushed line, *col* will display a warning message."
msgstr "Om inmatningen försöker backa tillbaka till den senast spolade linjen kommer *col* att visa ett varningsmeddelande."

#. from tp:util-linux-man-2.41.2-rc1
msgid "A *col* command appeared in Version 6 AT&T UNIX."
msgstr "Ett *col*-kommando dök upp i version 6 AT&T UNIX."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*expand*(1), *nroff*(1), *tbl*(1)"
msgstr "*expand*(1), *nroff*(1), *tbl*(1)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "colcrt(1)"
msgstr "colcrt(1)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "colcrt - filter nroff output for CRT previewing"
msgstr "colcrt - filtrera nroff-utdata för förhandsgranskning på CRT"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*colcrt* [options] [_file_ ...]"
msgstr "*colcrt* [flaggor] [_fil_ ...]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*colcrt* provides virtual half-line and reverse line feed sequences for terminals without such capability, and on which overstriking is destructive. Half-line characters and underlining (changed to dashing `-') are placed on new lines in between the normal output lines."
msgstr "*colcrt* ger virtuell halvrad och omvänd radmatning för terminaler som saknar sådana funktioner och där överstreckning är destruktivt. Halvradstecken och understrykningar (ändras till streckade `-') placeras på nya rader mellan de normala utdataraderna."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-*, *--no-underlining*"
msgstr "*-*, *--no-underlining*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Suppress all underlining. This option is especially useful for previewing _allboxed_ tables from *tbl*(1)."
msgstr "Undertrycker all understrykning. Denna flagga är särskilt användbart för förhandsgranskning av _allboxed_-tabeller från *tbl*(1)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-2*, *--half-lines*"
msgstr "*-2*, *--half-lines*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Causes all half-lines to be printed, effectively double spacing the output. Normally, a minimal space output format is used which will suppress empty lines. The program never suppresses two consecutive empty lines, however. The *-2* option is useful for sending output to the line printer when the output contains superscripts and subscripts which would otherwise be partially invisible."
msgstr "Gör att alla halva rader skrivs ut, vilket ger dubbelt avstånd i utskriften. Normalt används ett utmatningsformat med minimalt utrymme, vilket undertrycker tomma rader. Programmet undertrycker dock aldrig två tomma rader i följd. Flaggan *-2* är användbart för att skicka utdata till linjeskrivaren när utdata innehåller över- och underskrifter som annars skulle vara delvis osynliga."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The *colcrt* command appeared in 3.0BSD."
msgstr "Kommandot *colcrt* dök upp i 3.0BSD."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Should fold underlines onto blanks even with the *-* option so that a true underline character would show."
msgstr "Skulle vika understrykningar på blanksteg även med flaggan *-* så att ett riktigt understrykningstecken skulle visas."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Can't back up more than 102 lines."
msgstr "Det går inte att säkerhetskopiera mer än 102 rader."

#. from tp:util-linux-man-2.41.2-rc1
msgid "General overstriking is lost; as a special case '|' overstruck with '-' or underline becomes '{plus}'."
msgstr "Allmän överstrykning går förlorad; som ett specialfall blir \"|\" överstruket med \"-\" eller understrykning \"{plus}\"."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Lines are trimmed to 132 characters."
msgstr "Raderna är trimmade till 132 tecken."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Some provision should be made for processing superscripts and subscripts in documents which are already double-spaced."
msgstr "Det bör finnas en möjlighet att behandla upp- och nedskrivningar i dokument som redan har dubbelt spaltavstånd."

#. from tp:util-linux-man-2.41.2-rc1
msgid "A typical use of *colcrt* would be:"
msgstr "En typisk användning av *colcrt* skulle kunna vara:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*tbl exum2.n | nroff -ms | colcrt - | more*"
msgstr "*tbl exum2.n | nroff -ms | colcrt - | more*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*col*(1), *more*(1), *nroff*(1), *troff*(1), *ul*(1)"
msgstr "*col*(1), *more*(1), *nroff*(1), *troff*(1), *ul*(1)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "colrm(1)"
msgstr "colrm(1)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "colrm - remove columns from a file"
msgstr "colrm - ta bort kolumner från en fil"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*colrm* _[first [last]]_"
msgstr "*colrm* _[första [sista]]_ _[första [sista]]_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*colrm* removes selected columns from a file. Input is taken from standard input. Output is sent to standard output."
msgstr "*colrm* tar bort valda kolumner från en fil. Indata hämtas från standardinmatningen. Utdata skickas till standardutdata."

#. from tp:util-linux-man-2.41.2-rc1
msgid "If called with one parameter the columns of each line will be removed starting with the specified _first_ column. If called with two parameters the columns from the _first_ column to the _last_ column will be removed."
msgstr "Vid anrop med en parameter tas kolumnerna på varje rad bort med början från den angivna _första_ kolumnen. Om den anropas med två parametrar kommer kolumnerna från den _första_ kolumnen till den _sista_ kolumnen att tas bort."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Column numbering starts with column 1."
msgstr "Kolumnnumreringen börjar med kolumn 1."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The *colrm* command appeared in 3.0BSD."
msgstr "Kommandot *colrm* dök upp i 3.0BSD."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*awk*(1p), *column*(1), *expand*(1), *paste*(1)"
msgstr "*awk*(1p), *column*(1), *expand*(1), *paste*(1)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "column(1)"
msgstr "column(1)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "column - columnate lists"
msgstr "column - kolumnera listor"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*column* [options] [_file_ ...]"
msgstr "*column* [flaggor] [_fil_ ...]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "The *column* utility formats its input into multiple columns. It supports three modes:"
msgstr "Verktyget *column* formaterar indata till flera kolumner. Det stöder tre lägen:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*fill columns before rows*"
msgstr "*fylla kolumner före rader*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "This is the default mode (required for backwards compatibility)."
msgstr "Detta är standardläget (krävs för bakåtkompatibilitet)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*fill rows before columns*"
msgstr "*fylla rader före kolumner*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "This mode is enabled with the *-x, --fillrows* option."
msgstr "Detta läge aktiveras med flaggan *-x, --fillrows*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*create a table*"
msgstr "*skapa en tabell*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Determine the number of columns the input contains and create a table. This mode is enabled with the *-t, --table* option. Output is aligned to the terminal width in interactive mode and 80 columns in non-interactive mode (see *--output-width* for more details). Custom formatting can be applied by using various *--table-\\** options."
msgstr "Bestäm antalet kolumner som indata innehåller och skapa en tabell. Detta läge aktiveras med flaggan *-t, --table*. Utdata anpassas till terminalens bredd i interaktivt läge och 80 kolumner i icke-interaktivt läge (se *--output-width* för mer information). Anpassad formatering kan göras med hjälp av olika *--table-\\**-flaggor."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Input is taken from _file_, or otherwise from standard input. Empty lines are ignored and all invalid multibyte sequences are encoded with the x<hex> convention."
msgstr "Indata hämtas från _fil_, eller på annat sätt från standardinmatning. Tomma rader ignoreras och alla ogiltiga multibyte-sekvenser kodas med konventionen x<hex>."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The argument _columns_ for *--table-\\** options is a comma separated list of user supplied names, defined with *--table-column _name1_,_name2_,...*, indices of columns, as they appear in the input, beginning with 1, or names, defined by a *--table-columns* attribute.  It's possible to mix names and indices. The special placeholder '0' (e.g. -R0) may be used to specify all columns and '-1' (e.g. -R -1) to specify the last visible column.  It's possible to use ranges like '1-5' when addressing columns by indices."
msgstr "Argumentet _kolumner_ för *--table-\\**-flaggor är en kommaseparerad lista med namn som användaren angett, definierade med *--table-column _name1_,_name2_,...*, index för kolumner, som de visas i indata, med början med 1, eller namn, definierade av ett *--table-columns*-attribut.  Det är möjligt att blanda namn och index. Den speciella platshållaren '0' (t.ex. -R0) kan användas för att ange alla kolumner och '-1' (t.ex. -R -1) för att ange den sista synliga kolumnen.  Det är möjligt att använda intervall som '1-5' när kolumner adresseras med index."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-J, --json*"
msgstr "*-J, --json*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Use JSON output format to print the table. The option *--table-columns* is required and the option *--table-name* is recommended."
msgstr "Använd JSON-utdataformat för att skriva ut tabellen. Flaggan *--table-columns* är obligatorisk och flaggan *--table-name* rekommenderas."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-c, --output-width* _width_"
msgstr "*-c, --output-width* _width_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Output is formatted to a width specified as a number of characters. The original name of this option is *--columns*; this name is deprecated since v2.30. Note that input longer than _width_ is not truncated by default. The default is the terminal width and 80 columns in non-interactive mode. The column headers are never truncated."
msgstr "Utdata formateras till en bredd som anges som ett antal tecken. Det ursprungliga namnet på denna flagga är *--columns*; detta namn är föråldrat sedan v2.30. Observera att indata som är längre än _width_ inte trunkeras som standard. Standardinställningen är terminalbredd och 80 kolumner i icke-interaktivt läge. Kolumnrubrikerna trunkeras aldrig."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The placeholder \"unlimited\" (or 0) can be used to prevent restricting output width. This is recommended for example when redirecting output to a file."
msgstr "Platshållaren \"unlimited\" (eller 0) kan användas för att förhindra begränsning av utmatningsbredden. Detta rekommenderas t.ex. när utdata ska omdirigeras till en fil."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-d, --table-noheadings*"
msgstr "*-d, --table-noheadings*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Omit printing the header. This option allows the use of user supplied column names on the command line, but keeps the header hidden when printing the table."
msgstr "Utelämna utskrift av sidhuvudet. Denna flagga gör det möjligt att använda kolumnnamn som användaren angett på kommandoraden, men rubriken förblir dold när tabellen skrivs ut."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-o, --output-separator* _string_"
msgstr "*-o, --output-separator* _sträng_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Column delimiter for table output (default is two spaces)."
msgstr "Kolumnavgränsare för tabellutdata (standard är två mellanslag)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-s, --separator* _separators_"
msgstr "*-s, --separator* _avgränsare_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Possible input item delimiters (default is whitespace)."
msgstr "Möjliga avgränsare för inmatningsobjekt (standard är blanksteg)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-S, --use-spaces* _number_"
msgstr "*-S, --use-spaces* _nummer_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "When not in table mode, use whitespaces instead of tabulators to align the columns. This option specifies the minimum number of whitespaces that separate two columns."
msgstr "När du inte är i tabelläge använder du blanksteg i stället för tabulatorer för att justera kolumnerna. Det här flaggan anger det minsta antal blanksteg som ska skilja två kolumner åt."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-t, --table*"
msgstr "*-t, --table*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Determine the number of columns the input contains and create a table. Columns are by default delimited with whitespace, or with characters supplied using the *--output-separator* option. Table output is useful for pretty-printing."
msgstr "Bestäm antalet kolumner som indata innehåller och skapa en tabell. Kolumnerna avgränsas som standard med blanksteg eller med tecken som anges med flaggan *--output-separator*. Tabellutdata är användbara för pretty-printing."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-C, --table-column* _attributes_"
msgstr "*-C, --table-column* _attributes_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Define a column with a comma separated list of column attributes.  This option can be used more than once, every use defines a single column.  Attributes replace some of *--table-* options. For example, *--table-column name=FOO,right* defines a column where text is aligned to right. The option is mutually exclusive to *--table-columns*."
msgstr "Definiera en kolumn med en kommaseparerad lista över kolumnattribut.  Denna flagga kan användas mer än en gång, men varje användning definierar en enda kolumn.  Attributen ersätter vissa av flaggorna i *--table-*. Exempelvis definierar *--table-column name=FOO,right* en kolumn där texten är högerjusterad. Flaggan är ömsesidigt uteslutande i förhållande till *--table-columns*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Supported attributes are:"
msgstr "Attribut som stöds är:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*name=string*"
msgstr "*name=sträng*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Column name."
msgstr "Kolumnens namn."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*trunc*"
msgstr "*trunc*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Truncate column text when necessary. The same as *--table-truncate*."
msgstr "Trunkera kolumntexten vid behov. Samma sak som *--table-truncate*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*right*"
msgstr "*rätt*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Right align text. The same as *--table-right*."
msgstr "Högerjustera text. Samma sak som *--table-right*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*width=number*"
msgstr "*breddantal*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Column width. It's used only as a hint. To force it, specify the *strictwidth* attribute as well."
msgstr "Kolumnbredd. Det används endast som en antydan. Om du vill tvinga fram den anger du även attributet *strictwidth*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*strictwidth*"
msgstr "*strikt bredd*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Strictly follow column *width=* setting."
msgstr "Följ strikt inställningen för kolumn *bredd=*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*noextreme*"
msgstr "*noextreme*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Ignore unusually long cell width. See *--table-noextreme* for more details."
msgstr "Ignorera ovanligt lång cellbredd. Se *--table-noextreme* för mer information."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*wrap*"
msgstr "*wrap*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Allow using a multi-line cell for long text if necessary. See *--table-wrap* for more details."
msgstr "Tillåt användning av en cell med flera rader för lång text om det behövs. Se *--table-wrap* för mer information."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*hide*"
msgstr "*gömma*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Don't print the column. See *--table-hide* for more details."
msgstr "Skriv inte ut kolumnen. Se *--table-hide* för mer information."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*json=type*"
msgstr "*json=typ*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Define column type for JSON output. Supported types are string, number and boolean."
msgstr "Definiera kolumntyp för JSON-utdata. Typer som stöds är sträng, nummer och boolean."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-N, --table-columns* _names_"
msgstr "*-N, --table-columns* _names_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Specify column names with a comma separated list. The names are used for the table header and column addressing in option arguments. See also *--table-column*."
msgstr "Ange kolumnnamn med en kommaseparerad lista. Namnen används för tabellhuvudet och kolumnadresseringen i flaggargument. Se även *--table-column*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-l, --table-columns-limit* _number_"
msgstr "*-l, --table-columns-limit* _nummer_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Specify maximum number of input columns. The last column will contain all remaining line data if the limit is smaller than the number of the columns in the input data."
msgstr "Ange maximalt antal kolumner i indata. Den sista kolumnen kommer att innehålla alla återstående raddata om gränsen är mindre än antalet kolumner i indata."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-R, --table-right* _columns_"
msgstr "*-R, --table-right* _kolumner_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Right align text in specified columns."
msgstr "Högerjustera text i angivna kolumner."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-T, --table-truncate* _columns_"
msgstr "*-T, --table-truncate* _kolumner_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Specify columns where text can be truncated when necessary, otherwise very long table entries may be printed on multiple lines."
msgstr "Ange kolumner där texten kan förkortas vid behov, annars kan mycket långa tabellposter skrivas ut på flera rader."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-E, --table-noextreme* _columns_"
msgstr "*-E, --table-noextreme* _kolumner_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Specify columns where is possible to ignore unusually long (longer than average) cells when calculate column width. The option has impact to the width calculation and table formatting, but the printed text is not affected."
msgstr "Ange kolumner där det är möjligt att ignorera ovanligt långa (längre än genomsnittet) celler vid beräkning av kolumnbredd. Flaggan påverkar breddberäkningen och tabellformateringen, men den utskrivna texten påverkas inte."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The option is used for the last visible column by default."
msgstr "Flaggan används som standard för den sista synliga kolumnen."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-e, --table-header-repeat*"
msgstr "*-e, --table-header-repeat*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Print header line for each page."
msgstr "Skriv ut rubrikraden för varje sida."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-W, --table-wrap* _columns_"
msgstr "*-W, --table-wrap* _kolumner_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Specify columns where multi-line cells can be used for long text."
msgstr "Ange kolumner där celler med flera rader kan användas för lång text."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-H, --table-hide* _columns_"
msgstr "*-H, --table-hide* _kolumner_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Don't print specified columns. The special placeholder '-' may be used to hide all unnamed columns (see *--table-columns*)."
msgstr "Skriv inte ut angivna kolumner. Den speciella platshållaren '-' kan användas för att dölja alla namnlösa kolumner (se *--table-columns*)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-O, --table-order* _columns_"
msgstr "*-O, --table-order* _kolumner_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Specify the output column order."
msgstr "Ange kolumnordning för utdata."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-n, --table-name* _name_"
msgstr "*-n, --table-name* _namn_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Specify the table name used for JSON output. The default is \"table\"."
msgstr "Ange det tabellnamn som används för JSON-utdata. Standardvärdet är \"table\"."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-m, --table-maxout*"
msgstr "*-m, --table-maxout*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Fill all available space on output."
msgstr "Fyll i allt tillgängligt utrymme på utskriften."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-L, --keep-empty-lines*"
msgstr "*-L, --keep-empty-lines*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Preserve whitespace-only lines in the input. The default is to ignore all empty lines. This option's original name was *--table-empty-lines*, but has since been deprecated because it gives the false impression that the option only applies to table mode."
msgstr "Bevara rader med enbart blanksteg i inmatningen. Standardinställningen är att ignorera alla tomma rader. Den här flaggans ursprungliga namn var *--table-empty-lines*, men har sedan dess tagits bort eftersom det ger ett felaktigt intryck av att flaggan endast gäller för tabelläget."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-r, --tree* _column_"
msgstr "*-r, --tree* _column_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Specify the column to use for a tree-like output. Note that the circular dependencies and other anomalies in child and parent relation are silently ignored."
msgstr "Ange vilken kolumn som ska användas för en trädliknande utmatning. Observera att cirkulära beroenden och andra avvikelser i relationen mellan barn och förälder ignoreras i tysthet."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-i, --tree-id* _column_"
msgstr "*-i, --tree-id* _column_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Specify the column that contains each line's unique child IDs for a child-parent relation."
msgstr "Ange den kolumn som innehåller varje rads unika barn-ID för en barn-förälder-relation."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-p, --tree-parent* _column_"
msgstr "*-p, --tree-parent* _column_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Specify the column that contains each line's parent IDs for a child-parent relation."
msgstr "Ange den kolumn som innehåller varje rads föräldra-ID för en barn-förälder-relation."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-x, --fillrows*"
msgstr "*-x, --fillrows*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Fill rows before filling columns."
msgstr "Fyll raderna innan du fyller kolumnerna."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The environment variable *COLUMNS* is used to determine the size of the screen if no other information is available."
msgstr "Miljövariabeln *COLUMNS* används för att bestämma storleken på skärmen om ingen annan information finns tillgänglig."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The *column* command appeared in 4.3BSD-Reno."
msgstr "Kommandot *column* dök upp i 4.3BSD-Reno."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Version 2.23 changed the *-s* option to be non-greedy, for example:"
msgstr "I version 2.23 ändrades flaggan *-s* till att inte vara girig, till exempel:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "printf \"a:b:c\\n1::3\\n\" | column -t -s ':'\n"
msgstr "printf \"a:b:c\\n1::3\\n\" | kolumn -t -s ':'\n"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Old output:"
msgstr "Gammal utgång:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "a  b  c\n1  3\n"
msgstr "a b c\n1 3\n"

#. from tp:util-linux-man-2.41.2-rc1
msgid "New output (since util-linux 2.23):"
msgstr "Ny utdata (sedan util-linux 2.23):"

#. from tp:util-linux-man-2.41.2-rc1
msgid "a  b  c\n1     3\n"
msgstr "a b c\n1 3\n"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Historical versions of this tool indicated that \"rows are filled before columns\" by default, and that the *-x* option reverses this. This wording did not reflect the actual behavior, and it has since been corrected (see above). Other implementations of *column* may continue to use the older documentation, but the behavior should be identical in any case."
msgstr "I historiska versioner av detta verktyg angavs att \"rader fylls i före kolumner\" som standard och att flaggan *-x* vänder på detta. Denna formulering återspeglade inte det faktiska beteendet och har sedan dess korrigerats (se ovan). Andra implementeringar av *column* kan fortsätta att använda den äldre dokumentationen, men beteendet bör vara identiskt i vilket fall som helst."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Print fstab with a header line and align numbers to the right:"
msgstr "Skriv ut fstab med en rubrikrad och anpassa siffrorna till höger:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "sed 's/#.*//' /etc/fstab | column --table --table-columns SOURCE,TARGET,TYPE,OPTIONS,FREQ,PASS --table-right FREQ,PASS\n"
msgstr "sed 's/#.*//' /etc/fstab | column --table --table-columns SOURCE,TARGET,TYPE,OPTIONS,FREQ,PASS --table-right FREQ,PASS\n"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Print fstab and hide unnamed columns:"
msgstr "Skriv ut fstab och dölj namnlösa kolumner:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "sed 's/#.*//' /etc/fstab | column --table --table-columns SOURCE,TARGET,TYPE --table-hide -\n"
msgstr "sed 's/#.*//' /etc/fstab | column --table --table-columns SOURCE,TARGET,TYPE --table-hide -\n"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Print a tree:"
msgstr "Skriv ut ett träd:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "echo -e '1 0 A\\n2 1 AA\\n3 1 AB\\n4 2 AAA\\n5 2 AAB' | column --tree-id 1 --tree-parent 2 --tree 3\n1  0  A\n2  1  |-AA\n4  2  | |-AAA\n5  2  | `-AAB\n3  1  `-AB\n"
msgstr "echo -e '1 0 A\\n2 1 AA\\n3 1 AB\\n4 2 AAA\\n5 2 AAB' | column --tree-id 1 --tree-parent 2 --tree 3\n1 0 A\n2 1 |-AA\n4 2 | |-AAA\n5 2 | `-AAB\n3 1 `-AB\n"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*colrm*(1), *ls*(1), *paste*(1), *sort*(1)"
msgstr "*colrm*(1), *ls*(1), *paste*(1), *sort*(1)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "hexdump(1)"
msgstr "hexdump(1)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "hexdump - display file contents in hexadecimal, decimal, octal, or ascii"
msgstr "hexdump - visa filinnehåll i hexadecimal, decimal, oktal eller ascii"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*hexdump* _options file_ ..."
msgstr "*hexdump* _optionsfil_ ..."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*hd* _options file_ ..."
msgstr "*hd* _options file_ ..."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The *hexdump* utility is a filter which displays the specified files, or standard input if no files are specified, in a user-specified format."
msgstr "Verktyget *hexdump* är ett filter som visar de angivna filerna, eller standardinmatningen om inga filer anges, i ett användarspecifikt format."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Below, the _length_ and _offset_ arguments may be followed by the multiplicative suffixes KiB (=1024), MiB (=1024*1024), and so on for GiB, TiB, PiB, EiB, ZiB and YiB (the \"iB\" is optional, e.g., \"K\" has the same meaning as \"KiB\"), or the suffixes KB (=1000), MB (=1000*1000), and so on for GB, TB, PB, EB, ZB and YB."
msgstr "Nedan kan argumenten _längd_ och _offset_ följas av de multiplikativa suffixen KiB (=1024), MiB (=1024*1024), och så vidare för GiB, TiB, PiB, EiB, ZiB och YiB (\"iB\" är valfritt, t.ex, \"K\" har samma betydelse som \"KiB\"), eller suffixen KB (=1000), MB (=1000*1000), och så vidare för GB, TB, PB, EB, ZB och YB."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-b*, *--one-byte-octal*"
msgstr "*-b*, *--one-byte-octal*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "_One-byte octal display_. Display the input offset in hexadecimal, followed by sixteen space-separated, three-column, zero-filled bytes of input data, in octal, per line."
msgstr "_Oktal visning av en byte_. Visar inmatningsoffset i hexadecimal, följt av sexton mellanslagsseparerade, tre kolumner, nollfyllda bytes med inmatningsdata, i oktal, per rad."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-X*, *--one-byte-hex*"
msgstr "*-X*, *--one-byte-hex*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "_One-byte hexadecimal display_. Display the input offset in hexadecimal, followed by sixteen space-separated, two-column, zero-filled bytes of input data, in hexadecimal, per line."
msgstr "_Hexadecimal visning av en byte_. Visar inmatningsoffset i hexadecimal, följt av sexton mellanslagsseparerade, tvåkolumnerade, nollfyllda bytes med inmatningsdata, i hexadecimal, per rad."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-c*, *--one-byte-char*"
msgstr "*-c*, *--one-byte-char*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "_One-byte character display_. Display the input offset in hexadecimal, followed by sixteen space-separated, three-column, space-filled characters of input data per line."
msgstr "_Teckenvisning med en byte_. Visar inmatningsoffset i hexadecimal, följt av sexton mellanslagsseparerade, tre kolumner, mellanslagsfyllda tecken med inmatningsdata per rad."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-C*, *--canonical*"
msgstr "*-C*, *--canonical*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "_Canonical hex{plus}ASCII display_. Display the input offset in hexadecimal, followed by sixteen space-separated, two-column, hexadecimal bytes, followed by the same sixteen bytes in *%{underscore}p* format enclosed in *|* characters. Invoking the program as *hd* implies this option."
msgstr "_Canonical hex{plus}ASCII display_. Visar inmatningsoffset i hexadecimal, följt av sexton mellanslagsseparerade hexadecimala bytes i två kolumner, följt av samma sexton bytes i *%{underscore}p*-format omslutna av *|*-tecken. Om programmet anropas som *hd* innebär den här flaggan."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-d*, *--two-bytes-decimal*"
msgstr "*-d*, *--two-bytes-decimal*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "_Two-byte decimal display_. Display the input offset in hexadecimal, followed by eight space-separated, five-column, zero-filled, two-byte units of input data, in unsigned decimal, per line."
msgstr "_Två-byte decimalvisning_. Visar inmatningsoffset i hexadecimal, följt av åtta mellanslagsseparerade, femkolumners, nollfyllda, två-bytes enheter av inmatningsdata, i osignerad decimal, per rad."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-e*, *--format* _format_string_"
msgstr "*-e*, *--format* _format_sträng_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Specify a format string to be used for displaying data."
msgstr "Ange en formatsträng som ska användas för att visa data."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-f*, *--format-file* _file_"
msgstr "*-f*, *--format-file* _fil_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Specify a file that contains one or more newline-separated format strings. Empty lines and lines whose first non-blank character is a hash mark (#) are ignored."
msgstr "Ange en fil som innehåller en eller flera newline-separerade formatsträngar. Tomma rader och rader vars första tecken som inte är tomt är ett hashmärke (#) ignoreras."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Accept color units for the output. The optional argument _when_ can be *auto*, *never* or *always*. If the _when_ argument is omitted, it defaults to *auto*. The colors can be disabled; for the current built-in default see the *--help* output. See also the *Colors* subsection and the *COLORS* section below."
msgstr "Acceptera färgenheter för utdata. Det valfria argumentet _när_ kan vara *auto*, *never* eller *always*. Om argumentet _när_ utelämnas är standardvärdet *auto*. Färgerna kan inaktiveras; för den aktuella inbyggda standardinställningen, se utmatningen *--help*. Se även underavsnittet *Färger* och avsnittet *FÄRGER* nedan."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-n*, *--length* _length_"
msgstr "*-n*, *--length* _längd_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Interpret only _length_ bytes of input."
msgstr "Tolkar endast _längd_ bytes av indata."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-o*, *--two-bytes-octal*"
msgstr "*-o*, *--two-bytes-octal*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "_Two-byte octal display_. Display the input offset in hexadecimal, followed by eight space-separated, six-column, zero-filled, two-byte quantities of input data, in octal, per line."
msgstr "_Två-byte oktal display_. Visar inmatningsoffset i hexadecimal, följt av åtta mellanslagsseparerade, sex kolumner, nollfyllda, två-byte kvantiteter av inmatningsdata, i oktal, per rad."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-s*, *--skip* _offset_"
msgstr "*-s*, *--skip* _offset_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Skip _offset_ bytes from the beginning of the input."
msgstr "Hoppa över _offset_ bytes från början av inmatningen."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-v*, *--no-squeezing*"
msgstr "*-v*, *--no-squeezing*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "The *-v* option causes *hexdump* to display all input data. Without the *-v* option, any number of groups of output lines which would be identical to the immediately preceding group of output lines (except for the input offsets), are replaced with a line comprised of a single asterisk."
msgstr "Flaggan *-v* gör att *hexdump* visar alla indata. Utan flaggan *-v* ersätts valfritt antal grupper av utdatarader, som skulle vara identiska med den omedelbart föregående gruppen av utdatarader (med undantag för inmatningsoffseten), med en rad som består av en enda asterisk."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-x*, *--two-bytes-hex*"
msgstr "*-x*, *--two-bytes-hex*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "_Two-byte hexadecimal display_. Display the input offset in hexadecimal, followed by eight space-separated, four-column, zero-filled, two-byte quantities of input data, in hexadecimal, per line."
msgstr "_Två-byte hexadecimal visning_. Visar inmatningsoffset i hexadecimal, följt av åtta mellanslagsseparerade, fyra kolumner, nollfyllda, två byte stora mängder inmatningsdata i hexadecimal, per rad."

#. from tp:util-linux-man-2.41.2-rc1
msgid "For each input file, *hexdump* sequentially copies the input to standard output, transforming the data according to the format strings specified by the *-e* and *-f* options, in the order that they were specified."
msgstr "För varje indatafil kopierar *hexdump* indata sekventiellt till standardutdata och omvandlar data enligt de formatsträngar som anges med flaggorna *-e* och *-f*, i den ordning de anges."

#. from tp:util-linux-man-2.41.2-rc1
msgid "FORMATS"
msgstr "FORMAT"

#. from tp:util-linux-man-2.41.2-rc1
msgid "A format string contains any number of format units, separated by whitespace. A format unit contains up to three items: an iteration count, a byte count, and a format."
msgstr "En formatsträng innehåller ett valfritt antal formatenheter, åtskilda av blanksteg. En formatenhet innehåller upp till tre objekt: ett iterationsantal, ett byteantal och ett format."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The iteration count is an optional positive integer, which defaults to one. Each format is applied iteration count times."
msgstr "Antalet iterationer är ett valfritt positivt heltal, som i standardfallet är ett. Varje format tillämpas ett antal gånger."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The byte count is an optional positive integer. If specified it defines the number of bytes to be interpreted by each iteration of the format."
msgstr "Byteantalet är ett valfritt positivt heltal. Om det anges definierar det antalet byte som ska tolkas av varje iteration av formatet."

#. from tp:util-linux-man-2.41.2-rc1
msgid "If an iteration count and/or a byte count is specified, a single slash must be placed after the iteration count and/or before the byte count to disambiguate them. Any whitespace before or after the slash is ignored."
msgstr "Om ett iterationsantal och/eller ett byteantal anges, måste ett enkelt snedstreck placeras efter iterationsantalet och/eller före byteantalet för att skilja dem åt. Eventuella blanksteg före eller efter snedstrecket ignoreras."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The format is required and must be surrounded by double quote (\" \") marks. It is interpreted as a fprintf-style format string (see *fprintf*(3)), with the following exceptions:"
msgstr "Formatet är obligatoriskt och måste omges av dubbla citattecken (\" \"). Det tolkas som en formatsträng i fprintf-stil (se *fprintf*(3)), med följande undantag:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "1."
msgstr "1."

#. from tp:util-linux-man-2.41.2-rc1
msgid "An asterisk (*) may not be used as a field width or precision."
msgstr "En asterisk (*) får inte användas som fältbredd eller precision."

#. from tp:util-linux-man-2.41.2-rc1
msgid "2."
msgstr "2."

#. from tp:util-linux-man-2.41.2-rc1
msgid "A byte count or field precision _is_ required for each *s* conversion character (unlike the *fprintf*(3) default which prints the entire string if the precision is unspecified)."
msgstr "En byte- eller fältprecision _krävs_ för varje *s*-konverteringstecken (till skillnad från *fprintf*(3)-standarden som skriver ut hela strängen om precisionen inte är specificerad)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "3."
msgstr "3."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The conversion characters *h*, *l*, *n*, *p*, and *q* are not supported."
msgstr "Konverteringstecknen *h*, *l*, *n*, *p* och *q* stöds inte."

#. from tp:util-linux-man-2.41.2-rc1
msgid "4."
msgstr "4."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The single character escape sequences described in the C standard are supported:"
msgstr "De escape-sekvenser för enstaka tecken som beskrivs i C-standarden stöds:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "|NULL |\\0\n|<alert character> |\\a\n|<backspace> |\\b\n|<form-feed> |\\f\n|<newline> |\\n\n|<carriage return> |\\r\n|<tab> |\\t\n|<vertical tab> |\\v\n"
msgstr "|NULL |\\0\n|<alert character> |\\a\n|<backspace> |\\b\n|<form-feed> |\\f\n|<newline> |\\n\n|<carriage return> |\\r\n|<tab> |\\t\n|<vertical tab> |\\v\n"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Conversion strings"
msgstr "Konverteringssträngar"

#. from tp:util-linux-man-2.41.2-rc1
msgid "The *hexdump* utility also supports the following additional conversion strings."
msgstr "Verktyget *hexdump* har även stöd för följande ytterligare konverteringssträngar."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*_a[dox]*"
msgstr "*_a[dox]*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Display the input offset, cumulative across input files, of the next byte to be displayed. The appended characters *d*, *o*, and *x* specify the display base as decimal, octal or hexadecimal respectively."
msgstr "Visar inmatningsoffset, kumulativ över inmatningsfiler, för nästa byte som ska visas. De bifogade tecknen *d*, *o* och *x* anger visningsbasen som decimal, oktal respektive hexadecimal."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*_A[dox]*"
msgstr "*_A[dox]*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Almost identical to the *_a* conversion string except that it is only performed once, when all of the input data has been processed."
msgstr "Nästan identisk med konverteringssträngen *_a*, men den utförs bara en gång när alla indata har bearbetats."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*_c*"
msgstr "*_c*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Output characters in the default character set. Non-printing characters are displayed in three-character, zero-padded octal, except for those representable by standard escape notation (see above), which are displayed as two-character strings."
msgstr "Utmatningstecken i standardteckenuppsättningen. Tecken som inte skrivs ut visas i tre tecken, nollutfylld oktal, utom de som kan representeras av standard escape-notation (se ovan), som visas som strängar med två tecken."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*_p*"
msgstr "*_p*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Output characters in the default character set. Non-printing characters are displayed as a single '*.*'."
msgstr "Skriv ut tecken i standardteckensatsen. Tecken som inte skrivs ut visas som ett enda \"*.*\"."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*_u*"
msgstr "*_u*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Output US ASCII characters, with the exception that control characters are displayed using the following, lower-case, names. Characters greater than 0xff, hexadecimal, are displayed as hexadecimal strings."
msgstr "Utdata US ASCII-tecken, med undantag för att styrtecken visas med följande namn med små bokstäver. Tecken som är större än 0xff, hexadecimalt, visas som hexadecimala strängar."

#. from tp:util-linux-man-2.41.2-rc1
msgid "|000 nul |001 soh |002 stx |003 etx |004 eot |005 enq\n|006 ack |007 bel |008 bs |009 ht |00A lf |00B vt\n|00C ff |00D cr |00E so |00F si |010 dle |011 dc1\n|012 dc2 |013 dc3 |014 dc4 |015 nak |016 syn |017 etb\n|018 can |019 em |01A sub |01B esc |01C fs |01D gs\n|01E rs |01F us |0FF del | | |\n"
msgstr "|000 nul |001 soh |002 stx |003 etx |004 eot |005 enq\n|006 ack |007 bel |008 bs |009 ht |00A lf |00B vt\n|00C ff |00D cr |00E so |00F si |010 dle |011 dc1\n|012 dc2 |013 dc3 |014 dc4 |015 nak |016 syn |017 etb\n|018 can |019 em |01A sub |01B esc |01C fs |01D gs\n|01E rs |01F us |0FF del | | | |\n"

#. from tp:util-linux-man-2.41.2-rc1
msgid "When put at the end of a format specifier, *hexdump* highlights the respective string with the color specified. Conditions, if present, are evaluated prior to highlighting."
msgstr "När *hexdump* sätts i slutet av en formatspecifikation markeras respektive sträng med den färg som anges. Eventuella villkor utvärderas före färgmarkeringen."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*_L[color_unit_1,color_unit_2,...,color_unit_n]*"
msgstr "*_L[färg_enhet_1,färg_enhet_2,...,färg_enhet_n]*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "The full syntax of a color unit is as follows:"
msgstr "Den fullständiga syntaxen för en färgenhet är följande:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*[!]COLOR[:VALUE][@OFFSET_START[-END]]*"
msgstr "*[!]COLOR[:VALUE][@OFFSET_START[-END]]*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*!*"
msgstr "*!*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Negate the condition. Please note that it only makes sense to negate a unit if both a value/string and an offset are specified. In that case the respective output string will be highlighted if and only if the value/string does not match the one at the offset."
msgstr "Negera villkoret. Observera att det bara är meningsfullt att negera en enhet om både ett värde/en sträng och en offset anges. I så fall kommer respektive utdatasträng att markeras om och endast om värdet/strängen inte stämmer överens med värdet/strängen vid offset."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*COLOR*"
msgstr "*COLOR*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "One of the 8 basic shell colors."
msgstr "En av de 8 grundläggande skalfärgerna."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*VALUE*"
msgstr "*VÄRDE*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "A value to be matched specified in hexadecimal, or octal base, or as a string. Please note that the usual C escape sequences are not interpreted by *hexdump* inside the color_units."
msgstr "Ett värde som ska matchas specificerat i hexadecimal eller oktal bas, eller som en sträng. Observera att de vanliga C-escape-sekvenserna inte tolkas av *hexdump* inuti color_units."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*OFFSET*"
msgstr "*OFFSET*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "An offset or an offset range at which to check for a match. Please note that lone OFFSET_START uses the same value as END offset."
msgstr "En offset eller ett offsetintervall vid vilken man ska söka efter en matchning. Observera att lone OFFSET_START använder samma värde som END-offset."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Counters"
msgstr "Räknare"

#. from tp:util-linux-man-2.41.2-rc1
msgid "The default and supported byte counts for the conversion characters are as follows:"
msgstr "Standard och stödda byteantal för konverteringstecken är följande:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*%_c*, *%_p*, *%_u*, *%c*"
msgstr "*%_c*, *%_p*, *%_u*, *%c*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "One byte counts only."
msgstr "Endast en byte räknas."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*%d*, *%i*, *%o*, *%u*, *%X*, *%x*"
msgstr "*%d*, *%i*, *%o*, *%u*, *%X*, *%x*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Four byte default, one, two and four byte counts supported."
msgstr "Fyra byte som standard, stöd för en, två och fyra byte."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*%E*, *%e*, *%f*, *%G*, *%g*"
msgstr "*%E*, *%e*, *%f*, *%G*, *%g*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Eight byte default, four byte counts supported."
msgstr "Åtta byte som standard, stöd för fyra byte."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The amount of data interpreted by each format string is the sum of the data required by each format unit, which is the iteration count times the byte count, or the iteration count times the number of bytes required by the format if the byte count is not specified."
msgstr "Mängden data som tolkas av varje formatsträng är summan av de data som krävs av varje formatenhet, vilket är iterationsantalet gånger byteantalet, eller iterationsantalet gånger det antal byte som krävs av formatet om byteantalet inte anges."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The input is manipulated in _blocks_, where a block is defined as the largest amount of data specified by any format string. Format strings interpreting less than an input block's worth of data, whose last format unit both interprets some number of bytes and does not have a specified iteration count, have the iteration count incremented until the entire input block has been processed or there is not enough data remaining in the block to satisfy the format string."
msgstr "Indata hanteras i _block_, där ett block definieras som den största mängd data som anges av en formatsträng. Formatsträngar som tolkar mindre än ett indatablocks datamängd och vars sista formatenhet både tolkar ett visst antal byte och inte har ett angivet iterationsantal, får iterationsantalet ökat tills hela indatablocket har bearbetats eller tills det inte finns tillräckligt med data kvar i blocket för att uppfylla formatsträngen."

#. from tp:util-linux-man-2.41.2-rc1
msgid "If, either as a result of user specification or *hexdump* modifying the iteration count as described above, an iteration count is greater than one, no trailing whitespace characters are output during the last iteration."
msgstr "Om ett iterationsantal är större än ett, antingen som ett resultat av användarens specifikation eller *hexdump* som modifierar iterationsantalet enligt beskrivningen ovan, matas inga efterföljande blankstegstecken ut under den sista iterationen."

#. from tp:util-linux-man-2.41.2-rc1
msgid "It is an error to specify a byte count as well as multiple conversion characters or strings unless all but one of the conversion characters or strings is *_a* or *_A*."
msgstr "Det är ett fel att ange ett byteantal samt flera konverteringstecken eller strängar om inte alla utom ett av konverteringstecknen eller strängarna är *_a* eller *_A*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "If, as a result of the specification of the *-n* option or end-of-file being reached, input data only partially satisfies a format string, the input block is zero-padded sufficiently to display all available data (i.e., any format units overlapping the end of data will display some number of the zero bytes)."
msgstr "Om indata endast delvis uppfyller en formatsträng på grund av att flaggan *-n* har specificerats eller att filens slut har nåtts, nollställs indatablocket så att alla tillgängliga data visas (dvs. alla formatenheter som överlappar slutet av data kommer att visa ett visst antal nollbytes)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Further output by such format strings is replaced by an equivalent number of spaces. An equivalent number of spaces is defined as the number of spaces output by an *s* conversion character with the same field width and precision as the original conversion character or conversion string but with any '*{plus}*', ' ', '*#*' conversion flag characters removed, and referencing a NULL string."
msgstr "Ytterligare utdata från sådana formatsträngar ersätts med ett motsvarande antal mellanslag. Ett likvärdigt antal mellanslag definieras som det antal mellanslag som matas ut av ett *s*-konverteringstecken med samma fältbredd och precision som det ursprungliga konverteringstecknet eller konverteringssträngen, men med alla konverteringsflaggtecken '*{plus}*', ' ', '*#*' borttagna, och som refererar till en NULL-sträng."

#. from tp:util-linux-man-2.41.2-rc1
msgid "If no format strings are specified, the default display is very similar to the *-x* output format (the *-x* option causes more space to be used between format units than in the default output)."
msgstr "Om inga formatsträngar anges är standardvisningen mycket lik *-x*-utdataformatet (flaggan *-x* gör att mer utrymme används mellan formatenheterna än i standardutdata)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*hexdump* exits 0 on success and > 0 if an error occurred."
msgstr "*hexdump* avslutar 0 vid framgång och > 0 om ett fel inträffade."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The *hexdump* utility is expected to be IEEE Std 1003.2 (\"POSIX.2\") compatible."
msgstr "Verktyget *hexdump* förväntas vara kompatibelt med IEEE Std 1003.2 (\"POSIX.2\")."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Display the input in perusal format:"
msgstr "Visa inmatningen i genomläsningsformat:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "   \"%06.6_ao \"  12/1 \"%3_u \"\n   \"\\t\" \"%_p \"\n   \"\\n\"\n"
msgstr "   \"%06.6_ao \"  12/1 \"%3_u \"\n   \"\\t\" \"%_p \"\n   \"\\n\"\n"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Implement the *-x* option:"
msgstr "Implementera flaggan *-x*:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "   \"%07.7_Ax\\n\"\n   \"%07.7_ax  \" 8/2 \"%04x \" \"\\n\"\n"
msgstr "   \"%07.7_Ax\\n\"\n   \"%07.7_ax  \" 8/2 \"%04x \" \"\\n\"\n"

#. from tp:util-linux-man-2.41.2-rc1
msgid "MBR Boot Signature example: Highlight the addresses cyan and the bytes at offsets 510 and 511 green if their value is 0xAA55, red otherwise."
msgstr "Exempel på MBR Boot Signature: Markera adresserna med cyan och bytena vid offsets 510 och 511 med grönt om deras värde är 0xAA55, annars med rött."

#. from tp:util-linux-man-2.41.2-rc1
msgid "   \"%07.7_Ax_L[cyan]\\n\"\n   \"%07.7_ax_L[cyan]  \" 8/2 \"   %04x_L[green:0xAA55@510-511,!red:0xAA55@510-511] \" \"\\n\"\n"
msgstr "   \"%07.7_Ax_L[cyan]\\n\"\n   \"%07.7_ax_L[cyan]  \" 8/2 \"   %04x_L[green:0xAA55@510-511,!red:0xAA55@510-511] \" \"\\n\"\n"

#. from tp:util-linux-man-2.41.2-rc1
msgid "line(1)"
msgstr "line(1)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "line - read one line"
msgstr "line - läs en rad"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*line*"
msgstr "*line*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "The utility *line* copies one line (up to a newline) from standard input to standard output. It always prints at least a newline and returns an exit status of 1 on EOF or read error."
msgstr "Verktyget *line* kopierar en rad (upp till en ny rad) från standardinmatningen till standardutmatningen. Det skriver alltid ut minst en ny rad och returnerar en utgångsstatus på 1 vid EOF eller läsfel."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*read*(1p)"
msgstr "*read*(1p)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "more(1)"
msgstr "more(1)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "more - display the contents of a file in a terminal"
msgstr "more - visa innehållet i en fil i en terminal"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*more* [options] _file_ ..."
msgstr "*more* [flaggor] _fil_ ..."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*more* is a filter for paging through text one screenful at a time. This version is especially primitive. Users should realize that *less*(1) provides *more*(1) emulation plus extensive enhancements."
msgstr "*more* är ett filter för att bläddra igenom text en skärm full i taget. Den här versionen är särskilt primitiv. Användare bör inse att *less*(1) ger *more*(1)-emulering plus omfattande förbättringar."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Options are also taken from the environment variable *MORE* (make sure to precede them with a dash (*-*)) but command-line options will override those."
msgstr "Flaggor hämtas också från miljövariabeln *MORE* (se till att föregå dem med ett bindestreck (*-*)), men kommandoradsflaggor åsidosätter dessa."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-d*, *--silent*"
msgstr "*-d*, *--silent*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Prompt with \"[Press space to continue, 'q' to quit.]\", and display \"[Press 'h' for instructions.]\" instead of ringing the bell when an illegal key is pressed."
msgstr "Fråga med \"[Tryck mellanslag för att fortsätta, 'q' för att avsluta.]\" och visa \"[Tryck 'h' för instruktioner.]\" i stället för att ringa i klockan när en olaglig tangent trycks in."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-l*, *--logical*"
msgstr "*-l*, *--logical*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Do not pause after any line containing a *^L* (form feed)."
msgstr "Gör ingen paus efter en rad som innehåller *^L* (form feed)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-e*, *--exit-on-eof*"
msgstr "*-e*, *--exit-on-eof*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Exit on End-Of-File, enabled by default if POSIXLY_CORRECT environment variable is not set or if not executed on terminal."
msgstr "Avsluta på End-Of-File, aktiverad som standard om miljövariabeln POSIXLY_CORRECT inte är inställd eller om den inte körs på en terminal."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-f*, *--no-pause*"
msgstr "*-f*, *--no-pause*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Count logical lines, rather than screen lines (i.e., long lines are not folded)."
msgstr "Räkna logiska rader, snarare än skärmrader (dvs. långa rader viks inte)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-p*, *--print-over*"
msgstr "*-p*, *--print-over*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Do not scroll. Instead, clear the whole screen and then display the text. Notice that this option is switched on automatically if the executable is named *page*."
msgstr "Rulla inte. Istället rensas hela skärmen och sedan visas texten. Observera att denna flagga aktiveras automatiskt om den körbara filen har namnet *page*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-c*, *--clean-print*"
msgstr "*-c*, *--clean-print*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Do not scroll. Instead, paint each screen from the top, clearing the remainder of each line as it is displayed."
msgstr "Rulla inte. Måla istället varje skärm från början och rensa resten av varje rad allteftersom den visas."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-s*, *--squeeze*"
msgstr "*-s*, *--squeeze*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Squeeze multiple blank lines into one."
msgstr "Pressa ihop flera tomma rader till en."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-u*, *--plain*"
msgstr "*-u*, *--plain*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Suppress underlining. This option is silently ignored as backwards compatibility."
msgstr "Undertrycker understrykning. Denna flagga ignoreras som bakåtkompatibilitet."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-n*, *--lines* _number_"
msgstr "*-n*, *--lines* _nummer_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Specify the _number_ of lines per screenful. The _number_ argument is a positive decimal integer. The *--lines* option shall override any values obtained from any other source, such as number of lines reported by terminal."
msgstr "Ange _antalet_ rader per skärmfull. Argumentet _nummer_ är ett positivt decimalt heltal. Flaggan *--lines* ska åsidosätta alla värden som erhålls från någon annan källa, t.ex. antal rader som rapporteras av terminalen."

#. from tp:util-linux-man-2.41.2-rc1
msgid "**-**__number__"
msgstr "**-**__nummer__"

#. from tp:util-linux-man-2.41.2-rc1
msgid "A numeric option means the same as *--lines* option argument."
msgstr "En numerisk flagga betyder samma sak som *--lines*-flaggargument."

#. from tp:util-linux-man-2.41.2-rc1
msgid "**+**__number__"
msgstr "**+**__nummer__"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Start displaying each file at line _number_."
msgstr "Börja visa varje fil på rad _nummer_."

#. from tp:util-linux-man-2.41.2-rc1
msgid "**+**/__string__"
msgstr "**+**/__sträng__"

#. from tp:util-linux-man-2.41.2-rc1
msgid "The _string_ to be searched in each file before starting to display it."
msgstr "Den _sträng_ som ska sökas i varje fil innan den börjar visas."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Interactive commands for *more* are based on *vi*(1). Some commands may be preceded by a decimal number, called k in the descriptions below. In the following descriptions, *^X* means *control-X*."
msgstr "Interaktiva kommandon för *more* är baserade på *vi*(1). Vissa kommandon kan föregås av ett decimaltal, som kallas k i beskrivningarna nedan. I följande beskrivningar betyder *^X* *control-X*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*h* or *?*"
msgstr "*h* eller *?*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Help; display a summary of these commands. If you forget all other commands, remember this one."
msgstr "Help; visar en sammanfattning av dessa kommandon. Om du glömmer alla andra kommandon, kom ihåg det här."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*SPACE*"
msgstr "*MELLANSLAG*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Display next k lines of text. Defaults to current screen size."
msgstr "Visa nästa k rader text. Standard är aktuell skärmstorlek."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*z*"
msgstr "*z*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Display next k lines of text. Defaults to current screen size. Argument becomes new default."
msgstr "Visa nästa k rader text. Standard är aktuell skärmstorlek. Argumentet blir ny standard."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*RETURN*"
msgstr "*RETURN*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Display next k lines of text. Defaults to 1. Argument becomes new default."
msgstr "Visa nästa k rader text. Standardvärdet är 1. Argumentet blir ny standard."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*d* or *^D*"
msgstr "*d* eller *^D*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Scroll k lines. Default is current scroll size, initially 11. Argument becomes new default."
msgstr "Rulla k rader. Standard är aktuell rullningsstorlek, ursprungligen 11. Argumentet blir ny standard."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*q* or *Q* or *INTERRUPT*"
msgstr "*q* eller *Q* eller *INTERRUPT*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Exit."
msgstr "Avsluta."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Skip forward k lines of text. Defaults to 1."
msgstr "Hoppa framåt k rader i texten. Standardvärdet är 1."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*f*"
msgstr "*f*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Skip forward k screenfuls of text. Defaults to 1."
msgstr "Hoppa framåt k skärmvolymer av text. Standardvärdet är 1."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*b* or *^B*"
msgstr "*b* eller *^B*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Skip backwards k screenfuls of text. Defaults to 1. Only works with files, not pipes."
msgstr "Hoppa bakåt k skärmdumpar av text. Standardvärdet är 1. Fungerar bara med filer, inte pipes."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*'*"
msgstr "*'*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Go to the place where the last search started."
msgstr "Gå till den plats där den senaste sökningen startade."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*=*"
msgstr "*=*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Display current line number."
msgstr "Visar aktuellt radnummer."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*/pattern*"
msgstr "*/pattern*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Search for kth occurrence of regular expression. Defaults to 1."
msgstr "Sök efter den k:e förekomsten av ett reguljärt uttryck. Standardvärdet är 1."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Search for kth occurrence of last regular expression. Defaults to 1."
msgstr "Sök efter den k:e förekomsten av det sista reguljära uttrycket. Standardvärdet är 1."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*!command* or *:!command*"
msgstr "*!kommando* eller *:!kommando*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Execute _command_ in a subshell."
msgstr "Utför _kommando_ i ett underskal."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*v*"
msgstr "*v*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Start up an editor at current line. The editor is taken from the environment variable *VISUAL* if defined, or *EDITOR* if *VISUAL* is not defined, or defaults to *vi*(1) if neither *VISUAL* nor *EDITOR* is defined."
msgstr "Startar en redigerare på aktuell rad. Redigeraren hämtas från miljövariabeln *VISUAL* om den är definierad, eller *EDITOR* om *VISUAL* inte är definierad, eller standardvärdet *vi*(1) om varken *VISUAL* eller *EDITOR* är definierad."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*^L*"
msgstr "*^L*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Redraw screen."
msgstr "Rita om skärmen."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*:n*"
msgstr "*:n*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Go to kth next file. Defaults to 1."
msgstr "Gå till k:te nästa fil. Standardvärde är 1."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*:p*"
msgstr "*:p*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Go to kth previous file. Defaults to 1."
msgstr "Gå till k:te föregående fil. Standardvärdet är 1."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*:f*"
msgstr "*:f*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Display current file name and line number."
msgstr "Visar aktuellt filnamn och radnummer."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*.*"
msgstr "*.*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Repeat previous command."
msgstr "Upprepa föregående kommando."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The *more* command respects the following environment variables, if they exist:"
msgstr "Kommandot *more* respekterar följande miljövariabler, om de finns:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*MORE*"
msgstr "*MORE*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "This variable may be set with favored options to *more*."
msgstr "Denna variabel kan ställas in med favoritflaggor till *more*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Current shell in use (normally set by the shell at login time)."
msgstr "Aktuellt skal som används (ställs normalt in av skalet vid inloggning)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*TERM*"
msgstr "*TERM*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "The terminal type used by *more* to get the terminal characteristics necessary to manipulate the screen."
msgstr "Den terminaltyp som används av *fler* för att få de terminalegenskaper som krävs för att manipulera skärmen."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*VISUAL*"
msgstr "*VISUELL*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "The editor the user prefers. Invoked when command key _v_ is pressed."
msgstr "Den redigerare som användaren föredrar. Startas när kommandotangenten _v_ trycks in."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The editor of choice when *VISUAL* is not specified."
msgstr "Den redigerare som väljs när *VISUAL* inte specificeras."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Disable exit-on-eof (see option *-e* for more details)."
msgstr "Inaktivera exit-on-eof (se flaggan *-e* för mer information)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The *more* command appeared in 3.0BSD. This man page documents *more* version 5.19 (Berkeley 6/29/88), which is currently in use in the Linux community. Documentation was produced using several other versions of the man page, and extensive inspection of the source code."
msgstr "Kommandot *more* dök upp i 3.0BSD. Denna man-sida dokumenterar *more* version 5.19 (Berkeley 29/6/88), som för närvarande används i Linux-samhället. Dokumentationen togs fram med hjälp av flera andra versioner av man-sidan och omfattande inspektion av källkoden."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Eric Shienbrood, UC Berkeley."
msgstr "Eric Shienbrood, UC Berkeley."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Modified by Geoff Peck, UCB to add underlining, single spacing."
msgstr "Ändrad av Geoff Peck, UCB för att lägga till understrykning, enkelt avstånd."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Modified by John Foderaro, UCB to add -c and MORE environment variable."
msgstr "Modifierad av John Foderaro, UCB för att lägga till -c och miljövariabeln MORE."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*less*(1), *vi*(1)"
msgstr "*less*(1), *vi*(1)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "pg(1)"
msgstr "pg(1)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "pg - browse pagewise through text files"
msgstr "pg - bläddra sidvis genom textfiler"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*pg* *-*_amount_ *-p* _prompt_ *-cefnrs* +line +/pattern/ file_ ..."
msgstr "*pg* *-*_mängd_ *-p* _prompt_ *-cefnrs* +line +/pattern/ file_ ..."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*pg* displays a text file on a CRT one screenful at once. After each page, a prompt is displayed. The user may then either press the newline key to view the next page or one of the keys described below."
msgstr "*pg* visar en textfil på en CRT-skärm, en skärm full åt gången. Efter varje sida visas en prompt. Användaren kan då antingen trycka på newline-tangenten för att visa nästa sida eller på någon av de tangenter som beskrivs nedan."

#. from tp:util-linux-man-2.41.2-rc1
msgid "If no filename is given on the command line, *pg* reads from standard input. If standard output is not a terminal, *pg* acts like *cat*(1) but precedes each file with its name if there is more than one."
msgstr "Om inget filnamn anges på kommandoraden läser *pg* från standardinmatningen. Om standardutdata inte är en terminal, fungerar *pg* som *cat*(1) men föregår varje fil med dess namn om det finns mer än en."

#. from tp:util-linux-man-2.41.2-rc1
msgid "If input comes from a pipe, *pg* stores the data in a buffer file while reading, to make navigation possible."
msgstr "Om indata kommer från en pipe lagrar *pg* data i en buffertfil under läsningen för att möjliggöra navigering."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*pg* accepts the following options:"
msgstr "*pg* accepterar följande flaggor:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Start at the given line number."
msgstr "Börja vid det angivna radnumret."

#. from tp:util-linux-man-2.41.2-rc1
msgid "**+/**__pattern__*/*"
msgstr "**+/**__pattern__*/*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Start at the line containing the Basic Regular Expression _pattern_ given."
msgstr "Börja på den rad som innehåller det grundläggande reguljära uttrycket _mönster_ som anges."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The number of lines per page. By default, this is the number of CRT lines minus one."
msgstr "Antal rader per sida. Som standard är detta antalet CRT-rader minus ett."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Clear the screen before a page is displayed, if the terminfo entry for the terminal provides this capability."
msgstr "Rensa skärmen innan en sida visas, om terminalen har denna funktion i terminfo-posten."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-e*"
msgstr "*-e*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Do not pause and display _(EOF)_ at the end of a file."
msgstr "Pausa inte och visa inte _(EOF)_ i slutet av en fil."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Do not split long lines."
msgstr "Dela inte upp långa köer."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-n*"
msgstr "*-n*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Without this option, commands must be terminated by a newline character."
msgstr "Utan denna flagga måste kommandon avslutas med ett nytt radtecken."

#. from tp:util-linux-man-2.41.2-rc1
msgid "With this option, *pg* advances once a command letter is entered."
msgstr "Med denna flagga avancerar *pg* när en kommandobokstav skrivs in."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-p* _string_"
msgstr "*-p* _sträng_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Instead of the normal prompt _:_, _string_ is displayed. If _string_ contains *%d*, its first occurrence is replaced by the number of the current page."
msgstr "I stället för den normala prompten _:_ visas _sträng_. Om _sträng_ innehåller *%d* ersätts dess första förekomst av numret på den aktuella sidan."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-r*"
msgstr "*-r*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Disallow the shell escape."
msgstr "Tillåt inte att shell escape används."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Print messages in _standout_ mode, if the terminfo entry for the terminal provides this capability."
msgstr "Skriv ut meddelanden i _standout_-läge, om terminalen har denna funktion i terminfo-posten."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The following commands may be entered at the prompt. Commands preceded by _i_ in this document accept a number as argument, positive or negative. If this argument starts with *+* or *-*, it is interpreted relative to the current position in the input file, otherwise relative to the beginning."
msgstr "Följande kommandon kan anges vid prompten. Kommandon som föregås av _i_ i detta dokument accepterar ett tal som argument, positivt eller negativt. Om argumentet börjar med *+* eller *-* tolkas det i förhållande till den aktuella positionen i inmatningsfilen, annars i förhållande till början."

#. from tp:util-linux-man-2.41.2-rc1
msgid "__i__**<Enter>**"
msgstr "__i__**<Enter>**"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Display the next or the indicated page."
msgstr "Visa nästa eller den angivna sidan."

#. from tp:util-linux-man-2.41.2-rc1
msgid "__i__**d** or *^D*"
msgstr "__i__**d** eller *^D*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Display the next halfpage. If _i_ is given, it is always interpreted relative to the current position."
msgstr "Visar nästa halvsida. Om _i_ anges tolkas det alltid i förhållande till den aktuella positionen."

#. from tp:util-linux-man-2.41.2-rc1
msgid "__i__**l**"
msgstr "__i__**l**"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Display the next or the indicated line."
msgstr "Visa nästa eller den angivna raden."

#. from tp:util-linux-man-2.41.2-rc1
msgid "__i__**f**"
msgstr "__i__**f**"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Skip a page forward. _i_ must be a positive number and is always interpreted relative to the current position."
msgstr "Hoppa en sida framåt. _i_ måste vara ett positivt tal och tolkas alltid i förhållande till den aktuella positionen."

#. from tp:util-linux-man-2.41.2-rc1
msgid "__i__**w** or __i__**z**"
msgstr "__i__**w** eller __i__**z**"

#. from tp:util-linux-man-2.41.2-rc1
msgid "As *<Enter>* except that _i_ becomes the new page size."
msgstr "Som *<Enter>* förutom att _i_ blir den nya sidstorleken."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*.* or *^L*"
msgstr "*.* eller *^L*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Redraw the screen."
msgstr "Rita om skärmen."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*$*"
msgstr "*$*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Advance to the last line of the input file."
msgstr "Gå vidare till sista raden i inmatningsfilen."

#. from tp:util-linux-man-2.41.2-rc1
msgid "__i__**/**__pattern__**/**"
msgstr "__i__**/**__pattern__**/**"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Search forward until the first or the _i_-th occurrence of the Basic Regular Expression _pattern_ is found. The search starts after the current page and stops at the end of the file. No wrap-around is performed. _i_ must be a positive number."
msgstr "Sök framåt tills den första eller den _i_:e förekomsten av det grundläggande reguljära uttrycket _mönster_ hittas. Sökningen börjar efter den aktuella sidan och slutar vid slutet av filen. Ingen wrap-around utförs. _i_ måste vara ett positivt tal."

#. from tp:util-linux-man-2.41.2-rc1
msgid "__i__**?**__pattern__**?** or __i__**^**__pattern__**^**"
msgstr "__i__**?**__pattern__**?** eller __i__**^**__pattern__**^**"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Search backward until the first or the _i_-th occurrence of the Basic Regular Expression _pattern_ is found. The search starts before the current page and stops at the beginning of the file. No wrap-around is performed. _i_ must be a positive number."
msgstr "Sök bakåt tills den första eller den _i_:e förekomsten av det grundläggande reguljära uttrycket _mönster_ hittas. Sökningen börjar före den aktuella sidan och slutar vid början av filen. Ingen wrap-around utförs. _i_ måste vara ett positivt tal."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The search commands accept an added letter. If *t* is given, the line containing the pattern is displayed at the top of the screen, which is the default. *m* selects the middle and *b* the bottom of the screen. The selected position is used in following searches, too."
msgstr "Sökningskommandona accepterar en tillagd bokstav. Om *t* anges visas den rad som innehåller mönstret högst upp på skärmen, vilket är standardinställningen. *m* väljer mitten och *b* botten av skärmen. Den valda positionen används även i följande sökningar."

#. from tp:util-linux-man-2.41.2-rc1
msgid "__i__**n**"
msgstr "__i__**n**"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Advance to the next file or _i_ files forward."
msgstr "Gå vidare till nästa fil eller _i_ filer framåt."

#. from tp:util-linux-man-2.41.2-rc1
msgid "__i__**p**"
msgstr "__i__**p**"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Reread the previous file or _i_ files backward."
msgstr "Läs om föregående fil eller _i_ filer bakåt."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*s* _filename_"
msgstr "*s* _filnamn_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Save the current file to the given _filename_."
msgstr "Spara den aktuella filen till angivet _filnamn_."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Display a command summary."
msgstr "Visa en kommandosammanfattning."

#. from tp:util-linux-man-2.41.2-rc1
msgid "**!**__command__"
msgstr "**!**__kommando__"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Execute _command_ using the shell."
msgstr "Utför _kommando_ med hjälp av skalet."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*q* or *Q*"
msgstr "*q* eller *Q*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Quit."
msgstr "Avsluta."

#. from tp:util-linux-man-2.41.2-rc1
msgid "If the user presses the interrupt or quit key while *pg* reads from the input file or writes on the terminal, *pg* will immediately display the prompt. In all other situations these keys will terminate *pg*."
msgstr "Om användaren trycker på interrupt- eller quit-tangenten medan *pg* läser från inmatningsfilen eller skriver på terminalen, kommer *pg* omedelbart att visa prompten. I alla andra situationer kommer dessa tangenter att avsluta *pg*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The following environment variables affect the behavior of *pg*:"
msgstr "Följande miljövariabler påverkar *pg*:s beteende:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*COLUMNS*"
msgstr "*COLUMNS*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Overrides the system-supplied number of columns if set."
msgstr "Åsidosätter det systemangivna antalet kolumner om det är angivet."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*LANG*, *LC_ALL*, *LC_COLLATE*, *LC_CTYPE*, *LC_MESSAGES*"
msgstr "*LANG*, *LC_ALL*, *LC_COLLATE*, *LC_CTYPE*, *LC_MESSAGES*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "See *locale*(7)."
msgstr "Se *locale*(7)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*LINES*"
msgstr "*LINES*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Overrides the system-supplied number of lines if set."
msgstr "Åsidosätter det systemanpassade antalet rader om det har angetts."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Used by the *!* command."
msgstr "Används av kommandot *!*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Determines the terminal type."
msgstr "Fastställer terminaltyp."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*pg* expects the terminal tabulators to be set every eight positions."
msgstr "*pg* förväntar sig att terminalens tabulatorer ställs in på var åttonde position."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Files that include NUL characters cannot be displayed by *pg*."
msgstr "Filer som innehåller NUL-tecken kan inte visas av *pg*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*cat*(1), *more*(1), *sh*(1p), *terminfo*(5), *locale*(7), *regex*(7), *term*(7)"
msgstr "*cat*(1), *more*(1), *sh*(1p), *terminfo*(5), *locale*(7), *regex*(7), *term*(7)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "rev(1)"
msgstr "rev(1)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "rev - reverse lines characterwise"
msgstr "rev - omvända linjer teckenvis"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*rev* [option] [_file_...]"
msgstr "*rev* [flagga] [_fil_...]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "The *rev* utility copies the specified files to standard output, reversing the order of characters in every line. If no files are specified, standard input is read."
msgstr "Verktyget *rev* kopierar de angivna filerna till standardutmatningen, med omvänd teckenordning på varje rad. Om inga filer anges läses standardinmatningen."

#. from tp:util-linux-man-2.41.2-rc1
msgid "This utility is a line-oriented tool and it uses in-memory allocated buffer for a whole wide-char line. If the input file is huge and without line breaks then allocating the memory for the file may be unsuccessful."
msgstr "Detta verktyg är ett linjeorienterat verktyg och använder en minnesallokerad buffert för en hel rad med breda tecken. Om inmatningsfilen är stor och saknar radbrytningar kan det hända att det inte går att allokera minne för filen."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-0*, *--zero*"
msgstr "*-0*, *--zero*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "_Zero termination_. Use the byte '\\0' as line separator."
msgstr "_Zero avslutning_. Använd byte '\\0' som radavgränsare."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*tac*(1)"
msgstr "*tac*(1)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "ul(1)"
msgstr "ul(1)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "ul - do underlining"
msgstr "ul - gör understrykning"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*ul* [options] [_file_...]"
msgstr "*ul* [flaggor] [_fil_...]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*ul* reads the named files (or standard input if none are given) and translates occurrences of underscores to the sequence which indicates underlining for the terminal in use, as specified by the environment variable *TERM*. The _terminfo_ database is read to determine the appropriate sequences for underlining. If the terminal is incapable of underlining but is capable of a standout mode, then that is used instead. If the terminal can overstrike, or handles underlining automatically, *ul* degenerates to *cat*(1). If the terminal cannot underline, underlining is ignored."
msgstr "*ul* läser de namngivna filerna (eller standardinmatningen om ingen anges) och översätter förekomsten av understrykningar till den sekvens som anger understrykning för den terminal som används, vilket anges av miljövariabeln *TERM*. Databasen _terminfo_ läses för att avgöra vilka sekvenser som är lämpliga för understrykning. Om terminalen inte kan understryka men har ett överstrykningsläge används det i stället. Om terminalen kan överstryka, eller hanterar understrykning automatiskt, degenererar *ul* till *cat*(1). Om terminalen inte kan understryka, ignoreras understrykning."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-i*, *--indicated*"
msgstr "*-i*, *--indicated*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Underlining is indicated by a separate line containing appropriate dashes `-'; this is useful when you want to look at the underlining which is present in an *nroff* output stream on a crt-terminal."
msgstr "Understrykningar anges med en separat rad som innehåller lämpliga streck `-'; detta är användbart när du vill titta på de understrykningar som finns i en *nroff*-utmatningsström på en crt-terminal."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-t*, *-T*, *--terminal* _terminal_"
msgstr "*-t*, *-T*, *--terminal* _terminal_"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Override the environment variable *TERM* with the specified _terminal_ type."
msgstr "Åsidosätt miljövariabeln *TERM* med den angivna _terminal_-typen."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The following environment variable is used:"
msgstr "Följande miljövariabel används:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "The *TERM* variable is used to relate a tty device with its device capability description (see *terminfo*(5)). *TERM* is set at login time, either by the default terminal type specified in _/etc/ttys_ or as set during the login process by the user in their _login_ file (see *setenv*(3))."
msgstr "Variabeln *TERM* används för att relatera en tty-enhet till dess beskrivning av enhetens kapacitet (se *terminfo*(5)). *TERM* ställs in vid inloggning, antingen genom den standardterminaltyp som anges i _/etc/ttys_ eller som användaren anger i sin _login_-fil under inloggningsprocessen (se *setenv*(3))."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The *ul* command appeared in 3.0BSD."
msgstr "Kommandot *ul* dök upp i 3.0BSD."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*nroff* usually outputs a series of backspaces and underlines intermixed with the text to indicate underlining. No attempt is made to optimize the backward motion."
msgstr "*nroff* skriver vanligtvis ut en serie mellanslag och understrykningar blandat med texten för att indikera understrykning. Inga försök görs för att optimera den bakåtriktade rörelsen."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*colcrt*(1), *login*(1), *man*(1), *nroff*(1), *setenv*(3), *terminfo*(5)"
msgstr "*colcrt*(1), *login*(1), *man*(1), *nroff*(1), *setenv*(3), *terminfo*(5)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "bits(1)"
msgstr "bits(1)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "bits - convert bit masks from/to various formats"
msgstr "bits - konvertera bitmasker från/till olika format"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*bits* [*-h*] [*-V*] [*-w* _<NUM>_] [_<MODE>_] [_<MASK_OR_LIST>_...]"
msgstr "*bits* [*-h*] [*-V*] [*-w* _<NUM>_] [_<MODE>_] [_<MASK_OR_LIST>_...]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "The *bits* utility converts bit masks into various formats. It supports combining multiple masks together using bitwise operations."
msgstr "Verktyget *bits* konverterar bitmasker till olika format. Det stöder kombination av flera masker med hjälp av bitvisa operationer."

#. from tp:util-linux-man-2.41.2-rc1
msgid "POSITIONAL ARGUMENTS"
msgstr "POSITIONELLA ARGUMENT"

#. from tp:util-linux-man-2.41.2-rc1
msgid "_<MASK_OR_LIST>_"
msgstr "_<MASK_ELLER_LISTA>_ _<MASK_ELLER_LISTA"

#. from tp:util-linux-man-2.41.2-rc1
msgid "A set of bits specified as a hexadecimal mask value (e.g. _0xeec2_) or as a comma-separated list of bit IDs."
msgstr "En uppsättning bitar som anges som ett hexadecimalt maskvärde (t.ex. _0xeec2_) eller som en kommaseparerad lista med bit-ID:n."

#. from tp:util-linux-man-2.41.2-rc1
msgid "If no argument is specified, the sets of bits will be read from standard input; one group per line."
msgstr "Om inget argument anges läses bituppsättningarna in från standardinmatningen; en grupp per rad."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Consecutive ids can be compressed as ranges (e.g. _5,6,7,8,9,10_ -> _5-10_)."
msgstr "På varandra följande id:n kan komprimeras som intervall (t.ex. _5,6,7,8,9,10_ -> _5-10_)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Optionally, if an argument starts with a comma, it will be parsed as a single hexadecimal mask split in 32bit groups (e.g. _,00014000,00000000,00020000_ -> _17,78,80_)."
msgstr "Om ett argument börjar med ett kommatecken tolkas det som en hexadecimal mask uppdelad i 32-bitarsgrupper (t.ex. _,00014000,00000000,00020000_ -> _17,78,80_)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "By default all groups will be OR'ed together. If a group has one of the following prefixes, it will be combined with the resulting mask using a different binary operation:"
msgstr "Som standard kommer alla grupper att kombineras med OR. Om en grupp har något av följande prefix kombineras den med den resulterande masken med hjälp av en annan binär operation:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "**&**__<MASK_OR_LIST>__"
msgstr "**&**__<MASK_OR_LIST>__"

#. from tp:util-linux-man-2.41.2-rc1
msgid "The group will be combined with a binary AND operation. I.e. all bits that are set to 1 in the group AND the combined groups so far will be preserved to 1.  All other bits will be reset to 0."
msgstr "Gruppen kommer att kombineras med en binär AND-operation. D.v.s. alla bitar som är satta till 1 i gruppen OCH de hittills kombinerade grupperna kommer att bevaras till 1.  Alla andra bitar kommer att återställas till 0."

#. from tp:util-linux-man-2.41.2-rc1
msgid "**^**__<MASK_OR_LIST>__"
msgstr "**^**__<MASK_OR_LIST>__"

#. from tp:util-linux-man-2.41.2-rc1
msgid "The group will be combined with a binary XOR operation. I.e. all bits that are set to 1 in the group AND to 0 the combined groups so far (or the other way around) will be set to 1. Bits that are both to 1 or both to 0 will be reset to 0."
msgstr "Gruppen kommer att kombineras med en binär XOR-operation. D.v.s. alla bitar som är satta till 1 i gruppen OCH till 0 de kombinerade grupperna hittills (eller tvärtom) kommer att sättas till 1. Bitar som båda är till 1 eller båda till 0 kommer att återställas till 0."

#. from tp:util-linux-man-2.41.2-rc1
msgid "**~**__<MASK_OR_LIST>__"
msgstr "**~**__<MASK_OR_LIST>__"

#. from tp:util-linux-man-2.41.2-rc1
msgid "All bits set to 1 in the group will be cleared (reset to 0) in the combined groups so far."
msgstr "Alla bitar som är satta till 1 i gruppen kommer att rensas (återställas till 0) i de kombinerade grupperna hittills."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-w* __<NUM>__, *--width* __<NUM>__"
msgstr "*-w* __<NUM>__, *--width* __<NUM>__"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Maximum number of bits in the masks handled by *bits* (default __8192__). Any bit larger than this number will be truncated."
msgstr "Maximalt antal bitar i de masker som hanteras av *bits* (standard __8192__). Varje bit som är större än detta antal kommer att trunkeras."

#. from tp:util-linux-man-2.41.2-rc1
msgid "CONVERSION MODE"
msgstr "KONVERTERINGSLÄGE"

#. from tp:util-linux-man-2.41.2-rc1
msgid "One of the following conversion modes can be specified. If not specified, it defaults to *-m*, *--mask*."
msgstr "Ett av följande konverteringslägen kan anges. Om det inte anges är standardvärdet *-m*, *--mask*."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-m*, *--mask*"
msgstr "*-m*, *--mask*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Print the combined args as a hexadecimal mask value (default)."
msgstr "Skriv ut de kombinerade args som ett hexadecimalt maskvärde (standard)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-g*, *--grouped-mask*"
msgstr "*-g*, *--grouped-mask*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Print the combined args as a hexadecimal mask value in 32bit comma separated groups."
msgstr "Skriv ut de kombinerade args som ett hexadecimalt maskvärde i 32-bitars kommaseparerade grupper."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*-b*, *--binary*"
msgstr "*-b*, *--binary*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Print the combined args as a binary mask value."
msgstr "Skriv ut de kombinerade args som ett binärt maskvärde."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Print the combined args as a list of bit IDs. Consecutive IDs are compressed as ranges."
msgstr "Skriv ut de kombinerade args som en lista med bit-ID:n. På varandra följande ID:n komprimeras som intervall."

#. from tp:util-linux-man-2.41.2-rc1
msgid "~$ bits --mask 4,5-8 16,30\n0x400101f0\n"
msgstr "~$ bits --mask 4,5-8 16,30\n0x400101f0\n"

#. from tp:util-linux-man-2.41.2-rc1
msgid "~$ bits --list 0xeec2\n1,6,7,9-11,13-15\n"
msgstr "~$ bits --lista 0xeec2\n1,6,7,9-11,13-15\n"

#. from tp:util-linux-man-2.41.2-rc1
msgid "~$ bits --binary 4,5-8 16,30\n0b100_0000_0000_0001_0000_0001_1111_0000\n"
msgstr "~$ bits --binär 4,5-8 16,30\n0b100_0000_0000_0001_0000_0001_1111_0000\n"

#. from tp:util-linux-man-2.41.2-rc1
msgid "~$ bits --list ,00300000,03000000,30000003\n0,1,28,29,56,57,84,85\n"
msgstr "~$ bits --list ,00300000,03000000,30000003\n0,1,28,29,56,57,84,85\n"

#. from tp:util-linux-man-2.41.2-rc1
msgid "~$ bits --list 1,2,3,4 ~3-10\n1,2\n"
msgstr "~$ bits --lista 1,2,3,4 ~3-10\n1,2\n"

#. from tp:util-linux-man-2.41.2-rc1
msgid "~$ bits --list 1,2,3,4 ^3-10\n1,2,5-10\n"
msgstr "~$ bits --lista 1,2,3,4 ^3-10\n1,2,5-10\n"

#. from tp:util-linux-man-2.41.2-rc1
msgid "~$ bits --grouped-mask 2,22,74,79\n8400,00000000,00400004\n"
msgstr "~$ bits --grupperad-mask 2,22,74,79\n8400,00000000,00400004\n"

#. from tp:util-linux-man-2.41.2-rc1
msgid "~$ bits --width 64 --list 2,22,74,79\n2,22\n"
msgstr "~$ bits -bredd 64 --lista 2,22,74,79\n2,22\n"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Robin Jarry."
msgstr "Robin Jarry."

#. from tp:util-linux-man-2.41.2-rc1
msgid "lastlog2(3)"
msgstr "lastlog2(3)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "lastlog2 - Y2038 safe version of lastlog library."
msgstr "lastlog2 - Y2038 säker version av lastlog-biblioteket."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*#include <lastlog2.h>*"
msgstr "*#include <lastlog2.h>*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*lastlog2* reports the last login of a given user or of all users who did ever login on a system."
msgstr "*lastlog2* rapporterar den senaste inloggningen för en viss användare eller för alla användare som någonsin har loggat in på ett system."

#. from tp:util-linux-man-2.41.2-rc1
msgid "It's using sqlite3 as database backend. Data is only collected via a PAM module, so that all tools can make use of it, without modifying existing packages.  The output is as compatible as possible with the old lastlog implementation.  By default the database will be written as _/var/lib/lastlog/lastlog2.db_.  The size of the database depends on the amount of users, not how big the biggest UID is."
msgstr "Den använder sqlite3 som databasbackend. Data samlas endast in via en PAM-modul, så att alla verktyg kan använda den utan att ändra befintliga paket.  Utdata är så kompatibla som möjligt med den gamla lastlog-implementeringen.  Som standard kommer databasen att skrivas som _/var/lib/lastlog/lastlog2.db_.  Databasens storlek beror på antalet användare, inte på hur stort det största UID:et är."

#. from tp:util-linux-man-2.41.2-rc1
msgid "mailto:kukuk@suse.de[Thorsten Kukuk]"
msgstr "mailto:kukuk@suse.de[Thorsten Kukuk]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*lastlog2*(3), *ll2_new_context*(3), *ll2_unref_context*(3), *ll2_write_entry*(3), *ll2_read_all*(3), *ll2_read_entry*(3), *ll2_update_login_time*(3), *ll2_remove_entry*(3), *ll2_rename_user*(3), *ll2_import_lastlog*(3)"
msgstr "*lastlog2*(3), *ll2_new_context*(3), *ll2_unref_context*(3), *ll2_write_entry*(3), *ll2_read_all*(3), *ll2_read_entry*(3), *ll2_update_login_time*(3), *ll2_remove_entry*(3), *ll2_rename_user*(3), *ll2_import_lastlog*(3)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "ll2_import_lastlog(3)"
msgstr "ll2_import_lastlogg(3)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "ll2_import_lastlog - Imports old lastlog file."
msgstr "ll2_import_lastlog - Importerar gammal lastlog-fil."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*int ll2_import_lastlog (struct ll2_context *__context__,\n		         const char *__lastlog_file__,\n			 char **__error__);*\n"
msgstr "*int ll2_import_lastlog (struct ll2_context *__kontext__,\n		         const char *__lastlog_file__,\n			 char **__error__);*\n"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Imports all entries from _lastlog_file_ file (lastlog(8)) into lastlog2 database defined with _context_.  If _context_ is NULL, the default database, defined in _LL2_DEFAULT_DATABASE_, will be taken."
msgstr "Importerar alla poster från filen _lastlog_fil_ (lastlog(8)) till lastlog2-databasen som definieras med _kontext_.  Om _kontext_ är NULL kommer standarddatabasen, som definieras i _LL2_DEFAULT_DATABASE_, att användas."

#. from tp:util-linux-man-2.41.2-rc1
msgid "char    *error = NULL;\nconst   char *lastlog_path = \"/var/log/lastlog\";\n"
msgstr "char    *error = NULL;\nconst   char *lastlog_path = \"/var/log/lastlog\";\n"

#. from tp:util-linux-man-2.41.2-rc1
msgid "int ret = ll2_import_lastlog (NULL, lastlog_path, &error);\n"
msgstr "int ret = ll2_import_lastlog (NULL, lastlog_path, &error);\n"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Returns 0 on success, -ENOMEM or -1 on other failure.  _error_ contains an error string if the return value is -1.  _error_ is not guaranteed to contain an error string, could also be NULL.  _error_ should be freed by the caller."
msgstr "Returnerar 0 vid framgång, -ENOMEM eller -1 vid annat misslyckande.  _error_ innehåller en felsträng om returvärdet är -1.  det är inte garanterat att _error_ innehåller en felsträng, den kan också vara NULL.  _error_ bör frigöras av den som anropar."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*lastlog2*(3), *ll2_new_context*(3), *ll2_unref_context*(3), *ll2_read_all*(3), *ll2_write_entry*(3), *ll2_read_entry*(3), *ll2_update_login_time*(3), *ll2_rename_user*(3), *ll2_remove_entry*(3)"
msgstr "*lastlog2*(3), *ll2_new_context*(3), *ll2_unref_context*(3), *ll2_read_all*(3), *ll2_write_entry*(3), *ll2_read_entry*(3), *ll2_update_login_time*(3), *ll2_rename_user*(3), *ll2_remove_entry*(3)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "ll2_read_all(3)"
msgstr "ll2_read_all(3)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "ll2_read_all - Reads all entries from database and calls the callback function for each entry."
msgstr "ll2_read_all - Läser alla poster från databasen och anropar callback-funktionen för varje post."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*#include <lastlog2.h>*\n*int ll2_read_all (struct ll2_context *__context__,\n     		   int (*__callback__)(const char *__user__, int64_t __ll_time__,\n				       const char *__tty__, const char *__rhost__,\n				       const char *__pam_service__, const char *__cb_error__),\n 		   char **__error__);*\n"
msgstr "*#include <lastlog2.h>*\n*int ll2_read_all (struct ll2_context *__kontext__,\n     		   int (*__callback__)(const char *__user__, int64_t __ll_time__,\n				       const char *__tty__, const char *__rhost__,\n				       const char *__pam_service__, const char *__cb_error__),\n 		   char **__error__);*\n"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Reads all entries from database, defined in _context_, and calls callback function _callback_ for each entry.  If _context_ is NULL, the default database, defined in _LL2_DEFAULT_DATABASE_, will be taken."
msgstr "Läser alla poster från databasen, definierad i _kontext_, och anropar callback-funktionen _callback_ för varje post.  Om _kontext_ är NULL kommer standarddatabasen, definierad i _LL2_DEFAULT_DATABASE_, att användas."

#. from tp:util-linux-man-2.41.2-rc1
msgid "char  *error = NULL;\nconst char *user = \"root\";\n"
msgstr "char  *error = NULL;\nconst char *user = \"root\";\n"

#. from tp:util-linux-man-2.41.2-rc1
msgid "static int\ncallback (const char *res_user, int64_t ll_time, const char *res_tty,\n	  const char *res_rhost, const char *res_service, const char *cb_error)\n{\n   /* returning != 0 if no further entry has to be handled by the callback */\n   return 0;\n}\n"
msgstr "static int\ncallback (const char *res_user, int64_t ll_time, const char *res_tty,\n	  const char *res_rhost, const char *res_service, const char *cb_error)\n{\n   /* returning != 0 if no further entry has to be handled by the callback */\n   return 0;\n}\n"

#. from tp:util-linux-man-2.41.2-rc1
msgid "int ret = ll2_read_all (NULL, callback, &error);\n"
msgstr "int ret = ll2_read_all (NULL, callback, &error);\n"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Returns 0 on success, -ENOMEM or -1 on other failure.  _error_ contains an error string if the return value is -1.  _error_ is not guaranteed to contain an error string, could also be NULL.  _error_ should be freed by the caller.  If lastlog2 database does not exist at all, the errno ENOENT is set and can be checked."
msgstr "Returnerar 0 vid framgång, -ENOMEM eller -1 vid annat misslyckande.  _error_ innehåller en felsträng om returvärdet är -1.  det är inte garanterat att _error_ innehåller en felsträng, den kan också vara NULL.  _error_ bör frigöras av den som anropar.  Om databasen lastlog2 inte existerar alls, sätts errno ENOENT och kan kontrolleras."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*lastlog2*(3), *ll2_new_context*(3), *ll2_unref_context*(3), *ll2_write_entry*(3), *ll2_read_entry*(3), *ll2_update_login_time*(3), *ll2_remove_entry*(3), *ll2_rename_user*(3), *ll2_import_lastlog*(3)"
msgstr "*lastlog2*(3), *ll2_new_context*(3), *ll2_unref_context*(3), *ll2_write_entry*(3), *ll2_read_entry*(3), *ll2_update_login_time*(3), *ll2_remove_entry*(3), *ll2_rename_user*(3), *ll2_import_lastlog*(3)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "ll2_read_entry(3)"
msgstr "ll2_läsa_inmatning(3)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "ll2_read_entry - Reads one entry from database and returns that."
msgstr "ll2_read_entry - Läser en post från databasen och returnerar den."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*int ll2_read_entry (struct ll2_context *__context__, const char *__user__,\n		     int64_t *__ll_time__, char **__tty__, char **__rhost__,\n		     char **__pam_service__, char **__error__);*\n"
msgstr "*int ll2_read_entry (struct ll2_context *__kontext__, const char *__user__,\n		     int64_t *__ll_time__, char **__tty__, char **__rhost__,\n		     char **__pam_service__, char **__error__);*\n"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Reads the first entry from database, defined in _context_, for user _user_.  If _context_ is NULL, the default database, defined in _LL2_DEFAULT_DATABASE_, will be taken."
msgstr "Läser den första posten från databasen, definierad i _kontext_, för användaren _användare_.  Om _kontext_ är NULL kommer standarddatabasen, som definieras i _LL2_DEFAULT_DATABASE_, att användas."

#. from tp:util-linux-man-2.41.2-rc1
msgid "char    *error = NULL;\nconst   char *user = \"root\";\nint64_t res_time;\nchar    *res_tty = NULL;\nchar    *res_rhost = NULL;\nchar    *res_service = NULL;\n"
msgstr "char    *error = NULL;\nconst   char *user = \"root\";\nint64_t res_time;\nchar    *res_tty = NULL;\nchar    *res_rhost = NULL;\nchar    *res_service = NULL;\n"

#. from tp:util-linux-man-2.41.2-rc1
msgid "int ret = ll2_read_entry (NULL, user, &res_time, &res_tty, &res_rhost, &res_service, &error);\n"
msgstr "int ret = ll2_read_entry (NULL, user, &res_time, &res_tty, &res_rhost, &res_service, &error);\n"

#. from tp:util-linux-man-2.41.2-rc1
msgid "The evaluated values are returned by _ll_time_, _tty_, _rhost_ and _pam_service_."
msgstr "De utvärderade värdena returneras av _ll_time_, _tty_, _rhost_ och _pam_service_."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*lastlog2*(3), *ll2_new_context*(3), *ll2_unref_context*(3), *ll2_read_all*(3), *ll2_write_entry*(3), *ll2_update_login_time*(3), *ll2_remove_entry*(3), *ll2_rename_user*(3), *ll2_import_lastlog*(3)"
msgstr "*lastlog2*(3), *ll2_new_context*(3), *ll2_unref_context*(3), *ll2_read_all*(3), *ll2_write_entry*(3), *ll2_update_login_time*(3), *ll2_remove_entry*(3), *ll2_rename_user*(3), *ll2_import_lastlog*(3)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "ll2_remove_entry(3)"
msgstr "ll2_remove_entry(3)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "ll2_remove_entry - Removes all entries of a user."
msgstr "ll2_remove_entry - Tar bort alla poster för en användare."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*int ll2_remove_entry (struct ll2_context *__context__, const char *__user__,\n		       char **__error__);*\n"
msgstr "*int ll2_remove_entry (struct ll2_context *__kontext__, const char *__user__,\n		       char **__error__);*\n"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Removes all database entries, defined in _context_, with the user name _user_.  If _context_ is NULL, the default database, defined in _LL2_DEFAULT_DATABASE_, will be taken."
msgstr "Tar bort alla databasposter, definierade i _kontext_, med användarnamnet _användare_.  Om _kontext_ är NULL kommer standarddatabasen, som definieras i _LL2_DEFAULT_DATABASE_, att användas."

#. from tp:util-linux-man-2.41.2-rc1
msgid "char    *error = NULL;\nconst   char *user = \"root\";\n"
msgstr "char    *error = NULL;\nconst   char *user = \"root\";\n"

#. from tp:util-linux-man-2.41.2-rc1
msgid "int ret = ll2_remove_entry (NULL, user, &error);\n"
msgstr "int ret = ll2_remove_entry (NULL, user, &error);\n"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*lastlog2*(3), *ll2_new_context*(3), *ll2_unref_context*(3), *ll2_read_all*(3), *ll2_write_entry*(3), *ll2_read_entry*(3), *ll2_update_login_time*(3), *ll2_rename_user*(3), *ll2_import_lastlog*(3)"
msgstr "*lastlog2*(3), *ll2_new_context*(3), *ll2_unref_context*(3), *ll2_read_all*(3), *ll2_write_entry*(3), *ll2_read_entry*(3), *ll2_update_login_time*(3), *ll2_rename_user*(3), *ll2_import_lastlog*(3)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "ll2_rename_user(3)"
msgstr "ll2_rename_user(3)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "ll2_rename_user - Renames a user entry."
msgstr "ll2_rename_user - Byter namn på en användarpost."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*int ll2_rename_user (struct ll2_context *__context__, const char *__user__,\n		      const char *__newname__, char **__error__);*\n"
msgstr "*int ll2_rename_user (struct ll2_context *__kontext__, const char *__user__,\n		      const char *__newname__, char **__error__);*\n"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Changes user name from _user_ to _newname_ of one entry in database, which is defined by _context_. All other entries with the user _user_ will be deleted.  If _context_ is NULL, the default database, defined in _LL2_DEFAULT_DATABASE_, will be taken."
msgstr "Ändrar användarnamnet från _användare_ till _newname_ för en post i databasen, som definieras av _kontext_. Alla andra poster med användaren _användare_ kommer att raderas.  Om _kontext_ är NULL kommer standarddatabasen, som definieras i _LL2_DEFAULT_DATABASE_, att användas."

#. from tp:util-linux-man-2.41.2-rc1
msgid "char    *error = NULL;\nconst   char *user = \"root\";\nconst   char *new_user = \"notroot\";\n"
msgstr "char    *error = NULL;\nconst   char *user = \"root\";\nconst   char *new_user = \"notroot\";\n"

#. from tp:util-linux-man-2.41.2-rc1
msgid "int ret = ll2_rename_user (NULL, user, new_user, &error);\n"
msgstr "int ret = ll2_rename_user (NULL, user, new_user, &error);\n"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*lastlog2*(3), *ll2_new_context*(3), *ll2_unref_context*(3), *ll2_read_all*(3), *ll2_write_entry*(3), *ll2_read_entry*(3), *ll2_remove_entry*(3), *ll2_update_login_time*(3), *ll2_import_lastlog*(3)"
msgstr "*lastlog2*(3), *ll2_new_context*(3), *ll2_unref_context*(3), *ll2_read_all*(3), *ll2_write_entry*(3), *ll2_read_entry*(3), *ll2_remove_entry*(3), *ll2_update_login_time*(3), *ll2_import_lastlog*(3)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "ll2_update_login_time(3)"
msgstr "ll2_update_login_time(3)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "ll2_update_login_time - Writes a *new* entry with updated login time."
msgstr "ll2_update_login_time - Skriver en *ny* post med uppdaterad inloggningstid."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*int ll2_update_login_time (struct ll2_context *__context__,\n			    const char *__user__, int64_t __ll_time__,\n			    char **__error__);*\n"
msgstr "*int ll2_update_login_time (struct ll2_context *__kontext__,\n			    const char *__user__, int64_t __ll_time__,\n			    char **__error__);*\n"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Writes a *new* entry to database, defined in _context_, for user _user_.  Time is set by _ll_time_ whereas the other values are taken from an already existing entry.  If _context_ is NULL, the default database, defined in _LL2_DEFAULT_DATABASE_, will be taken."
msgstr "Skriver en *ny* post till databasen, definierad i _kontext_, för användaren _användare_.  Tiden anges av _ll_time_ medan de andra värdena hämtas från en redan befintlig post.  Om _kontext_ är NULL kommer standarddatabasen, som definieras i _LL2_DEFAULT_DATABASE_, att användas."

#. from tp:util-linux-man-2.41.2-rc1
msgid "char    *error = NULL;\nconst   char *user = \"root\";\nint64_t login_time = time(0); // Get the system time;\n"
msgstr "char    *error = NULL;\nconst   char *user = \"root\";\nint64_t login_time = time(0); // Get the system time;\n"

#. from tp:util-linux-man-2.41.2-rc1
msgid "int ret = ll2_update_login_time (NULL, user, login_time, &error);\n"
msgstr "int ret = ll2_update_login_time (NULL, user, login_time, &error);\n"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*lastlog2*(3), *ll2_new_context*(3), *ll2_unref_context*(3), *ll2_read_all*(3), *ll2_write_entry*(3), *ll2_read_entry*(3), *ll2_remove_entry*(3), *ll2_rename_user*(3), *ll2_import_lastlog*(3)"
msgstr "*lastlog2*(3), *ll2_new_context*(3), *ll2_unref_context*(3), *ll2_read_all*(3), *ll2_write_entry*(3), *ll2_read_entry*(3), *ll2_remove_entry*(3), *ll2_rename_user*(3), *ll2_import_lastlog*(3)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "ll2_write_entry(3)"
msgstr "ll2_write_entry(3)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "ll2_write_entry - Writes a new entry into the database."
msgstr "ll2_write_entry - Skriver en ny post i databasen."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*int ll2_write_entry (struct ll2_context *__context__, const char *__user__,\n		      int64_t __ll_time__, const char *__tty__,\n		      const char *__rhost__, const char *__pam_service__,\n		      char **__error__);*\n"
msgstr "*int ll2_write_entry (struct ll2_context *__kontext__, const char *__user__,\n		      int64_t __ll_time__, const char *__tty__,\n		      const char *__rhost__, const char *__pam_service__,\n		      char **__error__);*\n"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Writes a new entry into database, which is defined in _context_.  If _context_ is NULL, the default database, defined in _LL2_DEFAULT_DATABASE_, will be taken."
msgstr "Skriver en ny post i databasen, som definieras i _kontext_.  Om _kontext_ är NULL kommer standarddatabasen, som definieras i _LL2_DEFAULT_DATABASE_, att användas."

#. from tp:util-linux-man-2.41.2-rc1
msgid "time_t login_time = time(0); // Get the system time\nchar   *error = NULL;\nconst  char *user = \"root\";\n"
msgstr "time_t login_time = time(0); // Get the system time\nchar   *error = NULL;\nconst  char *user = \"root\";\n"

#. from tp:util-linux-man-2.41.2-rc1
msgid "int ret = ll2_write_entry (NULL, user, login_time, \"pts/0\",\n 	                   \"192.168.122.1\", NULL, &error);\n"
msgstr "int ret = ll2_write_entry (NULL, user, login_time, \"pts/0\",\n 	                   \"192.168.122.1\", NULL, &error);\n"

#. from tp:util-linux-man-2.41.2-rc1
msgid "_pam_service_ is the service or instance name which has generated the entry (optional)."
msgstr "_pam_service_ är namnet på den tjänst eller instans som har genererat posten (valfritt)."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*lastlog2*(3), *ll2_new_context*(3), *ll2_unref_context*(3), *ll2_read_all*(3), *ll2_read_entry*(3), *ll2_update_login_time*(3), *ll2_remove_entry*(3), *ll2_rename_user*(3), *ll2_import_lastlog*(3)"
msgstr "*lastlog2*(3), *ll2_new_context*(3), *ll2_unref_context*(3), *ll2_read_all*(3), *ll2_read_entry*(3), *ll2_update_login_time*(3), *ll2_remove_entry*(3), *ll2_rename_user*(3), *ll2_import_lastlog*(3)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "pam_lastlog2(8)"
msgstr "pam_lastlog2(8)"

#. from tp:util-linux-man-2.41.2-rc1
msgid "pam_lastlog2 - PAM module to display date of last login"
msgstr "pam_lastlog2 - PAM-modul för visning av datum för senaste inloggning"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*pam_lastlog2.so* [debug] [silent] [silent_if=<services>] [database=<file>]"
msgstr "*pam_lastlog2.so* [debug] [silent] [silent_if=<tjänster>] [database=<fil>]"

#. from tp:util-linux-man-2.41.2-rc1
msgid "pam_lastlog2 is a PAM module to display a line of information about the last login of the user. The module uses the /var/lib/lastlog/lastlog2.db database file to store all information."
msgstr "pam_lastlog2 är en PAM-modul som visar en rad med information om användarens senaste inloggning. Modulen använder databasfilen /var/lib/lastlog/lastlog2.db för att lagra all information."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Compared to pam_lastlog this PAM module is Y2038 safe and uses sqlite3 to store the information."
msgstr "Jämfört med pam_lastlog är den här PAM-modulen Y2038-säker och använder sqlite3 för att lagra informationen."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Print debug information."
msgstr "Skriv ut felsökningsinformation."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Avoid all messages except errors and don't inform the user about any previous login, only update the /var/lib/lastlog/lastlog2.db database."
msgstr "Undvik alla meddelanden utom felmeddelanden och informera inte användaren om någon tidigare inloggning, uppdatera bara databasen /var/lib/lastlog/lastlog2.db."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*silent_if=<services>*"
msgstr "*silent_if=<services>*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "The argument *services* is a comma separated list of PAM services. If a service is listed here, the last login message will not be shown."
msgstr "Argumentet *services* är en kommaseparerad lista över PAM-tjänster. Om en tjänst finns med i listan visas inte det senaste inloggningsmeddelandet."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*database=<file>*"
msgstr "*database=<fil>*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Use *file* instead of /var/lib/lastlog/lastlog2.db."
msgstr "Använd *file* istället för /var/lib/lastlog/lastlog2.db."

#. from tp:util-linux-man-2.41.2-rc1
msgid "MODULE TYPES PROVIDED"
msgstr "MODULTYPER SOM TILLHANDAHÅLLS"

#. from tp:util-linux-man-2.41.2-rc1
msgid "The *session* module type is provided for displaying the information about the last login and updating the lastlog file."
msgstr "Modultypen *session* finns för att visa information om den senaste inloggningen och uppdatera filen lastlog."

#. from tp:util-linux-man-2.41.2-rc1
msgid "RETURN VALUES"
msgstr "RETURVÄRDEN"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*PAM_SUCCESS*"
msgstr "*PAM_SUCCESS*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Everything was successful."
msgstr "Allt var framgångsrikt."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*PAM_SERVICE_ERR*"
msgstr "*PAM_SERVICE_ERR*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Internal service module error. This includes error reading from or writing to the database."
msgstr "Fel i den interna servicemodulen. Detta inkluderar fel vid läsning från eller skrivning till databasen."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*PAM_USER_UNKNOWN*"
msgstr "*PAM_USER_UNKNOWN*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "User not known."
msgstr "Användaren är inte känd."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*PAM_IGNORE*"
msgstr "*PAM_IGNORE*"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Returned by service types which do nothing."
msgstr "Returneras av servicetyper som inte gör någonting."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Add the following line to e.g.  /etc/pam.d/login to display the last login time of a user:"
msgstr "Lägg till följande rad i t.ex. /etc/pam.d/login för att visa den senaste inloggningstiden för en användare:"

#. from tp:util-linux-man-2.41.2-rc1
msgid "session optional pam_lastlog2.so silent_if=gdm,gdm-password"
msgstr "session valfri pam_lastlog2.so silent_if=gdm,gdm-lösenord"

#. from tp:util-linux-man-2.41.2-rc1
msgid "It is up to the administrator to decide if the user can login (optional/required) when pam_lastlog2 has returned an error."
msgstr "Det är upp till administratören att avgöra om användaren kan logga in (valfritt/krävs) när pam_lastlog2 har returnerat ett fel."

#. from tp:util-linux-man-2.41.2-rc1
msgid "pam_lastlog2 was written by Thorsten Kukuk <kukuk@suse.com>."
msgstr "pam_lastlog2 skrevs av Thorsten Kukuk <kukuk@suse.com>."

#. from tp:util-linux-man-2.41.2-rc1
msgid "*liblastlog2*(3), *pam.conf*(5), *pam.d*(5), *pam*(8)"
msgstr "*liblastlog2*(3), *pam.conf*(5), *pam.d*(5), *pam*(8)"

#. from tp:diffutils-3.10.242
msgid "Try '%s --help' for more information."
msgstr "Försök med ”%s --help” för mer information."

#. from tp:diffutils-3.10.242
msgid "unknown stream"
msgstr "okänd ström"

#. from tp:diffutils-3.10.242
msgid "failed to reopen %s with mode %s"
msgstr "det gick inte att öppna %s igen i läge %s"

#. from tp:diffutils-3.10.242
msgid "failed to open all three standard file descriptors; maybe %s or %s are not working right?"
msgstr "det gick inte att öppna alla tre standardfilbeskrivarna; kanske fungerar %s eller %s inte korrekt?"

#. from tp:diffutils-3.10.242
msgid "Files %s and %s differ\n"
msgstr "Filerna %s och %s skiljer sig\n"

#. from tp:diffutils-3.10.242
msgid "Binary files %s and %s differ\n"
msgstr "Binärfilerna %s och %s skiljer sig\n"

#. from tp:diffutils-3.10.242
msgid "No newline at end of file"
msgstr "Ingen nyrad vid filslut"

#. from tp:diffutils-3.10.242
msgid "invalid --ignore-initial value %s"
msgstr "ogiltigt värde för --ignore-initial: %s"

#. from tp:diffutils-3.10.242
msgid "options -l and -s are incompatible"
msgstr "flaggorna -l och -s är motstridiga"

#. from tp:diffutils-3.10.242
msgid "-b, --print-bytes          print differing bytes"
msgstr "-b, --print-bytes          skriv ut byte som skiljer sig"

#. from tp:diffutils-3.10.242
msgid "-i, --ignore-initial=SKIP         skip first SKIP bytes of both inputs"
msgstr "-i, --ignore-initial=HOPP         hoppa över de första HOPP bytena i båda indata"

#. from tp:diffutils-3.10.242
msgid "-i, --ignore-initial=SKIP1:SKIP2  skip first SKIP1 bytes of FILE1 and\n                                      first SKIP2 bytes of FILE2"
msgstr "-i, --ignore-initial=HOPP1:HOPP2  hoppa över de HOPP1 första byten i FIL1 och\n                                      de HOPP2 första byten i FIL2"

#. from tp:diffutils-3.10.242
msgid "-l, --verbose              output byte numbers and differing byte values"
msgstr "-l, --verbose              skriv ut bytenummer och värden för byte som skiljer sig"

#. from tp:diffutils-3.10.242
msgid "-n, --bytes=LIMIT          compare at most LIMIT bytes"
msgstr "-n, --bytes=GRÄNS          jämför högst GRÄNS byte"

#. from tp:diffutils-3.10.242
msgid "-s, --quiet, --silent      suppress all normal output"
msgstr "-s, --quiet, --silent      undertryck all normal utdata"

#. from tp:diffutils-3.10.242
msgid "    --help                 display this help and exit"
msgstr "    --help                 visa denna hjälp och avsluta"

#. from tp:diffutils-3.10.242
msgid "-v, --version              output version information and exit"
msgstr "-v, --version              visa versionsinformation och avsluta"

#. from tp:diffutils-3.10.242
msgid "Usage: %s [OPTION]... FILE1 [FILE2 [SKIP1 [SKIP2]]]\n"
msgstr "Användning: %s [FLAGGA]... FIL1 [FIL2 [HOPP1 [HOPP2]]]\n"

#. from tp:diffutils-3.10.242
msgid "Compare two files byte by byte."
msgstr "Jämför två filer byte för byte."

#. from tp:diffutils-3.10.242
msgid "The optional SKIP1 and SKIP2 specify the number of bytes to skip\nat the beginning of each file (zero by default)."
msgstr "De valfria HOPP1 och HOPP2 anger antalet byte att hoppa över\ni början av varje fil, noll som standard."

#. from tp:diffutils-3.10.242
msgid "SKIP values may be followed by the following multiplicative suffixes:\nkB 1000, K 1024, MB 1,000,000, M 1,048,576,\nGB 1,000,000,000, G 1,073,741,824, and so on for T, P, E, Z, Y."
msgstr "HOPP-värden kan följas av följande multiplikativa suffix:\nkB 1000, K 1024, MB 1 000 000, M 1 048 576\nGB 1 000 000 000, G 1 073 741 824, och så vidare för T, P, E, Z, Y."

#. from tp:diffutils-3.10.242
msgid "If a FILE is '-' or missing, read standard input."
msgstr "Om FIL är ”-” eller saknas, läs standardindata."

#. from tp:diffutils-3.10.242
msgid "Exit status is 0 if inputs are the same, 1 if different, 2 if trouble."
msgstr "Slutstatus är 0 om indata är lika, 1 om de skiljer sig och 2 vid problem."

#. from tp:diffutils-3.10.242
msgid "invalid --bytes value %s"
msgstr "ogiltigt värde för --bytes: %s"

#. from tp:diffutils-3.10.242
msgid "%s %s differ: byte %<PRIdMAX>, line %<PRIdMAX>\n"
msgstr "%s och %s skiljer sig: byte %<PRIdMAX>, rad %<PRIdMAX>\n"

#. from tp:diffutils-3.10.242
msgid "%s %s differ: byte %<PRIdMAX>, line %<PRIdMAX> is %3o %s %3o %s\n"
msgstr "%s och %s skiljer sig: byte %<PRIdMAX>, rad %<PRIdMAX> är %3o %s %3o %s\n"

#. from tp:diffutils-3.10.242
msgid "cmp: EOF on %s which is empty\n"
msgstr "cmp: EOF i %s, som är tom\n"

#. from tp:diffutils-3.10.242
msgid "cmp: EOF on %s after byte %<PRIdMAX>\n"
msgstr "cmp: EOF i %s efter byte %<PRIdMAX>\n"

#. from tp:diffutils-3.10.242
msgid "cmp: EOF on %s after byte %<PRIdMAX>, line %<PRIdMAX>\n"
msgstr "cmp: EOF i %s efter byte %<PRIdMAX>, rad %<PRIdMAX>\n"

#. from tp:diffutils-3.10.242
msgid "cmp: EOF on %s after byte %<PRIdMAX>, in line %<PRIdMAX>\n"
msgstr "cmp: EOF i %s efter byte %<PRIdMAX>, på rad %<PRIdMAX>\n"

#. from tp:diffutils-3.10.242
msgid "David Hayes"
msgstr "David Hayes"

#. from tp:diffutils-3.10.242
msgid "Richard Stallman"
msgstr "Richard Stallman"

#. from tp:diffutils-3.10.242
msgid "Len Tower"
msgstr "Len Tower"

#. from tp:diffutils-3.10.242
msgid "invalid context length %s"
msgstr "ogiltig omgivningslängd: %s"

#. from tp:diffutils-3.10.242
msgid "pagination not supported on this host"
msgstr "sidvisning stöds inte på denna värd"

#. from tp:diffutils-3.10.242
msgid "too many file label options"
msgstr "för många flaggor för etiketter"

#. from tp:diffutils-3.10.242
msgid "invalid width %s"
msgstr "ogiltig bredd %s"

#. from tp:diffutils-3.10.242
msgid "conflicting width options"
msgstr "motstridiga breddflaggor"

#. from tp:diffutils-3.10.242
msgid "invalid horizon length %s"
msgstr "ogiltig horisontlängd: %s"

#. from tp:diffutils-3.10.242
msgid "invalid tabsize %s"
msgstr "ogiltigt tabulatorsteg: %s"

#. from tp:diffutils-3.10.242
msgid "conflicting tabsize options"
msgstr "motstridiga tabulatorflaggor"

#. from tp:diffutils-3.10.242
msgid "--from-file and --to-file both specified"
msgstr "både --from-file och --to-file angavs"

#. from tp:diffutils-3.10.242
msgid "    --normal                  output a normal diff (the default)"
msgstr "    --normal                  skriv ut en normal diff, standard"

#. from tp:diffutils-3.10.242
msgid "-q, --brief                   report only when files differ"
msgstr "-q, --brief                   rapportera endast när filer skiljer sig"

#. from tp:diffutils-3.10.242
msgid "-s, --report-identical-files  report when two files are the same"
msgstr "-s, --report-identical-files  rapportera när två filer är lika"

#. from tp:diffutils-3.10.242
msgid "-c, -C NUM, --context[=NUM]   output NUM (default 3) lines of copied context"
msgstr "-c, -C ANT, --context[=ANT]   skriv ut ANT rader med kopierat sammanhang, 3 som standard"

#. from tp:diffutils-3.10.242
msgid "-u, -U NUM, --unified[=NUM]   output NUM (default 3) lines of unified context"
msgstr "-u, -U ANT, --unified[=ANT]   skriv ut ANT rader med enhetligt sammanhang, 3 som standard"

#. from tp:diffutils-3.10.242
msgid "-e, --ed                      output an ed script"
msgstr "-e, --ed                      skriv ut ett ed-skript"

#. from tp:diffutils-3.10.242
msgid "-n, --rcs                     output an RCS format diff"
msgstr "-n, --rcs                     skriv ut skillnader i RCS-format"

#. from tp:diffutils-3.10.242
msgid "-y, --side-by-side            output in two columns"
msgstr "-y, --side-by-side            skriv ut i två kolumner"

#. from tp:diffutils-3.10.242
msgid "-W, --width=NUM               output at most NUM (default 130) print columns"
msgstr "-W, --width=ANT               skriv ut högst ANT kolumner, 130 som standard"

#. from tp:diffutils-3.10.242
msgid "    --left-column             output only the left column of common lines"
msgstr "    --left-column             skriv ut endast vänstra kolumnen av gemensamma rader"

#. from tp:diffutils-3.10.242
msgid "    --suppress-common-lines   do not output common lines"
msgstr "    --suppress-common-lines   skriv inte ut gemensamma rader"

#. from tp:diffutils-3.10.242
msgid "-p, --show-c-function         show which C function each change is in"
msgstr "-p, --show-c-function         visa vilken C-funktion varje rad finns i"

#. from tp:diffutils-3.10.242
msgid "-F, --show-function-line=RE   show the most recent line matching RE"
msgstr "-F, --show-function-line=RU   visa den senaste raden som matchar RU"

#. from tp:diffutils-3.10.242
msgid "    --label LABEL             use LABEL instead of file name and timestamp\n                                (can be repeated)"
msgstr "    --label ETIKETT           använd ETIKETT istället för filnamn och\n                                tidsstämpel (kan upprepas)"

#. from tp:diffutils-3.10.242
msgid "-t, --expand-tabs             expand tabs to spaces in output"
msgstr "-t, --expand-tabs             expandera tabulatorer till blanksteg i utdata"

#. from tp:diffutils-3.10.242
msgid "-T, --initial-tab             make tabs line up by prepending a tab"
msgstr "-T, --initial-tab             justera tabulatorer genom att lägga till en inledande tabulator"

#. from tp:diffutils-3.10.242
msgid "    --tabsize=NUM             tab stops every NUM (default 8) print columns"
msgstr "    --tabsize=N               tabulatorstopp var N:e (8 som standard) kolumn"

#. from tp:diffutils-3.10.242
msgid "    --suppress-blank-empty    suppress space or tab before empty output lines"
msgstr "    --suppress-blank-empty    undertryck blanksteg eller tabulatorer före tomma utdatarader"

#. from tp:diffutils-3.10.242
msgid "-l, --paginate                pass output through 'pr' to paginate it"
msgstr "-l, --paginate                skicka utdata till ”pr” för sidindelning"

#. from tp:diffutils-3.10.242
msgid "-r, --recursive                 recursively compare any subdirectories found"
msgstr "-r, --recursive                 jämför underkataloger som hittas rekursivt"

#. from tp:diffutils-3.10.242
msgid "    --no-dereference            don't follow symbolic links"
msgstr "    --no-dereference            följ inte symboliska länkar"

#. from tp:diffutils-3.10.242
msgid "-N, --new-file                  treat absent files as empty"
msgstr "-N, --new-file                  behandla saknade filer som tomma"

#. from tp:diffutils-3.10.242
msgid "    --unidirectional-new-file   treat absent first files as empty"
msgstr "    --unidirectional-new-file   behandla saknade första filer som tomma"

#. from tp:diffutils-3.10.242
msgid "    --ignore-file-name-case     ignore case when comparing file names"
msgstr "    --ignore-file-name-case     bortse från skiftläge vid jämförelse av filnamn"

#. from tp:diffutils-3.10.242
msgid "    --no-ignore-file-name-case  consider case when comparing file names"
msgstr "    --no-ignore-file-name-case  ta hänsyn till skiftläge vid jämförelse av filnamn"

#. from tp:diffutils-3.10.242
msgid "-x, --exclude=PAT               exclude files that match PAT"
msgstr "-x, --exclude=MNS               ta inte med filer som matchar MNS"

#. from tp:diffutils-3.10.242
msgid "-X, --exclude-from=FILE         exclude files that match any pattern in FILE"
msgstr "-X, --exclude-from=FIL         uteslut filer som matchar ett mönster i FIL"

#. from tp:diffutils-3.10.242
msgid "-S, --starting-file=FILE        start with FILE when comparing directories"
msgstr "-S, --starting-file=FIL        börja med FIL när kataloger jämförs"

#. from tp:diffutils-3.10.242
msgid "    --from-file=FILE1           compare FILE1 to all operands;\n                                  FILE1 can be a directory"
msgstr "    --from-file=FIL1            jämför FIL1 med alla operander;\n                                  FIL1 kan vara en katalog"

#. from tp:diffutils-3.10.242
msgid "    --to-file=FILE2             compare all operands to FILE2;\n                                  FILE2 can be a directory"
msgstr "    --to-file=FIL2              jämför alla operander med FIL2;\n                                  FIL2 kan vara en katalog"

#. from tp:diffutils-3.10.242
msgid "-i, --ignore-case               ignore case differences in file contents"
msgstr "-i, --ignore-case               bortse från skillnader i skiftläge i filinnehåll"

#. from tp:diffutils-3.10.242
msgid "-E, --ignore-tab-expansion      ignore changes due to tab expansion"
msgstr "-E, --ignore-tab-expansion      bortse från ändringar på grund av tabulatorexpansion"

#. from tp:diffutils-3.10.242
msgid "-Z, --ignore-trailing-space     ignore white space at line end"
msgstr "-Z, --ignore-trailing-space     bortse från blanktecken i slutet av raden"

#. from tp:diffutils-3.10.242
msgid "-b, --ignore-space-change       ignore changes in the amount of white space"
msgstr "-b, --ignore-space-change       bortse från ändringar i mängden blanktecken"

#. from tp:diffutils-3.10.242
msgid "-w, --ignore-all-space          ignore all white space"
msgstr "-w, --ignore-all-space          bortse från alla blanktecken"

#. from tp:diffutils-3.10.242
msgid "-B, --ignore-blank-lines        ignore changes where lines are all blank"
msgstr "-B, --ignore-blank-lines        bortse från ändringar där rader är helt blanka"

#. from tp:diffutils-3.10.242
msgid "-I, --ignore-matching-lines=RE  ignore changes where all lines match RE"
msgstr "-I, --ignore-matching-lines=RU  bortse från ändringar där alla rader matchar RU"

#. from tp:diffutils-3.10.242
msgid "-a, --text                      treat all files as text"
msgstr "-a, --text                      behandla alla filer som text"

#. from tp:diffutils-3.10.242
msgid "    --strip-trailing-cr         strip trailing carriage return on input"
msgstr "    --strip-trailing-cr         ta bort avslutande vagnretur i indata"

#. from tp:diffutils-3.10.242
msgid "    --binary                    read and write data in binary mode"
msgstr "    --binary                    läs och skriv data i binärt läge"

#. from tp:diffutils-3.10.242
msgid "-D, --ifdef=NAME                output merged file with '#ifdef NAME' diffs"
msgstr "-D, --ifdef=NAMN                skriv sammanslagen fil med skillnader inom\n                                  ”#ifdef NAMN”"

#. from tp:diffutils-3.10.242
msgid "    --GTYPE-group-format=GFMT   format GTYPE input groups with GFMT"
msgstr "    --GTYP-group-format=GFMT    formatera GTYP-ingrupper med GFMT"

#. from tp:diffutils-3.10.242
msgid "    --line-format=LFMT          format all input lines with LFMT"
msgstr "    --line-format=RFMT          formatera alla inrader med RFMT"

#. from tp:diffutils-3.10.242
msgid "    --LTYPE-line-format=LFMT    format LTYPE input lines with LFMT"
msgstr "    --RTYP-line-format=RFMT     formatera RTYP-inrader med RFMT"

#. from tp:diffutils-3.10.242
msgid "  These format options provide fine-grained control over the output\n    of diff, generalizing -D/--ifdef."
msgstr "  Dessa formatflaggor ger detaljerad kontroll över diff:s utdata\noch generaliserar -D/--ifdef."

#. from tp:diffutils-3.10.242
msgid "  LTYPE is 'old', 'new', or 'unchanged'.  GTYPE is LTYPE or 'changed'."
msgstr "  LTYPE är ”old”, ”new” eller ”unchanged”. GTYPE är LTYPE eller ”changed”."

#. from tp:diffutils-3.10.242
msgid "  GFMT (only) may contain:\n    %<  lines from FILE1\n    %>  lines from FILE2\n    %=  lines common to FILE1 and FILE2\n    %[-][WIDTH][.[PREC]]{doxX}LETTER  printf-style spec for LETTER\n      LETTERs are as follows for new group, lower case for old group:\n        F  first line number\n        L  last line number\n        N  number of lines = L-F+1\n        E  F-1\n        M  L+1\n    %(A=B?T:E)  if A equals B then T else E"
msgstr "  GFMT (endast) kan innehålla:\n    %<  rader från FIL1\n    %>  rader från FIL2\n    %=  gemensamma rader i FIL1 och FIL2\n    %[-][BREDD][.[PREC]]{doxX}BOKSTAV  printf-lik spec. för BOKSTAV\n      BOKSTÄVER är enligt följande för ny grupp, gemen för gammal grupp:\n        F  första radnumret\n        L  sista radnumret\n        N  antal rader = L-F+1\n        E  F-1\n        M  L+1\n    %(A=B?T:E)  om A är lika med B då T annars E"

#. from tp:diffutils-3.10.242
msgid "  LFMT (only) may contain:\n    %L  contents of line\n    %l  contents of line, excluding any trailing newline\n    %[-][WIDTH][.[PREC]]{doxX}n  printf-style spec for input line number"
msgstr "  RFMT (endast) kan innehålla:\n    %L  radinnehåll\n    %l  radinnehåll exklusive avslutande nyrad\n    %[-][BREDD][.[PREC]]{doxX}n  printf-stil spec. för inradnummer"

#. from tp:diffutils-3.10.242
msgid "  Both GFMT and LFMT may contain:\n    %%  %\n    %c'C'  the single character C\n    %c'\\OOO'  the character with octal code OOO\n    C    the character C (other characters represent themselves)"
msgstr "  Både GFMT och LFMT kan innehålla:\n    %%  %\n    %c'C'  det enskilda tecknet C\n    %c'\\OOO'  tecknet med oktalkod OOO\n    C    tecknet C, övriga tecken representerar sig själva"

#. from tp:diffutils-3.10.242
msgid "-d, --minimal            try hard to find a smaller set of changes"
msgstr "-d, --minimal            försök hitta en mindre mängd ändringar"

#. from tp:diffutils-3.10.242
msgid "    --horizon-lines=NUM  keep NUM lines of the common prefix and suffix"
msgstr "    --horizon-lines=ANT  behåll ANT rader av gemensamt prefix och suffix"

#. from tp:diffutils-3.10.242
msgid "    --speed-large-files  assume large files and many scattered small changes"
msgstr "    --speed-large-files  förutsätt stora filer och många spridda små ändringar"

#. from tp:diffutils-3.10.242
msgid "    --color[=WHEN]       color output; WHEN is 'never', 'always', or 'auto';\n                           plain --color means --color='auto'"
msgstr "    --color[=NÄR]        färga utdata; NÄR är ”never”, ”always” eller\n                           ”auto”; bara --color betyder --color='auto'"

#. from tp:diffutils-3.10.242
msgid "    --palette=PALETTE    the colors to use when --color is active; PALETTE is\n                           a colon-separated list of terminfo capabilities"
msgstr "    --palette=PALETT     färger att använda när --color är aktivt; PALETT är\n                           en kolonseparerad lista över terminfo-funktioner"

#. from tp:diffutils-3.10.242
msgid "    --help               display this help and exit"
msgstr "    --help               visa denna hjälp och avsluta"

#. from tp:diffutils-3.10.242
msgid "-v, --version            output version information and exit"
msgstr "-v, --version            visa versionsinformation och avsluta"

#. from tp:diffutils-3.10.242
msgid "FILES are 'FILE1 FILE2' or 'DIR1 DIR2' or 'DIR FILE' or 'FILE DIR'."
msgstr "FILER är ”FIL1 FIL2” eller ”KAT1 KAT2” eller ”KAT FIL” eller ”FIL KAT”."

#. from tp:diffutils-3.10.242
msgid "If --from-file or --to-file is given, there are no restrictions on FILE(s)."
msgstr "Om --from-file eller --to-file anges finns inga begränsningar för FILER."

#. from tp:diffutils-3.10.242
msgid "If a FILE is '-', read standard input."
msgstr "Om en FIL är ”-”, läs standardindata."

#. from tp:diffutils-3.10.242
msgid "Usage: %s [OPTION]... FILES\n"
msgstr "Användning: %s [FLAGGA]... FILER\n"

#. from tp:diffutils-3.10.242
msgid "Compare FILES line by line."
msgstr "Jämför FILER rad för rad."

#. from tp:diffutils-3.10.242
msgid "conflicting %s option value %s"
msgstr "motstridigt värde %s för flaggan %s"

#. from tp:diffutils-3.10.242
msgid "conflicting output style options"
msgstr "motstridiga flaggor för utmatningsstil"

#. from tp:diffutils-3.10.242
msgid "invalid color %s"
msgstr "ogiltig färg %s"

#. from tp:diffutils-3.10.242
msgid "-D option not supported with directories"
msgstr "flaggan -D stödjs ej för kataloger"

#. from tp:diffutils-3.10.242
msgid "Common subdirectories: %s and %s\n"
msgstr "Gemensamma underkataloger: %s och %s\n"

#. from tp:diffutils-3.10.242
msgid "Only in %s: %s\n"
msgstr "Endast i %s: %s\n"

#. from tp:diffutils-3.10.242
msgid "File %s is a %s while file %s is a %s\n"
msgstr "Filen %s är %s medan filen %s är %s\n"

#. from tp:diffutils-3.10.242
msgid "Symbolic links %s -> %s and %s -> %s differ\n"
msgstr "De symboliska länkarna %s → %s och %s → %s skiljer sig\n"

#. from tp:diffutils-3.10.242
msgid "cannot compare '-' to a directory"
msgstr "det går inte att jämföra ”-” med en katalog"

#. from tp:diffutils-3.10.242
msgid "Files %s and %s are identical\n"
msgstr "Filerna %s och %s är lika\n"

#. from tp:diffutils-3.10.242
msgid "incompatible options"
msgstr "oförenliga flaggor"

#. from tp:diffutils-3.10.242
msgid "'-' specified for more than one input file"
msgstr "”-” har angetts för fler än en infil"

#. from tp:diffutils-3.10.242
msgid "-A, --show-all              output all changes, bracketing conflicts"
msgstr "-A, --show-all              skriv ut alla ändringar och markera konflikter"

#. from tp:diffutils-3.10.242
msgid "-e, --ed                    output ed script incorporating changes\n                                from OLDFILE to YOURFILE into MYFILE"
msgstr "-e, --ed                    skriv ut ett ed-skript som innehåller ändringar\n                                från GAMMALFIL till DINFIL i MINFIL"

#. from tp:diffutils-3.10.242
msgid "-E, --show-overlap          like -e, but bracket conflicts"
msgstr "-E, --show-overlap          som -e, men med markeringar runt konflikter"

#. from tp:diffutils-3.10.242
msgid "-3, --easy-only             like -e, but incorporate only nonoverlapping changes"
msgstr "-3, --easy-only             som -e, men använd endast icke-överlappande ändringar"

#. from tp:diffutils-3.10.242
msgid "-x, --overlap-only          like -e, but incorporate only overlapping changes"
msgstr "-x, --overlap-only          som -e, men använd endast överlappande ändringar"

#. from tp:diffutils-3.10.242
msgid "-X                          like -x, but bracket conflicts"
msgstr "-X                          som -x, men markera konflikter"

#. from tp:diffutils-3.10.242
msgid "-i                          append 'w' and 'q' commands to ed scripts"
msgstr "-i                          lägg till ”w”- och ”q”-kommandon till ed-skript"

#. from tp:diffutils-3.10.242
msgid "-m, --merge                 output actual merged file, according to\n                                -A if no other options are given"
msgstr "-m, --merge                 skriv ut den faktiska sammanslagna filen enligt\n                                -A om inga andra flaggor anges"

#. from tp:diffutils-3.10.242
msgid "-a, --text                  treat all files as text"
msgstr "-a, --text                  behandla alla filer som text"

#. from tp:diffutils-3.10.242
msgid "    --strip-trailing-cr     strip trailing carriage return on input"
msgstr "    --strip-trailing-cr     ta bort avslutande vagnretur i indata"

#. from tp:diffutils-3.10.242
msgid "-T, --initial-tab           make tabs line up by prepending a tab"
msgstr "-T, --initial-tab           justera tabulatorer genom att lägga till en inledande tabulator"

#. from tp:diffutils-3.10.242
msgid "    --diff-program=PROGRAM  use PROGRAM to compare files"
msgstr "    --diff-program=PROGRAM  använd PROGRAM för att jämföra filer"

#. from tp:diffutils-3.10.242
msgid "-L, --label=LABEL           use LABEL instead of file name\n                                (can be repeated up to three times)"
msgstr "-L, --label=ETIKETT         använd ETIKETT i stället för filnamn\n                                kan upprepas högst tre gånger"

#. from tp:diffutils-3.10.242
msgid "-v, --version               output version information and exit"
msgstr "-v, --version               visa versionsinformation och avsluta"

#. from tp:diffutils-3.10.242
msgid "Usage: %s [OPTION]... MYFILE OLDFILE YOURFILE\n"
msgstr "Användning: %s [FLAGGA]... MINFIL GAMMALFIL DINFIL\n"

#. from tp:diffutils-3.10.242
msgid "Compare three files line by line."
msgstr "Jämför tre filer rad för rad."

#. from tp:diffutils-3.10.242
msgid "\nThe default output format is a somewhat human-readable representation of\nthe changes.\n\nThe -e, -E, -x, -X (and corresponding long) options cause an ed script\nto be output instead of the default.\n\nFinally, the -m (--merge) option causes diff3 to do the merge internally\nand output the actual merged file.  For unusual input, this is more\nrobust than using ed.\n"
msgstr "\nStandardformatet för utdata är en någorlunda läsbar representation av\nändringarna.\n\nFlaggorna -e, -E, -x och -X, och motsvarande långa flaggor, gör att ett ed-skript\nskrivs ut i stället för standardformatet.\n\nSlutligen gör flaggan -m (--merge) att diff3 slår samman internt\noch skriver ut den faktiska sammanslagna filen. För ovanlig indata är detta\nmer robust än att använda ed.\n"

#. from tp:diffutils-3.10.242
msgid "Exit status is 0 if successful, 1 if conflicts, 2 if trouble."
msgstr "Slutstatus är 0 om det lyckas, 1 vid konflikter och 2 vid problem."

#. from tp:diffutils-3.10.242
msgid "internal error: screwup in format of diff blocks"
msgstr "internt fel: fel i formatet för diffblock"

