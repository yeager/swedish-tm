#. from tp:gettext-runtime-1.0-pre2
msgid "Usage: %s [OPTION] [SHELL-FORMAT]\n"
msgstr "Användning: %s [FLAGGA] [SKALFORMAT]\n"

#. from tp:gettext-runtime-1.0-pre2
msgid "Substitutes the values of environment variables.\n"
msgstr "Ersätter värdena av miljövariabler.\n"

#. from tp:gettext-runtime-1.0-pre2
msgid "Operation mode:\n"
msgstr "Körläge:\n"

#. from tp:gettext-runtime-1.0-pre2
msgid "  -v, --variables             output the variables occurring in SHELL-FORMAT\n"
msgstr "  -v, --variables             skriv ut variabler som förekommer i SKALFORMAT\n"

#. from tp:gettext-runtime-1.0-pre2
msgid "Informative output:\n"
msgstr "Informativ utskrift:\n"

#. from tp:gettext-runtime-1.0-pre2
msgid "  -h, --help                  display this help and exit\n"
msgstr "  -h, --help                  visa denna hjälptext och avsluta\n"

#. from tp:gettext-runtime-1.0-pre2
msgid "  -V, --version               output version information and exit\n"
msgstr "  -V, --version               visa versionsinformation och avsluta\n"

#. from tp:gettext-runtime-1.0-pre2
msgid "In normal operation mode, standard input is copied to standard output,\nwith references to environment variables of the form $VARIABLE or ${VARIABLE}\nbeing replaced with the corresponding values.  If a SHELL-FORMAT is given,\nonly those environment variables that are referenced in SHELL-FORMAT are\nsubstituted; otherwise all environment variables references occurring in\nstandard input are substituted.\n"
msgstr "I normalt körläge kopieras standardindata till standardutdata och referenser till miljövariabler i formen $VARIABEL eller ${VARIABEL} ersätts med motsvarande värden. Om SKALFORMAT anges ersätts endast de miljövariabler som refereras i SKALFORMAT; annars ersätts alla referenser till miljövariabler i standardindata.\n"

#. from tp:gettext-runtime-1.0-pre2
msgid "When --variables is used, standard input is ignored, and the output consists\nof the environment variables that are referenced in SHELL-FORMAT, one per line.\n"
msgstr "När --variables används ignoreras standardindata och utdata består av miljövariablerna som refereras i SKALFORMAT, en per rad.\n"

#. from tp:gettext-runtime-1.0-pre2
msgid "Report bugs in the bug tracker at <%s>\nor by email to <%s>.\n"
msgstr "Rapportera fel till feluppföljaren på <%s>\neller med e-post till <%s>.\nRapportera fel och synpunkter på översättningen\ntill <tp-sv@listor.tp-sv.se>.\n"

#. from tp:gettext-runtime-1.0-pre2
msgid "error while reading \"%s\""
msgstr "fel uppstod då ”%s” lästes"

#. from tp:gettext-runtime-1.0-pre2
msgid "Usage: %s [OPTION] [[TEXTDOMAIN] MSGID]\nor:    %s [OPTION] -s [MSGID]...\n"
msgstr "Användning: %s [FLAGGA] [[TEXTDOMÄN] MEDID]\neller       %s [FLAGGA] -s [MEDID]…\n"

#. from tp:gettext-runtime-1.0-pre2
msgid "Display native language translation of a textual message.\n"
msgstr "Visa lokala språkets översättning av textmeddelande.\n"

#. from tp:gettext-runtime-1.0-pre2
msgid "Options and arguments:\n"
msgstr "Flaggor och argument:\n"

#. from tp:gettext-runtime-1.0-pre2
msgid "  -d, --domain=TEXTDOMAIN   retrieve translated messages from TEXTDOMAIN\n"
msgstr "  -d, --domain=TEXTDOMÄN    hämta översatta meddelanden från TEXTDOMÄN\n"

#. from tp:gettext-runtime-1.0-pre2
msgid "  -c, --context=CONTEXT     specify context for MSGID\n"
msgstr "  -c, --context=KONTEXT     ange kontext för MEDID\n"

#. from tp:gettext-runtime-1.0-pre2
msgid "  -e                        enable expansion of some escape sequences\n"
msgstr "  -e                        aktivera expansion av några styrsekvenser\n"

#. from tp:gettext-runtime-1.0-pre2
msgid "  -n                        suppress trailing newline\n"
msgstr "  -n                        undertryck avslutande nyrad\n"

#. from tp:gettext-runtime-1.0-pre2
msgid "  -E                        (ignored for compatibility)\n"
msgstr "  -E                        (ignoreras för kompatibilitet)\n"

#. from tp:gettext-runtime-1.0-pre2
msgid "  [TEXTDOMAIN] MSGID        retrieve translated message corresponding\n                            to MSGID from TEXTDOMAIN\n"
msgstr "  [TEXTDOMÄN] MEDID         hämta ett översatt meddelande motsvarande\n                            MEDID från TEXTDOMÄN\n"

#. from tp:gettext-runtime-1.0-pre2
msgid "  -h, --help                display this help and exit\n"
msgstr "  -h, --help                visa denna hjälptext och avsluta\n"

#. from tp:gettext-runtime-1.0-pre2
msgid "  -V, --version             display version information and exit\n"
msgstr "  -V, --version             visa versionsinformation och avsluta\n"

#. from tp:gettext-runtime-1.0-pre2
msgid "If the TEXTDOMAIN parameter is not given, the domain is determined from the\nenvironment variable TEXTDOMAIN.  If the message catalog is not found in the\nregular directory, another location can be specified with the environment\nvariable TEXTDOMAINDIR.\nWhen used with the -s option the program behaves like the 'echo' command.\nBut it does not simply copy its arguments to stdout.  Instead those messages\nfound in the selected catalog are translated.\nStandard search directory: %s\n"
msgstr "Om parametern TEXTDOMÄN inte anges bestäms domänen av miljövariabeln TEXTDOMAIN. Om meddelandekatalogen inte hittas i den vanliga katalogen kan en annan plats anges med miljövariabeln TEXTDOMAINDIR.\nNär flaggan -s används beter sig programmet som kommandot ”echo”. Men det kopierar inte enbart sina argument till standardutdata. I stället översätts de argument som finns i den valda meddelandekatalogen.\nStandardkatalog för meddelandekataloger: %s\n"

#. from tp:gettext-runtime-1.0-pre2
msgid "Usage: %s [OPTION] [TEXTDOMAIN] MSGID MSGID-PLURAL COUNT\n"
msgstr "Användning: %s [FLAGGA] [TEXTDOMÄN] MEDID MEDID-PLURAL ANTAL\n"

#. from tp:gettext-runtime-1.0-pre2
msgid "Display native language translation of a textual message whose grammatical\nform depends on a number.\n"
msgstr "Visa översättningar i det lokala språket av textmeddelanden vars grammatiska\nform beror på ett tal.\n"

#. from tp:gettext-runtime-1.0-pre2
msgid "  -d, --domain=TEXTDOMAIN   retrieve translated message from TEXTDOMAIN\n"
msgstr "  -d, --domain=TEXTDOMÄN    hämta ett översatt meddelande från TEXTDOMÄN\n"

#. from tp:gettext-runtime-1.0-pre2
msgid "  [TEXTDOMAIN]              retrieve translated message from TEXTDOMAIN\n"
msgstr "  [TEXTDOMÄN]               hämta ett översatt meddelande från TEXTDOMÄN\n"

#. from tp:gettext-runtime-1.0-pre2
msgid "  MSGID MSGID-PLURAL        translate MSGID (singular) / MSGID-PLURAL (plural)\n"
msgstr "  MEDID MEDID-PLURAL        översätt MEDID (singular) / MEDID-PLURAL (plural)\n"

#. from tp:gettext-runtime-1.0-pre2
msgid "  COUNT                     choose singular/plural form based on this value\n"
msgstr "  ANTAL                     välj singular- eller pluralform utifrån detta värde\n"

#. from tp:gettext-runtime-1.0-pre2
msgid "If the TEXTDOMAIN parameter is not given, the domain is determined from the\nenvironment variable TEXTDOMAIN.  If the message catalog is not found in the\nregular directory, another location can be specified with the environment\nvariable TEXTDOMAINDIR.\nStandard search directory: %s\n"
msgstr "Om parametern TEXTDOMÄN utelämnas bestäms domänen av miljövariabeln\nTEXTDOMAIN. Om meddelandekatalogen inte hittas i den normala katalogen så\nkan en annan katalog anges med miljövariabeln TEXTDOMAINDIR.\nNormal katalog för meddelandekataloger: %s\n"

#. from tp:gettext-runtime-1.0-pre2
msgid "In the directive number %zu, the argument number 0 is not a positive integer."
msgstr "I direktiv nummer %zu är inte argument nummer 0 ett positivt heltal."

#. from tp:gettext-runtime-1.0-pre2
msgid "The string ends in the middle of a directive."
msgstr "Strängen slutar mitt i ett direktiv."

#. from tp:gettext-runtime-1.0-pre2
msgid "In the directive number %zu, the character '%c' is not a valid conversion specifier."
msgstr "I direktiv nummer %zu är inte tecknet ”%c” en giltig konverteringsspecificerare."

#. from tp:gettext-runtime-1.0-pre2
msgid "The character that terminates the directive number %zu is not a valid conversion specifier."
msgstr "Tecknet som avslutar direktiv nummer %zu är inte en giltig konverteringsspecificerare."

#. from tp:gettext-runtime-1.0-pre2
msgid "In the directive number %zu, the flag '%c' is invalid for the conversion '%c'."
msgstr "I direktiv nummer %zu är flaggan ”%c” felaktig för konverteringen ”%c”."

#. from tp:gettext-runtime-1.0-pre2
msgid "The string refers to arguments both through absolute argument numbers and through unnumbered argument specifications."
msgstr "Strängen refererar till argument både genom absoluta argumentnummer och genom onumrerade argumentspecifikationer."

#. from tp:gettext-runtime-1.0-pre2
msgid "The string ends in the middle of an escape sequence."
msgstr "Strängen slutar mitt i en styrsekvens."

#. from tp:gettext-runtime-1.0-pre2
msgid "The escape sequence '%c%c' is unsupported (not in POSIX)."
msgstr "Styrsekvensen ”%c%c” stödjs inte (inte i POSIX)."

#. from tp:gettext-runtime-1.0-pre2
msgid "The escape sequence '%c%c' is invalid."
msgstr "Styrsekvensen ”%c%c” är felaktig."

#. from tp:gettext-runtime-1.0-pre2
msgid "This escape sequence is invalid."
msgstr "Denna styrsekvens är felaktig."

#. from tp:gettext-runtime-1.0-pre2
msgid "The translated format string consumes %zu arguments, whereas the original format string consumes only %zu arguments."
msgstr "Den översatta formatsträngen konsumerar %zu argument, medan originalets formatsträng endast konsumerar %zu argument."

#. from tp:gettext-runtime-1.0-pre2
msgid "missing format string"
msgstr "formatsträng saknas"

#. from tp:gettext-runtime-1.0-pre2
msgid "Usage: %s [OPTION] FORMAT [ARGUMENT]...\n"
msgstr "Användning: %s [FLAGGA] FORMAT [ARGUMENT]…\n"

#. from tp:gettext-runtime-1.0-pre2
msgid "Produces formatted output, applying the native language translation of FORMAT\nto the ARGUMENTs.\n"
msgstr "Producerar formaterad utdata genom att tillämpa översättningen av FORMAT till ARGUMENTen på det lokala språket.\n"

#. from tp:gettext-runtime-1.0-pre2
msgid "  -c, --context=CONTEXT     specify context for FORMAT\n"
msgstr "  -c, --context=KONTEXT     ange kontext för FORMAT\n"

#. from tp:gettext-runtime-1.0-pre2
msgid "  FORMAT                    format string\n"
msgstr "  FORMAT                    formatsträng\n"

#. from tp:gettext-runtime-1.0-pre2
msgid "  ARGUMENT                  string or numeric argument\n"
msgstr "  ARGUMENT                  sträng- eller numeriskt argument\n"

#. from tp:gettext-runtime-1.0-pre2
msgid "The format string consists of\n  - plain text,\n  - directives, that start with '%c',\n  - escape sequences, that start with a backslash.\n"
msgstr "Formatsträngen består av\n  - vanlig text,\n  - direktiv, som inleds med ”%c”,\n  - styrsekvenser, som inleds med ett omvänt snedstreck.\n"

#. from tp:gettext-runtime-1.0-pre2
msgid "A directive that consumes an argument\n  - starts with '%s' or '%s' where %s is a positive integer,\n  - is optionally followed by any of the characters '%c', '%c', '%c', '%c', '%c',\n    each of which acts as a flag,\n  - is optionally followed by a width specification (a nonnegative integer),\n  - is optionally followed by '%c' and a precision specification (an optional\n    nonnegative integer),\n  - is finished by a specifier\n      - '%c', that prints a character,\n      - '%c', that prints a string,\n      - '%c', '%c', that print an integer,\n      - '%c', '%c', '%c', '%c', that print an unsigned (nonnegative) integer,\n      - '%c', '%c', that print a floating-point number in scientific notation,\n      - '%c', '%c', that print a floating-point number without an exponent,\n      - '%c', '%c', that print a floating-point number in general notation,\n      - '%c', '%c', that print a floating-point number in hexadecimal notation.\nAdditionally there is the directive '%s', that prints a single '%c'.\n"
msgstr "Ett direktiv som använder ett argument\n  - inleds med ”%s” eller ”%s”, där %s är ett positivt heltal,\n  - följs eventuellt av något av tecknen ”%c”, ”%c”, ”%c”, ”%c”, ”%c”,\n    som vart och ett fungerar som en flagga,\n  - följs eventuellt av en breddspecifikation (ett ickenegativt heltal),\n  - följs eventuellt av ”%c” och en precisionsspecifikation (ett eventuellt\n    ickenegativt heltal),\n  - avslutas med en specificerare\n      - ”%c”, som skriver ett tecken,\n      - ”%c”, som skriver en sträng,\n      - ”%c”, ”%c”, som skriver ett heltal,\n      - ”%c”, ”%c”, ”%c”, ”%c”, som skriver ett teckenlöst (ickenegativt) heltal,\n      - ”%c”, ”%c”, som skriver ett flyttal i vetenskaplig notation,\n      - ”%c”, ”%c”, som skriver ett flyttal utan exponent,\n      - ”%c”, ”%c”, som skriver ett flyttal i allmän notation,\n      - ”%c”, ”%c”, som skriver ett flyttal i hexadecimal notation.\nDessutom finns direktivet ”%s”, som skriver ett ensamt ”%c”.\n"

#. from tp:gettext-runtime-1.0-pre2
msgid "If a directive specifies the argument by its number ('%s' notation),\nall directives that consume an argument must do so.\n"
msgstr "Om ett direktiv anger argumentet med sitt nummer (notationen ”%s”),\nmåste alla direktiv som konsumerar ett argument göra det.\n"

#. from tp:gettext-runtime-1.0-pre2
msgid "The escape sequences are:\n\n  %s      backslash\n  %s      alert (BEL)\n  %s      backspace (BS)\n  %s      form feed (FF)\n  %s      new line (LF)\n  %s      carriage return (CR)\n  %s      horizontal tab (HT)\n  %s      vertical tab (VT)\n  %s    octal number with 1 to 3 octal digits\n"
msgstr "Styrsekvenserna är:\n\n  %s      omvänt snedstreck\n  %s      alarm (BEL)\n  %s      baksteg (BS)\n  %s      sidmatning (FF)\n  %s      nyrad (LF)\n  %s      vagnretur (CR)\n  %s      horisontell tabulator (HT)\n  %s      vertikal tabulator (VT)\n  %s    oktalt nummer med 1 till 3 oktala siffror\n"

#. from tp:gettext-runtime-1.0-pre2
msgid "Environment variables:\n"
msgstr "Miljövariabler:\n"

#. from tp:gettext-runtime-1.0-pre2
msgid "The translation of the format string is looked up in the translation domain\ngiven by the environment variable %s.\n"
msgstr "Översättningen av formatsträngen slås upp i översättningsdomänen\nsom anges av miljövariabeln %s.\n"

#. from tp:gettext-runtime-1.0-pre2
msgid "It is looked up in the catalogs directory given by the environment variable\n%s or, if not present, in the default catalogs directory.\nThis binary is configured to use the default catalogs directory:\n%s\n"
msgstr "Den slås upp i katalogen som anges av miljövariabeln\n%s eller, om den inte finns, i standardkatalogen.\nDen här binärfilen är konfigurerad att använda standardkatalogen:\n%s\n"

#. from tp:gettext-runtime-1.0-pre2
msgid "Usage: %s [OPTION] FORMAT FORMAT-PLURAL COUNT [ARGUMENT]...\n"
msgstr "Användning: %s [FLAGGA] FORMAT FORMAT-PLURAL ANTAL [ARGUMENT]…\n"

#. from tp:gettext-runtime-1.0-pre2
msgid "Produces formatted output, applying the native language translation of FORMAT\nand FORMAT-PLURAL, depending on COUNT, to the ARGUMENTs.\n"
msgstr "Producerar formaterad utdata, med tillämpning av det egna språkets översättning\nav FORMAT och FORMAT-PLURAL, beroende på ANTAL, på ARGUMENTen.\n"

#. from tp:gettext-runtime-1.0-pre2
msgid "  FORMAT                    English singular form of format string\n"
msgstr "  FORMAT                    Engelsk singularform av formatsträngen\n"

#. from tp:gettext-runtime-1.0-pre2
msgid "  FORMAT-PLURAL             English plural form of format string\n"
msgstr "  FORMAT-PLURAL             Engelsk pluralform av formatsträngen\n"

#. from tp:gettext-runtime-1.0-pre2
msgid "Each format string consists of\n  - plain text,\n  - directives, that start with '%c',\n  - escape sequences, that start with a backslash.\n"
msgstr "Varje formatsträng består av\n  - vanlig text,\n  - direktiv, som inleds med ”%c”,\n  - styrsekvenser, som inleds med ett omvänt snedstreck.\n"

#. from tp:gettext-tools-1.0-pre2
msgid "Could not parse file %s as XML"
msgstr "Kunde inte tolka filen %s som XML"

#. from tp:gettext-tools-1.0-pre2
msgid "The root element must be <%s>"
msgstr "Rotelementet måste vara <%s>"

#. from tp:gettext-tools-1.0-pre2
msgid "The element <%s> does not contain a <%s> element"
msgstr "Elementet <%s> innehåller inte ett <%s>-element"

#. from tp:gettext-tools-1.0-pre2
msgid "The element <%s> does not have attribute <%s>"
msgstr "Elementet <%s> har inte attributet <%s>"

#. from tp:gettext-tools-1.0-pre2
msgid "Usage: %s [OPTION...] [LOCALE RULES]...\n"
msgstr "Användning: %s [FLAGGA…] [LOKALREGLER]…\n"

#. from tp:gettext-tools-1.0-pre2
msgid "Extract or convert Unicode CLDR plural rules.\n\nIf both LOCALE and RULES are specified, it reads CLDR plural rules for\nLOCALE from RULES and print them in a form suitable for gettext use.\nIf no argument is given, it reads CLDR plural rules from the standard input.\n"
msgstr "Extrahera eller konvertera Unicode CLDR-pluralregler.\n\nOm både LOKAL och REGLER anges läser programmet CLDR-pluralregler för LOKAL från REGLER och skriver dem i en form som gettext kan använda.\nOm inget argument anges läser programmet CLDR-pluralregler från standardindata.\n"

#. from tp:gettext-tools-1.0-pre2
msgid "Mandatory arguments to long options are mandatory for short options too.\nSimilarly for optional arguments.\n"
msgstr "Obligatoriska argument för långa flaggor är obligatoriska även för korta.\nMotsvarande gäller för frivilliga argument.\n"

#. from tp:gettext-tools-1.0-pre2
msgid "  -c, --cldr                  print plural rules in the CLDR format\n"
msgstr "  -c, --cldr                  skriv pluralregler i formatet CLDR\n"

