msgstr "Skapar en dialogruta där du kan ange en beskrivning av det fretdiagram som ska sättas vid markörens position."

#. from tp:denemo-2.6-rc2
msgid "Give unit beat duration (e.g., 4. for dotted-quarter) \n or enter n for none:"
msgstr "Ange enhetens taktlängd (t.ex. 4. för prickad kvart)\n eller ange n för ingen:"

