msgid "Support MWAIT and MONITOR built-in functions and code generation."
msgstr "Stöd inbyggda MWAIT- och MONITOR-funktioner och -kodgenerering."

#. from tp:gcc-16.1-b20260222
msgid "Support MMX, SSE, SSE2, SSE3, SSSE3, SSE4.1, SSE4.2, AVX, AVX2, AVX512F and AVX512-FP16 built-in functions and code generation."
msgstr "Stöd inbyggda MMX-, SSE-, SSE2-, SSE3-, SSSE3-, SSE4.1-, SSE4.2-, AVX-, AVX2-, AVX512F- och AVX512-FP16-funktioner och -kodgenerering."

#. from tp:gcc-16.1-b20260222
msgid "Do not use GOT to access external symbols."
msgstr "Använd inte GOT för att komma åt externa symboler."

#. from tp:gcc-16.1-b20260222
msgid "Instructions number above which STFL stall penalty can be compensated."
msgstr "Instruktionsantal över vilket STFL-fördröjningsstraff kan kompenseras."

#. from tp:gcc-16.1-b20260222
msgid "Support MMX, SSE, SSE2, SSE3, SSSE3, SSE4.1, SSE4.2, AVX, AVX2, and AVXIFMA built-in functions and code generation."
msgstr "Stöd inbyggda MMX-, SSE-, SSE2-, SSE3-, SSSE3-, SSE4.1-, SSE4.2-, AVX-, AVX2- och AVIFMA-funktioner och -kodgenerering."

#. from tp:gcc-16.1-b20260222
msgid "Support MMX, SSE, SSE2, SSE3, SSSE3, SSE4.1, SSE4.2, AVX, AVX2 and AVXVNNIINT8 built-in functions and code generation."
msgstr "Stöd inbyggda MMX-, SSE-, SSE2-, SSE3-, SSSE3-, SSE4.1-, SSE4.2-, AVX-, AVX2- och AVXVNNIINT8-funktioner och -kodgenerering."

#. from tp:gcc-16.1-b20260222
msgid "Support MMX, SSE, SSE2, SSE3, SSSE3, SSE4.1, SSE4.2, AVX, AVX2, and AVXNECONVERT build-in functions and code generation."
msgstr "Stöd inbyggda MMX-, SSE-, SSE2-, SSE3-, SSSE3-, SSE4.1-, SSE4.2-, AVX-, AVX2- och AVXNECONVERT-funktioner och -kodgenerering."

#. from tp:gcc-16.1-b20260222
msgid "Support MMX, SSE, SSE2, SSE3, SSSE3, SSE4.1, SSE4.2, AVX, AVX2, and CMPCCXADD build-in functions and code generation."
msgstr "Stöd inbyggda MMX-, SSE-, SSE2-, SSE3-, SSSE3-, SSE4.1-, SSE4.2-, AVX-, AVX2- och CMPCCXADD-funktioner och -kodgenerering."

#. from tp:gcc-16.1-b20260222
msgid "Support AMX-FP16 built-in functions and code generation."
msgstr "Stöd inbyggda AMX-FP16-funktioner och -kodgenerering."

#. from tp:gcc-16.1-b20260222
msgid "Support PREFETCHI built-in functions and code generation."
msgstr "Stöd inbyggda PREFETCHI-funktioner och -kodgenerering."

#. from tp:gcc-16.1-b20260222
msgid "Support RAOINT built-in functions and code generation."
msgstr "Stöd inbyggda RAOINT-funktioner och -kodgenerering."

#. from tp:gcc-16.1-b20260222
msgid "Enable conservative small loop unrolling."
msgstr "Aktivera konservativ utrullning av små slingor."

#. from tp:gcc-16.1-b20260222
msgid "Limit how much the autovectorizer may unroll a loop."
msgstr "Begränsa hur mycket autovektoriseraren får rulla ut en slinga."

#. from tp:gcc-16.1-b20260222
msgid "Whether x86 vectorizer cost modeling compares costs of different vector sizes."
msgstr "Huruvida x86-vektoriserarens kostnadsmodellering jämför kostnaderna för olika vektorstorlekar."

#. from tp:gcc-16.1-b20260222
msgid "-mlam=[none|u48|u57] Instrument meta data position in user data pointers."
msgstr "-mlam=[none|u48|u57] Instrumentera metadatapositioner i användardatapekare."

#. from tp:gcc-16.1-b20260222
msgid "Support AMX-COMPLEX built-in functions and code generation."
msgstr "Stöd inbyggda AMX-COMPLEX-funktioner och -kodgenerering."

#. from tp:gcc-16.1-b20260222
msgid "Support MMX, SSE, SSE2, SSE3, SSSE3, SSE4.1, SSE4.2, AVX, AVX2 and AVXVNNIINT16 built-in functions and code generation."
msgstr "Stöd inbyggda MMX-, SSE-, SSE2-, SSE3-, SSSE3-, SSE4.1-, SSE4.2-, AVX-, AVX2- och AVXVNNIINT16-funktioner och -kodgenerering."

#. from tp:gcc-16.1-b20260222
msgid "Support MMX, SSE, SSE2, SSE3, SSSE3, SSE4.1, SSE4.2, AVX and SM3 built-in functions and code generation."
msgstr "Stöd inbyggda MMX-, SSE-, SSE2-, SSE3-, SSSE3-, SSE4.1-, SSE4.2-, AVX- och SM3-funktioner och -kodgenerering."

#. from tp:gcc-16.1-b20260222
msgid "Support MMX, SSE, SSE2, SSE3, SSSE3, SSE4.1, SSE4.2, AVX and SHA512 built-in functions and code generation."
msgstr "Stöd inbyggda MMX-, SSE-, SSE2-, SSE3-, SSSE3-, SSE4.1-, SSE4.2-, AVX- och SHA512-funktioner och -kodgenerering."

#. from tp:gcc-16.1-b20260222
msgid "Support MMX, SSE, SSE2, SSE3, SSSE3, SSE4.1, SSE4.2, AVX and SM4 built-in functions and code generation."
msgstr "Stöd inbyggda MMX-, SSE-, SSE2-, SSE3-, SSSE3-, SSE4.1-, SSE4.2-, AVX- och SM4-funktioner och -kodgenerering."

#. from tp:gcc-16.1-b20260222
msgid "Enable vectorization for gather instruction."
msgstr "Aktivera vektorisering för samlingsinstruktion."

#. from tp:gcc-16.1-b20260222
msgid "Enable vectorization for scatter instruction."
msgstr "Aktivera vektorisering för spridningsinstruktion."

#. from tp:gcc-16.1-b20260222
msgid "Support code generation for APX features, including EGPR, PUSH2POP2, NDD, PPX, NF, CCMP and ZU."
msgstr "Stöd kodgenerering för APX-funktioner, inklusive EGPR, PUSH2POP2, NDD, PPX, NF, CCMP och ZU."

#. from tp:gcc-16.1-b20260222
msgid "Enable GPR32 in inline asm when APX_F enabled."
msgstr "Aktivera GPR32 i inline:ad asm när APX_F är aktiverat."

#. from tp:gcc-16.1-b20260222
msgid "Support USER_MSR built-in functions and code generation."
msgstr "Stöd inbyggda USER_MSR-funktioner och -kodgenerering."

#. from tp:gcc-16.1-b20260222
msgid "Support MMX, SSE, SSE2, SSE3, SSSE3, SSE4.1, SSE4.2, AVX, AVX2, and AVX10.1 built-in functions and code generation."
msgstr "Stöd inbyggda MMX-, SSE-, SSE2-, SSE3-, SSSE3-, SSE4.1-, SSE4.2-, AVX-, AVX2- och AVX10.1-funktioner och -kodgenerering."

#. from tp:gcc-16.1-b20260222
msgid "Support MMX, SSE, SSE2, SSE3, SSSE3, SSE4.1, SSE4.2, AVX, AVX2, AVX10.1 and AVX10.2 built-in functions and code generation."
msgstr "Stöd inbyggda MMX-, SSE-, SSE2-, SSE3-, SSSE3-, SSE4.1-, SSE4.2-, AVX-, AVX2-, AVX10.1- och AVX10.2-funktioner och -kodgenerering."

#. from tp:gcc-16.1-b20260222
msgid "Support MMX, SSE, SSE2, SSE3, SSSE3, SSE4.1, SSE4.2, AVX, AVX2, AVX10.1, AVX10.2 and AMX-AVX512 built-in functions and code generation."
msgstr "Stöd inbyggda MMX-, SSE-, SSE2-, SSE3-, SSSE3-, SSE4.1-, SSE4.2-, AVX-, AVX2-, AVX10.1-, AVX10.2- och AMX-AVX512-funktioner och -kodgenerering."

#. from tp:gcc-16.1-b20260222
msgid "Support AMX-TF32 built-in functions and code generation."
msgstr "Stöd inbyggda AMX-TF32-funktioner och -kodgenerering."

#. from tp:gcc-16.1-b20260222
msgid "Support AMX-FP8 built-in functions and code generation."
msgstr "Stöd inbyggda AMX-FP8-funktioner och -kodgenerering."

#. from tp:gcc-16.1-b20260222
msgid "Support MOVRS built-in functions and code generation."
msgstr "Stöd inbyggda MOVRS-funktioner och -kodgenerering."

#. from tp:gcc-16.1-b20260222
msgid "Support AMX-MOVRS built-in functions and code generation."
msgstr "Stöd inbyggda AMX-MOVRS-funktioner och -kodgenerering."

#. from tp:gcc-16.1-b20260222
msgid "Support AVX512BMM built-in functions and code generation."
msgstr "Stöd inbyggda AVX512BMM-funktioner och -kodgenerering."

#. from tp:gcc-16.1-b20260222
msgid "Use unicode startup and define UNICODE macro."
msgstr "Använd unicode-uppstart och definiera ett UNICODE-makro."

#. from tp:gcc-16.1-b20260222
msgid "Known ARM CPUs (for use with the -mcpu= and -mtune= options):"
msgstr "Kända ARM-CPU:er (att användas med flaggorna -mcpu= och -mtune=):"

#. from tp:gcc-16.1-b20260222
msgid "Known ARM architectures (for use with the -march= option):"
msgstr "Kända ARM-arkitekturer (att användas med flaggan -march=):"

#. from tp:gcc-16.1-b20260222
msgid "Known ARM FPUs (for use with the -mfpu= option):"
msgstr "Kända ARM-FPU:er (att användas med flaggan -mfpu=):"

#. from tp:gcc-16.1-b20260222
msgid "TLS dialect to use:"
msgstr "TLS-dialekt att använda:"

#. from tp:gcc-16.1-b20260222
msgid "Specify an ABI."
msgstr "Ange ett ABI."

#. from tp:gcc-16.1-b20260222
msgid "Known ARM ABIs (for use with the -mabi= option):"
msgstr "Kända ARM-ABI:er (att användas med flaggan -mabi=):"

#. from tp:gcc-16.1-b20260222
msgid "Generate a call to abort if a noreturn function returns."
msgstr "Generera ett anrop till abort om en noreturn-funktion returnerar."

#. from tp:gcc-16.1-b20260222
msgid "Generate APCS conformant stack frames."
msgstr "Generera stackramar enligt APCS."

#. from tp:gcc-16.1-b20260222
msgid "Unimplemented option to generate re-entrant, PIC code."
msgstr "Oimplementerad flagga för att generera återinträdesbar PIC-kod."

#. from tp:gcc-16.1-b20260222
msgid "Unimplemented option to generate stack checking code on function entry."
msgstr "Oimplementerad flagga för att generera stackkontrollkod vid funktionsingång."

#. from tp:gcc-16.1-b20260222
msgid "Generate code in 32 bit ARM state."
msgstr "Generera kod i 32-bitars ARM-tillstånd."

#. from tp:gcc-16.1-b20260222
msgid "Thumb: Assume non-static functions may be called from ARM code."
msgstr "Thumb: Anta att icke-statiska funktioner kan anropas från ARM-kod."

#. from tp:gcc-16.1-b20260222
msgid "Thumb: Assume function pointers may go to non-Thumb aware code."
msgstr "Thumb: Anta att funktionspekare kan gå till kod som inte känner till Thumb."

#. from tp:gcc-16.1-b20260222
msgid "Specify that the compiler should target secure code as per ARMv8-M Security Extensions."
msgstr "Ange att kompilatorn ska rikta in sig på säker kod enligt ARMv8-M Security Extensions."

#. from tp:gcc-16.1-b20260222
msgid "Switch ARM/Thumb modes on alternating functions for compiler testing."
msgstr "Växla ARM-/Thumb-lägen mellan alternerande funktioner för kompilatortestning."

#. from tp:gcc-16.1-b20260222
msgid "Specify the __fp16 floating-point format."
msgstr "Ange flyttalsformatet __fp16."

#. from tp:gcc-16.1-b20260222
msgid "Known __fp16 formats (for use with the -mfp16-format= option):"
msgstr "Kända __fp16-format (att användas med flaggan -mfp16-format=):"

#. from tp:gcc-16.1-b20260222
msgid "Specify the name of the target floating point hardware/format."
msgstr "Ange namnet på målets flyttalshårdvara/-format."

#. from tp:gcc-16.1-b20260222
msgid "Generate call insns as indirect calls, if necessary."
msgstr "Generera anropsinstruktioner som indirekta anrop, om nödvändigt."

#. from tp:gcc-16.1-b20260222
msgid "Assume data segments are relative to text segment."
msgstr "Anta att datasegment är relativa till textsegment."

#. from tp:gcc-16.1-b20260222
msgid "Specify the register to be used for PIC addressing."
msgstr "Ange registret som skall användas för PIC-adressering."

#. from tp:gcc-16.1-b20260222
msgid "Store function names in object code."
msgstr "Lagra funktionsnamn i objektkod."

#. from tp:gcc-16.1-b20260222
msgid "Permit scheduling of a function's prologue sequence."
msgstr "Tillåt schemaläggning av en funktions prologsekvens."

#. from tp:gcc-16.1-b20260222
msgid "Specify the minimum bit alignment of structures. (Deprecated)."
msgstr "Ange den minsta bitjusteringen för strukturer. (Föråldrad.)"

#. from tp:gcc-16.1-b20260222
msgid "Generate code for Thumb state."
msgstr "Generera kod för Thumb-tillstånd."

#. from tp:gcc-16.1-b20260222
msgid "Support calls between Thumb and ARM instruction sets."
msgstr "Stöd anrop mellan Thumb- och ARM-instruktionsuppsättningar."

#. from tp:gcc-16.1-b20260222
msgid "Specify thread local storage scheme."
msgstr "Ange metod för trådlokal lagring."

#. from tp:gcc-16.1-b20260222
msgid "Specify how to access the thread pointer."
msgstr "Ange hur trådpekaren ska kommas åt."

#. from tp:gcc-16.1-b20260222
msgid "Valid arguments to -mtp=:"
msgstr "Giltiga argument till -mtp=:"

#. from tp:gcc-16.1-b20260222
msgid "Thumb: Generate (non-leaf) stack frames even if not needed."
msgstr "Thumb: Generera (icke-löv-)stackramar även om de inte behövs."

#. from tp:gcc-16.1-b20260222
msgid "Thumb: Generate (leaf) stack frames even if not needed."
msgstr "Thumb: Generera (löv)stackramar även om de inte behövs."

#. from tp:gcc-16.1-b20260222
msgid "Tune code for the given processor."
msgstr "Trimma koden för den angivna processorn."

#. from tp:gcc-16.1-b20260222
msgid "Print CPU tuning information as comment in assembler file.  This is an option used only for regression testing of the compiler and not intended for ordinary use in compiling code."
msgstr "Skriv CPU-trimningsinformation som kommentarer i assemblerfilen.  Detta är en flagga som används endast för regressionstestning av kompilatorn och är inte avsedd för normal användning vid kompilering."

#. from tp:gcc-16.1-b20260222
msgid "Use Neon quad-word (rather than double-word) registers for vectorization."
msgstr "Använd Neons fyrordsregister (snarare än dubbelordsregister) för vektorisering."

#. from tp:gcc-16.1-b20260222
msgid "Use Neon double-word (rather than quad-word) registers for vectorization."
msgstr "Använd Neons dubbelordsregister (snarare än fyrordsregister) för vektorisering."

#. from tp:gcc-16.1-b20260222
msgid "Enable more verbose RTX cost dumps during debug.  For GCC developers use only."
msgstr "Aktivera mer utförliga RTX-kostnadsdumpar under felsökning.  Endast för GCC-utvecklare."

#. from tp:gcc-16.1-b20260222
msgid "Only generate absolute relocations on word sized values."
msgstr "Generera endast absoluta omlokaliseringar för värden av ordstorlek."

#. from tp:gcc-16.1-b20260222
msgid "Generate IT blocks appropriate for ARMv8."
msgstr "Generera IT-block som passar för ARMv8."

#. from tp:gcc-16.1-b20260222
msgid "Avoid overlapping destination and address registers on LDRD instructions that may trigger Cortex-M3 errata."
msgstr "Undvik överlappande destinationer och adressregister för LDRD-instruktioner som kan utlösa Cortex-M3-errata."

#. from tp:gcc-16.1-b20260222
msgid "Mitigate issues with VLLDM on some M-profile devices (CVE-2021-35465)."
msgstr "Motverka problem med VLLDM på vissa M-profilenheter (CVE-2021-35465)."

#. from tp:gcc-16.1-b20260222
msgid "Mitigate issues with AES instructions on Cortex-A57 and Cortex-A72 (Arm erratum #1742098)."
msgstr "Motverka problem med AES-instruktioner på Cortex-A57 och Cortex-A72 (Arm-erratum nr. 1742098)."

#. from tp:gcc-16.1-b20260222
msgid "Mitigate issues with AES instructions on Cortex-A57 and Cortex-A72 (Arm erratum #1655431)."
msgstr "Motverka problem med AES-instruktioner på Cortex-A57 och Cortex-A72 (Arm-erratum nr. 1655431)."

#. from tp:gcc-16.1-b20260222
msgid "This option is deprecated and has no effect."
msgstr "Denna flagga bör undvikas och har ingen effekt."

#. from tp:gcc-16.1-b20260222
msgid "Assume loading data from flash is slower than fetching instructions."
msgstr "Anta att inläsning av data från flash är långsammare än hämtning av instruktioner."

#. from tp:gcc-16.1-b20260222
msgid "Assume unified syntax for inline assembly code."
msgstr "Anta unifierad syntax för inline:ad assemblerkod."

#. from tp:gcc-16.1-b20260222
msgid "Do not allow constant data to be placed in code sections."
msgstr "Tillåt inte konstant data att placeras i kodsektioner."

#. from tp:gcc-16.1-b20260222
msgid "When linking for big-endian targets, generate a BE8 format image."
msgstr "Vid länkning för mål med stor byteordning, generera en avbild i BE8-format."

#. from tp:gcc-16.1-b20260222
msgid "When linking for big-endian targets, generate a legacy BE32 format image."
msgstr "Vid länkning för mål med stor byteordning, generera en äldre avbild i BE32-format."

#. from tp:gcc-16.1-b20260222
msgid "Cost to assume for a branch insn."
msgstr "Kostnad att anta för en greninstruktion."

#. from tp:gcc-16.1-b20260222
msgid "Use branch-protection features."
msgstr "Använd grenskyddsfunktioner."

#. from tp:gcc-16.1-b20260222
msgid "Generate code which uses the core registers only (r0-r14)."
msgstr "Generera kod som endast använder kärnregister (r0-r14)."

#. from tp:gcc-16.1-b20260222
msgid "Use an immediate to offset from the TLS register. This option is for use with fstack-protector-guard=tls and not for use in user-land code."
msgstr "Använd ett omedelbart värde som förskjutning från TLS-registret.  Denna flagga ska användas med fstack-protector-guard=tls och är inte avsedd för kod i användarland."

#. from tp:gcc-16.1-b20260222
msgid "Generate code for the M*Core M210."
msgstr "Generera kod för M*Core M210."

#. from tp:gcc-16.1-b20260222
msgid "Generate code for the M*Core M340."
msgstr "Generera kod för M*Core M340."

#. from tp:gcc-16.1-b20260222
msgid "Force functions to be aligned to a 4 byte boundary."
msgstr "Tvinga funktioner att justeras till en 4-bytegräns."

#. from tp:gcc-16.1-b20260222
msgid "Emit call graph information."
msgstr "Mata ut anropsgrafsinformation."

#. from tp:gcc-16.1-b20260222
msgid "Use the divide instruction."
msgstr "Använd divisionsinstruktionen."

#. from tp:gcc-16.1-b20260222
msgid "Inline constants if it can be done in 2 insns or less."
msgstr "Inline:a konstanter om det kan göras på 2 instruktioner eller mindre."

#. from tp:gcc-16.1-b20260222
msgid "Assume that run-time support has been provided, so omit -lsim from the linker command line."
msgstr "Anta att körtidsstöd finns, så utelämna -lsim från länkningskommandoraden."

#. from tp:gcc-16.1-b20260222
msgid "Use arbitrary sized immediates in bit operations."
msgstr "Använd godtyckligt stora omedelbara i bitoperationer."

#. from tp:gcc-16.1-b20260222
msgid "Prefer word accesses over byte accesses."
msgstr "Föredra ordåtkomst före byteåtkomst."

#. from tp:gcc-16.1-b20260222
msgid "Set the maximum amount for a single stack increment operation."
msgstr "Ange maximal storlek på en enskild stackökningsoperation."

#. from tp:gcc-16.1-b20260222
msgid "Always treat bitfields as int-sized."
msgstr "Hantera alltid bitfält som värden av int-storlek."

#. from tp:gcc-16.1-b20260222
msgid "-mmcu=MCU	Select the target System-On-Chip variant that embeds this PRU."
msgstr "-mmcu=MCU	Välj målsystemkretsvariant (SoC) som bäddar in denna PRU."

#. from tp:gcc-16.1-b20260222
msgid "Make GCC pass the --no-relax command-line option to the linker instead of the --relax option."
msgstr "Låt GCC skicka kommandoradsflaggan --no-relax till länkaren istället för flaggan --relax."

#. from tp:gcc-16.1-b20260222
msgid "Allow (or do not allow) gcc to use the LOOP instruction."
msgstr "Tillåt (eller tillåt inte) gcc att använda LOOP-instruktionen."

#. from tp:gcc-16.1-b20260222
msgid "Allow (or do not allow) gcc to use the PRU multiplier unit."
msgstr "Tillåt (eller tillåt inte) gcc att använda PRU-multiplicerarenheten."

#. from tp:gcc-16.1-b20260222
msgid "Allow (or do not allow) gcc to use the FILL and ZERO instructions."
msgstr "Tillåt (eller tillåt inte) gcc att använda FILL och ZERO-instruktioner."

#. from tp:gcc-16.1-b20260222
msgid "Select target ABI variant."
msgstr "Välj mål-ABI-variant."

#. from tp:gcc-16.1-b20260222
msgid "ABI variant code generation (for use with -mabi= option):"
msgstr "ABI-variantkodgenerering (att användas med flaggan -mabi=):"

#. from tp:gcc-16.1-b20260222
msgid "Use software emulation for floating point (default)."
msgstr "Använd programvaruemulering för flyttal (standard)."

#. from tp:gcc-16.1-b20260222
msgid "Use hardware floating point instructions."
msgstr "Använd maskinvaruflyttalsinstruktioner."

#. from tp:gcc-16.1-b20260222
msgid "Use table lookup optimization for small signed integer divisions."
msgstr "Använd tabelluppslagningsoptimering för divisioner med små heltal med tecken."

#. from tp:gcc-16.1-b20260222
msgid "-mcpu=PROCESSOR		Use features of and schedule code for given CPU."
msgstr "-mcpu=PROCESSOR		Använd funktioner i och schemalägg kod för angiven CPU."

#. from tp:gcc-16.1-b20260222
msgid "Don't optimize block moves, use memcpy."
msgstr "Optimera inte blockförflyttningar, använd memcpy."

#. from tp:gcc-16.1-b20260222
msgid "Use the soft multiply emulation (default)."
msgstr "Använd programvaruemulering av multiplikation (standard)."

#. from tp:gcc-16.1-b20260222
msgid "Use reorder instructions (swap and byte reversed load/store) (default)."
msgstr "Använd omordningsinstruktioner (växlad och byteomvänd inläsning/lagring) (standard)."

#. from tp:gcc-16.1-b20260222
msgid "Use the software emulation for divides (default)."
msgstr "Använd programvaruemulering av division (standard)."

#. from tp:gcc-16.1-b20260222
msgid "Use the hardware barrel shifter instead of emulation."
msgstr "Använd maskinvarutunnskiftaren i stället för emulering."

#. from tp:gcc-16.1-b20260222
msgid "Use pattern compare instructions."
msgstr "Använd mönsterjämförelseinstruktioner."

#. from tp:gcc-16.1-b20260222
msgid "Check for stack overflow at runtime."
msgstr "Kontrollera stacköverflöd vid körtid."

#. from tp:gcc-16.1-b20260222
msgid "Clear the BSS to zero and place zero initialized in BSS."
msgstr "Nollställ BSS och placera nollinitierade data i BSS."

#. from tp:gcc-16.1-b20260222
msgid "Use multiply high instructions for high part of 32x32 multiply."
msgstr "Använd högmultiplikationsinstruktioner för den höga delen av 32·32-multiplikationer."

#. from tp:gcc-16.1-b20260222
msgid "Use hardware floating point conversion instructions."
msgstr "Använd maskinvaruinstruktioner för flyttalskonvertering."

#. from tp:gcc-16.1-b20260222
msgid "Use hardware floating point square root instruction."
msgstr "Använd maskinvaruinstruktion för flyttalskvadratrot."

#. from tp:gcc-16.1-b20260222
msgid "Build application as normal executable."
msgstr "Bygg programmet som en vanlig körbar fil."

#. from tp:gcc-16.1-b20260222
msgid "Build application for use with xmdstub debug agent."
msgstr "Bygg programmet för att användas med felsökningsagenten xmdstub."

#. from tp:gcc-16.1-b20260222
msgid "Build application to be loaded using a bootloader."
msgstr "Bygg ett program som ska laddas med en startladdare."

#. from tp:gcc-16.1-b20260222
msgid "Build application without any of the MicroBlaze vectors."
msgstr "Bygg programmet utan någon av MicroBlaze-vektorerna."

#. from tp:gcc-16.1-b20260222
msgid "Use hardware prefetch instruction."
msgstr "Använd instruktioner för förhandshämtning (prefetch) i hårdvara."

#. from tp:gcc-16.1-b20260222
msgid "Data referenced by offset from start of text instead of GOT (with -fPIC/-fPIE)."
msgstr "Data som refereras med förskjutning från början av textsegmentet i stället för GOT (med -fPIC/-fPIE)."

#. from tp:gcc-16.1-b20260222
msgid "Compile for the m32rx."
msgstr "Kompilera för en m32rx."

#. from tp:gcc-16.1-b20260222
msgid "Compile for the m32r2."
msgstr "Kompilera för en m32r2."

#. from tp:gcc-16.1-b20260222
msgid "Compile for the m32r."
msgstr "Kompilera för en m32r."

#. from tp:gcc-16.1-b20260222
msgid "Align all loops to 32 byte boundary."
msgstr "Justera alla slingor till en 32-bytegräns."

#. from tp:gcc-16.1-b20260222
msgid "Prefer branches over conditional execution."
msgstr "Föredra hopp framför villkorlig körning."

#. from tp:gcc-16.1-b20260222
msgid "Give branches their default cost."
msgstr "Ge grenar sin normalkostnad."

#. from tp:gcc-16.1-b20260222
msgid "Display compile time statistics."
msgstr "Visa kompileringstidsstatistik."

#. from tp:gcc-16.1-b20260222
msgid "Specify cache flush function."
msgstr "Ange cache-tömningsfunktion."

#. from tp:gcc-16.1-b20260222
msgid "Specify cache flush trap number."
msgstr "Ange cache-tömningsfällnummer."

#. from tp:gcc-16.1-b20260222
msgid "Only issue one instruction per cycle."
msgstr "Lägg bara ut en instruktion per cykel."

#. from tp:gcc-16.1-b20260222
msgid "Allow two instructions to be issued per cycle."
msgstr "Tillåt att två instruktioner läggs ut per cykel."

#. from tp:gcc-16.1-b20260222
msgid "Code size: small, medium or large."
msgstr "Kodstorlek: small, medium, eller large."

#. from tp:gcc-16.1-b20260222
msgid "Don't call any cache flush functions."
msgstr "Anropa inte några cache-tömningsfunktioner."

#. from tp:gcc-16.1-b20260222
msgid "Don't call any cache flush trap."
msgstr "Anropa inga cache-tömningsfällor."

#. from tp:gcc-16.1-b20260222
msgid "Small data area: none, sdata, use."
msgstr "Litet dataområde: none, sdata, use."

#. from tp:gcc-16.1-b20260222
msgid "The code model option names for -mcmodel:"
msgstr "Namnen för flaggan för kodmodell för -mcmodel:"

#. from tp:gcc-16.1-b20260222
msgid "Generates an error message if an attempt is made to access a system register which is not available on the target architecture."
msgstr "Genererar ett felmeddelande om ett försök görs att komma åt ett systemregister som inte är tillgängligt på målarkitekturen."

#. from tp:gcc-16.1-b20260222
msgid "Workaround for ARM Cortex-A53 Erratum number 835769."
msgstr "Lösning för ARM Cortex-A53-erratum nr. 835769."

#. from tp:gcc-16.1-b20260222
msgid "Workaround for ARM Cortex-A53 Erratum number 843419."
msgstr "Lösning för ARM Cortex-A53-erratum nr. 843419."

#. from tp:gcc-16.1-b20260222
msgid "The register used to access the thread pointer:"
msgstr "Registret som används för att nå trådpekaren:"

#. from tp:gcc-16.1-b20260222
msgid "Specify the thread pointer register."
msgstr "Ange trådpekarregistret."

#. from tp:gcc-16.1-b20260222
msgid "Don't assume that unaligned accesses are handled by the system."
msgstr "Anta inte att ojusterade åtkomster hanteras av systemet."

#. from tp:gcc-16.1-b20260222
msgid "Specifies bit size of immediate TLS offsets.  Valid values are 12, 24, 32, 48."
msgstr "Ange bitstorleken på omedelbara TLS-förskjutningar.  Giltiga värden är 12, 24, 32, 48."

#. from tp:gcc-16.1-b20260222
msgid "Use features of architecture ARCH."
msgstr "Använd funktioner i arkitekturen ARCH."

#. from tp:gcc-16.1-b20260222
msgid "Use features of and optimize for CPU."
msgstr "Använd funktioner i och optimera för angiven CPU."

#. from tp:gcc-16.1-b20260222
msgid "Optimize for CPU."
msgstr "Optimera för CPU."

#. from tp:gcc-16.1-b20260222
msgid "Generate code that conforms to the specified ABI."
msgstr "Generera kod som följer det angivna ABI:et."

#. from tp:gcc-16.1-b20260222
msgid "-fdump-tuning-model=<filename> Dump current tuning model to a JSON file."
msgstr "-fdump-tuning-model=<filnamn> Skriv aktuell trimningsmodell till en JSON-fil."

#. from tp:gcc-16.1-b20260222
msgid "-muser-provided-CPU=<json-tuning-file> User specific CPU tunings."
msgstr "-muser-provided-CPU=<json-tuning-fil> Användarspecifika CPU-trimningar."

#. from tp:gcc-16.1-b20260222
msgid "-moverride=<string>	Power users only! Override CPU optimization parameters."
msgstr "-moverride=<sträng>	Endast avancerade användare!  Åsidosätt CPU-optimeringsparametrar."

#. from tp:gcc-16.1-b20260222
msgid "Known AArch64 ABIs (for use with the -mabi= option):"
msgstr "Kända AArch64-ABI:er (att användas med flaggan -mabi=):"

#. from tp:gcc-16.1-b20260222
msgid "PC relative literal loads."
msgstr "PC-relativa litterala laddningar."

#. from tp:gcc-16.1-b20260222
msgid "Select return address signing scope."
msgstr "Välj räckvidd för signering av returadress."

#. from tp:gcc-16.1-b20260222
msgid "Supported AArch64 return address signing scope (for use with -msign-return-address= option):"
msgstr "Räckvidder som stödjs för signering av AArch64-returadresser (att användas med flaggan -msign-return-address=):"

#. from tp:gcc-16.1-b20260222
msgid "Enable the reciprocal square root approximation.  Enabling this reduces precision of reciprocal square root results to about 16 bits for single precision and to 32 bits for double precision."
msgstr "Aktivera approximation av reciprok kvadratrot.  Detta minskar precisionen för resultat av reciprok kvadratrot till ungefär 16 bitar för enkel precision och 32 bitar för dubbel precision."

#. from tp:gcc-16.1-b20260222
msgid "Enable the square root approximation.  Enabling this reduces precision of square root results to about 16 bits for single precision and to 32 bits for double precision. If enabled, it implies -mlow-precision-recip-sqrt."
msgstr "Aktivera approximation av kvadratrot.  Detta minskar precisionen för resultat av kvadratrot till ungefär 16 bitar för enkel precision och 32 bitar för dubbel precision.  Om flaggan aktiveras innebär den -mlow-precision-recip-sqrt."

#. from tp:gcc-16.1-b20260222
msgid "Enable the division approximation.  Enabling this reduces precision of division results to about 16 bits for single precision and to 32 bits for double precision."
msgstr "Aktivera approximationen av division.  Att aktivera detta reducerar precisionen på resultatet av division till ungefär 16 bitar för enkel precision och till 32 bitar för dubbel precision."

#. from tp:gcc-16.1-b20260222
msgid "Specify when to enable an early register allocation pass.  The possibilities are: all functions, functions that have access to strided multi-register instructions, and no functions."
msgstr "Ange när ett tidigt registerallokeringspass skall aktiveras. Möjligheterna är: alla funktioner, funktioner som har tillgång till stegvisa multiregisterinstruktioner och inga funktioner."

#. from tp:gcc-16.1-b20260222
msgid "The possible SVE vector lengths:"
msgstr "De möjliga SVE-vektorlängderna:"

#. from tp:gcc-16.1-b20260222
msgid "-msve-vector-bits=<number>	Set the number of bits in an SVE vector register."
msgstr "-msve-vector-bits=<antal>	Ange antalet bitar i ett SVE-vektorregister."

#. from tp:gcc-16.1-b20260222
msgid "-mautovec-preference=[default|asimd-only|sve-only|prefer-asimd|prefer-sve] Force an ISA selection strategy for auto-vectorization.  For best performance it is highly recommended to use -mcpu or -mtune instead.  This parameter should only be used for code exploration."
msgstr "-autovec-preference=[default|asimd-only|sve-only|prefer-asimd|prefer-sve] Framtvinga en ISA-valsstrategi för autovektorisering. För bästa prestanda rekommenderas det starkt att använda -mcpu eller -mtune istället. Denna parameter bör bara användas för kodutforskning."

#. from tp:gcc-16.1-b20260222
msgid "Enables verbose cost model dumping in the debug dump files."
msgstr "Aktiverar utförlig dump av kostnadsmodellen i dumpfilerna för felsökning."

#. from tp:gcc-16.1-b20260222
msgid "Generate code to track when the CPU might be speculating incorrectly."
msgstr "Generera kod för att spåra när CPU:n kan spekulera felaktigt."

#. from tp:gcc-16.1-b20260222
msgid "Enable the copy of the AArch64 load/store pair fusion pass that runs before register allocation."
msgstr "Aktivera kopieringen av sammanslagningspasset av load/store-par för AArch64 som köre före registerallokering."

#. from tp:gcc-16.1-b20260222
msgid "Enable the copy of the AArch64 load/store pair fusion pass that runs after register allocation."
msgstr "Aktivera kopieringen av sammanslagningspasset av load/store-par för AArch64 som köre efter registerallokering."

#. from tp:gcc-16.1-b20260222
msgid "Use the system register specified on the command line as the stack protector guard register. This option is for use with fstack-protector-strong and not for use in user-land code."
msgstr "Använd systemregistret som anges på kommandoraden som register för stackskyddsvakten.  Denna flagga ska användas med fstack-protector-strong och är inte avsedd för kod i användarland."

#. from tp:gcc-16.1-b20260222
msgid "Use an immediate to offset from the stack protector guard register, sp_el0. This option is for use with fstack-protector-strong and not for use in user-land code."
msgstr "Använd ett omedelbart värde som förskjutning från stackskyddsvaktregistret sp_el0.  Denna flagga ska användas med fstack-protector-strong och är inte avsedd för kod i användarland."

#. from tp:gcc-16.1-b20260222
msgid "Generate local calls to out-of-line atomic operations."
msgstr "Generera lokala anrop till atomära operationer utanför rad."

#. from tp:gcc-16.1-b20260222
msgid "When vectorizing, consider using multiple different approaches and use the cost model to choose the cheapest one."
msgstr "Överväg vid vektorisering att använda flera olika tillvägagångssätt och använd kostnadsmodellen för att välja den billigaste."

#. from tp:gcc-16.1-b20260222
msgid "The number of Newton iterations for calculating the reciprocal for float type.  The precision of division is proportional to this param when division approximation is enabled.  The default value is 1."
msgstr "Antalet Newtoniterationer för att beräkna inversen för typen float.  Precisionen i divisionen är proportionell mot denna parameter när divisionsapproximering är aktiverat.  Standardvärdet är 1."

#. from tp:gcc-16.1-b20260222
msgid "The number of Newton iterations for calculating the reciprocal for double type.  The precision of division is proportional to this param when division approximation is enabled.  The default value is 2."
msgstr "Antalet Newtoniterationer för att beräkna inversen för typen double. Precisionen i divisionen är proportionell mot denna parameter när divisionsapproximering är aktiverat. Standardvärdet är 2."

#. from tp:gcc-16.1-b20260222
msgid "An old alias for -mautovec-preference.  If both -mautovec-preference and --param=aarch64-autovec-preference are passed, the --param value will be used."
msgstr "Ett gammalt alias för -mautovec-preference. Om både -mautovec-preference och --param=aarch64-autovec-preference skickas kommer värdet --param att användas."

#. from tp:gcc-16.1-b20260222
msgid "Constant memcpy size in bytes above which to start using MOPS sequence."
msgstr "Konstant memcpy-storlek i byte över vilken MOPS-sekvenser skall användas."

#. from tp:gcc-16.1-b20260222
msgid "Constant memmove size in bytes above which to start using MOPS sequence."
msgstr "Konstant memmove-storlek i byte över vilken MOPS-sekvenser skall användas."

#. from tp:gcc-16.1-b20260222
msgid "Constant memset size in bytes from which to start using MOPS sequence."
msgstr "Konstant memset-storlek i byte över vilken MOPS-sekvenser skall användas."

#. from tp:gcc-16.1-b20260222
msgid "--param=aarch64-ldp-policy=[default|always|never|aligned] Fine-grained policy for load pairs."
msgstr "--param=aarch64-ldp-policy=[default|always|never|aligned] Finkorning policy för laddningspar."

#. from tp:gcc-16.1-b20260222
msgid "--param=aarch64-stp-policy=[default|always|never|aligned] Fine-grained policy for store pairs."
msgstr "--param=aarch64-stp-policy=[default|always|never|aligned] Finkorning policy för lagringspar."

#. from tp:gcc-16.1-b20260222
msgid "Limit on number of alias checks performed when attempting to form an ldp/stp."
msgstr "Gräns för antalet aliaskontroller som utförs vid försök att skapa en ldp/stp."

#. from tp:gcc-16.1-b20260222
msgid "Param to control which writeback opportunities we try to handle in the load/store pair fusion pass.  A value of zero disables writeback handling.  One means we try to form pairs involving one or more existing individual writeback accesses where possible.  A value of two means we also try to opportunistically form writeback opportunities by folding in trailing destructive updates of the base register used by a pair."
msgstr "Parameter som styr vilka återskrivningsmöjligheter som hanteras i sammanslagningspasset för load/store-par. Värdet noll avaktiverar återskrivningshantering. Ett betyder att vi försöker skapa par som omfattar en eller flera befintliga individuella återskrivningsåtkomster när det är möjligt. Värdet två betyder att vi även försöker skapa återskrivningsmöjligheter opportunistiskt genom att fälla in avslutande destruktiva uppdateringar av det basregister som används av ett par."

#. from tp:gcc-16.1-b20260222
msgid "Param to control the treshold in number of granules beyond which an explicit loop for tagging a memory block is emitted."
msgstr "Parameter som styr tröskelvärdet i antal granuler över vilket en explicit slinga för att tagga ett minnesblock matas ut."

#. from tp:gcc-16.1-b20260222
msgid "This option is deprecated."
msgstr "Denna flagga är föråldrad."

#. from tp:gcc-16.1-b20260222
msgid "Malloc data into P2 space."
msgstr "Malloc-data till P2-utrymmet."

#. from tp:gcc-16.1-b20260222
msgid "Set name of main routine for the debugger."
msgstr "Ange namnet på huvudrutinen för felsökaren."

#. from tp:gcc-16.1-b20260222
msgid "Use VMS exit codes instead of posix ones."
msgstr "Använd VMS-slutkoder i stället för POSIX-koder."

#. from tp:gcc-16.1-b20260222
msgid "-mpointer-size=[no,32,short,64,long]	Set the default pointer size."
msgstr "-mpointer-size=[no,32,short,64,long]\tAnge standardstorleken för pekare."

#. from tp:gcc-16.1-b20260222
msgid "Use CONST16 instruction to load constants."
msgstr "Använd CONST16-instruktioner för att ladda konstanter."

#. from tp:gcc-16.1-b20260222
msgid "Disable position-independent code (PIC) for use in OS kernel code."
msgstr "Avaktivera positionsoberoende kod (PIC) för användning i OS-kärnkod."

#. from tp:gcc-16.1-b20260222
msgid "Use indirect CALLXn instructions for large programs."
msgstr "Använd indirekta CALLXn-instruktioner för stora program."

#. from tp:gcc-16.1-b20260222
msgid "Set extra memory access cost for L32R instruction, in clock-cycle units."
msgstr "Ange extra kostnad för minnesåtkomst för L32R-instruktionen, i klockcykler."

#. from tp:gcc-16.1-b20260222
msgid "Automatically align branch targets to reduce branch penalties."
msgstr "Justera automatiskt grenmål för att reducera grenstraff."

#. from tp:gcc-16.1-b20260222
msgid "Intersperse literal pools with code in the text section."
msgstr "Växla mellan bokstavliga pooler och kod i textsektionen."

#. from tp:gcc-16.1-b20260222
msgid "Relax literals in assembler and place them automatically in the text section."
msgstr "Aktivera avslappning av litteraler i assemblern och placera dem automatiskt i textsektionen."

#. from tp:gcc-16.1-b20260222
msgid "-mno-serialize-volatile	Do not serialize volatile memory references with MEMW instructions."
msgstr "-mno-serialize-volatile	Serialisera inte minnesreferenser till flyktigt minne med MEMW-instruktioner."

#. from tp:gcc-16.1-b20260222
msgid "Use call0 ABI."
msgstr "Använd call0-ABI."

#. from tp:gcc-16.1-b20260222
msgid "Use windowed registers ABI."
msgstr "Använd ABI med registerfönster."

#. from tp:gcc-16.1-b20260222
msgid "Do not use unaligned memory references."
msgstr "Använd inte ojusterade minnesreferenser."

#. from tp:gcc-16.1-b20260222
msgid "-G<number>	Put global and static data smaller than <number> bytes into a special section (on some targets)."
msgstr "-G<antal>\tPlacera globala och statiska data mindre än <antal> byte i en särskild sektion (på vissa mål)."

#. from tp:gcc-16.1-b20260222
msgid "Assume the VxWorks RTP environment."
msgstr "Anta miljön VxWorks RTP."

#. from tp:gcc-16.1-b20260222
msgid "Assume the VxWorks vThreads environment."
msgstr "Anta miljön VxWorks vThreads."

#. from tp:gcc-16.1-b20260222
msgid "Target the AM33 processor."
msgstr "Ha processorn AM33 som mål."

#. from tp:gcc-16.1-b20260222
msgid "Target the AM33/2.0 processor."
msgstr "Ha processorn AM33/2.0 som mål."

#. from tp:gcc-16.1-b20260222
msgid "Target the AM34 processor."
msgstr "Ha processorn AM34 som mål."

#. from tp:gcc-16.1-b20260222
msgid "Work around hardware multiply bug."
msgstr "Gå runt multiplikationsfel i hårdvara."

#. from tp:gcc-16.1-b20260222
msgid "Enable linker relaxations."
msgstr "Aktivera länkaravslappning."

#. from tp:gcc-16.1-b20260222
msgid "Return pointers in both a0 and d0."
msgstr "Returnera pekare i både a0 och d0."

#. from tp:gcc-16.1-b20260222
msgid "Allow gcc to generate LIW instructions."
msgstr "Tillåt gcc att generera LIW-instruktioner."

#. from tp:gcc-16.1-b20260222
msgid "Allow gcc to generate the SETLB and Lcc instructions."
msgstr "Tillåt gcc att generera instruktionerna SETLB och Lcc."

#. from tp:gcc-16.1-b20260222
msgid "Use registers r2 and r5."
msgstr "Använd registren r2 och r5."

#. from tp:gcc-16.1-b20260222
msgid "Use 4 byte entries in switch tables."
msgstr "Använd 4-byteposter i hopptabeller."

#. from tp:gcc-16.1-b20260222
msgid "Enable backend debugging."
msgstr "Aktivera bakändefelsökning."

#. from tp:gcc-16.1-b20260222
msgid "Do not use the callt instruction (default)."
msgstr "Använd inte callt-instruktionen (standard)."

#. from tp:gcc-16.1-b20260222
msgid "Reuse r30 on a per-function basis."
msgstr "Återanvänd r30 i varje funktion."

#. from tp:gcc-16.1-b20260222
msgid "Alias for -mrh850-abi."
msgstr "Alias för -mrh850-abi."

#. from tp:gcc-16.1-b20260222
msgid "Prohibit PC-relative function calls."
msgstr "Förhindra PC-relativa funktionsanrop."

#. from tp:gcc-16.1-b20260222
msgid "Use stubs for function prologues."
msgstr "Använd stubbar för funktionsprologer."

#. from tp:gcc-16.1-b20260222
msgid "Set the max size of data eligible for the SDA area."
msgstr "Ange den maximala storleken på data som är lämpliga för SDA-arean."

#. from tp:gcc-16.1-b20260222
msgid "Enable the use of the short load instructions."
msgstr "Aktivera användning av de korta laddinstruktionerna."

#. from tp:gcc-16.1-b20260222
msgid "Same as: -mep -mprolog-function."
msgstr "Samma som: -mep -mprolog-function."

#. from tp:gcc-16.1-b20260222
msgid "Set the max size of data eligible for the TDA area."
msgstr "Ange den maximala storleken på data som är lämpliga för TDA-arean."

#. from tp:gcc-16.1-b20260222
msgid "Do not enforce strict alignment."
msgstr "Framtvinga inte strikt justering."

#. from tp:gcc-16.1-b20260222
msgid "Put jump tables for switch statements into the .data section rather than the .code section."
msgstr "Lägg hopptabeller för switch-satser i .data-sektionen istället för .code-sektionen."

#. from tp:gcc-16.1-b20260222
msgid "Compile for the v850 processor."
msgstr "Kompilera för processorn v850."

#. from tp:gcc-16.1-b20260222
msgid "Compile for the v850e processor."
msgstr "Kompilera för processorn v850e."

#. from tp:gcc-16.1-b20260222
msgid "Compile for the v850e1 processor."
msgstr "Kompilera för processorn v850e1."

#. from tp:gcc-16.1-b20260222
msgid "Compile for the v850es variant of the v850e1."
msgstr "Kompilera för varianten v850es av v850e1."

#. from tp:gcc-16.1-b20260222
msgid "Compile for the v850e2 processor."
msgstr "Kompilera för processorn v850e2."

#. from tp:gcc-16.1-b20260222
msgid "Compile for the v850e2v3 processor."
msgstr "Kompilera för processorn v850e2v3."

#. from tp:gcc-16.1-b20260222
msgid "Compile for the v850e3v5 processor."
msgstr "Kompilera för processorn v850e3v5."

#. from tp:gcc-16.1-b20260222
msgid "Enable v850e3v5 loop instructions."
msgstr "Använd slinginstruktionerna i v850e3v5."

#. from tp:gcc-16.1-b20260222
msgid "Set the max size of data eligible for the ZDA area."
msgstr "Ange den maximala storleken på data som är lämpliga för ZDA-arean."

#. from tp:gcc-16.1-b20260222
msgid "Enable relaxing in the assembler."
msgstr "Aktivera avslappning i assemblern."

#. from tp:gcc-16.1-b20260222
msgid "Prohibit PC relative jumps."
msgstr "Förhindra PC-relativa hopp."

#. from tp:gcc-16.1-b20260222
msgid "Inhibit the use of hardware floating point instructions."
msgstr "Stäng av användningen av maskinvaruflyttalsinstruktioner."

#. from tp:gcc-16.1-b20260222
msgid "Allow the use of hardware floating point instructions for V850E2V3 and up."
msgstr "Tillåt användningen av maskinvaruflyttalsinstruktioner för V850E2V3 och senare."

#. from tp:gcc-16.1-b20260222
msgid "Enable support for the RH850 ABI.  This is the default."
msgstr "Aktivera stöd för ABI:et RH850.  Detta är standard."

#. from tp:gcc-16.1-b20260222
msgid "Enable support for the old GCC ABI."
msgstr "Aktivera stöd för det gamla GCC-ABI:et."

#. from tp:gcc-16.1-b20260222
msgid "Support alignments of up to 64-bits."
msgstr "Stöd justering av upp till 64 bitar."

#. from tp:gcc-16.1-b20260222
msgid "Known M68K CPUs (for use with the -mcpu= option):"
msgstr "Kända M68K-CPU:er (att användas med flaggan -mcpu=):"

#. from tp:gcc-16.1-b20260222
msgid "Known M68K microarchitectures (for use with the -mtune= option):"
msgstr "Kända M68K-mikroarkitekturer (att användas med flaggan -mtune=):"

#. from tp:gcc-16.1-b20260222
msgid "Known M68K ISAs (for use with the -march= option):"
msgstr "Kända M68K-ISA:er (att användas med flaggan -march=):"

#. from tp:gcc-16.1-b20260222
msgid "Generate code for a 520X."
msgstr "Generera kod för en 520X."

#. from tp:gcc-16.1-b20260222
msgid "Generate code for a 5206e."
msgstr "Generera kod för en 5206e."

#. from tp:gcc-16.1-b20260222
msgid "Generate code for a 528x."
msgstr "Generera kod för en 528x."

#. from tp:gcc-16.1-b20260222
msgid "Generate code for a 5307."
msgstr "Generera kod för en 5307."

#. from tp:gcc-16.1-b20260222
msgid "Generate code for a 5407."
msgstr "Generera kod för en 5407."

#. from tp:gcc-16.1-b20260222
msgid "Generate code for a 68000."
msgstr "Generera kod för en 68000."

#. from tp:gcc-16.1-b20260222
