msgid "The extents overflow file should not contain its own extents!  You should check the file system."
msgstr "Överspillsfilen för utsträckningar bör inte innehålla sina egna utsträckningar!  Du bör kontrollera filsystemet."

#. from tp:parted-3.4.64.2
msgid "Could not cache the file system in memory."
msgstr "Kunde inte mellanlagra filsystemet i minnet."

#. from tp:parted-3.4.64.2
msgid "Bad blocks list could not be loaded."
msgstr "Listan över felaktiga block kunde inte läsas in."

#. from tp:parted-3.4.64.2
msgid "An error occurred during extent relocation."
msgstr "Ett fel inträffade under omplacering av utsträckningar."

#. from tp:parted-3.4.64.2
msgid "This HFS+ volume has no catalog file.  This is very unusual!"
msgstr "Denna HFS+-volym har ingen katalogfil.  Detta är väldigt ovanligt!"

#. from tp:parted-3.4.64.2
msgid "This HFS+ volume has no extents overflow file.  This is quite unusual!"
msgstr "Denna HFS+-volym har ingen överspillsfil för utsträckningar.  Detta är väldigt ovanligt!"

