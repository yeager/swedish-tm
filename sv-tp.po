#. from tp:gas-2.45.90
msgid " MMIX-specific command line options:\n"
msgstr " MMIX-specifika kommandoradsflaggor:\n"

#. from tp:gas-2.45.90
msgid "  -fixed-special-register-names\n                          Allow only the original special register names.\n"
msgstr "  -fixed-special-register-names\n                          Tillåt endast originalnamn för specialregister.\n"

#. from tp:gas-2.45.90
msgid "  -globalize-symbols      Make all symbols global.\n"
msgstr "  -globalize-symbols      Gör alla symboler globala.\n"

#. from tp:gas-2.45.90
msgid "  -gnu-syntax             Turn off mmixal syntax compatibility.\n"
msgstr "  -gnu-syntax             Stäng av kompatibilitet med mmixal-syntax.\n"

#. from tp:gas-2.45.90
msgid "  -relax                  Create linker relaxable code.\n"
msgstr "  -relax                  Skapa kod lämplig för länkarlättnad.\n"

#. from tp:gas-2.45.90
msgid "  -no-predefined-syms     Do not provide mmixal built-in constants.\n                          Implies -fixed-special-register-names.\n"
msgstr "  -no-predefined-syms     Tillhandahåll inte inbyggda mmixal-konstanter.\n                          Medför -fixed-special-register-names.\n"

#. from tp:gas-2.45.90
msgid "  -no-expand              Do not expand GETA, branches, PUSHJ or JUMP\n                          into multiple instructions.\n"
msgstr "  -no-expand              Expandera inte GETA, grenar, PUSHJ eller JUMP\n                          till flera instruktioner.\n"

#. from tp:gas-2.45.90
msgid "  -no-merge-gregs         Do not merge GREG definitions with nearby values.\n"
msgstr "  -no-merge-gregs         Sammanfoga inte GREG-definitioner med närliggande värden.\n"

#. from tp:gas-2.45.90
msgid "  -linker-allocated-gregs If there's no suitable GREG definition for the                          operands of an instruction, let the linker resolve.\n"
msgstr "  -linker-allocated-gregs Om det inte finns någon lämplig GREG-definition\n                          för en instruktions operander låter du länkaren lösa det.\n"

#. from tp:gas-2.45.90
msgid "  -x                      Do not warn when an operand to GETA, a branch,\n                          PUSHJ or JUMP is not known to be within range.\n                          The linker will catch any errors.  Implies\n                          -linker-allocated-gregs."
msgstr "  -x                      Varna inte när en operand till GETA, en gren,\n                          PUSHJ eller JUMP inte säkert är inom intervall.\n                          Länkaren kommer att fånga sådana fel. Medför\n                          -linker-allocated-gregs."

