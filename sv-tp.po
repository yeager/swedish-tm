msgid "%tests your ability to determine if note is moving by a step or skip"
msgstr "%tests din förmåga att avgöra om noten förflyttas med ett steg eller hoppar över"

#. from tp:denemo-2.6-rc2
msgid "Trace Note Direction"
msgstr "Följ notens riktning"

#. from tp:denemo-2.6-rc2
msgid "%tests your note tracking ability"
msgstr "%testar din förmåga att följa noter"

#. from tp:denemo-2.6-rc2
msgid "Scores have different numbers of movements"
msgstr "Partituren har olika antal satser"

#. from tp:denemo-2.6-rc2
msgid "Scores have different header information: "
msgstr "Partituren har olika rubrikinformation: "

#. from tp:denemo-2.6-rc2
msgid "Movement number "
msgstr "Rörelsens nummer "

#. from tp:denemo-2.6-rc2
msgid "Movements have different header information: "
msgstr "Rörelser har olika rubrikinformation: "

#. from tp:denemo-2.6-rc2
msgid "Finished Movement "
msgstr "Avslutad sats "

#. from tp:denemo-2.6-rc2
msgid "Finished, but lyric verses are not checked"
msgstr "Klar, men sångtextverser har inte kontrollerats"

#. from tp:denemo-2.6-rc2
msgid "Compare Scores"
msgstr "Jämför partitur"

#. from tp:denemo-2.6-rc2
msgid "Opens two scores and reports on any differences between them."
msgstr "Öppnar två partitur och rapporterar eventuella skillnader mellan dem."

#. from tp:denemo-2.6-rc2
msgid "Your score will be exported to MusicXML music interchange format. Note this does not preserve all the information - you must save your score as well"
msgstr "Ditt partitur kommer att exporteras till MusicXML musikutbytesformat. Observera att detta inte bevarar all information - du måste spara ditt partitur också"

#. from tp:denemo-2.6-rc2
msgid "Score not saved."
msgstr "Partituret är inte sparat."

#. from tp:denemo-2.6-rc2
msgid "Export as MusicXML"
msgstr "Exportera som MusicXML"

#. from tp:denemo-2.6-rc2
msgid "Exports the current score in the MusicXML format. For a multi-movement score the movements are saved in files of the form *-n.xml where n is the number of the movement. The export is limited to things Denemo knows about the score - it does not know a lot about how LilyPond will typeset the score. The parts are exported on separate staffs."
msgstr "Exporterar det aktuella partituret i MusicXML-format. I ett partitur med flera satser sparas satserna i filer av formen *-n.xml, där n är satsens nummer. Exporten är begränsad till sådant som Denemo känner till om partituret; Denemo känner inte till mycket om hur LilyPond typsätter det. Stämmorna exporteras på separata notsystem."

#. from tp:denemo-2.6-rc2
msgid "Export Currrent Audio Recording"
msgstr "Exportera pågående ljudinspelning"

#. from tp:denemo-2.6-rc2
msgid "Exports recorded audio output."
msgstr "Exporterar inspelad ljudutgång."

#. from tp:denemo-2.6-rc2
msgid "Recording Audio"
msgstr "Inspelning av ljud"

#. from tp:denemo-2.6-rc2
msgid "Give pause between movements (seconds):"
msgstr "Ange paus mellan satser (sekunder):"

#. from tp:denemo-2.6-rc2
msgid "Export Score as Audio"
msgstr "Exportera partitur som ljud"

#. from tp:denemo-2.6-rc2
msgid "Plays a performance of the whole score, including repeats, then offers to save the recording as Audio."
msgstr "Spelar upp hela partituret, inklusive upprepningar, och erbjuder sedan att spara inspelningen som ljud."

#. from tp:denemo-2.6-rc2
msgid "The score does not have a file name, so no file name for the output LilyPond file can be constructed. Save the score first."
msgstr "Partituret har inget filnamn, så något filnamn för LilyPond-utdatafilen kan inte skapas. Spara partituret först."

#. from tp:denemo-2.6-rc2
msgid "Quick LilyPond Export"
msgstr "Snabb export av LilyPond"

#. from tp:denemo-2.6-rc2
msgid "Exports as LilyPond to a file named the same as the .denemo file but with .ly suffix."
msgstr "Exporterar som LilyPond till en fil med samma namn som .denemo-filen, men med ändelsen .ly."

#. from tp:denemo-2.6-rc2
msgid "Quick LilyPond Parts All Movements"
msgstr "Snabb LilyPond-export av stämmor för alla satser"

#. from tp:denemo-2.6-rc2
msgid "Runs Quick LilyPond Parts on all movemnts."
msgstr "Kör Snabb LilyPond-export av stämmor för alla satser."

#. from tp:denemo-2.6-rc2
msgid "Quick LilyPond Parts"
msgstr "Snabb LilyPond-export av stämmor"

#. from tp:denemo-2.6-rc2
msgid "Runs Quick LilyPond Part on all the staffs of the current movement."
msgstr "Kör Snabb LilyPond-export av stämma för alla notsystem i den aktuella satsen."

#. from tp:denemo-2.6-rc2
msgid "Quick LilyPond Part"
msgstr "Snabb LilyPond-export av stämma"

#. from tp:denemo-2.6-rc2
msgid "Writes a file containing the music of the current staff in LilyPond format. The filename is the current file name with \\\"-denemo\\\" and the movement and staff numbers appended (and the .ly suffix)."
msgstr "Skriver en fil med musiken i det aktuella notsystemet i LilyPond-format. Filnamnet är det aktuella filnamnet med ”-denemo” samt sats- och notsystemnummer tillagda, och ändelsen .ly."

#. from tp:denemo-2.6-rc2
msgid "You have unsaved work."
msgstr "Du har osparat arbete."

#. from tp:denemo-2.6-rc2
msgid "Import Lilypond (Limited)"
msgstr "Importera LilyPond (begränsat)"

#. from tp:denemo-2.6-rc2
msgid "Try to Import a Lilypond File"
msgstr "Försök importera en LilyPond-fil"

#. from tp:denemo-2.6-rc2
msgid "Import Midi (Limited)"
msgstr "Importera MIDI (begränsat)"

#. from tp:denemo-2.6-rc2
msgid "Try to Import a Midi File"
msgstr "Försök importera en MIDI-fil"

#. from tp:denemo-2.6-rc2
msgid "Simple Titles"
msgstr "Enkla titlar"

#. from tp:denemo-2.6-rc2
msgid "Book Titles"
msgstr "Titlar på böcker"

#. from tp:denemo-2.6-rc2
msgid "Untitled"
msgstr "Saknar rubrik"

#. from tp:denemo-2.6-rc2
msgid "Imports a MusicXml file as a new movement. Not all features are supported."
msgstr "Importerar en MusicXML-fil som en ny sats. Alla funktioner stöds inte."

#. from tp:denemo-2.6-rc2
msgid "MIDI Import"
msgstr "MIDI-import"

#. from tp:denemo-2.6-rc2
msgid "Import Music from a MIDI file, either guided or (in simple cases) automatically."
msgstr "Importera musik från en MIDI-fil, antingen vägledd eller automatiskt i enkla fall."

#. from tp:denemo-2.6-rc2
msgid "Not an Index"
msgstr "Inte ett index"

#. from tp:denemo-2.6-rc2
msgid "Choose Denemo Score to add to Index"
msgstr "Välj Denemo-partitur att lägga till i index"

#. from tp:denemo-2.6-rc2
msgid "End of Index. Number of entries "
msgstr "Slut på index. Antal poster "

#. from tp:denemo-2.6-rc2
msgid "Add to Index"
msgstr "Lägg till i index"

#. from tp:denemo-2.6-rc2
msgid "Adds an index entry for the file chosen to the currently open Index."
msgstr "Lägger till en indexpost för den valda filen i det index som är öppet."

#. from tp:denemo-2.6-rc2
msgid "No Scheme condition in the Scheme Script window - see View menu"
msgstr "Inget Scheme-villkor i fönstret Scheme-skript – se menyn Visa"

#. from tp:denemo-2.6-rc2
msgid "Create Conditional Index"
msgstr "Skapa villkorligt index"

#. from tp:denemo-2.6-rc2
msgid "Creates an index including only those scores for which the script in the Scheme Window evaluates to true (i.e. the last expression evaluates as not #f). The comment for each index entry can be created using the procedure DenemoIndexCommentDisplay, e.g. (DenemoIndexCommentDisplay mycomment)."
msgstr "Skapar ett index som endast innehåller de partitur vars skript i Scheme-fönstret utvärderas till sant (det vill säga där det sista uttrycket inte blir #f). Kommentaren för varje indexpost kan skapas med proceduren DenemoIndexCommentDisplay, till exempel (DenemoIndexCommentDisplay mycomment)."

#. from tp:denemo-2.6-rc2
msgid "Where to search"
msgstr "Var sökning ska ske"

#. from tp:denemo-2.6-rc2
msgid "The Index to scores will appear in the Print View."
msgstr "Partiturindexet visas i utskriftsvyn."

#. from tp:denemo-2.6-rc2
msgid "Note that the display will be very sluggish until indexing completes."
msgstr "Observera att visningen blir mycket trög tills indexeringen är klar."

#. from tp:denemo-2.6-rc2
msgid "Indexing Complete in "
msgstr "Indexering komplett i "

#. from tp:denemo-2.6-rc2
msgid "No scores found for the given condition"
msgstr "Inga partitur hittades för det angivna villkoret"

#. from tp:denemo-2.6-rc2
msgid "No scores found"
msgstr "Inga partitur hittades"

#. from tp:denemo-2.6-rc2
msgid "Index Scores"
msgstr "Indexera partitur"

#. from tp:denemo-2.6-rc2
msgid "Creates an index of all the Denemo scores in a folder and sub-folders."
msgstr "Skapar ett index över alla Denemo-partitur i en mapp och dess undermappar."

#. from tp:denemo-2.6-rc2
msgid "Index Filter"
msgstr "Indexfilter"

#. from tp:denemo-2.6-rc2
msgid "Give Instrument Name to filter on:"
msgstr "Ange instrumentnamn att filtrera efter:"

#. from tp:denemo-2.6-rc2
msgid "Violino"
msgstr "Violino"

#. from tp:denemo-2.6-rc2
msgid "Create index first"
msgstr "Skapa index först"

#. from tp:denemo-2.6-rc2
msgid "Filter by Instrument"
msgstr "Filtrera efter instrument"

#. from tp:denemo-2.6-rc2
msgid "Filters the currently loaded index of scores by your choice of instrument name."
msgstr "Filtrerar det inlästa partiturindexet efter valt instrumentnamn."

#. from tp:denemo-2.6-rc2
msgid "Open the Scheme window from the View menu and write a condition to filter on (in Scheme syntax)\nThe variables available are:\nfilename composer title \nwhich are strings and\ninstruments\nwhich is a list of strings."
msgstr "Öppna Scheme-fönstret från menyn Visa och skriv ett villkor att filtrera efter (med Scheme-syntax).\nTillgängliga variabler är:\nfilename composer title\nsom är strängar, samt\ninstruments\nsom är en lista med strängar."

#. from tp:denemo-2.6-rc2
msgid "Filter by Scheme Condition"
msgstr "Filtrera efter Scheme-villkor"

#. from tp:denemo-2.6-rc2
msgid "Filters the currently loaded index of scores by a Scheme expression involving the variables filename, title, composer, comment (all strings) and the list of instruments (a list of strings)"
msgstr "Filtrerar det inlästa partiturindexet med ett Scheme-uttryck som innehåller variablerna filename, title, composer och comment (alla strängar) samt instruments (en lista med strängar)."

#. from tp:denemo-2.6-rc2
msgid "Sort by Composer"
msgstr "Sortera efter kompositör"

#. from tp:denemo-2.6-rc2
msgid "Sorts an index already created into alphabetical order by composer. The files are not re-indexed, so may be out-of-date, use Index Scores command if so."
msgstr "Sorterar ett redan skapat index alfabetiskt efter kompositör. Filerna indexeras inte om och kan därför vara inaktuella; använd kommandot Indexera partitur i så fall."

#. from tp:denemo-2.6-rc2
msgid "Create Template"
msgstr "Skapa mall"

#. from tp:denemo-2.6-rc2
msgid "Give key"
msgstr "Ange tonart"

#. from tp:denemo-2.6-rc2
msgid "Give time signature"
msgstr "Ange taktart"

#. from tp:denemo-2.6-rc2
msgid "Cancelled: "
msgstr "Avbruten: "

#. from tp:denemo-2.6-rc2
msgid "Score is not saved"
msgstr "Partituret är inte sparat"

#. from tp:denemo-2.6-rc2
msgid "New from Current"
msgstr "Nytt från nuvarande"

#. from tp:denemo-2.6-rc2
msgid "Creates a new score from the current score omitting the actual music and prompting for possible new values for clef, key, time signature, titles etc."
msgstr "Skapar ett nytt partitur från det aktuella partituret, utan själva musiken, och frågar efter eventuella nya värden för klav, tonart, taktart, titlar osv."

#. from tp:denemo-2.6-rc2
msgid "You can now insert the notes from the MIDI track into the staff beneath the (top) click track staff.\n    The MIDI notes detected are displayed above the top staff, and the first is marked ready to be entered.\n    The Return key will enter the note using the duration calculated from the time until the next note -\n    override this by playing a duration key 0, 1 .... or clicking a duration button.\n    Use the Ins key to insert a note in the chord if the MIDI notes are not sequential.\n    You can use the Navigation commands to move the marked MIDI note around if you need to back up or re-start\n    (or you can double-click on the MIDI note marker itself - above the blue line at the top - to make it the marked MIDI note).\n    When you have finished with this MIDI track use the button (or use the Staff->Add Staff->MIDI menu) to load another track. \n    It is best to work up from the lowest numbered track so that the staffs are in order without having to swap them afterwards."
msgstr "Du kan nu infoga noterna från MIDI-spåret i notsystemet under klickspårets översta notsystem.\n    De registrerade MIDI-noterna visas ovanför det översta notsystemet och den första är markerad som klar för inmatning.\n    Retur-tangenten matar in noten med en längd som beräknas från tiden till nästa not.\n    Du kan åsidosätta detta genom att trycka på en längdtangent (0, 1 …) eller klicka på en längdknapp.\n    Använd Insert-tangenten för att infoga en not i ackordet om MIDI-noterna inte följer på varandra.\n    Du kan använda navigeringskommandona för att flytta den markerade MIDI-noten om du behöver gå tillbaka eller börja om.\n    Du kan också dubbelklicka på MIDI-notmarkören ovanför den blå linjen överst för att markera den MIDI-noten.\n    När du är klar med MIDI-spåret använder du knappen eller menyn Notsystem → Lägg till notsystem → MIDI för att läsa in ett annat spår.\n    Arbeta helst från det lägst numrerade spåret uppåt så att notsystemen hamnar i ordning utan att behöva bytas senare."

#. from tp:denemo-2.6-rc2
msgid "Open Source MIDI"
msgstr "MIDI med öppen källkod"

#. from tp:denemo-2.6-rc2
msgid "Opens a MIDI file for transcribing. Load each track in turn and insert the MIDI notes by playing the durations."
msgstr "Öppnar en MIDI-fil för transkribering. Läs in varje spår i tur och ordning och infoga MIDI-noterna genom att spela längderna."

#. from tp:denemo-2.6-rc2
msgid "Open Source Audio"
msgstr "Ljud med öppen källkod"

#. from tp:denemo-2.6-rc2
msgid "Opens an audio file which will be played along with the notated music. The music is attached starting at the start time of the note at cursor. It is displayed above the top staff, provided there is notated music to provide timings to attach to. In an empty score a click track is created to attach the audio to."
msgstr "Öppnar en ljudfil som spelas upp tillsammans med den noterade musiken. Musiken fästs från starttiden för noten vid markören. Den visas ovanför det översta notsystemet, förutsatt att det finns noterad musik som ger tidpunkter att fästa den vid. I ett tomt partitur skapas ett klickspår att fästa ljudet vid."

#. from tp:denemo-2.6-rc2
msgid "Failed to open Default.denemo in your custom templates directory\nHave you saved a template called Default yet?"
msgstr "Det gick inte att öppna Default.denemo i katalogen för dina egna mallar\nHar du sparat en mall som heter Default än?"

#. from tp:denemo-2.6-rc2
msgid "Open Default Template"
msgstr "Öppna standardmall"

#. from tp:denemo-2.6-rc2
msgid "Opens the template Default.denemo in the user's custom template folder."
msgstr "Öppnar mallen Default.denemo i användarens mapp för anpassade mallar."

#. from tp:denemo-2.6-rc2
msgid "Open Proof Read PDF"
msgstr "Öppna PDF med korrektur"

#. from tp:denemo-2.6-rc2
msgid "Opens a dialog to fetch a PDF file generated by Denemo which has had proof reading annotations added to it. Clicking on notes in this file moves the cursor to the correct point in the Denemo display."
msgstr "Öppnar en dialogruta för att hämta en PDF-fil som genererats av Denemo och som har försetts med korrekturanteckningar. Genom att klicka på noter i filen flyttas markören till rätt punkt i Denemo-visningen."

#. from tp:denemo-2.6-rc2
msgid "Open Source for Transcribing"
msgstr "Öppen källkod för transkribering"

#. from tp:denemo-2.6-rc2
msgid "Opens a dialog to fetch a source facsimile or manuscript. Links can be placed in the Denemo score to this source file so that the source passage for a given measure can be re-displayed when reviewing the score."
msgstr "Öppnar en dialogruta för att hämta en faksimil eller ett manuskript. Länkar kan placeras i Denemo-partituret till denna källfil så att källpassagen för en viss takt kan visas igen när man granskar partituret."

#. from tp:denemo-2.6-rc2
msgid "You may need to fix this warning:\n\""
msgstr "Du kan behöva åtgärda denna varning:\n\""

#. from tp:denemo-2.6-rc2
msgid "\"\nbefore printing."
msgstr "\"\nföre utskrift."

#. from tp:denemo-2.6-rc2
msgid "Check and Print"
msgstr "Kontrollera och skriv ut"

#. from tp:denemo-2.6-rc2
msgid "Checks the score for errors, if none are found proceeds to typeset and print the current layout."
msgstr "Kontrollerar partituret för fel och, om inga hittas, fortsätter med att typsätta och skriva ut den aktuella layouten."

#. from tp:denemo-2.6-rc2
msgid "Do Not Create Layout for this selection"
msgstr "Skapa inte layout för detta urval"

#. from tp:denemo-2.6-rc2
msgid "Apply to All Movements"
msgstr "Tillämpa på alla satser"

#. from tp:denemo-2.6-rc2
msgid "Choose Staffs to Print"
msgstr "Välj notsystem att skriva ut"

#. from tp:denemo-2.6-rc2
msgid "Creating Layout"
msgstr "Skapa layout"

#. from tp:denemo-2.6-rc2
msgid "Give Layout Name"
msgstr "Ge layouten ett namn"

#. from tp:denemo-2.6-rc2
msgid "Woodwind"
msgstr "Träblås"

#. from tp:denemo-2.6-rc2
msgid "Use Typeset->"
msgstr "Använd Typsätt →"

#. from tp:denemo-2.6-rc2
msgid " in the Print View to typeset your new layout"
msgstr " i utskriftsvyn för att sätta din nya layout"

#. from tp:denemo-2.6-rc2
msgid "Select Staffs to Print"
msgstr "Välj notsystem att skriva ut"

#. from tp:denemo-2.6-rc2
msgid "Makes selected staffs non-printing."
msgstr "Gör markerade notsystem till sådana som inte skrivs ut."

#. from tp:denemo-2.6-rc2
msgid "Preview Four Measures"
msgstr "Förhandsgranskning av fyra takter"

#. from tp:denemo-2.6-rc2
msgid "Print preview of current bar and the next three."
msgstr "Utskriftsförhandsgranskning av aktuell takt och de tre följande."

#. from tp:denemo-2.6-rc2
msgid "Accompanist's Score"
msgstr "Ackompanjatörens partitur"

#. from tp:denemo-2.6-rc2
msgid "Print Accompanist's Score"
msgstr "Skriv ut ackompanjatörens partitur"

#. from tp:denemo-2.6-rc2
msgid "How many staffs to make small?"
msgstr "Hur många notsystem ska förminskas?"

#. from tp:denemo-2.6-rc2
msgid "Accompanist with "
msgstr "Ackompanjatör med "

#. from tp:denemo-2.6-rc2
msgid " cue part"
msgstr " cue-stämma"

#. from tp:denemo-2.6-rc2
msgid "Give Instrumentation "
msgstr "Ge instrumentering "

#. from tp:denemo-2.6-rc2
msgid "Prints out the score with the topmost staff in tiny size and puts page breaks before each movement."
msgstr "Skriver ut partituret med det översta notsystemet i mycket liten storlek och lägger sidbrytningar före varje sats."

#. from tp:denemo-2.6-rc2
msgid "No Layouts Available?"
msgstr "Inga layouter tillgängliga?"

#. from tp:denemo-2.6-rc2
msgid "Prints All Layouts"
msgstr "Skriver ut alla layouter"

#. from tp:denemo-2.6-rc2
msgid "Prints the score using all the defined score layouts."
msgstr "Skriver ut partituret med alla definierade partiturlayouter."

#. from tp:denemo-2.6-rc2
msgid "Bass without figures"
msgstr "Bas utan siffror"

#. from tp:denemo-2.6-rc2
msgid "Print Bass Part Omitting Figures"
msgstr "Skriv ut basstämma utan siffror"

#. from tp:denemo-2.6-rc2
msgid "Prints the Bass part omitting any figured bass figures."
msgstr "Skriver ut basstämman utan generalbassiffror."

#. from tp:denemo-2.6-rc2
msgid "No Book Title, see Score->Titles->Book Titles"
msgstr "Ingen boktitel, se partitur->Titlar->Boktitlar"

#. from tp:denemo-2.6-rc2
msgid "Print Part with Title Page"
msgstr "Skriv ut stämma med titelsida"

#. from tp:denemo-2.6-rc2
msgid "Prints part with part name on title page"
msgstr "Skriver ut stämman med stämnamnet på titelsidan"

#. from tp:denemo-2.6-rc2
msgid "Print Score and Parts"
msgstr "Skriv ut partitur och stämmor"

#. from tp:denemo-2.6-rc2
msgid "Creates score layouts for the current layout (full score) and parts (named after instrument name). Set instrument names before use."
msgstr "Skapar partiturlayouter för den aktuella layouten (hela partituret) och stämmor (namngivna efter instrumentnamn). Ställ in instrumentnamn före användning."

#. from tp:denemo-2.6-rc2
msgid "Print Three Parts as Cue for Accompanist"
msgstr "Skriv ut tre stämmor som cue för ackompanjatören"

#. from tp:denemo-2.6-rc2
msgid "Prints top three parts on one staff as cues."
msgstr "Skriver ut de tre översta stämmorna som cue på ett notsystem."

#. from tp:denemo-2.6-rc2
msgid "Print Two Parts as Cue for Accompanist"
msgstr "Skriv ut två stämmor som cue för ackompanjatören"

#. from tp:denemo-2.6-rc2
msgid "Prints the top two staffs on a single staff as cue."
msgstr "Skriver ut de två översta notsystemen som cue på ett notsystem."

#. from tp:denemo-2.6-rc2
msgid "Turn off continuous typesetting first"
msgstr "Stäng av kontinuerlig sättning först"

#. from tp:denemo-2.6-rc2
msgid "Ambitus"
msgstr "Ambitus"

#. from tp:denemo-2.6-rc2
msgid "Print with Ambitus"
msgstr "Skriv ut med ambitus"

#. from tp:denemo-2.6-rc2
msgid "Prints the score printing the range (ambitus) of each part at the start of the staff"
msgstr "Skriver ut partituret med omfånget (ambitus) för varje stämma i början av notsystemet."

#. from tp:denemo-2.6-rc2
msgid "Score not saved"
msgstr "Partituret är inte sparat"

#. from tp:denemo-2.6-rc2
msgid "Discard Changes"
msgstr "Kassera ändringar"

#. from tp:denemo-2.6-rc2
msgid "Make a copy first\n(re-issue this Reload command afterwards!)"
msgstr "Gör först en kopia\n(ge kommandot Reload igen efteråt!)"

#. from tp:denemo-2.6-rc2
msgid "Score not saved to disk"
msgstr "Partituret är inte sparat på disken"

#. from tp:denemo-2.6-rc2
msgid "Reload Score"
msgstr "Ladda om partitur"

#. from tp:denemo-2.6-rc2
msgid "Reloads the current score from last saved version on disk."
msgstr "Laddar om det aktuella partituret från den senast sparade versionen på disken."

#. from tp:denemo-2.6-rc2
msgid "Remove All Music?"
msgstr "Ta bort all musik?"

#. from tp:denemo-2.6-rc2
msgid "Keep Music?"
msgstr "Behålla musiken?"

#. from tp:denemo-2.6-rc2
msgid "Saves the current score as a template, offering to remove the music if desired. When removing the music, all movements except the first movement are deleted and all the contents of the staffs except the first source reference, and any Incipit is deleted too."
msgstr "Sparar det aktuella partituret som en mall och erbjuder att ta bort musiken om så önskas. När musiken tas bort raderas alla satser utom den första, liksom allt innehåll i notsystemen utom den första källhänvisningen och eventuellt incipit."

#. from tp:denemo-2.6-rc2
msgid "Returning to the first Movement for thumbnail selection"
msgstr "Återgå till första satsen för att välja miniatyrbild"

#. from tp:denemo-2.6-rc2
msgid "Thumbnail Selection Complete"
msgstr "Val av miniatyrbild klart"

#. from tp:denemo-2.6-rc2
msgid "Create thumbnail now?"
msgstr "Skapa miniatyrbild nu?"

#. from tp:denemo-2.6-rc2
msgid "No Selection to set the thumbnail to\nCreate a selection and re-run the command."
msgstr "Inget urval att ställa in miniatyrbilden till\nSkapa en markering och kör kommandot igen."

#. from tp:denemo-2.6-rc2
msgid "Save the score before trying to set the thumbnail"
msgstr "Spara partituret innan du försöker ange miniatyrbilden"

#. from tp:denemo-2.6-rc2
msgid "Set Thumbnail from Selection"
msgstr "Ange miniatyrbild från markering"

#. from tp:denemo-2.6-rc2
msgid "Sets the thumbnail for opening this file to the selection. (The selection must be in the first movement)."
msgstr "Ställer in miniatyrbilden för att öppna den här filen till urvalet. (Valet måste vara i den första rörelsen)."

#. from tp:denemo-2.6-rc2
msgid "Help by Email"
msgstr "Hjälp via e-post"

#. from tp:denemo-2.6-rc2
msgid "Please explain the problem you are having"
msgstr "Beskriv problemet"

#. from tp:denemo-2.6-rc2
msgid "Your browser will now start with a button to send your email. If the email form fails to show, send your email to denemo-devel@gnu.org"
msgstr "Din webbläsare kommer nu att starta med en knapp för att skicka ditt e-postmeddelande. Om e-postformuläret inte visas, skicka ditt e-postmeddelande till denemo-devel@gnu.org"

#. from tp:denemo-2.6-rc2
msgid "Email for Help"
msgstr "E-post för att få hjälp"

#. from tp:denemo-2.6-rc2
msgid "Uses your browser to open an email form for you to ask questions/report problems. This is the sure and certain way to get help, the chat facility is more hit and miss\""
msgstr "Använder din webbläsare för att öppna ett e-postformulär där du kan ställa frågor/rapportera problem. Detta är det säkraste sättet att få hjälp, chattfunktionen är mer osäker\""

#. from tp:denemo-2.6-rc2
msgid "Browse Feature-Packed Score"
msgstr "Bläddra i funktionsspäckat partitur"

#. from tp:denemo-2.6-rc2
msgid "Opens a score with examples of many things you can create with Denemo with Explanations attached. Click on the explanations in the Print View window. Or copy and paste useful objects to your score."
msgstr "Öppnar ett partitur med exempel på mycket av det du kan skapa i Denemo, med tillhörande förklaringar. Klicka på förklaringarna i fönstret Utskriftsvy. Du kan också kopiera användbara objekt till ditt partitur."

#. from tp:denemo-2.6-rc2
msgid "The Return keypress can be used as a special instantly movable shortcut,\nyou can set it to any menu action you wish by pressing it while you have the item selected\nAny one-key shortcut can be set this way, but with Return you do not get told if you are taking the shortcut away from another command.\nAlso the setting is not saved.\nThe idea is to set it for your current activity (e.g. applying tenuto marks).\nYou can make it \"normal\" by setting a preference - see Edit->Preferences->Command Behavior.\nNote that the Enter key on the numeric keypad is a separate key (or should be!) and can be used as a shortcut independently"
msgstr "Retur-tangenten kan användas som en speciell genväg som kan flyttas direkt,\ndu kan ställa in den på vilken menyåtgärd du vill genom att trycka på den medan du har objektet valt\nAlla genvägar med en tangent kan ställas in på det här sättet, men med Return får du inte veta om du tar bort genvägen från ett annat kommando.\nInställningen sparas inte heller.\nTanken är att du ska ställa in den för din aktuella aktivitet (t.ex. applicera tenuto-markeringar).\nDu kan göra det \"normalt\" genom att ställa in en preferens - se Redigera->Preferenser->Kommandobeteende.\nObservera att Enter-tangenten på det numeriska tangentbordet är en separat tangent (eller borde vara det!) och kan användas som en genväg på egen hand"

#. from tp:denemo-2.6-rc2
msgid "Help for Return Keypress"
msgstr "Hjälp om Retur-tangenten"

#. from tp:denemo-2.6-rc2
msgid "Does nothing except explain what the Return key is used for in Denemo, and how to make it an ordinary shortcut if you prefer."
msgstr "Gör inget annat än förklarar vad Retur-tangenten används till i Denemo och hur du gör den till en vanlig genväg om du vill."

#. from tp:denemo-2.6-rc2
msgid "Your browser may take a few moments to start - be patient!\n 	When it has started click Start\n 	Then you get a page with a place to type your question at the bottom.\n 	Type hello in there and hit Enter\n 	If no one is there to help you can use the mailing list denemo-devel@gnu.org"
msgstr "Det kan ta några ögonblick innan webbläsaren startar – ha tålamod.\n \tNär den har startat klickar du på Start.\n \tDu får sedan en sida med ett fält längst ned där du kan skriva din fråga.\n \tSkriv hello där och tryck på Enter.\n \tOm ingen kan hjälpa dig kan du använda sändlistan denemo-devel@gnu.org"

#. from tp:denemo-2.6-rc2
msgid "Chat to Other Users"
msgstr "Chatta med andra användare"

#. from tp:denemo-2.6-rc2
msgid "Runs your browser on a page giving access to denemo's internet relay chat"
msgstr "Öppnar en sida i webbläsaren som ger åtkomst till Denemos IRC-kanal"

#. from tp:denemo-2.6-rc2
msgid "Newbie status is now on - re-start Denemo to see extra tooltips"
msgstr "Nybörjarstatus är nu aktiverad - starta om Denemo för att se extra verktygstips"

#. from tp:denemo-2.6-rc2
msgid "Newbie status is now off - re-start Denemo to avoid excessive tooltips.\nNote you can also increase the time before the remaining ones appear via the Preferences\nSome Newbie Palettes have been hidden, use the View menu to choose ones to re-instate."
msgstr "Nybörjarstatusen är nu avstängd - starta om Denemo för att undvika överdrivna verktygstips.\nObservera att du också kan öka tiden innan de återstående visas via inställningarna\nVissa nybörjarpaletter har döljts, använd menyn Visa för att välja vilka som ska återinföras."

#. from tp:denemo-2.6-rc2
msgid "Turn Excessive Tooltips (Off/On)"
msgstr "Visa färre verktygstips (av/på)"

#. from tp:denemo-2.6-rc2
msgid "Sets your status as a newbie on or off. This affects the tooltips and palettes. Note you can also independently delay tooltips, indefinitely if you wish, via the preferences dialog. See Edit-&gt;Change Preferences-&gt;Command Behavior"
msgstr "Aktiverar eller inaktiverar din status som nybörjare. Detta påverkar verktygstips och paletter. Observera att du också kan fördröja verktygstipsen oberoende av varandra, på obestämd tid om du vill, via dialogrutan Inställningar. Se Redigera-&gt;Ändra inställningar-&gt;Kommandobeteende"

#. from tp:denemo-2.6-rc2
msgid "Tutorial"
msgstr "Handledning"

#. from tp:denemo-2.6-rc2
msgid "Steps through the basic commands"
msgstr "Går igenom de grundläggande kommandona steg för steg"

#. from tp:denemo-2.6-rc2
msgid "Note Names Default Action"
msgstr "Standardåtgärd för notnamn"

#. from tp:denemo-2.6-rc2
msgid "Changes the shortcuts for note names a, b, c, d, e, f, g so that they edit the note at the cursor, or append a note when in the appending position."
msgstr "Ändrar genvägarna för notnamnen a, b, c, d, e, f, g så att de redigerar noten vid markören eller lägger till en not när de befinner sig i tilläggspositionen."

#. from tp:denemo-2.6-rc2
msgid "Note Names Move Cursor"
msgstr "Notnamn flyttar markören"

#. from tp:denemo-2.6-rc2
msgid "Changes the shortcuts for note names a, b, c, d, e, f, g so that they move the cursor to the nearest note of that name."
msgstr "Ändrar genvägarna för notnamnen a, b, c, d, e, f, g så att de flyttar markören till närmaste not med samma namn."

#. from tp:denemo-2.6-rc2
msgid "Numbers Default Action"
msgstr "Standardåtgärd för siffror"

#. from tp:denemo-2.6-rc2
msgid "Sets key shortcuts 0,1,2... to the default action, inserting notes of the duration."
msgstr "Anger standardåtgärden för tangentbordsgenvägarna 0, 1, 2 …: att infoga noter med längden."

#. from tp:denemo-2.6-rc2
msgid "Numbers Select Duration"
msgstr "Siffror väljer längd"

#. from tp:denemo-2.6-rc2
msgid "Changes the action of keys 0,1,2... to select the prevailing duration instead of inserting notes of the duration."
msgstr "Ändrar åtgärden för tangenterna 0, 1, 2 … så att de väljer aktuell längd i stället för att infoga noter med längden."

#. from tp:denemo-2.6-rc2
msgid "Dismiss this dialog then press 20 keys for the 20 notes c'' - g'''. Esc to cancel."
msgstr "Avfärda dialogrutan och tryck sedan på 20 tangenter för de 20 tonerna c''–g'''. Esc avbryter."

#. from tp:denemo-2.6-rc2
msgid "Press Escape in the Denemo Main Window to end MIDI keyboard simulation."
msgstr "Tryck på Esc i Denemos huvudfönster för att avsluta simuleringen av MIDI-tangentbord."

#. from tp:denemo-2.6-rc2
msgid "Simulated MIDI Filter: Esc to end."
msgstr "Simulerat MIDI-filter: Esc avslutar."

#. from tp:denemo-2.6-rc2
msgid "Octave:"
msgstr "Oktav:"

#. from tp:denemo-2.6-rc2
msgid "MIDI simulator end"
msgstr "MIDI-simulatorn avslutas"

#. from tp:denemo-2.6-rc2
msgid "Simulate MIDI"
msgstr "Simulera MIDI"

#. from tp:denemo-2.6-rc2
msgid "Makes the second and third rows of the pc-keyboard behave like a MIDI piano keyboard: asdfg... creates the scale from Middle C, while the qwerty row provides sharps/flats (with gaps). To customize these key assignments for your keyboard use Ctrl-Esc. Tab key toggles chord entry off/on. PgUp key starts entering notes an octave higher, PgDn an octave lower. Use with rhythm entry for MIDI in checked in preferences."
msgstr "Gör så att andra och tredje raden på datorns tangentbord fungerar som ett MIDI-pianotangentbord: asdfg … skapar skalan från mitt-C, medan QWERTY-raden ger kors- och b-förtecken (med luckor). Anpassa tangenttilldelningarna för tangentbordet med Ctrl+Esc. Tabb-tangenten slår av eller på ackordinmatning. Page Up börjar infoga noter en oktav högre och Page Down en oktav lägre. Använd tillsammans med rytminmatning för MIDI-in, som aktiveras i inställningarna."

#. from tp:denemo-2.6-rc2
msgid "Angry Delete MIDI Filter"
msgstr "Angry Delete MIDI-filter"

#. from tp:denemo-2.6-rc2
msgid "Angry Delete"
msgstr "Angry Delete"

#. from tp:denemo-2.6-rc2
msgid "MIDI notes struck loudly delete the previous note before taking effect."
msgstr "MIDI-noter som slås an högt raderar den föregående noten innan de får effekt."

#. from tp:denemo-2.6-rc2
msgid "No MIDI Filter"
msgstr "Inget MIDI-filter"

#. from tp:denemo-2.6-rc2
msgid "Chord entry without pedal"
msgstr "Ackordsinmatning utan pedal"

#. from tp:denemo-2.6-rc2
msgid "Chord Entry Without Pedal"
msgstr "Ackordsinmatning utan pedal"

#. from tp:denemo-2.6-rc2
msgid "Playing notes on the MIDI keyboard will enter all notes played as a chord until no notes are on."
msgstr "När du spelar noter på MIDI-tangentbordet anges alla spelade noter som ett ackord tills inga noter längre hålls nedtryckta."

#. from tp:denemo-2.6-rc2
msgid "This command expects you to play the notes of the current bar together with chords.\nIt will notate the chords in a new staff above the current staff. You can hold chords over several notes, change chords on one note.\nTo temporarily switch to listening so as to try out a chord depress the foot pedal.\nIt will play you two bars of the music at the start and after you have entered the chords.\nUse the pitch bend control to go on to the next bar or to try again in the current bar."
msgstr "Kommandot förutsätter att du spelar noterna i den aktuella takten tillsammans med ackord.\nAckorden noteras i ett nytt notsystem ovanför det aktuella. Du kan hålla ackord över flera noter och byta ackord på en not.\nTryck ned fotpedalen för att tillfälligt växla till lyssning och prova ett ackord.\nProgrammet spelar upp två takter av musiken i början och efter att du har angett ackorden.\nAnvänd Pitch Bend-kontrollen för att gå vidare till nästa takt eller försöka igen i den aktuella takten."

#. from tp:denemo-2.6-rc2
msgid "Chords for Bar"
msgstr "Ackord för takt"

#. from tp:denemo-2.6-rc2
msgid "Plays the context of the current bar. Then listens for you to play each note in current bar with added chord(s). As you do this it notates the chords on a staff above. When the bar is finished it re-plays the bar. Allows you to repeat (pitch bend down) or go on to next bar (pitch bend up)."
msgstr "Spelar sammanhanget för den aktuella takten. Lyssnar sedan medan du spelar varje not i takten med tillagda ackord och noterar ackorden i ett notsystem ovanför. När takten är klar spelas den upp igen. Du kan upprepa med Pitch Bend nedåt eller gå vidare till nästa takt med Pitch Bend uppåt."

#. from tp:denemo-2.6-rc2
msgid "Non Empty Chords staff"
msgstr "Ackordnotsystemet är inte tomt"

#. from tp:denemo-2.6-rc2
msgid "Remove the previous transcription from this measure on?"
msgstr "Ta bort den tidigare transkriptionen från den här takten?"

#. from tp:denemo-2.6-rc2
msgid "Create Chords Over Bass Line"
msgstr "Skapa ackord över baslinje"

#. from tp:denemo-2.6-rc2
msgid "Place the cursor on a bass note and invoke this command. It creates a treble staff above and for each note in the bass staff, as you play it, it switches to the treble staff and allows you to enter a chord. Use the Pitch Bend wheel to stop/start the process. Hold a chord while moving to the next bass note to extend the chord over more than one bass note."
msgstr "Placera markören på en basnot och anropa kommandot. Det skapar ett diskantnotsystem ovanför och växlar för varje not i basnotsystemet, när du spelar den, till diskantnotsystemet så att du kan ange ett ackord. Använd Pitch Bend-hjulet för att stoppa eller starta processen. Håll kvar ett ackord medan du går till nästa basnot för att förlänga det över fler basnoter."

#. from tp:denemo-2.6-rc2
msgid "Figured Bass Filter On"
msgstr "Figured Bass Filter On"

#. from tp:denemo-2.6-rc2
msgid "Start filtering MIDI events, First note is bass, hold this down while entering notes for figures. Pedal changes harmony on same bass."
msgstr "Börja filtrera MIDI-händelser. Första noten är basen; håll ned den medan du anger noter för siffrorna. Pedalen ändrar harmonin på samma bas."

#. from tp:denemo-2.6-rc2
msgid "Foot Pedal Conductor"
msgstr "Fotpedalsdirigent"

#. from tp:denemo-2.6-rc2
msgid "Press the foot pedal at the start of each measure. The bar number is displayed and the beats are interpolated following the timesignature set. Two quick presses of the foot pedal stops the conductor."
msgstr "Tryck på fotpedalen i början av varje takt. Taktnumret visas och taktslagen interpoleras enligt den angivna taktarten. Två snabba tryck på fotpedalen stoppar dirigenten."

#. from tp:denemo-2.6-rc2
msgid "No MIDI filter active"
msgstr "Inget MIDI-filter aktivt"

#. from tp:denemo-2.6-rc2
msgid "MIDI Filter Off"
msgstr "MIDI-filter av"

#. from tp:denemo-2.6-rc2
msgid "Turn off any MIDI filter script currently active."
msgstr "Stäng av alla MIDI-filterskript som är aktiva för tillfället."

#. from tp:denemo-2.6-rc2
msgid "Checking Chords Filter"
msgstr "Filter för kontroll av ackord"

#. from tp:denemo-2.6-rc2
msgid "Note played was "
msgstr "Spelad not var "

#. from tp:denemo-2.6-rc2
msgid "\nExpecting "
msgstr "\nFörväntar mig "

#. from tp:denemo-2.6-rc2
msgid "(one of)"
msgstr "(en av)"

#. from tp:denemo-2.6-rc2
msgid "\nPlease play "
msgstr "\nSpela "

#. from tp:denemo-2.6-rc2
msgid "entire chord:"
msgstr "hela ackordet:"

#. from tp:denemo-2.6-rc2
msgid "No active MIDI Filter"
msgstr "Inget aktivt MIDI-filter"

#. from tp:denemo-2.6-rc2
msgid "Check Chords (On/Off)"
msgstr "Kontrollera ackord (på/av)"

#. from tp:denemo-2.6-rc2
msgid "Advances through the current movement as you play the notes from all staffs that sound together, with the cursor moving on in the current staff. Playing a wrong note stops the cursor and the chord/notes have to be re-played correctly. If the current staff has a rest the cursor stops on the note before until you have played to the moment when it re-joins. You can reposition the cursor or edit the music (via the PC keyboard) while continuing with this mode - the checking resumes when you play the next note(s) in. You can arpeggiate the notes as convenient, no particular order is required as long as all the notes that start at the same moment are played before moving on."
msgstr "Förflyttar sig genom den aktuella rörelsen när du spelar tonerna från alla noter som låter tillsammans, med markören som rör sig vidare i den aktuella noten. Om du spelar en felaktig ton stoppas markören och ackordet/noderna måste spelas om på rätt sätt. Om det finns en paus i det aktuella notsystemet stannar markören på noten före tills du har spelat fram till det ögonblick då markören kommer tillbaka. Du kan flytta markören eller redigera musiken (via datorns tangentbord) medan du fortsätter med detta läge - kontrollen återupptas när du spelar nästa not/noter. Du kan arpeggiera noterna som det passar dig, ingen särskild ordning krävs så länge alla noter som börjar i samma ögonblick spelas innan du går vidare."

#. from tp:denemo-2.6-rc2
msgid "Toggle Listening/Editing"
msgstr "Växla mellan lyssning och redigering"

#. from tp:denemo-2.6-rc2
msgid "Switches between passing MIDI input directly to output or to Denemo. Use this instead of CapsLock to avoid altering keyboard shortcuts involving the Shift key when editing and listening."
msgstr "Växlar mellan att skicka MIDI-indata direkt till utdata eller till Denemo. Använd detta i stället för Caps Lock för att undvika att ändra tangentbordsgenvägar som använder Skift när du redigerar och lyssnar."

#. from tp:denemo-2.6-rc2
msgid "Mouse Default Action"
msgstr "Musens standardåtgärd"

#. from tp:denemo-2.6-rc2
msgid "Mouse left click positions the cursor, right click edits, left-click with caps-lock does nothing.."
msgstr "Vänsterklick placerar markören, högerklick redigerar och vänsterklick med Caps Lock gör ingenting."

#. from tp:denemo-2.6-rc2
msgid "To insert notes hold down Shift key while left-clicking the mouse. To add to a chord hold down Shift and Alt, to delete hold down Control.\n    Or use keys a,b,c,d,e,f,g, 0,1,2,3,4 (with Shift, Control or Alt).\n    Or use palettes. To hide palettes right-click on a button and choose Edit Palette (saves space).\n    To cut out excessive messages like this use Help menu ->Turn Excessive Tooltips Off/On."
msgstr "För att infoga noter håller du ned Shift-tangenten medan du vänsterklickar med musen. För att lägga till i ett ackord håller du ned Shift och Alt, för att ta bort håller du ned Control.\n    Eller använd tangenterna a,b,c,d,e,f,g, 0,1,2,3,4 (med Shift, Control eller Alt).\n    Eller använd paletter. För att dölja paletter högerklickar du på en knapp och väljer Redigera palett (sparar utrymme).\n    Om du vill slippa överdrivna meddelanden som detta använder du Hjälp-menyn -> Slå av/på överdrivna verktygstips."

#. from tp:denemo-2.6-rc2
msgid "Mouse Note Insertion"
msgstr "Infoga noter med musen"

#. from tp:denemo-2.6-rc2
msgid "Changes the mouse use when CapsLock is on: left click inserts note in the prevailing duration. The shortcuts for number keys 0, 1, 2 ... are set to change the prevailing duration."
msgstr "Ändrar musanvändningen när Caps Lock är aktiverat: vänsterklick infogar en not med aktuell längd. Tangentbordsgenvägarna för 0, 1, 2 … ställs in för att ändra aktuell längd."

#. from tp:denemo-2.6-rc2
msgid "On-screen Piano Keyboard"
msgstr "Pianotangentbord på skärmen"

#. from tp:denemo-2.6-rc2
msgid "Displays a piano-style keyboard that can be clicked on to enter notes. Right click adds notes to the chord. Unlike a MIDI keyboard it doesn't pass through MIDI filters, etc."
msgstr "Visar ett pianotangentbord på skärmen som du kan klicka på för att ange noter. Högerklick lägger till noter i ackordet. Till skillnad från ett MIDI-tangentbord passerar det inte genom MIDI-filter osv."

#. from tp:denemo-2.6-rc2
msgid "Load Default Composer Number Keys"
msgstr "Ladda standardkompositörens nummerknappar"

#. from tp:denemo-2.6-rc2
msgid "Loads the default composer numberkeys (Notes and Rests)"
msgstr "Läser in standardkompositörens siffertangenter (noter och pauser)"

#. from tp:denemo-2.6-rc2
msgid "Change to 'Select Duration' Number Keys in Composer Mode"
msgstr "Ändra till \"Välj varaktighet\"-nummertangenter i kompositörsläge"

#. from tp:denemo-2.6-rc2
msgid "Change the number keys to select the prevailing duration in composer mode."
msgstr "Använd siffertangenterna för att välja den rådande varaktigheten i composer-läget."

#. from tp:denemo-2.6-rc2
msgid "NoOp"
msgstr "NoOp"

#. from tp:denemo-2.6-rc2
msgid "Does absolutely nothing. Use to \"blank\" a key."
msgstr "Gör absolut ingenting. Använd för att ”tömma” en tangent."

#. from tp:denemo-2.6-rc2
msgid "OpEight"
msgstr "OpEight"

#. from tp:denemo-2.6-rc2
msgid "Wrapper/Dummy for Keypress"
msgstr "Omslag/dummy för tangenttryckning"

#. from tp:denemo-2.6-rc2
msgid "OpFive"
msgstr "OpFive"

#. from tp:denemo-2.6-rc2
msgid "OpFour"
msgstr "OpFour"

#. from tp:denemo-2.6-rc2
msgid "OpNine"
msgstr "OpNine"

#. from tp:denemo-2.6-rc2
msgid "OpOne"
msgstr "OpOne"

#. from tp:denemo-2.6-rc2
msgid "OpSeven"
msgstr "OpSeven"

#. from tp:denemo-2.6-rc2
msgid "OpSix"
msgstr "OpSix"

#. from tp:denemo-2.6-rc2
msgid "OpThree"
msgstr "OpThree"

#. from tp:denemo-2.6-rc2
msgid "OpTwo"
msgstr "OpTwo"

#. from tp:denemo-2.6-rc2
msgid "OpZero"
msgstr "OpZero"

#. from tp:denemo-2.6-rc2
msgid "Add Named Bookmark"
msgstr "Lägg till namngivet bokmärke"

#. from tp:denemo-2.6-rc2
msgid "Adds a Denemo bookmark combined with a custom Lilypond Rehearsal Mark"
msgstr "Lägger till ett Denemo-bokmärke tillsammans med ett anpassat repetitionsmärke i LilyPond"

#. from tp:denemo-2.6-rc2
msgid "Insert Non-printing Rehearsal Mark"
msgstr "Infoga icke-tryckande repetitionsmärke"

#. from tp:denemo-2.6-rc2
msgid "Give a name "
msgstr "Ge ett namn "

#. from tp:denemo-2.6-rc2
msgid "Add Non-Printing Bookmark"
msgstr "Lägg till bokmärke som inte skrivs ut"

#. from tp:denemo-2.6-rc2
msgid "Adds a custom Denemo bookmark without Lilypond output."
msgstr "Lägger till ett anpassat Denemo-bokmärke utan LilyPond-utdata."

#. from tp:denemo-2.6-rc2
msgid "Next Bookmark"
msgstr "Nästa bokmärke"

#. from tp:denemo-2.6-rc2
msgid "Seach forward for bookmarks in the current staff."
msgstr "Sök framåt efter bokmärken i det aktuella notsystemet."

#. from tp:denemo-2.6-rc2
msgid "No more positions are stored"
msgstr "Inga fler positioner är lagrade"

#. from tp:denemo-2.6-rc2
msgid "Move to Stored Position"
msgstr "Flytta till lagrad position"

#. from tp:denemo-2.6-rc2
msgid "Moves the cursor to the last stored position. You can store a sequence of positions and then return to them in one by one (a stack of positions)."
msgstr "Flyttar markören till den senast lagrade positionen. Du kan lagra en sekvens av positioner och sedan återgå till dem en efter en (en stapel av positioner)."

#. from tp:denemo-2.6-rc2
msgid "Prev Bookmark"
msgstr "Föregående bokmärke"

#. from tp:denemo-2.6-rc2
msgid "Seach backward for bookmarks in the current staff."
msgstr "Sök bakåt efter bokmärken i det aktuella notsystemet."

#. from tp:denemo-2.6-rc2
msgid "Store Position"
msgstr "Spara position"

#. from tp:denemo-2.6-rc2
msgid "Stores the current cursor position for returning to later."
msgstr "Sparar den aktuella markörpositionen så att du kan återgå till den senare."

#. from tp:denemo-2.6-rc2
msgid "Add Rehearsal/Bookmark"
msgstr "Lägg till repetition/bokmärke"

#. from tp:denemo-2.6-rc2
msgid "Adds a Denemo bookmark combined with a default Rehearsal Mark"
msgstr "Lägger till ett Denemo-bokmärke kombinerat med ett standard-repetitionsmärke"

#. from tp:denemo-2.6-rc2
msgid "Search Bookmark"
msgstr "Sök bokmärke"

#. from tp:denemo-2.6-rc2
msgid "Searches for a named Bookmark in the current staff."
msgstr "Söker efter ett namngivet bokmärke i det aktuella notsystemet."

#. from tp:denemo-2.6-rc2
msgid "Cursor to Highest Note"
msgstr "Cursor till högsta not"

#. from tp:denemo-2.6-rc2
msgid "Moves the cursor to the highest note on current horizontal position (in a chord or on a single note)"
msgstr "Flyttar markören till den högsta noten på den aktuella horisontella positionen (i ett ackord eller på en enskild not)"

#. from tp:denemo-2.6-rc2
msgid "Cursor to Lowest Note"
msgstr "Cursor till lägsta not"

#. from tp:denemo-2.6-rc2
msgid "Moves the cursor to the lowest note on current horizontal position (in a chord or on a single note)"
msgstr "Flyttar markören till den lägsta noten på den aktuella horisontella positionen (i ett ackord eller på en enstaka not)"

#. from tp:denemo-2.6-rc2
msgid "Give destination: "
msgstr "Ge destination: "

#. from tp:denemo-2.6-rc2
msgid "Go To Typeset Measure Number"
msgstr "Gå till typsatt taktnummer"

#. from tp:denemo-2.6-rc2
msgid "Goes to the measure number given taking into account any measure offset (normally this will be set to be the measure number as typeset)."
msgstr "Går till det angivna taktnumret och tar hänsyn till eventuell taktförskjutning. Normalt är detta inställt på det taktnummer som typsätts."

#. from tp:denemo-2.6-rc2
msgid "Moves cursor down an octave."
msgstr "Flyttar markören en oktav nedåt."

#. from tp:denemo-2.6-rc2
msgid "JumpLeft"
msgstr "Hoppa vänster"

#. from tp:denemo-2.6-rc2
msgid "Jumps to beginning of this measure or previous measure."
msgstr "Hoppar till början av denna eller föregående takt."

#. from tp:denemo-2.6-rc2
msgid "JumpRight"
msgstr "Hoppa höger"

#. from tp:denemo-2.6-rc2
msgid "Moves cursor to start of next bar or to end."
msgstr "Flyttar markören till början av nästa takt eller till slutet."

#. from tp:denemo-2.6-rc2
msgid "Moves cursor up one octave."
msgstr "Flyttar markören uppåt en oktav."

#. from tp:denemo-2.6-rc2
msgid "Move To Movement Beginning"
msgstr "Flytta till början av satsen"

#. from tp:denemo-2.6-rc2
msgid "Moves the cursor to the beginning of the movement without altering the selection"
msgstr "Flyttar markören till början av satsen utan att ändra markeringen."

#. from tp:denemo-2.6-rc2
msgid "Move To Movement End"
msgstr "Flytta till slutet av satsen"

#. from tp:denemo-2.6-rc2
msgid "Move the cursor to last measure, last staff without altering the selection."
msgstr "Flyttar markören till sista takten i sista notsystemet utan att ändra markeringen."

#. from tp:denemo-2.6-rc2
msgid "Move to Staff Down, Appending"
msgstr "Flytta till notsystemet nedanför, lägg till"

#. from tp:denemo-2.6-rc2
msgid "Moves to the appending position in the staff below."
msgstr "Flyttar till tilläggspositionen i notsystemet nedanför."

#. from tp:denemo-2.6-rc2
msgid "Move to Staff Up, Appending"
msgstr "Flytta till notsystemet ovanför, lägg till"

#. from tp:denemo-2.6-rc2
msgid "Moves to the appending position in the staff above."
msgstr "Flyttar till tilläggspositionen i notsystemet ovanför."

#. from tp:denemo-2.6-rc2
msgid "Cursor To Next Note"
msgstr "Cursor till nästa not"

#. from tp:denemo-2.6-rc2
msgid "Moves to the next note, topping at blank measures. Sounds a warning if no more notes."
msgstr "Går vidare till nästa not och stannar vid tomma takter. Låter en varning om det inte finns fler noter."

#. from tp:denemo-2.6-rc2
msgid "Move to Visible Staff Down"
msgstr "Flytta till synligt notsystem nedanför"

#. from tp:denemo-2.6-rc2
msgid "Moves to the next staff or voice down skipping ones that are hidden in the display."
msgstr "Flyttar till nästa not eller röst nedåt och hoppar över dem som är dolda i displayen."

#. from tp:denemo-2.6-rc2
msgid "Move to Visible Staff Up"
msgstr "Flytta till synligt notsystem ovanför"

#. from tp:denemo-2.6-rc2
msgid "Moves to the next staff or voice up skipping ones that are hidden in the display."
msgstr "Flyttar till nästa notsystem eller stämma uppåt och hoppar över dem som är dolda i visningen."

#. from tp:denemo-2.6-rc2
msgid "Next Staff, Wrapping"
msgstr "Nästa notsystem, återgå"

#. from tp:denemo-2.6-rc2
msgid "Moves to the next staff, wrapping to the first staff when on the last staff."
msgstr "Flyttar till nästa notsystem och återgår till det första när markören är i det sista."

#. from tp:denemo-2.6-rc2
msgid "The cursor is "
msgstr "Markören är "

#. from tp:denemo-2.6-rc2
msgid "There is no link before this bar in this staff, open the source document and click on it to place one."
msgstr "Det finns ingen länk före denna stapel i den här staven, öppna källdokumentet och klicka på det för att placera en."

#. from tp:denemo-2.6-rc2
msgid "Follow Link to Source"
msgstr "Följ länk till källa"

#. from tp:denemo-2.6-rc2
msgid "Follows the link at or before the cursor to a source document."
msgstr "Följer länken vid eller före markören till ett källdokument."

#. from tp:denemo-2.6-rc2
msgid "Cursor to Marked Onset"
msgstr "Markör till markerad startpunkt"

#. from tp:denemo-2.6-rc2
msgid "Moves the Denemo cursor to the note to which the marked MIDI note onset belongs."
msgstr "Flyttar Denemo-markören till den not som den markerade MIDI-notstarten hör till."

#. from tp:denemo-2.6-rc2
msgid "No MIDI file has been loaded"
msgstr "Ingen MIDI-fil har laddats"

#. from tp:denemo-2.6-rc2
msgid "First Note Onset"
msgstr "Första anteckningens början"

#. from tp:denemo-2.6-rc2
msgid "The first recorded or imported MIDI note onset in the current track becomes marked so that entered durations will be given its pitch."
msgstr "Den första inspelade eller importerade MIDI-notens början i det aktuella spåret markeras så att inmatade durationer får dess tonhöjd."

#. from tp:denemo-2.6-rc2
msgid "No Onset has been marked"
msgstr "Ingen Onset har markerats"

#. from tp:denemo-2.6-rc2
msgid "Next Note Onset"
msgstr "Nästa anmärkning Onset"

#. from tp:denemo-2.6-rc2
msgid "Moves to the next MIDI note onset in the current recorded or imported MIDI track. Inserted durations will take their pitch from this note."
msgstr "Flyttar till nästa MIDI-notstart i det aktuella inspelade eller importerade MIDI-spåret. Inlagda varaktigheter får sin pitch från denna not."

#. from tp:denemo-2.6-rc2
msgid "Previous Note Onset"
msgstr "Tidigare anmärkning Onset"

#. from tp:denemo-2.6-rc2
msgid "Moves the marked MIDI note onset to the one before the current one."
msgstr "Flyttar den markerade MIDI-nodens början till den som ligger före den aktuella."

#. from tp:denemo-2.6-rc2
msgid "Un-mark Note Onsets"
msgstr "Un-mark Note Onsets"

#. from tp:denemo-2.6-rc2
msgid "Removes the mark from the MIDI note onset, so that inserting durations have their normal meaning."
msgstr "Tar bort markeringen från MIDI-nodens startpunkt, så att durationer som infogas får sin normala betydelse."

#. from tp:denemo-2.6-rc2
msgid "Move Display Right"
msgstr "Flytta displayen till höger"

#. from tp:denemo-2.6-rc2
msgid "Moves the view port (the Denemo Display) to the left, leaving the cursor on the same object as long as it is still in view."
msgstr "Flyttar visningsporten (Denemo Display) åt vänster och låter markören stå kvar på samma objekt så länge som det fortfarande syns."

#. from tp:denemo-2.6-rc2
msgid "Moves the view port (the Denemo Display) to the right, leaving the cursor on the same object as long as it is still in view."
msgstr "Flyttar visningsporten (Denemo Display) till höger och låter markören stå kvar på samma objekt så länge som det fortfarande syns."

#. from tp:denemo-2.6-rc2
msgid "Find Edit Point"
msgstr "Hitta redigeringspunkt"

#. from tp:denemo-2.6-rc2
msgid "Searches backward for the start of non-printing notes."
msgstr "Söker bakåt efter början på noter som inte skrivs ut."

#. from tp:denemo-2.6-rc2
msgid "Next Lower"
msgstr "Nästa lägre"

#. from tp:denemo-2.6-rc2
msgid "Moves cursor to next note that is lower than the cursor."
msgstr "Flyttar markören till nästa not som är lägre än markören."

#. from tp:denemo-2.6-rc2
msgid "Find Next Similar"
msgstr "Hitta nästa liknande"

#. from tp:denemo-2.6-rc2
msgid "Finds the next object similar to the one at the cursor."
msgstr "Hittar nästa objekt som liknar det som finns vid markören."

#. from tp:denemo-2.6-rc2
msgid "Find Note"
msgstr "Hitta not"

#. from tp:denemo-2.6-rc2
msgid "Moves the cursor forward until it is on the note given by the user."
msgstr "Flyttar markören framåt tills den befinner sig på den not som användaren har angett."

#. from tp:denemo-2.6-rc2
msgid "Go To Next Empty Measure"
msgstr "Gå till nästa tomhetsmått"

#. from tp:denemo-2.6-rc2
msgid "Move cursor to the next point in the current staff where the music ends."
msgstr "Flytta markören till nästa punkt i det aktuella notsystemet där musiken slutar."

#. from tp:denemo-2.6-rc2
msgid "Go To End of Measure"
msgstr "Gå till slutet av åtgärden"

#. from tp:denemo-2.6-rc2
msgid "Move to Earliest Empty Measure"
msgstr "Flytta till tidigaste tomma mätning"

#. from tp:denemo-2.6-rc2
msgid "Moves the cursor back until the a non-empty measure is found. Stops in the empty measure after that."
msgstr "Flyttar markören bakåt tills ett mått som inte är tomt hittas. Stannar i det tomma måttet efter det."

#. from tp:denemo-2.6-rc2
msgid "Move To Previous Empty Measure"
msgstr "Flytta till föregående tomma mått"

#. from tp:denemo-2.6-rc2
msgid "Move the cursor left until it finds an empty measure or the staffs beginning"
msgstr "Flytta markören åt vänster tills den hittar en tom takt eller notsystemets början"

#. from tp:denemo-2.6-rc2
msgid "Next Higher"
msgstr "Nästa högre"

#. from tp:denemo-2.6-rc2
msgid "Move cursor to next note higher than cursor position"
msgstr "Flytta markören till nästa not som är högre än markörens position"

#. from tp:denemo-2.6-rc2
msgid "New search music from selection"
msgstr "Ny sökmusik från urval"

#. from tp:denemo-2.6-rc2
msgid "Resume previous music search"
msgstr "Återuppta tidigare musiksökning"

#. from tp:denemo-2.6-rc2
msgid "Make a selection to search for"
msgstr "Gör ett urval för att söka efter"

#. from tp:denemo-2.6-rc2
msgid "Wrap to start of staff"
msgstr "Omslag till början av staven"

#. from tp:denemo-2.6-rc2
msgid "Wrap to next staff"
msgstr "Omslag till nästa notsystem"

#. from tp:denemo-2.6-rc2
msgid "Search Note Sequence"
msgstr "Sök notsekvens"

#. from tp:denemo-2.6-rc2
msgid "With a selection, searches from the cursor for the next occurrence of the notes of the selection. With no selection, continues the previous search. When a match (ignoring rests and duration) is found it offers to continue, stop or execute the script in the Scheme Window."
msgstr "Med ett val, söker från markören efter nästa förekomst av noterna i valet. Utan val fortsätter den föregående sökningen. När en matchning (utan hänsyn till pauser och varaktighet) hittas erbjuder den att fortsätta, stoppa eller exekvera skriptet i Scheme Window."

#. from tp:denemo-2.6-rc2
msgid "New search pattern from selection"
msgstr "Nytt sökmönster från urval"

#. from tp:denemo-2.6-rc2
msgid "Resume previous search"
msgstr "Återuppta tidigare sökning"

#. from tp:denemo-2.6-rc2
msgid "Search Rhythmic Pattern"
msgstr "Sök rytmiskt mönster"

#. from tp:denemo-2.6-rc2
msgid "With a selection, searches from the cursor for the next occurrence of the rhythmic patterm of the selection. With no selection, continues the previous search. When a match is found it offers to continue, stop or execute the script in the Scheme Window."
msgstr "Med ett val, söker från markören efter nästa förekomst av det rytmiska mönstret för valet. Om inget val görs, fortsätter den föregående sökningen. När en matchning hittas erbjuds att fortsätta, stoppa eller exekvera skriptet i Scheme Window."

#. from tp:denemo-2.6-rc2
msgid "Search locations in all staffs"
msgstr "Sökplatser i alla staber"

#. from tp:denemo-2.6-rc2
msgid "Search in only in staff"
msgstr "Sök i endast i notsystem"

#. from tp:denemo-2.6-rc2
msgid "Choose where to search"
msgstr "Välj var du vill söka"

#. from tp:denemo-2.6-rc2
msgid "Key Signature Changes"
msgstr "Ändringar av nyckelsignatur"

#. from tp:denemo-2.6-rc2
msgid "Time Signature Changes"
msgstr "Förändringar i tidssignatur"

#. from tp:denemo-2.6-rc2
msgid "Changes of Clef"
msgstr "Förändringar av klav"

#. from tp:denemo-2.6-rc2
msgid "Notes Higher Than Note"
msgstr "Noter Högre än not"

#. from tp:denemo-2.6-rc2
msgid "Notes Lower Than Note"
msgstr "Noter lägre än not"

#. from tp:denemo-2.6-rc2
msgid "Denemo Directives tagged"
msgstr "Denemo Direktiv taggade"

#. from tp:denemo-2.6-rc2
msgid "Note lower than"
msgstr "Not lägre än"

#. from tp:denemo-2.6-rc2
msgid "Note higher than"
msgstr "Not högre än"

#. from tp:denemo-2.6-rc2
msgid "Key Changes"
msgstr "Viktiga förändringar"

#. from tp:denemo-2.6-rc2
msgid "Clef Changes"
msgstr "Klavändringar"

#. from tp:denemo-2.6-rc2
msgid "You need a Scheme expression Scheme Script window\nto use this option\nLocations where the expression evaluates are true will be found."
msgstr "Du behöver ett Scheme-uttryck i fönstret Scheme-skript\nför att använda alternativet.\nPlatser där uttrycket utvärderas till sant hittas."

#. from tp:denemo-2.6-rc2
msgid "Install a template script in the Scheme Script window"
msgstr "Installera ett mallskript i fönstret Scheme-skript"

#. from tp:denemo-2.6-rc2
msgid "Seek Locations"
msgstr "Sök efter platser"

#. from tp:denemo-2.6-rc2
msgid "Open View->Scheme Script to edit the script to test for the locations you want to find"
msgstr "Öppna Visa → Scheme-skript för att redigera skriptet som testar platserna du vill hitta"

#. from tp:denemo-2.6-rc2
msgid "No locations found"
msgstr "Inga platser hittades"

#. from tp:denemo-2.6-rc2
msgid "Choose a location to go to (Movement, Staff, Measure, Object) and click OK"
msgstr "Välj en plats att gå till (sats, notsystem, takt, objekt) och klicka på OK"

#. from tp:denemo-2.6-rc2
msgid "Seek for locations in the score satisfying a certain condition e.g. exceeding a range or at a clef change etc. A list of such locations is created which can be selected from. Repeating the command after choosing one location re-presents the remainder of the list."
msgstr "Sök efter platser i partituret som uppfyller ett visst villkor, till exempel som överskrider ett omfång eller vid en klavändring. En lista med sådana platser skapas som du kan välja från. Om du upprepar kommandot efter att ha valt en plats visas resten av listan igen."

#. from tp:denemo-2.6-rc2
msgid "Convert MIDI Chords Over Bass"
msgstr "Konvertera MIDI-ackord över bas"

#. from tp:denemo-2.6-rc2
msgid "Takes a MIDI recording over a bass line and inserts the chords by matching the bass notes. Each chord must include the bass note."
msgstr "Tar en MIDI-inspelning över en baslinje och infogar ackorden genom att matcha basnoterna. Varje ackord måste innehålla basnoten."

#. from tp:denemo-2.6-rc2
msgid "Play from Cursor to End"
msgstr "Spela från markören till slutet"

#. from tp:denemo-2.6-rc2
msgid "Playback all staffs from the current cursor position to the end of the movement."
msgstr "Spela upp alla notsystem från markörens position till slutet av satsen."

#. from tp:denemo-2.6-rc2
msgid "No fine found, assuming all"
msgstr "Ingen fine hittades, antar alla"

#. from tp:denemo-2.6-rc2
msgid "Dal Segno with no Segno - assuming Da Capo"
msgstr "Dal segno utan segno – antar da capo"

#. from tp:denemo-2.6-rc2
msgid "Performance (Start/Stop)"
msgstr "Uppspelning (start/stopp)"

#. from tp:denemo-2.6-rc2
msgid "Plays the current movement, observing repeats, Da Capo, fine and Dal Segno. If playing stops the performance"
msgstr "Spelar den aktuella satsen och följer upprepningar, da capo, fine och dal segno. Stoppar uppspelningen om den redan pågår."

#. from tp:denemo-2.6-rc2
msgid "Pitch Change"
msgstr "Ändra tonhöjd"

#. from tp:denemo-2.6-rc2
msgid "Give amount =/-"
msgstr "Ange värde =/-"

#. from tp:denemo-2.6-rc2
msgid "Shift Pitch"
msgstr "Förskjut tonhöjd"

#. from tp:denemo-2.6-rc2
msgid "Outputs a pitch bend signal to the synthesizer for the value +/- 64 given."
msgstr "Skickar en Pitch Bend-signal till syntetisatorn för det angivna värdet ±64."

#. from tp:denemo-2.6-rc2
msgid "Play Music at Cursor"
msgstr "Spela musik vid markören"

#. from tp:denemo-2.6-rc2
msgid "Plays the score for the duration of the note/chord at the cursor, starting at that note."
msgstr "Spelar upp partituret under den tid som noten/ackordet vid markören varar, med början vid den noten."

#. from tp:denemo-2.6-rc2
msgid "Play All"
msgstr "Spela alla"

#. from tp:denemo-2.6-rc2
msgid "Plays the current movement from the start, observing any mute objects placed in the staffs."
msgstr "Spelar den aktuella satsen från början och tar hänsyn till eventuella dämpningsobjekt i notsystemen."

#. from tp:denemo-2.6-rc2
msgid "Playback and Record MIDI (Off/On)"
msgstr "Spela upp och spela in MIDI (av/på)"

#. from tp:denemo-2.6-rc2
msgid "Starts (or stops) playing the score from the playhead start (green marker bar) and simultaneously records your playing from MIDI in. You can stop the playback at any time and then the first MIDI note you entered is marked. Entering duration keys now enters the notes you played into the score. If you have no click track at the top one is created - set the keysignature/enharmonic range before you start."
msgstr "Startar eller stoppar uppspelningen av partituret från uppspelningshuvudets startpunkt (grön markör) och spelar samtidigt in ditt MIDI-spel. Du kan när som helst stoppa uppspelningen; då markeras den första MIDI-not du spelade. När du nu anger längdtangenter infogas de spelade noterna i partituret. Om det inte finns något klickspår överst skapas ett. Ange tonart och enharmoniskt omfång före start."

#. from tp:denemo-2.6-rc2
msgid "Play Chord at Cursor"
msgstr "Spela ackord med markören"

#. from tp:denemo-2.6-rc2
msgid "Sounds the note or chord at the cursor, using the current staffs instrument."
msgstr "Låter noten eller ackordet vid markören, med hjälp av det aktuella notinstrumentet."

#. from tp:denemo-2.6-rc2
msgid "Please turn continuous typsetting off first"
msgstr "Stäng av kontinuerlig typsättning först"

#. from tp:denemo-2.6-rc2
msgid "You should typeset this movement first in the Print View, otherwise positioning may not work."
msgstr "Du bör sätta denna rörelse först i utskriftsvyn, annars kanske positioneringen inte fungerar."

#. from tp:denemo-2.6-rc2
msgid "Displays the music fully typeset on one long page (the Playback View). Click on a note to play from there or drag to loop play."
msgstr "Visar musiken helt typsatt på en lång sida (uppspelningsvyn). Klicka på en not för att spela därifrån eller dra för att spela i slinga."

#. from tp:denemo-2.6-rc2
msgid "Play/Pause"
msgstr "Spela/pausa"

#. from tp:denemo-2.6-rc2
msgid "Plays from the playback start marker in the current movement or Pauses if playing"
msgstr "Spelar från uppspelningens startmarkör i den aktuella rörelsen eller Pausar om uppspelningen"

#. from tp:denemo-2.6-rc2
msgid "Time at Denemo Cursor "
msgstr "Tid vid Denemo-markör "

#. from tp:denemo-2.6-rc2
msgid "Time at Marked MIDI note "
msgstr "Tid vid markerad MIDI-not "

#. from tp:denemo-2.6-rc2
msgid "Move the Denemo Cursor to another position and click on the MIDI note that should appear at that position\nAnd then re-execute this command."
msgstr "Flytta Denemo-markören till en annan position och klicka på MIDI-noten som ska visas där.\nKör sedan kommandot igen."

#. from tp:denemo-2.6-rc2
msgid "Re-scaling out of range"
msgstr "Omskalning utanför omfånget"

#. from tp:denemo-2.6-rc2
msgid "Wrongly ordered adjustement points"
msgstr "Felordnade justeringspunkter"

#. from tp:denemo-2.6-rc2
msgid "Adjust Tempo to Recording"
msgstr "Anpassa tempot till inspelningen"

#. from tp:denemo-2.6-rc2
msgid "Adjusts the movement tempo to match the tempo of the MIDI recording. You have to designate two places to be synchronized."
msgstr "Justerar rörelsens tempo så att det stämmer överens med MIDI-inspelningens tempo. Du måste ange två platser som ska synkroniseras."

#. from tp:denemo-2.6-rc2
msgid "Plays the audio attached to the current movement. Use File-&gt;Open Audio to attach audio."
msgstr "Spelar upp ljudet som är kopplat till den aktuella rörelsen. Använd Arkiv-&gt;Öppna ljud för att bifoga ljud."

#. from tp:denemo-2.6-rc2
msgid "Delete Audio Recording"
msgstr "Radera ljudinspelning"

#. from tp:denemo-2.6-rc2
msgid "Deletes the current audio recording."
msgstr "Raderar den aktuella ljudinspelningen."

#. from tp:denemo-2.6-rc2
msgid "Play music you want to insert next\nThen re-issue this command."
msgstr "Spela musiken du vill infoga härnäst.\nKör sedan kommandot igen."

#. from tp:denemo-2.6-rc2
msgid "Now the music is attached to the score starting at the cursor position.\nThe timing of the notes is shown at the top of the score.\nYou can drag the timing of start of the music by left-clicking above the blue line.\nYou can insert the rhythm in your staff and check by invoking Play.\nWhen that's correct, press the Shift key to switch to Inserting/Appending Pitches and play in the music again."
msgstr "Nu är musiken kopplad till partituret från markörens position.\nNoternas tidpunkter visas högst upp i partituret.\nDu kan dra musikens starttid genom att vänsterklicka ovanför den blå linjen.\nDu kan infoga rytmen i notsystemet och kontrollera med Spela.\nNär det är korrekt trycker du på Skift för att växla till infogning eller tillägg av tonhöjder och spelar musiken igen."

#. from tp:denemo-2.6-rc2
msgid "Record (Start/Stop) and Attach at Cursor"
msgstr "Spela in (start/stopp) och koppla vid markören"

#. from tp:denemo-2.6-rc2
msgid "The first invocation of this command starts recording - play the melody you want to notate. Then invoke the command again to stop the recording - the audio is attached to an (optional) click track created at the top of the staffs. The recording will play along with your notated music - ensure you have enough filled measures after the cursor to attach the audio to otherwise it won't play."
msgstr "Den första anropningen av detta kommando startar inspelningen - spela den melodi du vill notera. Anropa sedan kommandot igen för att stoppa inspelningen - ljudet kopplas till ett (valfritt) klickspår som skapas högst upp i notsystemet. Inspelningen spelas upp tillsammans med din noterade musik - se till att du har tillräckligt många fyllda takter efter markören för att koppla ljudet till, annars spelas det inte upp."

#. from tp:denemo-2.6-rc2
msgid "Save Recording"
msgstr "Spara inspelning"

#. from tp:denemo-2.6-rc2
msgid "Saves the recorded autio to disk."
msgstr "Sparar inspelat ljud på disken."

#. from tp:denemo-2.6-rc2
msgid "Synchronize Audio"
msgstr "Synkronisera ljud"

#. from tp:denemo-2.6-rc2
msgid "Plays the audio attached to the current movement. Creates a timing bar for each space bar press. Music written in the staffs below will synchronize with the audio."
msgstr "Spelar upp ljudet som är kopplat till den aktuella rörelsen. Skapar en tidslinje för varje tryck på mellanslagstangenten. Musik skriven i nedanstående notsystem kommer att synkroniseras med ljudet."

#. from tp:denemo-2.6-rc2
msgid "Record (Start/Stop)"
msgstr "Spela in (start/stopp)"

#. from tp:denemo-2.6-rc2
msgid "Starts/Stops recording the audio output from Denemo."
msgstr "Startar eller stoppar inspelningen av ljudutdata från Denemo."

#. from tp:denemo-2.6-rc2
msgid "Backup and Play Marked MIDI Note."
msgstr "Säkerhetskopiera och spela markerad MIDI-not."

#. from tp:denemo-2.6-rc2
msgid "Moves the marked MIDI note one note earlier and plays that."
msgstr "Flyttar den markerade MIDI-noten en not bakåt och spelar den."

#. from tp:denemo-2.6-rc2
msgid "Delete Last Recorded Note"
msgstr "Radera senast inspelade not"

#. from tp:denemo-2.6-rc2
msgid "Plays the last recorded note, deletes it and marks the new last note."
msgstr "Spelar upp den senast inspelade noten, raderar den och markerar den nya sista noten."

#. from tp:denemo-2.6-rc2
msgid "Delete Recorded MIDI and Click Track"
msgstr "Ta bort inspelat MIDI- och klickspår"

#. from tp:denemo-2.6-rc2
msgid "Deletes the MIDI recording and the click track that shows it and any trailing blank measures."
msgstr "Raderar MIDI-inspelningen, klickspåret som visar den och eventuella efterföljande tomma takter."

#. from tp:denemo-2.6-rc2
msgid "Delete Imported/Recorded Midi"
msgstr "Radera importerad/inspelad MIDI"

#. from tp:denemo-2.6-rc2
msgid "Deletes the MIDI that has been imported or recorded via MIDI in."
msgstr "Raderar MIDI som har importerats eller spelats in via MIDI-in."

#. from tp:denemo-2.6-rc2
msgid "Play and Advance Marked Midi Note"
msgstr "Spela och gå vidare med markerad MIDI-not"

#. from tp:denemo-2.6-rc2
msgid "Plays the marked recorded MIDI note and advances the mark."
msgstr "Spelar den markerade inspelade MIDI-noten och flyttar fram markeringen."

#. from tp:denemo-2.6-rc2
msgid "Play Recorded MIDI (Off/On)"
msgstr "Spela upp inspelad MIDI (av/på)"

#. from tp:denemo-2.6-rc2
msgid "Plays the recorded MIDI track from the marked MIDI note or beginning if no note is marked. Stops playing if already playing MIDI track."
msgstr "Spelar upp det inspelade MIDI-spåret från den markerade MIDI-noten eller från början om ingen not är markerad. Stoppar uppspelningen om MIDI-spåret redan spelas."

#. from tp:denemo-2.6-rc2
msgid "Record from MIDI in (Off/On)"
msgstr "Spela in från MIDI-in (av/på)"

#. from tp:denemo-2.6-rc2
msgid "Records/Stops recording notes played on MIDI keyboard. Notes are recorded on a track above a click track staff at the top of the score. Insert the notes into the score by pressing duration keys/Ins key."
msgstr "Spelar in eller stoppar inspelning av noter som spelas på MIDI-tangentbordet. Noterna spelas in på ett spår ovanför ett klickspår högst upp i partituret. Infoga noterna i partituret med längdtangenterna eller Insert-tangenten."

#. from tp:denemo-2.6-rc2
msgid "Repositioning Marked MIDI Note"
msgstr "Omplacering av markerad MIDI-not"

#. from tp:denemo-2.6-rc2
msgid "Give interval back from end (seconds):"
msgstr "Ange intervall bakåt från slutet (sekunder):"

#. from tp:denemo-2.6-rc2
msgid "Reposition Relative to End"
msgstr "Flytta i förhållande till slutet"

#. from tp:denemo-2.6-rc2
msgid "Asks for a number of seconds back from the end of the recording which you want to synchronize with the Denemo Cursor. Use this to find and position a passage you have just recorded ready for transcribing."
msgstr "Frågar efter ett antal sekunder tillbaka från slutet av inspelningen som du vill synkronisera med Denemo Cursor. Använd detta för att hitta och positionera en passage som du just har spelat in och som är redo för transkribering."

#. from tp:denemo-2.6-rc2
msgid "No Recorded MIDI note is marked."
msgstr "Ingen inspelad MIDI-not är markerad."

#. from tp:denemo-2.6-rc2
msgid "Synchronize Marked Recorded Midi Note to Denemo Cursor Position"
msgstr "Synkronisera markerad inspelad MIDI-not med Denemo-markörens position"

#. from tp:denemo-2.6-rc2
msgid "Alters the timing of the recorded MIDI notes so that the marked note plays at the time of the note currently at the Denemo cursor."
msgstr "Ändrar tidpunkten för de inspelade MIDI-noterna så att den markerade noten spelas samtidigt som den not som för tillfället befinner sig vid Denemo-markören."

#. from tp:denemo-2.6-rc2
msgid "Hide Other Staffs (Off/On)"
msgstr "Dölj andra notsystem (av/på)"

#. from tp:denemo-2.6-rc2
msgid "Hides/unhides other staffs in the display while keeping the MIDI track at the top visible."
msgstr "Döljer eller visar andra notsystem medan MIDI-spåret överst förblir synligt."

#. from tp:denemo-2.6-rc2
msgid "Unmute/Mute Recording Playback"
msgstr "Inaktivera/Ljuddämpa Inspelning Uppspelning"

#. from tp:denemo-2.6-rc2
msgid "Controls whether the recorded MIDI (and the click track) plays back with your score when you do Play."
msgstr "Styr om inspelad MIDI (och klickspåret) ska spelas upp tillsammans med partituret när du spelar Play."

#. from tp:denemo-2.6-rc2
msgid "Create Timebase"
msgstr "Skapa en tidsbas"

#. from tp:denemo-2.6-rc2
msgid "Recalculates the timing of each note."
msgstr "Räknar om timingen för varje not."

#. from tp:denemo-2.6-rc2
msgid "Stop/Forget Pause"
msgstr "Stoppa/Förtränga Paus"

#. from tp:denemo-2.6-rc2
msgid "Stops the playback or cancels the Pause, restoring the original start playback marker position."
msgstr "Stoppar uppspelningen eller avbryter pausen och återställer den ursprungliga startpositionen för uppspelningsmarkören."

#. from tp:denemo-2.6-rc2
msgid "Mouse Conductor (Off/On)"
msgstr "Musledare (av/på)"

#. from tp:denemo-2.6-rc2
msgid "Turns on/off moving the playback on by moving the mouse over the score area."
msgstr "Aktiverar/inaktiverar att flytta uppspelningen genom att föra musen över partiturområdet."

#. from tp:denemo-2.6-rc2
msgid "Toggle Immediate Playback"
msgstr "Växla omedelbar uppspelning"

#. from tp:denemo-2.6-rc2
msgid "Toggle on/off if you want to hear the note directly after inserting/changing."
msgstr "Slå på/av om du vill höra noten direkt efter att den har infogats/bytts ut."

#. from tp:denemo-2.6-rc2
msgid "Play Along Playback (Off/On)"
msgstr "Spela upp längs uppspelning (av/på)"

#. from tp:denemo-2.6-rc2
msgid "Turns off play along playback: when this is on the playback does not advance past the cursor unless you play along the correct note via Midi In."
msgstr "Inaktiverar play along-uppspelning: när detta är aktiverat går uppspelningen inte förbi markören om du inte spelar med rätt not via Midi In."

#. from tp:denemo-2.6-rc2
msgid "Pops up a window which displays the object at the cursor, including anything attached to it."
msgstr "Öppnar ett fönster som visar objektet vid markören, inklusive allt som är kopplat till det."

#. from tp:denemo-2.6-rc2
msgid "This score has taken\n"
msgstr "Denna poäng har tagit\n"

#. from tp:denemo-2.6-rc2
msgid " to create, not counting unsaved edits."
msgstr " att skapa, och då räknas inte osparade redigeringar med."

#. from tp:denemo-2.6-rc2
msgid "Time Spent Editing"
msgstr "Tidsåtgång för redigering"

#. from tp:denemo-2.6-rc2
msgid "Displays the cumulative time spent editing this score. The time counts any period between starting to edit and saving to disk. The time is accumulated over different editing sessions."
msgstr "Visar den sammanlagda tid som använts för att redigera detta partitur. Tiden räknas från det att du börjar redigera till dess att du sparar på disken. Tiden ackumuleras under olika redigeringssessioner."

#. from tp:denemo-2.6-rc2
msgid "Select a Palette to Show"
msgstr "Välj en palett att visa"

#. from tp:denemo-2.6-rc2
msgid "Offers the available palettes to un-hide."
msgstr "Erbjuder de tillgängliga paletter som ska döljas."

#. from tp:denemo-2.6-rc2
msgid "Create Palette Button"
msgstr "Skapa palett-knapp"

#. from tp:denemo-2.6-rc2
msgid "Give a name for the chord"
msgstr "Ge ett namn åt ackordet"

#. from tp:denemo-2.6-rc2
msgid "Not on a chord"
msgstr "Inte på ett ackord"

#. from tp:denemo-2.6-rc2
msgid "Create Button for Chord Type"
msgstr "Skapa knapp för ackordtyp"

#. from tp:denemo-2.6-rc2
msgid "Creates a palette button which will insert the type of chord at the cursor, transposed to the cursor position when invoked. Use prepending sharp or flat to insert a chord with sharpened or flattened root note. Use for chord symbol chords."
msgstr "Skapar en palettknapp som infogar den typ av ackord som finns vid markören, transponera till markörens position när den aktiveras. Använd prepending kors eller b för att infoga ett ackord med skärpt eller tillplattad grundton. Används för ackordsymbolackord."

#. from tp:denemo-2.6-rc2
msgid "Object Clone"
msgstr "Kloning av objekt"

#. from tp:denemo-2.6-rc2
msgid "Give (unique) label for button: "
msgstr "Ange en (unik) etikett för knappen: "

#. from tp:denemo-2.6-rc2
msgid "mylabel"
msgstr "mylabel"

#. from tp:denemo-2.6-rc2
msgid "Give tooltip for button: "
msgstr "Ge verktygstips för knappen: "

#. from tp:denemo-2.6-rc2
msgid "Inserts object"
msgstr "Infogar objekt"

#. from tp:denemo-2.6-rc2
msgid "Failed - duplicate label, no palette?"
msgstr "Misslyckades - duplicerad etikett, ingen palett?"

#. from tp:denemo-2.6-rc2
msgid "Not implemented yet"
msgstr "Ej implementerat ännu"

#. from tp:denemo-2.6-rc2
msgid "Create Button for Object"
msgstr "Skapa en knapp för ett objekt"

#. from tp:denemo-2.6-rc2
msgid "Creates a palette button to insert a clone of the object at the cursor when the button is pressed."
msgstr "Skapar en palettknapp som infogar en klon av objektet vid markören när knappen trycks in."

#. from tp:denemo-2.6-rc2
msgid "Show Hidden Palettes"
msgstr "Visa dolda paletter"

#. from tp:denemo-2.6-rc2
msgid "Un-hides all non-empty palettes."
msgstr "Döljer alla icke-tomma paletter."

#. from tp:denemo-2.6-rc2
msgid "The last change was:\n"
msgstr "Den sista förändringen var:\n"

#. from tp:denemo-2.6-rc2
msgid "No change recorded in Undo stack"
msgstr "Ingen ändring registrerad i Undo stack"

#. from tp:denemo-2.6-rc2
msgid "Show Last Change"
msgstr "Visa senaste ändring"

#. from tp:denemo-2.6-rc2
msgid "Shows the last change recorded on the Undo stack."
msgstr "Visar den senast registrerade ändringen på Undo-stacken."

#. from tp:denemo-2.6-rc2
msgid "No (un-iconized) source for transcribing is open"
msgstr "Ingen (oikoniserad) källa för transkribering är öppen"

#. from tp:denemo-2.6-rc2
msgid "Swap Display and Source Window Positions"
msgstr "Byt positioner för display- och källfönster"

#. from tp:denemo-2.6-rc2
msgid "Swaps the positions of the Denemo Display and the (first, un-iconized) Source Window currently open."
msgstr "Byter position på Denemo-skärmen och det (första, ej ikoniserade) källfönstret som är öppet för tillfället."

#. from tp:denemo-2.6-rc2
msgid "Cursor Highlighting Off/On"
msgstr "Markörmarkering Av/På"

#. from tp:denemo-2.6-rc2
msgid "Shows up the position of the cursor more clearly (off/on)"
msgstr "Visar markörens position tydligare (av/på)"

#. from tp:denemo-2.6-rc2
msgid "Toggle Command Center"
msgstr "Växla kommandocentral"

#. from tp:denemo-2.6-rc2
msgid "Hides/Unhides the Command Center"
msgstr "Döljer/avslöjar kommandocentralen"

#. from tp:denemo-2.6-rc2
msgid "Toggle LilyPond View"
msgstr "Toggle LilyPond View"

#. from tp:denemo-2.6-rc2
msgid "Hides/Unhides the LilyPond View"
msgstr "Döljer/avslöjar LilyPond-vyn"

#. from tp:denemo-2.6-rc2
msgid "Toggle MidiIn Controls"
msgstr "Växla MidiIn-kontroller"

#. from tp:denemo-2.6-rc2
msgid "Hides/Unhides the Midi In Controls"
msgstr "Döljer/avslöjar Midi In-kontrollerna"

#. from tp:denemo-2.6-rc2
msgid "Toggle Playback Controls"
msgstr "Växla uppspelningskontroller"

#. from tp:denemo-2.6-rc2
msgid "Hides/Unhides the PlaybackControls"
msgstr "Döljer/avslöjar PlaybackControls"

#. from tp:denemo-2.6-rc2
msgid "Toggle Print View"
msgstr "Växla utskriftsvy"

#. from tp:denemo-2.6-rc2
msgid "Hides/Unhides the Print View"
msgstr "Döljer/avslöjar utskriftsvyn"

#. from tp:denemo-2.6-rc2
msgid "Toggle Scheme View"
msgstr "Växla vy för schema"

#. from tp:denemo-2.6-rc2
msgid "Hides/Unhides the Scheme view"
msgstr "Döljer/avslöjar schemavyn"

#. from tp:denemo-2.6-rc2
msgid "Scale Display"
msgstr "Skala Display"

#. from tp:denemo-2.6-rc2
msgid "Give % scaling required"
msgstr "Ge % scaling krävs"

#. from tp:denemo-2.6-rc2
msgid "Set Display Scale"
msgstr "Ställ in displayskala"

#. from tp:denemo-2.6-rc2
msgid "Scales the display by value given by user."
msgstr "Skalar displayen med det värde som användaren anger."

#. from tp:denemo-2.6-rc2
msgid "Zoom In"
msgstr "Zooma in"

#. from tp:denemo-2.6-rc2
msgid "Zoom Out"
msgstr "Zooma ut"

#. from tp:denemo-2.6-rc2
msgid "Zoom to 100%"
msgstr "Zooma till 100"

#. from tp:denemo-2.6-rc2
msgid "Zoom to 100%, restore the original size"
msgstr "Zooma till 100%, återställ originalstorleken"

#. from tp:denemo-2.6-rc2
msgid "Add Augmented 4th above base"
msgstr "Lägg till Augmented 4th ovanför basen"

#. from tp:denemo-2.6-rc2
msgid "Add a tritone/augmented fourth as chordnote relative to the lowest note upwards."
msgstr "Lägg till en tritonus/förhöjd kvart som ackordnot i förhållande till den lägsta tonen uppåt."

