msgid "An obsolete function has been called.\nWhile this is not an error, it is\nrecommended to update the project\nprogram and replace the function call.\nFor more information, see the manual\nabout obsolete functions."
msgstr "En föråldrad funktion har anropats.\nÄven om detta inte är ett fel rekommenderas det\natt uppdatera projektprogrammet\noch ersätta funktionsanropet.\nFör mer information, se manualen\nom föråldrade funktioner."

#. from tp:beebase-1.2
msgid "*Continue|Generate error"
msgstr "*Fortsätt|Generera fel"

#. from tp:beebase-1.2
msgid "Too many recursive calls"
msgstr "För många rekursiva anrop"

#. from tp:beebase-1.2
msgid "Unknown type"
msgstr "Okänd typ"

#. from tp:beebase-1.2
msgid "Invalid handle"
msgstr "Ogiltigt handtag"

#. from tp:beebase-1.2
msgid "Broken connection"
msgstr "Bruten anslutning"

#. from tp:beebase-1.2
msgid "In transaction"
msgstr "I transaktion"

#. from tp:beebase-1.2
msgid "Not in transaction"
msgstr "Inte i transaktion"

#. from tp:beebase-1.2
msgid "Nested transaction"
msgstr "Nästlad transaktion"

#. from tp:beebase-1.2
msgid "Result string exceeds ARexx maximum string length (65535)."
msgstr "Resultatsträng överskrider ARexx maximala stränglängd (65535)."

#. from tp:beebase-1.2
msgid "No such project opened"
msgstr "Inget sådant projekt öppnat"

#. from tp:beebase-1.2
msgid "BeeBase busy, try again later."
msgstr "BeeBase upptagen, försök igen senare."

#. from tp:beebase-1.2
msgid "_Weight"
msgstr "_Vikt"

#. from tp:beebase-1.2
msgid "Layout weight.  The higher the value\nthe more space the object will have\nin the final window layout."
msgstr "Layoutvikt. Ju högre värdet är\ndesto mer utrymme får objektet\ni den slutliga fönsterlayouten."

#. from tp:beebase-1.2
msgid "Font"
msgstr "Teckensnitt"

#. from tp:beebase-1.2
msgid "Font.  Leave field\nempty for default font."
msgstr "Teckensnitt. Lämna fältet\ntomt för standardteckensnitt."

#. from tp:beebase-1.2
msgid "_Background"
msgstr "_Bakgrund"

#. from tp:beebase-1.2
msgid "Background for the GUI item"
msgstr "Bakgrund för GUI-objektet"

#. from tp:beebase-1.2
msgid "_Default"
msgstr "_Standard"

#. from tp:beebase-1.2
msgid "If checked, a default background is used.\nOtherwise the specified one is used."
msgstr "Om markerad används standardbakgrunden.\nAnnars används den angivna."

#. from tp:beebase-1.2
msgid "Name of the field.  Must begin with an\nuppercase letter followed by further letters,\ndigits or underscore characters.  Non-ASCII\nletters like German umlauts are not allowed."
msgstr "Namn på fältet. Måste börja med en\nversal följt av ytterligare bokstäver,\nsiffror eller understreck. Icke-ASCII-\nbokstäver som tyska omljud är inte tillåtna."

#. from tp:beebase-1.2
msgid "_Type"
msgstr "_Typ"

#. from tp:beebase-1.2
msgid "Field type.  The field type can only\nbe specified at field creation time."
msgstr "Fälttyp. Fälttypen kan endast anges\nvid skapandet av fältet."

#. from tp:beebase-1.2
msgid "_Max length"
msgstr "_Maxlängd"

#. from tp:beebase-1.2
msgid "Maximum number of characters the\nstring field can hold."
msgstr "Maximalt antal tecken som\ntextfältet kan innehålla."

#. from tp:beebase-1.2
msgid " NIL"
msgstr " NIL"

#. from tp:beebase-1.2
msgid " TRUE"
msgstr " TRUE"

#. from tp:beebase-1.2
msgid "Edit la_bels..."
msgstr "Redigera et_iketter..."

#. from tp:beebase-1.2
msgid "Opens window for\nediting label strings."
msgstr "Öppnar fönster för att\nredigera etiketter."

#. from tp:beebase-1.2
msgid "To continue, please confirm the following:"
msgstr "För att fortsätta, bekräfta följande:"

#. from tp:beebase-1.2
msgid "Choice labels in existing records will show the new labels\n(records only store an index into the list of labels, and\nchanges to labels or their order do not change any index)."
msgstr "Valetiketter i befintliga poster kommer att visa de nya etiketterna\n(poster lagrar bara ett index i listan över etiketter, och\nändringar av etiketter eller deras ordning ändrar inte något index)."

#. from tp:beebase-1.2
msgid "There are empty labels."
msgstr "Det finns tomma etiketter."

#. from tp:beebase-1.2
msgid "There are duplicate labels."
msgstr "Det finns dubbla etiketter."

#. from tp:beebase-1.2
msgid "Set Reference to:"
msgstr "Ange referens till:"

#. from tp:beebase-1.2
msgid "Reference to a table."
msgstr "Referens till en tabell."

#. from tp:beebase-1.2
msgid "If selected, the user can only\naccess records where the reference\nis set to the current record of the\nreferenced table."
msgstr "Om markerad kan användaren endast\nkomma åt poster där referensen\npekar på den aktuella posten i\nreferenstabellen."

#. from tp:beebase-1.2
msgid "_Auto show?"
msgstr "_Autovisning?"

#. from tp:beebase-1.2
msgid "If selected, the referenced table gets\nupdated with the referenced record whenever\nthe user switches to another record."
msgstr "Om markerad uppdateras den refererade tabellen\nmed den refererade posten när\nanvändaren växlar till en annan post."

#. from tp:beebase-1.2
msgid "Initial value"
msgstr "Initialt värde"

#. from tp:beebase-1.2
msgid "_Initial value"
msgstr "_Initialvärde"

#. from tp:beebase-1.2
msgid "Initial value\nfor this field"
msgstr "Initialt värde\nför detta fält"

#. from tp:beebase-1.2
msgid "NIL"
msgstr "NIL"

#. from tp:beebase-1.2
msgid "other"
msgstr "annat"

#. from tp:beebase-1.2
msgid "other _value:"
msgstr "annat _värde:"

#. from tp:beebase-1.2
msgid "NI_L string"
msgstr "NI_L-sträng"

#. from tp:beebase-1.2
msgid "String that should be displayed\nfor the NIL value."
msgstr "Text som ska visas\nför NIL-värdet."

#. from tp:beebase-1.2
msgid "Com_pute"
msgstr "Beräk_na"

#. from tp:beebase-1.2
msgid "Trigger function which will be executed\nwhenever the value of this field\nis needed, e.g. for displaying it."
msgstr "Utlösarfunktion som körs\nnär värdet i detta fält\nbehövs, t.ex. för att visa det."

#. from tp:beebase-1.2
msgid "T_rigger"
msgstr "U_tlösare"

#. from tp:beebase-1.2
msgid "Trigger function that should be\ncalled after the user has changed\nthe field value."
msgstr "Utlösarfunktion som anropas\nefter att användaren har ändrat\nfältets värde."

#. from tp:beebase-1.2
msgid "_Count changes?"
msgstr "_Räkna ändringar?"

#. from tp:beebase-1.2
msgid "Decides whether changing the\nfield contents in a record\ncounts as a change of the project.\nUncheck this item if you want to\nignore changes to this field."
msgstr "Avgör om ändring av fältets innehåll\ni en post räknas som en ändring av projektet.\nAvmarkera detta om du vill\nignorera ändringar i detta fält."

#. from tp:beebase-1.2
msgid "Lo_g changes?"
msgstr "Lo_gga ändringar?"

#. from tp:beebase-1.2
msgid "Decides whether changing the contents\nof the field in a record should\nbe recorded in the project log."
msgstr "Avgör om ändring av fältets innehåll\ni en post ska registreras\ni projektloggen."

#. from tp:beebase-1.2
msgid "Edit labels"
msgstr "Redigera etiketter"

#. from tp:beebase-1.2
msgid "List of labels.  You may\nadd, change or remove items\nfrom this list."
msgstr "Lista över etiketter. Du kan\nlägga till, ändra eller ta bort objekt\nfrån denna lista."

#. from tp:beebase-1.2
msgid "Creates a new label."
msgstr "Skapar en ny etikett."

#. from tp:beebase-1.2
msgid "_Remove"
msgstr "_Ta bort"

#. from tp:beebase-1.2
msgid "Removes the currently selected label."
msgstr "Tar bort den markerade etiketten."

#. from tp:beebase-1.2
msgid "_Sort"
msgstr "_Sortera"

#. from tp:beebase-1.2
msgid "Sorts the list of labels in alphabetical order."
msgstr "Sorterar listan med etiketter i alfabetisk ordning."

#. from tp:beebase-1.2
msgid "_Label"
msgstr "_Etikett"

#. from tp:beebase-1.2
msgid "Edit program"
msgstr "Redigera program"

#. from tp:beebase-1.2
msgid "Include directory"
msgstr "Inkluderingskatalog"

#. from tp:beebase-1.2
msgid "_Shortcut"
msgstr "_Genväg"

#. from tp:beebase-1.2
msgid "The shortcut character can be used for\nactivating the GUI item.  If you don't\nwant a shortcut, leave this field empty.\nPress <Enter> to check if the entered\nshortcut character is already used by\nanother item in the same window."
msgstr "Genvägstecknet kan användas för att\naktivera GUI-objektet. Om du inte\nvill ha en genväg, lämna fältet tomt.\nTryck på <Enter> för att kontrollera om det angivna\ngenvägstecknet redan används av\nett annat objekt i samma fönster."

#. from tp:beebase-1.2
msgid "Warning: shortcut already in use\nby %s."
msgstr "Varning: genväg används redan\nav %s."

#. from tp:beebase-1.2
msgid "Enabled/disabled"
msgstr "Aktiverad/inaktiverad"

#. from tp:beebase-1.2
msgid "Always enabled"
msgstr "Alltid aktiverad"

#. from tp:beebase-1.2
msgid "Disabled in initial"
msgstr "Inaktiverad i initialposten"

#. from tp:beebase-1.2
msgid "Compute enabled"
msgstr "Beräkna aktiveringstillstånd"

#. from tp:beebase-1.2
msgid "Setting for the enabled/disabled state.\n'Disabled in initial' is like 'Always enabled'\nexcept that the object is disabled when it is\ninside a table showing its initial record."
msgstr "Inställning för aktiverat/inaktiverat tillstånd.\n'Inaktiverad i initialposten' är som 'Alltid aktiverad'\nförutom att objektet inaktiveras när det finns\ni en tabell som visar sin initiala post."

#. from tp:beebase-1.2
msgid "Computed"
msgstr "Beräknad"

#. from tp:beebase-1.2
msgid "Compute"
msgstr "Beräkna"

#. from tp:beebase-1.2
msgid "Trigger function which computes the enabled state.\nIf the function returns NIL, the object is disabled,\notherwise enabled.  The function is evaluated whenever\na dependent item changes (different record is shown,\na field changed, a record is added or deleted,\nuser/admin mode is changed, or program is recompiled).\nDependencies are obtained from the compute function."
msgstr "Utlösarfunktion som beräknar aktiveringstillståndet.\nOm funktionen returnerar NIL inaktiveras objektet,\nannars aktiveras det. Funktionen utvärderas när\nett beroende objekt ändras (en annan post visas,\nett fält ändras, en post läggs till eller tas bort,\nanvändar/admin-läge ändras, eller programmet kompileras om).\nBeroenden hämtas från beräkningsfunktionen."

#. from tp:beebase-1.2
msgid "Description"
msgstr "Beskrivning"

#. from tp:beebase-1.2
msgid "Short description of a record.\nEither a list of record fields,\nthe result of a compute function,\nor the settings from the table object."
msgstr "Kort beskrivning av en post.\nAntingen en lista med postfält,\nresultatet av en beräkningsfunktion,\neller inställningarna från tabellobjektet."

#. from tp:beebase-1.2
msgid "Fields"
msgstr "Fält"

#. from tp:beebase-1.2
msgid "From table"
msgstr "Från tabell"

#. from tp:beebase-1.2
msgid "Fields that are shown\nfrom the specific record."
msgstr "Fält som visas\nfrån den specifika posten."

#. from tp:beebase-1.2
msgid "Record number"
msgstr "Postnummer"

#. from tp:beebase-1.2
msgid "Function for computing the record description.\nThe function should either return a single expression\nor a list of expressions for multi-column lists."
msgstr "Funktion för att beräkna postens beskrivning.\nFunktionen ska antingen returnera ett enda uttryck\neller en lista med uttryck för flerkolumnslistor."

#. from tp:beebase-1.2
msgid "Use multi-column list?"
msgstr "Använd flerkolumnslista?"

#. from tp:beebase-1.2
msgid "Specifies how fields are organized when\nshown in a listview pop-up.\nIf checked, fields are aligned in columns.\nOtherwise, all fields are concatenated by\na separator character ' - ' and placed into\na single column."
msgstr "Anger hur fält organiseras när de\nvisas i en listvy-popup.\nOm markerad ordnas fälten i kolumner.\nAnnars sammanfogas alla fält med\navgränsningstecknet ' - ' och placeras i\nen enda kolumn."

#. from tp:beebase-1.2
msgid "Display table"
msgstr "Visa tabell"

#. from tp:beebase-1.2
msgid "Has panel?"
msgstr "Har panel?"

#. from tp:beebase-1.2
msgid "Whether a panel should be displayed\nat the top of the table."
msgstr "Huruvida en panel ska visas\nlängst upp i tabellen."

#. from tp:beebase-1.2
msgid "Title of the panel.  Will be displayed\nin the left corner of the panel bar."
msgstr "Panelens titel. Kommer att visas\ni vänstra hörnet av panelraden."

#. from tp:beebase-1.2
msgid "Gadgets"
msgstr "Objekt"

#. from tp:beebase-1.2
msgid "_Num/All?"
msgstr "_Antal/Alla?"

#. from tp:beebase-1.2
msgid "If checked, the number of the current record\ntogether with the number of all records\nwill be displayed in the right corner\nof the panel bar."
msgstr "Om markerad visas numret på aktuell post\ntillsammans med det totala antalet poster\ni högra hörnet av panelraden."

#. from tp:beebase-1.2
msgid "If checked, a filter button is added\nto the panel bar allowing the user to\nturn the table filter on and off."
msgstr "Om markerad läggs en filterknapp till\ni panelraden så att användaren kan\nslå på och av tabellfiltret."

#. from tp:beebase-1.2
msgid "_Arrows?"
msgstr "_Pilar?"

#. from tp:beebase-1.2
msgid "If checked, two arrow buttons are added\nto the panel bar allowing the user to go\nto the previous or next record."
msgstr "Om markerad läggs två pilknappar till\ni panelraden så att användaren kan gå\ntill föregående eller nästa post."

#. from tp:beebase-1.2
msgid "Display field"
msgstr "Visningsfält"

#. from tp:beebase-1.2
msgid "Title"
msgstr "Titel"

#. from tp:beebase-1.2
msgid "Extras"
msgstr "Extra"

#. from tp:beebase-1.2
msgid "_Position"
msgstr "_Position"

#. from tp:beebase-1.2
msgid "Title position relative\nto the field"
msgstr "Titelns position i förhållande\ntill fältet"

#. from tp:beebase-1.2
msgid "The title is placed near the\nfield.  If the title is empty,\nno title is displayed."
msgstr "Titeln placeras nära\nfältet. Om titeln är tom\nvisas ingen titel."

#. from tp:beebase-1.2
msgid "_Read only?"
msgstr "_Skrivskyddad?"

#. from tp:beebase-1.2
msgid "If checked, the field can\nonly be read but not modified."
msgstr "Om markerad kan fältet\nendast läsas men inte ändras."

#. from tp:beebase-1.2
msgid "If checked, the field cannot be edited.\nHowever, when adding a pop-up button to the\nstring field, the field can still be set to\nthe selections offered in the pop-up."
msgstr "Om markerad kan fältet inte redigeras.\nMen när en popup-knapp läggs till\ntextfältet kan fältet ändå ställas in på\nde val som erbjuds i popup-fönstret."

#. from tp:beebase-1.2
msgid "_Home?"
msgstr "_Hem?"

#. from tp:beebase-1.2
msgid "If checked, the cursor is set\non this field whenever a new\nrecord is created."
msgstr "Om markerad placeras markören\npå detta fält varje gång en ny\npost skapas."

#. from tp:beebase-1.2
msgid "Tab chain?"
msgstr "Tabbordning?"

#. from tp:beebase-1.2
msgid "If selected, the GUI object\ncan obtain the keyboard focus\nthrough pressing the <Tab> key."
msgstr "Om markerad kan GUI-objektet\nfå tangentbordsfokus genom att\ntrycka på <Tab>-tangenten."

#. from tp:beebase-1.2
msgid "_Alignment"
msgstr "_Justering"

#. from tp:beebase-1.2
msgid "Alignment of the text inside\nthe string or text field."
msgstr "Justering av texten inuti\nsträng- eller textfältet."

#. from tp:beebase-1.2
msgid "Center"
msgstr "Centrerad"

#. from tp:beebase-1.2
msgid "Top"
msgstr "Överkant"

#. from tp:beebase-1.2
msgid "Bottom"
msgstr "Underkant"

#. from tp:beebase-1.2
msgid "Calendar?"
msgstr "Kalender?"

#. from tp:beebase-1.2
msgid "Adds a pop-up button\nshowing a calendar."
msgstr "Lägger till en popup-knapp\nsom visar en kalender."

#. from tp:beebase-1.2
msgid "Format"
msgstr "Format"

#. from tp:beebase-1.2
msgid "Formatting for display"
msgstr "Formatering för visning"

#. from tp:beebase-1.2
msgid "HH:MM:SS"
msgstr "HH:MM:SS"

#. from tp:beebase-1.2
msgid "MM:SS"
msgstr "MM:SS"

#. from tp:beebase-1.2
msgid "HH:MM"
msgstr "HH:MM"

#. from tp:beebase-1.2
msgid "_Kind"
msgstr "_Typ"

#. from tp:beebase-1.2
msgid "Display kind for virtual field.\nBoolean displays only NIL and non-NIL values.\nText can display strings, numbers, etc.\nList displays items of a list, e.g. the\nresult of a SELECT FROM WHERE call."
msgstr "Visningstyp för virtuellt fält.\nBoolesk visar endast NIL och icke-NIL-värden.\nText kan visa strängar, tal osv.\nLista visar objekt i en lista, t.ex.\nresultatet av ett SELECT FROM WHERE-anrop."

#. from tp:beebase-1.2
msgid "List"
msgstr "Lista"

#. from tp:beebase-1.2
msgid "Display kind for button field"
msgstr "Visningstyp för knappfält"

#. from tp:beebase-1.2
msgid "Text button"
msgstr "Textknapp"

#. from tp:beebase-1.2
msgid "Image button"
msgstr "Bildknapp"

#. from tp:beebase-1.2
msgid "Display kind for choice field"
msgstr "Visningstyp för valfält"

#. from tp:beebase-1.2
msgid "Cycle button"
msgstr "Växlingsknapp"

#. from tp:beebase-1.2
msgid "Radio buttons"
msgstr "Radioknappar"

#. from tp:beebase-1.2
msgid "_Frame?"
msgstr "_Ram?"

#. from tp:beebase-1.2
msgid "Check this item and you will get\na frame around the radio buttons."
msgstr "Markera detta alternativ för att få\nen ram runt radioknapparna."

#. from tp:beebase-1.2
msgid "Hori_zontal?"
msgstr "Hori_sontell?"

#. from tp:beebase-1.2
msgid "Horizontal or vertical layout"
msgstr "Horisontell eller vertikal layout"

#. from tp:beebase-1.2
msgid "Deci_mals"
msgstr "Deci_maler"

#. from tp:beebase-1.2
msgid "Number of digits after\nthe decimal point\nfor a real value"
msgstr "Antal decimaler efter\ndecimaltecknet\nför ett decimaltal"

#. from tp:beebase-1.2
msgid "Show titles?"
msgstr "Visa titlar?"

#. from tp:beebase-1.2
msgid "If checked, the list field will\nalso show the field names in the\nfirst row."
msgstr "Om markerad kommer listfältet\nockså att visa fältnamnen i\nförsta raden."

#. from tp:beebase-1.2
msgid "Control table?"
msgstr "Styr tabellen?"

#. from tp:beebase-1.2
msgid "If checked, the list controls the table\nof the first column that is generated\nfrom a field of the table."
msgstr "Om markerad styr listan tabellen\nför första kolumnen som genereras\nfrån ett fält i tabellen."

#. from tp:beebase-1.2
msgid "On double-click"
msgstr "Vid dubbelklick"

#. from tp:beebase-1.2
msgid "Action to be performed when\nuser double-clicks a list-view item."
msgstr "Åtgärd som ska utföras när\nanvändaren dubbelklickar på ett objekt i listvyn."

#. from tp:beebase-1.2
msgid "Do nothing"
msgstr "Gör ingenting"

#. from tp:beebase-1.2
msgid "Show record"
msgstr "Visa post"

#. from tp:beebase-1.2
msgid "Call trigger"
msgstr "Anropa utlösare"

#. from tp:beebase-1.2
msgid "T_rigger function"
msgstr "U_tlösarfunktion"

#. from tp:beebase-1.2
msgid "Trigger function that should be\ncalled when the user double-clicks\nan item in the list view."
msgstr "Utlösarfunktion som anropas\nnär användaren dubbelklickar\npå ett objekt i listvyn."

#. from tp:beebase-1.2
msgid "Trigger function on URL _drop"
msgstr "Utlösarfunktion vid URL-_släpp"

#. from tp:beebase-1.2
msgid "Trigger function that should be called\nwhen the user drags and drops URLs\n(e.g. filenames) onto the list view."
msgstr "Utlösarfunktion som anropas\nnär användaren drar och släpper URL:er\n(t.ex. filnamn) på listvyn."

#. from tp:beebase-1.2
msgid "Trigger function on _sort drop"
msgstr "Utlösarfunktion vid _sorteringssläpp"

#. from tp:beebase-1.2
msgid "Trigger function that should be called\nwhen the user drags and drops an item\nfor sorting items in the list view."
msgstr "Utlösarfunktion som anropas\nnär användaren drar och släpper ett objekt\nför sortering av objekt i listvyn."

#. from tp:beebase-1.2
msgid "Auto _update?"
msgstr "Auto_uppdatering?"

#. from tp:beebase-1.2
msgid "If checked, the virtual field is recomputed\nwhenever a dependent item changes (a different\nrecord is shown, a field changed, a record\nis added or deleted, user/admin mode is changed,\nor program is recompiled).  The dependencies are\nobtained from the field's compute function."
msgstr "Om markerad beräknas det virtuella fältet på nytt\nnär ett beroende objekt ändras (en annan\npost visas, ett fält ändras, en post\nläggs till eller tas bort, användar/admin-läge ändras,\neller programmet kompileras om). Beroendena\nfås från fältets beräkningsfunktion."

#. from tp:beebase-1.2
msgid "Bubble\nhelp"
msgstr "Hjälp-\nbubbla"

#. from tp:beebase-1.2
msgid "Choose which records of the referenced\ntable should be shown in the pop-up."
msgstr "Välj vilka poster från den refererade\ntabellen som ska visas i popup-fönstret."

#. from tp:beebase-1.2
msgid "All"
msgstr "Alla"

#. from tp:beebase-1.2
msgid "Match filter"
msgstr "Matcha filter"

#. from tp:beebase-1.2
msgid "Trigger function which will be executed\nwhenever the pop-up button is pressed.\nThe compute function should return\na list which is searched depth-first.\nAny records found are included in the\nlist-view.  Non-record items are ignored."
msgstr "Utlösarfunktion som körs\nnär popup-knappen trycks in.\nBeräkningsfunktionen ska returnera\nen lista som genomsöks med djupet först.\nAlla poster som hittas inkluderas i\nlistvyn. Objekt som inte är poster ignoreras."

#. from tp:beebase-1.2
msgid "Initial record?"
msgstr "Initial post?"

#. from tp:beebase-1.2
msgid "If checked, the initial record is\nincluded in the pop-up list at the top."
msgstr "Om markerad inkluderas den initiala posten\nlängst upp i popup-listan."

#. from tp:beebase-1.2
msgid "Current record?"
msgstr "Aktuell post?"

#. from tp:beebase-1.2
msgid "If checked, the current record of\nthe referenced table is included in\nthe pop-up list at the top."
msgstr "Om markerad kommer den aktuella posten i\nreferenstabellen att inkluderas\nlängst upp i popup-listan."

#. from tp:beebase-1.2
msgid "Buttons"
msgstr "Knappar"

#. from tp:beebase-1.2
msgid "_Listview pop-up?"
msgstr "_Listvypopup?"

#. from tp:beebase-1.2
msgid "Adds a pop-up button to the right of the\nstring field to allow the user to choose\na string from a list of strings.\nIf the string field is read only, the user\ncan still change its contents by using\nthe pop-up button."
msgstr "Lägger till en popup-knapp till höger om\ntextfältet för att låta användaren välja\nen text från en lista med alternativ.\nOm textfältet är skrivskyddat kan användaren\nändå ändra dess innehåll genom att använda\npopup-knappen."

#. from tp:beebase-1.2
msgid "F_ile pop-up?"
msgstr "F_ilväljare?"

#. from tp:beebase-1.2
msgid "Adds a pop-up button to the right of the\nstring field to allow the user to select\na filename.\nIf the string field is read-only, the user\ncan still change its contents by selecting\nthe pop-up button."
msgstr "Lägger till en popup-knapp till höger om\ntextfältet så att användaren kan välja\nett filnamn.\nOm textfältet är skrivskyddat kan användaren\nändå ändra dess innehåll genom att välja\npopup-knappen."

#. from tp:beebase-1.2
msgid "Fo_nt pop-up?"
msgstr "Te_ckensnittsväljare?"

#. from tp:beebase-1.2
msgid "Adds a pop-up button to the right of the\nstring field to allow the user to select\na font name.\nIf the string field is read only, the user\ncan still change its contents by selecting\nthe pop-up button."
msgstr "Lägger till en popup-knapp till höger om\ntextfältet för att användaren ska kunna välja\nett teckensnitt.\nOm textfältet är skrivskyddat kan användaren\nändå ändra dess innehåll genom att välja\npopup-knappen."

#. from tp:beebase-1.2
msgid "_View?"
msgstr "_Visa?"

#. from tp:beebase-1.2
msgid "Adds a button for viewing the file\ngiven by the contents of the  string field.\nUse menu item Preferences/Set external viewer\nfor specifying the display program."
msgstr "Lägger till en knapp för att visa filen\nsom anges av innehållet i textfältet.\nAnvänd menyalternativet Inställningar/Extern visare\nför att ange visningsprogrammet."

#. from tp:beebase-1.2
msgid "Listview settings"
msgstr "Listvyinställningar"

#. from tp:beebase-1.2
msgid "Label items"
msgstr "Etikettobjekt"

#. from tp:beebase-1.2
msgid "Specifies either static labels\nor labels that are computed when\nthe pop-up button is pressed."
msgstr "Anger antingen statiska etiketter\neller etiketter som beräknas när\npopup-knappen trycks in."

#. from tp:beebase-1.2
msgid "Static"
msgstr "Statisk"

#. from tp:beebase-1.2
msgid "Edit labels..."
msgstr "Redigera etiketter..."

#. from tp:beebase-1.2
msgid "_Edit labels..."
msgstr "_Redigera etiketter..."

#. from tp:beebase-1.2
msgid "Pops up a window for specifying\nthe label strings."
msgstr "Öppnar ett fönster för att ange\netiketterna."

#. from tp:beebase-1.2
msgid "Trigger function which will be executed\nwhenever the pop-up button is pressed.\nThe compute function should return\na memo string with one label per line\nor NIL for an empty list-view."
msgstr "Utlösarfunktion som körs\nnär popup-knappen trycks in.\nBeräkningsfunktionen ska returnera\nen memosträng med en etikett per rad\neller NIL för en tom listvy."

#. from tp:beebase-1.2
msgid "_Show?"
msgstr "_Visa?"

#. from tp:beebase-1.2
msgid "If checked, the reference field\nalso contains a button for showing\nthe referenced record."
msgstr "Om markerad innehåller referensfältet\nockså en knapp för att visa\nden refererade posten."

#. from tp:beebase-1.2
msgid "Adds a checkmark button to turn auto-show mode\non and off.  When turned on, the referenced\ntable gets updated with the referenced record\nwhenever the user switches to another record."
msgstr "Lägger till en kryssruta för att slå på och av\nautovisningsläget. När det är aktiverat uppdateras\nden refererade tabellen med den refererade posten\nnär användaren växlar till en annan post."

#. from tp:beebase-1.2
msgid "Fi_lter?"
msgstr "Fi_ltrera?"

#. from tp:beebase-1.2
msgid "Adds a filter button to allow the user to toggle\nthe state of the reference filter.  When turned on,\nthe user can only access records where the reference\nis set to the current record of the referenced table."
msgstr "Lägger till en filterknapp så att användaren kan växla\nreferensfiltrets tillstånd. När det är aktiverat\nkan användaren endast komma åt poster där referensen\npekar på den aktuella posten i referenstabellen."

#. from tp:beebase-1.2
msgid "Picture"
msgstr "Bild"

#. from tp:beebase-1.2
msgid "Display _picture?"
msgstr "Visa _bild?"

#. from tp:beebase-1.2
msgid "Adds an image object for viewing the file\ngiven by the contents of the  string field."
msgstr "Lägger till ett bildobjekt för visning av filen\nsom anges av innehållet i textfältet."

#. from tp:beebase-1.2
msgid "_Title at string field?"
msgstr "_Titel vid textfält?"

#. from tp:beebase-1.2
msgid "Displays the title (if any) to the\nleft of the string field rather than\nto the left of the picture."
msgstr "Visar titeln (om sådan finns) till\nvänster om textfältet istället för\ntill vänster om bilden."

#. from tp:beebase-1.2
msgid "_Hide string field?"
msgstr "_Dölj textfält?"

#. from tp:beebase-1.2
msgid "If checked, the string field is\nnot shown in the window.  This is\nuseful if you want to display the\nexternal picture only."
msgstr "Om markerad visas inte textfältet\ni fönstret. Detta är\nanvändbart om du bara vill visa\nden externa bilden."

#. from tp:beebase-1.2
msgid "Size"
msgstr "Storlek"

#. from tp:beebase-1.2
msgid "Determines how the display object's width and height\nare calculated in the window layout.\n   Resizable allows to resize the object.  The object\nmay become larger than the size of its image.\n   Fixed sets the object's size to the size of the image.\nIf the image sizes vary, the object resizes accordingly.\n   Scrollable adds two scrollers to the object allowing\nto view images that are larger than the visible region.\n   Scaled scales the image to the size of the object.\n   Aspect scaled scales but preserves the aspect ratio."
msgstr "Avgör hur visningsobjektets bredd och höjd\nberäknas i fönsterlayouten.\n   Storleksändringsbar låter användaren ändra objektets storlek. Objektet\nkan bli större än bildens storlek.\n   Fast ställer in objektets storlek till bildens storlek.\nOm bildstorlekar varierar anpassas objektet.\n   Rullbar lägger till två rullningslister till objektet för att\nkunna visa bilder som är större än det synliga området.\n   Skalad skalar bilden till objektets storlek.\n   Proportionellt skalad bevarar bildförhållandet."

#. from tp:beebase-1.2
msgid "Group"
msgstr "Grupp"

#. from tp:beebase-1.2
msgid "Text to be displayed centered\nin the group frame."
msgstr "Text som centreras\ni gruppens ram."

#. from tp:beebase-1.2
msgid "Attributes"
msgstr "Attribut"

#. from tp:beebase-1.2
msgid "_Border?"
msgstr "_Kantlinje?"

#. from tp:beebase-1.2
msgid "If checked, a border frame will\nbe drawn around the group."
msgstr "Om markerad kommer en kantlinje\nritas runt gruppen."

#. from tp:beebase-1.2
msgid "_Horizontal?"
msgstr "_Horisontell?"

#. from tp:beebase-1.2
msgid "If checked, the group's elements are\norganized horizontally otherwise vertically."
msgstr "Om markerad ordnas gruppens element\nhorisontellt, annars vertikalt."

#. from tp:beebase-1.2
msgid "_Spacing?"
msgstr "_Mellanrum?"

#. from tp:beebase-1.2
msgid "If checked, space is inserted\nbetween the group's objects."
msgstr "Om markerad infogas mellanrum\nmellan gruppens objekt."

#. from tp:beebase-1.2
msgid "Register group"
msgstr "Registergrupp"

#. from tp:beebase-1.2
msgid "Labels"
msgstr "Etiketter"

#. from tp:beebase-1.2
msgid "Labels used for the register group items.\nThe number of labels should match the number\nof elements in the register group."
msgstr "Etiketter för registergruppens objekt.\nAntalet etiketter bör motsvara antalet\nelement i registergruppen."

#. from tp:beebase-1.2
msgid "Image"
msgstr "Bild"

#. from tp:beebase-1.2
msgid "_Image"
msgstr "_Bild"

#. from tp:beebase-1.2
msgid "Image to be displayed."
msgstr "Bild som ska visas."

#. from tp:beebase-1.2
msgid "Resizable"
msgstr "Storleksändringsbar"

#. from tp:beebase-1.2
msgid "Fixed"
msgstr "Fast"

#. from tp:beebase-1.2
msgid "Scrollable"
msgstr "Rullbar"

#. from tp:beebase-1.2
msgid "Scaled"
msgstr "Skalad"

#. from tp:beebase-1.2
msgid "Aspect scaled"
msgstr "Proportionellt skalad"

#. from tp:beebase-1.2
msgid "D_elimiter?"
msgstr "A_vgränsare?"

#. from tp:beebase-1.2
msgid "If checked, a delimiter bar\nwill be displayed."
msgstr "Om markerad kommer en avgränsningslinje\natt visas."

#. from tp:beebase-1.2
msgid "Text"
msgstr "Text"

#. from tp:beebase-1.2
msgid "Text to be displayed."
msgstr "Text som ska visas."

#. from tp:beebase-1.2
msgid "Text to be displayed in\nthe window title bar."
msgstr "Text som visas i\nfönstrets titelrad."

#. from tp:beebase-1.2
msgid "Id"
msgstr "Id"

#. from tp:beebase-1.2
msgid "A string of up to 4 characters defining\nthe MUI window id.  If set, the window's\nposition and size can be saved using MUI's\nsnapshot window facility.  Press <Enter> to\ncheck if the entered id is already used by\nanother window in any currently opened project.\nLeave empty for no id and window dimensions\nare stored in the project file."
msgstr "En sträng med upp till 4 tecken som definierar\nMUI-fönstrets id. Om den är inställd kan fönstrets\nposition och storlek sparas med hjälp av MUI:s funktion för att spara\nfönstrets position och storlek. Tryck på <Enter> för att\nkontrollera om det inmatade id:t redan används av\nett annat fönster i något öppet projekt.\nLämna tomt för inget id, då lagras fönstermåtten\ni projektfilen."

#. from tp:beebase-1.2
msgid "Warning: window id already in use\nby %s."
msgstr "Varning: fönster-ID används redan\nav %s."

#. from tp:beebase-1.2
msgid "Ids beginning with '_' are\nreserved for internal use."
msgstr "ID som börjar med '_' är\nreserverade för internt bruk."

#. from tp:beebase-1.2
msgid "B_utton?"
msgstr "K_napp?"

#. from tp:beebase-1.2
msgid "If checked, a button for opening\nand closing the window will be\nplaced into the parent window."
msgstr "Om markerad kommer en knapp för att öppna\noch stänga fönstret att placeras\ni det överordnade fönstret."

#. from tp:beebase-1.2
msgid "Button settings"
msgstr "Knappinställningar"

#. from tp:beebase-1.2
msgid "Close window when disabled?"
msgstr "Stäng fönstret när det inaktiveras?"

#. from tp:beebase-1.2
msgid "Check this if the window should be closed\nautomatically when the button gets disabled."
msgstr "Markera detta om fönstret ska stängas\nautomatiskt när knappen inaktiveras."

#. from tp:beebase-1.2
msgid "Change filter"
msgstr "Ändra filter"

#. from tp:beebase-1.2
msgid "Operators"
msgstr "Operatorer"

#. from tp:beebase-1.2
msgid "Applying filter..."
msgstr "Tillämpar filter..."

#. from tp:beebase-1.2
msgid "Change order"
msgstr "Ändra sortering"

#. from tp:beebase-1.2
msgid "Field list"
msgstr "Fältlista"

#. from tp:beebase-1.2
msgid "Comparison function"
msgstr "Jämförelsefunktion"

#. from tp:beebase-1.2
msgid "Available fields for ordering."
msgstr "Tillgängliga fält för sortering."

#. from tp:beebase-1.2
msgid "Order"
msgstr "Sortering"

#. from tp:beebase-1.2
msgid "Current order list.  All records are ordered by\nthe first field in this list.  If two records\nare equal in the first field then the second\nfield determines the order, and so on.\nAn up arrow means ascending ordering, a down\narrow descending ordering."
msgstr "Aktuell sorteringslista. Alla poster sorteras efter\ndet första fältet i listan. Om två poster\nhar samma värde i första fältet avgör det andra\nfältet ordningen, och så vidare.\nEn uppåtpil betyder stigande sortering, en nedåtpil\nbetyder fallande sortering."

#. from tp:beebase-1.2
msgid "_Function for comparing records"
msgstr "_Funktion för att jämföra poster"

#. from tp:beebase-1.2
msgid "The function gets two record pointers as arguments\nand should return a value less then 0 if the first\nrecord is smaller than the second, 0 if they are\nequal, and a value greater than 0 if the first\nrecord is larger than the second one."
msgstr "Funktionen får två postpekare som argument\noch ska returnera ett värde mindre än 0 om den första\nposten är mindre än den andra, 0 om de är\nlika, och ett värde större än 0 om den första\nposten är större än den andra."

#. from tp:beebase-1.2
msgid "Clears all fields\nfor an empty order."
msgstr "Rensar alla fält\nför en tom sortering."

#. from tp:beebase-1.2
msgid "Program output file"
msgstr "Programutdatafil"

#. from tp:beebase-1.2
msgid "_Filename"
msgstr "_Filnamn"

#. from tp:beebase-1.2
msgid "Pathname to which program output is sent."
msgstr "Sökväg dit programmets utdata skickas."

#. from tp:beebase-1.2
msgid "_Default?"
msgstr "_Standard?"

#. from tp:beebase-1.2
msgid "If checked, a default filename\nis chosen as output."
msgstr "Om markerad väljs ett standardfilnamn\nsom utdata."

#. from tp:beebase-1.2
msgid "_Append?"
msgstr "_Lägg till?"

#. from tp:beebase-1.2
msgid "If checked, program output is appended to\nthe file specified above, otherwise the file\nis overwritten silently."
msgstr "Om markerad läggs programmets utdata till\ni den angivna filen, annars skrivs filen\növer utan varning."

#. from tp:beebase-1.2
msgid "Name of the table.  Must begin with an\nuppercase letter followed by further letters\ndigits or underscore characters.  Non-ASCII\nletters like German umlauts are not allowed."
msgstr "Namn på tabellen. Måste börja med en\nversal följt av ytterligare bokstäver,\nsiffror eller understreck. Icke-ASCII-\nbokstäver som tyska omljud är inte tillåtna."

#. from tp:beebase-1.2
msgid "Number of records"
msgstr "Antal poster"

#. from tp:beebase-1.2
msgid "Normally you specify \"Unlimited\" here.\n\"Exactly one\" may be used in some special\ncases where only one record is needed."
msgstr "Normalt anger du \"Obegränsat\" här.\n\"Exakt en\" kan användas i vissa special-\nfall där endast en post behövs."

#. from tp:beebase-1.2
msgid "Unlimited"
msgstr "Obegränsat"

#. from tp:beebase-1.2
msgid "Exactly one"
msgstr "Exakt en"

#. from tp:beebase-1.2
msgid "Trigger functions"
msgstr "Utlösarfunktioner"

#. from tp:beebase-1.2
msgid "Ne_w"
msgstr "N_y"

#. from tp:beebase-1.2
msgid "Program function that should be called\nwhenever the user wants to create a new\nrecord.  If left empty, a new record will\nbe created automatically."
msgstr "Programfunktion som anropas när\nanvändaren vill skapa en ny post.\nOm den lämnas tom skapas en ny post\nautomatiskt."

#. from tp:beebase-1.2
msgid "_Delete"
msgstr "_Radera"

#. from tp:beebase-1.2
msgid "Program function that should be called\nwhenever the user wants to delete a record.\nIf left empty, the record is deleted after\nan optional delete-record confirmation."
msgstr "Programfunktion som anropas när\nanvändaren vill radera en post.\nOm den lämnas tom raderas posten efter\nen valfri bekräftelse på radering."

#. from tp:beebase-1.2
msgid "Decides whether adding, deleting or\nchanging the contents of a record\ncounts as a change of the project.\nUncheck this item if you want to\nignore any changes in this table."
msgstr "Avgör om tillägg, borttagning eller ändring\nav innehållet i en post räknas som\nen ändring av projektet.\nAvmarkera detta om du vill att ändringar\ni tabellen inte ska räknas som projektändringar."

#. from tp:beebase-1.2
msgid "Decides whether adding, deleting, or\nchanging the contents of a record\nshould be recorded in the project log."
msgstr "Avgör om tillägg, borttagning eller\nändring av innehållet i en post\nska registreras i projektloggen."

#. from tp:beebase-1.2
msgid "Search _pattern"
msgstr "Sök_mönster"

#. from tp:beebase-1.2
msgid "String pattern to search for.  You may use\nthe special wild-card characters '*' and '?'.\n'*' matches any number of characters whereas\n'?' matches exactly one character."
msgstr "Textmönster att söka efter. Du kan använda\nde speciella jokertecknen '*' och '?'.\n'*' matchar valfritt antal tecken medan\n'?' matchar exakt ett tecken."

#. from tp:beebase-1.2
msgid "Case sensi_tive?"
msgstr "Skiftläges_känslig?"

#. from tp:beebase-1.2
msgid "If checked, string comparison is done\ncase sensitive, else case insensitive."
msgstr "Om markerad görs skillnad på stora och små bokstäver\nvid jämförelse, annars inte."

#. from tp:beebase-1.2
msgid "_All fields?"
msgstr "_Alla fält?"

#. from tp:beebase-1.2
msgid "If checked, all fields of the\ncurrent table are checked for a match,\notherwise only the currently active\nfield is checked for."
msgstr "Om markerad söks i alla fält i den\naktuella tabellen,\nannars söks endast i det aktiva\nfältet."

#. from tp:beebase-1.2
msgid "Search direction"
msgstr "Sökriktning"

#. from tp:beebase-1.2
msgid "Forward"
msgstr "Framåt"

#. from tp:beebase-1.2
msgid "Backward"
msgstr "Bakåt"

#. from tp:beebase-1.2
msgid "Start with"
msgstr "Börja med"

#. from tp:beebase-1.2
msgid "First/last record"
msgstr "Första/sista posten"

#. from tp:beebase-1.2
msgid "Searching..."
msgstr "Söker..."

#. from tp:beebase-1.2
msgid "Search pattern '%s' not found"
msgstr "Sökmönster '%s' hittades inte"

#. from tp:beebase-1.2
msgid "Delimiter"
msgstr "Avgränsare"

#. from tp:beebase-1.2
msgid "Character to be inserted\nbetween fields."
msgstr "Tecken som ska infogas\nmellan fält."

#. from tp:beebase-1.2
msgid "Spaces"
msgstr "Mellanslag"

#. from tp:beebase-1.2
msgid "Tabs"
msgstr "Tabulatorer"

#. from tp:beebase-1.2
msgid "Custom"
msgstr "Anpassad"

#. from tp:beebase-1.2
msgid "Font for printing"
msgstr "Teckensnitt för utskrift"

#. from tp:beebase-1.2
msgid "NLQ"
msgstr "NLQ"

#. from tp:beebase-1.2
msgid "Draft"
msgstr "Utkast"

#. from tp:beebase-1.2
msgid "Misc"
msgstr "Övrigt"

#. from tp:beebase-1.2
msgid "_Init sequence"
msgstr "_Initieringssekvens"

#. from tp:beebase-1.2
msgid "Escape code sequence for initializing\nthe printer. For entering characters\nyou can also use \\n, \\t, \\f, \\???\n(octal code) or \\x?? (hex code)."
msgstr "Escape-kodsekvens för initiering av\nskrivaren. För inmatning av tecken\nkan du också använda \\n, \\t, \\f, \\???\n(oktal kod) eller \\x?? (hex-kod)."

#. from tp:beebase-1.2
msgid "Inden_t"
msgstr "Indr_ag"

#. from tp:beebase-1.2
msgid "Number of spaces each\nline is indented."
msgstr "Antal mellanslag som varje\nrad dras in."

#. from tp:beebase-1.2
msgid "_Headline?"
msgstr "_Rubrik?"

#. from tp:beebase-1.2
msgid "If checked, the field names are\nprinted in the first line."
msgstr "Om markerad skrivs fältnamnen ut\npå första raden."

#. from tp:beebase-1.2
msgid "_Escape codes?"
msgstr "_Escape-koder?"

#. from tp:beebase-1.2
msgid "If not checked, all escape code sequences\n(e.g. init sequence, font selection, etc.)\nare not printed.  This is useful for\nexporting records to an ASCII file."
msgstr "Om inte markerad skrivs inga escape-kodsekvenser\n(t.ex. initieringssekvens, teckensnittval, etc.)\nut. Detta är användbart vid\nexport av poster till en ASCII-fil."

#. from tp:beebase-1.2
msgid "_Quotes?"
msgstr "_Citattecken?"

#. from tp:beebase-1.2
msgid "If checked, each field entry is\nsurrounded with double quotes."
msgstr "Om markerad omges varje fältpost\nmed dubbla citattecken."

#. from tp:beebase-1.2
msgid "Font size used for printing"
msgstr "Teckenstorlek för utskrift"

#. from tp:beebase-1.2
msgid "Pica"
msgstr "Pica"

#. from tp:beebase-1.2
msgid "Elite"
msgstr "Elit"

#. from tp:beebase-1.2
msgid "Condensed"
msgstr "Komprimerad"

#. from tp:beebase-1.2
msgid "After printing"
msgstr "Efter utskrift"

#. from tp:beebase-1.2
msgid "Characters to be printed after\nall lines have been printed."
msgstr "Tecken som ska skrivas ut efter att\nalla rader har skrivits ut."

#. from tp:beebase-1.2
msgid "Form feed"
msgstr "Sidmatning"

#. from tp:beebase-1.2
msgid "Line feeds"
msgstr "Radmatningar"

#. from tp:beebase-1.2
msgid "Nothing"
msgstr "Ingenting"

#. from tp:beebase-1.2
msgid "_#"
msgstr "_#"

#. from tp:beebase-1.2
msgid "Number of line feeds\nto be printed."
msgstr "Antal radmatningar\natt skriva ut."

#. from tp:beebase-1.2
msgid "Out_put"
msgstr "Ut_data"

#. from tp:beebase-1.2
msgid "Output file.  You may use \"Console:\" for printing\nto standard output, \"CON:////Output/CLOSE/WAIT\"\nfor printing to a CON-window, or \"PRT:\" for\nsending the output to your printer."
msgstr "Utdatafil. Du kan använda \"Console:\" för utskrift\ntill standardutdata, \"CON:////Output/CLOSE/WAIT\"\nför utskrift till ett CON-fönster eller \"PRT:\" för\natt skicka utdata till din skrivare."

#. from tp:beebase-1.2
msgid "Fit page _width?"
msgstr "Anpassa sid_bredd?"

#. from tp:beebase-1.2
msgid "If checked, the resolution\nis set such that all lines\nfit into the page width."
msgstr "Om markerad ställs upplösningen\nin så att alla rader\nryms inom sidbredden."

#. from tp:beebase-1.2
msgid "Query editor"
msgstr "Frågeredigerare"

#. from tp:beebase-1.2
msgid "Name of the query"
msgstr "Namn på frågan"

#. from tp:beebase-1.2
msgid "None"
msgstr "Ingen"

#. from tp:beebase-1.2
msgid "Table to which query belongs"
msgstr "Tabell som frågan tillhör"

#. from tp:beebase-1.2
msgid "Run..."
msgstr "Kör..."

#. from tp:beebase-1.2
msgid "Compiles and runs the query."
msgstr "Kompilerar och kör frågan."

#. from tp:beebase-1.2
msgid "Export..."
msgstr "Exportera..."

#. from tp:beebase-1.2
msgid "Exports the output of the\nquery as a text file."
msgstr "Exporterar resultatet av\nfrågan som en textfil."

