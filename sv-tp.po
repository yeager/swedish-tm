msgstr "Användning: csv2rec [FLAGGOR] … [CSV_FIL]\n"

#. from tp:recutils-1.8
msgid "Convert csv data into rec data.\n"
msgstr "Konvertera CSV-data till rec-data.\n"

#. from tp:recutils-1.8
msgid "  -t, --type=TYPE                     type name for the converted records; if this\n                                        parameter is ommited then no type is used.\n  -s, --strict                        be strict parsing the csv file.\n  -e, --omit-empty                    omit empty fields.\n"
msgstr "  -t, -type=TYP                       skriv namn för de konverterade posterna.\n                                        Om denna parameter utelämnas används\n                                        ingen typ.\n  -s, -strict                         var strikt i tolkningen av csv-filen.\n  -e, -omit-empty                     uteslut tomma fält.\n"

#. from tp:recutils-1.8
msgid "invalid field name '%s' in header\n"
msgstr "ogiltigt fältnamn ”%s” i huvudet\n"

#. from tp:recutils-1.8
msgid "%s: %lu: this line contains %lu fields, but %lu header fields were read\n"
msgstr "%s: %lu: denna rad innehåller %lu fält, men %lu huvudfält lästes\n"

