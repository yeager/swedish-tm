msgid "      --recurse-limit            Enable a limit on recursion whilst demangling\n                                  (default)\n"
msgstr "      --recurse-limit            Aktivera en gräns på rekursionen vid\n                                 avmangling (standard)\n"

#. from tp:binutils-2.45.90
msgid "      --no-recurse-limit         Disable a limit on recursion whilst demangling\n"
msgstr "      --no-recurse-limit         Avaktivera en gräns på rekursionen vid\n                                  avmangling\n"

