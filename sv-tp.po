msgid "     -l FILE        Input log"
msgstr "     -l FIL         Inmatningslogg"

#. from tp:sarg-2.4.0
msgid "     --lastlog      Set the number of previous reports to keep"
msgstr "     --lastlog      Ställ in antalet tidigare rapporter som ska sparas"

#. from tp:sarg-2.4.0
msgid "     -n             Resolve IP addresses using RDNS"
msgstr "     -n             Slå upp IP-adresser med hjälp av RDNS"

#. from tp:sarg-2.4.0
msgid "     -o DIR         Report output directory"
msgstr "     -o KAT         Katalog för rapportutmatning"

#. from tp:sarg-2.4.0
msgid "     -p             Use Ip Address instead of userid (reports)"
msgstr "     -p             Använd ip-adress istället för användaridentitet (rapporter)"

#. from tp:sarg-2.4.0
msgid "     -P PREFIX      Prepend a prefix to the splitted file names"
msgstr "     -P PREFIX      Lägg till ett prefix till de uppdelade filnamnen"

#. from tp:sarg-2.4.0
msgid "     -r             Produce real time report"
msgstr "     -r             Ta fram rapport i realtid"

#. from tp:sarg-2.4.0
msgid "     -s SITE        Limit report to accessed site [eg. www.microsoft.com]"
msgstr "     -s WEBBP       Begränsa rapporten till den åtkomliga webbplatsen [t.ex. www.microsoft.com]"

#. from tp:sarg-2.4.0
msgid "     --split        Split the log file by date in -d parameter"
msgstr "     --split        Dela upp loggfilen efter datum i parametern -d"

#. from tp:sarg-2.4.0
msgid "     --splitprefix PREFIX\n                    Prepend a prefix to the splitted file names"
msgstr "     --splitprefix PREFIX\n                    Lägg till ett prefix till de uppdelade filnamnen"

#. from tp:sarg-2.4.0
msgid "     --statistics   Print run time statistics"
msgstr "     --statistics   Skriv ut körtidsstatistik"

#. from tp:sarg-2.4.0
msgid "     -t TIME        Limit report to time range [HH:MM or HH:MM-HH:MM]"
msgstr "     -t TID         Begränsa rapporten till tidsintervallet [HH:MM eller HH:MM-HH:MM]"

#. from tp:sarg-2.4.0
msgid "     -u USER        Report only that user's activity"
msgstr "     -u ANVÄ        Rapportera endast den användarens aktivitet"

