#. from tp:coreutils-9.10-pre1
msgid "  -a, --append\n         append to the given FILEs, do not overwrite\n"
msgstr "  -a, --append\n         lägg till i slutet av angivna FILer, skriv inte över\n"

#. from tp:coreutils-9.10-pre1
