msgid "Copyright (C) 2011 Free Software Foundation, Inc.\nThis is free software; see the source for copying conditions.  There is NO\nwarranty; not even for MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.\n\n"
msgstr "Copyright (C) 2011 Free Software Foundation, Inc.\nDetta är fri programvara; se källkoden för kopieringsvillkor. Det finns INGEN\ngaranti; inte ens underförstådd garanti för SÄLJBARHET eller LÄMPLIGHET FÖR NÅGOT SPECIELLT ÄNDAMÅL.\n\n"

#. from tp:help2man-texi-1.47.17
msgid "Written by A. Programmer.\n@exstrong{$ foo --help}\nGNU `foo' does nothing interesting except serve as an example for\n`help2man'.\n\n"
msgstr "Skrivet av E. N. Programmerare.\n@exstrong{$ foo --help}\nGNU `foo' gör ingenting intressant förutom att fungera som ett exempel för\n`help2man'.\n\n"

#. from tp:help2man-texi-1.47.17
msgid "Usage: foo [OPTION]...\n\n"
msgstr "Användning: foo [FLAGGA]…\n\n"

#. from tp:help2man-texi-1.47.17
msgid "Options:\n  -a, --option      an option\n  -b, --another-option[=VALUE]\n                    another option\n\n"
msgstr "Flaggor:\n  -a, --flagga      en flagga\n  -b, --annan-flagga[=VÄRDE]\n                    en annan flagga\n\n"

