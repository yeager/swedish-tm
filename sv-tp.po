msgid "the root element is not \"locatingRules\""
msgstr "rotelementet är inte ”locatingRules”"

#. from tp:gettext-tools-1.0-pre2
msgid "at most one input file allowed"
msgstr "Högst en indatafil är tillåten"

#. from tp:gettext-tools-1.0-pre2
msgid "%s and %s are mutually exclusive"
msgstr "%s och %s är ömsesidigt uteslutande"

#. from tp:gettext-tools-1.0-pre2
msgid "Usage: %s [OPTION] [INPUTFILE]\n"
msgstr "Användning: %s [FLAGGA] [INFIL]\n"

#. from tp:gettext-tools-1.0-pre2
msgid "Filters the messages of a translation catalog according to their attributes,\nand manipulates the attributes.\n"
msgstr "Filtrerar meddelanden i en meddelandekatalog efter deras attribut och\nmanipulerar attributen.\n"

#. from tp:gettext-tools-1.0-pre2
msgid "Input file location:\n"
msgstr "Plats för infiler:\n"

#. from tp:gettext-tools-1.0-pre2
msgid "  INPUTFILE                   input PO file\n"
msgstr "  INFIL                       PO-infil\n"

#. from tp:gettext-tools-1.0-pre2
msgid "  -D, --directory=DIRECTORY   add DIRECTORY to list for input files search\n"
msgstr "  -D, --directory=KATALOG     sök infiler även i KATALOG\n"

#. from tp:gettext-tools-1.0-pre2
msgid "If no input file is given or if it is -, standard input is read.\n"
msgstr "Om ingen indatafil anges eller om den är - läses standardindata.\n"

#. from tp:gettext-tools-1.0-pre2
msgid "Output file location:\n"
msgstr "Plats för utfil:\n"

#. from tp:gettext-tools-1.0-pre2
msgid "  -o, --output-file=FILE      write output to specified file\n"
msgstr "  -o, --output-file=FIL       skriv resultat till angiven fil\n"

#. from tp:gettext-tools-1.0-pre2
msgid "The results are written to standard output if no output file is specified\nor if it is -.\n"
msgstr "Resultatet skrivs till standardutdata om ingen utdatafil anges eller om den är -.\n"

#. from tp:gettext-tools-1.0-pre2
msgid "Message selection:\n"
msgstr "Meddelandeval:\n"

#. from tp:gettext-tools-1.0-pre2
msgid "      --translated            keep translated, remove untranslated messages\n"
msgstr "      --translated            behåll översatta, ta bort oöversatta meddelanden\n"

#. from tp:gettext-tools-1.0-pre2
msgid "      --untranslated          keep untranslated, remove translated messages\n"
msgstr "      --untranslated          behåll oöversatta, ta bort översatta meddelanden\n"

#. from tp:gettext-tools-1.0-pre2
msgid "      --no-fuzzy              remove 'fuzzy' marked messages\n"
msgstr "      --no-fuzzy              ta bort meddelanden markerade som \"fuzzy\"\n"

#. from tp:gettext-tools-1.0-pre2
msgid "      --only-fuzzy            keep 'fuzzy' marked messages\n"
msgstr "      --only-fuzzy            behåll meddelanden markerade som \"fuzzy\"\n"

#. from tp:gettext-tools-1.0-pre2
msgid "      --no-obsolete           remove obsolete #~ messages\n"
msgstr "      --no-obsolete           ta bort föråldrade #~ meddelanden\n"

#. from tp:gettext-tools-1.0-pre2
msgid "      --only-obsolete         keep obsolete #~ messages\n"
msgstr "      --only-obsolete         behåll föråldrade #~ meddelanden\n"

#. from tp:gettext-tools-1.0-pre2
msgid "Attribute manipulation:\n"
msgstr "Attributmanipulation:\n"

#. from tp:gettext-tools-1.0-pre2
msgid "      --set-fuzzy             set all messages 'fuzzy'\n"
msgstr "      --set-fuzzy             markera alla meddelanden som \"fuzzy\"\n"

#. from tp:gettext-tools-1.0-pre2
msgid "      --clear-fuzzy           set all messages non-'fuzzy'\n"
msgstr "      --clear-fuzzy           ta bort \"fuzzy\"-markering från alla meddelanden\n"

#. from tp:gettext-tools-1.0-pre2
msgid "      --set-obsolete          set all messages obsolete\n"
msgstr "      --set-obsolete          markera alla meddelanden som föråldrade\n"

#. from tp:gettext-tools-1.0-pre2
msgid "      --clear-obsolete        set all messages non-obsolete\n"
msgstr "      --clear-obsolete        ta bort föråldradmarkering från alla meddelanden\n"

#. from tp:gettext-tools-1.0-pre2
msgid "      --previous              when setting 'fuzzy', keep previous msgids\n                              of translated messages.\n"
msgstr "      --previous              när \"fuzzy\" är satt, behåll föregående\n                              \"msgid\" för översatta meddelanden\n"

#. from tp:gettext-tools-1.0-pre2
msgid "      --clear-previous        remove the \"previous msgid\" from all messages\n"
msgstr "      --clear-previous        ta bort \"previous msgid\" från alla meddelanden\n"

#. from tp:gettext-tools-1.0-pre2
msgid "      --empty                 when removing 'fuzzy', also set msgstr empty\n"
msgstr "      --empty                 när \"fuzzy\" tas bort, sätt msgstr till tom sträng\n"

#. from tp:gettext-tools-1.0-pre2
msgid "      --only-file=FILE.po     manipulate only entries listed in FILE.po\n"
msgstr "      --only-file=FIL.po      bearbeta bara poster som finns i FIL.po\n"

#. from tp:gettext-tools-1.0-pre2
msgid "      --ignore-file=FILE.po   manipulate only entries not listed in FILE.po\n"
msgstr "      --ignore-file=FIL.po    bearbeta bara poster som inte finns i FIL.po\n"

#. from tp:gettext-tools-1.0-pre2
msgid "      --fuzzy                 synonym for --only-fuzzy --clear-fuzzy\n"
msgstr "      --fuzzy                 samma som --only-fuzzy --clear-fuzzy\n"

#. from tp:gettext-tools-1.0-pre2
msgid "      --obsolete              synonym for --only-obsolete --clear-obsolete\n"
msgstr "      --obsolete              samma som --only-obsolete --clear-obsolete\n"

#. from tp:gettext-tools-1.0-pre2
msgid "Input file syntax:\n"
msgstr "Syntax på infil:\n"

#. from tp:gettext-tools-1.0-pre2
msgid "  -P, --properties-input      input file is in Java .properties syntax\n"
msgstr "  -P, --properties-input      infil har \"Java .properties\"-syntax\n"

#. from tp:gettext-tools-1.0-pre2
msgid "      --stringtable-input     input file is in NeXTstep/GNUstep .strings syntax\n"
msgstr "      --stringtable-input     infil har NeXTstep/GNUstep \".strings\"-syntax\n"

#. from tp:gettext-tools-1.0-pre2
msgid "Output details:\n"
msgstr "Resultatdetaljer:\n"

#. from tp:gettext-tools-1.0-pre2
msgid "      --color                 use colors and other text attributes always\n      --color=WHEN            use colors and other text attributes if WHEN.\n                              WHEN may be 'always', 'never', 'auto', or 'html'.\n"
msgstr "      --color                 använd alltid färger och andra textattribut\n      --color=NÄR             använd färger och andra textattribut beroende på\n                              NÄR, som kan vara ”always”, ”never”, ”auto”\n                              eller ”html”.\n"

#. from tp:gettext-tools-1.0-pre2
msgid "      --style=STYLEFILE       specify CSS style rule file for --color\n"
msgstr "      --style=STILMALL        ange CSS stilmallsfil för --color\n"

#. from tp:gettext-tools-1.0-pre2
msgid "  -e, --no-escape             do not use C escapes in output (default)\n"
msgstr "  -e, --no-escape             använd inte C-kontrollsekvenser i resultatet\n                                (normalläge)\n"

#. from tp:gettext-tools-1.0-pre2
msgid "  -E, --escape                use C escapes in output, no extended chars\n"
msgstr "  -E, --escape                använd C-kontrollsekvenser i resultatet, men\n                                inga utökade tecken\n"

#. from tp:gettext-tools-1.0-pre2
msgid "      --force-po              write PO file even if empty\n"
msgstr "      --force-po              skriv PO-fil även om den är tom\n"

#. from tp:gettext-tools-1.0-pre2
msgid "  -i, --indent                write the .po file using indented style\n"
msgstr "  -i, --indent                indentera resultatet\n"

#. from tp:gettext-tools-1.0-pre2
msgid "      --no-location           do not write '#: filename:line' lines\n"
msgstr "      --no-location           skriv inte rader med \"#: filnamn:rad\"\n"

#. from tp:gettext-tools-1.0-pre2
msgid "  -n, --add-location          generate '#: filename:line' lines (default)\n"
msgstr "  -n, --add-location          skriv rader med \"#: filnamn:rad\" (normalläge)\n"

#. from tp:gettext-tools-1.0-pre2
msgid "      --strict                write out strict Uniforum conforming .po file\n"
msgstr "      --strict                strikt Uniforum-format på resultatet\n"

#. from tp:gettext-tools-1.0-pre2
msgid "  -p, --properties-output     write out a Java .properties file\n"
msgstr "  -p, --properties-output     skriv en \"Java .properties\"-fil\n"

#. from tp:gettext-tools-1.0-pre2
msgid "      --stringtable-output    write out a NeXTstep/GNUstep .strings file\n"
msgstr "      --stringtable-output    skriv en NeXTstep/GNUstep \".strings\"-fil\n"

#. from tp:gettext-tools-1.0-pre2
msgid "  -w, --width=NUMBER          set output page width\n"
msgstr "  -w, --width=ANTAL           välj antal kolumner i resultatet\n"

#. from tp:gettext-tools-1.0-pre2
msgid "      --no-wrap               do not break long message lines, longer than\n                              the output page width, into several lines\n"
msgstr "      --no-wrap               dela inte meddelanden som är längre än\n                              resultatets kolumnantal i flera rader\n"

#. from tp:gettext-tools-1.0-pre2
msgid "  -s, --sort-output           generate sorted output\n"
msgstr "  -s, --sort-output           sortera resultatet\n"

#. from tp:gettext-tools-1.0-pre2
msgid "  -F, --sort-by-file          sort output by file location\n"
msgstr "  -F, --sort-by-file          sortera resultatet efter filposition\n"

#. from tp:gettext-tools-1.0-pre2
msgid "impossible selection criteria specified (%d < n < %d)"
msgstr "omöjligt urvalskriterium angivet (%d < n < %d)"

#. from tp:gettext-tools-1.0-pre2
msgid "Usage: %s [OPTION] [INPUTFILE]...\n"
msgstr "Användning: %s [FLAGGA] [INFIL]...\n"

#. from tp:gettext-tools-1.0-pre2
msgid "Concatenates and merges the specified PO files.\nFind messages which are common to two or more of the specified PO files.\nBy using the --more-than option, greater commonality may be requested\nbefore messages are printed.  Conversely, the --less-than option may be\nused to specify less commonality before messages are printed (i.e.\n--less-than=2 will only print the unique messages).  Translations,\ncomments, extracted comments, and file positions will be cumulated, except\nthat if --use-first is specified, they will be taken from the first PO file\nto define them.\n"
msgstr "Slår ihop de angivna PO-filerna.\nHitta meddelanden som förekommer i två eller flera angivna PO-filer.\nGenom att använda --more-than kan begäras att meddelanden\nförekommer i flera filer innan de skrivs ut. På motsvarande sätt\nanvänds --less-than till att ange meddelanden som förekommer i\nfärre filer (--less-than=2 skriver endast de meddelanden som är unika).\nÖversättningar, kommentarer, extraheringskommentarer och filpositioner samlas\nihop,  utom om --use-first ges.  Då tas de endast från den första PO-filen som\ndefinierar dem.\n"

#. from tp:gettext-tools-1.0-pre2
msgid "  INPUTFILE ...               input files\n"
msgstr "  INFIL ...                   infiler\n"

#. from tp:gettext-tools-1.0-pre2
msgid "  -f, --files-from=FILE       get list of input files from FILE\n"
msgstr "  -f, --files-from=FIL        läs lista av infiler från FIL\n"

#. from tp:gettext-tools-1.0-pre2
msgid "If input file is -, standard input is read.\n"
msgstr "Om indatafilen är - läses standardindata.\n"

#. from tp:gettext-tools-1.0-pre2
msgid "  -<, --less-than=NUMBER      print messages with less than this many\n                              definitions, defaults to infinite if not set\n"
msgstr "  -<, --less-than=ANTAL       skriv meddelanden med färre än ANTAL\n                              definitioner. Standardvärde: oändligt\n"

#. from tp:gettext-tools-1.0-pre2
msgid "  ->, --more-than=NUMBER      print messages with more than this many\n                              definitions, defaults to 0 if not set\n"
msgstr "  ->, --more-than=ANTAL       skriv meddelanden med fler än ANTAL\n                              definitioner. Standardvärde: 0\n"

#. from tp:gettext-tools-1.0-pre2
msgid "  -u, --unique                shorthand for --less-than=2, requests\n                              that only unique messages be printed\n"
msgstr "  -u, --unique                samma som --less-than=2, begär att\n                              endast unika meddelanden skrivs\n"

#. from tp:gettext-tools-1.0-pre2
msgid "  -P, --properties-input      input files are in Java .properties syntax\n"
msgstr "  -P, --properties-input      infiler har \"Java .properties\"-syntax\n"

#. from tp:gettext-tools-1.0-pre2
msgid "      --stringtable-input     input files are in NeXTstep/GNUstep .strings\n                              syntax\n"
msgstr "      --stringtable-input     infiler har NeXTstep/GNUstep \".strings\"-syntax\n"

#. from tp:gettext-tools-1.0-pre2
msgid "  -t, --to-code=NAME          encoding for output\n"
msgstr "  -t, --to-code=NAMN          kodning för resultatet\n"

#. from tp:gettext-tools-1.0-pre2
msgid "      --use-first             use first available translation for each\n                              message, don't merge several translations\n"
msgstr "      --use-first             använd först hittade översättning för varje\n                              meddelande, slå inte ihop översättningar\n"

#. from tp:gettext-tools-1.0-pre2
msgid "      --lang=CATALOGNAME      set 'Language' field in the header entry\n"
msgstr "      --lang=KATALOGNAMN      sätt \"Language\"-fältet i huvudet\n"

#. from tp:gettext-tools-1.0-pre2
msgid "Peter Miller"
msgstr "Peter Miller"

#. from tp:gettext-tools-1.0-pre2
msgid "no input files given"
msgstr "inga infiler givna"

#. from tp:gettext-tools-1.0-pre2
msgid "exactly 2 input files required"
msgstr "exakt 2 infiler krävs"

#. from tp:gettext-tools-1.0-pre2
msgid "Usage: %s [OPTION] def.po ref.pot\n"
msgstr "Användning: %s [FLAGGA] def.po ref.pot\n"

#. from tp:gettext-tools-1.0-pre2
msgid "Compare two Uniforum style .po files to check that both contain the same\nset of msgid strings.  The def.po file is an existing PO file with the\ntranslations.  The ref.pot file is the last created PO file, or a PO Template\nfile (generally created by xgettext).  This is useful for checking that\nyou have translated each and every message in your program.  Where an exact\nmatch cannot be found, fuzzy matching is used to produce better diagnostics.\n"
msgstr "Jämför två .po-filer av Uniforum-typ för att kontrollera att de innehåller samma uppsättning msgid-strängar. Filen def.po är en befintlig PO-fil med översättningarna. Filen ref.pot är den senast skapade PO-filen eller en PO-mallfil (vanligen skapad av xgettext). Detta är användbart för att kontrollera att du har översatt varje meddelande i programmet. Om en exakt träff inte kan hittas används luddig matchning för att ge bättre diagnoser.\n"

#. from tp:gettext-tools-1.0-pre2
msgid "  def.po                      translations\n"
msgstr "  def.po                      översättningar\n"

#. from tp:gettext-tools-1.0-pre2
msgid "  ref.pot                     references to the sources\n"
msgstr "  ref.pot                     referenser till källkod\n"

#. from tp:gettext-tools-1.0-pre2
msgid "Operation modifiers:\n"
msgstr "Bearbetningsvarianter:\n"

#. from tp:gettext-tools-1.0-pre2
msgid "  -m, --multi-domain          apply ref.pot to each of the domains in def.po\n"
msgstr "  -m, --multi-domain          tillämpa ref.pot på var och en av domänerna i def.po\n"

#. from tp:gettext-tools-1.0-pre2
msgid "  -N, --no-fuzzy-matching     do not use fuzzy matching\n"
msgstr "  -N, --no-fuzzy-matching     använd inte luddig jämförelse\n"

#. from tp:gettext-tools-1.0-pre2
msgid "      --use-fuzzy             consider fuzzy entries\n"
msgstr "      --use-fuzzy             använd luddiga poster i resultatet\n"

#. from tp:gettext-tools-1.0-pre2
msgid "      --use-untranslated      consider untranslated entries\n"
msgstr "      --use-untranslated      beakta oöversatta meddelanden\n"

#. from tp:gettext-tools-1.0-pre2
msgid "this message is untranslated"
msgstr "detta meddelande är oöversatt"

#. from tp:gettext-tools-1.0-pre2
msgid "this message needs to be reviewed by the translator"
msgstr "detta meddelande behöver granskas av översättaren"

#. from tp:gettext-tools-1.0-pre2
msgid "this message is used but not defined"
msgstr "detta meddelande används men är inte definierat"

#. from tp:gettext-tools-1.0-pre2
msgid "but this definition is similar"
msgstr "men denna definition är likartad"

#. from tp:gettext-tools-1.0-pre2
msgid "this message is used but not defined in %s"
msgstr "detta meddelande används men är inte definierat i %s"

#. from tp:gettext-tools-1.0-pre2
msgid "warning: this message is not used"
msgstr "varning: detta meddelande används inte"

#. from tp:gettext-tools-1.0-pre2
msgid "at least two files must be specified"
msgstr "minst två filer måste anges"

#. from tp:gettext-tools-1.0-pre2
msgid "Find messages which are common to two or more of the specified PO files.\nBy using the --more-than option, greater commonality may be requested\nbefore messages are printed.  Conversely, the --less-than option may be\nused to specify less commonality before messages are printed (i.e.\n--less-than=2 will only print the unique messages).  Translations,\ncomments and extracted comments will be preserved, but only from the first\nPO file to define them.  File positions from all PO files will be\ncumulated.\n"
msgstr "Hitta meddelanden som förekommer i två eller flera angivna PO-filer.\nGenom att använda --more-than begärs att meddelanden \nförekommer i flera filer innan de skrivs ut. På motsvarande sätt\nanvänds --less-than till att ange meddelanden som förekommer i\nfärre filer (--less-than=2 skriver endast de meddelanden som är unika).\nÖversättningar, kommentarer och extraherade kommentarer bevaras, men\nendast från den första PO-filen som definierar dem. Filpositioner från\nalla filer bevaras.\n"

#. from tp:gettext-tools-1.0-pre2
msgid "  ->, --more-than=NUMBER      print messages with more than this many\n                              definitions, defaults to 1 if not set\n"
msgstr "  ->, --more-than=ANTAL       skriv meddelanden med fler än ANTAL\n                              definitioner. Standardvärde: 1\n"

#. from tp:gettext-tools-1.0-pre2
msgid "      --omit-header           don't write header with 'msgid \"\"' entry\n"
msgstr "      --omit-header           skriv inte ut huvudet med `msgid \"\"'\n"

#. from tp:gettext-tools-1.0-pre2
msgid "Converts a translation catalog to a different character encoding.\n"
msgstr "Konverterar en meddelandekatalog till en annan teckenkodning.\n"

#. from tp:gettext-tools-1.0-pre2
msgid "Conversion target:\n"
msgstr "Konverteringsmål:\n"

#. from tp:gettext-tools-1.0-pre2
msgid "The default encoding is the current locale's encoding.\n"
msgstr "Standardvärde är nuvarande lokals kodning.\n"

#. from tp:gettext-tools-1.0-pre2
msgid "  -i, --indent                indented output style\n"
msgstr "  -i, --indent                indentera resultatet\n"

#. from tp:gettext-tools-1.0-pre2
msgid "      --no-location           suppress '#: filename:line' lines\n"
msgstr "      --no-location           skriv inte rader med \"#: filnamn:rad\"\n"

#. from tp:gettext-tools-1.0-pre2
msgid "  -n, --add-location          preserve '#: filename:line' lines (default)\n"
msgstr "  -n, --add-location          bevara rader med \"#: filnamn:rad\" (normalläge)\n"

#. from tp:gettext-tools-1.0-pre2
msgid "      --strict                strict Uniforum output style\n"
msgstr "      --strict                strikt Uniforum-format på resultatet\n"

#. from tp:gettext-tools-1.0-pre2
msgid "no input file given"
msgstr "Ingen indatafil angavs"

#. from tp:gettext-tools-1.0-pre2
msgid "exactly one input file required"
msgstr "exakt en infil krävs"

#. from tp:gettext-tools-1.0-pre2
msgid "Usage: %s [OPTION] INPUTFILE\n"
msgstr "Användning: %s [FLAGGA] INFIL\n"

#. from tp:gettext-tools-1.0-pre2
msgid "Creates an English translation catalog.  The input file is the last\ncreated English PO file, or a PO Template file (generally created by\nxgettext).  Untranslated entries are assigned a translation that is\nidentical to the msgid.\n"
msgstr "Skapar en engelsk meddelandekatalog.  Infilen är den senast skapade\nengelska PO-filen eller en PO-mönsterfil (ofta skapad med xgettext).\nOöversatta poster ges en översättning som är identisk med msgid.\n"

#. from tp:gettext-tools-1.0-pre2
msgid "  INPUTFILE                   input PO or POT file\n"
msgstr "  INFIL                       PO- eller POT-infil\n"

#. from tp:gettext-tools-1.0-pre2
msgid "missing command name"
msgstr "kommandonamn saknas"

#. from tp:gettext-tools-1.0-pre2
msgid "Usage: %s [OPTION] COMMAND [COMMAND-OPTION]\n"
msgstr "Användning: %s [FLAGGA] KOMMANDO [KOMMANDOFLAGGOR]\n"

#. from tp:gettext-tools-1.0-pre2
msgid "Applies a command to all translations of a translation catalog.\nThe COMMAND can be any program that reads a translation from standard\ninput.  It is invoked once for each translation.  Its output becomes\nmsgexec's output.  msgexec's return code is the maximum return code\nacross all invocations.\n"
msgstr "Tillämpa ett kommando på alla översättningar i en meddelandekatalog.\nKOMMANDO kan vara vilket program som helst som läser en översättning från\nstandardindata. Det körs en gång för varje översättning. Dess utdata blir\nmsgexecs utdata. Msgexecs slutstatus är den högsta slutstatusen från alla\nkörningar.\n"

#. from tp:gettext-tools-1.0-pre2
msgid "A special builtin command called '0' outputs the translation, followed by a\nnull byte.  The output of \"msgexec 0\" is suitable as input for \"xargs -0\".\n"
msgstr "Ett särskilt inbyggt kommando med namnet ”0” skriver ut översättningen följd av en nollbyte. Utdata från ”msgexec 0” kan användas som indata för ”xargs -0”.\n"

#. from tp:gettext-tools-1.0-pre2
msgid "Command input:\n"
msgstr "Kommandoindata:\n"

#. from tp:gettext-tools-1.0-pre2
msgid "  --newline                   add newline at the end of input\n"
msgstr "  --newline                   lägg till en nyrad vid slutet av indata\n"

#. from tp:gettext-tools-1.0-pre2
msgid "  -i, --input=INPUTFILE       input PO file\n"
msgstr "  -i, --input=INFIL           PO-infil\n"

#. from tp:gettext-tools-1.0-pre2
msgid "write to stdout failed"
msgstr "Skrivning till standardutdata misslyckades"

#. from tp:gettext-tools-1.0-pre2
msgid "write to %s subprocess failed"
msgstr "skrivning till %s-barnprocess misslyckades"

#. from tp:gettext-tools-1.0-pre2
msgid "missing filter name"
msgstr "filternamn saknas"

#. from tp:gettext-tools-1.0-pre2
msgid "at least one sed script must be specified"
msgstr "minst ett sed-skript måste anges"

#. from tp:gettext-tools-1.0-pre2
msgid "Usage: %s [OPTION] FILTER [FILTER-OPTION]\n"
msgstr "Användning: %s [FLAGGA] FILTER [FILTERFLAGGOR]\n"

#. from tp:gettext-tools-1.0-pre2
msgid "Applies a filter to all translations of a translation catalog.\n"
msgstr "Tillämpar ett filter på alla översättningar i en meddelandekatalog.\n"

#. from tp:gettext-tools-1.0-pre2
msgid "The FILTER can be any program that reads a translation from standard input\nand writes a modified translation to standard output.\n"
msgstr "FILTER kan vara vilket program som helst som läser en översättning från\nstandardindata och skriver den ändrade översättningen till standardutdata.\n"

#. from tp:gettext-tools-1.0-pre2
msgid "Filter input and output:\n"
msgstr "Filterindata och -utdata:\n"

#. from tp:gettext-tools-1.0-pre2
msgid "  --newline                   add a newline at the end of input and\n                                remove a newline from the end of output"
msgstr "  --newline                   lägg till en nyrad till slutet av indata och\n                                ta bort en nyrad från slutet av utdata"

#. from tp:gettext-tools-1.0-pre2
msgid "Useful FILTER-OPTIONs when the FILTER is 'sed':\n"
msgstr "Användbara FILTERFLAGGOR när FILTER är \"sed\":\n"

#. from tp:gettext-tools-1.0-pre2
msgid "  -e, --expression=SCRIPT     add SCRIPT to the commands to be executed\n"
msgstr "  -e, --expression=SKRIPT     lägg till SKRIPT till kommandon att exekvera\n"

#. from tp:gettext-tools-1.0-pre2
msgid "  -f, --file=SCRIPTFILE       add the contents of SCRIPTFILE to the commands\n                                to be executed\n"
msgstr "  -f, --file=SKRIPTFIL        lägg till innehållet i SKRIPTFIL till kommandon\n                                att exekvera\n"

#. from tp:gettext-tools-1.0-pre2
msgid "  -n, --quiet, --silent       suppress automatic printing of pattern space\n"
msgstr "  -n, --quiet, --silent       undertryck automatisk utskrift av mönsterutrymmet\n"

#. from tp:gettext-tools-1.0-pre2
msgid "      --no-escape             do not use C escapes in output (default)\n"
msgstr "      --no-escape             använd inte C-kontrollsekvenser i resultatet\n                                (normalläge)\n"

#. from tp:gettext-tools-1.0-pre2
msgid "      --indent                indented output style\n"
msgstr "      --indent                indentera resultatet\n"

#. from tp:gettext-tools-1.0-pre2
msgid "      --keep-header           keep header entry unmodified, don't filter it\n"
msgstr "Bevara huvudposten oförändrad; filtrera den inte\n"

#. from tp:gettext-tools-1.0-pre2
msgid "filter output is not terminated with a newline"
msgstr "filterutdata avslutas inte med en nyrad"

#. from tp:gettext-tools-1.0-pre2
msgid "the argument to %s should be a single punctuation character"
msgstr "argumentet till %s ska vara ett enskilt skiljetecken"

#. from tp:gettext-tools-1.0-pre2
msgid "invalid endianness: %s"
msgstr "ogiltig byteordning: %s"

#. from tp:gettext-tools-1.0-pre2
msgid "no input file should be given if %s and %s are specified"
msgstr "ingen infil ska anges om %s och %s är givna"

#. from tp:gettext-tools-1.0-pre2
msgid "%s is only valid with %s"
msgstr "%s är endast giltig med %s"

#. from tp:gettext-tools-1.0-pre2
msgid "%s requires a \"-d directory\" specification"
msgstr "%s kräver att \"-d katalog\" anges"

#. from tp:gettext-tools-1.0-pre2
msgid "%s requires a \"-l locale\" specification"
msgstr "%s kräver att \"-l lokal\" anges"

#. from tp:gettext-tools-1.0-pre2
msgid "%s requires a \"--template template\" specification"
msgstr "%s kräver att \"--template mall\" anges"

#. from tp:gettext-tools-1.0-pre2
msgid "%s requires a \"-o file\" specification"
msgstr "%s kräver att \"-o fil\" anges"

#. from tp:gettext-tools-1.0-pre2
msgid "%s and %s are mutually exclusive in %s"
msgstr "%s och %s är ömsesidigt uteslutande i %s"

#. from tp:gettext-tools-1.0-pre2
msgid "%s is only valid with %s or %s"
msgstr "%s är endast giltig med %s eller %s"

#. from tp:gettext-tools-1.0-pre2
msgid "%s is only valid with %s, %s or %s"
msgstr "%s är endast giltig med %s, %s eller %s"

#. from tp:gettext-tools-1.0-pre2
msgid "cannot locate ITS rules for %s"
msgstr "kan inte hitta ITS-regler för %s"

#. from tp:gettext-tools-1.0-pre2
msgid "%s: "
msgstr "%s: "

#. from tp:gettext-tools-1.0-pre2
msgid "Usage: %s [OPTION] filename.po ...\n"
msgstr "Användning: %s [FLAGGA] filnamn.po ...\n"

#. from tp:gettext-tools-1.0-pre2
msgid "Generate binary message catalog from textual translation description.\n"
msgstr "Generera en binär meddelandekatalog från en textuell beskrivning av översättning.\n"

#. from tp:gettext-tools-1.0-pre2
msgid "  filename.po ...             input files\n"
msgstr "  filnamn.po ...              infiler\n"

#. from tp:gettext-tools-1.0-pre2
msgid "  -j, --java                  Java mode: generate a Java ResourceBundle class\n"
msgstr "  -j, --java                  Javaläge: generera en Java ResourceBundle-klass\n"

#. from tp:gettext-tools-1.0-pre2
msgid "      --java2                 like --java, and assume Java2 (JDK 1.2 or higher)\n"
msgstr "      --java2                 som --java, och anta Java2 (JDK 1.2 eller högre)\n"

#. from tp:gettext-tools-1.0-pre2
msgid "      --csharp                C# mode: generate a .NET .dll file\n"
msgstr "      --csharp                C#-läge: generera en .NET .dll-fil\n"

#. from tp:gettext-tools-1.0-pre2
msgid "      --csharp-resources      C# resources mode: generate a .NET .resources file\n"
msgstr "      --csharp-resources      C#-resursläge: generera en .NET .resources-fil\n"

#. from tp:gettext-tools-1.0-pre2
msgid "      --tcl                   Tcl mode: generate a tcl/msgcat .msg file\n"
msgstr "      --tcl                   Tcl-läge: generera en .msg-fil av tcl/msgcat-typ\n"

#. from tp:gettext-tools-1.0-pre2
msgid "      --qt                    Qt mode: generate a Qt .qm file\n"
msgstr "      --qt                    Qt-läge: generera en Qt .qm-fil\n"

#. from tp:gettext-tools-1.0-pre2
msgid "      --desktop               Desktop Entry mode: generate a .desktop file\n"
msgstr "      --desktop               \"Desktop Entry\"-läge: generera en .desktop-fil\n"

#. from tp:gettext-tools-1.0-pre2
msgid "      --xml                   XML mode: generate XML file\n"
msgstr "      --xml                   XML-läge: generera en XML-fil\n"

#. from tp:gettext-tools-1.0-pre2
msgid "      --strict                enable strict Uniforum mode\n"
msgstr "      --strict                strikt Uniforum-format på resultatet\n"

#. from tp:gettext-tools-1.0-pre2
msgid "If output file is -, output is written to standard output.\n"
msgstr "Om utdatafilen är - skrivs resultatet till standardutdata.\n"

#. from tp:gettext-tools-1.0-pre2
msgid "Output file location in Java mode:\n"
msgstr "Plats för utfil i Javaläge:\n"

#. from tp:gettext-tools-1.0-pre2
msgid "  -r, --resource=RESOURCE     resource name\n"
msgstr "  -r, --resource=RESURS       resursnamn\n"

#. from tp:gettext-tools-1.0-pre2
msgid "  -l, --locale=LOCALE         locale name, either language or language_COUNTRY\n"
msgstr "  -l, --locale=LOKAL          lokalnamn, antingen språk eller språk_LAND\n"

#. from tp:gettext-tools-1.0-pre2
msgid "      --source                produce a .java file, instead of a .class file\n"
msgstr "      --source                generera en .java-fil istället för en .class-fil\n"

#. from tp:gettext-tools-1.0-pre2
msgid "  -d DIRECTORY                base directory of classes directory hierarchy\n"
msgstr "  -d KATALOG                  startkatalog för klassers katalogträd\n"

#. from tp:gettext-tools-1.0-pre2
msgid "The class name is determined by appending the locale name to the resource name,\nseparated with an underscore.  The -d option is mandatory.  The class is\nwritten under the specified directory.\n"
msgstr "Klassnamnet härleds genom att lägga till lokalnamnet till resursnamnet\navskiljt med ett understreck.  Flaggan -d är obligatorisk.  Klassen skrivs\ntill den givna katalogen.\n"

#. from tp:gettext-tools-1.0-pre2
msgid "Output file location in C# mode:\n"
msgstr "Plats för utfil i C#-läge:\n"

#. from tp:gettext-tools-1.0-pre2
msgid "  -d DIRECTORY                base directory for locale dependent .dll files\n"
msgstr "  -d KATALOG                  startkatalog för lokalberoende .dll-filer\n"

#. from tp:gettext-tools-1.0-pre2
msgid "The -l and -d options are mandatory.  The .dll file is written in a\nsubdirectory of the specified directory whose name depends on the locale.\n"
msgstr "Flaggorna -l och -d är obligatoriska.  .dll-filen skrivs till en underkatalog\ntill den angivna katalogen vars namn beror på lokalen.\n"

#. from tp:gettext-tools-1.0-pre2
msgid "Output file location in Tcl mode:\n"
msgstr "Plats för utfil i Tcl-läge:\n"

#. from tp:gettext-tools-1.0-pre2
msgid "  -d DIRECTORY                base directory of .msg message catalogs\n"
msgstr "  -d KATALOG                  startkatalog för .msg-meddelandekataloger\n"

#. from tp:gettext-tools-1.0-pre2
msgid "The -l and -d options are mandatory.  The .msg file is written in the\nspecified directory.\n"
msgstr "Flaggorna -l och -d är obligatoriska.  .msg-filen skrivs till den givna\nkatalogen.\n"

#. from tp:gettext-tools-1.0-pre2
msgid "Desktop Entry mode options:\n"
msgstr "Flaggor för \"Desktop Entry\"-läge\n"

#. from tp:gettext-tools-1.0-pre2
msgid "  --template=TEMPLATE         a .desktop file used as a template\n"
msgstr "  --template=MALL             en .desktop-fil att använda som mall\n"

#. from tp:gettext-tools-1.0-pre2
msgid "  -d DIRECTORY                base directory of .po files\n"
msgstr "  -d KATALOG                  baskatalog för .po-filer\n"

#. from tp:gettext-tools-1.0-pre2
msgid "  -kWORD, --keyword=WORD      look for WORD as an additional keyword\n  -k, --keyword               do not to use default keywords\n"
msgstr "  -kORD, --keyword=ORD        sök efter ORD som ett extra nyckelord\n  -k, --keyword               använd inte standardnyckelord\n"

#. from tp:gettext-tools-1.0-pre2
msgid "The -l, -o, and --template options are mandatory.  If -D is specified, input\nfiles are read from the directory instead of the command line arguments.\n"
msgstr "Flaggorna -l, -o och --template är obligatoriska.  Om -D är given så läses\nindatafiler från katalogen och inte från kommandoradsargument.\n"

#. from tp:gettext-tools-1.0-pre2
msgid "XML mode options:\n"
msgstr "XML-lägesflaggor:\n"

#. from tp:gettext-tools-1.0-pre2
msgid "  -L, --language=NAME         recognise the specified XML language\n"
msgstr "  -L, --language=NAMN         känn igen det angivna XML-språket\n"

#. from tp:gettext-tools-1.0-pre2
msgid "  --template=TEMPLATE         an XML file used as a template\n"
msgstr "  --template=MALL             en XML-fil använd som en mall\n"

#. from tp:gettext-tools-1.0-pre2
msgid "  --replace-text              output XML with translated text replacing the\n                              original text, not augmenting the original text\n"
msgstr "  --replace-text              skriv ut XML med originaltexten ersatt av\n                              översatt text, komplettera inte originaltexten\n"

#. from tp:gettext-tools-1.0-pre2
msgid "Input file interpretation:\n"
msgstr "Tolkning av infil:\n"

#. from tp:gettext-tools-1.0-pre2
msgid "  -c, --check                 perform all the checks implied by\n                                --check-format, --check-header, --check-domain\n"
msgstr "  -c, --check                 utför alla kontroller som innebär\n                                --check-format, --check-header, --check-domain\n"

#. from tp:gettext-tools-1.0-pre2
msgid "      --check-format          check language dependent format strings\n"
msgstr "      --check-format          kontrollera språkberoende formatsträngar\n"

#. from tp:gettext-tools-1.0-pre2
msgid "      --check-header          verify presence and contents of the header entry\n"
msgstr "      --check-header          verifiera närvaro och innehåll av huvudrader\n"

#. from tp:gettext-tools-1.0-pre2
msgid "      --check-domain          check for conflicts between domain directives\n                                and the --output-file option\n"
msgstr "      --check-domain          kontrollera konflikter mellan domändirektiv\n                                och flaggan --output-file\n"

#. from tp:gettext-tools-1.0-pre2
msgid "  -C, --check-compatibility   check that GNU msgfmt behaves like X/Open msgfmt\n"
msgstr "  -C, --check-compatibility   kontrollera att GNU msgfmt uppför sig som\n                                X/Open msgfmt\n"

#. from tp:gettext-tools-1.0-pre2
msgid "      --check-accelerators[=CHAR]  check presence of keyboard accelerators for\n                                menu items\n"
msgstr "      --check-accelerators[=TKN]   kontrollera närvaron av tangentkortkommandon\n                                för menyer\n"

#. from tp:gettext-tools-1.0-pre2
msgid "  -f, --use-fuzzy             use fuzzy entries in output\n"
msgstr "  -f, --use-fuzzy             använd luddiga poster i resultatet\n"

#. from tp:gettext-tools-1.0-pre2
msgid "      --no-convert            don't convert the messages to UTF-8 encoding\n"
msgstr "      --no-convert            konvertera inte meddelandena till UTF-8-kodning\n"

#. from tp:gettext-tools-1.0-pre2
msgid "      --no-redundancy         don't pre-expand ISO C 99 <inttypes.h>\n                                format string directive macros\n"
msgstr "      --no-redundancy         förexpandera inte ISO C 99 <inttypes.h>\n                                makron för formatsträngsdirektiv\n"

#. from tp:gettext-tools-1.0-pre2
msgid "  -a, --alignment=NUMBER      align strings to NUMBER bytes (default: %d)\n"
msgstr "  -a, --alignment=TAL         justera strängar till TAL byte (normalt: %d)\n"

#. from tp:gettext-tools-1.0-pre2
msgid "      --endianness=BYTEORDER  write out 32-bit numbers in the given byte order\n                                (big or little, default depends on platform)\n"
msgstr "      --endianness=BYTEORDN   skriv 32-bitarstal i given byteordning\n                                (big eller little, standard beror på plattform)\n"

#. from tp:gettext-tools-1.0-pre2
msgid "      --no-hash               binary file will not include the hash table\n"
msgstr "      --no-hash               binärfil innehåller inte hashtabellen\n"

#. from tp:gettext-tools-1.0-pre2
msgid "      --statistics            print statistics about translations\n"
msgstr "      --statistics            skriv ut statistik om översättningarna\n"

#. from tp:gettext-tools-1.0-pre2
msgid "  -v, --verbose               increase verbosity level\n"
msgstr "  -v, --verbose               öka mängden information i meddelanden\n"

#. from tp:gettext-tools-1.0-pre2
msgid "warning: PO file header missing or invalid\n"
msgstr "varning: PO-filens huvudrader saknas eller är ogiltiga\n"

#. from tp:gettext-tools-1.0-pre2
msgid "warning: charset conversion will not work\n"
msgstr "varning: konvertering till användarens teckenuppsättning kommer att misslyckas.\n"

#. from tp:gettext-tools-1.0-pre2
msgid "domain name \"%s\" not suitable as file name"
msgstr "domännamnet \"%s\" är inte lämpligt som filnamn"

#. from tp:gettext-tools-1.0-pre2
msgid "domain name \"%s\" not suitable as file name: will use prefix"
msgstr "domännamnet \"%s\" är inte lämpligt som filnamn: använder ett prefix"

#. from tp:gettext-tools-1.0-pre2
msgid "'domain %s' directive ignored"
msgstr "direktivet \"domain %s\" ignoreras"

#. from tp:gettext-tools-1.0-pre2
msgid "empty 'msgstr' entry ignored"
msgstr "tom \"msgstr\"-rad ignorerad"

#. from tp:gettext-tools-1.0-pre2
msgid "fuzzy 'msgstr' entry ignored"
msgstr "luddig \"msgstr\"-rad ignorerad"

#. from tp:gettext-tools-1.0-pre2
msgid "%s: warning: source file contains fuzzy translation"
msgstr "%s: varning: källfilen innehåller luddiga översättningar"

#. from tp:gettext-tools-1.0-pre2
msgid "%s does not exist"
msgstr "%s finns inte"

#. from tp:gettext-tools-1.0-pre2
msgid "%s exists but cannot read"
msgstr "%s finns men kan inte läsas"

#. from tp:gettext-tools-1.0-pre2
msgid "option '%c' cannot be used before 'J' or 'K' or 'T' or 'C' or 'X' has been specified"
msgstr "Flaggan ”%c” kan inte användas innan ”J”, ”K”, ”T”, ”C” eller ”X” har angetts"

#. from tp:gettext-tools-1.0-pre2
msgid "Extracts all messages of a translation catalog that match a given pattern\nor belong to some given source files.\n"
msgstr "Extraherar alla meddelanden i en meddelandekatalog som matchar ett visst\nmönster eller hör till någon given källkodsfil.\n"

#. from tp:gettext-tools-1.0-pre2
msgid "Message selection:\n  [-N SOURCEFILE]... [-M DOMAINNAME]...\n  [-J MSGCTXT-PATTERN] [-K MSGID-PATTERN] [-T MSGSTR-PATTERN]\n  [-C COMMENT-PATTERN] [-X EXTRACTED-COMMENT-PATTERN]\n  [-W WORKFLOW-FLAG] [-S STICKY-FLAG]\nA message is selected if it comes from one of the specified source files,\nor if it comes from one of the specified domains,\nor if -J is given and its context (msgctxt) matches MSGCTXT-PATTERN,\nor if -K is given and its key (msgid or msgid_plural) matches MSGID-PATTERN,\nor if -T is given and its translation (msgstr) matches MSGSTR-PATTERN,\nor if -C is given and the translator's comment matches COMMENT-PATTERN,\nor if -X is given and the extracted comment matches EXTRACTED-COMMENT-PATTERN,\nor if -W is given and its flags contain WORKFLOW-FLAG,\nor if -S is given and its flags contain STICKY-FLAG.\n\nWhen more than one selection criterion is specified, the set of selected\nmessages is the union of the selected messages of each criterion.\n\nMSGCTXT-PATTERN or MSGID-PATTERN or MSGSTR-PATTERN or COMMENT-PATTERN or\nEXTRACTED-COMMENT-PATTERN syntax:\n  [-E | -F] [-e PATTERN | -f FILE]...\nPATTERNs are basic regular expressions by default, or extended regular\nexpressions if -E is given, or fixed strings if -F is given.\n\n  -N, --location=SOURCEFILE   select messages extracted from SOURCEFILE\n  -M, --domain=DOMAINNAME     select messages belonging to domain DOMAINNAME\n  -J, --msgctxt               start of patterns for the msgctxt\n  -K, --msgid                 start of patterns for the msgid\n  -T, --msgstr                start of patterns for the msgstr\n  -C, --comment               start of patterns for the translator's comment\n  -X, --extracted-comment     start of patterns for the extracted comment\n  -E, --extended-regexp       PATTERN is an extended regular expression\n  -F, --fixed-strings         PATTERN is a set of newline-separated strings\n  -e, --regexp=PATTERN        use PATTERN as a regular expression\n  -f, --file=FILE             obtain PATTERN from FILE\n  -i, --ignore-case           ignore case distinctions\n  -W, --workflow-flag=FLAG    select messages with FLAG\n  -S, --sticky-flag=FLAG      select messages with FLAG\n  -v, --invert-match          output only the messages that do not match any\n                              selection criterion\n"
msgstr "Meddelandeval:\n  [-N KÄLLKODSFIL]... [-M DOMÄNNAMN]...\n  [-J MSGCTXT-MÖNSTER] [-K MSGID-MÖNSTER] [-T MSGSTR-MÖNSTER]\n  [-C KOMMENTARSMÖNSTER] [-X EXTRAHERAD-KOMMENTARSMÖNSTER]\n  [-W ARBETSFLÖDESFLAGGA] [-S FAST-FLAGGA]\nEtt meddelande väljs om det kommer från en av de angivna källkodsfilerna,\neller om det kommer från en av de angivna domänerna,\neller om -J ges och kontexten (msgctxt) matchar MSGCTXT-MÖNSTER,\neller om -K ges och nyckeln (msgid eller msgid_plural) matchar MSGID-MÖNSTER,\neller om -T ges och översättningen (msgstr) matchar MSGSTR-MÖNSTER,\neller om -C ges och översättarens kommentar matchar KOMMENTARSMÖNSTER\neller om -X ges och den extraherade kommentaren matchar EXTRAHERAD-KOMMENTARSMÖNSTER.\neller om -W ges och dess flaggor innehåller ARBETSFLÖDESFLAGGA\neller om -S ges och dess flaggor innehåller FAST-FLAGGA\n\nNär fler än ett urvalskriteria anges är mängden valda meddelanden unionen\nav utvalda meddelanden för varje enskilt kriterium.\n\nSyntax för MSGCTXT-MÖNSTER, MSGID-MÖNSTER, MSGSTR-MÖNSTER, KOMMENTARSMÖNSTER\neller EXTRAHERAD-KOMMENTARSMÖNSTER:\n  [-E | -F] [-e MÖNSTER | -f FIL]...\nMÖNSTER är normala reguljära uttryck\neller utökade reguljära uttryck om -E ges\neller vanliga strängar om -F ges.\n\n  -N, --location=KÄLLKODFIL   välj meddelanden extraherade från KÄLLKODFIL\n  -M, --domain=DOMÄNNAMN      välj meddelanden som hör till domän DOMÄNNAMN\n  -J, --msgctxt               start av mönster för kontext (msgctxt)\n  -K, --msgid                 start av mönster för id (msgid)\n  -T, --msgstr                start av mönster för översättning (msgstr)\n  -C, --comment               start av mönster för översättarens kommentarer\n  -X, --extracted-comment     start av mönster för extraherad kommentar\n  -E, --extended-regexp       MÖNSTER är ett utökat reguljärt uttryck\n  -F, --fixed-strings         MÖNSTER är en mängd av nyradsseparerade strängar\n  -e, --regexp=MÖNSTER        använd MÖNSTER som ett reguljärt uttryck\n  -f, --file=FIL              hämta MÖNSTER från FIL\n  -i, --ignore-case           versaler och gemener jämförs lika\n  -W, --workflow-flag=FLAGGA  välj meddelanden med FLAGGA\n  -S, --sticky-flag=FLAGGA    välj meddelanden med FLAGGA\n  -v, --invert-match          skriv ut endast de meddelanden som inte matchar\n                              något urvalskriteria.\n"

#. from tp:gettext-tools-1.0-pre2
msgid "      --escape                use C escapes in output, no extended chars\n"
msgstr "      --escape                använd C-kontrollsekvenser i resultatet, men\n                                inga utökade tecken\n"

