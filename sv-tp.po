#. from tp:e2fsprogs-1.47.3-rc1
msgid "\nThe @S could not be read or does not describe a valid ext2/ext3/ext4\n@f.  If the @v is valid and it really contains an ext2/ext3/ext4\n@f (and not swap or ufs or something else), then the @S\nis corrupt, and you might try running e2fsck with an alternate @S:\n    e2fsck -b 8193 <@v>\n or\n    e2fsck -b 32768 <@v>\n\n"
msgstr "\nSuperblocket kunde inte läsas eller beskriver inte ett giltigt\next2/ext3/ext4-filsystem. Om enheten är giltig och verkligen innehåller ett\next2/ext3/ext4-filsystem (och inte växlingsutrymme, ufs eller något annat),\när superblocket skadat och du kan försöka köra e2fsck med ett alternativt\nsuperblock:\n    e2fsck -b 8193 <enhet>\n eller\n    e2fsck -b 32768 <enhet>\n\n"

#. from tp:e2fsprogs-1.47.3-rc1
msgid "The @f size (according to the @S) is %b @bs\nThe physical size of the @v is %c @bs\nEither the @S or the partition table is likely to be corrupt!\n"
msgstr "Filsystemsstorleken (enligt superblocket) är %b block\nDen fysiska storleken på enheten är %c block\nSuperblocket eller partitionstabellen är förmodligen trasig!\n"

#. from tp:e2fsprogs-1.47.3-rc1
msgid "@S @b_size = %b, fragsize = %c.\nThis version of e2fsck does not support fragment sizes different\nfrom the @b size.\n"
msgstr "Superblockets blockstorlek = %b, fragmentstorlek = %c.\nDen här versionen av e2fsck stöder inte andra fragmentstorlekar än\nblockstorleken.\n"

#. from tp:e2fsprogs-1.47.3-rc1
msgid "@S @bs_per_group = %b, should have been %c\n"
msgstr "Superblockets block per grupp = %b, skulle ha varit %c\n"

#. from tp:e2fsprogs-1.47.3-rc1
msgid "@S first_data_@b = %b, should have been %c\n"
msgstr "Superblockets första datablock = %b, skulle ha varit %c\n"

#. from tp:e2fsprogs-1.47.3-rc1
msgid "@f did not have a UUID; generating one.\n\n"
msgstr "filsystemet hade ingen UUID; genererar en.\n\n"

#. from tp:e2fsprogs-1.47.3-rc1
msgid "Note: if several inode or block bitmap blocks or part\nof the inode table require relocation, you may wish to try\nrunning e2fsck with the '-b %S' option first.  The problem\nmay lie only with the primary block group descriptors, and\nthe backup block group descriptors may be OK.\n\n"
msgstr "Observera: om flera inod- eller blockbitkarteblock eller en del\nav inodstabellen måste flyttas, kanske du vill köra e2fsck med\nflaggan ”-b %S” först. Problemet kan ligga endast i den primära\nblockgruppbeskrivaren och reservblockgruppbeskrivaren kan vara okej.\n\n"

