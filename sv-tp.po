msgid "      --idle        tells the IMAP server to send notice of new messages\n"
msgstr "      --idle        begär att IMAP-servern skickar aviseringar om nya meddelanden\n"

#. from tp:fetchmail-6.6.0.rc3
msgid "      --forceidle   Force idle mode, even if server does not advertise the capability\n"
msgstr "      --forceidle   framtvinga viloläge även om servern inte annonserar funktionen\n"

