msgid "B<nntp_pipeline_limit>"
msgstr "B<nntp_pipeline_limit>"

#. from tp:tin-man-2.6.5
msgid "Number of pipelined NNTP commands to send. Set to 1 if server does not support pipelining. Default is 50. Allowed maximum is 256."
msgstr "Antal pipelinerade NNTP-kommandon som ska skickas. Ställ in på 1 om servern inte stöder pipelining. Standardvärdet är 50. Det maximala tillåtna värdet är 256."

#. from tp:tin-man-2.6.5
msgid "B<cache_overview_files>"
msgstr "B<cache_overview_files>"

#. from tp:tin-man-2.6.5
msgid "Identical to the tinrc variable of the same name but overrides it.  Be aware that the serverrc variable will not be promoted to the tinrc, but the tinrc variable will be promoted to the serverrc if changed in the B<OptionMenu> ('B<M>')."
msgstr "Identisk med variabeln tinrc med samma namn, men åsidosätter den.  Observera att variabeln serverrc inte kommer att flyttas upp till tinrc, men variabeln tinrc kommer att flyttas upp till serverrc om den ändras i B<OptionMenu> en ('B<M>')."

