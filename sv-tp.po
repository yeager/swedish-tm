msgid "      --plugout     specify external command to open smtp connection\n"
msgstr "      --plugout     ange externt kommando för att öppna SMTP-anslutning\n"

#. from tp:fetchmail-6.6.0.rc3
msgid "      --bad-header {reject|accept}\n                    specify policy for handling messages with bad headers\n"
msgstr "      --bad-header {reject|accept}\n                    ange policy för hantering av meddelanden med felaktiga huvuden\n"

#. from tp:fetchmail-6.6.0.rc3
msgid "  -p, --proto[col]  specify retrieval protocol (see man page)\n"
msgstr "  -p, --proto[col]  ange protokoll för hämtning (se manualsidan)\n"

