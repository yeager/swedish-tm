msgstr "    Åtkomst: %x\nModifiering: %y\n    Ändring: %z\n     Skapad: %w\n"

#. from tp:coreutils-9.10-pre1
msgid "Display file or file system status.\n"
msgstr "Visa fil- eller filsystemstatus.\n"

#. from tp:coreutils-9.10-pre1
msgid "  -L, --dereference\n         follow links\n"
msgstr "  -L, --dereference\n         följ länkar\n"

#. from tp:coreutils-9.10-pre1
msgid "  -f, --file-system\n         display file system status instead of file status\n"
msgstr "  -f, --file-system\n         visa filsystemstatus istället för filstatus\n"

#. from tp:coreutils-9.10-pre1
msgid "      --cached=MODE\n         specify how to use cached attributes;\n         useful on remote file systems. See MODE below\n"
msgstr "      --cached=LÄGE\n         ange hur cachade attribut används;\n         användbart på fjärrfilsystem. Se LÄGE nedan\n"

#. from tp:coreutils-9.10-pre1
msgid "  -c, --format=FORMAT\n         use the specified FORMAT instead of the default;\n         output a newline after each use of FORMAT\n"
msgstr "  -c, --format=FORMAT\n         använd angivet FORMAT istället för standardformat;\n         skriv ut en nyrad efter varje användning av FORMAT\n"

#. from tp:coreutils-9.10-pre1
msgid "      --printf=FORMAT\n         like --format, but interpret backslash escapes,\n         and do not output a mandatory trailing newline;\n         if you want a newline, include \\n in FORMAT\n"
msgstr "      --printf=FORMAT\n         som --format, men tolka specialkoder med omvända snedstreck,\n         och skriv inte ut en obligatorisk avslutande nyrad;\n         om du vill ha en nyrad, ta med \\n i FORMAT\n"

#. from tp:coreutils-9.10-pre1
msgid "  -t, --terse\n         print the information in terse form\n"
msgstr "  -t, --terse\n         skriv informationen i kortfattad form\n"

#. from tp:coreutils-9.10-pre1
msgid "\nThe MODE argument of --cached can be: always, never, or default.\n'always' will use cached attributes if available, while\n'never' will try to synchronize with the latest attributes, and\n'default' will leave it up to the underlying file system.\n"
msgstr "\nArgumentet LÄGE till --cached kan vara: always, never eller default.\n”always” använder cachade attribut om de finns, medan\n”never” försöker synkronisera med de senaste attributen och\n”default” överlåter detta till det underliggande filsystemet.\n"

#. from tp:coreutils-9.10-pre1
msgid "\nThe valid format sequences for files (without --file-system):\n\n  %a   permission bits in octal (see '#' and '0' printf flags)\n  %A   permission bits and file type in human readable form\n  %b   number of blocks allocated (see %B)\n  %B   the size in bytes of each block reported by %b\n  %C   SELinux security context string\n"
msgstr "\nDe giltiga formatsekvenserna för filer (utan --file-system):\n\n  %a   åtkomstbitar oktalt (se printf-flaggorna ”#” och ”0”)\n  %A   åtkomstbitar och filtyp i format läsbart för människa\n  %b   antal allokerade block (se %B)\n  %B   storleken i byte på varje block rapporterat av %b\n  %C   SELinux-säkerhetskontextsträng\n"

#. from tp:coreutils-9.10-pre1
msgid "  %d   device number in decimal (st_dev)\n  %D   device number in hex (st_dev)\n  %Hd  major device number in decimal\n  %Ld  minor device number in decimal\n  %f   raw mode in hex\n  %F   file type\n  %g   group ID of owner\n  %G   group name of owner\n"
msgstr "  %d   enhetsnummer decimalt (st_dev)\n  %D   enhetsnummer hexadecimalt (st_dev)\n  %Hd  övre enhetsnummer decimalt\n  %Ld  undre enhetsnummer decimalt\n  %f   rått filskyddsläge hexadecimalt\n  %F   filtyp\n  %g   grupp-ID på ägare\n  %G   gruppnamn på ägare\n"

#. from tp:coreutils-9.10-pre1
msgid "  %h   number of hard links\n  %i   inode number\n  %m   mount point\n  %n   file name\n  %N   quoted file name with dereference if symbolic link\n  %o   optimal I/O transfer size hint\n  %s   total size, in bytes\n  %r   device type in decimal (st_rdev)\n  %R   device type in hex (st_rdev)\n  %Hr  major device type in decimal, for character/block device special files\n  %Lr  minor device type in decimal, for character/block device special files\n  %t   major device type in hex, for character/block device special files\n  %T   minor device type in hex, for character/block device special files\n"
msgstr "  %h   antal hårda länkar\n  %i   inodnummer\n  %m   monteringspunkt\n  %n   filnamn\n  %N   citerat filnamn, med dereferens om symbolisk länk\n  %o   tips om optimal storlek för I/O-överföringar\n  %s   total storlek, i byte\n  %r   enhetstyp decimalt (st_rdev)\n  %R   enhetstyp hexadecimalt (st_rdev)\n  %Hr  övre enhetstyp decimalt, för tecken-/blockenhetsspecialfiler\n  %Lr  undre enhetstyp decimalt, för tecken-/blockenhetsspecialfiler\n  %t   övre enhetsnummer hexadecimalt, för tecken-/blockenhetsspecialfiler\n  %T   undre enhetsnummer hexadecimalt, för tecken-/blockenhetsspecialfiler\n"

#. from tp:coreutils-9.10-pre1
msgid "  %u   user ID of owner\n  %U   user name of owner\n  %w   time of file birth, human-readable; - if unknown\n  %W   time of file birth, seconds since Epoch; 0 if unknown\n  %x   time of last access, human-readable\n  %X   time of last access, seconds since Epoch\n  %y   time of last data modification, human-readable\n  %Y   time of last data modification, seconds since Epoch\n  %z   time of last status change, human-readable\n  %Z   time of last status change, seconds since Epoch\n\n"
msgstr "  %u   användar-ID på ägare\n  %U   användarnamn på ägare\n  %w   filens skapandetid, läsbar för människa, eller - om okänd\n  %W   filens skapandetid, sekunder sedan epoken, eller 0 om okänd\n  %x   senaste åtkomsttid, läsbar för människa\n  %X   senaste åtkomsttid, sekunder sedan epoken\n  %y   senaste datamodifieringstid, läsbar för människa\n  %Y   senaste datamodifieringstid, sekunder sedan epoken\n  %z   senaste statusändringstid, läsbar för människa\n  %Z   senaste statusändringstid, sekunder sedan epoken\n\n"

#. from tp:coreutils-9.10-pre1
msgid "Valid format sequences for file systems:\n\n  %a   free blocks available to non-superuser\n  %b   total data blocks in file system\n  %c   total file nodes in file system\n  %d   free file nodes in file system\n  %f   free blocks in file system\n"
msgstr "Giltiga formatsekvenser för filsystem:\n\n  %a   fria block tillgängliga för icke superanvändare\n  %b   totalt antal datablock i filsystem\n  %c   totalt antal filnoder i filsystem\n  %d   fria filnoder i filsystem\n  %f   fria block i filsystem\n"

#. from tp:coreutils-9.10-pre1
msgid "  %i   file system ID in hex\n  %l   maximum length of filenames\n  %n   file name\n  %s   block size (for faster transfers)\n  %S   fundamental block size (for block counts)\n  %t   file system type in hex\n  %T   file system type in human readable form\n"
msgstr "  %i   filsystem-ID hexadecimalt\n  %l   maxlängd på filnamn\n  %n   filnamn\n  %s   blockstorlek (för snabbare överföringar)\n  %S   grundläggande blockstorlek (för antal block)\n  %t   filsystemstyp hexadecimalt\n  %T   filsystemstyp i format läsbart för människa\n"

#. from tp:coreutils-9.10-pre1
msgid "\n--terse is equivalent to the following FORMAT:\n    %s"
msgstr "\n--terse är likvärdigt med följande FORMAT:\n    %s"

#. from tp:coreutils-9.10-pre1
msgid "--terse --file-system is equivalent to the following FORMAT:\n    %s"
msgstr "--terse --file-system är likvärdigt med följande FORMAT:\n    %s"

#. from tp:coreutils-9.10-pre1
msgid "Usage: %s OPTION... COMMAND\n"
msgstr "Användning: %s FLAGGA... KOMMANDO\n"

#. from tp:coreutils-9.10-pre1
msgid "Run COMMAND, with modified buffering operations for its standard streams.\n"
msgstr "Kör KOMMANDO, med modifierade buffringsoperationer för dess standardströmmar.\n"

#. from tp:coreutils-9.10-pre1
msgid "  -i, --input=MODE   adjust standard input stream buffering\n"
msgstr "  -i, --input=LÄGE   justera strömbuffring av standard in\n"

#. from tp:coreutils-9.10-pre1
msgid "  -o, --output=MODE  adjust standard output stream buffering\n"
msgstr "  -o, --output=LÄGE  justera strömbuffring av standard ut\n"

#. from tp:coreutils-9.10-pre1
msgid "  -e, --error=MODE   adjust standard error stream buffering\n"
msgstr "  -e, --error=LÄGE   justera strömbuffring av standard fel\n"

#. from tp:coreutils-9.10-pre1
msgid "\nIf MODE is 'L' the corresponding stream will be line buffered.\nThis option is invalid with standard input.\n"
msgstr "\nOm LÄGE är ”L” är motsvarande ström radbuffrad.\nDetta alternativ är ogiltigt med standard in.\n"

#. from tp:coreutils-9.10-pre1
msgid "\nIf MODE is '0' the corresponding stream will be unbuffered.\n"
msgstr "\nOm LÄGE är ”0” är motsvarande ström obuffrad.\n"

#. from tp:coreutils-9.10-pre1
msgid "\nOtherwise MODE is a number which may be followed by one of the following:\nKB 1000, K 1024, MB 1000*1000, M 1024*1024, and so on for G,T,P,E,Z,Y,R,Q.\nBinary prefixes can be used, too: KiB=K, MiB=M, and so on.\nIn this case the corresponding stream will be fully buffered with the buffer\nsize set to MODE bytes.\n"
msgstr "\nAnnars är LÄGE ett tal som kan följas av ett av följande:\nKB 1000, K 1024, MB 1000·1000, M 1024·1024, och så vidare för G,T,P,E,Z,Y,R,Q.\nBinära prefix kan också användas: KiB=K, MiB=M, och så vidare.\nI detta fall är strömmen fullt buffrad med buffertstorleken satt till\nLÄGE byte.\n"

#. from tp:coreutils-9.10-pre1
msgid "\nNOTE: If COMMAND adjusts the buffering of its standard streams ('tee' does\nfor example) then that will override corresponding changes by 'stdbuf'.\nAlso some filters (like 'dd' and 'cat' etc.) don't use streams for I/O,\nand are thus unaffected by 'stdbuf' settings.\n"
msgstr "\nOBSERVERA: Om KOMMANDO justerar buffringen på sina standardströmmar (”tee” gör\ndet till exempel) då kommer detta att åsidosätta motsvarande ändringar av\n”stdbuf”.  Vidare använder några filter (som ”dd” och ”cat” etc.) inte strömmar\nför I/O, och påverkas alltså inte av ”stdbuf”-inställningar.\n"

#. from tp:coreutils-9.10-pre1
msgid "failed to find %s"
msgstr "misslyckades med att hitta %s"

#. from tp:coreutils-9.10-pre1
msgid "failed to update the environment with %s"
msgstr "misslyckades med att uppdatera miljön med %s"

#. from tp:coreutils-9.10-pre1
msgid "line buffering standard input is meaningless"
msgstr "radbuffring av standard in är meningslös"

#. from tp:coreutils-9.10-pre1
msgid "you must specify a buffering mode option"
msgstr "du måste ange en flagga för buffringsläge"

#. from tp:coreutils-9.10-pre1
msgid "Usage: %s [-F DEVICE | --file=DEVICE] [SETTING]...\n  or:  %s [-F DEVICE | --file=DEVICE] [-a|--all]\n  or:  %s [-F DEVICE | --file=DEVICE] [-g|--save]\n"
msgstr "Användning: %s [-F ENHET | --file=ENHET] [INSTÄLLNING]...\n    eller:  %s [-F ENHET | --file=ENHET] [-a|--all]\n    eller:  %s [-F ENHET | --file=ENHET] [-g|--save]\n"

#. from tp:coreutils-9.10-pre1
msgid "Print or change terminal characteristics.\n"
msgstr "Skriv ut eller ändra terminalkarakteristik.\n"

#. from tp:coreutils-9.10-pre1
msgid "  -a, --all          print all current settings in human-readable form\n"
msgstr "  -a, --all          skriv ut alla nuvarande inställningar läsligt\n"

#. from tp:coreutils-9.10-pre1
msgid "  -g, --save         print all current settings in a stty-readable form\n"
msgstr "  -g, --save         skriv ut alla nuvarande inställningar i stty-format\n"

#. from tp:coreutils-9.10-pre1
msgid "  -F, --file=DEVICE  open and use DEVICE instead of standard input\n"
msgstr "  -F, --file=ENHET   öppna och använd ENHET istället för standard in\n"

#. from tp:coreutils-9.10-pre1
msgid "\nOptional - before SETTING indicates negation.  An * marks non-POSIX\nsettings.  The underlying system defines which settings are available.\n"
msgstr "\nEtt valfritt - före INSTÄLLNING indikerar negation.  En * indikerar en\nicke-POSIX-inställning.  Det underliggande systemet definierar vilka\ninställningar som är tillgängliga.\n"

#. from tp:coreutils-9.10-pre1
msgid "\nSpecial characters:\n"
msgstr "\nSpecialtecken:\n"

#. from tp:coreutils-9.10-pre1
msgid " * discard CHAR  CHAR will toggle discarding of output\n"
msgstr " * discard TECKEN  TECKEN växlar mellan att kasta och behålla utdata\n"

#. from tp:coreutils-9.10-pre1
msgid " * dsusp CHAR    CHAR will send a terminal stop signal once input flushed\n"
msgstr " * dsusp TECKEN  TECKEN skickar en terminalstoppsignal när programmet läser det\n"

#. from tp:coreutils-9.10-pre1
msgid "   eof CHAR      CHAR will send an end of file (terminate the input)\n   eol CHAR      CHAR will end the line\n"
msgstr "   eof TECKEN    TECKEN skickar ett filslut (avsluta inmatning)\n   eol TECKEN    TECKEN avslutar raden\n"

#. from tp:coreutils-9.10-pre1
msgid " * eol2 CHAR     alternate CHAR for ending the line\n"
msgstr " * eol2 TECKEN   alternativt TECKEN för radslut\n"

#. from tp:coreutils-9.10-pre1
msgid "   erase CHAR    CHAR will erase the last character typed\n   intr CHAR     CHAR will send an interrupt signal\n   kill CHAR     CHAR will erase the current line\n"
msgstr "   erase TECKEN  TECKEN raderar det senast skrivna tecknet\n   intr TECKEN   TECKEN skickar en avbrottssignal\n   kill TECKEN   TECKEN raderar nuvarande rad\n"

#. from tp:coreutils-9.10-pre1
msgid " * lnext CHAR    CHAR will enter the next character quoted\n"
msgstr " * lnext TECKEN  TECKEN gör att nästa tecken matas in bokstavligt\n"

#. from tp:coreutils-9.10-pre1
msgid " * status CHAR   CHAR will send an info signal\n"
msgstr " * status TECKEN TECKEN skickar en informationssignal\n"

#. from tp:coreutils-9.10-pre1
msgid "   quit CHAR     CHAR will send a quit signal\n"
msgstr "   quit  TECKEN  TECKEN skickar en avslutningssignal\n"

#. from tp:coreutils-9.10-pre1
msgid " * rprnt CHAR    CHAR will redraw the current line\n"
msgstr " * rprnt TECKEN  TECKEN ritar om nuvarande rad\n"

#. from tp:coreutils-9.10-pre1
msgid "   start CHAR    CHAR will restart the output after stopping it\n   stop CHAR     CHAR will stop the output\n   susp CHAR     CHAR will send a terminal stop signal\n"
msgstr "   start TECKEN  TECKEN startar utskrift igen efter att ha stoppat den\n   stop TECKEN   TECKEN stoppar utskriften\n   susp TECKEN   TECKEN skickar en terminalstoppsignal\n"

#. from tp:coreutils-9.10-pre1
msgid " * swtch CHAR    CHAR will switch to a different shell layer\n"
msgstr " * swtch TECKEN  TECKEN byter till ett annat skallager\n"

#. from tp:coreutils-9.10-pre1
msgid " * werase CHAR   CHAR will erase the last word typed\n"
msgstr " * werase TECKEN TECKEN raderar det senast skrivna ordet\n"

#. from tp:coreutils-9.10-pre1
msgid "\nSpecial settings:\n   N             set the input and output speeds to N bauds\n"
msgstr "\nSpecialinställningar:\n   N             sätt in- och utmatningshastighet till N baud\n"

#. from tp:coreutils-9.10-pre1
msgid "   cols N        tell the kernel that the terminal has N columns\n * columns N     same as cols N\n"
msgstr "   cols N        säg till kärnan att terminalen har N kolumner\n * columns N     samma som cols N\n"

#. from tp:coreutils-9.10-pre1
msgid " * [-]drain      wait for transmission before applying settings (%s by default)\n"
msgstr " * [-]drain      vänta tills sändningen är klar innan inställningarna\n                 verkställs (%s som standard)\n"

#. from tp:coreutils-9.10-pre1
msgid "on"
msgstr "på"

#. from tp:coreutils-9.10-pre1
msgid "off"
msgstr "av"

#. from tp:coreutils-9.10-pre1
msgid "   ispeed N      set the input speed to N\n"
msgstr "   ispeed N      sätt inmatningshastighet till N\n"

#. from tp:coreutils-9.10-pre1
msgid " * line N        use line discipline N\n"
msgstr " * line N        använd linjedisciplin N\n"

#. from tp:coreutils-9.10-pre1
msgid "   min N         with -icanon, set N characters minimum for a completed read\n   ospeed N      set the output speed to N\n"
msgstr "   min N         med -icanon, sätt N tecken till minimum för en avslutad läsning\n   ospeed N      sätt utmatningshastighet till N\n"

#. from tp:coreutils-9.10-pre1
msgid "   rows N        tell the kernel that the terminal has N rows\n   size          print the number of rows and columns according to the kernel\n"
msgstr "   rows N        säg till kärnan att terminalen har N rader\n   size          skriv ut antalet rader och kolumner enligt kärnan\n"

#. from tp:coreutils-9.10-pre1
msgid "   speed         print the terminal speed\n   time N        with -icanon, set read timeout of N tenths of a second\n"
msgstr "   speed         skriv ut terminalens hastighet\n   time N        med -icanon, sätt timeout för läsning till N tiondelssekunder\n"

#. from tp:coreutils-9.10-pre1
msgid "\nControl settings:\n   [-]clocal     disable modem control signals\n   [-]cread      allow input to be received\n"
msgstr "\nKontrollinställningar:\n   [-]clocal     stäng av modemstyrsignaler\n   [-]cread      tillåt mottagandet av indata\n"

#. from tp:coreutils-9.10-pre1
msgid " * [-]crtscts    enable RTS/CTS handshaking\n"
msgstr " * [-]crtscts    aktivera RTS/CTS-handskakning\n"

#. from tp:coreutils-9.10-pre1
msgid " * [-]cdtrdsr    enable DTR/DSR handshaking\n"
msgstr " * [-]cdtrdsr    aktivera DTR/DSR-handskakning\n"

#. from tp:coreutils-9.10-pre1
msgid "   csN           set character size to N bits, N in [5..8]\n"
msgstr "   csN           sätt teckenstorleken till N bitar, N i [5..8]\n"

#. from tp:coreutils-9.10-pre1
msgid "   [-]cstopb     use two stop bits per character (one with '-')\n   [-]hup        send a hangup signal when the last process closes the tty\n   [-]hupcl      same as [-]hup\n   [-]parenb     generate parity bit in output and expect parity bit in input\n   [-]parodd     set odd parity (or even parity with '-')\n"
msgstr "   [-]cstopb     använd två stoppbitar per tecken (en med ”-”)\n   [-]hup        skicka en avringningssignal när sista processen stänger ttyn\n   [-]hupcl      samma som [-]hup\n   [-]parenb     generera paritetsbit i utdata och förvänta paritetsbit i indata\n   [-]parodd     ställ in udda paritet (eller jämn paritet med ”-”)\n"

#. from tp:coreutils-9.10-pre1
msgid " * [-]cmspar     use \"stick\" (mark/space) parity\n"
msgstr " * [-]cmspar     använd fast paritet (etta/nolla)\n"

#. from tp:coreutils-9.10-pre1
msgid "\nInput settings:\n   [-]brkint     breaks cause an interrupt signal\n   [-]icrnl      translate carriage return to newline\n   [-]ignbrk     ignore break characters\n   [-]igncr      ignore carriage return\n   [-]ignpar     ignore characters with parity errors\n"
msgstr "\nInställningar för inmatning:\n   [-]brkint     BREAK-signaler orsakar en avbrottssignal\n   [-]icrnl      översätt vagnretur till nyrad\n   [-]ignbrk     ignorera BREAK-tecken\n   [-]igncr      ignorera vagnretur\n   [-]ignpar     ignorera tecken med paritetsfel\n"

#. from tp:coreutils-9.10-pre1
msgid " * [-]imaxbel    beep and do not flush a full input buffer on a character\n"
msgstr " * [-]imaxbel    pip men töm inte en full indatabuffert vid nytt tecken\n"

#. from tp:coreutils-9.10-pre1
msgid "   [-]inlcr      translate newline to carriage return\n   [-]inpck      enable input parity checking\n   [-]istrip     clear high (8th) bit of input characters\n"
msgstr "   [-]inlcr      översätt nyrad till vagnretur\n   [-]inpck      möjliggör paritetskontroll av indata\n   [-]istrip     nollställ den mest signifikanta (8:e) biten i indatatecken\n"

#. from tp:coreutils-9.10-pre1
msgid " * [-]iutf8      assume input characters are UTF-8 encoded\n"
msgstr " * [-]iutf8      anta att inmatningstecken är UTF-8-kodade\n"

#. from tp:coreutils-9.10-pre1
msgid " * [-]iuclc      translate uppercase characters to lowercase\n"
msgstr " * [-]iuclc      översätt versaler till gemener\n"

#. from tp:coreutils-9.10-pre1
msgid " * [-]ixany      let any character restart output, not only start character\n"
msgstr " * [-]ixany      tillåt vilket tecken som helst att starta om utmatning,\n                 inte bara starttecken\n"

#. from tp:coreutils-9.10-pre1
msgid "   [-]ixoff      enable sending of start/stop characters\n   [-]ixon       enable XON/XOFF flow control\n   [-]parmrk     mark parity errors (with a 255-0-character sequence)\n   [-]tandem     same as [-]ixoff\n"
msgstr "   [-]ixoff      aktivera sändning av start-/stopptecken\n   [-]ixon       möjliggör XON/XOFF-flödeskontroll\n   [-]parmrk     markera paritetsfel (med teckensekvensen 255-0)\n   [-]tandem     samma som [-]ixoff\n"

#. from tp:coreutils-9.10-pre1
msgid "\nOutput settings:\n"
msgstr "\nInställningar för utmatning:\n"

#. from tp:coreutils-9.10-pre1
msgid " * bsN           backspace delay style, N in [0..1]\n"
msgstr " * bsN           fördröjning på backsteg, N är [0-1]\n"

#. from tp:coreutils-9.10-pre1
msgid " * crN           carriage return delay style, N in [0..3]\n"
msgstr " * crN           fördröjning på vagnretur, N är [0-3]\n"

#. from tp:coreutils-9.10-pre1
msgid " * ffN           form feed delay style, N in [0..1]\n"
msgstr " * ffN           fördröjning på sidmatning, N är [0-1]\n"

#. from tp:coreutils-9.10-pre1
msgid " * nlN           newline delay style, N in [0..1]\n"
msgstr " * nlN           fördröjning på nyrad, N är [0-1]\n"

#. from tp:coreutils-9.10-pre1
msgid " * [-]ocrnl      translate carriage return to newline\n"
msgstr " * [-]ocrnl      översätt vagnretur till nyrad\n"

#. from tp:coreutils-9.10-pre1
msgid " * [-]ofdel      use delete characters for fill instead of NUL characters\n"
msgstr " * [-]ofdel      använd raderingstecken till utfyllnad, istället för NUL-tecken\n"

#. from tp:coreutils-9.10-pre1
msgid " * [-]ofill      use fill (padding) characters instead of timing for delays\n"
msgstr " * [-]ofill      använd utfyllnadstecken istället för tidsstyrning vid\n                   fördröjningar\n"

#. from tp:coreutils-9.10-pre1
msgid " * [-]olcuc      translate lowercase characters to uppercase\n"
msgstr " * [-]olcuc      översätt gemener till versaler\n"

#. from tp:coreutils-9.10-pre1
msgid " * [-]onlcr      translate newline to carriage return-newline\n"
msgstr " * [-]onlcr      översätt nyrad till vagnretur-nyrad\n"

#. from tp:coreutils-9.10-pre1
msgid " * [-]onlret     newline performs a carriage return\n"
msgstr " * [-]onlret     nyrad utför en vagnretur\n"

#. from tp:coreutils-9.10-pre1
msgid " * [-]onocr      do not print carriage returns in the first column\n"
msgstr " * [-]onocr      skriv inte ut vagnretur i första kolumnen\n"

#. from tp:coreutils-9.10-pre1
msgid "   [-]opost      postprocess output\n"
msgstr "   [-]opost      efterbehandla utdata\n"

#. from tp:coreutils-9.10-pre1
msgid " * tabN          horizontal tab delay style, N in [0..3]\n * tabs          same as tab0\n * -tabs         same as tab3\n"
msgstr " * tabN          fördröjning på horisontell tabulator, N är [0-3]\n * tabs          samma som tab0\n * -tabs         samma som tab3\n"

#. from tp:coreutils-9.10-pre1
msgid " * vtN           vertical tab delay style, N in [0..1]\n"
msgstr " * vtN           fördröjning på vertikal tabulator, N är [0-1]\n"

#. from tp:coreutils-9.10-pre1
msgid "\nLocal settings:\n   [-]crterase   echo erase characters as backspace-space-backspace\n"
msgstr "\nLokala inställningar:\n   [-]crterase   eka raderingstecken som backsteg-mellanslag-backsteg\n"

#. from tp:coreutils-9.10-pre1
msgid " * crtkill       kill all line by obeying the echoprt and echoe settings\n * -crtkill      kill all line by obeying the echoctl and echok settings\n"
msgstr " * crtkill       radera hela raden genom att använda inställningarna \n                 för echoprt och echoe\n * -crtkill      radera hela raden genom att använda inställningarna\n                 för echoctl och echok\n"

#. from tp:coreutils-9.10-pre1
msgid " * [-]ctlecho    echo control characters in hat notation ('^c')\n"
msgstr " * [-]ctlecho    eka kontrolltecken med hattnotation (”^c”)\n"

#. from tp:coreutils-9.10-pre1
msgid "   [-]echo       echo input characters\n"
msgstr "   [-]echo       eka inmatade tecken\n"

#. from tp:coreutils-9.10-pre1
msgid " * [-]echoctl    same as [-]ctlecho\n"
msgstr " * [-]echoctl    samma som [-]ctlecho\n"

#. from tp:coreutils-9.10-pre1
msgid "   [-]echoe      same as [-]crterase\n   [-]echok      echo a newline after a kill character\n"
msgstr "   [-]echoe      samma som [-]crterase\n   [-]echok      eka en nyrad efter ett radraderingstecken\n"

#. from tp:coreutils-9.10-pre1
msgid " * [-]echoke     same as [-]crtkill\n"
msgstr " * [-]echoke     samma som [-]crtkill\n"

#. from tp:coreutils-9.10-pre1
msgid "   [-]echonl     echo newline even if not echoing other characters\n"
msgstr "   [-]echonl     eka nyrad även om inga andra tecken ekas\n"

#. from tp:coreutils-9.10-pre1
msgid " * [-]echoprt    echo erased characters backward, between '\\' and '/'\n"
msgstr " * [-]echoprt    eka raderade tecken baklänges, mellan ”\\” och ”/”\n"

#. from tp:coreutils-9.10-pre1
msgid " * [-]extproc    enable \"LINEMODE\"; useful with high latency links\n"
msgstr " * [-]extproc    aktivera ”LINEMODE”; användbart för länkar med hög latens\n"

#. from tp:coreutils-9.10-pre1
msgid " * [-]flusho     discard output\n"
msgstr " * [-]flusho     kasta utdata\n"

#. from tp:coreutils-9.10-pre1
msgid "   [-]icanon     enable special characters: %s\n   [-]iexten     enable non-POSIX special characters\n"
msgstr "   [-]icanon     möjliggör specialtecknen: %s\n   [-]iexten     möjliggör specialtecken som inte är POSIX-tecken\n"

#. from tp:coreutils-9.10-pre1
msgid "   [-]isig       enable interrupt, quit, and suspend special characters\n   [-]noflsh     disable flushing after interrupt and quit special characters\n"
msgstr "   [-]isig       möjliggör specialtecken för avbrott, avslut och uppehåll\n   [-]noflsh     koppla bort rensning efter specialtecken för avbrott och avslut\n"

#. from tp:coreutils-9.10-pre1
msgid " * [-]prterase   same as [-]echoprt\n"
msgstr " * [-]prterase   samma som [-]echoprt\n"

#. from tp:coreutils-9.10-pre1
msgid " * [-]tostop     stop background jobs that try to write to the terminal\n"
msgstr " * [-]tostop     stoppa bakgrundsjobb som försöker skriva till terminalen\n"

#. from tp:coreutils-9.10-pre1
msgid " * [-]xcase      with icanon, escape with '\\' for uppercase characters\n"
msgstr " * [-]xcase      tillsammans med icanon, används ”\\” som kontrollsekvens\n                 för versaltecken\n"

#. from tp:coreutils-9.10-pre1
msgid "\nCombination settings:\n"
msgstr "\nKombinationsinställningar:\n"

#. from tp:coreutils-9.10-pre1
msgid " * [-]LCASE      same as [-]lcase\n"
msgstr " * [-]LCASE      samma som [-]lcase\n"

#. from tp:coreutils-9.10-pre1
msgid "   cbreak        same as -icanon\n   -cbreak       same as icanon\n"
msgstr "   cbreak        samma som -icanon\n   -cbreak       samma som icanon\n"

#. from tp:coreutils-9.10-pre1
msgid "   cooked        same as brkint ignpar istrip icrnl ixon opost isig\n                 icanon, eof and eol characters to their default values\n   -cooked       same as raw\n"
msgstr "   cooked        samma som brkint ignpar istrip icrnl ixon opost isig\n                 icanon, eof- och eol-tecknen till sina standardvärden\n   -cooked       samma som raw\n"

#. from tp:coreutils-9.10-pre1
msgid "   crt           same as %s\n"
msgstr "   crt           samma som %s\n"

#. from tp:coreutils-9.10-pre1
msgid "   dec           same as %s intr ^c erase 0177\n                 kill ^u\n"
msgstr "   dec           samma som %s intr ^c erase 0177\n                 kill ^u\n"

#. from tp:coreutils-9.10-pre1
msgid " * [-]decctlq    same as [-]ixany\n"
msgstr " * [-]decctlq    samma som [-]ixany\n"

#. from tp:coreutils-9.10-pre1
msgid "   ek            erase and kill characters to their default values\n   evenp         same as parenb -parodd cs7\n   -evenp        same as -parenb cs8\n"
msgstr "   ek            erase- och kill-tecken till sina standardvärden\n   evenp         samma som parenb -parodd cs7\n   -evenp        samma som -parenb cs8\n"

#. from tp:coreutils-9.10-pre1
msgid " * [-]lcase      same as xcase iuclc olcuc\n"
msgstr " * [-]lcase      samma som xcase iuclc olcuc\n"

#. from tp:coreutils-9.10-pre1
msgid "   litout        same as -parenb -istrip -opost cs8\n   -litout       same as parenb istrip opost cs7\n"
msgstr "   litout        samma som -parenb -istrip -opost cs8\n   -litout       samma som parenb istrip opost cs7\n"

#. from tp:coreutils-9.10-pre1
msgid "   nl            same as %s\n   -nl           same as %s\n"
msgstr "   nl            samma som %s\n   -nl           samma som %s\n"

#. from tp:coreutils-9.10-pre1
msgid "   oddp          same as parenb parodd cs7\n   -oddp         same as -parenb cs8\n   [-]parity     same as [-]evenp\n   pass8         same as -parenb -istrip cs8\n   -pass8        same as parenb istrip cs7\n"
msgstr "   oddp          samma som parenb parodd cs7\n   -oddp         samma som -parenb cs8\n   [-]parity     samma som [-]evenp\n   pass8         samma som -parenb -istrip cs8\n   -pass8        samma som parenb istrip cs7\n"

#. from tp:coreutils-9.10-pre1
msgid "   raw           same as -ignbrk -brkint -ignpar -parmrk -inpck -istrip\n                 -inlcr -igncr -icrnl -ixon -ixoff -icanon -opost\n                 -isig%s min 1 time 0\n   -raw          same as cooked\n"
msgstr "   raw           samma som -ignbrk -brkint -ignpar -parmrk -inpck -istrip\n                 -inlcr -igncr -icrnl  -ixon  -ixoff -icanon -opost\n                 -isig%s min 1 time 0\n   -raw          samma som cooked\n"

#. from tp:coreutils-9.10-pre1
msgid "   sane          same as cread -ignbrk brkint -inlcr -igncr icrnl\n                 icanon iexten echo echoe echok -echonl -noflsh\n                 %s\n                 %s\n                 %s,\n                 all special characters to their default values\n"
msgstr "   sane          samma som cread -ignbrk brkint -inlcr -igncr icrnl\n                 icanon iexten echo echoe echok -echonl -noflsh\n                 %s\n                 %s\n                 %s,\n                 alla specialtecken till sina standardvärden\n"

#. from tp:coreutils-9.10-pre1
msgid "\nHandle the tty line connected to standard input.  Without arguments,\nprints baud rate, line discipline, and deviations from stty sane.  In\nsettings, CHAR is taken literally, or coded as in ^c, 0x37, 0177 or\n127; special values ^- or undef used to disable special characters.\n"
msgstr "\nHantera tty-linjen kopplad till standard in. Utan argument skrivs \nbaudhastighet, linjedisciplin och avvikelser från stty sane ut. I inställningarna \ntolkas TECKEN ordagrant, eller kodat som i ^c, 0x37, 0177 eller 127;\nspecialvärdet ^- eller undef används för att stänga av specialtecken.\n"

#. from tp:coreutils-9.10-pre1
msgid "missing argument to %s"
msgstr "argument saknas till %s"

