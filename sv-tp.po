msgid "FOO(1)                         User Commands                        FOO(1)\n\n"
msgstr "FOO(1)                         Användarkommandon                    FOO(1)\n\n"

#. from tp:help2man-texi-1.47.17
msgid "@exstrong{NAME}\n       foo - manual page for foo 1.1\n\n"
msgstr "@exstrong{NAMN}\n       foo - manualsida för foo 1.1\n\n"

#. from tp:help2man-texi-1.47.17
msgid "@exstrong{SYNOPSIS}\n       foo [OPTION]...\n\n"
msgstr "@exstrong{SYNOPSIS}\n       foo [FLAGGA]…\n\n"

