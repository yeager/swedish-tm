msgstr "NP & blixt"

#. from tp:libexif-0.6.25
msgid "Aperture priority AE"
msgstr "Bländarprioritet AE"

#. from tp:libexif-0.6.25
msgid "Shutter priority AE"
msgstr "Slutarprioritet AE"

