msgstr "      --hex-suffixes[=FRÅN]\n         samma som -x, men tillåt att startvärdet sätts\n"

#. from tp:coreutils-9.10-pre1
msgid "  -e, --elide-empty-files\n         do not generate empty output files with '-n'\n"
msgstr "  -e, --elide-empty-files\n         generera inte tomma utfiler med ”-n”\n"

#. from tp:coreutils-9.10-pre1
msgid "      --filter=COMMAND\n         write to shell COMMAND; file name is $FILE\n"
msgstr "      --filter=KOMMANDO\n         skriv till skalKOMMANDO; filnamnet är $FILE\n"

#. from tp:coreutils-9.10-pre1
msgid "  -l, --lines=NUMBER\n         put NUMBER lines/records per output file\n"
msgstr "  -l, --lines=ANTAL\n         placera ANTAL rader/poster i varje utfil\n"

#. from tp:coreutils-9.10-pre1
msgid "  -n, --number=CHUNKS\n         generate CHUNKS output files; see explanation below\n"
msgstr "  -n, --number=BITAR\n         generera BITAR utfiler; se förklaring nedan\n"

#. from tp:coreutils-9.10-pre1
msgid "  -t, --separator=SEP\n         use SEP instead of newline as the record separator;\n         '\\0' (zero) specifies the NUL character\n"
