msgid "Variable %s at %L with NO_ARG_CHECK attribute shall either be a scalar or an assumed-size array"
msgstr "Variabeln %s vid %L med attributet NO_ARG_CHECK ska antingen vara en skalär eller en vektor med antagen storlek"

