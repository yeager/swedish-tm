msgstr "Användar-ID-nummer."

#. from tp:util-linux-man-2.41.2-rc1
msgid "UNIX.PATH <``string``>"
msgstr "UNIX.PATH <``sträng``>"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Filesystem pathname for UNIX domain socket."
msgstr "Filsystemets sökväg för UNIX-domänens uttag."

#. from tp:util-linux-man-2.41.2-rc1
msgid "USER <``string``>"
msgstr "ANVÄNDARE <``sträng``>"

#. from tp:util-linux-man-2.41.2-rc1
msgid "User of the process."
msgstr "Användare av processen."

#. from tp:util-linux-man-2.41.2-rc1
msgid "VSOCK.LADDR <``string``>"
msgstr "VSOCK.LADDR <``sträng``>"

#. from tp:util-linux-man-2.41.2-rc1
msgid "VSOCK.RADDR <``string``>"
msgstr "VSOCK.RADDR <``sträng``>"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Local VSOCK address. The format of the element is _VSOCK.LCID_``:``_VSOCK.LPORT_."
msgstr "Lokal VSOCK-adress. Elementets format är _VSOCK.LCID_``:``_VSOCK.LPORT_."

#. from tp:util-linux-man-2.41.2-rc1
msgid "Well-known CIDs will be decoded: \"`{asterisk}`\", \"`hypervisor`\", \"`local`\", or \"`host`\".  Well-known ports will be decoded: \"`{asterisk}`\"."
msgstr "Välkända CID:n kommer att avkodas: \"`{asterisk}`\", \"`hypervisor`\", \"`local`\" eller \"`host`\".  Välkända portar kommer att avkodas: \"`{asterisk}`\"."

#. from tp:util-linux-man-2.41.2-rc1
msgid "VSOCK.LCID <``number``>"
msgstr "VSOCK.LCID <``nummer``>"

#. from tp:util-linux-man-2.41.2-rc1
msgid "VSOCK.RCID <``number``>"
msgstr "VSOCK.RCID <``nummer``>"

#. from tp:util-linux-man-2.41.2-rc1
msgid "Local and remote VSOCK context identifiers."
msgstr "Identifierare för lokala och avlägsna VSOCK-kontexter."

#. from tp:util-linux-man-2.41.2-rc1
msgid "VSOCK.LPORT <``number``>"
msgstr "VSOCK.LPORT <``nummer``>"

