msgstr "VARNING: strömstartflagga funnen mitt i strömmen i ström %d\n"

#. from tp:vorbis-tools-1.4.3
msgid "WARNING: sequence number gap in stream %d. Got page %ld when expecting page %ld. Indicates missing data.\n"
msgstr "VARNING: sekvensnummerhopp i ström %d.  Fick sida %ld när sida %ld förväntades.  Indikerar saknade data.\n"

#. from tp:vorbis-tools-1.4.3
msgid "Logical stream %d ended\n"
msgstr "Logisk ström %d tog slut\n"

#. from tp:vorbis-tools-1.4.3
msgid "ERROR: No Ogg data found in file \"%s\".\nInput probably not Ogg.\n"
msgstr "FEL: Ingen Ogg-data funnen i filen ”%s”.\nIndata är förmodligen inte Ogg.\n"

#. from tp:vorbis-tools-1.4.3
msgid "ogginfo from %s %s\n"
msgstr "ogginfo från %s %s\n"

#. from tp:vorbis-tools-1.4.3
msgid " by the Xiph.Org Foundation (https://www.xiph.org/)\n\n"
msgstr " av Xiph.Org Foundation (https://www.xiph.org/)\n\n"

#. from tp:vorbis-tools-1.4.3
msgid "(c) 2003-2005 Michael Smith <msmith@xiph.org>\n\nUsage: ogginfo [flags] file1.ogg [file2.ogx ... fileN.ogv]\nFlags supported:\n	-h Show this help message\n	-q Make less verbose. Once will remove detailed informative\n	   messages, two will remove warnings\n	-v Make more verbose. This may enable more detailed checks\n	   for some stream types.\n"
msgstr "© 2003-2005 Michael Smith <msmith@xiph.org>\n\nAnvändning: ogginfo [flaggor] fil1.ogg [fil2.ogx … filN.ogv]\nFlaggor som stödjs:\n	-h Visa detta hjälpmeddelande\n	-q Gör mindre pratsam.  En gång tar bort informationsmeddelande om\n	   detaljer, två gånger tar bort varningar.\n	-v Gör mer pratsam.  Detta kan aktivera mer detaljerade kontroller\n	   för några strömtyper.\n"

#. from tp:vorbis-tools-1.4.3
msgid "	-V Output version information and exit\n"
msgstr "	-V Skriv ut versionsinformation och avsluta\n"

#. from tp:vorbis-tools-1.4.3
msgid "Usage: ogginfo [flags] file1.ogg [file2.ogx ... fileN.ogv]\n\nogginfo is a tool for printing information about Ogg files\nand for diagnosing problems with them.\nFull help shown with \"ogginfo -h\".\n"
msgstr "Användning: ogginfo [flaggor] fil1.ogg [fil2.ogx … filN.ogv]\n\nogginfo är ett verktyg för att skriva ut information om Oggfiler\noch för att diagnostisera problem med dem.\nFullständig hjälp visas med ”ogginfo -h”.\n"

#. from tp:vorbis-tools-1.4.3
msgid "No input files specified. \"ogginfo -h\" for help\n"
msgstr "Ingen infil angiven.  ”ogginfo -h” för hjälp\n"

#. from tp:vorbis-tools-1.4.3
