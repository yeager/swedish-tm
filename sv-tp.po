#. from tp:texinfo-7.2.91
msgid "ignoring unrecognized TEXINFO_OUTPUT_FORMAT value `%s'"
msgstr "ignorerar okänt TEXINFO_OUTPUT_FORMAT värde `%s'"

#. from tp:texinfo-7.2.91
msgid "Usage: %s [OPTION]... TEXINFO-FILE..."
msgstr "Användning: %s [FLAGGA]... TEXINFO-FIL..."

#. from tp:texinfo-7.2.91
msgid "Translate Texinfo source documentation to various other formats, by default\nInfo files suitable for reading online with Emacs or standalone GNU Info.\n\nThis program is commonly installed as both `makeinfo' and `texi2any';\nthe behavior is identical, and does not depend on the installed name."
msgstr "Översätt Texinfo-källdokumentation till diverse andra format, som standard\ninfofiler som är lämpliga för läsning med Emacs eller fristående GNU Info.\n\nDetta program installerars vanligen som både ”makeinfo” och ”texi2any”;\nbeteende är identiskt och beror inte på namnet det installeras under."

#. from tp:texinfo-7.2.91
msgid "      --document-language=STR locale to use in translating Texinfo keywords\n                                for the output document (default C)"
msgstr "      --document-language=STR-språk att använda vid översättning av Texinfo-nyckelord\n                                för utdatadokumentet (standard C)."

#. from tp:texinfo-7.2.91
msgid "      --error-limit=NUM       quit after NUM errors (default %d)"
msgstr "      --error-limit=NUM       avsluta efter NUM fel (standard %d)"

#. from tp:texinfo-7.2.91
msgid "      --force                 preserve output even if errors"
msgstr "      --force                 preservera utdata även om det uppstår fel"

#. from tp:texinfo-7.2.91
msgid "      --help                  display this help and exit"
msgstr "    --help                  visa denna hjälptext och avsluta"

#. from tp:texinfo-7.2.91
msgid "      --no-validate           suppress node cross-reference validation"
msgstr "      --no-validate          dämpa validering av nodkorsreferens"

#. from tp:texinfo-7.2.91
msgid "      --no-warn               suppress warnings (but not errors)"
msgstr "      --no-warn               dämpa varningar (men inte fel)"

#. from tp:texinfo-7.2.91
msgid "      --conf-dir=DIR          search also for initialization files in DIR"
msgstr "      --conf-dir=KAT          sök också efter initialiseringsfiler i KAT"

#. from tp:texinfo-7.2.91
msgid "      --init-file=FILE        load FILE to modify the default behavior"
msgstr "      --init-file=FIL        ladda FIL för att modifiera standardbeteendet"

#. from tp:texinfo-7.2.91
msgid "  -c, --set-customization-variable VAR=VAL  set customization variable VAR\n                                to value VAL"
msgstr "  -c, --set-customization-variable VAR=VAL  ställ in anpassningsvariabel VAR\n                                till värde VAL"

#. from tp:texinfo-7.2.91
msgid "      --trace-includes        print names of included files"
msgstr "      --trace-includes        skriv ut namnen på inkluderade filer"

#. from tp:texinfo-7.2.91
msgid "  -v, --verbose               explain what is being done"
msgstr "  -v, --verbose               förklara vad som görs"

#. from tp:texinfo-7.2.91
msgid "      --version               display version information and exit"
msgstr "    --version               visa versionsinformation och avsluta"

#. from tp:texinfo-7.2.91
msgid "Output format selection (default is to produce Info):"
msgstr "Val av utdataformat (standard är att producera info):"

#. from tp:texinfo-7.2.91
msgid "      --docbook               output Docbook XML"
msgstr "      --docbook               utdata Docbook XML"

#. from tp:texinfo-7.2.91
msgid "      --html                  output HTML"
msgstr "      --html               utdata HTML"

#. from tp:texinfo-7.2.91
msgid "      --epub3                 output EPUB 3"
msgstr "      --epub3               utdata EPUB 3"

#. from tp:texinfo-7.2.91
msgid "      --latex                 output LaTeX"
msgstr "      --latex               utdata LaTeX"

#. from tp:texinfo-7.2.91
msgid "      --plaintext             output plain text rather than Info"
msgstr "      --plaintext             utdata vanlig text istället för Info"

#. from tp:texinfo-7.2.91
msgid "      --xml                   output Texinfo XML"
msgstr "      --xml               utdata Texinfo XML"

#. from tp:texinfo-7.2.91
msgid "      --dvi, --dvipdf, --ps, --pdf  call texi2dvi to generate given output,\n                                after checking validity of TEXINFO-FILE"
msgstr "      --dvi, --dvipdf, --ps, --pdf  anropa texi2dvi för att generera given utdata,\n                                efter att ha kontrollerat giltigheten av TEXINFO-FIL"

#. from tp:texinfo-7.2.91
msgid "General output options:"
msgstr "Allmänna utdataalternativ:"

#. from tp:texinfo-7.2.91
msgid "  -E, --macro-expand=FILE     output macro-expanded source to FILE,\n                                ignoring any @setfilename"
msgstr "  -E, --macro-expand=FILE     utdata makro-expanderad källkod till FIL,\n                               ignorerar alla @setfilename"

#. from tp:texinfo-7.2.91
msgid "      --no-headers            suppress node separators, Node: lines, and menus\n                                from Info output (thus producing plain text)\n                                or from HTML (thus producing shorter output).\n                                Also, if producing Info, write to\n                                standard output by default."
msgstr "      --no-headers            dämpa nodseparatorer, Nod: linjer och menyer\n                                från Info utdata (vilket producerar vanlig text)\n                                eller från HTML (vilket ger kortare utdata.\n                               Dessutom, om du producerar info, skriv till\n                                standard utdata som standard."

#. from tp:texinfo-7.2.91
msgid "      --no-split              suppress any splitting of the output;\n                                generate only one output file"
msgstr "      --no-split              dämpa eventuell uppdelning av utdatan;\n                                generera endast en utdatafil"

#. from tp:texinfo-7.2.91
msgid "      --[no-]number-sections  output chapter and sectioning numbers;\n                                default is on"
msgstr "      --[no-]number-sections  utdata kapter och sektionsnummer;\n                                standard är på"

#. from tp:texinfo-7.2.91
msgid "      --[no-]number-footnotes  number footnotes sequentially; default is on"
msgstr "      --[no-]number-footnotes  numrera fotnoter sekventiellt; standard är på"

#. from tp:texinfo-7.2.91
msgid "  -o, --output=DEST           output to DEST.\n                                With split output, create DEST as a directory\n                                and put the output files there.\n                                With non-split output, if DEST is already\n                                a directory or ends with a /,\n                                put the output file there.\n                                Otherwise, DEST names the output file."
msgstr "  -o, --output=DEST           utdata till DEST.\n                                Med uppdeladutdata, skapa DEST som en katalog\n                                och stoppa utdata filerna där.\n                                Med icke uppdeladutdata, om DEST redan finns\n                                som en katalog eller slutar med ett a/,\n                                stoppa utdata filerna där.\n                                Annars, så är DEST namnen utdata filen."

#. from tp:texinfo-7.2.91
msgid "      --disable-encoding      do not output accented and special characters\n                                in Info and plain text output based on document\n                                encoding"
msgstr "      ---disable-encoding       matar inte ut accenter och specialtecken\n                                 i Info och oformaterad text baserat på dokument\n                                 kodning"

#. from tp:texinfo-7.2.91
msgid "      --enable-encoding       override --disable-encoding (default)"
msgstr "      --enable-encoding       åsidosätta --disable-encoding (standard)"

#. from tp:texinfo-7.2.91
msgid "Options for Info and plain text:"
msgstr "Alternativ för info och vanlig text:"

#. from tp:texinfo-7.2.91
msgid "      --fill-column=NUM       break Info lines at NUM columns (default %d)"
msgstr "      --fill-column=NUM       bryt informationsrader vid NUM kolumner (standard %d)"

#. from tp:texinfo-7.2.91
msgid "      --footnote-style=STYLE  output footnotes in Info according to STYLE:\n                                `separate' to put them in their own node;\n                                `end' to put them at the end of the node, in\n                                which they are defined (this is the default)"
msgstr "      --footnote-style=STYLE  utdata fotnoter i Info enligt STIL:\n                                `separate' för att placera dem i sin egen nod;\n                                `end' för att placera dom vid slutet av nod;\n                                som de är definierade (detta är standard)"

#. from tp:texinfo-7.2.91
msgid "      --paragraph-indent=VAL  indent Info paragraphs by VAL spaces (default %d).\n                                If VAL is `none', do not indent; if VAL is\n                                `asis', preserve existing indentation."
msgstr "      --paragraph-indent=VAL dra in Info-stycken med VÄR-mellanslag (standard %d)\n                                Om VAL är `none', indrag inte; om VAL är\n                                `asis', bevara befintlig indragning."

#. from tp:texinfo-7.2.91
msgid "      --split-size=NUM        split Info files at size NUM (default %d)"
msgstr "      --split-size=NUM        dela upp informationsfiler vid storlek NUM (standard %d)"

#. from tp:texinfo-7.2.91
msgid "Options for HTML:"
msgstr "Alternativ för HTML:"

#. from tp:texinfo-7.2.91
msgid "      --css-include=FILE      include FILE in HTML <style> output;\n                                read stdin if FILE is -"
msgstr "      --css-include=FIL      inkludera FIL i HTML <style> utdata;\n                                läs stdin om FIL är -"

#. from tp:texinfo-7.2.91
msgid "      --css-ref=URL           generate CSS reference to URL"
msgstr "      --css-ref=URL           generera CSS-referens till URL"

#. from tp:texinfo-7.2.91
msgid "      --internal-links=FILE   produce list of internal links in FILE"
msgstr "      --internal-links=FIL   producera lista av interna länkar i FIL"

#. from tp:texinfo-7.2.91
msgid "      --split=SPLIT           split at SPLIT, where SPLIT may be `chapter',\n                                `section' or `node'"
msgstr "      --split=DELA           dela vid DELA där, DEL, kan vara antingen `kapitel',\n                                `sektion' eller `nod'"

#. from tp:texinfo-7.2.91
msgid "      --transliterate-file-names  use file names in ASCII transliteration"
msgstr "      --transliterate-file-names  använd filnamn i ASCII-translitteration"

#. from tp:texinfo-7.2.91
msgid "      --node-files            produce redirection files for nodes and\n                                anchors; default is set only if split"
msgstr "      --node-files            producera omdirigeringsfiler för noder och\n                                ankare; standard är endast inställd vid delning"

#. from tp:texinfo-7.2.91
msgid "Options for DVI/PS/PDF:"
msgstr "Alternativ för DVI/PS/PDF:"

#. from tp:texinfo-7.2.91
msgid "      --Xopt=OPT              pass OPT to texi2dvi; can be repeated"
msgstr "      --Xopt=FLG              skicka FLG till texi2dvi; får repeteras"

#. from tp:texinfo-7.2.91
msgid "Input file options:"
msgstr "Inmatningsfilalternativ:"

#. from tp:texinfo-7.2.91
msgid " -D VAR                       define the variable VAR, as with @set"
msgstr " -D VAR                       definiera variabeln VAR, som med @set"

#. from tp:texinfo-7.2.91
msgid " -D 'VAR VAL'                 define VAR to VAL (one shell argument)"
msgstr " -D 'VAR VAL'                 definiera VAR till VAL (ett skal-argument)"

#. from tp:texinfo-7.2.91
msgid " -I DIR                       append DIR to the @include search path"
msgstr " -I KAT                       lägg till KAT till @include-sökvägen"

#. from tp:texinfo-7.2.91
msgid " -P DIR                       prepend DIR to the @include search path"
msgstr " -P KAT                       lägg KAT till @include-sökvägen"

#. from tp:texinfo-7.2.91
msgid " -U VAR                       undefine the variable VAR, as with @clear"
msgstr " -U VAR                       odefiniera variabeln VAR, som med @clear"

#. from tp:texinfo-7.2.91
msgid "Conditional processing in input:"
msgstr "Villkorlig bearbetning i indata:"

#. from tp:texinfo-7.2.91
msgid "      --ifdocbook       process @ifdocbook and @docbook"
msgstr "  --no-ifdocbook    bearbeta inte @ifdocbook och @docbook text"

#. from tp:texinfo-7.2.91
msgid "      --ifhtml          process @ifhtml and @html"
msgstr "  --ifxml           bearbeta @ifxml och @xml"

#. from tp:texinfo-7.2.91
msgid "      --ifinfo          process @ifinfo"
msgstr "  --no-ifinfo       bearbeta inte @ifinfo-text"

#. from tp:texinfo-7.2.91
msgid "      --iflatex         process @iflatex and @latex"
msgstr "  --iflatex         bearbeta @iflatex och @latex"

#. from tp:texinfo-7.2.91
msgid "      --ifplaintext     process @ifplaintext"
msgstr "  --no-ifplaintext  bearbeta inte @ifplaintext-text"

#. from tp:texinfo-7.2.91
msgid "      --iftex           process @iftex and @tex"
msgstr "  --iftex           bearbeta @iftex och @tex"

#. from tp:texinfo-7.2.91
msgid "      --ifxml           process @ifxml and @xml"
msgstr "  --ifxml           bearbeta @ifxml och @xml"

#. from tp:texinfo-7.2.91
msgid "  By default, an --ifFORMAT setting is on only when the output format\n  is FORMAT; for example, --ifhtml is on when outputting HTML.\n  Also, when --ifFORMAT is on, @ifnotFORMAT text is not processed."
msgstr "  Som standard är en --ifFORMAT-inställning endast aktiverad när utdataformatet\n  är FORMAT; till exempel, --ifhtml är aktiverat vid utmatning av HTML\n  Också, när --ifFORMAT är på, @ifnotFORMAT text bearbetas inte."

#. from tp:texinfo-7.2.91
msgid "  Each --ifFORMAT option may be prefixed with `--no-' to negate it;\n  for example, --no-ifhtml means not to process @ifhtml or @html text,\n  and to process @ifnothtml text."
msgstr "  Varje --ifFORMAT alternativ kan prefixas med `--no-' för att negera det;\n  till exempel, --no-ifhtml betyder att inte bearbeta @ifhtml eller @html text,\n  och att bearbeta @ifnothtml text."

#. from tp:texinfo-7.2.91
msgid "  %s foo.texi                      write Info"
msgstr "  %s foo.texi                      skriv Info"

#. from tp:texinfo-7.2.91
msgid "  %s --html foo.texi               write HTML"
msgstr "  %s --html foo.texi               skriv HTML"

#. from tp:texinfo-7.2.91
msgid "  %s --xml foo.texi                write Texinfo XML"
msgstr "  %s --xml foo.texi                skriv Texinfo XML"

#. from tp:texinfo-7.2.91
msgid "  %s --docbook foo.texi            write Docbook XML"
msgstr "  %s --docbook foo.texi            skriv Docbook XML"

#. from tp:texinfo-7.2.91
msgid "  %s --plaintext foo.texi          write plain text to standard output"
msgstr "  %s --plaintext foo.texi          skriv vanlig text till standard utdata"

#. from tp:texinfo-7.2.91
msgid "  %s --pdf foo.texi                write PDF using texi2dvi"
msgstr "  %s --pdf foo.texi                skriv PDF genom att använda texi2dvi"

#. from tp:texinfo-7.2.91
msgid "  %s --html --no-headers foo.texi  write html without node lines, menus"
msgstr "  %s --html --no-headers foo.texi  skriv html utan nodrader, menyer"

#. from tp:texinfo-7.2.91
msgid "  %s --number-sections foo.texi    write Info with numbered sections"
msgstr "  %s --number-sections foo.texi    skriv Info med numrerade avsnitt"

#. from tp:texinfo-7.2.91
msgid "  %s --no-split foo.texi           write one Info file however big"
msgstr "  %s --no-split foo.texi           skriv en infofil, hur stor den än är"

#. from tp:texinfo-7.2.91
msgid "%s: --footnote-style arg must be `separate' or `end', not `%s'."
msgstr "%s: --footnote-style argumentet måste vara `separate' eller `end', inte `%s'."

#. from tp:texinfo-7.2.91
msgid "%s is not a valid split possibility"
msgstr "%s är inte en giltig delningsmöjlighet"

#. from tp:texinfo-7.2.91
msgid "%s: --paragraph-indent arg must be numeric/`none'/`asis', not `%s'."
msgstr "%s: --paragraph-indent argumentet måste vara numeriskt/`none'/`asis', inte `%s'."

#. from tp:texinfo-7.2.91
msgid "overwriting file: %s"
msgstr "skriver över fil: %s"

#. from tp:texinfo-7.2.91
msgid "unknown tree transformation %s"
msgstr "okänd trädtransformation %s"

#. from tp:texinfo-7.2.91
msgid "ignoring splitting for converted format %s (for %s)"
msgstr "ignorerar delning för konverterat format %s (för %s)"

#. from tp:texinfo-7.2.91
msgid "ignoring splitting for format %s"
msgstr "hoppar över uppdelning för format %s"

#. from tp:texinfo-7.2.91
msgid "%s: when generating %s, only one input FILE may be specified with -o"
msgstr "%s: vid generering av %s kan endast en indata-FIL anges med -o"

#. from tp:texinfo-7.2.91
msgid "--Xopt option without printed output"
msgstr "--Xopt flagga utan utskrift"

#. from tp:texinfo-7.2.91
msgid "error loading %s: %s"
msgstr "fel vid inläsning %s: %s"

#. from tp:texinfo-7.2.91
msgid "%s: missing file argument."
msgstr "%s: filargument saknas."

#. from tp:texinfo-7.2.91
msgid "input file %s; did you mean %s?"
msgstr "inmatningsfil %s; menade du %s?"

#. from tp:texinfo-7.2.91
msgid "error on closing tree dump file %s: %s"
msgstr "fel vid stängning av träddumpfil %s: %s"

#. from tp:texinfo-7.2.91
msgid "error on closing macro expand file %s: %s"
