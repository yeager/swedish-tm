#. from tp:procps-ng-man-4.0.6rc1
msgid "*\\ \\ B<d> | B<s>\\ \\ :I<Change-Delay-Time-interval >"
msgstr "*\\ \\ B<d> | B<s>\\ \\ :I<Ändra tidsfördröjningsintervallet>"

