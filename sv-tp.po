msgid "      --fetchsizelimit set fetch message size limit\n"
msgstr "      --fetchsizelimit ange gräns för hämtade meddelandens storlek\n"

#. from tp:fetchmail-6.6.0.rc3
msgid "      --fastuidl    do a binary search for UIDLs\n"
msgstr "      --fastuidl    gör en binärsökning efter UIDL:er\n"

#. from tp:fetchmail-6.6.0.rc3
msgid "  -e, --expunge     set max deletions between expunges\n"
msgstr "  -e, --expunge     ange högsta antal raderingar mellan tömningar\n"

#. from tp:fetchmail-6.6.0.rc3
msgid "  -m, --mda         set MDA to use for forwarding\n"
msgstr "  -m, --mda         ange MDA för vidarebefordran\n"

#. from tp:fetchmail-6.6.0.rc3
msgid "      --bsmtp       set output BSMTP file\n"
msgstr "      --bsmtp       ange BSMTP-utdatafil\n"

#. from tp:fetchmail-6.6.0.rc3
msgid "      --lmtp        use LMTP (RFC2033) for delivery\n"
msgstr "      --lmtp        använd LMTP (RFC2033) för leverans\n"

