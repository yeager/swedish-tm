#. from tp:wget-1.25.0
msgid "Encoding %s isn't valid\n"
msgstr "Kodningen %s är inte giltig\n"

#. from tp:wget-1.25.0
msgid "Conversion from %s to %s isn't supported\n"
msgstr "Konvertering från %s till %s stöds inte\n"

#. from tp:wget-1.25.0
msgid "Incomplete or invalid multibyte sequence encountered\n"
msgstr "Ofullständig eller ogiltig multibyte-sekvens påträffades\n"

#. from tp:wget-1.25.0
msgid "Unhandled errno %d\n"
msgstr "Ohanterat felnummer %d\n"

#. from tp:wget-1.25.0
msgid "locale_to_utf8: locale is unset\n"
msgstr "locale_to_utf8: lokalen är inte inställd\n"

#. from tp:wget-1.25.0
msgid "idn_encode failed (%d): %s\n"
msgstr "idn_encode misslyckades (%d): %s\n"

#. from tp:wget-1.25.0
msgid "Failed to convert to lower: %d: %s\n"
msgstr "Misslyckades att konvertera till gemen: %d: %s\n"

#. from tp:wget-1.25.0
msgid "\nRedirecting output to %s.\n"
msgstr "\nOmdirigerar utdata till %s.\n"

#. from tp:wget-1.25.0
msgid "%s: %s; disabling logging.\n"
msgstr "%s: %s; deaktiverar loggning.\n"

#. from tp:wget-1.25.0
msgid "Usage: %s [OPTION]... [URL]...\n"
msgstr "Användning: %s [FLAGGA]... [URL]...\n"

#. from tp:wget-1.25.0
msgid "Mandatory arguments to long options are mandatory for short options too.\n\n"
msgstr "Obligatoriska argument till långa flaggor är obligatoriska även för de korta.\n\n"

#. from tp:wget-1.25.0
msgid "Startup:\n"
msgstr "Uppstart:\n"

#. from tp:wget-1.25.0
msgid "  -V,  --version                   display the version of Wget and exit\n"
msgstr "  -V,  --version                   visa Wgets version och avsluta\n"

#. from tp:wget-1.25.0
msgid "  -h,  --help                      print this help\n"
msgstr "  -h,  --help                      skriv ut denna hjälp.\n"

#. from tp:wget-1.25.0
msgid "  -b,  --background                go to background after startup\n"
msgstr "  -b,  --background                gå till bakgrunden efter uppstart\n"

#. from tp:wget-1.25.0
msgid "  -e,  --execute=COMMAND           execute a `.wgetrc'-style command\n"
msgstr "  -e,  --execute=KOMMANDO          kör ett kommando i ”.wgetrc”-stil\n"

#. from tp:wget-1.25.0
msgid "Logging and input file:\n"
msgstr "Loggning och inmatningsfil:\n"

#. from tp:wget-1.25.0
msgid "  -o,  --output-file=FILE          log messages to FILE\n"
msgstr "  -o,  --output-file=FIL           logga meddelanden till FIL\n"

#. from tp:wget-1.25.0
msgid "  -a,  --append-output=FILE        append messages to FILE\n"
msgstr "  -a,  --append-output=FIL         lägg till meddelanden till FIL\n"

#. from tp:wget-1.25.0
msgid "  -d,  --debug                     print lots of debugging information\n"
msgstr "  -d,  --debug                     skriv ut massor av felsökningsinformation\n"

#. from tp:wget-1.25.0
msgid "       --wdebug                    print Watt-32 debug output\n"
msgstr "       --wdebug                    skriv ut Watt-32-felsökningsinformation\n"

#. from tp:wget-1.25.0
msgid "  -q,  --quiet                     quiet (no output)\n"
msgstr "  -q,  --quiet                     tyst (ingen utdata)\n"

#. from tp:wget-1.25.0
msgid "  -v,  --verbose                   be verbose (this is the default)\n"
msgstr "  -v,  --verbose                   var informativ (detta är standard)\n"

#. from tp:wget-1.25.0
msgid "  -nv, --no-verbose                turn off verboseness, without being quiet\n"
msgstr "  -nv, --no-verbose                stäng av information, utan att vara tyst\n"

#. from tp:wget-1.25.0
msgid "       --report-speed=TYPE         output bandwidth as TYPE.  TYPE can be bits\n"
msgstr "       --report-speed=TYP          skriv ut bandvidd som TYP.  TYP kan vara bits\n"

#. from tp:wget-1.25.0
msgid "  -i,  --input-file=FILE           download URLs found in local or external FILE\n"
msgstr "  -i,  --input-file=FIL            hämta URL:ar som finns i lokal eller extern\n                                     FIL\n"

#. from tp:wget-1.25.0
msgid "       --input-metalink=FILE       download files covered in local Metalink FILE\n"
msgstr "       --input-metalink=FIL        hämta URL:ar som täcks av lokal Metalink-FIL\n"

#. from tp:wget-1.25.0
msgid "  -F,  --force-html                treat input file as HTML\n"
msgstr "  -F,  --force-html                behandla inmatningsfil som HTML\n"

#. from tp:wget-1.25.0
msgid "  -B,  --base=URL                  resolves HTML input-file links (-i -F)\n                                     relative to URL\n"
msgstr "  -B,  --base=URL                  slår upp HTML-länkar från indatafil\n                                    (-i -F) relativa till URL\n"

#. from tp:wget-1.25.0
msgid "       --config=FILE               specify config file to use\n"
msgstr "       --config=FIL                ange konfigurationsfil att använda\n"

#. from tp:wget-1.25.0
msgid "       --no-config                 do not read any config file\n"
msgstr "       --no-config                 läs ingen konfigurationsfil\n"

#. from tp:wget-1.25.0
msgid "       --rejected-log=FILE         log reasons for URL rejection to FILE\n"
msgstr "       --rejected-log=FIL          logga anledningar till URL-avvisanden till FIL\n"

#. from tp:wget-1.25.0
msgid "Download:\n"
msgstr "Hämta:\n"

#. from tp:wget-1.25.0
msgid "  -t,  --tries=NUMBER              set number of retries to NUMBER (0 unlimits)\n"
msgstr "  -t,  --tries=ANTAL               sätt antal försök till ANTAL (0 obegränsar)\n"

#. from tp:wget-1.25.0
msgid "       --retry-connrefused         retry even if connection is refused\n"
msgstr "       --retry-connrefused         försök igen även om anslutningen nekas\n"

#. from tp:wget-1.25.0
msgid "       --retry-on-host-error       consider host errors as non-fatal, transient errors\n"
msgstr "       --retry-on-host-error       betrakta värdfel som icke ödesdigra, transienta fel\n"

#. from tp:wget-1.25.0
msgid "       --retry-on-http-error=ERRORS    comma-separated list of HTTP errors to retry\n"
msgstr "       --retry-on-http-error=FEL       kommaseparerad lista över HTTP-fel att försöka igen vid\n"

#. from tp:wget-1.25.0
msgid "  -O,  --output-document=FILE      write documents to FILE\n"
msgstr "  -O,  --output-document=FIL       skriv dokument till FIL\n"

#. from tp:wget-1.25.0
msgid "  -nc, --no-clobber                skip downloads that would download to\n                                     existing files (overwriting them)\n"
msgstr "  -nc, --no-clobber                hoppa över hämtningar som skulle hämta till\n                                     redan befintliga filer (skriva över dem)\n"

#. from tp:wget-1.25.0
msgid "       --no-netrc                  don't try to obtain credentials from .netrc\n"
msgstr "       --no-netrc                  försök inte hämta kreditiv från .netrc\n"

#. from tp:wget-1.25.0
msgid "  -c,  --continue                  resume getting a partially-downloaded file\n"
msgstr "  -c,  --continue                  återuppta hämtning av delvis hämtad fil\n"

#. from tp:wget-1.25.0
msgid "       --start-pos=OFFSET          start downloading from zero-based position OFFSET\n"
msgstr "       --start-pos=AVSTÅND         börja hämta från nollbaserad position AVSTÅND\n"

#. from tp:wget-1.25.0
msgid "       --progress=TYPE             select progress gauge type\n"
msgstr "       --progress=TYP              välj typ av förloppsindikator\n"

#. from tp:wget-1.25.0
msgid "       --show-progress             display the progress bar in any verbosity mode\n"
msgstr "       --show-progress             visa förloppsmätare i alla informationslägen\n"

#. from tp:wget-1.25.0
msgid "  -N,  --timestamping              don't re-retrieve files unless newer than\n                                     local\n"
msgstr "  -N,  --timestamping              hämta inte om filer om de inte är nyare än\n                                     lokala\n"

#. from tp:wget-1.25.0
msgid "       --no-if-modified-since      don't use conditional if-modified-since get\n                                     requests in timestamping mode\n"
msgstr "       --no-if-modified-since      använd inte villkorliga if-modified-since get-\n                                     begäranden i tidsstämpelläge\n"

#. from tp:wget-1.25.0
msgid "       --no-use-server-timestamps  don't set the local file's timestamp by\n                                     the one on the server\n"
msgstr "       --no-use-server-timestamps  sätt inte den lokala filens tidsstämpel\n                                     efter den på servern\n"

#. from tp:wget-1.25.0
msgid "  -S,  --server-response           print server response\n"
msgstr "  -S,  --server-response           skriv ut serversvar\n"

#. from tp:wget-1.25.0
msgid "       --spider                    don't download anything\n"
msgstr "       --spider                    hämta ingenting\n"

#. from tp:wget-1.25.0
msgid "  -T,  --timeout=SECONDS           set all timeout values to SECONDS\n"
msgstr "  -T,  --timeout=SEKUNDER          sätt tidsgränser till SEKUNDER\n"

#. from tp:wget-1.25.0
msgid "       --dns-servers=ADDRESSES     list of DNS servers to query (comma separated)\n"
msgstr "       --dns-servers=ADRESSER      lista över DNS-servrar att fråga\n                                     (kommaseparerade)\n"

#. from tp:wget-1.25.0
msgid "       --bind-dns-address=ADDRESS  bind DNS resolver to ADDRESS (hostname or IP) on local host\n"
msgstr "       --bind-dns-address=ADRESS   bind till ADRESS (värdnamn eller IP) på den\n                                     lokala värden\n"

#. from tp:wget-1.25.0
msgid "       --dns-timeout=SECS          set the DNS lookup timeout to SECS\n"
msgstr "       --dns-timeout=SEK           sätt tidsgränsen för DNS-uppslagningar till\n                                     SEK\n"

#. from tp:wget-1.25.0
msgid "       --connect-timeout=SECS      set the connect timeout to SECS\n"
msgstr "       --connect-timeout=SEK       sätt anslutningstidsgränsen till SEK\n"

#. from tp:wget-1.25.0
msgid "       --read-timeout=SECS         set the read timeout to SECS\n"
msgstr "       --read-timeout=SEK          sätt lästidsgränsen till SEK\n"

#. from tp:wget-1.25.0
msgid "  -w,  --wait=SECONDS              wait SECONDS between retrievals\n                                     (applies if more then 1 URL is to be retrieved)\n"
msgstr "  -w,  --wait=SEKUNDER             vänta SEKUNDER mellan hämtningar\n                                     (gäller om mer än 1 URL skall hämtas)\n"

#. from tp:wget-1.25.0
msgid "       --waitretry=SECONDS         wait 1..SECONDS between retries of a retrieval\n                                     (applies if more then 1 URL is to be retrieved)\n"
msgstr "       --waitretry=SEKUNDER        vänta 1..SEKUNDER mellan hämtningsförsök\n                                     (gäller om mer än 1 URL skall hämtas)\n"

#. from tp:wget-1.25.0
msgid "       --random-wait               wait from 0.5*WAIT...1.5*WAIT secs between retrievals\n                                     (applies if more then 1 URL is to be retrieved)\n"
msgstr "       --random-wait               vänta från 0,5*VÄNTA…1,5*VÄNTA sekunder mellan hämtningar\n                                     (gäller om mer än 1 URL skall hämtas)\n"

#. from tp:wget-1.25.0
msgid "       --no-proxy                  explicitly turn off proxy\n"
msgstr "       --no-proxy                  stäng uttryckligen av proxy\n"

#. from tp:wget-1.25.0
msgid "  -Q,  --quota=NUMBER              set retrieval quota to NUMBER\n"
msgstr "  -Q,  --quota=ANTAL               ställ in mottagningskvot till ANTAL\n"

#. from tp:wget-1.25.0
msgid "       --bind-address=ADDRESS      bind to ADDRESS (hostname or IP) on local host\n"
msgstr "       --bind-address=ADRESS       bind till ADRESS (värdnamn eller IP) på\n                                     lokal värd\n"

#. from tp:wget-1.25.0
msgid "       --limit-rate=RATE           limit download rate to RATE\n"
msgstr "       --limit-rate=FART           begränsa hämtningshastighet till FART\n"

#. from tp:wget-1.25.0
msgid "       --no-dns-cache              disable caching DNS lookups\n"
msgstr "       --no-dns-cache              inaktivera mellanlagring av DNS-uppslag\n"

#. from tp:wget-1.25.0
msgid "       --restrict-file-names=OS    restrict chars in file names to ones OS allows\n"
msgstr "       --restrict-file-names=OS    begränsa tecken i filnamn till vad OS\n                                     tillåter\n"

#. from tp:wget-1.25.0
msgid "       --ignore-case               ignore case when matching files/directories\n"
msgstr "       --ignore-case               ignorera skiftläge när filer/kataloger\n                                     matchas\n"

#. from tp:wget-1.25.0
msgid "  -4,  --inet4-only                connect only to IPv4 addresses\n"
msgstr "  -4,  --inet4-only                anslut endast till IPv4-adresser\n"

#. from tp:wget-1.25.0
msgid "  -6,  --inet6-only                connect only to IPv6 addresses\n"
msgstr "  -6,  --inet6-only                anslut endast till IPv6-adresser\n"

#. from tp:wget-1.25.0
msgid "       --prefer-family=FAMILY      connect first to addresses of specified family,\n                                     one of IPv6, IPv4, or none\n"
msgstr "       --prefer-family=FAMILJ      anslut först till adresser av angiven familj,\n                                     en av IPv6, IPv4 eller none\n"

#. from tp:wget-1.25.0
msgid "       --user=USER                 set both ftp and http user to USER\n"
msgstr "       --user=ANVÄNDARE            ställ in både ftp- och http-användare till\n                                     ANVÄNDARE\n"

#. from tp:wget-1.25.0
msgid "       --password=PASS             set both ftp and http password to PASS\n"
msgstr "       --password=LÖSEN            ställ in både ftp- och http-lösenord till\n                                     LÖSEN\n"

#. from tp:wget-1.25.0
msgid "       --ask-password              prompt for passwords\n"
msgstr "       --ask-password              fråga efter lösenord\n"

#. from tp:wget-1.25.0
msgid "       --use-askpass=COMMAND       specify credential handler for requesting \n                                     username and password.  If no COMMAND is \n                                     specified the WGET_ASKPASS or the SSH_ASKPASS \n                                     environment variable is used.\n"
msgstr "       --use-askpass=KOMMANDO      ange kreditivhanterare för att begära\n                                     användarnamn och lösenord.  Om inget\n                                     KOMMANDO anges används miljövariabeln\n                                     WGET_ASKPASS eller SSH_ASKPASS.\n"

#. from tp:wget-1.25.0
msgid "       --no-iri                    turn off IRI support\n"
msgstr "       --no-iri                    stäng av IRI-stöd\n"

#. from tp:wget-1.25.0
msgid "       --local-encoding=ENC        use ENC as the local encoding for IRIs\n"
msgstr "       --local-encoding=KOD        använd KOD som lokal kodning för IRI:er\n"

#. from tp:wget-1.25.0
msgid "       --remote-encoding=ENC       use ENC as the default remote encoding\n"
msgstr "       --remote-encoding=KOD       använd KOD som standard fjärrkodning\n"

#. from tp:wget-1.25.0
msgid "       --unlink                    remove file before clobber\n"
msgstr "       --unlink                    ta bort filer före de skrivs över\n"

#. from tp:wget-1.25.0
msgid "       --keep-badhash              keep files with checksum mismatch (append .badhash)\n"
msgstr "       --keep-badhash              behåll filer med kontrollsummefel (lägg till .badhash)\n"

#. from tp:wget-1.25.0
msgid "       --metalink-index=NUMBER     Metalink application/metalink4+xml metaurl ordinal NUMBER\n"
msgstr "       --metalink-index=TAL        Metalink application/metalink4+xml metaurl ordningsTAL\n"

#. from tp:wget-1.25.0
msgid "       --metalink-over-http        use Metalink metadata from HTTP response headers\n"
msgstr "       --metalink-over-http        använd Metalink-metadata från HTTP-\n                                     svarshuvuden\n"

#. from tp:wget-1.25.0
msgid "       --preferred-location        preferred location for Metalink resources\n"
msgstr "       --preferred-location        önskad plats för Metalink-resurser\n"

#. from tp:wget-1.25.0
msgid "       --xattr                     turn on storage of metadata in extended file attributes\n"
msgstr "       --xattr                     slå på lagring av metadata i utökade filattribut\n"

#. from tp:wget-1.25.0
msgid "Directories:\n"
msgstr "Kataloger:\n"

#. from tp:wget-1.25.0
msgid "  -nd, --no-directories            don't create directories\n"
msgstr "  -nd, --no-directories            skapa inte kataloger\n"

#. from tp:wget-1.25.0
msgid "  -x,  --force-directories         force creation of directories\n"
msgstr "  -x,  --force-directories         tvinga skapandet av kataloger\n"

#. from tp:wget-1.25.0
msgid "  -nH, --no-host-directories       don't create host directories\n"
msgstr "  -nH, --no-host-directories       skapa inte värdkataloger\n"

#. from tp:wget-1.25.0
msgid "       --protocol-directories      use protocol name in directories\n"
msgstr "       --protocol-directories      använd protokollnamn i kataloger\n"

#. from tp:wget-1.25.0
msgid "  -P,  --directory-prefix=PREFIX   save files to PREFIX/..\n"
msgstr "  -P,  --directory-prefix=PREFIX   spara filer till PREFIX/…\n"

#. from tp:wget-1.25.0
msgid "       --cut-dirs=NUMBER           ignore NUMBER remote directory components\n"
msgstr "       --cut-dirs=ANTAL            ignorera ANTAL fjärrkatalogkomponenter\n"

#. from tp:wget-1.25.0
msgid "HTTP options:\n"
msgstr "HTTP-flaggor:\n"

#. from tp:wget-1.25.0
msgid "       --http-user=USER            set http user to USER\n"
msgstr "       --http-user=ANVÄNDARE    ställ in http-användare till ANVÄNDARE\n"

#. from tp:wget-1.25.0
msgid "       --http-password=PASS        set http password to PASS\n"
msgstr "       --http-password=LÖSEN       ställ in http-lösenord till LÖSEN\n"

#. from tp:wget-1.25.0
msgid "       --no-cache                  disallow server-cached data\n"
msgstr "       --no-cache                  tillåt inte mellanlagrad data på servern\n"

#. from tp:wget-1.25.0
msgid "       --default-page=NAME         change the default page name (normally\n                                     this is 'index.html'.)\n"
msgstr "       --default-page=NAMN         ändra namnet för standardsidan (vanligtvis\n                                     är detta ”index.html”.)\n"

#. from tp:wget-1.25.0
msgid "  -E,  --adjust-extension          save HTML/CSS documents with proper extensions\n"
msgstr "  -E,  --adjust-extension          spara HTML/CSS-dokument med korrekta ändelser\n"

#. from tp:wget-1.25.0
msgid "       --ignore-length             ignore 'Content-Length' header field\n"
msgstr "       --ignore-length             ignorera ”Content-Length”-rubrikfält\n"

#. from tp:wget-1.25.0
msgid "       --header=STRING             insert STRING among the headers\n"
msgstr "       --header=STRÄNG             infoga STRÄNG i huvudet\n"

#. from tp:wget-1.25.0
msgid "       --compression=TYPE          choose compression, one of auto, gzip and none. (default: none)\n"
msgstr "       --compression=TYP           välj komprimering, en av auto, gzip och none. (standard: none)\n"

#. from tp:wget-1.25.0
msgid "       --max-redirect              maximum redirections allowed per page\n"
msgstr "       --max-redirect              maximalt tillåtna omdirigeringar per sida\n"

#. from tp:wget-1.25.0
msgid "       --proxy-user=USER           set USER as proxy username\n"
msgstr "       --proxy-user=ANVÄNDARE      ställ in ANVÄNDARE som proxy-användarnamn\n"

#. from tp:wget-1.25.0
msgid "       --proxy-password=PASS       set PASS as proxy password\n"
msgstr "       --proxy-password=LÖSEN      ställ in LÖSEN som proxy-lösenord\n"

#. from tp:wget-1.25.0
msgid "       --referer=URL               include 'Referer: URL' header in HTTP request\n"
msgstr "       --referer=URL               inkludera ”Referer: URL”-rubrik i\n                                     HTTP-begäran.\n"

#. from tp:wget-1.25.0
msgid "       --save-headers              save the HTTP headers to file\n"
msgstr "       --save-headers              spara HTTP-rubrikerna till fil\n"

#. from tp:wget-1.25.0
msgid "  -U,  --user-agent=AGENT          identify as AGENT instead of Wget/VERSION\n"
msgstr "  -U,  --user-agent=AGENT          identifiera som AGENT istället för\n                                     Wget/VERSION\n"

#. from tp:wget-1.25.0
msgid "       --no-http-keep-alive        disable HTTP keep-alive (persistent connections)\n"
msgstr "       --no-http-keep-alive        inaktivera HTTP keep-alive (varaktiga\n                                     anslutningar)\n"

#. from tp:wget-1.25.0
msgid "       --no-cookies                don't use cookies\n"
msgstr "       --no-cookies                använd inte kakor\n"

#. from tp:wget-1.25.0
msgid "       --load-cookies=FILE         load cookies from FILE before session\n"
msgstr "       --load-cookies=FIL          läs in kakor från FIL före sessionen\n"

#. from tp:wget-1.25.0
msgid "       --save-cookies=FILE         save cookies to FILE after session\n"
msgstr "       --save-cookies=FIL          spara kakor till FIL efter sessionen\n"

#. from tp:wget-1.25.0
msgid "       --keep-session-cookies      load and save session (non-permanent) cookies\n"
msgstr "       --keep-session-cookies      läs in och spara sessionskakor\n                                     (icke-permanenta)\n"

#. from tp:wget-1.25.0
msgid "       --post-data=STRING          use the POST method; send STRING as the data\n"
msgstr "       --post-data=STRÄNG          använd POST-metoden; skicka STRÄNG som data\n"

#. from tp:wget-1.25.0
msgid "       --post-file=FILE            use the POST method; send contents of FILE\n"
msgstr "       --post-file=FIL             använd POST-metoden; skicka innehållet i FIL\n"

#. from tp:wget-1.25.0
msgid "       --method=HTTPMethod         use method \"HTTPMethod\" in the request\n"
msgstr "       --method=HTTPMetod          använd metoden ”HTTPMetod” i begäran\n"

#. from tp:wget-1.25.0
msgid "       --body-data=STRING          send STRING as data. --method MUST be set\n"
msgstr "       --body-data=STRÄNG          skicka STRÄNG som data.  --method MÅSTE anges\n"

#. from tp:wget-1.25.0
msgid "       --body-file=FILE            send contents of FILE. --method MUST be set\n"
msgstr "       --body-file=FIL             innehållet i FIL.  --method MÅSTE anges\n"

#. from tp:wget-1.25.0
msgid "       --content-disposition       honor the Content-Disposition header when\n                                     choosing local file names (EXPERIMENTAL)\n"
msgstr "       --content-disposition       ta hänsyn till huvudet Content-Disposition\n                                     när lokala filnamn väljs (EXPERIMENTELL)\n"

#. from tp:wget-1.25.0
msgid "       --content-on-error          output the received content on server errors\n"
msgstr "       --content-on-error          skriv ut det mottagna innehållet vid serverfel\n"

#. from tp:wget-1.25.0
msgid "       --auth-no-challenge         send Basic HTTP authentication information\n                                     without first waiting for the server's\n                                     challenge\n"
msgstr "       --auth-no-challenge         skicka Basic HTTP-autentiseringsinformation\n                                     utan att först vänta på serverns\n                                     kontrollfråga\n"

#. from tp:wget-1.25.0
msgid "HTTPS (SSL/TLS) options:\n"
msgstr "HTTPS-flaggor (SSL/TLS):\n"

#. from tp:wget-1.25.0
msgid "       --secure-protocol=PR        choose secure protocol, one of auto, SSLv2,\n                                     SSLv3, TLSv1, TLSv1_1, TLSv1_2, TLSv1_3 and PFS\n"
msgstr "       --secure-protocol=PR        välj säkert protokoll, ett av auto, SSLv2,\n                                     SSLv3, TLSv1, TLSv1_1, TLSv1_2, TLSv1_3 och\n                                     PFS\n"

#. from tp:wget-1.25.0
msgid "       --https-only                only follow secure HTTPS links\n"
msgstr "       --https-only                följ endast säkra HTTPS-länkar\n"

#. from tp:wget-1.25.0
msgid "       --no-check-certificate      don't validate the server's certificate\n"
msgstr "       --no-check-certificate      validera inte serverns certifikat\n"

#. from tp:wget-1.25.0
msgid "       --certificate=FILE          client certificate file\n"
msgstr "       --certificate=FIL           klientcertifikatfil\n"

#. from tp:wget-1.25.0
msgid "       --certificate-type=TYPE     client certificate type, PEM or DER\n"
msgstr "       --certificate-type=TYP      klientcertifikattyp, PEM eller DER\n"

#. from tp:wget-1.25.0
msgid "       --private-key=FILE          private key file\n"
msgstr "       --private-key=FIL           fil med privat nyckel\n"

#. from tp:wget-1.25.0
msgid "       --private-key-type=TYPE     private key type, PEM or DER\n"
msgstr "       --private-key-type=TYP      typ av privat nyckel, PEM eller DER\n"

#. from tp:wget-1.25.0
msgid "       --ca-certificate=FILE       file with the bundle of CAs\n"
msgstr "       --ca-certificate=FIL        fil med paketerade CA:er\n"

#. from tp:wget-1.25.0
msgid "       --ca-directory=DIR          directory where hash list of CAs is stored\n"
msgstr "       --ca-directory=KAT          katalog där hash-lista av CA:er lagras\n"

#. from tp:wget-1.25.0
msgid "       --crl-file=FILE             file with bundle of CRLs\n"
msgstr "       --crl-file=FIL              fil med paketerade CRL:er\n"

#. from tp:wget-1.25.0
msgid "       --pinnedpubkey=FILE/HASHES  Public key (PEM/DER) file, or any number\n                                   of base64 encoded sha256 hashes preceded by\n                                   'sha256//' and separated by ';', to verify\n                                   peer against\n"
msgstr "       --pinnedpubkey=FIL/SUMMOR   Publik nyckel-fil (PEM/DER), eller\n                                   godtyckligt antal base64-kodade sha256-\n                                   kontrollsummor föregångna av ”sha256//” och\n                                   separerade av ”;”, att verifiera motparten\n                                   mot.\n"

#. from tp:wget-1.25.0
msgid "       --random-file=FILE          file with random data for seeding the SSL PRNG\n"
msgstr "       --random-file=FIL           fil med slumpfrö för att så SSL PRNG\n"

#. from tp:wget-1.25.0
msgid "       --egd-file=FILE             file naming the EGD socket with random data\n"
msgstr "       --egd-file=FIL              fil med namnet för EGD-uttag med slumpdata\n"

#. from tp:wget-1.25.0
msgid "       --ciphers=STR           Set the priority string (GnuTLS) or cipher list string (OpenSSL) directly.\n                                   Use with care. This option overrides --secure-protocol.\n                                   The format and syntax of this string depend on the specific SSL/TLS engine.\n"
msgstr "       --ciphers=STR           Sätt prioritetssträngen (GnuTLS) eller chifferliststrängen (OpenSSL) direkt.\n                                   Använd med försiktighet.  Denna flagga åsidosätter --secure-protocol.\n                                   Formatet och syntaxen på denna sträng beror på den specifika SSL/TLS-motorn.\n"

#. from tp:wget-1.25.0
msgid "HSTS options:\n"
msgstr "HSTS-flaggor:\n"

#. from tp:wget-1.25.0
msgid "       --no-hsts                   disable HSTS\n"
msgstr "       --no-hsts                   avaktivera HSTS\n"

#. from tp:wget-1.25.0
msgid "       --hsts-file                 path of HSTS database (will override default)\n"
msgstr "       --hsts-file                 sökväg till HSTS-databas (kommer åsidosätta standard)\n"

#. from tp:wget-1.25.0
msgid "FTP options:\n"
msgstr "FTP-flaggor:\n"

#. from tp:wget-1.25.0
msgid "       --ftp-stmlf                 use Stream_LF format for all binary FTP files\n"
msgstr "       --ftp-stmlf                 använd formatet Stream_LF för alla binära\n                                     FTP-filer\n"

#. from tp:wget-1.25.0
msgid "       --ftp-user=USER             set ftp user to USER\n"
msgstr "       --ftp-user=ANVÄNDARE        ställ in ftp-användare till ANVÄNDARE\n"

#. from tp:wget-1.25.0
msgid "       --ftp-password=PASS         set ftp password to PASS\n"
msgstr "       --ftp-password=LÖSEN        ställ in ftp-lösenord till LÖSEN\n"

#. from tp:wget-1.25.0
msgid "       --no-remove-listing         don't remove '.listing' files\n"
msgstr "       --no-remove-listing         ta inte bort ”.listing”-filer\n"

#. from tp:wget-1.25.0
msgid "       --no-glob                   turn off FTP file name globbing\n"
msgstr "       --no-glob                   stäng av FTP-filnamnsmatchning\n"

#. from tp:wget-1.25.0
msgid "       --no-passive-ftp            disable the \"passive\" transfer mode\n"
msgstr "       --no-passive-ftp            avaktivera ”passivt” överföringsläge\n"

#. from tp:wget-1.25.0
msgid "       --preserve-permissions      preserve remote file permissions\n"
msgstr "       --preserve-permissions      behåll fjärrfilens rättigheter\n"

#. from tp:wget-1.25.0
msgid "       --retr-symlinks             when recursing, get linked-to files (not dir)\n"
msgstr "       --retr-symlinks             när rekursiv, hämta länkade-till filer (inte\n                                     kat)\n"

#. from tp:wget-1.25.0
msgid "FTPS options:\n"
msgstr "FTPS-flaggor:\n"

#. from tp:wget-1.25.0
msgid "       --ftps-implicit                 use implicit FTPS (default port is 990)\n"
msgstr "       --ftps-implicit                 använd implicit FTPS (standardport är\n                                         990)\n"

#. from tp:wget-1.25.0
msgid "       --ftps-resume-ssl               resume the SSL/TLS session started in the control connection when\n                                         opening a data connection\n"
msgstr "       --ftps-resume-ssl               återuppta SSL/TLS-sessionen som startades\n                                         i styrförbindelsen när en\n                                         dataförbindelse öppnas\n"

#. from tp:wget-1.25.0
msgid "       --ftps-clear-data-connection    cipher the control channel only; all the data will be in plaintext\n"
msgstr "       --ftps-clear-data-connection    chiffrera bara styrkanalen; all data\n                                         kommer skickas som klartext\n"

#. from tp:wget-1.25.0
msgid "       --ftps-fallback-to-ftp          fall back to FTP if FTPS is not supported in the target server\n"
msgstr "       --ftps-fallback-to-ftp          fall tillbaka till FTP om FTPS inte\n                                         stödjs av målservern\n"

#. from tp:wget-1.25.0
msgid "WARC options:\n"
msgstr "WARC-flaggor:\n"

#. from tp:wget-1.25.0
msgid "       --warc-file=FILENAME        save request/response data to a .warc.gz file\n"
msgstr "       --warc-file=FILNAMN         spara begäran-/svardata i en .warc.gz-fil\n"

#. from tp:wget-1.25.0
msgid "       --warc-header=STRING        insert STRING into the warcinfo record\n"
msgstr "       --warc-header=STRÄNG        infoga STRÄNG i warcinfo-posten\n"

#. from tp:wget-1.25.0
msgid "       --warc-max-size=NUMBER      set maximum size of WARC files to NUMBER\n"
msgstr "       --warc-max-size=ANTAL       sätt maximal storlek på WARC-filer till ANTAL\n"

#. from tp:wget-1.25.0
msgid "       --warc-cdx                  write CDX index files\n"
msgstr "       --warc-cdx                  skriv CDX-indexfiler\n"

#. from tp:wget-1.25.0
msgid "       --warc-dedup=FILENAME       do not store records listed in this CDX file\n"
msgstr "       --warc-dedup=FILNAMN        spara inte poster listade i denna CDX-fil\n"

#. from tp:wget-1.25.0
msgid "       --no-warc-compression       do not compress WARC files with GZIP\n"
msgstr "       --no-warc-compression       komprimera inte WARC-filer med GZIP\n"

#. from tp:wget-1.25.0
msgid "       --no-warc-digests           do not calculate SHA1 digests\n"
msgstr "       --no-warc-digests           beräkna inte SHA1-kontrollsummor\n"

#. from tp:wget-1.25.0
msgid "       --no-warc-keep-log          do not store the log file in a WARC record\n"
msgstr "       --no-warc-keep-log          lagra inte loggfilen i en WARC-post\n"

#. from tp:wget-1.25.0
msgid "       --warc-tempdir=DIRECTORY    location for temporary files created by the\n                                     WARC writer\n"
msgstr "       --warc-tempdir=KATALOG      plats för temporärfiler som skapas av\n                                     WARC-skrivaren\n"

#. from tp:wget-1.25.0
msgid "Recursive download:\n"
msgstr "Rekursiv hämtning:\n"

#. from tp:wget-1.25.0
msgid "  -r,  --recursive                 specify recursive download\n"
msgstr "  -r,  --recursive                 ange rekursiv hämtning\n"

#. from tp:wget-1.25.0
msgid "  -l,  --level=NUMBER              maximum recursion depth (inf or 0 for infinite)\n"
msgstr "  -l,  --level=ANTAL               maximalt rekursionsdjup (inf eller 0 för\n                                     oändligt)\n"

#. from tp:wget-1.25.0
msgid "       --delete-after              delete files locally after downloading them\n"
msgstr "       --delete-after              ta bort lokala filer efter att de hämtats\n"

#. from tp:wget-1.25.0
msgid "  -k,  --convert-links             make links in downloaded HTML or CSS point to\n                                     local files\n"
msgstr "  -k,  --convert-links             gör så att länkar i hämtad HTML eller CSS\n                                     pekar på lokala filer\n"

#. from tp:wget-1.25.0
msgid "       --convert-file-only         convert the file part of the URLs only (usually known as the basename)\n"
msgstr "       --convert-file-only         konvertera endast fildelen av URL:en\n                                     (vanligen känt som basename)\n"

#. from tp:wget-1.25.0
msgid "       --backups=N                 before writing file X, rotate up to N backup files\n"
msgstr "       --backups=N                 före fil X skrivs, rotera upp till N säkerhetskopiefiler\n"

#. from tp:wget-1.25.0
msgid "  -K,  --backup-converted          before converting file X, back up as X_orig\n"
msgstr "  -K,  --backup-converted          före filen X konverteras, säkerhetskopiera\n                                     den som X_orig\n"

#. from tp:wget-1.25.0
msgid "  -K,  --backup-converted          before converting file X, back up as X.orig\n"
msgstr "  -K,  --backup-converted          före filen X konverteras, säkerhetskopiera\n                                     den som X.orig\n"

#. from tp:wget-1.25.0
msgid "  -m,  --mirror                    shortcut for -N -r -l inf --no-remove-listing\n"
msgstr "  -m,  --mirror                    genväg för -N -r -l inf --no-remove-listing\n"

#. from tp:wget-1.25.0
msgid "  -p,  --page-requisites           get all images, etc. needed to display HTML page\n"
msgstr "  -p,  --page-requisites           hämta alla bilder, etc. som behövs för att\n                                     visa HTML-sidor\n"

#. from tp:wget-1.25.0
msgid "       --strict-comments           turn on strict (SGML) handling of HTML comments\n"
msgstr "       --strict-comments           slå på strikt (SGML) hantering av\n                                     HTML-kommentarer\n"

#. from tp:wget-1.25.0
msgid "Recursive accept/reject:\n"
msgstr "Rekursiv acceptans/vägran:\n"

#. from tp:wget-1.25.0
msgid "  -A,  --accept=LIST               comma-separated list of accepted extensions\n"
msgstr "  -A,  --accept=LISTA              kommaseparerad lista av accepterade ändelser\n"

#. from tp:wget-1.25.0
msgid "  -R,  --reject=LIST               comma-separated list of rejected extensions\n"
msgstr "  -R,  --reject=LISTA              kommaseparerad lista av vägrade ändelser\n"

#. from tp:wget-1.25.0
msgid "       --accept-regex=REGEX        regex matching accepted URLs\n"
msgstr "       --accept-regex=REGUTTR      reguljäruttryck som matchar godkända URL:ar\n"

#. from tp:wget-1.25.0
msgid "       --reject-regex=REGEX        regex matching rejected URLs\n"
msgstr "       --reject-regex=REGUTTR      reguljäruttryck som matchar avvisade URL:ar\n"

#. from tp:wget-1.25.0
msgid "       --regex-type=TYPE           regex type (posix|pcre)\n"
msgstr "       --regex-type=TYP            typ av reguljäruttryck (posix|pcre)\n"

#. from tp:wget-1.25.0
msgid "       --regex-type=TYPE           regex type (posix)\n"
msgstr "       --regex-type=TYP            typ av reguljäruttryck (posix)\n"

#. from tp:wget-1.25.0
msgid "  -D,  --domains=LIST              comma-separated list of accepted domains\n"
msgstr "  -D,  --domains=LISTA             kommaseparerad lista av accepterade domäner\n"

#. from tp:wget-1.25.0
msgid "       --exclude-domains=LIST      comma-separated list of rejected domains\n"
msgstr "       --exclude-domains=LISTA     kommaseparerad lista av vägrade domäner\n"

#. from tp:wget-1.25.0
msgid "       --follow-ftp                follow FTP links from HTML documents\n"
msgstr "       --follow-ftp                följ FTP-länkar från HTML-dokument\n"

#. from tp:wget-1.25.0
msgid "       --follow-tags=LIST          comma-separated list of followed HTML tags\n"
msgstr "       --follow-tags=LISTA         kommaseparerad lista av HTML-taggar att följa\n"

#. from tp:wget-1.25.0
msgid "       --ignore-tags=LIST          comma-separated list of ignored HTML tags\n"
msgstr "       --ignore-tags=LISTA         kommaseparerad lista av HTML-taggar att\n                                     ignorera\n"

#. from tp:wget-1.25.0
msgid "  -H,  --span-hosts                go to foreign hosts when recursive\n"
msgstr "  -H,  --span-hosts                gå till främmande värdar när rekursiv\n"

#. from tp:wget-1.25.0
msgid "  -L,  --relative                  follow relative links only\n"
msgstr "  -L,  --relative                  följ endast relativa länkar\n"

#. from tp:wget-1.25.0
msgid "  -I,  --include-directories=LIST  list of allowed directories\n"
msgstr "  -I,  --include-directories=LISTA lista av tillåtna kataloger\n"

#. from tp:wget-1.25.0
msgid "       --trust-server-names        use the name specified by the redirection\n                                     URL's last component\n"
msgstr "  --trust-server-names        använd namnet angivet av omdirigerings-url:ens\n                                sista komponent\n"

#. from tp:wget-1.25.0
msgid "  -X,  --exclude-directories=LIST  list of excluded directories\n"
msgstr "  -X,  --exclude-directories=LISTA lista av exkluderade kataloger\n"

#. from tp:wget-1.25.0
msgid "  -np, --no-parent                 don't ascend to the parent directory\n"
msgstr "  -np, --no-parent                 gå inte upp till föräldrakatalogen\n"

#. from tp:wget-1.25.0
msgid "Email bug reports, questions, discussions to <bug-wget@gnu.org>\nand/or open issues at https://savannah.gnu.org/bugs/?func=additem&group=wget.\n"
msgstr "Skicka felrapporter, frågor, diskussioner till <bug-wget@gnu.org>\noch/eller öppna ärenden på https://savannah.gnu.org/bugs/?func=additem&group=wget.\n"

#. from tp:wget-1.25.0
msgid "GNU Wget %s, a non-interactive network retriever.\n"
msgstr "GNU Wget %s, en icke-interaktiv nätverkshämtare.\n"

#. from tp:wget-1.25.0
msgid "Password for user %s: "
msgstr "Lösenord för användaren %s: "

#. from tp:wget-1.25.0
msgid "Cannot create pipe\n"
msgstr "Kan inte skapa ett rör\n"

#. from tp:wget-1.25.0
msgid "Error initializing spawn file actions for use-askpass: %d\n"
msgstr "Fel vid initiering av skapad filåtgärd för use-askpass: %d\n"

#. from tp:wget-1.25.0
msgid "Error setting spawn file actions for use-askpass: %d\n"
msgstr "Fel när skapad filåtgärd sattes för use-askpass: %d\n"

#. from tp:wget-1.25.0
msgid "Error reading response from command \"%s %s\": %s\n"
msgstr "Fel när svaret lästes från kommandot ”%s %s”: %s\n"

#. from tp:wget-1.25.0
msgid "Username for '%s%s': "
msgstr "Användarnamn för ”%s%s”: "

#. from tp:wget-1.25.0
msgid "Password for '%s%s@%s': "
msgstr "Lösenord för ”%s%s@%s”: "

#. from tp:wget-1.25.0
msgid "Wgetrc: "
msgstr "Wgetrc: "

#. from tp:wget-1.25.0
msgid "Locale: "
msgstr "Lokalanpassning: "

#. from tp:wget-1.25.0
msgid "Compile: "
msgstr "Kompilering: "

#. from tp:wget-1.25.0
msgid "Link: "
msgstr "Länkning: "

#. from tp:wget-1.25.0
msgid "GNU Wget %s built on %s.\n\n"
msgstr "GNU Wget %s byggd på %s.\n\n"

#. from tp:wget-1.25.0
msgid "    %s (env)\n"
msgstr "    %s (miljö)\n"

#. from tp:wget-1.25.0
msgid "    %s (user)\n"
msgstr "    %s (användare)\n"

#. from tp:wget-1.25.0
msgid "    %s (system)\n"
msgstr "    %s (system)\n"

#. from tp:wget-1.25.0
msgid "Copyright (C) %s Free Software Foundation, Inc.\n"
msgstr "Copyright © %s Free Software Foundation, Inc.\n"

#. from tp:wget-1.25.0
msgid "License GPLv3+: GNU GPL version 3 or later\n<http://www.gnu.org/licenses/gpl.html>.\nThis is free software: you are free to change and redistribute it.\nThere is NO WARRANTY, to the extent permitted by law.\n"
msgstr "Licens GPLv3+: GNU GPL version 3 eller senare\n<http://www.gnu.org/licenses/gpl.html>.\nDet här är fri programvara: du får fritt ändra och distribuera den.\nDet finns INGEN GARANTI så långt som lagen tillåter.\n"

#. from tp:wget-1.25.0
msgid "\nOriginally written by Hrvoje Niksic <hniksic@xemacs.org>.\n"
msgstr "\nUrsprungligen skrivet av Hrvoje Niksic <hniksic@xemacs.org>.\n"

#. from tp:wget-1.25.0
msgid "Please send bug reports and questions to <bug-wget@gnu.org>.\n"
msgstr "Skicka felrapporter och frågor till <bug-wget@gnu.org>.\nSkicka synpunkter på översättningen till <tp-sv@listor.tp-sv.se>.\n"

#. from tp:wget-1.25.0
msgid "Memory allocation problem\n"
msgstr "Minnesallokeringsproblem\n"

#. from tp:wget-1.25.0
msgid "Exiting due to error in %s\n"
msgstr "Avslutar på grund av fel i %s\n"

#. from tp:wget-1.25.0
msgid "Try `%s --help' for more options.\n"
msgstr "Prova \"%s --help\" för fler flaggor.\n"

#. from tp:wget-1.25.0
msgid "%s: illegal option -- `-n%c'\n"
msgstr "%s: ogiltig flagga -- \"-n%c\"\n"

#. from tp:wget-1.25.0
msgid "Debugging support not compiled in. Ignoring --debug flag.\n"
msgstr "Stöd för felsökning är inte inkompilerat.  Ignorerar flaggan --debug.\n"

#. from tp:wget-1.25.0
msgid "Both --no-clobber and --convert-links were specified, only --convert-links will be used.\n"
msgstr "Både --no-clobber och --convert-links angavs, endast --convert-links kommer användas.\n"

#. from tp:wget-1.25.0
msgid "Both --no-clobber and --convert-file-only were specified, only --convert-file-only will be used.\n"
msgstr "Både --no-clobber och --convert-file-only angavs, endast --convert-file-only kommer användas.\n"

#. from tp:wget-1.25.0
msgid "Can't be verbose and quiet at the same time.\n"
msgstr "Kan inte vara utförlig och tyst på samma gång.\n"

#. from tp:wget-1.25.0
msgid "Can't timestamp and not clobber old files at the same time.\n"
msgstr "Kan inte tidsstämpla och inte skriva över gamla filer på samma gång.\n"

#. from tp:wget-1.25.0
msgid "Cannot specify both --inet4-only and --inet6-only.\n"
msgstr "Kan inte ange både --inet4-only och --inet6-only.\n"

#. from tp:wget-1.25.0
msgid "Cannot specify both -k or --convert-file-only and -O if multiple URLs are given, or in combination\nwith -p or -r. See the manual for details.\n\n"
msgstr "Det går inte att ange både -k eller --convert-file-only och -O om flera URL:er\nanges, eller i kombination med -p eller -r.  Se manualen för information.\n\n"

#. from tp:wget-1.25.0
msgid "WARNING: combining -O with -r or -p will mean that all downloaded content\nwill be placed in the single file you specified.\n\n"
msgstr "VARNING: kombinera -O med -r eller -p betyder att allt hämtat innehåll\nkommer att placeras i en enstaka fil som du har angivit.\n\n"

#. from tp:wget-1.25.0
msgid "WARNING: timestamping does nothing in combination with -O. See the manual\nfor details.\n\n"
msgstr "VARNING: tidsstämpling gör ingenting i kombination med -O. Se manualen\nför information.\n\n"

#. from tp:wget-1.25.0
msgid "WARC output does not work with --no-clobber, --no-clobber will be disabled.\n"
msgstr "WARC-utdata fungerar inte med --no-clobber, --no-clobber kommer avaktiveras.\n"

#. from tp:wget-1.25.0
msgid "WARC output does not work with timestamping, timestamping will be disabled.\n"
msgstr "WARC-utdata fungerar inte med tidsstämplar, tidsstämplar kommer avaktiveras.\n"

#. from tp:wget-1.25.0
msgid "WARC output does not work with --spider.\n"
msgstr "WARC-utdata fungerar inte med --spider.\n"

#. from tp:wget-1.25.0
msgid "WARC output does not work with --continue or --start-pos, they will be disabled.\n"
msgstr "WARC-utdata fungerar inte med --continue eller --start-pos, de kommer avaktiveras.\n"

#. from tp:wget-1.25.0
msgid "Digests are disabled; WARC deduplication will not find duplicate records.\n"
msgstr "Kontrollsummor är avaktiverade; WARC-avduplicering kommer inte hitta dubblettposter.\n"

#. from tp:wget-1.25.0
msgid "Compression does not work with --continue or --start-pos, they will be disabled.\n"
msgstr "Komprimering fungerar inte med --continue eller --start-pos, den kommer avaktiveras.\n"

#. from tp:wget-1.25.0
msgid "Cannot specify both --ask-password and --password.\n"
msgstr "Det går inte att ange både --ask-password och --password.\n"

#. from tp:wget-1.25.0
msgid "WARNING: No username set with --ask-password. This is usually not what you want.\n"
msgstr "VARNING: inget användarnamn satt med --ask-password. Detta är normalt inte vad du vill.\n"

#. from tp:wget-1.25.0
msgid "Specifying both --start-pos and --continue is not recommended; --continue will be disabled.\n"
msgstr "Att ange både --start-pos och --continue rekommenderas inte; --continue kommer att avaktiveras.\n"

#. from tp:wget-1.25.0
msgid "%s: missing URL\n"
msgstr "%s: URL saknas\n"

#. from tp:wget-1.25.0
msgid "You cannot specify both --post-data and --post-file.\n"
msgstr "Det går inte att ange både --post-data och --post-file.\n"

