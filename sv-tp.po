msgstr "Generera kod för en 68010."

#. from tp:gcc-16.1-b20260222
msgid "Generate code for a 68020."
msgstr "Generera kod för en 68020."

#. from tp:gcc-16.1-b20260222
msgid "Generate code for a 68040, without any new instructions."
msgstr "Generera kod för en 68040, utan några nya instruktioner."

#. from tp:gcc-16.1-b20260222
msgid "Generate code for a 68060, without any new instructions."
msgstr "Generera kod för en 68060, utan några nya instruktioner."

#. from tp:gcc-16.1-b20260222
msgid "Generate code for a 68030."
msgstr "Generera kod för en 68030."

#. from tp:gcc-16.1-b20260222
msgid "Generate code for a 68040."
msgstr "Generera kod för en 68040."

#. from tp:gcc-16.1-b20260222
msgid "Generate code for a 68060."
msgstr "Generera kod för en 68060."

#. from tp:gcc-16.1-b20260222
msgid "Generate code for a 68302."
msgstr "Generera kod för en 68302."

#. from tp:gcc-16.1-b20260222
msgid "Generate code for a 68332."
msgstr "Generera kod för en 68332."

#. from tp:gcc-16.1-b20260222
msgid "Generate code for a 68851."
msgstr "Generera kod för en 68851."

#. from tp:gcc-16.1-b20260222
msgid "Generate code that uses 68881 floating-point instructions."
msgstr "Generera kod som använder flyttalsinstruktioner för 68881."

#. from tp:gcc-16.1-b20260222
msgid "Align variables on a 32-bit boundary."
msgstr "Justera variabler till en 32-bitarsgräns."

#. from tp:gcc-16.1-b20260222
msgid "Use the bit-field instructions."
msgstr "Använd bitfältsinstruktionerna."

#. from tp:gcc-16.1-b20260222
msgid "Generate code for a ColdFire v4e."
msgstr "Generera kod för en ColdFire v4e."

#. from tp:gcc-16.1-b20260222
msgid "Specify the target CPU."
msgstr "Ange mål-CPU:n."

#. from tp:gcc-16.1-b20260222
msgid "Generate code for a cpu32."
msgstr "Generera kod för en cpu32."

#. from tp:gcc-16.1-b20260222
msgid "Use hardware division instructions on ColdFire."
msgstr "Använd hårdvarudivisionsinstruktioner på ColdFire."

#. from tp:gcc-16.1-b20260222
msgid "Generate code for a Fido A."
msgstr "Generera kod för en Fido A."

#. from tp:gcc-16.1-b20260222
msgid "Generate code which uses hardware floating point instructions."
msgstr "Generera kod som använder hårdvaruflyttalsinstruktioner."

#. from tp:gcc-16.1-b20260222
msgid "Enable ID based shared library."
msgstr "Aktivera ID-baserat delat bibliotek."

#. from tp:gcc-16.1-b20260222
msgid "Use 32-bit offsets in jump tables rather than 16-bit offsets."
msgstr "Använd 32-bitarsförskjutningar i hopptabeller i stället för 16-bitarsförskjutningar."

#. from tp:gcc-16.1-b20260222
msgid "Use LRA for reload instead of the old reload framework.  This option is experimental, and it may be removed in future versions of the compiler."
msgstr "Använd LRA för omladdning istället för det gamla omladdningsramverket. Denna flagga är experimentell, och kan komma att tas bort i framtida versioner av kompilatorn."

#. from tp:gcc-16.1-b20260222
msgid "Do not use the bit-field instructions."
msgstr "Använd inte bitfältsinstruktionerna."

#. from tp:gcc-16.1-b20260222
msgid "Use normal calling convention."
msgstr "Använd normal anropskonvention."

#. from tp:gcc-16.1-b20260222
msgid "Consider type 'int' to be 32 bits wide."
msgstr "Betrakta typen ”int” som 32 bitar bred."

#. from tp:gcc-16.1-b20260222
msgid "Generate pc-relative code."
msgstr "Generera pc-relativ kod."

#. from tp:gcc-16.1-b20260222
msgid "Use different calling convention using 'rtd'."
msgstr "Använd en annan anropskonvention som använder ”rtd”."

#. from tp:gcc-16.1-b20260222
msgid "Consider type 'int' to be 16 bits wide."
msgstr "Betrakta typen ”int” som 16 bitar bred."

#. from tp:gcc-16.1-b20260222
msgid "Generate code with library calls for floating point."
msgstr "Generera kod med biblioteksanrop för flyttal."

#. from tp:gcc-16.1-b20260222
msgid "Tune for the specified target CPU or architecture."
msgstr "Trimma för den angivna mål-CPU:n eller arkitekturen."

#. from tp:gcc-16.1-b20260222
msgid "Support more than 8192 GOT entries on ColdFire."
msgstr "Stöd mer än 8192 GOT-poster på ColdFire."

#. from tp:gcc-16.1-b20260222
msgid "Support TLS segment larger than 64K."
msgstr "Stöd TLS-segment större än 64 k."

#. from tp:gcc-16.1-b20260222
msgid "Preprocess, compile or link with specified C RunTime DLL library."
msgstr "Preprocessa, kompilera eller länka med det angivna C-körtids-DLL-biblioteket."

#. from tp:gcc-16.1-b20260222
msgid "Warn about none ISO msvcrt scanf/printf width extensions."
msgstr "Varna för msvcrt-breddutökningar av scanf/printf som inte följer ISO."

#. from tp:gcc-16.1-b20260222
msgid "Create console application."
msgstr "Skapa konsolapplikation."

#. from tp:gcc-16.1-b20260222
msgid "Generate code for a DLL."
msgstr "Generera kod för en DLL."

#. from tp:gcc-16.1-b20260222
msgid "Ignore dllimport for functions."
msgstr "Ignorera dllimport för funktioner."

#. from tp:gcc-16.1-b20260222
msgid "Use Mingw-specific thread support."
msgstr "Använd Mingw-specifikt trådstöd."

#. from tp:gcc-16.1-b20260222
msgid "Set Windows defines."
msgstr "Sätt Windows-definitioner."

#. from tp:gcc-16.1-b20260222
msgid "Create GUI application."
msgstr "Skapa GUI-applikation."

#. from tp:gcc-16.1-b20260222
msgid "Use the GNU extension to the PE format for aligned common data."
msgstr "Använd GNU-utvidgningarna för PE-formatet för justerade common-data."

#. from tp:gcc-16.1-b20260222
msgid "Compile code that relies on Cygwin DLL wrappers to support C++ operator new/delete replacement."
msgstr "Kompilera kod som litar på Cygwin:s DLL-inkapsling för att stödja ersättning av C++-operatorerna new/delete."

#. from tp:gcc-16.1-b20260222
msgid "For nested functions on stack executable permission is set."
msgstr "För nästade funktioner på stacken sätts exekveringsrättigheter."

#. from tp:gcc-16.1-b20260222
msgid "Put relocated read-only data into .data section."
msgstr "Placera omlokaliserade skrivskyddade data i .data-sektionen."

#. from tp:gcc-16.1-b20260222
msgid "Basic ISAs of LoongArch:"
msgstr "Grundläggande ISA:er hos LoongArch:"

#. from tp:gcc-16.1-b20260222
msgid "FPU types of LoongArch:"
msgstr "FPU-typer hos LoongArch:"

#. from tp:gcc-16.1-b20260222
msgid "-mfpu=FPU	Generate code for the given FPU."
msgstr "-mfpu=FPU	Generera kod för den angivna FPU:n."

#. from tp:gcc-16.1-b20260222
msgid "Prevent the use of all hardware floating-point instructions."
msgstr "Förhindra användningen av alla maskinvaruflyttalsinstruktioner."

#. from tp:gcc-16.1-b20260222
msgid "Restrict the use of hardware floating-point instructions to 32-bit operations."
msgstr "Begränsa användningen av maskinvaruflyttalsinstruktioner till 32-bitarsoperationer."

#. from tp:gcc-16.1-b20260222
msgid "Allow hardware floating-point instructions to cover both 32-bit and 64-bit operations."
msgstr "Tillåt maskinvaruflyttalsinstruktioner för både 32-bitars- och 64-bitarsoperationer."

#. from tp:gcc-16.1-b20260222
msgid "SIMD extension levels of LoongArch:"
msgstr "SIMD-utvidgningsnivåer för LoongArch:"

#. from tp:gcc-16.1-b20260222
msgid "-msimd=SIMD	Generate code for the given SIMD extension."
msgstr "-msimd=SIMD\tGenerera kod för den angivna SIMD-utvidgningen."

#. from tp:gcc-16.1-b20260222
msgid "Enable LoongArch SIMD Extension (LSX, 128-bit)."
msgstr "Aktivera LoongArch SIMD-utvidgningen (LSX, 128-bitar)."

#. from tp:gcc-16.1-b20260222
msgid "Enable LoongArch Advanced SIMD Extension (LASX, 256-bit)."
msgstr "Aktivera LoongArch Advanced SIMD-utvidgningen (LASX, 256-bit)."

#. from tp:gcc-16.1-b20260222
msgid "LoongArch ARCH presets:"
msgstr "LoongArch-ARCH-förinställningar:"

#. from tp:gcc-16.1-b20260222
msgid "-march=PROCESSOR	Generate code for the given PROCESSOR ISA."
msgstr "-march=PROCESSOR	Generera kod för den angivna PROCESSOR-ISA:n."

#. from tp:gcc-16.1-b20260222
msgid "LoongArch TUNE presets:"
msgstr "LoongArch-TUNE-förinställningar:"

#. from tp:gcc-16.1-b20260222
msgid "-mtune=PROCESSOR	Generate optimized code for PROCESSOR."
msgstr "-mtune=PROCESSOR	Generera optimerad kod för PROCESSOR."

#. from tp:gcc-16.1-b20260222
msgid "Base ABI types for LoongArch:"
msgstr "Grund-ABI-typer för LoongArch:"

#. from tp:gcc-16.1-b20260222
msgid "-mabi=BASEABI	Generate code that conforms to the given BASEABI."
msgstr "-mabi=BASEABI\tGenerera kod som följer den angivna BASEABI."

#. from tp:gcc-16.1-b20260222
msgid "-mbranch-cost=COST	Set the cost of branches to roughly COST instructions."
msgstr "-mbranch-cost=KOSTNAD	Ange kostnaden för grenar till ungefär KOSTNAD instruktioner."

#. from tp:gcc-16.1-b20260222
msgid "-maddr-reg-reg-cost=COST  Set the cost of ADDRESS_REG_REG to the value calculated by COST."
msgstr "-maddr-reg-reg-cost=KOSTNAD Sätt kostnaden för ADDRESS_REG_REG till värdet beräknat av KOSTNAD."

#. from tp:gcc-16.1-b20260222
msgid "Trap on integer divide by zero."
msgstr "Fånga heltalsdivision med noll."

#. from tp:gcc-16.1-b20260222
msgid "Conditional moves for integral are enabled."
msgstr "Villkorliga flyttningar för heltal är aktiverade."

#. from tp:gcc-16.1-b20260222
msgid "Conditional moves for float are enabled."
msgstr "Villkorliga flyttningar för flyttal är aktiverade."

#. from tp:gcc-16.1-b20260222
msgid "Prevent optimizing block moves, which is also the default behavior of -Os."
msgstr "Förhindra optimering av blockförflyttningar, vilket även är standardbeteendet hos -Os."

#. from tp:gcc-16.1-b20260222
msgid "-mmax-inline-memcpy-size=SIZE	Set the max size of memcpy to inline, default is 1024."
msgstr "-mmax-inline-memcpy-size=STORLEK	Ange den maximala storleken att inline:a memcpy, standard är 1024."

#. from tp:gcc-16.1-b20260222
msgid "-mbreak-code=CODE	Use 'break CODE' for traps supposed to be unrecoverable, or an 'amswap.w' instruction leading to INE if CODE is out of range."
msgstr "-mbreak-code=KOD	Använd ”break KOD” för fällor som antas vara oåterställbara, eller en ”amswap.w”-instruktion som leder till INE om KOD är utanför intervallet."

#. from tp:gcc-16.1-b20260222
msgid "The code model option names for -mexplicit-relocs:"
msgstr "Namnen för flaggan för kodmodell för -mexplicit-relocs:"

#. from tp:gcc-16.1-b20260222
msgid "Use %reloc() assembly operators."
msgstr "Använd assembleroperatorer %reloc()."

#. from tp:gcc-16.1-b20260222
msgid "Use %reloc() assembly operators (for backward compatibility)."
msgstr "Använd assembleroperatorer %reloc() (för bakåtkompatibilitet)."

#. from tp:gcc-16.1-b20260222
msgid "Generate approximate reciprocal divide and square root for better throughput."
msgstr "Generera approximativ reciprok division och kvadratrot för bättre genomströmning."

#. from tp:gcc-16.1-b20260222
msgid "Avoid using the GOT to access external symbols."
msgstr "Undvika att använda GOT för att komma åt externa symboler."

#. from tp:gcc-16.1-b20260222
msgid "Pass -mrelax or -mno-relax option to the assembler."
msgstr "Skicka flaggan -mrelax eller -mno-relax till assemblern."

#. from tp:gcc-16.1-b20260222
msgid "Used to limit unroll factor which indicates how much the autovectorizer may unroll a loop.  The default value is 6."
msgstr "Används för att begränsa utrullningsfaktorn som indikerar hur mycket autovektoriseraren får rulla ut en slinga. Standardvärdet är 6."

#. from tp:gcc-16.1-b20260222
msgid "Annotate table jump instruction (jr {reg}) to correlate it with the jump table."
msgstr "Annotera tabellhoppinstruktionen (jr {reg}) för att korrelera den med hopptabellen."

#. from tp:gcc-16.1-b20260222
msgid "Support frecipe.{s/d} and frsqrte.{s/d} instructions."
msgstr "Stöd instruktionerna frecipe.{s/d} och frsqrte.{s/d}."

#. from tp:gcc-16.1-b20260222
msgid "Support div.w[u] and mod.w[u] instructions with inputs not sign-extended."
msgstr "Stöd instruktionerna div.w[u] och mod.w[u] med indata som inte är teckenutvidgade."

#. from tp:gcc-16.1-b20260222
msgid "Support am{swap/add}[_db].{b/h} instructions."
msgstr "Stöd instruktionerna am{swap/add}[_db].{b/h}."

#. from tp:gcc-16.1-b20260222
msgid "Support amcas[_db].{b/h/w/d} instructions."
msgstr "Stöd instruktionerna amcas[_db].{b/h/w/d}."

#. from tp:gcc-16.1-b20260222
msgid "Support sc.q instruction."
msgstr "Stöd instruktionen sc.q."

#. from tp:gcc-16.1-b20260222
msgid "Do not need load-load barriers (dbar 0x700)."
msgstr "Kräv inte load-load-barriärer (dbar 0x700)."

#. from tp:gcc-16.1-b20260222
msgid "Don't use any of r32..r63."
msgstr "Använd inte någon av r32..r63."

#. from tp:gcc-16.1-b20260222
msgid "Preferentially allocate registers that allow short instruction generation."
msgstr "Allokera företrädesvis register som tillåter generering av korta instruktioner."

#. from tp:gcc-16.1-b20260222
msgid "Set branch cost."
msgstr "Ange grenkostnaden."

#. from tp:gcc-16.1-b20260222
msgid "Enable conditional move instruction usage."
msgstr "Aktivera användning av villkorliga flyttinstruktioner."

#. from tp:gcc-16.1-b20260222
msgid "Set number of nops to emit before each insn pattern."
msgstr "Sätt antalet nop:ar att mata ut före varje instruktionsmönster."

#. from tp:gcc-16.1-b20260222
msgid "Use software floating point comparisons."
msgstr "Använd flyttalsjämförelser i programvara."

#. from tp:gcc-16.1-b20260222
msgid "Enable split of 32 bit immediate loads into low / high part."
msgstr "Aktivera delning av 32-bitars omedelbara laddningar i låg/hög del."

#. from tp:gcc-16.1-b20260222
msgid "Enable use of POST_INC / POST_DEC."
msgstr "Aktivera användning av POST_INC/POST_DEC."

#. from tp:gcc-16.1-b20260222
msgid "Enable use of POST_MODIFY."
msgstr "Aktivera användning av POST_MODIFY."

#. from tp:gcc-16.1-b20260222
msgid "Set number of bytes on the stack preallocated for use by the callee."
msgstr "Ange antalet byte på stacken som förallokeras för användning av den anropade funktionen."

#. from tp:gcc-16.1-b20260222
msgid "Assume round to nearest is selected for purposes of scheduling."
msgstr "Anta att avrundning till närmaste är vald i schemaläggningssyfte."

#. from tp:gcc-16.1-b20260222
msgid "Generate call insns as indirect calls."
msgstr "Generera anropsinstruktioner som indirekta anrop."

#. from tp:gcc-16.1-b20260222
msgid "Generate call insns as direct calls."
msgstr "Generera anropsinstruktioner som direkta anrop."

#. from tp:gcc-16.1-b20260222
msgid "Assume labels and symbols can be addressed using 16 bit absolute addresses."
msgstr "Anta att etiketter och symboler kan adresseras med 16-bitars absoluta adresser."

#. from tp:gcc-16.1-b20260222
msgid "A floating point to integer truncation may be replaced with rounding to save mode switching."
msgstr "En avhuggning från flyttal till heltal får ersättas med avrundning för att spara lägesbyten."

#. from tp:gcc-16.1-b20260222
msgid "Vectorize for double-word operations."
msgstr "Vektorisera för dubbelordsoperationer."

#. from tp:gcc-16.1-b20260222
msgid "Split unaligned 8 byte vector moves before post-modify address generation."
msgstr "Dela ojusterade 8-bytevektorförflyttningar före adressgenerering efter ändring."

#. from tp:gcc-16.1-b20260222
msgid "Use the floating-point unit for integer add/subtract."
msgstr "Använd flyttalsenheten för addition/subtraktion av heltal."

#. from tp:gcc-16.1-b20260222
msgid "Set register to hold -1."
msgstr "Ange ett register som ska innehålla -1."

#. from tp:gcc-16.1-b20260222
msgid "Generate code for darwin loadable kernel extensions."
msgstr "Generera kod för laddbara Darwin-kärnutvidgningar."

#. from tp:gcc-16.1-b20260222
msgid "Generate compile-time CFString objects."
msgstr "Generera CFString-objekt vid kompileringstillfället."

#. from tp:gcc-16.1-b20260222
msgid "-iframework <dir>	Add <dir> to the end of the system framework include path."
msgstr "-iframework <kat>	Lägg till <kat> till slutet av systemramverkets inkluderingssökväg."

#. from tp:gcc-16.1-b20260222
msgid "Warn if constant CFString objects contain non-portable characters."
msgstr "Varna om konstanta CFString-objekt innehåller icke-portabla tecken."

#. from tp:gcc-16.1-b20260222
msgid "Generate AT&T-style stubs for Mach-O."
msgstr "Generera stubbar i AT&T-stil för Mach-O."

#. from tp:gcc-16.1-b20260222
msgid "Generate code suitable for executables (NOT shared libs)."
msgstr "Generera kod lämplig för körbara program (INTE delade bibliotek)."

#. from tp:gcc-16.1-b20260222
msgid "Generate code suitable for fast turn around debugging."
msgstr "Generera kod lämplig för korta felsökningscykler."

#. from tp:gcc-16.1-b20260222
msgid "Generate code for the kernel or loadable kernel extensions."
msgstr "Generera kod för kärnan eller laddbara kärnutvidgningar."

#. from tp:gcc-16.1-b20260222
msgid "The earliest macOS version on which this program will run."
msgstr "Den tidigaste macOS-version som programmet kommer att köras på."

#. from tp:gcc-16.1-b20260222
msgid "Set sizeof(bool) to 1."
msgstr "Sätt sizeof(bool) till 1."

#. from tp:gcc-16.1-b20260222
msgid "Force generation of external symbol indirection stubs."
msgstr "Framtvinga generering av externa symbolindirektionsstubbar."

#. from tp:gcc-16.1-b20260222
msgid "-mtarget-linker <version>	Specify that ld64 <version> is the toolchain linker for the current invocation."
msgstr "-mtarget-linker <version>	Ange att ld64 <version> är verktygskedjelänkaren för det aktuella anropet."

#. from tp:gcc-16.1-b20260222
msgid "Load all members of archive libraries, rather than only those that satisfy undefined symbols."
msgstr "Läs in alla medlemmar i arkivbibliotek, istället för endast de som uppfyller odefinierade symboler."

#. from tp:gcc-16.1-b20260222
msgid "-allowable_client <name>	The output dylib is private to the client <name>."
msgstr "-allowable_client <namn>	Dylib-utdata är privat till klienten <namn>."

#. from tp:gcc-16.1-b20260222
msgid "-arch <name>	Generate output for architecture <name>."
msgstr "-arch <namn>	Generera utdata för arkitekturen <namn>."

#. from tp:gcc-16.1-b20260222
msgid "Mismatches between file architecture and one specified by \"-arch\" are errors instead of warnings."
msgstr "Skillnader mellan filarkitekturen och den som anges med ”-arch” är fel i stället för varningar."

#. from tp:gcc-16.1-b20260222
msgid "The earliest macOS version on which this program will run (formatted for the assembler)."
msgstr "Den tidigaste macOS-version som programmet kommer att köras på (formaterad för assemblern)."

#. from tp:gcc-16.1-b20260222
msgid "Generate an output executable that binds symbols on load, rather than lazily."
msgstr "Generera en körbar utdatafil som binder symboler vid laddning i stället för fördröjt."

#. from tp:gcc-16.1-b20260222
msgid "Generate a Mach-O bundle (file type MH_BUNDLE)."
msgstr "Generera en Mach-O-bunt (filtyp MH_BUNDLE)."

#. from tp:gcc-16.1-b20260222
msgid "-bundle_loader <executable>	Treat <executable> (that will be loading this bundle) as if it was one of the dynamic libraries the bundle is linked against for symbol resolution."
msgstr "-bundle_loader <körbar> 	Behandla <körbar> (som kommer att ladda denna bunt) som om den vore en av de dynamiska bibliotek bunten länkas mot vid symbolupplösning."

#. from tp:gcc-16.1-b20260222
msgid "-client_name <name>	Enable the executable being built to link against a private dylib (using allowable_client)."
msgstr "-client_name <namn>	Aktivera att den körbara byggs för att länka mot ett privat dylib (användande allowable_client)."

#. from tp:gcc-16.1-b20260222
msgid "-compatibility_version <number>	Set the version for the client interface.  Client programs must record a value less than or equal to <number>, or the binding will fail at runtime."
msgstr "-compatibility_version <nummer>\tAnge versionen för klientgränssnittet.  Klientprogram måste registrera ett värde mindre än eller lika med <nummer>, annars misslyckas bindningen vid körtid."

#. from tp:gcc-16.1-b20260222
msgid "-current_version <number>	Set the current version for the library to <number>."
msgstr "-current_version <nummer>	Sätt den aktuella versionen på biblioteket till <nummer>."

#. from tp:gcc-16.1-b20260222
msgid "Remove code and data that is unreachable from any exported symbol (including the entry point)."
msgstr "Ta bort kod och data som är onåbar från alla exporterade symboler (inklusive ingångspunkten)."

#. from tp:gcc-16.1-b20260222
msgid "-dylib_file install_name:file_name	This allows linking of a dylib with \"install_name\" but to be found in a different install position \"file_name\""
msgstr "-dylib_file installationsnamn:filnamn\tDetta tillåter länkning av ett dylib med ”installationsnamn” som finns på en annan installationsplats, ”filnamn”."

#. from tp:gcc-16.1-b20260222
msgid "Produce a Mach-O dylinker (file type MH_DYLINKER), only used for building dyld."
msgstr "Producera en Mach-O-dylinker (filtyp MH_DYLINKER), endast använd för att bygga dyld."

#. from tp:gcc-16.1-b20260222
msgid "-dylinker_install_name <path>	Only used for building dyld."
msgstr "-dylinker_install_name <sökväg>	Används endast för att bygga dyld."

#. from tp:gcc-16.1-b20260222
msgid "The default (and opposite of -static), implied by user mode executables, shared libraries and bundles."
msgstr "Standard (och motsats till -static), vilket antyds av körbara program i användarläge, delade bibliotek och buntar."

#. from tp:gcc-16.1-b20260222
msgid "Produce a Mach-O shared library (file type MH_DYLIB), synonym for \"-shared\"."
msgstr "Producera ett delat Mach-O-bibliotek (filtyp MH_DYLIB), synonymt med ”-shared”."

#. from tp:gcc-16.1-b20260222
msgid "-exported_symbols_list <filename>	Export global symbols in <filename> in linked output file; any symbols not mentioned will be treated as \"hidden\"."
msgstr "-exported_symbols_list <filnamn>	Exportera globala symboler i <filnamn> i den länkade utdatafilen; alla symboler som inte nämns kommer hanteras som ”hidden”."

#. from tp:gcc-16.1-b20260222
msgid "Supply a list of objects to be linked from a file, rather than the command line."
msgstr "Ge en lista över objekt som ska länkas från en fil i stället för kommandoraden."

#. from tp:gcc-16.1-b20260222
msgid "Used for generating code for some older kernel revisions."
msgstr "Använd för att generera kod för några äldre kärnversioner."

#. from tp:gcc-16.1-b20260222
msgid "Ignore the normal two-level namespace; resolve symbols in command line order and do not record which library provided the resolved symbol."
msgstr "Ignorera den normala tvånivånamnrymden; slå upp symboler i kommandoradsordning och notera inte vilket bibliotek som tillhandahöll den upplösta symbolen."

#. from tp:gcc-16.1-b20260222
msgid "For the assembler (and linker) permit any architecture sub-variant to be used without error."
msgstr "För assemblern (och länkaren) tillåt alla arkitekturundervarianter att användas utan fel."

#. from tp:gcc-16.1-b20260222
msgid "Set the output object such that, on loading, dyld will ignore any two-level namespace information and resolve symbols in the discovery order for loaded libs."
msgstr "Sätt utdataobjektet så att, vid laddning, dyld kommer ignorera tvånivås namnrymdsinformation och lösa upp symboler i upptäcktsordning från de laddade biblioteken."

#. from tp:gcc-16.1-b20260222
msgid "-framework <name>	The linker should search for the framework <name> in the framework search path."
msgstr "-framework <namn>	Länkaren skall söka efter ramverket <namn> i sökvägen för ramverk."

#. from tp:gcc-16.1-b20260222
msgid "Abbreviation for \"-g -fno-eliminate-unused-debug-symbols\"."
msgstr "Förkortning för ”-g -fno-eliminate-unused-debug-symbols”."

#. from tp:gcc-16.1-b20260222
msgid "Abbreviation for \"-g -feliminate-unused-debug-symbols\"."
msgstr "Förkortning för ”-g -feliminate-unused-debug-symbols”."

#. from tp:gcc-16.1-b20260222
msgid "Automatically adds space for longer path names in load commands (up to MAXPATHLEN)."
msgstr "Lägger automatiskt till mellanslag för längre sökvägsnamn i laddkommandon (upp till MAXPATHLEN)."

#. from tp:gcc-16.1-b20260222
msgid "-image_base <address>	Specify <address> as the base address for a dylib or bundle."
msgstr "-image_base <adress>	Ange <adress> som basadress för ett dylib eller en bunt."

#. from tp:gcc-16.1-b20260222
msgid "-init <symbol_name>	The symbol <symbol_name> will be used as the first initializer for a dylib."
msgstr "-init <symbolnamn>\tSymbolen <symbolnamn> används som den första initieraren för ett dylib."

#. from tp:gcc-16.1-b20260222
msgid "-install_name <name>	Set the install name for a dylib."
msgstr "-install_name <namn>	Ange installationsnamnet för ett dylib."

#. from tp:gcc-16.1-b20260222
msgid "Usually \"private extern\" (hidden) symbols are made local when linking, this command suppresses that such that they remain exported."
msgstr "Vanligen görs ”private extern” (dolda) symboler lokala vid länkning, detta kommando undertrycker det så att de behålls exporterade."

#. from tp:gcc-16.1-b20260222
msgid "(Obsolete after 10.4) Multi modules are ignored at runtime since macOS 10.4."
msgstr "(Föråldrat efter 10.4) Multimoduler ignoreras vid körtillfället sedan macOS 10.4."

#. from tp:gcc-16.1-b20260222
msgid "(Obsolete after 10.4) -multiply_defined <treatment>	Provided a mechanism for warning about symbols defined in multiple dylibs."
msgstr "(Föråldrat efter 10.4) -multiply_defined <hantering>	Tillhandahåller en mekanism för varningar för symboler definierade i flera dylib."

#. from tp:gcc-16.1-b20260222
msgid "(Obsolete after 10.4) -multiply_defined_unused <treatment>	Provided a mechanism for warning about symbols defined in the current executable also being defined in linked dylibs."
msgstr "(Föråldrat efter 10.4) -multiply_defined_unused <hantering>	Tillhandahåller en mekanism för varningar för symboler definierade i den aktuella körbara som också är definierade i inlänkade dylib."

#. from tp:gcc-16.1-b20260222
msgid "(Obsolete) Current linkers never dead-strip these items, so the option is not needed."
msgstr "(Föråldrat) Moderna länkare dödrensar aldrig dessa poster, så flaggan behövs inte."

#. from tp:gcc-16.1-b20260222
msgid "Do not add a default symbol exports to modules or dynamic libraries."
msgstr "Lägg inte till standardsymbolexporter till moduler eller dynamiska bibliotek."

#. from tp:gcc-16.1-b20260222
msgid "Do not add default run paths (for the compiler library directories) to executables, modules or dynamic libraries."
msgstr "Lägg inte till en standardkörsökväg (för kompilatorns bibliotekskataloger) till körbara, moduler eller dynamiska bibliotek."

#. from tp:gcc-16.1-b20260222
msgid "(Obsolete after 10.3.9) Set MH_NOPREFIXBINDING, in an executable."
msgstr "(Föråldrat efter 10.3.9) Sätt MH_NOPREFIXBINDING i en körbar."

#. from tp:gcc-16.1-b20260222
msgid "(Obsolete after 10.4)	Set MH_NOMULTIDEFS in an umbrella framework."
msgstr "(Föråldrat efter 10.4)	Sätt MH_NOMULTIDEFS i ett paraplyramverk."

#. from tp:gcc-16.1-b20260222
msgid "(Obsolete) LD_PREBIND is no longer supported."
msgstr "(Föråldrad) LD_PREBIND stödjs inte längre."

#. from tp:gcc-16.1-b20260222
msgid "(Obsolete) This is the default."
msgstr "(Föråldrad) Detta är standard."

#. from tp:gcc-16.1-b20260222
msgid "Equivalent to -xobjective-c."
msgstr "Ekvivalent med -xobjective-c."

#. from tp:gcc-16.1-b20260222
msgid "Equivalent to -xobjective-c++."
msgstr "Ekvivalent med -xobjective-c++."

#. from tp:gcc-16.1-b20260222
msgid "-pagezero_size <size>	Allows setting the page 0 size to 4kb when required."
msgstr "-pagezero_size <storlek>	Tillåter att sätta storleken på sida 0 till 4 kb för vissa specialfall."

#. from tp:gcc-16.1-b20260222
msgid "Produces a Mach-O file suitable for embedded/ROM use."
msgstr "Producerar en Mach-O-fil lämplig för inbäddad/ROM-användning."

#. from tp:gcc-16.1-b20260222
msgid "(Obsolete) Allowed linking to proceed with \"-flat_namespace\" when a linked bundle contained a symbol also exported from the main executable."
msgstr "(Föråldrat) Tillåt länkningen att gå vidare med ”-flat_namespace” när en länkad bunt innehåller en symbol som också exporteras från huvudprogrammet."

#. from tp:gcc-16.1-b20260222
msgid "Synonym for \"-export-dynamic\" for linker versions that support it."
msgstr "Synonym för ”-export-dynamic” för länkarversioner som stödjer det."

#. from tp:gcc-16.1-b20260222
msgid "-read_only_relocs <treatment>	Allow relocations in read-only pages (not recommended)."
msgstr "-read_only_relocs <hantering>	Tillåt omlokaliseringar i endast läsbara sidor (inte att rekommendera)."

#. from tp:gcc-16.1-b20260222
msgid "-sectalign <segname> <sectname> <value>	Set section <sectname> in segment <segname> to have alignment <value> which must be an integral power of two expressed in hexadecimal form."
msgstr "-sectalign <segnamn> <sektnamn> <värde>\tAnge att sektionen <sektnamn> i segmentet <segnamn> ska ha justeringen <värde>, som måste vara en heltalspotens av två uttryckt i hexadecimal form."

#. from tp:gcc-16.1-b20260222
msgid "-sectcreate <segname> <sectname> <file>	Create section <sectname> in segment <segname> from the contents of <file>."
msgstr "-sectcreate <segnamn> <sektnamn> <fil>\tSkapa sektionen <sektnamn> i segmentet <segnamn> från innehållet i <fil>."

#. from tp:gcc-16.1-b20260222
msgid "(Obsolete) -sectobjectsymbols <segname> <sectname>	Setting a local symbol at the start of a section is no longer supported."
msgstr "(Föråldrat) -sectobjectsymbols <segnamn> <sektnamn>	Att sätta en lokal symbol vid början av en sektion stödjs inte längre."

#. from tp:gcc-16.1-b20260222
msgid "(Obsolete) -sectorder <segname> <sectname> <orderfile>	Replaced by a more general option \"-order_file\"."
msgstr "(Föråldrat) -sectorder <segnamn> <sektnamn> <ordningsfil>	Ersatt av en mer generell flagga ”-order_file”."

#. from tp:gcc-16.1-b20260222
msgid "-seg_addr_table <file>	Specify the base addresses for dynamic libraries; <file> contains a line for each library."
msgstr "-seg_addr_table <fil>	Ange basadresserna för dynamiska bibliotek; <fil> innehåller en rad för varje bibliotek."

#. from tp:gcc-16.1-b20260222
msgid "(Obsolete, ld_classic only) -seg_addr_table_filename <path>."
msgstr "(Föråldrat, endast ld_classic) -seg_addr_table_filename <sökväg>."

#. from tp:gcc-16.1-b20260222
msgid "Synonym for \"image_base\"."
msgstr "Synonym för ”image_base”."

#. from tp:gcc-16.1-b20260222
msgid "-segaddr <name> <address>	Set the base address of segment <name> to <address> which must be aligned to a page boundary (currently 4kb)."
msgstr "-segaddr <namn> <adress>	Sätt basadressen för segment <namn> till <adress> som måste vara justerad till en sidgräns (för närvarande 4 kB)."

#. from tp:gcc-16.1-b20260222
msgid "(Obsolete, ld_classic only) -sectcreate <segname> <sectname> <file>	Allowed creation of a section from a file."
msgstr "(Föråldrat, endast ld_classic) -sectcreate <segnamn> <sektnamn> <fil>	Tillåt skapandet av en sektion från en fil."

#. from tp:gcc-16.1-b20260222
msgid "(Obsolete) Object files with LINKEDIT sections are no longer supported."
msgstr "(Föråldrat) Objektfiler med LINKEDIT-sektioner stödjs inte längre."

#. from tp:gcc-16.1-b20260222
msgid "-segprot <segname> <max_prot> <init_prot>	The virtual memory protections for segment <segname> have maximum and initial values <max_prot> and <init_prot> respectively.  The specified values may contain \"r\", \"w\", \"x\" or \"-\" the latter meaning \"no access\"."
msgstr "-segprot <segnamn> <max_skydd> <init_skydd>	Det virtuella minnets skydd för segment <segnamn> har maximala och initiala värden <max_skydd> respektive <init_skydd>.  Det angivna värdet kan innehålla ”r”, ”w”, ”x” eller ”-” det sistnämnda betyder ”ingen åtkomst”."

#. from tp:gcc-16.1-b20260222
msgid "-segs_read_only_addr <address>	Specify that <address> is the base address of the read-only segments of a dylib."
msgstr "-segs_read_only_addr <adress>\tAnge att <adress> är basadressen för de skrivskyddade segmenten i ett dylib."

#. from tp:gcc-16.1-b20260222
msgid "-segs_read_write_addr <address>	Specify that <address> is the base address address of the read-write segments of a dylib."
msgstr "-segs_read_write_addr <adress>\tAnge att <adress> är basadressen för de läs- och skrivbara segmenten i ett dylib."

#. from tp:gcc-16.1-b20260222
msgid "(Obsolete)	This is the default."
msgstr "(Föråldrat)	Detta är standard."

#. from tp:gcc-16.1-b20260222
msgid "-sub_library <name>	Library named <name> will be re-exported (only useful for dylibs)."
msgstr "-sub_library <namn>	Biblioteket med namnet <namn> kommer omexporteras (endast meningsfullt för dylib:ar)."

#. from tp:gcc-16.1-b20260222
msgid "-sub_umbrella <name>	Framework named <name> will be re-exported (only useful for dylibs)."
msgstr "-sub_umbrella <namn>	Ramverket med namnet <namn> kommer omexporteras (endast meningsfullt för dylib:ar)."

#. from tp:gcc-16.1-b20260222
msgid "This is the default."
msgstr "Detta är standard."

#. from tp:gcc-16.1-b20260222
msgid "Add extra information to the executable that can speed up dynamic loading (provided that dependent libraries are unchanged)."
msgstr "Lägg till extra information till den körbara som kan snabba upp den dynamiska laddningen (förutsatt att de beroende biblioteken är oförändrade)."

#. from tp:gcc-16.1-b20260222
msgid "-umbrella <framework>	The specified framework will be re-exported."
msgstr "-umbrella <ramverk>	Det angivna ramverket kommer omexporteras."

#. from tp:gcc-16.1-b20260222
msgid "-undefined <treatment>	Specify the handling for undefined symbols (default is error)."
msgstr "-undefined <hantering>	Ange hanteringen av odefinierade symboler (standard är fel)."

#. from tp:gcc-16.1-b20260222
msgid "-unexported_symbols_list <filename>	Do not export the global symbols listed in <filename>."
msgstr "-unexported_symbols_list <filnamn>	Exportera inte globala symboler uppräknade i <filnamn>."

#. from tp:gcc-16.1-b20260222
msgid "-weak_framework <framework>	Make a weak link to the specified framework."
msgstr "-weak_framework <ramverk>	Gör en svag länk till det angivna ramverket."

#. from tp:gcc-16.1-b20260222
msgid "-weak_reference_mismatches <treatment>	Specifies what to do if a symbol import conflicts between file (weak in one and not in another) the default is to treat the symbol as non-weak."
msgstr "-weak_reference_mismatches <hantering>\tAnge vad som ska göras om en symbolimport orsakar konflikt mellan filer (svag i en och inte i en annan); standard är att hantera symbolen som icke-svag."

#. from tp:gcc-16.1-b20260222
msgid "Logs which object files the linker loads."
msgstr "Loggar vilka objektfiler länkaren läser in."

#. from tp:gcc-16.1-b20260222
msgid "Logs which symbol(s) caused an object to be loaded."
msgstr "Loggar vilka symboler som orsakade att ett objekt laddades."

#. from tp:gcc-16.1-b20260222
msgid "(Obsolete, ignored)	Old support similar to \"-whyload\"."
msgstr "(Föråldrat, ignoreras)	Gammalt stöd liknande ”-whyload”."

#. from tp:gcc-16.1-b20260222
msgid "(Obsolete and unhandled by ld64, ignored)	ld should produce an executable (only handled by ld_classic)."
msgstr "(Föråldrat och ohanterat av ld64, ignoreras)	ld skall skapa en körbar (endast hanterat av ld_classic)."

#. from tp:gcc-16.1-b20260222
msgid "Known C6X ISAs (for use with the -march= option):"
msgstr "Kända C6X ISA:er (att användas med flaggan -march=):"

#. from tp:gcc-16.1-b20260222
msgid "Use big-endian byte order."
msgstr "Använd stor byteordning."

#. from tp:gcc-16.1-b20260222
msgid "Use little-endian byte order."
msgstr "Använd liten byteordning."

#. from tp:gcc-16.1-b20260222
msgid "Select method for sdata handling."
msgstr "Välj metod för hantering av sdata."

#. from tp:gcc-16.1-b20260222
msgid "Valid arguments for the -msdata= option:"
msgstr "Giltiga argument till flaggan -msdata=:"

#. from tp:gcc-16.1-b20260222
msgid "Compile for the DSBT shared library ABI."
msgstr "Kompilera för DSBT-ABI för delade bibliotek."

#. from tp:gcc-16.1-b20260222
msgid "-mabi=ABI	Generate code that conforms to the given ABI."
msgstr "-mabi=ABI	Generera kod som följer det angivna ABI:et."

#. from tp:gcc-16.1-b20260222
msgid "Known MIPS ABIs (for use with the -mabi= option):"
msgstr "Kända MIPS ABI:er (att användas med flaggan -mabi=):"

#. from tp:gcc-16.1-b20260222
msgid "Generate code that can be used in SVR4-style dynamic objects."
msgstr "Generera kod som kan användas i dynamiska objekt i SVR4-stil."

#. from tp:gcc-16.1-b20260222
msgid "Use PMC-style 'mad' instructions."
msgstr "Använd ”mad”-instruktioner i PMC-stil."

#. from tp:gcc-16.1-b20260222
msgid "Use integer madd/msub instructions."
msgstr "Använd heltals-madd-/msub-instruktioner."

#. from tp:gcc-16.1-b20260222
msgid "-march=ISA	Generate code for the given ISA."
msgstr "-march=ISA	Generera kod för den angivna ISA:n."

#. from tp:gcc-16.1-b20260222
msgid "Use Branch Likely instructions, overriding the architecture default."
msgstr "Använd Branch Likely-instruktioner och åsidosätt arkitekturens standardval."

#. from tp:gcc-16.1-b20260222
msgid "Switch on/off MIPS16 ASE on alternating functions for compiler testing."
msgstr "Växla av/på MIPS16 ASE mellan alternerande funktioner för kompilatortestning."

#. from tp:gcc-16.1-b20260222
msgid "-mcode-readable=SETTING	Specify when instructions are allowed to access code."
msgstr "-mcode-readable=INSTÄLLNING	Ange när instruktioner tillåts komma åt kod."

#. from tp:gcc-16.1-b20260222
msgid "Valid arguments to -mcode-readable=:"
msgstr "Giltiga argument till -mcode-readable=:"

#. from tp:gcc-16.1-b20260222
msgid "Use branch-and-break sequences to check for integer divide by zero."
msgstr "Använd branch-and-break-sekvenser för att upptäcka heltalsdivision med noll."

#. from tp:gcc-16.1-b20260222
msgid "Use trap instructions to check for integer divide by zero."
msgstr "Använd trap-instruktioner för att upptäcka heltalsdivision med noll."

#. from tp:gcc-16.1-b20260222
msgid "Allow the use of MDMX instructions."
msgstr "Tillåt användningen av MDMX-instruktioner."

#. from tp:gcc-16.1-b20260222
msgid "Use MIPS-DSP instructions."
msgstr "Använd MIPS-DSP-instruktioner."

#. from tp:gcc-16.1-b20260222
msgid "Use MIPS-DSP REV 2 instructions."
msgstr "Använd MIPS-DSP REV 2-instruktioner."

#. from tp:gcc-16.1-b20260222
msgid "Use Enhanced Virtual Addressing instructions."
msgstr "Använd instruktioner för förbättrad virtuell adressering."

#. from tp:gcc-16.1-b20260222
msgid "Don't use %reloc() assembly operators (for backward compatibility)."
msgstr "Använd inte assembleroperatorer %reloc() (för bakåtkompatibilitet)."

#. from tp:gcc-16.1-b20260222
msgid "Use -G for data that is not defined by the current object."
msgstr "Använd -G för data som inte är definierat av det aktuella objektet."

#. from tp:gcc-16.1-b20260222
msgid "Work around certain 24K errata."
msgstr "Gå runt vissa fel i 24K."

#. from tp:gcc-16.1-b20260222
msgid "Work around certain R4000 errata."
msgstr "Gå runt vissa fel i R4000."

#. from tp:gcc-16.1-b20260222
msgid "Work around certain R4400 errata."
msgstr "Gå runt vissa fel i R4400."

#. from tp:gcc-16.1-b20260222
msgid "Work around the R5900 short loop erratum."
msgstr "Gå runt felet med korta slingor i R5900."

#. from tp:gcc-16.1-b20260222
msgid "Work around certain RM7000 errata."
msgstr "Gå runt vissa fel i RM7000."

#. from tp:gcc-16.1-b20260222
msgid "Work around certain R10000 errata."
msgstr "Gå runt vissa fel i R10000."

#. from tp:gcc-16.1-b20260222
msgid "Work around errata for early SB-1 revision 2 cores."
msgstr "Gå runt fel i tidiga SB-1 revision 2-kärnor."

#. from tp:gcc-16.1-b20260222
msgid "Work around certain VR4120 errata."
msgstr "Gå runt vissa fel i VR4120."

#. from tp:gcc-16.1-b20260222
msgid "Work around VR4130 mflo/mfhi errata."
msgstr "Gå runt mflo/mfhi-fel i VR4130."

#. from tp:gcc-16.1-b20260222
msgid "Work around an early 4300 hardware bug."
msgstr "Gå runt ett hårdvarufel i tidiga 4300."

#. from tp:gcc-16.1-b20260222
msgid "FP exceptions are enabled."
msgstr "FP-undantag är aktiverade."

#. from tp:gcc-16.1-b20260222
msgid "Use 32-bit floating-point registers."
msgstr "Använd 32-bitars flyttalsregister."

#. from tp:gcc-16.1-b20260222
msgid "Conform to the o32 FPXX ABI."
msgstr "Följ ABI:t o32 FPXX."

#. from tp:gcc-16.1-b20260222
msgid "Use 64-bit floating-point registers."
msgstr "Använd 64-bitars flyttalsregister."

#. from tp:gcc-16.1-b20260222
msgid "-mflush-func=FUNC	Use FUNC to flush the cache before calling stack trampolines."
msgstr "-mflush-func=FUNK	Använd FUNK för att tömma cachen före anrop av stacktrampoliner."

#. from tp:gcc-16.1-b20260222
msgid "-mabs=MODE	Select the IEEE 754 ABS/NEG instruction execution mode."
msgstr "-mabs=MODE	Välj exekveringsläget IEEE 754 för instruktionerna ABS/NEG."

#. from tp:gcc-16.1-b20260222
msgid "-mnan=ENCODING	Select the IEEE 754 NaN data encoding."
msgstr "-mnan=ENCODING	Välj NaN-datakodningen IEEE 754."

#. from tp:gcc-16.1-b20260222
msgid "Known MIPS IEEE 754 settings (for use with the -mabs= and -mnan= options):"
msgstr "Kända MIPS IEEE 754-inställningar (att användas med flaggorna -mabs= och -mnan=):"

#. from tp:gcc-16.1-b20260222
msgid "Use 32-bit general registers."
msgstr "Använd 32-bitars allmänna register."

#. from tp:gcc-16.1-b20260222
msgid "Use 64-bit general registers."
msgstr "Använd 64-bitars allmänna register."

#. from tp:gcc-16.1-b20260222
msgid "Use GP-relative addressing to access small data."
msgstr "Använd GP-relativ adressering för att komma åt små data."

#. from tp:gcc-16.1-b20260222
msgid "When generating -mabicalls code, allow executables to use PLTs and copy relocations."
msgstr "Vid generering av -mabicalls-kod, tillåt körbara att använda PLT:er och kopieringsomlokaliseringar."

#. from tp:gcc-16.1-b20260222
msgid "Allow the use of hardware floating-point ABI and instructions."
msgstr "Tillåt användning av maskinvaru-ABI och -flyttalsinstruktioner."

#. from tp:gcc-16.1-b20260222
msgid "Generate code that is link-compatible with MIPS16 and microMIPS code."
msgstr "Generera kod som är länkkompatibel med MIPS16- och microMIPS-kod."

#. from tp:gcc-16.1-b20260222
msgid "An alias for minterlink-compressed provided for backward-compatibility."
msgstr "Ett alias för minterlink-compressed som finns för bakåtkompatibilitet."

#. from tp:gcc-16.1-b20260222
msgid "-mipsN	Generate code for ISA level N."
msgstr "-mipsN\tGenerera kod för ISA-nivå N."

#. from tp:gcc-16.1-b20260222
msgid "Generate MIPS16 code."
msgstr "Generera MIPS16-kod."

#. from tp:gcc-16.1-b20260222
msgid "Use MIPS-3D instructions."
msgstr "Använd MIPS-3D-instruktioner."

#. from tp:gcc-16.1-b20260222
msgid "Use ll, sc and sync instructions."
msgstr "Använd ll-, sc- och sync-instruktioner."

#. from tp:gcc-16.1-b20260222
msgid "Use -G for object-local data."
msgstr "Använd -G för objektlokala data."

#. from tp:gcc-16.1-b20260222
msgid "Use indirect calls."
msgstr "Använd indirekta anrop."

#. from tp:gcc-16.1-b20260222
msgid "Use a 32-bit long type."
msgstr "Använd en 32-bitars long-typ."

#. from tp:gcc-16.1-b20260222
msgid "Use a 64-bit long type."
msgstr "Använd en 64-bitars long-typ."

#. from tp:gcc-16.1-b20260222
msgid "Pass the address of the ra save location to _mcount in $12."
msgstr "Skicka adressen till ra-lagringsplatsen till _mcount i $12."

#. from tp:gcc-16.1-b20260222
msgid "Don't optimize block moves."
msgstr "Optimera inte blockförflyttningar."

#. from tp:gcc-16.1-b20260222
msgid "Use microMIPS instructions."
msgstr "Använd microMIPS-instruktioner."

#. from tp:gcc-16.1-b20260222
msgid "Use MIPS MSA Extension instructions."
msgstr "Använd MIPS MSA Extension-instruktioner."

#. from tp:gcc-16.1-b20260222
msgid "Allow the use of MT instructions."
msgstr "Tillåt användning av MT-instruktioner."

#. from tp:gcc-16.1-b20260222
msgid "Prevent the use of all floating-point operations."
msgstr "Förhindra användningen av alla flyttalsoperationer."

#. from tp:gcc-16.1-b20260222
msgid "Use MCU instructions."
msgstr "Använd MCU-instruktioner."

#. from tp:gcc-16.1-b20260222
msgid "Do not use a cache-flushing function before calling stack trampolines."
msgstr "Använd inte en cachetömmande funktion före anrop av stacktrampoliner."

#. from tp:gcc-16.1-b20260222
msgid "Do not use MDMX instructions."
msgstr "Använd inte MDMX-instruktioner."

#. from tp:gcc-16.1-b20260222
msgid "Generate normal-mode code."
msgstr "Generera kod för normalläge."

#. from tp:gcc-16.1-b20260222
msgid "Do not use MIPS-3D instructions."
msgstr "Använd inte MIPS-3D-instruktioner."

#. from tp:gcc-16.1-b20260222
msgid "Use paired-single floating-point instructions."
msgstr "Använd parvisa enkla flyttalsinstruktioner."

#. from tp:gcc-16.1-b20260222
msgid "-mr10k-cache-barrier=SETTING	Specify when r10k cache barriers should be inserted."
msgstr "-mr10k-cache-barrier=INSTÄLLNING	Ange när r10k-cache-barriärer skall skjutas in."

#. from tp:gcc-16.1-b20260222
msgid "Valid arguments to -mr10k-cache-barrier=:"
msgstr "Giltiga argument till -mr10k-cache-barrier=:"

#. from tp:gcc-16.1-b20260222
msgid "Try to allow the linker to turn PIC calls into direct calls."
msgstr "Försök att tillåta länkaren att göra om PIC-anrop till direkta anrop."

#. from tp:gcc-16.1-b20260222
msgid "When generating -mabicalls code, make the code suitable for use in shared libraries."
msgstr "Vid generering av -mabicalls-kod, gör så att koden passar för användning i delade bibliotek."

#. from tp:gcc-16.1-b20260222
msgid "Use SmartMIPS instructions."
msgstr "Använd SmartMIPS-instruktioner."

#. from tp:gcc-16.1-b20260222
msgid "Optimize lui/addiu address loads."
msgstr "Optimera adressladdning lui/addiu."

#. from tp:gcc-16.1-b20260222
msgid "Enable the MIPS16e V2 instructions."
msgstr "Använd instruktionerna MIPS16e V2."

#. from tp:gcc-16.1-b20260222
msgid "Assume all symbols have 32-bit values."
msgstr "Anta att alla symboler har 32-bitarsvärden."

#. from tp:gcc-16.1-b20260222
msgid "Use synci instruction to invalidate i-cache."
msgstr "Använd synci-instruktionen för att invalidera i-cachen."

#. from tp:gcc-16.1-b20260222
msgid "Use lwxc1/swxc1/ldxc1/sdxc1 instructions where applicable."
msgstr "Använd lwxc1/swxc1/ldxc1/sdxc1-instruktioner där det går."

#. from tp:gcc-16.1-b20260222
msgid "Use 4-operand madd.s/madd.d and related instructions where applicable."
msgstr "Använd madd.s/madd.d med fyra operander och relaterade instruktioner där det är tillämpligt."

#. from tp:gcc-16.1-b20260222
msgid "Don't generate code with unaligned load store, only valid for MIPS R6."
msgstr "Generera inte kod med ojusterade load/store-instruktioner; endast giltigt för MIPS R6."

#. from tp:gcc-16.1-b20260222
msgid "Generate code with unaligned load store for R6 (alias of -mno-strict-align)."
msgstr "Generera kod med ojusterade load/store-instruktioner för R6 (alias för -mno-strict-align)."

#. from tp:gcc-16.1-b20260222
msgid "Don't generate code with unaligned load store for R6 (alias of -mstrict-align)."
msgstr "Generera inte kod med ojusterade load/store-instruktioner för R6 (alias för -mstrict-align)."

#. from tp:gcc-16.1-b20260222
msgid "Use Virtualization (VZ) instructions."
msgstr "Använd virtualiseringsinstruktioner (VZ)."

#. from tp:gcc-16.1-b20260222
msgid "Use eXtended Physical Address (XPA) instructions."
msgstr "Använd instruktioner för utökad fysisk adress (XPA)."

#. from tp:gcc-16.1-b20260222
msgid "Use Cyclic Redundancy Check (CRC) instructions."
msgstr "Använd instruktioner för Cyclic Redundancy Check (CRC)."

#. from tp:gcc-16.1-b20260222
msgid "Use Global INValidate (GINV) instructions."
msgstr "Använd instruktioner för Global INValidering (GINV)."

#. from tp:gcc-16.1-b20260222
msgid "Perform VR4130-specific alignment optimizations."
msgstr "Utför VR4130-specifik justeringsoptimering."

#. from tp:gcc-16.1-b20260222
msgid "Lift restrictions on GOT size."
msgstr "Lyft restriktioner på GOT-storlek."

#. from tp:gcc-16.1-b20260222
msgid "Enable use of odd-numbered single-precision registers."
msgstr "Aktivera användningen av udda enkelprecisionsregister."

#. from tp:gcc-16.1-b20260222
msgid "Optimize frame header."
msgstr "Optimera ramhuvud."

#. from tp:gcc-16.1-b20260222
msgid "Change the behaviour to grow the frame downwards."
msgstr "Ändra så att ramen växer nedåt."

#. from tp:gcc-16.1-b20260222
msgid "Enable load/store bonding."
msgstr "Aktivera bindning av laddning/lagring."

#. from tp:gcc-16.1-b20260222
msgid "Specify the compact branch usage policy."
msgstr "Ange principen för användning av kompakta grenar."

#. from tp:gcc-16.1-b20260222
msgid "Policies available for use with -mcompact-branches=:"
msgstr "Principer som kan användas med -mcompact-branches=:"

#. from tp:gcc-16.1-b20260222
msgid "Use Loongson MultiMedia extensions Instructions (MMI) instructions."
msgstr "Använd instruktionerna Loongson Multimedia extensions Instructions (MMI)."

#. from tp:gcc-16.1-b20260222
msgid "Use Loongson EXTension (EXT) instructions."
msgstr "Använd Loongson Extension-instruktioner (EXT)."

#. from tp:gcc-16.1-b20260222
msgid "Use Loongson EXTension R2 (EXT2) instructions."
msgstr "Använd Loongson Extension R2-instruktioner (EXT2)."

#. from tp:gcc-16.1-b20260222
msgid "Known MIPS CPUs (for use with the -march= and -mtune= options):"
msgstr "Kända MIPS-CPU:er (att användas med flaggorna -march= och -mtune=):"

#. from tp:gcc-16.1-b20260222
msgid "Known MIPS ISA levels (for use with the -mips option):"
msgstr "Kända MIPS ISA-nivåer (att användas med flaggan -mips):"

#. from tp:gcc-16.1-b20260222
msgid "Enable TPF-OS tracing code."
msgstr "Aktivera TPF-OS-spårningskod."

#. from tp:gcc-16.1-b20260222
msgid "Set the trace check address for prologue tpf hook"
msgstr "Ange spårningskontrolladressen för prolog-tpf-haken"

#. from tp:gcc-16.1-b20260222
msgid "Set the trace jump address for prologue tpf hook"
msgstr "Ange spårningshoppadressen för prolog-tpf-haken"

#. from tp:gcc-16.1-b20260222
msgid "Set the trace check address for epilogue tpf hook"
msgstr "Ange spårningskontrolladressen för epilog-tpf-haken"

#. from tp:gcc-16.1-b20260222
msgid "Set the trace jump address for epilogue tpf hook"
msgstr "Ange spårningshoppadressen för epilog-tpf-haken"

#. from tp:gcc-16.1-b20260222
msgid "Set the prologue and epilogue hook addresses to TPF_TRACE_PROLOGUE_SKIP_TARGET and TPF_TRACE_EPILOGUE_SKIP_TARGET. Equivalent to using -mtpf-trace-hook-prologue-target=TPF_TRACE_PROLOGUE_SKIP_TARGET and -mtpf-trace-hook-epilogue-target=TPF_TRACE_EPILOGUE_SKIP_TARGET"
msgstr "Ange prolog- och epiloghakadresser till TPF_TRACE_PROLOGUE_SKIP_TARGET och TPF_TRACE_EPILOGUE_SKIP_TARGET.  Likvärdigt med att använda -mtpf-trace-hook-prologue-target=TPF_TRACE_PROLOGUE_SKIP_TARGET och -mtpf-trace-hook-epilogue-target=TPF_TRACE_EPILOGUE_SKIP_TARGET"

#. from tp:gcc-16.1-b20260222
msgid "Specify main object for TPF-OS."
msgstr "Ange huvudobjekt för TPF-OS."

#. from tp:gcc-16.1-b20260222
msgid "31 bit ABI."
msgstr "31-bitars ABI."

#. from tp:gcc-16.1-b20260222
msgid "64 bit ABI."
msgstr "64-bitars ABI."

#. from tp:gcc-16.1-b20260222
msgid "Maintain backchain pointer."
msgstr "Behåll bakåtkedjepekaren."

#. from tp:gcc-16.1-b20260222
msgid "Additional debug prints."
msgstr "Ytterligare felsökningsutskrifter."

#. from tp:gcc-16.1-b20260222
msgid "ESA/390 architecture."
msgstr "ESA/390-arkitektur."

#. from tp:gcc-16.1-b20260222
msgid "Enable decimal floating point hardware support."
msgstr "Använd hårdvarustöd för decimala flyttal."

#. from tp:gcc-16.1-b20260222
msgid "Enable hardware floating point."
msgstr "Använd hårdvaruflyttal."

#. from tp:gcc-16.1-b20260222
msgid "Takes two non-negative integer numbers separated by a comma. Prepend the function label with the number of two-byte Nop instructions indicated by the first.  Append Nop instructions covering the number of halfwords indicated by the second after the label.  Nop instructions of the largest possible size are used (six, four or two bytes), beginning with the largest possible size.  Using 0 for both values disables hotpatching."
msgstr "Tar två icke-negativa heltal separerade av ett kommatecken.  Inled funktionsetiketten med det antal tvåbytes Nop-instruktioner som indikeras av det första.  Avsluta med Nop-instruktioner som täcker det antal halvord som indikeras av den andra efter etiketten.  Nop-instruktioner av största möjliga storlek används (sex, fyra eller två byte), med början med den största möjliga storleken.  Att använda 0 för båda värdena avaktiverar hotpatchning."

#. from tp:gcc-16.1-b20260222
msgid "Use hardware transactional execution instructions."
msgstr "Använd transaktionskörningsinstruktioner i hårdvara."

#. from tp:gcc-16.1-b20260222
msgid "Use hardware vector facility instructions and enable the vector ABI."
msgstr "Använd instruktioner för vektorfunktioner i hårdvara och aktivera vektor-ABI:et."

#. from tp:gcc-16.1-b20260222
msgid "Use packed stack layout."
msgstr "Använd packad stacklayout."

#. from tp:gcc-16.1-b20260222
msgid "Use bras for executable < 64k."
msgstr "Använd bras för körbara program < 64k."

#. from tp:gcc-16.1-b20260222
msgid "Disable hardware floating point."
msgstr "Använd inte hårdvaruflyttal."

#. from tp:gcc-16.1-b20260222
msgid "Set the max. number of bytes which has to be left to stack size before a trap instruction is triggered."
msgstr "Ange maximalt antal byte som måste återstå av stackutrymmet innan en trap-instruktion utlöses."

#. from tp:gcc-16.1-b20260222
msgid "Switches off the -mstack-guard= option."
msgstr "Slår av flaggan -mstack-guard=."

#. from tp:gcc-16.1-b20260222
msgid "Generate section __stack_protector_loc containing pointers to all instructions which load the address of the global guard."
msgstr "Generera avsnittet __stack_protector_loc som innehåller pekare till alla instruktioner som laddar adressen till den globala vakten."

#. from tp:gcc-16.1-b20260222
msgid "Emit extra code in the function prologue in order to trap if the stack size exceeds the given limit."
msgstr "Mata ut extra kod i funktionsprologen för att utlösa en fälla om stackstorleken överskrider den angivna gränsen."

#. from tp:gcc-16.1-b20260222
msgid "Switches off the -mstack-size= option."
msgstr "Slår av flaggan -mstack-size=."

#. from tp:gcc-16.1-b20260222
msgid "Use the mvcle instruction for block moves."
msgstr "Använd mvcle-instruktioner för blockförflyttningar."

#. from tp:gcc-16.1-b20260222
msgid "Enable the z vector language extension providing the context-sensitive vector macro and enable the Altivec-style builtins in vecintrin.h."
msgstr "Aktivera språkutökningen z-vektor som ger det kontextkänsliga vektormakrot och aktivera de inbyggda i Altivec-stil i vecintrin.h."

#. from tp:gcc-16.1-b20260222
msgid "Warn if a function uses alloca or creates an array with dynamic size."
msgstr "Varna om en funktion använder alloca eller skapar ett fält med dynamisk storlek."

#. from tp:gcc-16.1-b20260222
msgid "Warn if a single function's framesize exceeds the given framesize."
msgstr "Varna om en enskild funktions ramstorlek överskrider den angivna ramstorleken."

#. from tp:gcc-16.1-b20260222
msgid "z/Architecture."
msgstr "z/Arkitektur."

#. from tp:gcc-16.1-b20260222
msgid "Set the branch costs for conditional branch instructions.  Reasonable values are small, non-negative integers.  The default branch cost is 1."
msgstr "Ange grenkostnaden för villkorliga greninstruktioner.  Rimliga värden är små, icke-negativa heltal.  Standardkostnaden för grenar är 1."

#. from tp:gcc-16.1-b20260222
msgid "Wrap all indirect branches into execute in order to disable branch prediction."
msgstr "Kapsla in alla indirekta grenar till att köra i ordning för att avaktivera grenförutsägelser."

#. from tp:gcc-16.1-b20260222
msgid "Wrap indirect table jumps and computed gotos into execute in order to disable branch prediction.  Using thunk or thunk-extern with this option requires the thunks to be considered signal handlers to order to generate correct CFI.  For environments where unwinding (e.g. for exceptions) is required please use thunk-inline instead."
msgstr "Kapsla in indirekta tabellhopp och beräknade goto:er i execute för att avaktivera grenförutsägelse.  Användning av thunk eller thunk-extern med denna flagga kräver att trampolinerna betraktas som signalhanterare för att korrekt CFI ska genereras.  Använd thunk-inline i miljöer där upprullning krävs (t.ex. för undantag)."

#. from tp:gcc-16.1-b20260222
msgid "Wrap all indirect calls into execute in order to disable branch prediction."
msgstr "Kapsla in alla indirekta anrop till att köras i ordning för att avaktivera grenförutsägelser."

#. from tp:gcc-16.1-b20260222
msgid "Wrap all indirect return branches into execute in order to disable branch prediction."
msgstr "Slå in alla indirekta returgrenar till att köras i ordning för att avaktivera grenförutsägelser."

#. from tp:gcc-16.1-b20260222
msgid "Wrap indirect return branches into execute in order to disable branch prediction. This affects only branches where the return address is going to be restored from memory."
msgstr "Kapsla in indirekta returgrenar till att köra i ordning för att avaktivera grenförutsägelser.  Detta påverkar endast grenar där returadressen kommer att återställas från minnet."

#. from tp:gcc-16.1-b20260222
msgid "Wrap indirect return branches into execute in order to disable branch prediction. This affects only branches where the return address doesn't need to be restored from memory."
msgstr "Slå in indirekta returgrenar till att köras i ordning för att avaktivera grenförutsägelser.  Detta påverkar endast grenar där returadressen inte behöver återställas från minnet."

#. from tp:gcc-16.1-b20260222
msgid "Generate sections .s390_indirect_jump, .s390_indirect_call, .s390_return_reg, and .s390_return_mem to contain the indirect branch locations which have been patched as part of using one of the -mindirect-branch* or -mfunction-return* options.  The sections consist of an array of 32 bit elements. Each entry holds the offset from the entry to the patched location."
msgstr "Generera sektionerna .s390_indirect_jump, .s390_indirect_call, .s390_return_reg och .s390_return_mem som innehåller indirekta grenplatser som har patchats vid användning av en av flaggorna -mindirect-branch* eller -mfunction-return*.  Sektionerna består av en vektor med 32-bitars element. Varje post innehåller förskjutningen från posten till den patchade platsen."

#. from tp:gcc-16.1-b20260222
msgid "Emit profiling counter call at function entry before prologue. The compiled code will require a 64-bit CPU and glibc 2.29 or newer to run."
msgstr "Generera profileringsräknaranrop vid funktionsstart före prologen.  Den kompilerade koden kommer kräva en 64-bitars CPU och glibc 2.29 eller senare för att köra."

#. from tp:gcc-16.1-b20260222
msgid "Generate __mcount_loc section with all _mcount and __fentry__ calls."
msgstr "Generera en __mcount_loc-sektion med alla _mcount- eller __fentry__-anrop."

#. from tp:gcc-16.1-b20260222
msgid "Emit fused multiply-add instructions for long doubles in vector registers (wfmaxb, wfmsxb, wfnmaxb, wfnmsxb).  Reassociation pass does not handle fused multiply-adds, therefore code generated by the middle-end is prone to having long fused multiply-add chains.  This is not pipeline-friendly, and the default behavior is to emit separate multiplication and addition instructions for long doubles in vector registers, because measurements show that this improves performance.  This option allows overriding it for testing purposes."
msgstr "Mata ut sammanslagna multiplicera-addera-instruktioner för long double-värden i vektorregister (wfmaxb, wfmsxb, wfnmaxb, wfnmsxb). Återassociationspasset hanterar inte sammanslagna multiplicera-addera-instruktioner, och kod som genereras av mellanänden kan därför innehålla långa kedjor av sådana instruktioner. Detta är inte gynnsamt för pipelinen. Standardbeteendet är att mata ut separata multiplikations- och additionsinstruktioner för long double-värden i vektorregister, eftersom mätningar visar bättre prestanda. Denna flagga tillåter att detta åsidosätts för testning."

#. from tp:gcc-16.1-b20260222
msgid "Store all argument registers on the stack."
msgstr "Slagra alla argumentregister på stacken."

#. from tp:gcc-16.1-b20260222
msgid "Assume external symbols, whose natural alignment would be 1, to be potentially unaligned.  By default all symbols without explicit alignment are assumed to reside on a 2 byte boundary as mandated by the IBM Z ABI."
msgstr "Anta att externa symboler, vars naturliga justering skulle vara 1, potentiellt är ojusterade. Som standard antas alla symboler utan en explicit justering att ligga på en 2-bytegräns så som IBM Z ABI:et kräver."

#. from tp:gcc-16.1-b20260222
msgid "Support legacy multi-threading."
msgstr "Stöd gammaldags multitrådning."

#. from tp:gcc-16.1-b20260222
msgid "Use shared libraries."
msgstr "Använd delade bibliotek."

#. from tp:gcc-16.1-b20260222
msgid "Support multi-threading."
msgstr "Stöd multitrådning."

#. from tp:gcc-16.1-b20260222
msgid "Assume small address space."
msgstr "Anta liten adressrymd."

#. from tp:gcc-16.1-b20260222
msgid "Generate code for an 11/10."
msgstr "Generera kod för 11/10."

#. from tp:gcc-16.1-b20260222
msgid "Generate code for an 11/40."
msgstr "Generera kod för 11/40."

#. from tp:gcc-16.1-b20260222
msgid "Generate code for an 11/45."
msgstr "Generera kod för 11/45."

#. from tp:gcc-16.1-b20260222
msgid "Return floating-point results in ac0 (fr0 in Unix assembler syntax)."
msgstr "Returnera flyttalsresultat i ac0 (fr0 i assemblersyntax för Unix)."

#. from tp:gcc-16.1-b20260222
msgid "Use the DEC assembler syntax."
msgstr "Använd assemblersyntax för DEC."

#. from tp:gcc-16.1-b20260222
msgid "Use the GNU assembler syntax."
msgstr "Använd assemblersyntax för GNU."

#. from tp:gcc-16.1-b20260222
msgid "Use 16 bit int."
msgstr "Använd 16-bitars int."

#. from tp:gcc-16.1-b20260222
msgid "Use 32 bit int."
msgstr "Använd 32-bitars int."

#. from tp:gcc-16.1-b20260222
msgid "Target has split I&D."
msgstr "Målet har uppdelat I&D."

#. from tp:gcc-16.1-b20260222
msgid "Use UNIX assembler syntax."
msgstr "Använd assemblersyntax för UNIX."

#. from tp:gcc-16.1-b20260222
msgid "Use LRA register allocator."
msgstr "Använd LRA-registerallokeraren."

#. from tp:gcc-16.1-b20260222
msgid "Enable generation of hardware divide (l.div, l.divu) instructions.  This is the default; use -msoft-div to override."
msgstr "Aktivera generering av hårdvarudivisionsinstruktioner (l.div, l.divu).  Detta är standard; använd -msoft-div för att åsidosätta."

#. from tp:gcc-16.1-b20260222
msgid "Enable generation of binaries which use functions from libgcc to perform divide operations.  The default is -mhard-div."
msgstr "Aktivera generering av binärer som använder funktioner från libgcc för att utföra divisionsoperationer.  Standard är -mhard-div."

#. from tp:gcc-16.1-b20260222
msgid "Enable generation of hardware multiply instructions (l.mul, l.muli) instructions. This is the default; use -msoft-mul to override."
msgstr "Aktivera generering av hårdvarumultiplikationsinstruktioner (l.mul, l.muli). Detta är standard; använd -msoft-mul för att åsidosätta."

#. from tp:gcc-16.1-b20260222
msgid "Enable generation of binaries which use functions from libgcc to perform multiply operations. The default is -mhard-mul."
msgstr "Aktivera generering av binärer som använder funktioner från libgcc för att utföra multiplikationsoperationer.  Standard är -mhard-mul."

#. from tp:gcc-16.1-b20260222
msgid "Enable generation of binaries which use functions from libgcc to perform floating point operations.  This is the default; use -mhard-float to override."
msgstr "Aktivera generering av binärer som använder funktioner från libgcc för att utföra flyttalsoperationer.  Detta är standard; använd -mhard-float för att åsidosätta."

#. from tp:gcc-16.1-b20260222
msgid "Enable generation of hardware floating point instructions. The default is -msoft-float."
msgstr "Aktivera generering av flyttalsinstruktioner i hårdvara.  Standard är -msoft-float."

#. from tp:gcc-16.1-b20260222
msgid "When -mhard-float is selected, enables generation of double-precision floating point instructions.  By default functions from libgcc are used to perform double-precision floating point operations."
msgstr "När -mhard-float har valts, aktivera generering av flyttalsinstruktioner med dubbel precision.  Som standard används funktioner från libgcc för flyttalsoperationer med dubbel precision."

#. from tp:gcc-16.1-b20260222
msgid "When -mhard-float is selected, enables generation of unordered floating point compare and set flag (lf.sfun*) instructions.  By default functions from libgcc are used to perform unordered floating point compare and set flag operations."
msgstr "När -mhard-float är valt, aktiverar generering av instruktioner för oordnad flyttalsjämförelse och för att sätta flaggor (lf.sfun*).  Som standard används funktioner från libgcc för att utföra oordnad jämförelse av flyttal och operationer för att sätta flaggor."

#. from tp:gcc-16.1-b20260222
msgid "Specify the code model used for accessing memory addresses.  Specifying large enables generating binaries with large global offset tables and calling functions anywhere in an executable.  By default the value is small."
msgstr "Ange kodmodellen som skall användas för att komma åt minnesadresser. Att ange large möjliggör generering av binärer med stora globala avståndstabeller och att anropa funktioner var som helst i den körbara. Som standard är värdet small."

#. from tp:gcc-16.1-b20260222
msgid "Known code model types (for use with the -mcmodel= option):"
msgstr "Kända kodmodelltyper (att användas med flaggan -mcmodel=):"

#. from tp:gcc-16.1-b20260222
msgid "Enable generation of conditional move (l.cmov) instructions.  By default the equivalents are generated using set and branch."
msgstr "Aktivera generering av instruktioner för villkorlig förflyttning (l.cmov).  Som standard genereras motsvarande med set och branch."

#. from tp:gcc-16.1-b20260222
msgid "Enable generation of rotate right (l.ror) instructions.  By default functions from libgcc are used to perform rotate right operations."
msgstr "Aktivera generering av instruktioner för att rotera åt höger (l.ror).  Som standard används funktioner från libgcc för att utföra operationer som roterar åt höger."

#. from tp:gcc-16.1-b20260222
msgid "Enable generation of rotate right with immediate (l.rori) instructions.  By default functions from libgcc are used to perform rotate right with immediate operations."
msgstr "Aktivera generering av instruktioner för att rotera åt höger med omedelbar (l.rori).  Som standard används funktioner från libgcc för att utföra operationer som roterar åt höger med omedelbar."

#. from tp:gcc-16.1-b20260222
msgid "Enable generation of sign extension (l.ext*) instructions.  By default memory loads are used to perform sign extension."
msgstr "Aktivera generering av instruktioner för teckenutökning (l.ext*).  Som standard används minnesinläsning för att utföra teckenutökning."

#. from tp:gcc-16.1-b20260222
msgid "Enable generation of compare and set flag with immediate (l.sf*i) instructions. By default extra instructions are generated to store the immediate to a register first."
msgstr "Aktivera generering av instruktioner för jämförelse och sätt flagga med omedelbar (l.sf*i).  Som standard genereras extra instruktioner för att lagra den omedelbara i ett register först."

#. from tp:gcc-16.1-b20260222
msgid "Enable generation of shift with immediate (l.srai, l.srli, l.slli) instructions. By default extra instructions are generated to store the immediate to a register first."
msgstr "Aktivera generering av instruktioner för skift med omedelbar (l.srai, l.srli, l.slli).  Som standard genereras extra instruktioner för att lagra den omedelbara i ett register först."

#. from tp:gcc-16.1-b20260222
msgid "Configure the newlib board specific runtime.  The default is or1ksim."
msgstr "Konfigurera den kortspecifika körtiden för newlib.  Standard är or1ksim."

#. from tp:gcc-16.1-b20260222
msgid "This option is ignored; it is provided for compatibility purposes only.  This used to select linker and preprocessor options for use with newlib."
msgstr "Denna flagga ignoreras och tillhandahålls endast för kompatibilitet.  Den användes tidigare för att välja flaggor för länkaren och preprocessorn vid användning med newlib."

#. from tp:gcc-16.1-b20260222
msgid "Generate big endian code."
msgstr "Generera kod med stor byteordning."

#. from tp:gcc-16.1-b20260222
msgid "Generate little endian code."
msgstr "Generera kod med liten byteordning."

#. from tp:gcc-16.1-b20260222
msgid "Generate code for GNU as."
msgstr "Generera kod för GNU as."

#. from tp:gcc-16.1-b20260222
msgid "Generate code for GNU ld."
msgstr "Generera kod för GNU ld."

#. from tp:gcc-16.1-b20260222
msgid "Emit stop bits before and after volatile extended asms."
msgstr "Mata ut stoppbitar före och efter flyktiga utökade asm:er."

#. from tp:gcc-16.1-b20260222
msgid "Use in/loc/out register names."
msgstr "Använd in/loc/out-registernamn."

#. from tp:gcc-16.1-b20260222
msgid "Enable use of sdata/scommon/sbss."
msgstr "Aktivera användningen av sdata/scommon/sbss."

#. from tp:gcc-16.1-b20260222
msgid "Generate code without GP reg."
msgstr "Generera kod utan GP-register."

#. from tp:gcc-16.1-b20260222
msgid "gp is constant (but save/restore gp on indirect calls)."
msgstr "gp är konstant (men spara/återställ gp vid indirekta anrop)."

#. from tp:gcc-16.1-b20260222
msgid "Generate self-relocatable code."
msgstr "Generera självomlokaliserbar kod."

#. from tp:gcc-16.1-b20260222
msgid "Generate inline floating point division, optimize for latency."
msgstr "Generera inline flyttalsdivision, optimera för svarstid."

#. from tp:gcc-16.1-b20260222
msgid "Generate inline floating point division, optimize for throughput."
msgstr "Generera inline flyttalsdivision, optimera för genomströmning."

#. from tp:gcc-16.1-b20260222
msgid "Generate inline integer division, optimize for latency."
msgstr "Generera inline heltalsdivision, optimera för svarstid."

#. from tp:gcc-16.1-b20260222
msgid "Generate inline integer division, optimize for throughput."
msgstr "Generera inline heltalsdivision, optimera för genomströmning."

#. from tp:gcc-16.1-b20260222
msgid "Do not inline integer division."
msgstr "Inline:a inte heltalsdivision."

#. from tp:gcc-16.1-b20260222
msgid "Generate inline square root, optimize for latency."
msgstr "Generera inline kvadratrot, optimera för svarstid."

#. from tp:gcc-16.1-b20260222
msgid "Generate inline square root, optimize for throughput."
msgstr "Generera inline kvadratrot, optimera för genomströmning."

#. from tp:gcc-16.1-b20260222
msgid "Do not inline square root."
msgstr "Inline:a inte kvadratrot."

#. from tp:gcc-16.1-b20260222
msgid "Enable DWARF line debug info via GNU as."
msgstr "Aktivera DWARF-radfelsökningsinformation via GNU as."

#. from tp:gcc-16.1-b20260222
msgid "Enable earlier placing stop bits for better scheduling."
msgstr "Aktivera tidigare utplacering av stoppbitar för bättre schemaläggning."

#. from tp:gcc-16.1-b20260222
msgid "Known Itanium CPUs (for use with the -mtune= option):"
msgstr "Kända Itanium-CPU:er (att användas med flaggan -mtune=):"

#. from tp:gcc-16.1-b20260222
msgid "Use data speculation before reload."
msgstr "Använd dataspekulation före omläsning."

#. from tp:gcc-16.1-b20260222
msgid "Use data speculation after reload."
msgstr "Använd dataspekulation efter omläsning."

#. from tp:gcc-16.1-b20260222
msgid "Use control speculation."
msgstr "Använd styrspekulation."

#. from tp:gcc-16.1-b20260222
msgid "Use in block data speculation before reload."
msgstr "Använd inblocksdataspekulation före omläsning."

#. from tp:gcc-16.1-b20260222
msgid "Use in block data speculation after reload."
msgstr "Använd inblocksdataspekulation efter omläsning."

#. from tp:gcc-16.1-b20260222
msgid "Use in block control speculation."
msgstr "Använd inblocksstyrspekulation."

#. from tp:gcc-16.1-b20260222
msgid "Use simple data speculation check."
msgstr "Använd enkel dataspekulationskontroll."

#. from tp:gcc-16.1-b20260222
msgid "Use simple data speculation check for control speculation."
msgstr "Använd enkel dataspekulationskontroll för styrspekulation."

#. from tp:gcc-16.1-b20260222
msgid "Count speculative dependencies while calculating priority of instructions."
msgstr "Räkna spekulativa beroenden vid beräkning av prioritet för instruktioner."

#. from tp:gcc-16.1-b20260222
msgid "Place a stop bit after every cycle when scheduling."
msgstr "Placera en stoppbit efter varje cykel vid schemaläggning."

#. from tp:gcc-16.1-b20260222
msgid "Assume that floating-point stores and loads are not likely to cause conflict when placed into one instruction group."
msgstr "Anta att flyttalslagringar och -laddningar troligen inte orsakar konflikter när de placeras i en instruktionsgrupp."

#. from tp:gcc-16.1-b20260222
msgid "Soft limit on number of memory insns per instruction group, giving lower priority to subsequent memory insns attempting to schedule in the same insn group. Frequently useful to prevent cache bank conflicts.  Default value is 1."
msgstr "Mjuk gräns för antalet minnesinstruktioner per instruktionsgrupp; senare minnesinstruktioner som försöker schemaläggas i samma instruktionsgrupp får lägre prioritet.  Detta är ofta användbart för att förhindra konflikter mellan cachebanker.  Standardvärdet är 1."

#. from tp:gcc-16.1-b20260222
msgid "Disallow more than 'msched-max-memory-insns' in instruction group. Otherwise, limit is 'soft' (prefer non-memory operations when limit is reached)."
msgstr "Tillåt inte mer än ”msched-max-memory-insns” i instruktionsgrupper.  Annars är gränsen ”mjuk” (föredra icke-minnesoperationer när gränsen är nådd)."

#. from tp:gcc-16.1-b20260222
msgid "Don't generate checks for control speculation in selective scheduling."
msgstr "Generera inte kontroller av styrningsspekulation i selektiv schemaläggning."

#. from tp:gcc-16.1-b20260222
msgid "Generate ILP32 code."
msgstr "Generera ILP32-kod."

#. from tp:gcc-16.1-b20260222
msgid "Generate LP64 code."
msgstr "Generera LP64-kod."

#. from tp:gcc-16.1-b20260222
msgid "Select VxWorks SMP C runtimes for linking."
msgstr "Välj VxWorks SMP C-körtider för länkning."

#. from tp:gcc-16.1-b20260222
msgid "Generate SH1 code."
msgstr "Generera SH1-kod."

#. from tp:gcc-16.1-b20260222
msgid "Generate SH2 code."
msgstr "Generera SH2-kod."

#. from tp:gcc-16.1-b20260222
msgid "Generate default double-precision SH2a-FPU code."
msgstr "Generera normal dubbelprecisions SH2a-FPU-kod."

#. from tp:gcc-16.1-b20260222
msgid "Generate SH2a FPU-less code."
msgstr "Generera SH2a-kod utan FPU."

#. from tp:gcc-16.1-b20260222
msgid "Generate default single-precision SH2a-FPU code."
msgstr "Generera normal enkelprecisions SH2a-FPU-kod."

#. from tp:gcc-16.1-b20260222
msgid "Generate only single-precision SH2a-FPU code."
msgstr "Generera endast enkelprecisions SH2a-FPU-kod."

#. from tp:gcc-16.1-b20260222
msgid "Generate SH2e code."
msgstr "Generera SH2e-kod."

#. from tp:gcc-16.1-b20260222
msgid "Generate SH3 code."
msgstr "Generera SH3-kod."

#. from tp:gcc-16.1-b20260222
msgid "Generate SH3e code."
msgstr "Generera SH3e-kod."

#. from tp:gcc-16.1-b20260222
msgid "Generate SH4 code."
msgstr "Generera SH4-kod."

#. from tp:gcc-16.1-b20260222
msgid "Generate SH4-100 code."
msgstr "Generera SH4-100-kod."

#. from tp:gcc-16.1-b20260222
msgid "Generate SH4-200 code."
msgstr "Generera SH4-200-kod."

#. from tp:gcc-16.1-b20260222
msgid "Generate SH4-300 code."
msgstr "Generera SH4-300-kod."

#. from tp:gcc-16.1-b20260222
msgid "Generate SH4 FPU-less code."
msgstr "Generera SH4-kod utan FPU."

#. from tp:gcc-16.1-b20260222
msgid "Generate SH4-100 FPU-less code."
msgstr "Generera SH4-100-kod utan FPU."

#. from tp:gcc-16.1-b20260222
msgid "Generate SH4-200 FPU-less code."
msgstr "Generera SH4-200-kod utan FPU."

#. from tp:gcc-16.1-b20260222
msgid "Generate SH4-300 FPU-less code."
msgstr "Generera SH4-300-kod utan FPU."

#. from tp:gcc-16.1-b20260222
msgid "Generate code for SH4 340 series (MMU/FPU-less)."
msgstr "Generera kod för SH4 340-serien (saknar MMU/FPU)."

#. from tp:gcc-16.1-b20260222
msgid "Generate code for SH4 400 series (MMU/FPU-less)."
msgstr "Generera kod för SH4 400-serien (saknar MMU/FPU)."

#. from tp:gcc-16.1-b20260222
msgid "Generate code for SH4 500 series (FPU-less)."
msgstr "Generera kod för SH4-500-serien (utan FPU)."

#. from tp:gcc-16.1-b20260222
msgid "Generate default single-precision SH4 code."
msgstr "Generera normal enkelprecisions SH4-kod."

#. from tp:gcc-16.1-b20260222
msgid "Generate default single-precision SH4-100 code."
msgstr "Generera normal enkelprecisions SH4-100-kod."

#. from tp:gcc-16.1-b20260222
msgid "Generate default single-precision SH4-200 code."
msgstr "Generera normal enkelprecisions SH4-200-kod."

#. from tp:gcc-16.1-b20260222
msgid "Generate default single-precision SH4-300 code."
msgstr "Generera normal enkelprecisions SH4-300-kod."

#. from tp:gcc-16.1-b20260222
msgid "Generate only single-precision SH4 code."
msgstr "Generera endast enkelprecisions SH4-kod."

#. from tp:gcc-16.1-b20260222
msgid "Generate only single-precision SH4-100 code."
msgstr "Generera endast enkelprecisions SH4-100-kod."

#. from tp:gcc-16.1-b20260222
msgid "Generate only single-precision SH4-200 code."
msgstr "Generera endast enkelprecisions SH4-200-kod."

#. from tp:gcc-16.1-b20260222
msgid "Generate only single-precision SH4-300 code."
msgstr "Generera endast enkelprecisions SH4-300-kod."

#. from tp:gcc-16.1-b20260222
msgid "Generate SH4a code."
msgstr "Generera SH4a-kod."

#. from tp:gcc-16.1-b20260222
msgid "Generate SH4a FPU-less code."
msgstr "Generera SH4a-kod utan FPU."

#. from tp:gcc-16.1-b20260222
msgid "Generate default single-precision SH4a code."
msgstr "Generera normal enkelprecisions SH4a-kod."

#. from tp:gcc-16.1-b20260222
msgid "Generate only single-precision SH4a code."
msgstr "Generera endast enkelprecisions SH4a-kod."

#. from tp:gcc-16.1-b20260222
msgid "Generate SH4al-dsp code."
msgstr "Generera SH4al-dsp-kod."

#. from tp:gcc-16.1-b20260222
msgid "Generate code in big endian mode."
msgstr "Generera kod med stor byteordning."

#. from tp:gcc-16.1-b20260222
msgid "Generate 32-bit offsets in switch tables."
msgstr "Använd 32-bitars avstånd i hopptabeller."

#. from tp:gcc-16.1-b20260222
msgid "Generate bit instructions."
msgstr "Generera bitinstruktioner."

#. from tp:gcc-16.1-b20260222
msgid "Assume that zero displacement conditional branches are fast."
msgstr "Anta att villkorliga grenar med noll förskjutning är snabba."

#. from tp:gcc-16.1-b20260222
msgid "Force the usage of delay slots for conditional branches."
msgstr "Framtvinga användningen av fördröjningssteg för villkorliga grenar."

#. from tp:gcc-16.1-b20260222
msgid "Align doubles at 64-bit boundaries."
msgstr "Justera dubbelvärden till 64-bitarsgränser."

#. from tp:gcc-16.1-b20260222
msgid "Division strategy, one of: call-div1, call-fp, call-table."
msgstr "Divisionsstrategi, en av: call-div1, call-fp, call-table."

#. from tp:gcc-16.1-b20260222
msgid "Specify name for 32 bit signed division function."
msgstr "Ange namnet på funktion för 32-bitars division med tecken."

#. from tp:gcc-16.1-b20260222
msgid "Generate ELF FDPIC code."
msgstr "Generera ELF FDPIC-kod."

#. from tp:gcc-16.1-b20260222
msgid "Enable the use of 64-bit floating point registers in fmov instructions.  See -mdalign if 64-bit alignment is required."
msgstr "Möjliggör användningen av 64-bitars flyttalsregister i fmov-instruktioner.  Se -mdalign om 64-bitars justering krävs."

#. from tp:gcc-16.1-b20260222
msgid "Follow Renesas (formerly Hitachi) / SuperH calling conventions."
msgstr "Följ Renesas (tidigare Hitachi) / SuperH-anropskonventioner."

#. from tp:gcc-16.1-b20260222
msgid "Increase the IEEE compliance for floating-point comparisons."
msgstr "Öka IEEE-överensstämmelsen för flyttalsjämförelser."

#. from tp:gcc-16.1-b20260222
msgid "Inline code to invalidate instruction cache entries after setting up nested function trampolines."
msgstr "Inline:a kod för att invalidera instruktionscacheposter efter att nästade funktionstrampoliner satts upp."

#. from tp:gcc-16.1-b20260222
msgid "Generate code in little endian mode."
msgstr "Generera kod för omvänd byteordning."

#. from tp:gcc-16.1-b20260222
msgid "Mark MAC register as call-clobbered."
msgstr "Markera MAC-register som anropsöverskrivna."

#. from tp:gcc-16.1-b20260222
msgid "Make structs a multiple of 4 bytes (warning: ABI altered)."
msgstr "Gör poster en multipel av 4 byte (varning: ABI:et ändras)."

#. from tp:gcc-16.1-b20260222
msgid "Emit function-calls using global offset table when generating PIC."
msgstr "Mata ut funktionsanrop som använder en global avståndstabell när PIC genereras."

#. from tp:gcc-16.1-b20260222
msgid "Shorten address references during linking."
msgstr "Förkorta adressreferenser vid länkning."

#. from tp:gcc-16.1-b20260222
msgid "Specify the model for atomic operations."
msgstr "Ange modellen för atomära operationer."

#. from tp:gcc-16.1-b20260222
msgid "Use tas.b instruction for __atomic_test_and_set."
msgstr "Använd instruktionen tas.b till __atomic_test_and_set."

#. from tp:gcc-16.1-b20260222
msgid "Cost to assume for a multiply insn."
msgstr "Kostnad att anta för en multiplikationsinstruktion."

#. from tp:gcc-16.1-b20260222
msgid "Don't generate privileged-mode only code; implies -mno-inline-ic_invalidate if the inline code would not work in user mode."
msgstr "Generera inte kod för endast privilegierat läge.  Implicerar -mno-inline-ic_invalidate om den inline:ade koden inte skulle fungera i användarläge."

#. from tp:gcc-16.1-b20260222
msgid "Pretend a branch-around-a-move is a conditional move."
msgstr "Låtsas en gren-runt-en-förflyttning är en villkorlig förflyttning."

#. from tp:gcc-16.1-b20260222
msgid "Enable the use of the fsca instruction."
msgstr "Aktivera användningen av instruktionen fsca."

#. from tp:gcc-16.1-b20260222
msgid "Enable the use of the fsrra instruction."
msgstr "Aktivera användningen av instruktionen fsrra."

#. from tp:gcc-16.1-b20260222
msgid "Board name [and memory region]."
msgstr "Kortnamn [och minnesregion]."

#. from tp:gcc-16.1-b20260222
msgid "Runtime name."
msgstr "Körtidsnamn."

#. from tp:gcc-16.1-b20260222
msgid "-msim	Use simulator runtime."
msgstr "-msim	Använd simulatorkörtider."

#. from tp:gcc-16.1-b20260222
msgid "-mcpu=r8c	Compile code for R8C variants."
msgstr "-mcpu=r8c	Kompilera kod för R8C-varianter."

#. from tp:gcc-16.1-b20260222
msgid "-mcpu=m16c	Compile code for M16C variants."
msgstr "-mcpu=m16c	Kompilera kod för M16C-varianter."

#. from tp:gcc-16.1-b20260222
msgid "-mcpu=m32cm	Compile code for M32CM variants."
msgstr "-mcpu=m32cm	Kompilera kod för M32CM-varianter."

#. from tp:gcc-16.1-b20260222
msgid "-mcpu=m32c	Compile code for M32C variants."
msgstr "-mcpu=m32c	Kompilera kod för M32C-varianter."

#. from tp:gcc-16.1-b20260222
msgid "-memregs=	Number of memreg bytes (default: 16, range: 0..16)."
msgstr "-memregs=	Antal memreg-byte (standard: 16, intervall: 0..16)."

#. from tp:gcc-16.1-b20260222
msgid "Provide libraries for the simulator."
msgstr "Tillhandahåll bibliotek för simulatorn."

#. from tp:gcc-16.1-b20260222
msgid "Generate assembler output that is compatible with the Renesas AS100 assembler.  This may restrict some of the compiler's capabilities.  The default is to generate GAS compatible syntax."
msgstr "Generera assemblerutdata som är kompatibla med Renesas AS100-assembler.  Detta kan begränsa vissa av kompilatorns möjligheter.  Standard är att generera GAS-kompatibel syntax."

#. from tp:gcc-16.1-b20260222
msgid "Specifies the number of registers to reserve for interrupt handlers."
msgstr "Anger antalet register som skall reserveras för avbrottshanterare."

#. from tp:gcc-16.1-b20260222
msgid "Specifies whether interrupt functions should save and restore the accumulator register."
msgstr "Anger om avbrottsfunktioner skall spara och återställa ackumulatorregistret."

#. from tp:gcc-16.1-b20260222
msgid "Store doubles in 64 bits."
msgstr "Lagra dubbelvärden i 64 bitar."

#. from tp:gcc-16.1-b20260222
msgid "Stores doubles in 32 bits.  This is the default."
msgstr "Lagra dubbelvärden i 32 bitar.  Detta är standard."

#. from tp:gcc-16.1-b20260222
msgid "Disable the use of RX FPU instructions."
msgstr "Avaktivera användningen av RX FPU-instruktioner."

#. from tp:gcc-16.1-b20260222
msgid "Enable the use of RX FPU instructions.  This is the default."
msgstr "Möjliggör användning av RX FPU-instruktionerna.  Detta är standard."

#. from tp:gcc-16.1-b20260222
msgid "Specify the target RX cpu type."
msgstr "Ange mål-RX-CPU-typen."

#. from tp:gcc-16.1-b20260222
msgid "Data is stored in big-endian format."
msgstr "Data lagras med stor byteordning."

#. from tp:gcc-16.1-b20260222
msgid "Data is stored in little-endian format.  (Default)."
msgstr "Data lagras med liten byteordning.  (Standard.)"

#. from tp:gcc-16.1-b20260222
msgid "Maximum size of global and static variables which can be placed into the small data area."
msgstr "Maximal storlek på globala och statiska variabler som kan placeras i den lilla dataarean."

#. from tp:gcc-16.1-b20260222
msgid "Enable linker relaxation."
msgstr "Aktivera länkaravslappning."

#. from tp:gcc-16.1-b20260222
msgid "Maximum size in bytes of constant values allowed as operands."
msgstr "Maximal storlek i byte på konstanta värden som tillåts som operander."

#. from tp:gcc-16.1-b20260222
msgid "Enables Position-Independent-Data (PID) mode."
msgstr "Aktivera läget för positionsoberoende data (PID)."

#. from tp:gcc-16.1-b20260222
msgid "Warn when multiple, different, fast interrupt handlers are in the compilation unit."
msgstr "Varna när flera olika snabba avbrottshanterare finns i kompileringsenheten."

#. from tp:gcc-16.1-b20260222
msgid "Enable the use of the old, broken, ABI where all stacked function arguments are aligned to 32-bits."
msgstr "Aktivera användning av det gamla trasiga ABI:t, där alla stackade funktionsargument justeras till 32 bitar."

#. from tp:gcc-16.1-b20260222
msgid "Enable the use the standard RX ABI where all stacked function arguments are naturally aligned.  This is the default."
msgstr "Aktivera användning av standard-RX-ABI:t, där alla stackade funktionsargument justeras naturligt.  Detta är standard."

#. from tp:gcc-16.1-b20260222
msgid "Enable the use of the LRA register allocator."
msgstr "Aktivera användningen av LRA-registerallokeraren."

#. from tp:gcc-16.1-b20260222
msgid "Enables or disables the use of the SMOVF, SMOVB, SMOVU, SUNTIL, SWHILE and RMPA instructions.  Enabled by default."
msgstr "Aktiverar eller avaktiverar användningen av instruktionerna SMOVF, SMOVB, SMOVU, SUNTIL, SWHILE och RMPA.  Normalt aktiverat."

#. from tp:gcc-16.1-b20260222
msgid "Always use JSR, never BSR, for calls."
msgstr "Använd alltid JSR, aldrig BSR, för anrop."

#. from tp:gcc-16.1-b20260222
msgid "Case statement label compile time checking when using an expression of an enum type."
msgstr "Kontroller av etiketter i case-satser vid kompileringstillfället när ett uttryck av en enum-typ används."

#. from tp:gcc-16.1-b20260222
msgid "Check definition module procedure parameter names match their implementation module counterpart."
msgstr "Kontrollera att procedurparameternamn för definitionsmoduler stämmer med sina motsvarande implementationsmoduler."

#. from tp:gcc-16.1-b20260222
msgid "Warn if a cast is being used on types of differing sizes."
msgstr "Varna om en typkonvertering används på typer av olika storlek."

#. from tp:gcc-16.1-b20260222
msgid "Inform user which parameters will be passed by reference."
msgstr "Informera användaren om vilka parametrar som kommer skickas som referenser."

#. from tp:gcc-16.1-b20260222
msgid "Semantic checking to catch poor programming style."
msgstr "Semantisk kontroll för att fånga dålig programmeringsstil."

#. from tp:gcc-16.1-b20260222
msgid "Compile time analysis in the first basic block of a procedure detecting access to uninitialized data."
msgstr "Analys vid kompileringstillfället i det första grundblocket i en procedur för att upptäcka åtkomst till oinitierade data."

#. from tp:gcc-16.1-b20260222
msgid "Compile time analysis to detect access to uninitialized variables, the checking can be specified by: known,cond,all."
msgstr "Analys vid kompileringstillfället för att upptäcka åtkomst till oinitierade variabler; kontrollen kan anges med known, cond eller all."

#. from tp:gcc-16.1-b20260222
msgid "Automatically initializes all pointers to NIL."
msgstr "Initierar automatiskt alla pekare till NIL."

#. from tp:gcc-16.1-b20260222
msgid "Runtime subrange, array index and indirection via NIL pointer checking."
msgstr "Kontroll under körtid av delintervall, vektorindex och indirektion via NIL-pekare."

#. from tp:gcc-16.1-b20260222
msgid "Runtime checking to check whether a CASE statement requires an ELSE clause when one was not specified."
msgstr "Körtidskontroller för att kontrollera huruvida en CASE-sats kräver en ELSE-klausul när inte någon var angiven."

#. from tp:gcc-16.1-b20260222
msgid "Preprocess the module using cpp."
msgstr "Preprocessa modulen med cpp."

#. from tp:gcc-16.1-b20260222
msgid "Passed to the preprocessor if -fcpp is used (internal switch)."
msgstr "Skickas till proprocessorn om -fcpp används (intern flagga)."

#. from tp:gcc-16.1-b20260222
msgid "Call a real function, rather than the builtin equivalent."
msgstr "Anropa en verklig funktion i stället för den inbyggda motsvarigheten."

#. from tp:gcc-16.1-b20260222
msgid "Internal debugging of the compiler (internal switch)."
msgstr "Intern felsökning av kompilatorn (intern flagga)."

#. from tp:gcc-16.1-b20260222
msgid "Trace procedure line numbers (internal switch)."
msgstr "Spåra procedurers radnummer (intern flagga)."

#. from tp:gcc-16.1-b20260222
msgid "Recognize the specified suffix as a definition module filename."
msgstr "Känn igen det angivna suffixet som ett definitionsmudulsfilnamn."

#. from tp:gcc-16.1-b20260222
msgid "Display all inbuilt system items."
msgstr "Visa alla inbyggda systemelement."

#. from tp:gcc-16.1-b20260222
msgid "Allows opaque types to be implemented as any type (a GNU Modula-2 extension)."
msgstr "Tillåt ogenomskinliga typer att implementeras som godtycklig typ (en utökning i GNU Modula-2)."

#. from tp:gcc-16.1-b20260222
msgid "Runtime checking to check whether a floating point number will exceed range."
msgstr "Körtidskontroll för att kontrollera huruvida ett flyttal kommer överskrida sitt intervall."

#. from tp:gcc-16.1-b20260222
msgid "Create a topologically sorted module list from all dependent modules used in the application."
msgstr "Skapa en topologiskt sorterad modullista av alla beroende moduler som används i programmet."

#. from tp:gcc-16.1-b20260222
msgid "Range checking for numerical values."
msgstr "Intervallkontroll av numeriska värden."

#. from tp:gcc-16.1-b20260222
msgid "ISO dialect of Modula-2."
msgstr "ISO-dialekt av Modula-2."

#. from tp:gcc-16.1-b20260222
msgid "Specify the library order, the libraries may be specified by a comma separated abbreviation: log,min,pim,iso or by directory names: m2log,m2min,m2pim,m2iso."
msgstr "Ange biblioteksordningen. Biblioteken kan anges med en kommaseparerad förkortning: log,min,pim,iso eller med katalognamn: m2log,m2min,m2pim,m2iso."

#. from tp:gcc-16.1-b20260222
msgid "Set all location values to a specific value (internal switch)."
msgstr "Sätt alla platsvärden till ett specifikt värde (intern flagga)."

#. from tp:gcc-16.1-b20260222
msgid "Internal debug tracing for quad,token,line,all (internal switch)."
msgstr "Intern felsökningsspårning för quad,token,line,all (intern flagga)."

#. from tp:gcc-16.1-b20260222
msgid "Dump Modula-2 internal intemediate representation specified by: all,quad,decl,gimple."
msgstr "Dumpa Modula-2:s interna mellanrepresentation som anges med all,quad,decl,gimple."

#. from tp:gcc-16.1-b20260222
msgid "Dump Modula-2 decls to the filename stem specified."
msgstr "Dumpa Modula-2:s decl:ar till den angivna filnamnsstammen."

#. from tp:gcc-16.1-b20260222
msgid "Dump Modula-2 gimple to the filename stem specified."
msgstr "Dumpa Modula-2:s gimple till den angivna filnamnsstammen."

#. from tp:gcc-16.1-b20260222
msgid "Dump Modula-2 quads to the filename stem specified."
msgstr "Dumpa Modula-2:s quad:ar till den angivna filnamnsstammen."

#. from tp:gcc-16.1-b20260222
msgid "Filter the language dump using a comma separated list of procedures and modules."
msgstr "Filtrera språkdumpen med en kommaseparerad lista över procedurer och moduler."

#. from tp:gcc-16.1-b20260222
msgid "Override the default 64 bit definition of SYSTEM.COFF_T with the argument specified."
msgstr "Ersätt standarddefinitionen av SYSTEM.COFF_T som är 64 bitar med det angivna argumentet."

#. from tp:gcc-16.1-b20260222
msgid "Generate extra nops to improve debugging, producing an instruction for every code related keyword."
msgstr "Generera extra nop:ar för att förbättra felsökningen, vilket ger en instruktion för varje kodrelaterat nyckelord."

#. from tp:gcc-16.1-b20260222
msgid "Generate error messages which render keywords in lower case."
msgstr "Generera felmeddelanden som visar nyckelord i gemener."

#. from tp:gcc-16.1-b20260222
msgid "Specify the module mangled prefix name for all modules in the following include paths."
msgstr "Ange det namnmanglade prefixnamnet för moduler i följande inkluderingssökvägar."

#. from tp:gcc-16.1-b20260222
msgid "Add include paths for all the library names in -flibs= to this directory root."
msgstr "Lägg till inkluderingssökvägar för alla biblioteksnamn i -flibs= till denna katalogrot."

#. from tp:gcc-16.1-b20260222
msgid "Insert plugin to identify runtime errors at compiletime."
msgstr "Infoga insticksmodulen för att identifiera körtidsfel vid kompileringstillfället."

#. from tp:gcc-16.1-b20260222
msgid "Specify the module mangled prefix name."
msgstr "Ange det modulmanglade prefixnamnet."

#. from tp:gcc-16.1-b20260222
msgid "Display statistics about the amount of source lines compiled and symbols used."
msgstr "Visa statistik om antalet kompilerade källkodsrader och använda symboler."

#. from tp:gcc-16.1-b20260222
msgid "Experimental flag to turn on the new strict type checker."
msgstr "Experimentell flagga för att aktivera den nya strikta typkontrollen."

#. from tp:gcc-16.1-b20260222
msgid "Provides more detail why the types are incompatible."
msgstr "Ge mer detaljer om varför typerna är inkompatibla."

#. from tp:gcc-16.1-b20260222
msgid "Compile all implementation modules and program module at once."
msgstr "Kompilera alla implementationsmoduler och programmodulen på en gång."

#. from tp:gcc-16.1-b20260222
msgid "Recognize the specified suffix as implementation and module filenames."
msgstr "Känn igen det angivna suffixet som implementations- och modulfilnamn."

#. from tp:gcc-16.1-b20260222
msgid "Runtime checking to detect accessing data through a NIL value pointer."
msgstr "Körtidskontroll för att upptäcka åtkomst av data via en NIL-värdespekare."

#. from tp:gcc-16.1-b20260222
msgid "PIM [234] dialect of Modula-2."
msgstr "PIM [234]-dialekten av Modula-2."

#. from tp:gcc-16.1-b20260222
msgid "PIM 2 dialect of Modula-2."
msgstr "PIM 2-dialekten av Modula-2."

#. from tp:gcc-16.1-b20260222
msgid "PIM 3 dialect of Modula-2."
msgstr "PIM 3-dialekten av Modula-2."

#. from tp:gcc-16.1-b20260222
msgid "PIM 4 dialect of Modula-2."
msgstr "PIM 4-dialekten av Modula-2."

#. from tp:gcc-16.1-b20260222
msgid "Force positive result from MOD and DIV result floor."
msgstr "Framtvinga positiva resultat från MOD och golvavrundning av DIV-resultat."

#. from tp:gcc-16.1-b20260222
msgid "Link against the pthread library (default on)."
msgstr "Länka mot biblioteket pthread (standard på)."

#. from tp:gcc-16.1-b20260222
msgid "Internal compiler debugging information, dump the list of quadruples."
msgstr "Intern information för kompilatorfelsökning, dumpa listan av kvadrupler."

#. from tp:gcc-16.1-b20260222
msgid "Runtime range checking for numerical values."
msgstr "Körtidkontrol av intervall för numeriska värden."

#. from tp:gcc-16.1-b20260222
msgid "Runtime checking for functions which finish without executing a RETURN statement."
msgstr "Körtidskontroll av funktioner som avslutas utan att utföra en RETURN-sats."

#. from tp:gcc-16.1-b20260222
msgid "Specify the list of runtime modules and their initialization order."
msgstr "Ange listan av körtidsmoduler och deras initieringsordning."

#. from tp:gcc-16.1-b20260222
msgid "Modules are initialized dynamically, determined by M2RTS and application dependencies."
msgstr "Moduler initieras dynamiskt, vilket bestäms av M2RTS och programberoenden."

#. from tp:gcc-16.1-b20260222
msgid "Generate a C source scaffold for the current module being compiled."
msgstr "Generera en C-kodsställning för den aktuella modulen som kompileras."

#. from tp:gcc-16.1-b20260222
msgid "Generate a C++ source scaffold for the current module being compiled."
msgstr "Generera en C++-kodställingsinitiering och -avslutning för varje modul inuti main."

#. from tp:gcc-16.1-b20260222
msgid "Generate the main function."
msgstr "Generera huvudfunktionen."

#. from tp:gcc-16.1-b20260222
msgid "Generate static scaffold initialization and finalization for every module inside main."
msgstr "Generera statisk ställningsinitiering och avslutning för varje modul inuti main."

#. from tp:gcc-16.1-b20260222
msgid "Generate a shared library from the module."
msgstr "Generera ett delat bibliotek av modulen."

#. from tp:gcc-16.1-b20260222
msgid "All software runtime checking (an abbreviation for -fnil -frange -findex -fwholediv -fcase -freturn -fwholevalue -ffloatvalue)."
msgstr "All kontroll i programvara vid körtid (en förkortning av -fnil -frange -findex -fwholediv -fcase -freturn -fwholevalue -ffloatvalue)."

#. from tp:gcc-16.1-b20260222
msgid "Display the location of module source files as they are compiled."
msgstr "Visa platsen för modulkällkodsfiler allteftersom de kompileras."

#. from tp:gcc-16.1-b20260222
msgid "Create a swig interface file for the module."
msgstr "Skapa en swig-gränssnittsfil för modulen."

#. from tp:gcc-16.1-b20260222
msgid "Optimize non var unbounded parameters by passing it by reference, providing it is not written to within the callee procedure."
msgstr "Optimera icke-var obegränsade parametrar genom att skicka dem via referens, förutsatt att den inte skrivs till i den anropade proceduren.."

#. from tp:gcc-16.1-b20260222
msgid "Order the initialization/finalizations for scaffold-static or force linking of modules if scaffold-dynamic."
msgstr "Ordna initieringarna/finaliseringarna för scaffold-static eller tvinga fram länkning av moduler för scaffold-dynamic."

#. from tp:gcc-16.1-b20260222
msgid "Link against the module M2WIDESET to perform the wideset operator, the negative version of this option will generate a warning if this module is required."
msgstr "Länka mot modulen M2WIDESET för att utföra operatorn wideset, den negativa versionen av denna flagga genererar en varning om denna modul krävs."

#. from tp:gcc-16.1-b20260222
msgid "Runtime checking of all division and modulus by zero checking for ordinal values."
msgstr "Körtidskontroll av division och modulus med noll för ordinalvärden."

#. from tp:gcc-16.1-b20260222
msgid "Runtime checking for whole numbers."
msgstr "Körtidskontroll för heltal."

#. from tp:gcc-16.1-b20260222
msgid "Link the standard Modula-2 libraries statically in the compilation."
msgstr "Länka standardbiblioteken för Modula-2 statiskt vid kompilering."

#. from tp:gcc-16.1-b20260222
msgid "save temporary preprocessed files."
msgstr "Spara temporära preprocessade filer."

#. from tp:gcc-16.1-b20260222
msgid "-J<directory>	Put MODULE files in 'directory'."
msgstr "-J<katalog>	Lägg MODULE-filer i ”katalog”."

#. from tp:gcc-16.1-b20260222
msgid "Warn about possible aliasing of dummy arguments."
msgstr "Varna för möjlig aliasering av dummyargument."

#. from tp:gcc-16.1-b20260222
msgid "Warn about alignment of COMMON blocks."
msgstr "Varna för justering av COMMON-block."

#. from tp:gcc-16.1-b20260222
msgid "Warn about missing ampersand in continued character constants."
msgstr "Varna för saknade et-tecken i fortsatta teckenkonstanter."

#. from tp:gcc-16.1-b20260222
msgid "Warn about creation of array temporaries."
msgstr "Varna om vektortemporärer skapas."

#. from tp:gcc-16.1-b20260222
msgid "Warn if the type of a variable might be not interoperable with C."
msgstr "Varna om typen på en variabel kanske inte är interoperabel med C."

#. from tp:gcc-16.1-b20260222
msgid "Warn about truncated character expressions."
msgstr "Varna för avhuggna teckenuttryck."

#. from tp:gcc-16.1-b20260222
msgid "Warn about equality comparisons involving REAL or COMPLEX expressions."
msgstr "Varna för likhetsjämförelser som involverar REAL- eller COMPLEX-uttryck."

#. from tp:gcc-16.1-b20260222
msgid "Warn about most implicit conversions."
msgstr "Varna för de flesta implicita konverteringar."

#. from tp:gcc-16.1-b20260222
msgid "Warn about possibly incorrect subscripts in do loops."
msgstr "Varna för eventuellt felaktiga index i do-slingor."

#. from tp:gcc-16.1-b20260222
msgid "Warn when arguments of external procedures do not match."
msgstr "Varna när argument till externa procedurer inte stämmer."

#. from tp:gcc-16.1-b20260222
msgid "Warn if loops have been interchanged."
msgstr "Varna om slingor har bytt plats."

#. from tp:gcc-16.1-b20260222
msgid "Warn about function call elimination."
msgstr "Varna för eliminering av funktionsanrop."

#. from tp:gcc-16.1-b20260222
msgid "Warn about calls with implicit interface."
msgstr "Varna för anrop med implicit gränssnitt."

#. from tp:gcc-16.1-b20260222
msgid "Warn about called procedures not explicitly declared."
msgstr "Varna för anrop av procedurer som inte explicit deklarerats."

#. from tp:gcc-16.1-b20260222
msgid "Warn about constant integer divisions with truncated results."
msgstr "Varna för konstant heltalsdivision med avhuggna resultat."

#. from tp:gcc-16.1-b20260222
msgid "Warn about truncated source lines."
msgstr "Varna för avhuggna källkodsrader."

#. from tp:gcc-16.1-b20260222
msgid "Warn on intrinsics not part of the selected standard."
msgstr "Varna för inbyggda som inte är med i den valda standarden."

#. from tp:gcc-16.1-b20260222
msgid "Warn about USE statements that have no ONLY qualifier."
msgstr "Varna för USE-satser som inte har någon ONLY-kvalificerare."

#. from tp:gcc-16.1-b20260222
msgid "Warn that -fno-automatic may break recursion."
msgstr "Varna för att -fno-automatic kan bryta rekursion."

#. from tp:gcc-16.1-b20260222
msgid "Warn about real-literal-constants with 'q' exponent-letter."
msgstr "Varna för reella litterala konstanter med exponentbokstav ”q”."

#. from tp:gcc-16.1-b20260222
msgid "Warn when a left-hand-side array variable is reallocated."
msgstr "Varna när en vektorvariabel på vänsterhandssidan allokeras om."

#. from tp:gcc-16.1-b20260222
msgid "Warn when a left-hand-side variable is reallocated."
msgstr "Varna när en variabel på vänsterhandssidan allokeras om."

#. from tp:gcc-16.1-b20260222
msgid "Warn if the pointer in a pointer assignment might outlive its target."
msgstr "Varna om pekaren i en pekartilldelning kan överleva sitt mål."

#. from tp:gcc-16.1-b20260222
msgid "Warn about \"suspicious\" constructs."
msgstr "Varna för ”misstänkta” konstruktioner."

#. from tp:gcc-16.1-b20260222
msgid "Permit nonconforming uses of the tab character."
msgstr "Tillåt icke-konforma användningar av tabulatortecken."

#. from tp:gcc-16.1-b20260222
msgid "Warn about an invalid DO loop."
msgstr "Varna för en felaktig DO-slinga."

#. from tp:gcc-16.1-b20260222
msgid "Warn about underflow of numerical constant expressions."
msgstr "Varna för underspill i numeriska konstanta uttryck."

#. from tp:gcc-16.1-b20260222
msgid "Warn if a user-procedure has the same name as an intrinsic."
msgstr "Varna om en användarprocedur har samma namn som en inbyggd."

#. from tp:gcc-16.1-b20260222
msgid "Warn about unused dummy arguments."
msgstr "Varna för oanvända dummyargument."

#. from tp:gcc-16.1-b20260222
msgid "Warn about zero-trip DO loops."
msgstr "Varna för DO-slingor med nolliterationer."

#. from tp:gcc-16.1-b20260222
msgid "Enable preprocessing."
msgstr "Aktivera preprocessning."

#. from tp:gcc-16.1-b20260222
msgid "Disable preprocessing."
msgstr "Avaktivera preprocessning."

#. from tp:gcc-16.1-b20260222
msgid "Accept argument mismatches in procedure calls."
msgstr "Acceptera argument som inte stämmer överens i proceduranrop."

#. from tp:gcc-16.1-b20260222
msgid "Eliminate multiple function invocations also for impure functions."
msgstr "Eliminera multipla funktionsanrop även för orena funktioner."

#. from tp:gcc-16.1-b20260222
msgid "Enable alignment of COMMON blocks."
msgstr "Aktivera justering av COMMON-block."

#. from tp:gcc-16.1-b20260222
msgid "All intrinsics procedures are available regardless of selected standard."
msgstr "Alla inbyggda procedurer är tillgängliga oavsett vald standard."

#. from tp:gcc-16.1-b20260222
msgid "Allow a BOZ literal constant to appear in an invalid context and with X instead of Z."
msgstr "Tillåt en BOZ-litteralkonstant i en ogiltig kontext och med X i stället för Z."

#. from tp:gcc-16.1-b20260222
msgid "Do not treat local variables and COMMON blocks as if they were named in SAVE statements."
msgstr "Behandla inte lokala variabler och COMMON-block som om de vore namngivna i SAVE-satser."

#. from tp:gcc-16.1-b20260222
msgid "Specify that backslash in string introduces an escape character."
msgstr "Ange att omvänt snedstreck i strängar inleder ett specialtecken."

#. from tp:gcc-16.1-b20260222
msgid "Produce a backtrace when a runtime error is encountered."
msgstr "Skapa en stackspårning när ett fel inträffar under körning."

#. from tp:gcc-16.1-b20260222
msgid "-fblas-matmul-limit=<n>	Size of the smallest matrix for which matmul will use BLAS."
msgstr "-fblas-matmul-limit=<n>	Storlek på den minsta matris för vilken matmul kommer använda BLAS."

#. from tp:gcc-16.1-b20260222
msgid "Produce a warning at runtime if a array temporary has been created for a procedure argument."
msgstr "Skapa en varning vid körtid om en fälttemporär har skapats för ett procedurargument."

#. from tp:gcc-16.1-b20260222
msgid "-fconvert=<big-endian|little-endian|native|swap|r16_ieee|r16_ibm>	The endianness used for unformatted files."
msgstr "-fconvert=<big-endian|little-endian|native|swap|r16_ieee|r16_ibm>	Byteordningen som används för oformaterade filer."

#. from tp:gcc-16.1-b20260222
msgid "Use the Cray Pointer extension."
msgstr "Använd Cray-pekarutökningen."

#. from tp:gcc-16.1-b20260222
msgid "Generate C prototypes from BIND(C) declarations."
msgstr "Generera C-prototyper från BIND(C)-deklarationer."

#. from tp:gcc-16.1-b20260222
msgid "Generate C prototypes from non-BIND(C) external procedure definitions."
msgstr "Generera C-prototyper från externa procedurdeklarationer som inte är BIND(C)."

#. from tp:gcc-16.1-b20260222
msgid "Ignore 'D' in column one in fixed form."
msgstr "Ignorera ”D” i kolumn ett i fast format."

#. from tp:gcc-16.1-b20260222
msgid "Treat lines with 'D' in column one as comments."
msgstr "Tolka rader med ”D” i kolumn ett som kommentarer."

#. from tp:gcc-16.1-b20260222
msgid "Issue debug information for compiler-generated auxiliary variables."
msgstr "Mata ut felsökningsinformation för kompilatorgenererade extravariabler."

#. from tp:gcc-16.1-b20260222
msgid "Enable all DEC language extensions."
msgstr "Aktivera språkutvidgningar från DEC."

#. from tp:gcc-16.1-b20260222
msgid "Enable the use of blank format items in format strings."
msgstr "Aktivera användningen av blanka formatelement i formatsträngar."

#. from tp:gcc-16.1-b20260222
msgid "Enable the use of character literals in assignments and data statements for non-character variables."
msgstr "Aktivera användningen av teckenlitteraler i tilldelningar och datasatser för icke-teckenvariabler."

#. from tp:gcc-16.1-b20260222
msgid "Enable legacy parsing of INCLUDE as statement."
msgstr "Aktivera gammaldags tolkning av INCLUDE som en sats."

#. from tp:gcc-16.1-b20260222
msgid "Enable default widths for i, f and g format specifiers."
msgstr "Aktivera standardbredder för i-, f- och g-formatspecificerarna."

#. from tp:gcc-16.1-b20260222
msgid "Enable kind-specific variants of integer intrinsic functions."
msgstr "Aktivera sortspecifika varianter av inbyggda heltalsfunktioner."

#. from tp:gcc-16.1-b20260222
msgid "Enable legacy math intrinsics for compatibility."
msgstr "Aktivera gamla inbyggda matematikfunktioner för kompatibilitet."

#. from tp:gcc-16.1-b20260222
msgid "Enable support for DEC STRUCTURE/RECORD."
msgstr "Aktivera stöd för DEC STRUCTURE/RECORD."

#. from tp:gcc-16.1-b20260222
msgid "Enable DEC-style STATIC and AUTOMATIC attributes."
msgstr "Aktivera STATIC- och AUTOMATIC-attribut i DEC-stil."

#. from tp:gcc-16.1-b20260222
msgid "Set the default double precision kind to an 8 byte wide type."
msgstr "Ange standardtypen för dubbel precision till en 8 byte bred typ."

#. from tp:gcc-16.1-b20260222
msgid "Set the default integer kind to an 8 byte wide type."
msgstr "Ange standardtypen för heltal till en 8 byte bred typ."

#. from tp:gcc-16.1-b20260222
msgid "Set the default real kind to an 8 byte wide type."
msgstr "Ange standardtypen för reella tal till en 8 byte bred typ."

#. from tp:gcc-16.1-b20260222
msgid "Set the default real kind to an 10 byte wide type."
msgstr "Ange standardtypen för reella tal till en 10 byte bred typ."

#. from tp:gcc-16.1-b20260222
msgid "Set the default real kind to an 16 byte wide type."
msgstr "Ange standardtypen för reella tal till en 16 byte bred typ."

#. from tp:gcc-16.1-b20260222
msgid "Allow dollar signs in entity names."
msgstr "Tillåt dollartecken i entitetsnamn."

#. from tp:gcc-16.1-b20260222
msgid "Display the code tree after parsing."
msgstr "Visa kodträdet efter tolkning."

#. from tp:gcc-16.1-b20260222
msgid "Display the code tree after front end optimization."
msgstr "Visa kodträdet efter framändesoptimering."

#. from tp:gcc-16.1-b20260222
msgid "Display the global symbol table after parsing."
msgstr "Visa den globala symboltabellen efter tolkning."

#. from tp:gcc-16.1-b20260222
msgid "Display the code tree after parsing; deprecated option."
msgstr "Visa kodträdet efter tolkning; flaggan är föråldrad."

#. from tp:gcc-16.1-b20260222
msgid "Specify that an external BLAS library should be used for matmul calls on large-size arrays."
msgstr "Ange att ett externt BLAS-bibliotek skall användas för matmul-anrop på större vektorer."

#. from tp:gcc-16.1-b20260222
msgid "Use an external BLAS library with 64-bit indexing for matmul on large-size arrays."
msgstr "Använd ett externt BLAS-bibliotek med 64-bitars inderxering för matmul-anrop på stora vektorer."

#. from tp:gcc-16.1-b20260222
msgid "Use f2c calling convention."
msgstr "Använd f2c:s anropskonvention."

#. from tp:gcc-16.1-b20260222
msgid "Assume that the source file is fixed form."
msgstr "Anta att källkodsfilen är i fast format."

#. from tp:gcc-16.1-b20260222
msgid "Force creation of temporary to test infrequently-executed forall code."
msgstr "Tvinga fram att temporärer skapas för att testa sällan körd forall-kod."

#. from tp:gcc-16.1-b20260222
msgid "Interpret any INTEGER(4) as an INTEGER(8)."
msgstr "Tolka varje INTEGER(4) som en INTEGER(8)."

#. from tp:gcc-16.1-b20260222
msgid "Specify where to find the compiled intrinsic modules."
msgstr "Ange var de kompilerade inbyggda modulerna finns."

#. from tp:gcc-16.1-b20260222
msgid "Allow arbitrary character line width in fixed mode."
msgstr "Tillåt radlängd med godtyckligt antal tecken i fast läge."

#. from tp:gcc-16.1-b20260222
msgid "-ffixed-line-length-<n>	Use n as character line width in fixed mode."
msgstr "-ffixed-line-length-<n>	Använd radlängd med n tecken i fast läge."

#. from tp:gcc-16.1-b20260222
msgid "Pad shorter fixed form lines to line width with spaces."
msgstr "Fyll ut kortare rader av fast form till radbredden med blanktecken."

#. from tp:gcc-16.1-b20260222
msgid "-ffpe-trap=[...]	Stop on following floating point exceptions."
msgstr "-ffpe-trap=[…]	Stanna vid följande flyttalsundantag."

#. from tp:gcc-16.1-b20260222
msgid "-ffpe-summary=[...]	Print summary of floating point exceptions."
msgstr "-ffpe-summary=[…]	Skriv ut en sammanfattning av flyttalsundantag."

#. from tp:gcc-16.1-b20260222
msgid "Assume that the source file is free form."
msgstr "Anta att källkodsfilen är i fritt format."

#. from tp:gcc-16.1-b20260222
msgid "Allow arbitrary character line width in free mode."
msgstr "Tillåt radlängd med godtyckligt antal tecken i fri form."

#. from tp:gcc-16.1-b20260222
msgid "-ffree-line-length-<n>	Use n as character line width in free mode."
msgstr "-ffree-line-length-<n>	Använd radlängd med n tecken i fri form."

#. from tp:gcc-16.1-b20260222
msgid "Try to interchange loops if profitable."
msgstr "Försök att byta plats på slingor om det lönar sig."

#. from tp:gcc-16.1-b20260222
msgid "Enable front end optimization."
msgstr "Aktivera framändesoptimeringar."

#. from tp:gcc-16.1-b20260222
msgid "Specify that no implicit typing is allowed, unless overridden by explicit IMPLICIT statements."
msgstr "Ange att ingen implicit typning är tillåten, om inte detta åsidosätts med uttryckliga IMPLICIT-satser."

#. from tp:gcc-16.1-b20260222
msgid "-finit-character=<n>	Initialize local character variables to ASCII value n."
msgstr "-finit-character=<n>	Initiera lokala teckenvariabler med ASCII-värde n."

#. from tp:gcc-16.1-b20260222
msgid "Initialize components of derived type variables according to other init flags."
msgstr "Initiera komponenter av härledda typvariabler i enlighet med andra init-flaggor."

#. from tp:gcc-16.1-b20260222
msgid "-finit-integer=<n>	Initialize local integer variables to n."
msgstr "-finit-integer=<n>	Initiera lokala heltalsvariabler med n."

#. from tp:gcc-16.1-b20260222
msgid "Initialize local variables to zero (from g77)."
msgstr "Initiera lokala variabler med noll (från g77)."

#. from tp:gcc-16.1-b20260222
msgid "-finit-logical=<true|false>	Initialize local logical variables."
msgstr "-finit-logical=<true|false>	Initiera lokala logiska variabler."

#. from tp:gcc-16.1-b20260222
msgid "-finit-real=<zero|snan|nan|inf|-inf>	Initialize local real variables."
msgstr "-finit-real=<zero|snan|nan|inf|-inf>	Initiera lokala reella variabler."

#. from tp:gcc-16.1-b20260222
msgid "-finline-arg-packing	Perform argument packing inline."
msgstr "-finline-arg-packing\tUtför argumentpackning inline."

#. from tp:gcc-16.1-b20260222
msgid "Enable generation of inline code instead of calls to functions from the library to implement intrinsics."
msgstr "Aktivera generering av inline-kod i stället för anrop av biblioteksfunktioner för att implementera inbyggda funktioner."

#. from tp:gcc-16.1-b20260222
msgid "-finline-matmul-limit=<n>	Specify the size of the largest matrix for which matmul will be inlined."
msgstr "-finline-matmul-limit=<n>\tAnge storleken på den största matris för vilken matmul infogas inline."

#. from tp:gcc-16.1-b20260222
msgid "-fmax-array-constructor=<n>	Maximum number of objects in an array constructor."
msgstr "-fmax-array-constructor=<n>	Maximalt antal objekt i en vektorkonstruerare."

#. from tp:gcc-16.1-b20260222
msgid "-fmax-identifier-length=<n>	Maximum identifier length."
msgstr "-fmax-identifier-length=<n>	Maximal identifierarlängd."

#. from tp:gcc-16.1-b20260222
msgid "-fmax-subrecord-length=<n>	Maximum length for subrecords."
msgstr "-fmax-subrecord-length=<n>	Maximal längd för underposter."

#. from tp:gcc-16.1-b20260222
msgid "-fmax-stack-var-size=<n>	Size in bytes of the largest array that will be put on the stack."
msgstr "-fmax-stack-var-size=<n>	Storlek i byte på den största vektorn som läggs på stacken."

#. from tp:gcc-16.1-b20260222
msgid "Put all local arrays on stack."
msgstr "Lägg alla lokala vektorer på stacken."

#. from tp:gcc-16.1-b20260222
msgid "Set default accessibility of module entities to PRIVATE."
msgstr "Sätt modulentiteternas standardtillgänglighet till PRIVATE."

#. from tp:gcc-16.1-b20260222
msgid "Handle OpenMP allocators for allocatables and pointers."
msgstr "Hantera OpenMP-allokerare för allokerbara och pekare."

#. from tp:gcc-16.1-b20260222
msgid "Try to lay out derived types as compactly as possible."
msgstr "Försök placera ut härledda typer så kompakt som möjligt."

#. from tp:gcc-16.1-b20260222
msgid "Protect parentheses in expressions."
msgstr "Skydda parenteser i uttryck."

#. from tp:gcc-16.1-b20260222
msgid "Path to header file that should be pre-included before each compilation unit."
msgstr "Sökväg till huvudfil som skall för-inkluderas före varje kompileringsenhet."

#. from tp:gcc-16.1-b20260222
msgid "Enable range checking during compilation."
msgstr "Aktivera intervallkontroller under kompilering."

#. from tp:gcc-16.1-b20260222
msgid "Interpret any REAL(4) as a REAL(8)."
msgstr "Tolka en REAL(4) som en REAL(8)."

#. from tp:gcc-16.1-b20260222
msgid "Interpret any REAL(4) as a REAL(10)."
msgstr "Tolka en REAL(4) som en REAL(10)."

#. from tp:gcc-16.1-b20260222
msgid "Interpret any REAL(4) as a REAL(16)."
msgstr "Tolka en REAL(4) som en REAL(16)."

#. from tp:gcc-16.1-b20260222
msgid "Interpret any REAL(8) as a REAL(4)."
msgstr "Tolka en REAL(8) som en REAL(4)."

#. from tp:gcc-16.1-b20260222
msgid "Interpret any REAL(8) as a REAL(10)."
msgstr "Tolka en REAL(8) som en REAL(10)."

#. from tp:gcc-16.1-b20260222
msgid "Interpret any REAL(8) as a REAL(16)."
msgstr "Tolka en REAL(8) som en REAL(16)."

#. from tp:gcc-16.1-b20260222
msgid "Reallocate the LHS in assignments."
msgstr "Omallokera vänsterhandssidan i tilldelningar."

#. from tp:gcc-16.1-b20260222
msgid "Use a 4-byte record marker for unformatted files."
msgstr "Använd en 4-bytepostmarkering för oformaterade filer."

#. from tp:gcc-16.1-b20260222
msgid "Use an 8-byte record marker for unformatted files."
msgstr "Använd en 8-bytepostmarkering för oformaterade filer."

#. from tp:gcc-16.1-b20260222
msgid "Allocate local variables on the stack to allow indirect recursion."
msgstr "Allokera lokala variabler på stacken för att möjliggöra indirekt rekursion."

#. from tp:gcc-16.1-b20260222
msgid "Copy array sections into a contiguous block on procedure entry."
msgstr "Kopiera vektorsektioner till sammanhängande block vid procedurstart."

#. from tp:gcc-16.1-b20260222
msgid "Experimental unsigned numbers."
msgstr "Experimentella teckenlösa tal."

#. from tp:gcc-16.1-b20260222
msgid "-fcoarray=<none|single|lib>	Specify which coarray parallelization should be used."
msgstr "-fcoarray=<none|single|lib>\tAnge vilken coarray-parallellisering som ska användas."

#. from tp:gcc-16.1-b20260222
msgid "-fcheck=[...]	Specify which runtime checks are to be performed."
msgstr "-fcheck=[...]	Ange vilka körtidskontroller som skall utföras."

#. from tp:gcc-16.1-b20260222
msgid "Append a second underscore if the name already contains an underscore."
msgstr "Lägg till ett andra understrykningstecken om namnet redan innehåller ett understrykningstecken."

#. from tp:gcc-16.1-b20260222
msgid "Apply negative sign to zero values."
msgstr "Använd negativt tecken på nollvärden."

#. from tp:gcc-16.1-b20260222
msgid "Disallow tail call optimization when a calling routine may have omitted character lengths."
msgstr "Tillåt inte svansanropsoptimering när en anropande rutin kan ha utelämnat teckenlängder."

#. from tp:gcc-16.1-b20260222
msgid "Append underscores to externally visible names."
msgstr "Lägg till understrykningstecken till externt synliga namn."

#. from tp:gcc-16.1-b20260222
msgid "Statically link the GNU Fortran helper library (libgfortran)."
msgstr "Länka statiskt till GNU:s Fortran-hjälpbibliotek (libgfortran)."

#. from tp:gcc-16.1-b20260222
msgid "Statically link the GCC Quad-Precision Math Library (libquadmath)."
msgstr "Länka statiskt till GCC:s matematikbibliotek för fyrdubbel precision (libquadmath)."

#. from tp:gcc-16.1-b20260222
msgid "Conform to the ISO Fortran 2003 standard."
msgstr "Följ standarden ISO Fortran 2003."

#. from tp:gcc-16.1-b20260222
msgid "Conform to the ISO Fortran 2008 standard."
msgstr "Följ standarden ISO Fortran 2008."

#. from tp:gcc-16.1-b20260222
msgid "Conform to the ISO Fortran 2008 standard including TS 29113."
msgstr "Följ standarden ISO Fortran 2008 inklusive TS 29113."

#. from tp:gcc-16.1-b20260222
msgid "Conform to the ISO Fortran 2018 standard."
msgstr "Följ standarden ISO Fortran 2018."

#. from tp:gcc-16.1-b20260222
msgid "Conform to the ISO Fortran 2023 standard."
msgstr "Följ standarden ISO Fortran 2023."

#. from tp:gcc-16.1-b20260222
msgid "Enable experimental Fortran 202y features."
msgstr "Aktivera experimentella funktioner i Fortran 202y."

#. from tp:gcc-16.1-b20260222
msgid "Conform to the ISO Fortran 95 standard."
msgstr "Följ standarden ISO Fortran 95."

#. from tp:gcc-16.1-b20260222
msgid "Conform to nothing in particular."
msgstr "Följ inget särskilt."

#. from tp:gcc-16.1-b20260222
msgid "Accept extensions to support legacy code."
msgstr "Acceptera utökningar för att stödja gammal kod."

#. from tp:gcc-16.1-b20260222
msgid "-fgo-c-header=<file>	Write Go struct definitions to file as C code."
msgstr "-fgo-c-header=<filnamn>\tSkriv Go-strukturdefinitioner till en fil som C-kod."

#. from tp:gcc-16.1-b20260222
msgid "Add explicit checks for division by zero."
msgstr "Lägg till explicita kontroller av division med noll."

#. from tp:gcc-16.1-b20260222
msgid "Add explicit checks for division overflow in INT_MIN / -1."
msgstr "Lägg till explicita kontroller av divisionsöverspill i INT_MIN / -1."

#. from tp:gcc-16.1-b20260222
msgid "Apply special rules for compiling runtime package."
msgstr "Använd specialregler för att kompilera körtidspaket."

#. from tp:gcc-16.1-b20260222
msgid "-fgo-dump-<type>	Dump Go frontend internal information."
msgstr "-fgo-dump-<typ>	Skriv ut Go-framändens interna information."

#. from tp:gcc-16.1-b20260222
msgid "-fgo-embedcfg=<file>	List embedded files via go:embed."
msgstr "-fgo-embedcfg=<fil>	Lista inbäddade filer via go:embed."

#. from tp:gcc-16.1-b20260222
msgid "-fgo-importcfg=<file>	Provide file that tells where to find imports."
msgstr "-fgo-importcfg=<fil>\tAnge en fil som visar var importer finns."

#. from tp:gcc-16.1-b20260222
msgid "-fgo-optimize-<type>	Turn on optimization passes in the frontend."
msgstr "-fgo-optimize-<typ>	Slå på optimeringspass i framänden."

#. from tp:gcc-16.1-b20260222
msgid "-fgo-pkgpath=<string>	Set Go package path."
msgstr "-fgo-pkgpath=<sträng>\tAnge Go-paketsökväg."

#. from tp:gcc-16.1-b20260222
msgid "-fgo-prefix=<string>	Set package-specific prefix for exported Go names."
msgstr "-fgo-prefix=<sträng>\tAnge ett paketspecifikt prefix för exporterade Go-namn."

#. from tp:gcc-16.1-b20260222
msgid "-fgo-relative-import-path=<path>	Treat a relative import as relative to path."
msgstr "-fgo-relative-import-path=<sökväg>\tHantera en relativ import som relativ till sökvägen."

#. from tp:gcc-16.1-b20260222
msgid "Functions which return values must end with return statements."
msgstr "Funktioner med returvärden måste sluta med retursatser."

#. from tp:gcc-16.1-b20260222
msgid "Emit debugging information related to the escape analysis pass when run with -fgo-optimize-allocs."
msgstr "Mata ut felsökningsinformation relaterad till flyktanalyspasset när det körs med -fgo-optimize-allocs."

#. from tp:gcc-16.1-b20260222
msgid "-fgo-debug-escape-hash=<string>	Hash value to debug escape analysis."
msgstr "-fgo-debug-escape-hash=<sträng>	Hashvärde för att felsöka flyktanalys."

#. from tp:gcc-16.1-b20260222
msgid "Emit optimization diagnostics."
msgstr "Skriv ut optimeringsmeddelanden."

#. from tp:gcc-16.1-b20260222
msgid "Loops iterating at least selected number of iterations get loop alignment."
msgstr "Slingor som itererar åtminstone det valda antalet gånger får slingjustering."

#. from tp:gcc-16.1-b20260222
msgid "Select fraction of the maximal frequency of executions of basic block in function given basic block get alignment."
msgstr "Välj den andel av den maximala exekveringsfrekvensen för ett grundblock i en funktion som ett visst grundblock måste uppnå för att få justering."

#. from tp:gcc-16.1-b20260222
msgid "Enable asan globals protection."
msgstr "Aktivera globalt asan-skydd."

#. from tp:gcc-16.1-b20260222
msgid "Enable asan allocas/VLAs protection."
msgstr "Aktivera asan-skydd av alloca:n/VLA:er."

#. from tp:gcc-16.1-b20260222
msgid "Enable asan load operations protection."
msgstr "Aktivera asan-skydd av laddningsoperationer."

#. from tp:gcc-16.1-b20260222
msgid "Enable asan store operations protection."
msgstr "Aktivera asan-skydd av lagringsoperationer."

#. from tp:gcc-16.1-b20260222
msgid "Use callbacks instead of inline code if number of accesses in function becomes greater or equal to this number."
msgstr "Använd återanrop i stället för inline-kod om antalet åtkomster i en funktion blir större än eller lika med detta tal."

#. from tp:gcc-16.1-b20260222
msgid "Prefix calls to memcpy, memset and memmove with __asan_ or __hwasan_ for -fsanitize=kernel-address or -fsanitize=kernel-hwaddress."
msgstr "Prefixa anrop av memcpy, memset och memmove med __asan_ ller __hwasan_ för -fsanitize=kernel-address eller -fsanitize=kernel-hwaddress."

#. from tp:gcc-16.1-b20260222
msgid "Enable asan builtin functions protection."
msgstr "Aktivera asan-skydd av inbyggda funktioner."

#. from tp:gcc-16.1-b20260222
msgid "Enable asan stack protection."
msgstr "Aktivera asan-skydd av stack."

#. from tp:gcc-16.1-b20260222
msgid "Enable asan detection of use-after-return bugs."
msgstr "Aktivera asan-detektering av använd-efter-retur-fel."

#. from tp:gcc-16.1-b20260222
msgid "Build basic block profile using auto profile."
msgstr "Bygg grundblocksprofil med autoprofil."

#. from tp:gcc-16.1-b20260222
msgid "Enable only function reordering with auto-profile."
msgstr "Aktivera endast omflyttning av funktioner med auto-profil."

#. from tp:gcc-16.1-b20260222
msgid "Whether the scheduling description is mostly a cycle-accurate model of the target processor and is likely to be spill aggressively to fill any pipeline bubbles."
msgstr "Huruvida schemaläggningsbeskrivningen är huvudsakligen en modell med cykelnoggrannhet av målprocessorn och troligen kommer att spilla över aggressivt för att fylla eventuella pipeline-bubblor."

#. from tp:gcc-16.1-b20260222
msgid "Enable hwasan instrumentation of statically-sized stack-allocated variables."
msgstr "Aktivera hwasan-instrumentering av stackallokerade variabler med statisk storlek."

#. from tp:gcc-16.1-b20260222
msgid "Use random base tag for each frame, as opposed to base always zero."
msgstr "Använd en slumpmässig bastagg för varje ram i stället för att alltid använda noll som bas."

#. from tp:gcc-16.1-b20260222
msgid "Enable hwasan instrumentation of allocas/VLAs."
msgstr "Aktivera hwasan-instrumentering av alloca:n/VLA:er."

#. from tp:gcc-16.1-b20260222
msgid "Enable hwasan instrumentation of load operations."
msgstr "Aktivera hwasan-instrumentering av laddoperationer."

#. from tp:gcc-16.1-b20260222
msgid "Enable hwasan instrumentation of store operations."
msgstr "Aktivera hwasan-instrumentering av lagringsoperationer."

#. from tp:gcc-16.1-b20260222
msgid "Enable hwasan instrumentation of builtin functions."
msgstr "Aktivera hwasan-instrumentering av inbyggda funktioner."

#. from tp:gcc-16.1-b20260222
msgid "When sanitizing using MTE instructions, add checks for all stack allocas."
msgstr "Vid sanering med MTE-instruktioner, lägg till kontroller för alla stack-alloca:n."

#. from tp:gcc-16.1-b20260222
msgid "When sanitizing using MTE instructions, include builtin functions."
msgstr "Vid sanering med MTE-instruktioner, inkludera inbyggda funktioner."

#. from tp:gcc-16.1-b20260222
msgid "Average number of iterations of a loop."
msgstr "Genomsnittligt antal iterationer per slinga."

#. from tp:gcc-16.1-b20260222
msgid "Maximum number of bits for which we avoid creating FMAs."
msgstr "Maximalt antal bitar för vilka vi undviker att skapa FMA:er."

#. from tp:gcc-16.1-b20260222
msgid "Set the estimated probability in percentage for builtin expect. The default value is 90% probability."
msgstr "Ange den uppskattade sannolikheten i procent för den inbyggda expect.  Standardvärdet är 90 % sannolikhet."

#. from tp:gcc-16.1-b20260222
msgid "The maximum length of a constant string for a builtin string comparison call eligible for inlining. The default value is 3."
msgstr "Den maximala längden på en konstant sträng för att ett inbyggt strängjämförelseanrop ska kunna infogas inline. Standardvärdet är 3."

#. from tp:gcc-16.1-b20260222
msgid "The smallest number of different values for which it is best to use a jump-table instead of a tree of conditional branches.  If 0, use the default for the machine."
msgstr "Det minsta antalet olika värden för vilka det är bäst att använda hopptabeller istället för ett träd med villkorliga grenar- Om 0, använd standardvärdet för maskinen."

#. from tp:gcc-16.1-b20260222
msgid "Probability that COMDAT function is shared with a different compilation unit."
msgstr "Sannolikheten att COMDAT-funktionen delas med en annan kompileringsenhet."

#. from tp:gcc-16.1-b20260222
msgid "Maximum number of namespaces to search for alternatives when name lookup fails."
msgstr "Det maximala antalet namnrymder att söka i för alternativ när namnuppslagning misslyckas."

#. from tp:gcc-16.1-b20260222
msgid "Maximum number of queries into the alias oracle per store."
msgstr "Maximalt antal frågor till aliasoraklet per lagring."

#. from tp:gcc-16.1-b20260222
msgid "Maximum size (in bytes) of objects tracked bytewise by dead store elimination."
msgstr "Maximal storlek (i byte) på objekt som spåras bytevis av eliminering av döda lagringar."

#. from tp:gcc-16.1-b20260222
msgid "Maximal estimated growth of function body caused by early inlining of single call."
msgstr "Maximal uppskattad ökning av funktionskroppen som orsakas av tidig inline-infogning av ett enda anrop."

#. from tp:gcc-16.1-b20260222
msgid "Maximum number of files in the file cache."
msgstr "Maximalt antal filer i filcachen."

#. from tp:gcc-16.1-b20260222
msgid "Maximum number of lines to index into file cache. When 0 this is automatically sized."
msgstr "Maximalt antal rader som ska indexeras i filcachen. När värdet är 0 bestäms storleken automatiskt."

#. from tp:gcc-16.1-b20260222
msgid "Scale factor to apply to the number of statements in a threading path crossing a loop back edge when comparing to max-jump-thread-duplication-stmts."
msgstr "Skalfaktor att använda på antalet satser i en trådningsväg som korsar en slingas bakåtbpge vid jämförelse med max-jump-thread-duplication-stmts."

#. from tp:gcc-16.1-b20260222
msgid "Whether the target fully pipelines FMA instructions.  If non-zero, reassociation considers the benefit of parallelizing FMA's multiplication part and addition part, assuming FMUL and FMA use the same units that can also do FADD."
msgstr "Huruvida målet fullt ut använder pipeline för FMA-instruktioner. Om skilt från noll bedömer reassocieringar fördelen av att parallellisera FMA:ers multiplikationsdel och additionsdel, under antagandet att FMUL och FMA använder samma enheter som även kan göra FADD."

#. from tp:gcc-16.1-b20260222
msgid "The threshold ratio of critical edges execution count that permit performing redundancy elimination after reload."
msgstr "Tröskelförhållandet av antal beräkningar av kritiska bågar som tillåter att göra redundanseliminering efter omläsning."

#. from tp:gcc-16.1-b20260222
msgid "The threshold ratio for performing partial redundancy elimination after reload."
msgstr "Tröskelförhållandet för partiell redundanseliminering efter omläsning."

#. from tp:gcc-16.1-b20260222
msgid "Scaling factor in calculation of maximum distance an expression can be moved by GCSE optimizations."
msgstr "Skalfaktor vid beräkning av det maximala avstånd som ett uttryck kan flyttas med GCSE-optimeringar."

#. from tp:gcc-16.1-b20260222
msgid "Cost at which GCSE optimizations does not constrain the distance an expression can travel."
msgstr "Kostnaden vid vilken GCSE-optimeringar inte begränsar avståndet som ett uttryck kan flyttas."

#. from tp:gcc-16.1-b20260222
msgid "Minimum heap expansion to trigger garbage collection, as a percentage of the total size of the heap."
msgstr "Minsta heap-expansion för att utlösa skräpsamling, som en procent av den totala storleken på heap:en."

#. from tp:gcc-16.1-b20260222
msgid "Minimum heap size before we start collecting garbage, in kilobytes."
msgstr "Minsta heap-storlek innan skräpsamling påbörjas, i kilobyte."

#. from tp:gcc-16.1-b20260222
msgid "The number of executions of a basic block which is considered hot. The parameter is used only in GIMPLE FE."
msgstr "Antalet körningar av ett grundblock som betraktas som varmt.  Parametern används bara i GIMPLE FE."

#. from tp:gcc-16.1-b20260222
msgid "Whether codegen errors should be ICEs when -fchecking."
msgstr "Huruvida kodgenereringsfel skall vara ICE:er med -fchecking."

#. from tp:gcc-16.1-b20260222
msgid "Maximum number of arrays per SCoP."
msgstr "Maximalt antal vektorer per SCoP."

#. from tp:gcc-16.1-b20260222
msgid "Maximum number of parameters in a SCoP."
msgstr "Maximalt antal parametrar i en SCoP."

#. from tp:gcc-16.1-b20260222
msgid "Maximum number of blocks for -fharden-control-flow-redundancy."
msgstr "Maximalt antal block för -fharden-control-flow-redundancy."

#. from tp:gcc-16.1-b20260222
msgid "Maximum number of blocks for in-line -fharden-control-flow-redundancy."
msgstr "Maximalt antal block för inline -fharden-control-flow-redundancy."

#. from tp:gcc-16.1-b20260222
msgid "The number of elements for which hash table verification is done for each searched element."
msgstr "Antalet element för vilka verifiering av hashtabellen görs för varje sökt element."

#. from tp:gcc-16.1-b20260222
msgid "The denominator n of fraction 1/n of the maximal execution count of a basic block in the entire program that a basic block needs to at least have in order to be considered hot (used in non-LTO mode)."
msgstr "Nämnaren n i bråket 1/n av det maximala antalet körningar av ett grundblock i hela programmet som ett grundblock åtminstone måste ha för att anses varmt (används i icke-LTO-läge)."

#. from tp:gcc-16.1-b20260222
msgid "The number of most executed permilles of the profiled execution of the entire program to which the execution count of a basic block must be part of in order to be considered hot (used in LTO mode)."
msgstr "Antalet mest exekverade promille av den profilerade körningen av hela programmet till vilken körningsräknaren för ett grundblock måste vara en del av för att betraktas som varm (används i LTO-läge)."

#. from tp:gcc-16.1-b20260222
msgid "The denominator n of fraction 1/n of the execution frequency of the entry block of a function that a basic block of this function needs to at least have in order to be considered hot."
msgstr "Nämnaren n i bråket 1/n av frekvensen av antalet körningar av ingångsblocket till en funktion som ett grundblock för denna funktion åtminstone måste ha för att anses varmt."

#. from tp:gcc-16.1-b20260222
msgid "The scale (as a percentage) applied to inline-insns-single and auto limits when heuristics hints that inlining is very profitable."
msgstr "Skalan (som en procentsats) tillämpad på inline-insns-single och automatiska gränser när heuristik indikerar att inline:ing är väldigt lönsamt."

#. from tp:gcc-16.1-b20260222
msgid "The minimal estimated speedup allowing inliner to ignore inline-insns-single and inline-insns-auto."
msgstr "Den minsta uppskattade hastighetsökningen som tillåter inline:aren att ignorera inline-insns-single och inline-insns-auto."

#. from tp:gcc-16.1-b20260222
msgid "How much can given compilation unit grow because of the inlining (as a percentage)."
msgstr "Hur mycket kan en given kompileringsenhet växa på grund av inline:ingen (som en procentsats)."

#. from tp:gcc-16.1-b20260222
msgid "The upper bound for sharing integer constants."
msgstr "Övre gränsen för att dela heltalskonstanter."

#. from tp:gcc-16.1-b20260222
msgid "Threshold ipa-cp opportunity evaluation that is still considered beneficial to clone."
msgstr "Tröskelvärde för ipa-cp-tillfällesberäkning som fortfarande betraktas som fördelaktig att klona."

#. from tp:gcc-16.1-b20260222
msgid "Compile-time bonus IPA-CP assigns to candidates which make loop bounds or strides known."
msgstr "Bonus IPA-CP tilldelar vid kompileringstillfället till kandidater vilka gör slingbegränsningar eller -steg kända."

#. from tp:gcc-16.1-b20260222
msgid "Maximum depth of recursive cloning for self-recursive function."
msgstr "Det maximala djupet för rekursiv kloning för självrekursiva funktioner."

#. from tp:gcc-16.1-b20260222
msgid "Recursive cloning only when the probability of call being executed exceeds the parameter."
msgstr "Rekursiv kloning endast när sannolikheten för att ett anrop skall göras överskrider parametern."

#. from tp:gcc-16.1-b20260222
msgid "When propagating IPA-CP effect estimates, multiply frequencies of recursive edges that bring back an unchanged value by this factor."
msgstr "Vid propagering av IPA-CP-effektuppskattningar, multiplicera frekvenser för rekursiva bågar som för tillbaka ett oförändrat värde med denna faktor."

#. from tp:gcc-16.1-b20260222
msgid "Percentage penalty recursive functions receive when they are evaluated for cloning."
msgstr "Procentuellt straff rekursiva funktionerna får när de utvärderas för kloning."

#. from tp:gcc-16.1-b20260222
msgid "Percentage penalty functions containing a single call to another function receive when they are evaluated for cloning."
msgstr "Procentuellt straff funktioner som innehåller ett ensamt anrop av en annan funktion får när de utvärderas för kloning."

#. from tp:gcc-16.1-b20260222
msgid "The number of times the interprocedural constant propagation traverses all functions to make cloning decisions."
msgstr "Antalet gånger den interprocedurella konstantpropageringen traverserar alla funktioner för att fatta kloningsbeslut."

#. from tp:gcc-16.1-b20260222
msgid "How much can given compilation unit grow because of the interprocedural constant propagation (as a percentage)."
msgstr "Hur mycket en given kompileringsenhet kan växa på grund av interproceduriell konstantpropagering (i procent)."

#. from tp:gcc-16.1-b20260222
msgid "The size of translation unit that IPA-CP pass considers large."
msgstr "Storleken på en översättningsenhet som IPA-CP-passet betraktar som stor."

#. from tp:gcc-16.1-b20260222
msgid "Maximum size of a list of values associated with each parameter for interprocedural constant propagation."
msgstr "Maximal storlek för en lista på värden associerad med varje parameter för konstantpropagering mellan procedurer."

#. from tp:gcc-16.1-b20260222
msgid "Maximum number of statements visited during jump function offset discovery."
msgstr "Maximalt antal besökta satser under upptäckt av avstånd för hoppfunktioner."

#. from tp:gcc-16.1-b20260222
msgid "Maximum number of statements that are visited by IPA formal parameter analysis based on alias analysis in any given function."
msgstr "Maximalt antal satser som besöks av IPA-formatparameteranalysen baserat på aliasanalys i varje given funktion."

#. from tp:gcc-16.1-b20260222
msgid "Maximum number of aggregate content items for a parameter in jump functions and lattices."
msgstr "Maximalt antal sammansatta innehållsposter för en parameter i hoppfunktioner och gitter."

#. from tp:gcc-16.1-b20260222
msgid "Maximum number of operations in a parameter expression that can be handled by IPA analysis."
msgstr "Maximalt antal operationer i ett parameteruttryck som kan hanteras av IPA-analys."

#. from tp:gcc-16.1-b20260222
msgid "Maximum number of different predicates used to track properties of loops in IPA analysis."
msgstr "Maximalt antal olika predikat som används för att spåra egenskaper hos slingor i IPA-analys."

#. from tp:gcc-16.1-b20260222
msgid "Maximal number of boundary endpoints of case ranges of switch statement used during IPA function summary generation."
msgstr "Maximala antalet gränsändpunkter för case-intervall i switch-satser som används under IPA-funktionssammanfattningsgenerering."

#. from tp:gcc-16.1-b20260222
msgid "Minimum probability (as a percentage) of dereferencing of a function pointer parameter for it to be considered for replacement with simple values."
msgstr "Minsta sannolikhet (som en procentsats) för dereferens av en funktionspekarparameter för att den skall övervägas för ersättning med enkla värden."

#. from tp:gcc-16.1-b20260222
msgid "Maximum pieces that IPA-SRA tracks per formal parameter, as a consequence, also the maximum number of replacements of a formal parameter."
msgstr "Maximala antalet delar som IPA-SRA följer per formell parameter, och som en konsekvens, även det maximala antalet ersättningar av en formell parameter."

#. from tp:gcc-16.1-b20260222
msgid "Maximum allowed growth of total size of new parameters that ipa-sra replaces a pointer to an aggregate with."
msgstr "Största tillåtna ökning av total storlek på nya parametrar som ipa-sra ersätter en pekare till ett aggregat med."

#. from tp:gcc-16.1-b20260222
msgid "Additional maximum allowed growth of total size of new parameters that ipa-sra replaces a pointer to an aggregate with, if it points to a local variable that the caller only writes to and passes it as an argument to functions."
msgstr "Ytterligare största tillåtna ökning av total storlek på nya parametrar som ipa-sra ersätter en pekare till ett aggregat med, om den pekar på en lokal variabel som anroparen endast skriver till och skickar den som ett argument till funktioner."

#. from tp:gcc-16.1-b20260222
msgid "The number of registers in each class kept unused by loop invariant motion."
msgstr "Antalet register i varje klass som hålls oanvända vid flyttning av slinginvarianter."

#. from tp:gcc-16.1-b20260222
msgid "Maximum size of conflict table in MB."
msgstr "Maximal storlek på konflikttabell i MB."

#. from tp:gcc-16.1-b20260222
msgid "Approximate function insn number in 1K units triggering simple local RA."
msgstr "Ungefärligt antal funktionsinstruktioner i 1k-enheter som utlöser enkel lokal RA."

#. from tp:gcc-16.1-b20260222
msgid "Maximum number of loops for regional RA."
msgstr "Maximalt slingantal för regional RA."

#. from tp:gcc-16.1-b20260222
msgid "Control IRA to consider matching constraint (duplicated operand number) heavily in all available alternatives for preferred register class.  If it is set as zero, it means IRA only respects the matching constraint when it's in the only available alternative with an appropriate register class.  Otherwise, it means IRA checks all available alternatives for preferred register class even if it has found some choice with an appropriate register class and respect the found qualified matching constraint."
msgstr "Styr huruvida IRA starkt beaktar en matchande begränsning (duplicerat operandnummer) i alla tillgängliga alternativ för den föredragna registerklassen. Värdet noll betyder att IRA endast beaktar den matchande begränsningen när den finns i det enda tillgängliga alternativet med en lämplig registerklass. I annat fall kontrollerar IRA alla tillgängliga alternativ för den föredragna registerklassen, även om ett val med en lämplig registerklass redan har hittats, och beaktar den kvalificerade matchande begränsningen."

#. from tp:gcc-16.1-b20260222
msgid "If number of candidates in the set is smaller, we always try to remove unused induction variables during its optimization."
msgstr "Om antalet kandidater i mängden är mindre än denna gräns försöker vi alltid ta bort oanvända induktionsvariabler under optimeringen."

#. from tp:gcc-16.1-b20260222
msgid "Bound on number of candidates below that all candidates are considered in induction variable optimizations."
msgstr "Gräns för antalet kandidater under vilken alla kandidater övervägs i induktionsvariabeloptimeringar."

#. from tp:gcc-16.1-b20260222
msgid "Bound on number of induction variable uses in loop optimized in IV optimizations."
msgstr "Gräns för antalet induktionsvariabelanvändningar i en slinga som optimeras med induktionsvariabeloptimeringar."

#. from tp:gcc-16.1-b20260222
msgid "The maximum code size growth ratio when expanding into a jump table (as a percentage).  The parameter is used when optimizing for size."
msgstr "Det maximala förhållandet för tillväxt av kod vid expansion till en hopptabell (som en procentsats).  Parametern används vid optimering för storlek."

#. from tp:gcc-16.1-b20260222
msgid "The maximum code size growth ratio when expanding into a jump table (as a percentage).  The parameter is used when optimizing for speed."
msgstr "Det maximala förhållandet för kodstorleksökning vid expansion till en hopptabell (i procent). Parametern används vid optimering för hastighet."

#. from tp:gcc-16.1-b20260222
msgid "The size of L1 cache line."
msgstr "Storleken på en L1-cacherad."

#. from tp:gcc-16.1-b20260222
msgid "The minimum recommended offset between two concurrently-accessed objects to avoid additional performance degradation due to contention introduced by the implementation.  Typically the L1 cache line size, but can be larger to accommodate a variety of target processors with different cache line sizes. C++17 code might use this value in structure layout, but is strongly discouraged from doing so in public ABIs."
msgstr "Det minsta rekommenderade avståndet mellan två samtidigt åtkomna objekt för att undvika ytterligare prestandaförsämring på grund av trängsel som introduceras av implementationen. Typiskt L1-cachens radstorlek, men kan vara större för att ge utrymme för olika målprocessorer med olika cacheradstorlekar. C++17-kod kan använda detta värde i post-layout, men avrådes starkt från att göra det i publika ABI:er."

#. from tp:gcc-16.1-b20260222
msgid "The maximum recommended size of contiguous memory occupied by two objects accessed with temporal locality by concurrent threads.  Typically the L1 cache line size, but can be smaller to accommodate a variety of target processors with different cache line sizes."
msgstr "Den maximala rekommenderade storleken på sammanhängande minne använt av två objekt som används med tidsmässig lokalitet av samtidiga trådar. Typiskt L1-cachens radstorlek, men kan vara mindre för att ge utrymme för olika målprocessorer med olika cacheradstorlekar."

#. from tp:gcc-16.1-b20260222
msgid "The size of L1 cache."
msgstr "Storleken på L1-cachen."

#. from tp:gcc-16.1-b20260222
msgid "The size of L2 cache."
msgstr "Storleken på L2-cachen."

#. from tp:gcc-16.1-b20260222
msgid "Maximal growth due to inlining of large function (as a percentage)."
msgstr "Maximal på grund av inline:ing av stora funktioner (som en procentsats)."

#. from tp:gcc-16.1-b20260222
msgid "The size of function body to be considered large."
msgstr "Storleken på en funktionskropp för att betraktas som stor."

#. from tp:gcc-16.1-b20260222
msgid "The size of stack frame to be considered large."
msgstr "Storleken på en stackram för att betraktas som stor."

#. from tp:gcc-16.1-b20260222
msgid "Maximal stack frame growth due to inlining (as a percentage)."
msgstr "Maximal storleksökning på stackram på grund av inline:ing (som en procentsats)."

#. from tp:gcc-16.1-b20260222
msgid "The size of translation unit to be considered large."
msgstr "Storleken på en översättningsenhet för att betraktas som stor."

#. from tp:gcc-16.1-b20260222
msgid "Maximum number of concurrently open C++ module files when lazy loading."
msgstr "Maximalt antal av samtidigt öppna C++-modulfiler vid lat laddning."

#. from tp:gcc-16.1-b20260222
msgid "The minimum cost of an expensive expression in the loop invariant motion."
msgstr "Den minsta kostnaden för ett dyrt uttryck vid flyttning av slinginvarianter."

#. from tp:gcc-16.1-b20260222
msgid "True if a non-short-circuit operation is optimal."
msgstr "Sant om en operation utan kortslutning är optimal."

#. from tp:gcc-16.1-b20260222
msgid "Size of tiles for loop blocking."
msgstr "Storlek på brickor för slingblockning."

#. from tp:gcc-16.1-b20260222
msgid "The maximum number of stmts in loop nest for loop interchange."
msgstr "Det maximala antalet satser i slingnästning för slingutväxling."

#. from tp:gcc-16.1-b20260222
msgid "The minimum stride ratio for loop interchange to be profitable."
msgstr "Minsta stegförhållande för att slingutväxling ska vara lönsam."

#. from tp:gcc-16.1-b20260222
msgid "Max basic blocks number in loop for loop invariant motion."
msgstr "Maximalt antal grundblock i en slinga för flyttning av slinginvarianter."

#. from tp:gcc-16.1-b20260222
msgid "Maximum number of datarefs in loop for building loop data dependencies."
msgstr "Maximalt antal datareferenser i en slinga för att bygga slingdataberoenden."

#. from tp:gcc-16.1-b20260222
msgid "The maximum number of instructions in an inner loop that is being considered for versioning."
msgstr "Det maximala antalet instruktioner i en inre slinga som beaktas för versionering."

#. from tp:gcc-16.1-b20260222
msgid "The maximum number of instructions in an outer loop that is being considered for versioning, on top of the instructions in inner loops."
msgstr "Det maximala antalet instruktioner i en yttre slinga som beaktas för versionering, ovanpå instruktionerna i inre slingor."

#. from tp:gcc-16.1-b20260222
msgid "Minimal fall-through edge probability as a percentage, used to add BB to inheritance EBB in LRA."
msgstr "Minsta sannolikhet för en genomfallsbåge, i procent, som används för att lägga till BB i arvs-EBB i LRA."

#. from tp:gcc-16.1-b20260222
msgid "The max number of reload pseudos which are considered during spilling a non-reload pseudo."
msgstr "Maximalt antal omläsningar av pseudoregister som övervägs när ett icke-omläst pseudoregister spills."

#. from tp:gcc-16.1-b20260222
msgid "The maximum log2(number of reload pseudos * number of program points) threshold when preferences for other reload pseudos are still considered. Taking these preferences into account helps to improve register allocation. However, for very large functions, a large value can result in significant compilation time and memory consumption. The default value is 30."
msgstr "Det maximala log2-tröskelvärdet för (antalet omladdningspseudon × antalet programpunkter) när preferenser för andra omladdningspseudon fortfarande beaktas. Att ta hänsyn till dessa preferenser hjälper till att förbättra registerallokeringen. För mycket stora funktioner kan dock ett stort värde leda till betydande kompileringstid och minnesförbrukning. Standardvärdet är 30."

#. from tp:gcc-16.1-b20260222
msgid "Maximal size of a partition for LTO (in estimated instructions)."
msgstr "Maximal storlek på en partition för LTO (i uppskattade instruktioner)."

#. from tp:gcc-16.1-b20260222
msgid "Maximal number of LTO partitions streamed in parallel."
msgstr "Maximalt antal LTO-partitioner som strömmas parallellt."

#. from tp:gcc-16.1-b20260222
msgid "Minimal size of a partition for LTO (in estimated instructions)."
msgstr "Minimal storlek på en partition för LTO (i uppskattade instruktioner)."

#. from tp:gcc-16.1-b20260222
msgid "Number of partitions the program should be split to."
msgstr "Antal partitioner som programmet ska delas upp i."

#. from tp:gcc-16.1-b20260222
msgid "The denominator n of fraction 1/n of the execution frequency of callee to be cloned for a particular caller. Special value of 0 dictates to always clone without a cut-off."
msgstr "Nämnaren n i bråket 1/n av frekvensen av antalet körningar av den anropade för att klonas för en viss anropare. Specialvärdet 0 dikterar att alltid klona utan något gränsvärde."

#. from tp:gcc-16.1-b20260222
msgid "Size cut-off for callee including inlined calls to be cloned for a particular caller."
msgstr "Storleksgränsvärde för att den anropade inklusive inline:ade anrop skall klonas för en viss anropare."

#. from tp:gcc-16.1-b20260222
msgid "Maximal size of a locality partition for LTO (in estimated instructions). Value of 0 results in default value being used."
msgstr "Maximal storlek på en lokalitetspartition för LTO (i uppskattade instruktioner). Ett värde på 0 resulterar i att standardvärdet används."

#. from tp:gcc-16.1-b20260222
msgid "Choose static heuristics for locality layout. Option cpp_template groups by C++ template instantiation type."
msgstr "Välj statisk heuristik för lokalitetslayout. Alternativet cpp_template grupperar efter C++-mallens instansieringstyp."

#. from tp:gcc-16.1-b20260222
msgid "The maximum number of instructions to consider to unroll in a loop on average."
msgstr "Det maximala antalet instruktioner som i genomsnitt kan övervägas för utrullning i en slinga."

#. from tp:gcc-16.1-b20260222
msgid "The maximum number of insns combine tries to combine."
msgstr "Det maximala antalet instruktioner som combine försöker kombinera."

#. from tp:gcc-16.1-b20260222
msgid "The maximum number of instructions that combine searches in order to find the next use of a particular register."
msgstr "Det maximala antalet instruktioner som kombinerar sökningar för att att hitta nästa användning av ett visst register."

#. from tp:gcc-16.1-b20260222
msgid "The maximum depth of a loop nest we completely peel."
msgstr "Det maximala djupet av nästade slingor som vi skalar helt."

#. from tp:gcc-16.1-b20260222
msgid "The maximum number of peelings of a single loop that is peeled completely."
msgstr "Det maximala antalet avskalningar av en enskild slinga som skalas helt."

#. from tp:gcc-16.1-b20260222
msgid "The maximum number of insns of a completely peeled loop."
msgstr "Det maximala antalet instruktioner i en helt avskalad slinga."

#. from tp:gcc-16.1-b20260222
msgid "The maximum number of incoming edges to consider for crossjumping."
msgstr "Det maximala antalet ingående bågar att överväga för korshopp."

#. from tp:gcc-16.1-b20260222
msgid "The maximum instructions CSE process before flushing."
msgstr "Det maximala antalet instruktioner CSE bearbetar före tömning."

#. from tp:gcc-16.1-b20260222
msgid "The maximum length of path considered in cse."
msgstr "Den maximala längden på sökvägar som övervägs i cse."

#. from tp:gcc-16.1-b20260222
msgid "The maximum memory locations recorded by cselib."
msgstr "Det maximala antalet minnesplatser noterade av cselib."

#. from tp:gcc-16.1-b20260222
msgid "Maximum count of debug markers to expand or inline."
msgstr "Maximalt antal felsökningsmarkörer att expandera eller inline:a."

#. from tp:gcc-16.1-b20260222
msgid "The maximum number of instructions to consider to fill a delay slot."
msgstr "Det maximala antalet instruktioner att överväga för att fylla ett fördröjningsutrymme."

#. from tp:gcc-16.1-b20260222
msgid "The maximum number of instructions to consider to find accurate live register information."
msgstr "Det maximala antalet instruktioner att överväga för att hitta korrekt information om aktiva register."

#. from tp:gcc-16.1-b20260222
msgid "Maximum number of active local stores in RTL dead store elimination."
msgstr "Maximalt antal aktiva lokala lagringar i RTL vid eliminering av döda lagringar."

#. from tp:gcc-16.1-b20260222
msgid "Maximum number of targets to devirutalize."
msgstr "Maximalt antal mål att devirtualisera."

#. from tp:gcc-16.1-b20260222
msgid "The maximum number of nested indirect inlining performed by early inliner."
msgstr "Det maximala antalet nästade indirekta inline:ingar som utförs av den tidiga inline:aren."

#. from tp:gcc-16.1-b20260222
msgid "Maximum number of fields in a structure before pointer analysis treats the structure as a single variable."
msgstr "Maximalt antal fält i en struktur innan pekaranalysen behandlar strukturen som en enda variabel."

#. from tp:gcc-16.1-b20260222
msgid "Maximum number of instructions to copy when duplicating blocks on a finite state automaton jump thread path."
msgstr "Maximalt antal instruktioner att kopiera vid duplicering av block på hopptrådvägen för en ändlig tillståndsmaskin."

#. from tp:gcc-16.1-b20260222
msgid "The maximum ratio of insertions to deletions of expressions in GCSE."
msgstr "Det maximala förhållandet mellan insättningar och raderingar av uttryck i GCSE."

#. from tp:gcc-16.1-b20260222
msgid "The maximum amount of memory to be allocated by GCSE, in kilobytes."
msgstr "Den maximala mängden minne som får allokeras av GCSE, i kilobyte."

#. from tp:gcc-16.1-b20260222
msgid "The maximum number of insns to duplicate when unfactoring computed gotos."
msgstr "Det maximala antalet instruktioner att duplicera vid avfaktorering av beräknade goto."

#. from tp:gcc-16.1-b20260222
msgid "The maximum expansion factor when copying basic blocks."
msgstr "Den maximala expansionsfaktorn vid kopiering av grundblock."

#. from tp:gcc-16.1-b20260222
msgid "Maximum depth of search in the dominator tree for expressions to hoist."
msgstr "Maximalt sökdjup i dominansträdet för uttryck som ska lyftas upp."

#. from tp:gcc-16.1-b20260222
msgid "Maximum loop depth of a call which is considered for inlining functions called once."
msgstr "Maximalt slingdjup för ett anrop vilket övervägs för inline:ing av funktioner som endast anropas en gång."

#. from tp:gcc-16.1-b20260222
msgid "Maximum combined size of caller and callee which is inlined if callee is called once."
msgstr "Maximal sammanlagd storlek för anropare och anropad som infogas inline om den anropade bara anropas en gång."

#. from tp:gcc-16.1-b20260222
msgid "The maximum number of instructions when automatically inlining."
msgstr "Det maximala antalet instruktioner vid automatisk inline:ing."

#. from tp:gcc-16.1-b20260222
msgid "The maximum number of instructions inline function can grow to via recursive inlining."
msgstr "Det maximala antalet instruktioner inline-funktioner kan växa till via rekursiv inline:ing."

#. from tp:gcc-16.1-b20260222
msgid "The maximum number of instructions non-inline function can grow to via recursive inlining."
msgstr "Det maximala antalet instruktioner icke-inline-funktioner kan växa till via rekursiv inline:ing."

#. from tp:gcc-16.1-b20260222
msgid "The maximum number of instructions in a single function eligible for inlining."
msgstr "Det maximala antalet instruktioner i en enskild funktion tänkbar för inline:ing."

#. from tp:gcc-16.1-b20260222
msgid "The maximum number of instructions when inlining for size."
msgstr "Det maximala antalet instruktioner vid inline:ing för storlek."

#. from tp:gcc-16.1-b20260222
msgid "The maximum number of instructions when automatically inlining small functions."
msgstr "Det maximala antalet instruktioner vid automatisk inline:ing av små funktioner."

#. from tp:gcc-16.1-b20260222
msgid "The maximum depth of recursive inlining for inline functions."
msgstr "Det maximala djupet för rekursiv inline:ing för inline-funktioner."

#. from tp:gcc-16.1-b20260222
msgid "The maximum depth of recursive inlining for non-inline functions."
msgstr "Det maximala djupet för rekursiv inline:ing för icke-inline-funktioner."

#. from tp:gcc-16.1-b20260222
msgid "Maximum number of isl operations, 0 means unlimited."
msgstr "Maximala antalet isl-operationer, 0 betyder obegränsat."

#. from tp:gcc-16.1-b20260222
msgid "Bound on the cost of an expression to compute the number of iterations."
msgstr "Övre gräns för kostnaden hos ett uttryck för att beräkna antalet iterationer."

#. from tp:gcc-16.1-b20260222
msgid "Bound on the number of iterations the brute force # of iterations analysis algorithm evaluates."
msgstr "Begränsning på antalet iterationer som utvärderas av råstyrkealgoritmen för att analysera antalet iterationer."

#. from tp:gcc-16.1-b20260222
msgid "Maximum number of statements allowed in a block that needs to be duplicated when threading jumps."
msgstr "Maximalt antal satser som tillåts i ett block som behöver dupliceras när hoppen trådas."

#. from tp:gcc-16.1-b20260222
msgid "Search space limit for the backwards jump threader."
msgstr "Sökrymdsgräns för bakåthoppstrådaren."

#. from tp:gcc-16.1-b20260222
msgid "The maximum number of RTL nodes that can be recorded as combiner's last value."
msgstr "Det maximala antalet RTL-noder som kan noteras som kombinerarens sista värde."

#. from tp:gcc-16.1-b20260222
msgid "The maximum number of insns in loop header duplicated by the copy loop headers pass."
msgstr "Det maximala antalet instruktioner i slinghuvudet duplicerade av kopieringspasset för slinghuvuden."

#. from tp:gcc-16.1-b20260222
msgid "The maximum number of backtrack attempts the scheduler should make when modulo scheduling a loop."
msgstr "Maximalt antal bakåtspårningsförsök som schemaläggaren ska göra vid moduloschemaläggning av en slinga."

#. from tp:gcc-16.1-b20260222
msgid "Minimum page size for warning purposes."
msgstr "Minsta sidstorlek för varningsändamål."

#. from tp:gcc-16.1-b20260222
msgid "Maximum length of partial antic set when performing tree pre optimization."
msgstr "Maximal längd på partiell förväntansmängd när föroptimeringar på träd görs."

#. from tp:gcc-16.1-b20260222
msgid "The maximum number of branches on the path through the peeled sequence."
msgstr "Det maximala antalet grenar på vägen genom den skalade sekvensen."

#. from tp:gcc-16.1-b20260222
msgid "The maximum number of peelings of a single loop."
msgstr "Det maximala antalet avskalningar av en enskild slinga."

#. from tp:gcc-16.1-b20260222
msgid "The maximum number of insns of a peeled loop."
msgstr "Det maximala antalet instruktioner i en avskalad slinga."

#. from tp:gcc-16.1-b20260222
msgid "The maximum length of scheduling's pending operations list."
msgstr "Den maximala längden på schemaläggarens lista över väntande operationer."

#. from tp:gcc-16.1-b20260222
msgid "The maximum number of blocks in a region to be considered for interblock scheduling."
msgstr "Det maximala antalet block i en region som övervägs för interblockschemaläggning."

#. from tp:gcc-16.1-b20260222
msgid "The maximum number of insns in a region to be considered for interblock scheduling."
msgstr "Det maximala antalet instruktioner i en region för att övervägas för interblockschemaläggning."

#. from tp:gcc-16.1-b20260222
msgid "Maximum depth of sqrt chains to use when synthesizing exponentiation by a real constant."
msgstr "Maximalt djup av sqrt-kedjor att använda vid syntetisering av exponentiering av en reell konstant."

#. from tp:gcc-16.1-b20260222
msgid "The maximum number of loop iterations we predict statically."
msgstr "Det maximala antalet slingiterationer vi förutsäger statiskt."

#. from tp:gcc-16.1-b20260222
msgid "The maximum number of instructions to search backward when looking for equivalent reload."
msgstr "Det största antalet instruktioner att söka bakåt för att leta efter ekvivalent omläsning."

#. from tp:gcc-16.1-b20260222
msgid "Maximum number of insns in a basic block to consider for RTL if-conversion."
msgstr "Maximalt antal instruktioner i ett grundblock att beakta för RTL-if-konvertering."

#. from tp:gcc-16.1-b20260222
msgid "Maximum permissible cost for the sequence that would be generated by the RTL if-conversion pass for a branch that is considered predictable."
msgstr "Maximal tillåten kostnad för sekvensen som skulle genererats av RTL if-konverteringspasset för en gren som betraktas som förutsägbar."

#. from tp:gcc-16.1-b20260222
msgid "Maximum permissible cost for the sequence that would be generated by the RTL if-conversion pass for a branch that is considered unpredictable."
msgstr "Maximal tillåten kostnad för sekvensen som skulle genererats av RTL if-konverteringspasset för en gren som betraktas som oförutsägbar."

#. from tp:gcc-16.1-b20260222
msgid "The maximum number of iterations through CFG to extend regions."
msgstr "Maximalt antal iterationer genom CFG för att utöka regioner."

#. from tp:gcc-16.1-b20260222
msgid "The maximum conflict delay for an insn to be considered for speculative motion."
msgstr "Den maximala konfliktfördröjningen för att en instruktion skall övervägas för spekulativ förflyttning."

#. from tp:gcc-16.1-b20260222
msgid "The maximum number of instructions ready to be issued to be considered by the scheduler during the first scheduling pass."
msgstr "Det maximala antalet instruktioner redo att matas ut för att övervägas under det första schemaläggningspasset."

#. from tp:gcc-16.1-b20260222
msgid "Maximum length of candidate scans for straight-line strength reduction."
msgstr "Maximal längd på kandidatsökningar för rätlinjig styrkereduktion."

#. from tp:gcc-16.1-b20260222
msgid "Maximum number of may-defs visited when devirtualizing speculatively."
msgstr "Maximalt antal av may-defs som besöks vid spekulativ avvirtualisering."

#. from tp:gcc-16.1-b20260222
msgid "Maximum recursion depth allowed when querying a property of an SSA name."
msgstr "Maximalt tillåtet rekursionsdjup när en egenskap efterfrågas från ett SSA-namn."

#. from tp:gcc-16.1-b20260222
msgid "Maximum number of constant stores to merge in the store merging pass."
msgstr "Maximalt antal konstantlagringar att slå samman i passet för sammanslagning av lagring."

#. from tp:gcc-16.1-b20260222
msgid "Maximum number of conditional store pairs that can be sunk."
msgstr "Maximalt antal villkorliga lagringspar som kan sänkas."

#. from tp:gcc-16.1-b20260222
msgid "Maximum number of store chains to track at the same time in the store merging pass."
msgstr "Maximalt antal lagringskedjor att spåra på samma gång i passet för sammanslagning av lagring."

#. from tp:gcc-16.1-b20260222
msgid "Maximum amount of similar bbs to compare a bb with."
msgstr "Maximalt antal liknande BB att jämföra ett BB med."

#. from tp:gcc-16.1-b20260222
msgid "Maximum amount of iterations of the pass over a function."
msgstr "Maximalt antal iterationer för passet över en funktion."

#. from tp:gcc-16.1-b20260222
msgid "Maximum number of strings for which strlen optimization pass tracks string lengths."
msgstr "Maximalt antal strängar för vilket strlen-optimeringspasset följer stränglängder."

#. from tp:gcc-16.1-b20260222
msgid "Maximum number of arguments in a PHI supported by TREE if-conversion unless the loop is marked with simd pragma."
msgstr "Maximalt antal argument i en PHI som stödjs av TREE if-konvertering om inte slingan är märkt med simd-pragma."

#. from tp:gcc-16.1-b20260222
msgid "The maximum number of unrollings of a single loop."
msgstr "Det maximala antalet utrullningar av en enskild slinga."

#. from tp:gcc-16.1-b20260222
msgid "The maximum number of instructions to consider to unroll in a loop."
msgstr "Det maximala antalet instruktioner för att överväga att rulla ut i en slinga."

#. from tp:gcc-16.1-b20260222
msgid "The maximum number of insns of an unswitched loop."
msgstr "Det maximala antalet instruktioner i en oväxlad slinga."

#. from tp:gcc-16.1-b20260222
msgid "The maximum depth of a loop nest to be unswitched."
msgstr "Det maximala djupet av nästade slingor för att bli oväxlad."

#. from tp:gcc-16.1-b20260222
msgid "If -fvariable-expansion-in-unroller is used, the maximum number of times that an individual variable is expanded during loop unrolling."
msgstr "Om -fvariable-expansion-in-unroller används, det maximala antalet gånger en enskild variabel expanderas vid slingutrullning."

#. from tp:gcc-16.1-b20260222
msgid "Maximum recursion depth for expanding var tracking expressions."
msgstr "Maximalt rekursionsdjup för att expandera variabelspårningsuttryck."

#. from tp:gcc-16.1-b20260222
msgid "Maximum size of loc list for which reverse ops should be added."
msgstr "Maximal storlek på loc-listan för vilken omvända operationer skall läggas till."

#. from tp:gcc-16.1-b20260222
msgid "Maximum size of var tracking hash tables."
msgstr "Maximal storlek på hashtabell för variabelspårning."

#. from tp:gcc-16.1-b20260222
msgid "Maximum number of VALUEs handled during a single find_base_term call."
msgstr "Maximala antalet VÄRDEn hanterade under ett enskilt anrop av find_base_term."

#. from tp:gcc-16.1-b20260222
msgid "The minimum number of matching instructions to consider for crossjumping."
msgstr "Minsta antal matchande instruktioner att beakta för korshopp."

#. from tp:gcc-16.1-b20260222
msgid "Inline recursively only when the probability of call being executed exceeds the parameter."
msgstr "Inline:a rekursivt endast när sannolikheten för att ett anrop skall göras överskrider parametern."

#. from tp:gcc-16.1-b20260222
msgid "Minimum ratio of insns to prefetches to enable prefetching for a loop with an unknown trip count."
msgstr "Minsta förhållande av instruktioner till minnesoperationer för att aktivera förhandshämtning (prefetching) för en slinga med okänt antal turer."

#. from tp:gcc-16.1-b20260222
msgid "The minimum threshold for probability of semi-invariant condition statement to trigger loop split."
msgstr "Det minsta tröskelvärdet för sannolikheten för en semi-invariant villkorssats för att utlösa slingdelning."

#. from tp:gcc-16.1-b20260222
msgid "The minimum UID to be used for a nondebug insn."
msgstr "Minsta UID som får användas för en icke-felsökningsinstruktion."

#. from tp:gcc-16.1-b20260222
msgid "The minimum size of variables taking part in stack slot sharing when not optimizing."
msgstr "Minsta storleken på variabler som är med i stackutrymmesdelning utan optimering."

#. from tp:gcc-16.1-b20260222
msgid "The minimum probability of reaching a source block for interblock speculative scheduling."
msgstr "Minsta sannolikhet för att nå ett källblock vid spekulativ schemaläggning mellan block."

#. from tp:gcc-16.1-b20260222
msgid "If -ftree-vectorize is used, the minimal loop bound of a loop to be considered for vectorization."
msgstr "Om -ftree-vectorize används, den minsta slinggränsen för att en slinga ska beaktas för vektorisering."

#. from tp:gcc-16.1-b20260222
msgid "--param=openacc-kernels=[decompose|parloops]	Specify mode of OpenACC 'kernels' constructs handling."
msgstr "--param=openacc-kernels=[decompose|parloops]\tAnge läge för hantering av OpenACC-”kernels”-konstruktioner."

#. from tp:gcc-16.1-b20260222
msgid "--param=openacc-privatization=[quiet|noisy]	Specify mode of OpenACC privatization diagnostics."
msgstr "--param=openacc-privatization=[quiet|noisy]	Ange läge för OpenACC:s privatiseringsmeddelanden."

#. from tp:gcc-16.1-b20260222
msgid "Chunk size of omp schedule for loops parallelized by parloops."
msgstr "Styckesstorlek för omp-schema för slingor som parallelliseras av parloops."

#. from tp:gcc-16.1-b20260222
msgid "Minimum number of iterations per thread of an innermost parallelized loop."
msgstr "Minsta antal iterationer per tråd i en innersta parallelliserad slinga."

#. from tp:gcc-16.1-b20260222
msgid "--param=parloops-schedule=[static|dynamic|guided|auto|runtime]	Schedule type of omp schedule for loops parallelized by parloops."
msgstr "--param=parloops-schedule=[static|dynamic|guided|auto|runtime]	Schemaläggningstyp för omp-scheman för slingor som parallelliseras av parloops."

#. from tp:gcc-16.1-b20260222
msgid "Maximum probability of the entry BB of split region (as a percentage relative to entry BB of the function) to make partial inlining happen."
msgstr "Maximal sannolikhet för ingångs-BB:t i en delad region (i procent i förhållande till funktionens ingångs-BB) för att möjliggöra partiell inline-infogning."

#. from tp:gcc-16.1-b20260222
msgid "Maximum number of statements allowed inbetween the statement and the end to considered not extending the liferange."
msgstr "Maximalt antal satser som tillåts mellan satsen och slutet för att anses inte utöka livsintervallet."

#. from tp:gcc-16.1-b20260222
msgid "Maximal estimated outcome of branch considered predictable."
msgstr "Maximal uppskattad sannolikhet för en gren för att anses förutsägbar."

#. from tp:gcc-16.1-b20260222
msgid "Whether software prefetch hints should be issued for non-constant strides."
msgstr "Huruvida mjukvaruförhandshämtningstips skall matas ut för icke-konstanta steg."

#. from tp:gcc-16.1-b20260222
msgid "The number of insns executed before prefetch is completed."
msgstr "Antalet instruktioner som körs innan förhandshämtning slutförs."

#. from tp:gcc-16.1-b20260222
msgid "Minimum ratio of insns to mem ops to enable prefetching in a loop."
msgstr "Minsta förhållande av instruktioner till minnesoperationer för att aktivera förhandshämtning (prefetching) i en slinga."

#. from tp:gcc-16.1-b20260222
msgid "The minimum constant stride beyond which we should use prefetch hints for."
msgstr "Det minsta konstanta steget bortom vilket vi skall använda förhandshämtningstips."

#. from tp:gcc-16.1-b20260222
msgid "Use internal function id in profile lookup."
msgstr "Använd internt funktions-id i profileringsuppslagningar."

#. from tp:gcc-16.1-b20260222
msgid "--param=ranger-debug=[none|trace|gori|cache|tracegori|all] Specifies the output mode for debugging ranger."
msgstr "--param=ranger-debug=[none|trace|gori|cache|tracegori|all] Anger utmatningsläget för felsökning av ranger."

#. from tp:gcc-16.1-b20260222
msgid "Maximum depth of logical expression evaluation ranger looks through when evaluating outgoing edge ranges."
msgstr "Maximalt djup på beräkningsintervallare av logiska uttryck tittar igenom vid beräkning av utgående bågintervall."

#. from tp:gcc-16.1-b20260222
msgid "Maximum depth of instruction chains to consider for recomputation in the outgoing range calculator."
msgstr "Maximalt djup för instruktionskedjor att överväga för omberäkning i beräknaren av utgående intervall."

#. from tp:gcc-16.1-b20260222
msgid "Maximum number of relations the oracle registers in a basic block."
msgstr "Maximalt antal relationer oraklet registrerar i ett grundblock."

#. from tp:gcc-16.1-b20260222
msgid "Work bound when discovering transitive relations from existing relations."
msgstr "Arbetsbegränsning vid upptäckt av transitiva relationer från befintliga relationer."

#. from tp:gcc-16.1-b20260222
msgid "Maximum depth of a loop nest to fully value-number optimistically."
msgstr "Maximalt djup av en slingnästning för fullständig optimistisk värdenumrering."

#. from tp:gcc-16.1-b20260222
msgid "Maximum number of disambiguations to perform per memory access."
msgstr "Maximalt antal upplösningar av tvetydigheter att utföra per minnesåtkomst."

#. from tp:gcc-16.1-b20260222
msgid "Bound on the complexity of the expressions in the scalar evolutions analyzer."
msgstr "Gräns på komplexiteten av uttryck som används i analyseraren av skalära uttryck."

#. from tp:gcc-16.1-b20260222
msgid "Bound on size of expressions used in the scalar evolutions analyzer."
msgstr "Gräns för storleken av uttryck som används i analyseraren av skalära uttryck."

#. from tp:gcc-16.1-b20260222
msgid "Hardware autoprefetcher scheduler model control flag.  Number of lookahead cycles the model looks into, at '0' only enable instruction sorting heuristic.  Disabled by default."
msgstr "Styrflagga för schemaläggningsmodellen för maskinvarans automatiska förhandshämtning.  Antalet framförhållningscykler som modellen undersöker; vid ”0” aktiveras endast heuristiken för instruktionssortering.  Avaktiverad som standard."

#. from tp:gcc-16.1-b20260222
msgid "Minimal distance between possibly conflicting store and load."
msgstr "Minsta avståndet mellan en lagring och en laddning som kan stå i konflikt."

#. from tp:gcc-16.1-b20260222
msgid "Which -fsched-pressure algorithm to apply."
msgstr "Vilken -fsched-pressure-algoritm som skall användas."

#. from tp:gcc-16.1-b20260222
msgid "The minimal probability of speculation success (as a percentage), so that speculative insns are scheduled."
msgstr "Den minsta sannolikheten för spekulativ framgång (som en procentsats), så att spekulativa instruktioner schemaläggs."

#. from tp:gcc-16.1-b20260222
msgid "The minimum probability an edge must have for the scheduler to save its state across it."
msgstr "Den minsta sannolikhet en båge måste ha för att schemaläggaren skall spara sitt tillstånd över den."

#. from tp:gcc-16.1-b20260222
msgid "Maximum number of instructions in the ready list that are considered eligible for renaming."
msgstr "Det maximala antalet instruktioner i redolistan som betraktas som valbara för namnändring."

#. from tp:gcc-16.1-b20260222
msgid "The maximum size of the lookahead window of selective scheduling."
msgstr "Den maximala storleken på fönstret för framåtblickar vid selektiv schemaläggning."

#. from tp:gcc-16.1-b20260222
msgid "Maximum number of times that an insn could be scheduled."
msgstr "Maximalt antal gånger som en instruktion kan schemaläggas."

#. from tp:gcc-16.1-b20260222
msgid "The number of prefetches that can run at the same time."
msgstr "Antalet förhandshämtningar (prefetch) som kan vara igång samtidigt."

#. from tp:gcc-16.1-b20260222
msgid "Target block's relative execution frequency (as a percentage) required to sink a statement."
msgstr "Målblockets relativa exekveringsfrekvens (i procent) som krävs för att sänka en sats."

#. from tp:gcc-16.1-b20260222
msgid "The number of cycles the swing modulo scheduler considers when checking conflicts using DFA."
msgstr "Antalet cykler som pendlingsschemaläggaren beaktar när den söker efter konflikter med DFA."

#. from tp:gcc-16.1-b20260222
msgid "A threshold on the average loop count considered by the swing modulo scheduler."
msgstr "Ett tröskelvärde på det genomsnittliga antalet varv som beaktas av pendlingsmoduloschemaläggaren."

#. from tp:gcc-16.1-b20260222
msgid "A factor for tuning the upper bound that swing modulo scheduler uses for scheduling a loop."
msgstr "En faktor för att trimma den övre gränsen som pendlingsmoduloschemaläggaren använder för att schemalägga en slinga."

#. from tp:gcc-16.1-b20260222
msgid "The minimum value of stage count that swing modulo scheduler generates."
msgstr "Minimivärdet för antalet steg som pendlingsmoduloschemaläggaren genererar."

#. from tp:gcc-16.1-b20260222
msgid "Maximum size, in storage units, of an aggregate which should be considered for scalarization when compiling for size."
msgstr "Maximal storlek, i lagringsenheter, av ett aggregat som skall övervägas för skalärisering vid kompilering för storlek."

#. from tp:gcc-16.1-b20260222
msgid "Maximum size, in storage units, of an aggregate which should be considered for scalarization when compiling for speed."
msgstr "Maximal storlek, i lagringsenheter, av ett aggregat som skall övervägas för skalärisering vid kompilering för hastighet."

#. from tp:gcc-16.1-b20260222
msgid "Maximum number of artificial accesses to enable forward propagation that Scalar Replacement of Aggregates keeps for one local variable."
msgstr "Maximalt antal artificiella åtkomster för att aktivera framåtpropagering som Skalär ersättning av aggregat behåller för en lokal variabel."

#. from tp:gcc-16.1-b20260222
msgid "The maximum number of SSA_NAME assignments to follow in determining a value."
msgstr "Det maximala antalet SSA_NAME-tilldelningar att följa för att avgöra ett värde."

#. from tp:gcc-16.1-b20260222
msgid "The lower bound for a buffer to be considered for stack smashing protection."
msgstr "Den undre gränsen för att en buffert skall övervägas för skydd mot stacksprängning."

#. from tp:gcc-16.1-b20260222
msgid "Size of the stack guard expressed as a power of two in bytes."
msgstr "Storleken på stackvakten uttryckt som en potens av två i byte."

#. from tp:gcc-16.1-b20260222
msgid "Interval in which to probe the stack expressed as a power of two in bytes."
msgstr "Intervall inom vilket stacken skall testas uttryckt som en potens av två i byte."

#. from tp:gcc-16.1-b20260222
msgid "Allow the store merging pass to introduce unaligned stores if it is legal to do so."
msgstr "Tillåt passet för lagringssammanslagning att introducera ojusterade lagringar om det är tillåtet att göra det."

#. from tp:gcc-16.1-b20260222
msgid "Maximum size of a single store merging region in bytes."
msgstr "Maximala storleken på en enda lagringssammanslagningsregion i byte."

#. from tp:gcc-16.1-b20260222
msgid "Maximum number of instruction distance that a small store forwarded to a larger load may stall. Value '0' disables the cost checks for the avoid-store-forwarding pass."
msgstr "Maximalt instruktionsavstånd som en liten lagring som vidarebefordras till en större laddning kan fördröjas. Värdet ”0” avaktiverar kostnadskontroller för passet för att undvika lagringsvidarebefordran."

#. from tp:gcc-16.1-b20260222
msgid "The maximum ratio between array size and switch branches for a switch conversion to take place."
msgstr "Det maximala förhållandet mellan vektorstorlek och switch-grenar för att en switch-konvertering skall ske."

#. from tp:gcc-16.1-b20260222
msgid "Maximum number of bases stored in each modref tree."
msgstr "Maximalt antal baser som lagras i varje modref-träd."

#. from tp:gcc-16.1-b20260222
msgid "Maximum number of references stored in each modref base."
msgstr "Maximalt antal referenser som lagras i varje modref-bas."

#. from tp:gcc-16.1-b20260222
msgid "Maximum number of accesses stored in each modref reference."
msgstr "Maximalt antal åtkomster som lagras i varje modref-referens."

#. from tp:gcc-16.1-b20260222
msgid "Maximum number of tests performed by modref query."
msgstr "Maximalt antal tester som utförs av modref-frågor."

#. from tp:gcc-16.1-b20260222
msgid "Maximum depth of DFS walk used by modref escape analysis."
msgstr "Maximalt djup hos DFS-vandringen som används av modref-flyktanalys."

#. from tp:gcc-16.1-b20260222
msgid "Maximum number of escape points tracked by modref per SSA-name."
msgstr "Maximalt antal flyktpunkter spårade av modref per SSA-namn."

#. from tp:gcc-16.1-b20260222
msgid "Maximum number of times a given range is adjusted during the dataflow."
msgstr "Maximalt antal gånger som ett angivet intervall justeras under dataflödet."

#. from tp:gcc-16.1-b20260222
msgid "--param=threader-debug=[none|all] Enables verbose dumping of the threader solver."
msgstr "--param=threader-debug=[none|all] Aktiverar utförlig utskrift från trådarens lösare."

#. from tp:gcc-16.1-b20260222
msgid "Size in bytes after which thread-local aggregates should be instrumented with the logging functions instead of save/restore pairs."
msgstr "Storlek i byte efter vilken trådlokala aggregat skall instrumenteras med loggningsfunktioner istället för spara/återställ-par."

#. from tp:gcc-16.1-b20260222
msgid "The percentage of function, weighted by execution frequency, that must be covered by trace formation. Used when profile feedback is not available."
msgstr "Andelen av en funktion, i procent och viktad efter exekveringsfrekvens, som måste täckas av spårbildning.  Används när profileringsåterkoppling inte är tillgänglig."

#. from tp:gcc-16.1-b20260222
msgid "The percentage of function, weighted by execution frequency, that must be covered by trace formation. Used when profile feedback is available."
msgstr "Andelen av en funktion, i procent och viktad efter exekveringsfrekvens, som måste täckas av spårbildning.  Används när profileringsåterkoppling är tillgänglig."

#. from tp:gcc-16.1-b20260222
msgid "Maximal code growth caused by tail duplication (as a percentage)."
msgstr "Maximal kodtillväxt orsakad av svansduplicering (som en procentsats)."

#. from tp:gcc-16.1-b20260222
msgid "Stop forward growth if the probability of best edge is less than this threshold (as a percentage). Used when profile feedback is not available."
msgstr "Stoppa framåttillväxt om sannolikheten för den bästa bågen är mindre än detta tröskelvärde (i procent).  Används när profileringsåterkoppling inte är tillgänglig."

#. from tp:gcc-16.1-b20260222
msgid "Stop forward growth if the probability of best edge is less than this threshold (as a percentage). Used when profile feedback is available."
msgstr "Stoppa framåttillväxt om sannolikheten för den bästa bågen är mindre än detta tröskelvärde (i procent).  Används när profileringsåterkoppling är tillgänglig."

#. from tp:gcc-16.1-b20260222
msgid "Stop reverse growth if the reverse probability of best edge is less than this threshold (as a percentage)."
msgstr "Stoppa omvänd tillväxt om den omvända sannolikheten för den bästa bågen är mindre än detta tröskelvärde (i procent)."

#. from tp:gcc-16.1-b20260222
msgid "Set the maximum number of instructions executed in parallel in reassociated tree.  If 0, use the target-dependent heuristic."
msgstr "Sätt maximala antalet instruktioner som exekveras parallellt i ett reassociativt träd.  Om 0, använd den målberoende heuristiken."

#. from tp:gcc-16.1-b20260222
msgid "Emit special instrumentation for accesses to volatiles."
msgstr "Mata ut specialinstrumentering för åtkomst av volatile:r."

#. from tp:gcc-16.1-b20260222
msgid "Emit instrumentation calls to __tsan_func_entry() and __tsan_func_exit()."
msgstr "Mata ut instrumenteringsanrop till __tsan_func_entry() och __tsan_func_exit()."

#. from tp:gcc-16.1-b20260222
msgid "Maximum number of nested calls to search for control dependencies during uninitialized variable analysis."
msgstr "Det maximala antalet nästade anrop att söka i efter styrberoenden under analys av oinitierade variabler."

#. from tp:gcc-16.1-b20260222
msgid "Maximum number of predicates anded for each predicate ored in the normalized predicate chain."
msgstr "Maximalt antal predikat med ”and” för varje predikat med ”or” i den normaliserade predikatkedjan."

#. from tp:gcc-16.1-b20260222
msgid "Maximum number of predicates ored in the normalized predicate chain."
msgstr "Maximalt antal predikat med ”or” i den normaliserade predikatkedjan."

#. from tp:gcc-16.1-b20260222
msgid "Maximum amount of work done to prune paths where the variable is always initialized."
msgstr "Maximal mäng arbete som görs för att ansa vägar där variabeln alltid är initierad."

#. from tp:gcc-16.1-b20260222
msgid "Instruction accounted for function prologue, epilogue and other overhead."
msgstr "Instruktioner som räknas för funktionsprolog, -epilog och andra omkostnader."

#. from tp:gcc-16.1-b20260222
msgid "Time accounted for function prologue, epilogue and other overhead."
msgstr "Tid inräknad för funktionprolog, -epilog och andra omkostnader."

#. from tp:gcc-16.1-b20260222
msgid "Instruction accounted for function thunk overhead."
msgstr "Instruktion inräknad för funktionssnuttsomkostnader."

#. from tp:gcc-16.1-b20260222
msgid "Time accounted for function thunk overhead."
msgstr "Tid inräknad för funktionssnuttsomkostnader."

#. from tp:gcc-16.1-b20260222
msgid "The denominator n of fraction 1/n of the number of profiled runs of the entire program below which the execution count of a basic block must be in order for the basic block to be considered unlikely."
msgstr "Nämnaren n i bråket 1/n av antalet profilerade körningar av hela programmet, under vilken ett grundblocks exekveringsantal måste ligga för att grundblocket ska anses osannolikt."

#. from tp:gcc-16.1-b20260222
msgid "Maximum unroll factor for the unroll-and-jam transformation."
msgstr "Maximal utrullningsfaktor för transformationen unroll-and-jam."

#. from tp:gcc-16.1-b20260222
msgid "Minimum percentage of memrefs that must go away for unroll-and-jam to be considered profitable."
msgstr "Minimal procent av minnesreferenser som måste försvinna för att unroll-and-jam skall betraktas som lönsamt."

#. from tp:gcc-16.1-b20260222
msgid "Use direct poisoning/unpoisoning instructions for variables smaller or equal to this number."
msgstr "Använd direkta förgiftnings-/avgiftningsinstruktioner för variabler som är mindre eller lika med detta tal."

#. from tp:gcc-16.1-b20260222
msgid "Whether to use canonical types."
msgstr "Om kanoniska typer skall användas."

#. from tp:gcc-16.1-b20260222
msgid "Enable loop epilogue vectorization using smaller vector size."
msgstr "Aktivera vektorisering av slingepiloger med mindre vektorstorlek."

#. from tp:gcc-16.1-b20260222
msgid "Maximum number of possible vector layouts (such as permutations) to consider when optimizing to-be-vectorized code."
msgstr "Maximalt antal möjliga vektorlayouter (såsom permutationer) att beakta vid optimering av kod som ska vektoriseras."

#. from tp:gcc-16.1-b20260222
msgid "Maximum number of loop peels to enhance alignment of data references in a loop."
msgstr "Maximala antalet slingavskalningar för att förbättra justering av datareferenser i en slinga."

#. from tp:gcc-16.1-b20260222
msgid "Bound on number of runtime checks inserted by the vectorizer's loop versioning for alias check."
msgstr "Gräns för antalet körtidskontroller som läggs in av vektoriserarens slingversionering för aliaskontroller."

#. from tp:gcc-16.1-b20260222
msgid "Bound on number of runtime checks inserted by the vectorizer's loop versioning for alignment check."
msgstr "Gräns för antalet körtidskontroller som läggs in av vektoriserarens slingversionering för justeringskontroller."

#. from tp:gcc-16.1-b20260222
msgid "Controls how loop vectorizer uses partial vectors.  0 means never, 1 means only for loops whose need to iterate can be removed, 2 means for all loops.  The default value is 2."
msgstr "Styr hur slingvektoriseraren använder partiella vektorer. 0 betyder aldrig, 1 betyder endast för slingor vars behov att iterera kan tas bort, 2 betyder för alla slingor. Standardvärdet är 2."

#. from tp:gcc-16.1-b20260222
msgid "The maximum factor which the loop vectorizer applies to the cost of statements in an inner loop relative to the loop being vectorized."
msgstr "Den maximala faktorn som slingvektoriseraren använder på kostnaden av satser i en inre slinga relativt slingan som vektoriseras."

#. from tp:gcc-16.1-b20260222
msgid "Enable loop vectorization of floating point inductions."
msgstr "Aktivera slingvektorisering av flyttalsinduktioner."

#. from tp:gcc-16.1-b20260222
msgid "The scaling multiplier as a percentage to apply to all scalar loop costing when performing vectorization profitability analysis.  The default value is 100."
msgstr "Skalningsfaktorn i procent som ska tillämpas på alla skalära slingkostnader när vektoriseringslönsamhetsanalys utförs. Standardvärdet är 100."

#. from tp:gcc-16.1-b20260222
msgid "Maximum number of basic blocks before VRP switches to a fast model with less memory requirements."
msgstr "Maximalt antal grundblock innan VRP byter till en snabb modell med mindre minneskrav."

#. from tp:gcc-16.1-b20260222
msgid "Maximum number of steps when inferring a value range from a load from a constant aggregate."
msgstr "Maximalt antal steg vid slutledning av ett värdeintervall från en laddning från ett konstant aggregat."

#. from tp:gcc-16.1-b20260222
msgid "Maximum number of basic blocks before VRP uses a sparse bitmap cache."
msgstr "Maximalt antal grundblock innan VRP använder en gles bitkartecache."

#. from tp:gcc-16.1-b20260222
msgid "Maximum number of outgoing edges in a switch before VRP does not process it."
msgstr "Maximalt antal utgående bågar i en switch innan VRP inte bearbetar den."

#. from tp:gcc-16.1-b20260222
msgid "Maximum number of basic blocks for VRP to use a basic cache vector."
msgstr "Maximalt antal grundblock för att VRP ska använda en grundläggande cachevektor."

#. from tp:gcc-16.1-b20260222
msgid "The maximum number of 'after supernode' exploded nodes within the analyzer per supernode, before terminating analysis."
msgstr "Maximala antalet ”efter supernod”-exploderade noder inom analyseraren per supernod, före analysen avslutas."

#. from tp:gcc-16.1-b20260222
msgid "The maximum number of exploded nodes per program point within the analyzer, before terminating analysis of that point."
msgstr "Det maximala antalet exploderade noder per programpunkt inom analyseraren, före analysen avslutas vid den punkten."

#. from tp:gcc-16.1-b20260222
msgid "The maximum number of constraints per state."
msgstr "Det maximala antalet begränsningar per tillstånd."

#. from tp:gcc-16.1-b20260222
msgid "The maximum number of infeasible edges to reject before declaring a diagnostic as infeasible."
msgstr "Maximalt antal ogenomförbara bågar att förkasta innan ett diagnostikmeddelande förklaras ogenomförbart."

#. from tp:gcc-16.1-b20260222
msgid "The maximum number of times a callsite can appear in a call stack within the analyzer, before terminating analysis of a call that would recurse deeper."
msgstr "Det maximala antalet gånger en anropssajt kan förekomma i en anropsstack inom analyseraren, före analysen avslutas av ett anrop som skulle göra en djupare rekursion."

#. from tp:gcc-16.1-b20260222
msgid "The maximum depth of a symbolic value, before approximating the value as unknown."
msgstr "Maximalt djup för ett symboliskt värde innan värdet approximeras som okänt."

#. from tp:gcc-16.1-b20260222
msgid "The minimum number of supernodes within a function for the analyzer to consider summarizing its effects at call sites."
msgstr "Det minsta antalet supernoder inom en funktion för att analyseraren skall överväga att summera dess effekter vid anropssajter."

#. from tp:gcc-16.1-b20260222
msgid "The maximum depth of exploded nodes that should appear in a dot dump before switching to a less verbose format."
msgstr "Det maximala djupet av exploderade noder som skall förekomma i en dot-dump före byte till ett mindre utförligt format."

#. from tp:gcc-16.1-b20260222
msgid "The number of bytes at which to ellipsize string literals in analyzer text art diagrams."
msgstr "Antalet byte vid vilket stränglitteraler i analyserarens textkonstdiagram ska förkortas med ellips."

#. from tp:gcc-16.1-b20260222
msgid "The number of literal bytes to show at the head of a string literal in text art when ellipsizing it."
msgstr "Antalet literala byte att visa vid huvudet av en strängliteral i textkonst när den har ellips."

#. from tp:gcc-16.1-b20260222
msgid "The number of literal bytes to show at the tail of a string literal in text art when ellipsizing it."
msgstr "Antalet literala byt att visa vid slutet av en strängliteral i textkonst när den har ellips."

#. from tp:gcc-16.1-b20260222
msgid "The ideal width in characters of text art diagrams generated by the analyzer."
msgstr "Den ideala bredden i tecken för textkonstdiagram som genereras ava analysatorn."

#. from tp:gcc-16.1-b20260222
msgid "Warn about code paths in which a pointer to a buffer is assigned to an incompatible type."
msgstr "Varna för kodvägar i vilka en pekare till en buffert tilldelas till en inkompatibel typ."

#. from tp:gcc-16.1-b20260222
msgid "Warn about code paths in which a pointer is checked for NULL after it has already been dereferenced."
msgstr "Varna för kodvägar i vilka en pekare undersöks om den är NULL efter att den redan har derefererats."

#. from tp:gcc-16.1-b20260222
msgid "Warn about code paths in which a stdio FILE can be closed more than once."
msgstr "Varna för kodvägar i vilka en stdio FILE kan stängas mer än en gång."

#. from tp:gcc-16.1-b20260222
msgid "Warn about code paths in which a pointer can be freed more than once."
msgstr "Varna för kodvägar i vilka en pekare kan frigöras mer än en gång."

#. from tp:gcc-16.1-b20260222
msgid "Warn about code paths in which sensitive data is written to a file."
msgstr "Varna för kodvägar i vilka känslig data skrivs till en fil."

#. from tp:gcc-16.1-b20260222
msgid "Warn about code paths in which sensitive data is copied across a security boundary."
msgstr "Varna för kodvägar i vilka känslig data kopieras över en säkerhetsgräns."

#. from tp:gcc-16.1-b20260222
msgid "Warn about code paths in which read on a write-only file descriptor is attempted, or vice versa."
msgstr "Varna för kodvägar i vilka försök att läsa från en endast skrivbar filbeskrivare görs, eller vice versa."

#. from tp:gcc-16.1-b20260222
msgid "Warn about code paths in which a file descriptor can be closed more than once."
msgstr "Varna för kodvägar i vilka en filbeskrivare kan stängas mer än en gång."

#. from tp:gcc-16.1-b20260222
msgid "Warn about code paths in which a file descriptor is not closed."
msgstr "Varna för kodvägar i vilka en filbeskrivare inte stängs."

#. from tp:gcc-16.1-b20260222
msgid "Warn about code paths in which an operation is attempted in the wrong phase of a file descriptor's lifetime."
msgstr "Varna för kodvägar i vilka en ågärd försöker göras i fel fas av en filbeskrivares livstid."

#. from tp:gcc-16.1-b20260222
msgid "Warn about code paths in which an operation is attempted on the wrong type of file descriptor."
msgstr "Varna för kodvägar i vilka en åtgärd försöker göras med fel typ av filbeskrivare."

#. from tp:gcc-16.1-b20260222
msgid "Warn about code paths in which a read or write is performed on a closed file descriptor."
msgstr "Varna för kodvägar i vilka en läsning eller skrivning görs med en stängd filbeskrivare."

#. from tp:gcc-16.1-b20260222
msgid "Warn about code paths in which a file descriptor is used without being checked for validity."
msgstr "Varna för kodvägar i vilka en filbeskrivare används utan att dess giltighet kontrolleras."

#. from tp:gcc-16.1-b20260222
msgid "Warn about code paths in which a stdio FILE is not closed."
msgstr "Varna för kodvägar i vilka en stdio-FILE inte stängs."

#. from tp:gcc-16.1-b20260222
msgid "Warn about code paths in which a non-heap pointer is freed."
msgstr "Varna för kodvägar i vilka en pekare till annat än heap:en frigörs."

#. from tp:gcc-16.1-b20260222
msgid "Warn about code paths in which floating-point arithmetic is used in locations where precise computation is needed."
msgstr "Varna för kodvägar i vilka flyttalsaritmetik används på platser där precis beräkning behövs."

#. from tp:gcc-16.1-b20260222
msgid "Warn about code paths which appear to lead to an infinite loop."
msgstr "Varna för kodvägar som förefaller leda till en oändlig slinga."

#. from tp:gcc-16.1-b20260222
msgid "Warn about code paths which appear to lead to infinite recursion."
msgstr "Varna för kodvägar vilka förefaller leda till oändlig rekursion."

#. from tp:gcc-16.1-b20260222
msgid "Warn about code paths in which a NULL function pointer is called."
msgstr "Varna för kodvägar i vilka en NULL-funktionspekare anropas."

#. from tp:gcc-16.1-b20260222
msgid "Warn about code paths in which a heap-allocated pointer leaks."
msgstr "Varna för kodvägar i vilka en heap-allokerad pekare läcker."

#. from tp:gcc-16.1-b20260222
msgid "Warn about code paths in which the wrong deallocation function is called."
msgstr "Varna för kodvägar i vilka fel avallokeringsfunktion anropas."

#. from tp:gcc-16.1-b20260222
msgid "Warn about code paths in which a write or read to a buffer is out-of-bounds."
msgstr "Varna för kodvägar där en skrivning till eller läsning från en buffert går utanför gränserna."

#. from tp:gcc-16.1-b20260222
msgid "Warn about code paths in which undefined behavior would occur due to overlapping buffers."
msgstr "Varna för kodvägar i vilka odefinierat beteende skulle uppstå på grund av överlappande buffertar."

#. from tp:gcc-16.1-b20260222
msgid "Warn about code paths in which a possibly-NULL value is passed to a must-not-be-NULL function argument."
msgstr "Varna för kodvägar i vilka ett möjligt NULL-värde skickas till ett får-inte-vara-NULL-funktionsargument."

#. from tp:gcc-16.1-b20260222
msgid "Warn about code paths in which a possibly-NULL pointer is dereferenced."
msgstr "Varna för kodvägar i vilka en möjlig NULL-pekare derefereras."

#. from tp:gcc-16.1-b20260222
msgid "Warn about code paths in which an async-signal-unsafe function is called from a signal handler."
msgstr "Varna för kodvägar i vilka en async-signal-unsafe-funktion anropas från en signalhanterare."

#. from tp:gcc-16.1-b20260222
msgid "Warn about code paths in which NULL is passed to a must-not-be-NULL function argument."
msgstr "Varna för kodvägar i vilka NULL skickas till ett får-inte-vara-NULL-funktionsargument."

#. from tp:gcc-16.1-b20260222
msgid "Warn about code paths in which a NULL pointer is dereferenced."
msgstr "Varna för kodvägar i vilka en NULL-pekare derefereras."

#. from tp:gcc-16.1-b20260222
msgid "Warn about code paths in which an on-stack buffer is passed to putenv."
msgstr "Varna för kodvägar i vilka en buffert på stacken skickas till putenv."

#. from tp:gcc-16.1-b20260222
msgid "Warn about code paths in which a shift with negative count is attempted."
msgstr "Varna för kodvägar där en skiftning med negativt antal försöker utföras."

#. from tp:gcc-16.1-b20260222
msgid "Warn about code paths in which a shift with count >= width of type is attempted."
msgstr "Varna för kodvägar där en skiftning med ett antal ≥ typens bredd försöker utföras."

#. from tp:gcc-16.1-b20260222
msgid "Warn about code paths in which a longjmp rewinds to a jmp_buf saved in a stack frame that has returned."
msgstr "Varna för kodvägar i vilka en longjmp hoppar tillbaka till en jmp_buf som sparades i en stackram som har returnerat."

#. from tp:gcc-16.1-b20260222
msgid "Warn about code paths in which an unsanitized value is used as an allocation size."
msgstr "Varna för kodvägar i vilka ett osanerat värde används som en allokeringsstorlek."

#. from tp:gcc-16.1-b20260222
msgid "Warn about code paths in which an unsanitized value is used as an array index."
msgstr "Varna för kodvägar i vilka ett osanerat värde används som ett vektorindex."

#. from tp:gcc-16.1-b20260222
msgid "Warn about code paths in which an 'assert()' is made involving an unsanitized value."
msgstr "Varna för kodvägar i vilka en ”assert()” görs med ett osanerat värde inblandat."

#. from tp:gcc-16.1-b20260222
msgid "Warn about code paths in which an unsanitized value is used as a divisor."
msgstr "Varna för kodvägar i vilka ett osanerat värde används som en nämnare."

#. from tp:gcc-16.1-b20260222
msgid "Warn about code paths in which an unsanitized value is used as a pointer offset."
msgstr "Varna för kodvägar i vilka ett osanerat värde används som ett pekaravstånd."

#. from tp:gcc-16.1-b20260222
msgid "Warn about code paths in which an unsanitized value is used as a size."
msgstr "Varna för kodvägar i vilka ett osanerat värde används som en storlek."

#. from tp:gcc-16.1-b20260222
msgid "Warn about code paths in which an exception of unexpected type is thrown."
msgstr "Varna för kodvägar i vilka ett undantag av oväntad typ kastas."

#. from tp:gcc-16.1-b20260222
msgid "Warn about code paths in which pointer subtraction involves undefined behavior."
msgstr "Varna för kodvägar i vilka pekarsubtraktion innebär odefinierat beteende."

#. from tp:gcc-16.1-b20260222
msgid "Warn about code paths in which a call is made to strtok with undefined behavior."
msgstr "Varna för kodvägar i vilka ett anrop görs av strtok med odefinierat beteende."

#. from tp:gcc-16.1-b20260222
msgid "Warn about code paths in which a freed value is used."
msgstr "Varna för kodvägar i vilka ett frigjort värde används."

#. from tp:gcc-16.1-b20260222
msgid "Warn about code paths in which a pointer to a stale stack frame is used."
msgstr "Varna för kodvägar där en pekare till en föråldrad stackram används."

#. from tp:gcc-16.1-b20260222
msgid "Warn about code paths in which va_arg uses the wrong type."
msgstr "Varna för kodvägar i vilka va_arg använder fel typ."

#. from tp:gcc-16.1-b20260222
msgid "Warn about code paths in which va_arg is used too many times on a va_list."
msgstr "Varna för kodvägar i vilka va_arg används för många gånger på en va_list."

#. from tp:gcc-16.1-b20260222
msgid "Warn about code paths in which va_start or va_copy is used without a corresponding va_end."
msgstr "Varna för kodvägar i vilka va_start eller va_copy används utan ett motsvarande va_end."

#. from tp:gcc-16.1-b20260222
msgid "Warn about code paths in which a va_list is used after va_end."
msgstr "Varna för kodvägar i vilka ett va_list används efter va_end."

#. from tp:gcc-16.1-b20260222
msgid "Warn about code paths which attempt to write to a const object."
msgstr "Varna för kodvägar i vilka försök görs att skriva till ett const-objekt."

#. from tp:gcc-16.1-b20260222
msgid "Warn about code paths which attempt to write to a string literal."
msgstr "Varna för kodvägar i vilka försök görs att skriva till en stränglitteral."

#. from tp:gcc-16.1-b20260222
msgid "Warn about code paths in which an uninitialized value is used."
msgstr "Varna för kodvägar i vilka ett oinitierat värde används."

#. from tp:gcc-16.1-b20260222
msgid "Warn if expressions are too complicated for the analyzer to fully track."
msgstr "Varna om uttryck är för komplicerade för att analyseraren skall kunna spåra dem fullständigt."

#. from tp:gcc-16.1-b20260222
msgid "Warn if the code is too complicated for the analyzer to fully explore."
msgstr "Varna om koden är för komplicerad för att analyseraren skall kunna utforska den fullständigt."

#. from tp:gcc-16.1-b20260222
msgid "Assume that no function calls can throw exceptions."
msgstr "Anta att inga funktionsanrop kan kasta undantag."

#. from tp:gcc-16.1-b20260222
msgid "Restrict the analyzer to run just the named checker."
msgstr "Begränsa analyseraren till att köra just den namngivna kontrollen."

#. from tp:gcc-16.1-b20260222
msgid "Add extra annotations to diagrams."
msgstr "Lägg till extra annotationer till diagram."

#. from tp:gcc-16.1-b20260222
msgid "Verify that paths are feasible when emitting diagnostics."
msgstr "Verifiera att vägar är genomförbara när diagnostik matas ut."

#. from tp:gcc-16.1-b20260222
msgid "Issue a note when diagnostics are deduplicated."
msgstr "Ge en notering när felmeddelanden avdupliceras."

#. from tp:gcc-16.1-b20260222
msgid "Simplify the supergraph before analyzing it."
msgstr "Förenkla supergrafen innan den analyseras."

#. from tp:gcc-16.1-b20260222
msgid "Purge unneeded state during analysis."
msgstr "Rensa ut tillstånd som inte behövs under analysen."

#. from tp:gcc-16.1-b20260222
msgid "Merge similar-enough states during analysis."
msgstr "Slå samman tillräckligt lika tillstånd under analysen."

#. from tp:gcc-16.1-b20260222
msgid "Stop exploring an execution path after certain diagnostics."
msgstr "Sluta att utforska en exekveringsväg efter visas felmeddelanden."

#. from tp:gcc-16.1-b20260222
msgid "Enable transitivity of constraints during analysis."
msgstr "Aktivera transitivitet av begränsningar under analysen."

#. from tp:gcc-16.1-b20260222
msgid "Show events within system headers in analyzer execution paths."
msgstr "Visa händelser inom systemhuvuden i analyserarens körvägar."

#. from tp:gcc-16.1-b20260222
msgid "Approximate the effect of function calls to simplify analysis."
msgstr "Approximera effekten av funktionsanrop för att förenkla analysen."

#. from tp:gcc-16.1-b20260222
msgid "Try to reconstruct function calls and returns after inlining."
msgstr "Försök att återskapa funktionsanrop och returer efter inline:ing."

#. from tp:gcc-16.1-b20260222
msgid "Emit more verbose descriptions of control flow in diagnostics."
msgstr "Mata ut mer utförliga beskrivningar av styrflödet i felmeddelanden."

#. from tp:gcc-16.1-b20260222
msgid "Emit more verbose descriptions of state changes in diagnostics."
msgstr "Mata ut mer utförliga beskrivningar av tillståndsändringar i felmeddelanden."

#. from tp:gcc-16.1-b20260222
msgid "Control which events are displayed in diagnostic paths."
msgstr "Styr vilka händelser som visas i diagnostikvägar."

#. from tp:gcc-16.1-b20260222
msgid "Dump various analyzer internals to SRCFILE.analyzer.txt."
msgstr "Dumpa diverse intern information om analyseraren till SRCFILE.analyzer.txt."

#. from tp:gcc-16.1-b20260222
msgid "Dump various analyzer internals to stderr."
msgstr "Dumpa diverse intern information om analyseraren till stderr."

#. from tp:gcc-16.1-b20260222
msgid "Dump the analyzer exploded graph to a SRCFILE.eg.dot file."
msgstr "Dumpa analyserarens exploderade graf till filen SRCFILE.eg.dot."

#. from tp:gcc-16.1-b20260222
msgid "Emit diagnostics showing the location of nodes in the exploded graph."
msgstr "Mata ut meddelanden som visar platsen för noder i den exploderade grafen."

#. from tp:gcc-16.1-b20260222
msgid "Dump a textual representation of the exploded graph to SRCFILE.eg.txt."
msgstr "Dumpa en textuell representation av den exploderade grafen till SRCFILE.eg.txt."

#. from tp:gcc-16.1-b20260222
msgid "Dump a textual representation of the exploded graph to SRCFILE.eg-ID.txt."
msgstr "Dumpa en textuell representation av den exploderade grafen till SRCFILE.eg-ID.txt."

#. from tp:gcc-16.1-b20260222
msgid "Dump a textual representation of each diagnostic's exploded path to SRCFILE.IDX.KIND.epath.txt."
msgstr "Dumpa en textuell representation av varje felmeddelandes exploderade väg till SRCFILE.IDX.KIND.epath.txt."

#. from tp:gcc-16.1-b20260222
msgid "Dump various analyzer internals to SRCFILE.*.fg.dot and SRCFILE.*.tg.dot."
msgstr "Dumpa diverse intern information om analyseraren till SRCFILE.*.fg.dot och SRCFILE.*.tg.dot."

#. from tp:gcc-16.1-b20260222
msgid "Dump various analyzer internals to SRCFILE.*.infinite-loop.dot."
msgstr "Dumpa diverse intern information om analyseraren till SRCFILE.*.infinite-loop.dot."

#. from tp:gcc-16.1-b20260222
msgid "Dump analyzer-specific data to a SRCFILE.analyzer.json.gz file."
msgstr "Dumpa analysspecifika data till filen SRCFILE.analyzer.json.gz."

#. from tp:gcc-16.1-b20260222
msgid "Dump state-purging information to a SRCFILE.state-purge.dot file."
msgstr "Dumpa tillståndsrensningsinformation till filen SRCFILE.state-purge.dot."

#. from tp:gcc-16.1-b20260222
msgid "Dump the analyzer supergraph to a SRCFILE.supergraph.dot file."
msgstr "Dumpa analyserarens supergraf till filen SRCFILE.supergraph.dot."

#. from tp:gcc-16.1-b20260222
msgid "Emit custom warnings with internal details intended for analyzer developers."
msgstr "Mata ut anpassade varningar med interna detaljer avsedda för analysatorutvecklare."

#. from tp:gcc-16.1-b20260222
msgid "Provide bash completion for options starting with provided string."
msgstr "Tillhandahåll bash-komplettering för flaggor som börjar med den angivna strängen."

#. from tp:gcc-16.1-b20260222
msgid "Display this information."
msgstr "Visa den här informationen."

#. from tp:gcc-16.1-b20260222
msgid "--help=<class>	Display descriptions of a specific class of options.  <class> is one or more of optimizers, target, warnings, undocumented, params."
msgstr "--help=<klass>	Visa beskrivningar av en speciell klass av flaggor.  <klass> är en eller flera av optimizers, target, warnings, undocumented, params."

#. from tp:gcc-16.1-b20260222
msgid "Display target specific command line options (including assembler and linker options)."
msgstr "Visa målspecifika kommandoradsflaggor (inklusive assembler- och länkarflaggor)."

#. from tp:gcc-16.1-b20260222
msgid "Passed to the linker."
msgstr "Skickas till länkaren."

#. from tp:gcc-16.1-b20260222
msgid "-O<number>	Set optimization level to <number>."
msgstr "-O<nummer>	Sätt optimeringsnivå till <nummer>."

#. from tp:gcc-16.1-b20260222
msgid "Optimize for space rather than speed."
msgstr "Optimera för storlek i stället för hastighet."

#. from tp:gcc-16.1-b20260222
msgid "Optimize for speed disregarding exact standards compliance."
msgstr "Optimera för hastighet och bortse från exakt efterlevnad av standarder."

#. from tp:gcc-16.1-b20260222
msgid "Optimize for debugging experience rather than speed or size."
msgstr "Optimera för bekväm felsökning snarare än storlek eller hastighet."

#. from tp:gcc-16.1-b20260222
msgid "Optimize for space aggressively rather than speed."
msgstr "Optimera aggressivt för storlek i stället för hastighet."

#. from tp:gcc-16.1-b20260222
msgid "-Q --help prints what options are enabled.  Just -Q enables verbose messages."
msgstr "-Q --help skriver ut vilka alternativ som är aktiverade. Bara -Q möjliggör utförliga meddelanden."

#. from tp:gcc-16.1-b20260222
msgid "Stop processing after generating assembly code; do not assemble."
msgstr "Sluta bearbeta efter generering av assemblerkod; assemblera inte."

#. from tp:gcc-16.1-b20260222
msgid "This switch is deprecated; use -Wextra instead."
msgstr "Denna flagga är föråldrad; använd -Wextra i stället."

#. from tp:gcc-16.1-b20260222
msgid "Warn about returning structures, unions or arrays."
msgstr "Varna för retur av poster, unioner eller vektorer."

#. from tp:gcc-16.1-b20260222
msgid "Warn if a loop with constant number of iterations triggers undefined behavior."
msgstr "Varna om en slinga med konstant antal iterationer orsakar odefinierat beteende."

#. from tp:gcc-16.1-b20260222
msgid "Warn if an array is accessed out of bounds."
msgstr "Varna om en vektor används utanför gränserna."

#. from tp:gcc-16.1-b20260222
msgid "Warn about problems with auto-profile data."
msgstr "Varna för problem med autoprofildata."

#. from tp:gcc-16.1-b20260222
msgid "Warn for uses of pointers to deallocated storage."
msgstr "Varna för användning av pekare till avallokerad lagring."

#. from tp:gcc-16.1-b20260222
msgid "Warn about inappropriate attribute usage."
msgstr "Varna för felaktig användning av attribut."

#. from tp:gcc-16.1-b20260222
msgid "Do not warn about specified attributes."
msgstr "Varna inte för angivna attribut."

#. from tp:gcc-16.1-b20260222
msgid "Warn about type safety and similar errors and mismatches in declarations with alias attributes."
msgstr "Varna för typsäkerhet och liknande fel och avsaknad av överensstämmelse i deklarationer med aliasattribut."

#. from tp:gcc-16.1-b20260222
msgid "Warn when profiling instrumentation was requested, but could not be applied to a certain function."
msgstr "Varna när profileringsinstrumentering begärdes men inte kunde tillämpas på en viss funktion."

#. from tp:gcc-16.1-b20260222
msgid "Warn about pointer casts which increase alignment."
msgstr "Varna för typkonvertering av pekare som ökar justeringen."

#. from tp:gcc-16.1-b20260222
msgid "Complain when a command-line option is valid, but not applicable to the current front end."
msgstr "Klaga när en kommandoradsflagga är giltig, men inte tillämplig på den aktuella framänden."

#. from tp:gcc-16.1-b20260222
msgid "Warn when a #warning directive is encountered."
msgstr "Varna när ett #warning-direktiv påträffas."

#. from tp:gcc-16.1-b20260222
msgid "Warn about uses of __attribute__((warning)) declarations."
msgstr "Varna för användning av __attribute__((warning))-deklarationer."

#. from tp:gcc-16.1-b20260222
msgid "Warn if a deprecated compiler feature, class, method, or field is used."
msgstr "Varna om en föråldrad kompilatorfunktion, klass, metod eller ett fält används."

#. from tp:gcc-16.1-b20260222
msgid "Warn about uses of __attribute__((deprecated)) declarations."
msgstr "Varna för användning av __attribute__((deprecated))-deklarationer."

#. from tp:gcc-16.1-b20260222
msgid "Warn when an optimization pass is disabled."
msgstr "Varna när ett optimerarpass är avaktiverat."

#. from tp:gcc-16.1-b20260222
msgid "Turn all warnings into errors."
msgstr "Gör om alla varningar till fel."

#. from tp:gcc-16.1-b20260222
msgid "Turn the specified warning into an error."
msgstr "Gör om den angivna varningen till ett fel."

#. from tp:gcc-16.1-b20260222
msgid "Print extra (possibly unwanted) warnings."
msgstr "Skriv extra (möjligen oönskade) varningar."

#. from tp:gcc-16.1-b20260222
msgid "Exit on the first error occurred."
msgstr "Avsluta vid första felet som uppstår."

#. from tp:gcc-16.1-b20260222
msgid "-Wframe-larger-than=<byte-size>	Warn if a function's stack frame requires in excess of <byte-size>."
msgstr "-Wframe-larger-than=<bytestorlek>	Varna om en funktions stackram har krav som överstiger <bytestorlek>."

#. from tp:gcc-16.1-b20260222
msgid "Disable -Wframe-larger-than= warning.  Equivalent to -Wframe-larger-than=<SIZE_MAX> or larger."
msgstr "Avaktivera varningen -Wframe-larger-than=.  Ekvivalent med -Wframe-larger-than=<SIZE_MAX> eller större."

#. from tp:gcc-16.1-b20260222
msgid "Warn when attempting to free a non-heap object."
msgstr "Varna vid försök att frigöra ett icke-heap-objekt."

#. from tp:gcc-16.1-b20260222
msgid "Warn when -fhardened did not enable an option from its set."
msgstr "Varna när -fardened inte aktiverade någon flagga från sin uppsättning."

#. from tp:gcc-16.1-b20260222
msgid "Warn when a switch case falls through."
msgstr "Varna när ett switch-fall faller igenom."

#. from tp:gcc-16.1-b20260222
msgid "Warn for infinitely recursive calls."
msgstr "Varna för oändligt rekursiva anrop."

#. from tp:gcc-16.1-b20260222
msgid "Warn when an inlined function cannot be inlined."
msgstr "Varna när en inline:ad funktion inte kan inline:as."

#. from tp:gcc-16.1-b20260222
msgid "Warn when an atomic memory model parameter is known to be outside the valid range."
msgstr "Varna när en atomär minnesmodellparameter med säkerhet är utanför det giltiga intervallet."

#. from tp:gcc-16.1-b20260222
msgid "-Wlarger-than=<byte-size>	Warn if an object's size exceeds <byte-size>."
msgstr "-Wlarger-than=<bytestorlek>	Varna om ett objekts storlek överskrider <bytestorlek>."

#. from tp:gcc-16.1-b20260222
msgid "Disable -Wlarger-than= warning.  Equivalent to -Wlarger-than=<SIZE_MAX> or larger."
msgstr "Avaktivera varningen -Wlarger-than=.  Ekvivalent med -Wlarger-than=<SIZE_MAX> eller större."

#. from tp:gcc-16.1-b20260222
msgid "Warn if comparing pointer parameter with nonnull attribute with NULL."
msgstr "Varna om en pekarparameter med attributet nonnull jämförs med NULL."

#. from tp:gcc-16.1-b20260222
msgid "Warn if dereferencing a NULL pointer may lead to erroneous or undefined behavior."
msgstr "Varna om dereferering av en NULL-pekare kan leda till felaktigt eller odefinierat beteende."

#. from tp:gcc-16.1-b20260222
msgid "Warn about passing a pointer/reference to a local or temporary variable to a musttail call argument."
msgstr "Varna för att skicka en pekare/referens till en lokal eller temporär variabel till ett argument till ett musttail-anrop."

#. from tp:gcc-16.1-b20260222
msgid "Warn about pointer/reference to a local or temporary variable possibly escaping to a musttail call."
msgstr "Varna för att en pekare/referens till en lokal eller temporär variabel kan läcka till ett musttail-anrop."

#. from tp:gcc-16.1-b20260222
msgid "Warn about some C++ One Definition Rule violations during link time optimization."
msgstr "Varna för vissa överträdelser av C++-endefinitionsregeln vid länktidsoptimering."

#. from tp:gcc-16.1-b20260222
msgid "Warn about overflow in arithmetic expressions."
msgstr "Varna för överspill i aritmetiska uttryck."

#. from tp:gcc-16.1-b20260222
msgid "During link time optimization warn about mismatched types of global declarations."
msgstr "Varna under länktidsoptimering för typer i globala deklarationer som inte stämmer överens."

#. from tp:gcc-16.1-b20260222
msgid "Warn when the packed attribute has no effect on struct layout."
msgstr "Varna när attributet packed inte har någon effekt på postformatet."

#. from tp:gcc-16.1-b20260222
msgid "Warn when padding is required to align structure members."
msgstr "Varna när utfyllnad krävs för att justera postmedlemmar."

#. from tp:gcc-16.1-b20260222
msgid "Issue warnings needed for strict compliance to the standard."
msgstr "Ge varningar som krävs för att strikt följa standarden."

#. from tp:gcc-16.1-b20260222
msgid "Warn about returning a pointer/reference to a local or temporary variable."
msgstr "Varna för retur av en pekare/referens till en lokal eller temporär variabel."

#. from tp:gcc-16.1-b20260222
msgid "Warn when one variable shadows another.  Same as -Wshadow=global."
msgstr "Varna när en variabel skuggar en annan.  Samma som -Wshadow=global."

#. from tp:gcc-16.1-b20260222
msgid "Warn when one variable shadows another (globally)."
msgstr "Varna när en variabel skuggar en annan (globalt)."

#. from tp:gcc-16.1-b20260222
msgid "Warn when one local variable shadows another local variable or parameter."
msgstr "Varna när en lokal variabel skuggar en annan lokal variabel eller parameter."

#. from tp:gcc-16.1-b20260222
msgid "Warn when one local variable shadows another local variable or parameter of compatible type."
msgstr "Varna när en lokal variabel skuggar en annan lokal variabel eller parameter med kompatibel typ."

#. from tp:gcc-16.1-b20260222
msgid "Warn when not issuing stack smashing protection for some reason."
msgstr "Varna när skydd mot stacköverskrivning av någon anledning inte matas ut."

#. from tp:gcc-16.1-b20260222
msgid "-Wstack-usage=<byte-size>	Warn if stack usage might exceed <byte-size>."
msgstr "-Wstack-usage=<bytestorlek>	Varna om stackanvändningen kan överskrida <bytestorlek>."

#. from tp:gcc-16.1-b20260222
msgid "Disable Wstack-usage= warning.  Equivalent to Wstack-usage=<SIZE_MAX> or larger."
msgstr "Avaktivera varningen -Wstack-usage=.  Ekvivalent med -Wstack-usage=<SIZE_MAX> eller större."

#. from tp:gcc-16.1-b20260222
msgid "Warn about code which might break strict aliasing rules."
msgstr "Varna för kod som kan bryta strikta aliasregler."

#. from tp:gcc-16.1-b20260222
msgid "Warn about optimizations that assume that signed overflow is undefined."
msgstr "Varna för optimeringar som antar att överspill med tecken är odefinierat."

#. from tp:gcc-16.1-b20260222
msgid "Warn about functions which might be candidates for __attribute__((cold))."
msgstr "Varna för funktioner som är möjliga kandidater för __attribute__((cold))."

#. from tp:gcc-16.1-b20260222
msgid "Warn about functions which might be candidates for __attribute__((const))."
msgstr "Varna för funktioner som är möjliga kandidater för __attribute__((const))."

#. from tp:gcc-16.1-b20260222
msgid "Warn about functions which might be candidates for __attribute__((pure))."
msgstr "Varna för funktioner som är möjliga kandidater för __attribute__((pure))."

#. from tp:gcc-16.1-b20260222
msgid "Warn about functions which might be candidates for __attribute__((noreturn))."
msgstr "Varna för funktioner som är möjliga kandidater för __attribute__((noreturn))."

#. from tp:gcc-16.1-b20260222
msgid "Warn about functions which might be candidates for __attribute__((malloc))."
msgstr "Varna för funktioner som är möjliga kandidater för __attribute__((malloc))."

#. from tp:gcc-16.1-b20260222
msgid "Warn about functions which might be candidates for __attribute__((returns_nonnull))."
msgstr "Varna för funktioner som är möjliga kandidater för __attribute__((returns_nonnull))."

#. from tp:gcc-16.1-b20260222
msgid "Warn about C++ polymorphic types where adding final keyword would improve code quality."
msgstr "Varna för polymorfa C++-typer där det skulle förbättra kodkvaliteten att lägga till nyckelordet final."

#. from tp:gcc-16.1-b20260222
msgid "Warn about C++ virtual methods where adding final keyword would improve code quality."
msgstr "Varna för virtuella C++-metoder där det skulle förbättra kodkvaliteten att lägga till nyckelordet final."

#. from tp:gcc-16.1-b20260222
msgid "Warn about statements between switch's controlling expression and the first case."
msgstr "Varna för satser mellan en switch-sats styruttryck och det första fallet."

#. from tp:gcc-16.1-b20260222
msgid "Do not suppress warnings from system headers."
msgstr "Undertryck inte varningar från systemhuvudfiler."

#. from tp:gcc-16.1-b20260222
msgid "Warn if a comparison always evaluates to true or false."
msgstr "Varna om en logisk jämförelse alltid beräknas till sant eller falskt."

#. from tp:gcc-16.1-b20260222
msgid "Warn whenever a trampoline is generated."
msgstr "Varna närhelst en trampolin genereras."

#. from tp:gcc-16.1-b20260222
msgid "Warn about cases where -ftrivial-auto-var-init cannot initialize an auto variable."
msgstr "Varna för fall där -ftrivial-auto-var-init inte kan initiera en auto-variabel."

#. from tp:gcc-16.1-b20260222
msgid "Warn if a comparison is always true or always false due to the limited range of the data type."
msgstr "Varna om en jämförelse alltid är sann eller falsk på grund av begränsat intervall för datatypen."

#. from tp:gcc-16.1-b20260222
msgid "Warn about uninitialized automatic variables."
msgstr "Varna för oinitierade automatiska variabler."

#. from tp:gcc-16.1-b20260222
msgid "Warn about maybe uninitialized automatic variables."
msgstr "Varna för eventuellt oinitierade automatiska variabler."

#. from tp:gcc-16.1-b20260222
msgid "Enable all -Wunused- warnings."
msgstr "Aktivera alla -Wunused-varningar."

#. from tp:gcc-16.1-b20260222
msgid "Warn when a function parameter is only set, otherwise unused."
msgstr "Varna när en funktionsparameter bara sätts, och i övrigt är oanvänd."

#. from tp:gcc-16.1-b20260222
msgid "Warn when a variable is only set, otherwise unused."
msgstr "Varna när en variabel bara sätts, och i övrigt är oanvänd."

#. from tp:gcc-16.1-b20260222
msgid "Warn when a function is unused."
msgstr "Varna när en funktion är oanvänd."

#. from tp:gcc-16.1-b20260222
msgid "Warn when a label is unused."
msgstr "Varna när en etikett är oanvänd."

#. from tp:gcc-16.1-b20260222
msgid "Warn when a function parameter is unused."
msgstr "Varna när en funktionsparameter är oanvänd."

#. from tp:gcc-16.1-b20260222
msgid "Warn when an expression value is unused."
msgstr "Varna när ett uttrycksvärde är oanvänt."

#. from tp:gcc-16.1-b20260222
msgid "Warn when a variable is unused."
msgstr "Varna när en variabel är oanvänd."

#. from tp:gcc-16.1-b20260222
msgid "Warn in case profiles in -fprofile-use do not match."
msgstr "Varna om profiler i -fprofile-use inte stämmer."

#. from tp:gcc-16.1-b20260222
msgid "Warn in case a function ends earlier than it begins due to an invalid linenum macros."
msgstr "Varna om en funktion slutar tidigare än den börjar på grund av ogiltiga linenum-makron."

#. from tp:gcc-16.1-b20260222
msgid "Warn when a conditional has too many terms and condition coverage profiling gives up instrumenting the expression."
msgstr "Varna när ett villkor har för många termer och villkorstäckningsprofileringen ger upp att instrumentera uttrycket."

#. from tp:gcc-16.1-b20260222
msgid "-fpath-coverage-limit=<number> Don't instrument functions path count exceeding <number>."
msgstr "-fpath-coverage-limit=<antal> Instrumentera inte funktioner vars antal vägar överskrider <antal>."

#. from tp:gcc-16.1-b20260222
msgid "Warn if a function exceeds the number of paths (controlled by -fpath-coverage-limit) and path coverage give up instrumenting the function. The limit is approximate and conservative and coverage might give up even if the actual number is slightly below the limit."
msgstr "Varna om en funktion överskrider antalet vägar (styrt av -fpath-coverage-limit) och vägtäckningen ger upp att instrumentera funktionen. Gränsen är ungefärlig och konservativ och täckningen kan ge upp även om det faktiska antalet är något under gränsen."

#. from tp:gcc-16.1-b20260222
msgid "Warn in case profiles in -fprofile-use do not exist."
msgstr "Varna om profiler i -fprofile-use inte finns."

#. from tp:gcc-16.1-b20260222
msgid "Warn when a vector operation is compiled outside the SIMD."
msgstr "Varna när en vektoroperation kompileras utanför SIMD:n."

#. from tp:gcc-16.1-b20260222
msgid "Warn about unsupported features in ThreadSanitizer."
msgstr "Varna för funktioner i ThreadSanitizer som inte stödjs."

#. from tp:gcc-16.1-b20260222
msgid "-aux-info <file>	Emit declaration information into <file>."
msgstr "-aux-info <fil>	Generera deklarationsinfo till <fil>."

#. from tp:gcc-16.1-b20260222
msgid "-d<letters>	Enable dumps from specific passes of the compiler."
msgstr "-d<bokstäver>	Slå på dumpning från specifika pass i kompilatorn."

#. from tp:gcc-16.1-b20260222
msgid "-dumpbase <file>	Set the file basename to be used for dumps."
msgstr "-dumpbase <fil>	Ange basfilnamn att användas för dumpar."

#. from tp:gcc-16.1-b20260222
msgid "-dumpbase-ext .<ext>    Drop a trailing .<ext> from the dump basename to name auxiliary output files."
msgstr "-dumpbase-ext .<änd>    Ta bort avslutande .<änd> från dumpbasnamnet för att namge extra utmatningsfiler."

#. from tp:gcc-16.1-b20260222
msgid "-dumpdir <dir>	Set the directory name to be used for dumps."
msgstr "-dumpdir <kat>	Ange katalognamn att användas för dumpar."

#. from tp:gcc-16.1-b20260222
msgid "The version of the C++ ABI in use."
msgstr "Versionen av C++-ABI:et som används."

#. from tp:gcc-16.1-b20260222
msgid "Aggressively optimize loops using language constraints."
msgstr "Optimera aggressivt slingor med användning av språkbegränsningar."

#. from tp:gcc-16.1-b20260222
msgid "Align the start of functions."
msgstr "Justera starten av funktioner."

#. from tp:gcc-16.1-b20260222
msgid "Align labels which are only reached by jumping."
msgstr "Justera etiketter som bara nås via hopp."

#. from tp:gcc-16.1-b20260222
msgid "Align all labels."
msgstr "Justera alla etiketter."

#. from tp:gcc-16.1-b20260222
msgid "Align the start of loops."
msgstr "Justera starten av slingor."

#. from tp:gcc-16.1-b20260222
msgid "Allow the compiler to introduce new data races on stores."
msgstr "Tillåt kompilatorn att introducera nya datakapplöpningar (race conditions) vid lagringar."

#. from tp:gcc-16.1-b20260222
msgid "Enable static analysis pass."
msgstr "Aktivera statiska analyspass."

#. from tp:gcc-16.1-b20260222
msgid "Select what to sanitize."
msgstr "Välj vad som skall saneras."

#. from tp:gcc-16.1-b20260222
msgid "Select type of coverage sanitization."
msgstr "Välj typ av täckningssanering."

#. from tp:gcc-16.1-b20260222
msgid "-fasan-shadow-offset=<number>	Use custom shadow memory offset."
msgstr "-fasan-shadow-offset=<tal>	Använd anpassat avstånd till skuggminne."

#. from tp:gcc-16.1-b20260222
msgid "-fsanitize-sections=<sec1,sec2,...>	Sanitize global variables in user-defined sections."
msgstr "-fsanitize-sections=<sek1,sek2,…>	Sanera globala variabler i användardefinierade sektioner."

#. from tp:gcc-16.1-b20260222
msgid "After diagnosing undefined behavior attempt to continue execution."
msgstr "Efter att ha diagnostiserat odefinierat beteende, försök fortsätta körningen."

#. from tp:gcc-16.1-b20260222
msgid "This switch is deprecated; use -fsanitize-recover= instead."
msgstr "Denna flagga är föråldrad; använd -fsanitize-recover= i stället."

#. from tp:gcc-16.1-b20260222
msgid "Use traps instead of diagnostics of undefined behavior sanitizers."
msgstr "Använd trap istället för diagnostik av saniterare av odefinierat beteende."

#. from tp:gcc-16.1-b20260222
msgid "This switch is deprecated; use -fsanitize-trap= instead."
msgstr "Denna flagga är föråldrad; använd -fsanitize-trap= i stället."

#. from tp:gcc-16.1-b20260222
msgid "Generate unwind tables that are exact at each instruction boundary."
msgstr "Generera tabeller för upprullning som är exakta vid varje instruktionsgräns."

#. from tp:gcc-16.1-b20260222
msgid "Generate auto-inc/dec instructions."
msgstr "Generera auto-inc/dec-instruktioner."

#. from tp:gcc-16.1-b20260222
msgid "Use sample profile information for call graph node weights. The default profile file is fbdata.afdo in 'pwd'."
msgstr "Använd samplingsprofilsinformation för vikter i anropsgrafnoder.  Standardprofilfilen är fbdata.afdo i ”pwd”."

#. from tp:gcc-16.1-b20260222
msgid "Use sample profile information for call graph node weights. The profile file is specified in the argument."
msgstr "Använd samplingsprofilsinformation för vikter i anropsgrafnoder.  Profilfilen anges i argumentet."

#. from tp:gcc-16.1-b20260222
msgid "Perform inlining using auto-profile."
msgstr "Utför inlining med automatisk profil."

#. from tp:gcc-16.1-b20260222
msgid "Generate code to check bounds before indexing arrays."
msgstr "Generera kod för att kontrollera gränser före indexering i vektorer."

#. from tp:gcc-16.1-b20260222
msgid "Replace add, compare, branch with branch on count register."
msgstr "Ersätt addition, jämförelse och gren med gren på räknarregister."

#. from tp:gcc-16.1-b20260222
msgid "Use profiling information for branch probabilities."
msgstr "Använd profileringsinformation för grensannolikheter."

#. from tp:gcc-16.1-b20260222
msgid "Output callgraph information on a per-file basis."
msgstr "Skriv ut information om anropsgrafer för varje fil."

#. from tp:gcc-16.1-b20260222
msgid "Output callgraph information on a per-file basis with decorations."
msgstr "Skriv ut information om anropsgrafer för varje fil med dekorationer."

#. from tp:gcc-16.1-b20260222
msgid "-fcall-saved-<register>	Mark <register> as being preserved across functions."
msgstr "-fcall-saved-<register>	Markera att <register> bevaras mellan funktioner."

#. from tp:gcc-16.1-b20260222
msgid "-fcall-used-<register>	Mark <register> as being corrupted by function calls."
msgstr "-fcall-used-<register>	Markera att <register> förstörs av funktionsanrop."

#. from tp:gcc-16.1-b20260222
msgid "Save registers around function calls."
msgstr "Spara register runt funktionsanrop."

#. from tp:gcc-16.1-b20260222
msgid "This switch is deprecated; do not use."
msgstr "Denna flagga bör undvikas, använd den inte."

#. from tp:gcc-16.1-b20260222
msgid "Check the return value of new in C++."
msgstr "Kontrollera returvärdet av new i C++."

#. from tp:gcc-16.1-b20260222
msgid "Perform internal consistency checkings."
msgstr "Utför interna konsistenskontroller."

#. from tp:gcc-16.1-b20260222
msgid "For -f*-prefix-map= options compare canonicalized pathnames rather than just strings."
msgstr "För flaggor av typ -f*-prefix-map= jämför kononiserade sökvägsnamn istället för bara strängar."

#. from tp:gcc-16.1-b20260222
msgid "Enable code hoisting."
msgstr "Aktivera kodhissning."

#. from tp:gcc-16.1-b20260222
msgid "Looks for opportunities to reduce stack adjustments and stack references."
msgstr "Söker efter möjligheter att minska stackjusteringar och stackreferenser."

#. from tp:gcc-16.1-b20260222
msgid "Put uninitialized globals in the common section."
msgstr "Lägg oinitierade globala i den gemensamma sektionen."

#. from tp:gcc-16.1-b20260222
msgid "-fcompare-debug[=<opts>]	Compile with and without e.g. -gtoggle, and compare the final-insns dump."
msgstr "-fcompare-debug[=<flgr>]	Kompilera med och utan t.ex. -gtoggle, och jämför slutinstruktionsdumpen."

#. from tp:gcc-16.1-b20260222
msgid "Run only the second compilation of -fcompare-debug."
msgstr "Kör endast den andra kompileringen av -fcompare-debug."

#. from tp:gcc-16.1-b20260222
msgid "Perform comparison elimination after register allocation has finished."
msgstr "Utför eliminering av jämförelser efter att registertilldelningen har avslutats."

#. from tp:gcc-16.1-b20260222
msgid "Do not perform optimizations increasing noticeably stack usage."
msgstr "Utför inte optimeringar som märkbart ökar stackanvändningen."

#. from tp:gcc-16.1-b20260222
msgid "Perform a register copy-propagation optimization pass."
msgstr "Utför ett optimeringspass för kopieringspropagering av register."

#. from tp:gcc-16.1-b20260222
msgid "Fold instructions calculating memory offsets to the memory access instruction if possible."
msgstr "Fäll om möjligt instruktioner som beräknar minnesförskjutningar in i minnesåtkomstinstruktionen."

#. from tp:gcc-16.1-b20260222
msgid "Perform cross-jumping optimization."
msgstr "Utför optimering för korshopp."

#. from tp:gcc-16.1-b20260222
msgid "When running CSE, follow jumps to their targets."
msgstr "När CSE körs, följ hopp till deras mål."

#. from tp:gcc-16.1-b20260222
msgid "Omit range reduction step when performing complex division."
msgstr "Uteslut intervallreduktionssteget när komplex division görs."

#. from tp:gcc-16.1-b20260222
msgid "Complex multiplication and division follow Fortran rules."
msgstr "Komplex multiplikation och division följer Fortran-regler."

#. from tp:gcc-16.1-b20260222
msgid "Place data items into their own section."
msgstr "Placera dataobjekt i sin egen sektion."

#. from tp:gcc-16.1-b20260222
msgid "List all available debugging counters with their limits and counts."
msgstr "Lista alla tillgängliga felsökningsräknare med deras gränser och värden."

#. from tp:gcc-16.1-b20260222
msgid "-fdbg-cnt=<counter>[:<lower_limit1>-]<upper_limit1>[:<lower_limit2>-<upper_limit2>:...][,<counter>:...]	Set the debug counter limit."
msgstr "-fdbg-cnt=<räknare>[:<undre_gräns1>-]<övre_gräns1>[:<undre_gräns2>-<övre_gräns2>:…][,<räknare>:…]\tAnge gränsen för felsökningsräknaren."

#. from tp:gcc-16.1-b20260222
msgid "-fdebug-prefix-map=<old>=<new>	Map one directory name to another in debug information."
msgstr "-fdebug-prefix-map=<gammalt>=<nytt>\tAvbilda ett katalognamn till ett annat i felsökningsinformation."

#. from tp:gcc-16.1-b20260222
msgid "-ffile-prefix-map=<old>=<new>	Map one directory name to another in compilation result."
msgstr "-ffile-prefix-map=<gammalt>=<nytt>\tAvbilda ett katalognamn till ett annat i kompileringsresultatet."

#. from tp:gcc-16.1-b20260222
msgid "Output .debug_types section when using DWARF v4 debuginfo."
msgstr "Mata ut en .debug_types-sektion när DWARF v4 felsökningsinformation används."

#. from tp:gcc-16.1-b20260222
msgid "Defer popping functions args from stack until later."
msgstr "Senarelägg borttagandet av funktionsargument från stacken."

#. from tp:gcc-16.1-b20260222
msgid "Attempt to fill delay slots of branch instructions."
msgstr "Försök fylla greninstruktionernas fördröjningsluckor."

#. from tp:gcc-16.1-b20260222
msgid "Delete dead instructions that may throw exceptions."
msgstr "Ta bort döda instruktioner som kan kasta undantag."

#. from tp:gcc-16.1-b20260222
msgid "Delete useless null pointer checks."
msgstr "Ta bort onödiga nollpekarkontroller."

#. from tp:gcc-16.1-b20260222
msgid "Issue defining instructions back to back with their single uses, provided they are macro-fusible in the target microarchitecture."
msgstr "Lägg ut definierande instruktioner rygg mot rygg med deras enstaka användningar, förutsatt att de är makrosammanfogningsbara i målmikroarkitekturen."

#. from tp:gcc-16.1-b20260222
msgid "Stream extra data to support more aggressive devirtualization in LTO local transformation mode."
msgstr "Strömma extra data för att stödja mer aggressiv avvirtualisering i lokaltransformationsläge i LTO."

#. from tp:gcc-16.1-b20260222
msgid "Perform speculative devirtualization."
msgstr "Utför spekulativ avvirtualisering."

#. from tp:gcc-16.1-b20260222
msgid "Try to convert virtual calls to direct ones."
msgstr "Försök att konvertera virtuella anrop till direkta."

#. from tp:gcc-16.1-b20260222
msgid "-fdiagnostics-show-location=[once|every-line]	How often to emit source location at the beginning of line-wrapped diagnostics."
msgstr "-fdiagnostics-show-location=[once|every-line]\tAnge hur ofta källkodsplatsen ska matas ut i början av radbrutna diagnostikmeddelanden."

#. from tp:gcc-16.1-b20260222
msgid "Show the source line with a caret indicating the column."
msgstr "Visa källkodsrader med en cirkumflex som indikerar kolumnen."

#. from tp:gcc-16.1-b20260222
msgid "Show lines linking related events in diagnostic paths."
msgstr "Visa rader som länkar relaterade händelser som visas i diagnostikvägar."

#. from tp:gcc-16.1-b20260222
msgid "Show labels annotating ranges of source code when showing source."
msgstr "Visa etiketter som markerar avsnitt av källkod när källan visas."

#. from tp:gcc-16.1-b20260222
msgid "Show line numbers in the left margin when showing source."
msgstr "Visa radnummer i vänstermarginalen när källan visas."

#. from tp:gcc-16.1-b20260222
msgid "-fdiagnostics-color=[never|always|auto]	Colorize diagnostics."
msgstr "-fdiagnostics-color=[never|always|auto]	Färglägg felmeddelanden."

#. from tp:gcc-16.1-b20260222
msgid "Enable formatting of JSON output."
msgstr "Aktivera formatering av JSON-utdata."

#. from tp:gcc-16.1-b20260222
msgid "-fdiagnostics-urls=[never|always|auto]	Embed URLs in diagnostics."
msgstr "-fdiagnostics-urls=[never|always|auto]	Bädda in URL:ar i felmeddelanden."

#. from tp:gcc-16.1-b20260222
msgid "-fdiagnostics-column-unit=[display|byte]	Select whether column numbers are output as display columns (default) or raw bytes."
msgstr "-fdiagnostics-column-unit=[display|byte]	Välj huruvida kolumnnummer skrivs ut som visningskolumner (standard) eller råa byte."

#. from tp:gcc-16.1-b20260222
msgid "-fdiagnostics-column-origin=<number>	Set the number of the first column.  The default is 1-based as per GNU style, but some utilities may expect 0-based, for example."
msgstr "-fdiagnostics-column-origin=<nummer>	Ange numret på den första kolumnen. Standard är 1-baserat enligt GNU-stil, men några verktyg kan förvänta sig 0-baserat, till exempel."

#. from tp:gcc-16.1-b20260222
msgid "-fdiagnostics-format=[text|sarif-stderr|sarif-file]	Select output format."
msgstr "-fdiagnostics-format=[text|sarif-stderr|sarif-file]\tVälj utdataformat."

#. from tp:gcc-16.1-b20260222
msgid "Add output format."
msgstr "Lägg till utmatningsformat."

#. from tp:gcc-16.1-b20260222
msgid "Set output format."
msgstr "Sätt utmatningsformat."

#. from tp:gcc-16.1-b20260222
msgid "-fdiagnostics-escape-format=[unicode|bytes]	Select how to escape non-printable-ASCII bytes in the source for diagnostics that suggest it."
msgstr "-fdiagnostics-escape-format=[unicode|bytes]\tVälj hur icke-utskrivbara ASCII-byte i källkoden ska skrivas med escape-sekvenser i diagnostikmeddelanden som föreslår det."

#. from tp:gcc-16.1-b20260222
msgid "Print fix-it hints in machine-readable form."
msgstr "Skriv fix-it-tips i maskinläsbar form."

#. from tp:gcc-16.1-b20260222
msgid "Print fix-it hints to stderr in unified diff format."
msgstr "Skriv fix-it-tips till standardfel i enhetligt diff-format."

#. from tp:gcc-16.1-b20260222
msgid "Amend appropriate diagnostic messages with the command line option that controls them."
msgstr "Komplettera lämpliga diagnostikmeddelanden med den kommandoradsflagga som styr dem."

#. from tp:gcc-16.1-b20260222
msgid "Print CWE identifiers for diagnostic messages, where available."
msgstr "Skriv ut CWE-identifierare för felmeddelanden, där de är tillgängliga."

#. from tp:gcc-16.1-b20260222
msgid "Print any rules associated with diagnostic messages."
msgstr "Skriv ut regler associerade med diagnostikmeddelanden."

#. from tp:gcc-16.1-b20260222
msgid "Use color within diagnostic messages to highlight pertinent information."
msgstr "Använd färger i diagnostikmeddelanden för att markera relevant information."

#. from tp:gcc-16.1-b20260222
msgid "Specify how to print any control-flow path associated with a diagnostic."
msgstr "Ange hur kontrollflödesvägen associerad med ett felmeddelande skrivs ut."

#. from tp:gcc-16.1-b20260222
msgid "Turn off any diagnostics features that complicate the output, such as line numbers, color, and warning URLs."
msgstr "Slå av diagnostiska funktioner som komplicerar utdata, såsom radnummer, färg och varnings-URL:er."

#. from tp:gcc-16.1-b20260222
msgid "-ftabstop=<number>      Distance between tab stops for column reporting."
msgstr "Visa stackdjup för händelser i vägar."

#. from tp:gcc-16.1-b20260222
msgid "Show stack depths of events in paths."
msgstr "Visa stackdjup för händelser i vägar."

#. from tp:gcc-16.1-b20260222
msgid "-fdiagnostics-text-art-charset=[none|ascii|unicode|emoji]	Determine which characters to use in text arg diagrams."
msgstr "-fdiagnostics-text-art-charset=[none|ascii|unicode|emoji]	Bestäm vilka tecken som används i textargumentdiagram."

#. from tp:gcc-16.1-b20260222
msgid "Set minimum width of left margin of source code when showing source."
msgstr "Sätt minsta bredd på vänstermarginalen för källkod när källan visas."

#. from tp:gcc-16.1-b20260222
msgid "Use indentation to show nesting of diagnostics in text output."
msgstr "Använd indrag för att visa nästning av diagnostik i textutdata."

#. from tp:gcc-16.1-b20260222
msgid "Show location information when showing nested diagnostics."
msgstr "Visa platsinformation när nästad diagnostik visas."

#. from tp:gcc-16.1-b20260222
msgid "Show nesting levels as numbers when showing nested diagnostics."
msgstr "Visa nästningsnivåer som siffror när nästad diagnostik visas."

#. from tp:gcc-16.1-b20260222
msgid "Collect and print more context information for diagnostics."
msgstr "Samla in och skriv ut mer kontextinformation för diagnostik."

#. from tp:gcc-16.1-b20260222
msgid "-fdisable-[tree|rtl|ipa]-<pass>=range1+range2	Disable an optimization pass."
msgstr "-fdisable-[tree|rtl|ipa]-<pass>=range1+range2\tAvaktivera ett optimeringspass."

#. from tp:gcc-16.1-b20260222
msgid "-fenable-[tree|rtl|ipa]-<pass>=range1+range2	Enable an optimization pass."
msgstr "-fenable-[tree|rtl|ipa]-<pass>=range1+range2\tAktivera ett optimeringspass."

#. from tp:gcc-16.1-b20260222
msgid "-fdump-<type>	Dump various compiler internals to a file."
msgstr "-fdump-<typ>	Skriv ut diverse intern kompilatorinformation till en fil."

#. from tp:gcc-16.1-b20260222
msgid "-fdump-final-insns=filename	Dump to filename the insns at the end of translation."
msgstr "-fdump-final-insns=filnamn	Skriv instruktionerna vid slutet av översättningen till filnamn."

#. from tp:gcc-16.1-b20260222
msgid "-fdump-go-spec=filename	Write all declarations to file as Go code."
msgstr "-fdump-go-spec=filnamn	Skriv alla deklarationer till fil som Go-kod."

#. from tp:gcc-16.1-b20260222
msgid "Suppress output of addresses in debugging dumps."
msgstr "Undertryck utskrift av adresser i felsökningsutskrifter."

#. from tp:gcc-16.1-b20260222
msgid "Collect and dump debug information into temporary file if ICE in C/C++ compiler occurred."
msgstr "Samla och skriv ut felsökningsinformation till en temporärfil om ICE sker i C/C++-kompilatorn."

#. from tp:gcc-16.1-b20260222
msgid "Dump detailed information on GCC's internal representation of source code locations."
msgstr "Skriv ut detaljerad information om GCC:s interna representation av källkodsplatser."

#. from tp:gcc-16.1-b20260222
msgid "Dump optimization passes."
msgstr "Dumpa optimeringspass."

#. from tp:gcc-16.1-b20260222
msgid "Suppress output of instruction numbers, line number notes and addresses in debugging dumps."
msgstr "Undertryck utskrift av instruktionsantal, radnummernoteringar och -adresser i felsökningsutskrifter."

#. from tp:gcc-16.1-b20260222
msgid "Suppress output of previous and next insn numbers in debugging dumps."
msgstr "Undertryck utskrift av föregående och nästa instruktionsnummer i felsökningsutskrifter."

#. from tp:gcc-16.1-b20260222
msgid "Enable CFI tables via GAS assembler directives."
msgstr "Aktivera CFI-tabeller via GAS-assemblerdirektiv."

#. from tp:gcc-16.1-b20260222
msgid "Perform early inlining."
msgstr "Utför tidig inline:ing."

#. from tp:gcc-16.1-b20260222
msgid "Perform interprocedural reduction of aggregates."
msgstr "Utför interprocedurell reduktion av aggregat."

#. from tp:gcc-16.1-b20260222
msgid "Perform unused symbol elimination in debug info."
msgstr "Utför eliminering av oanvända symboler i felsökningsinformation."

#. from tp:gcc-16.1-b20260222
msgid "Perform unused type elimination in debug info."
msgstr "Utför eliminering av oanvända typer i felsökningsinformation."

#. from tp:gcc-16.1-b20260222
msgid "Do not suppress C++ class debug information."
msgstr "Undertryck inte felsökningsinformation för C++-klasser."

#. from tp:gcc-16.1-b20260222
msgid "Enable exception handling."
msgstr "Aktivera undantagshantering."

#. from tp:gcc-16.1-b20260222
msgid "Perform a number of minor, expensive optimizations."
msgstr "Utför ett antal smärre, dyra optimeringar."

#. from tp:gcc-16.1-b20260222
msgid "-fexcess-precision=[fast|standard|16]	Specify handling of excess floating-point precision."
msgstr "-fexcess-precision=[fast|standard|16]	Ange hantering av överskjutande precision på flyttal."

#. from tp:gcc-16.1-b20260222
msgid "-fpermitted-flt-eval-methods=[c11|ts-18661]	Specify which values of FLT_EVAL_METHOD are permitted."
msgstr "-fpermitted-flt-eval-methods=[c11|ts-18661]	Ange vilka värden på FLT_EVAL_METHOD som är tillåtna."

#. from tp:gcc-16.1-b20260222
msgid "Output lto objects containing both the intermediate language and binary output."
msgstr "Mata ut lto-objekt som innehåller både mellanspråket och binärutdata."

#. from tp:gcc-16.1-b20260222
msgid "Assume no NaNs or infinities are generated."
msgstr "Anta att inga NaN:er eller oändligheter genereras."

#. from tp:gcc-16.1-b20260222
msgid "Assume that loops with an exit will terminate and not loop indefinitely."
msgstr "Anta att slingor med en utgång avslutas och inte upprepas i oändlighet."

#. from tp:gcc-16.1-b20260222
msgid "-ffixed-<register>	Mark <register> as being unavailable to the compiler."
msgstr "-ffixed-<register>	Markera <register> som ej tillgängligt för kompilatorn."

#. from tp:gcc-16.1-b20260222
msgid "Don't allocate floats and doubles in extended-precision registers."
msgstr "Allokera inte float och double i register med utökad precision."

#. from tp:gcc-16.1-b20260222
msgid "Perform a forward propagation pass on RTL."
msgstr "Utför ett framåtpropageringspass på RTL."

#. from tp:gcc-16.1-b20260222
msgid "-ffp-contract=[off|on|fast]	Perform floating-point expression contraction."
msgstr "-ffp-contract=[off|on|fast]	Utför kontraktion av flyttalsuttryck."

#. from tp:gcc-16.1-b20260222
msgid "Allow built-in functions ceil, floor, round, trunc to raise \"inexact\" exceptions."
msgstr "Tillåt de inbyggda funktionerna ceil, floor, round, trunc att höja ”oexakt”-undantag."

#. from tp:gcc-16.1-b20260222
msgid "Allow function addresses to be held in registers."
msgstr "Tillåt att funktionsadresser läggs i register."

#. from tp:gcc-16.1-b20260222
msgid "Place each function into its own section."
msgstr "Placera varje funktion i sin egen sektion."

#. from tp:gcc-16.1-b20260222
msgid "Allow limited optimization of operations with volatile memory access."
msgstr "Tillåt begränsad optimering av operationer med flyktig minnesåtkomst."

#. from tp:gcc-16.1-b20260222
msgid "Perform global common subexpression elimination."
msgstr "Utför global eliminering av gemensamma deluttryck."

#. from tp:gcc-16.1-b20260222
msgid "Perform enhanced load motion during global common subexpression elimination."
msgstr "Utför förbättrad förflyttning av laddning under global eliminering av gemensamma deluttryck."

#. from tp:gcc-16.1-b20260222
msgid "Perform store motion after global common subexpression elimination."
msgstr "Utför förflyttning av lagring efter global eliminering av gemensamma deluttryck."

#. from tp:gcc-16.1-b20260222
msgid "Try to avoid store forwarding."
msgstr "Försök att undvika lagringsvidarebefordran."

#. from tp:gcc-16.1-b20260222
msgid "Perform redundant load after store elimination in global common subexpression elimination."
msgstr "Utför eliminering av överflödig laddning efter lagring i globala gemensamma deluttryck."

#. from tp:gcc-16.1-b20260222
msgid "Perform global common subexpression elimination after register allocation has finished."
msgstr "Utför global eliminering av gemensamma deluttryck efter att registertilldelning har avslutats."

#. from tp:gcc-16.1-b20260222
msgid "-fgnat-encodings=[all|gdb|minimal]	Select the balance between GNAT encodings and standard DWARF emitted in the debug information."
msgstr "-fgnat-encodings=[all|gdb|minimal]	Välj balansen mellan GNAT-kodningar och standard DWARF som skrivs ut i felsökningsinformationen."

#. from tp:gcc-16.1-b20260222
msgid "Enable in and out of Graphite representation."
msgstr "Aktivera in och ut från Graphite-representation."

#. from tp:gcc-16.1-b20260222
msgid "Enable Graphite Identity transformation."
msgstr "Aktivera Graphite-identitetstransformation."

#. from tp:gcc-16.1-b20260222
msgid "Enable hoisting adjacent loads to encourage generating conditional move instructions."
msgstr "Aktivera lyftning av intilliggande laddningar för att främja generering av villkorliga move-instruktioner."

#. from tp:gcc-16.1-b20260222
msgid "Run two instruction combination passes late in the pass pipeline; one before register allocation and one after."
msgstr "Kör två instruktionskombinationspass sent i pass-pipelinen; en före registerallokeringen och en efter."

#. from tp:gcc-16.1-b20260222
msgid "Mark all loops as parallel."
msgstr "Markera alla slingor som parallella."

#. from tp:gcc-16.1-b20260222
msgid "Enable loop nest transforms.  Same as -floop-nest-optimize."
msgstr "Aktivera transformationer av slingnästningar.  Samma som -floop-nest-optimize."

#. from tp:gcc-16.1-b20260222
msgid "Enable loop interchange on trees."
msgstr "Aktivera slingutbyten i träd."

#. from tp:gcc-16.1-b20260222
msgid "Perform unroll-and-jam on loops."
msgstr "Utför unroll-and-jam på slingor."

#. from tp:gcc-16.1-b20260222
msgid "Enable support for GNU transactional memory."
msgstr "Aktivera stöd för GNU:s transaktionsminne."

#. from tp:gcc-16.1-b20260222
msgid "Use STB_GNU_UNIQUE if supported by the assembler."
msgstr "Använd STB_GNU_UNIQUE om det stödjs av assemblern."

#. from tp:gcc-16.1-b20260222
msgid "Enable the loop nest optimizer."
msgstr "Aktivera optimeraren av slingnästning."

#. from tp:gcc-16.1-b20260222
msgid "Turn indirect calls of pointers loaded from structures to speculative calls if there is one known candidate."
msgstr "Gör om indirekta anrop av pekare som laddats från strukturer till spekulativa anrop om det finns en känd kandidat."

#. from tp:gcc-16.1-b20260222
msgid "Force bitfield accesses to match their type width."
msgstr "Tvinga bitfältsåtkomster att matcha sin typbredd."

#. from tp:gcc-16.1-b20260222
msgid "Merge adjacent stores."
msgstr "Slå samman intilliggande lagringar."

#. from tp:gcc-16.1-b20260222
msgid "Enable guessing of branch probabilities."
msgstr "Aktivera att grensannolikheter gissas."

#. from tp:gcc-16.1-b20260222
msgid "Enable various security-relevant flags."
msgstr "Aktivera olika säkerhetsrelevanta flaggor."

#. from tp:gcc-16.1-b20260222
msgid "Harden conditionals not used in branches, checking reversed conditions."
msgstr "Härda villkor som inte används i grenar, kontrollera omvända villkor."

#. from tp:gcc-16.1-b20260222
msgid "Harden conditional branches by checking reversed conditions."
msgstr "Härda villkorsgrenar genom att kontrollera omvända villkor."

#. from tp:gcc-16.1-b20260222
msgid "Harden control flow by recording and checking execution paths."
msgstr "Härda styrflödet genom att spela in och kontroller körvägar."

#. from tp:gcc-16.1-b20260222
msgid "Disable CFR in leaf functions."
msgstr "Avaktivera CFR i lövfunktioner."

#. from tp:gcc-16.1-b20260222
msgid "Check CFR execution paths also before calls followed by returns of their results."
msgstr "Kontrollera CFR-körvägar även före anrop som följs av att deras resultat returneras."

#. from tp:gcc-16.1-b20260222
msgid "Check CFR execution paths also when exiting a function through an exception."
msgstr "Kontrollera CFR-körvägen även vid avslut av en funktion genom ett undantag."

#. from tp:gcc-16.1-b20260222
msgid "-fhardcfr-check-noreturn-calls=[always|no-xthrow|nothrow|never]	Check CFR execution paths also before calling noreturn functions."
msgstr "-fhardcfr-check-noreturn-calls=[always|no-xthrow|nothrow|never]	Kontrollera CFR-körvägar även före anrop av noreturn-funktioner."

#. from tp:gcc-16.1-b20260222
msgid "Emit .ident assembler directives."
msgstr "Mata ut .ident assembler-direktiv."

#. from tp:gcc-16.1-b20260222
msgid "Perform conversion of conditional jumps to branchless equivalents."
msgstr "Utför konvertering av villkorliga hopp till grenlösa motsvarigheter."

#. from tp:gcc-16.1-b20260222
msgid "Perform conversion of conditional jumps to conditional execution."
msgstr "Utför konvertering av villkorliga hopp till villkorlig exekvering."

#. from tp:gcc-16.1-b20260222
msgid "-fstack-reuse=[all|named_vars|none]	Set stack reuse level for local variables."
msgstr "-fstack-reuse=[all|named_vars|none]	Ställ in stackåteranvändningsnivån för lokala variabler."

#. from tp:gcc-16.1-b20260222
msgid "Convert conditional jumps in innermost loops to branchless equivalents."
msgstr "Konvertera villkorliga hopp i innersta slingor till grenlösa motsvarigheter."

#. from tp:gcc-16.1-b20260222
msgid "Do not generate .size directives."
msgstr "Generera inte .size-direktiv."

#. from tp:gcc-16.1-b20260222
msgid "Perform indirect inlining."
msgstr "Utför indirekt inline:ing."

#. from tp:gcc-16.1-b20260222
msgid "Enable inlining of function declared \"inline\", disabling disables all inlining."
msgstr "Aktivera inline-infogning av funktioner deklarerade ”inline”; avaktivering stänger av all inline-infogning."

#. from tp:gcc-16.1-b20260222
msgid "Integrate functions into their callers when code size is known not to grow."
msgstr "Integrera funktioner i deras anropare när det är klart att kodstorleken inte växer."

#. from tp:gcc-16.1-b20260222
msgid "Integrate functions not declared \"inline\" into their callers when profitable."
msgstr "Integrera funktioner som inte deklarerats ”inline” i sina anropare när det är lönsamt."

#. from tp:gcc-16.1-b20260222
msgid "Integrate functions only required by their single caller."
msgstr "Integrera funktioner som endast behövs av deras enda anropare."

#. from tp:gcc-16.1-b20260222
msgid "-finline-limit=<number>	Limit the size of inlined functions to <number>."
msgstr "-finline-limit=<tal>	Begränsa storlek på inline-funktioner till <tal>."

#. from tp:gcc-16.1-b20260222
msgid "Inline __atomic operations when a lock free instruction sequence is available."
msgstr "Inline:a __atomic-operationer när en låsningsfri instruktionssekvens är tillgänglig."

#. from tp:gcc-16.1-b20260222
msgid "-finline-stringops[=memcmp|memcpy|memmove|memset] Expand supported mem/str operations inline, even if against optimization."
msgstr "-finline-stringops[=memcmp|memcpy|memmove|memset] Expandera de stödda mem/str-operationerna inline, även om det strider mot optimeringen."

#. from tp:gcc-16.1-b20260222
msgid "Equivalent to -fcf-protection=full."
msgstr "Ekvivalent med -fcf-protection=full."

#. from tp:gcc-16.1-b20260222
msgid "-fcf-protection=[full|branch|return|none|check]	Instrument functions with checks to verify jump/call/return control-flow transfer instructions have valid targets."
msgstr "-fcf-protection=[full|branch|return|none|check]	Instrumentera funktioner med kontroller för att verifiera att jump/call/return-instruktioner för styrflödesövergångar har giltiga mål."

#. from tp:gcc-16.1-b20260222
msgid "Instrument function entry and exit with profiling calls."
msgstr "Instrumentera funktionsingång och -utgång med profileringsanrop."

#. from tp:gcc-16.1-b20260222
msgid "Instrument function entry and exit with profiling calls invoked once."
msgstr "Instrumentera funktionsingång och -utgång med profileringsanrop som körs en gång."

#. from tp:gcc-16.1-b20260222
msgid "-finstrument-functions-exclude-function-list=name,...	Do not instrument listed functions."
msgstr "-finstrument-functions-exclude-function-list=namn,…	Instrumentera inte uppräknade funktioner."

#. from tp:gcc-16.1-b20260222
msgid "-finstrument-functions-exclude-file-list=filename,...	Do not instrument functions listed in files."
msgstr "-finstrument-functions-exclude-file-list=filenamn,…	Instrumentera inte funktioner uppräknade i filerna."

#. from tp:gcc-16.1-b20260222
msgid "Perform interprocedural constant propagation."
msgstr "Utför konstantpropagering mellan procedurer."

#. from tp:gcc-16.1-b20260222
msgid "Perform cloning to make Interprocedural constant propagation stronger."
msgstr "Utför kloning för att göra konstantpropagering mellan procedurer starkare."

#. from tp:gcc-16.1-b20260222
msgid "Perform interprocedural bitwise constant propagation."
msgstr "Utför bitvis konstantpropagering mellan procedurer."

#. from tp:gcc-16.1-b20260222
msgid "Perform interprocedural modref analysis."
msgstr "Utför modref-analyser mellan procedurer."

#. from tp:gcc-16.1-b20260222
msgid "Perform reordering and cloning of functions to maximize locality."
msgstr "Utför omordning och kloning av funktioner för att maximera lokalitet."

#. from tp:gcc-16.1-b20260222
msgid "Perform interprocedural profile propagation."
msgstr "Utför profileringspropagering mellan procedurer."

#. from tp:gcc-16.1-b20260222
msgid "Perform interprocedural points-to analysis."
msgstr "Utför pekar-på-analyser mellan procedurer."

#. from tp:gcc-16.1-b20260222
msgid "Discover pure and const functions."
msgstr "Upptäck pure- och const-funktioner."

#. from tp:gcc-16.1-b20260222
msgid "Perform Identical Code Folding for functions and read-only variables."
msgstr "Fäll ihop identisk kod för funktioner och endast läsbara variabler."

#. from tp:gcc-16.1-b20260222
msgid "Perform Identical Code Folding for functions."
msgstr "Fäll ihop identisk kod för funktioner."

#. from tp:gcc-16.1-b20260222
msgid "Perform Identical Code Folding for variables."
msgstr "Utför ihopfällning av identisk kod för variabler."

#. from tp:gcc-16.1-b20260222
msgid "Discover read-only and non addressable static variables."
msgstr "Upptäck skrivskyddade och icke-adresserbara statiska variabler."

#. from tp:gcc-16.1-b20260222
msgid "Discover read-only, write-only and non-addressable static variables."
msgstr "Upptäck skrivskyddade, skrivbara och icke-adresserbara statiska variabler."

#. from tp:gcc-16.1-b20260222
msgid "Reduce stack alignment on call sites if possible."
msgstr "Reducera stackjusteringen vid anropsplatsen om möjligt."

#. from tp:gcc-16.1-b20260222
msgid "Perform IPA Value Range Propagation."
msgstr "Utför IPA-propagering av värdeintervall."

#. from tp:gcc-16.1-b20260222
msgid "-fira-algorithm=[CB|priority]	Set the used IRA algorithm."
msgstr "-fira-algorithm=[CB|priority]	Bestäm den använda IRA-algoritmen."

#. from tp:gcc-16.1-b20260222
msgid "Assume strict aliasing rules apply across (uninlined) function boundaries."
msgstr "Anta att strikta aliasregler gäller över (ej inline:ade) funktionsgränser."

#. from tp:gcc-16.1-b20260222
msgid "-fira-region=[one|all|mixed]	Set regions for IRA."
msgstr "-fira-region=[one|all|mixed]	Sätt regioner för IRA."

#. from tp:gcc-16.1-b20260222
msgid "Use IRA based register pressure calculation in RTL hoist optimizations."
msgstr "Använd IRA-baserad registertryckberäkning i RTL-hissningsoptimeringar."

#. from tp:gcc-16.1-b20260222
msgid "Use IRA based register pressure calculation in RTL loop optimizations."
msgstr "Använd IRA-baserad registertryckberäkning i RTL-slingeoptimeringar."

#. from tp:gcc-16.1-b20260222
msgid "Share slots for saving different hard registers."
msgstr "Dela fack för att spara olika hårda register."

#. from tp:gcc-16.1-b20260222
msgid "Share stack slots for spilled pseudo-registers."
msgstr "Dela stackfack för spillda pseudoregister."

#. from tp:gcc-16.1-b20260222
msgid "-fira-verbose=<number>	Control IRA's level of diagnostic messages."
msgstr "-fira-verbose=<tal>\tStyr IRA:s nivå för diagnostikmeddelanden."

#. from tp:gcc-16.1-b20260222
msgid "Optimize induction variables on trees."
msgstr "Optimera induktionsvariabler på träd."

#. from tp:gcc-16.1-b20260222
msgid "Use jump tables for sufficiently large switch statements."
msgstr "Använd hopptabeller för tillräckligt stora switch-satser."

#. from tp:gcc-16.1-b20260222
msgid "Use bit tests for sufficiently large switch statements."
msgstr "Använd bittester för tillräckligt stora switch-satser."

#. from tp:gcc-16.1-b20260222
msgid "Generate code for functions even if they are fully inlined."
msgstr "Generera kod för funktioner även om de är fullständigt inline:ade."

#. from tp:gcc-16.1-b20260222
msgid "Generate code for static functions even if they are never called."
msgstr "Generera kod för statiska funktioner även om de aldrig anropas."

#. from tp:gcc-16.1-b20260222
msgid "Emit static const variables even if they are not used."
msgstr "Mata ut static const-variabler även om de inte används."

#. from tp:gcc-16.1-b20260222
msgid "Give external symbols a leading underscore."
msgstr "Ge externa symboler ett inledande understrykningstecken."

#. from tp:gcc-16.1-b20260222
msgid "Do CFG-sensitive rematerialization in LRA."
msgstr "Gör CFG-känsliga återmaterialiseringar i LRA."

#. from tp:gcc-16.1-b20260222
msgid "Enable link-time optimization."
msgstr "Aktivera länkningsoptimeringar."

#. from tp:gcc-16.1-b20260222
msgid "Link-time optimization with number of parallel jobs or jobserver."
msgstr "Länktidsoptimering med antal parallella jobb eller jobbserver."

#. from tp:gcc-16.1-b20260222
msgid "Enable incremental LTO, with its cache in given directory."
msgstr "Aktivera inkrementell LTO, med dess cache i den angivna katalogen."

#. from tp:gcc-16.1-b20260222
msgid "Number of cache entries in incremental LTO after which to prune old entries."
msgstr "Antal cacheposter i inkrementell LTO efter vilka gamla poster ansas."

#. from tp:gcc-16.1-b20260222
msgid "Specify the algorithm to partition symbols and vars at linktime."
msgstr "Ange algoritmen för att dela upp symboler och variabler vid länktillfället."

#. from tp:gcc-16.1-b20260222
msgid "Enable heuristics to recognize symbol identifiers in toplevel (not extended) assembly and prevent their mangling/deletion."
msgstr "Aktivera heuristik för att känna igen symbolidentifierare i toppnivåassembler (inte utökad) och förhindra att de manglas/raderas."

#. from tp:gcc-16.1-b20260222
msgid "Use zlib/zstd compression level <number> for IL."
msgstr "Använd zlib/zstd-komprimering på nivå <tal> för IL."

#. from tp:gcc-16.1-b20260222
msgid "Report various link-time optimization statistics."
msgstr "Rapportera diverse optimeringsstatistik från länkningen."

#. from tp:gcc-16.1-b20260222
msgid "Report various link-time optimization statistics for WPA only."
msgstr "Rapportera diverse optimeringsstatistik från länkningen endast för WPA."

#. from tp:gcc-16.1-b20260222
msgid "Set errno after built-in math functions."
msgstr "Sätt errno efter inbyggda matematikfunktioner."

#. from tp:gcc-16.1-b20260222
msgid "-fmax-errors=<number>	Maximum number of errors to report."
msgstr "-fmax-errors=<antal>	Maximalt antal fel som skall rapporteras."

#. from tp:gcc-16.1-b20260222
msgid "Allow removal of malloc and free pairs when allocated block is unused."
msgstr "Tillåt borttagning av malloc- och free-par när det allokerade blocket inte används."

#. from tp:gcc-16.1-b20260222
msgid "Report on permanent memory allocation."
msgstr "Rapportera om permanent minnesallokering."

#. from tp:gcc-16.1-b20260222
msgid "Report on permanent memory allocation in WPA only."
msgstr "Rapportera bara om permanent minnesallokering i WPA."

#. from tp:gcc-16.1-b20260222
msgid "Attempt to merge identical constants and constant variables."
msgstr "Försök slå samman identiska konstanter och konstanta variabler."

#. from tp:gcc-16.1-b20260222
msgid "Attempt to merge identical constants across compilation units."
msgstr "Försök slå samman identiska konstanter mellan kompileringsenheter."

#. from tp:gcc-16.1-b20260222
msgid "Attempt to merge identical debug strings across compilation units."
msgstr "Försök slå samman identiska felsökningssträngar mellan kompileringsenheter."

#. from tp:gcc-16.1-b20260222
msgid "-fmessage-length=<number>	Limit diagnostics to <number> characters per line.  0 suppresses line-wrapping."
msgstr "-fmessage-length=<antal>	Begränsa felmeddelandens längd till <antal> tecken per rad.  0 stänger av radbrytning."

#. from tp:gcc-16.1-b20260222
msgid "Align the start of every function."
msgstr "Justera starten av varje funktion."

#. from tp:gcc-16.1-b20260222
msgid "Perform SMS based modulo scheduling before the first scheduling pass."
msgstr "Utför SMS-baserad modulo-schemaläggning före det första schemaläggningspasset."

#. from tp:gcc-16.1-b20260222
msgid "Perform SMS based modulo scheduling with register moves allowed."
msgstr "Utför SMS-baserad modulo-schemaläggning med tillåten registerförflyttning."

#. from tp:gcc-16.1-b20260222
msgid "Move loop invariant computations out of loops."
msgstr "Flytta slinginvarianta beräkningar ut från slingor."

#. from tp:gcc-16.1-b20260222
msgid "Move stores out of loops."
msgstr "Flytta ut lagringar ur slingor."

#. from tp:gcc-16.1-b20260222
msgid "Building block for specs-based multilib-aware TFLAGS."
msgstr "Byggblock för specs-baserade multibiblioteksmedvetna TFLAGS."

#. from tp:gcc-16.1-b20260222
msgid "Use the RTL dead code elimination pass."
msgstr "Använd passet på RTL för eliminering av död kod."

#. from tp:gcc-16.1-b20260222
msgid "Use the RTL dead store elimination pass."
msgstr "Använd passet på RTL för eliminering av död lagring."

#. from tp:gcc-16.1-b20260222
msgid "Enable/Disable the traditional scheduling in loops that already passed modulo scheduling."
msgstr "Aktivera/avaktivera den traditionella schemaläggningen i slingor som redan har passerat moduloschemaläggning."

#. from tp:gcc-16.1-b20260222
msgid "Support synchronous non-call exceptions."
msgstr "Stöd synkrona icke-anropsundantag."

#. from tp:gcc-16.1-b20260222
msgid "-foffload-options=<targets>=<options>	Specify options for the offloading targets."
msgstr "-foffload-options=<mål>=<flaggor>	Ange flaggor för mål att lasta av till."

#. from tp:gcc-16.1-b20260222
msgid "-foffload-abi=[lp64|ilp32]	Set the ABI to use in an offload compiler."
msgstr "-foffload-abi=[lp64|ilp32]	Ange ABI:et att använda i en avlastningskompilator."

#. from tp:gcc-16.1-b20260222
msgid "-foffload-abi-host-opts=<options>	Specify host ABI options."
msgstr "-foffload-abi-host-opts=<flaggor>	Ange värd ABI-flaggor."

#. from tp:gcc-16.1-b20260222
msgid "When possible do not generate stack frames."
msgstr "Låt bli att generera stackramar när det är möjligt."

#. from tp:gcc-16.1-b20260222
msgid "Generate SIMD clones for functions with the OpenMP declare target directive."
msgstr "Generera SIMD-kloner för funktioner med direketivet OpenMP declare target."

#. from tp:gcc-16.1-b20260222
msgid "Enable all optimization info dumps on stderr."
msgstr "Aktivera alla optimeringsinformationsdumpar på standardfel."

#. from tp:gcc-16.1-b20260222
msgid "-fopt-info[-<type>=filename]	Dump compiler optimization details."
msgstr "-fopt-info[-<type>=filenamn]	Skriv ut kompilatoroptimeringsdetaljer."

#. from tp:gcc-16.1-b20260222
msgid "Write a SRCFILE.opt-record.json file detailing what optimizations were performed."
msgstr "Skriv en SRCFILE.opt-record.json-fil med detaljer om vilka optimeringar som utfördes."

#. from tp:gcc-16.1-b20260222
msgid "Detect loops calculating CRC and replace with faster implementation. If the target supports CRC instruction and the CRC loop uses the same polynomial as the one used in the CRC instruction, directly replace with the corresponding CRC instruction. Otherwise, if the target supports carry-less-multiplication instruction, generate CRC using it. If neither case applies, generate table-based CRC."
msgstr "Upptäck slingor som beräknar CRC och ersätt dem med en snabbare implementation. Om målet stödjer en CRC-instruktion och CRC-slingan använder samma polynom smo det som används i CRC-instruktionen, ersätt då direkt med motsvarande CRC-instruktion. Annars, om målet stödjer en instruktion för minnesfri multiplikation, generera en CRC som använder det. Om inget av fallen är tillämpligt, generera tabellbaserad CRC."

#. from tp:gcc-16.1-b20260222
msgid "Optimize sibling and tail recursive calls."
msgstr "Optimera syskon- och svansrekursiva anrop."

#. from tp:gcc-16.1-b20260222
msgid "Insert path profiling code."
msgstr "Lägg till vägprofileringskod."

#. from tp:gcc-16.1-b20260222
msgid "Perform partial inlining."
msgstr "Utför partiell inline:ing."

#. from tp:gcc-16.1-b20260222
msgid "Report on memory allocation before interprocedural optimization."
msgstr "Rapportera minnesallokering för interprocedurella optimeringar."

#. from tp:gcc-16.1-b20260222
msgid "Pack structure members together without holes."
msgstr "Packa ihop postmedlemmar utan hål."

#. from tp:gcc-16.1-b20260222
msgid "-fpack-struct=<number>	Set initial maximum structure member alignment."
msgstr "-fpack-struct=<tal>	Ange initial maximal justering för postmedlemmar."

#. from tp:gcc-16.1-b20260222
msgid "Return small aggregates in memory, not registers."
msgstr "Returnera små aggregat i minne, inte register."

#. from tp:gcc-16.1-b20260222
msgid "Perform loop peeling."
msgstr "Utför slingavskalning."

#. from tp:gcc-16.1-b20260222
msgid "Enable machine specific peephole optimizations."
msgstr "Aktivera maskinspecifika nyckelhålsoptimeringar."

#. from tp:gcc-16.1-b20260222
msgid "Enable an RTL peephole pass before sched2."
msgstr "Aktivera ett RTL-nyckelhålspass före sched2."

#. from tp:gcc-16.1-b20260222
msgid "Generate position-independent code if possible (large mode)."
msgstr "Generera positionsoberoende kod om möjligt (stort läge)."

#. from tp:gcc-16.1-b20260222
msgid "Generate position-independent code for executables if possible (large mode)."
msgstr "Generera positionsoberoende kod för körbara program om möjligt (stort läge)."

#. from tp:gcc-16.1-b20260222
msgid "Generate position-independent code if possible (small mode)."
msgstr "Generera positionsoberoende kod om möjligt (litet läge)."

#. from tp:gcc-16.1-b20260222
msgid "Generate position-independent code for executables if possible (small mode)."
msgstr "Generera positionsoberoende kod för körbara program om möjligt (litet läge)."

#. from tp:gcc-16.1-b20260222
msgid "Use PLT for PIC calls (-fno-plt: load the address from GOT at call site)."
msgstr "Använd PLT för PIC-anrop (-fno-plt: läs adressen från GOT på anropsplatsen)."

#. from tp:gcc-16.1-b20260222
msgid "Specify a plugin to load."
msgstr "Ange en insticksmodul att läsa in."

#. from tp:gcc-16.1-b20260222
msgid "-fplugin-arg-<name>-<key>[=<value>]	Specify argument <key>=<value> for plugin <name>."
msgstr "-fplugin-arg-<namn>-<nyckel>[=<värde>]	Ange argument <nyckel>=<värde> för insticksmodul <namn>."

#. from tp:gcc-16.1-b20260222
msgid "Run predictive commoning optimization."
msgstr "Kör optimeringar för predikativ gemensamning."

#. from tp:gcc-16.1-b20260222
msgid "Generate prefetch instructions, if available, for arrays in loops."
msgstr "Generera förhandshämtningsinstruktioner (prefetch), om tillgängliga, för vektorer i slingor."

#. from tp:gcc-16.1-b20260222
msgid "Enable basic program profiling code."
msgstr "Aktivera grundläggande programprofileringskod."

#. from tp:gcc-16.1-b20260222
msgid "Generate absolute source path names for gcov."
msgstr "Generera absoluta källkodssökvägar för gcov."

#. from tp:gcc-16.1-b20260222
msgid "Insert arc-based program profiling code."
msgstr "Lägg in bågbaserad programprofileringskod."

#. from tp:gcc-16.1-b20260222
msgid "Insert condition coverage profiling code."
msgstr "Lägg in profileringskod för villkorstäckning."

#. from tp:gcc-16.1-b20260222
msgid "Set the top-level directory for storing the profile data. The default is 'pwd'."
msgstr "Sätt toppnivåkatalogen för att spara profildata.  Standard är ”pwd”."

#. from tp:gcc-16.1-b20260222
msgid "Select the name for storing the profile note file."
msgstr "Välj namnet att lagra profileringsnoteringsfil."

#. from tp:gcc-16.1-b20260222
msgid "Enable correction of flow inconsistent profile data input."
msgstr "Aktivera korrigering av profilindata med inkonsistent flöde."

#. from tp:gcc-16.1-b20260222
msgid "-fprofile-update=[single|atomic|prefer-atomic]	Set the profile update method."
msgstr "-fprofile-update=[single|atomic|prefer-atomic]	Ange metoden för profiluppdatering."

#. from tp:gcc-16.1-b20260222
msgid "Instrument only functions from files whose name matches any of the regular expressions (separated by semi-colons)."
msgstr "Instrumentera endast funktioner från filer vars namn matchar något av de reguljära uttrycken (separerade av semikolon)."

#. from tp:gcc-16.1-b20260222
msgid "Instrument only functions from files whose name does not match any of the regular expressions (separated by semi-colons)."
msgstr "Instrumentera endast funktioner från filer vars namn inte matchar något av de reguljära uttrycken (separerade av semikolon)."

#. from tp:gcc-16.1-b20260222
msgid "-fprofile-reproducible=[serial|parallel-runs|multithreaded]	Control level of reproducibility of profile gathered by -fprofile-generate."
msgstr "-fprofile-reproducible=[serial|parallel-runs|multithreaded]	Styr nivån av reproducerbarhet av profilen som samlas av -fprofile-generate."

#. from tp:gcc-16.1-b20260222
msgid "Remove prefix from absolute path before mangling name for -fprofile-generate= and -fprofile-use=."
msgstr "Ta bort prefix från absoluta sökvägar före namnmangling för -fprofile-generate= och -fprofile-use=."

#. from tp:gcc-16.1-b20260222
msgid "-fprofile-prefix-map=<old>=<new>	Map one directory name to another in GCOV coverage result."
msgstr "-fprofile-prefix-map=<gammalt>=<nytt>\tAvbilda ett katalognamn till ett annat i GCOV-täckningsresultatet."

#. from tp:gcc-16.1-b20260222
msgid "Enable common options for generating profile info for profile feedback directed optimizations."
msgstr "Aktivera vanliga flaggor för att generera profileringsinformation för optimeringar styrda av återmatad profil."

#. from tp:gcc-16.1-b20260222
msgid "Enable common options for generating profile info for profile feedback directed optimizations, and set -fprofile-dir=."
msgstr "Aktivera vanliga flaggor för att generera profileringsinformation för optimeringar styrda av återmatad profil, och sätt -fprofile-dir=."

#. from tp:gcc-16.1-b20260222
msgid "Register the profile information in the .gcov_info section instead of using a constructor/destructor."
msgstr "Registrera profilinformationen i sektionen .gcov_info i stället för att använda en konstruktor/destruktor."

#. from tp:gcc-16.1-b20260222
msgid "Register the profile information in the specified section instead of using a constructor/destructor."
msgstr "Registrera profilinformationen i den angivna sektionen i stället för att använda en konstruktor/destruktor."

#. from tp:gcc-16.1-b20260222
msgid "Do not assume that functions never executed during the train run are cold."
msgstr "Anta inte att funktioner som aldrig körs under träningskörningen är kalla."

#. from tp:gcc-16.1-b20260222
msgid "Enable common options for performing profile feedback directed optimizations."
msgstr "Aktivera vanliga flaggor för att utföra optimeringar styrda av återmatad profil."

#. from tp:gcc-16.1-b20260222
msgid "Enable common options for performing profile feedback directed optimizations, and set -fprofile-dir=."
msgstr "Aktivera vanliga flaggor för att utföra optimeringar styrda av återmatad profil, och sätt -fprofile-dir=."

#. from tp:gcc-16.1-b20260222
msgid "Insert code to profile values of expressions."
msgstr "Lägg in kod för att profilera värden av uttryck."

#. from tp:gcc-16.1-b20260222
msgid "Report on consistency of profile."
msgstr "Rapportera om intern konsistens hos profilen."

#. from tp:gcc-16.1-b20260222
msgid "Enable function reordering that improves code placement."
msgstr "Aktivera omflyttning av funktioner för att förbättra kodplacering."

#. from tp:gcc-16.1-b20260222
msgid "Insert NOP instructions at each function entry."
msgstr "Infoga NOP-instruktioner vid varje funktionsingång."

#. from tp:gcc-16.1-b20260222
msgid "-frandom-seed=<string>	Make compile reproducible using <string>."
msgstr "-frandom-seed=<sträng>	Gör kompileringen reproducerbar med <sträng>."

#. from tp:gcc-16.1-b20260222
msgid "Record gcc command line switches in the object file."
msgstr "Notera gcc:s kommandoradsflaggor i objektfilen."

#. from tp:gcc-16.1-b20260222
msgid "Return small aggregates in registers."
msgstr "Returnera små poster i register."

#. from tp:gcc-16.1-b20260222
msgid "Tell DSE that the storage for a C++ object is dead when the constructor starts and when the destructor finishes."
msgstr "Berätta för DSE att lagringen för ett C++-objekt är dött när konstrueraren börjar och när destrueraren avslutar."

#. from tp:gcc-16.1-b20260222
msgid "-flive-patching=[inline-only-static|inline-clone]	Control IPA optimizations to provide a safe compilation for live-patching.  At the same time, provides multiple-level control on the enabled IPA optimizations."
msgstr "-flive-patching=[inline-only-static|inline-clone]	Styr IPA-optimeringar till att ge en säker kompilering för uppdateringar i drift.  Ger på samma gång flernivåstyrning av de aktiverade IPA-optimeringarna."

#. from tp:gcc-16.1-b20260222
msgid "Tell DCE to remove unused C++ allocations."
msgstr "Säg till DCE att ta bort oanvända C++-allokeringar."

#. from tp:gcc-16.1-b20260222
msgid "Relief of register pressure through live range shrinkage."
msgstr "Minska registertrycket genom att krympa livsintervall."

#. from tp:gcc-16.1-b20260222
msgid "Perform a register renaming optimization pass."
msgstr "Utför ett optimeringspass med registernamnbyten."

#. from tp:gcc-16.1-b20260222
msgid "Perform a target dependent instruction fusion optimization pass."
msgstr "Utför ett optimeringspass med målberoende instruktionssammanslagning."

#. from tp:gcc-16.1-b20260222
msgid "Reorder basic blocks to improve code placement."
msgstr "Flytta om grundblock för att förbättra kodplacering."

#. from tp:gcc-16.1-b20260222
msgid "-freorder-blocks-algorithm=[simple|stc]	Set the used basic block reordering algorithm."
msgstr "-freorder-blocks-algorithm=[simple|stc]	Sätt algoritmen att användas för ordningsändring av grundblock."

#. from tp:gcc-16.1-b20260222
msgid "Reorder basic blocks and partition into hot and cold sections."
msgstr "Flytta om grundblock och partitionera dem i varma och kalla sektioner."

#. from tp:gcc-16.1-b20260222
msgid "Reorder functions to improve code placement."
msgstr "Flytta om funktioner för att förbättra kodplacering."

#. from tp:gcc-16.1-b20260222
msgid "Add a common subexpression elimination pass after loop optimizations."
msgstr "Lägg till ett pass för eliminering av gemensamma deluttryck efter slingoptimeringar."

#. from tp:gcc-16.1-b20260222
msgid "Disable optimizations that assume default FP rounding behavior."
msgstr "Avaktivera optimeringar som antar standardmässigt avrundningsbeteende för FP."

#. from tp:gcc-16.1-b20260222
msgid "Enable scheduling across basic blocks."
msgstr "Aktivera schemaläggning mellan grundblock."

#. from tp:gcc-16.1-b20260222
msgid "Enable register pressure sensitive insn scheduling."
msgstr "Aktivera registertryckskänslig instruktionsschemaläggning."

#. from tp:gcc-16.1-b20260222
msgid "Allow speculative motion of non-loads."
msgstr "Tillåt spekulativ förflyttning av icke-laddningar."

#. from tp:gcc-16.1-b20260222
msgid "Allow speculative motion of some loads."
msgstr "Tillåt spekulativ förflyttning av några laddningar."

#. from tp:gcc-16.1-b20260222
msgid "Allow speculative motion of more loads."
msgstr "Tillåt spekulativ förflyttning av fler laddningar."

#. from tp:gcc-16.1-b20260222
msgid "-fsched-verbose=<number>	Set the verbosity level of the scheduler."
msgstr "-fsched-verbose=<tal>\tAnge schemaläggarens utförlighetsnivå."

#. from tp:gcc-16.1-b20260222
msgid "If scheduling post reload, do superblock scheduling."
msgstr "Vid schemaläggning efter omläsning, utför superblockschemaläggning."

#. from tp:gcc-16.1-b20260222
msgid "Reschedule instructions before register allocation."
msgstr "Schemalägg om instruktioner före registertilldelning."

#. from tp:gcc-16.1-b20260222
msgid "Reschedule instructions after register allocation."
msgstr "Schemalägg om instruktioner efter registertilldelning."

#. from tp:gcc-16.1-b20260222
msgid "Schedule instructions using selective scheduling algorithm."
msgstr "Använd selektiv schemaläggningsalgoritm för att schemalägga instruktioner."

#. from tp:gcc-16.1-b20260222
msgid "Run selective scheduling after reload."
msgstr "Kör selektiv schemaläggning efter omläsning."

#. from tp:gcc-16.1-b20260222
msgid "Run self-tests, using the given path to locate test files."
msgstr "Kör självtester, använd den angivna sökvägen för att hitta testfiler."

#. from tp:gcc-16.1-b20260222
msgid "Perform software pipelining of inner loops during selective scheduling."
msgstr "Utför programvarurörläggning av inre slingor under selektiv schemaläggning."

#. from tp:gcc-16.1-b20260222
msgid "Perform software pipelining of outer loops during selective scheduling."
msgstr "Utför programvarurörläggning av yttre slingor under selektiv schemaläggning."

#. from tp:gcc-16.1-b20260222
msgid "Reschedule pipelined regions without pipelining."
msgstr "Schemalägg om rörlagda regioner utan rörläggning."

#. from tp:gcc-16.1-b20260222
msgid "Allow interposing function (or variables) by ones with different semantics (or initializer) respectively by dynamic linker."
msgstr "Tillåt den dynamiska länkaren att ersätta funktioner (eller variabler) med sådana med annan semantik (respektive initierare)."

#. from tp:gcc-16.1-b20260222
msgid "Allow premature scheduling of queued insns."
msgstr "Tillåt förtida schemaläggning av köade instruktioner."

#. from tp:gcc-16.1-b20260222
msgid "-fsched-stalled-insns=<number>	Set number of queued insns that can be prematurely scheduled."
msgstr "-fsched-stalled-insns=<antal>	Ange antalet köade instruktioner som kan schemaläggas i förtid."

#. from tp:gcc-16.1-b20260222
msgid "Set dependence distance checking in premature scheduling of queued insns."
msgstr "Sätt beroendeavståndet som kontrolleras i förtida schemaläggning av köade instruktioner."

#. from tp:gcc-16.1-b20260222
msgid "-fsched-stalled-insns-dep=<number>	Set dependence distance checking in premature scheduling of queued insns."
msgstr "-fsched-stalled-insns-dep=<antal>	Sätt beroendeavståndet som kontrolleras i förtida schemaläggning av köade instruktioner."

#. from tp:gcc-16.1-b20260222
msgid "Enable the group heuristic in the scheduler."
msgstr "Aktivera gruppheuristiken i schemaläggaren."

#. from tp:gcc-16.1-b20260222
msgid "Enable the critical path heuristic in the scheduler."
msgstr "Aktivera heuristiken för kritisk väg i schemaläggaren."

#. from tp:gcc-16.1-b20260222
msgid "Enable the speculative instruction heuristic in the scheduler."
msgstr "Aktivera den spekulativa instruktionsheuristiken i schemaläggaren."

#. from tp:gcc-16.1-b20260222
msgid "Enable the rank heuristic in the scheduler."
msgstr "Aktivera ordningsheuristiken i schemaläggaren."

#. from tp:gcc-16.1-b20260222
msgid "Enable the last instruction heuristic in the scheduler."
msgstr "Aktivera heuristiken för sista instruktion i schemaläggaren."

#. from tp:gcc-16.1-b20260222
msgid "Enable the dependent count heuristic in the scheduler."
msgstr "Aktivera heuristiken för beroende antal i schemaläggaren."

#. from tp:gcc-16.1-b20260222
msgid "Access data in the same section from shared anchor points."
msgstr "Nå data i samma sektion från delade förankringspunkter."

#. from tp:gcc-16.1-b20260222
msgid "Turn on Redundant Extensions Elimination pass."
msgstr "Slå på passet för eliminering av redundanta utökningar."

#. from tp:gcc-16.1-b20260222
msgid "Show column numbers in diagnostics, when available.  Default on."
msgstr "Visa kolumnnummer i diagnostikmeddelanden när de är tillgängliga.  Aktiverat som standard."

#. from tp:gcc-16.1-b20260222
msgid "Emit function prologues only before parts of the function that need it, rather than at the top of the function."
msgstr "Mata ut funktionsprologer bara före delar av funktionen som behöver dem i stället för i början av funktionen."

#. from tp:gcc-16.1-b20260222
msgid "Shrink-wrap parts of the prologue and epilogue separately."
msgstr "Kapsla in delar av prologen och epilogen separat."

#. from tp:gcc-16.1-b20260222
msgid "Disable optimizations observable by IEEE signaling NaNs."
msgstr "Avaktivera optimeringar som kan observeras av IEEE:s signalerande NaN:er."

#. from tp:gcc-16.1-b20260222
msgid "Disable floating point optimizations that ignore the IEEE signedness of zero."
msgstr "Avaktivera flyttalsoptimeringar som ignorerar IEEE:s tecken på noll."

#. from tp:gcc-16.1-b20260222
msgid "Convert floating point constants to single precision constants."
msgstr "Konvertera flyttalskonstanter till konstanter med enkel precision."

#. from tp:gcc-16.1-b20260222
msgid "Split lifetimes of induction variables when loops are unrolled."
msgstr "Dela livstiden på induktionsvariabler när slingor rullas ut."

#. from tp:gcc-16.1-b20260222
msgid "Generate discontiguous stack frames."
msgstr "Generera osammanhängande stackramar."

#. from tp:gcc-16.1-b20260222
msgid "Split wide types into independent registers."
msgstr "Dela upp breda typer i oberoende register."

#. from tp:gcc-16.1-b20260222
msgid "Split wide types into independent registers earlier."
msgstr "Dela upp breda typer i oberoende register tidigare."

#. from tp:gcc-16.1-b20260222
msgid "Enable backward propagation of use properties at the SSA level."
msgstr "Aktivera bakåtpropagering av användningsegenskaper på SSA-nivån."

#. from tp:gcc-16.1-b20260222
msgid "Optimize conditional patterns using SSA PHI nodes."
msgstr "Optimera villkorliga mönster med SSA PHI-noder."

#. from tp:gcc-16.1-b20260222
msgid "Optimize amount of stdarg registers saved to stack at start of function."
msgstr "Optimera mängden stdarg-register som sparas på stacken vid starten av en funktion."

#. from tp:gcc-16.1-b20260222
msgid "Apply variable expansion when loops are unrolled."
msgstr "Tillämpa variabelexpansion när slingor rullas ut."

#. from tp:gcc-16.1-b20260222
msgid "-fstack-check=[no|generic|specific]	Insert stack checking code into the program."
msgstr "-fstack-check=[no|generic|specific]	Lägg in stackkontrollkod i programmet."

#. from tp:gcc-16.1-b20260222
msgid "Insert stack checking code into the program.  Same as -fstack-check=specific."
msgstr "Lägg in stackkontrollkod i programmet.  Samma som -fstack-check=specific."

#. from tp:gcc-16.1-b20260222
msgid "Insert code to probe each page of stack space as it is allocated to protect from stack-clash style attacks."
msgstr "Infoga kod för att sondera varje sida av stackutrymmet när det allokeras, för att skydda mot stackkollisionsattacker."

#. from tp:gcc-16.1-b20260222
msgid "-fstack-limit-register=<register>	Trap if the stack goes past <register>."
msgstr "-fstack-limit-register=<register>\tUtlös en fälla om stacken går förbi <register>."

#. from tp:gcc-16.1-b20260222
msgid "-fstack-limit-symbol=<name>	Trap if the stack goes past symbol <name>."
msgstr "-fstack-limit-symbol=<namn>\tUtlös en fälla om stacken går förbi symbolen <namn>."

#. from tp:gcc-16.1-b20260222
msgid "Use propolice as a stack protection method."
msgstr "Använd propolice som en metod att skydda stacken."

#. from tp:gcc-16.1-b20260222
msgid "Use a stack protection method for every function."
msgstr "Använd en metod att skydda stacken för varje funktion."

#. from tp:gcc-16.1-b20260222
msgid "Use a smart stack protection method for certain functions."
msgstr "Använd en smart metod att skydda stacken för vissa funktioner."

#. from tp:gcc-16.1-b20260222
msgid "Use stack protection method only for functions with the stack_protect attribute."
msgstr "Använd en metod att skydda stacken endast för funktioner med attributet stack_protect."

#. from tp:gcc-16.1-b20260222
msgid "Output stack usage information on a per-function basis."
msgstr "Skriv ut information om stackanvändning för varje funktion."

#. from tp:gcc-16.1-b20260222
msgid "Assume strict aliasing rules apply."
msgstr "Anta att strikta aliasregler gäller."

#. from tp:gcc-16.1-b20260222
msgid "Treat signed overflow as undefined.  Negated as -fwrapv -fwrapv-pointer."
msgstr "Behandla spill med tecken som odefinierat.  Negeras som -fwrapv -fwrapv-pointer."

#. from tp:gcc-16.1-b20260222
msgid "Disable stack scrub entirely, disregarding strub attributes."
msgstr "Avaktivera helt stackskrubbning, bortse från strub-attribut."

#. from tp:gcc-16.1-b20260222
msgid "Enable stack scrub as per attributes, with strict call checking."
msgstr "Aktivera stackskrubbning enligt attribut, med strikt anropskontroll."

#. from tp:gcc-16.1-b20260222
msgid "Restore default strub mode: as per attributes, with relaxed checking."
msgstr "Återställ strub-läget: enligt attribut, med lättare kontroller."

#. from tp:gcc-16.1-b20260222
msgid "Enable stack scrubbing for all viable functions."
msgstr "Aktivera stackskrubbning för alla möjliga funktioner."

#. from tp:gcc-16.1-b20260222
msgid "Enable at-calls stack scrubbing for all viable functions."
msgstr "Aktivera stackskrubbning vid anrop för alla möjliga funktioner."

#. from tp:gcc-16.1-b20260222
msgid "Enable internal stack scrubbing for all viable functions."
msgstr "Aktivera intern stackskrubbning av alla möjliga funktioner."

#. from tp:gcc-16.1-b20260222
msgid "Implement __atomic operations via libcalls to legacy __sync functions."
msgstr "Implementera __atomic-operationer med biblioteksanrop till äldre __sync-funktioner."

#. from tp:gcc-16.1-b20260222
msgid "Check for syntax errors, then stop."
msgstr "Kontrollera syntaxfel och stoppa sedan."

#. from tp:gcc-16.1-b20260222
msgid "Create data files needed by \"gcov\"."
msgstr "Skapa datafiler som behövs av ”gcov”."

#. from tp:gcc-16.1-b20260222
msgid "Perform jump threading optimizations."
msgstr "Utför hopptrådningsoptimeringar."

#. from tp:gcc-16.1-b20260222
msgid "Report the time taken by each compiler pass."
msgstr "Rapportera tiden som går åt för varje kompilatorpass."

#. from tp:gcc-16.1-b20260222
msgid "Record times taken by sub-phases separately."
msgstr "Spela in tiden som går åt till underfaser separat."

#. from tp:gcc-16.1-b20260222
msgid "-ftls-model=[global-dynamic|local-dynamic|initial-exec|local-exec]	Set the default thread-local storage code generation model."
msgstr "-ftls-model=[global-dynamic|local-dynamic|initial-exec|local-exec]	Ange normal kodgenereringsmodell för trådlokal lagring."

#. from tp:gcc-16.1-b20260222
msgid "Reorder top level functions, variables, and asms."
msgstr "Ordna om toppnivåfunktioner, variabler och asm:ar."

#. from tp:gcc-16.1-b20260222
msgid "Perform superblock formation via tail duplication."
msgstr "Utför superblockformering via svansduplicering."

#. from tp:gcc-16.1-b20260222
msgid "For targets that normally need trampolines for nested functions, always generate them instead of using descriptors."
msgstr "För mål som normalt använder trampoliner för nästade funktioner, generera dem alltid istället för att använda deskriptorer."

#. from tp:gcc-16.1-b20260222
msgid "Whether trampolines are generated in executable memory rather than executable stack."
msgstr "Huruvida trampoliner genereras i körbart minne snarare än på körbar stack."

#. from tp:gcc-16.1-b20260222
msgid "Assume floating-point operations can trap."
msgstr "Anta att flyttalsoperationer kan utlösa fällor."

#. from tp:gcc-16.1-b20260222
msgid "Trap for signed overflow in addition, subtraction and multiplication."
msgstr "Utlös en fälla vid överspill med tecken i addition, subtraktion och multiplikation."

#. from tp:gcc-16.1-b20260222
msgid "Enable SSA-CCP optimization on trees."
msgstr "Aktivera SSA-CCP-optimering av träd."

#. from tp:gcc-16.1-b20260222
msgid "Enable SSA-BIT-CCP optimization on trees."
msgstr "Aktivera SSA-BIT-CCP-optimering av träd."

#. from tp:gcc-16.1-b20260222
msgid "Enable loop header copying on trees."
msgstr "Aktivera slinghuvudkopiering av träd."

#. from tp:gcc-16.1-b20260222
msgid "Enable SSA coalescing of user variables."
msgstr "Aktivera SSA-sammanläggning av användarvariabler."

#. from tp:gcc-16.1-b20260222
msgid "Enable copy propagation on trees."
msgstr "Aktivera kopiepropagering i träd."

#. from tp:gcc-16.1-b20260222
msgid "Transform condition stores into unconditional ones."
msgstr "Transformera villkorliga lagringar till ovillkorliga."

#. from tp:gcc-16.1-b20260222
msgid "Perform conversions of switch initializations."
msgstr "Utför konvertering av switch-initieringar."

#. from tp:gcc-16.1-b20260222
msgid "Enable SSA dead code elimination optimization on trees."
msgstr "Aktivera eliminering av död kod i SSA-optimeringen i träd."

#. from tp:gcc-16.1-b20260222
msgid "Enable dominator optimizations."
msgstr "Aktivera dominatoroptimeringar."

#. from tp:gcc-16.1-b20260222
msgid "Enable tail merging on trees."
msgstr "Aktivera svanssammanslagning av träd."

#. from tp:gcc-16.1-b20260222
msgid "Enable dead store elimination."
msgstr "Aktivera eliminering av död lagring."

#. from tp:gcc-16.1-b20260222
msgid "Enable forward propagation on trees."
msgstr "Aktivera framåtpropagering på träd."

#. from tp:gcc-16.1-b20260222
msgid "Enable Full Redundancy Elimination (FRE) on trees."
msgstr "Aktivera fullständig överflödseliminering (FRE) i träd."

#. from tp:gcc-16.1-b20260222
msgid "Enable string length optimizations on trees."
msgstr "Aktivera stränglängdsoptimering av träd."

#. from tp:gcc-16.1-b20260222
msgid "Detect paths that trigger erroneous or undefined behavior due to dereferencing a null pointer.  Isolate those paths from the main control flow and turn the statement with erroneous or undefined behavior into a trap."
msgstr "Upptäck vägar som utlöser felaktigt eller odefinierat beteende på grund av dereferering av nollpekare.  Isolera dessa vägar från det huvudsakliga styrflödet och omvandla satsen med det felaktiga eller odefinierade beteendet till en fälla."

#. from tp:gcc-16.1-b20260222
msgid "Detect paths that trigger erroneous or undefined behavior due to a null value being used in a way forbidden by a returns_nonnull or nonnull attribute.  Isolate those paths from the main control flow and turn the statement with erroneous or undefined behavior into a trap."
msgstr "Upptäck vägar som utlöser felaktigt eller odefinierat beteende på grund av att ett nollvärde används på ett sätt som förbjuds av ett returns_nonnull- eller nonnull-attribut.  Isolera dessa vägar från det huvudsakliga styrflödet och omvandla satsen med det felaktiga eller odefinierade beteendet till en fälla."

#. from tp:gcc-16.1-b20260222
msgid "Enable loop distribution on trees."
msgstr "Aktivera slingdistribution i träd."

#. from tp:gcc-16.1-b20260222
msgid "Enable loop distribution for patterns transformed into a library call."
msgstr "Aktivera slingdistribution för mönster transformerade till biblioteksanrop."

#. from tp:gcc-16.1-b20260222
msgid "Enable loop invariant motion on trees."
msgstr "Aktivera förflyttning av slingoberoende delar i träd."

#. from tp:gcc-16.1-b20260222
msgid "Create canonical induction variables in loops."
msgstr "Skapa kanoniska induktionsvariabler i slingor."

#. from tp:gcc-16.1-b20260222
msgid "Enable loop optimizations on tree level."
msgstr "Aktivera slingoptimeringar på trädnivå."

#. from tp:gcc-16.1-b20260222
msgid "-ftree-parallelize-loops=<number>	Enable automatic parallelization of loops."
msgstr "-ftree-parallelize-loops=<antal>	Aktivera automatisk parallellisering av slingor."

#. from tp:gcc-16.1-b20260222
msgid "Enable automatic parallelization of loops."
msgstr "Aktivera automatisk parallellisering av slingor."

#. from tp:gcc-16.1-b20260222
msgid "Enable hoisting loads from conditional pointers."
msgstr "Aktivera lyftningsladdning från villkorliga pekare."

#. from tp:gcc-16.1-b20260222
msgid "Enable SSA-PRE optimization on trees."
msgstr "Aktivera SSA-PRE-optimeringar i träd."

#. from tp:gcc-16.1-b20260222
msgid "In SSA-PRE optimization on trees, enable partial-partial redundancy elimination."
msgstr "I SSA-PRE-optimering på träd, aktivera eliminering av partiell-partiell redundans."

#. from tp:gcc-16.1-b20260222
msgid "Perform function-local points-to analysis on trees."
msgstr "Utför funktionslokala pekar-på-analyser i träd."

#. from tp:gcc-16.1-b20260222
msgid "Enable reassociation on tree level."
msgstr "Aktivera återassociering på trädnivå."

#. from tp:gcc-16.1-b20260222
msgid "Enable SSA code sinking on trees."
msgstr "Aktivera SSA-kodsänkning i träd."

#. from tp:gcc-16.1-b20260222
msgid "Perform straight-line strength reduction."
msgstr "Utför rätlinjig styrkereduktion."

#. from tp:gcc-16.1-b20260222
msgid "Perform scalar replacement of aggregates."
msgstr "Utför skalärersättning av aggregat."

#. from tp:gcc-16.1-b20260222
msgid "Replace temporary expressions in the SSA->normal pass."
msgstr "Ersätt tillfälliga uttryck i passet SSA->normal."

#. from tp:gcc-16.1-b20260222
msgid "Perform Value Range Propagation on trees."
msgstr "Utför propagering av värdeintervall i träd."

#. from tp:gcc-16.1-b20260222
msgid "Split paths leading to loop backedges."
msgstr "Dela sökvägar som leder till bakåtbågar i slingor."

#. from tp:gcc-16.1-b20260222
msgid "Assume common declarations may be overridden with ones with a larger trailing array."
msgstr "Anta att gemensamma deklarationer kan åsidosättas med sådana med en större avslutande vektor."

#. from tp:gcc-16.1-b20260222
msgid "Compile whole compilation unit at a time."
msgstr "Kompilera en hel kompileringsenhet åt gången."

#. from tp:gcc-16.1-b20260222
msgid "Trap on __builtin_unreachable instead of using it for optimization."
msgstr "Fånga vid __builtin_unreachable istället för att använda den för optimering."

#. from tp:gcc-16.1-b20260222
msgid "Perform loop unrolling when iteration count is known."
msgstr "Utför slingutrullning när iterationsantalet är känt."

#. from tp:gcc-16.1-b20260222
msgid "Perform loop unrolling for all loops."
msgstr "Utför slingutrullning för alla slingor."

#. from tp:gcc-16.1-b20260222
msgid "Allow optimization for floating-point arithmetic which may change the result of the operation due to rounding."
msgstr "Tillåt optimeringar för flyttalsaritmetik som kan ändra resultatet av operationen på grund av avrundning."

#. from tp:gcc-16.1-b20260222
msgid "Same as -fassociative-math for expressions which include division."
msgstr "Samma som -fassociative-math för uttryck som inkluderar division."

#. from tp:gcc-16.1-b20260222
msgid "Allow math optimizations that may violate IEEE or ISO standards."
msgstr "Tillåt matematikoptimeringar som kan strida mot IEEE- eller ISO-standarder."

#. from tp:gcc-16.1-b20260222
msgid "Perform loop unswitching."
msgstr "Utför slingavväxling."

#. from tp:gcc-16.1-b20260222
msgid "Perform loop splitting."
msgstr "Utför slingdelning."

#. from tp:gcc-16.1-b20260222
msgid "Version loops based on whether indices have a stride of one."
msgstr "Versionera slingor utifrån om indexen har steget ett."

#. from tp:gcc-16.1-b20260222
msgid "Just generate unwind tables for exception handling."
msgstr "Generera bara upprullningstabeller för undantagshantering."

#. from tp:gcc-16.1-b20260222
msgid "Use the bfd linker instead of the default linker."
msgstr "Använd bfd-länkaren i stället för standardlänkaren."

#. from tp:gcc-16.1-b20260222
msgid "Use the gold linker instead of the default linker."
msgstr "Använd gold-länkaren i stället för standardlänkaren."

#. from tp:gcc-16.1-b20260222
msgid "Use the lld LLVM linker instead of the default linker."
msgstr "Använd lld, LLVM-länkaren, i stället för standardlänkaren."

#. from tp:gcc-16.1-b20260222
msgid "Use the Modern linker (MOLD) linker instead of the default linker."
msgstr "Använd länkaren Modern Linker (MOLD) i stället för standardlänkaren."

#. from tp:gcc-16.1-b20260222
msgid "Use the Wild linker instead of the default linker."
msgstr "Använd Wild-länkaren i stället för standardlänkaren."

#. from tp:gcc-16.1-b20260222
msgid "Enable linking of libatomic."
msgstr "Aktivera länkning av libatomic."

#. from tp:gcc-16.1-b20260222
msgid "Perform variable tracking."
msgstr "Utför variabelspårning."

#. from tp:gcc-16.1-b20260222
msgid "Perform variable tracking by annotating assignments."
msgstr "Utför variabelspårning genom att annotera tilldelningar."

#. from tp:gcc-16.1-b20260222
msgid "Toggle -fvar-tracking-assignments."
msgstr "Växla -fvar-tracking-assignments."

#. from tp:gcc-16.1-b20260222
msgid "Perform variable tracking and also tag variables that are uninitialized."
msgstr "Utför variabelspårning och tagga också variabler som är oinitierade."

#. from tp:gcc-16.1-b20260222
msgid "Enable vectorization on trees."
msgstr "Aktivera vektorisering av träd."

#. from tp:gcc-16.1-b20260222
msgid "Enable loop vectorization on trees."
msgstr "Aktivera slingvektorisering i träd."

#. from tp:gcc-16.1-b20260222
msgid "Enable basic block vectorization (SLP) on trees."
msgstr "Aktivera grundblocksvektorisering (SLP) i träd."

#. from tp:gcc-16.1-b20260222
msgid "-fvect-cost-model=[unlimited|dynamic|cheap|very-cheap]	Specifies the cost model for vectorization."
msgstr "-fvect-cost-model=[unlimited|dynamic|cheap|very-cheap]	Anger kostnadsmodellen för vektorisering."

#. from tp:gcc-16.1-b20260222
msgid "-fsimd-cost-model=[unlimited|dynamic|cheap|very-cheap]	Specifies the vectorization cost model for code marked with a simd directive."
msgstr "-fsimd-cost-model=[unlimited|dynamic|cheap|very-cheap]	Anger kostnadsmodellen för vektorisering för kod markerad med ett simd-direktiv."

#. from tp:gcc-16.1-b20260222
msgid "Enables the dynamic vectorizer cost model.  Preserved for backward compatibility."
msgstr "Aktiverar den dynamiska kostnadsmodellen för vektoriseraren.  Bevarad för bakåtkompatibilitet."

#. from tp:gcc-16.1-b20260222
msgid "Enable copy propagation of scalar-evolution information."
msgstr "Aktivera kopiepropagering av skalärutvecklingsinformation."

#. from tp:gcc-16.1-b20260222
msgid "-ftrivial-auto-var-init=[uninitialized|pattern|zero]	Add initializations to automatic variables."
msgstr "-ftrivial-auto-var-init=[uninitialized|pattern|zero]	Lägg till initieringar till automatiska variabler."

#. from tp:gcc-16.1-b20260222
msgid "Add extra commentary to assembler output."
msgstr "Lägg till extra kommentarer till assemblerutdata."

#. from tp:gcc-16.1-b20260222
msgid "-fvisibility=[default|internal|hidden|protected]	Set the default symbol visibility."
msgstr "-fvisibility=[default|internal|hidden|protected]	Ange standardvärde för symbolsynlighet."

#. from tp:gcc-16.1-b20260222
msgid "Validate vtable pointers before using them."
msgstr "Validera vtable-pekare innan de används."

#. from tp:gcc-16.1-b20260222
msgid "Output vtable verification counters."
msgstr "Mata ut verifieringsräknare för vtable."

#. from tp:gcc-16.1-b20260222
msgid "Output vtable verification pointer sets information."
msgstr "Mata ut information om verifieringspekaruppsättningar för vtable."

#. from tp:gcc-16.1-b20260222
msgid "Use expression value profiles in optimizations."
msgstr "Använd uttrycksvärdeprofiler i optimeringar."

#. from tp:gcc-16.1-b20260222
msgid "Construct webs and split unrelated uses of single variable."
msgstr "Konstruera nät och dela orelaterade användningar av en enskild variabel."

#. from tp:gcc-16.1-b20260222
msgid "Enable conditional dead code elimination for builtin calls."
msgstr "Aktivera villkorlig eliminering av död kod för inbyggda anrop."

#. from tp:gcc-16.1-b20260222
msgid "Perform whole program optimizations."
msgstr "Utför optimering av hela program."

#. from tp:gcc-16.1-b20260222
msgid "Assume pointer overflow wraps around."
msgstr "Anta att pekarspill slår runt."

#. from tp:gcc-16.1-b20260222
msgid "Assume signed arithmetic overflow wraps around."
msgstr "Anta att spill vid teckenaritmetik slår runt."

#. from tp:gcc-16.1-b20260222
msgid "Put zero initialized data in the bss section."
msgstr "Lägg nollinitierad data i bss-sektionen."

#. from tp:gcc-16.1-b20260222
msgid "Clear call-used registers upon function return."
msgstr "Nollställ anropsanvända register vid funktionsretur."

#. from tp:gcc-16.1-b20260222
msgid "-fzero-init-padding-bits=[standard|unions|all]	Zero padding bits in initializers."
msgstr "-fzero-init-padding-bits=[standard|unions|all]\tNollställ utfyllnadsbitar i initierare."

#. from tp:gcc-16.1-b20260222
msgid "Generate debug information in default format."
msgstr "Generera felsökningsinformation i standardformat."

#. from tp:gcc-16.1-b20260222
msgid "Assume assembler support for (DWARF2+) .loc directives."
msgstr "Anta att assemblern stödjer .loc-direktiv (DWARF2+)."

#. from tp:gcc-16.1-b20260222
msgid "Assume assembler support for view in (DWARF2+) .loc directives."
msgstr "Anta att assemblern stödjer vyer i .loc-direktiv (DWARF2+)."

#. from tp:gcc-16.1-b20260222
msgid "Generate debug information in CodeView format."
msgstr "Generera felsökningsinformation i CodeView-format."

#. from tp:gcc-16.1-b20260222
msgid "Record DW_AT_decl_column and DW_AT_call_column in DWARF."
msgstr "Spara DW_AT_decl_column och DW_AT_call_column i DWARF."

#. from tp:gcc-16.1-b20260222
msgid "Generate CTF debug information at default level."
msgstr "Generera CTF-felsökningsinformation på standardnivå."

#. from tp:gcc-16.1-b20260222
msgid "Generate BTF debug information at default level."
msgstr "Generera BTF-felsökningsinformation på standardnivå."

#. from tp:gcc-16.1-b20260222
msgid "Generate pruned BTF when emitting BTF info."
msgstr "Generera ansad BTF när BTF-info skrivs ut."

#. from tp:gcc-16.1-b20260222
msgid "Generate debug information in default version of DWARF format."
msgstr "Generera felsökningsinformation i standardversion av DWARF-formatet."

#. from tp:gcc-16.1-b20260222
msgid "Generate debug information in DWARF v2 (or later) format."
msgstr "Generera felsökningsinformation i DWARF v2-format (eller senare)."

#. from tp:gcc-16.1-b20260222
msgid "Use 32-bit DWARF format when emitting DWARF debug information."
msgstr "Använd 32-bitars DWARF-format vid utmatning av DWARF-felsökningsinformation."

#. from tp:gcc-16.1-b20260222
msgid "Use 64-bit DWARF format when emitting DWARF debug information."
msgstr "Använd 64-bitars DWARF-format vid utmatning av DWARF-felsökningsinformation."

#. from tp:gcc-16.1-b20260222
msgid "Generate debug information in default extended format."
msgstr "Generera felsökningsinformation i normalt utökat format."

#. from tp:gcc-16.1-b20260222
msgid "Generate extended entry point information for inlined functions."
msgstr "Generera utökad information om ingångspunkt för inline:ade funktioner."

#. from tp:gcc-16.1-b20260222
msgid "Compute locview reset points based on insn length estimates."
msgstr "Beräkna locview-återställningspunkter baserat på uppskattningar av instruktionslängd."

#. from tp:gcc-16.1-b20260222
msgid "Don't generate DWARF pubnames and pubtypes sections."
msgstr "Generera inte DWARF-sektionerna pubnames och pubtypes."

#. from tp:gcc-16.1-b20260222
msgid "Generate DWARF pubnames and pubtypes sections."
msgstr "Generera DWARF-sektionerna pubnames och pubtypes."

#. from tp:gcc-16.1-b20260222
msgid "Generate DWARF pubnames and pubtypes sections with GNU extensions."
msgstr "Generera DWARF-sektionerna pubnames och pubtypes med GNU-utvidgningar."

#. from tp:gcc-16.1-b20260222
msgid "Record gcc command line switches in DWARF DW_AT_producer."
msgstr "Notera gcc:s kommandoradsflaggor i DWARF DW_AT_producer."

#. from tp:gcc-16.1-b20260222
msgid "Generate debug information in separate .dwo files."
msgstr "Generera felsökningsinformation i separata .dwo-filer."

#. from tp:gcc-16.1-b20260222
msgid "Emit progressive recommended breakpoint locations."
msgstr "Mata ut progressiva rekommenderade brytpunktsplatser."

#. from tp:gcc-16.1-b20260222
msgid "Don't emit DWARF additions beyond selected version."
msgstr "Mata inte ut DWARF-tillägg utöver vald version."

#. from tp:gcc-16.1-b20260222
msgid "Add description attributes to some DWARF DIEs that have no name attribute."
msgstr "Lägg till beskrivningsattribut till några DWARF DIE:er som inte har något namnattribut."

#. from tp:gcc-16.1-b20260222
msgid "Toggle debug information generation."
msgstr "Växla generering av felsökningsinformation."

#. from tp:gcc-16.1-b20260222
msgid "Augment variable location lists with progressive views."
msgstr "Utöka variabelplatslistor med progressiva vyer."

#. from tp:gcc-16.1-b20260222
msgid "Generate debug information in VMS format."
msgstr "Generera felsökningsinformation i VMS-format."

#. from tp:gcc-16.1-b20260222
msgid "Generate compressed debug sections."
msgstr "Generera komprimerade felsökningssektioner."

#. from tp:gcc-16.1-b20260222
msgid "-gz=<format>	Generate compressed debug sections in format <format>."
msgstr "-gz=<format>	Generera komprimerade felsökningssektioner i formatet <format>."

#. from tp:gcc-16.1-b20260222
msgid "-iplugindir=<dir>	Set <dir> to be the default plugin directory."
msgstr "-iplugindir=<kat>\tAnge <kat> som standardkatalog för insticksmoduler."

#. from tp:gcc-16.1-b20260222
msgid "-imultiarch <dir>	Set <dir> to be the multiarch include subdirectory."
msgstr "-imultiarch <kat>\tAnge <kat> som multiarkitekturens inkluderingsunderkatalog."

#. from tp:gcc-16.1-b20260222
msgid "-o <file>	Place output into <file>."
msgstr "-o <fil>	Skriv utdata i <fil>."

#. from tp:gcc-16.1-b20260222
msgid "Enable function profiling."
msgstr "Aktivera funktionsprofilering."

#. from tp:gcc-16.1-b20260222
msgid "Like -pedantic but issue errors instead of warnings."
msgstr "Som -pedantic men ge fel i stället för varningar."

#. from tp:gcc-16.1-b20260222
msgid "Do not display functions compiled or elapsed time."
msgstr "Visa inte kompilerade funktioner eller tiden som förbrukats."

#. from tp:gcc-16.1-b20260222
msgid "Produce a relocatable object as output."
msgstr "Producera ett omlokaliserbart objekt som utdata."

#. from tp:gcc-16.1-b20260222
msgid "Remove all symbol table and relocation information from the executable."
msgstr "Ta bort all symboltabell- och omlokaliseringsinformation från den körbara filen."

#. from tp:gcc-16.1-b20260222
msgid "Enable verbose output."
msgstr "Aktivera utförlig utskrift."

#. from tp:gcc-16.1-b20260222
msgid "Display the compiler's version."
msgstr "Visa kompilatorns version."

#. from tp:gcc-16.1-b20260222
msgid "Suppress warnings."
msgstr "Undertryck varningar."

#. from tp:gcc-16.1-b20260222
msgid "Create a shared library."
msgstr "Skapa ett delat bibliotek."

#. from tp:gcc-16.1-b20260222
msgid "Don't create a dynamically linked position independent executable."
msgstr "Skapa inte ett dynamiskt länkat positionsoberoende körbart program."

#. from tp:gcc-16.1-b20260222
msgid "Create a dynamically linked position independent executable."
msgstr "Skapa ett dynamiskt länkat positionsoberoende körbart program."

#. from tp:gcc-16.1-b20260222
msgid "Create a static position independent executable."
msgstr "Skapa ett statiskt positionsoberoende körbart program."

#. from tp:gcc-16.1-b20260222
msgid "Use caller save register across calls if possible."
msgstr "Använd anroparens sparregister mellan anrop om möjligt."

#. from tp:gcc-16.1-b20260222
msgid "Perform dead code elimination on zero and sign extensions with special dataflow analysis."
msgstr "Utför eliminering av död kod vid noll- och teckenutfyllnad med en speciell dataflödesanalys."

#. from tp:gcc-16.1-b20260222
msgid "Warn for usage of non-portable extensions of Algol 68."
msgstr "Varna för användning av icke-portabla tillägg till Algol 68."

#. from tp:gcc-16.1-b20260222
msgid "Warn when voiding occurs."
msgstr "Varna när void-användning förekommer."

#. from tp:gcc-16.1-b20260222
msgid "Warn for potential name scope violations."
msgstr "Varna för möjliga överträdelser av namnräckvidd."

#. from tp:gcc-16.1-b20260222
msgid "Warn about hidden declarations in inner scopes."
msgstr "Varna för dolda deklarationer i inre räckvidder."

#. from tp:gcc-16.1-b20260222
msgid "-Whidden-declarations=[none|prelude|all] Warn about declarations hidden in inner scopes."
msgstr "-Whidden-declarations=[inget|prelude|all] Varna för deklarationer som döljs i inre räckvidder."

#. from tp:gcc-16.1-b20260222
msgid "-fbrackets  	Consider [ .. ] and { .. } as being equivalent to ( .. )."
msgstr "-fbrackets  	Betrakta [ .. ] och { .. } som likvärdiga med ( .. )."

#. from tp:gcc-16.1-b20260222
msgid "Generate code for assert contracts."
msgstr "Generera kod för assert-kontrakt."

#. from tp:gcc-16.1-b20260222
msgid "Dump Algol 68 modes after parsing."
msgstr "Dumpa Algol 68-lägen efter tolkning."

#. from tp:gcc-16.1-b20260222
msgid "Dump Algol 68 parse tree after parsing."
msgstr "Dumpa Algol 68:s tolkningsträd efter tolkning."

#. from tp:gcc-16.1-b20260222
msgid "Dump the interfaces of module definitions in the compiled packet."
msgstr "Mata ut gränssnitten för moduldefinitioner i det kompilerade paketet."

#. from tp:gcc-16.1-b20260222
msgid "Link the GNU Algol run-time library statically in the compilation."
msgstr "Länka GNU Algols körtidsbibliotek statiskt i kompileringen."

#. from tp:gcc-16.1-b20260222
msgid "Link the GNU Algol 68 run-time library dynamically in the compilation."
msgstr "Länka GNU Algol 68:s körtidsbibliotek dynamiskt i kompileringen."

#. from tp:gcc-16.1-b20260222
msgid "Compile strict Algol 68 as defined by the Revised Report."
msgstr "Kompilera strikt Algol 68 enligt definitionen i den reviderade rapporten."

#. from tp:gcc-16.1-b20260222
msgid "Accept GNU extensions to Algol 68."
msgstr "Acceptera GNU-utökningar av Algol 68."

#. from tp:gcc-16.1-b20260222
msgid "-fstropping=[upper|supper]              Stropping regime to expect in Algol 68 programs."
msgstr "-fstropping=[upper|supper]              \"Stroppnings\"-regim att förvänta sig i Algol 68-program."

#. from tp:gcc-16.1-b20260222
msgid "-fmodules-map=<mapstring>                 Association between module indicants and files."
msgstr "-fmodules-map=<mapstring>                 Association mellan modulindikatorer och filer."

#. from tp:gcc-16.1-b20260222
msgid "-fmodules-map-file=<filename>              File containing modules map."
msgstr "-fmodules-map-file=<filnamn>               Fil som innehåller modulermappning."

#. from tp:gcc-16.1-b20260222
msgid "Warn when a const variable is unused."
msgstr "Varna när en const-variabel är oanvänd."

#. from tp:gcc-16.1-b20260222
msgid "Warn if a caller of a function, marked with attribute warn_unused_result, does not use its return value."
msgstr "Varna om anroparen av en funktion, deklarerad med attributet warn_unused_result, inte använder dess returvärde."

#. from tp:gcc-16.1-b20260222
msgid "-frust-crate=<name>             Set the crate name for the compilation."
msgstr "-frust-crate=<namn>             Ange crate-namnet för kompileringen."

#. from tp:gcc-16.1-b20260222
msgid "-frust-extern=              Specify where an external library is located."
msgstr "-frust-extern=              Ange var ett externt bibliotek är placerat."

#. from tp:gcc-16.1-b20260222
msgid "Dump various Rust front end internals."
msgstr "Skriv ut diverse intern information från Rust-framänden."

#. from tp:gcc-16.1-b20260222
msgid "-frust-dump-<type>              Dump Rust frontend internal information."
msgstr "-frust-dump-<typ>               Skriv ut Rust-framändens interna information."

#. from tp:gcc-16.1-b20260222
msgid "Enable experimental compilation of Rust files at your own risk."
msgstr "Aktivera experimentell kompilering av Rust-filer på egen risk."

#. from tp:gcc-16.1-b20260222
msgid "-frust-max-recursion-depth=<integer>."
msgstr "-frust-max-recursion-depth=<heltal>."

#. from tp:gcc-16.1-b20260222
msgid "-frust-crate-type=[bin|lib|rlib|dylib|cdylib|staticlib|proc-macro]     Crate type to emit."
msgstr "-frust-crate-type=[bin|lib|rlib|dylib|cdylib|staticlib|proc-macro]     Crate-typ att mata ut."

#. from tp:gcc-16.1-b20260222
msgid "-frust-mangling=[legacy|v0]     Version to use for name mangling."
msgstr "-frust-mangling=[legacy|v0]     Version att använda för namnmangling."

#. from tp:gcc-16.1-b20260222
msgid "-frust-cfg=<name>             Set a config expansion option."
msgstr "-frust-cfg=<namn>             Ange ett konfigurationsutökningsalternativ."

#. from tp:gcc-16.1-b20260222
msgid "-frust-edition=[2015|2018|2021]             Edition to use when compiling rust code."
msgstr "-frust-edition=[2015|2018|2021]             Utgåva att använda vid kompilering av rust-kod."

#. from tp:gcc-16.1-b20260222
msgid "Enable embedding metadata directly into object files."
msgstr "Aktivera inbäddad metadata direkt i objektfiler."

#. from tp:gcc-16.1-b20260222
msgid "-frust-metadata-output=<path.rox>  Path to output crate metadata."
msgstr "-frust-metadata-output=<väg.rox>  Sökväg till utdata för crate-metadata."

#. from tp:gcc-16.1-b20260222
msgid "-frust-compile-until=[ast|attributecheck|expansion|astvalidation|featuregating|nameresolution|lowering|typecheck|privacy|unsafety|const|borrowcheck|compilation|end]             The pipeline will run up until this stage when compiling Rust code."
msgstr "-frust-compile-until=[ast|attributecheck|expansion|astvalidation|featuregating|nameresolution|lowering|typecheck|privacy|unsafety|const|borrowcheck|compilation|end]             Pipelinen körs fram till detta steg vid kompilering av Rust-kod."

#. from tp:gcc-16.1-b20260222
msgid "Use the temporary and experimental name resolution pipeline instead of the stable one."
msgstr "Använd den tillfälliga och experimentella namnuppslagningspipelinen i stället för den stabila."

#. from tp:gcc-16.1-b20260222
msgid "Use the WIP borrow checker."
msgstr "Använd WIP-lånekontrolleraren."

#. from tp:gcc-16.1-b20260222
msgid "-frust-edition=[unwind|abort]             Panic strategy to compile crate with."
msgstr "-frust-edition=[unwind|abort]             Panikstrategi att kompilera lådan med."

#. from tp:gcc-16.1-b20260222
msgid "Enable the overflow checks in code generation."
msgstr "Aktivera spillkontroller i kodgenereringen."

#. from tp:gcc-16.1-b20260222
msgid "Define a built-in offset_of macro in the compiler and assume it is present."
msgstr "Definiera ett inbyggt makro offset_of i kompilatorn och anta att det finns."

#. from tp:gcc-16.1-b20260222
msgid "Use the new unused variable check implementation."
msgstr "Använd den nya oanvända implementationen av variabelkontroll."

#. from tp:gcc-16.1-b20260222
msgid "Enable most warning messages."
msgstr "Aktivera de flesta varningsmeddelanden."

#. from tp:gcc-16.1-b20260222
msgid "Dump Source Coverage Obligations."
msgstr "Dumpa källkodstäckningskrav."

#. from tp:gcc-16.1-b20260222
msgid "Synonym of -gnatk8."
msgstr "Synonym för -gnatk8."

#. from tp:gcc-16.1-b20260222
msgid "Do not look for object files in standard path."
msgstr "Titta inte efter objektfiler i standardsökvägen."

#. from tp:gcc-16.1-b20260222
msgid "Select the runtime."
msgstr "Välj körtidssystem."

#. from tp:gcc-16.1-b20260222
msgid "Use the narrowest integer type possible for enumeration types."
msgstr "Använd den smalaste möjliga heltalstypen för uppräkningstyper."

#. from tp:gcc-16.1-b20260222
msgid "Make \"char\" signed by default."
msgstr "Låt ”char” ha tecken som standard."

#. from tp:gcc-16.1-b20260222
msgid "Make \"char\" unsigned by default."
msgstr "Gör ”char” teckenlöst som standard."

#. from tp:gcc-16.1-b20260222
msgid "Catch typos."
msgstr "Fånga skrivfel."

#. from tp:gcc-16.1-b20260222
msgid "Set name of output ALI file (internal switch)."
msgstr "Sätt namnet på utmatnings-ALI-filen (intern flagga)."

#. from tp:gcc-16.1-b20260222
msgid "-gnat<options>	Specify options to GNAT."
msgstr "-gnat<flaggor>	Ange flaggor till GNAT."

#. from tp:gcc-16.1-b20260222
msgid "Ignored."
msgstr "Ignorerad."

#. from tp:gcc-16.1-b20260222
msgid "--compile-std-module	Compile module units for <bits/stdc++.h>, std, and std.compat."
msgstr "--compile-std-module\tKompilera modulenheter för <bits/stdc++.h>, std och std.compat."

#. from tp:gcc-16.1-b20260222
msgid "--embed-dir=<dir>	Add <dir> to the #embed path."
msgstr "--embed-dir=<kat>	Lägg till <kat> till #embed-sökvägen."

#. from tp:gcc-16.1-b20260222
msgid "-A<question>=<answer>	Assert the <answer> to <question>.  Putting '-' before <question> disables the <answer> to <question>."
msgstr "-A<fråga>=<svar>	Intyga <svar> på <fråga>.  Om ”-” sätts före <fråga> avaktiveras <svar>:et till <fråga>:n."

#. from tp:gcc-16.1-b20260222
msgid "Do not discard comments."
msgstr "Kasta inte bort kommentarer."

#. from tp:gcc-16.1-b20260222
msgid "Do not discard comments in macro expansions."
msgstr "Släng inte kommentarer vid makroexpansioner."

#. from tp:gcc-16.1-b20260222
msgid "-D<macro>[=<val>]	Define a <macro> with <val> as its value.  If just <macro> is given, <val> is taken to be 1."
msgstr "-D<makro>[=<värde>]	Definiera ett <makro> med <värde> som sitt värde.  Om bara <makro> anges sätts <värde> till 1."

#. from tp:gcc-16.1-b20260222
msgid "-F <dir>	Add <dir> to the end of the main framework include path."
msgstr "-F <kat>	Lägg till <kat> till slutet av huvudramverkets inkluderingssökväg."

#. from tp:gcc-16.1-b20260222
msgid "Enable parsing GIMPLE."
msgstr "Aktivera tolkning av GIMPLE."

#. from tp:gcc-16.1-b20260222
msgid "Print the name of header files as they are used."
msgstr "Skriv ut namnet på huvudfiler allteftersom de används."

#. from tp:gcc-16.1-b20260222
msgid "-I <dir>	Add <dir> to the end of the main include path."
msgstr "-I <kat>	Lägg till <kat> till slutet av huvudsökvägen."

#. from tp:gcc-16.1-b20260222
msgid "Generate make dependencies."
msgstr "Generera make-beroenden."

#. from tp:gcc-16.1-b20260222
msgid "Generate make dependencies and compile."
msgstr "Generera make-beroenden och kompilera."

#. from tp:gcc-16.1-b20260222
msgid "-MF <file>	Write dependency output to the given file."
msgstr "-MF <fil>	Skriv beroendeutdata till den angivna filen."

#. from tp:gcc-16.1-b20260222
msgid "Treat missing header files as generated files."
msgstr "Behandla saknade huvudfiler som genererade filer."

#. from tp:gcc-16.1-b20260222
msgid "Like -M but ignore system header files."
msgstr "Som -M men ignorera systemhuvudfiler."

#. from tp:gcc-16.1-b20260222
msgid "Like -MD but ignore system header files."
msgstr "Som -MD men ignorera systemhuvudfiler."

#. from tp:gcc-16.1-b20260222
msgid "Generate C++ Module dependency information."
msgstr "Generera C++ modulberoendeinformation."

#. from tp:gcc-16.1-b20260222
msgid "Generate phony targets for all headers."
msgstr "Generera låtsasmål för alla huvuden."

#. from tp:gcc-16.1-b20260222
msgid "-MQ <target>	Add a target that may require quoting."
msgstr "-MQ <mål>	Lägg till ett mål som kan kräva citationstecken."

#. from tp:gcc-16.1-b20260222
msgid "-MT <target>	Add a target that does not require quoting."
msgstr "-MT <mål>	Lägg till ett mål som inte kräver citationstecken."

#. from tp:gcc-16.1-b20260222
msgid "Structured format for output dependency information.  Supported (\"p1689r5\")."
msgstr "Strukturerat format för utdata av beroendeinformation.  Stöds (”p1689r5”)."

#. from tp:gcc-16.1-b20260222
msgid "File for output dependency information."
msgstr "Fil för utdata av beroendeinformation."

#. from tp:gcc-16.1-b20260222
msgid "-fdeps-target=obj.o Output file for the compile step."
msgstr "-fdeps-target=obj.o Utmatningsfil för kompileringssteget."

#. from tp:gcc-16.1-b20260222
msgid "Do not generate #line directives."
msgstr "Generera inte #line-direktiv."

#. from tp:gcc-16.1-b20260222
msgid "-U<macro>	Undefine <macro>."
msgstr "-U<makro>	Avdefiniera <makro>."

#. from tp:gcc-16.1-b20260222
msgid "Warn if the NSObject attribute is applied to a non-typedef."
msgstr "Varna om attributet NSObject används på en icke-typedef."

#. from tp:gcc-16.1-b20260222
msgid "Warn about things that will change when compiling with an ABI-compliant compiler."
msgstr "Varna för saker som skulle ändras vid kompilering med en kompilator som följer ABI."

#. from tp:gcc-16.1-b20260222
msgid "Warn about things that change between the current -fabi-version and the specified version."
msgstr "Varna för saker som ändras mellan den nuvarande -fabi-version och den angivna versionen."

#. from tp:gcc-16.1-b20260222
msgid "Warn if a subobject has an abi_tag attribute that the complete object type does not have."
msgstr "Varna om ett underobjekt har ett abi_tag-attribut som det fullständiga objektets typ inte har."

#. from tp:gcc-16.1-b20260222
msgid "Warn about code affected by incompatible psABI changes."
msgstr "Varna för kod som påverkas av inkompatibla psABI-ändringar."

#. from tp:gcc-16.1-b20260222
msgid "Warn on suspicious calls of standard functions computing absolute values."
msgstr "Varna för misstänkta anrop av standardfunktioner som beräknar absoluta värden."

#. from tp:gcc-16.1-b20260222
msgid "Warn about suspicious uses of memory addresses."
msgstr "Varna för misstänkt användning av minnesadresser."

#. from tp:gcc-16.1-b20260222
msgid "Warn when the address of packed member of struct or union is taken."
msgstr "Varna när adressen till en packad medlem i en post eller union tas."

#. from tp:gcc-16.1-b20260222
msgid "Warn about 'new' of type with extended alignment without -faligned-new."
msgstr "Varna för ”new” av en typ med utökad justering utan -faligned-new."

#. from tp:gcc-16.1-b20260222
msgid "-Waligned-new=[none|global|all]	Warn even if 'new' uses a class member allocation function."
msgstr "-Waligned-new=[none|global|all]	Varna även om ”new” använder en allokeringsfunktion som är klassmedlem."

#. from tp:gcc-16.1-b20260222
msgid "Warn on any use of alloca."
msgstr "Varna vid all användning av alloca."

#. from tp:gcc-16.1-b20260222
msgid "Warn when allocating insufficient storage for the target type of the assigned pointer."
msgstr "Varna när otillräckligt med lagring allokeras för måltypen för den tilldelade pekaren."

#. from tp:gcc-16.1-b20260222
msgid "-Walloc-size-larger-than=<bytes>	Warn for calls to allocation functions that attempt to allocate objects larger than the specified number of bytes."
msgstr "-Walloc-size-larger-than=<byte>	Varna för anrop till allokeringsfunktioner som försöker allokera objekt som är större än det angivna antalet byte."

#. from tp:gcc-16.1-b20260222
msgid "Disable Walloc-size-larger-than= warning.  Equivalent to Walloc-size-larger-than=<SIZE_MAX> or larger."
msgstr "Avaktivera varningen Walloc-size-larger-than=.  Ekvivalent med Walloc-size-larger-than=<SIZE_MAX> eller större."

#. from tp:gcc-16.1-b20260222
msgid "Warn for calls to allocation functions that specify zero bytes."
msgstr "Varna för anrop till allokeringsfunktioner som anger noll byte."

#. from tp:gcc-16.1-b20260222
msgid "-Walloca-larger-than=<number>	Warn on unbounded uses of alloca, and on bounded uses of alloca whose bound can be larger than <number> bytes."
msgstr "-Walloca-larger-than=<antal>	Varna vid obegränsade användningar av alloca, och vid begränsade användningar av alloca vars gränser kan vara större än <antal> byte."

#. from tp:gcc-16.1-b20260222
msgid "Disable Walloca-larger-than= warning.  Equivalent to Walloca-larger-than=<SIZE_MAX> or larger."
msgstr "Avaktivera varningen Walloca-larger-than=.  Ekvivalent med Walloca-larger-than=<SIZE_MAX> eller större."

#. from tp:gcc-16.1-b20260222
msgid "Warn if conversion of the result of arithmetic might change the value even though converting the operands cannot."
msgstr "Varna om konverteringar av resultatet av aritmetik kan ändra värdet även om konvertering av operanderna inte kan det."

#. from tp:gcc-16.1-b20260222
msgid "Warn about comparisons between two operands of array type."
msgstr "Varna för jämförelser mellan två operander av vektortyp."

#. from tp:gcc-16.1-b20260222
msgid "Warn about mismatched declarations of array parameters and unsafe accesses to them."
msgstr "Varna för deklarationer av vektorparametrar som inte stämmer överens och osäker åtkomst av dem."

#. from tp:gcc-16.1-b20260222
msgid "Warn whenever an Objective-C assignment is being intercepted by the garbage collector."
msgstr "Varna när en Objective-C-tilldelning fångas upp av skräpsamlaren."

#. from tp:gcc-16.1-b20260222
msgid "Diagnose a placeholder type in a template argument in a function parameter type."
msgstr "Diagnostisera en platshållartyp i ett mallargument i en funktionsparametertyp."

#. from tp:gcc-16.1-b20260222
msgid "Warn about casting functions to incompatible types."
msgstr "Varna för typkonvertering av funktioner till inkompatibla typer."

#. from tp:gcc-16.1-b20260222
msgid "-Wbidi-chars=[none|unpaired|any|ucn] Warn about UTF-8 bidirectional control characters."
msgstr "-Wbidi-chars=[none|unpaired|any|ucn] Varna för dubbelriktade UTF-8-styrtecken."

#. from tp:gcc-16.1-b20260222
msgid "Warn about boolean expression compared with an integer value different from true/false."
msgstr "Varna för booleska uttryck som jämförs med ett heltalsvärde annat än sant/falskt."

#. from tp:gcc-16.1-b20260222
msgid "Warn about certain operations on boolean expressions."
msgstr "Varna för vissa operationer på booleska uttryck."

#. from tp:gcc-16.1-b20260222
msgid "Warn when a built-in function is declared with the wrong signature."
msgstr "Varna när en inbyggd funktion deklareras med fel signatur."

#. from tp:gcc-16.1-b20260222
msgid "Warn when a built-in preprocessor macro is undefined or redefined."
msgstr "Varna när ett inbyggt preprocessormakro avdefinieras eller omdefinieras."

#. from tp:gcc-16.1-b20260222
msgid "Warn about features not present in ISO C11, but present in ISO C23."
msgstr "Varna för funktioner som inte finns i ISO C11, men finns i ISO C23."

#. from tp:gcc-16.1-b20260222
msgid "Deprecated in favor of -Wc11-c23-compat."
msgstr "Föråldrad till förmån för -Wc11-c23-compat."

#. from tp:gcc-16.1-b20260222
msgid "Warn about features not present in ISO C23, but present in ISO C2Y."
msgstr "Varna för funktioner som inte finns i ISO C23, men finns i ISO C2Y."

#. from tp:gcc-16.1-b20260222
msgid "Warn about features not present in ISO C90, but present in ISO C99."
msgstr "Varna för funktioner som inte finns i ISO C90, men finns i ISO C99."

#. from tp:gcc-16.1-b20260222
msgid "Warn about features not present in ISO C99, but present in ISO C11."
msgstr "Varna för funktioner som inte finns i ISO C99, men finns i ISO C11."

#. from tp:gcc-16.1-b20260222
msgid "Warn about C constructs that are not in the common subset of C and C++."
msgstr "Varna för C-konstruktioner som inte är i den gemensamma delmängden av C och C++."

#. from tp:gcc-16.1-b20260222
msgid "Warn about C++ constructs whose meaning differs between ISO C++ 1998 and ISO C++ 2011."
msgstr "Varna för C++-konstruktioner vars betydelse skiljer mellan ISO C++ 1998 och ISO C++ 2011."

#. from tp:gcc-16.1-b20260222
msgid "Warn about C++ constructs whose meaning differs between ISO C++ 2011 and ISO C++ 2014."
msgstr "Varna för C++-konstruktioner vars betydelse skiljer mellan ISO C++ 2011 och ISO C++ 2014."

#. from tp:gcc-16.1-b20260222
msgid "Warn about C++ constructs whose meaning differs between ISO C++ 2014 and ISO C++ 2017."
msgstr "Varna för C++-konstruktioner vars betydelse skiljer mellan ISO C++ 2014 och ISO C++ 2017."

#. from tp:gcc-16.1-b20260222
msgid "Warn about C++ constructs whose meaning differs between ISO C++ 2017 and ISO C++ 2020."
msgstr "Varna för C++-konstruktioner vars betydelse skiljer mellan ISO C++ 2017 och ISO C++ 2020."

#. from tp:gcc-16.1-b20260222
msgid "Warn about C++ constructs whose meaning differs between ISO C++ 2023 and ISO C++ 2026."
msgstr "Varna för C++-konstruktioner vars betydelse skiljer mellan ISO C++ 2023 och ISO C++ 2026."

#. from tp:gcc-16.1-b20260222
msgid "Warn about C++11 constructs in code compiled with an older standard."
msgstr "Varna för C++11-konstruktioner i kod kompilerad med en äldre standard."

#. from tp:gcc-16.1-b20260222
msgid "Warn about C++14 constructs in code compiled with an older standard."
msgstr "Varna för C++14-konstruktioner i kod kompilerad med en äldre standard."

#. from tp:gcc-16.1-b20260222
msgid "Warn about C++17 constructs in code compiled with an older standard."
msgstr "Varna för C++17-konstruktioner i kod kompilerad med en äldre standard."

#. from tp:gcc-16.1-b20260222
msgid "Warn about C++20 constructs in code compiled with an older standard."
msgstr "Varna för C++20-konstruktioner i kod kompilerad med en äldre standard."

#. from tp:gcc-16.1-b20260222
msgid "Warn about C++23 constructs in code compiled with an older standard."
msgstr "Varna för C++23-konstruktioner i kod kompilerad med en äldre standard."

#. from tp:gcc-16.1-b20260222
msgid "Warn about C++26 constructs in code compiled with an older standard."
msgstr "Varna för C++26-konstruktioner i kod kompilerad med en äldre standard."

#. from tp:gcc-16.1-b20260222
msgid "Warn about suspicious calls to calloc-like functions where sizeof expression is the earlier size argument and not the latter."
msgstr "Varna för misstänkta anrop av calloc-liknande funktioner där sizeof-uttryck är det tidigare storleksargumentet och inte det senare."

#. from tp:gcc-16.1-b20260222
msgid "Warn about casts between incompatible function types."
msgstr "Varna för typkonvertering mellan inkompatibla funktionstyper."

#. from tp:gcc-16.1-b20260222
msgid "Warn about casts which discard qualifiers."
msgstr "Varna för typkonvertering som slänger kvalificerare."

#. from tp:gcc-16.1-b20260222
msgid "Warn about a cast to reference type that does not use a related user-defined conversion function."
msgstr "Varna för en typkonvertering till en referenstyp som inte använder en relaterad användardefinierad konverteringsfunktion."

#. from tp:gcc-16.1-b20260222
msgid "Warn about catch handlers of non-reference type."
msgstr "Varna för catch-hanterare av icke-referenstyp."

#. from tp:gcc-16.1-b20260222
msgid "Complain about a name being declared as a class member after a previous use of the same name."
msgstr "Klaga om ett namn deklareras som en klassmedlem efter en tidigare användning av samma namn."

#. from tp:gcc-16.1-b20260222
msgid "Warn about subscripts whose type is \"char\"."
msgstr "Varna för index vars typ är ”char”."

#. from tp:gcc-16.1-b20260222
msgid "Warn when a conversion function will never be called due to the type it converts to."
msgstr "Varna när en konverteringsfunktion aldrig kommer att anropas på grund av typen den konverterar till."

#. from tp:gcc-16.1-b20260222
msgid "Warn for unsafe raw memory writes to objects of class types."
msgstr "Varna för osäkra råa minnesskrivningar till objekt av klasstyper."

#. from tp:gcc-16.1-b20260222
msgid "Warn about variables that might be changed by \"longjmp\" or \"vfork\"."
msgstr "Varna för variabler som kan ändras av ”longjmp” eller ”vfork”."

#. from tp:gcc-16.1-b20260222
msgid "Warn about uses of a comma operator within a subscripting expression."
msgstr "Varna för användning av en kommaoperator i ett indexuttryck."

#. from tp:gcc-16.1-b20260222
msgid "Warn about possibly nested block comments, and C++ comments spanning more than one physical line."
msgstr "Varna för möjliga nästade blockkommentarer, och C++-kommentarer som spänner över mer än en fysisk rad."

#. from tp:gcc-16.1-b20260222
msgid "Synonym for -Wcomment."
msgstr "Synonym för -Wcomment."

#. from tp:gcc-16.1-b20260222
msgid "Warn for conditionally-supported constructs."
msgstr "Varna för konstruktioner med villkorligt stöd."

#. from tp:gcc-16.1-b20260222
msgid "Warn for implicit type conversions that may change a value."
msgstr "Varna för implicita typkonverteringar som kan ändra ett värde."

#. from tp:gcc-16.1-b20260222
msgid "Warn for converting NULL from/to a non-pointer type."
msgstr "Varna för konvertering av NULL från eller till en icke-pekartyp."

#. from tp:gcc-16.1-b20260222
msgid "Warn when performing class template argument deduction on a type with no deduction guides."
msgstr "Varna när härledning av klassmallargument utförs på en typ utan några härledningsguider."

#. from tp:gcc-16.1-b20260222
msgid "Warn when all constructors and destructors are private."
msgstr "Varna när alla konstruerare och destruerare är privata."

#. from tp:gcc-16.1-b20260222
msgid "Warn about dangling else."
msgstr "Varna för hängande else."

#. from tp:gcc-16.1-b20260222
msgid "Warn for uses of pointers to auto variables whose lifetime has ended."
msgstr "Varna för användning av pekare till auto-variabler vars livstid är över."

#. from tp:gcc-16.1-b20260222
msgid "Warn when a reference is bound to a temporary whose lifetime has ended."
msgstr "Varna när en referens binds till en temporär variabel vars livstid är över."

#. from tp:gcc-16.1-b20260222
msgid "Warn about __TIME__, __DATE__ and __TIMESTAMP__ usage."
msgstr "Varna för användning av __TIME__, __DATE__ och __TIMESTAMP__."

#. from tp:gcc-16.1-b20260222
msgid "Warn when a declaration is found after a statement."
msgstr "Varna när en deklaration hittas efter en sats."

#. from tp:gcc-16.1-b20260222
msgid "Warn for missing parameter types in function declarations."
msgstr "Varna för saknade parametertyper i funktionsdeklarationer."

#. from tp:gcc-16.1-b20260222
msgid "Warn when an explicitly defaulted function is deleted."
msgstr "Varna när en funktion med explicit standardvärde raderas."

#. from tp:gcc-16.1-b20260222
msgid "Warn when deleting a pointer to incomplete type."
msgstr "Varna när en pekare till en ofullständig typ raderas."

#. from tp:gcc-16.1-b20260222
msgid "Warn about deleting polymorphic objects with non-virtual destructors."
msgstr "Varna för radering av polymorfa objekt med icke-virtuella destruerare."

#. from tp:gcc-16.1-b20260222
msgid "Mark implicitly-declared copy operations as deprecated if the class has a user-provided copy operation."
msgstr "Markera att implicit deklarerade kopieringsoperationer bör undvikas om klassen har en kopieringsoperator tillhandahållen av användaren."

#. from tp:gcc-16.1-b20260222
msgid "Mark implicitly-declared copy operations as deprecated if the class has a user-provided copy operation or destructor."
msgstr "Markera att implicit deklarerade kopieringsoperationer bör undvikas om klassen har en kopieringsoperator eller destruerare tillhandahållen av användaren."

#. from tp:gcc-16.1-b20260222
msgid "Warn about deprecated arithmetic conversions on operands of enumeration types."
msgstr "Varna för föråldrade aritmetiska konverteringar av operander av uppräkningstyper."

#. from tp:gcc-16.1-b20260222
msgid "Warn about deprecated arithmetic conversions on operands where one is of enumeration type and the other is of a floating-point type."
msgstr "Varna för aritmetiska konverteringar som bör undvikas på operander där en är av uppräkningstyp och den andra är av en flyttalstyp."

#. from tp:gcc-16.1-b20260222
msgid "Warn about deprecated space between \"\" and suffix in a user-defined literal operator."
msgstr "Varna för föråldrade mellanrum mellan \"\" och suffix i en användardefinierad literal operator."

#. from tp:gcc-16.1-b20260222
msgid "Warn about calls with arguments to functions declared without parameters."
msgstr "Varna för anrop med argument till funktioner deklarerade utan parametrar."

#. from tp:gcc-16.1-b20260222
msgid "Warn about deprecated OpenMP code."
msgstr "Varna för föråldrad OpenMP-kod."

#. from tp:gcc-16.1-b20260222
msgid "Warn about deprecated omission of comma before ... in varargs function declaration."
msgstr "Varna för föråldrat utelämnande av kommatecken före ... i varargs-funktionsdeklarationer."

#. from tp:gcc-16.1-b20260222
msgid "Warn about positional initialization of structs requiring designated initializers."
msgstr "Varna för positionsinitiering av poster som kräver designerade initierare."

#. from tp:gcc-16.1-b20260222
msgid "Warn if qualifiers on arrays which are pointer targets are discarded."
msgstr "Varna om kvalificerare på vektorer som är pekarmål kastas bort."

#. from tp:gcc-16.1-b20260222
msgid "Warn if type qualifiers on pointers are discarded."
msgstr "Varna om typkvalificerare på pekare kastas bort."

#. from tp:gcc-16.1-b20260222
msgid "Warn about compile-time integer division by zero."
msgstr "Varna för heltalsdivision med noll vid kompileringstillfället."

#. from tp:gcc-16.1-b20260222
msgid "Warn about implicit conversions from \"float\" to \"double\"."
msgstr "Varna för implicita konverteringar från ”float” till ”double”."

#. from tp:gcc-16.1-b20260222
msgid "Warn when a declaration has duplicate const, volatile, restrict or _Atomic specifier."
msgstr "Varna när en deklaration har dubblerade const-, volatile-, restrict- eller _Atomic-specificerare."

#. from tp:gcc-16.1-b20260222
msgid "Warn about duplicated branches in if-else statements."
msgstr "Varna för dubblerade grenar i if-else-satser."

#. from tp:gcc-16.1-b20260222
msgid "Warn about duplicated conditions in an if-else-if chain."
msgstr "Varna för dubblerade villkor i en if-else-if-kedja."

#. from tp:gcc-16.1-b20260222
msgid "Warn about violations of Effective C++ style rules."
msgstr "Varna för brott mot stilreglerna i Effective C++."

#. from tp:gcc-16.1-b20260222
msgid "Warn if an additional enum-base is used in an elaborated-type-specifier."
msgstr "Varna om en ytterligare enum-bas används i en elaborated-type-specifier."

#. from tp:gcc-16.1-b20260222
msgid "Warn about an empty body in an if or else statement."
msgstr "Varna för en tom kropp i en if- eller else-sats."

#. from tp:gcc-16.1-b20260222
msgid "Warn about stray tokens after #else and #endif."
msgstr "Varna för vilsekomna symboler efter #else och #endif."

#. from tp:gcc-16.1-b20260222
msgid "Warn about comparison of different enum types."
msgstr "Varna för jämförelser av skilda uppräkningstyper."

#. from tp:gcc-16.1-b20260222
msgid "Warn about implicit conversion of enum types."
msgstr "Varna för implicita konverteringar av enum-typer."

#. from tp:gcc-16.1-b20260222
msgid "Warn about enum/integer type mismatches."
msgstr "Varna för enum/heltalstyper som inte stämmer."

#. from tp:gcc-16.1-b20260222
msgid "This switch is deprecated; use -Werror=implicit-function-declaration instead."
msgstr "Denna flagga är föråldrad; använd -Werror=implicit-function-declaration i stället."

#. from tp:gcc-16.1-b20260222
msgid "Warn when an exception handler is shadowed by another handler."
msgstr "Varna när en undantagshanterare skuggas av en annan hanterare."

#. from tp:gcc-16.1-b20260222
msgid "Warn if \"defined\" is used outside #if."
msgstr "Varna om ”defined” är utanför #if."

#. from tp:gcc-16.1-b20260222
msgid "Warn about naming a TU-local entity declared in another translation unit."
msgstr "Varna när en TU-lokal enhet deklarerad i en annan översättningsenhet nämns."

#. from tp:gcc-16.1-b20260222
msgid "Warn when a module exposes a TU-local entity from the global module fragment."
msgstr "Varna när en modul exponerar en TU-lokal enhet från det globala modulfragmentet."

#. from tp:gcc-16.1-b20260222
msgid "Warn about semicolon after in-class function definition."
msgstr "Varna för semikolon efter en funktionsdefinition i en klass."

#. from tp:gcc-16.1-b20260222
msgid "Warn when a structure containing a C99 flexible array member as the last field is not at the end of another structure."
msgstr "Varna när en post som innehåller en flexibel vektormedlem enligt C99 som sista fält inte är vid slutet av en annan post."

#. from tp:gcc-16.1-b20260222
msgid "Warn for implicit type conversions that cause loss of floating point precision."
msgstr "Varna för implicita typkonverteringar som orsakar förlust av flyttalsprecision."

#. from tp:gcc-16.1-b20260222
msgid "Warn if testing floating point numbers for equality."
msgstr "Varna vid test av flyttal på likhet."

#. from tp:gcc-16.1-b20260222
msgid "Warn about printf/scanf/strftime/strfmon format string anomalies."
msgstr "Varna för anomalier i formatsträngar till printf/scanf/strftime/strfmon."

#. from tp:gcc-16.1-b20260222
msgid "Warn about format strings that contain NUL bytes."
msgstr "Varna för formatsträngar som innehåller NUL-byte:ar."

#. from tp:gcc-16.1-b20260222
msgid "Warn about GCC format strings with strings unsuitable for diagnostics."
msgstr "Varna för GCC-formatsträngar med strängar som inte passar till felmeddelanden."

#. from tp:gcc-16.1-b20260222
msgid "Warn if passing too many arguments to a function for its format string."
msgstr "Varna för för många argument till en funktion för dess formatsträng."

#. from tp:gcc-16.1-b20260222
msgid "Warn about format strings that are not literals."
msgstr "Varna för formatsträngar som inte är litteraler."

#. from tp:gcc-16.1-b20260222
msgid "Warn about function calls with format strings that write past the end of the destination region.  Same as -Wformat-overflow=1."
msgstr "Varna för funktionsanrop med formatsträngar som skriver utanför slutet av destinationsregionen.  Samma som -Wformat-overflow=1."

#. from tp:gcc-16.1-b20260222
msgid "Warn about function calls with format strings that write past the end of the destination region."
msgstr "Varna för funktionsanrop med formatsträngar som skriver utanför slutet av destinationsregionen."

#. from tp:gcc-16.1-b20260222
msgid "Warn about possible security problems with format functions."
msgstr "Varna för möjliga säkerhetsproblem med formatfunktioner."

#. from tp:gcc-16.1-b20260222
msgid "Warn about sign differences with format functions."
msgstr "Varna för teckenskillnader i formatfunktioner."

#. from tp:gcc-16.1-b20260222
msgid "Warn about calls to snprintf and similar functions that truncate output. Same as -Wformat-truncation=1."
msgstr "Varna för anrop till snprintf och liknande funktioner som hugger av utdata.  Samma som -Wformat-truncation=1."

#. from tp:gcc-16.1-b20260222
msgid "Warn about calls to snprintf and similar functions that truncate output."
msgstr "Varna för anrop till snprintf och liknande funktioner som hugger av utdata."

#. from tp:gcc-16.1-b20260222
msgid "Warn about strftime formats yielding 2-digit years."
msgstr "Varna för format till strftime som ger 2-siffrigt årtal."

#. from tp:gcc-16.1-b20260222
msgid "Warn about zero-length formats."
msgstr "Varna för format med längden noll."

#. from tp:gcc-16.1-b20260222
msgid "Warn when __builtin_frame_address or __builtin_return_address is used unsafely."
msgstr "Varna när __builtin_frame_address eller __builtin_return_address används osäkert."

#. from tp:gcc-16.1-b20260222
msgid "Warn about labels on declarations and at the end of compound statements."
msgstr "Varna för etikett på deklarationer och vid slutet av sammansatta satser."

#. from tp:gcc-16.1-b20260222
msgid "Warn about the global module fragment not containing only preprocessing directives."
msgstr "Varna för att det globala modulfragmentet inte endast innehåller preprocessordirektiv."

#. from tp:gcc-16.1-b20260222
msgid "Warn when #ifndef of a header guard is followed by #define of a different macro with the header guard macro not defined at the end of header."
msgstr "Varna när #ifndef av en huvudvakt följs av en #define av ett annat makro och huvudvaktsmakrot inte är definierat vid slutet av huvudet."

#. from tp:gcc-16.1-b20260222
msgid "Warn when the field in a struct is not aligned."
msgstr "Varna när fältet i en struktur inte är justerat."

#. from tp:gcc-16.1-b20260222
msgid "Warn whenever type qualifiers are ignored."
msgstr "Varna när typkvalificerare ignoreras."

#. from tp:gcc-16.1-b20260222
msgid "Warn whenever attributes are ignored."
msgstr "Varna när attribut ignoreras."

#. from tp:gcc-16.1-b20260222
msgid "Warn about implicit declarations."
msgstr "Varna för implicita deklarationer."

#. from tp:gcc-16.1-b20260222
msgid "Warn about implicit function declarations."
msgstr "Varna för implicita funktionsdeklarationer."

#. from tp:gcc-16.1-b20260222
msgid "Warn when a declaration does not specify a type."
msgstr "Varna när en deklaration inte anger en typ."

#. from tp:gcc-16.1-b20260222
msgid "Warn when a base is inaccessible in derived due to ambiguity."
msgstr "Varna när en bas är oåtkomlig i en härledd på grund av tvetydighet."

#. from tp:gcc-16.1-b20260222
msgid "Warn when there is a conversion between pointers that have incompatible types."
msgstr "Varna när det finns en konvertering mellan pekare med inkompatibla typer."

#. from tp:gcc-16.1-b20260222
msgid "Warn about variables which are initialized to themselves."
msgstr "Varna för variabler som initieras till sig själva."

#. from tp:gcc-16.1-b20260222
msgid "Warn about uses of std::initializer_list that can result in dangling pointers."
msgstr "Varna för användningar av std::initializer_list som kan resultera i hängande pekare."

#. from tp:gcc-16.1-b20260222
msgid "Warn about nonsensical values of --param destructive-interference-size or constructive-interference-size."
msgstr "Varna för meningslösa värden till --param destructive-interference-size eller constructive-interference-size."

#. from tp:gcc-16.1-b20260222
msgid "Warn about C++11 inheriting constructors when the base has a variadic constructor."
msgstr "Varna för C++11 ärvda konstruerare när basen har en variadisk konstruerare."

#. from tp:gcc-16.1-b20260222
msgid "Warn about incompatible integer to pointer and pointer to integer conversions."
msgstr "Varna för inkompatibla konverteringar från heltal till pekare och från pekare till heltal."

#. from tp:gcc-16.1-b20260222
msgid "Warn for suspicious integer expressions in boolean context."
msgstr "Varna för misstänkta heltalsuttryck i booleska sammanhang."

#. from tp:gcc-16.1-b20260222
msgid "Warn when there is a cast to a pointer from an integer of a different size."
msgstr "Varna för typkonverteringar till pekare från ett heltal med annan storlek."

#. from tp:gcc-16.1-b20260222
msgid "Warn when a function never produces a constant expression."
msgstr "Varna när en funktion aldrig producerar ett konstant uttryck."

#. from tp:gcc-16.1-b20260222
msgid "Warn about invalid uses of the \"offsetof\" macro."
msgstr "Varna för ogiltiga användningar av makrot ”offsetof”."

#. from tp:gcc-16.1-b20260222
msgid "Warn about PCH files that are found but not used."
msgstr "Varna för PCH-filer som hittas men inte används."

#. from tp:gcc-16.1-b20260222
msgid "Warn about invalid UTF-8 characters."
msgstr "Varna för felaktiga UTF-8-tecken."

#. from tp:gcc-16.1-b20260222
msgid "Warn when a jump misses a variable initialization."
msgstr "Varna när ett hopp missar en variabelinitiering."

#. from tp:gcc-16.1-b20260222
msgid "Warn about defining or undefining macros with identifiers equal to keywords (or for C++ conditional keywords or standard attribute names)."
msgstr "Varna för definitioner eller avdefinitioner av makron med identifierare som är lika med nyckelord (eller för C++ villkorliga nyckelord eller standardattributnamn)."

#. from tp:gcc-16.1-b20260222
msgid "Warn about leading whitespace style issues on lines except when in raw string literals."
msgstr "Varna för stilproblem med inledande blanktecken på rader utom inom råa stränglitteraler."

#. from tp:gcc-16.1-b20260222
msgid "Warn when a string or character literal is followed by a ud-suffix which does not begin with an underscore."
msgstr "Varna när en sträng- eller teckenkonstant följs av ett ud-suffix som inte börjar med ett understrykningstecken."

#. from tp:gcc-16.1-b20260222
msgid "Warn when logical not is used on the left hand side operand of a comparison."
msgstr "Varna när logiskt icke används på den vänstra operanden i en jämförelse."

#. from tp:gcc-16.1-b20260222
msgid "Warn when a logical operator is suspiciously always evaluating to true or false."
msgstr "Varna när en logisk operator misstänkt nog alltid beräknas till sant eller falskt."

#. from tp:gcc-16.1-b20260222
msgid "Do not warn about using \"long long\" when -pedantic."
msgstr "Varna inte om användning av ”long long” vid -pedantic."

#. from tp:gcc-16.1-b20260222
msgid "Warn about suspicious declarations of \"main\"."
msgstr "Varna för tveksamma deklarationer av ”main”."

#. from tp:gcc-16.1-b20260222
msgid "Warn about suspicious calls to memset where the third argument contains the number of elements not multiplied by the element size."
msgstr "Varna för misstänkta anrop till memset där det tredje argumentet innehåller antalet element som inte har multiplicerats med elementstorleken."

#. from tp:gcc-16.1-b20260222
msgid "Warn about suspicious calls to memset where the third argument is constant literal zero and the second is not."
msgstr "Varna för misstänkta anrop till memset där det tredje argumentet är en konstant litteral nolla och det andra inte är det."

#. from tp:gcc-16.1-b20260222
msgid "Warn when the indentation of the code does not reflect the block structure."
msgstr "Varna när indenteringen av koden inte avspeglar blockstrukturen."

#. from tp:gcc-16.1-b20260222
msgid "Warn for deallocation calls with arguments returned from mismatched allocation functions."
msgstr "Varna för avallokeringsanrop med argument returnerade från allokeringsfunktioner som inte passar ihop."

#. from tp:gcc-16.1-b20260222
msgid "Warn for mismatches between calls to operator new or delete and the corresponding call to the allocation or deallocation function."
msgstr "Varna för bristande överensstämmelse mellan anrop till operatorn new eller delete och motsvarande anrop till allokerings- eller avallokeringsfunktionen."

#. from tp:gcc-16.1-b20260222
msgid "Warn when a class is redeclared or referenced using a mismatched class-key."
msgstr "Varna när en klass är omdeklarerad eller refereras med en klassnyckel som inte stämmer."

#. from tp:gcc-16.1-b20260222
msgid "Warn about declarations of entities that may be missing attributes that related entities have been declared with."
msgstr "Varna för deklarationer av entiteter som kan sakna attribut som relaterade entiteter har deklarerats med."

#. from tp:gcc-16.1-b20260222
msgid "Warn about possibly missing braces around initializers."
msgstr "Varna för eventuellt saknade klamrar runt initierare."

#. from tp:gcc-16.1-b20260222
msgid "Warn about global functions without previous declarations."
msgstr "Varna för globala funktioner utan tidigare deklaration."

#. from tp:gcc-16.1-b20260222
msgid "Warn about missing fields in struct initializers."
msgstr "Varna för saknade fält i postinitierare."

#. from tp:gcc-16.1-b20260222
msgid "Warn about user-specified include directories that do not exist."
msgstr "Varna för användarangivna inkluderingskataloger som inte finns."

#. from tp:gcc-16.1-b20260222
msgid "Warn about function definitions omitting parameter names."
msgstr "Varna för funktionsdefinitioner som utelämnar parameternamn."

#. from tp:gcc-16.1-b20260222
msgid "Warn about function parameters declared without a type specifier in K&R-style functions."
msgstr "Varna för funktionsparametrar som deklarerats utan en typangivelse i K&R-stilfunktioner."

#. from tp:gcc-16.1-b20260222
msgid "Warn about global functions without prototypes."
msgstr "Varna för globala funktioner utan prototyper."

#. from tp:gcc-16.1-b20260222
msgid "Warn about likely missing requires keyword."
msgstr "Varna för sannolikt saknat nyckelord requires."

#. from tp:gcc-16.1-b20260222
msgid "Warn when the template keyword is missing after a member access token in a dependent member access expression if that member is a template."
msgstr "Varna när nyckelordet template saknas efter en medlemsåtkomstsymbol i ett beroende medlemsåtkomstuttryck om medlemmen är en mall."

#. from tp:gcc-16.1-b20260222
msgid "Warn about global variables without previous declarations."
msgstr "Varna för globala variabler utan tidigare deklaration."

#. from tp:gcc-16.1-b20260222
msgid "Warn about use of multi-character character constants."
msgstr "Varna vid användning av flerteckens teckenkonstanter."

#. from tp:gcc-16.1-b20260222
msgid "Warn on direct multiple inheritance."
msgstr "Varna vid direkt multipelt arv."

#. from tp:gcc-16.1-b20260222
msgid "Warn for multiple lists of forward declarations of function parameters."
msgstr "Varna för flera listor av forward-deklarationer av funktionsparametrar."

#. from tp:gcc-16.1-b20260222
msgid "Warn about unsafe macros expanding to multiple statements used as a body of a clause such as if, else, while, switch, or for."
msgstr "Varna för osäkra makron som expanderar till flera satser och används som kropp i en sats som if, else, while, switch eller for."

#. from tp:gcc-16.1-b20260222
msgid "Warn on namespace definition."
msgstr "Varna vid namnrymdsdefinition."

#. from tp:gcc-16.1-b20260222
msgid "Warn about narrowing conversions within { } that are ill-formed in C++11."
msgstr "Varna för avsmalnande konverteringar inom { } som är felformade i C++11."

#. from tp:gcc-16.1-b20260222
msgid "Warn about \"extern\" declarations not at file scope."
msgstr "Varna för ”extern”-deklarationer som inte är på filnivå."

#. from tp:gcc-16.1-b20260222
msgid "Warn when a noexcept expression evaluates to false even though the expression can't actually throw."
msgstr "Varna när ett noexcept-uttryck beräknas till false även om uttrycket inte faktiskt kan kasta."

#. from tp:gcc-16.1-b20260222
msgid "Warn if C++17 noexcept function type will change the mangled name of a symbol."
msgstr "Varna om funktionstypen noexcept i C++17 kommer ändra det manglade namnet på en symbol."

#. from tp:gcc-16.1-b20260222
msgid "Warn for non-C compatible unnamed classes with a typedef name for linkage purposes."
msgstr "Varna för icke-C-kompatibla namnlösa klasser med ett typedef-namn för länkningsändamål."

#. from tp:gcc-16.1-b20260222
msgid "Warn when non-templatized friend functions are declared within a template."
msgstr "Varna när en vänfunktion som inte är en mall deklareras inuti en mall."

#. from tp:gcc-16.1-b20260222
msgid "Warn about non-virtual destructors."
msgstr "Varna för ickevirtuella destruerare."

#. from tp:gcc-16.1-b20260222
msgid "Warn about NULL being passed to argument slots marked as requiring non-NULL."
msgstr "Varna om NULL skickas till argumentplatser som är markerade som krävande icke-NULL."

#. from tp:gcc-16.1-b20260222
msgid "-Wnormalized=[none|id|nfc|nfkc]	Warn about non-normalized Unicode strings."
msgstr "-Wnormalized=[none|id|nfc|nfkc]\tVarna för icke-normaliserade Unicode-strängar."

#. from tp:gcc-16.1-b20260222
msgid "Warn if a class interface has no superclass.  Root classes may use an attribute to suppress this warning."
msgstr "Varna om ett klassgränssnitt inte har någon superklass. Rotklasser kan använda ett attribut för att undertrycka denna varning."

#. from tp:gcc-16.1-b20260222
msgid "Warn if a C-style cast is used in a program."
msgstr "Varna om en typkonvertering i C-stil används i ett program."

#. from tp:gcc-16.1-b20260222
msgid "Warn for obsolescent usage in a declaration."
msgstr "Varna för föråldrad användning i en deklaration."

#. from tp:gcc-16.1-b20260222
msgid "Warn if an old-style parameter definition is used."
msgstr "Varna om en gammaldags parameterdefinition används."

#. from tp:gcc-16.1-b20260222
msgid "Warn about potentially suboptimal choices related to OpenACC parallelism."
msgstr "Varna för potentiellt suboptimala val relaterade till OpenACC-parallellism."

#. from tp:gcc-16.1-b20260222
msgid "Warn about suspicious OpenMP code."
msgstr "Varna för misstänkt OpenMP-kod."

#. from tp:gcc-16.1-b20260222
msgid "Warn if a simd directive is overridden by the vectorizer cost model."
msgstr "Varna om ett simd-direktiv åsidosätts av vektoriserarens kostnadsmodell."

#. from tp:gcc-16.1-b20260222
msgid "Warn if a string is longer than the maximum portable length specified by the standard."
msgstr "Varna om en sträng är längre än den maximala portabla längden som anges i standarden."

#. from tp:gcc-16.1-b20260222
msgid "Warn about overloaded virtual function names."
msgstr "Varna för överlagrade virtuella funktionsnamn."

#. from tp:gcc-16.1-b20260222
msgid "Warn about overriding initializers without side effects."
msgstr "Varna för åsidosättande initierare utan sidoeffekter."

#. from tp:gcc-16.1-b20260222
msgid "Warn about overriding initializers with side effects."
msgstr "Varna för åsidosättande initierare med sidoeffekter."

#. from tp:gcc-16.1-b20260222
msgid "Warn if the named return value optimization is not performed although it is allowed."
msgstr "Varna om optimeringen av ett namngivet returvärde inte utförs trots att det är tillåtet."

#. from tp:gcc-16.1-b20260222
msgid "Warn about packed bit-fields whose offset changed in GCC 4.4."
msgstr "Varna för packade bitfält vars förskjutning ändrades i GCC 4.4."

#. from tp:gcc-16.1-b20260222
msgid "Warn when fields in a struct with the packed attribute are misaligned."
msgstr "Varna när fält i en post med attributet packed är feljusterade."

#. from tp:gcc-16.1-b20260222
msgid "Warn about possibly missing parentheses."
msgstr "Varna för eventuellt saknade parenteser."

#. from tp:gcc-16.1-b20260222
msgid "Warn about calling std::move on a local object in a return statement preventing copy elision."
msgstr "Varna för att anrop av std::move på ett lokalt objekt i en retursats förhindrar att kopiering undviks."

#. from tp:gcc-16.1-b20260222
msgid "Warn for placement new expressions with undefined behavior."
msgstr "Varna för placerande new-uttryck med odefinierat beteende."

#. from tp:gcc-16.1-b20260222
msgid "Warn when converting the type of pointers to member functions."
msgstr "Varna vid typkonvertering av pekare till medlemsfunktioner."

#. from tp:gcc-16.1-b20260222
msgid "Warn about function pointer arithmetic."
msgstr "Varna för aritmetik med funktionspekare."

#. from tp:gcc-16.1-b20260222
msgid "Warn when a pointer differs in signedness in an assignment."
msgstr "Varna när en pekare skiljer i teckenhet i en tilldelning."

#. from tp:gcc-16.1-b20260222
msgid "Warn when a pointer is compared with a zero character constant."
msgstr "Varna när en pekare jämförs med en noll-teckenkonstant."

#. from tp:gcc-16.1-b20260222
msgid "Warn when a pointer is cast to an integer of a different size."
msgstr "Varna när en pekare typkonverteras till ett heltal av annan storlek."

#. from tp:gcc-16.1-b20260222
msgid "Warn about misuses of pragmas."
msgstr "Varna för missbruk av pragman."

#. from tp:gcc-16.1-b20260222
msgid "Warn about #pragma once outside of a header."
msgstr "Varna för #pragma utanför ett huvud."

#. from tp:gcc-16.1-b20260222
msgid "Warn if constructor or destructors with priorities from 0 to 100 are used."
msgstr "Varna om konstruerare eller destruerare med prioriteter från 0 till 100 används."

#. from tp:gcc-16.1-b20260222
msgid "Warn if a property for an Objective-C object has no assign semantics specified."
msgstr "Varna om en egenskap för ett Objective-C-objekt inte har någon tilldelningssemantik angiven."

#. from tp:gcc-16.1-b20260222
msgid "Warn if inherited methods are unimplemented."
msgstr "Varna om ärvda metoder är oimplementerade."

#. from tp:gcc-16.1-b20260222
msgid "Warn when a range-based for-loop is creating unnecessary copies."
msgstr "Varna när intervallbaserade for-slingor skapar onödiga kopior."

#. from tp:gcc-16.1-b20260222
msgid "Warn about multiple declarations of the same object."
msgstr "Varna för multipla deklarationer av samma objekt."

#. from tp:gcc-16.1-b20260222
msgid "Warn about redundant calls to std::move."
msgstr "Varna för överflödiga anrop av std::move."

#. from tp:gcc-16.1-b20260222
msgid "Warn when a class or enumerated type is referenced using a redundant class-key."
msgstr "Varna när en klass eller uppräkningstyp refereras med en överflödig klassnyckel."

#. from tp:gcc-16.1-b20260222
msgid "Warn about uses of register storage specifier."
msgstr "Varna för användning av lagringsspecificeraren ”register”."

#. from tp:gcc-16.1-b20260222
msgid "Warn when the compiler reorders code."
msgstr "Varna när kompilatorn ändrar ordning på kod."

#. from tp:gcc-16.1-b20260222
msgid "Warn when an argument passed to a restrict-qualified parameter aliases with another argument."
msgstr "Varna när ett argument som skickas till en restrict-kvalificerad parameter aliaserar med ett annat argument."

#. from tp:gcc-16.1-b20260222
msgid "Warn whenever void-returning functions return a non-void expressions, or a return expression is missing in a function not returning void."
msgstr "Varna närhelst void-returnerande funktioner returnerar ett yttryck som inte äv void, eller ett returuttryck saknas i en funktion som inte returnerar void."

#. from tp:gcc-16.1-b20260222
msgid "Warn whenever a function's return type defaults to \"int\" (C), or about inconsistent return types (C++)."
msgstr "Varna när en funktions returtyp får standardvärdet ”int” (C), eller för inkonsistenta returtyper (C++)."

#. from tp:gcc-16.1-b20260222
msgid "Warn on suspicious constructs involving reverse scalar storage order."
msgstr "Varna vid misstänkta konstruktioner med omvänd ordning av skalärlagring inblandad."

#. from tp:gcc-16.1-b20260222
msgid "Warn if a selector has multiple methods."
msgstr "Varna om en väljare har multipla metoder."

#. from tp:gcc-16.1-b20260222
msgid "Warn when a value is moved to itself with std::move."
msgstr "Varna när ett värde flyttas till sig själv med std::move."

#. from tp:gcc-16.1-b20260222
msgid "Warn about possible violations of sequence point rules."
msgstr "Varna för möjliga brott mot sekvenspunktregler."

#. from tp:gcc-16.1-b20260222
msgid "Warn about an incomplete type affecting semantics in a non-error context."
msgstr "Varna för en ofullständig typ som påverkar semantiken i ett icke-felsammanhang."

#. from tp:gcc-16.1-b20260222
msgid "Warn if a local declaration hides an instance variable."
msgstr "Varna om en lokal deklaration döljer en instansvariabel."

#. from tp:gcc-16.1-b20260222
msgid "Warn if left shift of a signed value overflows."
msgstr "Varna om vänsterskift av ett värde med tecken spiller över."

#. from tp:gcc-16.1-b20260222
msgid "Warn if shift count is negative."
msgstr "Varna om skiftantalet är negativt."

#. from tp:gcc-16.1-b20260222
msgid "Warn if shift count >= width of type."
msgstr "Varna om skiftantalet ≥ bredden på typen."

#. from tp:gcc-16.1-b20260222
msgid "Warn if left shifting a negative value."
msgstr "Varna vid vänsterskift med ett negativt värde."

#. from tp:gcc-16.1-b20260222
msgid "Warn about signed-unsigned comparisons."
msgstr "Varna för jämförelser mellan signed/unsigned."

#. from tp:gcc-16.1-b20260222
msgid "Warn for implicit type conversions between signed and unsigned integers."
msgstr "Varna för implicita typkonverteringar mellan heltalsuttryck med och utan tecken."

#. from tp:gcc-16.1-b20260222
msgid "Warn when overload promotes from unsigned to signed."
msgstr "Varna när överlagring anpassar från teckenlöst till med tecken."

#. from tp:gcc-16.1-b20260222
msgid "Warn about missing sized deallocation functions."
msgstr "Varna för saknade storleksbestämda deallokeringsfunktioner."

#. from tp:gcc-16.1-b20260222
msgid "Warn about divisions of two sizeof operators when the first one is applied to an array and the divisor does not equal the size of the array element."
msgstr "Varna för divisioner av två sizeof-operatorer när den första är tillämpad på en vektor och nämnaren inte är lika med storleken på vektorelementet."

#. from tp:gcc-16.1-b20260222
msgid "Warn when sizeof is applied on a parameter declared as an array."
msgstr "Varna när sizeof används på en parameter som är deklarerad som en vektor."

#. from tp:gcc-16.1-b20260222
msgid "Warn about suspicious divisions of two sizeof expressions that don't work correctly with pointers."
msgstr "Varna för misstänkta divisioner av två sizeof-uttryck som inte fungerar korrekt med pekare."

#. from tp:gcc-16.1-b20260222
msgid "Warn about suspicious length parameters to certain string functions if the argument uses sizeof."
msgstr "Varna för misstänkta längdparametrar till vissa strängfunktioner om argumentet använder sizeof."

#. from tp:gcc-16.1-b20260222
msgid "Warn about improper usages of flexible array members according to the level of -fstrict-flex-arrays."
msgstr "Varna för felaktig användning av flexibla vektorelement enligt nivån på -fstrict-flex-arrays."

#. from tp:gcc-16.1-b20260222
msgid "Warn about uncasted NULL used as sentinel."
msgstr "Varna för otypkonverterad NULL som används som vaktpost."

#. from tp:gcc-16.1-b20260222
msgid "Warn about unprototyped function declarations."
msgstr "Varna för funktionsdeklarationer utan prototyp."

#. from tp:gcc-16.1-b20260222
msgid "Warn if type signatures of candidate methods do not match exactly."
msgstr "Varna om typsignaturerna för kandidatmetoder inte stämmer exakt."

#. from tp:gcc-16.1-b20260222
msgid "Warn about calls to strcmp and strncmp used in equality expressions that are necessarily true or false due to the length of one and size of the other argument."
msgstr "Varna för anrop till strcmp och strncmp som används i likhetsuttryck som nödvändigtvis är sanna eller falska på grund av längden på det ena och storleken på det andra argumentet."

#. from tp:gcc-16.1-b20260222
msgid "Warn about buffer overflow in string manipulation functions like memcpy and strcpy."
msgstr "Varna för buffertöverspill i stränghanteringsfunktioner som memcpy och strcpy."

#. from tp:gcc-16.1-b20260222
msgid "Under the control of Object Size type, warn about buffer overflow in string manipulation functions like memcpy and strcpy."
msgstr "Under kontroll av typen Object Size, varna för buffertöverspill i stränghanteringsfunktioner som memcpy och strcpy."

#. from tp:gcc-16.1-b20260222
msgid "Warn about reading past the end of a source array in string manipulation functions like memchr and memcpy."
msgstr "Varna för att läsa bortom slutet på en källvektor i stränghanteringsfunktioner som memchr och memcpy."

#. from tp:gcc-16.1-b20260222
msgid "Warn about truncation in string manipulation functions like strncat and strncpy."
msgstr "Varna för avhuggning i stränghanteringsfunktioner som strncat och strncpy."

#. from tp:gcc-16.1-b20260222
msgid "Warn if a class type has a base or a field whose type uses the anonymous namespace or depends on a type with no linkage."
msgstr "Varna om en klasstyp har en bas eller ett fält vars typ använder den anonyma namnrymden eller beror på en typ utan länkning."

#. from tp:gcc-16.1-b20260222
msgid "Warn about functions which might be candidates for format attributes."
msgstr "Varna för funktioner som kan vara kandidater för formatattribut."

#. from tp:gcc-16.1-b20260222
msgid "Suggest that the override keyword be used when the declaration of a virtual function overrides another."
msgstr "Föreslå att använda nyckelordet override när deklarationen av en virtuell funktion åsidosätter en annan."

#. from tp:gcc-16.1-b20260222
msgid "Warn about enumerated switches, with no default, missing a case."
msgstr "Varna för switch-satser över uppräkningstyper, utan standardfall, som saknar ett case."

#. from tp:gcc-16.1-b20260222
msgid "Warn about enumerated switches missing a \"default:\" statement."
msgstr "Varna för switch-satser över uppräkningstyper som saknar en ”default:”-sats."

#. from tp:gcc-16.1-b20260222
msgid "Warn about all enumerated switches missing a specific case."
msgstr "Varna för switch-satser över uppräkningstyper som saknar ett specifikt case."

#. from tp:gcc-16.1-b20260222
msgid "Warn about switches with boolean controlling expression."
msgstr "Varna för switch-satser med booleskt styruttryck."

#. from tp:gcc-16.1-b20260222
msgid "Warn about switch values that are outside of the switch's type range."
msgstr "Varna för switch-värden som är utanför switch:ens typintervall."

#. from tp:gcc-16.1-b20260222
msgid "Warn when __sync_fetch_and_nand and __sync_nand_and_fetch built-in functions are used."
msgstr "Varna när de inbyggda funktionerna __sync_fetch_and_nand och __sync_nand_and_fetch används."

#. from tp:gcc-16.1-b20260222
msgid "Warn on primary template declaration."
msgstr "Varna vid primär malldeklaration."

#. from tp:gcc-16.1-b20260222
msgid "Diagnose errors when parsing a template."
msgstr "Diagnostisera fel vid tolkning av en mall."

#. from tp:gcc-16.1-b20260222
msgid "Warn about simple-template-id in a constructor or destructor."
msgstr "Varna för simple-template-id i en konstruerare eller destruerare."

#. from tp:gcc-16.1-b20260222
msgid "Warn about templates naming TU-local entities in a module."
msgstr "Varna för mallar som namnger TU-lokala enheter i en modul."

#. from tp:gcc-16.1-b20260222
msgid "Warn if a throw expression will always result in a call to terminate()."
msgstr "Varna om ett throw-uttryck alltid kommer att leda till ett anrop till terminate()."

#. from tp:gcc-16.1-b20260222
msgid "Warn about features not present in traditional C."
msgstr "Varna för funktioner som inte finns i traditionell C."

#. from tp:gcc-16.1-b20260222
msgid "Warn of prototypes causing type conversions different from what would happen in the absence of prototype."
msgstr "Varna för prototyper som orsakar andra typkonverteringar än de som skulle skett i frånvaro av prototyp."

#. from tp:gcc-16.1-b20260222
msgid "Warn about trailing whitespace on lines except when in raw string literals."
msgstr "Varna för avslutande blanktecken på rader utom i råa stränglitteraler."

#. from tp:gcc-16.1-b20260222
msgid "Warn about trailing whitespace on lines except when in raw string literals.   Equivalent to Wtrailing-whitespace=blanks when enabled or Wtrailing-whitespace=none when disabled."
msgstr "Varna för avslutande mellanrum på rader utom i råa stränglitteraler. Ekvivalent med Wtrailing-whitespace=blanks när det är aktiverat eller Wtrailing-whitespace=none när det är avaktiverat."

#. from tp:gcc-16.1-b20260222
msgid "Warn if trigraphs are encountered that might affect the meaning of the program."
msgstr "Varna om trigrafer som kan påverka programmets betydelse påträffas."

#. from tp:gcc-16.1-b20260222
msgid "Warn about @selector()s without previously declared methods."
msgstr "Varna för @selector()er utan tidigare deklarerade metoder."

#. from tp:gcc-16.1-b20260222
msgid "Warn if an undefined macro is used in an #if directive."
msgstr "Varna om ett odefinierat makro används i ett #if-direktiv."

#. from tp:gcc-16.1-b20260222
msgid "Warn about invalid forms of delimited or named escape sequences."
msgstr "Varna för felaktiga former på avgränsade eller namngivna styrsekvenser."

#. from tp:gcc-16.1-b20260222
msgid "Warn about unrecognized pragmas."
msgstr "Varna för okända pragman."

#. from tp:gcc-16.1-b20260222
msgid "Warn about unsuffixed float constants."
msgstr "Varna för flyttalskonstanter utan suffix."

#. from tp:gcc-16.1-b20260222
msgid "Warn about character arrays initialized as unterminated character sequences with a string literal."
msgstr "Varna för teckenvektorer som initieras som oavslutade teckensekvenser med en strängliteral."

#. from tp:gcc-16.1-b20260222
msgid "Warn when typedefs locally defined in a function are not used."
msgstr "Varna när typedef:ar lokalt definierade i en funktion inte används."

#. from tp:gcc-16.1-b20260222
msgid "Warn about macros defined in the main file that are not used."
msgstr "Varna för makron definierade i huvudfilen som inte används."

#. from tp:gcc-16.1-b20260222
msgid "Warn about useless casts."
msgstr "Varna för överflödiga typkonverteringar."

#. from tp:gcc-16.1-b20260222
msgid "Warn about using variadic macros."
msgstr "Varna för användning av variadiska makron."

#. from tp:gcc-16.1-b20260222
msgid "Warn about questionable usage of the macros used to retrieve variable arguments."
msgstr "Varna för tveksam användning av de makron som används för att hämta variabla argument."

#. from tp:gcc-16.1-b20260222
msgid "Warn about the most vexing parse syntactic ambiguity."
msgstr "Varna för den mest irriterande syntaktiska tvetydigheten vid parsning."

#. from tp:gcc-16.1-b20260222
msgid "Warn if a virtual base has a non-trivial move assignment operator."
msgstr "Varna om en virtuell bas har en icke-trivial flyttilldelningsoperator."

#. from tp:gcc-16.1-b20260222
msgid "Warn if a variable length array is used."
msgstr "Varna om en vektor med variabel längd används."

#. from tp:gcc-16.1-b20260222
msgid "-Wvla-larger-than=<number>	Warn on unbounded uses of variable-length arrays, and on bounded uses of variable-length arrays whose bound can be larger than <number> bytes."
msgstr "-Wvla-larger-than=<antal>	Varna för obegränsade användningar av vektorer med variabel längd, och för begränsade användningar av vektorer med variabel längd vars gräns kan vara större än <antal> byte."

#. from tp:gcc-16.1-b20260222
msgid "Disable Wvla-larger-than= warning.  Equivalent to Wvla-larger-than=<SIZE_MAX> or larger."
msgstr "Avaktivera varningen Wvla-larger-than=.  Ekvivalent med Wvla-larger-than=<SIZE_MAX> eller större."

#. from tp:gcc-16.1-b20260222
msgid "Warn about mismatched declarations of VLA parameters."
msgstr "Varna för deklarationer av VLA-parametrar som inte stämmer överens."

#. from tp:gcc-16.1-b20260222
msgid "Warn about deprecated uses of volatile qualifier."
msgstr "Varna för användningar av volatile-kvalificeraren som bör undvikas."

#. from tp:gcc-16.1-b20260222
msgid "Warn when a register variable is declared volatile."
msgstr "Varna när en registervariabel är deklarerad volatile."

#. from tp:gcc-16.1-b20260222
msgid "Warn on direct virtual inheritance."
msgstr "Varna vid direkt virtuellt arv."

#. from tp:gcc-16.1-b20260222
msgid "In C++, nonzero means warn about deprecated conversion from string literals to 'char *'.  In C, similar warning, except that the conversion is of course not deprecated by the ISO C standard."
msgstr "I C++ betyder ett värde skilt från noll att varna för föråldrad konvertering från stränglitteraler till ”char *”.  I C ges en liknande varning, men konverteringen är naturligtvis inte föråldrad enligt ISO C-standarden."

#. from tp:gcc-16.1-b20260222
msgid "Warn about xor operators where it appears the user meant exponentiation."
msgstr "Varna för xor-operatorer där det verkar som att användaren avsåg exponentiering."

#. from tp:gcc-16.1-b20260222
msgid "Warn when a literal '0' is used as null pointer."
msgstr "Varna när en ordagrann '0' används som en nollpekare."

#. from tp:gcc-16.1-b20260222
msgid "Warn about accesses to interior zero-length array members."
msgstr "Varna för åtkomst till interna vektormedlemmar med längden noll."

#. from tp:gcc-16.1-b20260222
msgid "A synonym for -std=c89 (for C) or -std=c++98 (for C++)."
msgstr "En synonym för -std=c89 (för C) eller -std=c++98 (för C++)."

#. from tp:gcc-16.1-b20260222
msgid "The version of the C++ ABI used for -Wabi warnings and link compatibility aliases."
msgstr "Versionen på det C++-ABI som används för -Wabi-varningar och länkkompatibilitetsalias."

#. from tp:gcc-16.1-b20260222
msgid "Enforce class member access control semantics."
msgstr "Upprätthåll åtkomstsemantik för klassmedlemmar."

#. from tp:gcc-16.1-b20260222
msgid "-fada-spec-parent=unit	Dump Ada specs as child units of given parent."
msgstr "-fada-spec-parent=unit	Skriv ut Ada-specifikationer som barnenheter till den givna föräldern."

#. from tp:gcc-16.1-b20260222
msgid "Support C++17 allocation of over-aligned types."
msgstr "Stöd C++17-allokering av överjusterade typer."

#. from tp:gcc-16.1-b20260222
msgid "-faligned-new=<N>	Use C++17 over-aligned type allocation for alignments greater than N."
msgstr "-faligned-new=<N>	Använd C++17 allokering av överjusterade typer för justeringar som är större än N."

#. from tp:gcc-16.1-b20260222
msgid "No longer supported."
msgstr "Stödjs inte längre."

#. from tp:gcc-16.1-b20260222
msgid "Recognize the \"asm\" keyword."
msgstr "Acceptera nyckelordet ”asm”."

#. from tp:gcc-16.1-b20260222
msgid "Assume C++ replaceable global operators new, new[], delete, delete[] don't read or write visible global state."
msgstr "Anta att C++ ersättningsbara globala operatorer new, new[], delete, delete[] inte läser eller skriver ett synligt globalt tillstånd."

#. from tp:gcc-16.1-b20260222
msgid "Recognize built-in functions."
msgstr "Acceptera inbyggda funktioner."

#. from tp:gcc-16.1-b20260222
msgid "Where shorter, use canonicalized paths to systems headers."
msgstr "När de är kortare, använd kanoniska sökvägar till systemhuvuden."

#. from tp:gcc-16.1-b20260222
msgid "Enable the char8_t fundamental type and use it as the type for UTF-8 string and character literals."
msgstr "Aktivera den fundamentala typen char8_t och använd den som typen för UTF-8-sträng- och -teckenlitteraler."

#. from tp:gcc-16.1-b20260222
msgid "Removed in GCC 8.  This switch has no effect."
msgstr "Borttagen i GCC 8.  Denna flagga har ingen effekt."

#. from tp:gcc-16.1-b20260222
msgid "Enable support for C++ concepts."
msgstr "Aktivera stöd för C++-koncept."

#. from tp:gcc-16.1-b20260222
msgid "Removed in GCC 15.  This switch has no effect."
msgstr "Borttagen i GCC 15. Denna flagga har ingen effekt."

#. from tp:gcc-16.1-b20260222
msgid "Specify maximum error replay depth during recursive diagnosis of a constraint satisfaction failure."
msgstr "Ange maximalt felåterspelningsdjup vid rekursiv diagnostik av ett fel i begränsningsuppfyllelse."

#. from tp:gcc-16.1-b20260222
msgid "Allow the arguments of the '?' operator to have different types."
msgstr "Tillåt argument till ”?”-operatorn att ha olika typer."

#. from tp:gcc-16.1-b20260222
msgid "-fconst-string-class=<name>	Use class <name> for constant strings."
msgstr "-fconst-string-class=<namn>	Använd klassen <namn> för konstanta strängar."

#. from tp:gcc-16.1-b20260222
msgid "-fconstexpr-depth=<number>	Specify maximum constexpr recursion depth."
msgstr "-fconstexpr-depth=<antal>	Ange maximalt rekursionsdjup för constexpr."

#. from tp:gcc-16.1-b20260222
msgid "-fconstexpr-cache-depth=<number>	Specify maximum constexpr recursion cache depth."
msgstr "-fconstexpr-cache-depth=<antal>	Ange maximalt cacherekursionsdjup för constexpr."

#. from tp:gcc-16.1-b20260222
msgid "Allow IEC559 floating point exceptions in constant expressions."
msgstr "Tillåt IEC559 flyttalsundantag i konstanta uttryck."

#. from tp:gcc-16.1-b20260222
msgid "-fconstexpr-loop-limit=<number>	Specify maximum constexpr loop iteration count."
msgstr "-fconstexpr-loop-limit=<antal>	Ange maximalt antal constexpr-slingiterationer."

#. from tp:gcc-16.1-b20260222
msgid "-fconstexpr-ops-limit=<number>	Specify maximum number of constexpr operations during a single constexpr evaluation."
msgstr "-fconstexpr-ops-limit=<antal>	Ange maximalt antal constexpr-operationer under en enda constexpr-beräkning."

#. from tp:gcc-16.1-b20260222
msgid "Enable features proposed for C++26 Contracts."
msgstr "Aktivera funktioner föreslagna för C++26-kontrakt."

#. from tp:gcc-16.1-b20260222
msgid "-fcontract-evaluation-semantic=[ignore|observe|enforce|quick_enforce]	Select the contract evaluation semantic (defaults to enforce)."
msgstr "-fcontract-evaluation-semantic=[ignore|observe|enforce|quick_enforce]	Välj semantik för kontraktsutvärdering (standard är enforce)."

#. from tp:gcc-16.1-b20260222
msgid "-fcontracts-conservative-ipa	Do not allow certain optimisations between functions in contract assertions."
msgstr "-fcontracts-conservative-ipa	Tillåt inte vissa optimeringar mellan funktioner i kontraktsförsäkranden."

#. from tp:gcc-16.1-b20260222
msgid "-fcontract-checks-outlined	Build contract checks using outlined functions."
msgstr "-fcontract-checks-outlined\tBygg kontraktskontroller med hjälp av utbrutna funktioner."

#. from tp:gcc-16.1-b20260222
msgid "-fcontract-disable-optimized-checks	Disable optimisation of contract checks."
msgstr "-fcontract-disable-optimized-checks\tAvaktivera optimering av kontraktskontroller."

#. from tp:gcc-16.1-b20260222
msgid "-fcontracts-client-check=[none|pre|all] Select which contracts will be checked on the client side for non virtual functions."
msgstr "-fcontracts-client-check=[none|pre|all] Välj vilka kontrakt som skall kontrolleras på klientsidan för icke-virtuella funktioner."

#. from tp:gcc-16.1-b20260222
msgid "-fcontracts-definition-check=[on|off]	Enable or disable contract checks on the definition side for all functions (default on)."
msgstr "-fcontracts-definition-check=[on|off]	Aktivera eller avaktivera kontraktskontroller av definitionssidad för alla funktioner (standard på)."

#. from tp:gcc-16.1-b20260222
msgid "Enable C++ coroutines (experimental)."
msgstr "Aktivera C++-korutiner (experimentellt)."

#. from tp:gcc-16.1-b20260222
msgid "Emit debug annotations during preprocessing."
msgstr "Mata ut felsökningsannoteringar under preprocessning."

#. from tp:gcc-16.1-b20260222
msgid "Factor complex constructors and destructors to favor space over speed."
msgstr "Faktorisera komplexa konstruerare och destruerare till förmån för utrymme snarare än hastighet."

#. from tp:gcc-16.1-b20260222
msgid "Print hierarchical comparisons when template types are mismatched."
msgstr "Skriv ut hierarkiska jämförelser när malltyper inte stämmer överens."

#. from tp:gcc-16.1-b20260222
msgid "Note all candidates during overload resolution failure."
msgstr "Notera alla kandidater under misslyckad upplösning av överlagring."

#. from tp:gcc-16.1-b20260222
msgid "Preprocess directives only."
msgstr "Preprocessa endast direktiv."

#. from tp:gcc-16.1-b20260222
msgid "Permit '$' as an identifier character."
msgstr "Tillåt ”$” som ett identifierartecken."

#. from tp:gcc-16.1-b20260222
msgid "-fmacro-prefix-map=<old>=<new>	Map one directory name to another in __FILE__, __BASE_FILE__, and __builtin_FILE()."
msgstr "-fmacro-prefix-map=<gammal>=<ny>\tAvbilda ett katalognamn till ett annat i __FILE__, __BASE_FILE__ och __builtin_FILE()."

#. from tp:gcc-16.1-b20260222
msgid "Write all declarations as Ada code transitively."
msgstr "Skriv alla deklarationer transitivt som Ada-kod."

#. from tp:gcc-16.1-b20260222
msgid "Write all declarations as Ada code for the given file only."
msgstr "Skriv alla deklarationer som Adakod endast för den angivna filen."

#. from tp:gcc-16.1-b20260222
msgid "Do not elide common elements in template comparisons."
msgstr "Utelämna inte gemensamma element i malljämförelser."

#. from tp:gcc-16.1-b20260222
msgid "Generate code to check exception specifications."
msgstr "Generera kod för att kontrollera undantagsspecifikationer."

#. from tp:gcc-16.1-b20260222
msgid "-fexec-charset=<cset>	Convert all strings and character constants to character set <cset>."
msgstr "-fexec-charset=<tknst>	Konvertera alla strängar och teckenkonstanter till teckenuppsättningen <tknst>."

#. from tp:gcc-16.1-b20260222
msgid "Permit universal character names (\\u and \\U) in identifiers."
msgstr "Tillåt universella teckennamn (\\u och \\U) i identifierare."

#. from tp:gcc-16.1-b20260222
msgid "-finput-charset=<cset>	Specify the default character set for source files."
msgstr "-finput-charset=<tknst>	Ange standardteckenuppsättning för källkodsfiler."

#. from tp:gcc-16.1-b20260222
msgid "Support dynamic initialization of thread-local variables in a different translation unit."
msgstr "Stöd dynamisk initiering av trådlokala variabler i en annan översättningsenhet."

#. from tp:gcc-16.1-b20260222
msgid "Fold calls to simple inline functions."
msgstr "Fäll ihop anrop till enkla inline-funktioner."

#. from tp:gcc-16.1-b20260222
msgid "Do not assume that standard C libraries and \"main\" exist."
msgstr "Anta inte att standard C-bibliotek och ”main” finns."

#. from tp:gcc-16.1-b20260222
msgid "Recognize GNU-defined keywords."
msgstr "Acceptera GNU-definierade nyckelord."

#. from tp:gcc-16.1-b20260222
msgid "Generate code for GNU runtime environment."
msgstr "Generera kod för GNU:s körtidsmiljö."

#. from tp:gcc-16.1-b20260222
msgid "Use traditional GNU semantics for inline functions."
msgstr "Använd traditionell GNU-semantik för inline-funktioner."

#. from tp:gcc-16.1-b20260222
msgid "Assume normal C execution environment."
msgstr "Anta normal C-körmiljö."

#. from tp:gcc-16.1-b20260222
msgid "Implement P2564 for consteval propagation."
msgstr "Implementera P2564 för consteval-propagering."

#. from tp:gcc-16.1-b20260222
msgid "Export functions even if they can be inlined."
msgstr "Exportera funktioner även om de kan inline:as."

#. from tp:gcc-16.1-b20260222
msgid "Make inline functions constexpr by default."
msgstr "Gör inline-funktioner constexpr som standard."

#. from tp:gcc-16.1-b20260222
msgid "Emit implicit instantiations of inline templates."
msgstr "Skapa implicita instansieringar av inline:ade mallar."

#. from tp:gcc-16.1-b20260222
msgid "Emit implicit instantiations of templates."
msgstr "Skapa implicita instansieringar av mallar."

#. from tp:gcc-16.1-b20260222
msgid "Implement C++17 inheriting constructor semantics."
msgstr "Implementera C++17-semantik för ärvda konstruerare."

#. from tp:gcc-16.1-b20260222
msgid "Don't emit dllexported inline functions unless needed."
msgstr "Mata inte ut dll-exporterade inline-funktioner om det inte behövs."

#. from tp:gcc-16.1-b20260222
msgid "Allow implicit conversions between vectors with differing numbers of subparts and/or differing element types."
msgstr "Tillåt implicit konvertering mellan vektorer med olika antal underdelar och/eller olika elementtyper."

#. from tp:gcc-16.1-b20260222
msgid "Enable C++20 Modules (experimental)."
msgstr "Aktivera C++20-moduler (experimentellt)."

#. from tp:gcc-16.1-b20260222
msgid "Enable C++ header module (experimental)."
msgstr "Aktivera C++-huvudenhetsmoduler (experimentellt)."

#. from tp:gcc-16.1-b20260222
msgid "Member functions defined within their class are inline in module purview."
msgstr "Medlemsfunktioner definierade inom sin klass är inline i modulräckvidd."

#. from tp:gcc-16.1-b20260222
msgid "Only emit Compiled Module Interface."
msgstr "Mata endast ut ett kompilerat modulgränssnitt."

#. from tp:gcc-16.1-b20260222
msgid "Mapper for module to CMI files."
msgstr "Modulmappare för CMI-filer."

#. from tp:gcc-16.1-b20260222
msgid "Enable lazy module importing."
msgstr "Aktivera lat modulimport."

#. from tp:gcc-16.1-b20260222
msgid "Warn about macros that have conflicting header units definitions."
msgstr "Varna för makron som har motstridiga huvudenhetsdefinitioner."

#. from tp:gcc-16.1-b20260222
msgid "Warn if pointers of distinct types are compared without a cast."
msgstr "Varna om pekare av distinkta typer jämförs utan en typkonvertering."

#. from tp:gcc-16.1-b20260222
msgid "Note #include directives translated to import declarations."
msgstr "Notera #include-direktiv översatta till importdeklarationer."

#. from tp:gcc-16.1-b20260222
msgid "Note #include directives not translated to import declarations, and not known to be textual."
msgstr "Notera #include-direktiv som inte översätts till importdeklarationer och inte är kända som textuella."

#. from tp:gcc-16.1-b20260222
msgid "Note a #include translation of a specific header."
msgstr "Notera en #include-översättning av ett specifikt huvud."

#. from tp:gcc-16.1-b20260222
msgid "Note Compiled Module Interface pathnames."
msgstr "Notera kompilerade modulgränssnittssökvägar."

#. from tp:gcc-16.1-b20260222
msgid "Note Compiled Module Interface pathname of a specific module or header-unit."
msgstr "Notera kompilerade modulgränssnittssökvägar för en specifik modul eller huvudenhet."

#. from tp:gcc-16.1-b20260222
msgid "fmax-include-depth=<number> Set the maximum depth of the nested #include."
msgstr "fmax-include-depth=<antal> Ange maximalt djup på nästade #include."

#. from tp:gcc-16.1-b20260222
msgid "Don't warn about uses of Microsoft extensions."
msgstr "Varna inte för användning av Microsoft-utökningar."

#. from tp:gcc-16.1-b20260222
msgid "Implement resolution of DR 150 for matching of template template arguments."
msgstr "Implementera upplösning av DR 150 för att matcha mall-mall-argument."

#. from tp:gcc-16.1-b20260222
msgid "Generate code for NeXT (Apple macOS) runtime environment."
msgstr "Generera kod för körtidsmiljön NeXT (Apple macOS)."

#. from tp:gcc-16.1-b20260222
msgid "Assume that receivers of Objective-C messages may be nil."
msgstr "Anta att mottagare av Objective-C-meddelanden kan vara nil."

#. from tp:gcc-16.1-b20260222
msgid "Allow access to instance variables as if they were local declarations within instance method implementations."
msgstr "Tillåt åtkomst till instansvariabler som om de vore lokala deklarationer i instansmetodimplementationer."

#. from tp:gcc-16.1-b20260222
msgid "-fvisibility=[private|protected|public|package]	Set the default symbol visibility."
msgstr "-fvisibility=[private|protected|public|package]	Ange standardvärde för symbolsynlighet."

#. from tp:gcc-16.1-b20260222
msgid "Treat a throw() exception specification as noexcept to improve code size."
msgstr "Behandla en undantagsspecifikation throw() som noexcept för att förbättra kodstorleken."

#. from tp:gcc-16.1-b20260222
msgid "Specify which ABI to use for Objective-C family code and meta-data generation."
msgstr "Ange vilket ABI som skall användas för kodfamiljen Objective-C och generering av metadata."

#. from tp:gcc-16.1-b20260222
msgid "Generate special Objective-C methods to initialize/destroy non-POD C++ ivars, if needed."
msgstr "Generera speciella Objective-C-metoder för att initiera/destruera icke-POD-C++-ivariabler, om det behövs."

#. from tp:gcc-16.1-b20260222
msgid "Allow fast jumps to the message dispatcher."
msgstr "Tillåt snabba hopp till meddelandehanteraren."

#. from tp:gcc-16.1-b20260222
msgid "Enable Objective-C exception and synchronization syntax."
msgstr "Aktivera Objective-C-undantags- och synkroniseringssyntax."

#. from tp:gcc-16.1-b20260222
msgid "Enable garbage collection (GC) in Objective-C/Objective-C++ programs."
msgstr "Aktivera skräpsamling (GC) i Objective-C-/Objective-C++-program."

#. from tp:gcc-16.1-b20260222
msgid "Enable inline checks for nil receivers with the NeXT runtime and ABI version 2."
msgstr "Aktivera inline-kontroller av nil-mottagare med NeXT-körtidskod och ABI-version 2."

#. from tp:gcc-16.1-b20260222
msgid "Enable Objective-C setjmp exception handling runtime."
msgstr "Aktivera Objective-C:s setjmp-undantagshantering i körtidsmiljön."

#. from tp:gcc-16.1-b20260222
msgid "Conform to the Objective-C 1.0 language as implemented in GCC 4.0."
msgstr "Följ språket Objective-C 1.0 så som det implementerades i GCC 4.0."

#. from tp:gcc-16.1-b20260222
msgid "Enable OpenACC."
msgstr "Aktivera OpenACC."

#. from tp:gcc-16.1-b20260222
msgid "Specify default OpenACC compute dimensions."
msgstr "Ange standard-OpenACC-beräkningsdimensioner."

#. from tp:gcc-16.1-b20260222
msgid "Enable OpenMP (implies -frecursive in Fortran)."
msgstr "Aktivera OpenMP (implicerar -frecursive i Fortran)."

#. from tp:gcc-16.1-b20260222
msgid "Enable OpenMP's SIMD directives."
msgstr "Aktivera OpenMP:s SIMD-direktiv."

#. from tp:gcc-16.1-b20260222
msgid "Recognize C++ keywords like \"compl\" and \"xor\"."
msgstr "Acceptera C++-nyckelord som ”compl” och ”xor”."

#. from tp:gcc-16.1-b20260222
msgid "Look for and use PCH files even when preprocessing."
msgstr "Sök efter och använd PCH-filer även vid preprocessning."

#. from tp:gcc-16.1-b20260222
msgid "Downgrade conformance errors to warnings."
msgstr "Nedgradera följsamhetsfel till varningar."

#. from tp:gcc-16.1-b20260222
msgid "Enable Plan 9 language extensions."
msgstr "Aktivera språkutvidgningar från Plan 9."

#. from tp:gcc-16.1-b20260222
msgid "Treat the input file as already preprocessed."
msgstr "Betrakta indatafilen som redan preprocessad."

#. from tp:gcc-16.1-b20260222
msgid "-ftrack-macro-expansion=<0|1|2>	Track locations of tokens coming from macro expansion and display them in error messages."
msgstr "-ftrack-macro-expansion=<0|1|2>	Spåra platser för symboler som kommer från makroexpansion och visa dem i felmeddelanden."

#. from tp:gcc-16.1-b20260222
msgid "Do not pretty-print template specializations as the template signature followed by the arguments."
msgstr "Finskriv inte mallspecialiseringar som mallsignaturer följda av argumenten."

#. from tp:gcc-16.1-b20260222
msgid "Treat known sprintf return values as constants."
msgstr "Hantera kända sprintf-returvärden som konstanter."

#. from tp:gcc-16.1-b20260222
msgid "Enable lifetime extension of range based for temporaries."
msgstr "Aktivera livstidsutökning av intervallbaserade for-temporärer."

#. from tp:gcc-16.1-b20260222
msgid "Enable experimental C++26 Reflection."
msgstr "Aktivera experimentell C++26-reflektion."

#. from tp:gcc-16.1-b20260222
msgid "Used in Fix-and-Continue mode to indicate that object files may be swapped in at runtime."
msgstr "Används i Fix-and-Continue-läge för att ange att objektfiler kan bytas ut vid körtid."

#. from tp:gcc-16.1-b20260222
msgid "Removed in GCC 10.  This switch has no effect."
msgstr "Borttagen i GCC 10.  Denna flagga har ingen effekt."

#. from tp:gcc-16.1-b20260222
msgid "Generate run time type descriptor information."
msgstr "Generera typbeskrivarinformation för körtid."

#. from tp:gcc-16.1-b20260222
msgid "Look for the main source file on the include path."
msgstr "Sök efter huvudkällfilen i inkluderingssökvägen."

#. from tp:gcc-16.1-b20260222
msgid "Force the underlying type for \"wchar_t\" to be \"unsigned short\"."
msgstr "Tvinga den underliggande typen för ”wchar_t” att vara ”unsigned short”."

#. from tp:gcc-16.1-b20260222
msgid "When \"signed\" or \"unsigned\" is not given make the bitfield signed."
msgstr "När ”signed” eller ”unsigned” inte anges låt bitfältet ha tecken."

#. from tp:gcc-16.1-b20260222
msgid "Enable C++14 sized deallocation support."
msgstr "Slå på stöd för C++14 storleksbestämd deallokering."

#. from tp:gcc-16.1-b20260222
msgid "-fstrict-flex-arrays=<level>    Control when to treat the trailing array of a structure as a flexible array member for the purposes of accessing the elements of such an array. The default is treating all trailing arrays of structures as flexible array members."
msgstr "-fstrict-flex-arrays=<nivå>     Styr när den avslutande vektorn i en post skall behandlas som en flexibel vektormedlem vid åtkomst av elementen i en sådan vektor. Standard är att betrakta alla avslutende vektorer i poster som flexibla vektormedlemmar."

#. from tp:gcc-16.1-b20260222
msgid "-fsso-struct=[big-endian|little-endian|native]	Set the default scalar storage order."
msgstr "-fsso-struct=[big-endian|little-endian|native]	Sätt standardordning för skalärlagring."

#. from tp:gcc-16.1-b20260222
msgid "Display statistics accumulated during compilation."
msgstr "Visa statistik som samlats under kompilering."

#. from tp:gcc-16.1-b20260222
msgid "Assume that values of enumeration type are always within the minimum range of that type."
msgstr "Anta att värden av uppräkningstyp alltid ligger inom typens minsta intervall."

#. from tp:gcc-16.1-b20260222
msgid "Follow the C++17 evaluation order requirements for assignment expressions, shift, member function calls, etc."
msgstr "Följ C++17-kraven på evalueringsordning för tilldelningsuttryck, skift, medlemsfunktionsanrop osv."

#. from tp:gcc-16.1-b20260222
msgid "Set the maximum number of template instantiation notes for a single warning or error."
msgstr "Sätt det maximala antalet mallinstansieringsnoter för en enskild varning eller fel."

#. from tp:gcc-16.1-b20260222
msgid "-ftemplate-depth=<number>	Specify maximum template instantiation depth."
msgstr "-ftemplate-depth=<antal>	Ange maximalt instansieringsdjup för mallar."

#. from tp:gcc-16.1-b20260222
msgid "-fno-threadsafe-statics	Do not generate thread-safe code for initializing local statics."
msgstr "-fno-threadsafe-statics\tGenerera inte trådsäker kod för initiering av lokala statiska variabler."

#. from tp:gcc-16.1-b20260222
msgid "When \"signed\" or \"unsigned\" is not given make the bitfield unsigned."
msgstr "När ”signed” eller ”unsigned” inte anges görs bitfälten teckenlösa."

#. from tp:gcc-16.1-b20260222
msgid "Use __cxa_atexit to register destructors."
msgstr "Använd __cxa_atexit för att registrera destruerare."

#. from tp:gcc-16.1-b20260222
msgid "Use __cxa_get_exception_ptr in exception handling."
msgstr "Använd __cxa_get_exception_ptr i undantagshantering."

#. from tp:gcc-16.1-b20260222
msgid "Marks all inlined functions and methods as having hidden visibility."
msgstr "Markerar alla inline-funktioner och metoder som att de har dold synlighet."

#. from tp:gcc-16.1-b20260222
msgid "Changes visibility to match Microsoft Visual Studio by default."
msgstr "Ändrar synlighet till att vara som Microsoft Visual Studio som standard."

#. from tp:gcc-16.1-b20260222
msgid "Emit common-like symbols as weak symbols."
msgstr "Mata ut common-liknande symboler som svaga symboler."

#. from tp:gcc-16.1-b20260222
msgid "-fwide-exec-charset=<cset>	Convert all wide strings and character constants to character set <cset>."
msgstr "-fwide-exec-charset=<tknst>	Konvertera alla breda strängar och teckenkonstanter till teckenuppsättningen <tknst>."

#. from tp:gcc-16.1-b20260222
msgid "Generate a #line directive pointing at the current working directory."
msgstr "Generera ett #line-direktiv som pekar på aktuell katalog."

#. from tp:gcc-16.1-b20260222
msgid "Generate lazy class lookup (via objc_getClass()) for use in Zero-Link mode."
msgstr "Generera lata klassuppslagningar (via objc_getClass()) att användas i läget Zero-Link."

#. from tp:gcc-16.1-b20260222
msgid "Dump declarations to a .decl file."
msgstr "Dumpa deklarationer till en .decl-fil."

#. from tp:gcc-16.1-b20260222
msgid "-femit-struct-debug-baseonly	Aggressive reduced debug info for structs."
msgstr "-femit-struct-debug-baseonly	Aggressivt reducerad felsökningsinformation för poster."

#. from tp:gcc-16.1-b20260222
msgid "-femit-struct-debug-reduced	Conservative reduced debug info for structs."
msgstr "-femit-struct-debug-reduced	Konservativt reducerad felsökningsinformation för poster."

#. from tp:gcc-16.1-b20260222
msgid "-femit-struct-debug-detailed=<spec-list>	Detailed reduced debug info for structs."
msgstr "-femit-struct-debug-detailed=<spec-lista>	Detaljreducerad felsökningsinformation för poster."

#. from tp:gcc-16.1-b20260222
msgid "Interpret imaginary, fixed-point, or other gnu number suffix as the corresponding number literal rather than a user-defined number literal."
msgstr "Tolka imaginära, fastpunkts- eller andra GNU-tal-suffix som motsvarande tallitteral i stället för en användardefinierad tallitteral."

#. from tp:gcc-16.1-b20260222
msgid "-idirafter <dir>	Add <dir> to the end of the system include path."
msgstr "-idirafter <kat>	Lägg till <kat> till slutet av sökvägen för systeminkluderingar."

#. from tp:gcc-16.1-b20260222
msgid "-imacros <file>	Accept definition of macros in <file>."
msgstr "-imacros <fil>\tAcceptera definitioner av makron i <fil>."

#. from tp:gcc-16.1-b20260222
msgid "-imultilib <dir>	Set <dir> to be the multilib include subdirectory."
msgstr "-imultilib <kat>\tAnge <kat> som multilibs inkluderingsunderkatalog."

#. from tp:gcc-16.1-b20260222
msgid "-include <file>	Include the contents of <file> before other files."
msgstr "-include <fil>	Inkludera innehållet i <fil> före andra filer."

#. from tp:gcc-16.1-b20260222
msgid "-iprefix <path>	Specify <path> as a prefix for next two options."
msgstr "-iprefix <skvg>	Ange <skvg> som ett prefix för de följande två flaggorna."

#. from tp:gcc-16.1-b20260222
msgid "-isysroot <dir>	Set <dir> to be the system root directory."
msgstr "-isysroot <kat>	Sätt <kat> som rotkatalog för systemet."

#. from tp:gcc-16.1-b20260222
msgid "-isystem <dir>	Add <dir> to the start of the system include path."
msgstr "-isystem <kat>	Lägg till <kat> till början av sökvägen för systeminkluderingar."

#. from tp:gcc-16.1-b20260222
msgid "-iquote <dir>	Add <dir> to the end of the quote include path."
msgstr "-iquote <kat>	Lägg till <kat> till slutet av sökvägen för citerade inkluderingar."

#. from tp:gcc-16.1-b20260222
msgid "-iwithprefix <dir>	Add <dir> to the end of the system include path."
msgstr "-iwithprefix <kat>	Lägg till <kat> till slutet av sökvägen för systeminkluderingar."

#. from tp:gcc-16.1-b20260222
msgid "-iwithprefixbefore <dir>	Add <dir> to the end of the main include path."
msgstr "-iwithprefixbefore <kat>	Lägg till <kat> till slutet av huvudsökvägen."

#. from tp:gcc-16.1-b20260222
msgid "Do not search standard system include directories (those specified with -isystem will still be used)."
msgstr "Sök inte standardkataloger för inkluderingar (de som anges med -isystem kommer fortfarande att användas)."

#. from tp:gcc-16.1-b20260222
msgid "Do not search standard system include directories for C++."
msgstr "Sök inte i standardkataloger för systeminkluderingar för C++."

#. from tp:gcc-16.1-b20260222
msgid "Generate C header of platform-specific features."
msgstr "Generera C-huvuden för plattformsspecifika funktioner."

#. from tp:gcc-16.1-b20260222
msgid "Remap file names when including files."
msgstr "Avbilda filnamn när filer inkluderas."

#. from tp:gcc-16.1-b20260222
msgid "Conform to the ISO 1998 C++ standard revised by the 2003 technical corrigendum."
msgstr "Följ standarden ISO 1998 C++ reviderad av 2003 års tekniska rättelser."

