msgid "Identify Line Number"
msgstr "Identifiera linjenummer"

#. from tp:denemo-2.6-rc2
msgid "Identify the line number in which the note is displayed"
msgstr "Identifiera radnumret där noten visas"

#. from tp:denemo-2.6-rc2
msgid "Line and Space Recognition"
msgstr "Identifiering av linjer och mellanrum"

#. from tp:denemo-2.6-rc2
msgid "%tests your ability to recognize the difference between line and space"
msgstr "%testar din förmåga att känna igen skillnaden mellan linje och mellanrum"

#. from tp:denemo-2.6-rc2
msgid "Note Name Speed Recognition"
msgstr "Snabbigenkänning av tonnamn"

#. from tp:denemo-2.6-rc2
msgid "%tests your ability to name the notes of the scale"
msgstr "%testar din förmåga att namnge skalans toner"

#. from tp:denemo-2.6-rc2
msgid "Solfege Note Name Recognition"
msgstr "Solmisation: igenkänning av tonnamn"

#. from tp:denemo-2.6-rc2
msgid "Note Name Recognition"
msgstr "Igenkänning av tonnamn"

#. from tp:denemo-2.6-rc2
msgid "Identify Space Number"
msgstr "Identifiera mellannummer"

#. from tp:denemo-2.6-rc2
msgid "Identify the space number in which the note is display on"
msgstr "Identifiera numret på mellanrummet där noten visas"

#. from tp:denemo-2.6-rc2
msgid "Step, Skip, or Same?"
msgstr "Steg, hoppa över eller samma?"

