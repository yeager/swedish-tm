msgid "\nWarning: With multiple addresses in \"From\", a \"Sender\"-header is\n         required, but its generation is deactivated by the global\n         configuration \"disable_sender=ON\" in\n         \"%s\".\n"
msgstr "\nVarning för detta: Med flera adresser i \"Från\" krävs en \"Avsändare\"-rubrik, men\n         krävs, men genereringen av den inaktiveras genom den globala\n         globala konfigurationen \"disable_sender=ON\" i\n         \"%s\".\n"

