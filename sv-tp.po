msgid "The alist for Staff.keySignature is no longer in reversed order.\n"
msgstr "Alistan för Staff.keySignature är inte längre i omvänd ordning.\n"

#. from tp:lilypond-2.23.80
msgid "\\bar \".\" now produces a thick barline\nly:hairpin::after-line-breaking -> ly:spanner::kill-zero-spanned-time\nDash parameters for slurs and ties are now in dash-definition"
msgstr "\\bar ”.” producerar nu ett tjockt taktstreck\nly:hairpin::after-line-breaking -> ly:spanner::kill-zero-spanned-time\nStreck-parametrar för legatobåge aoch bindebågar finns nu i dash-definition"

