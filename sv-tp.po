msgstr "DATA_PREPARER_ID - ISO9660-identifierare för data"

#. from tp:util-linux-man-2.41.2-rc1
msgid "PUBLISHER_ID - ISO9660 publisher identifier"
msgstr "PUBLISHER_ID - ISO9660-identifierare för utgivare"

#. from tp:util-linux-man-2.41.2-rc1
msgid "APPLICATION_ID - ISO9660 application identifier"
msgstr "APPLICATION_ID - ISO9660-applikationens identifierare"

#. from tp:util-linux-man-2.41.2-rc1
msgid "BOOT_SYSTEM_ID - ISO9660 boot system identifier"
msgstr "BOOT_SYSTEM_ID - ISO9660-identifierare för startsystem"

#. from tp:util-linux-man-2.41.2-rc1
msgid "*libblkid* was written by Andreas Dilger for the ext2 filesystem utilities, with input from Ted Ts'o. The library was subsequently heavily modified by Ted Ts'o."
msgstr "*libblkid* skrevs av Andreas Dilger för filsystemverktygen ext2, med hjälp av Ted Ts'o. Biblioteket har därefter kraftigt modifierats av Ted Ts'o."

#. from tp:util-linux-man-2.41.2-rc1
msgid "The low-level probing code was rewritten by Karel Zak."
msgstr "Den lågskaliga probingkoden skrevs om av Karel Zak."

