#. from tp:sarg-2.4.0
msgid "Usage: %s [options...]\n"
msgstr "Användning: %s [flaggor...]\n"

#. from tp:sarg-2.4.0
msgid "     -a NAME|IP     Create report for host name or IP address"
msgstr "     -a NAMN|IP     Skapa rapport för värdnamn eller IP-adress"

#. from tp:sarg-2.4.0
msgid "     -c FILE        Exclude connected hosts from the report"
msgstr "     -c FIL         Uteslut anslutna värdar från rapporten"

#. from tp:sarg-2.4.0
msgid "     --convert      Convert the access.log file to a legible date"
msgstr "     --convert      Konvertera filen access.log till ett läsbart datum"

#. from tp:sarg-2.4.0
msgid "     --css          Output the internal CSS"
msgstr "     --css          Utmatning av intern CSS"

#. from tp:sarg-2.4.0
msgid "     -d DATE        Date range to include in the report: from-until dd/mm/yyyy-dd/mm/yyyy"
msgstr "     -d DATE        Datumintervall som ska ingå i rapporten: från-till dd/mm/åååå-dd/mm/åååå"

#. from tp:sarg-2.4.0
msgid "     -e MAIL        Email address to send reports to (stdout for console)"
msgstr "     -e EPOST       E-postadress att skicka rapporter till (stdout för konsol)"

#. from tp:sarg-2.4.0
msgid "     -f FILE        Config file to read (default is %s/sarg.conf)\n"
msgstr "     -f FIL         Konfig-fil att läsa (standard är %s/sarg.conf)\n"

#. from tp:sarg-2.4.0
msgid "     -g FMT         Date format [e=Europe -> dd/mm/yyyy, u=USA -> mm/dd/yyyy]"
msgstr "     -g FMT         Datumformat [e=Europa -> dd/mm/åååå, u=USA -> mm/dd/ååååå]"

#. from tp:sarg-2.4.0
msgid "     -h             This help"
msgstr "     -h             Denna hjälp"

#. from tp:sarg-2.4.0
msgid "     --help         This help"
msgstr "     --help         Denna hjälp"

#. from tp:sarg-2.4.0
msgid "     -i             Reports by user and IP address"
msgstr "     -i             Rapporter per användare och IP-adress"

#. from tp:sarg-2.4.0
msgid "     --keeplogs     Keep every previously generated report"
msgstr "     --keeplogs     Behåll alla tidigare genererade rapporter"

