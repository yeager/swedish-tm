msgid "  -c, --bytes=[-]NUM\n         print the first NUM bytes of each file;\n         with the leading '-', print all but the last NUM bytes of each file\n"
msgstr "  -c, --bytes=[-]ANT\n         skriv de första ANT byte av varje fil;\n         med det inledande ”-”, skriv allt utom de sista ANT byte av varje fil\n"

