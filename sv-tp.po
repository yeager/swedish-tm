msgid "Menu:\nChanges the duration of the current rest"
msgstr "Meny:\nÄndrar den aktuella pausens tidsvärde"

#. from tp:denemo-2.6-rc2
msgid "Expression Marks"
msgstr "Uttrycksmarkeringar"

#. from tp:denemo-2.6-rc2
msgid "Menu:\nDynamics, staccato, slurs, ties and other expressive marks"
msgstr "Meny:\nDynamik, staccato, legatobågar, bindebågar och andra uttrycksmarkeringar"

#. from tp:denemo-2.6-rc2
msgid "Dynamics"
msgstr "Dynamik"

#. from tp:denemo-2.6-rc2
msgid "Dynamic markings"
msgstr "Dynamikmarkeringar"

#. from tp:denemo-2.6-rc2
msgid "Ornaments"
msgstr "Ornament"

#. from tp:denemo-2.6-rc2
msgid "Menu:\ngrace notes etc"
msgstr "Meny:\nFörslagsnoter med mera"

#. from tp:denemo-2.6-rc2
msgid "Other"
msgstr "Annat"

#. from tp:denemo-2.6-rc2
msgid "Lyrics, chord symbols, figured basses etc"
msgstr "Sångtexter, ackordsymboler, generalbas med mera"

#. from tp:denemo-2.6-rc2
msgid "Others"
msgstr "Andra"

#. from tp:denemo-2.6-rc2
msgid "Less used actions"
msgstr "Mindre använda åtgärder"

#. from tp:denemo-2.6-rc2
msgid "Favorites"
msgstr "Favoriter"

#. from tp:denemo-2.6-rc2
msgid "Customized LilyPond inserts. Store often-used inserts here labelled with what they do"
msgstr "Anpassade LilyPond-infogningar. Spara ofta använda infogningar här med etiketter som beskriver vad de gör"

#. from tp:denemo-2.6-rc2
msgid "Add Favorite"
msgstr "Lägg till favorit"

#. from tp:denemo-2.6-rc2
msgid "Menu:\nAdd a custom LilyPond insert to favorites menu"
msgstr "Meny:\nLägg till en anpassad LilyPond-infogning i favoritmenyn"

#. from tp:denemo-2.6-rc2
msgid "Tuplets"
msgstr "Tupletter"

#. from tp:denemo-2.6-rc2
msgid "Menu:\nEntering triplets and other tuplets"
msgstr "Meny:\nMata in trioler och andra tupletter"

#. from tp:denemo-2.6-rc2
msgid "Menu:\nDeleting notes, measures, staffs, key signatures as well as meta-objects such as imported MIDI or audio recordings."
msgstr "Meny:\nRadering av noter, takter, notsystem, tonartsbeteckningar samt meta-objekt som t.ex. importerade MIDI- eller ljudinspelningar."

#. from tp:denemo-2.6-rc2
msgid "Beaming"
msgstr "Balkning"

#. from tp:denemo-2.6-rc2
msgid "Menu:\nBeaming - controlling which notes are beamed together"
msgstr "Meny:\nBalkning – styr vilka noter som binds samman med balkar"

#. from tp:denemo-2.6-rc2
msgid "Conditional Directives"
msgstr "Villkorliga direktiv"

#. from tp:denemo-2.6-rc2
msgid "Menu:\nFor making directives apply only to one score layout or be omitted from one score layout"
msgstr "Meny:\nLåt direktiv gälla endast för en viss partiturlayout eller utelämna dem från en viss partiturlayout"

#. from tp:denemo-2.6-rc2
msgid "MIDI"
msgstr "MIDI"

#. from tp:denemo-2.6-rc2
msgid "Menu:\nFor issuing MIDI instructions during playback at the time indicated by the current cursor position."
msgstr "Meny:\nFör att skicka MIDI-instruktioner under uppspelning vid den tidpunkt som anges av den aktuella markörpositionen."

#. from tp:denemo-2.6-rc2
msgid "Audio"
msgstr "Ljud"

#. from tp:denemo-2.6-rc2
msgid "Menu:\nFor commands related to audio as opposed to MIDI."
msgstr "Meny:\nFör kommandon som är relaterade till ljud i motsats till MIDI."

#. from tp:denemo-2.6-rc2
msgid "PC Keyboard"
msgstr "PC-tangentbord"

#. from tp:denemo-2.6-rc2
msgid "Menu:\nChoose between different ways of entering notes from the computer keyboard."
msgstr "Meny:\nVälj mellan olika sätt att mata in noter från datorns tangentbord."

#. from tp:denemo-2.6-rc2
msgid "Mouse"
msgstr "Mus"

#. from tp:denemo-2.6-rc2
msgid "Menu:\nChoose between different ways of using the mouse."
msgstr "Meny:\nVälj mellan olika sätt att använda musen."

#. from tp:denemo-2.6-rc2
msgid "Print Transposed"
msgstr "Skriv ut transponerat"

#. from tp:denemo-2.6-rc2
msgid "Menu:\nTransposing the score when typesetting."
msgstr "Meny:\nTransponering av partitur vid sättning."

#. from tp:denemo-2.6-rc2
msgid "Start/Stop Transposing"
msgstr "Börja/avsluta transponering"

#. from tp:denemo-2.6-rc2
msgid "Menu:\nInserting markers to start/stop transposition when typesetting. The markers affect only the music in the staff/voice they are placed in."
msgstr "Meny:\nInfoga markörer för att starta/stoppa transponering vid sättning. Markörerna påverkar endast musiken i det notsystem/den stämma de placeras i."

#. from tp:denemo-2.6-rc2
msgid "Inserting Barlines"
msgstr "Infoga taktstreck"

#. from tp:denemo-2.6-rc2
msgid "Menu:\nDifferent sorts of barline (repeat barlines, double bars, end of movement ...)."
msgstr "Meny:\nOlika typer av taktstreck (upprepade taktstreck, dubbla taktstreck, slut på rörelse ...)."

#. from tp:denemo-2.6-rc2
msgid "Seek"
msgstr "Sök"

#. from tp:denemo-2.6-rc2
msgid "Menu:\nMoving the Denemo cursor forwards/backwards to find useful places in the score."
msgstr "Meny:\nFlytta Denemo-markören framåt/bakåt för att hitta användbara ställen i partituret."

#. from tp:denemo-2.6-rc2
msgid "Titles"
msgstr "Rubriker"

#. from tp:denemo-2.6-rc2
msgid "Menu:\nVarious titling schemes, (main title, movement titles, composer etc) and adding table of contents, critical commentary."
msgstr "Meny:\nOlika titelsystem, (huvudtitel, satstitlar, kompositör etc) och tillägg av innehållsförteckning, kritisk kommentar."

#. from tp:denemo-2.6-rc2
msgid "Print Layout"
msgstr "Layout för utskrift"

#. from tp:denemo-2.6-rc2
msgid "Menu:\nCommands to affect the layout of the typeset score."
msgstr "Meny:\nKommandon för att påverka layouten för det satta partituret."

#. from tp:denemo-2.6-rc2
msgid "Vertical Spacing"
msgstr "Vertikalt mellanrum"

#. from tp:denemo-2.6-rc2
msgid "Menu:\nCommands to affect the vertical spacing of the typeset score."
msgstr "Meny:\nKommandon för att påverka det vertikala avståndet i det satta partituret."

#. from tp:denemo-2.6-rc2
msgid "Capture Score"
msgstr "Avbilda partitur"

#. from tp:denemo-2.6-rc2
msgid "Menu:\nCommands to embed images taken from original manuscripts etc into the score (one for each measure)."
msgstr "Meny:\nKommandon för att bädda in bilder från originalmanuskript etc i partituret (en för varje takt)."

#. from tp:denemo-2.6-rc2
msgid "Ossia"
msgstr "Ossia"

#. from tp:denemo-2.6-rc2
msgid "Menu:\nCreating an Ossia staff, which appears with alternative interpretations for a bar or two on typesetting."
msgstr "Meny:\nSkapa ett ossia-notsystem som vid notsättningen visar alternativa tolkningar för en eller två takter."

#. from tp:denemo-2.6-rc2
msgid "Bar and Page Numbering"
msgstr "Takt- och sidnumrering"

#. from tp:denemo-2.6-rc2
msgid "Menu:\nCommands for setting how often bar numbers appear in the typeset version of this staff."
msgstr "Meny:\nKommandon för att ange hur ofta taktnummer ska visas i den satta versionen av detta notsystem."

#. from tp:denemo-2.6-rc2
msgid "Staff Groupings (Braces)"
msgstr "Personalgrupperingar (Braces)"

#. from tp:denemo-2.6-rc2
msgid "Menu:\nVarious sorts of brace linking the staffs together. These may be nested, see the Score Layout view for a display of the staff groups created."
msgstr "Meny:\nOlika typer av stöd som länkar samman staberna. Dessa kan vara nästlade, se vyn partitur Layout för en visning av de stavgrupper som skapats."

#. from tp:denemo-2.6-rc2
msgid "Add Note Above Base of Chord"
msgstr "Lägg till not ovanför ackordets bas"

#. from tp:denemo-2.6-rc2
msgid "Menu:\nAdding notes to the chord at the cursor at various intervals above base note."
msgstr "Meny:\nLägg till noter i ackordet vid markören med olika intervall ovanför den lägsta noten."

#. from tp:denemo-2.6-rc2
msgid "Add Note Below Top of Chord"
msgstr "Lägg till not under ackordets topp"

#. from tp:denemo-2.6-rc2
msgid "Menu:\nAdding notes to the chord at the cursor at various intervals below the top-most note."
msgstr "Meny:\nLägga till noter i ackordet vid markören med olika intervall under den översta noten."

#. from tp:denemo-2.6-rc2
msgid "Change Duration of Note"
msgstr "Ändra notens tidsvärde"

#. from tp:denemo-2.6-rc2
msgid "Menu:\nCommands to include other durations in a chord (instead of polyphony - this is specialized stuff!) The note at the cursor height is altered."
msgstr "Meny:\nKommandon för att lägga in andra tidsvärden i ett ackord (i stället för polyfoni – detta är en specialfunktion!). Noten på markörens höjd ändras."

#. from tp:denemo-2.6-rc2
msgid "Fingerings"
msgstr "Fingersättningar"

#. from tp:denemo-2.6-rc2
msgid "Menu:\nFingerings (numbers) to typeset near to notes."
msgstr "Meny:\nFingersättningar (siffror) som placeras nära noterna vid notsättningen."

#. from tp:denemo-2.6-rc2
msgid "Transpose Music"
msgstr "Transponera musik"

#. from tp:denemo-2.6-rc2
msgid "Menu:\nAlters the note/chord at the cursor or the selection transposing it by the interval chosen. This alters the music in the score - see other transpose options for transposing the printed output, leaving the music untouched."
msgstr "Meny:\nÄndrar noten/ackordet vid markören eller markeringen genom att transponera den med det valda intervallet. Detta ändrar musiken i partituret - se andra transponeringsalternativ för transponering av utskriften, där musiken lämnas orörd."

#. from tp:denemo-2.6-rc2
msgid "Make a Directive Conditional"
msgstr "Gör ett direktiv villkorligt"

#. from tp:denemo-2.6-rc2
msgid "Menu:\nMark the directive at the cursor as applying to just the current score layout, or to exclude the current layout. Use this for example to exclude redundant first and second time markings in parts which don't need them."
msgstr "Meny:\nMarkera om direktivet vid markören ska gälla bara för den aktuella partiturlayouten eller om den aktuella layouten ska uteslutas. Använd detta t.ex. för att utesluta överflödiga markeringar för första och andra gången i stämmor som inte behöver dem."

#. from tp:denemo-2.6-rc2
msgid "Single Random Note"
msgstr "Enstaka slumpmässig not"

#. from tp:denemo-2.6-rc2
msgid "Menu:\nTo insert random notes at cursor."
msgstr "Meny:\nInfoga slumpmässiga noter vid markören."

#. from tp:denemo-2.6-rc2
msgid "Generate Rhythm from String"
msgstr "Generera rytm från sträng"

#. from tp:denemo-2.6-rc2
msgid "Menu:\nCreating rhythms from a sequence of characters."
msgstr "Meny:\nSkapa rytmer från en sekvens av tecken."

#. from tp:denemo-2.6-rc2
msgid "Notation Magick"
msgstr "Notation Magick"

#. from tp:denemo-2.6-rc2
msgid "Menu:\nMethods of generating music of guided randomness."
msgstr "Meny:\nMetoder för att generera musik av styrd slumpmässighet."

#. from tp:denemo-2.6-rc2
msgid "Display Zoom"
msgstr "Visningszoom"

#. from tp:denemo-2.6-rc2
msgid "Menu:\nZooming the Denemo display. Usually Control and mouse wheel are used for this."
msgstr "Meny:\nZooma Denemo-skärmen. Vanligtvis används Control och mushjulet för detta."

#. from tp:denemo-2.6-rc2
msgid "Aural Training"
msgstr "Gehörsträning"

#. from tp:denemo-2.6-rc2
msgid "Menu:\nGames for testing your musical ear."
msgstr "Meny:\nSpel för att testa ditt musiköra."

#. from tp:denemo-2.6-rc2
msgid "Note Reading"
msgstr "Notläsning"

#. from tp:denemo-2.6-rc2
msgid "Menu:\nGames for testing your music reading ability. Notice there is (elsewhere) the Checking Pitches feature which lets you test your ability to play via Midi Controller."
msgstr "Meny:\nSpel för att testa din notläsningsförmåga. Observera att det också finns en funktion för att kontrollera tonhöjder som låter dig testa din spelförmåga med en MIDI-kontrollenhet."

#. from tp:denemo-2.6-rc2
msgid "Simple Titling"
msgstr "Enkel rubriksättning"

#. from tp:denemo-2.6-rc2
msgid "Menu:\nCommands to place titles etc at the start of the music (and each movement if needed). Do not mix with Book Titles."
msgstr "Meny:\nKommandon för att placera titlar etc i början av musiken (och varje rörelse om det behövs). Blanda inte med Book Titles."

#. from tp:denemo-2.6-rc2
msgid "Book Titling"
msgstr "Bokrubriker"

#. from tp:denemo-2.6-rc2
msgid "Menu:\nCommands to create a title page, table of contents, commentaries, appendices etc."
msgstr "Meny:\nKommandon för att skapa en titelsida, innehållsförteckning, kommentarer, bilagor etc."

#. from tp:denemo-2.6-rc2
msgid "Palettes"
msgstr "Paletter"

#. from tp:denemo-2.6-rc2
msgid "Menu:\nCommands to manipulate the palettes of commands."
msgstr "Meny:\nKommandon för att hantera kommandopaletterna."

#. from tp:denemo-2.6-rc2
msgid "Spanning"
msgstr "Över en passage"

#. from tp:denemo-2.6-rc2
msgid "Menu:\nCommands to tell the typesetter to start or stop a particular effect. Use these around passages that are to be treated differently, or over which a marking should be placed."
msgstr "Meny:\nKommandon som talar om för sättaren att starta eller stoppa en viss effekt. Använd dessa vid passager som ska behandlas annorlunda eller över vilka en markering ska göras."

#. from tp:denemo-2.6-rc2
msgid "Alternative Bars"
msgstr "Alternativa takter"

#. from tp:denemo-2.6-rc2
msgid "Menu:\nCommands for creating first/second/nth time bars."
msgstr "Meny:\nKommandon för att skapa alternativa takter för första, andra eller n:te gången."

#. from tp:denemo-2.6-rc2
msgid "Typesetter"
msgstr "Sättare"

#. from tp:denemo-2.6-rc2
msgid "Menu:\nInstructions for the typesetter to do something at the cursor position."
msgstr "Meny:\nInstruktioner till sättaren om att göra något vid markörens position."

#. from tp:denemo-2.6-rc2
msgid "Part-Combining"
msgstr "Stämkombination"

#. from tp:denemo-2.6-rc2
msgid "Menu:\nInstructions for the typesetter to combine two voices in various ways."
msgstr "Meny:\nInstruktioner för sättaren att kombinera två röster på olika sätt."

#. from tp:denemo-2.6-rc2
msgid "Object Menu"
msgstr "Objektmeny"

#. from tp:denemo-2.6-rc2
msgid "Menu:\nCommands for working with the musical object hierarchy."
msgstr "Meny:\nKommandon för att arbeta med den musikaliska objekthierarkin."

#. from tp:denemo-2.6-rc2
msgid "Main Menu"
msgstr "Huvudmeny"

#. from tp:denemo-2.6-rc2
msgid "Menu:\nThe top level commands for operating Denemo."
msgstr "Meny:\nKommandon på högsta nivån för att använda Denemo."

#. from tp:denemo-2.6-rc2
msgid "Could not parse command line: %s"
msgstr "Det gick inte att tolka kommandoraden: %s"

#. from tp:denemo-2.6-rc2
msgid "Graphics File"
msgstr "Grafikfil"

#. from tp:denemo-2.6-rc2
msgid "This score was last successfully typeset with LilyPond version "
msgstr "Detta partitur sattes senast framgångsrikt med LilyPond-versionen "

#. from tp:denemo-2.6-rc2
msgid "\nYou have your Denemo Preferences -> Externals -> lilypond set to "
msgstr "\nI Denemo-inställningarna -> Externa -> lilypond har du valt "

