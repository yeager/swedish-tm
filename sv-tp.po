msgid "Directory: "
msgstr "Katalog: "

#. from tp:coreutils-9.10-pre1
msgid "Shell: "
msgstr "Skal: "

#. from tp:coreutils-9.10-pre1
msgid "Project: "
msgstr "Projekt: "

#. from tp:coreutils-9.10-pre1
msgid "Plan:\n"
msgstr "Plan:\n"

#. from tp:coreutils-9.10-pre1
msgid "Login"
msgstr "Login"

#. from tp:coreutils-9.10-pre1
msgid " TTY"
msgstr " TTY"

#. from tp:coreutils-9.10-pre1
msgid "Idle"
msgstr "Overksam"

#. from tp:coreutils-9.10-pre1
msgid "When"
msgstr "När"

#. from tp:coreutils-9.10-pre1
msgid "  -l     produce long format output for the specified USERs\n"
msgstr "  -l     skriv ut i långt format för angivna ANVÄNDARE\n"

#. from tp:coreutils-9.10-pre1
msgid "  -b     omit the user's home directory and shell in long format\n"
msgstr "  -b     utelämna användarens hemkatalog och skal i det långa formatet\n"

#. from tp:coreutils-9.10-pre1
msgid "  -h     omit the user's project file in long format\n"
msgstr "  -h     utelämna användarens projektfil i det långa formatet\n"

#. from tp:coreutils-9.10-pre1
msgid "  -p     omit the user's plan file in long format\n"
msgstr "  -p     utelämna användarens planfil i det långa formatet\n"

#. from tp:coreutils-9.10-pre1
msgid "  -s     do short format output, this is the default\n"
msgstr "  -s     skriv ut i kort format, detta är standard\n"

#. from tp:coreutils-9.10-pre1
msgid "  -f     omit the line of column headings in short format\n"
msgstr "  -f     utelämna raden med kolumnrubriker i kort format\n"

#. from tp:coreutils-9.10-pre1
msgid "  -w     omit the user's full name in short format\n"
msgstr "  -w     utelämna användarens fullständiga namn i kort format\n"

#. from tp:coreutils-9.10-pre1
msgid "  -i     omit the user's full name and remote host in short format\n"
msgstr "  -i     utelämna användarens fullständiga namn och fjärrvärd i kort format\n"

#. from tp:coreutils-9.10-pre1
msgid "  -q     omit the user's full name, remote host and idle time in short format\n"
msgstr "  -q     utelämna användarens fullständiga namn, fjärrvärd och inaktivitetstid i kort format\n"

#. from tp:coreutils-9.10-pre1
msgid "      --lookup\n         attempt to canonicalize hostnames via DNS\n"
msgstr "      --lookup\n         försök omvandla värdnamn till kanonisk form med hjälp av DNS\n"

#. from tp:coreutils-9.10-pre1
msgid "\nA lightweight 'finger' program;  print user information.\nThe utmp file will be %s.\n"
msgstr "\nEtt lättviktigt ”finger”-program; skriver ut användarinformation.\nutmp-filen kommer att vara %s.\n"

#. from tp:coreutils-9.10-pre1
msgid "no username specified; at least one must be specified when using -l"
msgstr "inget användarnamn angivet; åtminstone ett måste anges när -l används"

#. from tp:coreutils-9.10-pre1
msgid "Pete TerMaat"
msgstr "Pete TerMaat"

#. from tp:coreutils-9.10-pre1
msgid "Roland Huebner"
msgstr "Roland Huebner"

#. from tp:coreutils-9.10-pre1
msgid "integer overflow"
msgstr "heltalsspill"

#. from tp:coreutils-9.10-pre1
msgid "'--pages=FIRST_PAGE[:LAST_PAGE]' missing argument"
msgstr "”--pages=FÖRSTA_SIDA[:SISTA_SIDA]” saknar argument"

#. from tp:coreutils-9.10-pre1
msgid "invalid page range %s"
msgstr "ogiltigt sidintervall %s"

#. from tp:coreutils-9.10-pre1
msgid "'-l PAGE_LENGTH' invalid number of lines"
msgstr "”-l SIDLÄNGD” felaktigt antal rader"

#. from tp:coreutils-9.10-pre1
msgid "'-N NUMBER' invalid starting line number"
msgstr "”-N NUMMER” felaktigt första radnummer"

#. from tp:coreutils-9.10-pre1
msgid "'-o MARGIN' invalid line offset"
msgstr "”-o MARGINAL” felaktigt indrag av rad"

#. from tp:coreutils-9.10-pre1
msgid "'-w PAGE_WIDTH' invalid number of characters"
msgstr "”-w SIDBREDD” felaktigt antal tecken"

#. from tp:coreutils-9.10-pre1
msgid "'-W PAGE_WIDTH' invalid number of characters"
msgstr "”-W SIDBREDD” felaktigt antal tecken"

#. from tp:coreutils-9.10-pre1
msgid "cannot specify number of columns when printing in parallel"
msgstr "det går inte att ange antal kolumner vid parallell utskrift"

#. from tp:coreutils-9.10-pre1
msgid "cannot specify both printing across and printing in parallel"
msgstr "det går inte att ange både utskrift på tvären och parallell utskrift"

#. from tp:coreutils-9.10-pre1
msgid "'-%c': Invalid argument: %s"
msgstr "”-%c”: Felaktigt argument: %s"

#. from tp:coreutils-9.10-pre1
msgid "'-%c' extra characters or invalid number in the argument: %s"
msgstr "”-%c” extra tecken eller felaktigt tal i argumentet: %s"

#. from tp:coreutils-9.10-pre1
msgid "page width too narrow"
msgstr "bredden på sidan är för smal"

#. from tp:coreutils-9.10-pre1
msgid "starting page number %ju exceeds page count %ju"
msgstr "första sidnumret %ju överskrider antalet sidor %ju"

#. from tp:coreutils-9.10-pre1
msgid "page number overflow"
msgstr "spill i sidnummer"

#. from tp:coreutils-9.10-pre1
msgid "Page %ju"
msgstr "Sida %ju"

#. from tp:coreutils-9.10-pre1
msgid "Paginate or columnate FILE(s) for printing.\n"
msgstr "Paginera eller skapa kolumner av FIL(er) för utskrift.\n"

#. from tp:coreutils-9.10-pre1
msgid "\n  +FIRST_PAGE[:LAST_PAGE], --pages=FIRST_PAGE[:LAST_PAGE]\n         begin [stop] printing with page FIRST_[LAST_]PAGE\n"
msgstr "\n+FÖRSTA_SIDA[:SISTA_SIDA], --pages=FÖRSTA_SIDA[:SISTA_SIDA]\n         börja [sluta] skriva vid sida FÖRSTA_[SISTA_]SIDA\n"

#. from tp:coreutils-9.10-pre1
msgid "  -COLS, --columns=COLS\n         output COLS columns and print columns down, unless -a is used.\n         Balance number of lines in the columns on each page\n"
msgstr "  -KOL, --columns=KOL\n         skapa KOL kolumner och skriv kolumner nedåt, om inte -a används.\n         Balansera antalet rader i kolumnerna på varje sida\n"

#. from tp:coreutils-9.10-pre1
msgid "  -a, --across\n         print columns across rather than down, used together with -COLUMN\n"
msgstr "  -a, --across\n         skriv kolumner på tvären i stället för nedåt,\n         används tillsammans med -KOLUMN\n"

#. from tp:coreutils-9.10-pre1
msgid "  -c, --show-control-chars\n         use hat notation (^G) and octal backslash notation\n"
msgstr "  -c, --show-control-chars\n         använd hattnotation (^G) och oktal notation med omvänt snedstreck\n"

#. from tp:coreutils-9.10-pre1
msgid "  -d, --double-space\n         double space the output\n"
msgstr "  -d, --double-space\n         skriv ut med dubbelt radavstånd\n"

#. from tp:coreutils-9.10-pre1
msgid "  -D, --date-format=FORMAT\n         use FORMAT for the header date\n"
msgstr "  -D, --date-format=FORMAT\n         använd FORMAT för datumet i sidhuvudet\n"

#. from tp:coreutils-9.10-pre1
msgid "  -e[CHAR[WIDTH]], --expand-tabs[=CHAR[WIDTH]]\n         expand input CHARs (TABs) to tab WIDTH (8)\n"
msgstr "  -e[TECKEN[BREDD]], --expand-tabs[=TECKEN[BREDD]]\n         expandera inmatade TECKEN (tabulatorer) till tabulatorpositioner med BREDD (8) kolumners mellanrum\n"

#. from tp:coreutils-9.10-pre1
msgid "  -F, -f, --form-feed\n         use form feeds instead of newlines to separate pages\n         (by a 3-line page header with -F or a 5-line header\n         and trailer without -F)\n"
msgstr "  -F, -f, --form-feed\n         använd sidmatning i stället för nya rader för att\n         separera sidor (med ett 3-raders huvud vid -F eller\n         5-raders huvud och fot utan -F)\n"

#. from tp:coreutils-9.10-pre1
msgid "  -h, --header=HEADER\n         use a centered HEADER instead of filename in page header,\n         -h \"\" prints a blank line, don't use -h\"\"\n"
msgstr "  -h, --header=HUVUD\n         använd ett centrerat HUVUD i stället för filnamn i sidhuvud,\n         -h \"\" skriver en tom rad, använd inte -h\"\"\n"

#. from tp:coreutils-9.10-pre1
msgid "  -i[CHAR[WIDTH]], --output-tabs[=CHAR[WIDTH]]\n         replace spaces with CHARs (TABs) to tab WIDTH (8)\n"
msgstr "  -i[TECKEN[BREDD]], --output-tabs[=TECKEN[BREDD]]\n         ersätt mellanslag med TECKEN (tabulatorer) med\n         BREDD (8) kolumners mellanrum mellan tabulatorpositionerna\n"

#. from tp:coreutils-9.10-pre1
msgid "  -J, --join-lines\n         merge full lines, turns off -W line truncation,\n         no column alignment, --sep-string[=STRING] sets separators\n"
msgstr "  -J, --join-lines\n         sammanfoga hela rader, stänger av -W avhuggning av rader,\n         ingen kolumnjustering, --sep-string[=STRÄNG] anger avskiljare\n"

#. from tp:coreutils-9.10-pre1
msgid "  -l, --length=PAGE_LENGTH\n         set the page length to PAGE_LENGTH (66) lines\n         (default number of lines of text 56, and with -F 63).\n         implies -t if PAGE_LENGTH <= 10\n"
msgstr "  -l, --length=SIDLÄNGD\n         sätt sidlängden till SIDLÄNGD (66) rader\n         (standard 56 rader text, och med -F 63).\n         Implicerar -t om SIDLÄNGD ≤ 10\n"

#. from tp:coreutils-9.10-pre1
msgid "  -m, --merge\n         print all files in parallel, one in each column,\n         truncate lines, but join lines of full length with -J\n"
msgstr "  -m, --merge\n         skriv alla filer parallellt, en i varje kolumn,\n         hugg av rader, men slå samman rader med full längd med -J\n"

#. from tp:coreutils-9.10-pre1
msgid "  -n[SEP[DIGITS]], --number-lines[=SEP[DIGITS]]\n         number lines, use DIGITS (5) digits, then SEP (TAB),\n         default counting starts with 1st line of input file\n"
msgstr "  -n[SEP[SIFFROR]], --number-lines[=SEP[SIFFROR]]\n         numrera rader, använd SIFFROR (5) siffror, sedan SEP (TAB),\n         i normalläge startar räkning vid infilens första rad\n"

#. from tp:coreutils-9.10-pre1
msgid "  -N, --first-line-number=NUMBER\n         start counting with NUMBER at 1st line of first\n         page printed (see +FIRST_PAGE)\n"
msgstr "  -N, --first-line-number=NUMMER\n         börja räkna med NUMMER vid första raden på första sidan\n         som skrivs ut (se +FÖRSTA_SIDA)\n"

#. from tp:coreutils-9.10-pre1
msgid "  -o, --indent=MARGIN\n         offset each line with MARGIN (zero) spaces, do not\n         affect -w or -W, MARGIN will be added to PAGE_WIDTH\n"
msgstr "  -o, --indent=MARGINAL\n         skjut in varje rad med MARGINAL (noll) mellanrum, påverka\n         ej -w eller -W, MARGINAL läggs till SIDBREDD\n"

#. from tp:coreutils-9.10-pre1
msgid "  -r, --no-file-warnings\n         omit warning when a file cannot be opened\n"
msgstr "  -r, --no-file-warnings\n         utelämna varning när en fil inte kan öppnas\n"

#. from tp:coreutils-9.10-pre1
msgid "  -s[CHAR], --separator[=CHAR]\n         separate columns by a single character, default for CHAR\n         is the <TAB> character without -w and 'no char' with -w.\n         -s[CHAR] turns off line truncation of all 3 column\n         options (-COLUMN|-a -COLUMN|-m) except -w is set\n"
msgstr "  -s[TECKEN], --separator[=TECKEN]\n         åtskilj kolumner med ett enda tecken, standard för TECKEN\n         är tabulatortecknet utan -w och ”inget tecken” med -w.\n         -s[TECKEN] slår av avhuggning för alla tre kolumnflaggorna\n         (-KOLUMN|-a -KOLUMN|-m) utom när -w är angivet\n"

#. from tp:coreutils-9.10-pre1
msgid "  -S[STRING], --sep-string[=STRING]\n         separate columns by STRING,\n         without -S: Default separator <TAB> with -J and <space>\n         otherwise (same as -S\" \"), no effect on column options\n"
msgstr "  -S[STRÄNG], --sep-string[=STRÄNG]\n         åtskilj kolumner med STRÄNG,\n         utan -S: Standardseparator <TAB> med -J och <blank>\n         annars (samma som -S\" \"), ingen effekt på kolumnflaggor\n"

#. from tp:coreutils-9.10-pre1
msgid "  -t, --omit-header\n         omit page headers and trailers; implied if PAGE_LENGTH <= 10\n"
msgstr "  -t, --omit-header\n         utelämna sidhuvud och sidfot: implicit om SIDLÄNGD ≤ 10\n"

#. from tp:coreutils-9.10-pre1
msgid "  -T, --omit-pagination\n         omit page headers and trailers,\n         eliminate any pagination by form feeds set in input files\n"
msgstr "  -T, --omit-pagination\n         utelämna sidhuvud och sidfot,\n         ta bort paginering gjord med sidmatning i infiler\n"

#. from tp:coreutils-9.10-pre1
msgid "  -v, --show-nonprinting\n         use octal backslash notation\n"
msgstr "  -v, --show-nonprinting\n         använd oktal notation med omvänt snedstreck\n"

#. from tp:coreutils-9.10-pre1
msgid "  -w, --width=PAGE_WIDTH\n         set page width to PAGE_WIDTH (72) characters for\n         multiple text-column output only, -s[char] turns off (72)\n"
msgstr "  -w, --width=SIDBREDD\n         sätt sidbredd till SIDBREDD (72) tecken vid utmatning\n         med flera textkolumner, -s[TECKEN] slår av (72)\n"

#. from tp:coreutils-9.10-pre1
msgid "  -W, --page-width=PAGE_WIDTH\n         set page width to PAGE_WIDTH (72) characters always,\n         truncate lines, except -J option is set,\n         no interference with -S or -s\n"
msgstr "  -W, --page-width=SIDBREDD\n         sätt sidbredd till SIDBREDD (72) tecken vid all utmatning,\n         hugg av rader utom om flaggan -J är satt,\n         ingen koppling till -S eller -s\n"

#. from tp:coreutils-9.10-pre1
msgid "Usage: %s [OPTION] [VARIABLE]...\nPrint the values of the specified environment VARIABLE(s).\nIf no VARIABLE is specified, print name and value pairs for them all.\n\n"
msgstr "Användning: %s [FLAGGA] [VARIABEL]…\nSkriv värdena på de angivna miljöVARIABLERNA.\nOm ingen VARIABEL angetts, skriv ut namn- och värdepar för samtliga.\n\n"

#. from tp:coreutils-9.10-pre1
msgid "warning: %s: character(s) following character constant have been ignored"
msgstr "varning: %s: tecken som följer efter teckenkonstanten har ignorerats"

#. from tp:coreutils-9.10-pre1
msgid "Usage: %s FORMAT [ARGUMENT]...\n  or:  %s OPTION\n"
msgstr "Användning: %s FORMAT [ARGUMENT]...\n   eller:   %s FLAGGA\n"

#. from tp:coreutils-9.10-pre1
msgid "Print ARGUMENT(s) according to FORMAT, or execute according to OPTION:\n\n"
msgstr "Skriv ut ARGUMENT enligt FORMAT, eller kör enligt FLAGGA:\n\n"

#. from tp:coreutils-9.10-pre1
msgid "\nFORMAT controls the output as in C printf.  Interpreted sequences are:\n\n  \\\"      double quote\n"
msgstr "\nFORMAT styr utdata som i C printf.  Tolkade sekvenser är:\n\n  \\\"      dubbelt citationstecken\n"

#. from tp:coreutils-9.10-pre1
msgid "  \\NNN    byte with octal value NNN (1 to 3 digits)\n  \\xHH    byte with hexadecimal value HH (1 to 2 digits)\n  \\uHHHH  Unicode (ISO/IEC 10646) character with hex value HHHH (4 digits)\n  \\UHHHHHHHH  Unicode character with hex value HHHHHHHH (8 digits)\n"
msgstr "  \\NNN    byte med oktalt värde NNN (1 till 3 siffror)\n  \\xHH    byte med hexadecimalt värde HH (1 till 2 siffror)\n  \\uHHHH  Unicodetecken (ISO/IEC 10646) med hexadecimalt värde HHHH (4 siffror)\n  \\UHHHHHHHH  Unicodetecken med hexadecimalt värde HHHHHHHH (8 siffror)\n"

#. from tp:coreutils-9.10-pre1
msgid "  %%      a single %\n  %b      ARGUMENT as a string with '\\' escapes interpreted,\n          except that octal escapes should have a leading 0 like \\0NNN\n  %q      ARGUMENT is printed in a format that can be reused as shell input,\n          escaping non-printable characters with the POSIX $'' syntax\n\nand all C format specifications ending with one of diouxXfeEgGcs, with\nARGUMENTs converted to proper type first.  Variable widths are handled.\n"
msgstr "  %%      ett enkelt %\n  %b      ARGUMENT som en sträng med ”\\”-kontrollsekvenser tolkade,\n          utom att oktala sekvenser skall ha en inledande 0 som \\0NNN\n  %q      ARGUMENT skrivs i ett format som kan återanvändas som skalindata,\n          icke skrivbara tecken skyddas med den POSIX-syntaxen $''\n\noch alla specifikationer på C-format som slutar med en av diouxXfeEgGcs, med \nARGUMENT konverterade till en passande typ först. Klarar av varierande storlek.\n"

#. from tp:coreutils-9.10-pre1
msgid "%s: expected a numeric value"
msgstr "%s: ett numeriskt värde förväntas"

#. from tp:coreutils-9.10-pre1
msgid "%s: value not completely converted"
msgstr "%s: värdet kunde inte konverteras helt"

#. from tp:coreutils-9.10-pre1
msgid "missing hexadecimal number in escape"
msgstr "saknar hexadecimalt tal i kontrollsekvens"

#. from tp:coreutils-9.10-pre1
msgid "invalid universal character name \\%c%0*x"
msgstr "ogiltigt universellt teckennamn \\%c%0*x"

#. from tp:coreutils-9.10-pre1
msgid "invalid field width: %s"
msgstr "ogiltig fältbredd: %s"

#. from tp:coreutils-9.10-pre1
msgid "invalid precision: %s"
msgstr "ogiltig precision: %s"

#. from tp:coreutils-9.10-pre1
msgid "%.*s: invalid conversion specification"
msgstr "%.*s: felaktig konverteringsspecifikation"

#. from tp:coreutils-9.10-pre1
msgid "warning: ignoring excess arguments, starting with %s"
msgstr "varning: ignorerar överflödiga argument, startar med %s"

#. from tp:coreutils-9.10-pre1
msgid "F. Pinard"
msgstr "François Pinard"

#. from tp:coreutils-9.10-pre1
msgid "%s (for regexp %s)"
msgstr "%s (för reguljäruttrycket %s)"

#. from tp:coreutils-9.10-pre1
msgid "error: regular expression has a match of length zero: %s"
msgstr "fel: det reguljära uttrycket har en matchning med längden noll: %s"

#. from tp:coreutils-9.10-pre1
msgid "Usage: %s [OPTION]... [INPUT]...   (without -G)\n  or:  %s -G [OPTION]... [INPUT [OUTPUT]]\n"
msgstr "Användning: %s [FLAGGA]... [INFIL]... (utan -G)\n  eller:    %s -G [FLAGGA]... [INFIL [UTFIL]]\n"

#. from tp:coreutils-9.10-pre1
msgid "Output a permuted index, including context, of the words in the input files.\n"
msgstr "Mata ut ett permuterat index, med sammanhang, av orden i indatafilerna.\n"

#. from tp:coreutils-9.10-pre1
msgid "  -A, --auto-reference           output automatically generated references\n"
msgstr "  -A, --auto-reference           skriv ut automatiskt genererade referenser\n"

#. from tp:coreutils-9.10-pre1
msgid "  -G, --traditional              behave more like System V 'ptx'\n"
msgstr "  -G, --traditional              uppträd mer som System V:s ”ptx”\n"

#. from tp:coreutils-9.10-pre1
msgid "  -F, --flag-truncation=STRING   use STRING for flagging line truncations.\n                                 The default is '/'\n"
msgstr "  -F, --flag-truncation=STRÄNG   använd STRÄNG för att markera avhuggna rader.\n                                 Standard är ”/”\n"

#. from tp:coreutils-9.10-pre1
msgid "  -M, --macro-name=STRING        macro name to use instead of 'xx'\n"
msgstr "  -M, --macro-name=STRÄNG        makronamn att använda istället för ”xx”\n"

#. from tp:coreutils-9.10-pre1
msgid "  -O, --format=roff              generate output as roff directives\n"
msgstr "  -O, --format=roff              generera utdata som roff-direktiv\n"

#. from tp:coreutils-9.10-pre1
msgid "  -R, --right-side-refs          put references at right, not counted in -w\n"
msgstr "  -R, --right-side-refs          skriv referenser till höger, ej med i -w\n"

#. from tp:coreutils-9.10-pre1
msgid "  -S, --sentence-regexp=REGEXP   for end of lines or end of sentences\n"
msgstr "  -S, --sentence-regexp=REGUTTR  för radslut eller meningsslut\n"

#. from tp:coreutils-9.10-pre1
msgid "  -T, --format=tex               generate output as TeX directives\n"
msgstr "  -T, --format=tex               generera utdata som TeX-direktiv\n"

#. from tp:coreutils-9.10-pre1
msgid "  -W, --word-regexp=REGEXP       use REGEXP to match each keyword\n"
msgstr "  -W, --word-regexp=REGUTTR      använd REGUTTR för att matcha varje nyckelord\n"

#. from tp:coreutils-9.10-pre1
msgid "  -b, --break-file=FILE          word break characters in this FILE\n"
msgstr "  -b, --break-file=FIL           ordavgränsande tecken i denna FIL\n"

#. from tp:coreutils-9.10-pre1
msgid "  -f, --ignore-case              fold lower case to upper case for sorting\n"
msgstr "  -f, --ignore-case              gör om gemener till versaler för sortering\n"

#. from tp:coreutils-9.10-pre1
msgid "  -g, --gap-size=NUMBER          gap size in columns between output fields\n"
msgstr "  -g, --gap-size=ANTAL           mellanrum i kolumner mellan utdatafält\n"

#. from tp:coreutils-9.10-pre1
msgid "  -i, --ignore-file=FILE         read ignore word list from FILE\n"
msgstr "  -i, --ignore-file=FIL          läs lista av ord att ignorera från FIL\n"

#. from tp:coreutils-9.10-pre1
msgid "  -o, --only-file=FILE           read only word list from this FILE\n"
msgstr "  -o, --only-file=FIL            läs lista av ord att endast använda från FIL\n"

#. from tp:coreutils-9.10-pre1
msgid "  -r, --references               first field of each line is a reference\n"
msgstr "  -r, --references               första fältet på varje rad är en referens\n"

#. from tp:coreutils-9.10-pre1
msgid "  -t, --typeset-mode             change the default width from 72 to 100\n"
msgstr "  -t, --typeset-mode             ändra standardbredden från 72 till 100\n"

#. from tp:coreutils-9.10-pre1
msgid "  -w, --width=NUMBER             output width in columns, reference excluded\n"
msgstr "  -w, --width=ANTAL              utmatningsbredd i kolumner, utan referenser\n"

#. from tp:coreutils-9.10-pre1
msgid "invalid gap width: %s"
msgstr "ogiltig gapbredd: %s"

#. from tp:coreutils-9.10-pre1
msgid "invalid line width: %s"
msgstr "felaktig radlängd: %s"

#. from tp:coreutils-9.10-pre1
msgid "Print the full filename of the current working directory.\n\n"
msgstr "Skriv ut hela filnamnet på aktuell katalog.\n\n"

#. from tp:coreutils-9.10-pre1
msgid "  -L, --logical\n         use PWD from environment, even if it contains symlinks\n"
msgstr "  -L, --logical\n         använd miljövariabeln PWD, även om den innehåller symlänkar\n"

#. from tp:coreutils-9.10-pre1
msgid "  -P, --physical\n         resolve all symlinks\n"
msgstr "  -P, --physical\n         slå upp alla symlänkar\n"

#. from tp:coreutils-9.10-pre1
msgid "\nIf no option is specified, -P is assumed.\n"
msgstr "\nOm ingen flagga anges antas -P.\n"

#. from tp:coreutils-9.10-pre1
msgid "failed to chdir to %s"
msgstr "misslyckades med att ändra katalog till %s"

#. from tp:coreutils-9.10-pre1
msgid "failed to stat %s"
msgstr "misslyckades med att ta status på %s"

#. from tp:coreutils-9.10-pre1
msgid "couldn't find directory entry in %s with matching i-node"
msgstr "kunde inte hitta katalogpost i %s med matchande i-nod"

#. from tp:coreutils-9.10-pre1
msgid "ignoring non-option arguments"
msgstr "ignorerar argument som inte är flaggor"

#. from tp:coreutils-9.10-pre1
msgid "Dmitry V. Levin"
msgstr "Dmitrij V. Levin"

#. from tp:coreutils-9.10-pre1
msgid "Usage: %s [OPTION]... FILE...\n"
msgstr "Användning: %s [FLAGGA]... FIL...\n"

#. from tp:coreutils-9.10-pre1
msgid "Print value of a symbolic link or canonical file name\n\n"
msgstr "Skriv värdet på en symbolisk länk eller kanoniskt filnamn\n\n"

#. from tp:coreutils-9.10-pre1
msgid "  -f, --canonicalize\n         canonicalize by following every symlink\n         in every component of the given name recursively;\n         all but the last component must exist\n"
msgstr "  -f, --canonicalize\n         gör kanoniskt genom att följa varje symbolisk länk\n         i varje komponent av det givna namnet rekursivt;\n         alla utom den sista komponenten måste finnas\n"

#. from tp:coreutils-9.10-pre1
msgid "  -e, --canonicalize-existing\n         canonicalize by following every symlink\n         in every component of the given name recursively;\n         all components must exist\n"
msgstr "  -e, --canonicalize-existing\n         gör kanoniskt genom att följa varje symbolisk länk\n         i varje komponent av det givna namnet rekursivt;\n         alla komponenter måste finnas\n"

#. from tp:coreutils-9.10-pre1
msgid "  -m, --canonicalize-missing\n         canonicalize by following every symlink\n         in every component of the given name recursively,\n         without requirements on components existence\n"
msgstr "  -m, --canonicalize-missing\n         gör kanoniskt genom att följa varje symbolisk länk\n         i varje komponent av det givna namnet rekursivt,\n         utan krav på att komponenterna finns\n"

#. from tp:coreutils-9.10-pre1
msgid "  -n, --no-newline\n         do not output the trailing delimiter\n"
msgstr "  -n, --no-newline\n         skriv inte ut den avslutande avgränsaren\n"

#. from tp:coreutils-9.10-pre1
msgid "  -q, --quiet\n"
msgstr "  -q, --quiet\n"

#. from tp:coreutils-9.10-pre1
msgid "  -s, --silent\n         suppress most error messages\n         (on by default if POSIXLY_CORRECT is not set)\n"
msgstr "  -s, --silent\n         undertryck de flesta felmeddelanden\n         (normalt på om POSIXLY_CORRECT inte är satt)\n"

#. from tp:coreutils-9.10-pre1
msgid "  -v, --verbose\n         report error messages\n         (on by default if POSIXLY_CORRECT is set)\n"
msgstr "  -v, --verbose\n         rapportera felmeddelanden\n         (normalt på om POSIXLY_CORRECT är satt)\n"

#. from tp:coreutils-9.10-pre1
msgid "ignoring --no-newline with multiple arguments"
msgstr "ignorerar --no-newline med flera argument"

#. from tp:coreutils-9.10-pre1
msgid "Print the resolved absolute file name.\n"
msgstr "Skriv de upplösta absoluta filnamnen.\n"

#. from tp:coreutils-9.10-pre1
msgid "  -E, --canonicalize           all but the last component must exist (default)\n"
msgstr "  -E, --canonicalize           alla utom sista komponenten måste finnas\n                                 (standard)\n"

#. from tp:coreutils-9.10-pre1
msgid "  -e, --canonicalize-existing  all components of the path must exist\n"
msgstr "  -e, --canonicalize-existing  alla komponenter i sökvägen måste finnas\n"

#. from tp:coreutils-9.10-pre1
msgid "  -m, --canonicalize-missing   no path components need exist or be a directory\n"
msgstr "  -m, --canonicalize-missing   inga komponenter i sökvägen behöver finnas eller\n                                 vara en katalog\n"

#. from tp:coreutils-9.10-pre1
msgid "  -L, --logical                resolve '..' components before symlinks\n"
msgstr "  -L, --logical                lös upp ”..”-komponenter före symlänkar\n"

#. from tp:coreutils-9.10-pre1
msgid "  -P, --physical               resolve symlinks as encountered (default)\n"
msgstr "  -P, --physical               lös upp symlänkar när de påträffas (standard)\n"

#. from tp:coreutils-9.10-pre1
msgid "  -q, --quiet                  suppress most error messages\n"
msgstr "  -q, --quiet                  undertryck de flesta felmeddelanden\n"

#. from tp:coreutils-9.10-pre1
msgid "      --relative-to=DIR        print the resolved path relative to DIR\n"
msgstr "      --relative-to=KAT        skriv den upplösta sökvägen relativt KAT\n"

#. from tp:coreutils-9.10-pre1
msgid "      --relative-base=DIR      print absolute paths unless paths below DIR\n"
msgstr "      --relative-base=KAT      skriv absoluta sökvägar om de inte är under KAT\n"

#. from tp:coreutils-9.10-pre1
msgid "  -s, --strip, --no-symlinks   don't expand symlinks\n"
msgstr "  -s, --strip, --no-symlinks   expandera inte symlänkar\n"

#. from tp:coreutils-9.10-pre1
msgid "  -z, --zero                   end each output line with NUL, not newline\n"
msgstr "  -z, --zero                   avsluta varje utmatad rad med NUL, inte nyrad\n"

#. from tp:coreutils-9.10-pre1
msgid "generating relative path"
msgstr "genererar relativ sökväg"

#. from tp:coreutils-9.10-pre1
msgid "%s: descend into write-protected directory %s? "
msgstr "%s: gå ner i skrivskyddad katalog %s? "

#. from tp:coreutils-9.10-pre1
msgid "%s: descend into directory %s? "
msgstr "%s: gå ner i katalog %s? "

#. from tp:coreutils-9.10-pre1
msgid "%s: attempt removal of inaccessible directory %s? "
msgstr "%s: försök att ta bort den oåtkomliga katalogen %s? "

#. from tp:coreutils-9.10-pre1
msgid "%s: remove write-protected %s %s? "
msgstr "%1$s: %3$s är skrivskyddad och av typen ”%2$s” – ta bort? "

#. from tp:coreutils-9.10-pre1
msgid "%s: remove %s %s? "
msgstr "%s: ta bort %s %s? "

#. from tp:coreutils-9.10-pre1
msgid "removed directory %s\n"
msgstr "tog bort katalogen %s\n"

#. from tp:coreutils-9.10-pre1
msgid "refusing to remove %s or %s directory: skipping %s"
msgstr "vägrar att ta bort katalogen %s eller %s: hoppar över %s"

#. from tp:coreutils-9.10-pre1
msgid "failed to stat %s: skipping %s"
msgstr "misslyckades med att ta status på %s: hoppar över %s"

#. from tp:coreutils-9.10-pre1
msgid "skipping %s, since it's on a different device"
msgstr "hoppar över %s, eftersom den är på en annan enhet"

#. from tp:coreutils-9.10-pre1
msgid "and --preserve-root=all is in effect"
msgstr "och --preserve-root=all är aktivt"

#. from tp:coreutils-9.10-pre1
msgid "traversal failed: %s"
msgstr "traversering misslyckades: %s"

#. from tp:coreutils-9.10-pre1
msgid "unexpected failure: fts_info=%d: %s\nplease report to %s"
msgstr "oväntat fel: fts_info=%d: %s\nrapportera gärna till %s"

#. from tp:coreutils-9.10-pre1
msgid "Try '%s ./%s' to remove the file %s.\n"
msgstr "Försök med ”%s ./%s” för att ta bort filen %s.\n"

#. from tp:coreutils-9.10-pre1
msgid "Remove (unlink) the FILE(s).\n\n"
msgstr "Ta bort (avlänka) FIL(en/erna).\n\n"

#. from tp:coreutils-9.10-pre1
msgid "  -f, --force\n         ignore nonexistent files and arguments, never prompt\n"
msgstr "  -f, --force\n         ignorera ej existerande filer och argument, fråga aldrig\n"

#. from tp:coreutils-9.10-pre1
msgid "  -i\n         prompt before every removal\n"
msgstr "  -i\n         fråga före varje borttagning\n"

#. from tp:coreutils-9.10-pre1
msgid "  -I\n         prompt once before removing more than three files,\n         or when removing recursively; less intrusive than -i,\n         while still giving protection against most mistakes\n"
msgstr "  -I\n         fråga en gång innan mer än tre filer tas bort,\n         eller vid rekursiv borttagning; mindre påträngande än -i,\n         men skyddar ändå mot de flesta misstag\n"

#. from tp:coreutils-9.10-pre1
msgid "      --interactive[=WHEN]\n         prompt according to WHEN: never, once (-I), or always (-i);\n         without WHEN, prompt always\n"
msgstr "      --interactive[=NÄR]\n         fråga enligt NÄR: never, once (-I), eller always (-i);\n         utan NÄR, fråga alltid\n"

#. from tp:coreutils-9.10-pre1
msgid "      --one-file-system\n         when removing a hierarchy recursively,\n         skip any directory that is on a file system different\n         from that of the corresponding command line argument\n"
msgstr "      --one-file-system\n         när en hierarki tas bort rekursivt,\n         hoppa över eventuella kataloger som ligger på andra\n         filsystem än motsvarande kommandoradsargument gör\n"

#. from tp:coreutils-9.10-pre1
msgid "      --no-preserve-root\n         do not treat '/' specially\n"
msgstr "      --no-preserve-root\n         behandla inte ”/” speciellt\n"

#. from tp:coreutils-9.10-pre1
msgid "      --preserve-root[=all]\n         do not remove '/' (default);\n         with 'all', reject any command line argument\n         on a separate device from its parent\n"
msgstr "      --preserve-root[=all]\n         ta inte bort ”/” (normalfall);\n         med ”all”, avvisa alla kommandoradsargument\n         på en annan enhet än sin förälder\n"

#. from tp:coreutils-9.10-pre1
msgid "  -r, -R, --recursive\n         remove directories and their contents recursively\n"
msgstr "  -r, -R, --recursive\n         ta bort kataloger och deras innehåll rekursivt\n"

#. from tp:coreutils-9.10-pre1
msgid "  -d, --dir\n         remove empty directories\n"
msgstr "  -d, --dir\n         ta bort tomma kataloger\n"

#. from tp:coreutils-9.10-pre1
msgid "\nBy default, rm does not remove directories.  Use the --recursive (-r or -R)\noption to remove each listed directory, too, along with all of its contents.\n"
msgstr "\nSom standard tar rm inte bort kataloger.  Använd flaggan --recursive (-r eller\n-R) för att ta bort varje uppräknad katalog också, tillsammans med hela dess\ninnehåll.\n"

#. from tp:coreutils-9.10-pre1
msgid "\nAny attempt to remove a file whose last file name component is '.' or '..'\nis rejected with a diagnostic.\n"
msgstr "\nEtt försök att ta bort en fil vars sista filnamnskomponent är ”.” eller ”..”\navvisas med ett felmeddelande.\n"

#. from tp:coreutils-9.10-pre1
msgid "\nTo remove a file whose name starts with a '-', for example '-foo',\nuse one of these commands:\n  %s -- -foo\n\n  %s ./-foo\n"
msgstr "\nFör att ta bort filer vars namn börjar med ”-”, till exempel ”-apa”,\nanvänder du ett av dessa kommandon:\n  %s -- -apa\n\n  %s ./-apa\n"

#. from tp:coreutils-9.10-pre1
msgid "\nIf you use rm to remove a file, it might be possible to recover\nsome of its contents, given sufficient expertise and/or time.  For greater\nassurance that the contents are unrecoverable, consider using shred(1).\n"
msgstr "\nOm man använder rm för att ta bort en fil kan det vara möjligt att få tillbaka\nen del av dess innehåll, givet tillräckligt med expertis och/eller tid.\nFör större visshet om att innehållet inte kan återställas, överväg att använda\nshred(1).\n"

#. from tp:coreutils-9.10-pre1
msgid "you may not abbreviate the --no-preserve-root option"
msgstr "du får inte förkorta flaggan --no-preserve-root"

#. from tp:coreutils-9.10-pre1
msgid "unrecognized --preserve-root argument: %s"
msgstr "okänt argument till --preserve-root: %s"

#. from tp:coreutils-9.10-pre1
msgid "removing directory, %s"
msgstr "tar bort katalog, %s"

#. from tp:coreutils-9.10-pre1
msgid "failed to remove directory %s"
msgstr "misslyckades med att ta bort katalogen %s"

#. from tp:coreutils-9.10-pre1
msgid "failed to remove %s"
msgstr "misslyckades med att ta bort %s"

#. from tp:coreutils-9.10-pre1
msgid "Remove the DIRECTORY(ies), if they are empty.\n\n"
msgstr "Ta bort KATALOG(er), om de är tomma.\n\n"

#. from tp:coreutils-9.10-pre1
msgid "      --ignore-fail-on-non-empty\n         ignore each failure to remove a non-empty directory\n"
msgstr "      --ignore-fail-on-non-empty\n         ignorera alla misslyckanden att ta bort kataloger som inte är tomma\n"

#. from tp:coreutils-9.10-pre1
msgid "  -p, --parents\n         remove DIRECTORY and its ancestors;\n         e.g., 'rmdir -p a/b' is similar to 'rmdir a/b a'\n"
msgstr "  -p, --parents\n         ta bort KATALOG och dess föräldrar;\n         t.ex. ”rmdir -p a/b” liknar ”rmdir a/b a”\n"

#. from tp:coreutils-9.10-pre1
msgid "  -v, --verbose\n         output a diagnostic for every directory processed\n"
msgstr "  -v, --verbose\n         skriv ut ett meddelande för varje bearbetad katalog\n"

#. from tp:coreutils-9.10-pre1
msgid "failed to remove %s: Symbolic link not followed"
msgstr "misslyckades med att ta bort %s: den symboliska länken följs inte"

#. from tp:coreutils-9.10-pre1
msgid "Usage: %s [CONTEXT COMMAND [ARG]...]\n  or:  %s [-c] [-u USER] [-r ROLE] [-t TYPE] [-l RANGE] COMMAND [ARG]...\n"
msgstr "Användning: %s [KONTEXT KOMMANDO [ARG]…]\n  eller:    %s [-c] [-u ANV] [-r ROLL] [-t TYP] [-l INTVL] KOMMANDO [ARG]…\n"

#. from tp:coreutils-9.10-pre1
msgid "Run a program in a different SELinux security context.\nWith neither CONTEXT nor COMMAND, print the current security context.\n"
msgstr "Kör ett program i en annan SELinux-säkerhetskontext.\nMed varken KONTEXT eller KOMMANDO, skriv ut den aktuella säkerhetskontexten.\n"

#. from tp:coreutils-9.10-pre1
msgid "  CONTEXT            Complete security context\n"
msgstr "  KONTEXT            Fullständig säkerhetskontext\n"

#. from tp:coreutils-9.10-pre1
msgid "  -c, --compute      compute process transition context before modifying\n"
msgstr "  -c, --compute      beräkna processövergångskontext före modifiering\n"

#. from tp:coreutils-9.10-pre1
msgid "  -t, --type=TYPE    type (for same role as parent)\n"
msgstr "  -t, --type=TYP     typ (för samma roll som föräldern)\n"

#. from tp:coreutils-9.10-pre1
msgid "  -u, --user=USER    user identity\n"
msgstr "  -u, --user=ANV     användaridentitet\n"

#. from tp:coreutils-9.10-pre1
msgid "  -r, --role=ROLE    role\n"
msgstr "  -r, --role=ROLL    roll\n"

#. from tp:coreutils-9.10-pre1
msgid "  -l, --range=RANGE  levelrange\n"
msgstr "  -l, --range=INTVL  nivåintervall\n"

#. from tp:coreutils-9.10-pre1
msgid "multiple roles"
msgstr "flera roller"

#. from tp:coreutils-9.10-pre1
msgid "multiple types"
msgstr "flera typer"

#. from tp:coreutils-9.10-pre1
msgid "multiple users"
msgstr "flera användare"

#. from tp:coreutils-9.10-pre1
msgid "multiple levelranges"
msgstr "flera nivåintervall"

#. from tp:coreutils-9.10-pre1
msgid "failed to get current context"
msgstr "misslyckades med att hämta aktuell kontext"

#. from tp:coreutils-9.10-pre1
msgid "you must specify -c, -t, -u, -l, -r, or context"
msgstr "du måste ange -c, -t, -u, -l, -r eller kontext"

#. from tp:coreutils-9.10-pre1
msgid "no command specified"
msgstr "inget kommando angivet"

#. from tp:coreutils-9.10-pre1
msgid "%s may be used only on a SELinux kernel"
msgstr "%s kan bara användas på en SELinux-kärna"

#. from tp:coreutils-9.10-pre1
msgid "failed to compute a new context"
msgstr "misslyckades med att beräkna en ny kontext"

#. from tp:coreutils-9.10-pre1
msgid "failed to set new user: %s"
msgstr "misslyckades med att sätta ny användare: %s"

#. from tp:coreutils-9.10-pre1
msgid "failed to set new type: %s"
msgstr "misslyckades med att sätta ny typ: %s"

#. from tp:coreutils-9.10-pre1
msgid "failed to set new range: %s"
msgstr "misslyckades med att sätta nytt intervall: %s"

#. from tp:coreutils-9.10-pre1
msgid "failed to set new role: %s"
msgstr "misslyckades med att sätta ny roll: %s"

#. from tp:coreutils-9.10-pre1
msgid "unable to set security context %s"
msgstr "kan inte sätta säkerhetskontext %s"

#. from tp:coreutils-9.10-pre1
msgid "Usage: %s [OPTION]... LAST\n  or:  %s [OPTION]... FIRST LAST\n  or:  %s [OPTION]... FIRST INCREMENT LAST\n"
msgstr "Användning: %s [FLAGGA]... SISTA\n  eller:    %s [FLAGGA]... FÖRSTA SISTA\n  eller:    %s [FLAGGA]... FÖRSTA ÖKNING SISTA\n"

#. from tp:coreutils-9.10-pre1
msgid "Print numbers from FIRST to LAST, in steps of INCREMENT.\n"
msgstr "Skriv ut tal från FÖRSTA till SISTA, i steg om ÖKNING.\n"

#. from tp:coreutils-9.10-pre1
msgid "  -f, --format=FORMAT\n         use printf style floating-point FORMAT\n"
msgstr "  -f, --format=FORMAT\n         använd flyttalsFORMAT av typ printf\n"

#. from tp:coreutils-9.10-pre1
msgid "  -s, --separator=STRING\n         use STRING to separate numbers (default: \\n)\n"
msgstr "  -s, --separator=STRÄNG\n         använd STRÄNG för att separera tal (standard: \\n)\n"

#. from tp:coreutils-9.10-pre1
msgid "  -w, --equal-width\n         equalize width by padding with leading zeroes\n"
msgstr "  -w, --equal-width\n         jämna ut bredd genom att lägga till inledande nollor\n"

#. from tp:coreutils-9.10-pre1
msgid "\nIf FIRST or INCREMENT is omitted, it defaults to 1.  That is, an\nomitted INCREMENT defaults to 1 even when LAST is smaller than FIRST.\nThe sequence of numbers ends when the sum of the current number and\nINCREMENT would become greater than LAST.\nFIRST, INCREMENT, and LAST are interpreted as floating point values.\nINCREMENT is usually positive if FIRST is smaller than LAST, and\nINCREMENT is usually negative if FIRST is greater than LAST.\nINCREMENT must not be 0; none of FIRST, INCREMENT and LAST may be NaN.\n"
msgstr "\nOm FÖRSTA eller ÖKNING utelämnas, sätts de till 1. Det vill säga, en\nutelämnad ÖKNING sätts till 1 även när SISTA är mindre än FÖRSTA.\nSekvensen av tal slutar när summan av det aktuella talet och ÖKNING\nskulle bli större än SISTA.  FÖRSTA, ÖKNING och SISTA tolkas som\nflyttalsvärden.  ÖKNING är normalt positiv om FÖRSTA är mindre än\nSISTA och ÖKNING är normalt negativ om FÖRSTA är större än SISTA.\nÖKNING får inte vara 0, ingen av FÖRSTA, ÖKNING och SISTA får vara NaN.\n"

#. from tp:coreutils-9.10-pre1
msgid "FORMAT must be suitable for printing one argument of type 'double';\nit defaults to %.PRECf if FIRST, INCREMENT, and LAST are all fixed point\ndecimal numbers with maximum precision PREC, and to %g otherwise.\n"
msgstr "FORMAT måste passa för att skriva ett argument av typen ”double”.  Som\nstandard är det %.PRECf om FÖRSTA, ÖKNING och SISTA alla är\nfixpunktsdecimaltal med maximal precision PREC, och annars %g.\n"

#. from tp:coreutils-9.10-pre1
msgid "invalid floating point argument: %s"
msgstr "felaktigt flyttalsargument: %s"

#. from tp:coreutils-9.10-pre1
msgid "invalid %s argument: %s"
msgstr "felaktigt argument till %s: %s"

#. from tp:coreutils-9.10-pre1
msgid "format %s has unknown %%%c directive"
msgstr "formatet %s har okänt %%%c-direktiv"

#. from tp:coreutils-9.10-pre1
msgid "format string may not be specified when printing equal width strings"
msgstr "formatsträng får inte anges när strängar med lika bredd skrivs"

#. from tp:coreutils-9.10-pre1
msgid "invalid Zero increment value: %s"
msgstr "felaktigt ökningsvärde noll: %s"

#. from tp:coreutils-9.10-pre1
msgid "invalid byte or character range"
msgstr "felaktigt byte- eller teckenintervall"

#. from tp:coreutils-9.10-pre1
msgid "invalid field range"
msgstr "felaktigt fältintervall"

#. from tp:coreutils-9.10-pre1
msgid "byte/character positions are numbered from 1"
msgstr "byte-/teckenpositioner numreras från 1"

#. from tp:coreutils-9.10-pre1
msgid "fields are numbered from 1"
msgstr "fält numreras från 1"

#. from tp:coreutils-9.10-pre1
msgid "invalid range with no endpoint: -"
msgstr "ogiltigt intervall utan slutpunkt: -"

#. from tp:coreutils-9.10-pre1
msgid "invalid decreasing range"
msgstr "ogiltigt sjunkande intervall"

#. from tp:coreutils-9.10-pre1
msgid "byte/character offset %s is too large"
msgstr "byte-/teckenposition %s är för stor"

#. from tp:coreutils-9.10-pre1
msgid "field number %s is too large"
msgstr "fältnummer %s är för stort"

#. from tp:coreutils-9.10-pre1
msgid "invalid byte/character position %s"
msgstr "felaktig byte-/teckenposition %s"

#. from tp:coreutils-9.10-pre1
msgid "invalid field value %s"
msgstr "felaktigt fältvärde %s"

#. from tp:coreutils-9.10-pre1
msgid "missing list of byte/character positions"
msgstr "saknad lista med byte-/teckenpositioner"

#. from tp:coreutils-9.10-pre1
msgid "missing list of fields"
msgstr "saknar fältlista"

#. from tp:coreutils-9.10-pre1
msgid "time %s is out of range"
msgstr "tiden %s är utanför tillåtet intervall"

#. from tp:coreutils-9.10-pre1
msgid "fprintftime error"
msgstr "fprintftime-fel"

#. from tp:coreutils-9.10-pre1
msgid "Colin Plumb"
msgstr "Colin Plumb"

#. from tp:coreutils-9.10-pre1
msgid "Overwrite the specified FILE(s) repeatedly, in order to make it harder\nfor even very expensive hardware probing to recover the data.\n"
msgstr "Skriv över de angivna FIL(erna) upprepade gånger för att göra det svårare\natt återställa data, även med mycket dyr undersökningsutrustning för hårdvara.\n"

#. from tp:coreutils-9.10-pre1
msgid "\nIf FILE is -, shred standard output.\n"
msgstr "\nOm FIL är -, strimla standard ut.\n"

#. from tp:coreutils-9.10-pre1
msgid "  -f, --force\n         change permissions to allow writing if necessary\n"
msgstr "  -f, --force\n         ändra rättigheter för att tillåta skrivning, om nödvändigt\n"

#. from tp:coreutils-9.10-pre1
msgid "  -n, --iterations=N\n         overwrite N times instead of the default (%d)\n"
msgstr "  -n, --iterations=N\n         skriv över N gånger istället för standard (%d)\n"

#. from tp:coreutils-9.10-pre1
msgid "      --random-source=FILE\n         get random bytes from FILE\n"
msgstr "      --random-source=FIL\n         hämta slumpmässiga byte från FIL\n"

#. from tp:coreutils-9.10-pre1
msgid "  -s, --size=N\n         shred this many bytes (suffixes like K, M, G accepted)\n"
msgstr "  -s, --size=N\n         strimla detta antal byte (ändelse som K, M, G fungerar)\n"

#. from tp:coreutils-9.10-pre1
msgid "  -u\n         deallocate and remove file after overwriting\n"
msgstr "  -u\n         avallokera och ta bort filen efter överskrivningen\n"

#. from tp:coreutils-9.10-pre1
msgid "      --remove[=HOW]\n         like -u but give control on HOW to delete;  See below\n"
msgstr "      --remove[=HUR]\n         som -u men styr HUR filen tas bort; se nedan\n"

#. from tp:coreutils-9.10-pre1
msgid "  -v, --verbose\n         show details of data and metadata operations performed\n"
msgstr "  -v, --verbose\n         visa detaljer om åtgärder som utförs på data och metadata\n"

#. from tp:coreutils-9.10-pre1
msgid "  -x, --exact\n         do not round file sizes up to the next full block;\n         this is the default for non-regular files\n"
msgstr "  -x, --exact\n         avrunda inte filstorlekar upp till nästa hela block;\n         detta är standardfallet för filer som inte är vanliga filer\n"

#. from tp:coreutils-9.10-pre1
msgid "  -z, --zero\n         add a final overwrite with zeros to hide shredding\n"
msgstr "  -z, --zero\n         lägg till en avslutande överskrivning med nollor för att\n         dölja strimlandet\n"

#. from tp:coreutils-9.10-pre1
msgid "\nDelete FILE(s) if --remove (-u) is specified.  The default is not to remove\nthe files because it is common to operate on device files like /dev/hda,\nand those files usually should not be removed.\nThe optional HOW parameter indicates how to remove a directory entry:\n'unlink' => use a standard unlink call.\n'wipe' => also first obfuscate bytes in the name.\n'wipesync' => also sync each obfuscated byte to the device.\nThe default mode is 'wipesync', but note it can be expensive.\n\n"
msgstr "\nTa bort FIL(er) om --remove (-u) anges.  Standard är att inte ta bort filerna\nför det är vanligt att arbeta på enhetsfiler som /dev/hda, och dessa filer\nbör inte tas bort.\nDen frivilliga parametern HUR anger hur katalogposter skall tas bort:\n”unlink” ⇒ använd ett vanligt anrop av unlink.\n”wipe” ⇒ skriv även först över filnamnets byte.\n”wipesync” ⇒ synkronisera även varje överskriven byte till enheten.\nStandardläget är ”wipesync”, men observera att detta kan vara dyrt.\n\n"

#. from tp:coreutils-9.10-pre1
msgid "CAUTION: shred assumes the file system and hardware overwrite data in place.\nAlthough this is common, many platforms operate otherwise.  Also, backups\nand mirrors may contain unremovable copies that will let a shredded file\nbe recovered later.  See the GNU coreutils manual for details.\n"
msgstr "VARNING: shred antar att filsystemet och hårdvaran skriver över data på plats.\nÄven om detta är vanligt fungerar många plattformar på annat sätt.  Vidare kan\nsäkerhetskopior och speglar innehålla kopior som inte går att ta bort som gör\natt den strimlade filen kan återskapas senare.  Se manualen för GNU coreutils\nför detaljer.\n"

#. from tp:coreutils-9.10-pre1
msgid "%s: fdatasync failed"
msgstr "%s: fdatasync misslyckades"

#. from tp:coreutils-9.10-pre1
msgid "%s: fsync failed"
msgstr "%s: fsync misslyckades"

#. from tp:coreutils-9.10-pre1
msgid "%s: cannot rewind"
msgstr "%s: kan inte backa till början"

#. from tp:coreutils-9.10-pre1
msgid "%s: pass %lu/%lu (%s)..."
msgstr "%s: pass %lu/%lu (%s)..."

#. from tp:coreutils-9.10-pre1
msgid "%s: error writing at offset %ju"
msgstr "%s: fel vid skrivning vid position %ju"

#. from tp:coreutils-9.10-pre1
msgid "%s: lseek failed"
msgstr "%s: lseek misslyckades"

#. from tp:coreutils-9.10-pre1
msgid "%s: file too large"
msgstr "%s: filen är för stor"

#. from tp:coreutils-9.10-pre1
msgid "%s: pass %lu/%lu (%s)...%s"
msgstr "%s: pass %lu/%lu (%s)...%s"

#. from tp:coreutils-9.10-pre1
msgid "%s: pass %lu/%lu (%s)...%s/%s %d%%"
msgstr "%s: pass %lu/%lu (%s)...%s/%s %d %%"

#. from tp:coreutils-9.10-pre1
msgid "%s: fstat failed"
msgstr "%s: fstat misslyckades"

#. from tp:coreutils-9.10-pre1
msgid "%s: invalid file type"
msgstr "%s: ogiltig filtyp"

#. from tp:coreutils-9.10-pre1
msgid "%s: file has negative size"
msgstr "%s: filen har negativ storlek"

#. from tp:coreutils-9.10-pre1
msgid "%s: error truncating"
msgstr "%s: fel vid avhuggning"

#. from tp:coreutils-9.10-pre1
msgid "%s: fcntl failed"
msgstr "%s: fcntl misslyckades"

#. from tp:coreutils-9.10-pre1
msgid "%s: cannot shred append-only file descriptor"
msgstr "%s: kan inte skriva över filidentifierare som bara är öppnad för tillägg"

#. from tp:coreutils-9.10-pre1
msgid "%s: removing"
msgstr "%s: tar bort"

#. from tp:coreutils-9.10-pre1
msgid "%s: renamed to %s"
msgstr "%s: namnändrad till %s"

#. from tp:coreutils-9.10-pre1
msgid "%s: failed to remove"
msgstr "%s: misslyckades med att ta bort"

#. from tp:coreutils-9.10-pre1
msgid "%s: removed"
msgstr "%s: borttagen"

#. from tp:coreutils-9.10-pre1
msgid "%s: failed to close"
msgstr "%s: misslyckades med att stänga"

#. from tp:coreutils-9.10-pre1
msgid "%s: failed to open for writing"
msgstr "%s: misslyckades med att öppna för skrivning"

#. from tp:coreutils-9.10-pre1
msgid "invalid number of passes"
msgstr "ogiltigt antal pass"

#. from tp:coreutils-9.10-pre1
msgid "multiple random sources specified"
msgstr "multipla slumpkällor angivna"

#. from tp:coreutils-9.10-pre1
msgid "invalid file size"
msgstr "ogiltig filstorlek"

#. from tp:coreutils-9.10-pre1
msgid "Usage: %s [OPTION]... [FILE]\n  or:  %s -e [OPTION]... [ARG]...\n  or:  %s -i LO-HI [OPTION]...\n"
msgstr "Användning: %s [FLAGGA]… [FIL]\n  eller:    %s -e [FLAGGA]… [ARG]…\n  eller:    %s -i LÅGT-HÖGT [FLAGGA]…\n"

#. from tp:coreutils-9.10-pre1
msgid "Write a random permutation of the input lines to standard output.\n"
msgstr "Skriv en slumpvis permutation av indataraderna till standard ut.\n"

#. from tp:coreutils-9.10-pre1
msgid "  -e, --echo                treat each ARG as an input line\n"
msgstr "  -e, --echo                behandla varje ARG som en indatarad\n"

#. from tp:coreutils-9.10-pre1
msgid "  -i, --input-range=LO-HI   treat each number LO through HI as an input line\n"
msgstr "  -i, --input-range=LÅGT-HÖGT  behandla varje tal från LÅGT till HÖGT\n                             som en indatarad\n"

#. from tp:coreutils-9.10-pre1
msgid "  -n, --head-count=COUNT    output at most COUNT lines\n"
msgstr "  -n, --head-count=ANTAL    skriv ut högst ANTAL rader\n"

#. from tp:coreutils-9.10-pre1
msgid "  -o, --output=FILE         write result to FILE instead of standard output\n"
msgstr "  -o, --output=FIL          skriv resultatet till FIL istället för standard ut\n"

#. from tp:coreutils-9.10-pre1
msgid "      --random-source=FILE  get random bytes from FILE\n"
msgstr "      --random-source=FIL   hämta slumpmässiga byte från FIL\n"

#. from tp:coreutils-9.10-pre1
msgid "  -r, --repeat              output lines can be repeated\n"
msgstr "  -r, --repeat              utskrivna rader kan upprepas\n"

#. from tp:coreutils-9.10-pre1
msgid "  -z, --zero-terminated     line delimiter is NUL, not newline\n"
msgstr "  -z, --zero-terminated     radavgränsare är NUL, inte nyrad\n"

#. from tp:coreutils-9.10-pre1
msgid "too many input lines"
msgstr "för många indatarader"

#. from tp:coreutils-9.10-pre1
msgid "multiple -i options specified"
msgstr "multipla -i-flaggor angivna"

#. from tp:coreutils-9.10-pre1
msgid "invalid input range"
msgstr "ogiltigt indataintervall"

#. from tp:coreutils-9.10-pre1
msgid "invalid line count: %s"
msgstr "felaktigt radantal: %s"

#. from tp:coreutils-9.10-pre1
msgid "multiple output files specified"
msgstr "multipla utfiler angivna"

#. from tp:coreutils-9.10-pre1
msgid "cannot combine -e and -i options"
msgstr "det går inte att kombinera flaggorna -e och -i"

#. from tp:coreutils-9.10-pre1
msgid "no lines to repeat"
msgstr "inga rader att upprepa"

#. from tp:coreutils-9.10-pre1
msgid "Usage: %s NUMBER[SUFFIX]...\n  or:  %s OPTION\nPause for NUMBER seconds, where NUMBER is an integer or floating-point.\nSUFFIX may be 's','m','h', or 'd', for seconds, minutes, hours, days.\nWith multiple arguments, pause for the sum of their values.\n\n"
msgstr "Användning: %s ANTAL[ÄNDELSE]…\n   eller:   %s FLAGGA\nGör paus i ANTAL sekunder, där ANTAL är ett heltal eller flyttal.\nÄNDELSE kan vara ”s”, ”m”, ”h” eller ”d” för sekunder, minuter, timmar, dagar.\nMed två eller flera argument, gör paus så länge som summan av dem anger.\n\n"

#. from tp:coreutils-9.10-pre1
msgid "invalid time interval %s"
msgstr "felaktigt tidsintervall: %s"

#. from tp:coreutils-9.10-pre1
msgid "cannot read realtime clock"
msgstr "kan inte läsa realtidsklockan"

#. from tp:coreutils-9.10-pre1
msgid "Write sorted concatenation of all FILE(s) to standard output.\n"
msgstr "Skriv en sorterad sammanfogning av alla FIL(er) till standard ut.\n"

#. from tp:coreutils-9.10-pre1
msgid "Ordering options:\n\n"
msgstr "Sorteringsflaggor:\n\n"

#. from tp:coreutils-9.10-pre1
msgid "  -b, --ignore-leading-blanks\n         ignore leading blanks when finding sort keys in each line\n"
msgstr "  -b, --ignore-leading-blanks\n         ignorera inledande blanktecken vid sökning efter sorteringsnycklar\n         på varje rad\n"

#. from tp:coreutils-9.10-pre1
msgid "  -d, --dictionary-order\n         consider only blanks and alphanumeric characters\n"
msgstr "  -d, --dictionary-order\n         betrakta endast alfanumeriska och blanka tecken\n"

#. from tp:coreutils-9.10-pre1
msgid "  -f, --ignore-case\n         fold lower case to upper case characters\n"
msgstr "  -f, --ignore-case\n         byt gemener mot versaler\n"

#. from tp:coreutils-9.10-pre1
msgid "  -g, --general-numeric-sort\n         compare according to general numerical value\n"
msgstr "  -g, --general-numeric-sort\n         jämför enligt generellt numeriskt värde\n"

#. from tp:coreutils-9.10-pre1
msgid "  -i, --ignore-nonprinting\n         consider only printable characters\n"
msgstr "  -i, --ignore-nonprinting\n         beakta endast skrivbara tecken\n"

#. from tp:coreutils-9.10-pre1
msgid "  -M, --month-sort\n         compare (unknown) < 'JAN' < ... < 'DEC'\n"
msgstr "  -M, --month-sort\n         jämför (okänd) < ”JAN” < … < ”DEC”\n"

#. from tp:coreutils-9.10-pre1
msgid "  -h, --human-numeric-sort\n         compare human readable numbers (e.g., 2K 1G)\n"
msgstr "  -h, --human-numeric-sort\n         jämför mänskligt läsbara tal (t.ex., 2K 1G)\n"

#. from tp:coreutils-9.10-pre1
msgid "  -n, --numeric-sort\n         compare according to string numerical value;\n         see full documentation for supported strings\n"
msgstr "  -n, --numeric-sort\n         jämför enligt strängens numeriska värde;\n         se den fullständiga dokumentationen för vilka strängar som stödjs\n"

#. from tp:coreutils-9.10-pre1
msgid "  -R, --random-sort\n         shuffle, but group identical keys.  See also shuf(1)\n"
msgstr "  -R, --random-sort\n         blanda, men gruppera identiska nycklar. Se även shuf(1)\n"

#. from tp:coreutils-9.10-pre1
msgid "  -r, --reverse\n         reverse the result of comparisons\n"
msgstr "  -r, --reverse\n         vänd på resultatet av jämförelserna\n"

#. from tp:coreutils-9.10-pre1
msgid "      --sort=WORD\n         sort according to WORD:\n           general-numeric -g, human-numeric -h, month -M,\n           numeric -n, random -R, version -V\n"
msgstr "      --sort=ORD\n         sortera enligt ORD:\n         general-numeric -g, human-numeric -h, month -M,\n         numeric -n, random -R, version -V\n"

#. from tp:coreutils-9.10-pre1
msgid "  -V, --version-sort\n         natural sort of (version) numbers within text\n"
msgstr "  -V, --version-sort\n         naturlig sortering av (versions)nummer i text\n"

#. from tp:coreutils-9.10-pre1
msgid "\nOther options:\n\n"
msgstr "\nAndra flaggor:\n\n"

#. from tp:coreutils-9.10-pre1
msgid "      --batch-size=NMERGE\n         merge at most NMERGE inputs at once; for more use temp files\n"
msgstr "      --batch-size=ANTAL\n         slå samman högst ANTAL indatafiler åt gången;\n         använd temporärfiler för fler\n"

#. from tp:coreutils-9.10-pre1
msgid "  -c, --check, --check=diagnose-first\n         check for sorted input; do not sort\n"
msgstr "  -c, --check, --check=diagnose-first\n         kontrollera om indata är sorterad, sortera ej\n"

#. from tp:coreutils-9.10-pre1
msgid "  -C, --check=quiet, --check=silent\n         like -c, but do not report first bad line\n"
msgstr "  -C, --check=quiet, --check=silent\n         som -c, men rapportera inte den första felaktiga raden\n"

#. from tp:coreutils-9.10-pre1
msgid "      --compress-program=PROG\n         compress temporaries with PROG; decompress them with PROG -d\n"
msgstr "      --compress-program=PROG\n         komprimera temporärfiler med PROG; packa upp dem med PROG -d\n"

#. from tp:coreutils-9.10-pre1
msgid "      --debug\n         annotate the part of the line used to sort,\n         and warn about questionable usage to standard error\n"
msgstr "      --debug\n         annotera delarna av raden som används för sortering,\n         och varna om tveksam användning till standard fel\n"

#. from tp:coreutils-9.10-pre1
msgid "      --files0-from=F\n         read input from the files specified by NUL-terminated names in file F;\n         If F is -, read names from standard input\n"
msgstr "      --files0-from=F\n         läs indata från filer som anges med NUL-terminerade namn i filen F;\n         Om F är -, läs namn från standard in\n"

#. from tp:coreutils-9.10-pre1
msgid "  -k, --key=KEYDEF\n         sort via a key; KEYDEF gives location and type\n"
msgstr "  -k, --key=NYCKELDEF\n         sortera via en nyckel; NYCKELDEF anger plats och typ\n"

#. from tp:coreutils-9.10-pre1
msgid "  -m, --merge\n         merge already sorted files; do not sort\n"
msgstr "  -m, --merge\n         slå samman redan sorterade filer, sortera inte\n"

#. from tp:coreutils-9.10-pre1
msgid "  -o, --output=FILE\n         write result to FILE instead of standard output\n"
msgstr "  -o, --output=FIL\n         skriv resultatet till FIL i stället för standard ut\n"

#. from tp:coreutils-9.10-pre1
msgid "  -s, --stable\n         stabilize sort by disabling last-resort comparison\n"
msgstr "  -s, --stable\n         stabilisera sortering genom att stänga av sista-utvägsjämförelse\n"

#. from tp:coreutils-9.10-pre1
msgid "  -S, --buffer-size=SIZE\n         use SIZE for main memory buffer\n"
msgstr "  -S, --buffer-size=STORLEK\n         använd STORLEK för huvudminnesbuffert\n"

#. from tp:coreutils-9.10-pre1
msgid "  -t, --field-separator=SEP\n         use SEP instead of non-blank to blank transition\n"
msgstr "  -t, --field-separator=SEP\n         använd SEP istället för övergång från ej blanka till blanka\n"

#. from tp:coreutils-9.10-pre1
msgid "  -T, --temporary-directory=DIR\n         use DIR for temporaries, not $TMPDIR or %s;\n         multiple options specify multiple directories\n"
msgstr "  -T, --temporary-directory=KAT\n         använd KAT för tillfälliga filer, ej $TMPDIR eller %s;\n         flera flaggor anger flera kataloger\n"

#. from tp:coreutils-9.10-pre1
msgid "      --parallel=N\n         change the number of sorts run concurrently to N\n"
msgstr "      --parallel=N\n         ändra antalet samtidiga sorteringskörningar till N\n"

#. from tp:coreutils-9.10-pre1
msgid "  -u, --unique\n         output only the first of lines with equal keys;\n         with -c, check for strict ordering\n"
msgstr "  -u, --unique\n         skriv ut endast den första av rader med likadana nycklar;\n         med -c, kontrollera strikt ordningsföljd\n"

#. from tp:coreutils-9.10-pre1
msgid "\nKEYDEF is F[.C][OPTS][,F[.C][OPTS]] for start and stop position, where F is a\nfield number and C a character position in the field; both are origin 1, and\nthe stop position defaults to the line's end.  If neither -t nor -b is in\neffect, characters in a field are counted from the beginning of the preceding\nwhitespace.  OPTS is one or more single-letter ordering options [bdfgiMhnRrV],\nwhich override global ordering options for that key.  If no key is given, use\nthe entire line as the key.  Use --debug to diagnose incorrect key usage.\n\nSIZE may be followed by the following multiplicative suffixes:\n"
msgstr "\nNYCKELDEF är F[.C][FLGR][,F[.C][FLGR]] för start- och slutposition, där F är ett\nfältnummer och C en teckenposition inom fältet; båda börjar på 1, och som\nstandard är slutpositionen radens slut.   Om vare sig -t eller -b är på\nräknas tecken i fältet från början av föregående blanktecken.  FLGR är\nen eller flera sorteringsflaggor med en bokstav [bdfgiMhnRrV], vilka ersätter\nglobala sorteringsflaggor för den nyckeln.  Om ingen nyckel är angiven, använd\nhela raden som nyckel.  Använd --debug för att diagnostisera felaktigt\nanvändande av nycklar.\n\nSTORLEK kan följas av följande multiplikativa ändelser:\n"

#. from tp:coreutils-9.10-pre1
msgid "% 1% of memory, b 1, K 1024 (default), and so on for M, G, T, P, E, Z, Y, R, Q.\n\n*** WARNING ***\nThe locale specified by the environment affects sort order.\nSet LC_ALL=C to get the traditional sort order that uses\nnative byte values.\n"
msgstr "% 1 % av minnet, b 1, K 1024 (standard), och så vidare för M, G, T, P, E, Z, Y, R, Q.\n\n*** VARNING ***\nLokalen som är angiven i miljön påverkar sorteringsordning.\nSätt LC_ALL=C för att få traditionell sorteringsordning som använder\nde underliggande bytevärdena.\n"

#. from tp:coreutils-9.10-pre1
msgid "waiting for %s [-d]"
msgstr "väntar på %s [-d]"

#. from tp:coreutils-9.10-pre1
msgid "%s [-d] terminated abnormally"
msgstr "%s [-d] avslutades onormalt"

#. from tp:coreutils-9.10-pre1
