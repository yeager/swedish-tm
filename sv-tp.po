msgstr "RTPRIO"

#. from tp:procps-ng-man-4.0.6rc1
msgid "realtime priority."
msgstr "realtidsprioritet."

#. from tp:procps-ng-man-4.0.6rc1
msgid "ruid"
msgstr "ruid"

