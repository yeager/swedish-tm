msgid "Failed to set device segments for next reencryption hotzone."
msgstr "Misslyckades med att ställa in enhetssegment för nästa varmzon i omkrypteringen."

#. from tp:cryptsetup-2.8.2-rc0
msgid "Failed to write reencryption resilience metadata."
msgstr "Misslyckades med att skriva metadata för omkrypteringens återhämtningsskydd."

#. from tp:cryptsetup-2.8.2-rc0
msgid "Decryption failed."
msgstr "Dekryptering misslyckades."

#. from tp:cryptsetup-2.8.2-rc0
msgid "Failed to write hotzone area starting at %<PRIu64>."
msgstr "Misslyckades med att skriva område för varmzon med början vid %<PRIu64>."

#. from tp:cryptsetup-2.8.2-rc0
msgid "Failed to sync data."
msgstr "Misslyckades med att synkronisera data."

