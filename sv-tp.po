msgstr "Kör Scheme"

#. from tp:denemo-2.6-rc2
msgid "Execute the scheme code from the scripting window"
msgstr "Kör Scheme-koden från skriptfönstret"

#. from tp:denemo-2.6-rc2
msgid "Menu:\nCreating, saving, loading, exporting, importing, typesetting and printing musical scores"
msgstr "Meny:\nSkapa, spara, ladda, exportera, importera, sätta och skriva ut musikpartitur"

#. from tp:denemo-2.6-rc2
