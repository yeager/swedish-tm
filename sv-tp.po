msgid "  -I R                         same as --replace=R\n"
msgstr "  -I E                         samma som --replace=E\n"

#. from tp:findutils-4.9.0
msgid "  -i, --replace[=R]            replace R in INITIAL-ARGS with names read\n                                 from standard input, split at newlines;\n                                 if R is unspecified, assume {}\n"
msgstr "  -i, --replace[=E]            ersätt E i STARTARGUMENT med namn lästa från\n                                 standardindata, uppdelade vid nyrader;\n                                 om E inte anges används {}\n"

