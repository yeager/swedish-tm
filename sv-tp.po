msgid "Show if at end of line"
msgstr "Visa om i slutet av raden"

#. from tp:denemo-2.6-rc2
msgid "Show if at start of line"
msgstr "Visa om i början av raden"

#. from tp:denemo-2.6-rc2
msgid "Standalone Coda (for barlines)"
msgstr "Standalone Coda (för barlines)"

#. from tp:denemo-2.6-rc2
msgid "Coda symbol attached to the net object, for example a barline. But shown between notes."
msgstr "Coda-symbol kopplad till nätobjektet, t.ex. en taktstreck. Men visas mellan noterna."

#. from tp:denemo-2.6-rc2
msgid "(Print) Standalone Fermata (for Barlines)"
msgstr "(Skriv ut) Standalone Fermata (för Barlines)"

#. from tp:denemo-2.6-rc2
msgid "Adds a standalone fermata which has no playback effect. Can be used to place a Fermata on a barline."
msgstr "Lägger till en fristående fermata som inte har någon playback-effekt. Kan användas för att placera en Fermata på en taktstreck."

