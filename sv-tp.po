#. from tp:gettext-tools-1.0-pre2
msgid "  -l, --locale=LL_CC[.ENCODING]  set target locale\n"
msgstr "  -l, --locale=LL_CC[.KODNING]   sätt mållokal\n"

#. from tp:gettext-tools-1.0-pre2
