msgstr "det går inte att skapa en temporärfil i %s"

#. from tp:coreutils-9.10-pre1
msgid "open failed"
msgstr "misslyckades med att öppna"

#. from tp:coreutils-9.10-pre1
msgid "fflush failed"
msgstr "fflush misslyckades"

#. from tp:coreutils-9.10-pre1
msgid "close failed"
msgstr "misslyckades med att stänga"

#. from tp:coreutils-9.10-pre1
msgid "could not run compress program %s"
msgstr "kunde inte köra komprimeringsprogrammet %s"

#. from tp:coreutils-9.10-pre1
msgid "couldn't create temporary file"
msgstr "det går inte att skapa temporärfil"

#. from tp:coreutils-9.10-pre1
msgid "could not run compress program %s -d"
msgstr "kunde inte köra komprimeringsprogrammet %s -d"

#. from tp:coreutils-9.10-pre1
msgid "warning: cannot remove: %s"
msgstr "varning: kan inte ta bort: %s"

#. from tp:coreutils-9.10-pre1
msgid "invalid --%s argument %s"
msgstr "felaktigt argument %2$s till --%1$s"

#. from tp:coreutils-9.10-pre1
msgid "minimum --%s argument is %s"
msgstr "minsta argument till --%s är %s"

#. from tp:coreutils-9.10-pre1
msgid "--%s argument %s too large"
msgstr "argument %2$s till --%1$s är för stort"

#. from tp:coreutils-9.10-pre1
msgid "maximum --%s argument with current rlimit is %u"
msgstr "maximalt argument till --%s vid aktuell rlimit är %u"

#. from tp:coreutils-9.10-pre1
msgid "number in parallel must be nonzero"
msgstr "antalet parallella sorteringar måste vara skilt från noll"

