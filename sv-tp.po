msgid "  -e, --eof[=END]              equivalent to -E END if END is specified;\n                                 otherwise, there is no end-of-file string\n"
msgstr "  -e, --eof[=SLUT]             detsamma som -E SLUT om SLUT anges;\n                                 annars så finns det ingen filslutssträng\n"

