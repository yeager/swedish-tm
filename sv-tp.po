#. from tp:coreutils-9.10-pre1
msgid "Print or check %s checksums.\n"
msgstr "Skriv eller kontrollera %s-kontrollsummor.\n"

#. from tp:coreutils-9.10-pre1
msgid "Legacy interface to the cksum utility.\n"
msgstr "Gammant gränssnitt till verktyget cksum.\n"

#. from tp:coreutils-9.10-pre1
msgid "Print or verify checksums.\nBy default use the 32 bit CRC algorithm.\n"
msgstr "Skriv ut eller verifiera kontrollsummor.\nSom standard används algoritmen 32-bitars CRC.\n"

#. from tp:coreutils-9.10-pre1
msgid "Print or check %s (%d-bit) checksums.\n"
msgstr "Skriv eller kontrollera %s (%d-bitars) kontrollsummor.\n"

#. from tp:coreutils-9.10-pre1
msgid "  -r\n         use BSD sum algorithm (the default), use 1K blocks\n"
msgstr "  -r\n         använd BSD:s summeringsalgoritm (standard), använd block om 1 KiB\n"

#. from tp:coreutils-9.10-pre1
msgid "  -s, --sysv\n         use System V sum algorithm, use 512 bytes blocks\n"
msgstr "  -s, --sysv\n         använd System V:s summeringsalgoritm, använd 512-byteblock\n"

#. from tp:coreutils-9.10-pre1
msgid "  -a, --algorithm=TYPE\n         select the digest type to use.  See DIGEST below\n"
msgstr "  -a, --algorithm=TYP\n         välj kontrollsummetyp att använda. Se KONTROLLSUMMA nedan\n"

#. from tp:coreutils-9.10-pre1
msgid "      --base64\n         emit base64-encoded digests, not hexadecimal\n"
msgstr "      --base64\n         avge base64-kodade kontrollsummor, inte hexadecimala\n"

#. from tp:coreutils-9.10-pre1
msgid "  -b, --binary\n         read in binary mode (default unless reading tty stdin)\n"
msgstr "  -b, --binary\n         läs i binärt läge (standard om inte standard in från tty läses)\n"

#. from tp:coreutils-9.10-pre1
msgid "  -b, --binary\n         read in binary mode\n"
msgstr "  -b, --binary\n         läs i binärt läge\n"

#. from tp:coreutils-9.10-pre1
msgid "  -c, --check\n         read checksums from the FILEs and check them\n"
msgstr "  -c, --check\n         läs kontrollsummor från FILerna och kontrollera dem\n"

#. from tp:coreutils-9.10-pre1
msgid "  -l, --length=BITS\n         digest length in bits; must not exceed the max size\n         and must be a multiple of 8 for blake2b;\n         must be 224, 256, 384, or 512 for sha2 or sha3\n"
msgstr "  -l, --length=BITAR\n         kontrollsummelängd i bitar; får inte överskrida den maximala\n         storleken och måste vara en multipel av 8 för\n         blake2b; måste vara 224, 256, 384 eller 512 för sha2 eller sha3\n"

#. from tp:coreutils-9.10-pre1
msgid "      --raw\n         emit a raw binary digest, not hexadecimal\n"
msgstr "      --raw\n         mata ut en rå binär kontrollsumma, inte hexadecimal\n"

#. from tp:coreutils-9.10-pre1
msgid "      --tag\n         create a BSD-style checksum\n"
msgstr "      --tag\n         skapa en kontrollsumma i BSD-stil\n"

#. from tp:coreutils-9.10-pre1
msgid "      --tag\n         create a BSD-style checksum (the default)\n"
msgstr "      --tag\n         skapa en kontrollsumma i BSD-stil (standard)\n"

#. from tp:coreutils-9.10-pre1
msgid "      --untagged\n         create a reversed style checksum, without digest type\n"
msgstr "      --untagged\n         skapa en kontrollsumma i omvänd stil, utan kontrollsummetyp\n"

#. from tp:coreutils-9.10-pre1
msgid "  -t, --text\n         read in text mode (default if reading tty stdin)\n"
msgstr "  -t, --text\n         läs i textläge (standard om standard in från tty läses)\n"

#. from tp:coreutils-9.10-pre1
msgid "  -t, --text\n         read in text mode (default)\n"
msgstr "  -t, --text\n         läs i textläge (standard)\n"

#. from tp:coreutils-9.10-pre1
msgid "  -z, --zero\n         end each output line with NUL, not newline,\n         and disable file name escaping\n"
msgstr "  -z, --zero\n         avsluta varje utmatad rad med NUL, inte nyrad,\n         och återge filnamn utan escape-sekvenser\n"

#. from tp:coreutils-9.10-pre1
msgid "\nThe following five options are useful only when verifying checksums:\n"
msgstr "\nDe fem följande flaggorna är användbara enbart vid verifikation av\nkontrollsummor:\n"

#. from tp:coreutils-9.10-pre1
msgid "      --ignore-missing\n         don't fail or report status for missing files\n"
msgstr "      --ignore-missing\n         ge inget fel och rapportera ingen status för saknade filer\n"

#. from tp:coreutils-9.10-pre1
msgid "      --quiet\n         don't print OK for each successfully verified file\n"
msgstr "      --quiet\n         skriv inte OK för varje verifierad fil\n"

#. from tp:coreutils-9.10-pre1
msgid "      --status\n         don't output anything, status code shows success\n"
msgstr "      --status\n         skriv inte ut något, statuskoden visar resultatet\n"

#. from tp:coreutils-9.10-pre1
msgid "      --strict\n         exit non-zero for improperly formatted checksum lines\n"
msgstr "      --strict\n         returnera nollskilt vid felformaterade kontrollsummerader\n"

#. from tp:coreutils-9.10-pre1
msgid "  -w, --warn\n         warn about improperly formatted checksum lines\n"
msgstr "  -w, --warn\n         varna för felaktigt formaterade kontrollsummerader\n"

#. from tp:coreutils-9.10-pre1
msgid "      --debug\n         indicate which implementation used\n"
msgstr "      --debug\n         indikera vilken implementation som används\n"

#. from tp:coreutils-9.10-pre1
msgid "\nDIGEST determines the digest algorithm and default output format:\n  sysv      (equivalent to sum -s)\n  bsd       (equivalent to sum -r)\n  crc       (equivalent to cksum)\n  crc32b    (only available through cksum)\n  md5       (equivalent to md5sum)\n  sha1      (equivalent to sha1sum)\n  sha2      (equivalent to sha{224,256,384,512}sum)\n  sha3      (only available through cksum)\n  blake2b   (equivalent to b2sum)\n  sm3       (only available through cksum)\n\n"
msgstr "\nKONTROLLSUMMA styr kontrollsummealgoritmen och standardutmatningsformatet:\n  sysv      (likvärdigt med sum -s)\n  bsd       (likvärdigt med sum -r)\n  crc       (likvärdigt med cksum)\n  crc32b    (endast tillgängligt via cksum)\n  md5       (likvärdigt med md5sum)\n  sha1      (likvärdigt med sha1sum)\n  sha2      (likvärdigt med sha{224,256,384,512}sum)\n  sha3      (endast tillgängligt via cksum)\n  blake2b   (likvärdigt med b2sum)\n  sm3       (endast tillgängligt genom cksum)\n\n"

#. from tp:coreutils-9.10-pre1
msgid "\nThe sums are computed as described in %s.\n"
msgstr "\nSummorna beräknas som beskrivs i %s.\n"

#. from tp:coreutils-9.10-pre1
msgid "When checking, the input should be a former output of this program.\nThe default mode is to print a line with: checksum, a space,\na character indicating input mode ('*' for binary, ' ' for text\nor where binary is insignificant), and name for each FILE.\n\nThere is no difference between binary mode and text mode on GNU systems.\n"
msgstr "Vid kontroll skall indata vara en tidigare utdata från detta program.\nNormalläget är att skriva en rad med: kontrollsumma, ett mellanslag,\nett tecken som indikerar indataläge (”*” för binärt, ” ” för text eller\ndär binärläge är betydelselöst) och namnet på varje FIL.\n\nDet är ingen skillnad mellan binärt läge och textläge på GNU-system.\n"

#. from tp:coreutils-9.10-pre1
msgid "When checking, the input should be a former output of this program,\nor equivalent standalone program.\n"
msgstr "Vid kontroll ska indata vara utdata som tidigare skapats av detta program\neller av ett motsvarande fristående program.\n"

#. from tp:coreutils-9.10-pre1
msgid "standard input"
msgstr "standard in"

#. from tp:coreutils-9.10-pre1
msgid "%s: too many checksum lines"
msgstr "%s: för många kontrollsummerader"

#. from tp:coreutils-9.10-pre1
msgid "%s: %ju: improperly formatted %s checksum line"
msgstr "%s: %ju: felaktigt formaterad %s-kontrollsummerad"

#. from tp:coreutils-9.10-pre1
msgid "FAILED open or read"
msgstr "MISSLYCKADES att öppna eller läsa"

#. from tp:coreutils-9.10-pre1
msgid "FAILED"
msgstr "MISSLYCKADES"

#. from tp:coreutils-9.10-pre1
msgid "%s: no properly formatted checksum lines found"
msgstr "%s: inga korrekt formaterade kontrollsummerader funna"

#. from tp:coreutils-9.10-pre1
msgid "%s: no file was verified"
msgstr "%s: ingen fil har verifierats"

#. from tp:coreutils-9.10-pre1
msgid "invalid length"
msgstr "felaktig längd"

#. from tp:coreutils-9.10-pre1
msgid "--length is only supported with --algorithm blake2b, sha2, or sha3"
msgstr "--length stödjs endast med --algorithm blake2b, sha2 eller sha3"

#. from tp:coreutils-9.10-pre1
msgid "--algorithm=%s requires specifying --length 224, 256, 384, or 512"
msgstr "--algorithm=%s kräver att man anger --length 224, 256, 384 eller 512"

#. from tp:coreutils-9.10-pre1
msgid "invalid length: %s"
msgstr "felaktig längd: %s"

#. from tp:coreutils-9.10-pre1
msgid "digest length for %s must be 224, 256, 384, or 512"
msgstr "kontrollsummelängden för %s måste vara 224, 256, 384 eller 512"

#. from tp:coreutils-9.10-pre1
msgid "maximum digest length for %s is %d bits"
msgstr "maximala kontrollsummelängden för %s är %d bitar"

#. from tp:coreutils-9.10-pre1
msgid "length is not a multiple of 8"
msgstr "längden är inte en multipel av 8"

#. from tp:coreutils-9.10-pre1
msgid "--check is not supported with --algorithm={bsd,sysv,crc,crc32b}"
msgstr "--check stödjs inte med --algorithm={bsd,sysv,crc,crc32b}"

#. from tp:coreutils-9.10-pre1
msgid "--base64 and --raw are mutually exclusive"
msgstr "--base64 och --raw är ömsesidigt uteslutande"

#. from tp:coreutils-9.10-pre1
msgid "the --zero option is not supported when verifying checksums"
msgstr "flaggan --zero stödjs inte när kontrollsummor verifieras"

#. from tp:coreutils-9.10-pre1
msgid "the --tag option is meaningless when verifying checksums"
msgstr "flaggan --tag är meningslös när kontrollsummor verifieras"

#. from tp:coreutils-9.10-pre1
msgid "the --binary and --text options are meaningless when verifying checksums"
msgstr "flaggorna --binary och --text är meningslösa när kontrollsummor verifieras"

#. from tp:coreutils-9.10-pre1
msgid "the --ignore-missing option is meaningful only when verifying checksums"
msgstr "flaggan --ignore-missing är meningsfull enbart när kontrollsummor verifieras"

#. from tp:coreutils-9.10-pre1
msgid "the --status option is meaningful only when verifying checksums"
msgstr "flaggan --status är meningsfull enbart när kontrollsummor verifieras"

#. from tp:coreutils-9.10-pre1
msgid "the --warn option is meaningful only when verifying checksums"
msgstr "flaggan --warn är meningsfull enbart när kontrollsummor verifieras"

#. from tp:coreutils-9.10-pre1
msgid "the --quiet option is meaningful only when verifying checksums"
msgstr "flaggan --quiet är meningsfull enbart när kontrollsummor verifieras"

#. from tp:coreutils-9.10-pre1
