msgid "      --esmtpname   override identity used for SMTP AUTH (default: user's name)"
msgstr "      --esmtpname   åsidosätt identiteten för SMTP AUTH (standard: användarens namn)"

#. from tp:fetchmail-6.6.0.rc3
msgid "      --esmtppassword\n"
msgstr "      --esmtppassword\n"

#. from tp:fetchmail-6.6.0.rc3
msgid "			   set secret (password) for SMTP AUTH"
msgstr "\t\t\t   ange hemlighet (lösenord) för SMTP AUTH"

#. from tp:fetchmail-6.6.0.rc3
msgid "  -Z, --antispam    set antispam response values\n"
msgstr "  -Z, --antispam    ange svarsvärden för skräppostskydd\n"

#. from tp:fetchmail-6.6.0.rc3
msgid "  -b, --batchlimit  set batch limit for SMTP connections\n"
msgstr "  -b, --batchlimit  ange batchgräns för SMTP-anslutningar\n"

