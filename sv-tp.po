msgstr "Oggbitströmmen innehåller inte Vorbisdata."

#. from tp:vorbis-tools-1.4.3
msgid "EOF before recognised stream."
msgstr "Filslut före någon igenkänd ström."

#. from tp:vorbis-tools-1.4.3
