#. from tp:coreutils-9.10-pre1
msgid "Usage: %s [OPTION]... [-T] SOURCE DEST\n  or:  %s [OPTION]... SOURCE... DIRECTORY\n  or:  %s [OPTION]... -t DIRECTORY SOURCE...\n  or:  %s [OPTION]... -d DIRECTORY...\n"
msgstr "Användning: %s [FLAGGA]... [-T] KÄLLA DEST\n   eller:   %s [FLAGGA]... KÄLLA... KATALOG\n   eller:   %s [FLAGGA]... -t KATALOG KÄLLA...\n   eller:   %s [FLAGGA]... -d KATALOG...\n"

#. from tp:coreutils-9.10-pre1
msgid "\nThis install program copies files (often just compiled) into destination\nlocations you choose.  If you want to download and install a ready-to-use\npackage on a GNU/Linux system, you should instead be using a package manager\nlike yum(1) or apt-get(1).\n\nIn the first three forms, copy SOURCE to DEST or multiple SOURCE(s) to\nthe existing DIRECTORY, while setting permission modes and owner/group.\nIn the 4th form, create all components of the given DIRECTORY(ies).\n"
msgstr "\nDetta installationsprogram kopierar filer (oftast nykompilerade) till\ndestinationsplatser du väljer.  Om du vill hämta och installera ett\npaket som är färdigt att använda på ett GNU/Linux-system bör du istället\nanvända en pakethanterare som yum(1) eller apt-get(1).\n\nDe första tre formaten kopierar KÄLLA till DEST eller flera KÄLLor till\nen befintlig KATALOG, samtidigt som rättigheter och ägare/grupp sätts.\nDet fjärde formatet skapar KATALOG(er) inklusive eventuella föräldrakataloger.\n"

#. from tp:coreutils-9.10-pre1
msgid "  -c\n         (ignored)\n"
msgstr "  -c\n         (ignoreras)\n"

#. from tp:coreutils-9.10-pre1
msgid "  -C, --compare\n         compare content of source and destination files,\n         and if no change to content, ownership, and permissions,\n         do not modify the destination at all\n"
msgstr "  -C, --compare\n         jämför innehållet i käll- och målfiler, och om innehållet,\n         ägarskapet och rättigheterna inte skiljer sig, ändra då inte\n         målet alls\n"

#. from tp:coreutils-9.10-pre1
msgid "  -d, --directory\n         treat all arguments as directory names;\n         create all components of the specified directories\n"
msgstr "  -d, --directory\n         betrakta alla argument som kataloger;\n         skapa de angivna katalogernas alla komponenter\n"

#. from tp:coreutils-9.10-pre1
msgid "  -D\n         create all leading components of DEST except the last,\n         or all components of --target-directory,\n         then copy SOURCE to DEST\n"
msgstr "  -D\n         skapa alla komponenter i DEST utom den sista;\n         eller alla komponenter av --target-directory,\n         kopiera sedan KÄLLA till DEST\n"

#. from tp:coreutils-9.10-pre1
msgid "  -g, --group=GROUP\n         set group ownership, instead of process' current group\n"
msgstr "  -g, --group=GRUPP\n         sätt grupptillhörighet, istället för processens grupp\n"

#. from tp:coreutils-9.10-pre1
msgid "  -m, --mode=MODE\n         set permission mode (as in chmod), instead of rwxr-xr-x\n"
msgstr "  -m, --mode=RÄTTIGHET\n         sätt rättigheter (som för chmod), istället för rwxr-xr-x\n"

#. from tp:coreutils-9.10-pre1
msgid "  -o, --owner=OWNER\n         set ownership (super-user only)\n"
msgstr "  -o, --owner=ÄGARE\n         sätt ägare (endast superanvändare)\n"

#. from tp:coreutils-9.10-pre1
msgid "  -p, --preserve-timestamps\n         apply access/modification times of SOURCE files\n         to corresponding destination files\n"
msgstr "  -p, --preserve-timestamps\n         sätt KÄLLors åtkomst- och modifikationstid på\n         motsvarande målfiler\n"

#. from tp:coreutils-9.10-pre1
msgid "  -s, --strip\n         strip symbol tables\n"
msgstr "  -s, --strip\n         ta bort symboltabeller\n"

#. from tp:coreutils-9.10-pre1
msgid "      --strip-program=PROGRAM\n         program used to strip binaries\n"
msgstr "      --strip-program=PROGRAM\n         program att använda för att ta bort symboltabeller\n"

#. from tp:coreutils-9.10-pre1
msgid "  -v, --verbose\n         print the name of each created file or directory\n"
msgstr "  -v, --verbose\n         skriv namnet på varje skapad fil eller katalog\n"

#. from tp:coreutils-9.10-pre1
msgid "      --preserve-context\n         preserve SELinux security context\n"
msgstr "      --preserve-context\n         bevara SELinux-säkerhetskontext\n"

#. from tp:coreutils-9.10-pre1
msgid "  -Z\n         set SELinux security context of destination file\n         and each created directory, to default type\n"
msgstr "  -Z\n         sätt SELinux-säkerhetskontext på målfilen\n         och varje skapad katalog till standardtypen\n"

#. from tp:coreutils-9.10-pre1
msgid "cannot unlink %s"
msgstr "kan inte ta bort %s"

#. from tp:coreutils-9.10-pre1
msgid "cannot open %s"
msgstr "kan inte öppna %s"

#. from tp:coreutils-9.10-pre1
msgid "WARNING: ignoring --preserve-context; this kernel is not SELinux-enabled"
msgstr "VARNING: ignorerar --preserve-context; denna kärna har inte SELinux."

#. from tp:coreutils-9.10-pre1
msgid "the strip option may not be used when installing a directory"
msgstr "strip-flaggan kan inte användas vid installation av en katalog"

#. from tp:coreutils-9.10-pre1
msgid "target directory not allowed when installing a directory"
msgstr "målkatalog kan inte användas vid installation av en katalog"

#. from tp:coreutils-9.10-pre1
msgid "failed to access %s"
msgstr "misslyckades med att komma åt %s"

#. from tp:coreutils-9.10-pre1
msgid "invalid mode %s"
msgstr "ogiltig rättighet %s"

#. from tp:coreutils-9.10-pre1
msgid "WARNING: ignoring --strip-program option as -s option was not specified"
msgstr "VARNING: ignorerar flaggan --strip-program eftersom flaggan -s inte angavs"

#. from tp:coreutils-9.10-pre1
msgid "options --compare (-C) and --preserve-timestamps are mutually exclusive"
msgstr "flaggorna --compare (-C) och --preserve-timestamps är ömsesidigt uteslutande"

#. from tp:coreutils-9.10-pre1
msgid "options --compare (-C) and --strip are mutually exclusive"
msgstr "flaggorna --compare (-C) och --strip är ömsesidigt uteslutande"

#. from tp:coreutils-9.10-pre1
msgid "the --compare (-C) option is ignored when you specify a mode with non-permission bits"
msgstr "flaggan --compare (-C) ignoreras när du anger ett läge med andra bitar än rättighetsbitar"

#. from tp:coreutils-9.10-pre1
msgid "Mike Haertel"
msgstr "Mike Haertel"

#. from tp:coreutils-9.10-pre1
msgid "For each pair of input lines with identical join fields, write a line to\nstandard output.  The default join field is the first, delimited by blanks.\n"
msgstr "För varje par av inmatade rader med identiska föreningsfält, skriv en rad till\nstandard ut.  Standard för föreningsfält är det första, avgränsat av blanktecken.\n"

#. from tp:coreutils-9.10-pre1
msgid "  -a FILENUM\n         also print unpairable lines from file FILENUM,\n         where FILENUM is 1 or 2, corresponding to FILE1 or FILE2\n"
msgstr "  -a FILNUM\n         skriv även omatchade rader från fil FILNUM,\n         där FILNUM är 1 eller 2, motsvarande FIL1 eller FIL2\n"

#. from tp:coreutils-9.10-pre1
msgid "  -e STRING\n         replace missing (empty) input fields with STRING;\n         I.e., missing fields specified with '-12jo' options\n"
msgstr "  -e STRÄNG\n      ersätt saknade (tomma) indatafält med STRÄNG;\n      d.v.s., saknade fält angivna med flaggor som ”-12jo”\n"

#. from tp:coreutils-9.10-pre1
msgid "  -i, --ignore-case\n         ignore differences in case when comparing fields\n"
msgstr "  -i, --ignore-case\n         ignorera skiftläge när fält jämförs\n"

#. from tp:coreutils-9.10-pre1
msgid "  -j FIELD\n         equivalent to '-1 FIELD -2 FIELD'\n"
msgstr "  -j FÄLT\n      samma som ”-1 FÄLT -2 FÄLT”\n"

#. from tp:coreutils-9.10-pre1
msgid "  -o FORMAT\n         obey FORMAT while constructing output line\n"
msgstr "  -o FORMAT\n         följ FORMAT när utskriftsrader konstrueras\n"

#. from tp:coreutils-9.10-pre1
msgid "  -t CHAR\n         use CHAR as input and output field separator\n"
msgstr "  -t TECKEN\n         använd TECKEN som fältseparator för in- och utmatning\n"

#. from tp:coreutils-9.10-pre1
msgid "  -v FILENUM\n         like -a FILENUM, but suppress joined output lines\n"
msgstr "  -v FILNUM\n         som -a FILNUM, men undertrycker förenade utmatade rader\n"

#. from tp:coreutils-9.10-pre1
msgid "  -1 FIELD\n         join on this FIELD of file 1\n"
msgstr "  -1 FÄLT\n         förena med detta FÄLT i fil 1\n"

#. from tp:coreutils-9.10-pre1
msgid "  -2 FIELD\n         join on this FIELD of file 2\n"
msgstr "  -2 FÄLT\n         förena med detta FÄLT i fil 2\n"

#. from tp:coreutils-9.10-pre1
msgid "      --check-order\n         check that the input is correctly sorted, even\n         if all input lines are pairable\n"
msgstr "      --check-order\n         kontrollera att indata är korrekt sorterade, även om\n         alla indatarader går att para ihop\n"

#. from tp:coreutils-9.10-pre1
msgid "      --header\n         treat the first line in each file as field headers,\n         print them without trying to pair them\n"
msgstr "      --header\n         hantera första raden i varje fil som fältrubriker,\n         skriv dem utan att försöka att para ihop dem\n"

#. from tp:coreutils-9.10-pre1
msgid "\nUnless -t CHAR is given, leading blanks separate fields and are ignored,\nelse fields are separated by CHAR.  Any FIELD is a field number counted\nfrom 1.  FORMAT is one or more comma or blank separated specifications,\neach being 'FILENUM.FIELD' or '0'.  Default FORMAT outputs the join field,\nthe remaining fields from FILE1, the remaining fields from FILE2, all\nseparated by CHAR.  If FORMAT is the keyword 'auto', then the first\nline of each file determines the number of fields output for each line.\n\nImportant: FILE1 and FILE2 must be sorted on the join fields.\nE.g., use \"sort -k 1b,1\" if 'join' has no options,\nor use \"join -t ''\" if 'sort' has no options.\nComparisons honor the rules specified by 'LC_COLLATE'.\nIf the input is not sorted and some lines cannot be joined, a\nwarning message will be given.\n"
msgstr "\nOm inte -t TECKEN är givet separeras fält av inledande mellanslag\nsom ignoreras, annars separeras fält av TECKEN.  Varje FÄLT är ett\nfältnummer räknat från 1.  FORMAT är en eller flera specifikationer\nåtskilda med komma eller mellanslag, var och en är ”FILNUM.FÄLT”\neller ”0”.  Normalvärdet för FORMAT skriver ut föreningsfältet, de\nkvarvarande fälten från FIL1, de kvarvarande fälten från FIL2, allt\nseparerat med TECKEN.  Om FORMAT är nyckelordet ”auto” avgör första\nraden av varje fil antalet fält som skrivs ut för varje rad.\n\nViktigt: FIL1 och FIL2 måste vara sorterade på föreningsfälten.\nT.ex., använd ”sort -k 1b,1” om ”join” inte har några flaggor,\neller använd ”join -t ''” om ”sort” inte har några flaggor.\nJämförelser tar hänsyn till reglerna som anges av ”LC_COLLATE”.\nOm indata inte är sorterade och några rader inte kan förenas, ges ett\nvarningsmeddelande.\n"

#. from tp:coreutils-9.10-pre1
msgid "%s:%ju: is not sorted: %.*s"
msgstr "%s:%ju: är inte sorterad: %.*s"

#. from tp:coreutils-9.10-pre1
msgid "invalid field number: %s"
msgstr "felaktigt fältnummer: %s"

#. from tp:coreutils-9.10-pre1
msgid "invalid field specifier: %s"
msgstr "felaktig fältspecifikation: %s"

#. from tp:coreutils-9.10-pre1
msgid "invalid file number in field spec: %s"
msgstr "felaktigt filnummer i fältspec: %s"

#. from tp:coreutils-9.10-pre1
msgid "incompatible join fields %td, %td"
msgstr "inkompatibla föreningsfält %td, %td"

#. from tp:coreutils-9.10-pre1
msgid "invalid file number: %s"
msgstr "felaktigt filnummer: %s"

#. from tp:coreutils-9.10-pre1
msgid "conflicting empty-field replacement strings"
msgstr "motsägelsefulla ersättningssträngar för tomma fält"

#. from tp:coreutils-9.10-pre1
msgid "multi-character tab %s"
msgstr "avgränsaren %s består av flera tecken"

#. from tp:coreutils-9.10-pre1
msgid "incompatible tabs"
msgstr "inkompatibla avgränsare"

#. from tp:coreutils-9.10-pre1
msgid "both files cannot be standard input"
msgstr "båda filerna kan inte vara standard in"

#. from tp:coreutils-9.10-pre1
msgid "Usage: %s [-s SIGNAL | -SIGNAL] PID...\n  or:  %s -l [SIGNAL]...\n  or:  %s -t [SIGNAL]...\n"
msgstr "Användning: %s [-s SIGNAL | -SIGNAL] PID...\n   eller:   %s -l [SIGNAL]...\n   eller:   %s -t [SIGNAL]...\n"

#. from tp:coreutils-9.10-pre1
msgid "Send signals to processes, or list signals.\n"
msgstr "Skickar signaler till processer, eller räknar upp signaler.\n"

#. from tp:coreutils-9.10-pre1
msgid "  -s, --signal=SIGNAL, -SIGNAL\n         specify the name or number of the signal to be sent\n"
msgstr "  -s, --signal=SIGNAL, -SIGNAL\n         ange namnet eller numret på signalen som skall skickas\n"

#. from tp:coreutils-9.10-pre1
msgid "  -l, --list\n         list signal names, or convert signal names to/from numbers\n"
msgstr "  -l, --list\n         räkna upp signalnamn, eller konvertera signalnamn till/från\n         nummer\n"

#. from tp:coreutils-9.10-pre1
msgid "  -t, --table\n         print a table of signal information\n"
msgstr "  -t, --table\n         skriv en tabell med signalinformation\n"

#. from tp:coreutils-9.10-pre1
msgid "\nSIGNAL may be a signal name like 'HUP', or a signal number like '1',\nor the exit status of a process terminated by a signal.\nPID is an integer; if negative it identifies a process group.\n"
msgstr "\nSIGNAL kan vara ett signalnamn som ”HUP” eller ett signalnummer som\n”1”, eller en slutstatus från en process avslutad av en signal.  PID\när ett heltal; om det är negativt identifierar det en processgrupp.\n"

#. from tp:coreutils-9.10-pre1
msgid "%s: invalid process id"
msgstr "%s: ogiltigt process-id"

#. from tp:coreutils-9.10-pre1
msgid "invalid option -- %c"
msgstr "ogiltig flagga -- %c"

#. from tp:coreutils-9.10-pre1
msgid "%s: multiple signals specified"
msgstr "%s: flera signaler angivna"

#. from tp:coreutils-9.10-pre1
msgid "multiple -l or -t options specified"
msgstr "multipla -l eller -t-flaggor angivna"

#. from tp:coreutils-9.10-pre1
msgid "cannot combine signal with -l or -t"
msgstr "det går inte att kombinera signal med -l eller -t"

#. from tp:coreutils-9.10-pre1
msgid "no process ID specified"
msgstr "inget process-ID angivet"

#. from tp:coreutils-9.10-pre1
msgid "invalid buffering mode %s for %s\n"
msgstr "felaktigt buffringsläge %s för %s\n"

#. from tp:coreutils-9.10-pre1
msgid "failed to allocate a %lu byte stdio buffer\n"
msgstr "misslyckades med att allokera en %lu byte stor stdio-buffert\n"

#. from tp:coreutils-9.10-pre1
msgid "could not set buffering of %s to mode %s\n"
msgstr "kunde inte ställa in buffring av %s till läge %s\n"

#. from tp:coreutils-9.10-pre1
msgid "Michael Stone"
msgstr "Michael Stone"

#. from tp:coreutils-9.10-pre1
msgid "Usage: %s FILE1 FILE2\n  or:  %s OPTION\n"
msgstr "Användning: %s FIL1 FIL2\n    eller:  %s FLAGGA\n"

#. from tp:coreutils-9.10-pre1
msgid "Call the link function to create a link named FILE2 to an existing FILE1.\n\n"
msgstr "Anropa funktionen link för att skapa en länk som heter FIL2 till en\nbefintlig FIL1.\n\n"

#. from tp:coreutils-9.10-pre1
msgid "cannot create link %s to %s"
msgstr "kan inte skapa länk %s till %s"

#. from tp:coreutils-9.10-pre1
msgid "%s: hard link not allowed for directory"
msgstr "%s: hård länk inte tillåten för katalog"

#. from tp:coreutils-9.10-pre1
msgid "%s: cannot overwrite directory"
msgstr "%s: kan inte skriva över katalog"

#. from tp:coreutils-9.10-pre1
msgid "%s: replace %s? "
msgstr "%s: ersätt %s? "

#. from tp:coreutils-9.10-pre1
msgid "failed to create symbolic link %s"
msgstr "misslyckades med att skapa symbolisk länk %s"

#. from tp:coreutils-9.10-pre1
msgid "failed to create symbolic link %s -> %s"
msgstr "misslyckades med att skapa symbolisk länk %s → %s"

#. from tp:coreutils-9.10-pre1
msgid "failed to create hard link to %s"
msgstr "misslyckades med att skapa en hård länk till %s"

#. from tp:coreutils-9.10-pre1
msgid "failed to create hard link %s"
msgstr "misslyckades med att skapa hård länk %s"

#. from tp:coreutils-9.10-pre1
msgid "failed to create hard link %s => %s"
msgstr "misslyckades med att skapa hård länk %s ⇒ %s"

#. from tp:coreutils-9.10-pre1
msgid "Usage: %s [OPTION]... [-T] TARGET LINK_NAME\n  or:  %s [OPTION]... TARGET\n  or:  %s [OPTION]... TARGET... DIRECTORY\n  or:  %s [OPTION]... -t DIRECTORY TARGET...\n"
msgstr "Användning: %s [FLAGGA]… [-T] MÅL LÄNKNAMN\n    eller:  %s [FLAGGA]… MÅL\n    eller:  %s [FLAGGA]… MÅL… KATALOG\n    eller:  %s [FLAGGA]… -t KATALOG MÅL…\n"

#. from tp:coreutils-9.10-pre1
msgid "In the 1st form, create a link to TARGET with the name LINK_NAME.\nIn the 2nd form, create a link to TARGET in the current directory.\nIn the 3rd and 4th forms, create links to each TARGET in DIRECTORY.\nCreate hard links by default, symbolic links with --symbolic.\nBy default, each destination (name of new link) should not already exist.\nWhen creating hard links, each TARGET must exist.  Symbolic links\ncan hold arbitrary text; if later resolved, a relative link is\ninterpreted in relation to its parent directory.\n"
msgstr "I det första formatet, skapa en länk till MÅL med namnet LÄNKNAMN.\nI det andra formatet, skapa en länk till MÅL i aktuell katalog.\nI de tredje och fjärde formaten, skapa länkar till varje MÅL i KATALOG.\nSkapa hårda länkar om inget annat anges, symboliska länkar med --symbolic.\nNormalt får varje destination (namn på ny länk) inte redan finnas.\nNär hårda länkar skapas måste varje MÅL finnas.\nSymboliska länkar kan innehålla godtycklig text.  Om de senare löses\nupp tolkas en relativ länk i förhållande till sin föräldrakatalog.\n"

#. from tp:coreutils-9.10-pre1
msgid "  -d, -F, --directory\n         allow the superuser to attempt to hard link directories,\n         if supported by the system\n"
msgstr "  -d, -F, --directory\n         tillåt superanvändaren att försöka skapa hårda länkar till kataloger,\n         om det stödjs av systemet\n"

#. from tp:coreutils-9.10-pre1
msgid "  -f, --force\n         remove existing destination files\n"
msgstr "  -f, --force\n         ta bort befintliga destinationsfiler\n"

#. from tp:coreutils-9.10-pre1
msgid "  -i, --interactive\n         prompt whether to remove destinations\n"
msgstr "  -i, --interactive\n         fråga om destinationer skall tas bort\n"

#. from tp:coreutils-9.10-pre1
msgid "  -L, --logical\n         dereference TARGETs that are symbolic links\n"
msgstr "  -L, --logical\n         följ MÅL som är symboliska länkar\n"

#. from tp:coreutils-9.10-pre1
msgid "  -n, --no-dereference\n         treat LINK_NAME as a normal file\n         if it is a symbolic link to a directory\n"
msgstr "  -n, --no-dereference\n         behandla LÄNKNAMN som en normal fil\n         om det är en symbolisk länk till en katalog\n"

#. from tp:coreutils-9.10-pre1
msgid "  -P, --physical\n         make hard links directly to symbolic links\n"
msgstr "  -P, --physical\n         gör hårda länkar direkt till symboliska länkar\n"

#. from tp:coreutils-9.10-pre1
msgid "  -r, --relative\n         with -s, create links relative to link location\n"
msgstr "  -r, --relative\n         med -s, skapa länkar relativt länkpositionen\n"

#. from tp:coreutils-9.10-pre1
msgid "  -s, --symbolic\n         make symbolic links instead of hard links\n"
msgstr "  -s, --symbolic\n         gör symboliska länkar istället för hårda länkar\n"

#. from tp:coreutils-9.10-pre1
msgid "  -t, --target-directory=DIRECTORY\n         specify the DIRECTORY in which to create the links\n"
msgstr "  -t, --target-directory=KATALOG\n         ange KATALOGen i vilken länkarna skall skapas\n"

#. from tp:coreutils-9.10-pre1
msgid "  -T, --no-target-directory\n         treat LINK_NAME as a normal file always\n"
msgstr "  -T, --no-target-directory\n         behandla alltid LÄNKNAMN som en vanlig fil\n"

#. from tp:coreutils-9.10-pre1
msgid "  -v, --verbose\n         print name of each linked file\n"
msgstr "  -v, --verbose\n         skriv namnet på varje länkad fil\n"

#. from tp:coreutils-9.10-pre1
msgid "\nUsing -s ignores -L and -P.  Otherwise, the last option specified controls\nbehavior when a TARGET is a symbolic link, defaulting to %s.\n"
msgstr "\nAnvändning av -s ignorerar -L och -P.  Annars styr den sist angivna flaggan\nbeteendet när ett MÅL är en symbolisk länk, som standard %s.\n"

#. from tp:coreutils-9.10-pre1
msgid "target %s is not a directory"
msgstr "målet %s är inte en katalog"

#. from tp:coreutils-9.10-pre1
msgid "cannot do --relative without --symbolic"
msgstr "kan inte göra --relative utan --symbolic"

#. from tp:coreutils-9.10-pre1
msgid "cannot combine --target-directory and --no-target-directory"
msgstr "det går inte att kombinera --target-directory och --no-target-directory"

#. from tp:coreutils-9.10-pre1
msgid "Usage: %s [OPTION]\n"
msgstr "Användning: %s [FLAGGA]\n"

#. from tp:coreutils-9.10-pre1
msgid "Print the user's login name.\n\n"
msgstr "Skriv ut användarens inloggningsnamn.\n\n"

#. from tp:coreutils-9.10-pre1
msgid "no login name"
msgstr "inget inloggningsnamn"

#. from tp:coreutils-9.10-pre1
msgid "%b %e  %Y"
msgstr "%e %b  %Y"

#. from tp:coreutils-9.10-pre1
msgid "%b %e %H:%M"
msgstr "%e %b %H.%M"

#. from tp:coreutils-9.10-pre1
msgid "invalid line width"
msgstr "felaktig radlängd"

#. from tp:coreutils-9.10-pre1
msgid "invalid tab size"
msgstr "felaktigt tabulatorsteg"

#. from tp:coreutils-9.10-pre1
msgid "ignoring invalid width in environment variable COLUMNS: %s"
msgstr "ignorerar felaktig bredd i miljövariabeln COLUMNS: %s"

#. from tp:coreutils-9.10-pre1
msgid "ignoring invalid tab size in environment variable TABSIZE: %s"
msgstr "ignorerar felaktigt tabulatorsteg i miljövariabeln TABSIZE: %s"

#. from tp:coreutils-9.10-pre1
msgid "--dired and --zero are incompatible"
msgstr "--dired och --zero är inkompatibla"

#. from tp:coreutils-9.10-pre1
msgid "invalid time style format %s"
msgstr "felaktigt tidsstilsformat %s"

#. from tp:coreutils-9.10-pre1
msgid "unrecognized prefix: %s"
msgstr "okänt prefix: %s"

#. from tp:coreutils-9.10-pre1
msgid "unparsable value for LS_COLORS environment variable"
msgstr "obegripligt värde på LS_COLORS-miljövariabeln"

#. from tp:coreutils-9.10-pre1
msgid "ignoring invalid value of environment variable QUOTING_STYLE: %s"
msgstr "ignorerar ogiltigt värde på miljövariabeln QUOTING_STYLE: %s"

#. from tp:coreutils-9.10-pre1
msgid "cannot open directory %s"
msgstr "kan inte öppna katalog %s"

#. from tp:coreutils-9.10-pre1
msgid "cannot determine device and inode of %s"
msgstr "kan inte avgöra enhet och inod för %s"

#. from tp:coreutils-9.10-pre1
msgid "%s: not listing already-listed directory"
msgstr "%s: listar inte redan listad katalog"

#. from tp:coreutils-9.10-pre1
msgid "error canonicalizing %s"
msgstr "fel vid kanonisering av %s"

#. from tp:coreutils-9.10-pre1
msgid "reading directory %s"
msgstr "läser katalog %s"

#. from tp:coreutils-9.10-pre1
msgid "closing directory %s"
msgstr "stänger katalog %s"

#. from tp:coreutils-9.10-pre1
msgid "cannot compare file names %s and %s"
msgstr "kan inte jämföra filnamnen %s och %s"

#. from tp:coreutils-9.10-pre1
msgid "List information about the FILEs (the current directory by default).\nSort entries alphabetically if none of -cftuvSUX nor --sort is specified.\n"
msgstr "Visa information om FILerna (aktuell katalog om inget anges).  Sortera\nposterna alfabetiskt om ingen av -cftuvSUX eller --sort anges.\n"

#. from tp:coreutils-9.10-pre1
msgid "  -a, --all\n         do not ignore entries starting with .\n"
msgstr "  -a, --all\n         bortse inte från poster som inleds med .\n"

#. from tp:coreutils-9.10-pre1
msgid "  -A, --almost-all\n         do not list implied . and ..\n"
msgstr "  -A, --almost-all\n         lista inte underförstådda . och ..\n"

#. from tp:coreutils-9.10-pre1
msgid "      --author\n         with -l, print the author of each file\n"
msgstr "      --author\n         med -l, skriv ut författare för varje fil\n"

#. from tp:coreutils-9.10-pre1
msgid "  -b, --escape\n         print C-style escapes for nongraphic characters\n"
msgstr "  -b, --escape\n         skriv escape-sekvenser i C-stil för icke-grafiska tecken\n"

#. from tp:coreutils-9.10-pre1
msgid "      --block-size=SIZE\n         with -l, scale sizes by SIZE when printing them;\n         e.g., '--block-size=M'; see SIZE format below\n"
msgstr "      --block-size=STORLEK\n         med -l, skala storlekar med STORLEK när de skrivs ut;\n         t.ex. ”--block-size=M”; se formatet för STORLEK nedan\n"

#. from tp:coreutils-9.10-pre1
msgid "  -B, --ignore-backups\n         do not list implied entries ending with ~\n"
msgstr "  -B, --ignore-backups\n         lista inte underförstådda poster som slutar på ~\n"

#. from tp:coreutils-9.10-pre1
msgid "  -c\n         with -lt: sort by, and show, ctime\n           (time of last change of file status information);\n         with -l: show ctime and sort by name;\n         otherwise: sort by ctime, newest first\n"
msgstr "  -c\n         med -lt: sortera efter och visa ctime,\n           (tid för senaste ändring av filstatusinformation);\n         med -l: visa ctime och sortera efter namn;\n         annars: sortera efter ctime, nyast först\n"

#. from tp:coreutils-9.10-pre1
msgid "  -C\n         list entries by columns\n"
msgstr "  -C\n         lista poster kolumnvis\n"

#. from tp:coreutils-9.10-pre1
msgid "      --color[=WHEN]\n         color the output WHEN; more info below\n"
msgstr "      --color[=NÄR]\n         färglägg utskriften NÄR; mer information nedan\n"

#. from tp:coreutils-9.10-pre1
msgid "  -d, --directory\n         list directories themselves, not their contents\n"
msgstr "  -d, --directory\n         lista själva katalogerna, inte deras innehåll\n"

#. from tp:coreutils-9.10-pre1
msgid "  -D, --dired\n         generate output designed for Emacs' dired mode\n"
msgstr "  -D, --dired\n         anpassa utdata för Emacs dired-funktion\n"

#. from tp:coreutils-9.10-pre1
msgid "  -f\n         same as -a -U\n"
msgstr "  -f\n         samma som -a -U\n"

#. from tp:coreutils-9.10-pre1
msgid "  -F, --classify[=WHEN]\n         append indicator (one of */=>@|) to entries WHEN\n"
msgstr "  -F, --classify[=NÄR]\n         lägg till indikator (en av */=>@|) till poster NÄR\n"

#. from tp:coreutils-9.10-pre1
msgid "      --file-type\n         like -F, except do not append '*'\n"
msgstr "      --file-type\n         som -F, förutom att inte lägga till ”*”\n"

#. from tp:coreutils-9.10-pre1
msgid "      --format=WORD\n         across,horizontal (-x), commas (-m), long (-l),\n         single-column (-1), verbose (-l), vertical (-C)\n"
msgstr "      --format=ORD\n         across,horizontal (-x), commas (-m), long (-l),\n         single-column (-1), verbose (-l), vertical (-C)\n"

#. from tp:coreutils-9.10-pre1
msgid "      --full-time\n         like -l --time-style=full-iso\n"
msgstr "      --full-time\n         som -l --time-style=full-iso\n"

#. from tp:coreutils-9.10-pre1
msgid "  -g\n         like -l, but do not list owner\n"
msgstr "  -g\n         som -l, men skriv inte ut ägare\n"

#. from tp:coreutils-9.10-pre1
msgid "      --group-directories-first\n         group directories before files\n"
msgstr "      --group-directories-first\n         gruppera kataloger före filer\n"

#. from tp:coreutils-9.10-pre1
msgid "  -G, --no-group\n         in a long listing, don't print group names\n"
msgstr "  -G, --no-group\n         i en lång listning, skriv inte ut gruppnamn\n"

#. from tp:coreutils-9.10-pre1
msgid "  -h, --human-readable\n         with -l and -s, print sizes like 1K 234M 2G etc.\n"
msgstr "  -h, --human-readable\n         med -l och -s, skriv storlekar som 1K 234M 2G etc.\n"

#. from tp:coreutils-9.10-pre1
msgid "      --si\n         likewise, but use powers of 1000 not 1024\n"
msgstr "      --si\n         d:o, men använd potenser av 1000, inte 1024\n"

#. from tp:coreutils-9.10-pre1
msgid "  -H, --dereference-command-line\n         follow symbolic links listed on the command line\n"
msgstr "  -H, --dereference-command-line\n         följ symboliska länkar angivna på kommandoraden\n"

#. from tp:coreutils-9.10-pre1
msgid "      --dereference-command-line-symlink-to-dir\n         follow each command line symbolic link that points to a directory\n"
msgstr "      --dereference-command-line-symlink-to-dir\n         följ varje symbolisk länk på kommandoraden som pekar på en katalog\n"

#. from tp:coreutils-9.10-pre1
msgid "      --hide=PATTERN\n         do not list implied entries matching shell PATTERN\n         (overridden by -a or -A)\n"
msgstr "      --hide=MÖNSTER\n         lista inte underförstådda poster som matchar skalmönstret MÖNSTER\n         (åsidosätts av -a eller -A)\n"

#. from tp:coreutils-9.10-pre1
msgid "      --hyperlink[=WHEN]\n         hyperlink file names WHEN\n"
msgstr "      --hyperlink[=NÄR]\n         hyperlänka filnamn NÄR\n"

#. from tp:coreutils-9.10-pre1
msgid "      --indicator-style=WORD\n         append indicator with style WORD to entry names:\n           none (default), slash (-p), file-type (--file-type), classify (-F)\n"
msgstr "      --indicator-style=ORD\n         lägg till en indikator med stil ORD till postnamn:\n         none (standard), slash (-p), file-type (--file-type), classify (-F)\n"

#. from tp:coreutils-9.10-pre1
msgid "  -i, --inode\n         print the index number of each file\n"
msgstr "  -i, --inode\n         skriv ut indexnummer för varje fil\n"

#. from tp:coreutils-9.10-pre1
msgid "  -I, --ignore=PATTERN\n         do not list implied entries matching shell PATTERN\n"
msgstr "  -I, --ignore=MÖNSTER\n         lista inte underförstådda poster som matchar skalmönstret MÖNSTER\n"

#. from tp:coreutils-9.10-pre1
msgid "  -k, --kibibytes\n         default to 1024-byte blocks for file system usage;\n         used only with -s and per directory totals\n"
msgstr "  -k, --kibibytes\n         använd som standard 1024-byteblock för filsystemsanvändning;\n         används endast med -s och för totaler per katalog\n"

#. from tp:coreutils-9.10-pre1
msgid "  -l\n         use a long listing format\n"
msgstr "  -l\n         använd långt listningsformat\n"

#. from tp:coreutils-9.10-pre1
msgid "  -L, --dereference\n         when showing file information for a symbolic link,\n         show information for the file the link references\n         rather than for the link itself\n"
msgstr "  -L, --dereference\n         när filinformation visas för en symbolisk länk,\n         visa information om filen länken refererar till\n         snarare än för själva länken\n"

#. from tp:coreutils-9.10-pre1
msgid "  -m\n         fill width with a comma separated list of entries\n"
msgstr "  -m\n         fyll bredden med en kommaseparerad postlista\n"

#. from tp:coreutils-9.10-pre1
msgid "  -n, --numeric-uid-gid\n         like -l, but list numeric user and group IDs\n"
msgstr "  -n, --numeric-uid-gid\n         som -l, men lista numeriska användar- och grupp-ID\n"

#. from tp:coreutils-9.10-pre1
msgid "  -N, --literal\n         print entry names without quoting\n"
msgstr "  -N, --literal\n         skriv ut råa postnamn utan citeringar\n"

#. from tp:coreutils-9.10-pre1
msgid "  -o\n         like -l, but do not list group information\n"
msgstr "  -o\n         som -l, men lista inte gruppinformation\n"

#. from tp:coreutils-9.10-pre1
msgid "  -p, --indicator-style=slash\n         append / indicator to directories\n"
msgstr "  -p, --indicator-style=slash\n         lägg till en /-indikator till kataloger\n"

#. from tp:coreutils-9.10-pre1
msgid "  -q, --hide-control-chars\n         print ? instead of nongraphic characters\n"
msgstr "  -q, --hide-control-chars\n         skriv ? istället för ickegrafiska tecken\n"

#. from tp:coreutils-9.10-pre1
msgid "      --show-control-chars\n         show nongraphic characters as-is;\n         the default, unless program is 'ls' and output is a terminal\n"
msgstr "      --show-control-chars\n         visa ickegrafiska tecken som de är;\n         normalfallet om inte programmet är ”ls” och utdata är en terminal\n"

#. from tp:coreutils-9.10-pre1
msgid "  -Q, --quote-name\n         enclose entry names in double quotes\n"
msgstr "  -Q, --quote-name\n         omge postnamnen med dubbla citationstecken\n"

#. from tp:coreutils-9.10-pre1
msgid "      --quoting-style=WORD\n         use quoting style WORD for entry names:\n           literal, locale, shell, shell-always,\n           shell-escape, shell-escape-always, c, escape\n         (overrides QUOTING_STYLE environment variable)\n"
msgstr "      --quoting-style=ORD\n         använd citationsstil ORD för postnamn:\n           literal, locale, shell, shell-always,\n           shell-escape, shell-escape-always, c, escape\n         (åsidosätter miljövariabeln QUOTING_STYLE)\n"

#. from tp:coreutils-9.10-pre1
msgid "  -r, --reverse\n         reverse order while sorting\n"
msgstr "  -r, --reverse\n         sortera baklänges\n"

#. from tp:coreutils-9.10-pre1
msgid "  -R, --recursive\n         list subdirectories recursively\n"
msgstr "  -R, --recursive\n         visa underkataloger rekursivt\n"

#. from tp:coreutils-9.10-pre1
msgid "  -s, --size\n         print the allocated size of each file, in blocks\n"
msgstr "  -s, --size\n         skriv allokerade storleken i block för varje fil\n"

#. from tp:coreutils-9.10-pre1
msgid "  -S\n         sort by file size, largest first\n"
msgstr "  -S\n         sortera efter filstorlek, störst först\n"

#. from tp:coreutils-9.10-pre1
msgid "      --sort=WORD\n         change default 'name' sort to WORD:\n           none (-U), size (-S), time (-t),\n           version (-v), extension (-X), name, width\n"
msgstr "      --sort=ORD\n         ändra normal sortering ”name” till ORD:\n           none (-U), size (-S), time (-t),\n           version (-v), extension (-X), name, width\n"

#. from tp:coreutils-9.10-pre1
msgid "      --time=WORD\n         select which timestamp used to display or sort;\n           access time (-u): atime, access, use;\n           metadata change time (-c): ctime, status;\n           modified time (default): mtime, modification;\n           birth time: birth, creation;\n         with -l, WORD determines which time to show;\n         with --sort=time, sort by WORD (newest first)\n"
msgstr "      --time=ORD\n         välj vilken tidsstämpel som används för att visa eller sortera:\n           åtkomsttid (-u): atime, access, use;\n           metadataändringstid (-c): ctime, status;\n           modifieringstid (standard): mtime, modification;\n           skapandetid: birth, creation;\n         med -l avgör ORD vilken tid att visa;\n         med --sort=time, sortera enligt ORD (nyast först)\n"

#. from tp:coreutils-9.10-pre1
msgid "      --time-style=TIME_STYLE\n         time/date format with -l; see TIME_STYLE below\n"
msgstr "      --time-style=TIDSSTIL\n         tid-/datumformat med -l; se TIDSSTIL nedan\n"

#. from tp:coreutils-9.10-pre1
msgid "  -t\n         sort by time, newest first; see --time\n"
msgstr "  -t\n         sortera efter tid, nyast först; se --time\n"

#. from tp:coreutils-9.10-pre1
msgid "  -T, --tabsize=COLS\n         assume tab stops at each COLS instead of 8\n"
msgstr "  -T, --tabsize=KOL\n         anta tabulatorpositioner med KOL kolumners mellanrum, inte 8\n"

#. from tp:coreutils-9.10-pre1
msgid "  -u\n         with -lt: sort by, and show, access time;\n         with -l: show access time and sort by name;\n         otherwise: sort by access time, newest first\n"
msgstr "  -u\n         med -lt: sortera efter och visa åtkomsttid;\n         med -l: visa åtkomsttid men sortera efter namn;\n         annars: sortera enligt åtkomsttid, nyast först\n"

#. from tp:coreutils-9.10-pre1
msgid "  -U\n         do not sort directory entries\n"
msgstr "  -U\n         sortera inte katalogposter\n"

#. from tp:coreutils-9.10-pre1
msgid "  -v\n         natural sort of (version) numbers within text\n"
msgstr "  -v\n         naturlig sortering av (versions)nummer i text\n"

#. from tp:coreutils-9.10-pre1
msgid "  -w, --width=COLS\n         set output width to COLS.  0 means no limit\n"
msgstr "  -w, --width=KOL\n         ange utmatningsbredd till KOL, 0 betyder ingen gräns\n"

#. from tp:coreutils-9.10-pre1
msgid "  -x\n         list entries by lines instead of by columns\n"
msgstr "  -x\n         lista poster radvis istället för kolumnvis\n"

#. from tp:coreutils-9.10-pre1
msgid "  -X\n         sort alphabetically by entry extension\n"
msgstr "  -X\n         sortera alfabetiskt efter posternas ändelser\n"

#. from tp:coreutils-9.10-pre1
msgid "  -Z, --context\n         print any security context of each file\n"
msgstr "  -Z, --context\n         skriv eventuell säkerhetskontext för varje fil\n"

#. from tp:coreutils-9.10-pre1
msgid "      --zero\n         end each output line with NUL, not newline\n"
msgstr "      --zero\n         avsluta varje utmatningsrad med NUL, inte nyrad\n"

#. from tp:coreutils-9.10-pre1
msgid "  -1\n         list one file per line\n"
msgstr "  -1\n         lista en fil per rad\n"

#. from tp:coreutils-9.10-pre1
msgid "\nThe TIME_STYLE argument can be full-iso, long-iso, iso, locale, or +FORMAT.\nFORMAT is interpreted like in date(1).  If FORMAT is FORMAT1<newline>FORMAT2,\nthen FORMAT1 applies to non-recent files and FORMAT2 to recent files.\nTIME_STYLE prefixed with 'posix-' takes effect only outside the POSIX locale.\nAlso the TIME_STYLE environment variable sets the default style to use.\n"
msgstr "\nArgumentet TIDSSTIL kan vara full-iso, long-iso, iso, locale eller +FORMAT.\nFORMAT tolkas som i date(1).  Om FORMAT är FORMAT1<nyrad>FORMAT2, då används\nFORMAT1 för gamla filer och FORMAT2 för nyare filer.  TIDSSTIL med prefixet\n”posix-” har effekt endast utanför lokalen POSIX.\n\nVidare anger miljövariabeln TIME_STYLE standardstilen att använda.\n"

#. from tp:coreutils-9.10-pre1
msgid "\nThe WHEN argument defaults to 'always' and can also be 'auto' or 'never'.\n"
msgstr "\nArgumentet ”NÄR” är som standard ”always” och kan även vara ”auto” eller\n”never”.\n"

#. from tp:coreutils-9.10-pre1
msgid "\nUsing color to distinguish file types is disabled both by default and\nwith --color=never.  With --color=auto, ls emits color codes only when\nstandard output is connected to a terminal.  The LS_COLORS environment\nvariable can change the settings.  Use the dircolors(1) command to set it.\n"
msgstr "\nAnvändning av färger för att särskilja filtyper är avslagen både som\nstandard och med --color=never.  Med --color=auto, skriver ls ut\nfärgkoder endast när standard ut är anslutet till en terminal.\nMiljövariabeln LS_COLORS kan ändra inställningen.  Använd kommandot\ndircolors(1) för att sätta den.\n"

#. from tp:coreutils-9.10-pre1
msgid "\nExit status:\n 0  if OK,\n 1  if minor problems (e.g., cannot access subdirectory),\n 2  if serious trouble (e.g., cannot access command-line argument).\n"
msgstr "\nSlutstatus:\n 0  om OK,\n 1  om smärre problem (t.ex., kan inte komma åt en underkatalog),\n 2  om allvarliga bekymmer (t.ex., kan inte komma åt kommandoradsargument).\n"

#. from tp:coreutils-9.10-pre1
msgid "Usage: %s [OPTION]... DIRECTORY...\n"
msgstr "Användning: %s [FLAGGA]... KATALOG...\n"

#. from tp:coreutils-9.10-pre1
msgid "Create the DIRECTORY(ies), if they do not already exist.\n"
msgstr "Skapa KATALOG(er), om de inte redan finns.\n"

#. from tp:coreutils-9.10-pre1
msgid "  -m, --mode=MODE\n         set file mode (as in chmod), not a=rwx - umask\n"
msgstr "  -m, --mode=RÄTTIGHET\n         sätt filrättigheter (som i chmod), inte a=rwx - umask\n"

#. from tp:coreutils-9.10-pre1
msgid "  -p, --parents\n         no error if existing, make parent directories as needed,\n         with their file modes unaffected by any -m option\n"
msgstr "  -p, --parents\n         inget fel om katalogen finns, skapa föräldrakataloger vid behov;\n         föräldrakatalogernas rättigheter påverkas inte av någon -m-flagga\n"

#. from tp:coreutils-9.10-pre1
msgid "  -v, --verbose\n         print a message for each created directory\n"
msgstr "  -v, --verbose\n         skriv meddelande för varje skapad katalog\n"

#. from tp:coreutils-9.10-pre1
msgid "  -Z\n         set SELinux security context of each created directory\n         to the default type\n"
msgstr "  -Z\n         sätt SELinux-säkerhetskontext på varje skapad katalog\n         till standardtypen\n"

#. from tp:coreutils-9.10-pre1
msgid "created directory %s"
msgstr "skapade katalog %s"

#. from tp:coreutils-9.10-pre1
msgid "warning: ignoring --context; it requires an SELinux/SMACK-enabled kernel"
msgstr "varning: ignorerar --context; det kräver en kärna med SELinux/SMACK"

#. from tp:coreutils-9.10-pre1
msgid "Usage: %s [OPTION]... NAME...\n"
msgstr "Användning: %s [FLAGGA]... NAMN...\n"

#. from tp:coreutils-9.10-pre1
msgid "Create named pipes (FIFOs) with the given NAMEs.\n"
msgstr "Skapa namngivna rör (FIFO) med de givna NAMNen.\n"

#. from tp:coreutils-9.10-pre1
msgid "  -m, --mode=MODE\n         set file permission bits to MODE, not a=rw - umask\n"
msgstr "  -m, --mode=RÄTTIGHET\n         sätt filrättighetsbitar till RÄTTIGHET, inte a=rw - umask\n"

#. from tp:coreutils-9.10-pre1
msgid "  -Z\n         set the SELinux security context to default type\n"
msgstr "  -Z\n         sätt SELinux-säkerhetskontext till standardtypen\n"

#. from tp:coreutils-9.10-pre1
msgid "invalid mode"
msgstr "felaktig rättighet"

#. from tp:coreutils-9.10-pre1
msgid "mode must specify only file permission bits"
msgstr "rättigheter måste ange endast filrättighetsbitar"

#. from tp:coreutils-9.10-pre1
msgid "cannot set permissions of %s"
msgstr "kan inte sätta rättigheter på %s"

#. from tp:coreutils-9.10-pre1
msgid "Usage: %s [OPTION]... NAME TYPE [MAJOR MINOR]\n"
msgstr "Användning: %s [FLAGGA]... NAMN TYP [ÖVRE LÄGRE]\n"

#. from tp:coreutils-9.10-pre1
msgid "Create the special file NAME of the given TYPE.\n"
msgstr "Skapa specialfilen NAMN av angiven TYP.\n"

#. from tp:coreutils-9.10-pre1
msgid "\nBoth MAJOR and MINOR must be specified when TYPE is b, c, or u, and they\nmust be omitted when TYPE is p.  If MAJOR or MINOR begins with 0x or 0X,\nit is interpreted as hexadecimal; otherwise, if it begins with 0, as octal;\notherwise, as decimal.  TYPE may be:\n"
msgstr "\nBåde ÖVRE och LÄGRE måste anges när TYP är b, c eller u, och de får\ninte anges när TYP är p. Om ÖVRE eller LÄGRE börjar med 0x eller 0X\ntolkas det som hexadecimalt; annars, om det börjar med 0 som oktalt;\nannars som decimalt. TYP får vara:\n"

#. from tp:coreutils-9.10-pre1
msgid "\n  b      create a block (buffered) special file\n  c, u   create a character (unbuffered) special file\n  p      create a FIFO\n"
msgstr "\n  b      skapa en (buffrad) blockspecialfil\n  c, u   skapa en (obuffrad) teckenspecialfil\n  p      skapa en FIFO\n"

#. from tp:coreutils-9.10-pre1
msgid "Special files require major and minor device numbers."
msgstr "Specialfiler kräver övre och undre enhetsnummer."

#. from tp:coreutils-9.10-pre1
msgid "Fifos do not have major and minor device numbers."
msgstr "Fifo:er har inte övre och undre enhetsnummer."

#. from tp:coreutils-9.10-pre1
msgid "block special files not supported"
msgstr "blockspecialfiler stödjs inte"

#. from tp:coreutils-9.10-pre1
msgid "character special files not supported"
msgstr "teckenspecialfiler stödjs inte"

#. from tp:coreutils-9.10-pre1
msgid "invalid major device number %s"
msgstr "ogiltigt övre enhetsnummer %s"

#. from tp:coreutils-9.10-pre1
msgid "invalid minor device number %s"
msgstr "ogiltigt undre enhetsnummer %s"

#. from tp:coreutils-9.10-pre1
msgid "invalid device %s %s"
msgstr "ogiltig enhet %s %s"

#. from tp:coreutils-9.10-pre1
msgid "invalid device type %s"
msgstr "ogiltig enhetstyp %s"

#. from tp:coreutils-9.10-pre1
msgid "Eric Blake"
msgstr "Eric Blake"

#. from tp:coreutils-9.10-pre1
msgid "Usage: %s [OPTION]... [TEMPLATE]\n"
msgstr "Användning: %s [FLAGGA]... [MALL]\n"

#. from tp:coreutils-9.10-pre1
msgid "Create a temporary file or directory, safely, and print its name.\nTEMPLATE must contain at least 3 consecutive 'X's in last component.\nIf TEMPLATE is not specified, use tmp.XXXXXXXXXX, and --tmpdir is implied.\n"
msgstr "Skapa en temporärfil eller -katalog, säkert, och skriv dess namn.\nMALL måste innehålla åtminstone 3 ”X” i följd i sin sista komponent.\nOm MALL inte är angiven, används tmp.XXXXXXXXXX, och --tmpdir är implicit.\n"

#. from tp:coreutils-9.10-pre1
msgid "Files are created u+rw, and directories u+rwx, minus umask restrictions.\n"
msgstr "Filer skapas u+rw, och kataloger u+rwx, minus begränsningar från umask.\n"

#. from tp:coreutils-9.10-pre1
msgid "  -d, --directory\n         create a directory, not a file\n"
msgstr "  -d, --directory\n         skapa en katalog, inte en fil\n"

#. from tp:coreutils-9.10-pre1
msgid "  -u, --dry-run\n         do not create anything; merely print a name (unsafe)\n"
msgstr "  -u, --dry-run\n         skapa ingenting, skriv bara ett namn (osäkert)\n"

#. from tp:coreutils-9.10-pre1
msgid "  -q, --quiet\n         suppress diagnostics about file/dir-creation failure\n"
msgstr "  -q, --quiet\n         utelämna meddelanden när det inte går att skapa filer/kataloger\n"

#. from tp:coreutils-9.10-pre1
msgid "      --suffix=SUFF\n         append SUFF to TEMPLATE; SUFF must not contain a slash.\n         This option is implied if TEMPLATE does not end in X\n"
msgstr "      --suffix=SUFF\n         lägg till SUFF till MALL; SUFF får inte innehålla ett snedstreck.\n         Denna flagga är implicit om MALL inte slutar med X\n"

#. from tp:coreutils-9.10-pre1
msgid "  -p DIR, --tmpdir[=DIR]\n         interpret TEMPLATE relative to DIR;\n         if DIR is not specified, use $TMPDIR if set, else /tmp.\n         With this option, TEMPLATE must not be an absolute name;\n         unlike with -t, TEMPLATE may contain slashes,\n         but mktemp creates only the final component\n"
msgstr "  -p KAT, --tmpdir[=KAT]\n         tolka MALL relativt KAT;\n         om KAT inte anges använd $TMPDIR om den är satt, annars /tmp.\n         Med denna flagga får MALL inte vara ett absolut namn;\n         till skillnad mot -t får MALL innehålla snedstreck,\n         men mktemp skapar endast den sista komponenten\n"

#. from tp:coreutils-9.10-pre1
msgid "  -t\n         interpret TEMPLATE as a single file name component,\n         relative to a directory: $TMPDIR, if set;\n         else the directory specified via -p; else /tmp [deprecated]\n"
msgstr "  -t\n         tolka MALL som en ensam filnamnskomponent,\n         relativt en katalog: $TMPDIR, om det är satt;\n         annars katalogen som angetts via -p; annars /tmp [föråldrad]\n"

#. from tp:coreutils-9.10-pre1
msgid "too many templates"
msgstr "för många mallar"

#. from tp:coreutils-9.10-pre1
msgid "with --suffix, template %s must end in X"
msgstr "med --suffix måste mallen %s sluta med X"

#. from tp:coreutils-9.10-pre1
msgid "invalid suffix %s, contains directory separator"
msgstr "ogiltigt suffix %s, innehåller katalogseparator"

#. from tp:coreutils-9.10-pre1
msgid "too few X's in template %s"
msgstr "för få X i mallen %s"

#. from tp:coreutils-9.10-pre1
msgid "invalid template, %s, contains directory separator"
msgstr "ogiltig mall, %s, innehåller katalogseparator"

#. from tp:coreutils-9.10-pre1
msgid "invalid template, %s; with --tmpdir, it may not be absolute"
msgstr "ogiltig mall, %s, med --tmpdir får den inte vara absolut"

#. from tp:coreutils-9.10-pre1
msgid "failed to create directory via template %s"
msgstr "misslyckades med att skapa en katalog via mallen %s"

#. from tp:coreutils-9.10-pre1
msgid "failed to create file via template %s"
msgstr "misslyckades med att skapa en fil via mallen %s"

#. from tp:coreutils-9.10-pre1
msgid "Rename SOURCE to DEST, or move SOURCE(s) to DIRECTORY.\n"
msgstr "Byt namn på KÄLLA till DEST eller flytta KÄLLor till KATALOG.\n"

#. from tp:coreutils-9.10-pre1
msgid "      --exchange\n         exchange source and destination\n"
msgstr "      --exchange\n         byt plats på källa och destination\n"

#. from tp:coreutils-9.10-pre1
msgid "  -f, --force\n         do not prompt before overwriting\n"
msgstr "  -f, --force\n         fråga inte innan något skrivs över\n"

#. from tp:coreutils-9.10-pre1
msgid "  -i, --interactive\n         prompt before overwrite\n"
msgstr "  -i, --interactive\n         fråga innan något skrivs över\n"

#. from tp:coreutils-9.10-pre1
msgid "  -n, --no-clobber\n         do not overwrite an existing file\n"
msgstr "  -n, --no-clobber\n         skriv inte över en befintlig fil\n"

#. from tp:coreutils-9.10-pre1
msgid "If you specify more than one of -i, -f, -n, only the final one takes effect.\n"
msgstr "Om man anger mer än en av -i, -f, -n har endast den sista någon effekt.\n"

#. from tp:coreutils-9.10-pre1
msgid "      --no-copy\n         do not copy if renaming fails\n"
msgstr "      --no-copy\n         kopiera inte om namnbytet misslyckas\n"

#. from tp:coreutils-9.10-pre1
msgid "  -t, --target-directory=DIRECTORY\n         move all SOURCE arguments into DIRECTORY\n"
msgstr "  -t, --target-directory=KATALOG\n         flytta alla KÄLLargument till KATALOG\n"

#. from tp:coreutils-9.10-pre1
msgid "  -Z, --context\n         set SELinux security context of destination file to default type\n"
msgstr "  -Z, --context\n         sätt SELinux-säkerhetskontext på målfilen till standardtypen\n"

#. from tp:coreutils-9.10-pre1
msgid "cannot combine --backup with --exchange, -n, or --update=none-fail"
msgstr "det går inte att kombinera --backup med --exchange, -n eller --update=none-fail"

#. from tp:coreutils-9.10-pre1
msgid "Usage: %s [OPTION] [COMMAND [ARG]...]\n"
msgstr "Användning: %s [FLAGGA] [KOMMANDO [ARG]...]\n"

#. from tp:coreutils-9.10-pre1
msgid "Run COMMAND with an adjusted niceness, which affects process scheduling.\nWith no COMMAND, print the current niceness.  Niceness values range from\n%d (most favorable to the process) to %d (least favorable to the process).\n"
msgstr "Kör KOMMANDO med justerat nice-värde, vilket påverkar processens\nschemaläggning.  Utan KOMMANDO skrivs nuvarande nice-värde.\nNice-värden går från %d (mest gynnsamt för processen) till %d (minst\ngynnsamt för processen).\n"

#. from tp:coreutils-9.10-pre1
msgid "  -n, --adjustment=N\n         add integer N to the niceness (default 10)\n"
msgstr "  -n, --adjustment=N\n         lägg till heltalet N till nice-värdet (10 som standard)\n"

#. from tp:coreutils-9.10-pre1
msgid "invalid adjustment %s"
msgstr "felaktig justering %s"

#. from tp:coreutils-9.10-pre1
msgid "cannot get niceness"
msgstr "kan inte avgöra nice-värde"

#. from tp:coreutils-9.10-pre1
msgid "a command must be given with an adjustment"
msgstr "ett kommando måste anges med en justering"

#. from tp:coreutils-9.10-pre1
msgid "cannot set niceness"
msgstr "kan inte sätta nice-värde"

#. from tp:coreutils-9.10-pre1
msgid "Scott Bartram"
msgstr "Scott Bartram"

#. from tp:coreutils-9.10-pre1
msgid "Write each FILE to standard output, with line numbers added.\n"
msgstr "Skriv varje FIL till standard ut och lägg till radnummer.\n"

#. from tp:coreutils-9.10-pre1
msgid "  -b, --body-numbering=STYLE      use STYLE for numbering body lines\n"
msgstr "  -b, --body-numbering=STIL       använd STIL för att numrera rader i brödtexten\n"

#. from tp:coreutils-9.10-pre1
msgid "  -d, --section-delimiter=CC      use CC for logical page delimiters\n"
msgstr "  -d, --section-delimiter=CC      använd CC som avgränsare för logiska sidor\n"

#. from tp:coreutils-9.10-pre1
msgid "  -f, --footer-numbering=STYLE    use STYLE for numbering footer lines\n"
msgstr "  -f, --footer-numbering=STIL     använd STIL för att numrera rader i sidfoten\n"

#. from tp:coreutils-9.10-pre1
msgid "  -h, --header-numbering=STYLE    use STYLE for numbering header lines\n"
msgstr "  -h, --header-numbering=STIL     använd STIL för att numrera rader i sidhuvudet\n"

#. from tp:coreutils-9.10-pre1
msgid "  -i, --line-increment=NUMBER     line number increment at each line\n"
msgstr "  -i, --line-increment=ANTAL      öka radnummer med ANTAL för varje rad\n"

#. from tp:coreutils-9.10-pre1
msgid "  -l, --join-blank-lines=NUMBER   group of NUMBER empty lines counted as one\n"
msgstr "  -l, --join-blank-lines=ANTAL    grupp med ANTAL tomma rader räknade som en\n"

#. from tp:coreutils-9.10-pre1
msgid "  -n, --number-format=FORMAT      insert line numbers according to FORMAT\n"
msgstr "  -n, --number-format=FORMAT      följ FORMAT när radnummer sätts in\n"

#. from tp:coreutils-9.10-pre1
msgid "  -p, --no-renumber               do not reset line numbers for each section\n"
msgstr "  -p, --no-renumber               börja inte om radnummer för varje avsnitt\n"

#. from tp:coreutils-9.10-pre1
msgid "  -s, --number-separator=STRING   add STRING after (possible) line number\n"
msgstr "  -s, --number-separator=STRÄNG   lägg till STRÄNG efter eventuellt radnummer\n"

#. from tp:coreutils-9.10-pre1
msgid "  -v, --starting-line-number=NUMBER  first line number for each section\n"
msgstr "  -v, --starting-line-number=NUMMER  första radnumret på varje avsnitt\n"

#. from tp:coreutils-9.10-pre1
msgid "  -w, --number-width=NUMBER       use NUMBER columns for line numbers\n"
msgstr "  -w, --number-width=ANTAL        använd ANTAL kolumner för radnummer\n"

#. from tp:coreutils-9.10-pre1
msgid "\nDefault options are: -bt -d'\\:' -fn -hn -i1 -l1 -n'rn' -s<TAB> -v1 -w6\n\nCC are two delimiter characters used to construct logical page delimiters;\na missing second character implies ':'.  As a GNU extension one can specify\nmore than two characters, and also specifying the empty string (-d '')\ndisables section matching.\n"
msgstr "\nStandardflaggor är: -bt -d'\\:' -fn -hn -i1 -l1 -n'rn' -s<TAB> -v1 -w6\n\nCC består av två avgränsningstecken som används för att skapa logiska\nsidavgränsare, saknas andra tecknet menas ”:”. Som ett GNU-tillägg kan man\nange mer än två tecken, och även ange den tomma strängen (-d '') som\navaktiverar avsnittsmatchning.\n"

#. from tp:coreutils-9.10-pre1
msgid "\nSTYLE is one of:\n\n  a      number all lines\n  t      number only nonempty lines\n  n      number no lines\n  pBRE   number only lines that contain a match for the basic regular\n         expression, BRE\n"
msgstr "\nSTIL är en av:\n\n  a      numrera alla rader\n  t      numrera endast icketomma rader\n  n      numrera inga rader\n  pGRU   numrera endast rader som stämmer med det grundläggande reguljära\n         uttrycket, GRU\n"

#. from tp:coreutils-9.10-pre1
msgid "\nFORMAT is one of:\n\n  ln     left justified, no leading zeros\n  rn     right justified, no leading zeros\n  rz     right justified, leading zeros\n\n"
msgstr "\nFORMAT är en av:\n\n  ln     vänsterjusterat, inga inledande nollor\n  rn     högerjusterat, inga inledande nollor\n  rz     högerjusterat, inledande nollor\n\n"

#. from tp:coreutils-9.10-pre1
msgid "invalid header numbering style: %s"
msgstr "felaktig stil för numrering av sidhuvud: %s"

#. from tp:coreutils-9.10-pre1
msgid "invalid body numbering style: %s"
msgstr "felaktig stil för numrering av brödtext: %s"

#. from tp:coreutils-9.10-pre1
msgid "invalid footer numbering style: %s"
msgstr "felaktig stil för numrering av sidfot: %s"

#. from tp:coreutils-9.10-pre1
msgid "invalid starting line number"
msgstr "felaktigt första radnummer"

#. from tp:coreutils-9.10-pre1
msgid "invalid line number increment"
msgstr "felaktig ökning av radnummer"

#. from tp:coreutils-9.10-pre1
msgid "invalid line number of blank lines"
msgstr "felaktigt antal tomma rader"

#. from tp:coreutils-9.10-pre1
msgid "invalid line number field width"
msgstr "felaktig bredd på radnumrets fält"

#. from tp:coreutils-9.10-pre1
msgid "invalid line numbering format: %s"
msgstr "felaktigt format på radnummer: %s"

#. from tp:coreutils-9.10-pre1
msgid "Usage: %s COMMAND [ARG]...\n  or:  %s OPTION\n"
msgstr "Användning: %s KOMMANDO [ARGUMENT]...\n   eller:   %s FLAGGA\n"

#. from tp:coreutils-9.10-pre1
msgid "Run COMMAND, ignoring hangup signals.\n\n"
msgstr "Kör KOMMANDO, ignorera avringningssignaler.\n\n"

#. from tp:coreutils-9.10-pre1
msgid "\nIf standard input is a terminal, redirect it from an unreadable file.\nIf standard output is a terminal, append output to 'nohup.out' if possible,\n'$HOME/nohup.out' otherwise.\nIf standard error is a terminal, redirect it to standard output.\nTo save output to FILE, use '%s COMMAND > FILE'.\n"
msgstr "\nOm standard in är en terminal, omdirigera den från en oläslig fil.\nOm standard ut är en terminal, lägg till utdata till ”nohup.out” om möjligt,\n”$HOME/nohup.out” annars.\nOm standard fel är en terminal, omdirigera den till standard ut.\nFör att spara utdata till FIL, använd ”%s KOMMANDO > FIL”.\n"

#. from tp:coreutils-9.10-pre1
msgid "failed to render standard input unusable"
msgstr "misslyckades med att göra standard in oanvändbar"

#. from tp:coreutils-9.10-pre1
msgid "ignoring input"
msgstr "ignorerar indata"

#. from tp:coreutils-9.10-pre1
msgid "ignoring input and appending output to %s"
msgstr "ignorerar indata och lägger till utdata till %s"

#. from tp:coreutils-9.10-pre1
msgid "appending output to %s"
msgstr "lägger till utdata till %s"

#. from tp:coreutils-9.10-pre1
msgid "ignoring input and redirecting standard error to standard output"
msgstr "ignorerar indata och omdirigerar standard fel till standard ut"

#. from tp:coreutils-9.10-pre1
msgid "redirecting standard error to standard output"
msgstr "omdirigerar standard fel till standard ut"

#. from tp:coreutils-9.10-pre1
msgid "failed to redirect standard error"
msgstr "misslyckades med att omdirigera standard fel"

#. from tp:coreutils-9.10-pre1
msgid "Giuseppe Scrivano"
msgstr "Giuseppe Scrivano"

#. from tp:coreutils-9.10-pre1
msgid "Print the number of processing units available to the current process,\nwhich may be less than the number of online processors.\nIf the 'OMP_NUM_THREADS' or 'OMP_THREAD_LIMIT' environment variables are set,\nthen they will determine the minimum and maximum returned value respectively.\n\n"
msgstr "Skriv antalet processorenheter som är tillgängliga för den aktuella processen,\nvilket kan vara mindre än antalet inkopplade processorer.\nOm miljövariablerna ”OMP_NUM_THREADS” eller ”OMP_THREAD_LIMIT” är satta,\ndå styr de det minsta respektive högsta returnerade värdet.\n\n"

#. from tp:coreutils-9.10-pre1
msgid "      --all\n         print the number of installed processors,\n         disregarding any OpenMP environment variables, or CPU quotas.\n"
msgstr "      --all\n         skriv antalet installerade processorer,\n         bortse från eventuella OpenMP-miljövariabler eller CPU-kvoter.\n"

#. from tp:coreutils-9.10-pre1
msgid "      --ignore=N\n         if possible, exclude N processing units.\n         The result is guaranteed to be at least 1.\n"
msgstr "      --ignore=N\n         om möjligt, uteslut N processorenheter.\n         Resultatet garanteras att vara minst 1.\n"

#. from tp:coreutils-9.10-pre1
msgid "value too large to be converted: %s"
msgstr "värdet är för stort för att konverteras: %s"

#. from tp:coreutils-9.10-pre1
msgid "invalid number: %s"
msgstr "ogiltigt tal: %s"

#. from tp:coreutils-9.10-pre1
msgid "rejecting suffix in input: %s (consider using --from)"
msgstr "avvisar suffix i indata: %s (överväg att använda --from)"

#. from tp:coreutils-9.10-pre1
msgid "invalid suffix in input: %s"
msgstr "felaktigt suffix i indata: %s"

#. from tp:coreutils-9.10-pre1
msgid "missing 'i' suffix in input: %s (e.g Ki/Mi/Gi)"
msgstr "saknat suffix ”i” i indata: %s (t.ex. Ki/Mi/Gi)"

#. from tp:coreutils-9.10-pre1
msgid "invalid unit size: %s"
msgstr "felaktig enhetsstorlek: %s"

#. from tp:coreutils-9.10-pre1
msgid "Usage: %s [OPTION]... [NUMBER]...\n"
msgstr "Användning: %s [FLAGGA]… [TAL]…\n"

#. from tp:coreutils-9.10-pre1
msgid "Reformat NUMBER(s), or the numbers from standard input if none are specified.\n"
msgstr "Formaterar om TAL, eller talen från standard in om inga är givna.\n"

#. from tp:coreutils-9.10-pre1
msgid "      --debug\n         print warnings about invalid input\n"
msgstr "      --debug\n         skriv varningar om ogiltig indata\n"

#. from tp:coreutils-9.10-pre1
msgid "  -d, --delimiter=X\n         use X instead of whitespace for field delimiter\n"
msgstr "  -d, --delimiter=X\n         använd X istället för blanka som fältseparator\n"

#. from tp:coreutils-9.10-pre1
msgid "      --field=FIELDS\n         replace the numbers in these input fields (default=1);\n         see FIELDS below for details\n"
msgstr "      --field=FÄLT\n         ersätt talen i dessa indatafält (standard är 1);\n         se FÄLT nedan för detaljer\n"

#. from tp:coreutils-9.10-pre1
msgid "      --format=FORMAT\n         use printf style floating-point FORMAT;\n         see FORMAT below for details\n"
msgstr "      --format=FORMAT\n         använd flyttalsformat FORMAT av typ printf;\n         se FORMAT nedan för detaljer\n"

#. from tp:coreutils-9.10-pre1
msgid "      --from=UNIT\n         auto-scale input numbers to UNITs; default is 'none';\n         see UNIT below for details\n"
msgstr "      --from=ENHET\n         skala automatiskt indatatal till ENHETer; standard är ”none”;\n         se ENHET nedan för detaljer\n"

#. from tp:coreutils-9.10-pre1
msgid "      --from-unit=N\n         specify the input unit size (instead of the default 1)\n"
msgstr "      --from-unit=N\n         ange indatas enhetsstorlek (istället för standard 1)\n"

#. from tp:coreutils-9.10-pre1
msgid "      --grouping\n         use locale-defined grouping of digits, e.g. 1,000,000.\n         This has no effect in the C/POSIX locale\n"
msgstr "      --grouping\n         använd lokaldefinierad gruppering av siffror, t.ex. 1 000 000.\n         Detta har ingen effekt i lokalen C/POSIX\n"

#. from tp:coreutils-9.10-pre1
msgid "      --header[=N]\n         print (without converting) the first N header lines;\n         N defaults to 1 if not specified\n"
msgstr "      --header[=N]\n         skriv (utan konvertering) de första N rubrikraderna;\n         N blir 1 som standard om det inte anges\n"

#. from tp:coreutils-9.10-pre1
msgid "      --invalid=MODE\n         failure mode for invalid numbers;\n         MODE can be: abort (default), fail, warn, ignore\n"
msgstr "      --invalid=SÄTT\n         felhanteringssätt för felaktiga tal;\n         SÄTT kan vara: abort (standard), fail, warn, ignore\n"

#. from tp:coreutils-9.10-pre1
msgid "      --padding=N\n         pad the output to N characters;\n         positive N will right-align, negative N will left-align;\n         padding is ignored if the output is wider than N;\n         the default is to automatically pad if a whitespace is found\n"
msgstr "      --padding=N\n         fyll ut utdata till N tecken;\n         positivt N högerjusterar, negativt N vänsterjusterar;\n         utfyllnad ignoreras om utdata är bredare än N;\n         standard är att automatiskt fylla ut om en blank finns\n"

#. from tp:coreutils-9.10-pre1
msgid "      --round=METHOD\n         use METHOD for rounding when scaling; METHOD can be:\n         up, down, from-zero (default), towards-zero, nearest\n"
msgstr "      --round=METOD\n         använd METOD för avrundning vid skalning; METOD kan vara:\n         up, down, from-zero (standard), towards-zero, nearest\n"

#. from tp:coreutils-9.10-pre1
msgid "      --suffix=SUFFIX\n         add SUFFIX to output numbers,\n         and accept an optional SUFFIX in input numbers\n"
msgstr "      --suffix=SUFFIX\n         lägg till SUFFIX till utskrivna tal,\n         och acceptera ett valfritt SUFFIX i indatatal\n"

#. from tp:coreutils-9.10-pre1
msgid "      --unit-separator=SEP\n         insert SEP between number and unit on output,\n         and accept an optional SEP in input numbers\n"
msgstr "      --unit-separator=SEP\n         infoga SEP mellan tal och enhet i utdata,\n         och tillåt en eventuell SEP i indatatal\n"

#. from tp:coreutils-9.10-pre1
msgid "      --to=UNIT\n         auto-scale output numbers to UNITs; see UNIT below\n"
msgstr "      --to=ENHET\n         skala automatiskt utdatatal till ENHETer; se ENHET nedan\n"

#. from tp:coreutils-9.10-pre1
msgid "      --to-unit=N\n         the output unit size (instead of the default 1)\n"
msgstr "      --to-unit=N\n         enhetsstorlek på utdata (istället för standard 1)\n"

#. from tp:coreutils-9.10-pre1
msgid "\nUNIT options:\n"
msgstr "\nENHETSflaggor:\n"

#. from tp:coreutils-9.10-pre1
msgid "  none       no auto-scaling is done; suffixes will trigger an error\n"
msgstr "  none       ingen automatisk skalning görs; suffix orsakar ett fel\n"

#. from tp:coreutils-9.10-pre1
msgid "  auto       accept optional single/two letter suffix:\n               1K = 1000, 1k = 1000,\n               1Ki = 1024,\n               1M = 1000000,\n               1Mi = 1048576,\n"
msgstr "  auto       acceptera valfria en-/tvåbokstavssuffix:\n               1K = 1000, 1k = 1000,\n               1Ki = 1024,\n               1M = 1000000,\n               1Mi = 1048576,\n"

#. from tp:coreutils-9.10-pre1
msgid "  si         accept optional single letter suffix:\n               1k = 1000, 1K = 1000,\n               1M = 1000000,\n               ...\n"
msgstr "  si         acceptera valfria enbokstavssuffix:\n               1K = 1000, 1k = 1000,\n               1M = 1000000,\n               …\n"

#. from tp:coreutils-9.10-pre1
msgid "  iec        accept optional single letter suffix:\n               1K = 1024, 1k = 1024,\n               1M = 1048576,\n               ...\n"
msgstr "  iec        acceptera valfria enbokstavssuffix:\n               1K = 1024, 1k = 1024,\n               1M = 1048576,\n               …\n"

#. from tp:coreutils-9.10-pre1
msgid "  iec-i      accept optional two-letter suffix:\n               1Ki = 1024, 1ki = 1024,\n               1Mi = 1048576,\n               ...\n"
msgstr "  iec-i      acceptera valfria tvåbokstavssuffix:\n               1Ki = 1024, 1ki = 1024,\n               1Mi = 1048576,\n               …\n"

#. from tp:coreutils-9.10-pre1
msgid "\nFIELDS supports cut(1) style field ranges:\n  N    N'th field, counted from 1\n  N-   from N'th field, to end of line\n  N-M  from N'th to M'th field (inclusive)\n  -M   from first to M'th field (inclusive)\n  -    all fields\nMultiple fields/ranges can be separated with commas\n"
msgstr "\nFÄLT stödjer fältintervall i stilen för cut(1):\n  N     N:e fältet, räknat från 1\n  N-    från N:e fältet, till radslut\n  N-M   från N:e till och med M:e fältet\n  -M    från första till och med M:e fältet\n  -     alla fält\nFlera fält/intervall kan separeras med komman\n"

#. from tp:coreutils-9.10-pre1
msgid "\nFORMAT must be suitable for printing one floating-point argument '%f'.\nOptional quote (%'f) will enable --grouping (if supported by current locale).\nOptional width value (%10f) will pad output. Optional zero (%010f) width\nwill zero pad the number. Optional negative values (%-10f) will left align.\nOptional precision (%.1f) will override the input determined precision.\n"
msgstr "\nFORMAT måste passa för att skriva ett flyttalsargument ”%f”. En valfri\napostrof (%'f) aktiverar --grouping (om det stöds av den aktuella\nlokalen). Ett valfritt breddvärde (%10f) fyller ut utdata. En valfri\nnolla (%010f) i bredden fyller ut talet med nollor. Ett valfritt negativt\nvärde (%-10f) vänsterjusterar utdata. En valfri precision (%.1f)\nåsidosätter precisionen som bestäms av indata.\n"

#. from tp:coreutils-9.10-pre1
msgid "\nExit status is 0 if all input numbers were successfully converted.\nBy default, %s will stop at the first conversion error with exit status 2.\nWith --invalid='fail' a warning is printed for each conversion error\nand the exit status is 2.  With --invalid='warn' each conversion error is\ndiagnosed, but the exit status is 0.  With --invalid='ignore' conversion\nerrors are not diagnosed and the exit status is 0.\n"
msgstr "\nSlutstatus är 0 om alla indatatal kunde konverteras.  Som standard kommer\n%s sluta vid det första konverteringsfelet med slutstatus 2.  Med\n--invalid='fail' skrivs en varning för varje konverteringsfel och slutstatus\när 2.  Med --invalid='warn' diagnostiseras varje konverteringsfel, men\nslutstatus är 0.  Med --invalid='ignore' diagnostiseras inte konverteringsfel\noch slutstatusen är 0.\n"

#. from tp:coreutils-9.10-pre1
msgid "\nExamples:\n  $ %s --to=si 1000\n            -> \"1.0k\"\n  $ %s --to=iec 2048\n           -> \"2.0K\"\n  $ %s --to=iec-i 4096\n           -> \"4.0Ki\"\n  $ echo 1K | %s --from=si\n           -> \"1000\"\n  $ echo 1K | %s --from=iec\n           -> \"1024\"\n  $ df -B1 | %s --header --field 2-4 --to=si\n  $ ls -l  | %s --header --field 5 --to=iec\n  $ ls -lh | %s --header --field 5 --from=iec --padding=10\n  $ ls -lh | %s --header --field 5 --from=iec --format %%10f\n"
msgstr "\nExempel:\n  $ %s --to=si 1000\n           → ”1.0k”\n  $ %s --to=iec 2048\n           → ”2.0K”\n  $ %s --to=iec-i 4096\n           → ”4.0Ki”\n  $ echo 1K | %s --from=si\n           → ”1000”\n  $ echo 1K | %s --from=iec\n           → ”1024”\n  $ df -B1 | %s --header --field 2-4 --to=si\n  $ ls -l  | %s --header --field 5 --to=iec\n  $ ls -lh | %s --header --field 5 --from=iec --padding=10\n  $ ls -lh | %s --header --field 5 --from=iec --format %%10f\n"

#. from tp:coreutils-9.10-pre1
msgid "format %s has no %% directive"
msgstr "formatet %s har inget %%-direktiv"

#. from tp:coreutils-9.10-pre1
msgid "--format padding overriding --padding"
msgstr "utfyllnad med --format åsidosätter --padding"

#. from tp:coreutils-9.10-pre1
msgid "format %s ends in %%"
msgstr "format %s avslutas med %%"

#. from tp:coreutils-9.10-pre1
msgid "invalid precision in format %s"
msgstr "ogiltig precision i format %s"

#. from tp:coreutils-9.10-pre1
msgid "invalid format %s, directive must be %%[0]['][-][N][.][N]f"
msgstr "ogiltigt format %s, direktivet måste vara %%[0]['][-][N][.][N]f"

#. from tp:coreutils-9.10-pre1
msgid "format %s has too many %% directives"
msgstr "format %s har för många %%-direktiv"

#. from tp:coreutils-9.10-pre1
msgid "invalid suffix in input %s: %s"
msgstr "felaktigt suffix i indata %s: %s"

#. from tp:coreutils-9.10-pre1
msgid "value/precision too large to be printed: '%Lg/%zu' (consider using --to)"
msgstr "värdet/precisionen är för stort för att skrivas: ”%Lg/%zu” (överväg att använda --to)"

#. from tp:coreutils-9.10-pre1
msgid "value too large to be printed: '%Lg' (consider using --to)"
msgstr "värdet är för stort för att skrivas: ”%Lg” (överväg att använda --to)"

#. from tp:coreutils-9.10-pre1
msgid "value too large to be printed: '%Lg' (cannot handle values > 999Q)"
msgstr "värdet är för stort för att skrivas: ”%Lg” (kan inte hantera värden > 999Q)"

#. from tp:coreutils-9.10-pre1
msgid "failed to prepare value '%Lf' for printing"
msgstr "misslyckades med att förbereda värdet ”%Lf” för utskrift"

#. from tp:coreutils-9.10-pre1
msgid "large input value %s: possible precision loss"
msgstr "stort indatavärde %s: möjlig förlust av precision"

#. from tp:coreutils-9.10-pre1
msgid "invalid padding value %s"
msgstr "ogiltigt utfyllnadsvärde %s"

#. from tp:coreutils-9.10-pre1
msgid "multiple field specifications"
msgstr "flera fältspecifikationer"

#. from tp:coreutils-9.10-pre1
msgid "invalid header value %s"
msgstr "ogiltigt värde för --header: %s"

#. from tp:coreutils-9.10-pre1
msgid "--grouping cannot be combined with --format"
msgstr "--grouping kan inte kombineras med --format"

#. from tp:coreutils-9.10-pre1
msgid "failed to set locale"
msgstr "misslyckades med att sätta lokal"

#. from tp:coreutils-9.10-pre1
msgid "no conversion option specified"
msgstr "ingen konverteringsflagga angiven"

#. from tp:coreutils-9.10-pre1
msgid "field delimiters have higher precedence than unit separators"
msgstr "fältavgränsare har högre precedens än enhetsseparatorer"

#. from tp:coreutils-9.10-pre1
msgid "grouping cannot be combined with --to"
msgstr "gruppering kan inte kombineras med --to"

#. from tp:coreutils-9.10-pre1
msgid "grouping has no effect in this locale"
msgstr "gruppering har ingen effekt i den här lokalen"

#. from tp:coreutils-9.10-pre1
msgid "--header ignored with command-line input"
msgstr "--header ignoreras vid kommandoradsindata"

#. from tp:coreutils-9.10-pre1
msgid "failed to convert some of the input numbers"
msgstr "misslyckades med att konvertera några av indatatalen"

#. from tp:coreutils-9.10-pre1
msgid "Usage: %s [OPTION]... [FILE]...\n  or:  %s [-abcdfilosx]... [FILE] [[+]OFFSET[.][b]]\n  or:  %s --traditional [OPTION]... [FILE] [[+]OFFSET[.][b] [+][LABEL][.][b]]\n"
msgstr "Användning: %s [FLAGGA]... [FIL]...\n   eller:   %s [-abcdfilosx]... [FIL] [[+]FÖRSKJUTNING[.][b]]\n   eller:   %s --traditional [FLAGGA]... [FIL] [[+]FÖRSKJUTNING[.][b] [+][ETIKETT][.][b]]\n"

#. from tp:coreutils-9.10-pre1
msgid "\nWrite an unambiguous representation, octal bytes by default,\nof FILE to standard output.  With more than one FILE argument,\nconcatenate them in the listed order to form the input.\n"
msgstr "\nSkriv en entydig representation, normalt oktala byte, av FIL till\nstandard ut.  Med mer än ett FIL-argument, slå samman dem i den\nangivna ordningen som indata.\n"

#. from tp:coreutils-9.10-pre1
msgid "\nIf first and second call formats both apply, the second format is assumed\nif the last operand begins with + or (if there are 2 operands) a digit.\nAn OFFSET operand means -j OFFSET.  LABEL is the pseudo-address\nat first byte printed, incremented when dump is progressing.\nFor OFFSET and LABEL, a 0x or 0X prefix indicates hexadecimal;\nsuffixes may be . for octal and b for multiply by 512.\n"
msgstr "\nOm både det första och andra anropsformatet är tillämpligt, används\ndet andra formatet om den sista operanden börjar med + eller (om det\nfinns två operander) en siffra.  En operand FÖRSKJUTNING betyder -j\nFÖRSKJUTNING.  ETIKETT är den första skrivna bytens pseudoadress,\nvilken ökas så länge utmatningen pågår.  För FÖRSKJUTNING och ETIKETT\nindikerar förstavelserna 0x eller 0X hexadecimalt, ändelser kan vara\n. för decimalt och b multiplicerar med 512.\n"

#. from tp:coreutils-9.10-pre1
msgid "  -A, --address-radix=RADIX\n         output format for file offsets;\n         RADIX is one of [doxn], for Decimal, Octal, Hex or None\n"
msgstr "  -A, --address-radix=RADIX\n         utformat för filpositioner;\n         RADIX är en av [doxn], för Decimal, Oktal, Hex eller iNgen\n"

#. from tp:coreutils-9.10-pre1
msgid "      --endian={big|little}\n         swap input bytes according the specified order\n"
msgstr "      --endian={big|little}\n         byt plats på indatabyte enligt angiven byteordning\n"

#. from tp:coreutils-9.10-pre1
msgid "  -j, --skip-bytes=BYTES\n         skip BYTES input bytes first\n"
msgstr "  -j, --skip-bytes=BYTE\n         hoppa först över BYTE byte i indata\n"

#. from tp:coreutils-9.10-pre1
msgid "  -N, --read-bytes=BYTES\n         limit dump to BYTES input bytes\n"
msgstr "  -N, --read-bytes=BYTE\n         begränsa utmatning till BYTE byte från indata\n"

#. from tp:coreutils-9.10-pre1
msgid "  -S BYTES, --strings[=BYTES]\n         show only NUL terminated strings\n         of at least BYTES (default 3) printable characters\n"
msgstr "  -S BYTE, --strings[=BYTE]\n         visa endast NUL-avslutade strängar\n         med åtminstone BYTE (3 som standard) skrivbara tecken\n"

#. from tp:coreutils-9.10-pre1
msgid "  -t, --format=TYPE\n         select output format or formats\n"
msgstr "  -t, --format=TYP\n         välj format för utmatning\n"

#. from tp:coreutils-9.10-pre1
msgid "  -v, --output-duplicates\n         do not use * to mark line suppression\n"
msgstr "  -v, --output-duplicates\n         använd inte * för att markera undertryckta rader\n"

#. from tp:coreutils-9.10-pre1
msgid "  -w[BYTES], --width[=BYTES]\n         output BYTES bytes per output line;\n         32 is implied when BYTES is not specified\n"
msgstr "  -w[BYTE], --width[=BYTE]\n         skriv ut BYTE byte per rad;\n         32 underförstås när BYTE inte anges\n"

#. from tp:coreutils-9.10-pre1
msgid "      --traditional\n         accept arguments in third form above\n"
msgstr "      --traditional\n         acceptera argument i tredje formatet ovan\n"

#. from tp:coreutils-9.10-pre1
msgid "\n\nTraditional format specifications may be intermixed; they accumulate:\n"
msgstr "\n\nTraditionella formatspecifikationer kan blandas, de ackumuleras:\n"

#. from tp:coreutils-9.10-pre1
msgid "  -a   same as -t a,  select named characters, ignoring high-order bit\n"
msgstr "   -a   samma som -t a,  välj namngivna tecken, ignorera den mest signifikanta biten\n"

#. from tp:coreutils-9.10-pre1
msgid "  -b   same as -t o1, select octal bytes\n"
msgstr "   -b   samma som -t o1, välj oktala byte\n"

#. from tp:coreutils-9.10-pre1
msgid "  -c   same as -t c,  select printable characters or backslash escapes\n"
msgstr "   -c   samma som -t c,  välj skrivbara tecken eller sekvenser med omvänt\n        snedstreck\n"

#. from tp:coreutils-9.10-pre1
msgid "  -d   same as -t u2, select unsigned decimal 2-byte units\n"
msgstr "   -d   samma som -t u2, välj decimala 2-byteenheter utan förtecken\n"

#. from tp:coreutils-9.10-pre1
msgid "  -f   same as -t fF, select floats\n"
msgstr "   -f   samma som -t fF, välj flyttal\n"

#. from tp:coreutils-9.10-pre1
msgid "  -i   same as -t dI, select decimal ints\n"
msgstr "   -i   samma som -t dI, välj decimala heltal\n"

#. from tp:coreutils-9.10-pre1
msgid "  -l   same as -t dL, select decimal longs\n"
msgstr "   -l   samma som -t dL, välj decimala långa heltal\n"

#. from tp:coreutils-9.10-pre1
msgid "  -o   same as -t o2, select octal 2-byte units\n"
msgstr "   -o   samma som -t o2, välj oktala 2-byteenheter\n"

#. from tp:coreutils-9.10-pre1
msgid "  -s   same as -t d2, select decimal 2-byte units\n"
msgstr "   -s   samma som -t d2, välj decimala 2-byteenheter\n"

#. from tp:coreutils-9.10-pre1
msgid "  -x   same as -t x2, select hexadecimal 2-byte units\n"
msgstr "   -x   samma som -t x2, välj hexadecimala 2-byteenheter\n"

#. from tp:coreutils-9.10-pre1
msgid "\n\nTYPE is made up of one or more of these specifications:\n  a          named character, ignoring high-order bit\n  c          printable character or backslash escape\n"
msgstr "\n\nTYP skapas av en eller fler av dessa specifikationer:\n  a          namngivet tecken, ignorera den mest signifikanta biten\n  c          skrivbart tecken eller sekvens med omvänt snedstreck\n"

#. from tp:coreutils-9.10-pre1
msgid "  d[SIZE]    signed decimal, SIZE bytes per integer\n  f[SIZE]    floating point, SIZE bytes per float\n  o[SIZE]    octal, SIZE bytes per integer\n  u[SIZE]    unsigned decimal, SIZE bytes per integer\n  x[SIZE]    hexadecimal, SIZE bytes per integer\n"
msgstr "  d[STORLEK] decimalt med förtecken, STORLEK byte per heltal\n  f[STORLEK] flyttal, STORLEK byte per flyttal\n  o[STORLEK] oktalt, STORLEK byte per heltal\n  u[STORLEK] decimalt utan förtecken, STORLEK byte per heltal\n  x[STORLEK] hexadecimalt, STORLEK byte per heltal\n"

#. from tp:coreutils-9.10-pre1
msgid "\nSIZE is a number.  For TYPE in [doux], SIZE may also be C for\nsizeof(char), S for sizeof(short), I for sizeof(int) or L for\nsizeof(long).  If TYPE is f, SIZE may also be B for Brain 16 bit,\nH for Half precision float, F for sizeof(float), D for sizeof(double),\nor L for sizeof(long double).\n"
msgstr "\nSTORLEK är ett tal. För TYP i [doux] kan STORLEK också vara C för\nsizeof(char), S för sizeof(short), I för sizeof(int) eller L för\nsizeof(long).  Om TYP är f kan STORLEK också vara B för Brain 16-bitars flyttal,\nH för flyttal med halv precision, F för sizeof(float), D för sizeof(double)\neller L för sizeof(long double).\n"

#. from tp:coreutils-9.10-pre1
msgid "\nAdding a z suffix to any type displays printable characters at the end of\neach output line.\n"
msgstr "\nAtt lägga till ett z-suffix till valfri typ visar skrivbara tecken vid slutet\nav varje utdatarad.\n"

#. from tp:coreutils-9.10-pre1
msgid "\n\nBYTES is hex with 0x or 0X prefix, and may have a multiplier suffix:\n  b    512\n  KB   1000\n  K    1024\n  MB   1000*1000\n  M    1024*1024\nand so on for G, T, P, E, Z, Y, R, Q.\nBinary prefixes can be used, too: KiB=K, MiB=M, and so on.\n"
msgstr "\n\nBYTE är hex med prefixet 0x eller 0X, och kan ha en multiplikativ ändelse:\n  b    512\n  KB   1000\n  K    1024\n  MB   1000·1000\n  M    1024·1024\noch så vidare för G, T, P, E, Z, Y, R, Q.\nBinära prefix kan också användas: KiB=K, MiB=M, och så vidare.\n"

#. from tp:coreutils-9.10-pre1
msgid "invalid type string %s"
msgstr "ogiltig typsträng %s"

#. from tp:coreutils-9.10-pre1
msgid "invalid type string %s;\nthis system doesn't provide a %d-byte integral type"
msgstr "ogiltig typsträng %s;\ndetta system har ingen heltalstyp på %d byte"

#. from tp:coreutils-9.10-pre1
msgid "invalid type string %s;\nthis system doesn't provide a %d-byte floating point type"
msgstr "ogiltig typsträng %s;\ndetta system har ingen flyttalstyp på %d byte"

