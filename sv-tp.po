msgstr "%2.2f mm"

#. from tp:libexif-0.6.25
msgid "Maker Note Version"
msgstr "Version av tillverkaranteckning"

#. from tp:libexif-0.6.25
msgid "This number is unique and based on the date of manufacture."
msgstr "Detta tal är unikt och baserat på tillverkningsdatum."

#. from tp:libexif-0.6.25
msgid "Chromaticity Saturation"
msgstr "Krominansmättnad"

#. from tp:libexif-0.6.25
msgid "Flash Firing Strength Compensation"
msgstr "Kompensation för blixtstyrka"

#. from tp:libexif-0.6.25
msgid "Focusing Mode"
msgstr "Fokuseringsläge"

#. from tp:libexif-0.6.25
msgid "Focus Point"
msgstr "Fokuseringspunkt"

#. from tp:libexif-0.6.25
msgid "Slow Synchro Mode"
msgstr "Läge för långsam synkronisering"

#. from tp:libexif-0.6.25
msgid "Picture Mode"
msgstr "Bildläge"

#. from tp:libexif-0.6.25
msgid "Continuous Taking"
msgstr "Kontinuerlig tagning"

#. from tp:libexif-0.6.25
msgid "Continuous Sequence Number"
msgstr "Sekvensnummer för kontinuerlig tagning"

#. from tp:libexif-0.6.25
msgid "FinePix Color"
msgstr "FinePix-färg"

#. from tp:libexif-0.6.25
msgid "Blur Check"
msgstr "Oskärpekontroll"

#. from tp:libexif-0.6.25
msgid "Auto Focus Check"
msgstr "Autofokuskontroll"

#. from tp:libexif-0.6.25
msgid "Auto Exposure Check"
msgstr "Autoexponeringskontroll"

#. from tp:libexif-0.6.25
msgid "Dynamic Range"
msgstr "Dynamiskt omfång"

#. from tp:libexif-0.6.25
msgid "Film Simulation Mode"
msgstr "Filmsimuleringsläge"

#. from tp:libexif-0.6.25
msgid "Dynamic Range Wide Mode"
msgstr "Läge för brett dynamiskt omfång"

#. from tp:libexif-0.6.25
msgid "Development Dynamic Range Wide Mode"
