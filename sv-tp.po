#. from tp:gcc-16.1-b20260222
msgid "  -pass-exit-codes         Exit with highest error code from a phase.\n"
msgstr "  -pass-exit-codes         Avsluta med högsta felkoden från någon av faserna.\n"

#. from tp:gcc-16.1-b20260222
msgid "  --help                   Display this information.\n"
msgstr "  --help                   Visa den här informationen.\n"

#. from tp:gcc-16.1-b20260222
msgid "  --target-help            Display target specific command line options (including assembler and linker options).\n"
msgstr "  --target-help            Visa målspecifika kommandoradsflaggor (inklusive assembler- och länkarflaggor).\n"

#. from tp:gcc-16.1-b20260222
msgid "  --help={common|optimizers|params|target|warnings|[^]{joined|separate|undocumented}}[,...].\n"
msgstr "  --help={common|optimizers|params|target|warnings|[^]{joined|separate|undocumented}}[,…].\n"

#. from tp:gcc-16.1-b20260222
msgid "                           Display specific types of command line options.\n"
msgstr "                           Visa specifika typer av kommandoradsflaggor.\n"

#. from tp:gcc-16.1-b20260222
msgid "  (Use '-v --help' to display command line options of sub-processes).\n"
msgstr "  (Använd ”-v --help” för att visa kommandoradsflaggor för barnprocesser).\n"

#. from tp:gcc-16.1-b20260222
msgid "  --version                Display compiler version information.\n"
msgstr "  --version                Visa information om kompilatorversion.\n"

#. from tp:gcc-16.1-b20260222
msgid "  -dumpspecs               Display all of the built in spec strings.\n"
msgstr "  -dumpspecs               Visa de inbyggda spec-strängarna.\n"

#. from tp:gcc-16.1-b20260222
msgid "  -dumpversion             Display the version of the compiler.\n"
msgstr "  -dumpversion             Visa kompilatorns version.\n"

#. from tp:gcc-16.1-b20260222
msgid "  -dumpmachine             Display the compiler's target processor.\n"
msgstr "  -dumpmachine             Visa kompilatorns målprocessor.\n"

#. from tp:gcc-16.1-b20260222
msgid "  -foffload=<targets>      Specify offloading targets.\n"
msgstr "  -foffload=<mål>          Ange mål att lasta av till.\n"

#. from tp:gcc-16.1-b20260222
msgid "  -print-search-dirs       Display the directories in the compiler's search path.\n"
msgstr "  -print-search-dirs       Visa katalogerna i kompilatorns sökväg.\n"

#. from tp:gcc-16.1-b20260222
msgid "  -print-libgcc-file-name  Display the name of the compiler's companion library.\n"
msgstr "  -print-libgcc-file-name  Visa namnet på kompilatorns medföljande bibliotek.\n"

#. from tp:gcc-16.1-b20260222
msgid "  -print-file-name=<lib>   Display the full path to library <lib>.\n"
msgstr "  -print-file-name=<bib>   Visa hela sökvägen till länkbibliotek <bib>.\n"

#. from tp:gcc-16.1-b20260222
msgid "  -print-prog-name=<prog>  Display the full path to compiler component <prog>.\n"
msgstr "  -print-prog-name=<prog>  Visa hela sökvägen till kompilatorkomponenten <prog>.\n"

#. from tp:gcc-16.1-b20260222
msgid "  -print-multiarch         Display the target's normalized GNU triplet, used as\n                           a component in the library path.\n"
msgstr "  -print-multiarch         Visa målets normaliserade GNU-trippel, använd som\n                           en del i bibliotekssökvägen.\n"

#. from tp:gcc-16.1-b20260222
msgid "  -print-multi-directory   Display the root directory for versions of libgcc.\n"
msgstr "  -print-multi-directory   Visa rotkatalogen för olika versioner av libgcc.\n"

#. from tp:gcc-16.1-b20260222
msgid "  -print-multi-lib         Display the mapping between command line options and\n                           multiple library search directories.\n"
msgstr "  -print-multi-lib         Visa avbildningen mellan kommandoradsflaggor och\n                           flera biblioteks sökkataloger.\n"

#. from tp:gcc-16.1-b20260222
msgid "  -print-multi-os-directory Display the relative path to OS libraries.\n"
msgstr "  -print-multi-os-directory Visa den relativa sökvägen till OS-bibliotek.\n"

#. from tp:gcc-16.1-b20260222
msgid "  -print-sysroot           Display the target libraries directory.\n"
msgstr "  -print-sysroot           Visa katalogen för målbibliotek.\n"

#. from tp:gcc-16.1-b20260222
msgid "  -print-sysroot-headers-suffix Display the sysroot suffix used to find headers.\n"
msgstr "  -print-sysroot-headers-suffix Visa sysroot-suffixet som används för att hitta huvudfiler.\n"

#. from tp:gcc-16.1-b20260222
msgid "  -Wa,<options>            Pass comma-separated <options> on to the assembler.\n"
msgstr "  -Wa,<flaggor>            Skicka kommaseparerade <flaggor> till assembleraren.\n"

#. from tp:gcc-16.1-b20260222
msgid "  -Wp,<options>            Pass comma-separated <options> on to the preprocessor.\n"
msgstr "  -Wp,<flaggor>            Skicka kommaseparerade <flaggor> till preprocessorn.\n"

#. from tp:gcc-16.1-b20260222
msgid "  -Wl,<options>            Pass comma-separated <options> on to the linker.\n"
msgstr "  -Wl,<flaggor>            Skicka kommaseparerade <flaggor> till länkaren.\n"

#. from tp:gcc-16.1-b20260222
msgid "  -Xassembler <arg>        Pass <arg> on to the assembler.\n"
msgstr "  -Xassembler <arg>        Skicka <arg> vidare till assemblern.\n"

#. from tp:gcc-16.1-b20260222
msgid "  -Xpreprocessor <arg>     Pass <arg> on to the preprocessor.\n"
msgstr "  -Xpreprocessor <arg>     Skicka <arg> vidare till preprocessorn.\n"

#. from tp:gcc-16.1-b20260222
msgid "  -Xlinker <arg>           Pass <arg> on to the linker.\n"
msgstr "  -Xlinker <arg>           Skicka <arg> vidare till länkaren.\n"

#. from tp:gcc-16.1-b20260222
msgid "  -save-temps              Do not delete intermediate files.\n"
msgstr "  -save-temps              Radera inte temporära filer.\n"

#. from tp:gcc-16.1-b20260222
msgid "  -save-temps=<arg>        Do not delete intermediate files.\n"
msgstr "  -save-temps=<arg>        Radera inte temporära filer.\n"

#. from tp:gcc-16.1-b20260222
msgid "  -no-canonical-prefixes   Do not canonicalize paths when building relative\n                           prefixes to other gcc components.\n"
msgstr "  -no-canonical-prefixes   Kanonisera inte sökvägar när relativa prefix\n                           byggs till andra gcc-komponenter.\n"

#. from tp:gcc-16.1-b20260222
msgid "  -pipe                    Use pipes rather than intermediate files.\n"
msgstr "  -pipe                    Använd rör istället för temporära filer.\n"

#. from tp:gcc-16.1-b20260222
msgid "  -time                    Time the execution of each subprocess.\n"
msgstr "  -time                    Mät tiden det tar att exekvera varje barnprocess.\n"

#. from tp:gcc-16.1-b20260222
msgid "  -specs=<file>            Override built-in specs with the contents of <file>.\n"
msgstr "  -specs=<fil>             Ersätt inbyggda specs med innehållet i <fil>.\n"

#. from tp:gcc-16.1-b20260222
msgid "  -std=<standard>          Assume that the input sources are for <standard>.\n"
msgstr "  -std=<standard>          Anta att källkodsfilerna följer <standard>.\n"

#. from tp:gcc-16.1-b20260222
msgid "  --sysroot=<directory>    Use <directory> as the root directory for headers\n                           and libraries.\n"
msgstr "  --sysroot=<katalog>      Använd <katalog> som rotkatalogen för huvuden och\n                           bibliotek.\n"

#. from tp:gcc-16.1-b20260222
msgid "  -B <directory>           Add <directory> to the compiler's search paths.\n"
msgstr "  -B <katalog>             Lägg till <katalog> till kompilatorns sökvägar.\n"

#. from tp:gcc-16.1-b20260222
msgid "  -v                       Display the programs invoked by the compiler.\n"
msgstr "  -v                       Visa vilka program som körs av kompilatorn.\n"

#. from tp:gcc-16.1-b20260222
msgid "  -###                     Like -v but options quoted and commands not executed.\n"
msgstr "  -###                     Som -v men med citerade flaggor och utan att köra kommandon.\n"

#. from tp:gcc-16.1-b20260222
msgid "  -E                       Preprocess only; do not compile, assemble or link.\n"
msgstr "  -E                       Preprocessa bara; kompilera, assemblera och\n                           länka inte.\n"

#. from tp:gcc-16.1-b20260222
msgid "  -S                       Compile only; do not assemble or link.\n"
msgstr "  -S                       Kompilera bara; assemblera och länka inte.\n"

#. from tp:gcc-16.1-b20260222
msgid "  -c                       Compile and assemble, but do not link.\n"
msgstr "  -c                       Kompilera och assemblera, men länka inte.\n"

#. from tp:gcc-16.1-b20260222
msgid "  -o <file>                Place the output into <file>.\n"
msgstr "  -o <fil>                 Placera utdata i <fil>.\n"

#. from tp:gcc-16.1-b20260222
msgid "  -pie                     Create a dynamically linked position independent\n                           executable.\n"
msgstr "  -pie                     Skapa ett dynamiskt länkat positionsoberoende\n                           körbart program.\n"

#. from tp:gcc-16.1-b20260222
msgid "  -shared                  Create a shared library.\n"
msgstr "  -shared                  Skapa ett delat bibliotek.\n"

#. from tp:gcc-16.1-b20260222
msgid "  -x <language>            Specify the language of the following input files.\n                           Permissible languages include: c c++ assembler none\n                           'none' means revert to the default behavior of\n                           guessing the language based on the file's extension.\n"
msgstr "  -x <språk>               Ange språket för följande källkodsfiler.\n                           Tillåtna språk omfattar: c c++ assembler none\n                           ”none” innebär återgång till standardbeteendet\n                           att gissa språk utifrån filändelsen.\n"

#. from tp:gcc-16.1-b20260222
msgid "\nOptions starting with -g, -f, -m, -O, -W, or --param are automatically\n passed on to the various sub-processes invoked by %s.  In order to pass\n other options on to these processes the -W<letter> options must be used.\n"
msgstr "\nFlaggor som börjar med -g, -f, -m, -O, -W eller --param skickas automatiskt\nvidare till de barnprocesser som startas av %s. För att skicka med andra\nflaggor till dessa processer måste flaggan -W<bokstav> användas.\n"

#. from tp:gcc-16.1-b20260222
msgid "Processing spec (%s), which is '%s'\n"
msgstr "Bearbetar specifikationen (%s), som är ”%s”\n"

#. from tp:gcc-16.1-b20260222
msgid "Target: %s\n"
msgstr "Mål: %s\n"

#. from tp:gcc-16.1-b20260222
msgid "Configured with: %s\n"
msgstr "Konfigurerad med: %s\n"

#. from tp:gcc-16.1-b20260222
msgid "Thread model: %s\n"
