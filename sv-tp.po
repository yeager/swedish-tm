msgid "Device %s is not a valid LUKS2 device."
msgstr "Enheten %s är inte en giltig LUKS2-enhet."

#. from tp:cryptsetup-2.8.2-rc0
msgid "Enter new passphrase for key slot: "
msgstr "Ange ny lösenfras för nyckelplats: "

