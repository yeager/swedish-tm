msgstr "  -p\n         arbeta på ett bättre SÄTT med rör\n"

#. from tp:coreutils-9.10-pre1
msgid "      --output-error[=MODE]\n         set behavior on write error.  See MODE below\n"
msgstr "      --output-error[=SÄTT]\n         ange beteende vid skrivfel.  Se SÄTT nedan\n"

#. from tp:coreutils-9.10-pre1
msgid "\nMODE determines behavior with write errors on the outputs:\n  warn           diagnose errors writing to any output\n  warn-nopipe    diagnose errors writing to any output not a pipe\n  exit           exit on error writing to any output\n  exit-nopipe    exit on error writing to any output not a pipe\nThe default MODE for the -p option is 'warn-nopipe'.\nWith \"nopipe\" MODEs, exit immediately if all outputs become broken pipes.\nThe default operation when --output-error is not specified, is to\nexit immediately on error writing to a pipe, and diagnose errors\nwriting to non pipe outputs.\n"
msgstr "\nSÄTT avgör beteendet med skrivfel i utmatningarna:\n  warn           diagnostisera fel vid skrivning till godtycklig utmatning\n  warn-nopipe    diagnostisera fel vid skrivning till utmatning som inte är rör\n  exit           avsluta vid fel vid skrivning till godtycklig utmatning\n  exit-nopipe    avsluta vid fel vid skrivning till utmatning som inte är rör\nStandardSÄTT med flaggan -p är ”warn-nopipe”.\nMed ”nopipe”-lägen avslutas programmet genast om alla utmatningar blir brutna rör.\nStandardbeteendet när --output-error inte anges är att avsluta omedelbart\nvid fel vid skrivning till ett rör, och diagnostisera fel vid skrivning till\nannat än rör.\n"

#. from tp:coreutils-9.10-pre1
msgid "iopoll error"
msgstr "iopoll-fel"

#. from tp:coreutils-9.10-pre1
msgid "failed to make temporary file name"
msgstr "misslyckades med att skapa ett temporärfilsnamn"

#. from tp:coreutils-9.10-pre1
msgid "failed to create temporary file %s"
msgstr "misslyckades med att skapa en temporärfil %s"

#. from tp:coreutils-9.10-pre1
msgid "failed to open %s for writing"
msgstr "misslyckades med att öppna %s för skrivning"

#. from tp:coreutils-9.10-pre1
msgid "failed to rewind stream for %s"
msgstr "misslyckades med att spola tillbaka strömmen för %s"

#. from tp:coreutils-9.10-pre1
msgid "missing argument after %s"
msgstr "argument saknas efter %s"

#. from tp:coreutils-9.10-pre1
msgid "invalid integer %s"
msgstr "ogiltigt heltal %s"

#. from tp:coreutils-9.10-pre1
msgid "%s expected"
msgstr "%s förväntades"

#. from tp:coreutils-9.10-pre1
msgid "%s expected, found %s"
msgstr "%s förväntades, fann %s"

#. from tp:coreutils-9.10-pre1
msgid "%s does not accept -l"
msgstr "%s tar inte -l"

#. from tp:coreutils-9.10-pre1
msgid "-ef does not accept -l"
msgstr "-ef tar inte -l"

#. from tp:coreutils-9.10-pre1
msgid "Usage: test EXPRESSION\n  or:  test\n  or:  [ EXPRESSION ]\n  or:  [ ]\n  or:  [ OPTION\n"
msgstr "Användning: test UTTRYCK\n   eller:   test\n   eller:   [ UTTRYCK ]\n   eller:   [ ]\n   eller:   [ FLAGGA\n"

#. from tp:coreutils-9.10-pre1
msgid "Exit with the status determined by EXPRESSION.\n\n"
msgstr "Avsluta med status som bestäms av UTTRYCK.\n\n"

#. from tp:coreutils-9.10-pre1
msgid "\nAn omitted EXPRESSION defaults to false.  Otherwise,\nEXPRESSION is true or false and sets exit status.  It is one of:\n"
msgstr "\nEtt utelämnat UTTRYCK behandlas som falskt.  Annars är UTTRYCK sant\neller falskt och sätter returvärdet. Det är något av:\n"

#. from tp:coreutils-9.10-pre1
msgid "\n  ( EXPRESSION )               EXPRESSION is true\n  ! EXPRESSION                 EXPRESSION is false\n  EXPRESSION1 -a EXPRESSION2   both EXPRESSION1 and EXPRESSION2 are true\n  EXPRESSION1 -o EXPRESSION2   either EXPRESSION1 or EXPRESSION2 is true\n"
msgstr "\n  ( UTTRYCK )                  UTTRYCK är sant\n  ! UTTRYCK                    UTTRYCK är falskt\n  UTTRYCK1 -a UTTRYCK2         både UTTRYCK1 och UTTRYCK2 är sanna\n  UTTRYCK1 -o UTTRYCK2         något av UTTRYCK1 eller UTTRYCK2 är sant\n"

#. from tp:coreutils-9.10-pre1
msgid "  -n STRING            the length of STRING is nonzero\n"
msgstr "  -n STRÄNG            längden på STRÄNG är inte noll\n"

#. from tp:coreutils-9.10-pre1
msgid "  STRING               equivalent to -n STRING\n"
msgstr "  STRÄNG               likvärdigt med -n STRÄNG\n"

#. from tp:coreutils-9.10-pre1
msgid "  -z STRING            the length of STRING is zero\n"
msgstr "  -z STRÄNG            längden på STRÄNG är noll\n"

#. from tp:coreutils-9.10-pre1
msgid "  STRING1 = STRING2    the strings are equal\n  STRING1 != STRING2   the strings are not equal\n  STRING1 > STRING2    STRING1 is greater than STRING2 in the current locale\n  STRING1 < STRING2    STRING1 is less than STRING2 in the current locale\n"
msgstr "  STRÄNG1 = STRÄNG2    strängarna är lika\n  STRÄNG1 != STRÄNG2   strängarna är inte lika\n  STRÄNG1 > STRÄNG2    STRÄNG1 är större än STRÄNG2 i den aktuella lokalen\n  STRÄNG1 < STRÄNG2    STRÄNG1 är mindre än STRÄNG2 i den aktuella lokalen\n"

#. from tp:coreutils-9.10-pre1
msgid "  INTEGER1 -eq INTEGER2   INTEGER1 is equal to INTEGER2\n"
msgstr "  HELTAL1 -eq HELTAL2     HELTAL1 är lika med HELTAL2\n"

#. from tp:coreutils-9.10-pre1
msgid "  INTEGER1 -ge INTEGER2   INTEGER1 is greater than or equal to INTEGER2\n"
msgstr "  HELTAL1 -ge HELTAL2     HELTAL1 är större än eller lika med HELTAL2\n"

#. from tp:coreutils-9.10-pre1
msgid "  INTEGER1 -gt INTEGER2   INTEGER1 is greater than INTEGER2\n"
msgstr "  HELTAL1 -gt HELTAL2     HELTAL1 är större än HELTAL2\n"

#. from tp:coreutils-9.10-pre1
msgid "  INTEGER1 -le INTEGER2   INTEGER1 is less than or equal to INTEGER2\n"
msgstr "  HELTAL1 -le HELTAL2     HELTAL1 är mindre än eller lika med HELTAL2\n"

#. from tp:coreutils-9.10-pre1
msgid "  INTEGER1 -lt INTEGER2   INTEGER1 is less than INTEGER2\n"
msgstr "  HELTAL1 -lt HELTAL2     HELTAL1 är mindre än HELTAL2\n"

#. from tp:coreutils-9.10-pre1
msgid "  INTEGER1 -ne INTEGER2   INTEGER1 is not equal to INTEGER2\n"
msgstr "  HELTAL1 -ne HELTAL2     HELTAL1 är inte lika med HELTAL2\n"

#. from tp:coreutils-9.10-pre1
msgid "  FILE1 -ef FILE2   FILE1 and FILE2 have the same device and inode numbers\n"
msgstr "  FIL1 -ef FIL2     FIL1 och FIL2 har samma enhets- och inodnummer\n"

#. from tp:coreutils-9.10-pre1
msgid "  FILE1 -nt FILE2   FILE1 is newer (modification date) than FILE2\n"
msgstr "  FIL1 -nt FIL2     FIL1 är nyare (ändringstidpunkt) än FIL2\n"

#. from tp:coreutils-9.10-pre1
msgid "  FILE1 -ot FILE2   FILE1 is older than FILE2\n"
msgstr "  FIL1 -ot FIL2     FIL1 är äldre än FIL2\n"

#. from tp:coreutils-9.10-pre1
msgid "  -b FILE     FILE exists and is block special\n"
msgstr "  -b FIL      FIL finns och är en specialfil för blockåtkomst\n"

#. from tp:coreutils-9.10-pre1
msgid "  -c FILE     FILE exists and is character special\n"
msgstr "  -c FIL      FIL finns och är en specialfil för teckenåtkomst\n"

#. from tp:coreutils-9.10-pre1
msgid "  -d FILE     FILE exists and is a directory\n"
msgstr "  -d FIL      FIL finns och är en katalog\n"

#. from tp:coreutils-9.10-pre1
msgid "  -e FILE     FILE exists\n"
msgstr "  -e FIL      FIL finns\n"

#. from tp:coreutils-9.10-pre1
msgid "  -f FILE     FILE exists and is a regular file\n"
msgstr "  -f FIL      FIL finns och är en vanlig fil\n"

#. from tp:coreutils-9.10-pre1
msgid "  -g FILE     FILE exists and is set-group-ID\n"
msgstr "  -g FIL      FIL finns och har sätt-grupp-ID-biten satt\n"

#. from tp:coreutils-9.10-pre1
msgid "  -G FILE     FILE exists and is owned by the effective group ID\n"
msgstr "  -G FIL      FIL finns och ägs av gruppen med effektivt grupp-ID\n"

#. from tp:coreutils-9.10-pre1
msgid "  -h FILE     FILE exists and is a symbolic link (same as -L)\n"
msgstr "  -h FIL      FIL finns och är en symbolisk länk (samma som -L)\n"

#. from tp:coreutils-9.10-pre1
msgid "  -k FILE     FILE exists and has its sticky bit set\n"
msgstr "  -k FIL      FIL finns med fastbiten satt\n"

#. from tp:coreutils-9.10-pre1
msgid "  -L FILE     FILE exists and is a symbolic link (same as -h)\n"
msgstr "  -L FIL      FIL finns och är en symbolisk länk (samma som -h)\n"

#. from tp:coreutils-9.10-pre1
msgid "  -N FILE     FILE exists and has been modified since it was last read\n"
msgstr "  -N FIL      FIL finns och har ändrats sedan den senast lästes\n"

#. from tp:coreutils-9.10-pre1
msgid "  -O FILE     FILE exists and is owned by the effective user ID\n"
msgstr "  -O FIL      FIL finns och ägs av användaren med effektivt användar-ID\n"

#. from tp:coreutils-9.10-pre1
msgid "  -p FILE     FILE exists and is a named pipe\n"
msgstr "  -p FIL      FIL finns och är ett namngivet rör\n"

#. from tp:coreutils-9.10-pre1
msgid "  -r FILE     FILE exists and the user has read access\n"
msgstr "  -r FIL      FIL finns och användaren har läsåtkomst\n"

#. from tp:coreutils-9.10-pre1
msgid "  -s FILE     FILE exists and has a size greater than zero\n"
msgstr "  -s FIL      FIL finns och har större storlek än noll\n"

#. from tp:coreutils-9.10-pre1
msgid "  -S FILE     FILE exists and is a socket\n"
msgstr "  -S FIL      FIL existerar och är ett uttag (socket)\n"

#. from tp:coreutils-9.10-pre1
msgid "  -t FD       file descriptor FD is opened on a terminal\n"
msgstr "  -t FI       filidentifierare FI är öppnad mot en terminal\n"

#. from tp:coreutils-9.10-pre1
msgid "  -u FILE     FILE exists and its set-user-ID bit is set\n"
msgstr "  -u FIL      FIL existerar och dess set-user-ID-bit är satt\n"

#. from tp:coreutils-9.10-pre1
msgid "  -w FILE     FILE exists and the user has write access\n"
msgstr "  -w FIL      FIL existerar och användaren har skrivåtkomst\n"

#. from tp:coreutils-9.10-pre1
msgid "  -x FILE     FILE exists and the user has execute (or search) access\n"
msgstr "  -x FIL      FIL existerar och användaren har kör- (eller sök)åtkomst\n"

#. from tp:coreutils-9.10-pre1
msgid "\nExcept for -h and -L, all FILE-related tests dereference symbolic links.\nBeware that parentheses need to be escaped (e.g., by backslashes) for shells.\nINTEGER may also be -l STRING, which evaluates to the length of STRING.\n"
msgstr "\nFörutom för -h och -L följer alla filrelaterade tester symboliska länkar.\nObservera att parenteser måste skyddas från skalets tolkning\n(t.ex. med omvända snedstreck). HELTAL kan också vara -l STRÄNG,\nsom ger längden på STRÄNG.\n"

#. from tp:coreutils-9.10-pre1
msgid "\nBinary -a and -o are ambiguous.  Use 'test EXPR1 && test EXPR2'\nor 'test EXPR1 || test EXPR2' instead.\n"
msgstr "\nBinära -a och -o är tvetydiga.  Använd ”test UTTR1 && test UTTR2”\neller ”test UTTR1 || test UTTR2” istället.\n"

#. from tp:coreutils-9.10-pre1
msgid "\n'[' honors --help and --version, but 'test' treats them as STRINGs.\n"
msgstr "\n”[” respekterar --help och --version, men ”test” behandlar dem som STRÄNGar.\n"

#. from tp:coreutils-9.10-pre1
msgid "test and/or ["
msgstr "test och/eller ["

#. from tp:coreutils-9.10-pre1
msgid "Kevin Braunsdorf"
msgstr "Kevin Braunsdorf"

#. from tp:coreutils-9.10-pre1
msgid "Matthew Bradburn"
msgstr "Matthew Bradburn"

#. from tp:coreutils-9.10-pre1
msgid "missing %s"
msgstr "%s saknas"

#. from tp:coreutils-9.10-pre1
msgid "extra argument %s"
msgstr "extra argument %s"

#. from tp:coreutils-9.10-pre1
msgid "warning: timer_settime"
msgstr "varning: timer_settime"

#. from tp:coreutils-9.10-pre1
msgid "warning: timer_create"
msgstr "varning: timer_create"

#. from tp:coreutils-9.10-pre1
msgid "warning: setitimer"
msgstr "varning: setitimer"

#. from tp:coreutils-9.10-pre1
msgid "sending signal %s to command %s"
msgstr "skickar signalen %s till kommandot: %s"

#. from tp:coreutils-9.10-pre1
msgid "Usage: %s [OPTION]... DURATION COMMAND [ARG]...\n"
msgstr "Användning: %s [FLAGGA]… LÖPTID KOMMANDO [ARG]…\n"

#. from tp:coreutils-9.10-pre1
msgid "Start COMMAND, and kill it if still running after DURATION.\n"
msgstr "Starta KOMMANDO, och döda det om det fortfarande körs efter LÖPTID.\n"

#. from tp:coreutils-9.10-pre1
msgid "  -f, --foreground\n         when not running timeout directly from a shell prompt,\n         allow COMMAND to read from the TTY and get TTY signals;\n         in this mode, children of COMMAND will not be timed out\n"
msgstr "  -f, --foreground\n         när timeout inte körs direkt från en skalprompt,\n         tillåt KOMMANDO att läsa från TTY:n och få TTY-signaler;\n         i detta läge gäller tidsgränsen inte barnprocesser till KOMMANDO\n"

#. from tp:coreutils-9.10-pre1
msgid "  -k, --kill-after=DURATION\n         also send a KILL signal if COMMAND is still running\n         this long after the initial signal was sent\n"
msgstr "  -k, --kill-after=LÖPTID\n         skicka även en KILL-signal om KOMMANDO fortfarande körs\n         så här länge efter att den ursprungliga signalen skickades\n"

#. from tp:coreutils-9.10-pre1
msgid "  -p, --preserve-status\n         exit with the same status as COMMAND,\n         even when the command times out\n"
msgstr "  -p, --preserve-status\n         avsluta med samma status som KOMMANDO,\n         även när tiden för kommandot löper ut\n"

#. from tp:coreutils-9.10-pre1
msgid "  -s, --signal=SIGNAL\n         specify the signal to be sent on timeout;\n         SIGNAL may be a name like 'HUP' or a number;\n         see 'kill -l' for a list of signals\n"
msgstr "  -s, --signal=SIGNAL\n         ange signalen som skall skickas när tiden går ut;\n         SIGNAL kan vara ett namn som ”HUP” eller ett nummer;\n         se ”kill -l” för en lista över signaler\n"

#. from tp:coreutils-9.10-pre1
msgid "  -v, --verbose\n         diagnose to standard error any signal sent upon timeout\n"
msgstr "  -v, --verbose\n         diagnostisera till standard fel signaler som skickas när tiden går ut\n"

#. from tp:coreutils-9.10-pre1
msgid "\nDURATION is a floating point number with an optional suffix:\n's' for seconds (the default), 'm' for minutes, 'h' for hours or 'd' for days.\nA duration of 0 disables the associated timeout.\n"
msgstr "\nLÖPTID är ett flyttal eventuellt följt av ett suffix:\n”s” för sekunder (standard), ”m” för minuter, ”h” för timmar eller ”d” för\ndagar.\n\nEn löptid på 0 avaktiverar den tillhörande tidsgränsen.\n"

#. from tp:coreutils-9.10-pre1
msgid "\nUpon timeout, send the TERM signal to COMMAND, if no other SIGNAL specified.\nThe TERM signal kills any process that does not block or catch that signal.\nIt may be necessary to use the KILL signal, since this signal can't be caught.\n"
msgstr "\nNär tiden går ut, skicka signalen TERM  till KOMMANDO, om ingen annan signal\nanges. Signalen TERM dödar en process som inte blockerar eller fångar den\nsignalen.  Det kan vara nödvändigt att använda signalen KILL, eftersom den\nsignalen inte kan fångas.\n"

#. from tp:coreutils-9.10-pre1
msgid "\nExit status:\n  124  if COMMAND times out, and --preserve-status is not specified\n  125  if the timeout command itself fails\n  126  if COMMAND is found but cannot be invoked\n  127  if COMMAND cannot be found\n  137  if COMMAND (or timeout itself) is sent the KILL (9) signal (128+9)\n  -    the exit status of COMMAND otherwise\n"
msgstr "\nSlutstatus:\n  124  om tidsgränsen för KOMMANDO överskrids och --preserve-status inte angivits\n  125  om kommandot timeout självt misslyckas\n  126  om KOMMANDO finns men inte kan köras\n  127  om KOMMANDO inte finns\n  137  om KOMMANDO (eller timeout självt) skickas signalen KILL (9) (128+9)\n  -    annars slutstatus från KOMMANDO\n"

#. from tp:coreutils-9.10-pre1
msgid "warning: sigprocmask"
msgstr "varning: sigprocmask"

#. from tp:coreutils-9.10-pre1
msgid "warning: disabling core dumps failed"
msgstr "varning: det gick inte att avaktivera minnesdumpar"

#. from tp:coreutils-9.10-pre1
msgid "fork system call failed"
msgstr "systemanropet fork misslyckades"

#. from tp:coreutils-9.10-pre1
msgid "child failed to reset signal mask"
msgstr "barnet misslyckades med att återställa signalmasken"

#. from tp:coreutils-9.10-pre1
msgid "error waiting for command"
msgstr "fel vid inväntande av kommando"

#. from tp:coreutils-9.10-pre1
msgid "the monitored command dumped core"
msgstr "det bevakade programmet skrev en minnesdump"

#. from tp:coreutils-9.10-pre1
msgid "unknown status from command (%d)"
msgstr "okänd status från kommando (%d)"

#. from tp:coreutils-9.10-pre1
msgid "Jim Kingdon"
msgstr "Jim Kingdon"

#. from tp:coreutils-9.10-pre1
msgid "Randy Smith"
msgstr "Randy Smith"

#. from tp:coreutils-9.10-pre1
msgid "invalid date format %s"
msgstr "felaktigt datumformat %s"

#. from tp:coreutils-9.10-pre1
msgid "cannot touch %s"
msgstr "kan inte uppdatera tidsstämplarna för %s"

#. from tp:coreutils-9.10-pre1
msgid "setting times of %s"
msgstr "sätter tider på %s"

#. from tp:coreutils-9.10-pre1
msgid "Update the access and modification times of each FILE to the current time.\n\nA FILE argument that does not exist is created empty, unless -c or -h\nis supplied.\n\nA FILE argument string of - is handled specially and causes touch to\nchange the times of the file associated with standard output.\n"
msgstr "Uppdatera åtkomst- och modifieringstiderna på varje fil till aktuell tid.\n\nEtt FIL-argument som inte finns skapas tomt, om inte -c eller -h anges.\n\nEn - som FIL-argumentsträng hanteras speciellt och får touch att ändra\ntiden på filen som är kopplad till standard ut.\n"

#. from tp:coreutils-9.10-pre1
msgid "  -a\n         change only the access time\n"
msgstr "  -a\n         ändra bara åtkomsttiden\n"

#. from tp:coreutils-9.10-pre1
msgid "  -c, --no-create\n         do not create any files\n"
msgstr "  -c, --no-create\n         skapa inga filer\n"

#. from tp:coreutils-9.10-pre1
msgid "  -d, --date=STRING\n         parse STRING and use it instead of current time\n"
msgstr "  -d, --date=STRÄNG\n         tolka STRÄNG och använd den istället för aktuell tid\n"

#. from tp:coreutils-9.10-pre1
msgid "  -f\n         (ignored)\n"
msgstr "  -f\n         (ignorerad)\n"

#. from tp:coreutils-9.10-pre1
msgid "  -h, --no-dereference\n         affect each symbolic link instead of any referenced file;\n         useful only on systems that can change the timestamps of a symlink\n"
msgstr "  -h, --no-dereference\n         ändra varje symbolisk länk istället för den refererade filen;\n         meningsfullt endast på system där det går att ändra tidsstämpel\n         på en symlänk\n"

#. from tp:coreutils-9.10-pre1
msgid "  -m\n         change only the modification time\n"
msgstr "  -m\n         ändra bara modifieringstiden\n"

#. from tp:coreutils-9.10-pre1
msgid "  -r, --reference=FILE\n         use this file's times instead of current time\n"
msgstr "  -r, --reference=FIL\n         använd denna FILs tider istället för aktuell tid\n"

#. from tp:coreutils-9.10-pre1
msgid "  -t [[CC]YY]MMDDhhmm[.ss]\n         use specified time instead of current time,\n         with a date-time format that differs from -d's\n"
msgstr "  -t [[ÅÅ]ÅÅ]MMDDhhmm[.ss]\n         använd den angivna tiden istället för aktuell tid,\n         med ett datum-tid-format som skiljer sig från -d:s\n"

#. from tp:coreutils-9.10-pre1
msgid "      --time=WORD\n         specify which time to change:\n         access time (-a): 'access', 'atime', 'use';\n         modification time (-m): 'modify', 'mtime'\n"
msgstr "      --time=ORD\n         ange vilken tid som ska ändras:\n         åtkomsttid (-a): ”access”, ”atime”, ”use”;\n         ändringstid (-m): ”modify”, ”mtime”\n"

#. from tp:coreutils-9.10-pre1
msgid "cannot specify times from more than one source"
msgstr "kan inte ange tider från mer än en källa"

#. from tp:coreutils-9.10-pre1
msgid "warning: 'touch %s' is obsolete; use 'touch -t %04ld%02d%02d%02d%02d.%02d'"
msgstr "varning: ”touch %s” är föråldrat; använd ”touch -t %04ld%02d%02d%02d%02d.%02d”"

#. from tp:coreutils-9.10-pre1
msgid "Usage: %s [OPTION]... STRING1 [STRING2]\n"
msgstr "Användning: %s [FLAGGA]… STRÄNG1 [STRÄNG2]\n"

#. from tp:coreutils-9.10-pre1
msgid "Translate, squeeze, and/or delete characters from standard input,\nwriting to standard output.  STRING1 and STRING2 specify arrays of\ncharacters ARRAY1 and ARRAY2 that control the action.\n\n"
msgstr "Översätt, pressa ihop och/eller ta bort tecken från standard in, skriv\ntill standard ut. STRÄNG1 och STRÄNG2 anger vektorer av tecken\nVEKTOR1 och VEKTOR2 som styr åtgärden.\n\n"

#. from tp:coreutils-9.10-pre1
msgid "  -c, -C, --complement\n         use the complement of ARRAY1\n"
msgstr "  -c, -C, --complement\n        använd komplementet av VEKTOR1\n"

#. from tp:coreutils-9.10-pre1
msgid "  -d, --delete\n         delete characters in ARRAY1, do not translate\n"
msgstr "  -d, --delete\n         ta bort tecken i VEKTOR1, översätt inte\n"

#. from tp:coreutils-9.10-pre1
msgid "  -s, --squeeze-repeats\n         replace each sequence of a repeated character\n         that is listed in the last specified ARRAY,\n         with a single occurrence of that character\n"
msgstr "  -s, --squeeze-repeats\n         ersätt varje sekvens av ett upprepat tecken\n         som är listat i den sist angivna VEKTORn,\n         med en ensam förekomst av det tecknet\n"

#. from tp:coreutils-9.10-pre1
msgid "  -t, --truncate-set1\n         first truncate ARRAY1 to length of ARRAY2\n"
msgstr "  -t, --truncate-set1\n         hugg först av VEKTOR1 till längden hos VEKTOR2\n"

#. from tp:coreutils-9.10-pre1
msgid "\nARRAYs are specified as strings of characters.  Most represent themselves.\nInterpreted sequences are:\n\n  \\NNN            character with octal value NNN (1 to 3 octal digits)\n  \\\\              backslash\n  \\a              audible BEL\n  \\b              backspace\n  \\f              form feed\n  \\n              new line\n  \\r              return\n  \\t              horizontal tab\n"
msgstr "\nVEKTORer anges som strängar av tecken.  De flesta representerar sig själva.\nFöljande sekvenser tolkas:\n\n  \\NNN            tecken med det oktala värdet NNN (1 till 3 oktala siffror)\n  \\\\              omvänt snedstreck\n  \\a              ljudsignalen BEL\n  \\b              backsteg\n  \\f              sidmatning\n  \\n              nyrad\n  \\r              vagnretur\n  \\t              horisontell tabulator\n"

#. from tp:coreutils-9.10-pre1
msgid "  \\v              vertical tab\n  CHAR1-CHAR2     all characters from CHAR1 to CHAR2 in ascending order\n  [CHAR*]         in ARRAY2, copies of CHAR until length of ARRAY1\n  [CHAR*REPEAT]   REPEAT copies of CHAR, REPEAT octal if starting with 0\n  [:alnum:]       all letters and digits\n  [:alpha:]       all letters\n  [:blank:]       all horizontal whitespace\n  [:cntrl:]       all control characters\n  [:digit:]       all digits\n"
msgstr "  \\v              vertikal tabulator\n  TECK1-TECK2     alla tecken från TECK1 till TECK2 i stigande ordning\n  [TECK*]         i VEKTOR2, repetera TECK upp till längden av VEKTOR1\n  [TECK*REP]      REP kopior av TECK, REP är oktalt om det startar med 0\n  [:alnum:]       alla bokstäver och siffror\n  [:alpha:]       alla bokstäver\n  [:blank:]       alla horisontella blanka\n  [:cntrl:]       alla styrtecken\n  [:digit:]       alla siffror\n"

#. from tp:coreutils-9.10-pre1
msgid "  [:graph:]       all printable characters, not including space\n  [:lower:]       all lower case letters\n  [:print:]       all printable characters, including space\n  [:punct:]       all punctuation characters\n  [:space:]       all horizontal or vertical whitespace\n  [:upper:]       all upper case letters\n  [:xdigit:]      all hexadecimal digits\n  [=CHAR=]        all characters which are equivalent to CHAR\n"
msgstr "  [:graph:]       alla skrivbara tecken, ej blanka\n  [:lower:]       alla gemena bokstäver\n  [:print:]       alla skrivbara tecken, inklusive mellanrum\n  [:punct:]       alla tecken för interpunktion\n  [:space:]       alla horisontella och vertikala blanka\n  [:upper:]       alla versala bokstäver\n  [:xdigit:]      alla hexadecimala siffror\n  [=TECKEN=]      alla tecken som är ekvivalenta med TECKEN\n"

#. from tp:coreutils-9.10-pre1
msgid "\nTranslation occurs if -d is not given and both STRING1 and STRING2 appear.\n-t is only significant when translating.  ARRAY2 is extended to length of\nARRAY1 by repeating its last character as necessary.  Excess characters\nof ARRAY2 are ignored.  Character classes expand in unspecified order;\nwhile translating, '[:lower:]' and '[:upper:]' may be used in pairs to\nspecify case conversion.  Squeezing occurs after translation or deletion.\nArguments like '[...]' should be quoted, to avoid potential shell globbing.\n"
msgstr "\nÖversättning sker om -d inte ges och både STRÄNG1 och STRÄNG2 förekommer.\n-t har endast betydelse vid översättning. VEKTOR2 expanderas till längden\nhos VEKTOR1 genom att dess sista tecken upprepas tillräckligt många \ngånger. Överflödiga tecken i VEKTOR2 ignoreras. Teckenklasser expanderas\ni en odefinierad ordning; vid översättning kan [:lower:] och [:upper:]\nanvändas i par för att ange skiftlägeskonvertering. Sammanslagning sker\nefter översättning eller radering. Argument som ”[…]” skall citeras, för\natt undvika eventuell globbning av skalet.\n"

#. from tp:coreutils-9.10-pre1
msgid "warning: the ambiguous octal escape \\%c%c%c is being\n	interpreted as the 2-byte sequence \\0%c%c, %c"
msgstr "varning: den tvetydiga oktala kontrollsekvensen \\%c%c%c\n	tolkas som 2-bytesekvensen \\0%c%c, %c"

#. from tp:coreutils-9.10-pre1
msgid "warning: an unescaped backslash at end of string is not portable"
msgstr "varning: ett oskyddat omvänt snedstreck vid strängslut är inte portabelt"

#. from tp:coreutils-9.10-pre1
msgid "range-endpoints of '%s-%s' are in reverse collating sequence order"
msgstr "intervallets ändpunkter för ”%s-%s” är i omvänd sorteringsordning"

#. from tp:coreutils-9.10-pre1
msgid "invalid repeat count %s in [c*n] construct"
msgstr "ogiltigt upprepningsantal %s i konstruktionen [c*n]"

#. from tp:coreutils-9.10-pre1
msgid "missing character class name '[::]'"
msgstr "saknat teckenklassnamn ”[::]”"

#. from tp:coreutils-9.10-pre1
msgid "missing equivalence class character '[==]'"
msgstr "saknat ekvivalensklasstecken ”[==]”"

#. from tp:coreutils-9.10-pre1
msgid "invalid character class %s"
msgstr "ogiltig teckenklass %s"

#. from tp:coreutils-9.10-pre1
msgid "%s: equivalence class operand must be a single character"
msgstr "%s: operand för ekvivalensklass får bara bestå av ett tecken"

#. from tp:coreutils-9.10-pre1
msgid "misaligned [:upper:] and/or [:lower:] construct"
msgstr "[:upper:] och/eller [:lower:] är felaktigt uppställda"

#. from tp:coreutils-9.10-pre1
msgid "too many characters in set"
msgstr "för många tecken i mängd"

#. from tp:coreutils-9.10-pre1
msgid "when translating with string1 longer than string2,\nthe latter string must not end with a character class"
msgstr "vid översättning med sträng1 längre än sträng2,\nfår inte den senare strängen sluta med en teckenklass"

#. from tp:coreutils-9.10-pre1
msgid "the [c*] repeat construct may not appear in string1"
msgstr "konstruktionen [c*] för upprepning får ej förekomma i sträng1"

#. from tp:coreutils-9.10-pre1
msgid "only one [c*] repeat construct may appear in string2"
msgstr "endast en konstruktion [c*] för upprepning får förekomma i sträng2"

#. from tp:coreutils-9.10-pre1
msgid "[=c=] expressions may not appear in string2 when translating"
msgstr "[=c=]-uttryck får inte förekomma i sträng2 vid översättning"

#. from tp:coreutils-9.10-pre1
msgid "when translating, the only character classes that may appear in\nstring2 are 'upper' and 'lower'"
msgstr "vid översättning får endast teckenklasserna ”upper” och ”lower”\nfinnas i sträng2"

#. from tp:coreutils-9.10-pre1
msgid "when not truncating set1, string2 must be non-empty"
msgstr "när mängd1 inte huggs av får sträng2 ej vara tom"

#. from tp:coreutils-9.10-pre1
msgid "when translating with complemented character classes,\nstring2 must map all characters in the domain to one"
msgstr "vid översättning med komplementerade teckenklasser måste sträng2\növersätta alla tecken i domänen till ett"

#. from tp:coreutils-9.10-pre1
msgid "the [c*] construct may appear in string2 only when translating"
msgstr "sammansättningen [c*] får förekomma i sträng2 endast vid översättning"

#. from tp:coreutils-9.10-pre1
msgid "Two strings must be given when both deleting and squeezing repeats."
msgstr "Två strängar måste anges när man både tar bort och pressar samman upprepningar."

#. from tp:coreutils-9.10-pre1
msgid "Two strings must be given when translating."
msgstr "Två strängar måste ges vid översättning."

#. from tp:coreutils-9.10-pre1
msgid "Only one string may be given when deleting without squeezing repeats."
msgstr "Endast en sträng får anges när man tar bort utan att pressa samman\nupprepningar."

#. from tp:coreutils-9.10-pre1
msgid "Usage: %s [ignored command line arguments]\n  or:  %s OPTION\n"
msgstr "Användning: %s [ignorerade kommandoradsargument]\n   eller:   %s FLAGGA\n"

#. from tp:coreutils-9.10-pre1
msgid "Exit with a status code indicating success."
msgstr "Avsluta med en statuskod som indikerar framgång."

#. from tp:coreutils-9.10-pre1
msgid "Exit with a status code indicating failure."
msgstr "Avsluta med en statuskod som indikerar misslyckande."

#. from tp:coreutils-9.10-pre1
msgid "Usage: %s OPTION... FILE...\n"
msgstr "Användning: %s FLAGGA… FIL…\n"

#. from tp:coreutils-9.10-pre1
msgid "Shrink or extend the size of each FILE to the specified size\n\nA FILE argument that does not exist is created.\n\nIf a FILE is larger than the specified size, the extra data is lost.\nIf a FILE is shorter, it is extended and the sparse extended part (hole)\nreads as zero bytes.\n"
msgstr "Krymp eller utöka storleken på varje FIL till den angivna storleken.\n\nEtt FIL-argument som inte finns skapas.\n\nOm en FIL är större än den angivna storleken förloras överskjutande data.\nOm en FIL är kortare utökas den och den utökade glesa delen (hålet) läses\nsom byte med värdet noll.\n"

#. from tp:coreutils-9.10-pre1
msgid "  -c, --no-create        do not create any files\n"
msgstr "  -c, --no-create        skapa inga filer\n"

#. from tp:coreutils-9.10-pre1
msgid "  -o, --io-blocks        treat SIZE as number of IO blocks instead of bytes\n"
msgstr "  -o, --io-blocks        använd STORLEK som antal IO-block istället för byte\n"

#. from tp:coreutils-9.10-pre1
msgid "  -r, --reference=RFILE  base size on RFILE\n"
msgstr "  -r, --reference=RFIL   basera storlek på RFIL\n"

#. from tp:coreutils-9.10-pre1
msgid "  -s, --size=SIZE        set or adjust the file size by SIZE bytes\n"
msgstr "  -s, --size=STORLEK     ange eller justera filstorlek med STORLEK byte\n"

#. from tp:coreutils-9.10-pre1
msgid "\nSIZE may also be prefixed by one of the following modifying characters:\n'+' extend by, '-' reduce by, '<' at most, '>' at least,\n'/' round down to multiple of, '%' round up to multiple of.\n"
msgstr "\nSTORLEK kan också föregås av ett av följande modifierande tecken:\n”+” utöka med, ”-” minska med, ”<” högst, ”>” minst,\n”/” avrunda neråt till multipel av, ”%” avrunda uppåt till multipel av.\n"

#. from tp:coreutils-9.10-pre1
msgid "overflow in %jd * %td byte blocks for file %s"
msgstr "spill i %jd block à %td byte för filen %s"

#. from tp:coreutils-9.10-pre1
msgid "%s has unusable, apparently negative size"
msgstr "%s: filen har oanvändbar, till synes negativ storlek"

#. from tp:coreutils-9.10-pre1
msgid "cannot get the size of %s"
msgstr "kan inte hämta storleken på %s"

#. from tp:coreutils-9.10-pre1
msgid "overflow extending size of file %s"
msgstr "spill vid utökning av storlek av filen %s"

#. from tp:coreutils-9.10-pre1
msgid "failed to truncate %s at %jd bytes"
msgstr "misslyckades med att hugga av %s vid %jd byte"

#. from tp:coreutils-9.10-pre1
msgid "multiple relative modifiers specified"
msgstr "multipla relativa modifierare angivna"

#. from tp:coreutils-9.10-pre1
msgid "Invalid number"
msgstr "Ogiltigt tal"

#. from tp:coreutils-9.10-pre1
msgid "you must specify either %s or %s"
msgstr "du måste ange antingen %s eller %s"

#. from tp:coreutils-9.10-pre1
msgid "you must specify a relative %s with %s"
msgstr "du måste ange en relativ %s till %s"

#. from tp:coreutils-9.10-pre1
msgid "%s was specified but %s was not"
msgstr "%s angavs men inte %s"

#. from tp:coreutils-9.10-pre1
msgid "cannot open %s for writing"
msgstr "kan inte öppna %s för skrivning"

#. from tp:coreutils-9.10-pre1
msgid "Mark Kettenis"
msgstr "Mark Kettenis"

#. from tp:coreutils-9.10-pre1
msgid "Usage: %s [OPTION] [FILE]\nWrite totally ordered list consistent with the partial ordering in FILE.\n"
msgstr "Användning: %s [FLAGGA] [FIL]\nSkriv en totalt ordnad lista förenlig med den partiella ordningen i FIL.\n"

#. from tp:coreutils-9.10-pre1
msgid "%s: input contains an odd number of tokens"
msgstr "%s: indata innehåller ett udda antal element"

#. from tp:coreutils-9.10-pre1
msgid "%s: input contains a loop:"
msgstr "%s: indata innehåller en slinga:"

#. from tp:coreutils-9.10-pre1
msgid "Print the file name of the terminal connected to standard input.\n\n"
msgstr "Skriv ut filnamnet på den terminal som är kopplad till standard in.\n\n"

#. from tp:coreutils-9.10-pre1
msgid "  -s, --silent, --quiet\n         print nothing, only return an exit status\n"
msgstr "  -s, --silent, --quiet\n         skriv inte ut någonting, returnera endast slutstatus\n"

#. from tp:coreutils-9.10-pre1
msgid "ttyname error"
msgstr "ttyname-fel"

#. from tp:coreutils-9.10-pre1
msgid "not a tty"
msgstr "inte en tty"

#. from tp:coreutils-9.10-pre1
msgid "Print certain system information.  With no OPTION, same as -s.\n\n"
msgstr "Skriv ut viss systeminformation. Om ingen FLAGGA angetts används -s.\n\n"

#. from tp:coreutils-9.10-pre1
msgid "  -a, --all                print all information, in the following order,\n                             except omit -p and -i if unknown\n"
msgstr "  -a, --all                skriv ut all information, i följande ordning,\n                             men utelämna -p och -i om okända:\n"

#. from tp:coreutils-9.10-pre1
msgid "  -s, --kernel-name        print the kernel name\n"
msgstr "  -s, --kernel-name        skriv ut kärnans namn\n"

#. from tp:coreutils-9.10-pre1
msgid "  -n, --nodename           print the network node hostname\n"
msgstr "  -n, --nodename           skriv ut maskinens nätverksnodnamn\n"

#. from tp:coreutils-9.10-pre1
msgid "  -r, --kernel-release     print the kernel release\n"
msgstr "  -r, --kernel-release     skriv ut kärnans utgåva\n"

#. from tp:coreutils-9.10-pre1
msgid "  -v, --kernel-version     print the kernel version\n"
msgstr "  -v, --kernel-version       skriv ut kärnans version\n"

#. from tp:coreutils-9.10-pre1
msgid "  -m, --machine            print the machine hardware name\n"
msgstr "  -m, --machine              skriv ut maskinens hårdvarutyp\n"

#. from tp:coreutils-9.10-pre1
msgid "  -p, --processor          print the processor type (non-portable)\n"
msgstr "  -p, --processor            skriv ut processortypen (ej portabelt)\n"

#. from tp:coreutils-9.10-pre1
msgid "  -i, --hardware-platform  print the hardware platform (non-portable)\n"
msgstr "  -i, --hardware-platform    skriv ut hårdvaruplattform (ej portabelt)\n"

#. from tp:coreutils-9.10-pre1
msgid "  -o, --operating-system   print the operating system\n"
msgstr "  -o, --operating-system     skriv ut operativsystemet\n"

#. from tp:coreutils-9.10-pre1
msgid "Print machine architecture.\n\n"
msgstr "Skriv ut maskinarkitekturen.\n\n"

#. from tp:coreutils-9.10-pre1
msgid "cannot get system name"
msgstr "kan inte avgöra systemnamn"

#. from tp:coreutils-9.10-pre1
msgid "Convert blanks in each FILE to tabs, writing to standard output.\n"
msgstr "Konvertera mellanrum i varje FIL till tabulatorer, skriv till standard ut.\n"

#. from tp:coreutils-9.10-pre1
msgid "  -a, --all\n         convert all blanks, instead of just initial blanks\n"
msgstr "  -a, --all\n         konvertera alla mellanrum, i stället för bara inledande\n"

#. from tp:coreutils-9.10-pre1
msgid "      --first-only\n         convert only leading sequences of blanks (overrides -a)\n"
msgstr "      --first-only\n         konvertera bara inledande mellanrumsekvenser (ersätter -a)\n"

#. from tp:coreutils-9.10-pre1
msgid "  -t, --tabs=N\n         have tabs N characters apart instead of 8 (enables -a)\n"
msgstr "  -t, --tabs=N\n         tabulatorpositionerna ligger N tecken isär i stället för 8 (aktiverar -a)\n"

#. from tp:coreutils-9.10-pre1
msgid "tab stop value is too large"
msgstr "tabulatorsteg är för stort"

#. from tp:coreutils-9.10-pre1
msgid "Usage: %s [OPTION]... [INPUT [OUTPUT]]\n"
msgstr "Användning: %s [FLAGGA]… [INFIL [UTFIL]]\n"

#. from tp:coreutils-9.10-pre1
msgid "Filter adjacent matching lines from INPUT (or standard input),\nwriting to OUTPUT (or standard output).\n\nWith no options, matching lines are merged to the first occurrence.\n"
msgstr "Filtrera intilliggande matchande rader från INFIL (eller standard in),\nskriv till UTFIL (eller standard ut).\n\nUtan flaggor slås matchande rader samman till den första förekomsten.\n"

#. from tp:coreutils-9.10-pre1
msgid "  -c, --count\n         prefix lines by the number of occurrences\n"
msgstr "  -c, --count\n         skriv antalet gånger raden förekom framför raden\n"

#. from tp:coreutils-9.10-pre1
msgid "  -d, --repeated\n         only print duplicate lines, one for each group\n"
msgstr "  -d, --repeated\n         skriv endast repeterade rader, en för varje grupp\n"

#. from tp:coreutils-9.10-pre1
msgid "  -D\n         print all duplicate lines\n"
msgstr "  -D\n         skriv ut alla upprepade rader\n"

#. from tp:coreutils-9.10-pre1
msgid "      --all-repeated[=METHOD]\n         like -D, but allow separating groups with an empty line;\n         METHOD={none(default),prepend,separate}\n"
msgstr "      --all-repeated[=METOD]\n         som -D, men tillåt att grupper separeras med en tom rad;\n         METOD={none(standard),prepend,separate}\n"

#. from tp:coreutils-9.10-pre1
msgid "  -f, --skip-fields=N\n         avoid comparing the first N fields\n"
msgstr "  -f, --skip-fields=N\n         undvik att jämföra de första N fälten\n"

#. from tp:coreutils-9.10-pre1
msgid "      --group[=METHOD]\n         show all items, separating groups with an empty line;\n         METHOD={separate(default),prepend,append,both}\n"
msgstr "      --group[=METOD]\n         visa alla poster, separera grupper med en tom rad;\n         METOD={separate(standard),prepend,append,both}\n"

#. from tp:coreutils-9.10-pre1
msgid "  -i, --ignore-case\n         ignore differences in case when comparing\n"
msgstr "  -i, --ignore-case\n         ignorera skillnader i skiftläge vid jämförelse\n"

#. from tp:coreutils-9.10-pre1
msgid "  -s, --skip-chars=N\n         avoid comparing the first N characters\n"
msgstr "  -s, --skip-chars=N\n         undvik jämförelse av de första N tecknen\n"

#. from tp:coreutils-9.10-pre1
msgid "  -u, --unique\n         only print unique lines\n"
msgstr "  -u, --unique\n         skriv endast unika rader\n"

#. from tp:coreutils-9.10-pre1
msgid "  -w, --check-chars=N\n         compare no more than N characters in lines\n"
msgstr "  -w, --check-chars=N\n         jämför inte mer än N tecken i rader\n"

#. from tp:coreutils-9.10-pre1
msgid "\nA field is a run of blanks (usually spaces and/or TABs), then non-blank\ncharacters.  Fields are skipped before chars.\n"
msgstr "\nEtt fält är en följd av blanka (vanligen mellanslag och/eller\ntabulatorer) och sedan tecken som ej är blanka.  Fält hoppas över före\ntecken.\n"

#. from tp:coreutils-9.10-pre1
msgid "\n'uniq' does not detect repeated lines unless they are adjacent.\nYou may want to sort the input first, or use 'sort -u' without 'uniq'.\n"
msgstr "\n”uniq” upptäcker inte upprepade rader om de inte är intill varandra.\nMan kanske vill sortera indata först, eller använda ”sort -u” utan ”uniq”.\n"

#. from tp:coreutils-9.10-pre1
msgid "too many repeated lines"
msgstr "för många upprepade rader"

#. from tp:coreutils-9.10-pre1
msgid "invalid number of fields to skip"
msgstr "ogiltigt antal fält att hoppa över"

#. from tp:coreutils-9.10-pre1
msgid "invalid number of bytes to skip"
msgstr "ogiltigt antal byte att hoppa över"

#. from tp:coreutils-9.10-pre1
msgid "invalid number of bytes to compare"
msgstr "ogiltigt antal byte att jämföra"

#. from tp:coreutils-9.10-pre1
msgid "--group is mutually exclusive with -c/-d/-D/-u"
msgstr "--group är ömsesidigt uteslutande med -c/-d/-D/-u"

#. from tp:coreutils-9.10-pre1
msgid "grouping and printing repeat counts is meaningless"
msgstr "att gruppera och skriva antal repetitioner är meningslöst"

#. from tp:coreutils-9.10-pre1
msgid "printing all duplicated lines and repeat counts is meaningless"
msgstr "att skriva alla duplicerade rader och antalet upprepningar är meningslöst"

#. from tp:coreutils-9.10-pre1
msgid "Usage: %s FILE\n  or:  %s OPTION\n"
msgstr "Användning: %s FIL\n   eller:   %s FLAGGA\n"

#. from tp:coreutils-9.10-pre1
msgid "Call the unlink function to remove the specified FILE.\n\n"
msgstr "Anropa funktionen unlink för att ta bort angiven FIL.\n\n"

#. from tp:coreutils-9.10-pre1
msgid "couldn't get boot time"
msgstr "kunde inte avgöra starttiden"

#. from tp:coreutils-9.10-pre1
msgid " %H:%M:%S  "
msgstr " %H.%M.%S  "

#. from tp:coreutils-9.10-pre1
msgid " ??:????  "
msgstr " ??.??  "

#. from tp:coreutils-9.10-pre1
msgid "up ???? days ??:??,  "
msgstr "uppe ???? dagar ??.??,  "

#. from tp:coreutils-9.10-pre1
msgid "up  %2d:%02d,  "
msgstr "uppe %2d.%02d,  "

#. from tp:coreutils-9.10-pre1
msgid ",  load average: %.2f"
msgstr ",  medellast: %.2f"

#. from tp:coreutils-9.10-pre1
msgid "Print the current time, the length of time the system has been up,\nthe number of users on the system, and the average number of jobs\nin the run queue over the last 1, 5 and 15 minutes."
msgstr "Skriver ut aktuell tid, den tid som systemet varit uppe, antalet\nanvändare på systemet och medelvärdet av antalet jobb i körkön under\nde senaste 1, 5 och 15 minuterna."

#. from tp:coreutils-9.10-pre1
msgid "  Processes in\nan uninterruptible sleep state also contribute to the load average.\n"
msgstr "  Processer som sover i ett tillstånd\nsom inte går att avbryta bidrar också till medellasten.\n"

#. from tp:coreutils-9.10-pre1
msgid "If FILE is not specified, use %s.  %s as FILE is common.\n\n"
msgstr "Om FIL inte anges, använd %s.  %s som FIL är vanligt.\n\n"

#. from tp:coreutils-9.10-pre1
msgid "Output who is currently logged in according to FILE.\nIf FILE is not specified, use %s.  %s as FILE is common.\n\n"
msgstr "Skriv ut vilka som är inloggade enligt FIL.\nOm FIL inte är angiven, använd %s.  %s som FIL är vanligt.\n\n"

#. from tp:coreutils-9.10-pre1
msgid "Print newline, word, and byte counts for each FILE, and a total line if\nmore than one FILE is specified.  A word is a nonempty sequence of non white\nspace delimited by white space characters or by start or end of input.\n"
msgstr "Skriv antalet nyrader, ord och byte för varje FIL, och en totalrad om\nmer än en FIL anges. Ett ord är en icketom följd av tecken som inte är\nblanktecken, avgränsad av blanktecken eller början eller slutet av indata.\n"

#. from tp:coreutils-9.10-pre1
msgid "\nThe options below may be used to select which counts are printed, always in\nthe following order: newline, word, character, byte, maximum line length.\n"
msgstr "\nFlaggorna nedan kan användas för att välja vilka antal som skrivs, alltid\ni följande ordning: nyrad, ord, tecken, byte, maximal radlängd.\n"

#. from tp:coreutils-9.10-pre1
msgid "  -c, --bytes\n         print the byte counts\n"
msgstr "  -c, --bytes\n         skriv antalet byte\n"

#. from tp:coreutils-9.10-pre1
msgid "  -m, --chars\n         print the character counts\n"
msgstr "  -m, --chars\n         skriv antalet tecken\n"

#. from tp:coreutils-9.10-pre1
msgid "  -l, --lines\n         print the newline counts\n"
msgstr "  -l, --lines\n         skriv antalet radbrytningar\n"

#. from tp:coreutils-9.10-pre1
msgid "      --debug\n         indicate what line count acceleration is used\n"
msgstr "      --debug\n         indikera vilken acceleration av radräkning som används\n"

#. from tp:coreutils-9.10-pre1
