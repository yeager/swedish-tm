msgid "      --disassembler-color=off       Disable disassembler color output.\n"
msgstr "      --disassembler-color=off       Avaktivera färger i disassemblerarens utdata.\n"

#. from tp:binutils-2.45.90
msgid "      --disassembler-color=terminal  Enable disassembler color output if displaying on a terminal. (default)\n"
msgstr "      --disassembler-color=terminal  Aktivera färger i disassemblerarens utdata vid visning på en terminal. (standard).\n"

