msgstr "Infoga en (fransk 18:e c) agrément på noten vid markören."

#. from tp:denemo-2.6-rc2
msgid "Add Accidental/Ornament"
msgstr "Lägg till Accidental/Ornament"

#. from tp:denemo-2.6-rc2
