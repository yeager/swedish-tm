msgid "Select"
msgstr "Markera"

#. from tp:denemo-2.6-rc2
msgid "Selecting stretches of notes"
msgstr "Markera följder av noter"

#. from tp:denemo-2.6-rc2
msgid "Object At Cursor"
msgstr "Objekt vid markör"

