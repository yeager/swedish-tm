#. from tp:gas-2.45.90
msgid "-KPIC			generate PIC\n-V			print assembler version number\n-undeclared-regs	ignore application global register usage without\n			appropriate .register directive (default)\n-no-undeclared-regs	force error on application global register usage\n			without appropriate .register directive\n--dcti-couples-detect	warn when an unpredictable DCTI couple is found\n-q			ignored\n-Qy, -Qn		ignored\n-s			ignored\n"
msgstr "-KPIC\t\t\tgenerera PIC\n-V\t\t\tskriv ut assemblerversionen\n-undeclared-regs\tignorera global registeranvändning i program utan\n\t\t\tlämpligt .register-direktiv (standard)\n-no-undeclared-regs\trapportera fel vid global registeranvändning\n\t\t\tutan lämpligt .register-direktiv\n--dcti-couples-detect\tvarna när ett oförutsägbart DCTI-par hittas\n-q\t\t\tignoreras\n-Qy, -Qn\t\tignoreras\n-s\t\t\tignoreras\n"

#. from tp:gas-2.45.90
msgid "-EL			generate code for a little endian machine\n-EB			generate code for a big endian machine\n--little-endian-data	generate code for a machine having big endian\n                        instructions and little endian data.\n"
msgstr "-EL			generera kod för en maskin med omvänd byteordning\n-EB			generera kod för en maskin med rak byteordning\n--little-endian-data	generera kod för en maskin som har kod enligt\n                        rak byteordning och data enligt omvänd byteordning.\n"

