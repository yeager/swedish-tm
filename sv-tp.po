msgid "  -p, --profile=STRING     Use specified stringprep profile instead\n                             Valid stringprep profiles: Nameprep\n                             iSCSI Nodeprep Resourceprep trace SASLprep\n"
msgstr "  -p, --profile=STRING     Använd specificerad stringprep-profil istället\n                             Giltiga stringprep-profiler: Nameprep\n                             iSCSI Nodeprep Resourceprep trace SASLprep\n"

