msgid "Does nothing.  Preserved for backward compatibility."
msgstr "Gör ingenting. Bevarad för bakåtkompatibilitet."

#. from tp:gcc-16.1-b20260222
msgid "Use ordinarily cached memory accesses for volatile references."
msgstr "Använd normalt cachade minnesåtkomster för flyktiga referenser."

#. from tp:gcc-16.1-b20260222
msgid "Enable cache bypass for volatile references."
msgstr "Aktivera cacheförbikoppling för flyktiga referenser."

#. from tp:gcc-16.1-b20260222
msgid "Generate instructions supported by barrel shifter."
msgstr "Generera instruktioner som stöds av barrel-shiftern."

#. from tp:gcc-16.1-b20260222
msgid "Generate norm instruction."
msgstr "Generera norm-instruktion."

#. from tp:gcc-16.1-b20260222
msgid "Generate swap instruction."
msgstr "Generera swap-instruktion."

#. from tp:gcc-16.1-b20260222
msgid "Generate mul64 and mulu64 instructions."
msgstr "Generera mul64- och mulu64-instruktioner."

#. from tp:gcc-16.1-b20260222
msgid "Do not generate mpy instructions for ARC700."
msgstr "Generera inte mpy-instruktioner för ARC700."

#. from tp:gcc-16.1-b20260222
msgid "Generate extended arithmetic instructions, only valid for ARC700."
msgstr "Generera utökade aritmetiska instruktioner; endast giltigt för ARC700."

#. from tp:gcc-16.1-b20260222
msgid "Dummy flag. This is the default unless FPX switches are provided explicitly."
msgstr "Attrappflagga. Detta är standard om inte FPX-flaggor anges uttryckligen."

#. from tp:gcc-16.1-b20260222
msgid "Generate call insns as register indirect calls."
msgstr "Generera anropsinstruktioner som registerindirekta anrop."

#. from tp:gcc-16.1-b20260222
msgid "Generate BRcc instructions in arc_reorg."
msgstr "Generera BRcc-instruktioner i arc_reorg."

#. from tp:gcc-16.1-b20260222
msgid "Generate sdata references.  This is the default, unless you compile for PIC."
msgstr "Generera sdata-referenser. Detta är standard om kod inte kompileras för PIC."

#. from tp:gcc-16.1-b20260222
msgid "Generate millicode thunks."
msgstr "Generera millikodsthunkar."

#. from tp:gcc-16.1-b20260222
msgid "FPX: Generate Single Precision FPX (compact) instructions."
msgstr "FPX: generera FPX-instruktioner med enkel precision (kompakta)."

#. from tp:gcc-16.1-b20260222
msgid "FPX: Generate Single Precision FPX (fast) instructions."
msgstr "FPX: generera FPX-instruktioner med enkel precision (snabba)."

#. from tp:gcc-16.1-b20260222
msgid "FPX: Enable Argonaut ARC CPU Double Precision Floating Point extensions."
msgstr "FPX: aktivera Argonaut ARC CPU-utökningar för flyttal med dubbel precision."

#. from tp:gcc-16.1-b20260222
msgid "FPX: Generate Double Precision FPX (compact) instructions."
msgstr "FPX: generera FPX-instruktioner med dubbel precision (kompakta)."

#. from tp:gcc-16.1-b20260222
msgid "FPX: Generate Double Precision FPX (fast) instructions."
msgstr "FPX: generera FPX-instruktioner med dubbel precision (snabba)."

#. from tp:gcc-16.1-b20260222
msgid "Enable LR and SR instructions to use FPX extension aux registers."
msgstr "Aktivera LR- och SR-instruktioner att använda FPX-utökningens aux-register."

#. from tp:gcc-16.1-b20260222
msgid "Enable generation of ARC SIMD instructions via target-specific builtins."
msgstr "Aktivera generering av ARC-SIMD-instruktioner via målspecifika inbyggda funktioner."

#. from tp:gcc-16.1-b20260222
msgid "-mcpu=CPU	Compile code for ARC variant CPU."
msgstr "-mcpu=CPU\tKompilera kod för ARC-CPU-varianten."

#. from tp:gcc-16.1-b20260222
msgid "Size optimization level: 0:none 1:opportunistic 2: regalloc 3:drop align, -Os."
msgstr "Storleksoptimeringsnivå: 0: ingen, 1: opportunistisk, 2: registerallokering, 3: ta bort justering, -Os."

#. from tp:gcc-16.1-b20260222
msgid "Annotate assembler instructions with estimated addresses."
msgstr "Annotera assemblerinstruktioner med bedömda adresser."

#. from tp:gcc-16.1-b20260222
msgid "Cost to assume for a multiply instruction, with 4 being equal to a normal insn."
msgstr "Antagen kostnad för en multiplikationsinstruktion, där 4 motsvarar en normal instruktion."

#. from tp:gcc-16.1-b20260222
msgid "-mtune=TUNE	Tune code for given ARC variant."
msgstr "-mtune=TUNE\tAnpassa kod för angiven ARC-variant."

#. from tp:gcc-16.1-b20260222
msgid "Enable the use of indexed loads."
msgstr "Aktivera användning av indexerade laddningar."

#. from tp:gcc-16.1-b20260222
msgid "Enable the use of pre/post modify with register displacement."
msgstr "Aktivera användning av pre-/postmodifiering med registerförskjutning."

#. from tp:gcc-16.1-b20260222
msgid "Generate 32x16 multiply and mac instructions."
msgstr "Generera 32×16 multiplikations- och mac-instruktioner."

#. from tp:gcc-16.1-b20260222
msgid "Don't use less than 25 bit addressing range for calls."
msgstr "Använd inte mindre än 25-bitars adresseringsintervall för anrop."

#. from tp:gcc-16.1-b20260222
msgid "Enable pre-reload use of cbranchsi pattern."
msgstr "Aktivera användning av cbranchsi-mönstret före reload."

#. from tp:gcc-16.1-b20260222
msgid "Use pc-relative switch case tables - this enables case table shortening."
msgstr "Använd pc-relativa switch-falltabeller — detta aktiverar förkortning av falltabeller."

#. from tp:gcc-16.1-b20260222
msgid "Enable compact casesi pattern."
msgstr "Aktivera kompakt casesi-mönster."

#. from tp:gcc-16.1-b20260222
msgid "Enable 'q' instruction alternatives."
msgstr "Aktivera ”q”-instruktionsalternativ."

#. from tp:gcc-16.1-b20260222
msgid "Expand adddi3 and subdi3 at rtl generation time into add.f / adc etc."
msgstr "Expandera adddi3 och subdi3 vid RTL-generering till add.f / adc osv."

#. from tp:gcc-16.1-b20260222
msgid "Enable variable polynomial CRC extension."
msgstr "Aktivera variabel polynomisk CRC-utökning."

#. from tp:gcc-16.1-b20260222
msgid "Enable DSP 3.1 Pack A extensions."
msgstr "Aktivera utvidgningarna DSP 3.1 Pack A."

#. from tp:gcc-16.1-b20260222
msgid "Enable dual viterbi butterfly extension."
msgstr "Aktivera dubbel Viterbi-fjärilsutökning."

#. from tp:gcc-16.1-b20260222
msgid "Enable Dual and Single Operand Instructions for Telephony."
msgstr "Aktivera dubbel- och enkeloperandinstruktioner för telefoni."

#. from tp:gcc-16.1-b20260222
msgid "Enable XY Memory extension (DSP version 3)."
msgstr "Aktivera XY-minnesutökningen (DSP version 3)."

#. from tp:gcc-16.1-b20260222
msgid "Enable Locked Load/Store Conditional extension."
msgstr "Aktivera utökningen villkorlig låst laddning/lagring."

#. from tp:gcc-16.1-b20260222
msgid "Enable swap byte ordering extension instruction."
msgstr "Aktivera utökningsinstruktionen för byteordningsväxling."

#. from tp:gcc-16.1-b20260222
msgid "Enable 64-bit Time-Stamp Counter extension instruction."
msgstr "Aktivera utökningsinstruktionen för 64-bitars tidsstämpelräknare."

#. from tp:gcc-16.1-b20260222
msgid "Pass -EB option through to linker."
msgstr "Skicka vidare flaggan -EB till länkaren."

#. from tp:gcc-16.1-b20260222
msgid "Pass -EL option through to linker."
msgstr "Skicka vidare flaggan -EL till länkaren."

#. from tp:gcc-16.1-b20260222
msgid "Pass -marclinux option through to linker."
msgstr "Skicka vidare flaggan -marclinux till länkaren."

#. from tp:gcc-16.1-b20260222
msgid "Pass -marclinux_prof option through to linker."
msgstr "Skicka vidare flaggan -marclinux_prof till länkaren."

#. from tp:gcc-16.1-b20260222
msgid "Don't indicate any priority with TARGET_REGISTER_PRIORITY."
msgstr "Ange ingen prioritet med TARGET_REGISTER_PRIORITY."

#. from tp:gcc-16.1-b20260222
msgid "Indicate priority for r0..r3 / r12..r15 with TARGET_REGISTER_PRIORITY."
msgstr "Indikera prioritet för r0..r3 / r12..r15 med TARGET_REGISTER_PRIORITY."

#. from tp:gcc-16.1-b20260222
msgid "Reduce priority for r0..r3 / r12..r15 with TARGET_REGISTER_PRIORITY."
msgstr "Minska prioriteten för r0..r3 / r12..r15 med TARGET_REGISTER_PRIORITY."

#. from tp:gcc-16.1-b20260222
msgid "Enable atomic instructions."
msgstr "Aktivera atomära instruktioner."

#. from tp:gcc-16.1-b20260222
msgid "Enable double load/store instructions for ARC HS."
msgstr "Aktivera dubbla laddnings-/lagringsinstruktioner för ARC HS."

#. from tp:gcc-16.1-b20260222
msgid "Specify the name of the target floating point configuration."
msgstr "Ange namnet på målets flyttalskonfiguration."

#. from tp:gcc-16.1-b20260222
msgid "Specify thread pointer register number."
msgstr "Ange registernumret för trådpekaren."

#. from tp:gcc-16.1-b20260222
msgid "Enable use of NPS400 bit operations."
msgstr "Aktivera användning av NPS400-bitoperationer."

#. from tp:gcc-16.1-b20260222
msgid "Enable use of NPS400 xld/xst extension."
msgstr "Aktivera användning av NPS400-utökningen xld/xst."

#. from tp:gcc-16.1-b20260222
msgid "Specifies the registers that the processor saves on an interrupt entry and exit."
msgstr "Anger registren som processorn sparar vid avbrottsingång och -utgång."

#. from tp:gcc-16.1-b20260222
msgid "Specifies the number of registers replicated in second register bank on entry to fast interrupt."
msgstr "Ange antalet register som replikeras i den andra registerbanken vid inträde i snabbt avbrott."

#. from tp:gcc-16.1-b20260222
msgid "Sets LP_COUNT register width.  Possible values are 8, 16, 20, 24, 28, and 32."
msgstr "Ställ in registerbredden för LP_COUNT. Möjliga värden är 8, 16, 20, 24, 28 och 32."

#. from tp:gcc-16.1-b20260222
msgid "Enable 16-entry register file."
msgstr "Aktivera en registerfil med 16 poster."

#. from tp:gcc-16.1-b20260222
msgid "Enable use of BI/BIH instructions when available."
msgstr "Möjliggör användning av BI-/BIH-instruktioner när de är tillgängliga."

#. from tp:gcc-16.1-b20260222
msgid "Enable ENTER_S and LEAVE_S opcodes for ARCv2."
msgstr "Aktivera operationskoderna ENTER_S och LEAVE_S för ARCv2."

#. from tp:gcc-16.1-b20260222
msgid "Generate big-endian code."
msgstr "Generera kod med rak byteordning."

#. from tp:gcc-16.1-b20260222
msgid "Generate little-endian code."
msgstr "Generera kod med omvänd byteordning."

#. from tp:gcc-16.1-b20260222
msgid "Enable MUL.X and UMUL.X instructions."
msgstr "Använd MUL.X- och UMUL.X-instruktioner."

#. from tp:gcc-16.1-b20260222
msgid "Generate code for the Android platform."
msgstr "Generera kod för plattformen Android."

