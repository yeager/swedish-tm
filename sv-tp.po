msgid "this system doesn't provide a %s floating point type"
msgstr "detta system har ingen %s flyttalstyp"

#. from tp:coreutils-9.10-pre1
msgid "invalid character '%c' in type string %s"
msgstr "ogiltigt tecken ”%c” i typsträngen %s"

#. from tp:coreutils-9.10-pre1
msgid "cannot skip past end of combined input"
msgstr "kan inte hoppa förbi slutet på en kombinerad inmatning"

#. from tp:coreutils-9.10-pre1
msgid "pseudo address too large for input"
msgstr "pseudoadressen är för stor för indatan"

#. from tp:coreutils-9.10-pre1
msgid "invalid output address radix '%c'; it must be one character from [doxn]"
msgstr "ogiltig radix för utmatningsadress ”%c”; måste vara ett tecken från [doxn]"

#. from tp:coreutils-9.10-pre1
msgid "no type may be specified when dumping strings"
msgstr "ingen typ kan anges när strängar skrivs ut"

#. from tp:coreutils-9.10-pre1
msgid "compatibility mode supports at most one file"
msgstr "kompatibilitetsläge stödjer högst en fil"

#. from tp:coreutils-9.10-pre1
msgid "skip-bytes + read-bytes is too large"
msgstr "skip-bytes + read-bytes är för stort"

#. from tp:coreutils-9.10-pre1
msgid "warning: invalid width %td; using %d instead"
msgstr "varning: ogiltig bredd %td; använder %d i stället"

#. from tp:coreutils-9.10-pre1
msgid "%td is too large"
msgstr "%td är för stort"

#. from tp:coreutils-9.10-pre1
msgid "standard input is closed"
msgstr "standard in stängd"

#. from tp:coreutils-9.10-pre1
msgid "Write lines consisting of the sequentially corresponding lines from\neach FILE, separated by TABs, to standard output.\nThe newline of every line except the line from the last file\nis replaced with a TAB.\n"
msgstr "Skriv rader som består av motsvarande rader i tur och ordning\nfrån varje FIL, åtskilda med TAB, till standard ut.\nRadbrytningen efter varje rad utom raden från den sista filen ersätts\nmed en TAB.\n"

#. from tp:coreutils-9.10-pre1
msgid "  -d, --delimiters=LIST\n         reuse characters from LIST instead of TABs;\n         backslash escapes are supported\n"
msgstr "  -d, --delimiters=LISTA\n         återanvänd tecken från LISTA istället för TAB;\n         styrsekvenser med omvänt snedstreck stödjs\n"

#. from tp:coreutils-9.10-pre1
msgid "  -s, --serial\n         paste one file at a time instead of in parallel; the newline of\n         every line except the last line in each file is replaced with a TAB\n"
msgstr "  -s, --serial\n         klistra in en fil i taget i stället för parallellt; radbrytningen efter\n         varje rad utom den sista raden i varje fil ersätts med en TAB\n"

#. from tp:coreutils-9.10-pre1
msgid "delimiter list ends with an unescaped backslash: %s"
msgstr "avgränsningslistan avslutas med ett oskyddat omvänt snedstreck: %s"

#. from tp:coreutils-9.10-pre1
msgid "Diagnose invalid or non-portable file names.\n\n"
msgstr "Diagnostisera ogiltiga eller oportabla filnamn.\n\n"

#. from tp:coreutils-9.10-pre1
msgid "  -p     check for most POSIX systems\n"
msgstr "  -p     kontrollera för de flesta POSIX-system\n"

#. from tp:coreutils-9.10-pre1
msgid "  -P     check for empty names and leading \"-\"\n"
msgstr "  -P    kontrollera tomma namn och inledande ”-”\n"

#. from tp:coreutils-9.10-pre1
msgid "      --portability\n         check for all POSIX systems (equivalent to -p -P)\n"
msgstr "      --portability\n         kontrollera för alla POSIX-system (detsamma som -p -P)\n"

#. from tp:coreutils-9.10-pre1
msgid "leading '-' in a component of file name %s"
msgstr "inledande ”-” i en komponent av filnamnet %s"

#. from tp:coreutils-9.10-pre1
msgid "non-portable character %s in file name %s"
msgstr "ej portabelt tecken %s i filnamnet %s"

#. from tp:coreutils-9.10-pre1
msgid "empty file name"
msgstr "tomt filnamn"

#. from tp:coreutils-9.10-pre1
msgid "%s: unable to determine maximum file name length"
msgstr "%s: kan inte avgöra maximal filnamnslängd"

#. from tp:coreutils-9.10-pre1
msgid "limit %td exceeded by length %td of file name %s"
msgstr "gränsen %td överskreds av längden %td för filnamnet %s"

#. from tp:coreutils-9.10-pre1
msgid "limit %td exceeded by length %td of file name component %s"
msgstr "gränsen %td överskreds av längden %td för filnamnsdelen %s"

