msgstr "Slå samman den här notsystemet som en stämma på den tidigare notsystemet"

#. from tp:denemo-2.6-rc2
msgid "Swap Movements"
msgstr "Byt plats på satser"

#. from tp:denemo-2.6-rc2
msgid "Swap this movement with the one before"
msgstr "Byt plats på denna sats och den föregående"

#. from tp:denemo-2.6-rc2
msgid "Selection Voice Up"
msgstr "Val Röst Upp"

#. from tp:denemo-2.6-rc2
msgid "Go to the higher numbered voice on staff, extending selection if any"
msgstr "Gå till den högre numrerade rösten i notsystemet och utvidga urvalet om det finns något"

#. from tp:denemo-2.6-rc2
msgid "Selection Voice Down"
msgstr "Val Röst Ned"

#. from tp:denemo-2.6-rc2
msgid "Go to the lower numbered voice on this staff, extending selection if any"
msgstr "Gå till den lägre numrerade stämman på denna notsystem, förläng eventuellt val"

#. from tp:denemo-2.6-rc2
msgid "Move to Voice Up"
msgstr "Flytta till stämman uppåt"

#. from tp:denemo-2.6-rc2
msgid "Go to the higher numbered voice on staff without altering selection"
msgstr "Gå till den högre numrerade stämman i notsystemet utan att ändra markeringen"

#. from tp:denemo-2.6-rc2
msgid "Move to Voice Down"
msgstr "Flytta till stämman nedåt"

#. from tp:denemo-2.6-rc2
msgid "Go to the lower numbered voice on this staff without altering selection"
msgstr "Gå till den lägre numrerade stämman på detta notsystem utan att ändra markeringen"

