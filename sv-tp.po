msgstr "Lägg till ett notsystem först"

#. from tp:denemo-2.6-rc2
msgid "Inserts a new staff at the top of the score"
msgstr "Infogar ett nytt notsystem överst i partituret"

#. from tp:denemo-2.6-rc2
msgid "Add Last Staff"
msgstr "Lägg till sista notsystem"

#. from tp:denemo-2.6-rc2
msgid "Inserts a new staff at the end of the score"
msgstr "Infogar ett nytt notsystem sist i partituret"

#. from tp:denemo-2.6-rc2
msgid "Delete Staff Before"
msgstr "Ta bort notsystem innan"

