msgstr "Importera LilyPond"

#. from tp:denemo-2.6-rc2
msgid "Import a Lilypond file"
msgstr "Importera en LilyPond-fil"

#. from tp:denemo-2.6-rc2
msgid "Import Midi"
msgstr "Importera MIDI"

#. from tp:denemo-2.6-rc2
msgid "Import a Midi file"
msgstr "Importera en MIDI-fil"

#. from tp:denemo-2.6-rc2
msgid "Import MusicXml"
msgstr "Importera MusicXML"

#. from tp:denemo-2.6-rc2
