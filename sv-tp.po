#. from tp:m4-1.4.21
msgid "empty string treated as 0 in builtin `%s'"
msgstr "tom sträng behandlad som 0 i inbyggt makro ”%s”"

#. from tp:m4-1.4.21
msgid "non-numeric argument to builtin `%s'"
msgstr "ickenumeriskt argument till inbyggt makro ”%s”"

#. from tp:m4-1.4.21
msgid "leading whitespace ignored in builtin `%s'"
msgstr "inledande blanksteg ignoreras i inbyggt makro ”%s”"

#. from tp:m4-1.4.21
msgid "numeric overflow detected in builtin `%s'"
msgstr "numeriskt överspill identifierat i inbyggt makro ”%s”"

#. from tp:m4-1.4.21
msgid "Warning: %s: invalid macro name ignored"
msgstr "Varning: %s: ogiltigt makronamn ignoreras"

#. from tp:m4-1.4.21
msgid "undefined macro `%s'"
msgstr "odefinierat makro ”%s”"

#. from tp:m4-1.4.21
msgid "undefined builtin `%s'"
msgstr "odefinierat inbyggt makro ”%s”"

#. from tp:m4-1.4.21
msgid "builtin `%s' requested by frozen file is not supported"
msgstr "inbyggt makro ”%s” som begärs av en fryst fil stöds inte"

#. from tp:m4-1.4.21
msgid "Warning: cannot concatenate builtin `%s'"
msgstr "Varning: kan inte sammanfoga inbyggt makro ”%s”"

#. from tp:m4-1.4.21
msgid "cannot run command `%s'"
msgstr "kan inte köra kommando ”%s”"

#. from tp:m4-1.4.21
msgid "cannot read pipe"
msgstr "kan inte läsa från rör"

#. from tp:m4-1.4.21
msgid "radix %d in builtin `%s' out of range"
msgstr "talbasen %d i inbyggt makro ”%s” ligger utanför intervallet"

#. from tp:m4-1.4.21
msgid "negative width to builtin `%s'"
msgstr "negativ bredd till inbyggt makro ”%s”"

