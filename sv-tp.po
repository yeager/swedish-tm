#. from tp:meritous-1.5
msgid "Use the movement keys to locate a checkpoint. Press button 1 to"
msgstr "Använd rörelseknapparna för att hitta en kontrollpunkt. Tryck på knapp 1 för att"

#. from tp:meritous-1.5
msgid "teleport to this checkpoint. Press Back or 3 once you are done."
msgstr "teleportera till kontrollpunkten. Tryck på Bakåt eller 3 när du är klar."

#. from tp:meritous-1.5
msgid "Use the movement keys to locate a checkpoint. Press ENTER to"
msgstr "Använd rörelseknapparna för att hitta en kontrollpunkt. Tryck på Retur för att"

#. from tp:meritous-1.5
msgid "teleport to this checkpoint. Press ESCAPE or TAB once you are done."
msgstr "teleportera till kontrollpunkten. Tryck på Escape eller Tab när du är klar."

#. from tp:meritous-1.5
msgid "Paused"
msgstr "Pausat"

#. from tp:meritous-1.5
msgid "Press button 2 to confirm."
msgstr "Tryck på knapp 2 för att bekräfta."

#. from tp:meritous-1.5
