msgstr "Tryck på knapp 2 för att teleportera mellan kontrollstationer."

#. from tp:meritous-1.5
msgid "Press ENTER to teleport between checkpoints."
msgstr "Tryck på RETUR för att teleportera mellan kontrollstationer."

#. from tp:meritous-1.5
msgid "Press button 2 to open the storage chest"
msgstr "Tryck på knapp 2 för att öppna förvaringskistan"

