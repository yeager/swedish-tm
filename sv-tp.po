msgstr "      --additional-suffix=ÄNDELSE\n         lägg till en extra ÄNDELSE på filnamn\n"

#. from tp:coreutils-9.10-pre1
msgid "  -b, --bytes=SIZE\n         put SIZE bytes per output file\n"
msgstr "  -b, --bytes=STORLEK\n         placera STORLEK byte i varje utfil\n"

