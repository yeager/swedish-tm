msgstr "[::1]:1119 /tmp/localhost6\\(en1119 lh6"

#. from tp:tin-man-2.6.5
msgid "# catch all rules should go last"
msgstr "# alla regler ska placeras sist"

#. from tp:tin-man-2.6.5
