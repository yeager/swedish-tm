msgstr "id=%s (nr=%u) raderades, men är fortfarande kvar!\n"

#. from tp:fetchmail-6.6.0.rc3
msgid "Messages inserted into list on server. Cannot handle this.\n"
msgstr "Meddelanden har infogats i listan på servern. Kan inte hantera detta.\n"

#. from tp:fetchmail-6.6.0.rc3
msgid "LAST is an obsolete command that many servers will not support. We will try modern means to find what messages are new.\n"
msgstr "LAST är ett föråldrat kommando som många servrar inte stöder. Vi försöker med moderna sätt att hitta nya meddelanden.\n"

#. from tp:fetchmail-6.6.0.rc3
msgid "protocol error\n"
msgstr "protokollfel\n"

#. from tp:fetchmail-6.6.0.rc3
msgid "protocol error while fetching UIDLs\n"
msgstr "protokollfel när UIDL:er hämtades\n"

#. from tp:fetchmail-6.6.0.rc3
msgid "id=%s (num=%d) was deleted, but is still present!\n"
msgstr "id=%s (nr=%d) raderades, men är fortfarande kvar!\n"

#. from tp:fetchmail-6.6.0.rc3
