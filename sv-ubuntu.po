msgid "Exclude files mentioned in B<Files-Excluded> in the given I<copyright-file>.  This is useful when running B<uscan> not within a source package directory."
msgstr "Uteslut filer som nämns i B<Files-Excluded> i den angivna I<copyright-file>.  Detta är användbart när B<uscan> körs utanför en källkodspaketkatalog."

#. from ubuntu:devscripts
msgid "Exclude files whose basenames match I<PATTERN>.  Multiple uses of this option are permitted.  Note that this option is passed on to B<diff> and has the same behaviour, so only the basename of the file is considered: in particular, B<--exclude='*.patch'> will work, but B<--exclude='debian/patches/*'> will have no practical effect."
msgstr "Uteslut filer vars basnamn matchar I<PATTERN>.  Det är tillåtet att använda denna flagga flera gånger.  Observera att denna flagga vidarebefordras till B<diff> och har samma funktion, så endast filens basnamn beaktas: i synnerhet kommer B<--exclude='*.patch'> att fungera, men B<--exclude='debian/patches/*'> kommer inte att ha någon praktisk effekt."

#. from ubuntu:devscripts
msgid "Execute the given script \\f[I]POST_SCRIPT\\f[R] after packages install.\\fR"
msgstr "Kör det angivna skriptet \\f[I]POST_SCRIPT\\f[R] efter att paketen har installerats.\\fR"

#. from ubuntu:devscripts
msgid "Execute the given script \\f[I]PRE_SCRIPT\\f[R] before packages install.\\fR"
msgstr "Kör det angivna skriptet \\f[I]PRE_SCRIPT\\f[R] innan paketen installeras.\\fR"

