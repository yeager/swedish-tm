msgid "* B<< DL-2.04/foo-2.04.tar.gz >>"
msgstr "* B<< DL-2.04/foo-2.04.tar.gz >>"

#. from ubuntu:devscripts
msgid "* B<Files-Excluded> or B<Files-Excluded->I<component> stanzas are set in F<debian/copyright> to make B<mk-origtargz> invoked from B<uscan> remove files from the upstream tarball and repack it.  See L<uscan(1)/COPYRIGHT FILE EXAMPLES> and mk-origtargz(1)."
msgstr "* B<Files-Excluded> eller B<Files-Excluded->I<component> stroferna anges i F<debian/copyright> för att göra B<mk-origtargz> anropas från B<uscan> ta bort filer från uppströms-tarballen och packa om den.  Se L<uscan(1)/COPYRIGHT FILE EXAMPLES> och mk-origtargz(1)."

#. from ubuntu:devscripts
msgid "* B<Matching-Pattern:> I<< <regex> >>"
msgstr "* B<Matching-Pattern:> I<< <regex> >>"

#. from ubuntu:devscripts
msgid "* B<Source> I<< <url> >>"
msgstr "* B<Source> I<< <url> >>"

#. from ubuntu:devscripts
msgid "* B<Template>"
msgstr "* B<Template>"

#. from ubuntu:devscripts
msgid "* B<USCAN_REPACK> is set in the devscripts configuration.  See L<uscan(1)/DEVSCRIPTS CONFIGURATION VARIABLES>."
msgstr "* B<USCAN_REPACK> anges i devscripts-konfigurationen. Se L<uscan(1)/DEVSCRIPTS KONFIGURATIONSVARIABLER>."

#. from ubuntu:devscripts
msgid "* B<Update-Script:> I<< <script> >>:"
msgstr "* B<Update-Script:> I<< <skript> >>:"

#. from ubuntu:devscripts
msgid "* B<Version-Schema> I<< <schema> >>"
msgstr "* B<Version-Schema> I<< <schema> >>"

#. from ubuntu:devscripts
msgid "* B<Version-Separator> I<< <separator> >>: string used to assemble component versions when B<Version-Schema> is set to \"group\" or \"checksum\".  The default value is \"B<+~>\". This parameter must be in the first paragraph I<(just after \"Version\")>, else it will be ignored."
msgstr "* B<Version-Separator> I<< <separator> >>: sträng som används för att sammanställa komponentversioner när B<Version-Schema> är inställd på \"group\" eller \"checksum\".  Standardvärdet är \"B<+~>\". Denna parameter måste finnas i första stycket I<(just after \"Version\")>, annars ignoreras den."

#. from ubuntu:devscripts
msgid "* B<archive>, B<unarchive>: check whether the bug is already/not yet archived."
msgstr "* B<archive>, B<unarchive>: kontrollera om felet redan är arkiverat eller inte."

#. from ubuntu:devscripts
msgid "* B<checksum> requires the downloading upstream tarball to be newer than the version obtained from F<debian/changelog>. Package version is the concatenation of the version of the main tarball, followed by a checksum of all the tarballs using the \"checksum\" version system.  At least the main upstream source has to be declared as \"group\"."
msgstr "* B<checksum> kräver att den nedladdade uppströms-tarballen är nyare än den version som erhållits från F<debian/changelog>. Paketversionen är en sammanfogning av versionen av huvud-tarballen, följt av en kontrollsumma av alla tarballer som använder versionssystemet \"checksum\".  Åtminstone den huvudsakliga uppströms-källan måste deklareras som \"grupp\"."

#. from ubuntu:devscripts
msgid "* B<checksum>: see L<Grouped package>. When \"B<Version-Schema: checksum>\" is declared in global paragraph, it is applied to all source except the first one which is declared as \"group\"."
msgstr "* B<checksum>: se L<Grouped package>. När \"B<Version-Schema: checksum>\" deklareras i det globala stycket tillämpas det på alla källor utom den första som deklareras som \"group\"."

#. from ubuntu:devscripts
msgid "* B<debian> I<(default)> requires the downloading upstream tarball to be newer than the version obtained from F<debian/changelog>."
msgstr "* B<debian> I<(default)> kräver att den nedladdade uppströms-tarballen är nyare än den version som erhållits från F<debian/changelog>."

#. from ubuntu:devscripts
msgid "* B<done>: checks whether the bug is alread marked 'done',"
msgstr "* B<done>: kontrollerar om felet redan är markerat som \"klart\","

#. from ubuntu:devscripts
msgid "* B<fixed>, B<found>: complain when the record that's being made already exists in the BTS,"
msgstr "* B<fixed>, B<found>: klaga när den post som skapas redan finns i BTS,"

#. from ubuntu:devscripts
msgid "* B<ftp://>I<URL>"
msgstr "* B<ftp://>I<URL>"

#. from ubuntu:devscripts
msgid "* B<group> requires the downloading upstream tarball to be newer than the version obtained from F<debian/changelog>. Package version is the concatenation of all \"group\" upstream version."
msgstr "* B<group> kräver att den nedladdade uppströms-tarballen är nyare än den version som erhållits från F<debian/changelog>. Paketversionen är en sammanfogning av alla \"grupp\"-uppströmsversioner."

#. from ubuntu:devscripts
msgid "* B<group>: Debian version is then built with all sources declared as \"B<Version-Schema: group>\" I<(see L<Grouped package>)>."
msgstr "* B<group>: Debian-versionen byggs sedan med alla källor deklarerade som \"B<Version-Schema: group>\" I<(se L<Grouped package>)>."

#. from ubuntu:devscripts
msgid "* B<http://>I<URL> I<matching-pattern> [I<version> [I<script>]]"
msgstr "* B<http://>I<URL> I<matching-pattern> [I<version> [I<script>]]"

#. from ubuntu:devscripts
msgid "* B<http://>I<URL> specifies the web page where upstream publishes the link to the latest source archive."
msgstr "* B<http://>I<URL> anger webbsidan där uppströms publicerar länken till det senaste källarkivet."

#. from ubuntu:devscripts
msgid "* B<http://www.example.org/@ANY_VERSION@/>"
msgstr "* B<http://www.example.org/@ANY_VERSION@/>"

#. from ubuntu:devscripts
msgid "* B<https://>I<URL> may also be used, as may"
msgstr "* B<https://>I<URL> kan också användas, liksom"

#. from ubuntu:devscripts
msgid "* B<ignore> does not restrict the version of the secondary tarballs. (Maybe useful for MUT)"
msgstr "* B<ignore> begränsar inte versionen av de sekundära tarbollar. (Kanske användbart för MUT)"

#. from ubuntu:devscripts
msgid "* B<notfixed>, B<notfound>: complain when the record being removed doesn't exist,"
msgstr "* B<notfixed>, B<notfound>: klaga när posten som tas bort inte finns,"

#. from ubuntu:devscripts
msgid "* B<opts=\"> I<...> B<\">"
msgstr "* B<opts=\"> I<...> B<\">"

#. from ubuntu:devscripts
msgid "* B<opts=\"> I<...> B<\"> B<http://>I<URL> I<matching-pattern> [I<version> [I<script>]]"
msgstr "* B<opts=\"> I<...> B<\"> B<http://>I<URL> I<matching-pattern> [I<version> [I<script>]]"

#. from ubuntu:devscripts
msgid "* B<opts=\"> I<...> B<\"> specifies the behavior of B<uscan>.  See L<uscan(1)/WATCH FILE OPTIONS>."
msgstr "* B<opts=\"> I<...> B<\"> anger beteendet för B<uscan>.  Se L<uscan(1)/WATCH FILE OPTIONS>."

#. from ubuntu:devscripts
msgid "* B<opts=\"dversionmangle=s/\\+dfsg\\d*$//\">"
msgstr "* B<opts=\"dversionmangle=s/\\+dfsg\\d*$//\">"

#. from ubuntu:devscripts
msgid "* B<previous> restricts the version of the signature file. (Used with pgpmode=previous)"
msgstr "* B<previous> begränsar versionen av signaturfilen. (Används med pgpmode=previous)"

#. from ubuntu:devscripts
msgid "* B<previous>: used when previous source contains B<Pgp-Mode> I<(see L<GPGE<sol>PGP options>)>."
msgstr "* B<previous>: används när föregående källa innehåller B<Pgp-Mode> I<(se L<GPGE<sol>PGP-alternativ>)>."

#. from ubuntu:devscripts
msgid "* B<repack> is set in the watch line as B<Repack: yes>."
msgstr "* B<repack> är inställd i klocklinjen som B<Repack: yes>."

#. from ubuntu:devscripts
msgid "* B<repack> is set in the watch line as B<opts=\"repack,>I<...>B<\">."
msgstr "* B<repack> är inställd i klocklinjen som B<opts=\"repack,>I<...>B<\">."

#. from ubuntu:devscripts
msgid "* B<same> requires the downloaded version of the secondary tarballs to be exactly the same as the one for the first upstream tarball downloaded. (Useful only for MUT)"
msgstr "* B<same> kräver att den nedladdade versionen av de sekundära tarbollar är exakt samma som den för den första nedladdade uppströms tarbollen. (Endast användbart för MUT)"

#. from ubuntu:devscripts
msgid "* B<same>, version must be identic as main source version"
msgstr "* B<same>, versionen måste vara identisk med huvudkällans version"

#. from ubuntu:devscripts
msgid "* B<uscan> downloads a web page from the specified I<URL> in F<debian/watch>."
msgstr "* B<uscan> hämtar en webbsida från den angivna I<URL> i F<debian/watch>."

#. from ubuntu:devscripts
msgid "* B<uscan> downloads the upstream tarball with the highest version newer than the last upstream version."
msgstr "* B<uscan> laddar ner den uppströms-tarball som har den högsta versionen som är nyare än den senaste uppströmsversionen."

#. from ubuntu:devscripts
msgid "* B<uscan> extracts hrefs pointing to the upstream tarball(s) from the web page using the specified I<matching-pattern> in F<debian/watch>."
msgstr "* B<uscan> extraherar hrefs som pekar på uppströms-tarball(er) från webbsidan med hjälp av den angivna I<matching-pattern> en i F<debian/watch>."

#. from ubuntu:devscripts
msgid "* B<uscan> invokes B<mk-origtargz> to create the source tarball: I<< ../<spkg>_<oversion>.orig.tar.gz >>"
msgstr "* B<uscan> anropar B<mk-origtargz> för att skapa källkodsarkivet: I<< ../<spkg>_<oversion>.orig.tar.gz >>"

#. from ubuntu:devscripts
msgid "* B<uscan> invokes the custom I<script> as \"I<script> B<--upstream-version> I<version> B<../>I<spkg>B<_>I<version>B<.orig.tar.gz>\"."
msgstr "* B<uscan> anropar den anpassade I<script> som \"I<script> B<--upstream-version> I<version> B<../>I<spkg>B<_>I<version>B<.orig.tar.gz>\"."

#. from ubuntu:devscripts
msgid "* B<uscan> invokes the custom I<script> as \"I<script> B<--upstream-version> I<version>\"."
msgstr "* B<uscan> anropar den anpassade I<script> som \"I<script> B<--upstream-version> I<version>\"."

#. from ubuntu:devscripts
msgid "* B<uscan> invokes the standard B<uupdate> as \"B<uupdate> B<--find> B<--upstream-version> I<version>\"."
msgstr "* B<uscan> hänvisar till standarden B<uupdate> som \"B<uupdate> B<--find> B<--upstream-version> I<version>\"."

#. from ubuntu:devscripts
msgid "* B<uscan> invokes the standard B<uupdate> as \"B<uupdate> B<--no-symlink --upstream-version> I<version> B<../>I<spkg>B<_>I<version>B<.orig.tar.gz>\"."
msgstr "* B<uscan> anropar standard B<uupdate> som \"B<uupdate> B<--no-symlink --upstream-version> I<version> B<../>I<spkg>B<_>I<version>B<.orig.tar.gz>\"."

#. from ubuntu:devscripts
msgid "* B<uscan> process the watch lines F<debian/watch> from the top to the bottom in a single pass."
msgstr "* B<uscan> -processen bearbetar övervakningsraderna F<debian/watch> från toppen till botten i ett enda steg."

#. from ubuntu:devscripts
msgid "* B<uscan> reads the first entry in F<debian/changelog> to determine the source package name I<< <spkg> >> and the last upstream version."
msgstr "* B<uscan> läser den första posten i F<debian/changelog> för att fastställa källpaketets namn I<< <spkg> >> och den senaste uppströmsversionen."

#. from ubuntu:devscripts
msgid "* B<uscan> saves the downloaded tarball to the parent B<../> directory: I<< ../<upkg>-<uversion>.tar.gz >>"
msgstr "* B<uscan> sparar den nedladdade tarbollen i den överordnade B<../> -katalogen: I<< ../<upkg>-<uversion>.tar.gz >>"

#. from ubuntu:devscripts
msgid "* B<uscan> with the B<--debug> option produces a human readable report of B<uscan>'s execution including internal variable states."
msgstr "* B<uscan> med alternativet B<--debug> genererar en läsbar rapport om B<uscan>:s exekvering, inklusive interna variablers tillstånd."

#. from ubuntu:devscripts
msgid "* B<uscan> with the B<--dehs> option produces an upstream package status report in XML format for other programs such as the Debian External Health System."
msgstr "* B<uscan> med alternativet B<--dehs> genererar en uppströms paketstatusrapport i XML-format för andra program, såsom Debian External Health System."

#. from ubuntu:devscripts
msgid "* B<uscan> with the B<--extra-debug> option produces a human readable report of B<uscan>'s execution including internal variable states and remote content during \"search\" step."
msgstr "* B<uscan> med alternativet B<--extra-debug> genererar en läsbar rapport om B<uscan>:s körning, inklusive interna variablers tillstånd och fjärrinnehåll under \"sök\"-steget."

#. from ubuntu:devscripts
msgid "* B<uscan> with the B<--safe> option limits the functionality of B<uscan> to its primary objective.  Both the repacking of downloaded files and updating of the source tree are skipped to avoid running unsafe scripts.  This also changes the default to B<--no-download> and B<--skip-signature>."
msgstr "* B<uscan> med alternativet B<--safe> begränsar funktionaliteten hos B<uscan> till dess primära syfte.  Både ompackningen av nedladdade filer och uppdateringen av källkoden hoppas över för att undvika att osäkra skript körs.  Detta ändrar också standardinställningen till B<--no-download> och B<--skip-signature>."

#. from ubuntu:devscripts
msgid "* B<uscan> with the B<--verbose> option produces a human readable report of B<uscan>'s execution."
msgstr "* B<uscan> med alternativet B<--verbose> genererar en läsbar rapport om B<uscan>:s exekvering."

#. from ubuntu:devscripts
msgid "* Blast radius control I<command>s: B<package>, B<limit>."
msgstr "* Kontroller av sprängradie I<command>s: B<package>, B<limit>."

#. from ubuntu:devscripts
msgid "* Bug Linking I<command>s: B<affects>."
msgstr "* Bugglänkning I<command>s: B<affects>."

#. from ubuntu:devscripts
msgid "* Bug Organisation I<command>s: B<reassign>, B<clone>, B<merge>, B<forcemerge>, B<unmerge>."
msgstr "* Bug Organisation I<command>s: B<reassign>, B<clone>, B<merge>, B<forcemerge>, B<unmerge>."

#. from ubuntu:devscripts
msgid "* Bug State I<command>s: B<done>|B<close>, B<reopen>, B<archive>, B<unarchive>."
msgstr "* Bug State I<command>s: B<done>|B<close>, B<reopen>, B<archive>, B<unarchive>."

#. from ubuntu:devscripts
msgid "* Coordination I<command>s: B<owner>, B<noowner>|B<disown>, B<claim>, B<unclaim>."
msgstr "* Samordning I<command>s: B<owner>, B<noowner>|B<disown>, B<claim>, B<unclaim>."

#. from ubuntu:devscripts
msgid "* Empty lines are dropped."
msgstr "* Tomma rader tas bort."

#. from ubuntu:devscripts
msgid "* F<../bar_2.04+dfsg.orig.tar.gz> (repackaged)"
msgstr "* F<../bar_2.04+dfsg.orig.tar.gz> (ompaketerad)"

#. from ubuntu:devscripts
msgid "* F<../bar_2.04.orig.tar.gz> -> F<foo-2.04.tar.gz> (as is)"
msgstr "* F<../bar_2.04.orig.tar.gz> -> F<foo-2.04.tar.gz> (som det är)"

#. from ubuntu:devscripts
msgid "* F<../foo-2.04.tar.gz>"
msgstr "* F<../foo-2.04.tar.gz>"

#. from ubuntu:devscripts
msgid "* Fetch Live Bug Status: B<bts status> I<bug-number>"
msgstr "* Hämta live-bugstatus: B<bts status> I<bug-number>"

#. from ubuntu:devscripts
msgid "* File is written using rfc822-style, like other Debian files."
msgstr "* Filen är skriven i rfc822-format, precis som andra Debian-filer."

#. from ubuntu:devscripts
msgid "* First paragraph"
msgstr "* Första stycket"

#. from ubuntu:devscripts
msgid "* For a multiple upstream tarball (MUT) package, the secondary upstream tarball will instead be named I<< ../<spkg>_<oversion>.orig-<component>.tar.gz >>."
msgstr "* För ett paket med flera uppströms-tarballer (MUT) kommer den sekundära uppströms-tarballen istället att namnges I<< ../<spkg>_<oversion>.orig-<component>.tar.gz >>."

#. from ubuntu:devscripts
msgid "* For simplicity, the compression method used in examples is B<gzip> with B<.gz> suffix.  Other methods such as B<xz>, B<bzip2>, and B<lzma> with corresponding B<xz>, B<bz2> and B<lzma> suffixes may also be used."
msgstr "* För enkelhetens skull är komprimeringsmetoden som används i exemplen B<gzip> med suffixet B<.gz>.  Andra metoder såsom B<xz>, B<bzip2> och B<lzma> med motsvarande suffix B<xz>, B<bz2> och B<lzma> kan också användas."

#. from ubuntu:devscripts
msgid "* Hyphens in key names are ignored. B<Matching-Pattern> is equivalent to B<Matchingpattern>"
msgstr "* Bindestreck i nyckelnamn ignoreras. B<Matching-Pattern> motsvarar B<Matchingpattern>"

#. from ubuntu:devscripts
msgid "* I<< bar >> (B<3:2.03+dfsg-4>) unstable; urgency=low"
msgstr "* I<< bar >> (B<3:2.03+dfsg-4>) instabil; brådskande=låg"

#. from ubuntu:devscripts
msgid "* I<matching-pattern> specifies the full string matching pattern for hrefs in the web page.  See L<uscan(1)/WATCH FILE EXAMPLES>."
msgstr "* I<matching-pattern> anges det fullständiga strängmatchningsmönstret för hrefs på webbsidan.  Se L<uscan(1)/WATCH FILE EXAMPLES>."

#. from ubuntu:devscripts
msgid "* I<rule> may only use the B<s>, B<tr>, and B<y> operations."
msgstr "* I<rule> får endast använda funktionerna B<s>, B<tr> och B<y>."

#. from ubuntu:devscripts
msgid "* I<version-number> such as B<12.5> requires the upstream tarball to be newer than the I<version-number>."
msgstr "* I<version-number>, till exempel B<12.5>, krävs att uppströms-tarballen är nyare än I<version-number>."

#. from ubuntu:devscripts
msgid "* I<version> restricts the upstream tarball which may be downloaded.  The newest available version is chosen in each case."
msgstr "* I<version> begränsas de uppströms-tarballer som kan laddas ner.  Den senaste tillgängliga versionen väljs i varje enskilt fall."

#. from ubuntu:devscripts
msgid "* If requested, B<uscan> invokes an update script.  This may be B<uupdate> to create the Debianized source tree I<< ../<spkg>-<oversion>/* >> or a custom script."
msgstr "* Om så önskas, kör B<uscan> ett uppdateringsskript. Detta kan vara B<uupdate> för att skapa Debianiserade källkodsträdet I<< ../<spkg>-<oversion>/* >> eller ett anpassat skript."

#. from ubuntu:devscripts
msgid "* If set, I<script> is executed at the end of B<uscan> execution with appropriate arguments provided by B<uscan> I<(default: no action)>.  See L<uscan/\"Custom script\"> for more details on these scripts and L<uscan/\"HISTORY AND UPGRADING\"> for how B<uscan> invokes the custom I<script> (or L<uupdate>)."
msgstr "* Om inställt, exekveras I<script> i slutet av B<uscan>-exekveringen med lämpliga argument som tillhandahålls av B<uscan> I<(standard: ingen åtgärd)>. Se L<uscan/”Anpassat skript”> för mer information om dessa skript och L<uscan/”HISTORIK OCH UPPGRADERING”> för information om hur B<uscan> anropar det anpassade I<script> (eller L<uupdate>)."

#. from ubuntu:devscripts
msgid "* If the directory name part of B<Source:> has no parentheses, B<(> and B<)>, it is taken as verbatim."
msgstr "* Om katalognamnet i B<Source:> inte har några parenteser, B<(> och B<)>, tas det som det står."

#. from ubuntu:devscripts
msgid "* If the directory name part of B<Source:> has parentheses, B<(> and B<)>, then B<uscan> recursively searches all possible directories to find a page for the newest version.  If a B<Dirversion-Mangle> rule exists, the generated sorting index is used to find the newest version.  If a specific version is specified for the download, the matching version string has priority over the newest version."
msgstr "* Om katalognamnet i B<Source:> innehåller parenteser, B<(> och B<)>, söker B<uscan> rekursivt igenom alla möjliga kataloger för att hitta en sida för den senaste versionen.  Om en B<Dirversion-Mangle> -regel finns, används det genererade sorteringsindexet för att hitta den senaste versionen.  Om en specifik version anges för nedladdningen, har den matchande versionssträngen prioritet framför den senaste versionen."

#. from ubuntu:devscripts
msgid "* If the directory name part of I<URL> has no parentheses, B<(> and B<)>, it is taken as verbatim."
msgstr "* Om katalognamnet i I<URL> inte har några parenteser, B<(> och B<)>, tas det som det står."

#. from ubuntu:devscripts
msgid "* If the directory name part of I<URL> has parentheses, B<(> and B<)>, then B<uscan> recursively searches all possible directories to find a page for the newest version.  If the B<dirversionmangle> rule exists, the generated sorting index is used to find the newest version.  If a specific version is specified for the download, the matching version string has priority over the newest version."
msgstr "* Om katalognamnet i I<URL> innehåller parenteser, B<(> och B<)>, söker B<uscan> rekursivt igenom alla möjliga kataloger för att hitta en sida för den senaste versionen.  Om regeln B<dirversionmangle> finns, används det genererade sorteringsindexet för att hitta den senaste versionen.  Om en specifik version anges för nedladdningen, har den matchande versionssträngen prioritet framför den senaste versionen."

#. from ubuntu:devscripts
msgid "* If the hrefs do not contain directories, you can combine this with the previous entry. I.e., B<http://>I<URL>B</>I<matching-pattern> ."
msgstr "* Om href-adresserna inte innehåller kataloger kan du kombinera detta med föregående post. Dvs. B<http://>I<URL>B</>I<matching-pattern>."

#. from ubuntu:devscripts
msgid "* Key names are case-insensitive."
msgstr "* Nyckelnamn är inte skiftlägeskänsliga."

#. from ubuntu:devscripts
msgid "* L<http://pypi.python.org>"
msgstr "* L<http://pypi.python.org>"

#. from ubuntu:devscripts
msgid "* L<http://sf.net>"
msgstr "* L<http://sf.net>"

#. from ubuntu:devscripts
msgid "* Leading spaces and tabs are dropped."
msgstr "* Ledande mellanslag och tabbar tas bort."

#. from ubuntu:devscripts
msgid "* List bugs in local cache (for shell completion): B<bts listcachedbugs>"
msgstr "* Lista buggar i lokal cache (för shell-komplettering): B<bts listcachedbugs>"

#. from ubuntu:devscripts
msgid "* List matching bug numbers: B<bts select> I<bug-selection>..."
msgstr "* Lista över matchande felnummer: B<bts select> I<bug-selection>..."

#. from ubuntu:devscripts
msgid "* Metadata I<command>s: B<retitle>, B<summary>, B<severity>, B<forwarded>, B<notforwarded>, B<blocked>, B<unblock>, B<submitter>."
msgstr "* Metadata I<command>s: B<retitle>, B<summary>, B<severity>, B<forwarded>, B<notforwarded>, B<blocked>, B<unblock>, B<submitter>."

#. from ubuntu:devscripts
msgid "* Repeat until all lines in F<debian/watch> are processed."
msgstr "* Upprepa tills alla rader i F<debian/watch> har bearbetats."

#. from ubuntu:devscripts
msgid "* Since version 4 of debian/watch, B<uscan> enables handling of multiple upstream tarball (MUT) packages but this is a rare case for Debian packaging.  For a single upstream tarball package, there is only one watch line and no I<< ../<spkg>_<oversion>.orig-<component>.tar.gz >>."
msgstr "* Sedan version 4 av debian/watch möjliggör B<uscan> hantering av flera uppströms-tarball-paket (MUT), men detta är ett sällsynt fall för Debian-paket.  För ett enda uppströms-tarball-paket finns det bara en watch-rad och ingen I<< ../<spkg>_<oversion>.orig<component>.tar.gz >>."

#. from ubuntu:devscripts
msgid "* Some parts of I<URL> may be in the regex match pattern surrounded between B<(> and B<)> such as B</foo/bar-([\\.\\d]+)/>.  (If multiple directories match, the highest version is picked.) Otherwise, the I<URL> is taken as verbatim."
msgstr "* Vissa delar av I<URL> kan finnas i det reguljära uttrycket som omges av B<(> och B<)>, till exempel B</foo/bar-([\\.\\d]+)/>.  (Om flera kataloger matchar väljs den högsta versionen.) I annat fall tas I<URL> bokstavligt."

#. from ubuntu:devscripts
msgid "* Tagging I<command>s: B<tags>, B<user>, B<usertags>."
msgstr "* Taggning av I<command>: B<tags>, B<user>, B<usertags>."

#. from ubuntu:devscripts
msgid "* The B<Matching-Pattern> field is recommended. It specifies the full string matching pattern for hrefs in the web page. B<uscan> provides also templates that fill this field automatically I<(see below)>. Default value: C<(?:@PACKAGE@)?@ANY_VERSION@@ARCHIVE_EXT@>."
msgstr "* Fältet B<Matching-Pattern> rekommenderas. Det anger det fullständiga strängmatchningsmönstret för hrefs på webbsidan. B<uscan> tillhandahåller också mallar som fyller i detta fält automatiskt I<(see below)>. Standardvärde: C<(?:@PACKAGE@)?@ANY_VERSION@@ARCHIVE_EXT@>."

#. from ubuntu:devscripts
msgid "* The B<Source:> field is required. It gives the URL where B<uscan> will look at candidate upstream tarballs."
msgstr "* Fältet B<Source:> är obligatoriskt. Det anger den URL där B<uscan> kommer att söka efter möjliga uppströms-tarballs."

