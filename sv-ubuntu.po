msgid " -h              This help text.\n"
msgstr " -h              Denna hjälptext.\n"

#. from ubuntu:aptitude
msgid " -i              Perform an install run on startup.\n"
msgstr " -i              Utför en installationskörning vid uppstart.\n"

#. from ubuntu:aptitude
