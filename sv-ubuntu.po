#. from ubuntu:alsa-utils
msgid "Usage: %s [OPTION]... [FILE]...\n\n-h, --help              help\n    --version           print current version\n-l, --list-devices      list all soundcards and digital audio devices\n-L, --list-pcms         list device names\n-D, --device=NAME       select PCM by name\n-q, --quiet             quiet mode\n-t, --file-type TYPE    file type (voc, wav, raw or au)\n-c, --channels=#        channels\n-f, --format=FORMAT     sample format (case insensitive)\n    --subformat=SUBFORMAT  sample subformat (case insensitive)\n-r, --rate=#            sample rate\n-d, --duration=#        interrupt after # seconds\n-s, --samples=#         interrupt after # samples per channel\n-M, --mmap              mmap stream\n-N, --nonblock          nonblocking mode\n-F, --period-time=#     distance between interrupts is # microseconds\n-B, --buffer-time=#     buffer duration is # microseconds\n    --period-size=#     distance between interrupts is # frames\n    --buffer-size=#     buffer duration is # frames\n-A, --avail-min=#       min available space for wakeup is # microseconds\n-R, --start-delay=#     delay for automatic PCM start is # microseconds \n                        (relative to buffer size if <= 0)\n-T, --stop-delay=#      delay for automatic PCM stop is # microseconds from xrun\n-v, --verbose           show PCM structure and setup (accumulative)\n-V, --vumeter=TYPE      enable VU meter (TYPE: mono or stereo)\n-I, --separate-channels one file for each channel\n-i, --interactive       allow interactive operation from stdin\n-m, --chmap=ch1,ch2,..  Give the channel map to override or follow\n    --disable-resample  disable automatic rate resample\n    --disable-channels  disable automatic channel conversions\n    --disable-format    disable automatic format conversions\n    --disable-softvol   disable software volume control (softvol)\n    --test-position     test ring buffer position\n    --test-coef=#       test coefficient for ring buffer position (default 8)\n                        expression for validation is: coef * (buffer_size / 2)\n    --test-nowait       do not wait for ring buffer - eats whole CPU\n    --max-file-time=#   start another output file when the old file has recorded\n                        for this many seconds\n    --process-id-file   write the process ID here\n    --use-strftime      apply the strftime facility to the output file name\n    --dump-hw-params    dump hw_params of the device\n    --fatal-errors      treat all errors as fatal\n"
msgstr "Användning: %s [OPTION]... [FIL]...\n\n-h, --help              hjälp\n    --version           visa aktuell version\n-l, --list-devices      lista alla ljudkort och digitala ljudenheter\n-L, --list-pcms         lista enhetsnamn\n-D, --device=NAMN       välj PCM efter namn\n-q, --quiet             tyst läge\n-t, --file-type TYP     filtyp (voc, wav, raw eller au)\n-c, --channels=#        kanaler\n-f, --format=FORMAT     samplingsformat (skiftlägesokänsligt)\n    --subformat=SUBFORMAT  samplingsunderformat (skiftlägesokänsligt)\n-r, --rate=#            samplingsfrekvens\n-d, --duration=#        avbryt efter # sekunder\n-s, --samples=#         avbryt efter # samplingar per kanal\n-M, --mmap              mmap-ström\n-N, --nonblock          icke-blockerande läge\n-F, --period-time=#     avståndet mellan avbrott är # mikrosekunder\n-B, --buffer-time=#     buffertlängd är # mikrosekunder\n     --period-size=# avstånd mellan avbrott är # ramar\n     --buffer-size=# buffertlängd är # ramar\n-A, --avail-min=#       min tillgängligt utrymme för väckning är # mikrosekunder\n-R, --start-delay=#     fördröjning för automatisk PCM-start är # mikrosekunder\n                        (relativt buffertstorlek om <= 0)\n-T, --stop-delay=#      fördröjning för automatisk PCM-stopp är # mikrosekunder från xrun\n-v, --verbose           visa PCM-struktur och inställningar (ackumulerande)\n-V, --vumeter=TYP       aktivera VU-mätare (TYPE: mono eller stereo)\n-I, --separate-channels en fil för varje kanal\n-i, --interactive       tillåt interaktiv drift från stdin\n-m, --chmap=ch1,ch2,..  Ange kanalkartan som ska åsidosättas eller följas\n    --disable-resample inaktivera automatisk omsampling\n    --disable-channels  inaktivera automatisk kanalomvandling\n    --disable-format    inaktivera automatisk formatomvandling\n    --disable-softvol   inaktivera programvaruvolymkontroll (softvol)\n    --test-position     testa ringbuffertposition\n    --test-coef=#       testkoefficient för ringbuffertposition (standard 8)\n                        uttryck för validering är: coef * (buffer_size / 2)\n    --test-nowait       vänta inte på ringbuffert - tar upp hela CPU\n    --max-file-time=#   starta en annan utdatafil när den gamla filen har spelat\n                        in i så många sekunder\n    --process-id-file   skriv process-ID här\n    --use-strftime      tillämpa strftime-funktionen på utdatafilens namn\n    --dump-hw-params    dumpa hw_params för enheten\n    --fatal-errors      behandla alla fel som allvarliga\n"

