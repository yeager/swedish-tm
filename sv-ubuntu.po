msgstr " -o nkl=vde      Sätt direkt värde för konfigurationsalternativet 'nkl'.\n"

#. from ubuntu:aptitude
msgid " -q              In command-line mode, suppress the incremental progress\n                  indicators.\n"
msgstr " -q              I kommandoradsläge, dölj de inkrementella förlopps-\n                  indikatorerna.\n"

#. from ubuntu:aptitude
msgid " -s              Simulate actions, but do not actually perform them.\n"
msgstr " -s              Simulera åtgärder, men utför dem inte.\n"

