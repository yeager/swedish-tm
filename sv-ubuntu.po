msgid " -t [release]    Set the release from which packages should be installed.\n"
msgstr " -t [utgåva]     Ange från vilken utgåva paket ska installeras.\n"

#. from ubuntu:aptitude
msgid " -u              Download new package lists on startup.\n"
msgstr " -u              Ladda ned nya paketlistor vid uppstart.\n"

