msgid "  -c cups-files.conf      Set cups-files.conf file to use."
msgstr "  -c cups-files.conf      Ange vilken cups-files.conf som ska användas."

#. from ubuntu:cups
msgid "  -d output-dir           Specify the output directory."
msgstr "  -d output-dir           Ange mapp för utdata."

#. from ubuntu:cups
msgid "  -d printer              Use the named printer."
msgstr "  -d skrivare              Använd namngiven skrivare."

#. from ubuntu:cups
msgid "  -e                      Use every filter from the PPD file."
msgstr "  -e                      Använd alla filter från PPD-filen."

#. from ubuntu:cups
msgid "  -i mime/type            Set input MIME type (otherwise auto-typed)."
msgstr "  -i mime/type            Ange indatans MIME-typ (auto-typas annars)."

#. from ubuntu:cups
msgid "  -j job-id[,N]           Filter file N from the specified job (default is file 1)."
msgstr "  -j jobb-id[,N]          Filtrera fil N från angivet jobb (förval är fil 1)."

#. from ubuntu:cups
msgid "  -l lang[,lang,...]      Specify the output language(s) (locale)."
msgstr "  -l språk[,språk,...]    Ange språk för utdatan (lokal)."

#. from ubuntu:cups
msgid "  -m                      Use the ModelName value as the filename."
msgstr "  -m                      Använd värdet ModelName som filnamn."

#. from ubuntu:cups
msgid "  -m mime/type            Set output MIME type (otherwise application/pdf)."
msgstr "  -m mime/type            Ange utdatans MIME-typ (annars application/pdf)."

#. from ubuntu:cups
msgid "  -n copies               Set number of copies."
msgstr "  -n exemplar             Ange antal exemplar."

#. from ubuntu:cups
msgid "  -o filename.drv         Set driver information file (otherwise ppdi.drv)."
msgstr "  -o filnamn.drv          Ange drivrutinsinformationfil (annars ppdi.drv)."

#. from ubuntu:cups
msgid "  -o filename.ppd[.gz]    Set output file (otherwise stdout)."
msgstr "  -o filnamn.ppd[.gz]     Ange utdatafil (annars stdout)."

#. from ubuntu:cups
msgid "  -o name=value           Set option(s)."
msgstr "  -o namn=värde           Ange alternativ."

#. from ubuntu:cups
msgid "  -p filename.ppd         Set PPD file."
msgstr "  -p filnamn.ppd          Ange PPD-fil."

#. from ubuntu:cups
msgid "  -t                      Test PPDs instead of generating them."
msgstr "  -t                      Testa PPD:er istället för att generera dem."

#. from ubuntu:cups
msgid "  -t title                Set title."
msgstr "  -t titel                Ange titel."

#. from ubuntu:cups
msgid "  -u                      Remove the PPD file when finished."
msgstr "  -u                      Ta bort PPD-fil när uppgiften har slutförts."

#. from ubuntu:cups
msgid "  -v                      Be verbose."
msgstr "  -v                      Var utförlig."

#. from ubuntu:cups
msgid "  -z                      Compress PPD files using GNU zip."
msgstr "  -z                      Komprimera PPD-filer med GNU zip."

