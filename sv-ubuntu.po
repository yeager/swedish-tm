msgid "L<uscan(1)>, L<uscan-templates(5)>, L<mk-origtargz(1)>, L<perlre(1)>, L<uupdate(1)>, L<devscripts.conf(5)>"
msgstr "L<uscan(1)>, L<uscan-templates(5)>, L<mk-origtargz(1)>, L<perlre(1)>, L<uupdate(1)>, L<devscripts.conf(5)>"

