msgid "Package version is then the concatenation of upstream versions separated by \"+~\"."
msgstr "Paketversionen är då en sammanfogning av uppströmsversioner separerade med \"+~\"."

#. from ubuntu:devscripts
msgid "Parse changelogs for all versions strictly greater than I<version>."
msgstr "Analysera ändringsloggar för alla versioner som är strikt större än I<version>."

#. from ubuntu:devscripts
msgid "Parsing options"
msgstr "Analysalternativ"

#. from ubuntu:devscripts
msgid "Pass <option>--debug</option> to <citerefentry> <refentrytitle>dpkg-deb</refentrytitle> <manvolnum>1</manvolnum> </citerefentry>."
msgstr "Passera <option>--debug</option> till <citerefentry> <refentrytitle>dpkg-deb</refentrytitle> <manvolnum>1</manvolnum> </citerefentry>."

#. from ubuntu:devscripts
msgid "Pass <option>--force-bad-version</option> to <citerefentry> <refentrytitle>dch</refentrytitle> <manvolnum>1</manvolnum> </citerefentry>"
msgstr "Passera <option>--force-bad-version</option> till <citerefentry> <refentrytitle>dch</refentrytitle> <manvolnum>1</manvolnum> </citerefentry>"

#. from ubuntu:devscripts
msgid "Pass a B<-p>, B<-l> or B<-t> option to B<wdiff> respectively.  (This yields the whole B<wdiff> output rather than just the lines with any changes.)"
msgstr "Skicka ett B<-p>, B<-l> eller B<-t> -alternativ till B<wdiff>.  (Detta ger hela B<wdiff> -utdata istället för bara raderna med ändringar.)"

#. from ubuntu:devscripts
msgid "Patch file to apply, in the format output by B<debdiff>(1).  Default: I<\\,/dev/stdin\\/>"
msgstr "Patchfil att tillämpa, i formatet som genereras av B<debdiff>(1).  Standard: I<\\,/dev/stdin\\/>"

#. from ubuntu:devscripts
msgid "Patches are extracted to one of these directories.  ``debian/patches/'' is preferred, if it exists.  If I<DEB_PATCHES> is present in the environment, it will override this behavior (see ``ENVIRONMENT VARIABLES'' section below)."
msgstr "Patchar extraheras till en av dessa kataloger. ``debian/patches/'' är att föredra, om den finns. Om I<DEB_PATCHES> finns i miljön kommer det att åsidosätta detta beteende (se avsnittet ``MILJÖVARIABLER'' nedan)."

#. from ubuntu:devscripts
msgid "Path to an image for the project's avatar.  If path value contains \"%p\", it is replaced by project name."
msgstr "Sökväg till en bild för projektets avatar. Om sökvägsvärdet innehåller \"%p\" ersätts det med projektnamnet."

#. from ubuntu:devscripts
msgid "Path to debian/changelog; default: debian/changelog"
msgstr "Sökväg till debian/changelog; standard: debian/changelog"

#. from ubuntu:devscripts
msgid "Patrick Schoenfeld <schoenfeld@debian.org>"
msgstr "Patrick Schoenfeld <schoenfeld@debian.org>"

#. from ubuntu:devscripts
msgid "Per-project configuration options.  Will override any per-user or global configuration if B<cowpoke> is called from the directory where they exist."
msgstr "Konfigurationsalternativ per projekt.  Åsidosätter alla användarspecifika eller globala konfigurationer om B<cowpoke> anropas från den katalog där de finns."

#. from ubuntu:devscripts
msgid "Per-user configuration options.  Will override any global configuration."
msgstr "Konfigurationsalternativ per användare. Åsidosätter alla globala konfigurationer."

