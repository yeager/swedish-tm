msgid "This module is free software; you can redistribute it and/or modify it under the same terms as Perl itself."
msgstr "Denna modul är fri programvara; du kan distribuera och/eller modifiera den under samma villkor som Perl själv."

#. from ubuntu:devscripts
msgid "This option controls whether a new bug report is made, or whether the diff is sent to the bugs closed by this NMU.  Can be I<maybe> (default), which sends to the existing bug reports if exactly one bug is being closed; I<yes>, which always creates a new report, or I<no>, which always sends to the reports of the bugs being closed (unless no bugs are being closed, in which case a new report is always made)."
msgstr "Den här flaggan styr om en ny felrapport skapas eller om diff skickas till de fel som stängts av denna NMU.  Kan vara I<maybe> (standard), som skickar till befintliga felrapporter om exakt ett fel stängs; I<yes>, som alltid skapar en ny rapport, eller I<no>, som alltid skickar till rapporterna om de fel som stängs (om inga fel stängs skapas alltid en ny rapport)."

#. from ubuntu:devscripts
msgid "This option is set by default and ignored if more than one line of the message begins with \"[*+-] \"."
msgstr "Den här flaggan är inställt som standard och ignoreras om mer än en rad i meddelandet börjar med \"[*+-] \"."

#. from ubuntu:devscripts
msgid "This option is valid only in git mode."
msgstr "Den här flaggan är bara tillgängligt i git-läge."

#. from ubuntu:devscripts
msgid "This option will be passed to B<wdiff>; it should be one of B<-p>, B<-l> or B<-t>."
msgstr "Den här flaggan skickas till B<wdiff>; det ska vara ett av B<-p>, B<-l> eller B<-t>."

#. from ubuntu:devscripts
msgid "This option will override any B<BUILD_OPTS> specified for a chroot in the cowpoke configuration files."
msgstr "Den här flaggan åsidosätter alla B<BUILD_OPTS> som anges för en chroot i cowpoke-konfigurationsfilerna."

#. from ubuntu:devscripts
msgid "This option will override any B<CREATE_OPTS> specified for a chroot in the cowpoke configuration files."
msgstr "Den här flaggan åsidosätter alla B<CREATE_OPTS> som anges för en chroot i cowpoke-konfigurationsfilerna."

#. from ubuntu:devscripts
msgid "This option will override any B<UPDATE_OPTS> specified for a chroot in the cowpoke configuration files."
msgstr "Den här flaggan åsidosätter alla B<UPDATE_OPTS> som anges för en chroot i cowpoke-konfigurationsfilerna."

#. from ubuntu:devscripts
