msgid "The following packages are awaiting processing of triggers that they\nhave activated in other packages.  This processing can be requested using\ndselect or dpkg --configure --pending (or dpkg --triggers-only):\n"
msgstr "Följande paket avvaktar hantering av utlösare de aktiverat i andra\npaket. Hantering kan efterfrågas genom att använda dselect eller\ndpkg --configure --pending (eller dpkg --triggers-only):\n"

#. from ubuntu:dpkg
msgid "The following packages are in a mess due to serious problems during\ninstallation.  They must be reinstalled for them (and any packages\nthat depend on them) to function properly:\n"
msgstr "Följande paket är i oordning på grund av allvarliga problem när de\ninstallerades. De måste ominstalleras om de (och paket som är\nberoende av dem) ska fungera korrekt:\n"

