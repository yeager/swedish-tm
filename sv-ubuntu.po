msgstr "Se L<COMMANDLINE OPTIONS> och L<DEVSCRIPT CONFIGURATION VARIABLES> för andra varianter."

#. from ubuntu:devscripts
msgid "See L<HISTORY AND UPGRADING> for how B<uscan> invokes a custom I<script> (or L<uupdate>)."
msgstr "Se L<HISTORIK OCH UPPGRADERING> för information om hur B<uscan> anropar ett anpassat I<script> (eller L<uupdate>)."

#. from ubuntu:devscripts
msgid "See L<https://lists.debian.org/msgid-search/20050908170731.GA20584@cyan.localnet>."
msgstr "Se L<https://lists.debian.org/msgid-search/20050908170731.GA20584@cyan.localnet>."

