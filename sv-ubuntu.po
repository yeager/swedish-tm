msgstr "Flaggorna -n och -l/-L är inkompatibla."

#. from ubuntu:e2fsprogs
msgid "The -p option only supported in raw mode\n"
msgstr "Flaggan -p stödjs endast i raw-läge\n"

#. from ubuntu:e2fsprogs
msgid "The -t option is not supported on this version of e2fsck.\n"
msgstr "Flaggan -t stödjs inte i denna version av e2fsck.\n"

#. from ubuntu:e2fsprogs
msgid "The -t option may only be used once"
msgstr "Flaggan -t får endast anges en gång"

#. from ubuntu:e2fsprogs
msgid "The @f size (according to the @S) is %b @bs\nThe physical size of the @v is %c @bs\nEither the @S or the partition table is likely to be corrupt!\n"
msgstr "Filsystemsstorleken (enligt superblocket) är %b block\nDen fysiska storleken på enheten är %c block\nSuperblocket eller partitionstabellen är förmodligen trasig!\n"

#. from ubuntu:e2fsprogs
msgid "The HURD does not support the ea_inode feature.\n"
msgstr "HURD stödjer inte funktionen ea_inode.\n"

#. from ubuntu:e2fsprogs
msgid "The HURD does not support the filetype feature.\n"
msgstr "HURD stödjer inte funktionen filtype.\n"

#. from ubuntu:e2fsprogs
msgid "The HURD does not support the huge_file feature.\n"
msgstr "HURD stödjer inte funktionen huge_file.\n"

#. from ubuntu:e2fsprogs
msgid "The HURD does not support the metadata_csum feature.\n"
msgstr "HURD stödjer inte funktionen metadata_csum.\n"

#. from ubuntu:e2fsprogs
msgid "The Hurd does not support the filetype feature.\n"
msgstr "Hurd stödjer inte funktionen filtyp.\n"

#. from ubuntu:e2fsprogs
msgid "The UUID may only be changed when the filesystem is unmounted.\n"
msgstr "UUID:n får endast ändras när filsystemet är omonterat.\n"

#. from ubuntu:e2fsprogs
msgid "The bad @b @i looks @n.  "
msgstr "Inoden för dåliga block verkar felaktig.  "

#. from ubuntu:e2fsprogs
msgid "The callback function will not handle this case"
msgstr "Återanropsfunktionen kommer inte att hantera detta fall"

#. from ubuntu:e2fsprogs
msgid "The casefold feature can't be cleared when there are inodes with +F flag.\n"
msgstr "Funktionen casefold kan inte nollställas när det finns inoder med flaggan +F.\n"

#. from ubuntu:e2fsprogs
msgid "The casefold feature may only be disabled when the filesystem is unmounted.\n"
msgstr "Funktionen casefold kan endast avaktiveras när filsystemet är omonterat.\n"

#. from ubuntu:e2fsprogs
msgid "The casefold feature may only be enabled when the filesystem is unmounted.\n"
msgstr "Funktionen casefold kan endast aktiveras när filsystemet är omonterat.\n"

#. from ubuntu:e2fsprogs
msgid "The cluster size may not be smaller than the block size.\n"
msgstr "Klusterstorleken får inte vara mindre än blockstorleken.\n"

#. from ubuntu:e2fsprogs
msgid "The containing partition (or device) is only %llu (%dk) blocks.\nYou requested a new size of %llu blocks.\n\n"
msgstr "Den rymmande partitionen (eller enheten) är bara %llu (%d k) block.\nDu begärde en ny storlek på %llu block.\n\n"

#. from ubuntu:e2fsprogs
msgid "The ext2 superblock is corrupt"
msgstr "Ext2-superblocket är skadat"

#. from ubuntu:e2fsprogs
msgid "The file %s does not exist and no size was specified.\n"
msgstr "Filen %s finns inte och ingen storlek angavs.\n"

#. from ubuntu:e2fsprogs
msgid "The file system superblock doesn't match the undo file.\n"
msgstr "Filsystemets superblock stämmer inte med gör-ogjort-filen.\n"

#. from ubuntu:e2fsprogs
msgid "The filesystem already has a journal.\n"
msgstr "Filsystemet har redan en journal.\n"

#. from ubuntu:e2fsprogs
msgid "The filesystem is already %llu (%dk) blocks long.  Nothing to do!\n\n"
msgstr "Filsystemet är redan %llu (%d k) block långt.  Inget behöver göras!\n\n"

#. from ubuntu:e2fsprogs
msgid "The filesystem is already 32-bit.\n"
msgstr "Filsystemet är redan 32-bitars.\n"

#. from ubuntu:e2fsprogs
msgid "The filesystem is already 64-bit.\n"
msgstr "Filsystemet är redan 64-bitars.\n"

#. from ubuntu:e2fsprogs
msgid "The filesystem on %s is now %llu (%dk) blocks long.\n\n"
msgstr "Filsystemet på %s är nu %llu (%d k) block långt.\n\n"

#. from ubuntu:e2fsprogs
msgid "The filesystem revision is apparently too high for this version of e2fsck.\n(Or the filesystem superblock is corrupt)\n\n"
msgstr "Filsystemsrevisionen är uppenbarligen för hög för denna version av e2fsck.\n(Eller så är filsystemets superblock trasigt)\n\n"

#. from ubuntu:e2fsprogs
msgid "The has_journal feature may only be cleared when the filesystem is\nunmounted or mounted read-only.\n"
msgstr "Flaggan has_journal får endast nollställas när filsystemet är\nomonterat eller monterat enbart för läsning.\n"

#. from ubuntu:e2fsprogs
msgid "The huge_file feature may only be cleared when the filesystem is\nunmounted or mounted read-only.\n"
msgstr "Flaggan huge_file får endast nollställas när filsystemet är\nomonterat eller monterat enbart för läsning.\n"

#. from ubuntu:e2fsprogs
msgid "The inode is from a bad block in the inode table"
msgstr "Inoden är från ett dåligt block i inodstabellen"

#. from ubuntu:e2fsprogs
msgid "The inode size is already %lu\n"
msgstr "Inodsstorleken är redan %lu\n"

#. from ubuntu:e2fsprogs
msgid "The inode size may only be changed when the filesystem is unmounted and not in use.\n"
msgstr "Inodsstorleken får endast ändras när filsystemet är omonterat och inte används.\n"

#. from ubuntu:e2fsprogs
msgid "The internal ext2_filsys data structure appears to be corrupted"
msgstr "Den interna ext2_filsys-datastrukturen förefaller vara trasig"

#. from ubuntu:e2fsprogs
msgid "The journal superblock is corrupt"
msgstr "Journalsuperblocket är trasigt"

#. from ubuntu:e2fsprogs
msgid "The metadata_csum_seed feature requires the metadata_csum feature.\n"
msgstr "Funktionen metadata_csum_seed förutsätter funktionen metadata_csum.\n"

#. from ubuntu:e2fsprogs
msgid "The multiple mount protection feature can't\nbe set if the filesystem is mounted or\nread-only.\n"
msgstr "Funktionen för skydd mot flerfaldig montering\nkan inte sättas på om filsystemet är monterat\neller skrivskyddat.\n"

#. from ubuntu:e2fsprogs
msgid "The multiple mount protection feature cannot\nbe disabled if the filesystem is readonly.\n"
msgstr "Funktionen för skydd mot flerfaldig montering kan inte\navaktiveras om filsystemet är skrivskyddat.\n"

#. from ubuntu:e2fsprogs
msgid "The needs_recovery flag is set.  Please run e2fsck before clearing\nthe has_journal flag.\n"
msgstr "Flaggan needs_recovery är satt.  Kör e2fsck före flaggan has_journal\nnollställs.\n"

#. from ubuntu:e2fsprogs
msgid "The orphan_file feature may only be cleared when the filesystem is unmounted.\n"
msgstr "Funktionen orphan_file kan endast nollställas när filsystemet är omonterat.\n"

#. from ubuntu:e2fsprogs
msgid "The orphan_present feature is set. Please run e2fsck before clearing orphan_file feature.\n"
msgstr "Funktionen orphan_present är satt.  Kör e2fsck före funktionen orphan_file nollställs.\n"

#. from ubuntu:e2fsprogs
msgid "The primary @S (%b) is on the bad @b list.\n"
msgstr "Det primära superblocket (%b) är på listan över dåliga block.\n"

#. from ubuntu:e2fsprogs
msgid "The quota feature may only be changed when the filesystem is unmounted and not in use.\n"
msgstr "Kvotfunktionen kan endast ändras när filsystemet är omonterat och inte används.\n"

#. from ubuntu:e2fsprogs
msgid "The resize maximum must be greater than the filesystem size.\n"
msgstr "Storleksändringens maximum måste vara större än filsystemets storlek.\n"

#. from ubuntu:e2fsprogs
msgid "The resize_inode and meta_bg features are not compatible.\nThey can not be both enabled simultaneously.\n"
msgstr "Egenskaperna resize_inode och meta_bg är inte kompatibla\nDe kan inte båda aktiveras samtidigt.\n"

#. from ubuntu:e2fsprogs
msgid "The test_fs flag is set (and ext4 is available).  "
msgstr "Flaggan test_fs är satt (och ext4 är tillgängligt).  "

#. from ubuntu:e2fsprogs
msgid "This doesn't bode well, but we'll try to go on...\n"
msgstr "Detta bådar inte gott, men vi skall försöka att fortsätta ...\n"

#. from ubuntu:e2fsprogs
msgid "This filesystem will be automatically checked every %d mounts or\n%g days, whichever comes first.  Use tune2fs -c or -i to override.\n"
msgstr "Detta filsystem kommer automatiskt kontrolleras var %d montering eller\n%g dag, vilket som kommer först.  Använd tune2fs -c eller -i för att ändra.\n"

#. from ubuntu:e2fsprogs
msgid "This may result in very poor performance, (re)-partitioning suggested.\n"
msgstr "Detta kan medföra väldigt dåliga prestanda, (om)partitionering föreslås.\n"

#. from ubuntu:e2fsprogs
msgid "Timestamp(s) on @i %i beyond 2310-04-04 are likely pre-1970.\n"
msgstr "Tidsstämplar på inod %i bortom 2310-04-04 är sannolikt före 1970.\n"

#. from ubuntu:e2fsprogs
msgid "Too big max bad blocks count %u - maximum is %u"
msgstr "För stort maximalt antal dåliga block %u — maximum är %u"

#. from ubuntu:e2fsprogs
msgid "Too many bad blocks, aborting test\n"
msgstr "För många dåliga block, avbryter testet\n"

#. from ubuntu:e2fsprogs
msgid "Too many illegal @bs in @i %i.\n"
msgstr "För många ogiltiga block i inod %i.\n"

#. from ubuntu:e2fsprogs
msgid "Too many references in table"
msgstr "För många referenser i tabellen"

#. from ubuntu:e2fsprogs
msgid "Too many reserved group descriptor blocks"
msgstr "För många reserverade gruppidentifierarblock"

#. from ubuntu:e2fsprogs
msgid "Too many symbolic links encountered."
msgstr "Alltför många symboliska länkar påträffade."

#. from ubuntu:e2fsprogs
msgid "Tried to set block bmap with missing indirect block"
msgstr "Försökte sätta en blockbitkarta med saknat indirektblock"

#. from ubuntu:e2fsprogs
msgid "Truncate"
msgstr "Kapa"

#. from ubuntu:e2fsprogs
msgid "Truncating"
msgstr "Kapar"

#. from ubuntu:e2fsprogs
msgid "UNEXPECTED INCONSISTENCY: the filesystem is being modified while fsck is running.\n"
msgstr "OVÄNTAD INKONSISTENS: filsystemet modifieras medan fsck körs.\n"

#. from ubuntu:e2fsprogs
msgid "UNLINKED"
msgstr "AVLÄNKAD"

#. from ubuntu:e2fsprogs
msgid "UUID does not match.\n"
msgstr "UUID stämmer inte.\n"

#. from ubuntu:e2fsprogs
msgid "UUID has changed since enabling metadata_csum.  Filesystem must be unmounted \nto safely rewrite all metadata to match the new UUID.\n"
msgstr "UUID har ändrats sedan metadata_csum aktiverades.  Filsystem måste vara omonterade för att säkert skriva om alla metadata till att matcha det nya UUID:t.\n"

#. from ubuntu:e2fsprogs
msgid "Unable to resolve '%s'"
msgstr "Kan inte hitta ”%s”"

#. from ubuntu:e2fsprogs
msgid "Unconnected @d @i %i (was in %q)\n"
msgstr "Oförbunden kataloginod %i (fanns i %q)\n"

#. from ubuntu:e2fsprogs
msgid "Undo file corrupt"
msgstr "Gör-ogjort-filen är trasig"

#. from ubuntu:e2fsprogs
msgid "Undo file corruption; run e2fsck NOW!\n"
msgstr "Gör-ogjort-filen trasig; kör e2fsck NU!\n"

#. from ubuntu:e2fsprogs
msgid "Undo file superblock checksum doesn't match.\n"
msgstr "Gör-ogjort-superblockets kontrollsumma stämmer inte.\n"

#. from ubuntu:e2fsprogs
msgid "Unexpected @b in @h %d (%q).\n"
msgstr "Oväntat block i HTREE-katalog %d (%q).\n"

#. from ubuntu:e2fsprogs
msgid "Unexpected reply length from server %d\n"
msgstr "Oväntad svarslängd från servern %d\n"

#. from ubuntu:e2fsprogs
msgid "Unhandled error code (0x%x)!\n"
msgstr "Ej hanterad felkod (0x%x)!\n"

#. from ubuntu:e2fsprogs
msgid "Unimplemented ext2 library function"
msgstr "Oimplementerad ext2-biblioteksfunktion"

#. from ubuntu:e2fsprogs
msgid "Unknown checksum algorithm"
msgstr "Okänd kontrollsummealgoritm"

#. from ubuntu:e2fsprogs
msgid "Unknown encoding flags from profile: %s"
msgstr "Okända kodningsflaggor från profilen: %s"

#. from ubuntu:e2fsprogs
msgid "Unknown extended option: %s\n"
msgstr "Okänd utökad flagga: %s\n"

#. from ubuntu:e2fsprogs
msgid "Unknown filename encoding from profile: %s"
msgstr "Okänd filnamnskodning från profilen: %s"

#. from ubuntu:e2fsprogs
msgid "Unknown pass?!?"
msgstr "Okänt pass?!?"

#. from ubuntu:e2fsprogs
msgid "Unsupported journal version"
msgstr "Ej stödd journalversion"

#. from ubuntu:e2fsprogs
msgid "Update quota info for quota type %N"
msgstr "Uppdatera kvotinformation för kvottyp %N"

#. from ubuntu:e2fsprogs
msgid "Updating inode references"
msgstr "Uppdaterar inodsreferenser"

#. from ubuntu:e2fsprogs
msgid "Usage:  %s device...\n\nPrints out the partition information for each given device.\nFor example: %s /dev/hda\n\n"
msgstr "Användning:  %s enhet...\n\nSkriv ut partitionsinformationen för varje angiven enhet.\nTill exempel: %s /dev/hda\n\n"

#. from ubuntu:e2fsprogs
msgid "Usage:  findsuper device [skipbytes [startkb]]\n"
msgstr "Användning:  findsuper enhet [skippabyte [startkb]]\n"

#. from ubuntu:e2fsprogs
msgid "Usage: %s -r device\n"
msgstr "Användning: %s -r enhet\n"

#. from ubuntu:e2fsprogs
msgid "Usage: %s [ -r|-Q ] [ -f ] [ -b superblock ] [ -B blocksize ] device image-file\n"
msgstr "Användning: %s [ -r|-Q ] [ -f ] [ -b superblock ] [ -B blockstorlek ] enhet avbildsfil\n"

#. from ubuntu:e2fsprogs
msgid "Usage: %s [-RVadlpv] [files...]\n"
msgstr "Användning: %s [-RVadlpv] [filer…]\n"

#. from ubuntu:e2fsprogs
msgid "Usage: %s [-RVf] [-+=aAcCdDeijPsStTuFx] [-p project] [-v version] files...\n"
msgstr "Användning: %s [-RVf] [-+=aAcCdDeijPsStTuFx] [-p projekt] [-v version] filer…\n"

#. from ubuntu:e2fsprogs
msgid "Usage: %s [-b block_size] [-i input_file] [-o output_file] [-svwnfBX]\n       [-c blocks_at_once] [-d delay_factor_between_reads] [-e max_bad_blocks]\n       [-p num_passes] [-t test_pattern [-t test_pattern [...]]]\n       device [last_block [first_block]]\n"
msgstr "Användning: %s [-b blockstorlek] [-i infil] [-o utfil] [-svwnfBX]\n            [-c block_åt_gången] [-d fördröjningsfaktor mellan läsningar]\n            [-e max_dåliga_block] [-p antal_pass]\n            [-t testmönster [-t testmönster [...]]]\n            enhet [sista_block [första_block]]\n"

#. from ubuntu:e2fsprogs
msgid "Usage: %s [-bfghimxV] [-o superblock=<num>] [-o blocksize=<num>] device\n"
msgstr "Användning: %s [-bfghimxV] [-o superblock=<num>] [-o blocksize=<num>] enhet\n"

#. from ubuntu:e2fsprogs
msgid "Usage: %s [-c max_mounts_count] [-e errors_behavior] [-f] [-g group]\n	[-i interval[d|m|w]] [-j] [-J journal_options] [-l]\n	[-m reserved_blocks_percent] [-o [^]mount_options[,...]]\n	[-r reserved_blocks_count] [-u user] [-C mount_count]\n	[-L volume_label] [-M last_mounted_dir]\n	[-O [^]feature[,...]] [-Q quota_options]\n	[-E extended-option[,...]] [-T last_check_time] [-U UUID]\n	[-I new_inode_size] [-z undo_file] device\n"
msgstr "Användning: %s [-c max_antal_monteringar] [-e felbeteende] [-f] [-g grupp]\n	[-i intervall[d|m|w]] [-j] [-J journalflaggor] [-l]\n	[-m reserverade_block_procent] [-o [^]monteringsflaggor[,…]]\n	[-r antal_reserverade_block] [-u användare] [-C antal_monteringar]\n	[-L volymetikett] [-M senast_monterad_katalog]\n	[-O [^]funktion[,…]] [-Q kvotflaggor]\n	[-E utökad-flagga[,…]] [-T senaste_kontrolltid] [-U UUID]\n	[-I ny_inodstorlek] [-z gör-ogjort-fil] enhet\n"

#. from ubuntu:e2fsprogs
msgid "Usage: %s [-c|-l filename] [-b block-size] [-C cluster-size]\n	[-i bytes-per-inode] [-I inode-size] [-J journal-options]\n	[-G flex-group-size] [-N number-of-inodes] [-d root-directory|tarball]\n	[-m reserved-blocks-percentage] [-o creator-os]\n	[-g blocks-per-group] [-L volume-label] [-M last-mounted-directory]\n	[-O feature[,...]] [-E extended-option[,...]] [-t fs-type]\n	[-T usage-type ] [-U UUID] [-e errors_behavior][-z undo_file]\n	[-jnqvDFSV] device [blocks-count]\n"
msgstr "Användning: %s [-c|-l filnamn] [-b blockstorlek] [-C klusterstorlek]\n	[-i byte-per-inode] [-I inode-storlek] [-J journal-flaggor]\n	[-G flex-group-storlek] [-N antal-inoder] [-d root-katalog|tarball]\n	[-m reserverade-block-procent] [-o creator-os]\n	[-g block-per-grupp] [-L volymetikett] [-M senast-monterade-katalog]\n	[-O funktion[,...]] [-E utökad-flagga[,...]] [-t fs-typ]\n	[-T användningstyp ] [-U UUID] [-e felbeteende][-z ångra_fil]\n	[-jnqvDFSV] enhet [blockantal]\n"

#. from ubuntu:e2fsprogs
msgid "Usage: %s [-d debug_flags] [-f] [-F] [-M] [-P] [-p] device [-b|-s|new_size] [-S RAID-stride] [-z undo_file]\n\n"
msgstr "Användning: %s [-d felsökningflaggor] [-f] [-F] [-M] [-P] [-p] enhet [-b|-s|ny_storlek] [-S RAID-kliv] [-z gör-ogjort-fil]\n\n"

#. from ubuntu:e2fsprogs
msgid "Usage: %s [-d] [-p pidfile] [-s socketpath] [-T timeout]\n"
msgstr "Användning: %s [-d] [-p pid-fil] [-s uttagssökväg] [-T tidsgräns]\n"

#. from ubuntu:e2fsprogs
msgid "Usage: %s [-f] [-h] [-n] [-o offset] [-v] [-z undo_file] <transaction file> <filesystem>\n"
msgstr "Användning: %s [-f] [-h] [-n] [-o avstånd] [-v] [-z gör-ogjort-fil] <transaktionsfil> <filsystem>\n"

#. from ubuntu:e2fsprogs
msgid "Usage: %s [-panyrcdfktvDFV] [-b superblock] [-B blocksize]\n		[-l|-L bad_blocks_file] [-C fd] [-j external_journal]\n		[-E extended-options] [-z undo_file] device\n"
msgstr "Användning: %s [-panyrcdfktvDFV] [-b superblock] [-B blockstorlek]\n		[-l|-L dåliga_block_fil] [-C fd] [-j extern_journal]\n		[-E utökade-flaggor] [-z gör_ogjort_fil] enhet\n"

#. from ubuntu:e2fsprogs
msgid "Usage: %s [-r] [-t]\n"
msgstr "Användning: %s [-r] [-t]\n"

#. from ubuntu:e2fsprogs
msgid "Usage: %s disk\n"
msgstr "Användning: %s disk\n"

#. from ubuntu:e2fsprogs
msgid "Usage: e2label device [newlabel]\n"
msgstr "Användning: e2label enhet [ny-etikett]\n"

#. from ubuntu:e2fsprogs
msgid "Usage: fsck [-AMNPRTV] [ -C [ fd ] ] [-t fstype] [fs-options] [filesys ...]\n"
msgstr "Användning: fsck [-AMNPRTV] [ -C [ fh ] ] [-t fstyp] [fs-flaggor] [filsys ...]\n"

#. from ubuntu:e2fsprogs
msgid "Usage: mklost+found\n"
msgstr "Användning: mklost+found\n"

#. from ubuntu:e2fsprogs
msgid "User cancel requested"
msgstr "Användarannullering begärd"

#. from ubuntu:e2fsprogs
msgid "Using journal device's blocksize: %d\n"
msgstr "Använder journalenhetens blockstorlek: %d\n"

#. from ubuntu:e2fsprogs
msgid "Version of %s set as %lu\n"
msgstr "Version av %s satt som %lu\n"

#. from ubuntu:e2fsprogs
msgid "WARNING: Could not confirm kernel support for metadata_csum_seed.\n  This requires Linux >= v4.4.\n"
msgstr "VARNING: Kunde inte bekräfta stöd i kärnan för metadata_csum_seed.\n  Detta kräver Linux ≥ v4.4.\n"

#. from ubuntu:e2fsprogs
msgid "WARNING: PROGRAMMING BUG IN E2FSCK!\n	OR SOME BONEHEAD (YOU) IS CHECKING A MOUNTED (LIVE) FILESYSTEM.\n@i_link_info[%i] is %N, @i.i_links_count is %Il.  They @s the same!\n"
msgstr "VARNING: PROGRAMMERINGSFEL I E2FSCK!\n	ELLER NÅGON KLANTSKALLE (DU) KONTROLLERAR ETT MONTERAT (AKTIVT) FILSYSTEM.\ninod_link_info[%i] är %N, inod.i_links_count är %Il.  De skulle vara samma!\n"

#. from ubuntu:e2fsprogs
msgid "WARNING: Your /etc/fstab does not contain the fsck passno\n	field.  I will kludge around things for you, but you\n	should fix your /etc/fstab file as soon as you can.\n\n"
msgstr "VARNING: Din /etc/fstab innehåller inte fsck-passnr-fältet.\n	Jag fixar mig förbi detta åt dig, men du\n	bör rätta din /etc/fstab-fil så snart du kan.\n\n"

#. from ubuntu:e2fsprogs
msgid "WARNING: bad format on line %d of %s\n"
msgstr "VARNING: fel format på rad %d av %s\n"

#. from ubuntu:e2fsprogs
msgid "WARNING: couldn't open %s: %s\n"
msgstr "VARNING: kunde inte öppna %s: %s\n"

#. from ubuntu:e2fsprogs
msgid "WILL OPTIMIZE"
msgstr "KOMMER OPTIMERA"

#. from ubuntu:e2fsprogs
msgid "WILL RECREATE"
msgstr "KOMMER ÅTERSKAPA"

#. from ubuntu:e2fsprogs
msgid "Warning!  %s is in use.\n"
msgstr "Varning!  %s används.\n"

#. from ubuntu:e2fsprogs
msgid "Warning!  %s is mounted.\n"
msgstr "Varning!  %s är monterat.\n"

#. from ubuntu:e2fsprogs
msgid "Warning... %s for device %s exited with signal %d.\n"
msgstr "Varning... %s för enhet %s avslutade med signal %d.\n"

#. from ubuntu:e2fsprogs
msgid "Warning: %d-byte blocks too big for system (max %d), forced to continue\n"
msgstr "Varning: %d-byteblock för stort för systemet (max %d), tvingas fortsätta\n"

#. from ubuntu:e2fsprogs
msgid "Warning: -K option is deprecated and should not be used anymore. Use '-E nodiscard' extended option instead!\n"
msgstr "Varning: flaggan -K undanbedes och skall inte användas mera.  Använd den utökade flaggan ”-E nodiscard” istället!\n"

#. from ubuntu:e2fsprogs
msgid "Warning: Check time reached; running e2fsck is recommended.\n"
msgstr "Varning: kontrolltiden uppnådd; att köra e2fsck rekommenderas.\n"

#. from ubuntu:e2fsprogs
msgid "Warning: Group %g's @S (%b) is bad.\n"
msgstr "Varning: Grupp %g:s superblock (%b) är dåligt.\n"

#. from ubuntu:e2fsprogs
msgid "Warning: Group %g's copy of the @g descriptors has a bad @b (%b).\n"
msgstr "Varning: Grupp %g:s kopia av gruppbeskrivarna har ett dåligt block (%b).\n"

#. from ubuntu:e2fsprogs
msgid "Warning: Maximal mount count reached, running e2fsck is recommended.\n"
msgstr "Varning: maximalt antal monteringar uppnått, att köra e2fsck rekommenderas.\n"

#. from ubuntu:e2fsprogs
msgid "Warning: Mounting unchecked fs, running e2fsck is recommended.\n"
msgstr "Varning: monterar okontrollerat fs, att köra e2fsck rekommenderas.\n"

#. from ubuntu:e2fsprogs
msgid "Warning: The journal is dirty. You may wish to replay the journal like:\n\n	e2fsck -E journal_only %s\n\nthen rerun this command.  Otherwise, any changes made may be overwritten\nby journal recovery.\n"
