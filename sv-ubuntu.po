#. from ubuntu:devscripts
msgid "\\f[B]deb2apptainer\\f[R] - Build a Singularity/Apptainer image with given Debian packages\\fR"
msgstr "\\f[B]deb2apptainer\\f[R] - Skapa en Singularity/Apptainer-bild med angivna Debian-paket\\fR"

#. from ubuntu:devscripts
msgid "\\f[B]deb2apptainer\\f[R] [\\f[B]-hB\\f[R]][\\f[B]-c\\f[R] \\f[I]CMD\\f[R]] [\\f[B]-f\\f[R] \\f[I]FROM\\f[R]][\\f[B]-n\\f[R] \\f[I]NAME\\f[R]] [\\f[B]-o\\f[R] \\f[I]DIR\\f[R]][\\f[B]-p\\f[R] \\f[I]PRE_SCRIPT\\f[R]] [\\f[B]-s\\f[R] \\f[I]POST_SCRIPT\\f[R]] \\f[I]packages\\fR"
msgstr "\\f[B]deb2apptainer\\f[R] [\\f[B]-hB\\f[R]][\\f[B]-c\\f[R] \\f[I]CMD\\f[R]] [\\f[B]-f\\f[R] \\f[I]FROM\\f[R]][\\f[B]-n\\f[R] \\f[I]NAME\\f[R]] [\\f[B]-o\\f[R] \\f[I]DIR\\f[R]][\\f[B]-p\\f[R] \\f[I]PRE_SCRIPT\\f[R]] [\\f[B]-s\\f[R] \\f[I]POST_SCRIPT\\f[R]] \\f[I]paket\\fR"

#. from ubuntu:devscripts
msgid "\\f[B]deb2apptainer\\f[R] is a simple script which takes as input a list of Debian packages and generates automatically a Singularity/Apptainer container including these packages.  A set of \\f[I]freedesktop.org\\f[R] desktop launchers are also generated based on the .desktop and icon files found in the packages.  In addition, a desktop launcher is created to start the container in a Terminal.\\fR"
msgstr "\\f[B]deb2apptainer\\f[R] är ett enkelt skript som tar emot en lista med Debian-paket som indata och automatiskt genererar en Singularity/Apptainer-container som innehåller dessa paket.  En uppsättning \\f[I]freedesktop.org\\f[R] skrivbordsstartprogram genereras också baserat på .desktop- och ikonfilerna som finns i paketen. Dessutom skapas ett skrivbordsstartprogram för att starta containern i en terminal.\\fR"

#. from ubuntu:devscripts
msgid "\\f[B]deb2docker\\f[R] - Build a Docker image with given Debian packages\\fR"
msgstr "\\f[B]deb2docker\\f[R] - Skapa en Docker-bild med angivna Debian-paket\\fR"

#. from ubuntu:devscripts
msgid "\\f[B]deb2docker\\f[R] [-hB][-c CMD][-f FROM][-n NAME][-o DIR][-p PRE_SCRIPT][-s POST_SCRIPT] \\f[I]packages\\fR"
msgstr "\\f[B]deb2docker\\f[R] [-hB][-c CMD][-f FROM][-n NAME][-o DIR][-p PRE_SCRIPT][-s POST_SCRIPT] \\f[I]packages\\fR"

#. from ubuntu:devscripts
msgid "\\f[B]deb2docker\\f[R] is a simple script which takes as input a list of Debian packages and generates automatically a Docker container including these packages.  A set of \\f[I]freedesktop.org\\f[R] desktop launchers are also generated based on the .desktop and icon files found in the packages.  In addition, a desktop launcher is created to start the container in a Terminal.\\fR"
msgstr "\\f[B]deb2docker\\f[R] är ett enkelt skript som tar emot en lista med Debian-paket som indata och automatiskt genererar en Docker-container som innehåller dessa paket. En uppsättning \\f[I]freedesktop.org\\f[R]-startprogram för skrivbordet genereras också baserat på .desktop- och ikonfilerna som finns i paketen. Dessutom skapas ett startprogram för skrivbordet för att starta containern i en terminal.\\fR"

#. from ubuntu:devscripts
msgid "\\f[B]deb2singularity\\f[R] [\\f[B]-hB\\f[R]][\\f[B]-c\\f[R] \\f[I]CMD\\f[R]] [\\f[B]-f\\f[R] \\f[I]FROM\\f[R]][\\f[B]-n\\f[R] \\f[I]NAME\\f[R]] [\\f[B]-o\\f[R] \\f[I]DIR\\f[R]][\\f[B]-p\\f[R] \\f[I]PRE_SCRIPT\\f[R]] [\\f[B]-s\\f[R] \\f[I]POST_SCRIPT\\f[R]] \\f[I]packages\\fR"
msgstr "\\f[B]deb2singularity\\f[R] [\\f[B]-hB\\f[R]][\\f[B]-c\\f[R] \\f[I]CMD\\f[R]] [\\f[B]-f\\f[R] \\f[I]FROM\\f[R]][\\f[B]-n\\f[R] \\f[I]NAME\\f[R]] [\\f[B]-o\\f[R] \\f[I]DIR\\f[R]][\\f[B]-p\\f[R] \\f[I]PRE_SCRIPT\\f[R]] [\\f[B]-s\\f[R] \\f[I]POST_SCRIPT\\f[R]] \\f[I]paket\\fR"

