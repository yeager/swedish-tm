msgid " -F format       Specify a format for displaying search results; see the manual.\n"
msgstr " -F format       Ange ett format för att visa sökresultat; se manualen.\n"

#. from ubuntu:aptitude
msgid " -O order        Specify how search results should be sorted; see the manual.\n"
msgstr " -O ordning      Ange hur sökresultat bör sorteras; se manualen.\n"

#. from ubuntu:aptitude
msgid " -P              Always prompt for confirmation of actions.\n"
msgstr " -P              Fråga alltid efter bekräftelse för åtgärder.\n"

#. from ubuntu:aptitude
msgid " -S fname        Read the aptitude extended status info from fname.\n"
msgstr " -S fname        Läs aptitudes utökade statusinfo från fname.\n"

#. from ubuntu:aptitude
msgid " -V              Show which versions of packages are to be installed.\n"
msgstr " -V              Visa vilka paketversioner som kommer att installeras.\n"

#. from ubuntu:aptitude
msgid " -Z              Show the change in installed size of each package.\n"
msgstr " -Z              Visa ändringen i installerad storlek för varje paket.\n"

#. from ubuntu:aptitude
msgid " -d              Only download packages, do not install or remove anything.\n"
msgstr " -d              Ladda endast ned paket, installera inget och ta inte bort något.\n"

#. from ubuntu:aptitude
msgid " -f              Aggressively try to fix broken packages.\n"
msgstr " -f              Försök aggressivt att laga trasiga paket.\n"

